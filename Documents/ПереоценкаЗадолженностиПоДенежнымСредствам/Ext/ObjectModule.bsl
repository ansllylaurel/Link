				ПроводкиТорговойКомиссии);
				
				
			Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
				
				Погрешность = ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего * ВыборкаДетальныеЗаписи.ДнейПрошло / ВыборкаДетальныеЗаписи.ВсегоДней
								- (ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего - ВыборкаДетальныеЗаписи.КомиссияПоРЕПОНачислено)
								- ВыборкаДетальныеЗаписи.НачислитьКомиссии;
								
				ПогрешностьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Погрешность, ВыборкаДетальныеЗаписи.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);								
				
				СтрокиПогрешности = ТЗПогрешности.НайтиСтроки(Новый Структура("СделкаРЕПО", СделкаРЕПО));
				Если СтрокиПогрешности.Количество() = 0 Тогда
					СтрокаПогрешности = ТЗПогрешности.Добавить();
					СтрокаПогрешности.СделкаРЕПО = СделкаРЕПО;
					СтрокаПогрешности.Проводки = ПроводкиТорговойКомиссии;
				Иначе
					СтрокаПогрешности = СтрокиПогрешности[0];
				КонецЕсли;
				
				СтрокаПогрешности.Погрешность = СтрокаПогрешности.Погрешность + Погрешность;
				СтрокаПогрешности.ПогрешностьВВалютеУчета = СтрокаПогрешности.ПогрешностьВВалютеУчета + ПогрешностьВВалютеУчета;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Комиссия брокера
	
	// Итак, тут сделано проведение по "правильной" схеме, до 1.1.18 все проведене было не очень правильно (мягко говоря).
	// По большинству клиентов 18й год проводили, но были и такие по которым только с февраля провели
	// К сожалению эта периодичность тут не зашита
	// Проведение этого документа ранее 1.1.18 меняет проводки, и Таня К.(и остальные бухгалтера) в курсе
	// 
	// С 1го марта 18го схема опять изменилась, но это уже тут учитывается
	//
	
	// ГПБ ведет себя аналогично бирже - начисляет комиссию 1 раз и сразу поэтому ее тоже размазываем
	//
	// БК до 1.3.18 ведет себя "плохо" (и это реализовано в следующем блоке)
	// но с 1.3.18 начинает вести себя "хорошо", как ГПБ
	// 
	// как оказалось в трасте по НГ ПР и Традиции ПР на новую схему перешли только с 1го апреля...
	//
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(РасходыПоКомиссии.СуммаОборот, 0) КАК КомиссияПоРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК СделкаРЕПОДата,
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
		|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ) КАК ВсегоДней,
		|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, &ДатаПереоценки, ДЕНЬ) КАК ДнейПрошло,
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ СделкиРЕПОПроценты
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодДата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ЧастьСделкиРЕПО = 1
		|				И СделкаРЕПО.Брокер = &БрокерГПБ) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				&ПериодДата,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоКомиссии
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = РасходыПоКомиссии.Сделка
		|			И УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага = РасходыПоКомиссии.ЦеннаяБумага
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ПериодДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиРЕПОПроценты.СделкаРЕПО КАК СделкаРЕПО,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СделкиРЕПОПроценты.ЦеннаяБумага) КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ТаблицаОшибокЦБ
		|ИЗ
		|	СделкиРЕПОПроценты КАК СделкиРЕПОПроценты
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкиРЕПОПроценты.СделкаРЕПО
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(СделкиРЕПОПроценты.ЦеннаяБумага) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиРЕПОПроценты.СделкаРЕПО КАК СделкаРЕПО,
		|	СделкиРЕПОПроценты.СделкаРЕПО.Брокер.ЮрФизЛицо КАК Контрагент,
		|	СделкиРЕПОПроценты.СделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	СделкиРЕПОПроценты.СделкаРЕПО.ВалютаТорговойКомиссии КАК ВалютаТорговойКомиссии,
		|	СделкиРЕПОПроценты.ВсегоДней КАК ВсегоДней,
		|	СделкиРЕПОПроценты.ДнейПрошло КАК ДнейПрошло,
		|	СделкиРЕПОПроценты.КомиссияПоРЕПО КАК КомиссияПоРЕПОВсего,
		|	ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК КомиссияПоРЕПОНачислено,
		|	(ВЫРАЗИТЬ(СделкиРЕПОПроценты.КомиссияПоРЕПО * СделкиРЕПОПроценты.ДнейПрошло / СделкиРЕПОПроценты.ВсегоДней КАК ЧИСЛО(19, 2))) - (СделкиРЕПОПроценты.КомиссияПоРЕПО - ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстаток, 0)) КАК НачислитьКомиссии,
		|	СделкиРЕПОПроценты.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	СделкиРЕПОПроценты КАК СделкиРЕПОПроценты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссииБрокера),
		|				&ВидыСубконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
		|		ПО СделкиРЕПОПроценты.СделкаРЕПО = БухгалтерскийУчетОстатки.Субконто1";
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Сделка);
	
	Если ЭтотОбъект.Дата < '20180301' Тогда // до 1.3.18 только ГПБ
		Запрос.УстановитьПараметр("БрокерГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	ИначеЕсли (ЭтотОбъект.Дата < '20180402')
		И (СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_PR_RN_001"
			ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_UL_PR_24"
			ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_NPF037") Тогда // до 27.3.18 траст нг пр и традиция пр по-старому
		Запрос.УстановитьПараметр("БрокерГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	Иначе // с 1.3.18 берем всех брокеров (и ГПБ и БК)
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СделкаРЕПО.Брокер = &БрокерГПБ", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ПериодДата", КонецДня(ЭтотОбъект.Дата));
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	_ТаблицаОшибокЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ТаблицаОшибокЦБ").ПолучитьДанные().Выгрузить();
	
	Если _ТаблицаОшибокЦБ.Количество() > 0 Тогда
		Для Каждого СтрокаОшибки Из _ТаблицаОшибокЦБ Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для сделки РЕПО %1 при расчете переоценки комиссии подобралось более 1 ценной бумаги!", СтрокаОшибки.СделкаРЕПО),,,,Отказ);
		КонецЦикла;	
		Возврат;
	КонецЕсли;	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.НачислитьКомиссии > 0 Тогда
			
			СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			ЦеннаяБумага = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
			СделкаРЕПО = ВыборкаДетальныеЗаписи.СделкаРЕПО;
			
			БУНУ_ПризнатьКомиссиюПоРЕПО(
				ЭтотОбъект.Движения[УчетныйРегистр],
				СуммаОперации,
				СделкаРЕПО,
				ЦеннаяБумага,
				СведенияОбОбращенииЦенныхБумагНаОРЦБ,
				ВыборкаДетальныеЗаписи.Контрагент,
				Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии,
				НастройкиКомиссии,
				МетодПризнанияРасходовПоСделкамРЕПО);
			
			Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
				
				Погрешность = ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего * ВыборкаДетальныеЗаписи.ДнейПрошло / ВыборкаДетальныеЗаписи.ВсегоДней
								- (ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего - ВыборкаДетальныеЗаписи.КомиссияПоРЕПОНачислено)
								- ВыборкаДетальныеЗаписи.НачислитьКомиссии;
								
				ПогрешностьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Погрешность, ВыборкаДетальныеЗаписи.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);								
				
				СтрокиПогрешности = ТЗПогрешности.НайтиСтроки(Новый Структура("СделкаРЕПО", СделкаРЕПО));
				Если СтрокиПогрешности.Количество() = 0 Тогда
					СтрокаПогрешности = ТЗПогрешности.Добавить();
					СтрокаПогрешности.СделкаРЕПО = СделкаРЕПО;
				Иначе
					СтрокаПогрешности = СтрокиПогрешности[0];
				КонецЕсли;
				
				СтрокаПогрешности.Погрешность = СтрокаПогрешности.Погрешность + Погрешность;
				СтрокаПогрешности.ПогрешностьВВалютеУчета = СтрокаПогрешности.ПогрешностьВВалютеУчета + ПогрешностьВВалютеУчета;
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
	Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
	
		Для каждого СтрокаТЗПогрешности Из ТЗПогрешности Цикл
			
			СтрокаТЗПогрешности.Погрешность = Окр(СтрокаТЗПогрешности.Погрешность, 2);
			СтрокаТЗПогрешности.ПогрешностьВВалютеУчета = Окр(СтрокаТЗПогрешности.ПогрешностьВВалютеУчета, 2);
			
			Если СтрокаТЗПогрешности.ПогрешностьВВалютеУчета >= 0.01 ИЛИ СтрокаТЗПогрешности.ПогрешностьВВалютеУчета <= -0.01 Тогда
			
				МассивПроводок = СтрокаТЗПогрешности.Проводки;
				
				Для каждого Проводка Из МассивПроводок Цикл
				
					Проводка.Сумма = Проводка.Сумма + СтрокаТЗПогрешности.ПогрешностьВВалютеУчета;
					
				КонецЦикла;
			
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	// А ТЕПЕРЬ ОБРАБОТАЕМ БРОКЕРСКУЮ КОМИССИЮ ПО БК
	//
	// до 1.3.18 все шло по извращенной схеме
	// с 1.3.18 все идет по "правильной" схеме и обработано выше
	
	Если ЭтотОбъект.Дата < '20180301' // до 1го марта все по бкшной схеме
		ИЛИ (ЭтотОбъект.Дата < '20180402' // до 2го апреля нг пр и традиции тоже
			И ((СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_PR_RN_001"
				ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_UL_PR_24"
				ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_NPF037"))) Тогда
	
		// ТО ЕЩЕ ИЗВРАЩЕНИЕ
		
		// теущий день тоже считаем, поэтому -2 и -3
		ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ЭтотОбъект.Дата), -2);
		ПредПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ЭтотОбъект.Дата), -3);
		
		Если НачалоДня(ПредПредыдущийРабочийДень) <> (НачалоДня(ЭтотОбъект.Дата) - 86400 - 86400) Тогда
		    //если предпредыдущий день нерабочий - берем 1/3 оплаченого за предыдущий
			НачалоПериода = НачалоДня(ЭтотОбъект.Дата) - 86400;
			КонецПериода = КонецДня(ЭтотОбъект.Дата) - 86400;
			
			Коэффициент = 3;
		ИначеЕсли НачалоДня(ПредыдущийРабочийДень) <> (НачалоДня(ЭтотОбъект.Дата) - 86400) Тогда
		    //если предыдущий день нерабочий - берем 2/3 оплаченного за сегодня
			НачалоПериода = НачалоДня(ЭтотОбъект.Дата);
			КонецПериода = КонецДня(ЭтотОбъект.Дата);
			
			Коэффициент = 2;
		Иначе
		    //берем, что было оплачено вчера
			НачалоПериода = НачалоДня(ЭтотОбъект.Дата) - 86400;
			КонецПериода = КонецДня(ЭтотОбъект.Дата) - 86400;
			
			Коэффициент = 1;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоСделке.СуммаОборот КАК Комиссия,
			|	РасходыПоСделке.Сделка КАК СделкаРЕПО,
			|	ВЫРАЗИТЬ(РасходыПоСделке.Сделка КАК Документ.СделкаРЕПО).Брокер.ЮрФизЛицо КАК Контрагент,
			|	ВЫРАЗИТЬ(РасходыПоСделке.Сделка КАК Документ.СделкаРЕПО).ВалютаСделки КАК ВалютаСделки,
			|	ВЫРАЗИТЬ(РасходыПоСделке.Сделка КАК Документ.СделкаРЕПО).ВалютаТорговойКомиссии КАК ВалютаТорговойКомиссии,
			|	РасходыПоСделке.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫРАЗИТЬ(РасходыПоСделке.Сделка КАК Документ.СделкаРЕПО).Дата КАК СделкаДата
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В (&СписокСтратегий)
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|				И Сделка ССЫЛКА Документ.СделкаРЕПО
			|				И ВЫРАЗИТЬ(Сделка КАК Документ.СделкаРЕПО).Брокер = &БрокерБК
			|				И ВЫРАЗИТЬ(Сделка КАК Документ.СделкаРЕПО).ДатаВторойЧастиРЕПО > &КонецДня) КАК РасходыПоСделке";
		
		Запрос.УстановитьПараметр("БрокерБК", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
		
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.Комиссия > 0 Тогда
				
				СуммаКомиссии = ВыборкаДетальныеЗаписи.Комиссия;
				
				Если Коэффициент = 2 Тогда
					СуммаКомиссии = Окр(СуммаКомиссии / 3 * 2, 2);
				ИначеЕсли (Коэффициент = 3) И (НачалоДня(ВыборкаДетальныеЗаписи.СделкаДата) < НачалоПериода) Тогда
					СуммаКомиссии = СуммаКомиссии - Окр(СуммаКомиссии / 3 * 2, 2);
				КонецЕсли;
				
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.ВалютаТорговойКомиссии, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				
				ЦеннаяБумага = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				СделкаРЕПО = ВыборкаДетальныеЗаписи.СделкаРЕПО;
				
				БУНУ_ПризнатьКомиссиюПоРЕПО(
					ЭтотОбъект.Движения[УчетныйРегистр],
					СуммаОперации,
					СделкаРЕПО,
					ЦеннаяБумага,
					СведенияОбОбращенииЦенныхБумагНаОРЦБ,
					ВыборкаДетальныеЗаписи.Контрагент,
					Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии,
					НастройкиКомиссии,
					МетодПризнанияРасходовПоСделкамРЕПО);
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры

Процедура БУНУ_ПереоценитьЗадолженность(Отказ)
	
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета);
	
	НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЦельРасчета);
		
	ВариантРасчетаОценочнойСтоимости = НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости;		
	
	Параметры = Новый Структура;
	Параметры.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Параметры.Вставить("Период", ЭтотОбъект.Дата);
	Параметры.Вставить("ВариантРасчетаОценочнойСтоимости", ВариантРасчетаОценочнойСтоимости);
	Параметры.Вставить("Организация", ЭтотОбъект.Организация);
	Параметры.Вставить("ЦельРасчета", ЦельРасчета);
	
	ЗадолженностиКОбесценениюИДисконтированию = РаботаСоСтоимостьюПоРыночнойСтавке.РассчитатьСправедливыеСтоимостиЗадолженностей(
		Параметры, 
		Неопределено,
		Отказ);
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ЗадолженностиКОбесценениюИДисконтированию, 
		"_ЗадолженностиКОбесценениюИДисконтированию", 
		Запрос.МенеджерВременныхТаблиц,,
		"ВидЗадолженности, ОснованиеЗадолженности, ТипЗадолженности, Контрагент, ПроцентыЭСП, СуммаРезерва");
		
	//Переоценку по счету 76.ПЗ.5 пока ведут вручную (задача #308260, комментарий от 18.10.2022) 
	// #572237 убрал фильтр по счету 76.ПЗ.5. Учитываем обесценение дебиторки  
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _БухУчетОстатки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ДатаПереоценки,
		|			Счет В ИЕРАРХИИ (&Счет76ПЗ),
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Документ.СделкаСНедвижимостью)
		|						ТОГДА ВЫРАЗИТЬ(Субконто2 КАК Документ.СделкаСНедвижимостью).ВидПраваНаНедвижимость <> ЗНАЧЕНИЕ(Перечисление.ВидыПравНаНедвижимость.ДДУ)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БухУчетОстатки.Счет КАК СчетБухОстатки,
		|	_БухУчетОстатки.Субконто1 КАК Контрагент,
		|	_БухУчетОстатки.Субконто2 КАК ОснованиеРасчетов,
		|	_БухУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	НастройкиУчетаКомиссииСрезПоследних.АналитикаПереоценки КАК АналитикаПереоценки
		|ИЗ
		|	_БухУчетОстатки КАК _БухУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И ВидЗадолженности В
		|						(ВЫБРАТЬ
		|							_ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности КАК ВидЗадолженности
		|						ИЗ
		|							_ЗадолженностиКОбесценениюИДисконтированию КАК _ЗадолженностиКОбесценениюИДисконтированию)) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО _БухУчетОстатки.Счет = НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(ЗадолженностьПоДаннымБэкаВся.СуммаОстаток) КАК СуммаОстаток,
		|			ЗадолженностьПоДаннымБэкаВся.Основание КАК Основание,
		|			ЗадолженностьПоДаннымБэкаВся.ВидЗадолженности КАК ВидЗадолженности
		|		ИЗ
		|			(ВЫБРАТЬ
		|				ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|				ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|				ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности
		|			ИЗ
		|				РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|						&ДатаПереоценки,
		|						Организация = &Организация
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|							И (ВидЗадолженности, Основание) В
		|								(ВЫБРАТЬ
		|									_ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности КАК ВидЗадолженности,
		|									_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности КАК ОснованиеЗадолженности
		|								ИЗ
		|									_ЗадолженностиКОбесценениюИДисконтированию КАК _ЗадолженностиКОбесценениюИДисконтированию)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|			
		|			ОБЪЕДИНИТЬ ВСЕ
		|			
		|			ВЫБРАТЬ
		|				ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток,
		|				ЗадолженностиПоЦеннымБумагамОстатки.Основание,
		|				ЗадолженностиПоЦеннымБумагамОстатки.ВидЗадолженности
		|			ИЗ
		|				РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|						&ДатаПереоценки,
		|						Организация = &Организация
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|							И (ВидЗадолженности, Основание) В
		|								(ВЫБРАТЬ
		|									_ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности КАК ВидЗадолженности,
		|									_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности КАК ОснованиеЗадолженности
		|								ИЗ
		|									_ЗадолженностиКОбесценениюИДисконтированию КАК _ЗадолженностиКОбесценениюИДисконтированию)) КАК ЗадолженностиПоЦеннымБумагамОстатки) КАК ЗадолженностьПоДаннымБэкаВся
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЗадолженностьПоДаннымБэкаВся.Основание,
		|			ЗадолженностьПоДаннымБэкаВся.ВидЗадолженности) КАК ЗадолженностьПоДаннымБэка
		|		ПО _БухУчетОстатки.Субконто2 = ЗадолженностьПоДаннымБэка.Основание
		|			И (НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности = ЗадолженностьПоДаннымБэка.ВидЗадолженности)
		|ГДЕ
		|	ЗадолженностьПоДаннымБэка.СуммаОстаток = 0";
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ДатаПереоценки", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Счет76ПЗ", ПланыСчетов.Основной.ПереоценкаЗадолженностей);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	
	ПроцентыПоЗайму_РПИ = Новый Массив;
	ПроцентыПоЗайму_РПИ.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ПроцентыПоЗайму_РПИ_011024_5_1"));
	ПроцентыПоЗайму_РПИ.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ПроцентыПоЗайму_РПИ_090125_5_1"));
	Запрос.УстановитьПараметр("ПроцентыПоЗаймуРПИ", ПроцентыПоЗайму_РПИ);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены остатки переоценки задолженности по основанию " 
			+ ВыборкаДетальныеЗаписи.ОснованиеРасчетов + " на счете " + ВыборкаДетальныеЗаписи.СчетБухОстатки 
			+ ", при этом по данным бэк-офиса задолженность погашена полностью", ЭтотОбъект,,, Отказ);
	КонецЦикла;	
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности КАК ОснованиеЗадолженности,
		|	_ЗадолженностиКОбесценениюИДисконтированию.ТипЗадолженности КАК ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиКОбесценениюИДисконтированию.Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|				И _ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|			ТОГДА Сделка.Контрагент
		|		ИНАЧЕ _ЗадолженностиКОбесценениюИДисконтированию.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	СУММА(_ЗадолженностиКОбесценениюИДисконтированию.ПроцентыЭСП) + СУММА(_ЗадолженностиКОбесценениюИДисконтированию.СуммаРезерва) КАК СуммаПереоценки,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиКОбесценениюИДисконтированию.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И _ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоИнвестконтракту)
		|				И ТИПЗНАЧЕНИЯ(_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности) = ТИП(Справочник.Договоры)
		|			ТОГДА &АналитикаПереоценкиДебиторскойЗадолженности
		|		ИНАЧЕ ЕСТЬNULL(НастройкиУчетаПрочееСрезПоследних.АналитикаПереоценки, НастройкиУчетаКомиссииСрезПоследних.АналитикаПереоценки)
		|	КОНЕЦ КАК АналитикаПереоценки
		|ПОМЕСТИТЬ _ЗадолженностиСНастройками
		|ИЗ
		|	_ЗадолженностиКОбесценениюИДисконтированию КАК _ЗадолженностиКОбесценениюИДисконтированию
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО _ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности = Сделка.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И ВидЗадолженности В
		|						(ВЫБРАТЬ
		|							_ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности КАК ВидЗадолженности
		|						ИЗ
		|							_ЗадолженностиКОбесценениюИДисконтированию КАК _ЗадолженностиКОбесценениюИДисконтированию)) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО _ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности = НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Прочее)) КАК НастройкиУчетаПрочееСрезПоследних
		|		ПО (ВЫРАЗИТЬ(_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности КАК Документ.Оплата).ОбеспечительныйПлатеж)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности,
		|	_ЗадолженностиКОбесценениюИДисконтированию.ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиКОбесценениюИДисконтированию.Контрагент = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|				И _ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|			ТОГДА Сделка.Контрагент
		|		ИНАЧЕ _ЗадолженностиКОбесценениюИДисконтированию.Контрагент
		|	КОНЕЦ,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки,
		|	ВЫБОР
		|		КОГДА _ЗадолженностиКОбесценениюИДисконтированию.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И _ЗадолженностиКОбесценениюИДисконтированию.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоИнвестконтракту)
		|				И ТИПЗНАЧЕНИЯ(_ЗадолженностиКОбесценениюИДисконтированию.ОснованиеЗадолженности) = ТИП(Справочник.Договоры)
		|			ТОГДА &АналитикаПереоценкиДебиторскойЗадолженности
		|		ИНАЧЕ ЕСТЬNULL(НастройкиУчетаПрочееСрезПоследних.АналитикаПереоценки, НастройкиУчетаКомиссииСрезПоследних.АналитикаПереоценки)
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БухУчетОстатки.Счет КАК СчетБухОстатки,
		|	ЕСТЬNULL(_БухУчетОстатки.Субконто1, ЗадолженностиСНастройками.Контрагент) КАК Контрагент,
		|	ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) КАК ОснованиеРасчетов,
		|	ВЫБОР
		|		КОГДА ЗадолженностиСНастройками.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА -1
		|		ИНАЧЕ 1
		|	КОНЕЦ * ЕСТЬNULL(_БухУчетОстатки.СуммаОстаток, 0) КАК СуммаОстаток,
		|	ЕСТЬNULL(ЗадолженностиСНастройками.СуммаПереоценки, 0) КАК СуммаПереоценки,
		|	ЗадолженностиСНастройками.ТипЗадолженности КАК ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА Оплата.ОбеспечительныйПлатеж
		|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаРасчетовСПокупателямиИЗаказчикамиОбеспечительныйПлатеж)
		|		ИНАЧЕ ЕСТЬNULL(ЗадолженностиСНастройками.СчетУчетаПереоценки, _БухУчетОстатки.Счет)
		|	КОНЕЦ КАК СчетУчетаПереоценки,
		|	ЕСТЬNULL(ЗадолженностиСНастройками.АналитикаПереоценки, ЕСТЬNULL(НастройкиУчетаПрочиеСрезПоследних.АналитикаПереоценки, НастройкиУчетаКомиссииСрезПоследних.АналитикаПереоценки)) КАК АналитикаПереоценки,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ЗакрытиеКредитногоИнструмента.КредитныйИнструмент
		|		КОГДА ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) ССЫЛКА Документ.Сделка
		|			ТОГДА Сделка.Договор
		|		КОГДА ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) ССЫЛКА Документ.СделкаСНедвижимостью
		|			ТОГДА СделкаСНедвижимостью.Договор
		|		КОГДА ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) ССЫЛКА Документ.Оплата
		|			ТОГДА Оплата.Договор
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|	КОНЕЦ КАК Договор
		|ИЗ
		|	_БухУчетОстатки КАК _БухУчетОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ЗадолженностиСНастройками КАК ЗадолженностиСНастройками
		|		ПО _БухУчетОстатки.Субконто1 = ЗадолженностиСНастройками.Контрагент
		|			И (_БухУчетОстатки.Субконто2 = ВЫБОР
		|				КОГДА ЗадолженностиСНастройками.ОснованиеЗадолженности В (&ПроцентыПоЗаймуРПИ)
		|					ТОГДА НЕОПРЕДЕЛЕНО
		|				ИНАЧЕ ЗадолженностиСНастройками.ОснованиеЗадолженности
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И СчетУчетаПереоценки В
		|						(ВЫБРАТЬ
		|							_БухУчетОстатки.Счет КАК Счет
		|						ИЗ
		|							_БухУчетОстатки КАК _БухУчетОстатки)) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО _БухУчетОстатки.Счет = НастройкиУчетаКомиссииСрезПоследних.СчетУчетаПереоценки
		|			И (ЗадолженностиСНастройками.ТипЗадолженности ЕСТЬ NULL)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО (ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) = Сделка.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|		ПО (ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) = СделкаСНедвижимостью.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ПО (ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) = ЗакрытиеКредитногоИнструмента.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО (ЕСТЬNULL(_БухУчетОстатки.Субконто2, ЗадолженностиСНастройками.ОснованиеЗадолженности) = Оплата.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&ДатаПереоценки,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Прочее)) КАК НастройкиУчетаПрочиеСрезПоследних
		|		ПО (Оплата.ОбеспечительныйПлатеж)
		|			И (ЗадолженностиСНастройками.ТипЗадолженности ЕСТЬ NULL)";
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("АналитикаПереоценкиДебиторскойЗадолженности", НастройкиУчета.АналитикаПереоценкиДебиторскойЗадолженности);		

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчетаПереоценки) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПереоценки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для основания расчетов " + ВыборкаДетальныеЗаписи.ОснованиеРасчетов + " не удалось определить настройки переоценки",ЭтотОбъект,,,Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		Переоценка = ВыборкаДетальныеЗаписи.СуммаПереоценки - ВыборкаДетальныеЗаписи.СуммаОстаток;
		
		//При обнулении переоценки тип задолженности не важен, т.к. доход/расход определится по остатку на бух.счете
		Если ВыборкаДетальныеЗаписи.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Тогда
			Переоценка = -1 * Переоценка;
		КонецЕсли;
		
		Если Переоценка > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Переоценка, "Переоценка задолженности");
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоДт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.ОснованиеРасчетов;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Договор;
			
		ИначеЕсли Переоценка < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], -Переоценка, "Переоценка задолженности");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Договор;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.ОснованиеРасчетов;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//техдолг:Ругаться, если нет остатков, а переоценка зависла
	
КонецПроцедуры

Процедура БУНУ_ПереоценкаДоходныхВложенийВМатериальныеЦенности(Отказ)
	
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета КАК СчетУчета,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки
		|ПОМЕСТИТЬ _НастройкиУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаПереоценки,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДоходныеВложенияВМатериальныеЦенности), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВложенияВоВнеоборотныеАктивы))) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _БухУчетОстатки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ДатаПереоценки,
		|			Счет В
		|				(ВЫБРАТЬ
		|					_НастройкиУчета.СчетУчета КАК СчетУчета
		|				ИЗ
		|					_НастройкиУчета КАК _НастройкиУчета
		|			
		|				ОБЪЕДИНИТЬ ВСЕ
		|			
		|				ВЫБРАТЬ
		|					_НастройкиУчета.СчетУчетаПереоценки
		|				ИЗ
		|					_НастройкиУчета КАК _НастройкиУчета),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БухУчетОстаткиАктив.Счет КАК СчетБухОстатки,
		|	_БухУчетОстаткиАктив.Субконто1 КАК ОбъектНедвижимости,
		|	_БухУчетОстаткиАктив.СуммаОстаток КАК СуммаСебестоимость,
		|	ЕСТЬNULL(_БухУчетОстаткиПереоценка.СуммаОстаток, 0) КАК СуммаПереоценка,
		|	_НастройкиУчета.СчетУчета КАК СчетУчета,
		|	_НастройкиУчета.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	_НастройкиУчета.АналитикаДоходовОтПереоценки КАК АналитикаПереоценки,
		|	ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость КАК Стоимость,
		|	ОценкиСтоимостиПрочихАктивовСрезПоследних.ДатаОкончанияДействия КАК ДатаОкончанияДействия
		|ИЗ
		|	_БухУчетОстатки КАК _БухУчетОстаткиАктив
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НастройкиУчета КАК _НастройкиУчета
		|		ПО _БухУчетОстаткиАктив.Счет = _НастройкиУчета.СчетУчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостиПрочихАктивов.СрезПоследних(&ДатаПереоценки, ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.Недвижимость)) КАК ОценкиСтоимостиПрочихАктивовСрезПоследних
		|		ПО _БухУчетОстаткиАктив.Субконто1 = ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БухУчетОстатки КАК _БухУчетОстаткиПереоценка
		|		ПО (_БухУчетОстаткиПереоценка.Счет = _НастройкиУчета.СчетУчетаПереоценки)
		|			И _БухУчетОстаткиАктив.Субконто1 = _БухУчетОстаткиПереоценка.Субконто1";
	
	Запрос.УстановитьПараметр("ДатаПереоценки", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчетаПереоценки) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПереоценки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для объекта недвижимости " + ВыборкаДетальныеЗаписи.ОбъектНедвижимости + " не удалось определить настройки переоценки",ЭтотОбъект,,,Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		Переоценка = ВыборкаДетальныеЗаписи.Стоимость - ВыборкаДетальныеЗаписи.СуммаСебестоимость - ВыборкаДетальныеЗаписи.СуммаПереоценка;
		
		Если Переоценка > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Переоценка, "Переоценка объекта недвижимости");
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
		ИначеЕсли Переоценка < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], -Переоценка, "Переоценка объекта недвижимости");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоКт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура БУНУ_ПереоценкаИмущественныхПрав(УчетныйАктив, Отказ)
	
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета);
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.БухгалтерскийУчет);
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют настройки для указанной цели расчета!", ЭтотОбъект,,, Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Справочники.ОбъектыНедвижимости.ПоместитьОбъектыНедвижимостиДляСЧАВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, 
			ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, КонецДня(ЭтотОбъект.Дата), Отказ); 
			
	ВидПраваНаНедвижимость = Неопределено;
	Если УчетныйАктив = Справочники.УчетныеАктивы.Инвестконтракты Тогда
		ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Инвестконтракт;
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ДДУ Тогда
		ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.ДДУ;
	ИначеЕсли УчетныйАктив = Справочники.УчетныеАктивы.ПраваАренды Тогда
		ВидПраваНаНедвижимость = Перечисления.ВидыПравНаНедвижимость.Аренда;
	КонецЕсли;
			
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчета КАК СчетУчета,
		|	НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки
		|ПОМЕСТИТЬ _НастройкиУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаПереоценки,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И УчетныйАктив = &УчетныйАктив) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухгалтерскийУчетОстатки.Счет КАК Счет,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Субконто1,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК Субконто2,
		|	БухгалтерскийУчетОстатки.Субконто3 КАК Субконто3,
		|	БухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _БухУчетОстатки
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|			&ДатаПереоценки,
		|			Счет В
		|				(ВЫБРАТЬ
		|					_НастройкиУчета.СчетУчета КАК СчетУчета
		|				ИЗ
		|					_НастройкиУчета КАК _НастройкиУчета
		|			
		|				ОБЪЕДИНИТЬ ВСЕ
		|			
		|				ВЫБРАТЬ
		|					_НастройкиУчета.СчетУчетаПереоценки
		|				ИЗ
		|					_НастройкиУчета КАК _НастройкиУчета),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|		ПО БухгалтерскийУчетОстатки.Субконто2 = Договоры.Ссылка
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Инвестконтракты)
		|				ТОГДА Договоры.ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СтроительствоНаСвоемУчастке), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СтроительствоНаЧужомУчастке))
		|			КОГДА &УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ПраваАренды)
		|				ТОГДА Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Аренды)
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_БухУчетОстаткиАктив.Счет КАК СчетБухОстатки,
		|	_БухУчетОстаткиАктив.Субконто1 КАК Контрагент,
		|	_БухУчетОстаткиАктив.Субконто2 КАК Договор,
		|	_БухУчетОстаткиАктив.Субконто3 КАК ОбъектНедвижимости,
		|	_БухУчетОстаткиАктив.СуммаОстаток КАК СуммаСебестоимость,
		|	ЕСТЬNULL(_БухУчетОстаткиПереоценка.СуммаОстаток, 0) КАК СуммаПереоценка,
		|	_НастройкиУчета.СчетУчета КАК СчетУчета,
		|	_НастройкиУчета.СчетУчетаПереоценки КАК СчетУчетаПереоценки,
		|	_НастройкиУчета.АналитикаДоходовОтПереоценки КАК АналитикаПереоценки,
		|	ОценкиСтоимостиПрочихАктивовСрезПоследних.Стоимость КАК Стоимость,
		|	ОценкиСтоимостиПрочихАктивовСрезПоследних.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
		|	_БухУчетОстаткиАктив.Субконто3 ЕСТЬ NULL КАК НетДанныхБухУчета,
		|	_ОбъектыНедвижимости.ОбъектНедвижимости ЕСТЬ NULL КАК НетДанныхБэкОфиса,
		|	_ОбъектыНедвижимости.Основание КАК ОснованиеБэкОфис,
		|	_ОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимостиБэкОфис
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОбъектыНедвижимости.Основание КАК Основание,
		|		_ОбъектыНедвижимости.ОбъектНедвижимости КАК ОбъектНедвижимости
		|	ИЗ
		|		_ОбъектыНедвижимости КАК _ОбъектыНедвижимости
		|	ГДЕ
		|		_ОбъектыНедвижимости.ВидПраваНаНедвижимость = &ВидПраваНаНедвижимость) КАК _ОбъектыНедвижимости
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостьюОснование
		|		ПО _ОбъектыНедвижимости.Основание = СделкаСНедвижимостьюОснование.Ссылка
		|		ПОЛНОЕ СОЕДИНЕНИЕ _БухУчетОстатки КАК _БухУчетОстаткиАктив
		|		ПО _ОбъектыНедвижимости.ОбъектНедвижимости = _БухУчетОстаткиАктив.Субконто3
		|			И (СделкаСНедвижимостьюОснование.Договор = _БухУчетОстаткиАктив.Субконто2)
		|			И (СделкаСНедвижимостьюОснование.Контрагент = _БухУчетОстаткиАктив.Субконто1)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НастройкиУчета КАК _НастройкиУчета
		|		ПО (_БухУчетОстаткиАктив.Счет = _НастройкиУчета.СчетУчета)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БухУчетОстатки КАК _БухУчетОстаткиПереоценка
		|		ПО (_БухУчетОстаткиПереоценка.Счет = _НастройкиУчета.СчетУчетаПереоценки)
		|			И (_БухУчетОстаткиАктив.Субконто1 = _БухУчетОстаткиПереоценка.Субконто1)
		|			И (_БухУчетОстаткиАктив.Субконто2 = _БухУчетОстаткиПереоценка.Субконто2)
		|			И (_БухУчетОстаткиАктив.Субконто3 = _БухУчетОстаткиПереоценка.Субконто3)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиСтоимостиПрочихАктивов.СрезПоследних(&ДатаПереоценки, ВидАктива В (ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ИмущественныеПрава), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ПраваАренды))) КАК ОценкиСтоимостиПрочихАктивовСрезПоследних
		|		ПО (_БухУчетОстаткиАктив.Субконто3 = ОценкиСтоимостиПрочихАктивовСрезПоследних.СубъектАналитики)";
	
	Запрос.УстановитьПараметр("ДатаПереоценки", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("УчетныйАктив", УчетныйАктив);
	Запрос.УстановитьПараметр("ВидПраваНаНедвижимость", ВидПраваНаНедвижимость);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.НетДанныхБэкОфиса Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По данным бэк-офиса объекта недвижимости " 
				+ ВыборкаДетальныеЗаписи.ОбъектНедвижимости + " по договору " + ВыборкаДетальныеЗаписи.Договор + " не числится ", ЭтотОбъект,,, Отказ);
		ИначеЕсли ВыборкаДетальныеЗаписи.НетДанныхБухУчета Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По данным регистра " + ЭтотОбъект.ВидУчета
				+ " объекта недвижимости " + ВыборкаДетальныеЗаписи.ОбъектНедвижимостиБэкОфис + " по основанию "
				+ ВыборкаДетальныеЗаписи.ОснованиеБэкОфис + " не числится ", ЭтотОбъект,,, Отказ);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчетаПереоценки) 
			ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПереоценки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для " + ВыборкаДетальныеЗаписи.ОбъектНедвижимости
				+ " не удалось определить настройки переоценки", ЭтотОбъект,,, Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		Переоценка = ВыборкаДетальныеЗаписи.Стоимость - ВыборкаДетальныеЗаписи.СуммаСебестоимость - ВыборкаДетальныеЗаписи.СуммаПереоценка;
		
		Если Переоценка > 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Переоценка, "Переоценка прав");
			
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоДт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			Проводка.СубконтоДт.Договоры = ВыборкаДетальныеЗаписи.Договор;
			Проводка.СубконтоДт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Договор;
			
		ИначеЕсли Переоценка < 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], -Переоценка, "Переоценка прав");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = ВыборкаДетальныеЗаписи.АналитикаПереоценки;
			Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.Договор;
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.СчетУчетаПереоценки;
			Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
			Проводка.СубконтоКт.Договоры = ВыборкаДетальныеЗаписи.Договор;
			Проводка.СубконтоКт.ОбъектыНедвижимости = ВыборкаДетальныеЗаписи.ОбъектНедвижимости;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета,
		Отказ);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);
	
	Движения[УчетныйРегистр].Записывать = Истина;
	Движения[УчетныйРегистр].Очистить();
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		
		ОбработкаПроведенияЕПС(Отказ, Режим);
		Возврат;
		
	КонецЕсли;		
	
	ПереоцениватьЗадолженностьДСПоСделкамТПлюс = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьЗадолженностьДСПоСделкамТПлюс", ПереоцениватьЗадолженностьДСПоСделкамТПлюс) Тогда
		ПереоцениватьЗадолженностьДСПоСделкамТПлюс = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.ЗадолженностьДСПоСделкамТПлюс, ВидУчета);
	КонецЕсли;
	Если ПереоцениватьЗадолженностьДСПоСделкамТПлюс Тогда
		БУНУ_ПереоценкаЗадолженностейПоСделкамТПлюс(Отказ, УчетныйРегистр);
	КонецЕсли;
	
	СтруктураПереоценки = Новый Структура("ПереоцениватьПрямоеРЕПО, ПереоцениватьОбратноеРЕПО, ТолькоПервоначальноеПризнаниеПрямогоРЕПО, ТолькоПервоначальноеПризнаниеОбратногоРЕПО", Ложь, Ложь, Ложь, Ложь);
	
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьРасчетыПоПрямомуРЕПО", СтруктураПереоценки.ПереоцениватьПрямоеРЕПО) Тогда
		СтруктураПереоценки.ПереоцениватьПрямоеРЕПО = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО, ВидУчета, СтруктураПереоценки.ТолькоПервоначальноеПризнаниеПрямогоРЕПО);
	Иначе
		ЭтотОбъект.ДополнительныеСвойства.Свойство("ТолькоПервоначальноеПризнаниеПрямогоРЕПО", СтруктураПереоценки.ТолькоПервоначальноеПризнаниеПрямогоРЕПО)		
	КонецЕсли;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьРасчетыПоОбратномуРЕПО", СтруктураПереоценки.ПереоцениватьОбратноеРЕПО) Тогда
		СтруктураПереоценки.ПереоцениватьОбратноеРЕПО = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО, ВидУчета, СтруктураПереоценки.ТолькоПервоначальноеПризнаниеОбратногоРЕПО);
	Иначе
		ЭтотОбъект.ДополнительныеСвойства.Свойство("ТолькоПервоначальноеПризнаниеОбратногоРЕПО", СтруктураПереоценки.ТолькоПервоначальноеПризнаниеОбратногоРЕПО);
	КонецЕсли;

	Если СтруктураПереоценки.ПереоцениватьПрямоеРЕПО ИЛИ СтруктураПереоценки.ПереоцениватьОбратноеРЕПО Тогда
		
		БУНУ_НачислитьПроцентыПоРЕПО(СтруктураПереоценки, Отказ);
		
		Если НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности
			ИЛИ НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичностиСОтражениемНаСчетеРасчетов Тогда
		    БУНУ_ПереоценитьКомиссиюПоРЕПО(НастройкиПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО, УчетныйРегистр);
		КонецЕсли;
	КонецЕсли;
	
	ПереоцениватьЗадолженности = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьЗадолженности", ПереоцениватьЗадолженности) Тогда
		ПереоцениватьЗадолженности = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаЗадолженностей(Дата, Организация, СчетДоверительногоУправления, ВидУчета);
	КонецЕсли;
	Если ПереоцениватьЗадолженности Тогда
		БУНУ_ПереоценитьЗадолженность(Отказ);
	КонецЕсли;

	ПереоцениватьДоходныеВложенияВМатериальныеЦенности = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьДоходныеВложенияВМатериальныеЦенности", ПереоцениватьДоходныеВложенияВМатериальныеЦенности) Тогда
		ПереоцениватьДоходныеВложенияВМатериальныеЦенности = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.ДоходныеВложенияВМатериальныеЦенности, ВидУчета);
	КонецЕсли;
	Если ПереоцениватьДоходныеВложенияВМатериальныеЦенности Тогда
		БУНУ_ПереоценкаДоходныхВложенийВМатериальныеЦенности(Отказ);
	КонецЕсли;
	
	ПереоцениватьИнвестконтракты = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьИнвестконтракты", ПереоцениватьИнвестконтракты) Тогда
		ПереоцениватьИнвестконтракты = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.Инвестконтракты, ВидУчета);
	КонецЕсли;
	Если ПереоцениватьИнвестконтракты Тогда
		БУНУ_ПереоценкаИмущественныхПрав(Справочники.УчетныеАктивы.Инвестконтракты, Отказ);
	КонецЕсли;
	
	ПереоцениватьПраваАренды = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПереоцениватьПраваАренды", ПереоцениватьПраваАренды) Тогда
		ПереоцениватьПраваАренды = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.НужнаПереоценкаПоАктиву(Дата, Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.ПраваАренды, ВидУчета);
	КонецЕсли;
	Если ПереоцениватьПраваАренды Тогда
		БУНУ_ПереоценкаИмущественныхПрав(Справочники.УчетныеАктивы.ПраваАренды, Отказ);
	КонецЕсли;
	
	ПризнатьРасходыПоБиржевымДепозитам = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ПризнатьРасходыПоБиржевымДепозитам", ПризнатьРасходыПоБиржевымДепозитам) Тогда
		ПризнатьРасходыПоБиржевымДепозитам = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.Нужно_ПризнатьРасходыПоБиржевымДепозитам(Дата, Организация, СчетДоверительногоУправления, ВидУчета);
	КонецЕсли;
	Если ПризнатьРасходыПоБиржевымДепозитам Тогда
		БУНУ_ПризнатьРасходыПоБиржевымДепозитам(Отказ);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЕПС_ПризнатьРасходыПоБиржевымДепозитам(Отказ)
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(ЭтотОбъект.Дата,
	ЭтотОбъект.Организация,
	ЭтотОбъект.СчетДоверительногоУправления,
	ЭтотОбъект.ВидУчета,
	Отказ);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
	
	Если НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности
		ИЛИ НастройкиПоВидуУчета.МетодПризнанияРасходовПоБиржевымДепозитам = Перечисления.МетодыПризнанияРасходовПоСделкам.ПриНачислении Тогда
		
		ГФУКомиссий = ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("Комиссионные_расходы_затраты_по_сделке");//Справочники.ГруппыФинансовогоУчетаДоходовРасходов.НайтиПоКоду("31322"); // пока хардкод т.к. еще не устоялась ситуация
		
		СчетУчетаДоходов = ПланыСчетов.Единый.НайтиПоКоду(ГФУКомиссий.НомерСчетаБухгалтерскогоУчета); // именно доходов т.к. комиссии уменьшают доход
		
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДепозитныеВклады);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
			|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.БанковскийСчет КАК БанковскиеСчета,
			|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК ДепозитныеВклады,
			|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации КАК ДатаРегистрации,
			|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК ВсегоДней,
			|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, НАЧАЛОПЕРИОДА(&ДатаПериода, ДЕНЬ), ДЕНЬ) КАК ДнейПрошло,
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
			|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СУММА(ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт, 0)) КАК СуммаОплаченоОстаток,
			|	СУММА(ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0)) КАК ВалютнаяСуммаОплаченоОстаток,
			|	СУММА(ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки05.СуммаОстатокКт, 0)) КАК СуммаКомиссииПризнаноРанееОстаток,
			|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0)) КАК СуммаКомиссии,
			|	СУММА(ЕдиныйБухгалтерскийУчетОбороты05.СуммаОборотКт) КАК СуммаКомиссииПризнаноРанееОборот
			|ИЗ
			|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
			|			&Период,
			|			ДатаНачалаДействияУсловий <= &ДатаПериода
			|				И КредитныйИнструмент.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК УсловияКредитныхИнструментовСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|				&Период,
			|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты07),
			|				&ВидыСубконто,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
			|		ПО (ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
			|			И (ЕдиныйБухгалтерскийУчетОстатки.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|				&Период,
			|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты05),
			|				&ВидыСубконто,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки05
			|		ПО (ЕдиныйБухгалтерскийУчетОстатки05.Субконто2 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
			|			И (ЕдиныйБухгалтерскийУчетОстатки05.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И Активный) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
			|		ПО УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.БанковскийСчет.Договор = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор
			|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ПО (ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствам.Основание КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
			|			И (ЗадолженностиПоДенежнымСредствам.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
			|			И (ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.НачислениеЗадолженности))
			|			И (ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
			|			И (ЗадолженностиПоДенежнымСредствам.Активность)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
			|				,
			|				&Период,
			|				Период,
			|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты05),
			|				&ВидыСубконто,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления,
			|				КорСчет = &СчетУчетаДоходов,
			|				) КАК ЕдиныйБухгалтерскийУчетОбороты05
			|		ПО (ЕдиныйБухгалтерскийУчетОбороты05.Субконто2 = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
			|			И (ЕдиныйБухгалтерскийУчетОбороты05.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
			|ГДЕ
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения >= &Период
			|	И УсловияКредитныхИнструментовСрезПоследних.Действует
			|
			|СГРУППИРОВАТЬ ПО
			|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.БанковскийСчет,
			|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент,
			|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации,
			|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ),
			|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, НАЧАЛОПЕРИОДА(&ДатаПериода, ДЕНЬ), ДЕНЬ),
			|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения,
			|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствам.Валюта";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("ДатаПериода", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СчетУчетаДоходов", СчетУчетаДоходов);
		Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			
			СчетКомиссий = ПланыСчетов.Единый.Депозиты07;
			СчетРасчетов = ПланыСчетов.Единый.Депозиты05;
			
			Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления);
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				КоличествоДнейОстаток = ОбщегоНазначенияКлиентСервер.РазностьДатВДнях(ВыборкаДетальныеЗаписи.ДатаПогашения, ЭтотОбъект.Дата);
				
				СуммаНачисление = 0;
				Если ЗначениеЗаполнено(КоличествоДнейОстаток) Тогда
					СуммаНачисление = Окр((ВыборкаДетальныеЗаписи.СуммаКомиссии - ВыборкаДетальныеЗаписи.СуммаКомиссииПризнаноРанееОборот)/КоличествоДнейОстаток, 2);
					
					// Начисление
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаНачисление, "Списание расходов");	
					
					
					Проводка.СчетДт = СчетУчетаДоходов;
					
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКомиссий;
					Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ДепозитныеВклады;
					
					
					Проводка.СчетКт = СчетРасчетов;
					
					Проводка.СубконтоКт.БанковскиеСчета = ВыборкаДетальныеЗаписи.БанковскиеСчета;
					Проводка.СубконтоКт.ДепозитныеВклады = ВыборкаДетальныеЗаписи.ДепозитныеВклады;
					
					Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
					Проводка.ВалютнаяСуммаКт = СуммаНачисление;
					
				КонецЕсли;	
				
				
				СуммаПризнание = Мин(ВыборкаДетальныеЗаписи.СуммаОплаченоОстаток, (СуммаНачисление + ВыборкаДетальныеЗаписи.СуммаКомиссииПризнаноРанееОстаток));
					
				// Признание
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПризнание, "Списание расходов");	
				
				Проводка.СчетДт = СчетРасчетов;
				
				Проводка.СубконтоДт.БанковскиеСчета = ВыборкаДетальныеЗаписи.БанковскиеСчета;
				Проводка.СубконтоДт.ДепозитныеВклады = ВыборкаДетальныеЗаписи.ДепозитныеВклады;
				
				Проводка.ВалютаДт = ВыборкаДетальныеЗаписи.Валюта;
				Проводка.ВалютнаяСуммаДт = СуммаПризнание;
				
				
				Проводка.СчетКт = СчетКомиссий;
				
				Проводка.СубконтоКт.БанковскиеСчета = ВыборкаДетальныеЗаписи.БанковскиеСчета;
				Проводка.СубконтоКт.ДепозитныеВклады = ВыборкаДетальныеЗаписи.ДепозитныеВклады;
				
				Проводка.ВалютаКт = ВыборкаДетальныеЗаписи.Валюта;
				Проводка.ВалютнаяСуммаКт = СуммаПризнание;
				
				
				Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПризнание, "Списание расходов");	
					
					Проводка.СчетДт 				= ПланыСчетов.Единый.АктивыВДУ03;
					Проводка.СубконтоДт.Договоры 	= ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
					
					Проводка.СчетКт = СчетУчетаДоходов;
					
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУКомиссий;
					Проводка.СубконтоКт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ДепозитныеВклады;
					
				КонецЕсли;	
				
				
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

Процедура БУНУ_ПризнатьРасходыПоБиржевымДепозитам(Отказ)
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Сделка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.БанковскийСчет КАК БанковскиеСчета,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК ДепозитныеВклады,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации КАК ДатаРегистрации,
		|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ) КАК ВсегоДней,
		|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, НАЧАЛОПЕРИОДА(&ДатаПериода, ДЕНЬ), ДЕНЬ) КАК ДнейПрошло,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстатокДт, 0)) КАК СуммаОплаченоОстаток,
		|	СУММА(ЕСТЬNULL(БухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0)) КАК ВалютнаяСуммаОплаченоОстаток,
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0)) КАК СуммаКомиссии,
		|	БухгалтерскийУчетОстатки.Субконто1 КАК Контрагент,
		|	БухгалтерскийУчетОстатки.Субконто2 КАК Сделка
		|ИЗ
		|	РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|			&Период,
		|			ДатаНачалаДействияУсловий <= &ДатаПериода
		|				И КредитныйИнструмент.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии),
		|				&ВидыСубконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстатки
		|		ПО (ВЫРАЗИТЬ(БухгалтерскийУчетОстатки.Субконто2 КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
		|			И (БухгалтерскийУчетОстатки.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Активный) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ПО УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.БанковскийСчет.Договор = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ПО (ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствам.Основание КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент)
		|			И (ЗадолженностиПоДенежнымСредствам.Организация = УсловияКредитныхИнструментовСрезПоследних.Организация)
		|			И (ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.НачислениеЗадолженности))
		|			И (ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
		|			И (ЗадолженностиПоДенежнымСредствам.Активность)
		|ГДЕ
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения >= &Период
		|	И УсловияКредитныхИнструментовСрезПоследних.Действует
		|
		|СГРУППИРОВАТЬ ПО
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.БанковскийСчет,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент,
		|	УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации,
		|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения, ДЕНЬ),
		|	РАЗНОСТЬДАТ(УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент.ДатаРегистрации, НАЧАЛОПЕРИОДА(&ДатаПериода, ДЕНЬ), ДЕНЬ),
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения,
		|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствам.Валюта,
		|	БухгалтерскийУчетОстатки.Субконто1,
		|	БухгалтерскийУчетОстатки.Субконто2
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЕСТЬNULL(ЗадолженностиПоДенежнымСредствам.Сумма, 0)) <> 0 И
		|	СУММА(ЕСТЬNULL(БухгалтерскийУчетОстатки.СуммаОстатокДт, 0)) <> 0";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаПериода", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", УчетныйРегистр);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		АналитикаПереоценки = БухгалтерскийУчет.ОпределитьНастройкуУчетаКомиссии(
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления, 
		Справочники.ВидыЗадолженности.ПоТорговойКомиссии, 
		УчетныйРегистр, 
		"АналитикаПереоценки",
		Истина);
		
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СуммаНачисление = 0;
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВсегоДней) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СуммаКомиссии) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СуммаОплаченоОстаток) Тогда
				СуммаНачисление = Мин(Окр((ВыборкаДетальныеЗаписи.СуммаКомиссии) / ВыборкаДетальныеЗаписи.ВсегоДней * ВыборкаДетальныеЗаписи.ДнейПрошло, 2) - (ВыборкаДетальныеЗаписи.СуммаКомиссии - ВыборкаДетальныеЗаписи.СуммаОплаченоОстаток), ВыборкаДетальныеЗаписи.СуммаОплаченоОстаток);
				
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаНачисление, "Списание расходов");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.РасчетыПоТорговойКомиссии;
				Проводка.СубконтоДт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
				Проводка.СубконтоДт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоКомиссии;
				Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
				Проводка.СубконтоКт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
				
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаНачисление, "Списание расходов");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
				Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПереоценки;
				Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ДепозитныеВклады;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоТорговойКомиссии;
				Проводка.СубконтоКт.Контрагенты = ВыборкаДетальныеЗаписи.Контрагент;
				Проводка.СубконтоКт.Сделка = ВыборкаДетальныеЗаписи.Сделка;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти
