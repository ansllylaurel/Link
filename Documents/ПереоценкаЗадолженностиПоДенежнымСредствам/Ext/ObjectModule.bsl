
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	//ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "");
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведенияЕПС(Отказ, Режим)
	
	ЕПС_ГлаваБ_НачислитьПроцентыПоРЕПО(Отказ);
	
	ЕПС_ПереоценитьКомиссиюПоРЕПО();
	
	ЕПС_ГлаваГ_НачислитьКурсовуюРазницу();
	
	ЕПС_ПризнатьРасходыПоБиржевымДепозитам(Отказ);
	
	ЕПС_ПереоценитьСПФИ();
	
КонецПроцедуры

Процедура ЕПС_ГлаваБ_НачислитьПроцентыПоРЕПО(Отказ)

	Переоценивать = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО", Переоценивать) Тогда
		Переоценивать = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.Нужно_ГлаваБ_НачислитьПроцентыПоРЕПО(Дата, Организация, СчетДоверительногоУправления);
	КонецЕсли;
	
	Если НЕ Переоценивать Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);
	
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета,
		Отказ);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
	
	ВариантРасчетаПроцентовПоСделкамРЕПО = НастройкиПоВидуУчета.ВариантРасчетаПроцентовПоСделкамРЕПО;
			
	// С 1го сентября решено использовать "реального" контрагента по д/с в репо и процентам по репо
	// на 1ое сентября будет(возрожно) сторно старых проводок
	// контрагентом по комиссии остается брокер
	
	// ПРОЦЕНТЫ ПО РЕПО
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокРЕПОСрезПоследних.Сумма + УсловияСделокРЕПОСрезПоследних.СуммаКупона КАК СуммаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК ДатаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СтавкаРЕПО КАК СтавкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК Дата,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Контрагент КАК Контрагент,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Брокер.ЮрФизЛицо КАК Брокер,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) - ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки1.ВалютнаяСуммаОстаток, 0) КАК НачисленныеПроцентыПоРЕПО,
		|	УсловияСделокРЕПОСрезПоследних1.Сумма + УсловияСделокРЕПОСрезПоследних1.СуммаКупона КАК СуммаЗакрытияРЕПО,
		|	УсловияСделокРЕПОСрезПоследних1.ДатаВторойЧастиРЕПО КАК ДатаЗакрытияРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.ВидСделки КАК ВидСделки
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодУсловий,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В (&СчетаПроцентовДоход),
		|				&ВидыСубконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|			И УсловияСделокРЕПОСрезПоследних.ВалютаОплаты = ЕдиныйБухгалтерскийУчетОстатки.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В (&СчетаПроцентовРасход),
		|				&ВидыСубконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки1
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = ЕдиныйБухгалтерскийУчетОстатки1.Субконто1
		|			И УсловияСделокРЕПОСрезПоследних.ВалютаОплаты = ЕдиныйБухгалтерскийУчетОстатки1.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ПериодУсловий,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияСделокРЕПОСрезПоследних1
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = УсловияСделокРЕПОСрезПоследних1.СделкаРЕПО
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ДатаПереоценки";

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	СчетаПроцентовДоход = Новый Массив;
	СчетаПроцентовДоход.Добавить(ПланыСчетов.Единый.ПрочиеСредства11);
	СчетаПроцентовДоход.Добавить(ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг22);
	
	СчетаПроцентовРасход = Новый Массив;
	СчетаПроцентовРасход.Добавить(ПланыСчетов.Единый.ПрочиеСредства22);
	СчетаПроцентовРасход.Добавить(ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг09);
		
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПериодУсловий", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("СчетаПроцентовДоход", СчетаПроцентовДоход);
	Запрос.УстановитьПараметр("СчетаПроцентовРасход", СчетаПроцентовРасход);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Реквизиты = Новый Структура("Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов");
		ЗаполнитьЗначенияСвойств(Реквизиты, ВыборкаДетальныеЗаписи);
		Реквизиты.Ссылка = ВыборкаДетальныеЗаписи.СделкаРЕПО;
		КонтрагентПоСделке = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(Реквизиты, НастройкиУчета);
		
		Если ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРавномерномуРаспределениюПоДням Тогда
			
			ЗадолженностьПоРЕПО = РаботаСоСделкамиРЕПО.РассчитатьЗадолженностьПоСделкеРЕПОПоРавномерномуРаспределениюПоДням(
				ВыборкаДетальныеЗаписи.СуммаРЕПО,
				ВыборкаДетальныеЗаписи.СуммаЗакрытияРЕПО,
				ВыборкаДетальныеЗаписи.ДатаРЕПО,
				ВыборкаДетальныеЗаписи.ДатаЗакрытияРЕПО,
				НачалоДня(ЭтотОбъект.Дата));
			
		ИначеЕсли ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоСтавкеОтПервойЧастиРЕПО Тогда
				
			ЗадолженностьПоРЕПО = РаботаСоСделкамиРЕПО.РассчитатьСправедливуюСтоимостьЗадолженностиПоСделкеРЕПО(
				ВыборкаДетальныеЗаписи.СуммаРЕПО,
				ВыборкаДетальныеЗаписи.СтавкаРЕПО,
				ВыборкаДетальныеЗаписи.ДатаРЕПО,
				НачалоДня(ЭтотОбъект.Дата));
				
		ИначеЕсли ВариантРасчетаПроцентовПоСделкамРЕПО = Перечисления.ВариантыРасчетаПроцентовПоСделкамРЕПО.ПоРасчетнойСтавке Тогда
			
			РазрядностьОкругления = 8;
				
			РасчетнаяСтавка = РаботаСоСделкамиРЕПО.РассчитатьСтавкуРЕПО(ВыборкаДетальныеЗаписи.СуммаРЕПО,
				ВыборкаДетальныеЗаписи.СуммаЗакрытияРЕПО,
				ВыборкаДетальныеЗаписи.ДатаРЕПО,
				ВыборкаДетальныеЗаписи.ДатаЗакрытияРЕПО,
				РазрядностьОкругления);
			
			ЗадолженностьПоРЕПО = РаботаСоСделкамиРЕПО.РассчитатьСправедливуюСтоимостьЗадолженностиПоСделкеРЕПО(
				ВыборкаДетальныеЗаписи.СуммаРЕПО,
				РасчетнаяСтавка,
				ВыборкаДетальныеЗаписи.ДатаРЕПО,
				НачалоДня(ЭтотОбъект.Дата));
				
		КонецЕсли;
			
		ПроцентыПоРЕПО = ЗадолженностьПоРЕПО - ВыборкаДетальныеЗаписи.СуммаРЕПО - ВыборкаДетальныеЗаписи.НачисленныеПроцентыПоРЕПО;
			
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПроцентыПоРЕПО, ВыборкаДетальныеЗаписи.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
		
		ЦеннаяБумага = ВыборкаДетальныеЗаписи.СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
		
		Если ВыборкаДетальныеЗаписи.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Если ПроцентыПоРЕПО > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Проценты по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства11;
				
				Проводка.СубконтоДт.Контрагенты       = КонтрагентПоСделке;
				Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СделкаРЕПО;
				
				Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = ПроцентыПоРЕПО;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентПоСделке, ЭтотОбъект.Дата);
				Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
				
			ИначеЕсли ПроцентыПоРЕПО < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -СуммаОперации, "Проценты по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеРасходы01;
				
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентПоСделке, ЭтотОбъект.Дата);
				Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства22;
				
				Проводка.СубконтоКт.Контрагенты       = КонтрагентПоСделке;
				Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СделкаРЕПО;
				
				Проводка.ВалютаКт  = ВыборкаДетальныеЗаписи.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = -ПроцентыПоРЕПО;
				
			КонецЕсли;
		Иначе
			Если ПроцентыПоРЕПО > 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Проценты по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеРасходы01;
				
				Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхРасходовПоПривлеченнымСредствам(КонтрагентПоСделке, ЭтотОбъект.Дата);
				Проводка.СубконтоДт.ЦенныеБумаги         = ЦеннаяБумага;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг09;
				
				Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СделкаРЕПО;
				
				Проводка.ВалютаКт  = ВыборкаДетальныеЗаписи.ВалютаСделки;
				Проводка.ВалютнаяСуммаКт = ПроцентыПоРЕПО;
				
			ИначеЕсли ПроцентыПоРЕПО < 0 Тогда
				
				Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -СуммаОперации, "Проценты по РЕПО");
				
				// дебет
				Проводка.СчетДт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг22;
				
				Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
				Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СделкаРЕПО;
				
				Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.ВалютаСделки;
				Проводка.ВалютнаяСуммаДт = -ПроцентыПоРЕПО;
				
				// кредит
				Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы01;
				
				Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУПроцентныхДоходовПоСредствамПредоставленнымКонтрагенту(КонтрагентПоСделке, ЭтотОбъект.Дата);
				Проводка.СубконтоКт.ЦенныеБумаги         = ЦеннаяБумага;
				
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

Процедура ЕПС_ПереоценитьКомиссиюПоРЕПО()

	Переоценивать = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО", Переоценивать) Тогда
		Переоценивать = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.Нужно_ЕПС_ПереоценитьКомиссиюПоРЕПО(Дата, Организация, СчетДоверительногоУправления);
	КонецЕсли;
	
	Если НЕ Переоценивать Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		Дата, 
		Организация, 
		СчетДоверительногоУправления);
		
	Отказ = Ложь;
		
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет,
		Отказ);	
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", СчетДоверительногоУправления, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, Дата));
		Возврат;
	КонецЕсли;
		
	Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
	
		ТЗПогрешности = Новый ТаблицаЗначений;
		
		ТЗПогрешности.Колонки.Добавить("СделкаРЕПО", Новый ОписаниеТипов("ДокументСсылка.СделкаРЕПО"));
		ТЗПогрешности.Колонки.Добавить("Погрешность", Новый ОписаниеТипов("Число"));
		ТЗПогрешности.Колонки.Добавить("ПогрешностьВВалютеУчета", Новый ОписаниеТипов("Число"));
		ТЗПогрешности.Колонки.Добавить("Проводки");
		
	КонецЕсли;
		
		
	// воткнул т.к. задача ставилась НЕПРАВИЛЬНО и теперь затыкаю дыру	
	РаботаСОтчетами.КонтрольВалютыРасходовПоСделкамОтличнойОтВалютыУчета(ЭтотОбъект.СчетДоверительногоУправления, Неопределено, Неопределено);
	
	Закрывать7ойРазделПриПоступленииДенежныхСредств = БухгалтерскийУчет.Закрывать7ойРазделПриПоступленииДенежныхСредств(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	// торговая комиссия - "размазываем"
	ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходыПоКомиссии.СуммаОборот КАК КомиссияПоРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК СделкаРЕПОДата,
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
		|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ) КАК ВсегоДней,
		|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, &ДатаПереоценки, ДЕНЬ) КАК ДнейПрошло,
		|	РасходыПоКомиссии.Валюта КАК Валюта
		|ПОМЕСТИТЬ СделкиРЕПОПроценты
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодДата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				&ПериодДата,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоКомиссии
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = РасходыПоКомиссии.Сделка
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ПериодДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиРЕПОПроценты.СделкаРЕПО КАК СделкаРЕПО,
		|	СделкиРЕПОПроценты.СделкаРЕПО.Брокер.ЮрФизЛицо КАК Контрагент,
		|	СделкиРЕПОПроценты.СделкаРЕПО.Контрагент КАК КонтрагентПоСделке,
		|	СделкиРЕПОПроценты.СделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	СделкиРЕПОПроценты.ВсегоДней КАК ВсегоДней,
		|	СделкиРЕПОПроценты.ДнейПрошло КАК ДнейПрошло,
		|	СделкиРЕПОПроценты.КомиссияПоРЕПО КАК КомиссияПоРЕПОВсего,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК КомиссияПоРЕПОНачислено,
		|	(ВЫРАЗИТЬ(СделкиРЕПОПроценты.КомиссияПоРЕПО * СделкиРЕПОПроценты.ДнейПрошло / СделкиРЕПОПроценты.ВсегоДней КАК ЧИСЛО(19, 2))) - (СделкиРЕПОПроценты.КомиссияПоРЕПО - ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0)) КАК НачислитьКомиссии,
		|	СделкиРЕПОПроценты.Валюта КАК Валюта
		|ИЗ
		|	СделкиРЕПОПроценты КАК СделкиРЕПОПроценты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В (&СчетаУчетаКомиссий),
		|				&ВидыСубконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЛицевойСчет.ДополнительнаяАналитика = &ДополнительнаяАналитика) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО СделкиРЕПОПроценты.СделкаРЕПО = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|			И СделкиРЕПОПроценты.Валюта = ЕдиныйБухгалтерскийУчетОстатки.Валюта";
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	СчетаУчетаКомиссий = Новый Массив;
	СчетаУчетаКомиссий.Добавить(ПланыСчетов.Единый.ПрочиеСредства19);
	СчетаУчетаКомиссий.Добавить(ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19);
		
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ДополнительнаяАналитика", ДополнительнаяАналитика);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ПериодДата", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СчетаУчетаКомиссий", СчетаУчетаКомиссий);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.НачислитьКомиссии > 0 Тогда
			
			СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			ЦеннаяБумага = ВыборкаДетальныеЗаписи.СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
			СделкаРЕПО = ВыборкаДетальныеЗаписи.СделкаРЕПО;
			
			КонтрагентПоСделке = ВыборкаДетальныеЗаписи.КонтрагентПоСделке;
			// некоторые клиенты не хотят раскрывать реального контрагента по репо и требуют отображать брокера
			Если НастройкиУчета.ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО Тогда
				КонтрагентПоСделке = ВыборкаДетальныеЗаписи.Контрагент;
			КонецЕсли;
			
			ПроводкиТорговойКомиссии = Новый Массив;
			
			ЕПС_ПризнатьКомиссиюПоРЕПО(СуммаОперации,
										СуммаКомиссии,
										СделкаРЕПО,
										ВыборкаДетальныеЗаписи.Валюта,
										УчетныйАктив,
										ЦеннаяБумага,
										КонтрагентПоСделке,
										ВыборкаДетальныеЗаписи.Контрагент,
										ДополнительнаяАналитика,
										Закрывать7ойРазделПриПоступленииДенежныхСредств,
										ПроводкиТорговойКомиссии);
			
			Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
				
				Погрешность = ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего * ВыборкаДетальныеЗаписи.ДнейПрошло / ВыборкаДетальныеЗаписи.ВсегоДней
								- (ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего - ВыборкаДетальныеЗаписи.КомиссияПоРЕПОНачислено)
								- ВыборкаДетальныеЗаписи.НачислитьКомиссии;
								
				ПогрешностьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Погрешность, ВыборкаДетальныеЗаписи.СделкаРЕПО.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);								
				
				
				СтрокиПогрешности = ТЗПогрешности.НайтиСтроки(Новый Структура("СделкаРЕПО", СделкаРЕПО));
				Если СтрокиПогрешности.Количество() = 0 Тогда
					СтрокаПогрешности = ТЗПогрешности.Добавить();
					СтрокаПогрешности.СделкаРЕПО = СделкаРЕПО;
					СтрокаПогрешности.Проводки = ПроводкиТорговойКомиссии;
				Иначе
					СтрокаПогрешности = СтрокиПогрешности[0];
				КонецЕсли;
				
				СтрокаПогрешности.Погрешность = СтрокаПогрешности.Погрешность + Погрешность;
				СтрокаПогрешности.ПогрешностьВВалютеУчета = СтрокаПогрешности.ПогрешностьВВалютеУчета + ПогрешностьВВалютеУчета;
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Комиссия брокера
	
	// Итак, тут сделано проведение по "правильной" схеме, до 1.1.18 все проведене было не очень правильно (мягко говоря).
	// По большинству клиентов 18й год проводили, но были и такие по которым только с февраля провели
	// К сожалению эта периодичность тут не зашита
	// Проведение этого документа ранее 1.1.18 меняет проводки, и Таня К.(и остальные бухгалтера) в курсе
	// 
	// С 1го марта 18го схема опять изменилась, но это уже тут учитывается
	//
	
	ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера;
	
	// ГПБ ведет себя аналогично бирже - начисляет комиссию 1 раз и сразу поэтому ее тоже размазываем
	//
	// БК до 1.3.18 ведет себя "плохо" (и это реализовано в следующем блоке)
	// но с 1.3.18 начинает вести себя "хорошо", как ГПБ
	// 
	// как оказалось в трасте по НГ ПР и Традиции ПР на новую схему перешли только с 1го апреля...
	//
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(РасходыПоКомиссии.СуммаОборот, 0) КАК КомиссияПоРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК СделкаРЕПОДата,
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
		|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ) КАК ВсегоДней,
		|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, &ДатаПереоценки, ДЕНЬ) КАК ДнейПрошло,
		|	РасходыПоКомиссии.Валюта КАК Валюта
		|ПОМЕСТИТЬ СделкиРЕПОПроценты
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодДата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ЧастьСделкиРЕПО = 1
		|				И СделкаРЕПО.Брокер = &БрокерГПБ) КАК УсловияСделокРЕПОСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				,
		|				&ПериодДата,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&СписокСтратегий)
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоКомиссии
		|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = РасходыПоКомиссии.Сделка
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ПериодДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиРЕПОПроценты.СделкаРЕПО КАК СделкаРЕПО,
		|	СделкиРЕПОПроценты.СделкаРЕПО.Брокер.ЮрФизЛицо КАК Контрагент,
		|	СделкиРЕПОПроценты.СделкаРЕПО.Контрагент КАК КонтрагентПоСделке,
		|	СделкиРЕПОПроценты.СделкаРЕПО.ВалютаСделки КАК ВалютаСделки,
		|	СделкиРЕПОПроценты.ВсегоДней КАК ВсегоДней,
		|	СделкиРЕПОПроценты.ДнейПрошло КАК ДнейПрошло,
		|	СделкиРЕПОПроценты.КомиссияПоРЕПО КАК КомиссияПоРЕПОВсего,
		|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК КомиссияПоРЕПОНачислено,
		|	(ВЫРАЗИТЬ(СделкиРЕПОПроценты.КомиссияПоРЕПО * СделкиРЕПОПроценты.ДнейПрошло / СделкиРЕПОПроценты.ВсегоДней КАК ЧИСЛО(19, 2))) - (СделкиРЕПОПроценты.КомиссияПоРЕПО - ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток, 0)) КАК НачислитьКомиссии,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта
		|ИЗ
		|	СделкиРЕПОПроценты КАК СделкиРЕПОПроценты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет В (&СчетаУчетаКомиссий),
		|				&ВидыСубконто,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЛицевойСчет.ДополнительнаяАналитика = &ДополнительнаяАналитика) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО СделкиРЕПОПроценты.СделкаРЕПО = ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|			И СделкиРЕПОПроценты.Валюта = ЕдиныйБухгалтерскийУчетОстатки.Валюта";
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	Если ЭтотОбъект.Дата < '20180301' Тогда // до 1.3.18 только ГПБ
		Запрос.УстановитьПараметр("БрокерГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	ИначеЕсли (ЭтотОбъект.Дата < '20180402')
		И (СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_PR_RN_001"
			ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_UL_PR_24"
			ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_NPF037") Тогда // до 27.3.18 траст нг пр и традиция пр по-старому
		Запрос.УстановитьПараметр("БрокерГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	Иначе // с 1.3.18 берем всех брокеров (и ГПБ и БК)
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И СделкаРЕПО.Брокер = &БрокерГПБ", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ДополнительнаяАналитика", ДополнительнаяАналитика);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ПериодДата", КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СчетаУчетаКомиссий", СчетаУчетаКомиссий);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.НачислитьКомиссии > 0 Тогда
			
			СуммаКомиссии = ВыборкаДетальныеЗаписи.НачислитьКомиссии;
			СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
			
			ЦеннаяБумага = ВыборкаДетальныеЗаписи.СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
			УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
			СделкаРЕПО = ВыборкаДетальныеЗаписи.СделкаРЕПО;
			
			КонтрагентПоСделке = ВыборкаДетальныеЗаписи.КонтрагентПоСделке;
			// некоторые клиенты не хотят раскрывать реального контрагента по репо и требуют отображать брокера
			Если НастройкиУчета.ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО Тогда
				КонтрагентПоСделке = ВыборкаДетальныеЗаписи.Контрагент;
			КонецЕсли;
			
			ЕПС_ПризнатьКомиссиюПоРЕПО(СуммаОперации, СуммаКомиссии, СделкаРЕПО, ВыборкаДетальныеЗаписи.Валюта, УчетныйАктив, ЦеннаяБумага, КонтрагентПоСделке, ВыборкаДетальныеЗаписи.Контрагент, ДополнительнаяАналитика, Закрывать7ойРазделПриПоступленииДенежныхСредств);
			
			Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
				
				Погрешность = ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего * ВыборкаДетальныеЗаписи.ДнейПрошло / ВыборкаДетальныеЗаписи.ВсегоДней
								- (ВыборкаДетальныеЗаписи.КомиссияПоРЕПОВсего - ВыборкаДетальныеЗаписи.КомиссияПоРЕПОНачислено)
								- ВыборкаДетальныеЗаписи.НачислитьКомиссии;
								
				ПогрешностьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(Погрешность, ВыборкаДетальныеЗаписи.СделкаРЕПО.ВалютаСделки, ЭтотОбъект.Организация, ЭтотОбъект.Дата);								
				
				СтрокиПогрешности = ТЗПогрешности.НайтиСтроки(Новый Структура("СделкаРЕПО", СделкаРЕПО));
				Если СтрокиПогрешности.Количество() = 0 Тогда
					СтрокаПогрешности = ТЗПогрешности.Добавить();
					СтрокаПогрешности.СделкаРЕПО = СделкаРЕПО;
				Иначе
					СтрокаПогрешности = СтрокиПогрешности[0];
				КонецЕсли;
				
				СтрокаПогрешности.Погрешность = СтрокаПогрешности.Погрешность + Погрешность;
				СтрокаПогрешности.ПогрешностьВВалютеУчета = СтрокаПогрешности.ПогрешностьВВалютеУчета + ПогрешностьВВалютеУчета;
				
			КонецЕсли;
																							
		КонецЕсли;
		
	КонецЦикла;
	
	Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
	
		Для каждого СтрокаТЗПогрешности Из ТЗПогрешности Цикл
			
			СтрокаТЗПогрешности.Погрешность = Окр(СтрокаТЗПогрешности.Погрешность, 2);
			СтрокаТЗПогрешности.ПогрешностьВВалютеУчета = Окр(СтрокаТЗПогрешности.ПогрешностьВВалютеУчета, 2);
			
			Если СтрокаТЗПогрешности.ПогрешностьВВалютеУчета >= 0.01 ИЛИ СтрокаТЗПогрешности.ПогрешностьВВалютеУчета <= -0.01 Тогда
			
				МассивПроводок = СтрокаТЗПогрешности.Проводки;
				
				Для каждого Проводка Из МассивПроводок Цикл
				
					Проводка.Сумма = Проводка.Сумма + СтрокаТЗПогрешности.ПогрешностьВВалютеУчета;
					
					Если Проводка.СчетДт <> ПланыСчетов.Единый.ПроцентныеДоходы03 И Проводка.СчетДт <> ПланыСчетов.Единый.АктивыВДУ03 Тогда
						Проводка.ВалютнаяСуммаДт = Проводка.ВалютнаяСуммаДт + СтрокаТЗПогрешности.Погрешность;
					КонецЕсли;
					
					Если Проводка.СчетКт <> ПланыСчетов.Единый.ПроцентныеДоходы03 И Проводка.СчетКт <> ПланыСчетов.Единый.АктивыВДУ03 Тогда
						Проводка.ВалютнаяСуммаКт = Проводка.ВалютнаяСуммаКт + СтрокаТЗПогрешности.Погрешность;
					КонецЕсли;
					
				КонецЦикла;
			
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	
	// А ТЕПЕРЬ ОБРАБОТАЕМ БРОКЕРСКУЮ КОМИССИЮ ПО БК
	//
	// до 1.3.18 все шло по извращенной схеме
	// с 1.3.18 все идет по "правильной" схеме и обработано выше
	
	Если ЭтотОбъект.Дата < '20180301' // до 1го марта все по бкшной схеме
		ИЛИ (ЭтотОбъект.Дата < '20180402' // до 2го апреля нг пр и традиции тоже
			И ((СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_PR_RN_001"
				ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_UL_PR_24"
				ИЛИ СокрЛП(ЭтотОбъект.СчетДоверительногоУправления.КодСчета) = "DU_NPF037"))) Тогда
	
		// ТО ЕЩЕ ИЗВРАЩЕНИЕ
		
		// текущий день тоже считаем, поэтому -2 и -3
		ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ЭтотОбъект.Дата), -2);
		ПредПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Константы.ОсновнойКалендарьКотировок.Получить(),НачалоДня(ЭтотОбъект.Дата), -3);
		
		Если НачалоДня(ПредПредыдущийРабочийДень) <> (НачалоДня(ЭтотОбъект.Дата) - 86400 - 86400) Тогда
		    //если предпредыдущий день нерабочий - берем 1/3 оплаченого за предыдущий
			НачалоПериода = НачалоДня(ЭтотОбъект.Дата) - 86400;
			КонецПериода = КонецДня(ЭтотОбъект.Дата) - 86400;
			
			Коэффициент = 3;
		ИначеЕсли НачалоДня(ПредыдущийРабочийДень) <> (НачалоДня(ЭтотОбъект.Дата) - 86400) Тогда
		    //если предыдущий день нерабочий - берем 2/3 оплаченного за сегодня
			НачалоПериода = НачалоДня(ЭтотОбъект.Дата);
			КонецПериода = КонецДня(ЭтотОбъект.Дата);
			
			Коэффициент = 2;
		Иначе
		    //берем, что было оплачено вчера
			НачалоПериода = НачалоДня(ЭтотОбъект.Дата) - 86400;
			КонецПериода = КонецДня(ЭтотОбъект.Дата) - 86400;
			
			Коэффициент = 1;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоСделке.СуммаОборот КАК Комиссия,
			|	РасходыПоСделке.Сделка КАК СделкаРЕПО,
			|	РасходыПоСделке.Сделка.Брокер.ЮрФизЛицо КАК Контрагент,
			|	РасходыПоСделке.Сделка.Контрагент КАК КонтрагентПоСделке,
			|	РасходыПоСделке.Сделка.ВалютаСделки КАК ВалютаСделки,
			|	РасходыПоСделке.ЦеннаяБумага КАК ЦеннаяБумага,
			|	РасходыПоСделке.Валюта КАК Валюта
			|ИЗ
			|	РегистрНакопления.РасходыПоСделке.Обороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В (&СписокСтратегий)
			|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|				И Сделка ССЫЛКА Документ.СделкаРЕПО
			|				И ВЫРАЗИТЬ(Сделка КАК Документ.СделкаРЕПО).Брокер = &БрокерБК
			|				И ВЫРАЗИТЬ(Сделка КАК Документ.СделкаРЕПО).ДатаВторойЧастиРЕПО > &КонецДня) КАК РасходыПоСделке";
		
		Запрос.УстановитьПараметр("БрокерБК", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
		
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.Комиссия > 0 Тогда
				
				СуммаКомиссии = ВыборкаДетальныеЗаписи.Комиссия;
				
				Если Коэффициент = 2 Тогда
					СуммаКомиссии = Окр(СуммаКомиссии / 3 * 2, 2);
				ИначеЕсли (Коэффициент = 3) И (НачалоДня(ВыборкаДетальныеЗаписи.СделкаРЕПО.Дата) < НачалоПериода) Тогда
					СуммаКомиссии = СуммаКомиссии - Окр(СуммаКомиссии / 3 * 2, 2);
				КонецЕсли;
				
				СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаКомиссии, ВыборкаДетальныеЗаписи.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
				
				ЦеннаяБумага = ВыборкаДетальныеЗаписи.СделкаРЕПО.ЦенныеБумаги[0].ЦеннаяБумага;
				УчетныйАктив = Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО;
				КонтрагентПоКомиссии = ВыборкаДетальныеЗаписи.Контрагент;
				СделкаРЕПО = ВыборкаДетальныеЗаписи.СделкаРЕПО;
				
				КонтрагентПоСделке = ВыборкаДетальныеЗаписи.КонтрагентПоСделке;
				// некоторые клиенты не хотят раскрывать реального контрагента по репо и требуют отображать брокера
				Если НастройкиУчета.ОтражатьБрокераКакКонтрагентаНаСчетахРасчетовПоРЕПО Тогда
					КонтрагентПоСделке = ВыборкаДетальныеЗаписи.Контрагент;
				КонецЕсли;
				
				ЕПС_ПризнатьКомиссиюПоРЕПО(СуммаОперации, СуммаКомиссии, СделкаРЕПО, ВыборкаДетальныеЗаписи.Валюта, УчетныйАктив, ЦеннаяБумага, КонтрагентПоСделке, КонтрагентПоКомиссии, ДополнительнаяАналитика, Закрывать7ойРазделПриПоступленииДенежныхСредств);
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;

КонецПроцедуры

Процедура ЕПС_ГлаваГ_НачислитьКурсовуюРазницу()

	// ЗАДОЛЖЕННОСТИ ПО ДС
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Сделка,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта КАК Валюта,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
		|	ВЫБОР
		|		КОГДА КурсыВалют.Кратность = 0
		|			ТОГДА ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность
		|	КОНЕЦ КАК СуммаОстатокНовый
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (&СчетаТребованийИОбязательствПоДС),
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Валюта <> &ВалютаУчета) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Валюта = КурсыВалют.Валюта
		|			И (КурсыВалют.Период = &ДатаПереоценки)";
	
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(ПланыСчетов.Единый.ТребованияПоПоставкеДС01);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ТребованияПоПоставкеДС02);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ОбязательстваПоПоставкеДС01);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ОбязательстваПоПоставкеДС02);
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("СчетаТребованийИОбязательствПоДС", МассивСчетов);
	Запрос.УстановитьПараметр("ДатаПереоценки", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.СуммаОстаток > 0 Тогда  // активный счет
			КоррСчет = ПланыСчетов.Единый.КорреспонденцияСАктивом;
		Иначе
			КоррСчет = ПланыСчетов.Единый.КорреспонденцияСПассивом;
		КонецЕсли;
		
		СуммаПереоценки = Окр(ВыборкаДетальныеЗаписи.СуммаОстатокНовый - ВыборкаДетальныеЗаписи.СуммаОстаток, 2);
		
		Если СуммаПереоценки > 0 Тогда  // увеличиваем
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценки, "Курсовая разница");
				
			// дебет
			Проводка.СчетДт = ВыборкаДетальныеЗаписи.Счет;
			
			Проводка.СубконтоДт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Сделка;
			
			Проводка.ВалютаДт  = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаДт = 0;
			
			// кредит
			Проводка.СчетКт = КоррСчет;
		
		ИначеЕсли СуммаПереоценки < 0 Тогда  // уменьшаем
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, -СуммаПереоценки, "Курсовая разница");
				
			// дебет
			Проводка.СчетДт = КоррСчет;
			
			// кредит
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.Счет;
			
			Проводка.СубконтоКт.ОснованиеРасчетов = ВыборкаДетальныеЗаписи.Сделка;
			
			Проводка.ВалютаКт  = ВыборкаДетальныеЗаписи.Валюта;
			Проводка.ВалютнаяСуммаКт = 0;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЕПС_ПереоценитьСПФИ()

	УчетныйАктивЕПС = Справочники.УчетныеАктивыЕПС.ПроизводныеФинансовыеИнструментыОснованныеНаПроцентныхДоговорах;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьСПФИ.СПФИ КАК СПФИ,
		|	СтоимостьСПФИ.Валюта КАК Валюта,
		|	СтоимостьСПФИ.ДебиторскаяЗадолженность КАК ДебиторскаяЗадолженность,
		|	СтоимостьСПФИ.КредиторскаяЗадолженность КАК КредиторскаяЗадолженность
		|ПОМЕСТИТЬ _ОценкаСПФИ
		|ИЗ
		|	РегистрСведений.СтоимостьСПФИ КАК СтоимостьСПФИ
		|ГДЕ
		|	СтоимостьСПФИ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьСПФИ.Период = &ПериодКотировок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОценкаСПФИ.СПФИ КАК СПФИ,
		|	_ОценкаСПФИ.Валюта КАК Валюта,
		|	_ОценкаСПФИ.ДебиторскаяЗадолженность - ЕСТЬNULL(ЕПС_ОстаткиВходящиеПлатежи.СуммаОстатокДт, 0) КАК ПереоценкаДебиторки,
		|	_ОценкаСПФИ.КредиторскаяЗадолженность - ЕСТЬNULL(ЕПС_ОстаткиИсходящиеПлатежи.СуммаОстатокКт, 0) КАК ПереоценкаКредиторки
		|ИЗ
		|	_ОценкаСПФИ КАК _ОценкаСПФИ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = &СчетУчетаТребованийПоПоставке,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПроцентыКПолучению)) КАК ЕПС_ОстаткиВходящиеПлатежи
		|		ПО _ОценкаСПФИ.СПФИ = ЕПС_ОстаткиВходящиеПлатежи.Субконто1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = &СчетУчетаОбязательствПоПоставке,
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ПроцентыКУплате)) КАК ЕПС_ОстаткиИсходящиеПлатежи
		|		ПО _ОценкаСПФИ.СПФИ = ЕПС_ОстаткиИсходящиеПлатежи.Субконто1";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ПериодКотировок", НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетУчетаТребованийПоПоставке", УчетныйАктивЕПС.СчетУчетаТребованийПоПоставке);
	Запрос.УстановитьПараметр("СчетУчетаОбязательствПоПоставке", УчетныйАктивЕПС.СчетУчетаОбязательствПоПоставке);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.ПереоценкаДебиторки <> 0 Тогда
			ПроводкиПереоценкиСПФИ(ВыборкаДетальныеЗаписи, Истина, ВыборкаДетальныеЗаписи.ПереоценкаДебиторки, УчетныйАктивЕПС, Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПроцентыКПолучению);
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ПереоценкаКредиторки <> 0 Тогда
			ПроводкиПереоценкиСПФИ(ВыборкаДетальныеЗаписи, Ложь, ВыборкаДетальныеЗаписи.ПереоценкаКредиторки, УчетныйАктивЕПС, Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПроцентыКУплате);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПроводкиПереоценкиСПФИ(ВыборкаДетальныеЗаписи, Дебиторка, СуммаПереоценки, УчетныйАктивЕПС, АналитикаЛицевогоСчета)

	Если Дебиторка Тогда 
		
		СчетПроцентов = УчетныйАктивЕПС.СчетУчетаТребованийПоПоставке;
		КоррСчет = ПланыСчетов.Единый.КорреспонденцияСАктивом;
		
		СторонаСчета = ?(СуммаПереоценки > 0, "Дт", "Кт");
		СторонаКоррСчета = ?(СуммаПереоценки > 0, "Кт", "Дт");
		
	Иначе
		
		СчетПроцентов = УчетныйАктивЕПС.СчетУчетаОбязательствПоПоставке;
	 	КоррСчет = ПланыСчетов.Единый.КорреспонденцияСПассивом;
		
		СторонаСчета = ?(СуммаПереоценки > 0, "Кт", "Дт");
		СторонаКоррСчета = ?(СуммаПереоценки > 0, "Дт", "Кт");
		
	КонецЕсли;
	
	Сумма = МатематическиеФункции.МодульЧисла(СуммаПереоценки);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, Сумма, "Задолженность по процентам");
	
	// дебет
	Проводка["Счет" + СторонаСчета] = СчетПроцентов;

	Проводка["Субконто" + СторонаСчета].ЦенныеБумаги = ВыборкаДетальныеЗаписи.СПФИ;
	Проводка["Субконто" + СторонаСчета].ОснованиеРасчетов = ВыборкаДетальныеЗаписи.СПФИ;

	Проводка["Валюта" + СторонаСчета] = ВыборкаДетальныеЗаписи.Валюта;
	Проводка["ВалютнаяСумма" + СторонаСчета] = Сумма;

	// кредит
	Проводка["Счет" + СторонаКоррСчета] = КоррСчет;
	
	Проводка.Партия = ВыборкаДетальныеЗаписи.СПФИ;
	Проводка.СтрокаПартии = 0;
	
	Проводка["ДополнительнаяАналитика" + СторонаСчета] = АналитикаЛицевогоСчета;

КонецПроцедуры

Процедура БУНУ_ПереоценкаЗадолженностейПоСделкамТПлюс(Отказ, УчетныйРегистр)
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.БухгалтерскийУчет);
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют настройки для указанной цели расчета!",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьЗадолженностиПоСделкамСОтложеннымИсполнением(
		НастройкиОценки.ВариантРасчетаОценочнойСтоимости,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.Дата,
		Неопределено,
		Отказ,
		МенеджерВременныхТаблиц);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Возможно, в регистре сведений 'Настройки целей расчета' неверно установлен вариант расчета оценочной стоимости");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ _СделкиСОтложеннымИсполнением"; 
	Задолженности = Запрос.Выполнить().Выгрузить();
	
	ЗадолженностиПоСделкам = Задолженности.Скопировать(Новый Структура("ВидЗадолженности", Справочники.ВидыЗадолженности.ПоСделке), "ВидАктива, Основание, СубъектАналитики, СуммаРынокВВалютеУчета");
	
	ОбращениеНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, ЗадолженностиПоСделкам.ВыгрузитьКолонку("СубъектАналитики"), УчетныйРегистр);
	
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница",						Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Период",							ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",						ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("ОбращениеНаОРЦБ",				ОбращениеНаОРЦБ);
	Запрос.УстановитьПараметр("Задолженности",					ЗадолженностиПоСделкам);
	
	ВидыСубконто = новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Сделка);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦенныеБумаги);
	Запрос.УстановитьПараметр("ВидыСубконто",					ВидыСубконто);
	
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОбращениеНаОРЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	               |	ОбращениеНаОРЦБ.ОбращаетсяНаОРЦБ КАК ОбращениеНаОРЦБ
	               |ПОМЕСТИТЬ _ОбращениеНаОРЦБ
	               |ИЗ
	               |	&ОбращениеНаОРЦБ КАК ОбращениеНаОРЦБ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки
	               |ПОМЕСТИТЬ _АналитикаПереоценки
	               |ИЗ
	               |	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И ВидУчета = &ВидУчета
	               |				И УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЗадолженностьДСПоСделкамТПлюс)
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаАктивовСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Задолженности.ВидАктива КАК ВидАктива,
	               |	Задолженности.Основание КАК Сделка,
	               |	Задолженности.СубъектАналитики КАК ЦеннаяБумага,
	               |	ВЫБОР
	               |		КОГДА Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
	               |			ТОГДА -Задолженности.СуммаРынокВВалютеУчета
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СуммаДт,
	               |	ВЫБОР
	               |		КОГДА Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА Задолженности.СуммаРынокВВалютеУчета
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СуммаКт,
	               |	ВЫБОР
	               |		КОГДА Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА Задолженности.СуммаРынокВВалютеУчета
	               |		ИНАЧЕ -Задолженности.СуммаРынокВВалютеУчета
	               |	КОНЕЦ КАК Сумма
	               |ПОМЕСТИТЬ _Задолженности
	               |ИЗ
	               |	&Задолженности КАК Задолженности
	               |ГДЕ
	               |	Задолженности.Основание ССЫЛКА Документ.Сделка
	               |	И НЕ ВЫРАЗИТЬ(Задолженности.Основание КАК Документ.Сделка).МестоХранения В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Сделка,
	               |	СуммаДт,
	               |	СуммаКт
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	БухгалтерскийУчетОстатки.Субконто1 КАК Сделка,
	               |	БухгалтерскийУчетОстатки.Субконто2 КАК ЦеннаяБумага,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.СуммаДт <> БухгалтерскийУчетОстатки.СуммаОстатокДт
	               |			ТОГДА -БухгалтерскийУчетОстатки.СуммаОстатокДт
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СуммаДт,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.СуммаКт <> БухгалтерскийУчетОстатки.СуммаОстатокКт
	               |			ТОГДА -БухгалтерскийУчетОстатки.СуммаОстатокКт
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК СуммаКт
	               |ПОМЕСТИТЬ _ТекущиеЗадолженности
	               |ИЗ
	               |	_Задолженности КАК _Задолженности
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
	               |				&Граница,
	               |				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс),
	               |				&ВидыСубконто,
	               |				Организация = &Организация
	               |					И СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |					И Субконто1 В
	               |						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |							_Задолженности.Сделка КАК Сделка
	               |						ИЗ
	               |							_Задолженности КАК _Задолженности)) КАК БухгалтерскийУчетОстатки
	               |		ПО _Задолженности.Сделка = БухгалтерскийУчетОстатки.Субконто1
				   |			И _Задолженности.ЦеннаяБумага = БухгалтерскийУчетОстатки.Субконто2
	               |			И (_Задолженности.СуммаДт <> БухгалтерскийУчетОстатки.СуммаОстатокДт
	               |				ИЛИ _Задолженности.СуммаКт <> БухгалтерскийУчетОстатки.СуммаОстатокКт)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс) КАК СчетДт,
	               |	_ТекущиеЗадолженности.Сделка КАК СубконтоДт1,
	               |	_ТекущиеЗадолженности.ЦеннаяБумага КАК СубконтоДт2,
	               |	НЕОПРЕДЕЛЕНО КАК СубконтоДт3,
	               |	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы) КАК СчетКт,
	               |	_АналитикаПереоценки.АналитикаДоходовОтПереоценки КАК СубконтоКт1,
	               |	_ТекущиеЗадолженности.ЦеннаяБумага КАК СубконтоКт2,
	               |	_ОбращениеНаОРЦБ.ОбращениеНаОРЦБ КАК СубконтоКт3,
	               |	_ТекущиеЗадолженности.СуммаДт КАК Сумма,
	               |	ИСТИНА КАК Сторнирование
	               |ИЗ
	               |	_ТекущиеЗадолженности КАК _ТекущиеЗадолженности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ОбращениеНаОРЦБ КАК _ОбращениеНаОРЦБ
	               |		ПО _ТекущиеЗадолженности.ЦеннаяБумага = _ОбращениеНаОРЦБ.ЦеннаяБумага
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаПереоценки КАК _АналитикаПереоценки
	               |		ПО (ИСТИНА)
	               |ГДЕ
	               |	_ТекущиеЗадолженности.СуммаДт < 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
	               |	_АналитикаПереоценки.АналитикаДоходовОтПереоценки,
	               |	_ТекущиеЗадолженности.ЦеннаяБумага,
	               |	_ОбращениеНаОРЦБ.ОбращениеНаОРЦБ,
	               |	ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс),
	               |	_ТекущиеЗадолженности.Сделка,
	               |	_ТекущиеЗадолженности.ЦеннаяБумага,
	               |	НЕОПРЕДЕЛЕНО,
	               |	_ТекущиеЗадолженности.СуммаКт,
	               |	ИСТИНА
	               |ИЗ
	               |	_ТекущиеЗадолженности КАК _ТекущиеЗадолженности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ОбращениеНаОРЦБ КАК _ОбращениеНаОРЦБ
	               |		ПО _ТекущиеЗадолженности.ЦеннаяБумага = _ОбращениеНаОРЦБ.ЦеннаяБумага
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаПереоценки КАК _АналитикаПереоценки
	               |		ПО (ИСТИНА)
	               |ГДЕ
	               |	_ТекущиеЗадолженности.СуммаКт < 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА _Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА _Задолженности.Сделка
	               |		ИНАЧЕ _АналитикаПереоценки.АналитикаДоходовОтПереоценки
	               |	КОНЕЦ,
	               |	_Задолженности.ЦеннаяБумага,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА НЕОПРЕДЕЛЕНО
	               |		ИНАЧЕ _ОбращениеНаОРЦБ.ОбращениеНаОРЦБ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаСделокТПлюс)
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА _АналитикаПереоценки.АналитикаДоходовОтПереоценки
	               |		ИНАЧЕ _Задолженности.Сделка
	               |	КОНЕЦ,
	               |	_Задолженности.ЦеннаяБумага,
	               |	ВЫБОР
	               |		КОГДА _Задолженности.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
	               |			ТОГДА _ОбращениеНаОРЦБ.ОбращениеНаОРЦБ
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ,
	               |	_Задолженности.Сумма,
	               |	ЛОЖЬ
	               |ИЗ
	               |	_Задолженности КАК _Задолженности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ОбращениеНаОРЦБ КАК _ОбращениеНаОРЦБ
	               |		ПО _Задолженности.ЦеннаяБумага = _ОбращениеНаОРЦБ.ЦеннаяБумага
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _АналитикаПереоценки КАК _АналитикаПереоценки
	               |		ПО (ИСТИНА)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], Выборка.Сумма, ?(Выборка.Сторнирование, "Сторно переоценки сделки Т+", "Переоценка сделки Т+"));
		
		Проводка.СчетДт = Выборка.СчетДт;
		Проводка.СчетКт = Выборка.СчетКт;
		
		ИндексСубконто = 1;
		
		Для Каждого ТекСубконто Из Проводка.СчетДт.ВидыСубконто Цикл
			Проводка.СубконтоДт[ТекСубконто.ВидСубконто] = Выборка["СубконтоДт" + ИндексСубконто];
			ИндексСубконто = ИндексСубконто + 1;
		КонецЦикла;
		
		ИндексСубконто = 1;
		
		Для Каждого ТекСубконто Из Проводка.СчетКт.ВидыСубконто Цикл
			Проводка.СубконтоКт[ТекСубконто.ВидСубконто] = Выборка["СубконтоКт" + ИндексСубконто];
			ИндексСубконто = ИндексСубконто + 1;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЕПС_ПризнатьКомиссиюПоРЕПО(СуммаОперации, СуммаКомиссии, СделкаРЕПО, ВалютаСделки, УчетныйАктив, ЦеннаяБумага, Контрагент, КонтрагентПоКомиссии, ДополнительнаяАналитика, Закрывать7ойРазделПриПоступленииДенежныхСредств, ВозвращаемыеПроводки = Неопределено)

	Если ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТорговаяКомиссия Тогда
	
		ОписаниеПроводкиНачисления = "Начисление торговой комиссия";
		ОписаниеПроводкиПризнания = "Признание торговой комиссия";
		ОписаниеПроводкиЗакрытия = "Торговая комиссия закрытие расхода";
		
	ИначеЕсли ДополнительнаяАналитика = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КомиссияБрокера Тогда
		
		ОписаниеПроводкиНачисления = "Начисление брокерской комиссия";
		ОписаниеПроводкиПризнания = "Признание брокерской комиссия";
		ОписаниеПроводкиЗакрытия = "Комиссия брокера закрытие расхода";
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата) И ЭтотОбъект.Дата > '20230101' Тогда
	
		ГФУ = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту(КонтрагентПоКомиссии, ЭтотОбъект.Дата);
		
	Иначе
		ГФУ = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоСредствамПредоставленнымКонтрагенту(Контрагент, ЭтотОбъект.Дата);
	КонецЕсли;
	
	// ПРИЗНАНИЕ КОМИССИИ
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиНачисления);
	
	// дебет
	Если СделкаРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеДоходы03;
		
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
	Иначе
		Проводка.СчетДт = ПланыСчетов.Единый.ПроцентныеРасходы02;
		
		Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоПривлеченнымСредствам(Контрагент, ЭтотОбъект.Дата);
	КонецЕсли;
	Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
	
	// кредит
	Если СделкаРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства18;
	Иначе
		Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг18;
	КонецЕсли;	
	
	Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
	Проводка.СубконтоКт.ОснованиеРасчетов = СделкаРЕПО;
	
	Проводка.ВалютаКт = ВалютаСделки;
	Проводка.ВалютнаяСуммаКт = СуммаКомиссии;
	
	Если ВозвращаемыеПроводки <> Неопределено Тогда
		ВозвращаемыеПроводки.Добавить(Проводка);
	КонецЕсли;
	
	// СВЕРНЕМ 18 и 19
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиПризнания);
	
	// дебет
	Если СделкаРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		Проводка.СчетДт = ПланыСчетов.Единый.ПрочиеСредства18;
	Иначе
		Проводка.СчетДт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг18;
	КонецЕсли;	
	
	Проводка.СубконтоДт.Контрагенты = КонтрагентПоКомиссии;
	Проводка.СубконтоДт.ОснованиеРасчетов = СделкаРЕПО;
	
	Проводка.ВалютаДт = ВалютаСделки;
	Проводка.ВалютнаяСуммаДт = СуммаКомиссии;
	
	// кредит
	Если СделкаРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
		Проводка.СчетКт = ПланыСчетов.Единый.ПрочиеСредства19;
	Иначе
		Проводка.СчетКт = ПланыСчетов.Единый.ПривлеченныеСредстваФинОрг19;
	КонецЕсли;	
	
	Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
	Проводка.СубконтоКт.ОснованиеРасчетов = СделкаРЕПО;
	
	Проводка.ВалютаКт = ВалютаСделки;
	Проводка.ВалютнаяСуммаКт = СуммаКомиссии;
	Проводка.ДополнительнаяАналитикаКт = ДополнительнаяАналитика;
	
	Если ВозвращаемыеПроводки <> Неопределено Тогда
		ВозвращаемыеПроводки.Добавить(Проводка);
	КонецЕсли;
	
	// ЗАКРЫТИЕ РАСХОДОВ ПО ТОРГОВОЙ КОМИССИИ НА АКТИВЫ В ДУ
	Если Закрывать7ойРазделПриПоступленииДенежныхСредств Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, ОписаниеПроводкиЗакрытия);
		// дебет
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
		
		// кредит
		Если СделкаРЕПО.ВидСделки = Перечисления.ВидыСделок.Покупка Тогда
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеДоходы03;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = ГФУ;
		Иначе
			Проводка.СчетКт = ПланыСчетов.Единый.ПроцентныеРасходы02;
			Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = БухгалтерскийУчетЕПС.ОпределитьГФУКомиссионныхРасходовПоПривлеченнымСредствам(Контрагент, ЭтотОбъект.Дата);
		КонецЕсли;
		Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
		
		Если ВозвращаемыеПроводки <> Неопределено Тогда
			ВозвращаемыеПроводки.Добавить(Проводка);
		КонецЕсли;
		
	КонецЕсли; 

КонецПроцедуры

Функция ДисконтироватьЗадолженностиПоСделкамРЕПО(МассивАктивов)
	
	Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, "ПроверятьСтавкуРЕПОнаРыночность") Тогда
		Возврат Ложь;	
	КонецЕсли;
	
	МассивВидовАктивов = Новый Массив;
	МассивВидовАктивов.Добавить(Перечисления.ВидыАктивовДляПроверкиНаРыночность.ПрямоеРЕПО);
	МассивВидовАктивов.Добавить(Перечисления.ВидыАктивовДляПроверкиНаРыночность.ОбратноеРЕПО);
	
	Возврат РаботаСоСтоимостьюПоРыночнойСтавке.ЕстьНастройкиПроверкиНаРыночность(
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.Дата,
		БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета),
		МассивВидовАктивов,
		МассивАктивов);
	
КонецФункции

//Параметр СтруктураПереоценкиПервоначальногоПризнания - структура, содержащая значения:
//		- ПереоцениватьПрямоеРЕПО
//      - ТолькоПервоначальноеПризнаниеПрямогоРЕПО
//      - ПереоцениватьОбратноеРЕПО
//      - ТолькоПервоначальноеПризнаниеОбратногоРЕПО
//
Процедура БУНУ_НачислитьПроцентыПоРЕПО(СтруктураПереоценки, Отказ)
	
	СуммыЗаймовПоПериодам = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.РассчитатьПроцентыПоРЕПО(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата, БухгалтерскийУчетПовтИсп.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета),, Отказ);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось рассчитать проценты по сделкам РЕПО",ЭтотОбъект.Ссылка);
		Возврат;
	КонецЕсли;
	
	КоличествоСтрокСуммыЗаймовПоПериодам = СуммыЗаймовПоПериодам.Количество();

	Если КоличествоСтрокСуммыЗаймовПоПериодам = 0 Тогда
		//нет сделок
		Возврат;
	КонецЕсли;

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	//получим настройки
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	НастройкиПрямогоРЕПО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоПрямомуРЕПО,УчетныйРегистр);
	НастройкиОбратногоРЕПО = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(Дата, СчетДоверительногоУправления.Организация, СчетДоверительногоУправления, Справочники.УчетныеАктивы.РасчетыПоОбратномуРЕПО,УчетныйРегистр);
	АналитикаПроцентовПрямогоРЕПО = НастройкиПрямогоРЕПО.АналитикаДоходов; 
	АналитикаПроцентовОбратногоРЕПО = НастройкиОбратногоРЕПО.АналитикаДоходов;
	АналитикаПерекурсовкиПрямогоРЕПО = НастройкиПрямогоРЕПО.АналитикаПерекурсовки; 
	АналитикаПерекурсовкиОбратногоРЕПО = НастройкиОбратногоРЕПО.АналитикаПерекурсовки; 
	
	//т.к. у ПИФов идет оценка по справедливй стоимости, то подменяем аналитику. Если есть чем
	ЭтоПИФ = СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда;
	
	Если ЭтоПИФ Тогда
		АналитикаПереоценкиПрямогоРЕПО = НастройкиПрямогоРЕПО.АналитикаДоходовОтПереоценки; 
		Если ЗначениеЗаполнено(АналитикаПереоценкиПрямогоРЕПО) И АналитикаПереоценкиПрямогоРЕПО <> АналитикаПроцентовПрямогоРЕПО Тогда
			АналитикаПроцентовПрямогоРЕПО = АналитикаПереоценкиПрямогоРЕПО; 
		КонецЕсли;
		
		АналитикаПереоценкиОбратногоРЕПО = НастройкиОбратногоРЕПО.АналитикаДоходовОтПереоценки; 
		Если ЗначениеЗаполнено(АналитикаПереоценкиОбратногоРЕПО) И АналитикаПереоценкиОбратногоРЕПО <> АналитикаПроцентовОбратногоРЕПО Тогда
			АналитикаПроцентовОбратногоРЕПО = АналитикаПереоценкиОбратногоРЕПО; 
		КонецЕсли;
	КонецЕсли;
	
	АналитикаПервоначальногоПризнанияПрямогоРЕПО = НастройкиПрямогоРЕПО.АналитикаПервоначальногоПризнания;
	АналитикаПервоначальногоПризнанияОбратногоРЕПО = НастройкиОбратногоРЕПО.АналитикаПервоначальногоПризнания;
	ВыделятьАналитикуПервоначальногоПризнанияПрямогоРЕПО = НастройкиПрямогоРЕПО.ПереоцениватьВДеньОперации 
		И ЗначениеЗаполнено(АналитикаПервоначальногоПризнанияПрямогоРЕПО) 
		И АналитикаПервоначальногоПризнанияПрямогоРЕПО <> АналитикаПроцентовПрямогоРЕПО;
	ВыделятьАналитикуПервоначальногоПризнанияОбратногоРЕПО = НастройкиОбратногоРЕПО.ПереоцениватьВДеньОперации 
		И ЗначениеЗаполнено(АналитикаПервоначальногоПризнанияОбратногоРЕПО) 
		И АналитикаПервоначальногоПризнанияОбратногоРЕПО <> АналитикаПроцентовОбратногоРЕПО;
	
	
	//Если нужно получим сделки за дату оценки
	ТаблицаПервоначальногоПризнания = Неопределено;
	Если СтруктураПереоценки.ТолькоПервоначальноеПризнаниеПрямогоРЕПО ИЛИ ВыделятьАналитикуПервоначальногоПризнанияПрямогоРЕПО 
		ИЛИ СтруктураПереоценки.ТолькоПервоначальноеПризнаниеОбратногоРЕПО ИЛИ ВыделятьАналитикуПервоначальногоПризнанияОбратногоРЕПО Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&КонецДня,
			|			СделкаРЕПО В (&СделкиРЕПО)
			|				И ЧастьСделкиРЕПО = 1
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК УсловияСделокРЕПОСрезПоследних
			|ГДЕ
			|	НЕ УсловияСделокРЕПОСрезПоследних.Отменено
			|	И (УсловияСделокРЕПОСрезПоследних.ДатаИсполнения МЕЖДУ &НачалоДня И &КонецДня
			|			ИЛИ УсловияСделокРЕПОСрезПоследних.ДатаОплаты МЕЖДУ &НачалоДня И &КонецДня)";
		
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Дата));
		Запрос.УстановитьПараметр("КонецДня", КонецДня(Дата));
		Запрос.УстановитьПараметр("СделкиРЕПО", СуммыЗаймовПоПериодам.ВыгрузитьКолонку("Основание"));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		ТаблицаПервоначальногоПризнания = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;	
	
	СуммыЗаймовПоПериодам.Колонки.Добавить("ЭтоПрямоеРЕПО");
	СуммыЗаймовПоПериодам.Колонки.Добавить("ЭтоПервоначальноеПризнание");
	
	Для сц = -(КоличествоСтрокСуммыЗаймовПоПериодам - 1) По 0 Цикл
		
		СтрокаРЕПО = СуммыЗаймовПоПериодам.Получить(-сц);
		
		СтрокаРЕПО.ЭтоПрямоеРЕПО = Документы.СделкаРЕПО.ЭтоПрямоеРЕПО(СтрокаРЕПО.Основание.ЧастьСделкиРЕПО, СтрокаРЕПО.Основание.ВидСделки);
		//ЭтоПервоначальноеПризнание заполняем если требуется
		СтрокаРЕПО.ЭтоПервоначальноеПризнание = ?(ТаблицаПервоначальногоПризнания = Неопределено, Ложь, ТаблицаПервоначальногоПризнания.Найти(СтрокаРЕПО.Основание) <> Неопределено);
		
		Если СтрокаРЕПО.ЭтоПрямоеРЕПО ТОгда
			Если СтруктураПереоценки.ПереоцениватьПрямоеРЕПО Тогда
				Если НЕ СтруктураПереоценки.ТолькоПервоначальноеПризнаниеПрямогоРЕПО  Тогда
					Продолжить;
				ИначеЕсли СтрокаРЕПО.ЭтоПервоначальноеПризнание Тогда 
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если СтруктураПереоценки.ПереоцениватьОбратноеРЕПО Тогда
				Если НЕ СтруктураПереоценки.ТолькоПервоначальноеПризнаниеОбратногоРЕПО Тогда
					Продолжить;
				ИначеЕсли СтрокаРЕПО.ЭтоПервоначальноеПризнание Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СуммыЗаймовПоПериодам.Удалить(СтрокаРЕПО);

	КонецЦикла;
	
	Если ДисконтироватьЗадолженностиПоСделкамРЕПО(СуммыЗаймовПоПериодам.ВыгрузитьКолонку("Основание")) Тогда
		
		ЗадолженностьПоСделкамРЕПО = Новый ТаблицаЗначений;
		ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("СделкаРЕПО");
		ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("Задолженность");
		ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("Ставка");
		ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("ДатаИсполнения");
		ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("ЗадолженностьПоСС");
		ЗадолженностьПоСделкамРЕПО.Колонки.Добавить("СуммаПроцентов");
		
		Для каждого Займ из СуммыЗаймовПоПериодам Цикл
			//т.к. может быть несколько периодов по займу - берем последний, там текущая задолженность
			СтрокаСделкиРЕПО = ЗадолженностьПоСделкамРЕПО.Найти(Займ.Основание, "СделкаРЕПО");
			Если СтрокаСделкиРЕПО = Неопределено Тогда  
				СтрокаСделкиРЕПО = ЗадолженностьПоСделкамРЕПО.Добавить();
				СтрокаСделкиРЕПО.СделкаРЕПО = Займ.Основание;
				СтрокаСделкиРЕПО.Ставка = Займ.СтавкаРЕПО;
				СтрокаСделкиРЕПО.ДатаИсполнения = Займ.ДатаРЕПО;
				СтрокаСделкиРЕПО.СуммаПроцентов = 0;
			КонецЕсли;
			СтрокаСделкиРЕПО.Задолженность = Займ.СуммаВЗалоге;
			СтрокаСделкиРЕПО.СуммаПроцентов = СтрокаСделкиРЕПО.СуммаПроцентов + Займ.СуммаПроцентов;
		КонецЦикла;
		
		РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьРЕПОПоРыночнойСтавке(
			ЗадолженностьПоСделкамРЕПО, 
			ЭтотОбъект.СчетДоверительногоУправления, 
			ЭтотОбъект.Дата, 
			БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета),
			Неопределено,
			Неопределено,
			Отказ);
	
		СуммыЗаймовПоПериодам.Свернуть("Основание, ВалютаСделки, Контрагент, ЭтоПрямоеРЕПО, ЭтоПервоначальноеПризнание","СуммаПроцентов");
		
		Для Каждого СтрокаСделкиРЕПО из ЗадолженностьПоСделкамРЕПО Цикл
			СтрокаЗайма = СуммыЗаймовПоПериодам.Найти(СтрокаСделкиРЕПО.СделкаРЕПО, "Основание");
			Если СтрокаЗайма <> Неопределено Тогда
				Если СтрокаЗайма.СуммаПроцентов <> СтрокаСделкиРЕПО.СуммаПроцентов Тогда
					СтрокаЗайма.СуммаПроцентов = СтрокаСделкиРЕПО.СуммаПроцентов;
				КонецЕсли;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена сделка РЕПО " + СтрокаСделкиРЕПО.СделкаРЕПО + " при дисконтировании задолженности за " + Формат(ЭтотОбъект.Дата,"ДФ=dd.MM.yyyy"), ЭтотОбъект.Ссылка,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
	
		СуммыЗаймовПоПериодам.Свернуть("Основание, ВалютаСделки, Контрагент, ЭтоПрямоеРЕПО, ЭтоПервоначальноеПризнание","СуммаПроцентов");
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(НалоговыйУчетОстатки.СуммаОстаток, 0) КАК НачисленныеПроцентыПоРЕПОВВалютеУчета,
		|	ЕСТЬNULL(НалоговыйУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК НачисленныеПроцентыПоРЕПО,
		|	НалоговыйУчетОстатки.Субконто1 КАК СделкаРЕПО
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Остатки(
		|			&ВечерВчерашнегоДня,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
		|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НалоговыйУчетОстатки";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВечерВчерашнегоДня", НачалоДня(ЭтотОбъект.Дата)-1);//считаем что "включая" дложно сработать. Проценты начисляются со дня след. за днем исполнения первой части
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "НалоговыйУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета));
	
	НачисленныеПроцентыПоРЕПО = Запрос.Выполнить().Выгрузить();
	
	
	Для Каждого СтрокаРЕПО ИЗ СуммыЗаймовПоПериодам Цикл

		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаРЕПО.Основание, "Ссылка, СчетДоверительногоУправления, Дата, Брокер, Контрагент, РежимБиржевыхТоргов");
		КонтрагентПоСделке = БухгалтерскийУчет.ОпределитьКонтрагентаПоСделкеРЕПО(Реквизиты, НастройкиУчета);
		
		СрокаПроцентов = НачисленныеПроцентыПоРЕПО.Найти(СтрокаРЕПО.Основание,"СделкаРЕПО");
		Если СрокаПроцентов = Неопределено Тогда
			СуммаНачисленныхПроцентов = 0;
			СуммаНачисленныхПроцентовВВалютаУчета = 0;
		Иначе
			СуммаНачисленныхПроцентов = СрокаПроцентов.НачисленныеПроцентыПоРЕПО;
			СуммаНачисленныхПроцентовВВалютаУчета = СрокаПроцентов.НачисленныеПроцентыПоРЕПОВВалютеУчета;
		КонецЕсли;
		
		СчетПереоценкиРасчетовПоРЕПО = ?(СтрокаРЕПО.ЭтоПрямоеРЕПО, ПланыСчетов.Основной.ПроцентыПоКраткосрочнымКредитам, ПланыСчетов.Основной.НалоговыеНачисленияПоРЕПО); 
		АналитикаПроцентов = ?(СтрокаРЕПО.ЭтоПрямоеРЕПО, АналитикаПроцентовПрямогоРЕПО, АналитикаПроцентовОбратногоРЕПО); 
		АналитикаПерекурсовки = ?(СтрокаРЕПО.ЭтоПрямоеРЕПО, АналитикаПерекурсовкиПрямогоРЕПО, АналитикаПерекурсовкиОбратногоРЕПО); 
		
		Если СтрокаРЕПО.ЭтоПервоначальноеПризнание ТОгда
			Если СтрокаРЕПО.ЭтоПрямоеРЕПО И ВыделятьАналитикуПервоначальногоПризнанияПрямогоРЕПО Тогда
				АналитикаПроцентов = АналитикаПервоначальногоПризнанияПрямогоРЕПО;
			ИначеЕсли НЕ СтрокаРЕПО.ЭтоПрямоеРЕПО И ВыделятьАналитикуПервоначальногоПризнанияОбратногоРЕПО Тогда
				АналитикаПроцентов = АналитикаПервоначальногоПризнанияОбратногоРЕПО;	
			КонецЕсли;
		КонецЕсли;
		
		// Перекурсовка Процентов
		СуммаПроцентовПоТекущемуКурсу = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
			СуммаНачисленныхПроцентов,
			СтрокаРЕПО.ВалютаСделки,
			ЭтотОбъект.Организация,
			ЭтотОбъект.Дата);
		
		КурсоваяРазницаПроценты = СуммаПроцентовПоТекущемуКурсу - СуммаНачисленныхПроцентовВВалютаУчета;
		               
		Если КурсоваяРазницаПроценты > 0 Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], КурсоваяРазницаПроценты, "Курсовая разница");
			
			Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СтрокаРЕПО.Основание;
			
			Проводка.ВалютаДт = СтрокаРЕПО.ВалютаСделки;
			
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПерекурсовки;
			
		ИначеЕсли КурсоваяРазницаПроценты > 0 Тогда
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], -КурсоваяРазницаПроценты, "Курсовая разница");
			
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы =  АналитикаПерекурсовки;
			
			Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СтрокаРЕПО.Основание;
			
			Проводка.ВалютаКт = СтрокаРЕПО.ВалютаСделки;
			
		КонецЕсли;
		
		
		ПроцентыПоРЕПО = СтрокаРЕПО.СуммаПроцентов - СуммаНачисленныхПроцентов;
			
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(
			ПроцентыПоРЕПО,
			СтрокаРЕПО.ВалютаСделки,
			ЭтотОбъект.Организация,
			ЭтотОбъект.Дата);
		
		ЦеннаяБумага = СтрокаРЕПО.Основание.ЦенныеБумаги[0].ЦеннаяБумага;
		
		СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииКорзиныЦенныхБумагНаОРЦБ(
			ЭтотОбъект.Дата,
			СтрокаРЕПО.Основание, 
			УчетныйРегистр);
		
		ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
		
		Если ПроцентыПоРЕПО > 0 Тогда
				
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], СуммаОперации, "% по РЕПО");
			
			// дебет
			Проводка.СчетДт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоДт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоДт.СделкаРЕПО = СтрокаРЕПО.Основание;
			
			Проводка.ВалютаДт = СтрокаРЕПО.ВалютаСделки;
			Проводка.ВалютнаяСуммаДт = ПроцентыПоРЕПО;
			
			// кредит
			Проводка.СчетКт = ПланыСчетов.Основной.ПрочиеДоходы;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаПроцентов;
			Проводка.СубконтоКт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
		ИначеЕсли ПроцентыПоРЕПО < 0 Тогда
				
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, ЭтотОбъект.Движения[УчетныйРегистр], -СуммаОперации, "% по РЕПО");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
			Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаПроцентов;
			Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = ОбращаетсяНаОРЦБ;
			
			// кредит
			Проводка.СчетКт = СчетПереоценкиРасчетовПоРЕПО;
			Проводка.СубконтоКт.Контрагенты = КонтрагентПоСделке;
			Проводка.СубконтоКт.СделкаРЕПО = СтрокаРЕПО.Основание;
			
			Проводка.ВалютаКт = СтрокаРЕПО.ВалютаСделки;
			Проводка.ВалютнаяСуммаКт = -ПроцентыПоРЕПО;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура БУНУ_ПризнатьКомиссиюПоРЕПО(Движения, СуммаОперации, СделкаРЕПО, ЦеннаяБумага, СведенияОбОбращенииЦенныхБумагНаОРЦБ, КонтрагентПоКомиссии, ВидКомиссии, НастройкиКомиссии, МетодПризнанияРасходовПоСделкамРЕПО, ВозвращаемыеПроводки = Неопределено)
	
	// СуммаКомиссии, ВалютаСделки - не используются т.к. невалютные счета

	Если ВидКомиссии = Справочники.ВидыЗадолженности.ПоТорговойКомиссии Тогда
	
		ОписаниеПроводкиНачисления = "Начисление торговой комиссия";
		
	ИначеЕсли ВидКомиссии = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии Тогда
		
		ОписаниеПроводкиНачисления = "Начисление брокерской комиссия";
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	НастройкаКомиссии = НастройкиКомиссии.Найти(ВидКомиссии, "ВидЗадолженности");
	
	
	// ПРИЗНАНИЕ КОМИССИИ
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения, СуммаОперации, ОписаниеПроводкиНачисления);
	
	// дебет
	Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
	
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкаКомиссии.АналитикаРЕПО;
	Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
	Проводка.СубконтоДт.ОбращаетсяНаОРЦБ = СведенияОбОбращенииЦенныхБумагНаОРЦБ.Найти(ЦеннаяБумага, "ЦеннаяБумага").ОбращаетсяНаОРЦБ;
	
	// кредит
	Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичностиСОтражениемНаСчетеРасчетов Тогда
		// если настройка "...НаСчетеРасчетов" то и отражаем на счете РасчетыПоКомиссии
		Проводка.СчетКт = ПланыСчетов.Основной.РасчетыПоКомиссии;
	Иначе
		// на счете учета комиссии
		Проводка.СчетКт = НастройкаКомиссии.СчетУчета;
	КонецЕсли;
	
	Проводка.СубконтоКт.Контрагенты = КонтрагентПоКомиссии;
	Проводка.СубконтоКт.Сделка = СделкаРЕПО;
	
	//Проводка.ВалютаКт = ВалютаСделки;
	//Проводка.ВалютнаяСуммаКт = СуммаКомиссии;
	
	Если ВозвращаемыеПроводки <> Неопределено Тогда
		ВозвращаемыеПроводки.Добавить(Проводка);
	КонецЕсли;
	
КонецПроцедуры

Процедура БУНУ_ПереоценитьКомиссиюПоРЕПО(МетодПризнанияРасходовПоСделкамРЕПО, УчетныйРегистр)

	РаботаСОтчетами.КонтрольВалютыРасходовПоСделкамОтличнойОтВалютыУчета(ЭтотОбъект.СчетДоверительногоУправления, Неопределено, Неопределено);
	
	Отказ = Ложь;
	НастройкиПоВидуУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, Отказ);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствуют настройки у %1 по виду учета %2 на %3!", ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, ЭтотОбъект.Дата));
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.Дата < '20231231' Тогда
	    ЕПС_УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО = Истина;
	ИначеЕсли БухгалтерскийУчет.ВедетсяУчетЕПС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления) Тогда
		ЕПС_УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, "УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО");
	Иначе
		ЕПС_УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО = Ложь;
	КонецЕсли;
	
	Если НастройкиПоВидуУчета.УчитыватьПогрешностьСложенияБрокерскойИТорговойКомиссийПоРЕПО Тогда
	
		ТЗПогрешности = Новый ТаблицаЗначений;
		
		ТЗПогрешности.Колонки.Добавить("СделкаРЕПО", Новый ОписаниеТипов("ДокументСсылка.СделкаРЕПО"));
		ТЗПогрешности.Колонки.Добавить("Погрешность", Новый ОписаниеТипов("Число"));
		ТЗПогрешности.Колонки.Добавить("ПогрешностьВВалютеУчета", Новый ОписаниеТипов("Число"));
		ТЗПогрешности.Колонки.Добавить("Проводки");
		
	КонецЕсли;
	
	// ------------
	УчетныйРегистр = РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности КАК ВидЗадолженности,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчета КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО = ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|			ТОГДА НастройкиУчетаКомиссииСрезПоследних.Аналитика
		|		ИНАЧЕ НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО
		|	КОНЕЦ КАК АналитикаРЕПО
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК НастройкиУчетаКомиссииСрезПоследних";
	
	Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	НастройкиКомиссии = Запрос.Выполнить().Выгрузить();
	
	
	// ------------
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ПериодДата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СписокСтратегий)
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
		|ГДЕ
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ПериодДата";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СписокСтратегий", Справочники.СчетаДоверительногоУправления.ПолучитьМассивСчетовПоДоговоруДУ(ЭтотОбъект.СчетДоверительногоУправления));
	Запрос.УстановитьПараметр("ПериодДата", КонецДня(ЭтотОбъект.Дата));
	
	СведенияОбОбращенииЦенныхБумагНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦенныхБумагНаОРЦБ(ЭтотОбъект.Дата, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага"), УчетныйРегистр);
	
	
	Если МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичностиСОтражениемНаСчетеРасчетов Тогда
		//для данного метода предполагается, что комиссии брокера и биржи не отличаются и считать их будем вместе
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РасходыПоКомиссии.СуммаОборот КАК КомиссияПоРЕПО,
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО КАК СделкаРЕПО,
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата КАК СделкаРЕПОДата,
			|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
			|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ) КАК ВсегоДней,
			|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, &ДатаПереоценки, ДЕНЬ) КАК ДнейПрошло,
			|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ СделкиРЕПОПроценты
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&ПериодДата,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В (&СписокСтратегий)
			|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
			|				,
			|				&ПериодДата,
			|				Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления В (&СписокСтратегий)
			|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК РасходыПоКомиссии
			|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = РасходыПоКомиссии.Сделка
			|			И УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага = РасходыПоКомиссии.ЦеннаяБумага
			|ГДЕ
			|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ПериодДата
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	РасходыПоКомиссии.СуммаОборот,
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО,
			|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата,
			|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО,
			|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО, ДЕНЬ),
			|	РАЗНОСТЬДАТ(УсловияСделокРЕПОСрезПоследних.СделкаРЕПО.Дата, &ДатаПереоценки, ДЕНЬ),
			|	УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
			|ИЗ
			|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
			|			&ПериодДата,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В (&СписокСтратегий)
			|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
			|				,
			|				&ПериодДата,
			|				Период,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления В (&СписокСтратегий)
			|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК РасходыПоКомиссии
			|		ПО УсловияСделокРЕПОСрезПоследних.СделкаРЕПО = РасходыПоКомиссии.Сделка
			|			И УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага = РасходыПоКомиссии.ЦеннаяБумага
			|ГДЕ
			|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО > &ПериодДата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(СделкиРЕПОПроценты.КомиссияПоРЕПО) КАК КомиссияПоРЕПО,
			|	СделкиРЕПОПроценты.СделкаРЕПО КАК СделкаРЕПО,
			|	СделкиРЕПОПроценты.СделкаРЕПОДата КАК СделкаРЕПОДата,
			|	СделкиРЕПОПроценты.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
			|	СделкиРЕПОПроценты.ВсегоДней КАК ВсегоДней,
			|	СделкиРЕПОПроценты.ДнейПрошло КАК ДнейПрошло,
