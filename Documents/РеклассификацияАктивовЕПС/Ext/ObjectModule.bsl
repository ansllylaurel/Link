Процедура СоздатьПроводкуПереноса(ПараметрыПроводки)

	Если ПараметрыПроводки.СуммаВВалютеУчета = 0 И ПараметрыПроводки.Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПереноситьЧерезСчет000 = Ложь;
	Если НЕ ПараметрыПроводки.Свойство("ПереноситьЧерезСчет000", ПереноситьЧерезСчет000) Тогда
	    ПереноситьЧерезСчет000 = Ложь;
	КонецЕсли;
	
	Если ПараметрыПроводки.СуммаВВалютеУчета > 0 Тогда
		
		ПроводкаПереноса = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ПараметрыПроводки.СуммаВВалютеУчета, ПараметрыПроводки.Содержание);
		
		// дебет
		ПроводкаПереноса.СчетДт = ПараметрыПроводки.СчетЗачисления;
		
		Если ПроводкаПереноса.СчетДт = ПланыСчетов.Единый.АктивыВДУ03 Тогда
			ПроводкаПереноса.СубконтоДт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
		Иначе	
			ПроводкаПереноса.СубконтоДт.ЦенныеБумаги = ПараметрыПроводки.ЦеннаяБумага;
			ЕстьСубконтоДтРезервы = (ПроводкаПереноса.СчетДт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Резервы) <> Неопределено);
			
			Если ЕстьСубконтоДтРезервы Тогда
				ПроводкаПереноса.СубконтоДт.Резервы = Справочники.Резервы.РезервПодОбесценениеМСФО39;
			КонецЕсли;	
		КонецЕсли;	
		
