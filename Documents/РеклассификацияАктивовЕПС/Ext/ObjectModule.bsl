		|		ПО (_ДвиженияПартийРасход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|			И (_ДвиженияПартийПриход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))";
	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	ПараметрыПроводки = Новый Структура;
	
	ПараметрыПроводки.Вставить("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);
	ПараметрыПроводки.Вставить("ВалютаНоминала", ЭтотОбъект.ЦеннаяБумага.ВалютаНоминала);
	
	НакопленнаяДельта = 0;
	НакопленнаяДельтаВВалютеУчета = 0;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если Не ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы", ЭтотОбъект,,, Отказ);
		Возврат;
	КонецЕсли;
	
	// сначала начислим переоценку, купон, дисконт/премию
	ТаблицаДвиженийПереоценки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияПереоценки"].ПолучитьДанные().Выгрузить();
	Для Каждого ДвижениеПереоценки Из ТаблицаДвиженийПереоценки Цикл
		
		Если МассивУчетныхАктивов.Найти(ДвижениеПереоценки.УчетныйАктивЕПС) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(ДвижениеПереоценки.УчетныйАктивЕПС);
		КонецЕсли;
		
		ПараметрыНачисления = Новый Структура;
		
		ПараметрыНачисления.Вставить("СуммаУчета", ДвижениеПереоценки.ПереоценкаКупонаВВалютеУчета);
		ПараметрыНачисления.Вставить("СуммаВал", ДвижениеПереоценки.ПереоценкаКупона);
		ПараметрыНачисления.Вставить("ВалютаУчета", ЭтотОбъект.Организация.ВалютаУчета);
		ПараметрыНачисления.Вставить("УчетныйАктив", ДвижениеПереоценки.УчетныйАктивЕПС);
		ПараметрыНачисления.Вставить("ЦеннаяБумага", ПараметрыПроводки.ЦеннаяБумага);
		ПараметрыНачисления.Вставить("ВалютаНоминала", ПараметрыПроводки.ВалютаНоминала);
		ПараметрыНачисления.Вставить("ПереоценкаПослеВводаНачальныхОстатков", ?(ЭтотОбъект.ОтноситьПереоценкуНаАктивыВДУ03, Истина, Ложь));
		ПараметрыНачисления.Вставить("Аналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный);
		
		БухгалтерскийУчетЕПС.НачислитьНКД(ЭтотОбъект, ПараметрыНачисления, Отказ);
		
			
		ПараметрыНачисления.Вставить("СуммаВал", ДвижениеПереоценки.ДисконтПремияНачисленный);
		ПараметрыНачисления.Вставить("СуммаУчета", ДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета);
		Если ДвижениеПереоценки.ДисконтПремияНачисленный > 0 Тогда
			ПараметрыНачисления.Вставить("Аналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
			ПараметрыНачисления.Вставить("Доход", Истина);
		Иначе			
			ПараметрыНачисления.Вставить("Аналитика", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
			ПараметрыНачисления.Вставить("Доход", Ложь);
		КонецЕсли;
			
		БухгалтерскийУчетЕПС.НачислитьДисконтПремию(ЭтотОбъект, ПараметрыНачисления, Отказ);
		
		
		ПараметрыНачисления.Вставить("Показатель", "Переоценка");
		ПараметрыНачисления.Вставить("СуммаВал", ДвижениеПереоценки.Переоценка);
		ПараметрыНачисления.Вставить("СуммаУчета", ДвижениеПереоценки.ПереоценкаВВалютеУчета);
		ПараметрыНачисления.Вставить("Сделка", Неопределено);
		
		БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыНачисления, Отказ);
		
		
		ПараметрыНачисления.Вставить("Показатель", "КорректировкаЭСП");
		ПараметрыНачисления.Вставить("СуммаВал", ДвижениеПереоценки.КорректировкаЭСП);
		ПараметрыНачисления.Вставить("СуммаУчета", ДвижениеПереоценки.КорректировкаЭСПВВалютеУчета);
		
		БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыНачисления, Отказ);
		
		
		ПараметрыНачисления.Вставить("Показатель", "РазницаПервоначальногоПризнания");
		ПараметрыНачисления.Вставить("СуммаВал", ДвижениеПереоценки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
		ПараметрыНачисления.Вставить("СуммаУчета", ДвижениеПереоценки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета);
		
		БухгалтерскийУчетЕПС.ДвижениеКорректировки(ЭтотОбъект, ПараметрыНачисления, Отказ);
		
	КонецЦикла;
	
	
	// теперь будем переносить
	// 
	// при любом варианте рекласса перенесем:
