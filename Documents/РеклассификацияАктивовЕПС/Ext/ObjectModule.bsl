			//	НачислитьДисконтПремияНачисленныйВВалютеУчета = ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчета_Приход - ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчета_Расход;
			//	
			//	Если ВыборкаДетальныеЗаписи.ДисконтПремия_Приход > 0 Тогда
			//		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
			//	Иначе
			//		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
			//	КонецЕсли;
			//	ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчета);
			//	
