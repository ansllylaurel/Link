	ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
	ПараметрыПроводки.Вставить("ДополнительнаяАналитикаКт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
	ПараметрыПроводки.Вставить("Сумма", ВыборкаДетальныеЗаписи.ПремияНачисленная_Расход);
	ПараметрыПроводки.Вставить("СуммаВВалютеУчета", ВыборкаДетальныеЗаписи.ПремияНачисленнаяВВалютеУчета_Расход);
	
	ПараметрыПроводки.Вставить("Содержание", "Премия");
	СоздатьПроводкуПереноса(ПараметрыПроводки);
	
	// остальное
	Если ВыборкаДетальныеЗаписи.Переоценка_Расход <> 0 Тогда // СС → АС
		
		// при такой реклассификации (СС → АС) наша задача распихать переоценку и мы действуем так:
		//		0. Корректировку ПП в корректировку ЭСП - это ради одного случая сделано
		//		1. Пихаем сколько нужно в тело (если нужно, конечно)
		//		2. Пихаем сколько нужно в ДисконтПремияНачисленный (если нужно, конечно)  - это пока отключил ибо нелогично совсем
		//		3. Пихаем сколько нужно в КорректировкуПП (если нужно, конечно)
		//		4. Пихаем сколько ОСТАЛОСЬ переоценки в КорректировкуЭСП (если нужно, конечно)
		//		5. Если после предыдущего шага КорректировкаЭСП еще не доросла до нужной суммы - доначисляем
		
		НачислитьКорректировкаЭСП = 0;
		НачислитьКорректировкаЭСПВВалютеУчета = 0;
		
		Если ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход <> 0
			И ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Приход = 0 Тогда // вся корректировка ПП в корректировку ЭСП
			
			НачислитьКорректировкаЭСП = ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход;
			НачислитьКорректировкаЭСПВВалютеУчета = ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета_Расход;
			
			ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Неопределено);
			Если НачислитьКорректировкаЭСП > 0 Тогда
				ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокА);
			Иначе	
				ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокП);
			КонецЕсли;
			
			ПараметрыПроводки.Вставить("ДополнительнаяАналитикаКт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
			Если ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход > 0 Тогда
				ПараметрыПроводки.Вставить("СчетСписания", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Расход_СчетУчетаКорректировокА);
