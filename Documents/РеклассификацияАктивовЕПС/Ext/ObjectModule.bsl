			Иначе
				ПараметрыПроводки.Вставить("СчетСписания", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Расход_СчетУчетаПереоценкиП);
			КонецЕсли;
			ПараметрыПроводки.Вставить("Содержание", "Переоценка");
			
			Если ВыборкаДетальныеЗаписи.Стоимость_Расход <> ВыборкаДетальныеЗаписи.Стоимость_Приход Тогда // ага, нужно стоимость добить
			
				НачислитьСтоимость = ВыборкаДетальныеЗаписи.Стоимость_Приход - ВыборкаДетальныеЗаписи.Стоимость_Расход;
				НачислитьСтоимостьВВалютеУчета = ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета_Приход - ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета_Расход;
				
				ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
