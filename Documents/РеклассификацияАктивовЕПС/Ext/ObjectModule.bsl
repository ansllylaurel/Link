			ПараметрыПроводки.Вставить("Сумма", НачислитьКорректировкаЭСП);
			ПараметрыПроводки.Вставить("СуммаВВалютеУчета", НачислитьКорректировкаЭСПВВалютеУчета);
			
			ПараметрыПроводки.Вставить("Содержание", "Перенос корректировку ПП в корректировку ЭСП");
			СоздатьПроводкуПереноса(ПараметрыПроводки);
			
		КонецЕсли;
		
		
		ОсталосьПереоценки = ВыборкаДетальныеЗаписи.Переоценка_Расход;
		ОсталосьПереоценкиВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета_Расход;
		
		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаКт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
		Если ОсталосьПереоценки > 0 Тогда
			ПараметрыПроводки.Вставить("СчетСписания", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Расход_СчетУчетаПереоценкиА);
		Иначе
			ПараметрыПроводки.Вставить("СчетСписания", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Расход_СчетУчетаПереоценкиП);
		КонецЕсли;
		ПараметрыПроводки.Вставить("Содержание", "Переоценка");
		
		Если ВыборкаДетальныеЗаписи.Стоимость_Расход <> ВыборкаДетальныеЗаписи.Стоимость_Приход Тогда // ага, нужно стоимость добить
		
			НачислитьСтоимость = ВыборкаДетальныеЗаписи.Стоимость_Приход - ВыборкаДетальныеЗаписи.Стоимость_Расход;
			НачислитьСтоимостьВВалютеУчета = ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета_Приход - ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета_Расход;
			
			ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
			ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчета);
			
			ПараметрыПроводки.Вставить("Сумма", НачислитьСтоимость);
			ПараметрыПроводки.Вставить("СуммаВВалютеУчета", НачислитьСтоимостьВВалютеУчета);
			
			ПараметрыПроводки.Вставить("Содержание", "Перенос переоценки в тело ценной бумаги");
			СоздатьПроводкуПереноса(ПараметрыПроводки);
			
			ОсталосьПереоценки = ОсталосьПереоценки - НачислитьСтоимость;
			ОсталосьПереоценкиВВалютеУчета = ОсталосьПереоценкиВВалютеУчета - НачислитьСтоимостьВВалютеУчета;
			
		КонецЕсли;
		
		//Если ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный_Расход <> ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный_Приход Тогда // дисконт/премию добиваем
		//
		//	НачислитьДисконтПремияНачисленный = ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный_Приход - ВыборкаДетальныеЗаписи.ДисконтПремияНачисленный_Расход;
		//	НачислитьДисконтПремияНачисленныйВВалютеУчета = ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчета_Приход - ВыборкаДетальныеЗаписи.ДисконтПремияНачисленныйВВалютеУчета_Расход;
		//	
		//	Если ВыборкаДетальныеЗаписи.ДисконтПремия_Приход > 0 Тогда
		//		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия);
		//	Иначе
		//		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт);
		//	КонецЕсли;
		//	ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчета);
		//	
		//	ПараметрыПроводки.Вставить("Сумма", НачислитьДисконтПремияНачисленный);
		//	ПараметрыПроводки.Вставить("СуммаВВалютеУчета", НачислитьДисконтПремияНачисленныйВВалютеУчета);
		//	
		//	ПараметрыПроводки.Вставить("Содержание", "Перенос переоценки в дисконт");
		//	СоздатьПроводкуПереноса(ПараметрыПроводки);
		//	
		//	ОсталосьПереоценки = ОсталосьПереоценки - НачислитьДисконтПремияНачисленный;
		//	ОсталосьПереоценкиВВалютеУчета = ОсталосьПереоценкиВВалютеУчета - НачислитьДисконтПремияНачисленныйВВалютеУчета;
		//	
		//КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход - НачислитьКорректировкаЭСП <> ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Приход Тогда // корректировку ПП добиваем
		
			НачислитьРазницаПервоначальногоПризнания = ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Приход - ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход + + НачислитьКорректировкаЭСП;
			НачислитьРазницаПервоначальногоПризнанияВВалютеУчета = ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Приход - ВыборкаДетальныеЗаписи.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход + НачислитьКорректировкаЭСПВВалютеУчета;
			
			ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания);
			Если НачислитьРазницаПервоначальногоПризнания > 0 Тогда
				ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокА);
			Иначе	
				ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокП);
			КонецЕсли;
			
			ПараметрыПроводки.Вставить("Сумма", НачислитьРазницаПервоначальногоПризнания);
			ПараметрыПроводки.Вставить("СуммаВВалютеУчета", НачислитьРазницаПервоначальногоПризнанияВВалютеУчета);
			
			ПараметрыПроводки.Вставить("Содержание", "Перенос переоценки в корректировку ПП");
			СоздатьПроводкуПереноса(ПараметрыПроводки);
			
			ОсталосьПереоценки = ОсталосьПереоценки - НачислитьРазницаПервоначальногоПризнания;
			ОсталосьПереоценкиВВалютеУчета = ОсталосьПереоценкиВВалютеУчета - НачислитьРазницаПервоначальногоПризнанияВВалютеУчета;
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.КорректировкаЭСП_Расход <> ВыборкаДетальныеЗаписи.КорректировкаЭСП_Приход - НачислитьКорректировкаЭСП Тогда // корректировку ЭСП добиваем
			
			НадоНачислитьКорректировкаЭСП = ВыборкаДетальныеЗаписи.КорректировкаЭСП_Приход - ВыборкаДетальныеЗаписи.КорректировкаЭСП_Расход - НачислитьКорректировкаЭСП;
			НадоНачислитьКорректировкаЭСПВВалютеУчета = ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчета_Приход - ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчета_Расход - НачислитьКорректировкаЭСПВВалютеУчета;
			
			НачислитьКорректировкаЭСП = ОсталосьПереоценки;
			НачислитьКорректировкаЭСПВВалютеУчета = ОсталосьПереоценкиВВалютеУчета;
			
			ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Неопределено);
			Если НачислитьКорректировкаЭСП > 0 Тогда
				ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокА);
			Иначе	
				ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокП);
			КонецЕсли;
			
			ПараметрыПроводки.Вставить("Сумма", НачислитьКорректировкаЭСП);
			ПараметрыПроводки.Вставить("СуммаВВалютеУчета", НачислитьКорректировкаЭСПВВалютеУчета);
			
			ПараметрыПроводки.Вставить("Содержание", "Перенос переоценки в корректировку ЭСП");
			СоздатьПроводкуПереноса(ПараметрыПроводки);
			
