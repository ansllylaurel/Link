Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	//УстановитьБлокировки();
	//
	//РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	//
	//Движения.ГипотетическийБэкофисныйРегистрДляРеклассификаций.Записывать = Истина;
	
	Движения.ОперацииСЦеннымиБумагами.Записывать   = Истина;
	
	Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
	Движение.Операция                     = ЭтотОбъект.Ссылка;
	Движение.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Рынок 						  = РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЭтотОбъект.ЦеннаяБумага);
	Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
	Движение.ДатаПоставки                 = ЭтотОбъект.Дата;
	Движение.Количество                   = ЭтотОбъект.Партии.Итог("Количество");
	Движение.Сумма                        = ЭтотОбъект.Партии.Итог("СтоимостьВВалютеУчета")
											+ ЭтотОбъект.Партии.Итог("ПереоценкаВВалютеУчета")
											+ ЭтотОбъект.Партии.Итог("ДисконтПремияНачисленныйВВалютеУчета")
											+ ЭтотОбъект.Партии.Итог("КорректировкаЭСПВВалютеУчета")
											+ ЭтотОбъект.Партии.Итог("РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета");
	Движение.СуммаКупона                  = 0;
	Движение.ДатаОперации                 = ЭтотОбъект.Дата;
	Движение.Валюта						  = ЭтотОбъект.Организация.ВалютаУчета;
	Движение.СтрокаПартии                 = 0;
	Движение.ДатаПокупки				  = ЭтотОбъект.Дата;
	
		
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПССПартиямиНаЛицевыхСчетах(УчетныйРегистр, НастройкиУчета, Отказ) Экспорт
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	АналитикаТела 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный = Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремии 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконта 			= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	
	МассивУчетныхАктивов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.Переоценка КАК Переоценка,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС1,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчетаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГодаОстаток
		|ПОМЕСТИТЬ _ДвиженияПереоценки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&Период,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ЦеннаяБумага = &ЦеннаяБумага) КАК БухПартииЦенныхБумагОстатки
		|		ПО БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И БухПартииЦенныхБумаг.Количество = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК Количество,
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ДисконтПремия > 0
		|				ТОГДА 0
		|			ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремия
		|		КОНЕЦ) КАК Дисконт,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ДисконтПремия <= 0
		|				ТОГДА 0
		|			ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремия
		|		КОНЕЦ) КАК Премия,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ДисконтПремия > 0
		|				ТОГДА 0
		|			ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленный
		|		КОНЕЦ) КАК ДисконтНачисленный,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ДисконтПремия <= 0
		|				ТОГДА 0
		|			ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленный
		|		КОНЕЦ) КАК ПремияНачисленная,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ДисконтПремия > 0
		|				ТОГДА 0
		|			ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета
		|		КОНЕЦ) КАК ДисконтНачисленныйВВалютеУчета,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ДисконтПремия <= 0
		|				ТОГДА 0
		|			ИНАЧЕ БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета
		|		КОНЕЦ) КАК ПремияНачисленнаяВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСП) КАК КорректировкаЭСП,
		|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрок) КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	СУММА(БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета) КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчета КАК УчетныйАктивЕПС_СчетУчета,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаСписанияПремии КАК УчетныйАктивЕПС_АналитикаСписанияПремии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаПроцентныхДоходов КАК УчетныйАктивЕПС_АналитикаПроцентныхДоходов,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаДоходовОтПереоценки КАК УчетныйАктивЕПС_АналитикаДоходовОтПереоценки,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаРасходовОтПереоценки КАК УчетныйАктивЕПС_АналитикаРасходовОтПереоценки,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаПереоценкиА КАК УчетныйАктивЕПС_СчетУчетаПереоценкиА,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаПереоценкиП КАК УчетныйАктивЕПС_СчетУчетаПереоценкиП
		|ПОМЕСТИТЬ _ДвиженияПартий
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.Количество <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ВидДвижения,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчета,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаПереоценкиА,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаПереоценкиП,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаСписанияПремии,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаПроцентныхДоходов,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаДоходовОтПереоценки,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.АналитикаРасходовОтПереоценки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС КАК УчетныйАктивЕПС_Расход,
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС.СчетУчета КАК УчетныйАктивЕПС_Расход_СчетУчета,
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС.СчетУчетаПереоценкиА КАК УчетныйАктивЕПС_Расход_СчетУчетаПереоценкиА,
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС.СчетУчетаПереоценкиП КАК УчетныйАктивЕПС_Расход_СчетУчетаПереоценкиП,
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС.СчетУчетаКорректировокА КАК УчетныйАктивЕПС_Расход_СчетУчетаКорректировокА,
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС.СчетУчетаКорректировокП КАК УчетныйАктивЕПС_Расход_СчетУчетаКорректировокП,
		|	_ДвиженияПартийРасход.УчетныйАктивЕПС.СчетУчетаРезервов КАК УчетныйАктивЕПС_Расход_СчетУчетаРезервов,
		|	_ДвиженияПартийРасход.Количество КАК Количество,
		|	_ДвиженияПартийРасход.СтоимостьКупона КАК СтоимостьКупона,
		|	_ДвиженияПартийРасход.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	_ДвиженияПартийРасход.ПереоценкаКупона КАК ПереоценкаКупона,
		|	_ДвиженияПартийРасход.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	_ДвиженияПартийРасход.ПогашениеКупонаНеИсполненноеВСрок КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	_ДвиженияПартийРасход.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета,
		|	_ДвиженияПартийРасход.Стоимость КАК Стоимость_Расход,
		|	_ДвиженияПартийРасход.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета_Расход,
		|	_ДвиженияПартийРасход.Переоценка КАК Переоценка_Расход,
		|	_ДвиженияПартийРасход.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета_Расход,
		|	_ДвиженияПартийРасход.ДисконтНачисленный КАК ДисконтНачисленный_Расход,
		|	_ДвиженияПартийРасход.ДисконтНачисленныйВВалютеУчета КАК ДисконтНачисленныйВВалютеУчета_Расход,
		|	_ДвиженияПартийРасход.ПремияНачисленная КАК ПремияНачисленная_Расход,
		|	_ДвиженияПартийРасход.ПремияНачисленнаяВВалютеУчета КАК ПремияНачисленнаяВВалютеУчета_Расход,
		|	_ДвиженияПартийРасход.КорректировкаЭСП КАК КорректировкаЭСП_Расход,
		|	_ДвиженияПартийРасход.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета_Расход,
		|	_ДвиженияПартийРасход.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Расход,
		|	_ДвиженияПартийРасход.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета_Расход,
		|	_ДвиженияПартийРасход.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение_Расход,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС КАК УчетныйАктивЕПС_Приход,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС.СчетУчета КАК УчетныйАктивЕПС_Приход_СчетУчета,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС.СчетУчетаПереоценкиА КАК УчетныйАктивЕПС_Приход_СчетУчетаПереоценкиА,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС.СчетУчетаПереоценкиП КАК УчетныйАктивЕПС_Приход_СчетУчетаПереоценкиП,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС.СчетУчетаКорректировокА КАК УчетныйАктивЕПС_Приход_СчетУчетаКорректировокА,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС.СчетУчетаКорректировокП КАК УчетныйАктивЕПС_Приход_СчетУчетаКорректировокП,
		|	_ДвиженияПартийПриход.УчетныйАктивЕПС.СчетУчетаРезервов КАК УчетныйАктивЕПС_Приход_СчетУчетаРезервов,
		|	_ДвиженияПартийПриход.Стоимость КАК Стоимость_Приход,
		|	_ДвиженияПартийПриход.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета_Приход,
		|	_ДвиженияПартийПриход.Переоценка КАК Переоценка_Приход,
		|	_ДвиженияПартийПриход.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета_Приход,
		|	_ДвиженияПартийПриход.ДисконтНачисленный КАК ДисконтНачисленный_Приход,
		|	_ДвиженияПартийПриход.ДисконтНачисленныйВВалютеУчета КАК ДисконтНачисленныйВВалютеУчета_Приход,
		|	_ДвиженияПартийПриход.ПремияНачисленная КАК ПремияНачисленная_Приход,
		|	_ДвиженияПартийПриход.ПремияНачисленнаяВВалютеУчета КАК ПремияНачисленнаяВВалютеУчета_Приход,
		|	_ДвиженияПартийПриход.КорректировкаЭСП КАК КорректировкаЭСП_Приход,
		|	_ДвиженияПартийПриход.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета_Приход,
		|	_ДвиженияПартийПриход.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные_Приход,
		|	_ДвиженияПартийПриход.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета_Приход,
		|	_ДвиженияПартийПриход.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение_Приход,
		|	_ДвиженияПартийПриход.Партия КАК Партия_Приход,
		|	_ДвиженияПартийПриход.СтрокаПартии КАК СтрокаПартии_Приход,
		|	_ДвиженияПартийРасход.Партия КАК Партия_Расход,
		|	_ДвиженияПартийРасход.СтрокаПартии КАК СтрокаПартии_Расход
		|ИЗ
		|	Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДвиженияПартий КАК _ДвиженияПартийРасход
		|		ПО РеклассификацияАктивовЕПСПартии.Партия = _ДвиженияПартийРасход.Партия
		|			И РеклассификацияАктивовЕПСПартии.СтрокаПартии = _ДвиженияПартийРасход.СтрокаПартии
		|			И (_ДвиженияПартийРасход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДвиженияПартий КАК _ДвиженияПартийПриход
		|		ПО (_ДвиженияПартийПриход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					И РеклассификацияАктивовЕПСПартии.Ссылка = _ДвиженияПартийПриход.Партия
		|					И РеклассификацияАктивовЕПСПартии.НомерСтроки = _ДвиженияПартийПриход.СтрокаПартии
		|				ИЛИ _ДвиженияПартийПриход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					И РеклассификацияАктивовЕПСПартии.Партия = _ДвиженияПартийПриход.Партия
		|					И РеклассификацияАктивовЕПСПартии.СтрокаПартии = _ДвиженияПартийПриход.СтрокаПартии)
		|ГДЕ
		|	РеклассификацияАктивовЕПСПартии.Ссылка = &Регистратор";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);	
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	ПараметрыПроводки = Новый Структура;
	
	ПараметрыПроводки.Вставить("ЦеннаяБумага", ЭтотОбъект.ЦеннаяБумага);
	ПараметрыПроводки.Вставить("ВалютаНоминала", ЭтотОбъект.ЦеннаяБумага.ВалютаНоминала);
	ПараметрыПроводки.Вставить("ПереноситьЧерезСчет000", Истина);
	
	НакопленнаяДельта = 0;
	НакопленнаяДельтаВВалютеУчета = 0;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы", ЭтотОбъект,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ПараметрыНачисления = Новый Структура;
	
	ПараметрыНачисления.Вставить("НастройкиУчета",	НастройкиУчета);
	
	ПараметрыНачисления.Вставить("ЦеннаяБумага",	ЭтотОбъект.ЦеннаяБумага);
	ПараметрыНачисления.Вставить("ВалютаНоминала",	ЭтотОбъект.ЦеннаяБумага.ВалютаНоминала);
	
	
	// сначала начислим переоценку, купон, дисконт/премию
	ТаблицаДвиженийПереоценки = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияПереоценки"].ПолучитьДанные().Выгрузить();
	Для каждого ДвижениеПереоценки Из ТаблицаДвиженийПереоценки Цикл
		
		Если МассивУчетныхАктивов.Найти(ДвижениеПереоценки.УчетныйАктивЕПС) = Неопределено Тогда
			МассивУчетныхАктивов.Добавить(ДвижениеПереоценки.УчетныйАктивЕПС);
		КонецЕсли;
		
		ПараметрыНачисления.Вставить("Партия",			ДвижениеПереоценки.Партия);
		ПараметрыНачисления.Вставить("СтрокаПартии",	ДвижениеПереоценки.СтрокаПартии);
		ПараметрыНачисления.Вставить("Количество",		0);
		ПараметрыНачисления.Вставить("ПроверитьПарные",	"");
		
		// дисконт-премия	
		ПараметрыНачисления.Вставить("Сумма",				ДвижениеПереоценки.ДисконтПремияНачисленный);
		ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета);
		
		ПараметрыНачисления.Вставить("СчетУчета",			ДвижениеПереоценки.УчетныйАктивЕПС.СчетУчета);
		Если ДвижениеПереоценки.ДисконтПремияНачисленный < 0 Тогда
			ПараметрыНачисления.Вставить("Содержание",			"Списание премии");
			ПараметрыНачисления.Вставить("Аналитика",			АналитикаПремии);
			ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы04);
			ПараметрыНачисления.Вставить("ГФУ",					ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаСписанияПремии);
		Иначе
			ПараметрыНачисления.Вставить("Содержание",			"Начисление дисконта");
			ПараметрыНачисления.Вставить("Аналитика",			АналитикаДисконта);
			ПараметрыНачисления.Вставить("СчетДоходовРасходов",	ПланыСчетов.Единый.ПроцентныеДоходы01);
			ПараметрыНачисления.Вставить("ГФУ",					ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаПроцентныхДоходов);
		КонецЕсли;
		
		БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
			
		// ННКД	
		ПараметрыНачисления.Вставить("Сумма",				ДвижениеПереоценки.ПереоценкаКупона);
		ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ДвижениеПереоценки.ПереоценкаКупонаВВалютеУчета);
		
		ПараметрыНачисления.Вставить("СчетУчета",			ДвижениеПереоценки.УчетныйАктивЕПС.СчетУчета);
		ПараметрыНачисления.Вставить("Содержание",			"Переоценка купона");
		ПараметрыНачисления.Вставить("Аналитика",			АналитикаКупонНачисленный);
		ПараметрыНачисления.Вставить("СчетДоходовРасходов", ПланыСчетов.Единый.ПроцентныеДоходы01);
		ПараметрыНачисления.Вставить("ГФУ",					ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаПроцентныхДоходов);
		
		БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
		
		// переоценка
		БалансоваяПереоценка = ДвижениеПереоценки.ПереоценкаОстаток;
		БалансоваяПереоценкаВВалютеУчета = ДвижениеПереоценки.ПереоценкаВВалютеУчетаОстаток;
		
		ПараметрыНачисления.Вставить("Сумма",				ДвижениеПереоценки.Переоценка);
		ПараметрыНачисления.Вставить("СуммаВВалютеУчета",	ДвижениеПереоценки.ПереоценкаВВалютеУчета);
		ПараметрыНачисления.Вставить("СуммаСНачалаГода",	ДвижениеПереоценки.ПереоценкаСНачалаГодаОстаток + ДвижениеПереоценки.ПереоценкаВВалютеУчета);
		ПараметрыНачисления.Вставить("СуммаБалансовая",		БалансоваяПереоценка);
		ПараметрыНачисления.Вставить("СуммаБалансоваяВВалютеУчета",		БалансоваяПереоценкаВВалютеУчета);
		
		ПараметрыНачисления.Вставить("Содержание",			"Переоценка");
		ПараметрыНачисления.Вставить("Аналитика",			Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги);
		
		ПараметрыНачисления.Вставить("ПроверитьПарные",		"Переоценка");
		
		Если (БалансоваяПереоценкаВВалютеУчета > 0)ИЛИ(БалансоваяПереоценкаВВалютеУчета = 0 И ДвижениеПереоценки.ПереоценкаВВалютеУчета > 0) Тогда
			ПараметрыНачисления.Вставить("СчетУчета",		ДвижениеПереоценки.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
			ПараметрыНачисления.Вставить("СчетУчетаПарный",	ДвижениеПереоценки.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
		Иначе
			ПараметрыНачисления.Вставить("СчетУчета",		ДвижениеПереоценки.УчетныйАктивЕПС.СчетУчетаПереоценкиП);
			ПараметрыНачисления.Вставить("СчетУчетаПарный",	ДвижениеПереоценки.УчетныйАктивЕПС.СчетУчетаПереоценкиА);
		КонецЕсли;
		
		Если (ДвижениеПереоценки.ПереоценкаСНачалаГодаОстаток > 0)ИЛИ(ДвижениеПереоценки.ПереоценкаСНачалаГодаОстаток = 0 И ДвижениеПереоценки.ПереоценкаВВалютеУчета > 0) Тогда
			ПараметрыНачисления.Вставить("СчетДоходовРасходов", БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ДвижениеПереоценки.УчетныйАктивЕПС));
			ПараметрыНачисления.Вставить("ГФУ",				ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаДоходовОтПереоценки);
			
			ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ДвижениеПереоценки.УчетныйАктивЕПС, Ложь));
			ПараметрыНачисления.Вставить("ГФУПарный",		ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаРасходовОтПереоценки);
		Иначе
			ПараметрыНачисления.Вставить("СчетДоходовРасходов",	БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ДвижениеПереоценки.УчетныйАктивЕПС, Ложь));
			ПараметрыНачисления.Вставить("ГФУ",				ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаРасходовОтПереоценки);
			
			ПараметрыНачисления.Вставить("СчетДоходовРасходовПарный", БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(ДвижениеПереоценки.УчетныйАктивЕПС));
			ПараметрыНачисления.Вставить("ГФУПарный",		ДвижениеПереоценки.УчетныйАктивЕПС_АналитикаДоходовОтПереоценки);
		КонецЕсли;
			
		БухгалтерскийУчетЕПС.СформироватьПроводкиНачисленияПроцентовПереоценкиСПартиямиНаЛицевыхСчетах(ЭтотОбъект, УчетныйРегистр, ПараметрыНачисления);
		
	КонецЦикла;
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПараметрыПроводки.Вставить("Партия_Приход", ВыборкаДетальныеЗаписи.Партия_Приход);
		ПараметрыПроводки.Вставить("СтрокаПартии_Приход", ВыборкаДетальныеЗаписи.СтрокаПартии_Приход);
		
		ПараметрыПроводки.Вставить("Партия_Расход", ВыборкаДетальныеЗаписи.Партия_Расход);
		ПараметрыПроводки.Вставить("СтрокаПартии_Расход", ВыборкаДетальныеЗаписи.СтрокаПартии_Расход);
		
		// теперь будем переносить
		// 
		// при любом варианте рекласса перенесем:
		//	1. Неизменяемые части стоимости: УНКД, ННКД, просроченный НКД
		//	2. Перенесем части стоимости, которые уходят целиком, но потом могут быть откорректированы: Тело, ДисконтПремияНачисленный
		
		ПараметрыПроводки.Вставить("СчетСписания", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Расход_СчетУчета);
		ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчета);
		
		// сначала перенесем Стоимость 1к1
		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
		ПараметрыПроводки.Вставить("ДополнительнаяАналитикаКт", Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги);
		ПараметрыПроводки.Вставить("Сумма", ВыборкаДетальныеЗаписи.Стоимость_Расход);
