				НачислитьКорректировкаЭСП = ОсталосьПереоценки;
				НачислитьКорректировкаЭСПВВалютеУчета = ОсталосьПереоценкиВВалютеУчета;
				
				ПараметрыПроводки.Вставить("ДополнительнаяАналитикаДт", Неопределено);
				Если НачислитьКорректировкаЭСП > 0 Тогда
					ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокА);
				Иначе	
					ПараметрыПроводки.Вставить("СчетЗачисления", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС_Приход_СчетУчетаКорректировокП);
				КонецЕсли;
				
				ПараметрыПроводки.Вставить("Сумма", НачислитьКорректировкаЭСП);
				ПараметрыПроводки.Вставить("СуммаВВалютеУчета", НачислитьКорректировкаЭСПВВалютеУчета);
				
				ПараметрыПроводки.Вставить("Содержание", "Перенос переоценки в корректировку ЭСП");
				СоздатьПроводкуПереноса(ПараметрыПроводки);
				
				ДоначислитьКорректировкаЭСП = НадоНачислитьКорректировкаЭСП - НачислитьКорректировкаЭСП;
				ДоначислитьКорректировкаЭСПВВалютеУчета = НадоНачислитьКорректировкаЭСПВВалютеУчета - НачислитьКорректировкаЭСПВВалютеУчета;
				
				ПараметрыСписания = Новый Структура;
				
				ПараметрыСписания.Вставить("Показатель", "КорректировкаЭСП");
				ПараметрыСписания.Вставить("СуммаВал", ДоначислитьКорректировкаЭСП);
				ПараметрыСписания.Вставить("СуммаУчета", ДоначислитьКорректировкаЭСПВВалютеУчета);
