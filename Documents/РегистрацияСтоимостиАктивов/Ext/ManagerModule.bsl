	КонецЦикла;
	
#Область Строка010

	КоличествоДней_Строка010 = ?(ДоговорЗаключенПослеНачалаГода, ДеньГода(Период) - ДеньГода(ПериодыСЧА.НачалоГода) + 1, ДеньГода(Период));
	Расшифровка_Строка010 = Новый Структура;
