		ФинансовыеПоказатели.Вставить("Расшифровка_Строка020"	, Расшифровка_Строка020);
		ФинансовыеПоказатели.Вставить("Расшифровка_Строка030"	, Расшифровка_Строка030);
		ФинансовыеПоказатели.Вставить("Расшифровка_Строка040"	, Расшифровка_Строка040);	
