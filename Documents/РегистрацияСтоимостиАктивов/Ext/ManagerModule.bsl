КонецПроцедуры

#КонецОбласти

#Область Расчет_доходности_инвестирования_ПФР

// Расчет Доходности ПФР
Процедура ДобавитьВРасшифровкуСреднееГеометрическое(ТаблицаДоходностей, Доходность, Формула)
	
	Основание = 1;
	МассивМножителей = Новый Массив;
	
	Для Каждого СтрокаДоходностей Из ТаблицаДоходностей Цикл
		Основание = Основание * (СтрокаДоходностей.Доходность/100+1);
		МассивМножителей.Добавить("(" + Формат(СтрокаДоходностей.Доходность, "ЧДЦ=2") + "/100 + 1)");
	КонецЦикла;
	
	Доходность = Окр((Pow(Основание, 1/ТаблицаДоходностей.Количество())-1)*100, 2);
	Формула = "(" + СтрСоединить(МассивМножителей, "*") + "^(1/" + ТаблицаДоходностей.Количество() + " - 1)*100 = " + Формат(Доходность, "ЧДЦ=2");
	
КонецПроцедуры

Функция ПолучитьДатуРасчетаДоходностиПФР(Организация, СчетДоверительногоУправления, Период, Отказ) Экспорт
	
	ДатаРасчетаДоходности = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(СчетДоверительногоУправления, НачалоКвартала(Период), КонецКвартала(Период), Отказ);
	
	Если ДатаРасчетаДоходности = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить дату расчета доходности ПФР для счета " + СчетДоверительногоУправления + " на " + Формат(КонецКвартала(Период), "ДФ=dd.MM.yy"), СчетДоверительногоУправления);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДатаРасчетаДоходности;
	
КонецФункции

Функция РассчитатьДоходностьИнвестированияПФР(Организация, СчетДоверительногоУправления, Период, РасшифровкаРасчета = Ложь) Экспорт
	
	ДнейВГоду = ДеньГода(КонецГода(Период));
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация"						, Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"	, СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период"							, Период);
	
	ДатаЗаключения					= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ДатаЗаключения");
	ДоговорЗаключенПослеНачалаГода	= ДатаЗаключения > НачалоГода(Период);
	
	Запрос.УстановитьПараметр("ДоговорЗаключенПослеНачалаГода",	ДоговорЗаключенПослеНачалаГода); 
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ФинансовыеПоказателиСрезПоследних.Период, ДЕНЬ) КАК Период,
