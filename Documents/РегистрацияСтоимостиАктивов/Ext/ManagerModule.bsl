		|				И СубъектАналитики = &СчетДоверительногоУправления
		|				И ВидПоказателя В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.ДоходностьПФР))) КАК ФинансовыеПоказателиСрезПоследних
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ФинансовыеПоказателиСрезПоследних.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)";
#КонецОбласти

	Запрос.Выполнить();
	
	ПериодыСЧА = Новый Структура;
	ПериодыСЧА.Вставить("Период"		, Период);
	ПериодыСЧА.Вставить("НачалоГода"	, КонецГода(ДобавитьМесяц(Период, -12)));
	ПериодыСЧА.Вставить("ПериодМинусГод", ДобавитьМесяц(Период, -12));
	
	Для Каждого СтрокаПериода Из Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПериодыИСЧА").ПолучитьДанные().Выгрузить() Цикл
		Если ЗначениеЗаполнено(СтрокаПериода.Период) Тогда
			ПериодыСЧА.Вставить(СтрокаПериода.ИдентификаторПериода, СтрокаПериода.Период);
