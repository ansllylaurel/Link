#Область Расчет_резервов_ПИФ

Функция ПолучитьПредварительнуюСЧА(ПараметрыЗаполнения) Экспорт
	
	Запрос = Новый Запрос;
	
	ОтсутствуютНастройки = Ложь;	
	ДатаПредыдущегоСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ПараметрыЗаполнения.СчетДоверительногоУправления, ПараметрыЗаполнения.Дата, ОтсутствуютНастройки); 
	Если ОтсутствуютНастройки Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СокрЛП(ПараметрыЗаполнения.СчетДоверительногоУправления) + " не определены настройки формирования СЧА на дату " + Формат(ПараметрыЗаполнения.Дата, "ДФ=dd.MM.yyyy") + "", ПараметрыЗаполнения.СчетДоверительногоУправления);
		Возврат Неопределено;
	КонецЕсли;
	                                                                                                                                                                 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаКурса", 							НачалоДня(ПараметрыЗаполнения.Дата));
	Запрос.УстановитьПараметр("Организация", 						ПараметрыЗаполнения.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 		ПараметрыЗаполнения.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", 			ПараметрыЗаполнения.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("ВалютаУчета", 						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыЗаполнения.Организация, "ВалютаУчета")); 	
	Запрос.УстановитьПараметр("ДатаПредыдущегоСЧА", 				Новый Граница(КонецДня(ДатаПредыдущегоСЧА), ВидГраницы.Включая));		
	Запрос.УстановитьПараметр("ПериодОкончание", 					Новый Граница(КонецДня(ПараметрыЗаполнения.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СтоимостиПереоценки", 				ПараметрыЗаполнения.СтоимостиПереоценки);
	Запрос.УстановитьПараметр("АктивыНеОтносящиесяКЦеннымБумагам", 	ПараметрыЗаполнения.АктивыНеОтносящиесяКЦеннымБумагам);
	
	Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьКурсыВалютВМенеджерВременныхТаблиц(Запрос, НачалоДня(ПараметрыЗаполнения.Дата));
	
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего) КАК Резерв
		|ПОМЕСТИТЬ _РезервыДляУчетаВСЧА
		|ИЗ
		|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ПериодОкончание, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|ГДЕ
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика)
		|ИЗ
		|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ПериодОкончание, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|ГДЕ
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Резервы.ПрочиеВозмещаемыеРасходыУправляющего)
		|ИЗ
		|	РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ПериодОкончание, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|ГДЕ
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаПрочиеВозмещаемыеРасходыУправляющего
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПИФОстаткиИОбороты.Резерв КАК Резерв,
		|	РезервыПИФОстаткиИОбороты.Валюта КАК Валюта,
		|	-(РезервыПИФОстаткиИОбороты.СуммаКонечныйОстаток - РезервыПИФОстаткиИОбороты.СуммаПриход) КАК Сумма
		|ПОМЕСТИТЬ _ОстаткиРезервов
		|ИЗ
		|	РегистрНакопления.РезервыПИФ.ОстаткиИОбороты(
		|			&ДатаПредыдущегоСЧА,
		|			&ПериодОкончание,
		|			,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Резерв В
		|					(ВЫБРАТЬ
		|						_РезервыДляУчетаВСЧА.Резерв
		|					ИЗ
		|						_РезервыДляУчетаВСЧА)) КАК РезервыПИФОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостиПереоценки.СуммаКупонаВВалютеУчета + СтоимостиПереоценки.СуммаВВалютеУчета КАК Сумма
		|ПОМЕСТИТЬ _РСП
		|ИЗ
		|	&СтоимостиПереоценки КАК СтоимостиПереоценки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АктивыНеОтносящиесяКЦеннымБумагам.СуммаРынокВВалютеУчета КАК Сумма,
		|	АктивыНеОтносящиесяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	ВЫРАЗИТЬ(АктивыНеОтносящиесяКЦеннымБумагам.Основание КАК Документ.НачислениеЗадолженности) КАК Основание
		|ПОМЕСТИТЬ _ПрочиеАктивыНеРезервы
		|ИЗ
		|	&АктивыНеОтносящиесяКЦеннымБумагам КАК АктивыНеОтносящиесяКЦеннымБумагам
		|ГДЕ
		|	ВЫРАЗИТЬ(АктивыНеОтносящиесяКЦеннымБумагам.ВидЗадолженности КАК Справочник.Резервы) ЕСТЬ NULL
		|	И АктивыНеОтносящиесяКЦеннымБумагам.Примечание <> ""КЗ: Расч. По вознаграждению управляющего""
		|	И АктивыНеОтносящиесяКЦеннымБумагам.Примечание <> ""КЗ: Расч. расходы по вознаграждению спецдепозитария""
		|	И АктивыНеОтносящиесяКЦеннымБумагам.Примечание <> ""КЗ: Расч. расходы по вознаграждению спец.регистратора""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ УсловияПравилПаевогоИнвестиционногоФонда.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
		|				И УсловияПравилПаевогоИнвестиционногоФонда.РасчетРезерваПИФНаВознаграждениеУправляющегоОтСреднегодовойСЧА
		|				И _ПрочиеАктивыНеРезервы.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|				И НАЧАЛОПЕРИОДА(_ПрочиеАктивыНеРезервы.Основание.Дата, ДЕНЬ) = &ДатаКурса
		|			ТОГДА 0
		|		ИНАЧЕ _ПрочиеАктивыНеРезервы.Сумма
		|	КОНЕЦ КАК Сумма
		|ПОМЕСТИТЬ _РСА
		|ИЗ
		|	_ПрочиеАктивыНеРезервы КАК _ПрочиеАктивыНеРезервы
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Составляющие.БазаРасчета ЕСТЬ НЕ NULL  КАК РасчетРезерваПИФНаВознаграждениеУправляющегоОтСреднегодовойСЧА,
		|			УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего КАК УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
		|		ИЗ
		|			РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ПериодОкончание, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК Составляющие
		|				ПО УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаВознаграждениеУправляющего = Составляющие.Ссылка
		|					И (Составляющие.БазаРасчета = ЗНАЧЕНИЕ(Справочник.БазыРасчета.РасчетРезерваПИФОтСреднегодовойСЧА))) КАК УсловияПравилПаевогоИнвестиционногоФонда
		|		ПО (ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиРезервов.Сумма * _КурсыВалют.Курс / _КурсыВалютыУчета.Курс КАК Сумма
		|ПОМЕСТИТЬ _Объединение
		|ИЗ
		|	_ОстаткиРезервов КАК _ОстаткиРезервов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _ОстаткиРезервов.Валюта = _КурсыВалют.Валюта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалютыУчета
		|		ПО (_КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(СУММА(_РСП.Сумма) КАК ЧИСЛО(19, 2))
		|ИЗ
		|	_РСП КАК _РСП
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_РСА.Сумма
		|ИЗ
		|	_РСА КАК _РСА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(_Объединение.Сумма), 0) КАК Сумма
		|ИЗ
		|	_Объединение КАК _Объединение";		
	#КонецОбласти 
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда		
		Возврат Выборка.Сумма;
	Иначе
		Возврат 0;
	КонецЕсли;
	
