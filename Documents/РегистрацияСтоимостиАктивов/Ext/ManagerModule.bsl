		|		И ОстаткиДенежныхСредств.Активность
		|		И ОстаткиДенежныхСредств.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|		И ОстаткиДенежныхСредств.Организация = &Организация
		|		И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюВекселя), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюИпотечногоСертификатаУчастия), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода))
		|		И ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага В(&СписокАктивовДляИсключенияИзРасчетаДоходности)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ОстаткиДенежныхСредств.Активность,
		|		ОстаткиДенежныхСредств.Период,
		|		ОстаткиДенежныхСредств.Регистратор,
		|		ОстаткиДенежныхСредств.Организация,
		|		ОстаткиДенежныхСредств.СчетДоверительногоУправления,
		|		ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств,
		|		ОстаткиДенежныхСредств.ВидДвижения) КАК ОбъединенныеДанные
		|
		|СГРУППИРОВАТЬ ПО
		|	ОбъединенныеДанные.Активность,
		|	ОбъединенныеДанные.Период,
		|	ОбъединенныеДанные.Регистратор,
		|	ОбъединенныеДанные.Организация,
		|	ОбъединенныеДанные.СчетДоверительногоУправления,
		|	ОбъединенныеДанные.ВидОперацииВводаВыводаДС,
		|	ОбъединенныеДанные.ВидДвиженияДенежныхСредств
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводы.Период КАК Период,
		|	ВводыВыводы.Регистратор КАК Операция,
		|	ВводыВыводы.Организация.ВалютаУчета КАК Валюта,
		|	ВЫБОР
		|		КОГДА &ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА ВводыВыводы.РыночнаяСтоимость
		|		ИНАЧЕ ВводыВыводы.РыночнаяСтоимость / КурсыВалют.Курс * КурсыВалют.Кратность
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА 1
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК Сумма,
		|	ВЫБОР
		|		КОГДА &ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА ВводыВыводы.РыночнаяСтоимость
		|		ИНАЧЕ ВводыВыводы.РыночнаяСтоимость / КурсыВалют.Курс * КурсыВалют.Кратность
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаВводов,
		|	ВЫБОР
		|		КОГДА &ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА ВводыВыводы.РыночнаяСтоимость
		|		ИНАЧЕ ВводыВыводы.РыночнаяСтоимость / КурсыВалют.Курс * КурсыВалют.Кратность
		|	КОНЕЦ * ВЫБОР
		|		КОГДА ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА -1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаВыводов,
		|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВводыВыводы.Период, ДЕНЬ), НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ), ДЕНЬ) + 1 КАК ДнейВУправлении,
		|	ВводыВыводы.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ _ВводыВыводы
		|ИЗ
		|	_ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = &ВалютаРасчета)
		|			И (КурсыВалют.Период = НАЧАЛОПЕРИОДА(ВводыВыводы.Период, ДЕНЬ))
		|ГДЕ
		|	ВводыВыводы.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВводыВыводы.Организация = &Организация
		|	И ВводыВыводы.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВводыВыводы.ВидОперацииВводаВыводаДС В(&МассивВидыОпераций)
		|	И ВводыВыводы.Активность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СтоимостьПортфеляНаНачало.СтоимостьПортфеля КАК СтоимостьАктивовНаНачало,
		|	_СтоимостьПортфеляНаНачало.ЗадолженностьПоНДФЛ КАК ЗадолженностьПоНДФЛНаНачало,
		|	_СтоимостьПортфеляНаКонец.СтоимостьПортфеля КАК СтоимостьАктивовНаКонец,
		|	_СтоимостьПортфеляНаКонец.ЗадолженностьПоНДФЛ КАК ЗадолженностьПоНДФЛНаКонец,
		|	_СтоимостьПортфеляНаНачало.КоличествоДнейВПериоде КАК КоличествоДнейВПериоде,
		|	&ДатаНачала КАК ДатаНачала,
		|	&ДатаОкончания КАК ДатаОкончания,
		|	ЕСТЬNULL(ВводыВыводыИтог.Сумма, 0) КАК СуммаОпераций,
		|	ЕСТЬNULL(ВводыВыводыИтог.СуммаВводов, 0) КАК СуммаВводов,
		|	ЕСТЬNULL(ВводыВыводыИтог.СуммаВыводов, 0) КАК СуммаВыводов,
		|	ЕСТЬNULL(ВводыВыводыИтог.СуммаВУправлении, 0) КАК СуммаВУправлении,
		|	_СтоимостьПортфеляНаКонец.СтоимостьПортфеля - _СтоимостьПортфеляНаНачало.СтоимостьПортфеля - ЕСТЬNULL(ВводыВыводыИтог.Сумма, 0) КАК ФинансовыйРезультат,
		|	ВЫБОР
		|		КОГДА _СтоимостьПортфеляНаНачало.СтоимостьПортфеля * _СтоимостьПортфеляНаНачало.КоличествоДнейВПериоде + ЕСТЬNULL(ВводыВыводыИтог.СуммаВУправлении, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ (_СтоимостьПортфеляНаКонец.СтоимостьПортфеля - _СтоимостьПортфеляНаНачало.СтоимостьПортфеля - ЕСТЬNULL(ВводыВыводыИтог.Сумма, 0)) * ДЕНЬГОДА(КОНЕЦПЕРИОДА(&ДатаОкончания, ГОД)) * 100 / (_СтоимостьПортфеляНаНачало.СтоимостьПортфеля * _СтоимостьПортфеляНаНачало.КоличествоДнейВПериоде + ЕСТЬNULL(ВводыВыводыИтог.СуммаВУправлении, 0))
		|	КОНЕЦ КАК Доходность,
		|	ВЫБОР
		|		КОГДА _СтоимостьПортфеляНаНачало.СтоимостьПортфеля * _СтоимостьПортфеляНаНачало.КоличествоДнейВПериоде + ЕСТЬNULL(ВводыВыводыИтог.СуммаВУправлении, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ (_СтоимостьПортфеляНаКонец.СтоимостьПортфеля - _СтоимостьПортфеляНаНачало.СтоимостьПортфеля - ЕСТЬNULL(ВводыВыводыИтог.Сумма, 0) + ЕСТЬNULL(_ПоказателиУвеличивающиеЭффективнуюДоходность.СуммаПоказателей, 0)) * ДЕНЬГОДА(КОНЕЦПЕРИОДА(&ДатаОкончания, ГОД)) * 100 / (_СтоимостьПортфеляНаНачало.СтоимостьПортфеля * _СтоимостьПортфеляНаНачало.КоличествоДнейВПериоде + ЕСТЬNULL(ВводыВыводыИтог.СуммаВУправлении, 0))
		|	КОНЕЦ КАК ЭффективнаяДоходность
		|ИЗ
		|	_СтоимостьПортфеля КАК _СтоимостьПортфеляНаНачало
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтоимостьПортфеля КАК _СтоимостьПортфеляНаКонец
		|		ПО (_СтоимостьПортфеляНаКонец.Дата = &ДатаОкончания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_ВводыВыводы.Сумма) КАК Сумма,
		|			СУММА(_ВводыВыводы.СуммаВводов) КАК СуммаВводов,
		|			СУММА(_ВводыВыводы.СуммаВыводов) КАК СуммаВыводов,
		|			СУММА(_ВводыВыводы.Сумма * _ВводыВыводы.ДнейВУправлении) КАК СуммаВУправлении
		|		ИЗ
		|			_ВводыВыводы КАК _ВводыВыводы) КАК ВводыВыводыИтог
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоказателиУвеличивающиеЭффективнуюДоходность КАК _ПоказателиУвеличивающиеЭффективнуюДоходность
		|		ПО (ИСТИНА)
		|ГДЕ
		|	_СтоимостьПортфеляНаНачало.Дата = &ДатаНачала";
#КонецОбласти

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ВводыВыводы = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ВводыВыводы").ПолучитьДанные().Выгрузить();
	ВводыВыводы.Сортировать("Период");
	
	ФинансовыеПоказатели = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ФинансовыеПоказатели").ПолучитьДанные().Выгрузить();
	ФинансовыеПоказатели.Сортировать("Период");
	
	СуммаАктивовДляИсключения = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СуммаАктивовДляИсключения").ПолучитьДанные().Выгрузить();
	СуммаАктивовДляИсключения.Сортировать("Период");
	
	Если ЗначениеЗаполнено(ПараметрыРасчета.ВалютаРасчета) Тогда
		Для Каждого СтрокаВводыВыводы Из ВводыВыводы Цикл
			Если СтрокаВводыВыводы.Сумма = Null Тогда
				ЗарегистрироватьОшибку(СтрШаблон("Расчет показателя %1 по счету %2 невозможен, т.к. на дату операции (%3) не загружен курс валюты %4!", ПараметрыРасчета.Показатель, ПараметрыРасчета.СчетДоверительногоУправления, Формат(СтрокаВводыВыводы.Период, "ДЛФ=DD"), ПараметрыРасчета.ВалютаРасчета), ПараметрыРасчета.МассивОшибок, Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ПараметрыРасчета.Свойство("РасшифровкаРасчета") И ПараметрыРасчета.РасшифровкаРасчета Тогда
	
		ДеталиРасчета = Новый Структура;
		
		ДеталиРасчета.Вставить("СчетДоверительногоУправления", 	Выборка.СчетДоверительногоУправления);
		ДеталиРасчета.Вставить("КоличествоДнейВПериоде", 		Выборка.КоличествоДнейВПериоде);
		ДеталиРасчета.Вставить("СтоимостьАктивовНаКонец", 		Выборка.СтоимостьАктивовНаКонец);
		ДеталиРасчета.Вставить("СтоимостьАктивовНаНачало", 		Выборка.СтоимостьАктивовНаНачало);
		ДеталиРасчета.Вставить("ЗадолженностьПоНДФЛНаКонец", 	Выборка.ЗадолженностьПоНДФЛНаКонец);
		ДеталиРасчета.Вставить("ЗадолженностьПоНДФЛНаНачало", 	Выборка.ЗадолженностьПоНДФЛНаНачало);
		ДеталиРасчета.Вставить("ДатаНачала", 					Выборка.ДатаНачала);
		ДеталиРасчета.Вставить("ДатаОкончания", 				Выборка.ДатаОкончания);
		ДеталиРасчета.Вставить("СуммаОпераций", 				Выборка.СуммаОпераций);
		ДеталиРасчета.Вставить("СуммаВводов", 					Выборка.СуммаВводов);
		ДеталиРасчета.Вставить("СуммаВыводов", 					Выборка.СуммаВыводов);
		ДеталиРасчета.Вставить("СуммаВУправлении", 				Выборка.СуммаВУправлении);
		ДеталиРасчета.Вставить("ФинансовыйРезультат",			Выборка.ФинансовыйРезультат);
		ДеталиРасчета.Вставить("Доходность", 					Выборка.Доходность);
		ДеталиРасчета.Вставить("ЭффективнаяДоходность", 		Выборка.ЭффективнаяДоходность);
		
		ДеталиРасчета.Вставить("Операции", 						ВводыВыводы);
		ДеталиРасчета.Вставить("ФинансовыеПоказатели", 			ФинансовыеПоказатели);
		ДеталиРасчета.Вставить("СуммаАктивовДляИсключения", 	СуммаАктивовДляИсключения);
		
	Иначе
		
		ДеталиРасчета = Новый Соответствие;
		ДеталиРасчета.Вставить(ПараметрыРасчета.Показатель, Выборка.Доходность);

	КонецЕсли; 	
	
	Возврат ДеталиРасчета;
	
КонецФункции

Процедура ЗаполнитьДатыСЧАДляРасчетаДоходности(Запрос, ПараметрыРасчета, Отказ) Экспорт
	
#Область ПараметрыЗапроса
	Если НЕ Запрос.Параметры.Свойство("МассивВидыОпераций") Тогда
		Запрос.УстановитьПараметр("МассивВидыОпераций",				ПолучитьМассивВидыОперацийДляРасчетаДоходности());
		Запрос.УстановитьПараметр("Организация",					ПараметрыРасчета.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ПараметрыРасчета.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ДатаНачала",						ПараметрыРасчета.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",					КонецДня(ПараметрыРасчета.ДатаОкончания));
	КонецЕсли;	
	
#КонецОбласти
	
#Область ДатаПервогоВвода
	РасчетСНачалаУправления = Ложь;

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НАЧАЛОПЕРИОДА(ВводыВыводы.Период, ДЕНЬ) КАК ДатаПервогоВвода
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводы
		|ГДЕ
		|	ВводыВыводы.Организация = &Организация
		|	И ВводыВыводы.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|	И ВводыВыводы.ВидОперацииВводаВыводаДС В(&МассивВидыОпераций)
		|	И ВводыВыводы.Активность
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПервогоВвода";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ДатаПервогоВвода >= ПараметрыРасчета.ДатаНачала Тогда
			ПараметрыРасчета.Вставить("ДатаНачала", Выборка.ДатаПервогоВвода);
			Запрос.УстановитьПараметр("ДатаНачала", Выборка.ДатаПервогоВвода);
			РасчетСНачалаУправления = Истина;
		КонецЕсли;
	ИначеЕсли НЕ ЗначениеЗаполнено(ПараметрыРасчета.ДатаНачала) Тогда	
		Возврат;
	Иначе
		ЗарегистрироватьОшибку(СтрШаблон("Расчет показателя %1 по счету %2 невозможен, т.к. нет ни одного ввода!", ПараметрыРасчета.Показатель, ПараметрыРасчета.СчетДоверительногоУправления), ПараметрыРасчета.МассивОшибок, Отказ);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("РасчетСНачалаУправления", РасчетСНачалаУправления);
	
#КонецОбласти
	
#Область ДатыСЧА 
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Периоды.ДатаПериода КАК ДатаПериода,
		|	МАКСИМУМ(ФинансовыеПоказатели.Период) КАК ДатаСЧА
		|ИЗ
		|	(ВЫБРАТЬ
		|		Даты.ДатаПериода КАК ДатаПериода,
		|		МАКСИМУМ(ДанныеКалендаря.Дата) КАК ДатаНачала,
		|		Даты.ДатаОкончания КАК ДатаОкончания
		|	ИЗ
		|		(ВЫБРАТЬ
		|			&ДатаНачала КАК ДатаПериода,
		|			ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) КАК ДатаОкончания
		|		ГДЕ
		|			НЕ &РасчетСНачалаУправления
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			&ДатаОкончания,
		|			&ДатаОкончания) КАК Даты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|			ПО (ДанныеКалендаря.Дата <= Даты.ДатаОкончания)
		|				И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Даты.ДатаПериода,
		|		Даты.ДатаОкончания) КАК Периоды
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления)
		|			И (ФинансовыеПоказатели.Организация = &Организация)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ФинансовыеПоказатели.Период МЕЖДУ Периоды.ДатаНачала И Периоды.ДатаОкончания)
		|
		|СГРУППИРОВАТЬ ПО
		|	Периоды.ДатаПериода";
	
	ДатыСЧА = Запрос.Выполнить().Выгрузить();
	ДатыСЧА.Сортировать("ДатаПериода");
	
	Если РасчетСНачалаУправления Тогда
		ДатаСЧАНачала		= Неопределено;
		ДатаСЧАОкончания	= ДатыСЧА[0].ДатаСЧА;
	Иначе
		ДатаСЧАНачала		= ДатыСЧА[0].ДатаСЧА;
		ДатаСЧАОкончания	= ДатыСЧА[1].ДатаСЧА;
		
		Если НЕ ЗначениеЗаполнено(ДатаСЧАНачала) Тогда
			ЗарегистрироватьОшибку(СтрШаблон("Расчет показателя %1 по счету %2 невозможен, т.к. стоимость портфеля на %3 не зарегистрирована!", ПараметрыРасчета.Показатель, ПараметрыРасчета.СчетДоверительногоУправления, Формат(НачалоДня(ПараметрыРасчета.ДатаНачала) - 1, "ДЛФ=DD")), ПараметрыРасчета.МассивОшибок, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаСЧАОкончания) Тогда
		ЗарегистрироватьОшибку(СтрШаблон("Расчет показателя %1 по счету %2 невозможен, т.к. стоимость портфеля на %3 не зарегистрирована!", ПараметрыРасчета.Показатель, ПараметрыРасчета.СчетДоверительногоУправления, Формат(ПараметрыРасчета.ДатаОкончания, "ДЛФ=DD")), ПараметрыРасчета.МассивОшибок, Отказ);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаСЧАНачала",		ДатаСЧАНачала);
	Запрос.УстановитьПараметр("ДатаСЧАОкончания",	ДатаСЧАОкончания);
	
	ПараметрыРасчета.Вставить("ДатаСЧАНачала",		ДатаСЧАНачала);
	ПараметрыРасчета.Вставить("ДатаСЧАОкончания",	ДатаСЧАОкончания);

#КонецОбласти	
	
КонецПроцедуры

Функция ПолучитьМассивВидыОперацийДляРасчетаДоходности() 
	
	МассивВидыОпераций = Новый Массив;
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствСПереводомВсехАктивовНаДругойИИС);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствИспользованныхДляСобственныхСделок);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыделениеДенежныхСредствДляСобственныхСделок);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПриЗакрытииПИФ);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику);
	МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка());
	
	Возврат МассивВидыОпераций;
	
КонецФункции

Функция ТребуетсяРегистрацияФинансовыхПоказателейДоходности(Организация, Дата) Экспорт
	
	ДатаНачалаРасчетаДоходности = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ДатаНачалаРасчетаДоходности", Организация);
	
	Возврат (ЗначениеЗаполнено(ДатаНачалаРасчетаДоходности) И Дата >= ДатаНачалаРасчетаДоходности);

КонецФункции

// Помещает таблицы для расчета доходности в источник временных таблиц, используемые для расчёта доходности по методу начисления НДФЛ
//
// Параметры
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//	Организация				- СправочникСсылка.Организации		- Отбор по ораганизации
//	Период					- Дата								- Дата на которую расчитывается доходность
//	ИмяОтбора				- Строка							- Имя отбора по которому будут отобраны счета ДУ, в порядке приоритета работает только один отбор
//																"СчетаДоверительногоУправления" - отбор по списку счетов ДУ
//																"СтратегииИндивидуальногоИнвестирования" - отбор по стратегии в которую входят счета ДУ
//																"ВидыДоговоровДоверительногоУправления" - отбор по видам договоров
//																"" - без отбора
//	ЗначениеОтбора			- СправочникСсылка.СчетаДоверительногоУправления,СправочникСсылка.СтратегииИндивидуальногоИнвестирования,ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления,СписокЗначений,Массив	- элемент или массив элемнтов по которым будет работать отбор с учётом имени отбора
//	ДополнительныеПараметры - Структура - ВидВалюты -	"ВалютаУчета" - расчёт доходности в валюте учёта, "ВалютаЦелиРасчета" - расчёт доходности в валюте цели расчёта, если она цель зарегистрирована, иначе в валюте учёта. Необязательно, по умолчанию "ВалютаУчета"
//							-			- УчитыватьНДФЛПоНачислению - Булево, если Ложь в запрос помещаются пустые таблицы с задолженностью. Необязательно, по умолчанию ЛОЖЬ.
//							-			- ДатаСЧАНачала - Дата, неопределено - передаётся если дата начальное СЧА определена заранее, иначе запрос поместит даты СЧА в _ДатыСЧА. Необязательно.
//							-			- ДатаСЧАОкончания - Дата, неопределено - передаётся если дата конечное СЧА определена заранее, иначе запрос поместит даты СЧА в _ДатыСЧА. Необязательно.
Процедура ПоместитьТаблицыДляРасчетаДоходностиУправленияВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Организация, Период, ИмяОтбора, ЗначениеОтбора, ДополнительныеПараметры) Экспорт
	
	МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	МассивИменВременныхТаблиц = СистемныеФункции.ПолучитьИменаВременныхТаблицЗапроса(МенеджерВременныхТаблиц);
	МассивИменВременныхТаблиц.Добавить("_ДатыСЧА");
	МассивИменВременныхТаблиц.Добавить("_ЗадолженностьПоНДФЛНеучтеннаяВСЧАВВалюте");
	МассивИменВременныхТаблиц.Добавить("_ЗадолженностьПоНДФЛНеучтеннаяВСЧА");
	МассивИменВременныхТаблиц.Добавить("_ПоказателиУвеличивающиеЭффективнуюДоходностьПодробно");
	МассивИменВременныхТаблиц.Добавить("_ПоказателиУвеличивающиеЭффективнуюДоходность");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ДатаНачала",		Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ИмяОтбора",		ИмяОтбора);
	Запрос.УстановитьПараметр("ЗначениеОтбора", ЗначениеОтбора);
	
	Если ДополнительныеПараметры.Свойство("ВалютаРасчета") И ЗначениеЗаполнено(ДополнительныеПараметры.ВалютаРасчета) Тогда
		Запрос.УстановитьПараметр("ВидВалюты", 		"ВалютаРасчета");	
		Запрос.УстановитьПараметр("ВалютаРасчета",	ДополнительныеПараметры.ВалютаРасчета);
		
	Иначе 
		Запрос.УстановитьПараметр("ВидВалюты",		?(ДополнительныеПараметры.Свойство("ВидВалюты"), ДополнительныеПараметры.ВидВалюты, "ВалютаУчета"));
		Запрос.УстановитьПараметр("ВалютаРасчета",	Неопределено);
	КонецЕсли;
		
	Запрос.УстановитьПараметр("УчитыватьНДФЛПоНачислению",	ДополнительныеПараметры.Свойство("УчитыватьНДФЛПоНачислению") И ДополнительныеПараметры.УчитыватьНДФЛПоНачислению);
	
#Область ПОМЕСТИТЬ_СчетаДоверительногоУправления
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА &ВидВалюты = ""ВалютаРасчета""
		|			ТОГДА &ВалютаРасчета
		|		КОГДА &ВидВалюты = ""ВалютаУчета""
		|				ИЛИ ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта ЕСТЬ NULL
		|			ТОГДА Организации.ВалютаУчета
		|		КОГДА &ВидВалюты = ""ВалютаЦелиРасчета""
		|			ТОГДА ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок) КАК ВидПоказателя
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО СчетаДоверительногоУправления.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеПрофили.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК ИнвестиционныеПрофилиСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = ИнвестиционныеПрофилиСрезПоследних.СубъектУчета
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&ДатаОкончания, ГОД))
		|	И ВЫБОР
		|			КОГДА &ИмяОтбора = ""СчетаДоверительногоУправления""
		|				ТОГДА СчетаДоверительногоУправления.Ссылка В (&ЗначениеОтбора)
		|			КОГДА &ИмяОтбора = ""ВидыДоговоровДоверительногоУправления""
		|				ТОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ЗначениеОтбора)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.Выполнить();
	
#КонецОбласти	

#Область ПОМЕСТИТЬ_ДатыСЧА
	Если ДополнительныеПараметры.Свойство("ДатаСЧАНачала") Тогда
		
		Запрос.УстановитьПараметр("ДатаСЧАНачала",		ДополнительныеПараметры.ДатаСЧАНачала);
		Запрос.УстановитьПараметр("ДатаСЧАОкончания",	ДополнительныеПараметры.ДатаСЧАОкончания);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_СчетаДоверительногоУправления.ВидПоказателя КАК ВидПоказателя,
			|	ДатыСЧА.Дата КАК Дата,
			|	ДатыСЧА.ДатаСЧА КАК ДатаСЧА
			|ПОМЕСТИТЬ _ДатыСЧА
			|ИЗ
			|	(ВЫБРАТЬ
			|		&ДатаНачала КАК Дата,
			|		&ДатаСЧАНачала КАК ДатаСЧА
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		&ДатаОкончания,
			|		&ДатаСЧАОкончания) КАК ДатыСЧА,
			|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления";

		
	Иначе
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ДатаНачала КАК Дата,
			|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ДатаНачала,
			|	ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1) КАК ДатаОкончания
			|ПОМЕСТИТЬ _РабочиеДни
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|ГДЕ
			|	ДанныеКалендаря.Дата < &ДатаНачала
			|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	&ДатаОкончания,
			|	МАКСИМУМ(ДанныеКалендаря.Дата),
			|	&ДатаОкончания
			|ИЗ
