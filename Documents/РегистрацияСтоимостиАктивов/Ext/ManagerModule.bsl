КонецФункции

#КонецОбласти

#Область Расчет_доходности_стратегии

Функция РассчитатьДоходностьСтратегииСНачалаГода(Организация, СубъектАналитики, Период, РасшифровкаРасчета, Отказ) Экспорт
	
	ОшибкаРасчета = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("СубъектАналитики",	СубъектАналитики);
	Запрос.УстановитьПараметр("Период",				КонецДня(Период));
	
	ПоместитьТаблицыДляРасчетаДоходностиСтратегииСНачалаГодаВМенеджерВременныхТаблиц(Запрос, Организация, Период, СубъектАналитики.Метаданные().Имя, СубъектАналитики);
	
	#Область Контроли

	Для Каждого Строка_КонтрольСЧА Из СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_КонтрольСЧА").Выгрузить() Цикл
		
		ТекстОшибки = СтрШаблон("По счёту %1 не зарегистрирована СЧА на %2.", Строка_КонтрольСЧА.СчетДоверительногоУправления, Формат(Строка_КонтрольСЧА.ДатаСЧА, "ДФ=dd.MM.yyyy"));
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , ОшибкаРасчета);
			
	КонецЦикла;
	
	#КонецОбласти
	
	#Область Параметры_расшифровки
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(_ДатыРасчета.Период) КАК ДатаНачала,
		|	МАКСИМУМ(_ДатыРасчета.Период) КАК ДатаОкончания,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА _Расшифровка.ДатаРасчета < НАЧАЛОПЕРИОДА(&Период, ГОД)
		|				ТОГДА ДЕНЬГОДА(&Период)
		|			ИНАЧЕ РАЗНОСТЬДАТ(ВЫРАЗИТЬ(_Расшифровка.ДатаРасчета КАК ДАТА), &Период, ДЕНЬ) + 1
		|		КОНЕЦ) КАК КоличествоДней
		|ПОМЕСТИТЬ _ПараметрыРасшифровки
		|ИЗ
		|	_ДатыРасчета КАК _ДатыРасчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Расшифровка КАК _Расшифровка
		|		ПО _ДатыРасчета.СубъектАналитики = _Расшифровка.СубъектАналитики
		|			И _Расшифровка.СЧА ЕСТЬ НЕ NULL
		|ГДЕ _ДатыРасчета.СубъектАналитики = &СубъектАналитики";

	Запрос.Выполнить();	
	
	#КонецОбласти

	Таблица_ПараметрыРасшифровки	= СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ПараметрыРасшифровки").Выгрузить();
	Таблица_Расшифровка				= СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Расшифровка",,, Новый Структура("Текст, Параметры", "СубъектАналитики = &СубъектАналитики", Новый Структура("СубъектАналитики", СубъектАналитики)), "ДатаРасчета").Выгрузить();
	
	Расшифровка = Новый Структура;
	Расшифровка.Вставить("ДатаНачала",		Таблица_ПараметрыРасшифровки[0].ДатаНачала);
	Расшифровка.Вставить("ДатаОкончания",	Таблица_ПараметрыРасшифровки[0].ДатаОкончания);
	Расшифровка.Вставить("ПриростИтог",		1);
	Расшифровка.Вставить("Доходность",		0);
	Расшифровка.Вставить("Формула",			"Ошибка расчета"); // При отсутствии ошибки текст будет заменен
	Расшифровка.Вставить("КоличествоДней",	Таблица_ПараметрыРасшифровки[0].КоличествоДней);
	Расшифровка.Вставить("Таблица",			Таблица_Расшифровка);
	
	Если ОшибкаРасчета Тогда

		ТекстОшибки = СтрШаблон("Показатель %1 не рассчитан.", Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , , , Отказ);

	Иначе
	
		Для Каждого Строка_Расшифровка Из Таблица_Расшифровка Цикл
			Расшифровка.ПриростИтог			= Расшифровка.ПриростИтог * Строка_Расшифровка.Прирост;
			Строка_Расшифровка.ПриростИтог	= Расшифровка.ПриростИтог;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Расшифровка.КоличествоДней) Тогда
			Расшифровка.Доходность = Окр((Расшифровка.ПриростИтог - 1) * 365 / Расшифровка.КоличествоДней * 100, 2);
		КонецЕсли;
		
		Расшифровка.Формула = "(" + Строка(Окр(Расшифровка.ПриростИтог, 10)) + " - 1)*365/" + Расшифровка.КоличествоДней + "*100 = ";
		
	КонецЕсли;	
		
	Если РасшифровкаРасчета Тогда
		ФинансовыеПоказатели = Новый Структура;
		ФинансовыеПоказатели.Вставить("Расшифровка", Расшифровка);
	Иначе
		ФинансовыеПоказатели = Новый Соответствие;
		ФинансовыеПоказатели.Вставить(Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода, Расшифровка.Доходность);
	КонецЕсли;
	
	Возврат ФинансовыеПоказатели;
	
КонецФункции

Функция ТребуетсяРегистрацияДоходностиСтратегииСНачалаГода(Организация, СубъектАналитики, Период, ВыводитьСообщения = Ложь) Экспорт

	ВидПоказателя		= Справочники.ВидыФинансовыхПоказателей.ДоходностьСтратегииСНачалаГода;
	НачалоИспользования = Дата(2023, 03, 31);
	
	Если НЕ ТипЗнч(СубъектАналитики) = Тип("СправочникСсылка.СчетаДоверительногоУправления") И НЕ ТипЗнч(СубъектАналитики) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		Если ВыводитьСообщения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Расчёт доходности стратегии с начала года для субъекта &1 не предусмотрено", СубъектАналитики));
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если КонецДня(Период) <> КонецМесяца(Период) Тогда 
		Если ВыводитьСообщения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Показатель '%1' регистрируется только на конец месяца", ВидПоказателя));
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если Период < НачалоИспользования Тогда
		Если ВыводитьСообщения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Показатель '%1' регистрируется только начиная с %2", ВидПоказателя, Формат(НачалоИспользования, "ДФ=dd.MM.yyyy")));
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("СубъектАналитики",	СубъектАналитики);
	Запрос.УстановитьПараметр("Период",				Период);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|				&Период,
		|				Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(&СубъектАналитики) = ТИП(Справочник.СчетаДоверительногоУправления)
		|				ТОГДА СчетаДоверительногоУправления.Ссылка = &СубъектАналитики
		|						И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|						И ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная, ЛОЖЬ) = ЛОЖЬ
		|			КОГДА ТИПЗНАЧЕНИЯ(&СубъектАналитики) = ТИП(Справочник.СтратегииИндивидуальногоИнвестирования)
		|				ТОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия = &СубъектАналитики
		|						И СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная
		|		КОНЕЦ
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)
		|	И ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|	И ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует";
		
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Помещает таблицы для расчёта доходности стратегии с начала года в источник временных таблиц
//
// Параметры
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц	- источник временных таблиц
//	Организация				- СправочникСсылка.Организации		- Отбор по ораганизации
//	Период					- Дата								- Дата на которую расчитывается доходность
//	ИмяОтбора				- Строка							- Имя отбора по которому будут отобраны счета ДУ, в порядке приоритета работает только один отбор
//																"СчетаДоверительногоУправления" - отбор по списку счетов ДУ
//																"СтратегииИндивидуальногоИнвестирования" - отбор по стратегии в которую входят счета ДУ
//																"ВидыДоговоровДоверительногоУправления" - отбор по видам договоров
//																"" - без отбора
//	ЗначениеОтбора			- СправочникСсылка.СчетаДоверительногоУправления,СправочникСсылка.СтратегииИндивидуальногоИнвестирования,ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления,СписокЗначений,Массив	- элемент или массив элемнтов по которым будет работать отбор с учётом имени отбора
//	ВидВалюты				- Строка -	"ВалютаУчета" - расчёт доходности в валюте учёта
//										"ВалютаЦелиРасчета" - расчёт доходности в валюте цели расчёта, если она цель зарегистрирована, иначе в валюте учёта.
Процедура ПоместитьТаблицыДляРасчетаДоходностиСтратегииСНачалаГодаВМенеджерВременныхТаблиц(ИсточникВременныхТаблиц, Организация, Период, ИмяОтбора, ЗначениеОтбора, ВидВалюты = "ВалютаУчета") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц);
	
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("Период",		 		КонецДня(Период));
	Запрос.УстановитьПараметр("ВидВалюты",	 		ВидВалюты);
	Запрос.УстановитьПараметр("ИмяОтбора",			ИмяОтбора);
	Запрос.УстановитьПараметр("ЗначениеОтбора", 	ЗначениеОтбора);
	Запрос.УстановитьПараметр("МассивВидыОпераций", ПолучитьМассивВидыОперацийДляРасчетаДоходности());
	
#Область ПОМЕСТИТЬ_СчетаДоверительногоУправления
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия КАК Стратегия,
		|	ВЫБОР
		|		КОГДА &ВидВалюты = ""ВалютаУчета""
		|				ИЛИ ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта ЕСТЬ NULL
		|			ТОГДА Организации.ВалютаУчета
		|		КОГДА &ВидВалюты = ""ВалютаЦелиРасчета""
		|			ТОГДА ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта
		|	КОНЕЦ КАК Валюта,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО СчетаДоверительногоУправления.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Период, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеПрофили.СрезПоследних(&Период, Организация = &Организация) КАК ИнвестиционныеПрофилиСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = ИнвестиционныеПрофилиСрезПоследних.СубъектУчета
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&Период, ГОД))
		|	И ВЫБОР
		|			КОГДА &ИмяОтбора = ""СчетаДоверительногоУправления""
		|				ТОГДА СчетаДоверительногоУправления.Ссылка В (&ЗначениеОтбора)
		|			КОГДА &ИмяОтбора = ""СтратегииИндивидуальногоИнвестирования""
		|				ТОГДА СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия В (&ЗначениеОтбора)
		|			КОГДА &ИмяОтбора = ""ВидыДоговоровДоверительногоУправления""
		|				ТОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ЗначениеОтбора)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.Выполнить();
	
#КонецОбласти	
	
	Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, 
		Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями", "СЧА", ДобавитьМесяц(НачалоГода(Период), -2), Период, Ложь));

#Область ВыполнитьОсновнойЗапрос 
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыВыводыАктивовВВалютеУчета.Период), ДЕНЬ) КАК Дата
		|ПОМЕСТИТЬ _ДатыПервыхВводов
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления
		|			И (ВводыВыводыАктивовВВалютеУчета.Период <= &Период)
		|			И (ВводыВыводыАктивовВВалютеУчета.Активность)
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.ВидОперацииВводаВыводаДС В(&МассивВидыОпераций)
		|
		|СГРУППИРОВАТЬ ПО
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДатыДействияЗаПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
