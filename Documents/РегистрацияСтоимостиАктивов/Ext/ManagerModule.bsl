Функция РасшифровкаСтрокФинПоказателей(ТабличныйДокумент, МакетРасшифровка, РасшифровкаРасчета, НомерСтроки) Экспорт
	
	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("НомерСтроки", "Строка" + НомерСтроки);
	
	Если ПустаяСтрока(НомерСтроки) Тогда
		ПараметрыРасшифровки.Вставить("НомерСтроки", "");
		ПараметрыРасшифровки.Вставить("СуффиксМакета", "");
		
	ИначеЕсли НомерСтроки > "020" Тогда
		ПараметрыРасшифровки.Вставить("СуффиксМакета", "3040");
		
	Иначе
		ПараметрыРасшифровки.Вставить("СуффиксМакета", "1020");
		
	КонецЕсли;
	
	ОбластьШапка	= МакетРасшифровка.ПолучитьОбласть("Шапка" + ПараметрыРасшифровки.СуффиксМакета);
	ОбластьСтрока	= МакетРасшифровка.ПолучитьОбласть("Строка" + ПараметрыРасшифровки.СуффиксМакета);
	ОбластьИтог		= МакетРасшифровка.ПолучитьОбласть("Итог" + ПараметрыРасшифровки.СуффиксМакета);
	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, РасшифровкаРасчета);
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ПараметрыРасшифровки);

	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Для Каждого СтрокаРасшифровки Из РасшифровкаРасчета.Таблица Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаРасшифровки);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, РасшифровкаРасчета);
	ТабличныйДокумент.Вывести(ОбластьИтог);

КонецФункции	

Функция ПолучитьТекстЗапросаДляСпискаЦБ(ТаблицаЦБ = Неопределено, ДетализацияПоПартиям = Ложь) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Партия КАК Партия,
		|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.ВидУчета КАК ВидУчета,
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	ВЫРАЗИТЬ(СтоимостьПереоценки.Цена КАК ЧИСЛО) КАК Стоимость,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
		|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
		|	СтоимостьПереоценки.Источник КАК Источник,
		|	СтоимостьПереоценки.РучнойВвод КАК РучнойВвод,
		|	СтоимостьПереоценки.ВидЦеныОценки КАК ВидЦеныОценки,
		|	СтоимостьПереоценки.Примечание КАК Примечание,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК Сумма,
		|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК Купон,
		|	СУММА(СтоимостьПереоценки.Количество) КАК Количество,
		|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета + СтоимостьПереоценки.СуммаВВалютеУчета) КАК ИтогоРынок
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	_Источник КАК СтоимостьПереоценки
		|ГДЕ
		|	&Условия
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.Партия,
		|	СтоимостьПереоценки.СтрокаПартии,
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.ВидУчета,
		|	СтоимостьПереоценки.Рынок,
		|	СтоимостьПереоценки.ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки,
		|	СтоимостьПереоценки.ДатаЦены,
		|	СтоимостьПереоценки.Источник,
		|	СтоимостьПереоценки.РучнойВвод,
		|	СтоимостьПереоценки.ВидЦеныОценки,
		|	СтоимостьПереоценки.Примечание,
		|	ВЫРАЗИТЬ(СтоимостьПереоценки.Цена КАК ЧИСЛО)";   	
	
	ТипЧислаЦена = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЧИСЛО(0, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЧислаЦена.Разрядность, ТипЧислаЦена.РазрядностьДробнойЧасти));
	
	Если Не ДетализацияПоПартиям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтоимостьПереоценки.Партия КАК Партия,", 				"");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,",	"");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтоимостьПереоценки.Партия,",			"");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СтоимостьПереоценки.СтрокаПартии,",	"");
	КонецЕсли;
	
	Если ТаблицаЦБ = Неопределено Тогда
						
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_Источник", "РегистрСведений.СтоимостьПереоценки");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Условия", "СтоимостьПереоценки.Период = &Период
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)");
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	&ВидУчета КАК ВидУчета,
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.Источник КАК Источник,
			|	СтоимостьПереоценки.РучнойВвод КАК РучнойВвод,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки) КАК ВидЦеныОценки,
			|	СтоимостьПереоценки.Примечание КАК Примечание,
			|	СтоимостьПереоценки.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
			|	СтоимостьПереоценки.СуммаКупонаВВалютеУчета КАК СуммаКупонаВВалютеУчета,
			|	СтоимостьПереоценки.Количество КАК Количество
			|ПОМЕСТИТЬ _СтоимостьПереоценки
			|ИЗ
			|	&ТаблицаЦБ КАК СтоимостьПереоценки" + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|" + ТекстЗапроса;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_Источник", "_СтоимостьПереоценки");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Условия", "ИСТИНА");
		
	КонецЕсли; 
	
	Возврат ТекстЗапроса;	
	
КонецФункции 

