		ИначеЕсли СтрокаРасшифровки.Показатель = "030" Тогда 
			СтрокаРасшифровки.ДоходностьРасчет = Расшифровка_Строка030.Доходность;
		ИначеЕсли СтрокаРасшифровки.Показатель = "040" Тогда 	
			СтрокаРасшифровки.ДоходностьРасчет = Расшифровка_Строка040.Доходность;
		КонецЕсли;	
	КонецЦикла;	
	
	Расшифровка_Проверка.Вставить("Таблица", ТаблицаРасшифровки );

