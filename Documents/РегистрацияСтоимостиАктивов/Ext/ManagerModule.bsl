
#Область Расчет_доходности_управления

// Функция - Рассчитать доходность управления
//
// Параметры:
//  СчетДоверительногоУправления - СправочникСсылка.СчетаДоверительногоУправления
//  Период						 - Дата - Конец периода
//  ВалютаРасчета				 - СправочникСсылка.Валюты, Неопределено - Валюта, в которой оцениваются активы. Если не указана, расчеты выполняются в валюте учета.
//  НачалоПериода				 - Дата, Неопределено - Начало периода. Если не указан - используется дата первого ввода
//  РасшифровкаРасчета			 - Булево - Определяет тип возвращаемого значения. Если Истина - возвращается структура для вывода расшифровки
// 								   Если Ложь - возвращается соответствие. Ключ - СправочникСсылка.ВидыФинансовыхПоказателей, Значение - значение доходности
// 
// Возвращаемое значение:
//	Структура - при расшифровке
//	Соответствие - ключи: Средневзвешенная доходность управления | Текущая доходность управления (с начала года)  
//
Функция РассчитатьДоходностьУправления(ПараметрыРасчета, Отказ = Ложь) Экспорт
	
	Если ПараметрыРасчета.ДатаНачала = НачалоГода(ПараметрыРасчета.ДатаОкончания) Тогда 
		ПараметрыРасчета.Вставить("Показатель", "Средневзвешенная доходность управления");
	Иначе	
		ПараметрыРасчета.Вставить("Показатель", "Средневзвешенная доходность управления (с начала года)");
	КонецЕсли;

	Если НЕ ПараметрыРасчета.Свойство("ВалютаРасчета") Тогда
		ПараметрыРасчета.Вставить("ВалютаРасчета", Справочники.Валюты.ПустаяСсылка());
	КонецЕсли;
	
	Если НЕ ПараметрыРасчета.Свойство("МассивОшибок") Тогда
		ПараметрыРасчета.Вставить("МассивОшибок", Неопределено);
	КонецЕсли;
	
	Если ПараметрыРасчета.Свойство("СписокАктивовДляИсключенияИзРасчетаДоходности") 
		И ЗначениеЗаполнено(ПараметрыРасчета.СписокАктивовДляИсключенияИзРасчетаДоходности) Тогда
		ПараметрыРасчета.Вставить("ИсключитьАктивыИзРасчетаДоходности", Истина);
	Иначе
		ПараметрыРасчета.Вставить("ИсключитьАктивыИзРасчетаДоходности", Ложь);
		ПараметрыРасчета.Вставить("СписокАктивовДляИсключенияИзРасчетаДоходности", Справочники.Облигации.ПустаяСсылка());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",									ПараметрыРасчета.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 					ПараметрыРасчета.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала",										ПараметрыРасчета.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",									КонецДня(ПараметрыРасчета.ДатаОкончания));
	Запрос.УстановитьПараметр("ВалютаРасчета",									ПараметрыРасчета.ВалютаРасчета);
	Запрос.УстановитьПараметр("МассивВидыОпераций", 							ПолучитьМассивВидыОперацийДляРасчетаДоходности());
    Запрос.УстановитьПараметр("ИсключитьАктивыИзРасчетаДоходности",				ПараметрыРасчета.ИсключитьАктивыИзРасчетаДоходности);
	Запрос.УстановитьПараметр("СписокАктивовДляИсключенияИзРасчетаДоходности",	ПараметрыРасчета.СписокАктивовДляИсключенияИзРасчетаДоходности);

	ЗаполнитьДатыСЧАДляРасчетаДоходности(Запрос, ПараметрыРасчета, Отказ);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыРасчета.ДатаНачала) Тогда	
		Возврат Новый Соответствие;
	КонецЕсли;
	
	ПоместитьТаблицыДляРасчетаДоходностиУправленияВМенеджерВременныхТаблиц(
		Запрос, 
		ПараметрыРасчета.Организация, 
		Новый СтандартныйПериод(ПараметрыРасчета.ДатаНачала, КонецДня(ПараметрыРасчета.ДатаОкончания)),
		"СчетаДоверительногоУправления", 
		ПараметрыРасчета.СчетДоверительногоУправления, 
		ПараметрыРасчета);
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета + СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК Сумма
		|ПОМЕСТИТЬ _СуммаАктивовДляИсключения
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	&ИсключитьАктивыИзРасчетаДоходности
		|	И СтоимостьПереоценки.Активность
		|	И СтоимостьПереоценки.Период В (&ДатаСЧАНачала, &ДатаСЧАОкончания)
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И СтоимостьПереоценки.ЦеннаяБумага В(&СписокАктивовДляИсключенияИзРасчетаДоходности)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.Период,
		|	СтоимостьПереоценки.ЦеннаяБумага
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики,
		|	СУММА(-СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета)
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	&ИсключитьАктивыИзРасчетаДоходности
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период В (&ДатаСЧАНачала, &ДатаСЧАОкончания)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики В(&СписокАктивовДляИсключенияИзРасчетаДоходности)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Активность КАК Активность,
		|	ФинансовыеПоказатели.Период КАК Период,
		|	ФинансовыеПоказатели.Регистратор КАК Регистратор,
		|	ФинансовыеПоказатели.Организация КАК Организация,
		|	ФинансовыеПоказатели.СубъектАналитики КАК СубъектАналитики,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение - ЕСТЬNULL(СуммаАктивовДляИсключения.Сумма, 0) КАК Значение,
		|	ФинансовыеПоказатели.Значение КАК СЧА,
		|	ЕСТЬNULL(СуммаАктивовДляИсключения.Сумма, 0) КАК СЧАИсключаемыхАктивов,
		|	ВЫБОР
		|		КОГДА ФинансовыеПоказатели.Период < &ДатаСЧАОкончания
		|			ТОГДА РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1), &ДатаОкончания, ДЕНЬ)
		|		ИНАЧЕ РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, -1), &ДатаОкончания, ДЕНЬ)
		|	КОНЕЦ КАК КоличествоДнейВПериоде
		|ПОМЕСТИТЬ _ФинансовыеПоказатели
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СуммвАктивовДляИсключения.Период КАК Период,
		|			СУММА(_СуммвАктивовДляИсключения.Сумма) КАК Сумма
		|		ИЗ
		|			_СуммаАктивовДляИсключения КАК _СуммвАктивовДляИсключения
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_СуммвАктивовДляИсключения.Период) КАК СуммаАктивовДляИсключения
		|		ПО ФинансовыеПоказатели.Период = СуммаАктивовДляИсключения.Период
		|ГДЕ
		|	ФинансовыеПоказатели.Активность
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.Период В (&ДатаСЧАНачала, &ДатаСЧАОкончания)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивов.Дата КАК Дата,
		|	РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(СтоимостьАктивов.Дата, ДЕНЬ, -1), &ДатаОкончания, ДЕНЬ) КАК КоличествоДнейВПериоде,
		|	СУММА(СтоимостьАктивов.Сумма) КАК СтоимостьПортфеля,
		|	СУММА(СтоимостьАктивов.ЗадолженностьПоНДФЛ) КАК ЗадолженностьПоНДФЛ
		|ПОМЕСТИТЬ _СтоимостьПортфеля
		|ИЗ
		|	(ВЫБРАТЬ
		|		&ДатаНачала КАК Дата,
		|		ВЫБОР
		|			КОГДА &ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|				ТОГДА ФинансовыеПоказатели.Значение
		|			ИНАЧЕ ФинансовыеПоказатели.Значение / КурсыВалют.Курс * КурсыВалют.Кратность
		|		КОНЕЦ КАК Сумма,
		|		0 КАК ЗадолженностьПоНДФЛ
		|	ИЗ
		|		_ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО (КурсыВалют.Валюта = &ВалютаРасчета)
		|				И (КурсыВалют.Период = &ДатаНачала)
		|	ГДЕ
		|		ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|		И ФинансовыеПоказатели.Организация = &Организация
		|		И ФинансовыеПоказатели.Период = &ДатаСЧАНачала
		|		И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&ДатаНачала,
		|		0,
		|		0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&ДатаОкончания,
		|		0,
		|		0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&ДатаОкончания,
		|		ВЫБОР
		|			КОГДА &ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|				ТОГДА ФинансовыеПоказатели.Значение
		|			ИНАЧЕ ФинансовыеПоказатели.Значение / КурсыВалют.Курс * КурсыВалют.Кратность
		|		КОНЕЦ,
		|		0
		|	ИЗ
		|		_ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО (КурсыВалют.Валюта = &ВалютаРасчета)
		|				И (КурсыВалют.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|	ГДЕ
		|		ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|		И ФинансовыеПоказатели.Организация = &Организация
		|		И ФинансовыеПоказатели.Период = &ДатаСЧАОкончания
		|		И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ЗадолженностьПоНДФЛНеучтеннаяВСЧА.Дата,
		|		-_ЗадолженностьПоНДФЛНеучтеннаяВСЧА.Сумма,
		|		_ЗадолженностьПоНДФЛНеучтеннаяВСЧА.Сумма
		|	ИЗ
		|		_ЗадолженностьПоНДФЛНеучтеннаяВСЧА КАК _ЗадолженностьПоНДФЛНеучтеннаяВСЧА
		|	ГДЕ
		|		&ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ЗадолженностьПоНДФЛНеучтеннаяВСЧАВВалюте.Дата,
		|		-_ЗадолженностьПоНДФЛНеучтеннаяВСЧАВВалюте.Сумма,
		|		_ЗадолженностьПоНДФЛНеучтеннаяВСЧАВВалюте.Сумма
		|	ИЗ
		|		_ЗадолженностьПоНДФЛНеучтеннаяВСЧАВВалюте КАК _ЗадолженностьПоНДФЛНеучтеннаяВСЧАВВалюте
		|	ГДЕ
		|		НЕ &ВалютаРасчета = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК СтоимостьАктивов
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьАктивов.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА ""Ввод актива""
		|		КОГДА ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА ""Вывод актива""
		|	КОНЕЦ КАК Комментарий,
		|	ВводыВыводы.Активность КАК Активность,
		|	ВводыВыводы.Период КАК Период,
		|	ВводыВыводы.Регистратор КАК Регистратор,
		|	ВводыВыводы.Организация КАК Организация,
		|	ВводыВыводы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВводыВыводы.НаправлениеДвижения КАК НаправлениеДвижения,
		|	ВводыВыводы.ВидАктива КАК ВидАктива,
		|	ВводыВыводы.ВидОперацииВводаВыводаДС КАК ВидОперацииВводаВыводаДС,
		|	ВводыВыводы.БалансоваяСтоимость КАК БалансоваяСтоимость,
		|	ВводыВыводы.РыночнаяСтоимость КАК РыночнаяСтоимость,
		|	РАЗНОСТЬДАТ(ДОБАВИТЬКДАТЕ(ВводыВыводы.Период, ДЕНЬ, -1), &ДатаОкончания, ДЕНЬ) КАК КоличествоДнейВПериоде
		|ПОМЕСТИТЬ _ВводыВыводыАктивовВВалютеУчета
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводы
		|ГДЕ
		|	ВводыВыводы.Активность
		|	И ВводыВыводы.Организация = &Организация
		|	И ВводыВыводы.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОбъединенныеДанные.ВидДвиженияДенежныхСредств,
		|	ОбъединенныеДанные.Активность,
