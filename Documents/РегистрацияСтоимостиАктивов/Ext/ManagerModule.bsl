	Расшифровка_Строка010.Вставить("Таблица"		, Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Строка010").ПолучитьДанные().Выгрузить());
	
	Для Индекс = 1 По Расшифровка_Строка010.Таблица.Количество() - 1 Цикл
		СтрокаДанных = Расшифровка_Строка010.Таблица[Индекс];
