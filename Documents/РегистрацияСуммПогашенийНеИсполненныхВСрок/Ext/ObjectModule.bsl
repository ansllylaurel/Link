
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаЦБ Из ЭтотОбъект.ПартииЦеннойБумаги Цикл
		Если СтрокаЦБ.Партия.СчетДоверительногоУправления <> ЭтотОбъект.СчетДоверительногоУправления Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru=""В строке " + СтрокаЦБ.НомерСтроки
			+ " выбрана сделка другого счета ДУ """),ЭтотОбъект ,"ЦенныеБумаги["+(СтрокаЦБ.НомерСтроки-1)+"].Сделка",, Отказ);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	
	// ЕдиныйБухгалтерскийУчет
	Движения.ЕдиныйБухгалтерскийУчет.Очистить();
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СУММА(РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.ПогашениеКупонаНеИсполненноеВСрок) КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	СУММА(РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета) КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета,
		|	РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.НаБалансе КАК НаБалансе
		|ИЗ
		|	Документ.РегистрацияСуммПогашенийНеИсполненныхВСрок.ПартииЦеннойБумаги КАК РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги
		|ГДЕ
		|	РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.УчетныйАктивЕПС,
		|	РегистрацияСуммПогашенийНеИсполненныхВСрокЦенныеБумаги.НаБалансе";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета, "Дефолтный купон");
		
		// дебет
		Проводка.СчетДт = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчета;
		
		Проводка.СубконтоДт.ЦенныеБумаги = ЭтотОбъект.ЦеннаяБумага;
		
		Проводка.ВалютаДт = ЭтотОбъект.ЦеннаяБумага.ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ПогашениеКупонаНеИсполненноеВСрок;
		
		Проводка.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок;
		
		Если ВыборкаДетальныеЗаписи.НаБалансе Тогда
			
			Проводка.СчетКт = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчета;
			
			Проводка.СубконтоКт.ЦенныеБумаги = ЭтотОбъект.ЦеннаяБумага;
			
			Проводка.ВалютаКт = ЭтотОбъект.ЦеннаяБумага.ВалютаНоминала;
			Проводка.ВалютнаяСуммаКт = ВыборкаДетальныеЗаписи.ПогашениеКупонаНеИсполненноеВСрок;
			
			Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
			
		Иначе
			// кредит
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.ЕдиныйБухгалтерскийУчет.Записать();	
	// ЕдиныйБухгалтерскийУчет
	
	
	// БухПартииЦенныхБумаг
	Движения.БухПартииЦенныхБумаг.Очистить();
	Движения.БухПартииЦенныхБумаг.Записывать = Истина;
	
	Для Каждого ТекСтрокаЦенныеБумаги Из ПартииЦеннойБумаги Цикл
		
		Движение = Движения.БухПартииЦенныхБумаг.Добавить();
		//Движение.ВидДвиженияПартий = Перечисления.ВидыДвиженийПартий.ПереводЗадолженностиВПросроченную;
		
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = ЭтотОбъект.Дата;
		Движение.Организация = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
		Движение.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
		Движение.ЦеннаяБумага = ЭтотОбъект.ЦеннаяБумага;
		Движение.Партия = ТекСтрокаЦенныеБумаги.Партия;
		Движение.СтрокаПартии = ТекСтрокаЦенныеБумаги.СтрокаПартии;
		Движение.УчетныйАктивЕПС = ТекСтрокаЦенныеБумаги.УчетныйАктивЕПС;
		Движение.ПогашениеКупонаНеИсполненноеВСрок = ТекСтрокаЦенныеБумаги.ПогашениеКупонаНеИсполненноеВСрок;
		Движение.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета = ТекСтрокаЦенныеБумаги.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета;
		
		Если ТекСтрокаЦенныеБумаги.НаБалансе Тогда
		
			Движение.ЗадолженностьПоПогашениюКупона = -ТекСтрокаЦенныеБумаги.ПогашениеКупонаНеИсполненноеВСрок;
			Движение.ЗадолженностьПоПогашениюКупонаВВалютеУчета = -ТекСтрокаЦенныеБумаги.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.БухПартииЦенныхБумаг.Записать();	
	// БухПартииЦенныхБумаг
	
КонецПроцедуры

#КонецОбласти
