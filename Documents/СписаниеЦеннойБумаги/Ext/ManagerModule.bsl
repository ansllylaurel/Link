Процедура ПроведениеПоРегиструБухгалтерииПолноеПогашение(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, НаРасходыБудущихПериодов = Ложь, ОтражатьДоход = Истина, Отказ)

	ЭтотОбъект 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ЦеннаяБумага, Рынок, ПогашениеЦеннойБумаги, Количество");
	ПогашениеЦеннойБумаги 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ПогашениеЦеннойБумаги, "Сумма, ВалютаОплаты");
	ВалютаУчета 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	Эмитент		 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ЦеннаяБумага, "Эмитент");
	ЮрЛицоЭмитента			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эмитент, "ЮрФизЛицо");
	
		
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Дата, ЭтотОбъект.ЦеннаяБумага, УчетныйРегистр);	
	
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Перечисления.РынкиЦенныхБумаг.Облигации, ЭтотОбъект.ЦеннаяБумага);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
		
	СчетДоходов  = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		Дата,
		Организация, 
		СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов  = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;
	
	Если НаРасходыБудущихПериодов Тогда
		СчетДоходов  = ПланыСчетов.Основной.ДоходыБудущихПериодов;
		СчетРасходов = ПланыСчетов.Основной.РасходыБудущихПериодов;
	КонецЕсли;
		
	//читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.СуммаЧастичногоПогашения) КАК СуммаЧастичногоПогашения,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.СуммаЧастичногоПогашения = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения = 0
		|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|				ТОГДА БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ИндексацияНоминалаЗаВремяВладенияДооценка,
		|	СУММА(ВЫБОР
		|			КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ИндексацияНоминалаЗаВремяВладения
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.СуммаЧастичногоПогашения = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения = 0
		|				И БухПартииЦенныхБумаг.СтоимостьКупона = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ";

	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	СтруктураОбъекта = Новый Структура("Ссылка, Дата, Движения", ДокументСсылка, Дата, Движения); 
	
	Стоимость  				= 0;
	СтоимостьВВалютеУчета  	= 0;
	Переоценка 				= 0;
	ПереоценкаВВалютеУчета 	= 0;
	СуммаЧастичногоПогашения = 0;
	ИндексацияНоминалаЗаВремяВладенияДооценка = 0;
	ИндексацияНоминалаЗаВремяВладения = 0;
	
	Если ВыборкаДетальныеЗаписи.Количество()>0 Тогда
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.перекурсовка Тогда
				
				ПараметрыПерекурсовки = Новый Структура("ЦеннаяБумага, Рынок,"
					+ "СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
					ЭтотОбъект.ЦеннаяБумага, ЭтотОбъект.Рынок,
					ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета, 0, ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета, 0);
					
				СчетаУчета = Новый Структура;
				СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.СчетУчета);
				
				СчетаУчетаПереоценки = Новый Структура;
				СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.СчетУчетаПереоценки);
				
				АналитикаПерекурсовки = Новый Структура;
				АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.АналитикаПерекурсовки);
				
				БухгалтерскийУчет.ДвижениеПерекурсовки(СтруктураОбъекта, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
				
			Иначе
				Стоимость  				= ВыборкаДетальныеЗаписи.Стоимость;
				СтоимостьВВалютеУчета  	= ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета;
				Переоценка 				= ВыборкаДетальныеЗаписи.Переоценка;
				ПереоценкаВВалютеУчета 	= ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета;
				СуммаЧастичногоПогашения = ВыборкаДетальныеЗаписи.СуммаЧастичногоПогашения;
			//	ИндексацияНоминала		 = ВыборкаДетальныеЗаписи.ИндексацияНоминала;
							
				СтоимостьКупона		 		= ВыборкаДетальныеЗаписи.СтоимостьКупона;
				СтоимостьКупонаВВалютеУчета	= ВыборкаДетальныеЗаписи.СтоимостьКупонаВВалютеУчета;
				
				ИндексацияНоминалаЗаВремяВладенияДооценка = ВыборкаДетальныеЗаписи.ИндексацияНоминалаЗаВремяВладенияДооценка;
				ИндексацияНоминалаЗаВремяВладения = ВыборкаДетальныеЗаписи.ИндексацияНоминалаЗаВремяВладения;
				
			КонецЕсли;
		КонецЦикла;
	Иначе
		//возможна ситуация, что документ по налоговому учету не делает ничего и это норма
		Если СокрЛП(УчетныйРегистр) = "НалоговыйУчет" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы");
			Возврат;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы",,,, Отказ);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПогашениеЦеннойБумаги.ВалютаОплаты = ВалютаУчета Тогда
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
	Иначе
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
	КонецЕсли;
	
	
	СчетУчета = НастройкиУчета.СчетУчета;
		
	СчетУчетаПереоценки = НастройкиУчета.СчетУчетаПереоценки;
		
	АналитикаДоходов = НастройкиУчета.АналитикаДоходов;		
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ЦеннаяБумага, "ВалютаНоминала");
	ВалютныйУчет = ВалютаНоминала <> ВалютаУчета;
	
	// #471838. К одному полному погашению случилось два списания ценной бумаги по разным депозитарриям. 
	// Расчет партий себестоимость тела и купона списывает по первому документу, а количество по каждому документу свое
	// Если себестоиомость уже списана (СтоимостьВВалютеУчета), то это не первый документ Списание, списываем только количество, 
	// и поэтому проводку суммы погашения в доход не делаем 
	Если СтоимостьВВалютеУчета > 0 И ОтражатьДоход Тогда
		// #500167   Делим сумму погашения на сумму погашения тела и накопленной индексации номинала
		Если   ИндексацияНоминалаЗаВремяВладения <> 0 Тогда 
			
			СуммаПогашения =  ПогашениеЦеннойБумаги.Сумма -  ИндексацияНоминалаЗаВремяВладения; //Индексируемый номинал только у рублевых облигаций.			
			//погашение
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СуммаПогашения, "Доход от погашения облигации");
			
			Проводка.СчетДт = РасчетыСДебиторамиИКредиторами;
			Проводка.СубконтоДт.Контрагенты = ЮрЛицоЭмитента;
						
			Проводка.СчетКт = СчетДоходов;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
					
			//номинал 
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ИндексацияНоминалаЗаВремяВладения, "Доход от индексации номинала");
			
			Проводка.СчетДт = РасчетыСДебиторамиИКредиторами;
			Проводка.СубконтоДт.Контрагенты = ЮрЛицоЭмитента;
						
			Проводка.СчетКт = СчетДоходов;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаДоходовПогашенияИндексируемогоНоминала;
			Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
			
		Иначе	
			//Дт Счет7651 Кт СчетДоходы Сумма = ЭтотОбъект.ПогашениеЦеннойБумаги.Сумма
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПогашениеЦеннойБумаги.Сумма, ПогашениеЦеннойБумаги.ВалютаОплаты, Организация, Дата, Отказ) , "Доход от погашения облигации");
			
			Проводка.СчетДт = РасчетыСДебиторамиИКредиторами;
			Проводка.СубконтоДт.Контрагенты = ЮрЛицоЭмитента;
			
			Если РасчетыСДебиторамиИКредиторами.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = ПогашениеЦеннойБумаги.Сумма;
				Проводка.ВалютаДт = ПогашениеЦеннойБумаги.ВалютаОплаты;
			КонецЕсли;
			
			Проводка.СчетКт = СчетДоходов;
			Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
			Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		КонецЕсли;
	КонецЕсли;
	
	//Дт СчетРасходы Кт СчетУчета Сумма = Стоимость
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьВВалютеУчета, "Себестоимость в расход");
	
	Проводка.СчетДт = СчетРасходов;
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Если НЕ НаРасходыБудущихПериодов Тогда
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	КонецЕсли;
	
	Проводка.СчетКт = СчетУчета;
	Проводка.СубконтоКт.Облигации = ЭтотОбъект.ЦеннаяБумага;
	
	Проводка.КоличествоКт = ЭтотОбъект.Количество;
	
	Если ВалютныйУчет Тогда
		Проводка.ВалютнаяСуммаКт = Стоимость;
		Проводка.ВалютаКт = ВалютаНоминала;
	КонецЕсли;
	
	Если ПереоценкаВВалютеУчета <> 0 Тогда
		
		//Дт СчетРасходы Кт СчетУчетаПереоценки = Переоценка
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ПереоценкаВВалютеУчета, "Переоценка в расход");
		
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Если НЕ НаРасходыБудущихПериодов Тогда
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		КонецЕсли;
		
		Проводка.СчетКт = СчетУчетаПереоценки;
		Проводка.СубконтоКт.Облигации = ЭтотОбъект.ЦеннаяБумага;
		
		Если ВалютныйУчет Тогда
			Проводка.ВалютнаяСуммаКт = Переоценка;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
	КонецЕсли;
		
	// #500167  В НУ и БУ только ИндексацияНоминалаЗаВремяВладения 			
	Если ИндексацияНоминалаЗаВремяВладенияДооценка > 0 Тогда 
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ИндексацияНоминалаЗаВремяВладенияДооценка, "Индексация номинала");		
		
		// дебет
		Проводка.СчетДт = НастройкиУчета.СчетУчетаИндексацииНоминалаЗаВремяВладения;
		Проводка.СубконтоДт.Облигации = ЭтотОбъект.ЦеннаяБумага;
		
		// кредит
		Проводка.СчетКт = СчетДоходов;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаДоходовИндексацииНоминала;
		Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Если НЕ НаРасходыБудущихПериодов Тогда
			Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		КонецЕсли;
	ИначеЕсли ИндексацияНоминалаЗаВремяВладенияДооценка < 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, -ИндексацияНоминалаЗаВремяВладенияДооценка, "Индексация номинала");		
		
		// дебет
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаДоходовИндексацииНоминала;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Если НЕ НаРасходыБудущихПериодов Тогда
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = НастройкиУчета.СчетУчетаИндексацииНоминалаЗаВремяВладения;
		Проводка.СубконтоКт.Облигации = ЭтотОбъект.ЦеннаяБумага;
		
	КонецЕсли;		
	
	Если ИндексацияНоминалаЗаВремяВладения > 0 Тогда
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ИндексацияНоминалаЗаВремяВладения, "Списание накопленной индексации номинала");
		
		// дебет
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаДоходовИндексацииНоминала;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Если НЕ НаРасходыБудущихПериодов Тогда
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = НастройкиУчета.СчетУчетаИндексацииНоминалаЗаВремяВладения;
		Проводка.СубконтоКт.Облигации = ЭтотОбъект.ЦеннаяБумага;
		
	КонецЕсли;
		
	Если СуммаЧастичногоПогашения <> 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СуммаЧастичногоПогашения, ВалютаНоминала, Организация, Дата, Отказ), "Списание аванса");
		
		Проводка.СчетДт = ПланыСчетов.Основной.АвансыПоЧастичномуПогашениюОблигаций;
		Проводка.СубконтоДт.Облигации = ЭтотОбъект.ЦеннаяБумага;
		
		Если Проводка.СчетДт.Валютный Тогда
			Проводка.ВалютнаяСуммаДт = СуммаЧастичногоПогашения;
			Проводка.ВалютаДт = ВалютаНоминала;
		КонецЕсли;
		
		Проводка.СчетКт = СчетДоходов;
		Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
		Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	КонецЕсли;
	
	Если СтоимостьКупона <> 0 Тогда
		
		УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, ЭтотОбъект.Рынок, ЭтотОбъект.ЦеннаяБумага, Истина);
		
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			Дата,
			Организация,
			СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);		
		
		//Дт СчетРасходы Кт СчетУчета Сумма = СтоимостьКупона
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьКупонаВВалютеУчета, "Купон в расход");
		
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = НастройкиУчета.АналитикаДоходовПоследнееПогашение;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Если НЕ НаРасходыБудущихПериодов Тогда
			Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		КонецЕсли;
		
		Проводка.СчетКт = НастройкиУчета.СчетУчета;
		Проводка.СубконтоКт.Облигации = ЭтотОбъект.ЦеннаяБумага;
		
		Если ВалютныйУчет Тогда
			Проводка.ВалютнаяСуммаКт = СтоимостьКупона;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииСписаниеКоличества(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ, ЭтоПроведениеНачисления = Ложь)

	ЭтотОбъект = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ЦеннаяБумага, Количество, ПогашениеЦеннойБумаги");
	ПогашениеЦеннойБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ПогашениеЦеннойБумаги, "Сумма, ВалютаОплаты");
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Дата, ЭтотОбъект.ЦеннаяБумага, УчетныйРегистр);	
		
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Перечисления.РынкиЦенныхБумаг.Облигации, ЭтотОбъект.ЦеннаяБумага);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
	
	Если ПогашениеЦеннойБумаги.ВалютаОплаты = ВалютаУчета Тогда
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
	Иначе
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
	КонецЕсли;
	
	
	СчетУчета = НастройкиУчета.СчетУчета;
		
	СчетУчетаПереоценки = НастройкиУчета.СчетУчетаПереоценки;
		
	АналитикаДоходов = НастройкиУчета.АналитикаДоходов;		
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ЦеннаяБумага, "ВалютаНоминала");
	ВалютныйУчет = ВалютаНоминала <> ВалютаУчета;
		
	
	//Дт СчетРасходы Кт СчетУчета Сумма = Стоимость
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, 0, "Списание количества");
	
	Проводка.СчетДт = ПланыСчетов.Основной.ПрочиеРасходы;
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	Проводка.СчетКт = СчетУчета;
	Проводка.СубконтоКт.Облигации = ЭтотОбъект.ЦеннаяБумага;
	
	Проводка.КоличествоКт = ЭтотОбъект.Количество;
	
	Если ВалютныйУчет Тогда
		Проводка.ВалютаКт = ВалютаНоминала;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииСписаниеПаев(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ, ЭтоПроведениеНачисления = Ложь)

	ЭтотОбъект 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ЦеннаяБумага, ПогашениеЦеннойБумаги, Количество");
	ПогашениеЦеннойБумаги 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ПогашениеЦеннойБумаги, "Сумма, ВалютаОплаты");
	ВалютаУчета 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо КАК УправляющаяКомпанияЮрФизЛицо
	|ИЗ
	|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК РеквизитыПИФСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", ЭтотОбъект.ЦеннаяБумага.ПаевойИнвестиционныйФонд);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЮрЛицоЭмитента = ВыборкаДетальныеЗаписи.УправляющаяКомпанияЮрФизЛицо;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. не определен контрагент",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Дата, ЭтотОбъект.ЦеннаяБумага, УчетныйРегистр);	
	
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, Перечисления.РынкиЦенныхБумаг.Паи, ЭтотОбъект.ЦеннаяБумага);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
		
	СчетДоходов  = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		Дата,
		Организация, 
		СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов  = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;	
		
	//читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ";

	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	СтруктураОбъекта = Новый Структура("Ссылка, Дата, Движения", ДокументСсылка, Дата, Движения); 
	
	Стоимость  				= 0;
	СтоимостьВВалютеУчета  	= 0;
	Переоценка 				= 0;
	ПереоценкаВВалютеУчета 	= 0;
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы",,,, Отказ);
		Возврат;
		
	КонецЕсли;
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Перекурсовка Тогда
			
			ПараметрыПерекурсовки = Новый Структура(
				"ЦеннаяБумага, Рынок, СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ЭтотОбъект.ЦеннаяБумага, Перечисления.РынкиЦенныхБумаг.Паи,	ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета, 0, ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета, 0);
				
			СчетаУчета = Новый Структура;
			СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.СчетУчета);
			
			СчетаУчетаПереоценки = Новый Структура;
			СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.СчетУчетаПереоценки);
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.АналитикаПерекурсовки);
			
			БухгалтерскийУчет.ДвижениеПерекурсовки(СтруктураОбъекта, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
			
		Иначе
			
			Стоимость  				= ВыборкаДетальныеЗаписи.Стоимость;
			СтоимостьВВалютеУчета  	= ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета;
			Переоценка 				= ВыборкаДетальныеЗаписи.Переоценка;
			ПереоценкаВВалютеУчета 	= ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета;
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если ПогашениеЦеннойБумаги.ВалютаОплаты = ВалютаУчета Тогда
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
	Иначе
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
	КонецЕсли;
	
	СчетУчета = НастройкиУчета.СчетУчета;
		
	СчетУчетаПереоценки = НастройкиУчета.СчетУчетаПереоценки;
	
	// аналитика доходов всегда должна быть "Доходы по паям ЗПИФ",
	// любое погашение, как последнее, аналитику берем с последнего погашения
	АналитикаДоходов = НастройкиУчета.АналитикаДоходовПоследнееПогашение; //АналитикаДоходов;	
	Если НЕ ЗначениеЗаполнено(АналитикаДоходов) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задана 'Аналитика последнее погашение'. Исправьте настройик учета.",ЭтотОбъект.ПогашениеЦеннойБумаги.Ссылка,,,Отказ);
		Возврат;
	КонецЕсли;	
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ЦеннаяБумага, "ВалютаНоминала");
	ВалютныйУчет = ВалютаНоминала <> ВалютаУчета;
		
	//Дт Счет7651 Кт СчетДоходы Сумма = ЭтотОбъект.ПогашениеЦеннойБумаги.Сумма
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПогашениеЦеннойБумаги.Сумма, ПогашениеЦеннойБумаги.ВалютаОплаты, Организация, Дата, Отказ) , "Доход от погашения паев");
	
	Проводка.СчетДт = РасчетыСДебиторамиИКредиторами;
	Проводка.СубконтоДт.Контрагенты = ЮрЛицоЭмитента;
	
	Если РасчетыСДебиторамиИКредиторами.Валютный Тогда
		Проводка.ВалютнаяСуммаДт = ПогашениеЦеннойБумаги.Сумма;
		Проводка.ВалютаДт = ПогашениеЦеннойБумаги.ВалютаОплаты;
	КонецЕсли;
	
	Проводка.СчетКт = СчетДоходов;
	Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	//Дт СчетРасходы Кт СчетУчета Сумма = Стоимость
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьВВалютеУчета, "Себестоимость в расход");
	
	Проводка.СчетДт = СчетРасходов;
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	Проводка.СчетКт = СчетУчета;
	Проводка.СубконтоКт.Паи = ЭтотОбъект.ЦеннаяБумага;
	
	Проводка.КоличествоКт = ЭтотОбъект.Количество;
	
	Если ВалютныйУчет Тогда
		Проводка.ВалютнаяСуммаКт = Стоимость;
		Проводка.ВалютаКт = ВалютаНоминала;
	КонецЕсли;
	
	Если ПереоценкаВВалютеУчета <> 0 ИЛИ Переоценка <> 0 Тогда
	
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ПереоценкаВВалютеУчета, "Переоценка в расход");
		
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		
		Проводка.СчетКт = СчетУчетаПереоценки;
		Проводка.СубконтоКт.Паи = ЭтотОбъект.ЦеннаяБумага;
		
		Если ВалютныйУчет Тогда
			Проводка.ВалютнаяСуммаКт = Переоценка;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииСписаниеЦенныхБумаг(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ, ЭтоПроведениеНачисления = Ложь)

	ЭтотОбъект 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ЦеннаяБумага, ПогашениеЦеннойБумаги, Количество, Рынок");
	ПогашениеЦеннойБумаги 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ПогашениеЦеннойБумаги, "Сумма, ВалютаОплаты");
	ВалютаУчета 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Дата, ЭтотОбъект.ЦеннаяБумага, УчетныйРегистр);	
	
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, ЭтотОбъект.Рынок, ЭтотОбъект.ЦеннаяБумага);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
		
	СчетДоходов  = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		Дата,
		Организация, 
		СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов  = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;	
		
	//читаем движения партий
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Перекурсовка
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумаг.Стоимость = 0
		|				И БухПартииЦенныхБумаг.Переоценка = 0
		|				И БухПартииЦенныхБумаг.ИндексацияНоминала = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ";

	Запрос.УстановитьПараметр("Регистратор", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидУчета",    Перечисления.ВидыУчета[УчетныйРегистр]);

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	СтруктураОбъекта = Новый Структура("Ссылка, Дата, Движения", ДокументСсылка, Дата, Движения); 
	
	Стоимость  				= 0;
	СтоимостьВВалютеУчета  	= 0;
	Переоценка 				= 0;
	ПереоценкаВВалютеУчета 	= 0;
	
	Если ВыборкаДетальныеЗаписи.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведение по регистрам бухгалтерии не возможно, т.к. движения по партиям не сформированы",,,, Отказ);
		Возврат;
		
	КонецЕсли;
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Перекурсовка Тогда
			
			ПараметрыПерекурсовки = Новый Структура(
				"ЦеннаяБумага, Рынок, СтоимостьВВалютеУчета, СтоимостьКупонаВВалютеУчета, ПереоценкаВВалютеУчета, ПереоценкаКупонаВВалютеУчета",
				ЭтотОбъект.ЦеннаяБумага, ЭтотОбъект.Рынок,	ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета, 0, ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета, 0);
				
			СчетаУчета = Новый Структура;
			СчетаУчета.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.СчетУчета);
			
			СчетаУчетаПереоценки = Новый Структура;
			СчетаУчетаПереоценки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.СчетУчетаПереоценки);
			
			АналитикаПерекурсовки = Новый Структура;
			АналитикаПерекурсовки.Вставить(УчетныйАктив.ИмяПредопределенныхДанных, НастройкиУчета.АналитикаПерекурсовки);
			
			БухгалтерскийУчет.ДвижениеПерекурсовки(СтруктураОбъекта, УчетныйРегистр, ПараметрыПерекурсовки, АналитикаПерекурсовки,  СчетаУчета, СчетаУчетаПереоценки, ОбращаетсяНаОРЦБ, Отказ);		
			
		Иначе
			
			Стоимость  				= ВыборкаДетальныеЗаписи.Стоимость;
			СтоимостьВВалютеУчета  	= ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета;
			Переоценка 				= ВыборкаДетальныеЗаписи.Переоценка;
			ПереоценкаВВалютеУчета 	= ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета;
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если ПогашениеЦеннойБумаги.ВалютаОплаты = ВалютаУчета Тогда
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВРублях;
	Иначе
		РасчетыСДебиторамиИКредиторами = ПланыСчетов.Основной.РасчетыСДебиторамиИКредиторамиВВалюте;
	КонецЕсли;
	
	СчетУчета = НастройкиУчета.СчетУчета;
		
	СчетУчетаПереоценки = НастройкиУчета.СчетУчетаПереоценки;
	
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
		
	АналитикаДоходов = НастройкиУчета.АналитикаДоходовПоследнееПогашение;		
	
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ЦеннаяБумага, "ВалютаНоминала");
		
	//Дт Счет7651 Кт СчетДоходы Сумма = ЭтотОбъект.ПогашениеЦеннойБумаги.Сумма
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ПогашениеЦеннойБумаги.Сумма, ПогашениеЦеннойБумаги.ВалютаОплаты, Организация, Дата, Отказ) , "Доход от погашения");
	
	Проводка.СчетДт = РасчетыСДебиторамиИКредиторами;
	Проводка.СубконтоДт.Контрагенты = ЭтотОбъект.ЦеннаяБумага.Эмитент.ЮрФизЛицо;
	
	Если РасчетыСДебиторамиИКредиторами.Валютный Тогда
		Проводка.ВалютнаяСуммаДт = ПогашениеЦеннойБумаги.Сумма;
		Проводка.ВалютаДт = ПогашениеЦеннойБумаги.ВалютаОплаты;
	КонецЕсли;
	
	Проводка.СчетКт = СчетДоходов;
	Проводка.СубконтоКт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоКт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Проводка.СубконтоКт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	//Дт СчетРасходы Кт СчетУчета Сумма = Стоимость
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, СтоимостьВВалютеУчета, "Себестоимость в расход");
	
	Проводка.СчетДт = СчетРасходов;
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	Проводка.СчетКт = СчетУчета;
	Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЭтотОбъект.ЦеннаяБумага;
	
	Проводка.КоличествоКт = ЭтотОбъект.Количество;
	
	Если СчетУчета.Валютный Тогда
		Проводка.ВалютнаяСуммаКт = Стоимость;
		Проводка.ВалютаКт = ВалютаНоминала;
	КонецЕсли;
	
	Если Переоценка <> 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, ПереоценкаВВалютеУчета, "Переоценка в расход");
		
		Проводка.СчетДт = СчетРасходов;
		Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
		Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
		Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
		
		Проводка.СчетКт = СчетУчетаПереоценки;
		Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЭтотОбъект.ЦеннаяБумага;
		
		Если СчетУчетаПереоценки.Валютный Тогда
			Проводка.ВалютнаяСуммаКт = Переоценка;
			Проводка.ВалютаКт = ВалютаНоминала;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерииСписаниеКоличестваЦенныхБумаг(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ, ЭтоПроведениеНачисления = Ложь)

	ЭтотОбъект 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ЦеннаяБумага, ПогашениеЦеннойБумаги, Количество, Рынок");
	ПогашениеЦеннойБумаги 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.ПогашениеЦеннойБумаги, "Сумма, ВалютаОплаты");
	ВалютаУчета 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета");
	
	ОбращаетсяНаОРЦБ = БухгалтерскийУчет.ПолучитьСведенияОбОбращенииЦеннойБумагиНаОРЦБ(Дата, ЭтотОбъект.ЦеннаяБумага, УчетныйРегистр);	
	
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, ЭтотОбъект.Рынок, ЭтотОбъект.ЦеннаяБумага);
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр);		
		
	СчетДоходов  = ПланыСчетов.Основной.ПрочиеДоходы;	
	СчетРасходов = ПланыСчетов.Основной.ПрочиеРасходы;
		
	ИспользоватьСчетПродаж = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		Дата,
		Организация, 
		СчетДоверительногоУправления,
		"ИспользоватьСчетПродаж");
		
	Если ИспользоватьСчетПродаж Тогда
		СчетДоходов  = ПланыСчетов.Основной.Выручка;
		СчетРасходов = ПланыСчетов.Основной.СебестоимостьПродажи;
	КонецЕсли;	
	
	СчетУчета = НастройкиУчета.СчетУчета;
		
	АналитикаДоходов = НастройкиУчета.АналитикаДоходов;		
	
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);	
		
	ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ЦеннаяБумага, "ВалютаНоминала");
	
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ДокументСсылка, Движения, 0, "Списание ИСУ");
	
	Проводка.СчетДт = СчетРасходов;
	Проводка.СубконтоДт.ПрочиеДоходыИРасходы = АналитикаДоходов;
	Проводка.СубконтоДт.ЦенныеБумаги         = ЭтотОбъект.ЦеннаяБумага;
	Проводка.СубконтоДт.ОбращаетсяНаОРЦБ     = ОбращаетсяНаОРЦБ;
	
	Проводка.СчетКт = СчетУчета;
	Проводка.СубконтоКт[ВидСубконтоУчетаЦеннойБумаги] = ЭтотОбъект.ЦеннаяБумага;
	
	Проводка.КоличествоКт = ЭтотОбъект.Количество;
	
	Если СчетУчета.Валютный Тогда
		Проводка.ВалютнаяСуммаКт = 0;
		Проводка.ВалютаКт = ВалютаНоминала;
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьНаборПроводок(ДокументСсылка, Дата, Организация, СчетДоверительногоУправления, ВидЗадолженности = Неопределено, УчетныйРегистр, Отказ, ЭтоПроведениеНачисления = Ложь) Экспорт
	
	ЭтотОбъект = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ЦеннаяБумага,Рынок");
	
	УчетныйАктив = БухгалтерскийУчет.ОпределитьУчетныйАктив(Дата, ЭтотОбъект.Рынок, ЭтотОбъект.ЦеннаяБумага);
	
	ВариантОтраженияДебиторскойЗадолженностиПриПолномПогашении = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
		Дата,
		Организация,
		СчетДоверительногоУправления,
		УчетныйАктив,
		УчетныйРегистр,
		"ВариантОтраженияДебиторскойЗадолженностиПриПолномПогашении");
		
		
	Движения = РегистрыБухгалтерии[УчетныйРегистр].СоздатьНаборЗаписей();
	
	Если Не ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЦеннойБумаги") Тогда
		Возврат Движения;
	КонецЕсли;
	
	
	Если ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		
		Если ВариантОтраженияДебиторскойЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментСписания Тогда
			ПроведениеПоРегиструБухгалтерииСписаниеПаев(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ);
		КонецЕсли;
		
		Возврат Движения;
		
	ИначеЕсли ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия
		ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
		
		Если ВариантОтраженияДебиторскойЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментСписания Тогда
			ПроведениеПоРегиструБухгалтерииСписаниеЦенныхБумаг(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ);
		Иначе
			ПроведениеПоРегиструБухгалтерииСписаниеКоличестваЦенныхБумаг(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ);
		КонецЕсли;
		
		Возврат Движения;
		
	КонецЕсли;
	
	МетодОпределенияДоходовИРасходов = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		Дата, 
		Организация, 
		СчетДоверительногоУправления,
		УчетныйРегистр,
		"МетодОпределенияДоходовИРасходов");
		
	Если Не ЗначениеЗаполнено(МетодОпределенияДоходовИРасходов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В настройках по виду учета " + УчетныйРегистр + " не указан метод определения доходов и расходов. Документ не проведен по виду учета!", ДокументСсылка,,,Отказ);
		Возврат Движения;
	КонецЕсли;
	
	// при кассовом методе нам нужно определить прошла ли оплата в день списания
	Если МетодОпределенияДоходовИРасходов = Перечисления.МетодыОпределенияДоходовИРасходов.Кассовый Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ОстатокЗадолженности.СуммаОстаток КАК СуммаОстаток
			|ИЗ
			|	(ВЫБРАТЬ
			|		ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток
			|	ИЗ
			|		РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|				&КонецДня,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|					И Основание = &Основание) КАК ЗадолженностиПоДенежнымСредствамОстатки) КАК _ОстатокЗадолженности
			|ГДЕ
			|	_ОстатокЗадолженности.СуммаОстаток <> 0";
		
		Запрос.УстановитьПараметр("КонецДня", Новый Граница(КонецДня(Дата), ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Основание", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПогашениеЦеннойБумаги"));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
		
		ОплатаПрошла = Запрос.Выполнить().Пустой();
		Если ОплатаПрошла Тогда // спишем только количество, себестоимость спишет оплата  
		    ПроведениеПоРегиструБухгалтерииСписаниеКоличества(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ);
		Иначе // себестоимость на расходы будущих периодов
			ПроведениеПоРегиструБухгалтерииПолноеПогашение(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Истина, Ложь, Отказ);
		КонецЕсли;
	Иначе
		Если ВариантОтраженияДебиторскойЗадолженностиПриПолномПогашении = Перечисления.ВариантыОтраженияДебиторскойЗадолженностиПриПолномПогашенииОблигаций.НаМоментСписания Тогда
			ПроведениеПоРегиструБухгалтерииПолноеПогашение(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр,,, Отказ);
		Иначе
			ПроведениеПоРегиструБухгалтерииСписаниеКоличества(ДокументСсылка, Движения, Дата, Организация, СчетДоверительногоУправления, УчетныйРегистр, Отказ);
		КонецЕсли;
	КонецЕсли;
		
	Возврат Движения;
	
КонецФункции	