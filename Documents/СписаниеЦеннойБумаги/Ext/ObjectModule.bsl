
Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные");
	
	ЭлементБлокировкиДанных.УстановитьЗначение("ВидБлокировкиАктива",          Перечисления.ВидыБлокировокАктивов.Погашение);
	ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
	ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ЭлементБлокировкиДанных.УстановитьЗначение("ДепозитарныйСчет",             ЭтотОбъект.ДепозитарныйСчет);
	ЭлементБлокировкиДанных.УстановитьЗначение("ЦеннаяБумага",                 ЭтотОбъект.ЦеннаяБумага);

	БлокировкаДанных.Заблокировать();

КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);

	Движения.ОстаткиЦенныхБумагЗаблокированные.Записывать = Истина;
	Движения.ОстаткиЦенныхБумаг.Записывать                = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать          = Истина;
	
	// остатки ц/б заблокированные
	Движение = Движения.ОстаткиЦенныхБумагЗаблокированные.ДобавитьРасход();
	
	Движение.Период                       = ЭтотОбъект.Дата;
	Движение.ВидБлокировкиАктива          = Перечисления.ВидыБлокировокАктивов.Погашение;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчет;
	Движение.Рынок                        = ЭтотОбъект.Рынок;
	Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
	Движение.Количество                   = ЭтотОбъект.Количество;
	
	// остатки ц/б
	Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьРасход();
	
	Движение.Период                       = ЭтотОбъект.Дата;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчет;
	Движение.Рынок                        = ЭтотОбъект.Рынок;
	Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
	Движение.Количество                   = ЭтотОбъект.Количество;
	
	// операции с ц/б
	Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
	
	Движение.Операция                     = ЭтотОбъект.Ссылка;
	Движение.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
	Движение.Организация                  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.Рынок                        = ЭтотОбъект.Рынок;
	Движение.ЦеннаяБумага                 = ЭтотОбъект.ЦеннаяБумага;
	Движение.Количество                   = ЭтотОбъект.Количество;
	Движение.ДатаОперации                 = ЭтотОбъект.Дата;
	
	Движения.Записать();
	
	РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЦенныхБумагЗаблокированных(ЭтотОбъект, Отказ);
		
КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
		
	// все списало погашение
	Если НастройкиУчета.СписыватьПриПолномПогашенииВМоментПогашения
		И ЭтотОбъект.ПогашениеЦеннойБумаги.Дата < БухгалтерскийУчетПовтИсп.ДатаСКоторойПерестаемСписыватьКоличествоВМоментПолногоПогашения() Тогда
		Возврат
	КонецЕсли;
	
	Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
		БухгалтерскийУчетЕПС.СформироватьПроводкиСписанияЦеннойБумагиСПартиямиНаЛицевыхСчетах(УчетныйРегистр, ЭтотОбъект, Отказ);
		Возврат;
	Иначе
		БухгалтерскийУчетЕПС.СформироватьПроводкиСписанияЦеннойБумаги(УчетныйРегистр, ЭтотОбъект, Отказ);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Погашение
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС";
	
	Запрос.УстановитьПараметр("Погашение", ЭтотОбъект.ПогашениеЦеннойБумаги);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	
	МассивУчетныхАктивов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УчетныйАктивЕПС");
	
	БухгалтерскийУчетЕПС.ЗакрытьПарныеСчетаДоходовРасходов(ЭтотОбъект, МассивУчетныхАктивов, Истина, Истина, Неопределено, Отказ);
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	// Получение списка проводок вынесено в модуль менеджера
	НаборПроводок = Документы.СписаниеЦеннойБумаги.ПодготовитьНаборПроводок(
		ЭтотОбъект.Ссылка, 
		ЭтотОбъект.Дата, 
		ЭтотОбъект.Организация, 
		ЭтотОбъект.СчетДоверительногоУправления,
		,
		УчетныйРегистр, 
		Отказ, Истина);
				
	Если Отказ ИЛИ НаборПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТЗПроводок = НаборПроводок.Выгрузить();
	ТЗПроводок.ЗаполнитьЗначения(ЭтотОбъект.Ссылка, "Регистратор");
	Движения[УчетныйРегистр].Загрузить(ТЗПроводок);  
		
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда
		ЭтотОбъект.ПогашениеЦеннойБумаги = ДанныеЗаполнения;
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, Рынок, ЦеннаяБумага, СчетДоверительногоУправления, Количество");
	Конецесли;
		
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "ПогашениеЦеннойБумаги");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации
			И ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Паи
			И ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Векселя
			И ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия
		Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимое значение рынка ценных бумаг", ЭтотОбъект, "Рынок",, Отказ);
		КонецЕсли;
		
		Если РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЭтотОбъект.ЦеннаяБумага) <> ЭтотОбъект.Рынок Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рынок не соответствует ценной бумаге", ЭтотОбъект, "Рынок",, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);

	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
