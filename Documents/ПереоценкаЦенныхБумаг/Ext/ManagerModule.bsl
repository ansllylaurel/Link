Функция НужнаПереоценка(Дата, Организация, СчетДоверительногоУправления, ВидУчета) Экспорт  
	
	Если ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда // для ЕПС определение необходимости пока очень сложно, оставлю его на потом
		Возврат Истина; 
	КонецЕсли;
	
	// Для НУ необходимость переоценки определяется просто:
	// 	берем настройки активов:
	//		"Еврооблигации купон"
	//		"Облигации государственные и муниципальные купон"
	//		"Облигации государственные номинированные в иностранной валюте купон"
	//		"Облигации корпоративные купон"
	// и проверяем их на периодичность
	// Для РСБУ учитываем кроме купонов все виды активов ценные бумаги.
	Если  СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		КалендарьДУ = Справочники.Календари.Общероссийский;
	Иначе 
		КалендарьДУ = Неопределено;
	КонецЕсли;
	
	ДатаПереоценки = НачалоДня(Дата);
	
	Если ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		
		ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ДатаПереоценки,
			Организация,
			СчетДоверительногоУправления,
			ВидУчета,
			"ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств");
			
		Если БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПерекурсовкиВалютныхАктивовИОбязательств, ДатаПереоценки, КалендарьДУ) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВДеньОперации КАК ПереоцениватьВДеньОперации,
		|	НастройкиУчетаАктивовСрезПоследних.ПереоцениватьВНерабочиеДни КАК ПереоцениватьВНерабочиеДни
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&НаДату,
		|			Организация = &Организация
		|				И ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив В (&УчетныеАктивы)) КАК НастройкиУчетаАктивовСрезПоследних";
	
	УчетныеАктивы = Новый Массив;
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон);
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.Акции);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.Паи);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративные);
		УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.Еврооблигации);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("НаДату", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("УчетныеАктивы", УчетныеАктивы);
	
	ПоследняяРабочаяДата = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский,НачалоДня(ДатаПереоценки));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ПереоцениватьВДеньОперации Тогда // тут мы не можем проверить были ли операции - пусть переоценка сам проверит
			Возврат Истина;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно Тогда
			Если ПоследняяРабочаяДата = ДатаПереоценки ИЛИ ВыборкаДетальныеЗаписи.ПереоцениватьВНерабочиеДни Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ВыборкаДетальныеЗаписи.ПериодичностьПереоценки, ДатаПереоценки, КалендарьДУ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьСуществующийДокумент(Организация, СчетДоверительногоУправления, Дата, ВидУчета) Экспорт

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумаг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
		|ГДЕ
		|	ПереоценкаЦенныхБумаг.Организация = &Организация
		|	И ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПереоценкаЦенныхБумаг.Дата МЕЖДУ &НачальнаяДата И &КонечнаяДата
		|	И НЕ ПереоценкаЦенныхБумаг.ПометкаУдаления
		|	И ПереоценкаЦенныхБумаг.ВидУчета = &ВидУчета");

	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачальнаяДата",					НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонечнаяДата",					КонецДня(Дата));
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

Функция РазрешенаИнтерактивнаяРаботаСДокументом(ОбъектДокумента) Экспорт

	Если ОбъектДокумента.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет
		И ОбъектДокумента.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
	
		Возврат Ложь;
	
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Функция СверитьДанныеПереоценкиСОстаткамиПартий(ЭтотОбъект, Запрос) Экспорт

	// проверим, что текущие показатели партий ц/б (балансовые в терминологии переоценки) соответствуют остаткам на учетном регистре
	#Область Текст_запроса_контроль_остатков
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.Партия КАК Партия,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.Количество КАК Количество,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСумма КАК БалансоваяСумма,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСуммаКупона КАК БалансоваяСуммаКупона,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.Рынок КАК Рынок,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяИндексацияНоминала КАК БалансоваяИндексацияНоминала,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦена КАК ОценочнаяЦена,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСумма КАК ОценочнаяСумма,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаВВалютеУчета КАК ОценочнаяСуммаВВалютеУчета,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяЦенаКупона КАК ОценочнаяЦенаКупона,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаКупона КАК ОценочнаяСуммаКупона,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета КАК ОценочнаяСуммаКупонаВВалютеУчета,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ПолеЦены КАК ПолеЦены,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.УровеньОценки КАК УровеньОценки,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ДатаКотировки КАК ДатаКотировки,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ДатаКотировкиКупона КАК ДатаКотировкиКупона,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.ИсточникЦены КАК ИсточникЦены,
		|	ПереоценкаЦенныхБумагЦенныеБумаги.КурсВалютыНоминала КАК КурсВалютыНоминала
		|ПОМЕСТИТЬ _ПереоценкаЦенныхБумагЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ПереоценкаЦенныхБумагЦенныеБумаги
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	УчетныйАктивЕПС,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага, _ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.Рынок, _ПереоценкаЦенныхБумагЦенныеБумаги.Рынок) КАК Рынок,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.Партия, _ПереоценкаЦенныхБумагЦенныеБумаги.Партия) КАК Партия,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтрокаПартии, _ПереоценкаЦенныхБумагЦенныеБумаги.СтрокаПартии) КАК СтрокаПартии,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьОстаток, 0) КАК БалансоваяСтоимостьОстаток,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаОстаток, 0) КАК БалансоваяПереоценкаОстаток,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСумма, 0) КАК БалансоваяСумма,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток, 0) КАК БалансоваяСтоимостьКупонаОстаток,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток, 0) КАК БалансоваяПереоценкаКупонаОстаток,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСуммаКупона, 0) КАК БалансоваяСуммаКупона,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяИндексацияНоминала, 0) КАК ИндексацияНоминала,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) КАК БалансоваяИндексацияНоминала
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ПереоценкаЦенныхБумагЦенныеБумаги КАК _ПереоценкаЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.Рынок = _ПереоценкаЦенныхБумагЦенныеБумаги.Рынок
		|			И БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС = _ПереоценкаЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС
		|			И БухПартииЦенныхБумагОстатки.ЦеннаяБумага = _ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.Партия = _ПереоценкаЦенныхБумагЦенныеБумаги.Партия
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = _ПереоценкаЦенныхБумагЦенныеБумаги.СтрокаПартии
		|ГДЕ
		|	(ЕСТЬNULL(БухПартииЦенныхБумагОстатки.КоличествоОстаток, 0) <> ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.Количество, 0)
		|			ИЛИ ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаОстаток + ВЫБОР
		|						КОГДА &ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|							ТОГДА БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток
		|						ИНАЧЕ 0
		|					КОНЕЦ, 0) <> ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСумма, 0)
		|				И ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаОстаток, 0) <> ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСумма, 0)
		|			ИЛИ ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) <> ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяИндексацияНоминала, 0)
		|			ИЛИ ЕСТЬNULL(БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток, 0) <> ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСуммаКупона, 0)
		|				И ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток, 0) <> ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.БалансоваяСуммаКупона, 0))";		
	#КонецОбласти 
		
	Запрос.УстановитьПараметр("Период",                       Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     ЭтотОбъект.ВидУчета);
	Запрос.УстановитьПараметр("ЦенныеБумаги",                 ЭтотОбъект.ДополнительныеСвойства.ЦенныеБумаги);
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИндексацияНоминалаЗаВремяВладенияОстаток", "ИндексацияНоминалаОстаток");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() <> 0 Тогда
		ТекстСообщения = "Обнаружены расхождения между данными документа и остатками партий:";
				
		Пока Выборка.Следующий() Цикл
			Если Выборка.Количество <> Выборка.КоличествоОстаток Тогда
				ТекстСообщения = ТекстСообщения + Символы.ПС + "	" + Выборка.ЦеннаяБумага + " / " + Выборка.Партия + " / " + Выборка.СтрокаПартии + " / Количество / " + Выборка.Количество + " / " + Выборка.КоличествоОстаток;
			КонецЕсли;
			
			Если Выборка.БалансоваяСумма <> Выборка.БалансоваяПереоценкаОстаток 
				И Выборка.БалансоваяСумма <> Выборка.БалансоваяСтоимостьОстаток + Выборка.БалансоваяПереоценкаОстаток
			Тогда
				ТекстСообщения = ТекстСообщения + Символы.ПС + "	" + Выборка.ЦеннаяБумага + " / " + Выборка.Партия + " / " + Выборка.СтрокаПартии + " / Балансовая стоимость / " + Выборка.БалансоваяСумма + " / " + Выборка.БалансоваяСтоимостьОстаток + " + " + Выборка.БалансоваяПереоценкаОстаток;
			КонецЕсли;
			
			Если Выборка.БалансоваяСуммаКупона <> Выборка.БалансоваяСтоимостьКупонаОстаток + Выборка.БалансоваяПереоценкаКупонаОстаток
				И Выборка.БалансоваяСуммаКупона <> Выборка.БалансоваяСтоимостьКупонаОстаток
			Тогда
				ТекстСообщения = ТекстСообщения + Символы.ПС + "	" + Выборка.ЦеннаяБумага + " / " + Выборка.Партия + " / " + Выборка.СтрокаПартии + " / Балансовая стоимость купона / " + Выборка.БалансоваяСуммаКупона + " / " + Выборка.БалансоваяСтоимостьКупонаОстаток + " + " + Выборка.БалансоваяПереоценкаКупонаОстаток; 
			КонецЕсли;
			
			Если Выборка.БалансоваяИндексацияНоминала <> Выборка.ИндексацияНоминала Тогда 
				ТекстСообщения = ТекстСообщения + Символы.ПС + "	" + Выборка.ЦеннаяБумага + " / " + Выборка.Партия + " / " + Выборка.СтрокаПартии + " / Стоимость индексации номинала / " + Выборка.БалансоваяИндексацияНоминала + " / " + Выборка.ИндексацияНоминала; 
			КонецЕсли;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,ЭтотОбъект.Ссылка);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;

