Процедура ЗаполнитьЦенныеБумагиПроданныеВРЕПО(Объект, МенеджерВременныхТаблиц = Неопределено, ИмяВремТаблицы = Неопределено, Отказ)  Экспорт

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",                       Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",                  Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",                     Объект.ВидУчета);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтрокаПартии КАК СтрокаПартии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРепо.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагПроданныеВРепоОстатки
		|ГДЕ
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток = 0";
		
	Первый = Истина;
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Количество");
	
	Для каждого Ресурс Из Метаданные.РегистрыНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Ресурсы Цикл
		
		Если МассивИсключений.Найти(Ресурс.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Первый Тогда
			ТекстЗапроса = ТекстЗапроса + " 
			|	И НЕ(";
			Первый = Ложь;
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|				И ";
		КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса + "БухПартииЦенныхБумагПроданныеВРепоОстатки." + Ресурс.Имя + "Остаток = 0";
	
	КонецЦикла; 
		
	ТекстЗапроса = ТекстЗапроса + ")";
	
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение невозможно: по ценной бумаге " + Выборка.ЦеннаяБумага + " обнаружен нулевой остаток. Партия прямого РЕПО: " + Выборка.Партия + ", строка: " + Выборка.СтрокаПартии, , , , Отказ);
	КонецЦикла; 
	
	Если Отказ Тогда
	    Возврат;
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО) КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Неопределено КАК ТипЗадолженности,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Партия КАК Основание,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПродажаРЕПО КАК ПродажаРЕПО,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтрокаПродажиРЕПО КАК СтрокаПродажиРЕПО,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток <> 0
		|			ТОГДА (БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьОстаток + БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяЦена,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток = 0
		|			ТОГДА 0
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагПроданныеВРепоОстатки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА НоминалыЦенныхБумагСрезПоследних.Номинал = 0
		|						ТОГДА 0
		|					ИНАЧЕ (БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьОстаток + БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток / НоминалыЦенныхБумагСрезПоследних.Номинал * 100
		|				КОНЕЦ
		|		ИНАЧЕ (БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьОстаток + БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаОстаток) / БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток
		|	КОНЕЦ КАК БалансоваяЦенаПроцент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток <> 0
		|			ТОГДА (БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьКупонаОстаток + БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаКупонаОстаток) / БухПартииЦенныхБумагПроданныеВРепоОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК БалансоваяЦенаКупона,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьОстаток + БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаОстаток КАК БалансоваяСумма,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьКупонаОстаток КАК БалансоваяСуммаКупона,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупона,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета,
		|	0 КАК БалансоваяИндексацияНоминала,
		|	0 КАК РасходыПриПокупкеВСтоимости,
		|	0 КАК ПереоценкаНаБалансе,
		|	0 КАК ПереоценкаНаБалансеВВалютеУчета,
		|	0 КАК БалансовыеДисконтПремия,
		|	0 КАК БалансовыеДисконтПремияВВалютеУчета,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета,
		|	0 КАК НачальнаяРазницаППНеНаблюдаемыеДанные,
		|	0 КАК БалансоваяКорректировкаЭСП,
		|	0 КАК БалансоваяКорректировкаЭСПВВалютеУчета,
		|	0 КАК НачальныеДисконтПремия,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаВВалютеУчетаОстаток КАК БалансоваяСуммаВВалютеУчета,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК БалансоваяСуммаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумагПроданныеВРепоОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение";
		Если МенеджерВременныхТаблиц <> Неопределено Тогда
			Запрос.Текст =Запрос.Текст + "
			|	ПОМЕСТИТЬ "+ИмяВремТаблицы;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст +"
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагПроданныеВРЕПО.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагПроданныеВРепоОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО БухПартииЦенныхБумагПроданныеВРепоОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага";

		
		
	РезультатЗапроса = Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПрименитьПолитикуУчетаПереоценкиПроданныеВРЕПО(Объект, УдалятьЛишниеСтроки = Ложь, СообщенияОбОценочнойСтоимости = Неопределено, ВалютаУчета,  Отказ) Экспорт

	ДатаПереоценки = НачалоДня(Объект.Дата);
	
	НастройкаПериодичностиПереоценки       = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктивов(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета, "ПериодичностьПереоценкиПереданныхВЗалог");
	
	НужнаПерекурсовка = Документы.ПереоценкаВалютныхЦенностей.НужнаПерекурсовка(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	НужнаИндексацияНоминала = БухгалтерскийУчет.НужнаИндексацияНоминала(ДатаПереоценки, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ВидУчета);
	
	КоличествоИндексовПереоценки = Объект.ЦенныеБумаги.Количество()-1;
	Для СЦ = -(КоличествоИндексовПереоценки) По 0 Цикл
		СтрокаЦенныеБумаги = Объект.ЦенныеБумаги.Получить(-СЦ);
		
		УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(Объект.Дата, СтрокаЦенныеБумаги.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага);
		УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(Объект.Дата, СтрокаЦенныеБумаги.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага, Истина);
		ИмяУчетногоАктива = УчетныйАктив.ИмяПредопределенныхДанных;
		ИмяУчетногоАктиваКупона = УчетныйАктивКупон.ИмяПредопределенныхДанных;
		
		ПериодичностьПереоценки       = НастройкаПериодичностиПереоценки[ИмяУчетногоАктива];
		ПериодичностьПереоценкиКупона = НастройкаПериодичностиПереоценки[ИмяУчетногоАктиваКупона];
		
		Переоценивать = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценки, ДатаПереоценки, Справочники.Календари.Общероссийский);

		ПереоцениватьКупон = БухгалтерскийУчетЕПС.ПроверкаНеобходимостиПереоценки(ПериодичностьПереоценкиКупона, ДатаПереоценки, Справочники.Календари.Общероссийский);
		
		
		Если СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала = ВалютаУчета Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Ложь;
		ИначеЕсли Переоценивать ИЛИ ПереоцениватьКупон Тогда
			СтрокаЦенныеБумаги.Перекурсовать = Истина;
		ИначеЕсли ЗначениеЗаполнено(Переоценивать) И ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать 
			И ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка() Тогда
			СтрокаЦенныеБумаги.Перекурсовать = НужнаПерекурсовка;
		КонецЕсли;
		
		СтрокаЦенныеБумаги.ИндексироватьНоминал = Ложь;
		Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			Если СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал 
				И ЗначениеЗаполнено(Переоценивать) 
				И ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.НеПереоценивать 
				И ПериодичностьПереоценки <> Перечисления.ПериодичностьПереоценкиАктивов.ПустаяСсылка() Тогда
				СтрокаЦенныеБумаги.ИндексироватьНоминал = НужнаИндексацияНоминала;
			КонецЕсли;
		КонецЕсли;
		
		Если УдалятьЛишниеСтроки И Не Переоценивать И Не ПереоцениватьКупон И НЕ СтрокаЦенныеБумаги.Перекурсовать И НЕ СтрокаЦенныеБумаги.ИндексироватьНоминал Тогда
			Объект.ЦенныеБумаги.Удалить(-СЦ);
			Продолжить;
		КонецЕсли;
		
		Если Не Переоценивать Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦена        = СтрокаЦенныеБумаги.БалансоваяЦена;
			СтрокаЦенныеБумаги.ОценочнаяЦенаПроцент = СтрокаЦенныеБумаги.БалансоваяЦенаПроцент;
			
			СтрокаЦенныеБумаги.ПолеЦены   = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена;
			СтрокаЦенныеБумаги.ОценочнаяСумма = СтрокаЦенныеБумаги.БалансоваяСумма;
			Если СтрокаЦенныеБумаги.Перекурсовать и Объект.ВидУчета <> Перечисления.ВидыУчета.НалоговыйУчет Тогда
				СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСумма,СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ);
			Иначе
				СтрокаЦенныеБумаги.ОценочнаяСуммаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаВВалютеУчета;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПереоцениватьКупон Тогда
			СтрокаЦенныеБумаги.ОценочнаяЦенаКупона  = СтрокаЦенныеБумаги.БалансоваяЦенаКупона;
			Если СтрокаЦенныеБумаги.Перекурсовать Тогда
				Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
					
					УчитыватьПереоценкуОтдельноКупон = Истина;
					
					СуммаПереоценкиКупона 				= СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
					Если СуммаПереоценкиКупона = 0 Тогда
						БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
					Иначе
						БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2);
					КонецЕсли;
					КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
					СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
					Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
						СуммаКурсовойРазницыПереоценкиКупона = 0;
					Иначе
						СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2)
						 - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
					КонецЕсли;
					СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СуммаКурсовойРазницыПереоценкиКупона;
					Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда 
						//купон при покупке погашен, все валим на переоценку купона
						СуммаКурсовойРазницыПереоценкиКупона = СуммаКурсовойРазницыПереоценкиКупона + СуммаКурсовойРазницыКупона;
						СуммаКурсовойРазницыКупона = 0;
					КонецЕсли;
					Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда	
						//Уплаченный НКД в НУ не переоценивается
						СуммаКурсовойРазницыКупона = 0;
					КонецЕсли;	
						
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета  
						+ СуммаКурсовойРазницыПереоценкиКупона;
					
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
					
				Иначе
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
					СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона,СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ);
				КонецЕсли;
			Иначе
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупона = СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
			КонецЕсли;
		Иначе
			Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
				
				УчитыватьПереоценкуОтдельноКупон = Истина;
				
				СуммаПереоценкиКупона 				= СтрокаЦенныеБумаги.ОценочнаяСуммаКупона - СтрокаЦенныеБумаги.БалансоваяСуммаКупона;
				Если СуммаПереоценкиКупона = 0 Тогда
					БалансоваяСуммаКупонаПоТекущемуКурсу =  СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета;
				Иначе
					БалансоваяСуммаКупонаПоТекущемуКурсу = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.БалансоваяСуммаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2);
				КонецЕсли;
				КурсоваяРазницаКупона = БалансоваяСуммаКупонаПоТекущемуКурсу - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета;
				СуммаПереоценкиКупонаВВалютеУчета 	= СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета - СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета - КурсоваяРазницаКупона;
				Если НЕ УчитыватьПереоценкуОтдельноКупон Тогда
					СуммаКурсовойРазницыПереоценкиКупона = 0;
				Иначе
					СуммаКурсовойРазницыПереоценкиКупона = Окр(РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ПереоценкаКупона, СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, Объект.Организация, Объект.Дата, Отказ), 2)
					 - СтрокаЦенныеБумаги.ПереоценкаКупонаВВалютеУчета;
				КонецЕсли;
				СуммаКурсовойРазницыКупона = КурсоваяРазницаКупона - СуммаКурсовойРазницыПереоценкиКупона;
				Если СтрокаЦенныеБумаги.БалансоваяСуммаКупона = СтрокаЦенныеБумаги.ПереоценкаКупона Тогда 
					//купон при покупке погашен, все валим на переоценку купона
					СуммаКурсовойРазницыПереоценкиКупона = СуммаКурсовойРазницыПереоценкиКупона + СуммаКурсовойРазницыКупона;
					СуммаКурсовойРазницыКупона = 0;
				КонецЕсли;
				Если Объект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда	
					//Уплаченный НКД в НУ не переоценивается
					СуммаКурсовойРазницыКупона = 0;
				КонецЕсли;	
					
				СтрокаЦенныеБумаги.ОценочнаяСуммаКупонаВВалютеУчета = СтрокаЦенныеБумаги.БалансоваяСуммаКупонаВВалютеУчета + СуммаПереоценкиКупонаВВалютеУчета
					+ СуммаКурсовойРазницыПереоценкиКупона;
					
			КонецЕсли;			
		КонецЕсли;
		
		
	КонецЦикла;
	
	Если СообщенияОбОценочнойСтоимости <> Неопределено Тогда
		Для Каждого Сообщение из СообщенияОбОценочнойСтоимости Цикл
			Если ТипЗнч(Объект) = Тип("Структура") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение.Значение);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение.Значение, Объект.Ссылка);
			КонецЕсли;                                                                    			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТаблицуЦенныхБумагПоДвижениямДокумента(Объект, ПолучатьДанныеТабличнойЧасти = Истина, МенеджерВременныхТаблиц = Неопределено, ВозвращатьДополнительныеПоля = Ложь) Экспорт

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
	
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумаг.Рынок КАК Рынок,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.Партия КАК Партия,
			|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСП) КАК КорректировкаЭСП,
			|	СУММА(БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета) КАК КорректировкаЭСПВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
			|	СУММА(БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета) КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВСтоимости) КАК ПереоценкаВСтоимости,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминала) КАК ИндексацияНоминала,
			|	СУММА(БухПартииЦенныхБумаг.ИндексацияНоминалаЗаВремяВладения) КАК ИндексацияНоминалаЗаВремяВладения,
			|	СУММА(БухПартииЦенныхБумаг.Стоимость) КАК Стоимость,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупона) КАК ПереоценкаКупона,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВСтоимости) КАК ПереоценкаКупонаВСтоимости,
			|	СУММА(БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета) КАК ПереоценкаКупонаВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
			|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленный) КАК ДисконтПремияНачисленный,
			|	СУММА(БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета) КАК ДисконтПремияНачисленныйВВалютеУчета
			|ПОМЕСТИТЬ _Движения
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|ГДЕ
			|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
			|
			|СГРУППИРОВАТЬ ПО
			|	БухПартииЦенныхБумаг.Рынок,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
			|	БухПартииЦенныхБумаг.Партия,
			|	БухПартииЦенныхБумаг.СтрокаПартии
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Рынок,
			|	ЦеннаяБумага,
			|	Партия,
			|	СтрокаПартии
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
			|	СтоимостьПереоценки.Источник КАК Источник,
			|	СтоимостьПереоценки.Сумма КАК Сумма,
			|	СтоимостьПереоценки.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
			|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки
			|ПОМЕСТИТЬ _СтоимостьПереоценки
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|ГДЕ
			|	СтоимостьПереоценки.Регистратор = &Регистратор
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СтоимостьПереоценки.Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия,
			|	СтоимостьПереоценки.СтрокаПартии" + "
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|";
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	Иначе
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ТекстЗапроса = "";
		
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Партия КАК Партия,
		|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
		|	СтоимостьПереоценки.КурсВалютыНоминала КАК КурсВалютыНоминала,
		|	СтоимостьПереоценки.Цена КАК Цена,
		|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
		|	СтоимостьПереоценки.Источник КАК Источник,
		|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
		|	СтоимостьПереоценки.ДатаЦеныКупона КАК ДатаЦеныКупона
		|ПОМЕСТИТЬ _СтоимостьОценки
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Период = &Период
		|	И СтоимостьПереоценки.Активность
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.ВидУчета = &ВидУчета
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.Организация КАК Организация,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ВидУчета КАК ВидУчета,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия.Дата КАК ДатаПартии,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупкиОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток КАК СтоимостьПокупкиКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток КАК РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеСНачалаГодаОстаток КАК РасходыПриПокупкеСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчетаОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаОстаток,
