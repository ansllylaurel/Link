		|	БухПартииЦенныхБумагОстатки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток
		|ПОМЕСТИТЬ _ТЧПереоценки
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ОкончаниеПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|			И _ЦенныеБумаги.Партия = БухПартииЦенныхБумагОстатки.Партия
		|			И _ЦенныеБумаги.СтрокаПартии = БухПартииЦенныхБумагОстатки.СтрокаПартии
		|			И _ЦенныеБумаги.УчетныйАктивЕПС = БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС";
	
	#КонецОбласти 
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ОкончаниеПериода = ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени());
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПереоценкаЦенныхБумаг") Тогда
		ОкончаниеПериода = ?(Объект.ЭтоНовый(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОкончаниеПериода", 				Новый Граница(ОкончаниеПериода, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", 					Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", 						Объект.ВидУчета);
	Запрос.УстановитьПараметр("ЦенныеБумаги", 					Объект.ЦенныеБумаги.Выгрузить());
	
	Запрос.Выполнить();
	
	Возврат ПолучитьТаблицуЦенныхБумагСДополнительнымиПолями(Запрос.МенеджерВременныхТаблиц, Объект);
	
