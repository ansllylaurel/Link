	|	_ТЧПереоценки.РучнаяКорректировка КАК РучнаяКорректировка,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|				КОГДА ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки ЕСТЬ NULL
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО)
	|			КОНЕЦ
	|			ТОГДА _ТЧПереоценки.БалансоваяСумма + _ТЧПереоценки.БалансовыеДисконтПремия + _ТЧПереоценки.БалансоваяКорректировкаЭСП + _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокОстаток + ВЫБОР
	|					КОГДА ВЫБОР
	|								КОГДА ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки ЕСТЬ NULL
	|									ТОГДА ИСТИНА
	|								ИНАЧЕ ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО)
	|							КОНЕЦ
	|							И _ТЧПереоценки.ПолеЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.БалансоваяЦена)
	|						ТОГДА _ТЧПереоценки.БалансоваяРазницаППНеНаблюдаемыеДанные
	|					ИНАЧЕ 0
	|				КОНЕЦ + ВЫБОР
	|					КОГДА _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокОстаток <> 0
	|							ИЛИ _ТЧПереоценки.ПолеЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_Финстоун
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_АрчерФинанс
	|						ТОГДА _ТЧПереоценки.БалансоваяСуммаКупона
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ _ТЧПереоценки.БалансоваяСумма
	|	КОНЕЦ КАК БалансоваяСуммаОтображаемая,
	|	ВЫБОР
	|		КОГДА &НастройкаВключать
	|			ТОГДА _ТЧПереоценки.БалансоваяСуммаВВалютеУчета + _ТЧПереоценки.БалансовыеДисконтПремияВВалютеУчета + _ТЧПереоценки.БалансоваяКорректировкаЭСПВВалютеУчета + _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток + ВЫБОР
	|					КОГДА ВЫБОР
	|								КОГДА ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки ЕСТЬ NULL
	|									ТОГДА ИСТИНА
	|								ИНАЧЕ ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО)
	|							КОНЕЦ
	|							И _ТЧПереоценки.ПолеЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.БалансоваяЦена)
	|						ТОГДА _ТЧПереоценки.БалансоваяРазницаППНеНаблюдаемыеДанныеВВалютеУчета
	|					ИНАЧЕ 0
	|				КОНЕЦ + ВЫБОР
	|					КОГДА _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток <> 0
	|							ИЛИ _ТЧПереоценки.ПолеЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_Финстоун
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_АрчерФинанс
	|						ТОГДА _ТЧПереоценки.БалансоваяСуммаКупонаВВалютеУчета
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ _ТЧПереоценки.БалансоваяСуммаВВалютеУчета
	|	КОНЕЦ КАК БалансоваяСуммаВВалютеУчетаОтображаемая,
	|	ВЫБОР
	|		КОГДА &НастройкаВключать
	|			ТОГДА _ТЧПереоценки.ОценочнаяСумма - _ТЧПереоценки.БалансоваяСумма - _ТЧПереоценки.ОценочныеДисконтПремия - _ТЧПереоценки.ОценочнаяКорректировкаЭСП - _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокОстаток - ВЫБОР
	|					КОГДА ВЫБОР
	|								КОГДА ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки ЕСТЬ NULL
	|									ТОГДА ИСТИНА
	|								ИНАЧЕ ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО)
	|							КОНЕЦ
	|							И _ТЧПереоценки.ПолеЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.БалансоваяЦена)
	|						ТОГДА _ТЧПереоценки.ОценочнаяРазницаППНеНаблюдаемыеДанные
	|					ИНАЧЕ 0
	|				КОНЕЦ - ВЫБОР
	|					КОГДА _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокОстаток <> 0
	|							ИЛИ _ТЧПереоценки.ПолеЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_Финстоун
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_АрчерФинанс
	|						ТОГДА _ТЧПереоценки.ОценочнаяСуммаКупона
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ _ТЧПереоценки.ОценочнаяСумма - _ТЧПереоценки.БалансоваяСумма
	|	КОНЕЦ КАК ПереоценкаОтображаемая,
	|	ВЫБОР
	|		КОГДА &НастройкаВключать
	|			ТОГДА _ТЧПереоценки.ОценочнаяСуммаВВалютеУчета - _ТЧПереоценки.БалансоваяСуммаВВалютеУчета - _ТЧПереоценки.ОценочныеДисконтПремияВВалютеУчета - _ТЧПереоценки.ОценочнаяКорректировкаЭСПВВалютеУчета - _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток - ВЫБОР
	|					КОГДА ВЫБОР
	|								КОГДА ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки ЕСТЬ NULL
	|									ТОГДА ИСТИНА
	|								ИНАЧЕ ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО)
	|							КОНЕЦ
	|							И _ТЧПереоценки.ПолеЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.БалансоваяЦена)
	|						ТОГДА _ТЧПереоценки.ОценочнаяРазницаППНеНаблюдаемыеДанныеВВалютеУчета
	|					ИНАЧЕ 0
	|				КОНЕЦ - ВЫБОР
	|					КОГДА _ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток <> 0
	|							ИЛИ _ТЧПереоценки.ПолеЦены = ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Дефолт)
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_Финстоун
	|							ИЛИ _ТЧПереоценки.ЦеннаяБумага = &Облигация_АрчерФинанс
	|						ТОГДА _ТЧПереоценки.ОценочнаяСуммаКупонаВВалютеУчета
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ _ТЧПереоценки.ОценочнаяСуммаВВалютеУчета - _ТЧПереоценки.БалансоваяСуммаВВалютеУчета
	|	КОНЕЦ КАК ПереоценкаВВалютеУчетаОтображаемая,
	|	_ТЧПереоценки.ОценочнаяСуммаКупона - _ТЧПереоценки.БалансоваяСуммаКупона КАК ПереоценкаКупонаОтображаемая,
	|	_ТЧПереоценки.ОценочнаяСуммаКупонаВВалютеУчета - _ТЧПереоценки.БалансоваяСуммаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчетаОтображаемая,
	|	_ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокОстаток КАК ПогашениеКупонаНеИсполненноеВСрокОстаток,
	|	_ТЧПереоценки.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчетаОстаток
	|ИЗ
	|	_ТЧПереоценки КАК _ТЧПереоценки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И ЗначениеНастройки = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПравильныйУчетПервоначальногоПризнания)) КАК ЗначенияНастроекУчетаЦенныхБумагСрезПоследних
	|		ПО _ТЧПереоценки.ЦеннаяБумага = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЦеннаяБумага
	|			И _ТЧПереоценки.Рынок = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Рынок
	|			И _ТЧПереоценки.Партия = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Партия
	|			И _ТЧПереоценки.СтрокаПартии = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.СтрокаПартии
	|			И _ТЧПереоценки.УчетныйАктивЕПС = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.УчетныйАктивЕПС
	|
	|УПОРЯДОЧИТЬ ПО
	|	Рынок,
	|	ЦеннаяБумага,
	|	Партия,
	|	СтрокаПартии";
	
	
	НастройкаВключать = БухгалтерскийУчет.ОпределитьНастройкуУчета(
								Объект.Дата,
								Объект.Организация,
								Объект.СчетДоверительногоУправления,
								"ВключатьПроцентныеДоходыИКорректировкиВБалансовуюСтоимостьПриПереоценке");
	Запрос.УстановитьПараметр("НастройкаВключать", НастройкаВключать И (Объект.ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет));
	
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ОкончаниеПериода = ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.ПереоценкаЦенныхБумаг") Тогда
		ОкончаниеПериода = ?(Объект.ЭтоНовый(), КонецДня(Объект.Дата), Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", ОкончаниеПериода);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	МассивСчетовЭволюции = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Эволюция"),
																				ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"),
																				Объект.Дата);
	ЭтоКлиентЭволюция = (МассивСчетовЭволюции.Найти(Объект.СчетДоверительногоУправления) <> Неопределено);
	
	Если Объект.Дата >= '20201231' Тогда
		Запрос.УстановитьПараметр("Облигация_АрчерФинанс", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_АрчерФинанс"));
	Иначе		
		Запрос.УстановитьПараметр("Облигация_АрчерФинанс", Неопределено);
	КонецЕсли;
	
	Если Объект.Дата >= '20201231' И ЭтоКлиентЭволюция Тогда
		Запрос.УстановитьПараметр("Облигация_Финстоун", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Финстоун"));
	Иначе		
		Запрос.УстановитьПараметр("Облигация_Финстоун", Неопределено);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();

