	
Процедура УстановитьБлокировки()

	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	Если      ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиДенежныхСредств");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("РасчетныйСчет",                	ЭтотОбъект.РасчетныйСчет);
		
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ДенежныеСредстваНаличные");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  	ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("Касса",                         ЭтотОбъект.Касса);
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Основание) И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
		И Не ЭтотОбъект.Основание.ВыводВсехАктивов Тогда
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям");
		
		ЭлементБлокировкиДанных.УстановитьЗначение("Организация",                  ЭтотОбъект.Организация);
		ЭлементБлокировкиДанных.УстановитьЗначение("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ЭлементБлокировкиДанных.УстановитьЗначение("ТипЗадолженности",             Перечисления.ТипыЗадолженности.Кредиторская);
		ЭлементБлокировкиДанных.УстановитьЗначение("Основание",                    ЭтотОбъект.Основание);
	КонецЕсли;	

	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры // УстановитьБлокировки

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиДенежныхСредств.Записывать                       = Истина;
	Движения.ДенежныеСредстваНаличные.Записывать                     = Истина;
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать             = Истина;
	Движения.ЗадолженностиПоДенежнымСредствамПоПоручениям.Записывать = Истина;
	Движения.ВводыВыводыАктивовВВалютеУчета.Записывать               = Истина;
	Движения.ДенежныеСредстваПереданныеВОплатуПаев.Записывать        = Истина;
	
	Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		ВалютаДенежныхСредств = ЭтотОбъект.РасчетныйСчет.Валюта;
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		ВалютаДенежныхСредств = ЭтотОбъект.Касса.ВалютаДенежныхСредств;
	КонецЕсли;
	
	Если ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ Тогда
		
		// Реестр денежных средств переданных в оплату паев
		Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратОшибочноЗачисленных Тогда
			
			Движение = Движения.ДенежныеСредстваПереданныеВОплатуПаев.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Пайщик                       = Неопределено;
			Движение.РасчетныйСчет                = ЭтотОбъект.РасчетныйСчет;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			
		КонецЕсли;
		
	Иначе
		
		// остатки д/с
		Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
			
			Движение = Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
			
			Движение.Период                         = ЭтотОбъект.Дата;
			Движение.Организация                    = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.МестоХранения                  = Справочники.МестаХранения.ВнебиржевойРынок;
			Движение.РасчетныйСчет                  = ЭтотОбъект.РасчетныйСчет;
			Движение.Валюта                         = ВалютаДенежныхСредств;
			Движение.Сумма                          = ЭтотОбъект.Сумма - ЭтотОбъект.СуммаНДФЛ;
			Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств;
			Движение.ВариантДвиженияДенежныхСредств = ЭтотОбъект.ВидОперации;
			
			Если ЭтотОбъект.СуммаНДФЛ <> 0 Тогда
				
				Движение = Движения.ОстаткиДенежныхСредств.ДобавитьРасход();
				
				Движение.Период                         = ЭтотОбъект.Дата;
				Движение.Организация                    = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления   = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.МестоХранения                  = Справочники.МестаХранения.ВнебиржевойРынок;
				Движение.РасчетныйСчет                  = ЭтотОбъект.РасчетныйСчет;
				Движение.Валюта                         = ВалютаДенежныхСредств;
				Движение.Сумма                          = ЭтотОбъект.СуммаНДФЛ;
				Движение.ВидДвиженияДенежныхСредств     = Перечисления.ВидыДвиженийДенежныхСредств.Оплата;
				Движение.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНДФЛ13;
				
			КонецЕсли;
			
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			
			Движение = Движения.ДенежныеСредстваНаличные.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Касса                        = ЭтотОбъект.Касса;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
			
		КонецЕсли;
		
		// задолженность по поручение
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание)
			И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
			И НЕ ЭтотОбъект.Основание.ВыводВсехАктивов Тогда
			Движение = Движения.ЗадолженностиПоДенежнымСредствамПоПоручениям.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Валюта                       = ВалютаДенежныхСредств;
			Движение.Основание                    = ЭтотОбъект.Основание;
			Движение.Сумма                        = ЭтотОбъект.Сумма;
		КонецЕсли;
		
		// Задолженность перед пайщиком
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание)
			и (ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика")
			   или ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПогашениеПаев")) Тогда
			
			Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
			
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Основание                    = ЭтотОбъект.Основание;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
			Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПередПайщиками;
			Движение.Контрагент                   = ЭтотОбъект.Основание.Пайщик;
			Движение.Валюта                       = ВалютаДенежныхСредств;
			Движение.Сумма                        = ЭтотОбъект.Сумма - ЭтотОбъект.СуммаНДФЛ;
			Движение.Аванс                        = Ложь;
			
			Если ЭтотОбъект.СуммаНДФЛ <> 0 Тогда
				
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Основание                    = ЭтотОбъект.Основание;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
				Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПередПайщиками;
				Движение.Контрагент                   = ЭтотОбъект.Основание.Пайщик;
				Движение.Валюта                       = ВалютаДенежныхСредств;
				Движение.Сумма                        = ЭтотОбъект.СуммаНДФЛ;
				Движение.Аванс                        = Ложь;
				
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Основание                    = ЭтотОбъект.Основание;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
				Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоНДФЛ13;
				Движение.Контрагент                   = ЭтотОбъект.Контрагент;
				Движение.Валюта                       = ВалютаДенежныхСредств;
				Движение.Сумма                        = ЭтотОбъект.СуммаНДФЛ;
				Движение.Аванс                        = Ложь;
				
				Движение = Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьРасход();
				
				Движение.Период                       = ЭтотОбъект.Дата;
				Движение.Основание                    = ЭтотОбъект.Основание;
				Движение.Организация                  = ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Кредиторская;
				Движение.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоНДФЛ13;
				Движение.Контрагент                   = ЭтотОбъект.Контрагент;
				Движение.Валюта                       = ВалютаДенежныхСредств;
				Движение.Сумма                        = ЭтотОбъект.СуммаНДФЛ;
				Движение.Аванс                        = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
	// вводы/выводы активов
	СуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуДокументаВВалютеУчета(
		ЭтотОбъект.Сумма, ВалютаДенежныхСредств, ЭтотОбъект, Отказ);
	
	Движение = Движения.ВводыВыводыАктивовВВалютеУчета.Добавить();
	
	Движение.НаправлениеДвижения		  = Перечисления.ВидыДвижений.Расход;
	Движение.ВидОперацииВводаВыводаДС	  = ЭтотОбъект.ВидОперации;
	Движение.Период						  = ЭтотОбъект.Дата;
	Движение.Организация				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.ВидАктива					  = Перечисления.ВидыАктивов.ДенежныеСредства;
	Движение.РыночнаяСтоимость			  = СуммаВВалютеУчета - ЭтотОбъект.СуммаНДФЛ;
	Движение.БалансоваяСтоимость		  = СуммаВВалютеУчета - ЭтотОбъект.СуммаНДФЛ;
		
	// реестр платежей
	СтрокиБанковскойВыписки = Новый Массив();
	СтрокиБанковскойВыписки.Добавить(РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(
		ЭтотОбъект.СтрокаБанковскойВыписки, Перечисления.ВидыДвижений.Расход, ЭтотОбъект.Сумма - ЭтотОбъект.СуммаНДФЛ, Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств));
	СтрокиБанковскойВыписки.Добавить(РегистрыСведений.РеестрПлатежей.СкомпоноватьСведенияОСтрокеБанковскойВыписки(
		ЭтотОбъект.СтрокаБанковскойВыпискиНДФЛ, Перечисления.ВидыДвижений.Расход, ЭтотОбъект.СуммаНДФЛ, Перечисления.ВидыДвиженийДенежныхСредств.Оплата));
		
	Движения.Записать();
	
	РегистрыСведений.РеестрПлатежей.ЗарегистрироватьПлатеж(ЭтотОбъект, СтрокиБанковскойВыписки);
		
	// проверим отрицательные остатки
	Если ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредствПереданныхВОплатуПаев(ЭтотОбъект, Отказ);	
	Иначе
		Если      ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиДенежныхСредств(ЭтотОбъект, Отказ);
		ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиНаличныхДенежныхСредств(ЭтотОбъект, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Основание)
		И (ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг")
			ИЛИ ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
			И ЭтотОбъект.Основание.ВыводВсехАктивов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Основание) Тогда
		Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствамПоПоручениям(ЭтотОбъект, Отказ);
		Иначе
			РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоДенежнымСведствам(ЭтотОбъект, Отказ);
		КонецЕсли;
	КонецЕсли;	

КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт

	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, ЭтотОбъект.РасчетныйСчет.Валюта, ЭтотОбъект.Организация, ЭтотОбъект.Дата);
	
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаОперации, "Вывод денежных средств");
	
	Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы Тогда 
		Проводка.СчетДт 				= ПланыСчетов.Единый.Расчеты23;
		Проводка.СубконтоДт.Контрагенты = Контрагент;
	ИначеЕсли ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратОшибочноЗачисленных Тогда 
		Проводка.СчетДт 						= ПланыСчетов.Единый.Расчеты16;
		Проводка.СубконтоДт.Контрагенты 		= Контрагент;
		Проводка.СубконтоДт.ОснованиеРасчетов 	= ДокументЗачисления;
		//дописать основание расчетов
	Иначе	
		Проводка.СчетДт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоДт.Договоры = СчетДоверительногоУправления;
	КонецЕсли;
	
	Если Проводка.СчетДт.Валютный Тогда
		Проводка.ВалютаДт  = ЭтотОбъект.РасчетныйСчет.Валюта;
		Проводка.ВалютнаяСуммаДт = ЭтотОбъект.Сумма;
	КонецЕсли;
	
	Если Справочники.Банки.ЯвляетсяРезидентом(ЭтотОбъект.РасчетныйСчет.Банк,Дата) Тогда
		Проводка.СчетКт = ПланыСчетов.Единый.РасчетныеСчета01;
	Иначе
		Проводка.СчетКт = ПланыСчетов.Единый.РасчетныеСчета02;
	КонецЕсли;
	Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
	Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы Тогда
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;
	ИначеЕсли ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению Тогда
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ВыводДенежныхСредствИзДУ;
	Иначе
		Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ВыводДенежныхСредств;
	КонецЕсли;
	Проводка.ВалютаКт  = ЭтотОбъект.РасчетныйСчет.Валюта;
	Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Сумма;
	
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);

	//по НДФЛ не делаем проводку т.к. ну какой НДФЛ у НПФов???
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт
	
	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратОшибочноЗачисленных
		 	и ЭтотОбъект.РасчетныйСчет.ТранзитныйПИФ Тогда
		// Не ведется бухгалтерский учет	 
		Возврат;
	КонецЕсли;
	
	ВалютаВывода = ?(ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная, ЭтотОбъект.РасчетныйСчет.Валюта, ЭтотОбъект.Касса.ВалютаДенежныхСредств);
	Если ЭтотОбъект.СуммаНДФЛ <> 0 И ВалютаВывода <> ЭтотОбъект.Организация.ВалютаУчета Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не реализовано удержание НДФЛ при выводе валюты!", ЭтотОбъект.Ссылка,,,Отказ);
	КонецЕсли;
		
	Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПогашениеПаев") И Субконто1 <> ЭтотОбъект.Основание.Пайщик Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Субконто1(Контрагенты) не равно пайщику в документе-основание.", ЭтотОбъект.Ссылка,,,Отказ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.КоррСчет) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен корр счет!", ЭтотОбъект.Ссылка,,,Отказ);
		Возврат;
	КонецЕсли;
	
	УчетныйРегистр = Движения[УчетныйРегистр].Метаданные().Имя;
	
	// Переделал по указанию Тани, хотя кажется она же и просила так сделать
	//Если УчетныйРегистр = "НалоговыйУчет" Тогда
	//	СчетВывода = ПланыСчетов.Основной.РасчетыПоДоговоруДоверительногоУправленияИмуществом;
	//Иначе
		СчетВывода = ЭтотОбъект.КоррСчет;
	//КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	// ПРОВОДКА ПО ОСНОВНОЙ СУММЕ
	СуммаВыводаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ЭтотОбъект.Сумма, ВалютаВывода, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ);
	Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаВыводаВВалютеУчета - ЭтотОбъект.СуммаНДФЛ, "Вывод денежных средств");
	
	// Дебет
	Проводка.СчетДт = СчетВывода;
	
	Для НомСубк = 1 По Проводка.СчетДт.ВидыСубконто.Количество() Цикл
		Проводка.СубконтоДт[СчетВывода.ВидыСубконто[НомСубк - 1].ВидСубконто] = ЭтотОбъект["Субконто" + НомСубк];
	КонецЦикла;
	
	// Кредит
	Если ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		СчетУчетаДС = БухгалтерскийУчет.ОпределитьСчетУчетаДенежныхСредств(
			ЭтотОбъект.Дата, 
			ЭтотОбъект.Организация, 
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.РасчетныйСчет.Валюта,
			Справочники.БрокерскиеКомпании.ПустаяСсылка());
			
		Проводка.СчетКт = СчетУчетаДС;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.БанковскиеСчета)  <> Неопределено Тогда 
			Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		КонецЕсли;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда	
			Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;
			ИначеЕсли ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению Тогда
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ВыводДенежныхСредствИзДУ;
			Иначе
				ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ВыводДенежныхСредств;
			КонецЕсли;
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = ВидДвиженияДенежныхСредств;
		КонецЕсли;
		
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		СчетУчетаДС = ПланыСчетов.Основной.КассаОрганизации;
		
		Проводка.СчетКт = СчетУчетаДС;
		
	КонецЕсли;
	
	Если СчетУчетаДС.Валютный Тогда
		Проводка.ВалютнаяСуммаКт = ЭтотОбъект.Сумма;
		Проводка.ВалютаКт = ВалютаВывода;
	КонецЕсли;
	
	///////////////////////////////////////////////////////////////////////////////
	// ПРОВОДКА ПО ОТРАЖЕНИЮ КРЕДИТОРСКОЙ ЗАДОЛЖЕННОСТИ: РАСЧЕТЫ С АГЕНТАМИ 
	
	Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") И ЭтотОбъект.Основание.ВыводВсехАктивов Тогда

		Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
			
			СчетРасчетовСАгентом = ЭтотОбъект.КоррСчет;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма, "Требование на вывод ДС");
			Проводка.СчетДт = ПланыСчетов.Основной.ЦелевоеФинансированиеПФРВозврат;
			Проводка.СчетКт = СчетРасчетовСАгентом;	
			
			Если СчетРасчетовСАгентом.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено Тогда
				Проводка.СубконтоКт.Контрагенты = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ЭтотОбъект.Дата);	
			КонецЕсли; 
	
		КонецЕсли;
	
	КонецЕсли;
		
	///////////////////////////////////////////////////////////////////////////////
	// ПРОВОДКА ПО НДФЛ
	Если ЭтотОбъект.СуммаНДФЛ <> 0 Тогда
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаНДФЛ, "Удержание НДФЛ");
		
		// Дебет
		Проводка.СчетДт = СчетВывода;
		
		Для НомСубк = 1 По Проводка.СчетДт.ВидыСубконто.Количество() Цикл
			Проводка.СубконтоДт[СчетВывода.ВидыСубконто[НомСубк - 1].ВидСубконто] = ЭтотОбъект["Субконто" + НомСубк];
		КонецЦикла;
		
		// Кредит
		Проводка.СчетКт =  ПланыСчетов.Основной.НДФЛ;
		Проводка.СубконтоКт.ВидыПлатежейВБюджет = Перечисления.ВидыПлатежейВБюджет.НалогВзносыНачисленоУплачено;
				
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаНДФЛ, "Оплата НДФЛ");
		
		// Дебет
		Проводка.СчетДт = ПланыСчетов.Основной.НДФЛ;
		Проводка.СубконтоДт.ВидыПлатежейВБюджет = Перечисления.ВидыПлатежейВБюджет.НалогВзносыНачисленоУплачено;
				
		// Кредит
		Проводка.СчетКт = СчетУчетаДС;
		Проводка.СубконтоКт.БанковскиеСчета = ЭтотОбъект.РасчетныйСчет;
		
		Если Проводка.СчетКт.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.ВидДвиженияДенежныхСредств) <> Неопределено Тогда	
			Проводка.СубконтоКт.ВидДвиженияДенежныхСредств = Справочники.ВидыДвиженияДенежныхСредств.ПрочиеВыплаты;
		КонецЕсли;
		
	КонецЕсли;
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(Дата, Организация, СчетДоверительногоУправления);
	БухгалтерскийУчет.ПереоценитьВалютныеАктивы(ЭтотОбъект,УчетныйРегистр, Перечисления.ВидыУчета[УчетныйРегистр], НастройкиУчетаОбщие, Отказ);
	
	Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику
		И НастройкиУчетаОбщие.ВестиУчетИмуществаПайщиков Тогда
		
		ЗаявкаПайщика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Основание, "Заявка");
		
		Если ЭтотОбъект.СуммаНДФЛ <> 0 Тогда
		
			ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаНДФЛ, "Начислен НДФЛ к уплате");
			
			ПроводкаПайщика.СчетДт = Планысчетов.Основной.ПрибылиИУбыткиПайщика;
			
			ПроводкаПайщика.СчетКт = Планысчетов.Основной.НДФЛНачислен;
			ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Контрагент;
			ПроводкаПайщика.СубконтоКт.СтавкиНДФЛ = Перечисления.СтавкиНДФЛ.Ставка15;
			

			ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.СуммаНДФЛ, "Уплата НДФЛ");
			
			ПроводкаПайщика.СчетДт = Планысчетов.Основной.НДФЛНачислен;
			ПроводкаПайщика.СубконтоДт.Пайщики = ЭтотОбъект.Контрагент;
			ПроводкаПайщика.СубконтоДт.СтавкиНДФЛ = Перечисления.СтавкиНДФЛ.Ставка15;

			ПроводкаПайщика.СчетКт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
			ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Контрагент;
			ПроводкаПайщика.СубконтоКт.ЗаявкиПайщиков = ЗаявкаПайщика;
		
		КонецЕсли;
		
		
		ПроводкаПайщика = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ЭтотОбъект.Сумма - ЭтотОбъект.СуммаНДФЛ, "Вывод денежных средств");
		
		ПроводкаПайщика.СчетДт = ПланыСчетов.Основной.СредстваКлиента;
		
		ПроводкаПайщика.СчетКт = ПланыСчетов.Основной.РасчетыКлиентаСПИФ;
		ПроводкаПайщика.СубконтоКт.Пайщики = ЭтотОбъект.Контрагент;
		ПроводкаПайщика.СубконтоКт.ЗаявкиПайщиков = ЗаявкаПайщика;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") Тогда // ввод на основании
		
		Если ДанныеЗаполнения.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
			ЭтотОбъект.Основание = ДанныеЗаполнения;
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
				
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Поручение", ДанныеЗаполнения);
		
		Если ДанныеЗаполнения.ВыводВсехАктивов Тогда
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ПоручениеНаДвижениеДенежныхСредств.Организация КАК Организация,
				|	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	ПоручениеНаДвижениеДенежныхСредств.Ссылка КАК Основание,
				|	ПоручениеНаДвижениеДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет,
				|	ПоручениеНаДвижениеДенежныхСредств.РасчетныйСчетПолучатель КАК РасчетныйСчетКонтрагента,
				|	ПоручениеНаДвижениеДенежныхСредств.ВидОперации КАК ВидОперации,
				|	ПоручениеНаДвижениеДенежныхСредств.КонтрагентДоговорТекстом КАК КонтрагентДоговорТекстом,
				|	ПоручениеНаДвижениеДенежныхСредств.Контрагент КАК Контрагент
				|ИЗ
				|	Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
				|ГДЕ
				|	ПоручениеНаДвижениеДенежныхСредств.Ссылка = &Поручение";
		Иначе
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДанныеЗаполнения.СчетДоверительногоУправления);
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Организация КАК Организация,
				|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	Поручение.Ссылка КАК Основание,
				|	Поручение.РасчетныйСчет КАК РасчетныйСчет,
				|	Поручение.РасчетныйСчетПолучатель КАК РасчетныйСчетКонтрагента,
				|	Поручение.Контрагент КАК Контрагент,
				|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СуммаОстаток КАК Сумма,
				|	Поручение.ВидОперации КАК ВидОперации,
				|	Поручение.КонтрагентДоговорТекстом КАК КонтрагентДоговорТекстом
				|ИЗ
				|	РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(
				|			,
				|			Основание = &Поручение
				|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК Поручение
				|		ПО ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание = Поручение.Ссылка";
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() = 0 И Не ДанныеЗаполнения.ВыводВсехАктивов Тогда
			ЭтотОбъект.Основание = ДанныеЗаполнения;
		Иначе
		
			Пока Выборка.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
			КонецЦикла;
			
		КонецЕсли;
		
		// Установим вид операции по умолчанию
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
			ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению;	
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг") Тогда
		
		Если НЕ ДанныеЗаполнения.ВыводВсехАктивов Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание документа 'Вывод денежных средств' на основании документа 'Поручение на движение ценных бумаг' возможен только при установке флага 'Вывод всех активов'!");
			ЭтотОбъект.Основание = ДанныеЗаполнения;
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Поручение", ДанныеЗаполнения);
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПоручениеНаДвижениеЦенныхБумаг.Организация КАК Организация,
			|	ПоручениеНаДвижениеЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ПоручениеНаДвижениеЦенныхБумаг.Ссылка КАК Основание
			|ИЗ
			|	Документ.ПоручениеНаДвижениеЦенныхБумаг КАК ПоручениеНаДвижениеЦенныхБумаг
			|ГДЕ
			|	ПоручениеНаДвижениеЦенныхБумаг.Ссылка = &Поручение";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
		
		ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
			|	ЗаявкаПайщика.РасчетныйСчет КАК РасчетныйСчетКонтрагента,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма
			|ПОМЕСТИТЬ _Задолженность
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			,
			|			Основание = &Основание
			|				И НЕ Аванс) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
			|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = ЗаявкаПайщика.Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ИсполнителиПоДенежнымСредствамСобственные.Организация КАК Организация,
			|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
			|ПОМЕСТИТЬ _РасчетныйСчет
			|ИЗ
			|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
			|ГДЕ
			|	(ИсполнителиПоДенежнымСредствамСобственные.Организация, ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления) В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Задолженность.Организация КАК Организация,
			|				_Задолженность.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|			ИЗ
			|				_Задолженность КАК _Задолженность)
			|	И НЕ ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Транзитный
			|	И НЕ ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.ТранзитныйПИФ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Задолженность.Организация КАК Организация,
			|	_Задолженность.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Задолженность.Основание КАК Основание,
			|	_Задолженность.Контрагент КАК Контрагент,
			|	_Задолженность.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
			|	_Задолженность.Сумма КАК Сумма,
			|	_РасчетныйСчет.РасчетныйСчет КАК РасчетныйСчет
			|ИЗ
			|	_Задолженность КАК _Задолженность
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РасчетныйСчет КАК _РасчетныйСчет
			|		ПО _Задолженность.Организация = _РасчетныйСчет.Организация
			|			И _Задолженность.СчетДоверительногоУправления = _РасчетныйСчет.СчетДоверительногоУправления";
			
		Запрос.УстановитьПараметр("Основание", ДанныеЗаполнения);
			
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет задолженности перед пайщиком для вывода д/с по " + ДанныеЗаполнения);
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПогашениеПаев") Тогда
		
		Если ДанныеЗаполнения.ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПоЗаявке Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для ""Погашения паев"" по заявке создание ""Вывода денежных средств"" не предусмотрено. Создайте документ на основании заявки пайщика.");
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
				
		Запрос = Новый Запрос();
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
			|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
			|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК Сумма
			|ПОМЕСТИТЬ _Задолженность
			|ИЗ
			|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|			,
			|			Основание = &Основание
			|				И НЕ Аванс) КАК ЗадолженностиПоДенежнымСредствамОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ИсполнителиПоДенежнымСредствамСобственные.Организация КАК Организация,
			|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
			|ПОМЕСТИТЬ _РасчетныйСчет
			|ИЗ
			|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
			|ГДЕ
			|	(ИсполнителиПоДенежнымСредствамСобственные.Организация, ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления) В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Задолженность.Организация КАК Организация,
			|				_Задолженность.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|			ИЗ
			|				_Задолженность КАК _Задолженность)
			|	И НЕ ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Транзитный
			|	И НЕ ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.ТранзитныйПИФ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Задолженность.Организация КАК Организация,
			|	_Задолженность.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_Задолженность.Основание КАК Основание,
			|	_Задолженность.Контрагент КАК Контрагент,
			|	_Задолженность.Сумма КАК Сумма,
			|	_РасчетныйСчет.РасчетныйСчет КАК РасчетныйСчет,
			|	ВЫБОР
			|		КОГДА ВЫРАЗИТЬ(_Задолженность.Основание КАК Документ.ПогашениеПаев).ВариантПогашенияПаев = ЗНАЧЕНИЕ(Перечисление.ВариантыПогашенияПаев.ПриЗакрытииПИФ)
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПриЗакрытииПИФ)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику)
			|	КОНЕЦ КАК ВидОперации
			|ИЗ
			|	_Задолженность КАК _Задолженность
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РасчетныйСчет КАК _РасчетныйСчет
			|		ПО _Задолженность.Организация = _РасчетныйСчет.Организация
			|			И _Задолженность.СчетДоверительногоУправления = _РасчетныйСчет.СчетДоверительногоУправления";
		
		Запрос.УстановитьПараметр("Основание", ДанныеЗаполнения);
			
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет задолженности перед пайщиком для вывода д/с по " + ДанныеЗаполнения);
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
				
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
		ЭтотОбъект.КоррСчет		= БухгалтерскийУчет.ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидОперации);
		ЭтотОбъект.Субконто1	= РаботаСДокументами.Субконто1ДляВводаВыводаДенежныхСредств(ЭтотОбъект);
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ОбщегоНазначенияКлиентСервер.ОчиститьПоля(ЭтотОбъект, "Основание, СтрокаБанковскойВыписки, СтрокаБанковскойВыпискиНДФЛ");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если      ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная Тогда
		ПроверяемыеРеквизиты.Добавить("РасчетныйСчет");
	ИначеЕсли ЭтотОбъект.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Наличная Тогда
		ПроверяемыеРеквизиты.Добавить("Касса");
	КонецЕсли;
	
	// Проверяем поручение для вывода учредителю управления и для ИИС
	Если (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет
	   			И (ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению
	   	  			Или ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДенежныхСредствСПереводомВсехАктивовНаДругойИИС))
		Или (ЭтотОбъект.Дата >= '20221223' 
				И ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению) Тогда
		ПроверяемыеРеквизиты.Добавить("Основание");
	КонецЕсли;
	
	Если РаботаСДокументамиКлиентСервер.ТребуетсяПроверкаЗаполненияЗначенияКонтрагента(ЭтотОбъект) Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если ЭтотОбъект.СуммаНДФЛ <> 0 И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Реквизиты ""Сумма НДФЛ"" заполняется только для вида договора ""Управление активами паевого инвестиционного фонда""",,,, Отказ);
	КонецЕсли;
	
	Если РаботаСДокументами.ДействуетКонтрольПорученийВнутреннейСистемы(ЭтотОбъект.Дата, ЭтотОбъект.Организация) Тогда
		ПроверяемыеРеквизиты.Добавить("Основание");	
	КонецЕсли;
		
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Функция БылТакойКлиент(СчетДоверительногоУправления, Контрагент)
	// эта хрень была сделана для проведения бух/нал/бэк/епс учета задним числом при условии изменения владельца счета ду
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И КлиентыДоверительногоУправления.Клиент = &Клиент";
	
	Запрос.УстановитьПараметр("Клиент", Контрагент);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции 

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание) И Не РаботаСДокументами.ПройденаОтложеннаяСверкаСоСпискомНедействительныхПаспортовПриВыводеАктивов(ЭтотОбъект) Тогда
			Отказ = Истина;		
		КонецЕсли;
		
		РаботаСБанковскимиВыпискамиКлиентСервер.ПроверитьСоответствиеСтрокиБанковскойВыпискиИПлатежногоДокумента(ЭтотОбъект,
			ЭтотОбъект.СтрокаБанковскойВыписки, Перечисления.ВидыДвижений.Расход, Отказ);
		
		РаботаСБанковскимиВыпискамиКлиентСервер.ПроверитьСоответствиеСтрокиБанковскойВыпискиИПлатежногоДокумента(ЭтотОбъект,
			ЭтотОбъект.СтрокаБанковскойВыпискиНДФЛ, Перечисления.ВидыДвижений.Расход, Отказ);
			
		РаботаСДокументами.ПроверитьРеквизитыВводаВыводаДенежныхСредств(ЭтотОбъект, Отказ);
		
		// владельцем р/счета должно быть юр/физ лицо счета д/у (на портфели временно забиваем)
		Если ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчет) Тогда
			Если ЭтотОбъект.РасчетныйСчет.ЮрФизЛицо <> ЭтотОбъект.Организация.ЮрФизЛицо Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет не принадлежит выбранной организации", ЭтотОбъект, "РасчетныйСчет",, Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Касса) Тогда
			Если ЭтотОбъект.Касса.Организация <> ЭтотОбъект.Организация Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Касса не принадлежит выбранной организации", ЭтотОбъект, "Касса",, Отказ);
			КонецЕсли;
		КонецЕсли; 		
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Основание) Тогда
			
			Если ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг") И Не ЭтотОбъект.Основание.ВыводВсехАктивов Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание документа 'Вывод денежных средств' на основании документа 'Поручение на движение ценных бумаг' возможен только при установке флага 'Вывод всех активов'!", ЭтотОбъект, "Основание",, Отказ);		
			ИначеЕсли ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПогашениеПаев") И ЭтотОбъект.Основание.ВариантПогашенияПаев = Перечисления.ВариантыПогашенияПаев.ПоЗаявке Тогда				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для ""Погашения паев"" по заявке создание ""Вывода денежных средств"" не предусмотрено", ЭтотОбъект, "Основание",, Отказ);
			ИначеЕсли ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств")
				И ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда
				
				Если РаботаСДокументами.ДействуетКонтрольПорученийВнутреннейСистемы(ЭтотОбъект.Дата, ЭтотОбъект.Организация) 
					И Не РаботаСдокументами.ПоручениеНаВыводАктивовСогласовано(ЭтотОбъект.Основание, ЭтотОбъект.Дата) Тогда
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя проводить вывод денежных средств, на основании поручения, которое не прошло согласование [" + ЭтотОбъект.Основание + "].", ЭтотОбъект,,, Отказ);						
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПайщику Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана Заявка пайщика на погашение паев", ЭтотОбъект, "Основание",, Отказ);
			ИначеЕсли ЭтотОбъект.ВидОперации = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствПриЗакрытииПИФ Тогда
				// В старых системах отсутствало основание вывода денежных средств
				Если Дата >= '20150101' Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано Погашение паев", ЭтотОбъект, "Основание",, Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект.РасчетныйСчетКонтрагента) Тогда
			Если ЭтотОбъект.РасчетныйСчетКонтрагента.Организация <> ЭтотОбъект.Организация Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет контрагента не принадлежит выбранной организации", ЭтотОбъект, "РасчетныйСчетКонтрагента",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.РасчетныйСчетКонтрагента.ЮрФизЛицо <> ЭтотОбъект.Контрагент
				И ЭтотОбъект.РасчетныйСчетКонтрагента.ЮрФизЛицо <> ЭтотОбъект.РасчетныйСчетКонтрагента.Банк.ЮрФизЛицо
				И НЕ БылТакойКлиент(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Контрагент) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расчетный счет контрагента не принадлежит выбранному контрагенту или банку", ЭтотОбъект, "РасчетныйСчетКонтрагента",, Отказ);
			КонецЕсли;
			
			Если ЭтотОбъект.РасчетныйСчетКонтрагента.Валюта <> ЭтотОбъект.РасчетныйСчет.Валюта Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюты расчетных счетов получателя и отправителя не совпадают", ЭтотОбъект, "РасчетныйСчетКонтрагента",, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет 
		   И ТипЗнч(ЭтотОбъект.Основание) = Тип("ДокументСсылка.ПоручениеНаДвижениеДенежныхСредств") 
		   И ЭтотОбъект.ВидОперации <> ЭтотОбъект.Основание.ВидОперации Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		   		СтрШаблон("Для договоров вида ИИС вид операции '%1' должен быть равен виду операции в Поручении на вывод денежных средств '%2'",
					ЭтотОбъект.ВидОперации,
					ЭтотОбъект.Основание.ВидОперации),
				,,,
				Отказ);
		КонецЕсли;
			
		РаботаСДокументами.ПроверитьДатуИсполненияПоручения(ЭтотОбъект, Отказ);
		
		РаботаСДокументами.ПроверитьВозможностьСозданияПодчиненногоДокументаНаОснованииПоручения(ЭтотОбъект, Отказ);
		
		Если Не Отказ Тогда
			Отказ = Не РаботаСДокументами.РазрешенВыводАктивовКонтрагенту(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
			
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
