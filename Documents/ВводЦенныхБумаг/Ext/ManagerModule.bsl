
Функция РассчитатьСуммуВВалютеУчета(СтрокиТабличнойЧасти, Организация, ДатаКурса, Колонки, Отказ = Ложь) Экспорт
	
	РассчитаннаяСумма = 0;	
	
	КолонкиТабличнойЧасти	= Метаданные.Документы.ВводЦенныхБумаг.ТабличныеЧасти.ЦенныеБумаги.Реквизиты;
	ПоляВВалютеУчета		= СтрРазделить("РезервПодОбесценение, РезервПодОбесценениеКупонаПокупки, РезервПодОбесценениеКупонаНачисленный, РезервПодСомнительныеДолги", ", ", Ложь);	
	ПараметрыОкругления		= Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип;	
	
	СоставляющиеСуммы = Новый ТаблицаЗначений;
	СоставляющиеСуммы.Колонки.Добавить("Поле",				Новый ОписаниеТипов("Строка"));
	СоставляющиеСуммы.Колонки.Добавить("ПолеВВалютеУчета",	Новый ОписаниеТипов("Строка"));
	СоставляющиеСуммы.Колонки.Добавить("Вычитаемое",		Новый ОписаниеТипов("Булево"));
	
	МассивКолонок = СтрРазделить(РаботаСоСтрокамиКлиентСервер.ЗаменитьПробельныеСимволы(Колонки), ",", Ложь);
	Для Каждого Колонка Из МассивКолонок Цикл
		Вычитаемое = Ложь;
		Если СтрНачинаетсяС(Колонка, "-") Тогда
			Колонка = Сред(Колонка, 2);
			Вычитаемое = Истина;
		КонецЕсли;
		
		Составляющее = СоставляющиеСуммы.Добавить();
		Составляющее.Поле		= Колонка;
		Составляющее.Вычитаемое	= Вычитаемое;
		
		Если КолонкиТабличнойЧасти.Найти(Колонка + "ВВалютеУчета") <> Неопределено Тогда
			Составляющее.ПолеВВалютеУчета = Колонка + "ВВалютеУчета";	
		КонецЕсли;
	КонецЦикла;
	
	// Если поле уже в валюте учета, то берем значение без пересчета
	// Если для переданного поля есть аналогичное в валюте учета и в строке по нему есть данные, то берем значение из него
	// Иначе пересчитываем значение из валюты номинала в валюту учета
	
	Для Каждого СтрокаТабличнойЧасти Из СтрокиТабличнойЧасти Цикл
		
		Для Каждого Составляющее Из СоставляющиеСуммы Цикл
			
			Если ПоляВВалютеУчета.Найти(Составляющее.Поле) <> Неопределено Тогда
				СуммаВВалютеУчета = СтрокаТабличнойЧасти[Составляющее.Поле];	
			ИначеЕсли ЗначениеЗаполнено(Составляющее.ПолеВВалютеУчета) И ЗначениеЗаполнено(СтрокаТабличнойЧасти[Составляющее.ПолеВВалютеУчета]) Тогда
				СуммаВВалютеУчета = СтрокаТабличнойЧасти[Составляющее.ПолеВВалютеУчета];	
			Иначе
				СуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаТабличнойЧасти[Составляющее.Поле], СтрокаТабличнойЧасти.ЦеннаяБумага.ВалютаНоминала, Организация, ДатаКурса, Отказ);
			КонецЕсли;
			
			РассчитаннаяСумма = РассчитаннаяСумма + ?(Составляющее.Вычитаемое, -1, 1) * ПараметрыОкругления.ПривестиЗначение(СуммаВВалютеУчета);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат РассчитаннаяСумма;
	
КонецФункции

Функция ДатаОтказаОтНепроведенныхРеклассовВоВводеЦенныхБумаг() Экспорт

	Возврат '20250601';

КонецФункции
