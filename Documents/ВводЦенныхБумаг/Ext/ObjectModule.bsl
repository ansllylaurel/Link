
Процедура ЗаполнитьНаОснованииПоручения(Основание) Экспорт
	
	Если Основание.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Тогда
		ЭтотОбъект.Поручение = Неопределено; // при заполнении из обработчика ПоручениеПриИзменении
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Основанием для ввода ц/б может быть поручение с видом ""Поступление""!");
		Возврат;
	КонецЕсли; 
	
	ЭтотОбъект.Поручение = Основание;

	// Заполнение табличной части
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Основание, "Организация, СчетДоверительногоУправления, ДепозитарныйСчет, Рынок, Валюта, Контрагент");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ПоручениеНаДвижениеЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	 |	ПоручениеНаДвижениеЦенныхБумагЦенныеБумаги.Количество КАК Количество,
	 |	ВЫБОР
	 |		КОГДА &ЗаполнятьКоличествоНУ
	 |			ТОГДА ПоручениеНаДвижениеЦенныхБумагЦенныеБумаги.Количество
	 |		ИНАЧЕ 0
	 |	КОНЕЦ КАК КоличествоНУ
	 |ИЗ
	 |	Документ.ПоручениеНаДвижениеЦенныхБумаг.ЦенныеБумаги КАК ПоручениеНаДвижениеЦенныхБумагЦенныеБумаги
	 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям.Остатки(
	 |				&Период,
	 |				Поручение = &Поручение
	 |					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)) КАК ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки
	 |		ПО ПоручениеНаДвижениеЦенныхБумагЦенныеБумаги.Ссылка = ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.Поручение
	 |ГДЕ
	 |	ПоручениеНаДвижениеЦенныхБумагЦенныеБумаги.Ссылка = &Поручение
	 |	И ЗадолженностиПоЦеннымБумагамПоПоручениямОстатки.КоличествоОстаток <> 0";
	 
	Запрос.УстановитьПараметр("Период",    ?(ЭтотОбъект.ЭтоНовый(), Неопределено, ЭтотОбъект.МоментВремени()));
	Запрос.УстановитьПараметр("Поручение", Основание);                        
	
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	ЗаполнятьКоличествоНУ = ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица
		Или ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами;
		
	Запрос.УстановитьПараметр("ЗаполнятьКоличествоНУ", ЗаполнятьКоличествоНУ);
		
	ЭтотОбъект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура УстановитьБлокировки()
	
	Если МонопольныйРежим() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) Тогда
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрНакопления.ЗадолженностиПоЦеннымБумагамПоПоручениям");
		ЭлементБлокировкиДанных.УстановитьЗначение("Поручение", ЭтотОбъект.Поручение);
		БлокировкаДанных.Заблокировать();
	КонецЕсли;
	
КонецПроцедуры // УстановитьБлокировки

Процедура СформироватьДвиженияПоЗадолженностиПоДенежнымСредствам()
	
	Движения.ЗадолженностиПоДенежнымСредствам.Записывать = Истина;
		
	// задолженность по д/с, если таковая имело место быть (например, к нам поступили
	// дефолтные облигации с накопленной задолженность по телу и/или купону)
	Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Возврат;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК Контрагент,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская) КАК ТипЗадолженности,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность) КАК Сумма,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон) КАК СуммаКупона
		|ПОМЕСТИТЬ _ДебиторскаяЗадолженность
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка = &Ссылка
		|	И (ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность > 0
		|			ИЛИ ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон > 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумаг.Ссылка КАК Основание,
		|	ВводЦенныхБумаг.Дата КАК Период,
		|	ВводЦенныхБумаг.Организация КАК Организация,
		|	ВводЦенныхБумаг.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВводЦенныхБумаг.Валюта КАК Валюта,
		|	СуммыЗадолженности.Контрагент КАК Контрагент,
		|	СуммыЗадолженности.ТипЗадолженности КАК ТипЗадолженности,
		|	СуммыЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
		|	СуммыЗадолженности.Сумма КАК Сумма,
		|	СуммыЗадолженности.СуммаКупона КАК СуммаКупона
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДебиторскаяЗадолженность.Ссылка КАК Ссылка,
		|		_ДебиторскаяЗадолженность.Контрагент КАК Контрагент,
		|		_ДебиторскаяЗадолженность.ТипЗадолженности КАК ТипЗадолженности,
		|		ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации) КАК ВидЗадолженности,
		|		_ДебиторскаяЗадолженность.Сумма КАК Сумма,
		|		0 КАК СуммаКупона
		|	ИЗ
		|		_ДебиторскаяЗадолженность КАК _ДебиторскаяЗадолженность
		|	ГДЕ
		|		_ДебиторскаяЗадолженность.Сумма > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ДебиторскаяЗадолженность.Ссылка,
		|		_ДебиторскаяЗадолженность.Контрагент,
		|		_ДебиторскаяЗадолженность.ТипЗадолженности,
		|		ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона),
		|		0,
		|		_ДебиторскаяЗадолженность.СуммаКупона
		|	ИЗ
		|		_ДебиторскаяЗадолженность КАК _ДебиторскаяЗадолженность
		|	ГДЕ
		|		_ДебиторскаяЗадолженность.СуммаКупона > 0) КАК СуммыЗадолженности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|		ПО СуммыЗадолженности.Ссылка = ВводЦенныхБумаг.Ссылка";

	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Движения.ЗадолженностиПоДенежнымСредствам.ДобавитьПриход(), Выборка);
	КонецЦикла;

КонецПроцедуры // СформироватьДвиженияПоЗадолженностиПоДенежнымСредствам

Процедура ПроведениеПоРегистрамБэкОфиса(Отказ) Экспорт
	
	УстановитьБлокировки();
	
	// новая схема проведения
	РаботаСРегистрамиНакопления.ОчиститьДвиженияПоБэкофису(ЭтотОбъект);
	
	Движения.ОстаткиЦенныхБумаг.Записывать                       = Истина;
	Движения.ЗадолженностиПоЦеннымБумагамПоПоручениям.Записывать = Истина;
	Движения.ОперацииСЦеннымиБумагами.Записывать                 = Истина;
	Движения.ВводыВыводыАктивовВВалютеУчета.Записывать           = Истина;
	Движения.РешенияКлиентовПоЗначениямЭСП.Записывать			 = Истина;
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.Количество) КАК Количество,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.Сумма) КАК Сумма,
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.СуммаКупона) КАК СуммаКупона
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВводЦенныхБумагЦенныеБумаги.Количество) > 0";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// остатки ц/б
		Движение = Движения.ОстаткиЦенныхБумаг.ДобавитьПриход();
		Движение.Период                       = ЭтотОбъект.Дата;
		Движение.Организация                  = ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ДепозитарныйСчет             = ЭтотОбъект.ДепозитарныйСчет;
		Движение.Рынок                        = ЭтотОбъект.Рынок;
		Движение.ЦеннаяБумага                 = Выборка.ЦеннаяБумага;
		Движение.Количество                   = Выборка.Количество;
		
		// задолженность по поручению
		Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) Тогда
			Движение = Движения.ЗадолженностиПоЦеннымБумагамПоПоручениям.ДобавитьРасход();
			Движение.Период                       = ЭтотОбъект.Дата;
			Движение.Поручение                    = ЭтотОбъект.Поручение;
			Движение.ТипЗадолженности             = Перечисления.ТипыЗадолженности.Дебиторская;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = Выборка.ЦеннаяБумага;
			Движение.Валюта                       = ЭтотОбъект.Валюта;
			Движение.Количество                   = Выборка.Количество;
		КонецЕсли;
	КонецЦикла;		
	
	// операции с ц/б
	Если НЕ ЭтотОбъект.ДепозитарныйСчет.Транзитный Тогда
	
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
			Движение = Движения.ОперацииСЦеннымиБумагами.Добавить();
			Движение.Операция                     = ЭтотОбъект.Ссылка;
			Движение.ВидДвижения                  = Перечисления.ВидыДвижений.Приход;
			Движение.Организация                  = ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
			Движение.Рынок                        = ЭтотОбъект.Рынок;
			Движение.ЦеннаяБумага                 = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Движение.ДатаПоставки                 = ЭтотОбъект.Дата;
			Движение.Количество                   = СтрокаЦенныеБумаги.Количество;
			Движение.Сумма                        = СтрокаЦенныеБумаги.Сумма;
			Движение.СуммаКупона                  = СтрокаЦенныеБумаги.СуммаКупона;
			Движение.ДатаОперации                 = ЭтотОбъект.Дата;
			Движение.Валюта						  = ЭтотОбъект.Валюта;
			Движение.СтрокаПартии                 = СтрокаЦенныеБумаги.СтрокаПартии;
			Движение.ДатаПокупки				  = СтрокаЦенныеБумаги.ДатаПокупки;
		КонецЦикла;
	
	КонецЕсли;
	
	// вводы/вывода активов
	
	СоставляющиеБалансовойСтоимости = "Сумма, СуммаКупона, СуммаКупонаНачисленного, ДисконтПремияНачисленный, СуммаПереоценки, СуммаИндексацииНоминала, ПогашениеКупонаНеИсполненноеВСрок,
		|КорректировкаЭСП, ДебиторскаяЗадолженность, ДебиторскаяЗадолженностьКупон, РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|-РезервПодОбесценение, -РезервПодОбесценениеКупонаПокупки, -РезервПодСомнительныеДолги";
	
	Движение = Движения.ВводыВыводыАктивовВВалютеУчета.Добавить();
	Движение.НаправлениеДвижения		  = Перечисления.ВидыДвижений.Приход;
	Движение.Период						  = ЭтотОбъект.Дата;
	Движение.Организация				  = ЭтотОбъект.Организация;
	Движение.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
	Движение.ВидАктива					  = Перечисления.ВидыАктивов.ЦенныеБумаги;
	Движение.РыночнаяСтоимость			  = ЭтотОбъект.ЦенныеБумаги.Итог("СуммаРынокВВалютеУчета") + ЭтотОбъект.ЦенныеБумаги.Итог("СуммаКупонаРынокВВалютеУчета");
	Движение.БалансоваяСтоимость		  = Документы.ВводЦенныхБумаг.РассчитатьСуммуВВалютеУчета(ЭтотОбъект.ЦенныеБумаги, ЭтотОбъект.Организация, ЭтотОбъект.Дата, СоставляющиеБалансовойСтоимости, Отказ);
		
	СформироватьДвиженияПоЗадолженностиПоДенежнымСредствам();
	
	// регистрации ЭСП
	
	Если РаботаСДокументами.ПолучитьТипПередачиДляВводаВыводаАктивов(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Контрагент) = 2 // от сторонней УК
		И ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
		И БухгалтерскийУчет.ВедетсяУчетЕПС(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления)
		И ЭтотОбъект.Дата >= '20240308' Тогда 
	
		Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
			Если СтрокаЦенныеБумаги.ЭффективнаяСтавкаПроцента > 0 Тогда
			
				Движение = Движения.РешенияКлиентовПоЗначениямЭСП.Добавить();
				
				Движение.Используется					= Истина;
				Движение.Период							= ЭтотОбъект.Дата;
				Движение.Организация					= ЭтотОбъект.Организация;
				Движение.СчетДоверительногоУправления	= ЭтотОбъект.СчетДоверительногоУправления;
				Движение.ЦеннаяБумага					= СтрокаЦенныеБумаги.ЦеннаяБумага;
				Движение.Партия							= ЭтотОбъект.Ссылка;
				Движение.Рынок							= ЭтотОбъект.Рынок;
				Движение.СтрокаПартии					= СтрокаЦенныеБумаги.СтрокаПартии;
				Движение.УчетныйАктивЕПС				= СтрокаЦенныеБумаги.УчетныйАктивЕПС;
				Движение.ЭСП							= СтрокаЦенныеБумаги.ЭффективнаяСтавкаПроцента;
				
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЕсли;
	
	Движения.Записать();
	
	// проверим отрицательные остатки
	Если ЗначениеЗаполнено(ЭтотОбъект.Поручение) Тогда
		РаботаСРегистрамиНакопления.ПроверитьОтрицательныеОстаткиЗадолженностиПоЦеннымБумагамПоПоручениям(ЭтотОбъект, Отказ);
	КонецЕсли;
	

КонецПроцедуры // ПроведениеПоРегистрамБэкОфиса

Процедура ПроведениеПоРегиструЕПС(УчетныйРегистр, Отказ) Экспорт
	
	Движения.ЕдиныйБухгалтерскийУчет.Записывать = Истина;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления);	
		
	АналитикаТела 								= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ТелоЦеннойБумаги;
	АналитикаПереоценкиТела 					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПереоценкаТелаЦеннойБумаги;
	АналитикаКупонПриобретенный 				= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонПриобретенный;
	АналитикаКупонНачисленный 					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.КупонНачисленный;
	АналитикаПремия 							= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Премия;
	АналитикаДисконт 							= Справочники.ДополнительныеАналитикиЛицевыхСчетов.Дисконт;
	АналитикаИндексацииНоминала					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ИндексацияНоминала;
	АналитикаПогашениеКупонаНеИсполненноеВСрок	= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПогашениеКупонаНеИсполненноеВСрок;
	ВалютаУчета									= ЭтотОбъект.Организация.ВалютаУчета;
	
	МассивСчетовНациональный = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
		ЭтотОбъект.Дата);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Стоимость КАК Сумма,
		|	БухПартииЦенныхБумаг.Количество КАК Количество,
		|	БухПартииЦенныхБумаг.Переоценка КАК СуммаПереоценки,
		|	БухПартииЦенныхБумаг.ИндексацияНоминала КАК СуммаИндексацииНоминала,
		|	БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумаг.СтоимостьКупона КАК СуммаКупона,
		|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК СуммаКупонаНачисленного,
		|	БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение КАК РезервПодОбесценение,
		|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
		|	БухПартииЦенныхБумаг.ДисконтПремия КАК ДисконтПремия,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СтоимостьВВалютеУчета,
		|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СтоимостьКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК ПереоценкаКупонаВВалютеУчета,
		|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
		|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	ВводЦенныхБумагЦенныеБумаги.Резерв КАК Резерв,
		|	БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрок КАК ПогашениеКупонаНеИсполненноеВСрок,
		|	БухПартииЦенныхБумаг.ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета КАК ПогашениеКупонаНеИсполненноеВСрокВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО (БухПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|					И БухПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|				ИЛИ БухПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумаги.РеклассификацияАктивовЕПС
		|					И БухПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаРеклассификации)
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		УчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
		
		ВалютаНоминала = ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала;
		// ТЕЛО ЦЕННОЙ БУМАГИ
		
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.СтоимостьВВалютеУчета, "Ввод ценных бумаг");

		// дебет
		Проводка.СчетДт = УчетныйАктив.СчетУчета;
		Проводка.СубконтоДт.ЦенныеБумаги = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		
		Проводка.КоличествоДт = ВыборкаДетальныеЗаписи.Количество;
		Проводка.ВалютаДт  = ВалютаНоминала;
		Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.Сумма;
		
		Проводка.ДополнительнаяАналитикаДт = АналитикаТела;
		
		// кредит
		Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоКт.Договоры = СчетДоверительногоУправления;
		
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
			Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
			Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
		КонецЕсли;
		
		// Переоценка
		Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах И ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета <> 0 Тогда
			
			СуммаПереоценки				= МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.СуммаПереоценки);
			СуммаПереоценкиВВалютеУчета	= МатематическиеФункции.МодульЧисла(ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета);
			
			Проводка 						= РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценкиВВалютеУчета, "Ввод ценных бумаг");
			
			Если ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета > 0 Тогда
				
				// дебет
				Проводка.СчетДт 					= УчетныйАктив.СчетУчетаПереоценкиА;
				Проводка.СубконтоДт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				
				Проводка.ВалютаДт  			= ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт	= СуммаПереоценки;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаПереоценкиТела;
				
				// кредит
				Проводка.СчетКт 				= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоКт.Договоры 	= СчетДоверительногоУправления;
				
				Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
				Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
				
				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценкиВВалютеУчета, "Ввод ценных бумаг");
					
					Проводка.СчетДт 					= ПланыСчетов.Единый.АктивыВДУ03;
					Проводка.СубконтоДт.Договоры 		= СчетДоверительногоУправления;
					
					Проводка.СчетКт 					= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив);
					Проводка.СубконтоКт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтПереоценки;
					Проводка.ВалютаКт  			= ВалютаУчета;
					Проводка.ВалютнаяСуммаКт	= СуммаПереоценкиВВалютеУчета;
					
					Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
					Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
				КонецЕсли;
				
			Иначе
								
				// дебет
				Проводка.СчетДт 				= ПланыСчетов.Единый.АктивыВДУ03;
				Проводка.СубконтоДт.Договоры 	= СчетДоверительногоУправления;
				
				// кредит
				Проводка.СчетКт 					= УчетныйАктив.СчетУчетаПереоценкиП;
				Проводка.СубконтоКт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.ВалютаКт  					= ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт 			= СуммаПереоценки;
				Проводка.ДополнительнаяАналитикаКт = АналитикаПереоценкиТела;
				
				Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
				Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
				
				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценкиВВалютеУчета, "Ввод ценных бумаг");
				
					Проводка.СчетДт 					= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, Ложь);
					Проводка.СубконтоДт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтПереоценки;
					
					Проводка.ВалютаДт 					= ВалютаУчета;
					Проводка.ВалютнаяСуммаДт 			= СуммаПереоценкиВВалютеУчета;
					
					Проводка.СчетКт 					= ПланыСчетов.Единый.АктивыВДУ03;
					Проводка.СубконтоКт.Договоры 		= СчетДоверительногоУправления;
					
					Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
					Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
			Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
			
		КонецЕсли;
		
		
		// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ
		Если ВыборкаДетальныеЗаписи.РезервПодОбесценение <> 0 Тогда
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ВыборкаДетальныеЗаписи.РезервПодОбесценение, "Ввод ценных бумаг");

