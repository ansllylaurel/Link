					Проводка.СубконтоКт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					
					Проводка.ВалютаКт  			= ВалютаНоминала;
					Проводка.ВалютнаяСуммаКт 	= РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
					
					Проводка.ДополнительнаяАналитикаКт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания;
					
					
					// дебет
					ПроводкаОбратная.СчетДт 					= УчетныйАктив.СчетУчетаОтрицательнойРазницыПервоначальногоПризнанияУровень3Дт;
					ПроводкаОбратная.СубконтоДт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					
					ПроводкаОбратная.ВалютаДт  			= ВалютаНоминала;
					ПроводкаОбратная.ВалютнаяСуммаДт 	= РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные;
					
					ПроводкаОбратная.ДополнительнаяАналитикаДт = Справочники.ДополнительныеАналитикиЛицевыхСчетов.РазницаПервоначальногоПризнания;
					
					// кредит
					ПроводкаОбратная.СчетКт 				= ПланыСчетов.Единый.АктивыВДУ03;
					ПроводкаОбратная.СубконтоКт.Договоры 	= СчетДоверительногоУправления;
					
				КонецЕсли;
				
				Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда
					
					Проводка.Партия = ВыборкаДетальныеЗаписи.Партия;
					Проводка.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
					ПроводкаОбратная.Партия = ВыборкаДетальныеЗаписи.Партия;
					ПроводкаОбратная.СтрокаПартии = ВыборкаДетальныеЗаписи.СтрокаПартии;
					
				КонецЕсли;
			
			КонецЕсли;																				
			
		КонецЕсли;
		
		// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ КУПОНА
		// пока не сделано
		// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ КУПОНА НАЧИСЛЕННОГО
		// пока не сделано
		
	КонецЦикла;

	
	// тут мы вводим дебиторку по погашению
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность КАК ДебиторскаяЗадолженность,
		|	ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон КАК ДебиторскаяЗадолженностьКупон,
		|	ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	(ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженность <> 0
		|			ИЛИ ВводЦенныхБумагЦенныеБумаги.ДебиторскаяЗадолженностьКупон <> 0)
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов 	= БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
	АналитикаДебиторкиПоКупону 						= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона;
	АналитикаДебиторкиПоОблигации 					= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЦеннаяБумага = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		ВалютаНоминала = ЦеннаяБумага.ВалютаНоминала;
		УчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
		
		Если ТипЗнч(ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
			УправляющаяКомпания = Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФДляПаяНаДату(ЭтотОбъект.Дата, ЦеннаяБумага);
			Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УправляющаяКомпания, "ЮрФизЛицо");
		Иначе
			Контрагент = ЦеннаяБумага.Эмитент.ЮрФизЛицо;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженность <>0 Тогда
			
			ДебиторскаяЗадолженностьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженность, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ДебиторскаяЗадолженностьВВалютеУчета, "Дебиторская задолженность по ценной бумаге");
			
			Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				Проводка.СчетДт = УчетныйАктив.СчетУчета;
			
				Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженность;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			Иначе 
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
			
				Проводка.СубконтоДт.Контрагенты = Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;				
				
				Проводка.ВалютаДт = ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженность;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
			
			КонецЕсли; 
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженностьКупон <> 0 Тогда
			
			ДебиторскаяЗадолженностьКупонВВалютеУчета = ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженностьКупон;
			//ДебиторскаяЗадолженностьКупонВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженностьКупон, ВалютаНоминала, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ДебиторскаяЗадолженностьКупонВВалютеУчета, "Дебиторская задолженность по купону");
			
			Если ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов Тогда
				
				Проводка.СчетДт = УчетныйАктив.СчетУчета;
			
				Проводка.СубконтоДт.ЦенныеБумаги = ЦеннаяБумага;
				
				Проводка.ВалютаДт = ВалютаУчета;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженностьКупон;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
				
			Иначе 
				
				Проводка.СчетДт = ПланыСчетов.Единый.Расчеты23;
			
				Проводка.СубконтоДт.Контрагенты = Контрагент;
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка;				
				
				Проводка.ВалютаДт = ВалютаУчета;
				Проводка.ВалютнаяСуммаДт = ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженностьКупон;
				
				Проводка.ДополнительнаяАналитикаДт = АналитикаДебиторкиПоКупону;
			
			КонецЕсли; 
			
			Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
			Проводка.СубконтоКт.Договоры = ЭтотОбъект.СчетДоверительногоУправления;
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	Если НастройкиУчета.ОтражатьПартииНаЛицевыхСчетах Тогда // всех нижележащих вещей не бывает при лицевых на партиях
		Возврат;
	КонецЕсли;
	
	
	// тут у нас обработка ситуации, когда идет ввод бумаг, которые уже есть и переоценка может изменить знак
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаОстаток) КАК ПереоценкаОстаток,
		|	СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток) КАК ПереоценкаВВалютеУчетаОстаток
		|ПОМЕСТИТЬ ОстаткиЦенныхБумаг
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = &ВидУчета
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок
		|				И ЦеннаяБумага В (&ЦенныеБумаги)) КАК БухПартииЦенныхБумагОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Переоценка) КАК Переоценка,
		|	СУММА(БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ПереоценкаВВалютеУчета
		|ПОМЕСТИТЬ ДвиженияПереоценки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДвиженияПереоценки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ДвиженияПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДвиженияПереоценки.Переоценка КАК Переоценка,
		|	ЕСТЬNULL(ОстаткиЦенныхБумаг.ПереоценкаОстаток, 0) КАК ПереоценкаОстаток,
		|	ДвиженияПереоценки.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	ЕСТЬNULL(ОстаткиЦенныхБумаг.ПереоценкаВВалютеУчетаОстаток, 0) КАК ПереоценкаВВалютеУчетаОстаток
		|ИЗ
		|	ДвиженияПереоценки КАК ДвиженияПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|		ПО ДвиженияПереоценки.УчетныйАктивЕПС = ОстаткиЦенныхБумаг.УчетныйАктивЕПС
		|			И ДвиженияПереоценки.ЦеннаяБумага = ОстаткиЦенныхБумаг.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(ЭтотОбъект.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Рынок", ЭтотОбъект.Рынок);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЭтотОбъект.ЦенныеБумаги.ВыгрузитьКолонку("ЦеннаяБумага"));
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета[УчетныйРегистр]);
	Запрос.УстановитьПараметр("Регистратор", ЭтотОбъект.Ссылка);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	
		УчетныйАктив = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
		
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчетаАктива(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);		
			
		ВалютаНоминала = ВыборкаДетальныеЗаписи.ЦеннаяБумага.ВалютаНоминала;

		// ПЕРЕОЦЕНКА
		Если ВыборкаДетальныеЗаписи.Переоценка * ВыборкаДетальныеЗаписи.ПереоценкаОстаток < 0 Тогда
			// была отрицательная, а ввели положительную, или наоборот
			Если (ВыборкаДетальныеЗаписи.Переоценка + ВыборкаДетальныеЗаписи.ПереоценкаОстаток) * ВыборкаДетальныеЗаписи.ПереоценкаОстаток < 0 Тогда
				// после ввода переоценка меняет знак 
				// значит списываем всю переоценку, что уже была
				ПредварительноСписать = ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
				ПредварительноСписатьВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаОстаток;
				// а переоценку делаем на разницу
				СуммаПереоценки = ВыборкаДетальныеЗаписи.Переоценка + ВыборкаДетальныеЗаписи.ПереоценкаОстаток;
				СуммаПереоценкиВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета + ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчетаОстаток;
			Иначе
				// после ввода переоценка не меняет знак
				// значит списываем только разность
				ПредварительноСписать = -ВыборкаДетальныеЗаписи.Переоценка;
				ПредварительноСписатьВВалютеУчета = -ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета;
				// а переоценка уже ушла в разность
				СуммаПереоценки = 0;
				СуммаПереоценкиВВалютеУчета = 0;
			КонецЕсли;
		Иначе
			// какая была, такую и ввели
		    ПредварительноСписать = 0;
		    ПредварительноСписатьВВалютеУчета = 0;
			СуммаПереоценки = ВыборкаДетальныеЗаписи.Переоценка;
			СуммаПереоценкиВВалютеУчета = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета;
		КонецЕсли;
		
		Если ПредварительноСписать <> 0 Тогда
			
			ПредварительноСписатьМодуль	= Макс(ПредварительноСписать, -ПредварительноСписать);	
			ПредварительноСписатьВВалютеУчетаМодуль	= Макс(ПредварительноСписатьВВалютеУчета, -ПредварительноСписатьВВалютеУчета);	
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, ПредварительноСписатьВВалютеУчетаМодуль, "Ввод ценных бумаг");

			Если ПредварительноСписать > 0 Тогда
				
				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
					Проводка.СчетДт 					= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив);
					Проводка.СубконтоДт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтПереоценки;
					Проводка.ВалютаДт 					= ВалютаУчета;
					Проводка.ВалютнаяСуммаДт 			= ПредварительноСписатьВВалютеУчетаМодуль;
				Иначе	
					Проводка.СчетДт 					= ПланыСчетов.Единый.АктивыВДУ03;
					Субконто1Дт                     	= СчетДоверительногоУправления;
					Проводка.СубконтоДт.Договоры 		= Субконто1Дт;
				КонецЕсли;
				
				Проводка.СчетКт 					= УчетныйАктив.СчетУчетаПереоценкиА;
				Субконто1Кт 						= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоКт.ЦенныеБумаги 	= Субконто1Кт;
				
				Проводка.ВалютаКт  					= ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт 			= ПредварительноСписатьМодуль;
				
				ДопАналитикаДт 						= Неопределено;
				ДопАналитикаКт 						= АналитикаПереоценкиТела;
			Иначе
				Проводка.СчетДт 					= УчетныйАктив.СчетУчетаПереоценкиП;
				Субконто1Дт 						= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.ЦенныеБумаги 	= Субконто1Дт;
				
				Проводка.ВалютаДт  					= ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт 			= ПредварительноСписатьМодуль;

				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
					Проводка.СчетКт 					= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, Ложь);
					Проводка.СубконтоКт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтПереоценки;
					Проводка.ВалютаКт 					= ВалютаУчета;
					Проводка.ВалютнаяСуммаКт 			= ПредварительноСписатьВВалютеУчетаМодуль;
				Иначе
					Проводка.СчетКт 					= ПланыСчетов.Единый.АктивыВДУ03;
					Субконто1Кт                     	= СчетДоверительногоУправления;
					Проводка.СубконтоКт.Договоры 		= Субконто1Кт;
				КонецЕсли;
				
				ДопАналитикаДт 						= АналитикаПереоценкиТела;
				ДопАналитикаКт                      = Неопределено;
			КонецЕсли; 
			
			Проводка.ДополнительнаяАналитикаДт = ДопАналитикаДт;		
			Проводка.ДополнительнаяАналитикаКт = ДопАналитикаКт;
			
		КонецЕсли;
		
		Если СуммаПереоценки <> 0 Тогда
			
			СуммаПереоценкиМодуль	= Макс(СуммаПереоценки, -СуммаПереоценки);	
			СуммаПереоценкиВВалютеУчетаМодуль	= Макс(СуммаПереоценкиВВалютеУчета, -СуммаПереоценкиВВалютеУчета);	
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценкиВВалютеУчетаМодуль, "Ввод ценных бумаг");

			Если СуммаПереоценки > 0 Тогда
				Проводка.СчетДт 					= УчетныйАктив.СчетУчетаПереоценкиА;
				Субконто1Дт 						= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоДт.ЦенныеБумаги 	= Субконто1Дт;
				Проводка.ВалютаДт  					= ВалютаНоминала;
				Проводка.ВалютнаяСуммаДт 			= СуммаПереоценкиМодуль;
				
				Проводка.СчетКт 					= ПланыСчетов.Единый.АктивыВДУ03;
				Субконто1Кт                     	= СчетДоверительногоУправления;
				Проводка.СубконтоКт.Договоры 		= Субконто1Кт;
				
				Проводка.ДополнительнаяАналитикаДт	= АналитикаПереоценкиТела;
				Проводка.ДополнительнаяАналитикаКт  = Неопределено;
				
				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценкиВВалютеУчетаМодуль, "Ввод ценных бумаг");
					
					Проводка.СчетДт 					= ПланыСчетов.Единый.АктивыВДУ03;
					Субконто1Дт                     	= СчетДоверительногоУправления;
					Проводка.СубконтоДт.Договоры 		= Субконто1Дт;
					
					Проводка.СчетКт 					= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив);
					Проводка.СубконтоКт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					Проводка.СубконтоКт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаДоходовОтПереоценки;
					Проводка.ВалютаКт 					= ВалютаУчета;
					Проводка.ВалютнаяСуммаКт 			= СуммаПереоценкиВВалютеУчетаМодуль;
					
				КонецЕсли;
				
			Иначе
				
				Проводка.СчетДт 					= ПланыСчетов.Единый.АктивыВДУ03;
				Субконто1Дт                     	= СчетДоверительногоУправления;
				Проводка.СубконтоДт.Договоры 		= Субконто1Дт;

				Проводка.СчетКт 					= УчетныйАктив.СчетУчетаПереоценкиП;
				Субконто1Кт 						= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
				Проводка.СубконтоКт.ЦенныеБумаги 	= Субконто1Кт;
				Проводка.ВалютаКт  					= ВалютаНоминала;
				Проводка.ВалютнаяСуммаКт 			= СуммаПереоценкиМодуль;
				
				Проводка.ДополнительнаяАналитикаДт	= Неопределено;
				Проводка.ДополнительнаяАналитикаКт	= АналитикаПереоценкиТела;
				
				Если УчетныйАктив.Родитель = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи Тогда
					
					Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения.ЕдиныйБухгалтерскийУчет, СуммаПереоценкиВВалютеУчетаМодуль, "Ввод ценных бумаг");
				
					Проводка.СчетДт 					= БухгалтерскийУчетЕПС.ОпределитьСчетУчетаДоходовРасходовОтПереоценки(УчетныйАктив, Ложь);
					Проводка.СубконтоДт.ЦенныеБумаги 	= ВыборкаДетальныеЗаписи.ЦеннаяБумага;
					Проводка.СубконтоДт.ГруппыФинансовогоУчетаДоходовРасходов = УчетныйАктив.АналитикаРасходовОтПереоценки;
					Проводка.ВалютаДт 					= ВалютаУчета;
					Проводка.ВалютнаяСуммаДт 			= СуммаПереоценкиВВалютеУчетаМодуль;
					
					Проводка.СчетКт 					= ПланыСчетов.Единый.АктивыВДУ03;
					Субконто1Кт                     	= СчетДоверительногоУправления;
					Проводка.СубконтоКт.Договоры 		= Субконто1Кт;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	БухгалтерскийУчетЕПС.ОбработатьДвиженияДокументаПоПарнымСчетам(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроведениеПоРегиструБухгалтерии(УчетныйРегистр, Отказ) Экспорт

	Движения[УчетныйРегистр].Записывать = Истина;
	
	Если ЭтотОбъект.ДепозитарныйСчет.Транзитный Тогда
		Возврат;
	КонецЕсли;
	
	УчетныйРегистр = Движения[УчетныйРегистр].Метаданные().Имя;
	
	СчетРасчетов = БухгалтерскийУчет.ОпределитьСчетРасчетовПоДоговоруДоверительногоУправления(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		Неопределено);
		
	ВалютаУчета = ЭтотОбъект.Организация.ВалютаУчета;
		
	Если Не ЗначениеЗаполнено(СчетРасчетов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить счет расчетов",,,, Отказ);
		Возврат;
	КонецЕсли;
																		
	ЕстьСубконтоКонтрагенты = (СчетРасчетов.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты) <> Неопределено);
	
	Если ЕстьСубконтоКонтрагенты Тогда
		Контрагент = РаботаСНормативноСправочнойИнформацией.ПолучитьЮрФизЛицоСчетаДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
	КонецЕсли;
	
	ВидСубконтоУчетаЦеннойБумаги = БухгалтерскийУчет.ОпределитьВидСубконтоУчетаЦеннойБумаги(ЭтотОбъект.Рынок);
	
	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
		УчетныйАктив      = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага);
		УчетныйАктивКупон = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Дата, ЭтотОбъект.Рынок, СтрокаЦенныеБумаги.ЦеннаяБумага, Истина);
		ВалютаНоминала = СтрокаЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала;
		
		// ТЕЛО ЦЕННОЙ БУМАГИ
		СуммаВВалютеУчета = ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаНУВВалютеУчета, СтрокаЦенныеБумаги.СуммаВВалютеУчета);
		Если СуммаВВалютеУчета = 0 Тогда
			СуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаНУ, СтрокаЦенныеБумаги.Сумма), ВалютаНоминала, Организация, Дата, Отказ);
		КонецЕсли;
		Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаВВалютеУчета, "Ввод ценной бумаги");

		// дебет
		СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
			ЭтотОбъект.Дата,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			УчетныйАктив,
			УчетныйРегистр);
		
		Проводка.СчетДт = СчетУчета;
		Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
		
		Проводка.КоличествоДт = СтрокаЦенныеБумаги.Количество;
		
		Если СчетУчета.Валютный Тогда
			Проводка.ВалютнаяСуммаДт = ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаНУ, СтрокаЦенныеБумаги.Сумма);
			Проводка.ВалютаДт = ВалютаНоминала;
		КонецЕсли;
		
		// кредит
		Проводка.СчетКт = СчетРасчетов;
		
		Если ЕстьСубконтоКонтрагенты Тогда
			Проводка.СубконтоКт.Контрагенты = Контрагент;
		КонецЕсли;
		
		// ПЕРЕОЦЕНКА
		Если СтрокаЦенныеБумаги.СуммаПереоценки <> 0 И УчетныйРегистр <> "НалоговыйУчет" Тогда
			СуммаПереоценкиВВалютеУчета = СтрокаЦенныеБумаги.СуммаПереоценкиВВалютеУчета;
			Если СуммаПереоценкиВВалютеУчета = 0 Тогда
				СуммаПереоценкиВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.СуммаПереоценки, ВалютаНоминала, Организация, Дата, Отказ);
			КонецЕсли;
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаПереоценкиВВалютеУчета, "Ввод переоценки ценной бумаги");
			
			// дебет
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктив,
				УчетныйРегистр);
			
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			Если СчетУчета.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = СтрокаЦенныеБумаги.СуммаПереоценки;
				Проводка.ВалютаДт = ВалютаНоминала;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		// ДЕБИТОРСКАЯ ЗАДОЛЖЕННОСТЬ
		Если (СтрокаЦенныеБумаги.ДебиторскаяЗадолженность <> 0 И УчетныйРегистр <> "НалоговыйУчет")
			Или (СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьНУ <> 0 И УчетныйРегистр = "НалоговыйУчет")
		Тогда
			ДебиторскаяЗадолженностьВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьНУ, СтрокаЦенныеБумаги.ДебиторскаяЗадолженность), ВалютаНоминала, Организация, Дата, отказ);
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ДебиторскаяЗадолженностьВВалютеУчета, "Ввод дебиторской задолженности по ценной бумаге");
			
			// дебет
			Проводка.СчетДт = ПланыСчетов.Основной.АвансыПоЧастичномуПогашениюОблигаций;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьНУ, СтрокаЦенныеБумаги.ДебиторскаяЗадолженность);
				Проводка.Валюта = ВалютаНоминала;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;		
		
		// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ
		Если (СтрокаЦенныеБумаги.РезервПодОбесценение <> 0) И (УчетныйРегистр<>"НалоговыйУчет") Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.РезервПодОбесценение, "Ввод резерва под обесценивание по ценной бумаге");
			
			// дебет
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктив);
			
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
						
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		// РЕЗЕРВ ПОД СОМНИТЕЛЬНЫЕ ДОЛГИ
		Если (СтрокаЦенныеБумаги.РезервПодСомнительныеДолги <> 0) И (УчетныйРегистр<>"НалоговыйУчет") Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.РезервПодСомнительныеДолги, "Ввод резерва под сомнительные долги по ценной бумаге");

			// дебет
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПоСомнительнымДолгам(УчетныйАктив);
			
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			Проводка.КоличествоДт = СтрокаЦенныеБумаги.Количество;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		// КУПОН ЦЕННОЙ БУМАГИ
		Если (СтрокаЦенныеБумаги.СуммаКупона <> 0 И УчетныйРегистр <> "НалоговыйУчет")
			Или (СтрокаЦенныеБумаги.СуммаКупонаНУ <> 0 И УчетныйРегистр = "НалоговыйУчет")
		Тогда
			СуммаКупонаВВалютеУчета = ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаКупонаНУВВалютеУчета, СтрокаЦенныеБумаги.СуммаКупонаВВалютеУчета);
			
			Если СуммаКупонаВВалютеУчета = 0 Тогда
				СуммаКупонаВВалютеУчета = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаКупонаНУ, СтрокаЦенныеБумаги.СуммаКупона), ВалютаНоминала, Организация, Дата, Отказ);
			КонецЕсли;
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СуммаКупонаВВалютеУчета, "Ввод купона ценной бумаги");
			
			// дебет
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаАктивов(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктивКупон,
				УчетныйРегистр);
				
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			Если СчетУчета.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаКупонаНУ, СтрокаЦенныеБумаги.СуммаКупона);
				Проводка.ВалютаДт			 = ВалютаНоминала;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		// НАЧИСЛЕННЫЙ КУПОН
		Если (СтрокаЦенныеБумаги.СуммаКупонаНачисленного <> 0 И УчетныйРегистр <> "НалоговыйУчет")
			Или (СтрокаЦенныеБумаги.СуммаКупонаНачисленногоНУ <> 0 И УчетныйРегистр = "НалоговыйУчет")
		Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаКупонаНачисленногоНУВВалютеУчета, СтрокаЦенныеБумаги.СуммаКупонаНачисленногоВВалютеУчета), "Ввод начисленного купона по ценной бумаге");
			
			// дебет
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетУчетаПереоценкиАктивов(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктивКупон,
				УчетныйРегистр);
																	 
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			Если СчетУчета.Валютный Тогда
				Проводка.ВалютнаяСуммаДт = ?(УчетныйРегистр = "НалоговыйУчет", СтрокаЦенныеБумаги.СуммаКупонаНачисленногоНУ, СтрокаЦенныеБумаги.СуммаКупонаНачисленного);
				Проводка.ВалютаДт = ВалютаНоминала;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
		
		КонецЕсли;
		
		// ДЕБЕТОРСКАЯ ЗАДОЛЖЕННОСТЬ ПО КУПОНУ
		Если (СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьКупон <> 0 И УчетныйРегистр <> "НалоговыйУчет") 
			Или (СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьКупонНУ <> 0 И УчетныйРегистр = "НалоговыйУчет")
		Тогда
		
			Если ВалютаНоминала = ВалютаУчета Тогда
				СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупона;
			Иначе
				СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации;
			КонецЕсли;
		
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], ?(УчетныйРегистр = "НалоговыйУчет", РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьКупонНУ, ВалютаНоминала, Организация, Дата, Отказ), СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьКупон), "Ввод дебиторской задолженности по купону по ценной бумаге");

			// дебет
			Проводка.СчетДт = СчетПогашениеКупона;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютнаяСУммаДт = СтрокаЦенныеБумаги.ДебиторскаяЗадолженностьКупонНУ;
				Проводка.ВалютаДт = ВалютаНоминала;
			КонецЕсли;
			
			Если СчетПогашениеКупона = ПланыСчетов.Основной.ПогашениеКупонаЕврооблигации Тогда
				Проводка.СубконтоДт.ОснованиеРасчетов = ЭтотОбъект.Ссылка; 
			КонецЕсли;			
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ КУПОНА
		Если (СтрокаЦенныеБумаги.РезервПодОбесценениеКупонаПокупки <> 0) И (УчетныйРегистр <> "НалоговыйУчет") Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.РезервПодОбесценениеКупонаПокупки, "Ввод резерва под обесценивание купона по ценной бумаге");
			
			// дебет		
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктивКупон);
			
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
		// РЕЗЕРВ ПОД ОБЕСЦЕНИВАНИЕ КУПОНА
		Если (СтрокаЦенныеБумаги.РезервПодОбесценениеКупонаНачисленный <> 0) И (УчетныйРегистр <> "НалоговыйУчет") Тогда
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.РезервПодОбесценениеКупонаНачисленный, "Ввод резерва под обесценивание купона начисленного по ценной бумаге");

			// дебет
			СчетУчета = БухгалтерскийУчет.ОпределитьСчетРезерваПодОбесценение(УчетныйАктивКупон, Истина);
			
			Проводка.СчетДт = СчетУчета;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;

		// ИНДЕКСАЦИЯ НОМИНАЛА
		Если СтрокаЦенныеБумаги.СуммаИндексацииНоминала <> 0 Тогда
			
			СчетУчетаИндексацииНоминала = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(
				ЭтотОбъект.Дата,
				ЭтотОбъект.Организация,
				ЭтотОбъект.СчетДоверительногоУправления,
				УчетныйАктив,
				УчетныйРегистр,
				"СчетУчетаИндексацииНоминалаЗаВремяВладения");
			
			Проводка = РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(ЭтотОбъект, Движения[УчетныйРегистр], СтрокаЦенныеБумаги.СуммаИндексацииНоминала, "Ввод индексации номинала");
				
			// дебет
			Проводка.СчетДт = СчетУчетаИндексацииНоминала;
			Проводка.СубконтоДт[ВидСубконтоУчетаЦеннойБумаги] = СтрокаЦенныеБумаги.ЦеннаяБумага;
			
			Если Проводка.СчетДт.Валютный Тогда
				Проводка.ВалютнаяСУммаДт = СтрокаЦенныеБумаги.СуммаИндексацииНоминала;
				Проводка.ВалютаДт = ВалютаНоминала;
			КонецЕсли;
			
			// кредит
			Проводка.СчетКт = СчетРасчетов;
			
			Если ЕстьСубконтоКонтрагенты Тогда
				Проводка.СубконтоКт.Контрагенты = Контрагент;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КонтрольПроцентныхПоказателей() Экспорт

	Если ЭтотОбъект.Рынок <> Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проверяются только вводы по облигациям!");
		Возврат Ложь;	
	КонецЕсли;
	
	НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	Если НЕ НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проверяются только вводы по клиентам, ведущим ЕПС!");
		Возврат Ложь;	
	КонецЕсли;
	
	ТаблицаРасхождений = Новый ТаблицаЗначений();
	ТаблицаРасхождений.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ТаблицаРасхождений.Колонки.Добавить("НомерСтроки", Метаданные.ОпределяемыеТипы.СтрокаПартии.Тип);
	ТаблицаРасхождений.Колонки.Добавить("ДисконтПремияИзДокумента", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ТаблицаРасхождений.Колонки.Добавить("ДисконтПремияРасчетный", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ТаблицаРасхождений.Колонки.Добавить("КорректировкаЭСПИзДокумента", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	ТаблицаРасхождений.Колонки.Добавить("КорректировкаЭСПРасчетная", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	
	ТочностьОкругления = Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	
	ДанныеПереоценки = Новый Структура("Количество, УчетныйАктивЕПС, СтрокаПартии");
	
	ДанныеПереоценки.Вставить("Партия", ЭтотОбъект.Ссылка);
	ДанныеПереоценки.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	ДанныеПереоценки.Вставить("ДатаПереоценки", НачалоДня(ЭтотОбъект.Дата));
	
	Для каждого СтрокаЦенныеБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
		НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
			НастройкиУчетаОбщие,
			СтрокаЦенныеБумаги.ЦеннаяБумага,
			СтрокаЦенныеБумаги.УчетныйАктивЕПС,
			ЭтотОбъект.Ссылка,
			СтрокаЦенныеБумаги.СтрокаПартии);
		
		Если НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода <> Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке
			И ЗначениеЗаполнено(СтрокаЦенныеБумаги.УчетныйАктивЕПС)
			И СтрокаЦенныеБумаги.УчетныйАктивЕПС.Родитель <> Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток Тогда
			
			НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДанныеПереоценки, СтрокаЦенныеБумаги, "Количество, УчетныйАктивЕПС, СтрокаПартии");
		
		ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона", СтрокаЦенныеБумаги.СуммаКупона + СтрокаЦенныеБумаги.СуммаКупонаНачисленного);
		ДанныеПереоценки.Вставить("БалансовыйДисконт", СтрокаЦенныеБумаги.ДисконтПремияНачисленный);
		ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаЦенныеБумаги.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные);
		
		Если СтрокаЦенныеБумаги.ДисконтПремияПокупки > 0 Тогда
			Если СтрокаЦенныеБумаги.ЦеннаяБумага.Амортизационная Тогда
				НоминальнаяСтоимость = Кэширование.ПолучитьНоминал(СтрокаЦенныеБумаги.ЦеннаяБумага, ЭтотОбъект.Дата) * СтрокаЦенныеБумаги.Количество;
			Иначе
				НоминальнаяСтоимость = СтрокаЦенныеБумаги.ЦеннаяБумага.Номинал * СтрокаЦенныеБумаги.Количество;
			КонецЕсли;
			ДанныеПереоценки.Вставить("Стоимость", НоминальнаяСтоимость);
		Иначе
			ДанныеПереоценки.Вставить("Стоимость", СтрокаЦенныеБумаги.СуммаПокупки);
		КонецЕсли;
		
		ДанныеПокупки = Новый Структура;
		ДанныеПокупки.Вставить("НачальныйДисконт", СтрокаЦенныеБумаги.ДисконтПремияПокупки / СтрокаЦенныеБумаги.Количество);
		ДанныеПокупки.Вставить("ДатаПокупки", СтрокаЦенныеБумаги.ДатаПокупки);
		ДанныеПокупки.Вставить("ДатаПокупкиНачальная", СтрокаЦенныеБумаги.ДатаПокупки);
		ДанныеПокупки.Вставить("КорректировкаЭСПНачальная", 0);
		ДанныеПокупки.Вставить("ЦенаПокупки", СтрокаЦенныеБумаги.СуммаПокупки / СтрокаЦенныеБумаги.Количество);
		ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", СтрокаЦенныеБумаги.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная / СтрокаЦенныеБумаги.Количество);
		ДанныеПокупки.Вставить("ЦенаПокупкиКупона", СтрокаЦенныеБумаги.СуммаПокупкиКупона / СтрокаЦенныеБумаги.Количество);
		ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", СтрокаЦенныеБумаги.СуммаПокупки / СтрокаЦенныеБумаги.Количество);

		Отказ = Ложь;
		ДисконтИКорректировкаЭСП = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаЦенныеБумаги.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
		
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Возникли ошибки при расчете процентных показателей в строке %1", СтрокаЦенныеБумаги.НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		ОценочныеДисконтПремия = Окр(ДисконтИКорректировкаЭСП.ОценочныеДисконтПремия, ТочностьОкругления);
		ОценочнаяКорректировкаЭСП = Окр(ДисконтИКорректировкаЭСП.ОценочнаяКорректировкаЭСП, ТочностьОкругления);
		
		Если СтрокаЦенныеБумаги.ДисконтПремияНачисленный <> ОценочныеДисконтПремия
			ИЛИ СтрокаЦенныеБумаги.КорректировкаЭСП <> ОценочнаяКорректировкаЭСП Тогда
			
			СтрокаРасхождений = ТаблицаРасхождений.Добавить();
			
			СтрокаРасхождений.ЦеннаяБумага = СтрокаЦенныеБумаги.ЦеннаяБумага;
			СтрокаРасхождений.НомерСтроки = СтрокаЦенныеБумаги.НомерСтроки;
			
			СтрокаРасхождений.ДисконтПремияИзДокумента = СтрокаЦенныеБумаги.ДисконтПремияНачисленный;
			СтрокаРасхождений.ДисконтПремияРасчетный = ОценочныеДисконтПремия;
			
			СтрокаРасхождений.КорректировкаЭСПИзДокумента = СтрокаЦенныеБумаги.КорректировкаЭСП;
			СтрокаРасхождений.КорректировкаЭСПРасчетная = ОценочнаяКорректировкаЭСП;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаРасхождений.Количество() = 0 Тогда
	    Возврат Истина;
	Иначе		
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент();
		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаРасхождений, , , , Истина);    
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
		
		Возврат ПараметрыВывода.ДокументРезультат;       
	КонецЕсли;

КонецФункции 

Процедура ПроверкаСоответствияРынкаИУчетныхАктивовЕПС(Отказ)
	
	Если ЦенныеБумаги.Количество() > 0 Тогда 
		РазрешенныеУчетныеАктивыЕПС = Новый Массив;
		
		Если Рынок = Перечисления.РынкиЦенныхБумаг.Закладные
			ИЛИ	Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы
			ИЛИ	Рынок = Перечисления.РынкиЦенныхБумаг.Опционы
			ИЛИ	Рынок = Перечисления.РынкиЦенныхБумаг.ВалютныеПары
			ИЛИ	Рынок = Перечисления.РынкиЦенныхБумаг.Доли
			Тогда
			
			// Эти рынки не проверяем
			
		ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Акции
			ИЛИ Рынок = Перечисления.РынкиЦенныхБумаг.Паи
			ИЛИ Рынок = Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия
			ИЛИ Рынок = Перечисления.РынкиЦенныхБумаг.ДепозитарныеРасписки
			Тогда
			
			// Долевые ценные бумаги, имеющиеся в наличии для продажи, или долевые ценные бумаги, оцениваемые по справедливой стоимости через прочий совокупный доход
			// Долевые ценные бумаги, оцениваемые по справедливой стоимости через прибыль или убыток
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
			
		ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			// Долговые (кроме векселей), по аморт. с-ти, кроме по СС ч/з ОПУ, для продажи, СС ч/з ПСД и до погашен
			// Долговые ценные бумаги, имеющиеся в наличии для продажи, или долговые ценные бумаги, оцениваемые по справедливой стоимости через прочий совокупный дох
			// Долговые ценные бумаги, оцениваемые по справедливой стоимости через прибыль или убыток
			// Долговые ценные бумаги, удерживаемые до погашения
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения);
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД);
			
		ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Векселя Тогда
			
			// Векселя, кроме оцениваемых по справедливой стоимости через прибыль или убыток, имеющихся в наличии для продажи и удерживаемых до погашения
			// Векселя, оцениваемые по справедливой стоимости через прибыль или убыток
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ВекселяДоПогашения);
			РазрешенныеУчетныеАктивыЕПС.Добавить(Справочники.УчетныеАктивыЕПС.ВекселяЧерезПрибыльУбыток);
			
		Иначе	
			
		КонецЕсли;
		
		Если РазрешенныеУчетныеАктивыЕПС.Количество() > 0 Тогда
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЦенныеБумаги.НомерСтроки КАК НомерСтроки,
			|	ЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	&ЦенныеБумаги КАК ЦенныеБумаги
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.НомерСтроки КАК НомерСтроки,
			|	ПРЕДСТАВЛЕНИЕ(_ЦенныеБумаги.УчетныйАктивЕПС) КАК УчетныйАктивЕПС,
			|	ПРЕДСТАВЛЕНИЕ(_ЦенныеБумаги.ЦеннаяБумага) КАК ЦеннаяБумага
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|ГДЕ
			|	_ЦенныеБумаги.УчетныйАктивЕПС <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяССылка)
			|	И НЕ _ЦенныеБумаги.УчетныйАктивЕПС В ИЕРАРХИИ (&РазрешенныеУчетныеАктивыЕПС)
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки
			|АВТОУПОРЯДОЧИВАНИЕ";
			
			Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги.Выгрузить(,"НомерСтроки, УчетныйАктивЕПС, ЦеннаяБумага"));
			Запрос.УстановитьПараметр("РазрешенныеУчетныеАктивыЕПС", РазрешенныеУчетныеАктивыЕПС);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для Рынка %1 в строке %2 для ценной бумаги %3 выбран не допустимый учетный актив ЕПС %4", Рынок, ВыборкаДетальныеЗаписи.НомерСтроки, ВыборкаДетальныеЗаписи.ЦеннаяБумага , ВыборкаДетальныеЗаписи.УчетныйАктивЕПС),,,,Отказ);
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	

#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоручениеНаДвижениеЦенныхБумаг") Тогда
		ЗаполнитьНаОСнованииПоручения(ДанныеЗаполнения);
	КонецЕсли;
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
	// очистим персонифицированные реквизиты
	ЭтотОбъект.Поручение = Документы.ПоручениеНаДвижениеЦенныхБумаг.ПустаяСсылка();
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
		
	Если ЭтотОбъект.Дата >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента() Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Для Каждого СтрокаЦеннойБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
		// Заполнение сумм в валюте учета
			
		Если ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаКупонаРынок) И Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаКупонаРынокВВалютеУчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Не заполнено поле ""Сумма купона (рынок) в валюте учета"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
				ЭтотОбъект,
				"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧГ=") + "].СуммаКупонаРынокВВалютеУчета",,
				Отказ
			);
		КонецЕсли;

		// Соответствие валюты номинала валюте документа
		
		Если ТипЗнч(СтрокаЦеннойБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.Акции")
			ИЛИ ТипЗнч(СтрокаЦеннойБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
			ИЛИ ТипЗнч(СтрокаЦеннойБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.Паи")
			ИЛИ ТипЗнч(СтрокаЦеннойБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.Векселя")
			ИЛИ ТипЗнч(СтрокаЦеннойБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.ИпотечныеСертификатыУчастия")
			ИЛИ ТипЗнч(СтрокаЦеннойБумаги.ЦеннаяБумага) = Тип("СправочникСсылка.ДепозитарныеРасписки")
		Тогда
			ВалютаНоминала = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЦеннойБумаги.ЦеннаяБумага, "ВалютаНоминала");
		Иначе
			ВалютаНоминала = Неопределено;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВалютаНоминала) И ВалютаНоминала <> ЭтотОбъект.Валюта Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Валюта номинала ценной бумаги """ + Строка(СтрокаЦеннойБумаги.ЦеннаяБумага) + """ отличается от валюты документа",
				ЭтотОбъект,
				"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧГ=") + "].ЦеннаяБумага",,
				Отказ
			);
		КонецЕсли;

	КонецЦикла;
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Предварительная обработка объекта
	
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);
	
	РаботаСДокументами.ЗаполнитьСтрокиПартии(ЭтотОбъект);
		
	// Блокирующие проверки
	
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;	

	Если РаботаСДокументами.ЭтоРежимПроведения(ЭтотОбъект, РежимЗаписи) Тогда
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Контрагент) И ЭтотОбъект.Дата >= РаботаСДокументами.ДатаНачалаПроверкиЗаполненияКонтрагента() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено значение реквизиита [Контрагент]!", ЭтотОбъект, "Контрагент",, Отказ);
		КонецЕсли;
		
		РаботаСДокументами.ПроверитьДатуИсполненияПоручения(ЭтотОбъект, Отказ);
		
		// Проверка заполнения рыночной стоимости
		
		УчетРыночнойСтоимостиАктивов = (ЭтотОбъект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));	
		
		Если УчетРыночнойСтоимостиАктивов Тогда 
			
			Для Каждого СтрокаЦеннойБумаги Из ЭтотОбъект.ЦенныеБумаги Цикл
		
				Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынок) ИЛИ Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынокВВалютеУчета) Тогда
					
					Если СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт
						ИЛИ СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Погашена
						ИЛИ СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ОценочнаяЦена
						ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы
						ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Опционы
						ИЛИ ЭтотОбъект.Рынок = Перечисления.РынкиЦенныхБумаг.Доли
					Тогда
						Продолжить;
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынок) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							"Не заполнено поле ""Сумма (рынок)"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
							ЭтотОбъект,
							"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧН=; ЧГ=") + "].СуммаРынок",,
							?(СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена, Ложь, Отказ)
						);
					КонецЕсли;				
					
					Если Не ЗначениеЗаполнено(СтрокаЦеннойБумаги.СуммаРынокВВалютеУчета) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							"Не заполнено поле ""Сумма (рынок) в валюте учета"" в строке " + Формат(СтрокаЦеннойБумаги.НомерСтроки, "ЧГ="),
							ЭтотОбъект,
							"ЦенныеБумаги[" + Формат(СтрокаЦеннойБумаги.НомерСтроки - 1, "ЧН=; ЧГ=") + "].СуммаРынокВВалютеУчета",,
							?(СтрокаЦеннойБумаги.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена, Ложь, Отказ)
						);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	РаботаСЖурналамиОпераций.ПриЗаписиДокумента(ЭтотОбъект);
	
	ПроверкаСоответствияРынкаИУчетныхАктивовЕПС(Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	РаботаСДокументами.СформироватьДвиженияПоРегистрамБэкОфиса(ЭтотОбъект, Отказ);
	
	РаботаСДокументами.СформироватьПроводки(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти
