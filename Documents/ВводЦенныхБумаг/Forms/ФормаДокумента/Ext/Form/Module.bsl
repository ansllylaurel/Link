
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.КорзинаЦенныхБумаг = Истина; // в этом документе всегда вкл. корзина ц/б
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	КонецЕсли;

	ЗаполнитьПодтверждениеОперацииНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперациинаСервере();
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоЦеннымБумагам",
		ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, ДепозитарныйСчет"))
	Тогда
		Объект.ДепозитарныйСчет = Неопределено;
	КонецЕсли;		
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.ДатаОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный") Тогда
		ЭтаФорма.ТипПередачи = 0;
	КонецЕсли;
	
	Объект.Контрагент = РаботаСДокументамиКлиент.ПолучитьКонтрагентаДляВводаВыводаАктивов(Объект.Дата, ЭтаФорма.ТипПередачи, Объект.Организация, Объект.СчетДоверительногоУправления);
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	РаботаСДокументамиКлиент.СчетДоверительногоУправленияОбработкаВыбора(Объект, ЭтаФорма, ВыбранноеЗначение, СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	Если Объект.Рынок = ЭтаФорма.ТекущийРынок Тогда // ничего менять не нужно
		Возврат;
	КонецЕсли;
	
	// на текущий момент выбор рынка закладных возможен только в сделке
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Закладные")
		И ТипЗнч(Объект.Ссылка) <> Тип("ДокументСсылка.Сделка")
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На текущий момент допускается только покупка закладных");
		Объект.Рынок = ЭтаФорма.ТекущийРынок;
		Возврат;
	КонецЕсли;
	
	Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа  = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок);
	Элементы.ЦенныеБумаги1ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	Элементы.ЦенныеБумаги2ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	Элементы.ЦенныеБумаги3ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	
	Если ЭтаФорма.ТекущийРынок <> ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.ПустаяСсылка") Тогда
		// если выбрана корзина ценных бумаг и добавлены строки корзины,
		// то после подтверждения очистим корзину
		ТребПодтверждение = Не ЭтаФорма.КорзинаЦенныхБумаг Или (ЭтаФорма.КорзинаЦенныхБумаг И Объект.ЦенныеБумаги.Количество() > 0);
		
		Если ТребПодтверждение Тогда
			Если Вопрос("Ценные бумаги и связанные с ними реквизиты будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда // возвращаем всё в зад
				Объект.Рынок = ЭтаФорма.ТекущийРынок;
				Возврат;
			Иначе
				РаботаСКорзинойЦенныхБумагКлиентСервер.ОчиститьРеквизиты(ЭтаФорма, Объект);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма.ТекущийРынок = Объект.Рынок;
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоручениеОчистка(Элемент, СтандартнаяОбработка)
	
	Если Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Поручение, "ПометкаУдаления") Тогда
		Если Вопрос("Пометить на удаление поручение? Документ ввода ценных бумаг будет записан и перепроведен (для проведенных)!", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			СтандартнаяОбработка = Ложь;
			ПометитьНаУдалениеПоручениеНаСервере();
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоручениеПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Поручение) Тогда
		Если Вопрос("Заполнить документ на основании выбранного поручения?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ЗаполнитьДокументНаОснованииПорученияНаСервере();
			ЭтаФорма.КорзинаЦенныхБумаг = Истина;
			НастроитьВидимостьИДоступность(ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПередачиПриИзменении(Элемент)
	
	Объект.Контрагент = РаботаСДокументамиКлиент.ПолучитьКонтрагентаДляВводаВыводаАктивов(Объект.Дата, ЭтаФорма.ТипПередачи, Объект.Организация, Объект.СчетДоверительногоУправления);
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ТЧ_ЦЕННЫЕ_БУМАГИ

&НаКлиенте
Процедура ЦенныеБумагиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда
		Элемент.ТекущиеДанные.СтрокаПартии = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиПриИзменении(Элемент)
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ИмяРодителя = Элемент.Имя; 	
	
	Если ЭтаФорма.ТолькоПросмотр И Поле.Имя = ИмяРодителя + "ЦеннаяБумага" Тогда
		ТекущиеДанные = Элементы[ИмяРодителя].ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ЦеннаяБумага) Тогда 
			ОткрытьЗначение(ТекущиеДанные.ЦеннаяБумага);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦеннаяБумагаПриИзменении(Элемент)
	
	ТаблицаФормы = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	
	ТекущиеДанные = ТаблицаФормы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда // не вводится новая строка
		ТекущиеДанные.ЦенаКотировки                 = 0;
		ТекущиеДанные.ЦенаКотировкиКупона			= 0;
		ТекущиеДанные.ВалютаКотировки				= Неопределено;
		ТекущиеДанные.ВалютаКотировкиКупона			= Неопределено;
		ТекущиеДанные.СуммаРынок					= 0;
		ТекущиеДанные.СуммаКупонаРынок				= 0;
		ТекущиеДанные.СуммаРынокВВалютеУчета       	= 0;
		ТекущиеДанные.СуммаКупонаРынокВВалютеУчета	= 0;
	КонецЕсли;
		
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ТаблицаФормы.ТекущаяСтрока, ТаблицаФормы.Имя);	
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ТаблицаФормы.Имя, "Количество", , Истина);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиКоличествоПриИзменении(Элемент)
	
	ТаблицаФормы  = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	ТекущиеДанные = ТаблицаФормы.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Количество > 0 И ТекущиеДанные.КоличествоНУ = 0 Тогда
		ТекущиеДанные.КоличествоНУ = ТекущиеДанные.Количество;
	КонецЕсли;
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ТаблицаФормы.Имя, "Количество", , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦенаКотировкиПриИзменении(Элемент)
	
	ТаблицаФормы = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ТаблицаФормы.Имя, "ЦенаКотировки", , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦенаКотировкиОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	ТекущиеДанные.ВалютаКотировки = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦенаКотировкиКупонаПриИзменении(Элемент)
	
	ТаблицаФормы = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ТаблицаФормы.Имя, "ЦенаКотировкиКупона", , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦенаКотировкиКупонаОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	ТекущиеДанные.ВалютаКотировкиКупона = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма);
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала), Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги", "Сумма", ВалютаСуммы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаКупонаПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма);
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала), Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги", "СуммаКупона", ВалютаСуммы);

КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаПереоценкиПриИзменении(Элемент)

	ТаблицаФормы  = ТаблицаФормыПоПодчиненномуЭлементу(Элемент);
	ТекущиеДанные = ТаблицаФормы.ТекущиеДанные;
		
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(ТекущиеДанные.ВалютаНоминала), ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета(ТаблицаФормы.Имя, "СуммаПереоценки", ВалютаСуммы);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаКупонаНачисленногоПриИзменении(Элемент)
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала), Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги", "СуммаКупонаНачисленного", ВалютаСуммы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаНУПриИзменении(Элемент)
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала), Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги", "СуммаНУ", ВалютаСуммы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаКупонаНУПриИзменении(Элемент)
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала), Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги", "СуммаКупонаНУ", ВалютаСуммы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиСуммаКупонаНачисленногоНУПриИзменении(Элемент)
	
	ВалютаСуммы = ?(ЗначениеЗаполнено(Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала), Элементы.ЦенныеБумаги.ТекущиеДанные.ВалютаНоминала, Объект.Валюта);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги", "СуммаКупонаНачисленногоНУ", ВалютаСуммы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1СуммаРынокПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	ТекущиеДанные.СуммаВсегоРынок = ТекущиеДанные.СуммаРынок + ТекущиеДанные.СуммаКупонаРынок;
	
	ВалютаНоминала	= ?(ЗначениеЗаполнено(ТекущиеДанные["ВалютаНоминала"]), ТекущиеДанные["ВалютаНоминала"], Объект.Валюта);
	ВалютаСуммы		= ?(ЗначениеЗаполнено(ТекущиеДанные["ВалютаКотировки"]), ТекущиеДанные["ВалютаКотировки"], ВалютаНоминала);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги1", "СуммаРынок", ВалютаСуммы, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумаги1СуммаКупонаРынокПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ЦенныеБумаги1.ТекущиеДанные;
	ТекущиеДанные.СуммаВсегоРынок = ТекущиеДанные.СуммаРынок + ТекущиеДанные.СуммаКупонаРынок;

	ВалютаНоминала	= ?(ЗначениеЗаполнено(ТекущиеДанные["ВалютаНоминала"]), ТекущиеДанные["ВалютаНоминала"], Объект.Валюта);
	ВалютаСуммы		= ?(ЗначениеЗаполнено(ТекущиеДанные["ВалютаКотировкиКупона"]), ТекущиеДанные["ВалютаКотировкиКупона"], ВалютаНоминала);
	
	ПересчетСуммыВВалютеУчета("ЦенныеБумаги1", "СуммаКупонаРынок", ВалютаСуммы, Истина);
	
КонецПроцедуры

