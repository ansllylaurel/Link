			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
			|				И &ЗаполняемРеклассы
			|			ТОГДА БухПартииЦенныхБумаг.Партия
			|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.РеклассификацияАктивовЕПС.ПустаяСсылка)
			|	КОНЕЦ КАК РеклассификацияАктивовЕПС,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
			|				И &ЗаполняемРеклассы
			|			ТОГДА БухПартииЦенныхБумаг.СтрокаПартии
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СтрокаРеклассификации,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.КорректировкаЭСП / РеклассификацияАктивовЕПСПартии.Количество * БухПартииЦенныхБумаг.Количество, 0) КАК КорректировкаЭСППриРеклассификации,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.Ссылка.Стоимость, 0) КАК ЦенаРеклассификации,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.ДисконтПремия / РеклассификацияАктивовЕПСПартии.Количество * БухПартииЦенныхБумаг.Количество, 0) КАК ДисконтПремияРеклассификации,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.Ссылка.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРеклассификации,
			|	ЕСТЬNULL(ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ВремяПокупки, РеклассификацияАктивовЕПСПартии.ВремяПокупки), ВЫБОР
			|			КОГДА БухПартииЦенныхБумаг.Партия ССЫЛКА Документ.Сделка
