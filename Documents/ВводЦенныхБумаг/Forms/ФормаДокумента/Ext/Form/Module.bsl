&НаКлиенте
Процедура КомандаОбновитьСделкиИзАктаПриемаПередачи(Команда)
	
	Если Вопрос("Данные по сделкам будут обновлены. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
	Тогда
		Возврат;
	КонецЕсли;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls)|*.xls|Лист Excel2007... (*.xlsx)|*.xlsx";

	Если Не ДиалогВыбора.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Обновление данных акта...");	

	ВременныйАдресФайла = ПолучитьИмяВременногоФайла();
	
	КопироватьФайл(ДиалогВыбора.ПолноеИмяФайла, ВременныйАдресФайла);
	
	БинарныйФайл = Новый ДвоичныеДанные(ВременныйАдресФайла);
	АдресФайлаВХранилище = ПоместитьВоВременноеХранилище(БинарныйФайл);
	
	ФайлЗагрузки = Новый Файл(ДиалогВыбора.ПолноеИмяФайла);
	
	ОбновитьСделкиИзАктаПриемаПередачиНаСервере(АдресФайлаВХранилище, СтрЗаменить(ФайлЗагрузки.Расширение, ".", ""));
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСделкиИзАктаПриемаПередачиНаСервере(АдресФайлаВХранилище, Расширение)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);

	БинарныйФайл = ПолучитьИзВременногоХранилища(АдресФайлаВХранилище);
	БинарныйФайл.Записать(ИмяВременногоФайла);    
	
	Попытка
		Excel = Новый ТабличныйДокумент;
		Excel.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Текст);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	НомСтр = 4;
	
	МаксимумСтрок = 10000; // По-хорошему это кол-во берется из самого Excel, но у нас и в загрузке тоже стоит 10000, поэтому не буду ломать традиции.
	
	МассивДанныхДляЗагрузки = Новый Массив;
	
	Пока НомСтр < МаксимумСтрок Цикл // защита от зацикливания
		
		РегНомерЦБ = Строка(Excel.Область(НомСтр, 3, НомСтр, 3).Текст);
		
		Если РегНомерЦБ = "" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загрузка завершена. Обработано " + Строка(НомСтр-4) + " строк.");
			Прервать;
		КонецЕсли;
		
		РегНомер = Excel.Область(НомСтр, 3, НомСтр, 3).Текст;
		
		ДатаПокупки = Строка(Excel.Область(НомСтр, 4, НомСтр, 4).Текст);
		
		Если ЗначениеЗаполнено(ДатаПокупки) Тогда
			
			Попытка
				НоваяДатаПокупки = СтрокаВДату(ДатаПокупки, ЧастиДаты.ДатаВремя);
				ДатаПокупкиТолькоДата = СтрокаВДату(ДатаПокупки, ЧастиДаты.Дата);
				ДатаПокупкиТолькоВремя = СтрокаВДату(ДатаПокупки, ЧастиДаты.Время);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить дату покупки из значения '" + ДатаПокупки + "'! Строка №" + НомСтр + " Загрузка прервана.");
				Прервать;
			КонецПопытки;
			
		КонецЕсли;
		
		// Если в процессе произошла ошибка, сообщим более подробно: что за ошибка, в какой строке.
		Попытка
			
			Количество 		= РаботаСоСтрокамиКлиентСервер.СтрокаВЧисло(СокрЛП(Excel.Область(НомСтр, 5, НомСтр, 5).Текст));
			НомерСделки		= РаботаСоСтрокамиКлиентСервер.СтрокаВЧисло(СокрЛП(Excel.Область(НомСтр, 7, НомСтр, 7).Текст));
			СуммаПокупки	= РаботаСоСтрокамиКлиентСервер.СтрокаВЧисло(СокрЛП(Excel.Область(НомСтр, 8, НомСтр, 8).Текст));
			Сумма			= РаботаСоСтрокамиКлиентСервер.СтрокаВЧисло(СокрЛП(Excel.Область(НомСтр, 19, НомСтр, 19).Текст));
			
		Исключение
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При загрузке из файла произошла ошибка: " + ОписаниеОшибки() + "!" + Символы.ПС + "Строка №" + НомСтр + " Загрузка прервана.");
			Прервать;
			
		КонецПопытки;
		
		Если ЗначениеЗаполнено(РегНомер) И ЗначениеЗаполнено(НоваяДатаПокупки) И ЗначениеЗаполнено(ДатаПокупкиТолькоДата) И ЗначениеЗаполнено(Количество)
			И ЗначениеЗаполнено(СуммаПокупки) И ЗначениеЗаполнено(Сумма) Тогда
			
			ДанныеДляЗагрузки = Новый Структура;
			ДанныеДляЗагрузки.Вставить("РегНомер", РегНомер);
			ДанныеДляЗагрузки.Вставить("НоваяДатаПокупки", НоваяДатаПокупки);
			ДанныеДляЗагрузки.Вставить("ДатаПокупкиТолькоДата", ДатаПокупкиТолькоДата);
			ДанныеДляЗагрузки.Вставить("ДатаПокупкиТолькоВремя", ДатаПокупкиТолькоВремя);
			ДанныеДляЗагрузки.Вставить("Количество", Количество);
			ДанныеДляЗагрузки.Вставить("НомерСделки", НомерСделки);
			ДанныеДляЗагрузки.Вставить("СуммаПокупки", СуммаПокупки);
			ДанныеДляЗагрузки.Вставить("Сумма", Сумма);
			ДанныеДляЗагрузки.Вставить("НомСтр", НомСтр);
			
			МассивДанныхДляЗагрузки.Добавить(ДанныеДляЗагрузки);
			
		КонецЕсли;	
		
		
		НомСтр = НомСтр + 1;
		
	КонецЦикла;
	
	
	ДокументИзменен = Ложь;
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Акции") Тогда
		ТипЦБСтрокой = "акцию";
	ИначеЕсли Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
		ТипЦБСтрокой = "облигацию";
	Иначе
		ТипЦБСтрокой = "пай";
	КонецЕсли;
	
	СтараяТаблицаЦенныеБумаги = Объект.ЦенныеБумаги.Выгрузить();
	СтараяТаблицаЦенныеБумаги.Колонки.Добавить("НомерСтрокиВТаблице", СтараяТаблицаЦенныеБумаги.Колонки.Найти("НомерСтроки").ТипЗначения);
	
	Для Каждого СтрокаСтараяТаблицаЦенныеБумаги Из СтараяТаблицаЦенныеБумаги Цикл
		СтрокаСтараяТаблицаЦенныеБумаги.НомерСтрокиВТаблице = СтрокаСтараяТаблицаЦенныеБумаги.НомерСтроки;	
	КонецЦикла;	
	
	ТаблицаПоискаПоРеклассам = СтараяТаблицаЦенныеБумаги.СкопироватьКолонки("ЦеннаяБумага, СтрокаПартии, ДатаПокупки, ВремяПокупки, НомерСделки");
	ТаблицаПоискаПоРеклассам.Колонки.Добавить("Партия", Метаданные.ОпределяемыеТипы.Партия.Тип);
	
	Для Каждого ЭлементМассиваДанныхДляЗагрузки Из МассивДанныхДляЗагрузки Цикл
		
		ЦеннаяБумага = НайтиЦеннуюБумагуПоРегНомеруИISINу(Объект.Рынок, ЭлементМассиваДанныхДляЗагрузки.РегНомер, Объект.Дата);
		
		Если ЦеннаяБумага = Неопределено Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить " + ТипЦБСтрокой + " по регистрационному номеру (или ISINу) '" + ЭлементМассиваДанныхДляЗагрузки.РегНомер + "'! Строка №" + ЭлементМассиваДанныхДляЗагрузки.НомСтр + ". Загрузка прервана.");
			Прервать;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЦеннаяБумага) И ЗначениеЗаполнено(ЭлементМассиваДанныхДляЗагрузки.НоваяДатаПокупки) И ЗначениеЗаполнено(ЭлементМассиваДанныхДляЗагрузки.ДатаПокупкиТолькоДата) И ЗначениеЗаполнено(ЭлементМассиваДанныхДляЗагрузки.Количество)
			И ЗначениеЗаполнено(ЭлементМассиваДанныхДляЗагрузки.СуммаПокупки) И ЗначениеЗаполнено(ЭлементМассиваДанныхДляЗагрузки.Сумма) Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("ЦеннаяБумага", ЦеннаяБумага);
			Отбор.Вставить("Количество", ЭлементМассиваДанныхДляЗагрузки.Количество);
			Отбор.Вставить("СуммаПокупки", ЭлементМассиваДанныхДляЗагрузки.СуммаПокупки);
			Отбор.Вставить("Сумма", ЭлементМассиваДанныхДляЗагрузки.Сумма);
			Отбор.Вставить("ДатаПокупки", ЭлементМассиваДанныхДляЗагрузки.ДатаПокупкиТолькоДата);
			
			НайденныеСтроки = СтараяТаблицаЦенныеБумаги.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					СтрокаЦенныеБумаги 				= Объект.ЦенныеБумаги.Получить(НайденнаяСтрока.НомерСтрокиВТаблице - 1);	
					СтрокаЦенныеБумаги.НомерСделки 	= ЭлементМассиваДанныхДляЗагрузки.НомерСделки;
					СтрокаЦенныеБумаги.ВремяПокупки	= ЭлементМассиваДанныхДляЗагрузки.ДатаПокупкиТолькоВремя;
					
					ДокументИзменен = Истина;
					
					СтараяТаблицаЦенныеБумаги.Удалить(НайденнаяСтрока);
					
					НоваяСтрокаПоискаПоРеклассам 						= ТаблицаПоискаПоРеклассам.Добавить();
					НоваяСтрокаПоискаПоРеклассам.ЦеннаяБумага 			= СтрокаЦенныеБумаги.ЦеннаяБумага;
					НоваяСтрокаПоискаПоРеклассам.Партия 				= Объект.Ссылка;
					НоваяСтрокаПоискаПоРеклассам.СтрокаПартии 			= СтрокаЦенныеБумаги.СтрокаПартии;
					НоваяСтрокаПоискаПоРеклассам.ДатаПокупки 			= СтрокаЦенныеБумаги.ДатаПокупки;
					НоваяСтрокаПоискаПоРеклассам.ВремяПокупки			= СтрокаЦенныеБумаги.ВремяПокупки;
					НоваяСтрокаПоискаПоРеклассам.НомерСделки 			= СтрокаЦенныеБумаги.НомерСделки;
					
					Прервать;
					
				КонецЦикла;	
				
			Иначе 
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе не найдено соответствие для " + ТипЦБСтрокой + " " + ЦеннаяБумага + " с Количеством " + Строка(ЭлементМассиваДанныхДляЗагрузки.Количество) + " на Сумму "  + Строка(ЭлементМассиваДанныхДляЗагрузки.Сумма) + " и с Суммой покупки " + Строка(ЭлементМассиваДанныхДляЗагрузки.СуммаПокупки)  + "!" + Символы.ПС + "Строка № " + ЭлементМассиваДанныхДляЗагрузки.НомСтр);
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если ДокументИзменен Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		НачатьТранзакцию();
		
		ОтборДатЗапретаРедактированияПоСчетуДУ = РегистрыСведений.ДатыЗапретаРедактирования.СформироватьСтруктуруОтбораДатЗапрета(Объект.Организация, Объект.СчетДоверительногоУправления);
		ДатыЗапретаРедактированияПоСчетуДУ     = РегистрыСведений.ДатыЗапретаРедактирования.ПолучитьДатыЗапретаРедактирования(ОтборДатЗапретаРедактированияПоСчетуДУ);
		
		ДатаДокументаМеньшеДатыЗапрета = РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьЗапретРедактирования(Объект.Дата, ДатыЗапретаРедактированияПоСчетуДУ);
		
		БлокировкаДанных = Новый БлокировкаДанных();
		
		БлокировкаДатЗапрета = БлокировкаДанных.Добавить("РегистрСведений.ДатыЗапретаРедактирования");
		БлокировкаДатЗапрета.УстановитьЗначение("Организация", Объект.Организация);
		БлокировкаДатЗапрета.УстановитьЗначение("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
		
		БлокировкаДанных.Заблокировать();
		
		Если ДатаДокументаМеньшеДатыЗапрета Тогда
			РегистрыСведений.ДатыЗапретаРедактирования.ОчиститьДатыЗапретаРедактирования(ОтборДатЗапретаРедактированияПоСчетуДУ);
		КонецЕсли;
		
		Попытка
			ОбъектНаСервере = РеквизитФормыВЗначение("Объект"); 
			
			ОбъектНаСервере.Записать(РежимЗаписиДокумента.Запись);
			
			ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
			
		Исключение	
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При загрузке из файла произошла ошибка: " + ОписаниеОшибки() + "!" + Символы.ПС + " Загрузка прервана.");
			
		КонецПопытки;	
		
		Если ТаблицаПоискаПоРеклассам.Количество() > 0 Тогда
			// Ищем связанные реклассы
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаПоискаПоРеклассам, "_ТаблицаПоискаПоРеклассам", Запрос.МенеджерВременныхТаблиц);
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РеклассификацияАктивовЕПСПартии.Ссылка КАК Ссылка,
				|	РеклассификацияАктивовЕПСПартии.НомерСтроки КАК НомерСтроки,
				|	_ТаблицаПоискаПоРеклассам.ДатаПокупки КАК ДатаПокупки,
				|	_ТаблицаПоискаПоРеклассам.ВремяПокупки КАК ВремяПокупки,
				|	_ТаблицаПоискаПоРеклассам.НомерСделки КАК НомерСделки,
				|	ПРЕДСТАВЛЕНИЕ(РеклассификацияАктивовЕПСПартии.Ссылка) КАК СсылкаПредставление
				|ИЗ
				|	Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПоискаПоРеклассам КАК _ТаблицаПоискаПоРеклассам
				|		ПО РеклассификацияАктивовЕПСПартии.Партия = _ТаблицаПоискаПоРеклассам.Партия
				|			И РеклассификацияАктивовЕПСПартии.СтрокаПартии = _ТаблицаПоискаПоРеклассам.СтрокаПартии
				|			И РеклассификацияАктивовЕПСПартии.Ссылка.ЦеннаяБумага = _ТаблицаПоискаПоРеклассам.ЦеннаяБумага
				|			И РеклассификацияАктивовЕПСПартии.ДатаПокупки = _ТаблицаПоискаПоРеклассам.ДатаПокупки
				|			И (РеклассификацияАктивовЕПСПартии.ВремяПокупки <> _ТаблицаПоискаПоРеклассам.ВремяПокупки
				|				ИЛИ РеклассификацияАктивовЕПСПартии.НомерСделки <> _ТаблицаПоискаПоРеклассам.НомерСделки)
				|ИТОГИ ПО
				|	Ссылка";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаСсылка.Следующий() Цикл
				
				РеклассификацияАктивовЕПСОбъект = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
				
				ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					
					СтрокаПартии = РеклассификацияАктивовЕПСОбъект.Партии.Получить(ВыборкаДетальныеЗаписи.НомерСтроки - 1);
					СтрокаПартии.ВремяПокупки = ВыборкаДетальныеЗаписи.ВремяПокупки;
					СтрокаПартии.НомерСделки = ВыборкаДетальныеЗаписи.НомерСделки;
					
				КонецЦикла;
				
				Попытка
					
					РеклассификацияАктивовЕПСОбъект.Записать(РежимЗаписиДокумента.Запись);
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обновлен по ссылкам документ реклассификации " + ВыборкаСсылка.СсылкаПредставление); 				
					
				Исключение	
					
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При загрузке из файла произошла ошибка: Не получилось обновить по ссылкам документ " +  + " " + ОписаниеОшибки() + "!");
					
				КонецПопытки;	
				
			КонецЦикла;
			
		КонецЕсли;
		
		РегистрыСведений.ДатыЗапретаРедактирования.УстановитьДатыЗапретаРедактирования(ДатыЗапретаРедактированияПоСчетуДУ, ОтборДатЗапретаРедактированияПоСчетуДУ, "Обновление ввода ценных бумаг.");
		
		ЗафиксироватьТранзакцию();
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗаполнитьИзВывода(Команда)
	
	ЗаполнитьИзВывода();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьЦенныеБумагиИКоличествоИзВывода(Команда)
	
	ЗаполнитьИзВывода(Ложь, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьИзВыводаВПривилегированномРежиме(Команда)
	
	ЗаполнитьИзВывода(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьРыночнуюСтоимость(Команда)
	
	Если Вопрос("Текущие значения рыночных цен будут изменены на расчетные. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьРыночнуюСтоимость();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗадатьВалютуКотировки(Команда)
	
	ИмяКорзины		= "ЦенныеБумаги1";
	ТекущиеДанные	= Элементы[ИмяКорзины].ТекущиеДанные;
	
	ВыбраннаяВалюта = ВыбратьВалюту(ТекущиеДанные.ВалютаКотировки, "Валюта котировки");
	Если ВыбраннаяВалюта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ВалютаКотировки = ВыбраннаяВалюта;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ЦенаКотировки) Тогда 
		РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ИмяКорзины, "ЦенаКотировки", , Истина);
	Иначе
		ПересчетСуммыВВалютеУчета(ИмяКорзины, "СуммаРынок", ВыбраннаяВалюта, Истина);
	КонецЕсли;
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗадатьВалютуКотировкиКупона(Команда)
	
	ИмяКорзины		= "ЦенныеБумаги1";
	ТекущиеДанные	= Элементы[ИмяКорзины].ТекущиеДанные;
	
	ВыбраннаяВалюта = ВыбратьВалюту(ТекущиеДанные.ВалютаКотировкиКупона, "Валюта котировки купона");
	Если ВыбраннаяВалюта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ВалютаКотировкиКупона = ВыбраннаяВалюта;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ЦенаКотировкиКупона) Тогда 
		РаботаСКорзинойЦенныхБумагКлиентСервер.Пересчитать(ЭтаФорма, ИмяКорзины, "ЦенаКотировкиКупона", , Истина);
	Иначе
		ПересчетСуммыВВалютеУчета(ИмяКорзины, "СуммаКупонаРынок", ВыбраннаяВалюта, Истина);
	КонецЕсли;
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура КомандаРасшифроватьРасчет(Команда)
	
	Отказ = Ложь;	
	
	ТаблицаФормыЦенныеБумаги = Элементы.ЦенныеБумаги1;
	
	ТекущиеДанные = ТаблицаФормыЦенныеБумаги.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ Не ЗначениеЗаполнено(ТекущиеДанные.ЦеннаяБумага) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для расшифровки", , , "Объект.ЦенныеБумаги");
		Возврат;
	КонецЕсли;
	
	// Формируем расшифровку расчета
	
	РасшифровкаРасчета = Новый Структура;
	РасшифровкаРасчета.Вставить("ЦеннаяБумага",	ТекущиеДанные.ЦеннаяБумага);
	РасшифровкаРасчета.Вставить("Операции",		Новый Массив);
	
	ПересчитатьРыночнуюСтоимость(ТаблицаФормыЦенныеБумаги.ТекущаяСтрока, Отказ, РасшифровкаРасчета);
	
	Если ТипЗнч(РасшифровкаРасчета) = Тип("ТабличныйДокумент") Тогда
		РасшифровкаРасчета.Показать("Расчет стоимости '" + Строка(ТекущиеДанные.ЦеннаяБумага) + "'");		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьАмортизированнуюСтоимость(Команда)
	
	ИдентификаторыСтрок = ПолучитьИдентификаторыСтрокБумагОцениваемыхПоАмортизированнойСтоимости();
	
	Если ИдентификаторыСтрок.Количество() = 0
		ИЛИ Вопрос("Текущие значения рыночных цен бумаг, оцениваемых по амортизированной стоимости, будут изменены на расчетные. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да
	Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьРыночнуюСтоимость(ИдентификаторыСтрок);

КонецПроцедуры

&НаКлиенте
Процедура КомандаКонтрольПроцентныхПоказателей(Команда)
	
	РезультатПроверки = КонтрольПроцентныхПоказателейНаСервере();
	Если ТипЗнч(РезультатПроверки) = Тип("ТабличныйДокумент") Тогда
		РезультатПроверки.ТолькоПросмотр = Истина;
		РезультатПроверки.ОтображатьСетку = Ложь;
		РезультатПроверки.Показать("Контроль заполнения ввода " + Строка(Объект));
	ИначеЕсли РезультатПроверки Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Все правильно - проблем нет");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьПрисоединенныеФайлы()

	РаботаСФайловымХранилищемКлиент.ОткрытьПрисоединенныеФайлы(Объект.Ссылка);

КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаКлиенте
Функция ТаблицаФормыПоПодчиненномуЭлементу(Элемент)
	
	ТаблицаФормы = Элемент;
	
	Пока ТипЗнч(ТаблицаФормы) <> Тип("ТаблицаФормы") Цикл
		ТаблицаФормы = ТаблицаФормы.Родитель;
	КонецЦикла;
	
	Возврат ТаблицаФормы;
	
КонецФункции

&НаКлиенте
Функция ВыбратьВалюту(Знач ТекущееЗначение, Подсказка = "")
	Если ВвестиЗначение(ТекущееЗначение, Подсказка, Тип("СправочникСсылка.Валюты")) Тогда
		Возврат ТекущееЗначение;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ПересчетСуммыВВалютеУчета(ИмяКорзины = "ЦенныеБумаги", ИмяСуммы, ВалютаСуммы, ПересчитатьРынок = Ложь)
	
	ТекущиеДанные = Элементы[ИмяКорзины].ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные[ИмяСуммы + "ВВалютеУчета"]) Тогда
		Если Вопрос("Пересчитать сумму в валюте учёта?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ДатаКурса = ?(ПересчитатьРынок ИЛИ Не ЗначениеЗаполнено(ТекущиеДанные.ДатаПокупки), Объект.Дата, ТекущиеДанные.ДатаПокупки); 
	ТекущиеДанные[ИмяСуммы + "ВВалютеУчета"] = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(ТекущиеДанные[ИмяСуммы], ВалютаСуммы, Объект.Организация, ДатаКурса);
	
	Если ПересчитатьРынок Тогда
		ПересчитатьСуммуВсегоРынокВВалютеУчета(ИмяКорзины);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуВсегоРынокВВалютеУчета(ИмяКорзины)

	ТекущиеДанные = Элементы[ИмяКорзины].ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.СуммаВсегоРынокВВалютеУчета = ТекущиеДанные.СуммаРынокВВалютеУчета + ТекущиеДанные.СуммаКупонаРынокВВалютеУчета;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()
	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиЦеннуюБумагуПоРегНомеруИISINу(Рынок, РегНомер, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Акции.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ГосударственныйРегистрационныйНомер = &РегНомер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КодыВТорговыхСистемахСрезПоследних.Объект
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			&Период,
		|			ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|				И Код = &РегНомер) КАК КодыВТорговыхСистемахСрезПоследних";
		
	Если Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Акции", "Облигации");
	ИначеЕсли Рынок = Перечисления.РынкиЦенныхБумаг.Паи Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Акции", "Паи");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("РегНомер", РегНомер);
	Запрос.УстановитьПараметр("Период", Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	ДанныеОбъекта = Форма.Объект;
	Элементы	  = Форма.Элементы;
	
	// в зависимости от рынка
	ЭтоРынокОблигаций = (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"));
	ЭтоРынокВекселей  = (ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Векселя"));
	
	Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа  = РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(ДанныеОбъекта.Рынок);
	Элементы.ЦенныеБумаги1ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	Элементы.ЦенныеБумаги2ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	Элементы.ЦенныеБумаги3ЦеннаяБумага.ОграничениеТипа = Элементы.ЦенныеБумагиЦеннаяБумага.ОграничениеТипа;
	
	Элементы.ЦенныеБумагиКупоны.Видимость              = ЭтоРынокОблигаций;
	Элементы.ЦенныеБумагиКупоныНачисленные.Видимость   = ЭтоРынокОблигаций;
	
	Элементы.ЦенныеБумаги1ГруппаКотировкиКупона.Видимость			= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаКупона.Видимость				= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаКупонаВВалютеУчета.Видимость	= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаВсего.Видимость				= ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги1ГруппаСуммаВсегоВВалютеУчета.Видимость	= ЭтоРынокОблигаций;
	
	Элементы.ЦенныеБумаги3РезервПодОбесценениеКупонаПокупки.Видимость     = ЭтоРынокОблигаций;
	Элементы.ЦенныеБумаги3РезервПодОбесценениеКупонаНачисленный.Видимость = ЭтоРынокОблигаций;

	Элементы.ГруппаДебиторскаяЗадолженность.Видимость = ЭтоРынокОблигаций;
	
	СобственныйСчетДУ = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъекта.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") = ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный"));

	Элементы.ТипПередачи.Видимость = Не СобственныйСчетДУ;
	Элементы.Контрагент.АвтоОтметкаНезаполненного = РаботаСДокументамиКлиентСервер.ТребуетсяПроверкаЗаполненияЗначенияКонтрагента(ДанныеОбъекта);
	Элементы.Контрагент.ТолькоПросмотр = Форма.ТипПередачи < 2 И Не СобственныйСчетДУ;

	Если ДанныеОбъекта.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации")  
		И БухгалтерскийУчет.ОпределитьНастройкуУчета(ДанныеОбъекта.Дата, ДанныеОбъекта.Организация, ДанныеОбъекта.СчетДоверительногоУправления, "ВестиЕдиныйБухгалтерскийУчет") Тогда 
		Элементы.ЦенныеБумаги1СверитьЭСПпоВводуВыводу.Видимость = Истина;
	Иначе
		Элементы.ЦенныеБумаги1СверитьЭСПпоВводуВыводу.Видимость = Ложь;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьИтоговыеСтроки(Форма)
	
	КорзинаЦенныхБумаг = Форма.Объект.ЦенныеБумаги;
		
	Итоги = Новый Структура("ИтогСуммаВсего, ИтогСуммаВсегоРынок, ИтогСуммаВсегоРынокВВалютеУчета, ИтогСуммаВсегоНУ, ИтогСуммаЕПСБезКупона, ИтогСуммаВсегоЕПС",
		КорзинаЦенныхБумаг.Итог("Сумма") + КорзинаЦенныхБумаг.Итог("СуммаКупона"),
		КорзинаЦенныхБумаг.Итог("СуммаРынок") + КорзинаЦенныхБумаг.Итог("СуммаКупонаРынок"),
		КорзинаЦенныхБумаг.Итог("СуммаРынокВВалютеУчета") + КорзинаЦенныхБумаг.Итог("СуммаКупонаРынокВВалютеУчета"),
		КорзинаЦенныхБумаг.Итог("СуммаНУ") + КорзинаЦенныхБумаг.Итог("СуммаКупонаНУ"),
		КорзинаЦенныхБумаг.Итог("Сумма") + КорзинаЦенныхБумаг.Итог("ДисконтПремияНачисленный") + КорзинаЦенныхБумаг.Итог("СуммаПереоценки") + КорзинаЦенныхБумаг.Итог("СуммаИндексацииНоминала") + КорзинаЦенныхБумаг.Итог("КорректировкаЭСП"),
		КорзинаЦенныхБумаг.Итог("Сумма") + КорзинаЦенныхБумаг.Итог("ДисконтПремияНачисленный") + КорзинаЦенныхБумаг.Итог("СуммаПереоценки") + КорзинаЦенныхБумаг.Итог("СуммаИндексацииНоминала") + КорзинаЦенныхБумаг.Итог("КорректировкаЭСП") + КорзинаЦенныхБумаг.Итог("СуммаКупона") + КорзинаЦенныхБумаг.Итог("СуммаКупонаНачисленного")
	);
	
	ЗаполнитьЗначенияСвойств(Форма, Итоги); 	
			
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	ЭтаФорма.ТекущийРынок = Объект.Рынок;
		
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыИКотировкиЦенныхБумаг(ЭтаФорма, Объект);
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления") <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.Собственный") Тогда
	
		ЭтаФорма.ТипПередачи = РаботаСДокументами.ПолучитьТипПередачиДляВводаВыводаАктивов(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Объект.Контрагент);
		
	КонецЕсли;
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаОснованииПорученияНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект"); 
	ОбъектНаСервере.ЗаполнитьНаОСнованииПоручения(Объект.Поручение);
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");
	
	ПриЧтенииСозданииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПометитьНаУдалениеПоручениеНаСервере()
	
	Поручение = Объект.Поручение.ПолучитьОбъект();
	
	НачатьТранзакцию();
	
	Попытка
		Объект.Поручение = Документы.ПоручениеНаДвижениеЦенныхБумаг.ПустаяСсылка();
		Поручение.УстановитьПометкуУдаления(Истина);
		Поручение.Записать();
		Если Объект.Проведен Тогда
			ЭтаФорма.ПриЗаписиПерепроводить = Истина;
		Иначе	
			ЭтаФорма.ПриЗаписиПерепроводить = Ложь;
		КонецЕсли;
		Если ЭтаФорма.Записать() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось пометить на удаление поручение " + Объект.Поручение + "! "+ ОписаниеОшибки(),,,,);
	КонецПопытки;

КонецПроцедуры	

&НаКлиенте
Процедура ПересчитатьРыночнуюСтоимость(ИдентификаторСтроки = Неопределено, Отказ = Ложь, РасшифровкаРасчета = Неопределено)
	
	// Проверяем, что заведены настройки оценки, и подгружаем файл с оценочной стоимостью, предоставленной клиентом
	
	ОшибкаРасчетаРыночнойСтоимости = Ложь;	
	
	ЦельРасчета				= ПредопределенноеЗначение("Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении");
	НастройкиОценки			= РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, ЦельРасчета);
	АдресТаблицыСтоимостей	= Неопределено;
	
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЦельРасчета + "'", , , , ОшибкаРасчетаРыночнойСтоимости);
		
	ИначеЕсли НастройкиОценки.ВариантРасчетаОценочнойСтоимости = ПредопределенноеЗначение("Справочник.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом") Тогда
		
		АдресТаблицыСтоимостей = РаботаСВнешнимиСистемамиКлиентСервер.ВыбратьФайлОценочнойСтоимостиПредоставленнойКлиентом(
			Объект.СчетДоверительногоУправления, Объект.Дата, Ложь, ЭтаФорма.УникальныйИдентификатор);
		Если Не ЭтоАдресВременногоХранилища(АдресТаблицыСтоимостей) Тогда
			ОшибкаРасчетаРыночнойСтоимости = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОшибкаРасчетаРыночнойСтоимости Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Рыночная стоимость не рассчитана.", , , , Отказ);		
		Возврат;
	КонецЕсли;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		РасшифровкаРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиОценки.ВариантРасчетаОценочнойСтоимости);	
	КонецЕсли;
	
	// Пересчет рыночной стоимости
		
	ПересчитатьРыночнуюСтоимостьНаСервере(ИдентификаторСтроки, АдресТаблицыСтоимостей, РасшифровкаРасчета);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьРыночнуюСтоимостьНаСервере(ИдентификаторСтроки = Неопределено, АдресТаблицыСтоимостей = Неопределено, РасшифровкаРасчета = Неопределено)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьРыночнуюСтоимостьЦенныхБумаг(Объект, "ЦенныеБумаги", АдресТаблицыСтоимостей, ИдентификаторСтроки, , , РасшифровкаРасчета);
	
	Если РасшифровкаРасчета = Неопределено Тогда

		ЗаполнитьИтоговыеСтроки(ЭтаФорма);
		
	Иначе
		
		#Область Формирование_отчета_по_расшифровке_расчета_стоимости_бумаги
		
		Если РасшифровкаРасчета.Операции.Количество() = 0 Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета стоимости для варианта '" + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости + "' не реализована");	
			РасшифровкаРасчета = Неопределено;

		Иначе

			Отчет = Новый ТабличныйДокумент;
			
			ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("Вариант расчета справедливой стоимости: " + РасшифровкаРасчета.ВариантРасчетаОценочнойСтоимости, , , Отчет);
			ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
			
			РаботаСДокументами.СформироватьРасшифровкуОперации(РасшифровкаРасчета, ПараметрыВывода);
			
			РасшифровкаРасчета = Отчет;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено, ИмяКорзины = "ЦенныеБумаги")
	
	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыИКотировкиЦенныхБумаг(ЭтаФорма, Объект,, НомерСтрокиКорзины);
	
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиПоБухгалтерскомуУчету()

	РаботаСФормамиКлиент.ПровестиПоБухгалтерскомуУчету(ЭтаФорма); 

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзВывода(ПривилегированныйРежим = Ложь, ТолькоКоличество = Ложь)
	
	Если Объект.ЦенныеБумаги.Количество() > 0 Тогда
		Если Вопрос("Табличная часть будет очищена! Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	СписокВыводов = РаботаСДокументами.СписокВыводовЦенныхБумагПоПрочимОрганизациям(Объект.Дата, ПривилегированныйРежим, ТолькоКоличество);	
	Если СписокВыводов = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ВыводЦенныхБумаг = ОткрытьФормуМодально("ОбщаяФорма.ВыборИзСпискаСФильтрацией", Новый Структура("Список, Заголовок", СписокВыводов, "Выводы ценных бумаг"));
	
	Если ВыводЦенныхБумаг = Неопределено Или ВыводЦенныхБумаг = КодВозвратаДиалога.Отмена Тогда // Неопределено, если нажали ESC
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Если Вопрос("Для продолжения заполнения текущий документ необходимо записать. Записать документ?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;	
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьИзВыводаНаСервере(ВыводЦенныхБумаг, ПривилегированныйРежим, ТолькоКоличество);

	Попытка
		Записать();
	Исключение
		Объект.ЦенныеБумаги.Очистить();
		Возврат;
	КонецПопытки;	
	
	// Заполним ставки ЭСП автоматически
	ЗаписатьДокументВыводЦБ(Объект.Ссылка, ВыводЦенныхБумаг);
	
	Если Объект.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации")
		И БухгалтерскийУчет.ОпределитьНастройкуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, "ВестиЕдиныйБухгалтерскийУчет") Тогда
	
		ПараметрыФормы = Новый Структура("ДокументВводЦБ, ТолькоПросмотр, ВызовДляАвтоматическогоЗаполнения", Объект.Ссылка, ЭтаФорма.ТолькоПросмотр, Истина);
		ОткрытьФормуМодально("Документ.ВводЦенныхБумаг.Форма.ФормаСверкаЭСП", ПараметрыФормы);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзВыводаНаСервере(ВыводЦенныхБумаг, ПривилегированныйРежим = Ложь, ТолькоКоличество = Ложь)
	
	Если Не ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран счет д/у!", , "СчетДоверительногоУправления", "Объект.СчетДоверительногоУправления");
		Возврат;
	КонецЕсли;
	
	Если ТолькоКоличество Тогда	
		
		РаботаСДокументами.ЗаполнитьЦенныеБумагиИКоличествоИзВыводаЦенныхБумаг(ЭтаФорма.Объект, ВыводЦенныхБумаг, ПривилегированныйРежим);

	Иначе

		Если ПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;
			
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления);
		
		Если НастройкиУчета.ВестиЕдиныйБухгалтерскийУчет Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения использованы данные ЕПС");
			ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
		ИначеЕсли НастройкиУчета.ВестиБухгалтерскийУчет Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения использованы данные РСБУ");
			ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет;
		ИначеЕсли НастройкиУчета.ВестиНалоговыйУчет Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения использованы данные НУ");
			ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет;
		КонецЕсли;
		
		#Область Текст_запроса_партий_вывода
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумаг.Количество КАК Количество,
			|	БухПартииЦенныхБумаг.Количество КАК КоличествоНУ,
			|	БухПартииЦенныхБумаг.Стоимость КАК Сумма,
			|	ВЫБОР
			|		КОГДА &ПереносДанныхНУ
			|			ТОГДА ЕСТЬNULL(БухПартииЦенныхБумагНУ.Стоимость, БухПартииЦенныхБумаг.СтоимостьПокупки)
			|		ИНАЧЕ БухПартииЦенныхБумаг.СтоимостьПокупки
			|	КОНЕЦ КАК СуммаНУ,
			|	БухПартииЦенныхБумаг.СтоимостьКупона КАК СуммаКупона,
			|	БухПартииЦенныхБумаг.СтоимостьКупона КАК СуммаКупонаНУ,
			|	БухПартииЦенныхБумаг.ПереоценкаКупона КАК СуммаКупонаНачисленного,
			|	ВЫБОР
			|		КОГДА &ПереносДанныхНУ
			|			ТОГДА ЕСТЬNULL(БухПартииЦенныхБумагНУ.ПереоценкаКупона, БухПартииЦенныхБумаг.ПереоценкаКупона)
			|		ИНАЧЕ БухПартииЦенныхБумаг.ПереоценкаКупона
			|	КОНЕЦ КАК СуммаКупонаНачисленногоНУ,
			|	БухПартииЦенныхБумаг.Переоценка КАК СуммаПереоценки,
			|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК СуммаПереоценкиВВалютеУчета,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.ДисконтПремия / РеклассификацияАктивовЕПСПартии.Количество * БухПартииЦенныхБумаг.Количество, БухПартииЦенныхБумаг.ДисконтПремия) КАК ДисконтПремия,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.ДисконтПремияПокупки / РеклассификацияАктивовЕПСПартии.Количество * БухПартииЦенныхБумаг.Количество, БухПартииЦенныхБумаг.ДисконтПремияПокупки) КАК ДисконтПремияПокупки,
			|	БухПартииЦенныхБумаг.ДисконтПремияНачисленный КАК ДисконтПремияНачисленный,
			|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчета КАК ДисконтПремияНачисленныйВВалютеУчета,
			|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.СуммаПокупки / РеклассификацияАктивовЕПСПартии.Количество * БухПартииЦенныхБумаг.Количество, БухПартииЦенныхБумаг.СтоимостьПокупки) КАК СуммаПокупки,
			|	БухПартииЦенныхБумаг.СтоимостьПокупкиКупона КАК СуммаПокупкиКупона,
			|	БухПартииЦенныхБумаг.КорректировкаЭСП КАК КорректировкаЭСП,
			|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета,
			|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
			|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
			|	БухПартииЦенныхБумаг.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчета,
			|	ВЫБОР
			|		КОГДА БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости <> 0
			|			ТОГДА БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости
			|		КОГДА &ПереносДанныхНУ
			|			ТОГДА ЕСТЬNULL(БухПартииЦенныхБумагНУ.РасходыПриПокупкеВСтоимости, БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости)
			|		ИНАЧЕ БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимости
			|	КОНЕЦ КАК РасходыПриПокупкеВСтоимости,
			|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета КАК СуммаВВалютеУчета,
			|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СуммаКупонаВВалютеУчета,
			|	БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК СуммаКупонаНачисленногоВВалютеУчета,
			|	ВЫБОР
			|		КОГДА &ПереносДанныхНУ
			|			ТОГДА ЕСТЬNULL(БухПартииЦенныхБумагНУ.СтоимостьВВалютеУчета, БухПартииЦенныхБумаг.СтоимостьВВалютеУчета)
			|		ИНАЧЕ БухПартииЦенныхБумаг.СтоимостьВВалютеУчета
			|	КОНЕЦ КАК СуммаНУВВалютеУчета,
			|	БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета КАК СуммаКупонаНУВВалютеУчета,
			|	ВЫБОР
			|		КОГДА &ПереносДанныхНУ
			|			ТОГДА ЕСТЬNULL(БухПартииЦенныхБумагНУ.ПереоценкаКупонаВВалютеУчета, БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета)
			|		ИНАЧЕ БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета
			|	КОНЕЦ КАК СуммаКупонаНачисленногоНУВВалютеУчета,
			|	0 КАК ДебиторскаяЗадолженность,
			|	0 КАК ДебиторскаяЗадолженностьНУ,
			|	БухПартииЦенныхБумаг.ЗадолженностьПоПогашениюКупонаВВалютеУчета КАК ДебиторскаяЗадолженностьКупон,
			|	БухПартииЦенныхБумаг.ЗадолженностьПоПогашениюКупона КАК ДебиторскаяЗадолженностьКупонНУ,
			|	ЛОЖЬ КАК Частичная,
			|	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, РеклассификацияАктивовЕПСПартии.ДатаПокупки), БухПартииЦенныхБумаг.Партия.Дата), ДЕНЬ) КАК ДатаПокупки,
			|	0 КАК СтрокаПартии,
			|	0 КАК ЭффективнаяСтавкаПроцента,
			|	0 КАК Номинал,
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаНоминала,
			|	0 КАК СуммаВсего,
			|	0 КАК СуммаВсегоВВалютеУчета,
			|	БухПартииЦенныхБумаг.СуммаРезервовПодОбесценение КАК РезервПодОбесценение,
			|	0 КАК РезервПодОбесценениеКупонаПокупки,
			|	БухПартииЦенныхБумаг.СуммаРезервовПодОбесценениеКупона КАК РезервПодОбесценениеКупонаНачисленный,
			|	БухПартииЦенныхБумаг.СуммаРезервовПоСомнительнымДолгам КАК РезервПодСомнительныеДолги,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Партия) = ТИП(Документ.Сделка)
			|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумаг.Партия КАК Документ.Сделка).НомерСделки
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
			|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(БухПартииЦенныхБумаг.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Партия) = ТИП(Документ.ВводЦенныхБумаг)
			|			ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
			|			ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
			|		ИНАЧЕ ""9999999999999999""
			|	КОНЕЦ КАК НомерСделки,
			|	ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт2 КАК Резерв,
