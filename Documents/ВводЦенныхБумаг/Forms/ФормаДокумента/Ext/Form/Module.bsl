			|			ИНАЧЕ ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Партия.Дата, ДЕНЬ), БухПартииЦенныхБумаг.Партия.Дата, СЕКУНДА))
			|		КОНЕЦ) КАК ВремяПокупки
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумагЦенныеБумаги
			|		ПО (ВыводЦенныхБумагЦенныеБумаги.Ссылка = &Регистратор)
			|			И (ВыводЦенныхБумагЦенныеБумаги.ЦеннаяБумага = БухПартииЦенныхБумаг.ЦеннаяБумага)
			|			И (ВыводЦенныхБумагЦенныеБумаги.СтрокаПартии = 0
			|				ИЛИ ВыводЦенныхБумагЦенныеБумаги.Партия = БухПартииЦенныхБумаг.Партия
			|					И ВыводЦенныхБумагЦенныеБумаги.СтрокаПартии = БухПартииЦенныхБумаг.СтрокаПартии)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
			|		ПО БухПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
			|			И БухПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
			|		ПО (&Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
			|			И БухПартииЦенныхБумаг.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
			|			И БухПартииЦенныхБумаг.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумагиСРеклассом
			|		ПО (&Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
			|			И БухПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумагиСРеклассом.РеклассификацияАктивовЕПС
			|			И БухПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумагиСРеклассом.СтрокаРеклассификации
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумагНУ
			|		ПО (&ПереносДанныхНУ)
			|			И БухПартииЦенныхБумаг.Регистратор = БухПартииЦенныхБумагНУ.Регистратор
			|			И (БухПартииЦенныхБумагНУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
			|			И БухПартииЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагНУ.ЦеннаяБумага
			|			И БухПартииЦенныхБумаг.ВидДвижения = БухПартииЦенныхБумагНУ.ВидДвижения
			|			И (БухПартииЦенныхБумаг.Партия = БухПартииЦенныхБумагНУ.Партия
			|					И БухПартииЦенныхБумаг.СтрокаПартии = БухПартииЦенныхБумагНУ.СтрокаПартии
			|				ИЛИ &Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					И БухПартииЦенныхБумагНУ.Партия = РеклассификацияАктивовЕПСПартии.Партия
			|					И БухПартииЦенныхБумагНУ.СтрокаПартии = РеклассификацияАктивовЕПСПартии.СтрокаПартии
			|				ИЛИ &Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					И ВводЦенныхБумагЦенныеБумагиСРеклассом.Ссылка = БухПартииЦенныхБумагНУ.Партия
			|					И ВводЦенныхБумагЦенныеБумагиСРеклассом.СтрокаПартии = БухПартииЦенныхБумагНУ.СтрокаПартии)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ДвиженияССубконто(, , Регистратор = &Регистратор, , ) КАК ЕдиныйБухгалтерскийУчетДвиженияССубконто
			|		ПО (&Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
			|			И БухПартииЦенныхБумаг.УчетныйАктивЕПС.СчетУчетаРезервов = ЕдиныйБухгалтерскийУчетДвиженияССубконто.СчетДт
			|			И БухПартииЦенныхБумаг.ЦеннаяБумага = ЕдиныйБухгалтерскийУчетДвиженияССубконто.СубконтоДт1
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ПО (СтоимостьПереоценки.Организация = БухПартииЦенныхБумаг.Организация)
			|			И (СтоимостьПереоценки.СчетДоверительногоУправления = БухПартииЦенныхБумаг.СчетДоверительногоУправления)
			|			И (СтоимостьПереоценки.Период = &Период)
			|			И (СтоимостьПереоценки.ЦельРасчета = &ЦельРасчета)
			|			И (СтоимостьПереоценки.ВидЦеныОценки = &ВидЦеныОценки)
			|			И (СтоимостьПереоценки.Рынок = БухПартииЦенныхБумаг.Рынок)
			|			И (СтоимостьПереоценки.ЦеннаяБумага = БухПартииЦенныхБумаг.ЦеннаяБумага)
			|			И (СтоимостьПереоценки.Партия = БухПартииЦенныхБумаг.Партия)
			|			И (СтоимостьПереоценки.СтрокаПартии = БухПартииЦенныхБумаг.СтрокаПартии)
			|			И (СтоимостьПереоценки.ВидУчета = &ВидУчета)
			|			И (&ВыполнятьРасчетПоПисьмуЦБ0185316)
			|ГДЕ
			|	БухПартииЦенныхБумаг.Регистратор = &Регистратор
			|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
			|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЦеннаяБумага,
			|	ДатаПокупки,
			|	НомерСделки,
			|	БухПартииЦенныхБумаг.Партия,
			|	БухПартииЦенныхБумаг.СтрокаПартии");
		
		#КонецОбласти
		
		// 1. Номиналы и суммы всего считаем в ЗаполнитьНоминалыИСуммыВсегоВТаблице
		// 2. Рыночную стоимость бумаг, оцениваемых по амортизированной стоимости, заполняем в ПересчитатьРыночнуюСтоимостьНаСервере
		// 3. Если считаем по письму ЦБ РФ, предполагаем, что клиент, с которого выводили бумаги, также работает по нему.
		//    Сведения по рынку берем на предыдущий рабочий, т.к. в этот день их уже нет - вывели, а если работают по письму, то цены не меняются.
		
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
		ИспользуетсяОценкаПоАС = Ложь;
		Если Объект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			ИспользуетсяОценкаПоАС = РаботаСПереоценкой.ИспользуетсяОценкаПоАмортизированнойСтоимости(НастройкиОценки.ВариантРасчетаОценочнойСтоимости, Объект.Дата);
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Рынок",								Объект.Рынок);
		Запрос.УстановитьПараметр("Регистратор",						ВыводЦенныхБумаг);
		Запрос.УстановитьПараметр("ВидУчета",							ВидУчета);
		Запрос.УстановитьПараметр("ПереносДанныхНУ",					БухгалтерскийУчет.ОпределитьНастройкуУчета(Объект.Дата, Объект.Организация, Объект.СчетДоверительногоУправления, "ВестиНалоговыйУчет"));
		
		Запрос.УстановитьПараметр("ИспользуетсяОценкаПоАС",				ИспользуетсяОценкаПоАС);
		Запрос.УстановитьПараметр("УчетныеАктивыОцениваемыеПоАС",		Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости());
		
		Запрос.УстановитьПараметр("ВыполнятьРасчетПоПисьмуЦБ0185316",	НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316);
		Запрос.УстановитьПараметр("ВидЦеныОценки",						Перечисления.ВидыЦенОценки.ЦенаОценки);
		Запрос.УстановитьПараметр("ЦельРасчета",						Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		Запрос.УстановитьПараметр("Период",								Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ВыводЦенныхБумаг.Дата) - 1, -1));
		Запрос.УстановитьПараметр("ЗаполняемРеклассы",					Объект.Дата < Документы.ВводЦенныхБумаг.ДатаОтказаОтНепроведенныхРеклассовВоВводеЦенныхБумаг());
		
		Объект.ЦенныеБумаги.Загрузить(Запрос.Выполнить().Выгрузить());
		
		Если Объект.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			МассивРеклассов = Новый Массив();
			Для каждого СтрокаЦенныеБумаги Из Объект.ЦенныеБумаги Цикл
				Если СтрокаЦенныеБумаги.РеклассификацияАктивовЕПС <> Документы.РеклассификацияАктивовЕПС.ПустаяСсылка()
					И МассивРеклассов.Найти(СтрокаЦенныеБумаги.РеклассификацияАктивовЕПС) = Неопределено Тогда
				
					МассивРеклассов.Добавить(СтрокаЦенныеБумаги.РеклассификацияАктивовЕПС);
				
				КонецЕсли;
			
			КонецЦикла;
			
			Если МассивРеклассов.Количество() > 0 Тогда
				
				Если ПривилегированныйРежим Тогда
				
					СоответствиеРеклассов = ПеренестиРеклассы(МассивРеклассов);
					
				Иначе
					
					УстановитьПривилегированныйРежим(Истина);
					СоответствиеРеклассов = ПеренестиРеклассы(МассивРеклассов);
					УстановитьПривилегированныйРежим(Ложь);
					
				КонецЕсли;
				
				Для каждого СтрокаРеклассы Из СоответствиеРеклассов Цикл
				                                    
					СтрокиЦенныеБумаги = Объект.ЦенныеБумаги.НайтиСтроки(Новый Структура("РеклассификацияАктивовЕПС", СтрокаРеклассы.Ключ));
					
					Для каждого СтрокаЦенныеБумаги Из СтрокиЦенныеБумаги Цикл
						
						СтрокаЦенныеБумаги.РеклассификацияАктивовЕПС = СтрокаРеклассы.Значение;
					
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПривилегированныйРежим Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	
	КонецЕсли;
	
	Объект.ЦенныеБумаги.Загрузить(
		РаботаСЦеннымиБумагами.ЗаполнитьНоминалыИСуммыВсегоВТаблице(
			Объект.ЦенныеБумаги.Выгрузить(), Объект.Дата, Объект.Организация));
	
	Если Не ТолькоКоличество И ИспользуетсяОценкаПоАС Тогда
		
		ИдентификаторыСтрок = ПолучитьИдентификаторыСтрокБумагОцениваемыхПоАмортизированнойСтоимости();
		
		Если ИдентификаторыСтрок.Количество() > 0 Тогда
			ПересчитатьРыночнуюСтоимостьНаСервере(ИдентификаторыСтрок);
		КонецЕсли;
		
	КонецЕсли;
			
	ЗаполнитьИтоговыеСтроки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИдентификаторыСтрокБумагОцениваемыхПоАмортизированнойСтоимости()
	
	ИдентификаторыСтрок = Новый Массив;
	
	УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости = Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости();
	
	Для каждого СтрокаЦенныеБумаги Из Объект.ЦенныеБумаги Цикл
	
		Если УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости.Найти(СтрокаЦенныеБумаги.УчетныйАктивЕПС) <> Неопределено Тогда
			
			ИдентификаторыСтрок.Добавить(СтрокаЦенныеБумаги.ПолучитьИдентификатор());	
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ИдентификаторыСтрок;
	
КонецФункции

&НаСервере
Функция КонтрольПроцентныхПоказателейНаСервере()
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ТекущийОбъект.КонтрольПроцентныхПоказателей();
	
КонецФункции

&НаСервере
Функция ПеренестиРеклассы(МассивРеклассов)

	СоответствиеРеклассов = Новый Соответствие();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеклассификацияАктивовЕПС.Ссылка КАК Ссылка,
		|	РеклассификацияАктивовЕПС.Дата КАК Дата,
		|	РеклассификацияАктивовЕПС.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _РеклассыИсходные
		|ИЗ
		|	Документ.РеклассификацияАктивовЕПС КАК РеклассификацияАктивовЕПС
		|ГДЕ
		|	РеклассификацияАктивовЕПС.Ссылка В(&МассивРеклассов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДокументРеклассификацияАктивовЕПС.Ссылка КАК Ссылка,
		|	ДокументРеклассификацияАктивовЕПС.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ДопустимыеРеклассификации
		|ИЗ
		|	Документ.РеклассификацияАктивовЕПС КАК ДокументРеклассификацияАктивовЕПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ДокументРеклассификацияАктивовЕПС.Ссылка = ВводЦенныхБумагЦенныеБумаги.РеклассификацияАктивовЕПС
		|			И (ВводЦенныхБумагЦенныеБумаги.Ссылка <> &НашВвод)
		|			И (НЕ ВводЦенныхБумагЦенныеБумаги.Ссылка.ПометкаУдаления)
		|			И (ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен)
		|ГДЕ
		|	ДокументРеклассификацияАктивовЕПС.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НЕ ДокументРеклассификацияАктивовЕПС.ПометкаУдаления
		|	И НЕ ДокументРеклассификацияАктивовЕПС.Проведен
		|	И ДокументРеклассификацияАктивовЕПС.ЦеннаяБумага В
		|			(ВЫБРАТЬ
		|				_РеклассыИсходные.ЦеннаяБумага
		|			ИЗ
		|				_РеклассыИсходные)
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РеклассыИсходные.Ссылка КАК РеклассИсходный,
		|	ЕСТЬNULL(_ДопустимыеРеклассификации.Ссылка, ЗНАЧЕНИЕ(Документ.РеклассификацияАктивовЕПС.ПустаяСсылка)) КАК РеклассНовый
		|ИЗ
		|	_РеклассыИсходные КАК _РеклассыИсходные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДопустимыеРеклассификации КАК _ДопустимыеРеклассификации
		|		ПО _РеклассыИсходные.ЦеннаяБумага = _ДопустимыеРеклассификации.ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("НашВвод", Объект.Ссылка);
	Запрос.УстановитьПараметр("МассивРеклассов", МассивРеклассов);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.РеклассНовый = Документы.РеклассификацияАктивовЕПС.ПустаяСсылка() Тогда
			
			ДокументРекласса = Документы.РеклассификацияАктивовЕПС.СоздатьДокумент();
			
		Иначе
			
			ДокументРекласса = ВыборкаДетальныеЗаписи.РеклассНовый.ПолучитьОбъект();
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДокументРекласса, ВыборкаДетальныеЗаписи.РеклассИсходный);
		ДокументРекласса.Партии.Загрузить(ВыборкаДетальныеЗаписи.РеклассИсходный.Партии.Выгрузить());
		
		ДокументРекласса.Номер = "";
		ДокументРекласса.Проведен = Ложь;
		ДокументРекласса.ПометкаУдаления = Ложь;
		
		ДокументРекласса.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
		
		ДокументРекласса.Записать(РежимЗаписиДокумента.Запись);
		
		СоответствиеРеклассов.Вставить(ВыборкаДетальныеЗаписи.РеклассИсходный, ДокументРекласса.Ссылка);
		
	КонецЦикла;

	Возврат СоответствиеРеклассов;
	
КонецФункции

&НаКлиенте
Процедура СверитьЭСПпоВводуВыводу(Команда)
	
	Если Модифицированность Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Записать();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ДокументВводЦБ, ТолькоПросмотр", Объект.Ссылка, ЭтаФорма.ТолькоПросмотр);
	ОткрытьФормуМодально("Документ.ВводЦенныхБумаг.Форма.ФормаСверкаЭСП", ПараметрыФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста 	
Процедура ЗаписатьДокументВыводЦБ(ДокументВводЦБ, ДокументВыводЦБ)
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "ДокументВыводаЦБДляОпределенияЭСП");
	
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		ВызватьИсключение("Не найдено свойство для сохранения Документа вывода ЦБ.");	
	КонецЕсли;	
	
	Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
	Запись.Объект = ДокументВводЦБ;
	Запись.Свойство = Свойство;
	Запись.Значение = ДокументВыводЦБ; 
	Запись.Записать();
	
КонецПроцедуры	

#КонецОбласти
