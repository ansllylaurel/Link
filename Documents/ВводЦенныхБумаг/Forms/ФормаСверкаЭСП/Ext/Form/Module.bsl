&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)      
	
	ЭтотОбъект.ДокументВводЦБ = ЭтаФорма.Параметры.ДокументВводЦБ;
	ЭтаФорма.ТолькоПросмотр = ЭтаФорма.Параметры.ТолькоПросмотр;
	ЭтаФорма.Элементы.ДокументВыводЦБПредставление.ТолькоПросмотр = ЭтаФорма.Параметры.ТолькоПросмотр;
	ЭтаФорма.Параметры.Свойство("ВызовДляАвтоматическогоЗаполнения", ВызовДляАвтоматическогоЗаполнения);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДокументВводЦБ) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияДополнительныхСведений.Значение КАК Значение,
		|	ПРЕДСТАВЛЕНИЕ(ЗначенияДополнительныхСведений.Значение) КАК ПредставлениеЗначение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДокументВыводаЦБДляОпределенияЭСП""
		|	И ЗначенияДополнительныхСведений.Объект = &Объект";
		
		Запрос.УстановитьПараметр("Объект", ЭтотОбъект.ДокументВводЦБ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			ВыборкаСтроки = РезультатЗапроса.Выбрать();
			Пока ВыборкаСтроки.Следующий() Цикл        
				ДокументВыводЦБ = ВыборкаСтроки.Значение;	
				ДокументВыводЦБПредставление = ВыборкаСтроки.ПредставлениеЗначение;
			КонецЦикла;	
			
		Иначе 
			
			ЗапросВывод = Новый Запрос; 
			ЗапросВывод.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
			|ПОМЕСТИТЬ _КлиентДУ
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _СчетаДУКлиента
			|ИЗ
			|	_КлиентДУ КАК _КлиентДУ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|			ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
			|				И (НЕ СчетаДоверительногоУправления.ПометкаУдаления)
			|				И (СчетаДоверительногоУправления.ДатаЗаключения <= &Период)
			|				И (СчетаДоверительногоУправления.ДатаРасторжения > &Период
			|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
			|		ПО _КлиентДУ.Клиент = КлиентыДоверительногоУправленияСрезПоследних.Клиент
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	ВыводЦенныхБумаг.Ссылка КАК Значение,
			|	ПРЕДСТАВЛЕНИЕ(ВыводЦенныхБумаг.Ссылка) КАК ПредставлениеЗначение
			|ИЗ
			|	Документ.ВыводЦенныхБумаг КАК ВыводЦенныхБумаг
			|ГДЕ
			|	ВыводЦенныхБумаг.Проведен
			|	И НЕ ВыводЦенныхБумаг.ПометкаУдаления
			|	И ВыводЦенныхБумаг.СчетДоверительногоУправления В
			|			(ВЫБРАТЬ
			|				_СчетаДУКлиента.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|			ИЗ
			|				_СчетаДУКлиента КАК _СчетаДУКлиента)
			|	И ВыводЦенныхБумаг.Рынок = &Рынок
			|	И НАЧАЛОПЕРИОДА(ВыводЦенныхБумаг.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)";
			
			ЗапросВывод.УстановитьПараметр("ВводЦБ", ЭтотОбъект.ДокументВводЦБ);
			ЗапросВывод.УстановитьПараметр("Период", ЭтотОбъект.ДокументВводЦБ.Дата);
			ЗапросВывод.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.ДокументВводЦБ.СчетДоверительногоУправления);
			ЗапросВывод.УстановитьПараметр("Организация", ЭтотОбъект.ДокументВводЦБ.Организация);
			ЗапросВывод.УстановитьПараметр("Рынок", ЭтотОбъект.ДокументВводЦБ.Рынок);
			
			РезультатЗапросаВывод = ЗапросВывод.Выполнить();
			
			ВыборкаДетальныеЗаписиВывод = РезультатЗапросаВывод.Выбрать();
			
			Пока ВыборкаДетальныеЗаписиВывод.Следующий() Цикл
				
				ДокументВыводЦБ = ВыборкаДетальныеЗаписиВывод.Значение;	
				ДокументВыводЦБПредставление = ВыборкаДетальныеЗаписиВывод.ПредставлениеЗначение;
				
				ЗаписатьДокументВыводЦБ(ЭтотОбъект.ДокументВводЦБ, ДокументВыводЦБ);
				
			КонецЦикла;	
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаСверкиРасчет = СверитьЭСПпоВводуВыводуНаСервере(ЭтотОбъект.ДокументВводЦБ, Отказ); 
	Если ТаблицаСверкиРасчет <> Неопределено Тогда 
		ЭтаФорма.ТаблицаСверки.Загрузить(ТаблицаСверкиРасчет);  
	КонецЕсли;
	
	Если ВызовДляАвтоматическогоЗаполнения Тогда
		ОформитьРегистрацииНаСервере(Отказ);	
		Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СверитьЭСПпоВводуВыводуНаСервере(ДокументВводЦБ, Отказ)

	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Значение КАК Документ.ВыводЦенныхБумаг).СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	ЗначенияДополнительныхСведений.Значение КАК Документ,
	|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Значение КАК Документ.ВыводЦенныхБумаг).Организация КАК Организация,
	|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Значение КАК Документ.ВыводЦенныхБумаг).Дата КАК Дата
	|ПОМЕСТИТЬ _ДанныеВыводЦБ
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|ГДЕ
	|	ЗначенияДополнительныхСведений.Объект = &ВводЦБ
	|	И ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДокументВыводаЦБДляОпределенияЭСП""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия КАК Партия,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии КАК СтрокаПартии,
	|	МАКСИМУМ(РешенияКлиентовПоЗначениямЭСПСрезПоследних.ДатаНачалаДействия) КАК ДатаНачалаДействия,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ПОМЕСТИТЬ _РешенияМаксДата
	|ИЗ
	|	РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
	|			&Период,
	|			СчетДоверительногоУправления В
	|				(ВЫБРАТЬ
	|					&СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|			
	|				ОБЪЕДИНИТЬ ВСЕ
	|			
	|				ВЫБРАТЬ
	|					_ДанныеВыводЦБ.СчетДоверительногоУправления
	|				ИЗ
	|					_ДанныеВыводЦБ КАК _ДанныеВыводЦБ)) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЦеннаяБумага,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СчетДоверительногоУправления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_РешенияМаксДата.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_РешенияМаксДата.Партия КАК Партия,
	|	_РешенияМаксДата.СтрокаПартии КАК СтрокаПартии,
	|	_РешенияМаксДата.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	_РешенияМаксДата.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЭСП КАК ЭСП,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Регистратор КАК Документ,
	|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Используется КАК Используется
	|ПОМЕСТИТЬ _РешенияЭСП
	|ИЗ
	|	_РешенияМаксДата КАК _РешенияМаксДата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
	|				&Период,
	|				СчетДоверительногоУправления В
	|					(ВЫБРАТЬ
	|						&СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|				
	|					ОБЪЕДИНИТЬ ВСЕ
	|				
	|					ВЫБРАТЬ
	|						_ДанныеВыводЦБ.СчетДоверительногоУправления
	|					ИЗ
	|						_ДанныеВыводЦБ КАК _ДанныеВыводЦБ)) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних
	|		ПО _РешенияМаксДата.СчетДоверительногоУправления = РешенияКлиентовПоЗначениямЭСПСрезПоследних.СчетДоверительногоУправления
	|			И _РешенияМаксДата.ЦеннаяБумага = РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЦеннаяБумага
	|			И _РешенияМаксДата.Партия = РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия
	|			И _РешенияМаксДата.СтрокаПартии = РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии
	|			И _РешенияМаксДата.ДатаНачалаДействия = РешенияКлиентовПоЗначениямЭСПСрезПоследних.ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БухПартииЦенныхБумаг.Партия КАК Партия,
	|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
	|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	БухПартииЦенныхБумаг.Количество КАК Количество,
	|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.ДатаПокупки, НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Партия.Дата, ДЕНЬ))) КАК ДатаПокупки,
	|	ЕСТЬNULL(_РешенияЭСП.ЭСП, -1) КАК ЭСП,
	|	ВЫБОР
	|		КОГДА РеклассификацияАктивовЕПСПартии.СуммаПокупки ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумаг.СтоимостьПокупки / БухПартииЦенныхБумаг.Количество КАК ЧИСЛО(27, 12))
	|		ИНАЧЕ ВЫРАЗИТЬ(РеклассификацияАктивовЕПСПартии.СуммаПокупки / РеклассификацияАктивовЕПСПартии.Количество КАК ЧИСЛО(27, 12))
	|	КОНЕЦ КАК Цена,
	|	_РешенияЭСП.Документ КАК Документ,
	|	ЕСТЬNULL(_РешенияЭСП.Используется, ИСТИНА) КАК Используется
	|ПОМЕСТИТЬ _ВыводимыеПартии
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
	|		ПО БухПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
	|			И БухПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
	|		ПО БухПартииЦенныхБумаг.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
	|			И БухПартииЦенныхБумаг.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ _РешенияЭСП КАК _РешенияЭСП
	|		ПО БухПартииЦенныхБумаг.СчетДоверительногоУправления = _РешенияЭСП.СчетДоверительногоУправления
	|			И БухПартииЦенныхБумаг.ЦеннаяБумага = _РешенияЭСП.ЦеннаяБумага
	|			И БухПартииЦенныхБумаг.Партия = _РешенияЭСП.Партия
	|			И БухПартииЦенныхБумаг.СтрокаПартии = _РешенияЭСП.СтрокаПартии
	|ГДЕ
	|	БухПартииЦенныхБумаг.Регистратор В
	|			(ВЫБРАТЬ
	|				_ДанныеВыводЦБ.Документ КАК Документ
	|			ИЗ
	|				_ДанныеВыводЦБ КАК _ДанныеВыводЦБ)
	|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
	|	И БухПартииЦенныхБумаг.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
	|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ВводЦенныхБумагЦенныеБумаги.Ссылка КАК Партия,
	|	ВводЦенныхБумагЦенныеБумаги.СтрокаПартии КАК СтрокаПартии,
	|	ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	ВводЦенныхБумагЦенныеБумаги.Количество КАК Количество,
	|	ВводЦенныхБумагЦенныеБумаги.ДатаПокупки КАК ДатаПокупки,
	|	ЕСТЬNULL(_РешенияЭСП.ЭСП, -1) КАК ЭСП,
	|	ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.СуммаПокупки / ВводЦенныхБумагЦенныеБумаги.Количество КАК ЧИСЛО(27, 12)) КАК Цена,
	|	_РешенияЭСП.Документ КАК Документ,
	|	ЕСТЬNULL(_РешенияЭСП.Используется, ИСТИНА) КАК Используется
	|ПОМЕСТИТЬ _ВводимыеПартии
	|ИЗ
	|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
	|		ЛЕВОЕ СОЕДИНЕНИЕ _РешенияЭСП КАК _РешенияЭСП
	|		ПО (_РешенияЭСП.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|					И ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага = _РешенияЭСП.ЦеннаяБумага
	|					И ВводЦенныхБумагЦенныеБумаги.Ссылка = _РешенияЭСП.Партия
	|					И ВводЦенныхБумагЦенныеБумаги.СтрокаПартии = _РешенияЭСП.СтрокаПартии
	|				ИЛИ ВводЦенныхБумагЦенныеБумаги.РеклассификацияАктивовЕПС = _РешенияЭСП.Партия
	|					И ВводЦенныхБумагЦенныеБумаги.СтрокаРеклассификации = _РешенияЭСП.СтрокаПартии
	|					И ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага = _РешенияЭСП.ЦеннаяБумага)
	|ГДЕ
	|	ВводЦенныхБумагЦенныеБумаги.Ссылка = &ВводЦБ
	|	И ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВыводимыеПартии.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ВыводимыеПартии.Партия КАК ПартияВывод,
	|	ПРЕДСТАВЛЕНИЕ(_ВыводимыеПартии.Партия) КАК ПартияВыводПредставление,
	|	_ВыводимыеПартии.СтрокаПартии КАК СтрокаПартииВывод,
	|	_ВыводимыеПартии.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	_ВыводимыеПартии.Количество КАК Количество,
	|	_ВыводимыеПартии.ДатаПокупки КАК ДатаПокупки,
	|	_ВводимыеПартии.Партия КАК ПартияВвод,
	|	_ВводимыеПартии.СтрокаПартии КАК СтрокаПартииВвод,
	|	_ВыводимыеПартии.ЭСП КАК ЭСПВывод,
	|	_ВводимыеПартии.ЭСП КАК ЭСПВвод,
	|	_ВводимыеПартии.Документ КАК Документ,
	|	_ВводимыеПартии.Используется КАК ИспользуетсяВвод,
	|	_ВыводимыеПартии.Используется КАК ИспользуетсяВывод
	|ПОМЕСТИТЬ _Итоговая
	|ИЗ
	|	_ВыводимыеПартии КАК _ВыводимыеПартии
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводимыеПартии КАК _ВводимыеПартии
	|		ПО _ВыводимыеПартии.ЦеннаяБумага = _ВводимыеПартии.ЦеннаяБумага
	|			И _ВыводимыеПартии.УчетныйАктивЕПС = _ВводимыеПартии.УчетныйАктивЕПС
	|			И _ВыводимыеПартии.Количество = _ВводимыеПартии.Количество
	|			И _ВыводимыеПартии.ДатаПокупки = _ВводимыеПартии.ДатаПокупки
	|			И _ВыводимыеПартии.Цена = _ВводимыеПартии.Цена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Итоговая.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Итоговая.ПартияВывод КАК ПартияВывод,
	|	_Итоговая.СтрокаПартииВывод КАК СтрокаПартииВывод,
	|	_Итоговая.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	_Итоговая.Количество КАК Количество,
	|	_Итоговая.ДатаПокупки КАК ДатаПокупки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Итоговая.ПартияВвод) КАК ПартияВвод,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Итоговая.СтрокаПартииВвод) КАК СтрокаПартииВвод
	|ПОМЕСТИТЬ _ДублированныеСтроки
	|ИЗ
	|	_Итоговая КАК _Итоговая
	|
	|СГРУППИРОВАТЬ ПО
	|	_Итоговая.ЦеннаяБумага,
	|	_Итоговая.ПартияВывод,
	|	_Итоговая.СтрокаПартииВывод,
	|	_Итоговая.УчетныйАктивЕПС,
	|	_Итоговая.Количество,
	|	_Итоговая.ДатаПокупки
	|
	|ИМЕЮЩИЕ
	|	(КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Итоговая.ПартияВвод) > 1
	|		ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Итоговая.СтрокаПартииВвод) > 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Итоговая.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Итоговая.ПартияВывод КАК ПартияВывод,
	|	_Итоговая.ПартияВыводПредставление КАК ПартияВыводПредставление,
	|	_Итоговая.СтрокаПартииВывод КАК СтрокаПартииВывод,
	|	_Итоговая.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	|	_Итоговая.Количество КАК Количество,
	|	_Итоговая.ДатаПокупки КАК ДатаПокупки,
	|	_Итоговая.ПартияВвод КАК ПартияВвод,
	|	_Итоговая.СтрокаПартииВвод КАК СтрокаПартииВвод,
	|	_Итоговая.ЭСПВывод КАК ЭСПВывод,
	|	_Итоговая.ЭСПВвод КАК ЭСПВвод,
	|	_Итоговая.Документ КАК Документ,
	|	_Итоговая.ИспользуетсяВвод КАК ИспользуетсяВвод,
	|	_Итоговая.ИспользуетсяВывод КАК ИспользуетсяВывод
	|ИЗ
	|	_Итоговая КАК _Итоговая
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЦеннаяБумага,
	|	ПартияВвод,
	|	СтрокаПартииВвод";
	
	Запрос.УстановитьПараметр("ВводЦБ", ДокументВводЦБ);
	Запрос.УстановитьПараметр("Период", ДокументВводЦБ.Дата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ДокументВводЦБ.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ДокументВводЦБ.Организация);
	Запрос.УстановитьПараметр("Рынок", ДокументВводЦБ.Рынок);


	ЦенныеБумагиВвод = Новый ТаблицаЗначений;
	ЦенныеБумагиВвод.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ЦенныеБумагиВвод.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ЦенныеБумагиВвод.Колонки.Добавить("Партия",  Метаданные.ОпределяемыеТипы.Партия.Тип);
	ЦенныеБумагиВвод.Колонки.Добавить("СтрокаПартии", Новый ОписаниеТипов("Число"));
	ЦенныеБумагиВвод.Колонки.Добавить("УчетныйАктивЕПС", Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ЦенныеБумагиВвод.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	
	ЦенныеБумагиВывод = ЦенныеБумагиВвод.СкопироватьКолонки();
	
	Индекс = 0;
	
	// партии вывода могут быть по другой организации. Поэтому, 
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаСверкиРасчет = Запрос.Выполнить().Выгрузить();
	ТаблицаСверкиРасчет.Колонки.Добавить("Отметка", Новый ОписаниеТипов("Булево"));
	
	ТаблицаДублированныеСтроки = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДублированныеСтроки").ПолучитьДанные().Выгрузить(); 
	Если ТаблицаДублированныеСтроки.Количество() > 0 Тогда
		//Был вывод одинаковых ЦБ с одинаковым количеством, датой и ценой покупки. И они в ТаблицаСверкиРасчет сейчас дублированы. Надо это чистить.
		Для Каждого СтрокаДублированныеСтроки Из ТаблицаДублированныеСтроки Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("ЦеннаяБумага", СтрокаДублированныеСтроки.ЦеннаяБумага);
			Отбор.Вставить("ПартияВывод", СтрокаДублированныеСтроки.ПартияВывод);
			Отбор.Вставить("СтрокаПартииВывод", СтрокаДублированныеСтроки.СтрокаПартииВывод);
			Отбор.Вставить("Количество", СтрокаДублированныеСтроки.Количество);
			Отбор.Вставить("ДатаПокупки", СтрокаДублированныеСтроки.ДатаПокупки);
			
			СтрокиОтбора = ТаблицаСверкиРасчет.НайтиСтроки(Отбор);
			
			Если СтрокиОтбора.Количество() > 1 Тогда
				// Удаляем строки кроме первой	
				СчетчикСтрок = 1;
				Для Каждого СтрокаДляУдаления Из СтрокиОтбора Цикл
					Если СчетчикСтрок = 1 Тогда
						// Эту строку оставляем поэтому ищем другие её вводы и сносим их
						ОтборПоВводам = Новый Структура;
						ОтборПоВводам.Вставить("ЦеннаяБумага", СтрокаДляУдаления.ЦеннаяБумага);
						ОтборПоВводам.Вставить("ПартияВвод", СтрокаДляУдаления.ПартияВвод);
						ОтборПоВводам.Вставить("СтрокаПартииВвод", СтрокаДляУдаления.СтрокаПартииВвод);
						ОтборПоВводам.Вставить("Количество", СтрокаДляУдаления.Количество);
						ОтборПоВводам.Вставить("ДатаПокупки", СтрокаДляУдаления.ДатаПокупки);
						
						СтрокиОтбораПоВводам = ТаблицаСверкиРасчет.НайтиСтроки(ОтборПоВводам);
						
						Для Каждого СтрокаОтбораПоВводам Из СтрокиОтбораПоВводам Цикл
							Если СтрокаОтбораПоВводам <> СтрокаДляУдаления Тогда
								// Удаляем эти строки из ТаблицаСверкиРасчет
								ТаблицаСверкиРасчет.Удалить(СтрокаОтбораПоВводам);
							КонецЕсли;
						КонецЦикла;	
						
					Иначе	
						// Удаляем эти строки из ТаблицаСверкиРасчет
						ТаблицаСверкиРасчет.Удалить(СтрокаДляУдаления);
					КонецЕсли;	
					СчетчикСтрок = СчетчикСтрок + 1;	
				КонецЦикла;	
			КонецЕсли;	
			
		КонецЦикла;
	КонецЕсли;	
	
	Для Каждого СтрокаТаблицыСверки Из ТаблицаСверкиРасчет Цикл
	
		СтрокаЦБВывод = ЦенныеБумагиВывод.Добавить();
		СтрокаЦБВывод.НомерСтроки = Индекс;
		СтрокаЦБВывод.ЦеннаяБумага = СтрокаТаблицыСверки.ЦеннаяБумага;
		СтрокаЦБВывод.Партия = СтрокаТаблицыСверки.ПартияВывод;
		СтрокаЦБВывод.СтрокаПартии = СтрокаТаблицыСверки.СтрокаПартииВывод;
		СтрокаЦБВывод.УчетныйАктивЕПС = СтрокаТаблицыСверки.УчетныйАктивЕПС;
		СтрокаЦБВывод.Количество = СтрокаТаблицыСверки.Количество;

		СтрокаЦБВвод = ЦенныеБумагиВвод.Добавить();
		СтрокаЦБВвод.НомерСтроки = Индекс;
		СтрокаЦБВвод.ЦеннаяБумага = СтрокаТаблицыСверки.ЦеннаяБумага;
		СтрокаЦБВвод.Партия = СтрокаТаблицыСверки.ПартияВвод;
		СтрокаЦБВвод.СтрокаПартии = СтрокаТаблицыСверки.СтрокаПартииВвод;
		СтрокаЦБВвод.УчетныйАктивЕПС = СтрокаТаблицыСверки.УчетныйАктивЕПС;
		СтрокаЦБВвод.Количество = СтрокаТаблицыСверки.Количество;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Отказ = Ложь;
	
	ДанныеВыводЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДанныеВыводЦБ").ПолучитьДанные().Выгрузить(); 
	Если ДанныеВыводЦБ.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно провести сверку. Не найден документа Вывода ЦБ на " + Формат(ДокументВводЦБ.Дата, "ДФ=dd.MM.yyyy"),,,,Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаВывод =  ДанныеВыводЦБ[0].Дата;
	ОрганизацияВывод = ДанныеВыводЦБ[0].Организация;
	СчетДоверительногоУправленияВывод = ДанныеВыводЦБ[0].СчетДоверительногоУправления;   
		
	НастройкиУчетаОбщиеВывод = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДатаВывод, ОрганизацияВывод, СчетДоверительногоУправленияВывод);
	НастройкиУчетаОбщиеВвод = БухгалтерскийУчет.ОпределитьНастройкиУчета(ДокументВводЦБ.Дата, ДокументВводЦБ.Организация, ДокументВводЦБ.СчетДоверительногоУправления);
	
	ТаблицаДатИЦенПокупкиВывод = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ЦенныеБумагиВывод, СчетДоверительногоУправленияВывод, ДатаВывод).Выгрузить();
	ТаблицаДатИЦенПокупкиВвод = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ЦенныеБумагиВвод, ДокументВводЦБ.СчетДоверительногоУправления, ДокументВводЦБ.Дата).Выгрузить();
	
	Для Каждого СтрокаТаблицыСверки Из ТаблицаСверкиРасчет  Цикл
		
		Если СтрокаТаблицыСверки.ЭСПВывод = -1 Тогда
		
			СтрокиПокупки = ТаблицаДатИЦенПокупкиВывод.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаТаблицыСверки.ПартияВывод, СтрокаТаблицыСверки.СтрокаПартииВывод));
			Если СтрокиПокупки.Количество() > 0 Тогда
				
				СтрокаПокупки = СтрокиПокупки[0];
				
				ДанныеПереоценки = Новый Структура;
				ДанныеПереоценки.Вставить("ДатаПереоценки",												  КонецДня(ДатаВывод));
				ДанныеПереоценки.Вставить("Партия",														  СтрокаТаблицыСверки.ПартияВывод);
				ДанныеПереоценки.Вставить("СтрокаПартии",												  СтрокаТаблицыСверки.СтрокаПартииВывод);
				ДанныеПереоценки.Вставить("БалансовыйДисконт",											  0);
				ДанныеПереоценки.Вставить("УчетныйАктивЕПС",											  СтрокаТаблицыСверки.УчетныйАктивЕПС);
				ДанныеПереоценки.Вставить("Количество",													  СтрокаТаблицыСверки.Количество);
				ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона",										  0);
				ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", 0);
				ДанныеПереоценки.Вставить("СчетДоверительногоУправления", 								  СчетДоверительногоУправленияВывод);
				ДанныеПереоценки.Вставить("Стоимость", 													  0);
				
				ДанныеПокупки = Новый Структура;
				ДанныеПокупки.Вставить("НачальныйДисконт",												СтрокаПокупки.НачальныйДисконт);
				ДанныеПокупки.Вставить("ДатаПокупки",													СтрокаПокупки.ДатаПокупки);
				ДанныеПокупки.Вставить("ДатаПокупкиНачальная",											СтрокаПокупки.ДатаПокупкиНачальная);
				ДанныеПокупки.Вставить("КорректировкаЭСПНачальная",										СтрокаПокупки.КорректировкаЭСПНачальная);
				ДанныеПокупки.Вставить("ЦенаПокупки",													СтрокаПокупки.ЦенаПокупки);
				ДанныеПокупки.Вставить("ЦенаПокупкиКупона",												СтрокаПокупки.ЦенаКупона);
				ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные",	0);
				ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", 											СтрокаПокупки.ЦенаПокупкиНачальная);
				
				НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
					НастройкиУчетаОбщиеВывод,
					СтрокаТаблицыСверки.ЦеннаяБумага,
					СтрокаТаблицыСверки.УчетныйАктивЕПС,
					СтрокаТаблицыСверки.ПартияВвод,
					СтрокаТаблицыСверки.СтрокаПартииВвод);
				НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;
				
				Попытка
					ДанныеРасчета = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаТаблицыСверки.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
				
					СтрокаТаблицыСверки.ЭСПВывод = ДанныеРасчета.ЭСПКорректировка;
				Исключение
					Сообщить("По ценной бумаге " + Строка(СтрокаТаблицыСверки.ЦеннаяБумага) + " не удалось получить ставку ЭСП. По данной ЦБ не будет сформирована регистрация ставки ЭСП. Необходимо проверить корректность денежных потоков."); 	
				КонецПопытки;	
				
			КонецЕсли;
		
		КонецЕсли;
		
		Если СтрокаТаблицыСверки.ЭСПВвод = -1 Тогда
		
			СтрокиПокупки = ТаблицаДатИЦенПокупкиВвод.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаТаблицыСверки.ПартияВвод, СтрокаТаблицыСверки.СтрокаПартииВвод));
			Если СтрокиПокупки.Количество() > 0 Тогда
				
				СтрокаПокупки = СтрокиПокупки[0];
				
				ДанныеПереоценки = Новый Структура;
				ДанныеПереоценки.Вставить("ДатаПереоценки",												  КонецДня(ДокументВводЦБ.Дата));
				ДанныеПереоценки.Вставить("Партия",														  СтрокаТаблицыСверки.ПартияВвод);
				ДанныеПереоценки.Вставить("СтрокаПартии",												  СтрокаТаблицыСверки.СтрокаПартииВвод);
				ДанныеПереоценки.Вставить("БалансовыйДисконт",											  0);
				ДанныеПереоценки.Вставить("УчетныйАктивЕПС",											  СтрокаТаблицыСверки.УчетныйАктивЕПС);
				ДанныеПереоценки.Вставить("Количество",													  СтрокаТаблицыСверки.Количество);
				ДанныеПереоценки.Вставить("ОценочнаяСуммаКупона",										  0);
				ДанныеПереоценки.Вставить("БалансоваяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные", 0);
				ДанныеПереоценки.Вставить("СчетДоверительногоУправления", 								  ДокументВводЦБ.СчетДоверительногоУправления);
				ДанныеПереоценки.Вставить("Стоимость", 													  0);
			
				ДанныеПокупки = Новый Структура;
				ДанныеПокупки.Вставить("НачальныйДисконт",												СтрокаПокупки.НачальныйДисконт);
				ДанныеПокупки.Вставить("ДатаПокупки",													СтрокаПокупки.ДатаПокупки);
				ДанныеПокупки.Вставить("ДатаПокупкиНачальная",											СтрокаПокупки.ДатаПокупкиНачальная);
				ДанныеПокупки.Вставить("КорректировкаЭСПНачальная",										СтрокаПокупки.КорректировкаЭСПНачальная);
				ДанныеПокупки.Вставить("ЦенаПокупки",													СтрокаПокупки.ЦенаПокупки);
				ДанныеПокупки.Вставить("ЦенаПокупкиКупона",												СтрокаПокупки.ЦенаКупона);
				ДанныеПокупки.Вставить("НачальнаяРазницаПервоначальногоПризнанияНеНаблюдаемыеДанные",	0);
				ДанныеПокупки.Вставить("ЦенаПокупкиНачальная", 											СтрокаПокупки.ЦенаПокупкиНачальная);
				
				НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
					НастройкиУчетаОбщиеВвод,
					СтрокаТаблицыСверки.ЦеннаяБумага,
					СтрокаТаблицыСверки.УчетныйАктивЕПС,
					СтрокаТаблицыСверки.ПартияВвод,
					СтрокаТаблицыСверки.СтрокаПартииВвод);
				НастройкиУчетаЦеннойБумаги.ВариантУчетаКупонногоДохода = Перечисления.ВариантыУчетаПроцентныхДоходов.ПоЭффективнойСтавке;
				
				Попытка
					ДанныеРасчета = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремииИКорректировкуПоЭСПИРазницуПервоначальногоПризнания(СтрокаТаблицыСверки.ЦеннаяБумага, ДанныеПереоценки, ДанныеПокупки, НастройкиУчетаЦеннойБумаги, Отказ);
					
					СтрокаТаблицыСверки.ЭСПВвод = ДанныеРасчета.ЭСПКорректировка;
				Исключение
					Сообщить("По ценной бумаге " + Строка(СтрокаТаблицыСверки.ЦеннаяБумага) + " не удалось получить ставку ЭСП. По данной ЦБ не будет сформирована регистрация ставки ЭСП. Необходимо проверить корректность денежных потоков."); 	
				КонецПопытки;	
				
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла; 
	
	УстановитьПривилегированныйРежим(Ложь);
	
	//удалим строки с ЭСПВвод = ЭСПВывод, совпадающими Используется и записанным документом в вводимых партиях
	//и строки по которым есть проблемы с расчетом ЭСП. По ним после исправления данных в учете этих ЦБ ещё раз вызовут функцию.
	УдаляемыеСтроки = Новый Массив;
	Для Каждого СтрокаСверки Из ТаблицаСверкиРасчет Цикл 
		Если СтрокаСверки.ЭСПВвод = СтрокаСверки.ЭСПВывод И СтрокаСверки.ИспользуетсяВвод = СтрокаСверки.ИспользуетсяВывод И ЗначениеЗаполнено(СтрокаСверки.Документ) Тогда 
			УдаляемыеСтроки.Добавить(СтрокаСверки);
		ИначеЕсли СтрокаСверки.ЭСПВвод = -1 Или СтрокаСверки.ЭСПВывод = -1 Тогда
			УдаляемыеСтроки.Добавить(СтрокаСверки);
		КонецЕсли;
	КонецЦикла;
				
	Для Каждого СтрокаСверки Из УдаляемыеСтроки Цикл 
		ТаблицаСверкиРасчет.Удалить(СтрокаСверки);
	КонецЦикла;
	
	ТаблицаСверкиРасчет.ЗаполнитьЗначения(Истина, "Отметка");

	Возврат ТаблицаСверкиРасчет;
	
КонецФункции

&НаСервере 
Процедура ОформитьРегистрацииНаСервере(Отказ)
	
	Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ДокументВводЦБ.СчетДоверительногоУправления, ДокументВводЦБ.Дата);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ТаблицаСверки.ЦеннаяБумага КАК ЦеннаяБумага,
	 |	ТаблицаСверки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	 |	ТаблицаСверки.ПартияВвод КАК Партия,
	 |	ТаблицаСверки.СтрокаПартииВвод КАК СтрокаПартии,
	 |	ТаблицаСверки.ЭСПВывод КАК ЭСП,
	 |	ТаблицаСверки.ИспользуетсяВывод КАК Используется,
	 |	ТаблицаСверки.Документ КАК Документ,
	 |	ТаблицаСверки.Отметка КАК Отметка
	 |ПОМЕСТИТЬ _ТаблицаСверки
	 |ИЗ
	 |	&ТаблицаСверки КАК ТаблицаСверки
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	_ТаблицаСверки.ЦеннаяБумага КАК ЦеннаяБумага,
	 |	_ТаблицаСверки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
	 |	_ТаблицаСверки.Партия КАК Партия,
	 |	_ТаблицаСверки.СтрокаПартии КАК СтрокаПартии,
	 |	_ТаблицаСверки.ЭСП КАК ЭСП,
	 |	_ТаблицаСверки.Используется КАК Используется,
	 |	_ТаблицаСверки.Документ КАК Документ
	 |ИЗ
	 |	_ТаблицаСверки КАК _ТаблицаСверки
	 |ГДЕ
	 |	_ТаблицаСверки.Отметка
	 |ИТОГИ ПО
	 |	ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("ТаблицаСверки", ЭтотОбъект.ТаблицаСверки.Выгрузить());  
	
	ВыборкаЦБ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	НачатьТранзакцию();
	
	Пока ВыборкаЦБ.Следующий() Цикл	
		
		ДокументСведения = Неопределено;  
		СозданНовыйДокумент = Ложь;
		
		ВыборкаСтроки = ВыборкаЦБ.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл        
			Если ДокументСведения = Неопределено Тогда 
				Если ЗначениеЗаполнено(ВыборкаСтроки.Документ) Тогда 
					ДокументСведения = ВыборкаСтроки.Документ.ПолучитьОбъект(); 
					// документ существует, но в нем есть ошибка. Будем его исправлять. 
				Иначе 
					ДокументСведения = Документы.РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах.СоздатьДокумент(); 
					ДокументСведения.Организация = ДокументВводЦБ.Организация;
					ДокументСведения.Клиент = Клиент;
					ДокументСведения.ЦеннаяБумага = ВыборкаЦБ.ЦеннаяБумага;
					ДокументСведения.ТипСведений = "ЭСП";
					ДокументСведения.Ответственный = ДокументВводЦБ.Ответственный;
					ДокументСведения.Дата = ДокументВводЦБ.Дата + 30 * 60; 
					ДокументСведения.ДатаНачалаДействия = НачалоДня(ДокументВводЦБ.Дата + 60 * 60 * 24); 
					СозданНовыйДокумент = Истина;
				КонецЕсли; 
			КонецЕсли;
			
			//попробуем найти строку 
			СтруктураПоиска = Новый Структура("УчетныйАктивЕПС, Партия, СтрокаПартии, Используется");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВыборкаСтроки);
			МассивСтрок = ДокументСведения.ЭСП.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() = 0 Тогда
				СтрокаЭСП = ДокументСведения.ЭСП.Добавить();   
			Иначе
				СтрокаЭСП = МассивСтрок[0];
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаЭСП, ВыборкаСтроки);
		КонецЦикла;
		
		МетаданныеДокумента = ДокументСведения.Метаданные();
		СообщениеОбОшибке = "Не удалось провести документ " + МетаданныеДокумента.Синоним + ", Клиент " + СокрЛП(ДокументСведения.Клиент) + ", дата " + Формат(ДокументСведения.Дата, "ДФ=dd.MM.yyyy") + "."; 
		Попытка
			ДокументСведения.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке + " Система сообщает: " + ОписаниеОшибки(),,,,Отказ); 
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
		
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Если Не Отказ Тогда 
		ТаблицаСверкиРасчет = СверитьЭСПпоВводуВыводуНаСервере(ДокументВводЦБ, Отказ); 
		ЭтаФорма.ТаблицаСверки.Загрузить(ТаблицаСверкиРасчет);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОформитьРегистрации(Команда) 
	Отказ = Ложь;
	ОформитьРегистрацииНаСервере(Отказ);
	Предупреждение("Документы регистрации ЭСП сформированы.");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)   
	
	Для Каждого СтрокаТаблицы Из ЭтаФорма.ТаблицаСверки Цикл 
		СтрокаТаблицы.Отметка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)

	Для Каждого СтрокаТаблицы Из ЭтаФорма.ТаблицаСверки Цикл 
		СтрокаТаблицы.Отметка = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСверкиОтметкаПриИзменении(Элемент)

	ТекущаяБумага = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.ЦеннаяБумага; 
	ТекущаяОтметка = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.Отметка;
	
	Для Каждого СтрокаТаблицы Из ЭтаФорма.ТаблицаСверки Цикл
		Если СтрокаТаблицы.ЦеннаяБумага = ТекущаяБумага Тогда
			СтрокаТаблицы.Отметка = ТекущаяОтметка;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТаблицаСверки.Количество() = 0 Тогда 
		Предупреждение("ЭСП по партиям вывода и ввода совпадают, или не найдены. Исправления не требуются.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументВыводЦБПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ДокументВводЦБ, ДокументВыводЦБ", ДокументВводЦБ, ДокументВыводЦБ);
	ВыбранныеДанныеВводЦенныхБумаг = ОткрытьФормуМодально("Документ.ВводЦенныхБумаг.Форма.ФормаВыбораДокументаВывода", ПараметрыФормы);
	
	Если ВыбранныеДанныеВводЦенныхБумаг = Неопределено Тогда
		Возврат;
	Иначе	
		ДокументВыводЦБ = ВыбранныеДанныеВводЦенныхБумаг.СсылкаДокументаВывода;
		ДокументВыводЦБПредставление = ВыбранныеДанныеВводЦенныхБумаг.Представление;
		
		ЗаписатьДокументВыводЦБ(ДокументВводЦБ, ДокументВыводЦБ);
		
		ДокументВыводЦБПредставлениеНачалоВыбораСервер();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗначениеЗаполнено(ДокументВводЦБ) И Не ЗавершениеРаботы Тогда
		ЗаписатьДокументВыводЦБ(ДокументВводЦБ, ДокументВыводЦБ);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста 	
Процедура ЗаписатьДокументВыводЦБ(ДокументВводЦБ, ДокументВыводЦБ)
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "ДокументВыводаЦБДляОпределенияЭСП");
	
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		ВызватьИсключение("Не найдено свойство для сохранения Документа вывода ЦБ.");	
	КонецЕсли;	
	
	Запись = РегистрыСведений.ЗначенияДополнительныхСведений.СоздатьМенеджерЗаписи();
	Запись.Объект = ДокументВводЦБ;
	Запись.Свойство = Свойство;
	Запись.Значение = ДокументВыводЦБ; 
	Запись.Записать();
	
КонецПроцедуры	

&НаСервере
Процедура ДокументВыводЦБПредставлениеНачалоВыбораСервер()
	
	Отказ = Ложь;
	
	ТаблицаСверкиРасчет = СверитьЭСПпоВводуВыводуНаСервере(ЭтотОбъект.ДокументВводЦБ, Отказ); 
	Если ТаблицаСверкиРасчет <> Неопределено Тогда 
		ЭтаФорма.ТаблицаСверки.Загрузить(СверитьЭСПпоВводуВыводуНаСервере(ДокументВводЦБ, Отказ));
	Иначе 	
		ЭтаФорма.ТаблицаСверки.Очистить();
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ДокументВыводЦБПредставлениеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Попытка 
		ОткрытьЗначение(ДокументВыводЦБ);
	Исключение
		
	КонецПопытки;	
	
КонецПроцедуры
