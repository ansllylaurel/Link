
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("БазаДляНачисленияПроцентов");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;	

	Если Данные.БазаДляНачисленияПроцентов = Перечисления.БазаДляНачисленияПроцентовНаОстаткиДенежныхСредств.ФактическийЕжедневныйОстаток Тогда
		ВидСоглашения = "Сделка ФЕО";
	Иначе
		ВидСоглашения = "Сделка СМО";
	КонецЕсли;
	
	Представление = СтрШаблон("%1 %2 от %3", ВидСоглашения, Данные.Номер, Данные.Дата);			
	
КонецПроцедуры