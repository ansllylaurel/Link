Функция ПолучитьВидДолжностногоЛицаОтветственногоЗаОбучение(ВидПеречня, Отказ) Экспорт
	
	ВидДолжностногоЛица = Неопределено;
	
 	Если ВидПеречня = Справочники.ВидыПеречнейОбъектов.СотрудникиПроходящиеОбучениеПОДФТ Тогда
		ВидДолжностногоЛица = Перечисления.ВидыДолжностныхЛиц.СпециальноеДолжностноеЛицо;
		
	ИначеЕсли ВидПеречня = Справочники.ВидыПеречнейОбъектов.Инсайдеры Тогда
		ВидДолжностногоЛица = Перечисления.ВидыДолжностныхЛиц.Контролер;
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для вида перечня %1 не задан вид ответственного лица", ВидПеречня),,,, Отказ);			
		
	КонецЕсли;
	
	Возврат ВидДолжностногоЛица;
	
КонецФункции
