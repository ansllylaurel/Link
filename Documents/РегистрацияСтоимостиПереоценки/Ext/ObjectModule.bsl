	// Если для колонки явно не задана точность, то в SQL она урезается до 9 знаков после запятой
	
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ТаблицаСтоимостейЦБ, "ЦенаКотировки", Метаданные.РегистрыСведений.СтоимостьПереоценки.Ресурсы.Цена.Тип);
	
	// Возникают ситуации, когда превышается допустимая длина числа в SQL, поэтому в запросе приводим числа к точности, необходимой для данного счета ДУ
	
	ТипЧислаЦенаПроцент	= Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦенаПроцент.Тип.КвалификаторыЧисла;
	ДлинаЦелойЧасти		= Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла.Разрядность;
	ТочностьЦены		= РаботаСПереоценкой.ПолучитьТочностьРасчетаОценочнойСтоимости(НастройкиОценки);
	ТипЧислаСумма		= Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип.КвалификаторыЧисла;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(1, 0)", "ЧИСЛО(" + Строка(ТипЧислаЦенаПроцент.Разрядность) + ", " +  Строка(ТипЧислаЦенаПроцент.РазрядностьДробнойЧасти) + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(2, 0)", "ЧИСЛО(" + Строка(ДлинаЦелойЧасти) + ", " +  Строка(ТочностьЦены) + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(3, 0)", "ЧИСЛО(" + Строка(ТипЧислаСумма.Разрядность) + ", " +  Строка(ТипЧислаСумма.РазрядностьДробнойЧасти) + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(6, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЧислаСумма.Разрядность, 2));
	
	
	#Область Варианты_округления_валютных_сумм_при_расчете_сумм_в_валюте_учета
	
	РассчитыватьРыночнуюСуммуВВалютеУчетаОтОкругленнойВалютнойСуммы = (ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму <> "НеОкруглять");	
		
	Если РассчитыватьРыночнуюСуммуВВалютеУчетаОтОкругленнойВалютнойСуммы Тогда
		Если ТипЗнч(ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму) = Тип("Число") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(4, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЧислаСумма.Разрядность, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму));
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неизвестный вариант округления валютной суммы '%1'", ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму), , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
	РассчитыватьРыночнуюСуммуКупонаВВалютеУчетаОтОкругленнойВалютнойСуммы = (ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона <> "НеОкруглять");	
	
