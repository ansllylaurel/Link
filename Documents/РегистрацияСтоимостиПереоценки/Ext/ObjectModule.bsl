Функция ПолучитьСтоимостиПереоценкиДляОценкиОбъектовВУправлении(АдресФайлаXML, Отказ, РасчетПартий = Неопределено) Экспорт

	ТаблицыДокумента = Новый Структура("СтоимостиПереоценки, СтоимостиПрочихЦенныхБумаг");
		
	ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Строка(АдресФайлаXML),,,,, РасчетПартий);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ТаблицаСтоимостиПереоценки", ТаблицыДокумента.СтоимостиПереоценки) Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("ТаблицаСтоимостиПереоценки");
		Запрос.УстановитьПараметр("ТаблицаСтоимостиПереоценки", ТаблицыДокумента.СтоимостиПереоценки);
	Иначе
		ПустаяТаблица = Новый ТаблицаЗначений;
		ПустаяТаблица.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип));
		Запрос.УстановитьПараметр("ТаблицаСтоимостиПереоценки", ПустаяТаблица);
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаСтоимостиПереоценки.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ТаблицаСтоимостиПереоценки
		|ИЗ
		|	&ТаблицаСтоимостиПереоценки КАК ТаблицаСтоимостиПереоценки";
	Запрос.Выполнить();
		
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ЦельРасчета);
	
	Если НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316 Тогда
	
		ПараметрыПолученияПартий = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации, ВидУчета, НастройкиОценки.ВариантРасчетаОценочнойСтоимости, ЭтотОбъект.Дата, , ЭтотОбъект.СчетДоверительногоУправления);	
		ПараметрыПолученияПартий.УчестьСрочныеКонтракты = Истина;
		РаботаСПереоценкой.ПолучитьЦенныеБумаги(ЭтотОбъект, Запрос.МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", ПараметрыПолученияПартий, РасчетПартий);
			
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ТаблицаПартийЦБ.Рынок КАК Рынок,
			|	ТаблицаПартийЦБ.Количество КАК Количество,
			|	ТаблицаПартийЦБ.Партия КАК Партия,
			|	ТаблицаПартийЦБ.СтрокаПартии КАК СтрокаПартии
			|ИЗ
			|	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСтоимостиПереоценки КАК _ТаблицаСтоимостиПереоценки
			|		ПО ТаблицаПартийЦБ.ЦеннаяБумага = _ТаблицаСтоимостиПереоценки.ЦеннаяБумага
			|ГДЕ
			|	_ТаблицаСтоимостиПереоценки.ЦеннаяБумага ЕСТЬ NULL";

		ТаблицаПрочихЦенныхБумаг = Запрос.Выполнить().Выгрузить();
		ТаблицаПрочихЦенныхБумаг.Колонки.Добавить("ТипЗадолженности", 	Новый ОписаниеТипов("ПеречислениеСсылка.ТипыЗадолженности"));
		ТаблицаПрочихЦенныхБумаг.Колонки.Добавить("УчетныйАктивЕПС",	Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));

	Иначе
		
		ТипыЗадолженностейПоЦеннымБумагам = Новый Массив;
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Дебиторская);
		ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Кредиторская);
		
		ПараметрыПолученияОстатков = Новый Структура;
		ПараметрыПолученияОстатков.Вставить("ОстаткиЦенныхБумаг",					Истина);
		ПараметрыПолученияОстатков.Вставить("ТипыЗадолженностейПоЦеннымБумагам",	ТипыЗадолженностейПоЦеннымБумагам);
		ПараметрыПолученияОстатков.Вставить("ЗадолженностиПоВторойЧастиРЕПО",		Истина);
		ПараметрыПолученияОстатков.Вставить("НеУчитыватьЦБКупленныеПоРЕПО",			Ложь);
		ПараметрыПолученияОстатков.Вставить("УчитыватьЦБПроданныеВРЕПО",			Истина); 
		
		Справочники.ВариантыРасчетаОценочнойСтоимости.ПоместитьЦенныеБумагиВМенеджерВременныхТаблиц(
			НастройкиОценки.ВариантРасчетаОценочнойСтоимости,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.Дата,
			Запрос.МенеджерВременныхТаблиц,
			ПараметрыПолученияОстатков);
			
		Если НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 Или ЭтотОбъект.Дата >= '20251218' Тогда
		
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ЦенныеБумаги.Рынок КАК Рынок,
				|	_ЦенныеБумаги.Количество КАК Количество,
				|	_ЦенныеБумаги.ТипЗадолженности КАК ТипЗадолженности
				|ИЗ
				|	_ЦенныеБумаги КАК _ЦенныеБумаги
				|ГДЕ
				|	_ЦенныеБумаги.ТипЗадолженности <> Неопределено";
		
		Иначе		
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
				|	_ЦенныеБумаги.Рынок КАК Рынок,
				|	_ЦенныеБумаги.Количество КАК Количество,
				|	_ЦенныеБумаги.ТипЗадолженности КАК ТипЗадолженности
				|ИЗ
				|	_ЦенныеБумаги КАК _ЦенныеБумаги
				|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСтоимостиПереоценки КАК _ТаблицаСтоимостиПереоценки
				|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ТаблицаСтоимостиПереоценки.ЦеннаяБумага
				|ГДЕ
				|	_ТаблицаСтоимостиПереоценки.ЦеннаяБумага ЕСТЬ NULL";
			
		КонецЕсли;
		
		ТаблицаПрочихЦенныхБумаг = Запрос.Выполнить().Выгрузить();
		ТаблицаПрочихЦенныхБумаг.Колонки.Добавить("Партия",							Метаданные.ОпределяемыеТипы.Партия.Тип);
		ТаблицаПрочихЦенныхБумаг.Колонки.Добавить("СтрокаПартии",					Новый ОписаниеТипов("Число"));
		ТаблицаПрочихЦенныхБумаг.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
		
	КонецЕсли; 
		
	Если ТаблицаПрочихЦенныхБумаг.Количество() > 0 Тогда
	
		ТаблицаПрочихЦенныхБумаг.Колонки.Добавить("СуммаРезервовПодОбесценение",	Новый ОписаниеТипов("Число"));
		
		ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, Строка(АдресФайлаXML), , , ТаблицаПрочихЦенныхБумаг, Истина);

		Если Отказ Тогда
			ТаблицаПрочихЦенныхБумаг.Свернуть("Рынок, ЦеннаяБумага");
			ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг = ТаблицаПрочихЦенныхБумаг;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось выполнить оценку ценных бумаг для целей контроля ИД",,,, Отказ); 
		Иначе
			ЭтотОбъект.ДополнительныеСвойства.Свойство("ТаблицаСтоимостиПереоценки", ТаблицыДокумента.СтоимостиПрочихЦенныхБумаг);
		КонецЕсли;
		
	КонецЕсли; 	
	
	Возврат ТаблицыДокумента;
	
КонецФункции

#Область Служебные_и_вспомогательные_функции

#Область Подмена_цен_в_соответствии_с_указаниями_ЦБ

// Обновляет стоимости ценных бумаг согласно указанию ЦБ РФ № 5419-У:
// 1. Облигации
//   1.1 Оцениваемые по амортизированной стоимости: оцениваются как обычно
//   1.2 Прочие:
//     1.2.1 Купленные до 01.03: по последней оценочной цене (28.02 или 29.02), купон на дату оценки
//     1.2.2 Купленные после 01.03: по цене на дату приобретения, купон на дату оценки
// 2. Акции и паи
//   2.1 Купленные до 01.03: по последней оценочной цене (28.02 или 29.02)
//   2.2 Купленные после 01.03: оцениваются как обычно
// 3. Прочие ц/б: оцениваются как обычно	
//
Процедура ОбновитьСтоимостиВСоответствииСУказаниемЦБРФ5419У(ТаблицаСтоимостейЦБ, ПересчитыватьСуммы, ПараметрыПолученияПартий = Неопределено, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Определение_даты_последней_оценки_до_1_марта_2020_года
	
	Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда	
		
		ДатаПоследнейОценкиДо1Марта = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ЭтотОбъект.СчетДоверительногоУправления, '20200301');
		
	Иначе
		
		ЗапросДатыПоследнейОценки = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(МАКСИМУМ(ПереоценкаЦенныхБумаг.Дата), ДЕНЬ) КАК Период
			|ИЗ
			|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
