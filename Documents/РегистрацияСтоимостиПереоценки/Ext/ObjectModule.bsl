		ЕстьТекущаяСтоимость = НЕ Запрос.МенеджерВременныхТаблиц.Таблицы["ЕстьТекущаяСтоимость"].ПолучитьДанные().Пустой();
		
		Если ЕстьТекущаяСтоимость Тогда
		
			ТаблицаРазличий = Запрос.МенеджерВременныхТаблиц.Таблицы["ТаблицаРазличий"].ПолучитьДанные().Выгрузить();
			ТаблицаРазличий.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
			ТаблицаРазличий.ЗаполнитьЗначения(НачалоДня(ЭтотОбъект.Дата), "Период");
			
			ДополнительныеСвойства.Вставить("ЕстьОтличияСтоимостиПереоценки",		Истина);
