		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценкиПоБумаге
		|		ПО (СтоимостьПереоценкиПоБумаге.Организация = &Организация)
		|			И (СтоимостьПереоценкиПоБумаге.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (СтоимостьПереоценкиПоБумаге.ЦельРасчета = &ЦельРасчета)
		|			И (СтоимостьПереоценкиПоБумаге.ВидЦеныОценки = &ВидЦеныОценки)
		|			И (СтоимостьПереоценкиПоБумаге.Рынок = _ПодменяемыеБумаги.Рынок)
		|			И (СтоимостьПереоценкиПоБумаге.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|			И (СтоимостьПереоценкиПоБумаге.Период = _ПодменяемыеБумаги.ДатаОценки)
		|			И (СтоимостьПереоценкиПоПартии.ЦеннаяБумага ЕСТЬ NULL)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалНаДатуОценки
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ПодменяемыеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_ПодменяемыеБумаги КАК _ПодменяемыеБумаги
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|						И (НоминалыЦенныхБумаг.Период <= &ДатаПереоценки)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ПодменяемыеБумаги.ЦеннаяБумага) КАК ДатыИзмененийНоминалаНаДатуОценки
		|			ПО (ДатыИзмененийНоминалаНаДатуОценки.ЦеннаяБумага = НоминалНаДатуОценки.ЦеннаяБумага)
		|				И (ДатыИзмененийНоминалаНаДатуОценки.Период = НоминалНаДатуОценки.Период)
		|		ПО (НоминалНаДатуОценки.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалНаДатуЦены
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ПодменяемыеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|				_ПодменяемыеБумаги.ДатаОценки КАК ДатаОценки,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_ПодменяемыеБумаги КАК _ПодменяемыеБумаги
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|						И (НоминалыЦенныхБумаг.Период <= _ПодменяемыеБумаги.ДатаОценки)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ПодменяемыеБумаги.ЦеннаяБумага,
		|				_ПодменяемыеБумаги.ДатаОценки) КАК ДатыИзмененийНоминалаНаДатуЦены
		|			ПО (ДатыИзмененийНоминалаНаДатуЦены.ЦеннаяБумага = НоминалНаДатуЦены.ЦеннаяБумага)
		|				И (ДатыИзмененийНоминалаНаДатуЦены.Период = НоминалНаДатуЦены.Период)
		|		ПО (НоминалНаДатуЦены.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|			И (ДатыИзмененийНоминалаНаДатуЦены.ДатаОценки = _ПодменяемыеБумаги.ДатаОценки)
		|ГДЕ
		|	_ПодменяемыеБумаги.ДатаОценки ЕСТЬ НЕ NULL ");
	
	#КонецОбласти
	
	ПодменямыеБумаги = РаботаСПереоценкой.ЦенныеБумагиСРасчетомСтоимостиВСоответствииСУказаниемЦБРФ5419У(ЭтотОбъект.СчетДоверительногоУправления);
	
	Если ПодменямыеБумаги.Количество() = 0 Тогда
		ЗапросПодмен.Текст = СтрЗаменить(ЗапросПодмен.Текст, "&ФильтрПодменяемыхБумаг", "ИСТИНА");
	Иначе
		ЗапросПодмен.Текст = СтрЗаменить(ЗапросПодмен.Текст, "&ФильтрПодменяемыхБумаг", "ЦеннаяБумага В (&ПодменямыеБумаги)");
	КонецЕсли;
	
	Если ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
		ВидЦеныОценки = Перечисления.ВидыЦенОценки.ЦенаОценки;
	Иначе
		ВидЦеныОценки = Перечисления.ВидыЦенОценки.ЦенаПереоценки;
	КонецЕсли;
	
	ЗапросПодмен.УстановитьПараметр("КонецДняПереоценкиГраницаВключая",	Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));	
	ЗапросПодмен.УстановитьПараметр("ДатаПереоценки",					НачалоДня(ЭтотОбъект.Дата));	
	ЗапросПодмен.УстановитьПараметр("Организация",						ЭтотОбъект.Организация);
	ЗапросПодмен.УстановитьПараметр("СчетДоверительногоУправления",		ЭтотОбъект.СчетДоверительногоУправления);
	ЗапросПодмен.УстановитьПараметр("ЦельРасчета",						ЭтотОбъект.ЦельРасчета);
	ЗапросПодмен.УстановитьПараметр("ВидУчета",							ЭтотОбъект.ВидУчета);
	ЗапросПодмен.УстановитьПараметр("ВидЦеныОценки",					ВидЦеныОценки);
	ЗапросПодмен.УстановитьПараметр("СтоимостиПереоценки",				ТаблицаСтоимостейЦБ);
	ЗапросПодмен.УстановитьПараметр("ДатаПоследнейОценкиДо1Марта",		ДатаПоследнейОценкиДо1Марта);
	ЗапросПодмен.УстановитьПараметр("ПриоритетнаяСтоимостьНа1Марта",	ПриоритетнаяСтоимостьНаДатуПоследнейОценкиДо1Марта);
	ЗапросПодмен.УстановитьПараметр("ПодменямыеБумаги",					ПодменямыеБумаги);
	
	ВыборкаПодмен = ЗапросПодмен.Выполнить().Выбрать();
	
	ВыполнитьПодменуЦен(ТаблицаСтоимостейЦБ, ВыборкаПодмен, ПересчитыватьСуммы, Отказ);		
	
КонецПроцедуры

// Обновляет стоимости ценных бумаг согласно указанию ЦБ РФ № 6073-У:
// 1. Купленные до 18.02: по цене на 18.02
// 2. Купленные после 18.02: по цене приобретения
//
Процедура ОбновитьСтоимостиВСоответствииСУказаниемЦБРФ6073У(ТаблицаСтоимостейЦБ, ПересчитыватьСуммы, РеквизитыПереоценки, Отказ, РасшифровкаРасчета = Неопределено)
	
	#Область Запрос_подмены_цен	
	
	ЗапросПодмен = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостиПереоценки.НомерСтроки КАК НомерСтроки,
		|	СтоимостиПереоценки.Рынок КАК Рынок,
		|	СтоимостиПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостиПереоценки.Партия КАК Партия,
		|	СтоимостиПереоценки.СтрокаПартии КАК СтрокаПартии,
		|	СтоимостиПереоценки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	СтоимостиПереоценки.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	&СтоимостиПереоценки КАК СтоимостиПереоценки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЦБ.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаЦБ.Рынок КАК Рынок,
		|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ТаблицаЦБ.Партия КАК Партия,
		|	_ТаблицаЦБ.СтрокаПартии КАК СтрокаПартии,
		|	_ТаблицаЦБ.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	_ТаблицаЦБ.ВалютаНоминала КАК ВалютаНоминала
		|ПОМЕСТИТЬ _ПроверяемыеБумаги
		|ИЗ
		|	_ТаблицаЦБ КАК _ТаблицаЦБ
		|ГДЕ
		|	_ТаблицаЦБ.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))
		|	И НЕ _ТаблицаЦБ.ЦеннаяБумага В (&ИсключаемыеБумаги)
		|	И НЕ(&ИсключатьБумагиОцениваемыеПоАС
		|				И _ТаблицаЦБ.УчетныйАктивЕПС В ИЕРАРХИИ (&УчетныеАктивыОцениваемыеПоАС))
		|	И (НЕ &ИсключатьПартииРЕПОиТПлюс
		|			ИЛИ НЕ(ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.Партия) = ТИП(Документ.СделкаРЕПО)
		|					ИЛИ ТИПЗНАЧЕНИЯ(_ТаблицаЦБ.Партия) = ТИП(Документ.Сделка)
		|						И ВЫРАЗИТЬ(_ТаблицаЦБ.Партия КАК Документ.Сделка).ОтложенноеИсполнение))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПроверяемыеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПроверяемыеБумаги.Партия КАК Партия,
		|	_ПроверяемыеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	НАЧАЛОПЕРИОДА(ВводЦенныхБумаг.Дата, ДЕНЬ) КАК ДатаВвода,
		|	НАЧАЛОПЕРИОДА(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, ДЕНЬ) КАК ДатаПокупки,
		|	ВводЦенныхБумагЦенныеБумаги.ЦенаКотировки КАК Цена,
		|	ВводЦенныхБумагЦенныеБумаги.ДатаЦены КАК ДатаЦены,
		|	ВводЦенныхБумагЦенныеБумаги.ВидЦены КАК ВидЦены,
		|	ВводЦенныхБумагЦенныеБумаги.УровеньОценки КАК УровеньОценки,
		|	ВводЦенныхБумагЦенныеБумаги.Источник КАК Источник
		|ПОМЕСТИТЬ _ВведенныеБумаги
		|ИЗ
		|	_ПроверяемыеБумаги КАК _ПроверяемыеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|		ПО _ПроверяемыеБумаги.Партия = ВводЦенныхБумаг.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО _ПроверяемыеБумаги.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И _ПроверяемыеБумаги.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И _ПроверяемыеБумаги.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПроверяемыеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПроверяемыеБумаги.Партия КАК Партия,
		|	_ПроверяемыеБумаги.СтрокаПартии КАК СтрокаПартии,
		|	ИсполнениеОбязательствПоСделке.Основание КАК Сделка,
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ) КАК Дата
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	_ПроверяемыеБумаги КАК _ПроверяемыеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО _ПроверяемыеБумаги.Партия = ИсполнениеОбязательствПоСделке.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ПО _ПроверяемыеБумаги.Партия = ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
		|			И _ПроверяемыеБумаги.ЦеннаяБумага = ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага
		|			И _ПроверяемыеБумаги.СтрокаПартии = ИсполнениеОбязательствПоСделкеЦенныеБумаги.СтрокаПартии
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ПроверяемыеБумаги.ЦеннаяБумага,
		|	_ПроверяемыеБумаги.Партия,
		|	_ПроверяемыеБумаги.СтрокаПартии,
		|	ПоставкаЦенныхБумаг.Основание,
		|	НАЧАЛОПЕРИОДА(ПоставкаЦенныхБумаг.Дата, ДЕНЬ)
		|ИЗ
		|	_ПроверяемыеБумаги КАК _ПроверяемыеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
		|		ПО _ПроверяемыеБумаги.Партия = ПоставкаЦенныхБумаг.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг.ЦенныеБумаги КАК ПоставкаЦенныхБумагЦенныеБумаги
		|		ПО _ПроверяемыеБумаги.Партия = ПоставкаЦенныхБумагЦенныеБумаги.Ссылка
		|			И _ПроверяемыеБумаги.ЦеннаяБумага = ПоставкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И _ПроверяемыеБумаги.СтрокаПартии = ПоставкаЦенныхБумагЦенныеБумаги.НомерСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ПроверяемыеБумаги.ЦеннаяБумага,
		|	_ПроверяемыеБумаги.Партия,
		|	_ПроверяемыеБумаги.СтрокаПартии,
		|	_ПроверяемыеБумаги.Партия,
		|	НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ)
		|ИЗ
		|	_ПроверяемыеБумаги КАК _ПроверяемыеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО _ПроверяемыеБумаги.Партия = Сделка.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО _ПроверяемыеБумаги.Партия = СделкаЦенныеБумаги.Ссылка
		|			И _ПроверяемыеБумаги.ЦеннаяБумага = СделкаЦенныеБумаги.ЦеннаяБумага
		|			И _ПроверяемыеБумаги.СтрокаПартии = СделкаЦенныеБумаги.СтрокаПартии
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ПроверяемыеБумаги.ЦеннаяБумага,
		|	_ПроверяемыеБумаги.Партия,
		|	_ПроверяемыеБумаги.СтрокаПартии,
		|	_ПроверяемыеБумаги.Партия,
		|	НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ)
		|ИЗ
		|	_ПроверяемыеБумаги КАК _ПроверяемыеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО _ПроверяемыеБумаги.Партия = СделкаРЕПО.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО _ПроверяемыеБумаги.Партия = СделкаЦенныеБумаги.Ссылка
		|			И _ПроверяемыеБумаги.ЦеннаяБумага = СделкаЦенныеБумаги.ЦеннаяБумага
		|			И _ПроверяемыеБумаги.СтрокаПартии = СделкаЦенныеБумаги.СтрокаПартии
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ВведенныеБумаги.ЦеннаяБумага,
		|	_ВведенныеБумаги.Партия,
		|	_ВведенныеБумаги.СтрокаПартии,
		|	_ВведенныеБумаги.Партия,
		|	_ВведенныеБумаги.ДатаПокупки
		|ИЗ
		|	_ВведенныеБумаги КАК _ВведенныеБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
