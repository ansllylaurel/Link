
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// предварительная обработка объекта
	РаботаСДокументами.ПередЗаписью(ЭтотОбъект);

	// блокирующие проверки
	Если Не УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении
		И Не (ДополнительныеСвойства.Свойство("ЗаписьВСоставеРегистрацииСтоимостиАктивов") Или ДополнительныеСвойства.Свойство("НумерацияДокументов"))
	Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменение документа доступно только из регистрации стоимости активов", ЭтотОбъект,,, Отказ);
		Возврат;
	КонецЕсли; 
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение И ЭтотОбъект.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда
		
		#Область Проверка_отсутствия_нулевых_цен_и_ошибок_расчета
		
		СтрокиДляПроверки = Новый Массив;
		
		РаботаСКоллекциями.ДополнитьМассив(СтрокиДляПроверки, ЭтотОбъект.СтоимостиПереоценки.НайтиСтроки(Новый Структура("Цена", 0)));
		РаботаСКоллекциями.ДополнитьМассив(СтрокиДляПроверки, ЭтотОбъект.СтоимостиПрочихЦенныхБумаг.НайтиСтроки(Новый Структура("Цена", 0)));
		
		РаботаСКоллекциями.ДополнитьМассив(СтрокиДляПроверки, ЭтотОбъект.СтоимостиПереоценки.НайтиСтроки(Новый Структура("ВидЦены", Перечисления.ИсточникиЦеныДляПереоценки.ОшибкаРасчета)), Истина);
		РаботаСКоллекциями.ДополнитьМассив(СтрокиДляПроверки, ЭтотОбъект.СтоимостиПрочихЦенныхБумаг.НайтиСтроки(Новый Структура("ВидЦены", Перечисления.ИсточникиЦеныДляПереоценки.ОшибкаРасчета)), Истина);
		
		Для Каждого ПроверяемаяСтрока Из СтрокиДляПроверки Цикл
			
			Если ПроверяемаяСтрока.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ОшибкаРасчета
				ИЛИ Не Документы.РегистрацияСтоимостиПереоценки.ДопустимаНулеваяЦена(ПроверяемаяСтрока)
			Тогда
				
				ТекстОшибки			= "Не определена цена по бумаге " + ПроверяемаяСтрока.ЦеннаяБумага + ", строка " + ПроверяемаяСтрока.НомерСтроки;
				ТабличнаяЧастьЦены	= ?(ТипЗнч(ПроверяемаяСтрока) = Тип("ДокументТабличнаяЧастьСтрока.РегистрацияСтоимостиПереоценки.СтоимостиПереоценки"), "СтоимостиПереоценки", "СтоимостиПрочихЦенныхБумаг"); 
				ПолеОшибки			= ТабличнаяЧастьЦены + "[" + (ПроверяемаяСтрока.НомерСтроки - 1) + "].Цена";
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, ПолеОшибки, , Отказ);
				
				ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкаОпределенияЦены", Истина);
				
			КонецЕсли;
			
		КонецЦикла;
		
		#КонецОбласти
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
		ЭтотОбъект.Дата,
		ЭтотОбъект.Организация,
		ЭтотОбъект.СчетДоверительногоУправления,
		ЭтотОбъект.ВидУчета);
		
	МетодОценкиСтоимости = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
		ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, "МетодОценкиСтоимости");	
		
	// Вдруг это переоценка датой ввода остатков?
	
	Если Не ВедетсяУчетПоТекущемуВиду Тогда
		
		ВедетсяУчетПоТекущемуВиду = РегистрыСведений.НастройкиУчетаОбщие.ВедетсяУчетПоВиду(
			ЭтотОбъект.Дата + 24 * 60 * 60,
			ЭтотОбъект.Организация,
			ЭтотОбъект.СчетДоверительногоУправления,
			ЭтотОбъект.ВидУчета);
			
		МетодОценкиСтоимости = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(
			ЭтотОбъект.Дата + 24 * 60 * 60, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, "МетодОценкиСтоимости");	
			
	КонецЕсли;
	
	Если Не ВедетсяУчетПоТекущемуВиду Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("На %1 у %2 не ведется %3", Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"), ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета),
			ЭтотОбъект, "ВидУчета", , Отказ);
		Возврат;
	КонецЕсли;
	
	НастройкиОценки		 = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ЦельРасчета, Истина);
	ВестиРасчетПоПартиям = НастройкиОценки.ВестиРасчетПоПартиям;		
	
	Если ВестиРасчетПоПартиям = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не настроена цель расчета %1 на %2 у %3", ЭтотОбъект.ЦельРасчета, Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"), ЭтотОбъект.СчетДоверительногоУправления), ЭтотОбъект, "ВидУчета");
		ВестиРасчетПоПартиям = Ложь;		
	КонецЕсли;
	
	Если ЭтотОбъект.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда
		
		Если ВестиРасчетПоПартиям Тогда
			
			Для Каждого СтрокаДок из ЭтотОбъект.СтоимостиПереоценки Цикл
				Если НЕ ЗначениеЗаполнено(СтрокаДок.Партия) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						"Не указана партия в строке " + СтрокаДок.НомерСтроки, ЭтотОбъект, "СтоимостиПереоценки[" + (СтрокаДок.НомерСтроки - 1) + "].Партия", , Отказ);
				ИначеЕсли СтрокаДок.СтрокаПартии = 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						"Не указана строка партии в строке " + СтрокаДок.НомерСтроки, ЭтотОбъект, "СтоимостиПереоценки[" + (СтрокаДок.НомерСтроки - 1) + "].СтрокаПартии", , Отказ);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе // балансовое цены недопустимы
		
		Для Каждого СтрокаДок из ЭтотОбъект.СтоимостиПереоценки Цикл
			Если СтрокаДок.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					"Цена не может быть балансовой. Балансовая цена будет определена в переоценке", ЭтотОбъект, "СтоимостиПереоценки[" + (СтрокаДок.НомерСтроки - 1) + "].ВидЦены",, Отказ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// Если ведется учет по партиям, то нужно проверить, что зафиксированное в переоценке количество соответствует остаткам на партиях.
	// Оценка объектов в управлении всегда проводится раньше расчета партий, поэтому возникает необходимость в их динамическом расчете,
	// результаты которого могут и не соответствовать текущим остаткам, следовательно для нее проверку не выполняем
	
	ПроверитьКоличествоНаСоответствиеПартиям =
		ВестиРасчетПоПартиям
		И Не ЭтотОбъект.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки
		И МетодОценкиСтоимости <> Перечисления.МетодыОценкиСтоимости.ПоСреднему;

	Если ПроверитьКоличествоНаСоответствиеПартиям Тогда
		
		#Область Проверка_количества_на_соответствие_партиям
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Рынок КАК Рынок,
			|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Партия КАК Партия,
			|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Количество КАК Количество
			|ПОМЕСТИТЬ _ПереоценкаЦенныхБумагЦенныеБумаги
			|ИЗ
			|	Документ.РегистрацияСтоимостиПереоценки.СтоимостиПереоценки КАК РегистрацияСтоимостиПереоценкиСтоимостиПереоценки
			|ГДЕ
			|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Ссылка = &Ссылка
			|	И РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Партия <> НЕОПРЕДЕЛЕНО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
			|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
			|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
			|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток
			|ПОМЕСТИТЬ _ОстаткиПартий
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Партия В
			|					(ВЫБРАТЬ
			|						_ПереоценкаЦенныхБумагЦенныеБумаги.Партия КАК Партия
			|					ИЗ
			|						_ПереоценкаЦенныхБумагЦенныеБумаги КАК _ПереоценкаЦенныхБумагЦенныеБумаги)) КАК БухПартииЦенныхБумагОстатки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага,
			|	БухПартииЦенныхБумагКПолучениюОстатки.Рынок,
			|	БухПартииЦенныхБумагКПолучениюОстатки.Партия,
			|	БухПартииЦенныхБумагКПолучениюОстатки.СтрокаПартии,
			|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Партия В
			|					(ВЫБРАТЬ
			|						_ПереоценкаЦенныхБумагЦенныеБумаги.Партия КАК Партия
			|					ИЗ
			|						_ПереоценкаЦенныхБумагЦенныеБумаги КАК _ПереоценкаЦенныхБумагЦенныеБумаги)) КАК БухПартииЦенныхБумагКПолучениюОстатки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.ЦеннаяБумага,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Рынок,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.Партия,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтрокаПартии,
			|	БухПартииЦенныхБумагКупленныеПоРЕПООстатки.КоличествоОстаток
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
			|			&Период,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = &ВидУчета
			|				И Партия В
			|					(ВЫБРАТЬ
			|						_ПереоценкаЦенныхБумагЦенныеБумаги.Партия КАК Партия
			|					ИЗ
			|						_ПереоценкаЦенныхБумагЦенныеБумаги КАК _ПереоценкаЦенныхБумагЦенныеБумаги)) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(_ОстаткиПартий.ЦеннаяБумага, _ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага) КАК ЦеннаяБумага,
			|	ЕСТЬNULL(_ОстаткиПартий.Рынок, _ПереоценкаЦенныхБумагЦенныеБумаги.Рынок) КАК Рынок,
			|	ЕСТЬNULL(_ОстаткиПартий.Партия, _ПереоценкаЦенныхБумагЦенныеБумаги.Партия) КАК Партия,
			|	ЕСТЬNULL(_ОстаткиПартий.СтрокаПартии, _ПереоценкаЦенныхБумагЦенныеБумаги.СтрокаПартии) КАК СтрокаПартии,
			|	ЕСТЬNULL(_ОстаткиПартий.КоличествоОстаток, 0) КАК КоличествоОстаток,
			|	ЕСТЬNULL(_ПереоценкаЦенныхБумагЦенныеБумаги.Количество, 0) КАК Количество
			|ИЗ
			|	_ПереоценкаЦенныхБумагЦенныеБумаги КАК _ПереоценкаЦенныхБумагЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиПартий КАК _ОстаткиПартий
			|		ПО (_ОстаткиПартий.Рынок = _ПереоценкаЦенныхБумагЦенныеБумаги.Рынок)
			|			И (_ОстаткиПартий.ЦеннаяБумага = _ПереоценкаЦенныхБумагЦенныеБумаги.ЦеннаяБумага)
			|			И (_ОстаткиПартий.Партия = _ПереоценкаЦенныхБумагЦенныеБумаги.Партия)
			|			И (_ОстаткиПартий.СтрокаПартии = _ПереоценкаЦенныхБумагЦенныеБумаги.СтрокаПартии)
			|ГДЕ
			|	_ПереоценкаЦенныхБумагЦенныеБумаги.Партия <> НЕОПРЕДЕЛЕНО
			|	И _ОстаткиПартий.Партия ЕСТЬ NULL";
			
		Запрос.УстановитьПараметр("Период",                       Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Организация",                  ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВидУчета",                     ЭтотОбъект.ВидУчета);
		Запрос.УстановитьПараметр("Ссылка",                       ЭтотОбъект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() <> 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены партии, отсутствующие на остатках:", ЭтотОбъект.Ссылка,,, Отказ);
			
			Пока Выборка.Следующий() Цикл
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Символы.Таб + Выборка.ЦеннаяБумага + " / " + Выборка.Партия + " / " + Выборка.СтрокаПартии, ЭтотОбъект.Ссылка,,, Отказ);
			КонецЦикла;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;		
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОчиститьДвижения") Тогда
		ЭтотОбъект.Движения.СтоимостьПереоценки.Очистить(); 
		ЭтотОбъект.Движения.СтоимостьПереоценки.Записать();
	КонецЕсли; 
	
	Движения.СтоимостьПереоценки.Записывать = Истина;
	
	Для Каждого ТекСтрокаСтоимостиПереоценки Из ЭтотОбъект.СтоимостиПереоценки Цикл
		Движение = ЭтотОбъект.Движения.СтоимостьПереоценки.Добавить();
		Движение.Период 						= ЭтотОбъект.Дата;
		Движение.Организация 					= ЭтотОбъект.Организация;
		Движение.СчетДоверительногоУправления 	= ЭтотОбъект.СчетДоверительногоУправления;
		Движение.ЦеннаяБумага 					= ТекСтрокаСтоимостиПереоценки.ЦеннаяБумага;
		Движение.Партия		 					= ТекСтрокаСтоимостиПереоценки.Партия;
		Движение.СтрокаПартии 					= ТекСтрокаСтоимостиПереоценки.СтрокаПартии;
		Движение.ВидУчета 						= ЭтотОбъект.ВидУчета;
		Движение.ЦельРасчета					= ЭтотОбъект.ЦельРасчета;
		Движение.ВидЦеныОценки					= Перечисления.ВидыЦенОценки.ЦенаОценки;
		Движение.Рынок 							= ТекСтрокаСтоимостиПереоценки.Рынок;
		Движение.Цена 							= ТекСтрокаСтоимостиПереоценки.Цена;
		Движение.ЦенаКотировки					= ТекСтрокаСтоимостиПереоценки.ЦенаКотировки;
		Движение.Количество						= ТекСтрокаСтоимостиПереоценки.Количество;
		Движение.Сумма							= ТекСтрокаСтоимостиПереоценки.Сумма;
		Движение.ЦенаКупона		 				= ТекСтрокаСтоимостиПереоценки.ЦенаКупона;
		Движение.ЦенаКотировкиКупона			= ТекСтрокаСтоимостиПереоценки.ЦенаКотировкиКупона;
		Движение.ВидЦены 						= ТекСтрокаСтоимостиПереоценки.ВидЦены;
		Движение.УровеньОценки 					= ТекСтрокаСтоимостиПереоценки.УровеньОценки;
		Движение.ДатаЦены 						= ТекСтрокаСтоимостиПереоценки.ДатаЦены;
		Движение.ДатаЦеныКупона					= ТекСтрокаСтоимостиПереоценки.ДатаЦеныКупона;
		Движение.Источник 						= ТекСтрокаСтоимостиПереоценки.Источник;
		Движение.РучнойВвод 					= ТекСтрокаСтоимостиПереоценки.РучнойВвод;
		Движение.ВалютаКотировкиКупона			= ТекСтрокаСтоимостиПереоценки.ВалютаКотировкиКупона;
		Движение.ВалютаКотировки				= ТекСтрокаСтоимостиПереоценки.ВалютаКотировки;
		Движение.СуммаВВалютеУчета 				= ТекСтрокаСтоимостиПереоценки.СуммаВВалютеУчета;
		Движение.СуммаКупонаВВалютеУчета		= ТекСтрокаСтоимостиПереоценки.СуммаКупонаВВалютеУчета;
		Движение.СуммаКупона					= ТекСтрокаСтоимостиПереоценки.СуммаКупона;
		Движение.Примечание						= ТекСтрокаСтоимостиПереоценки.Примечание;
		Движение.КурсВалютыНоминала				= ТекСтрокаСтоимостиПереоценки.КурсВалютыНоминала;
	КонецЦикла;
	
	Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
	
		Для Каждого ТекСтрокаСтоимостиПрочихЦенныхБумаг Из ЭтотОбъект.СтоимостиПрочихЦенныхБумаг Цикл
			Движение = ЭтотОбъект.Движения.СтоимостьПереоценки.Добавить();
			Движение.Период 						= ЭтотОбъект.Дата;
			Движение.Организация 					= ЭтотОбъект.Организация;
			Движение.СчетДоверительногоУправления 	= ЭтотОбъект.СчетДоверительногоУправления;
			Движение.ЦеннаяБумага 					= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ЦеннаяБумага;
			Движение.Партия		 					= ТекСтрокаСтоимостиПрочихЦенныхБумаг.Партия;
			Движение.СтрокаПартии 					= ТекСтрокаСтоимостиПрочихЦенныхБумаг.СтрокаПартии;
			Движение.ВидУчета 						= ЭтотОбъект.ВидУчета;
			Движение.ЦельРасчета					= Справочники.ЦелиРасчета.КонтрольИнвестиционнойДекларации;
			Движение.ВидЦеныОценки					= Перечисления.ВидыЦенОценки.ЦенаОценки;
			Движение.Рынок 							= ТекСтрокаСтоимостиПрочихЦенныхБумаг.Рынок;
			Движение.Цена 							= ТекСтрокаСтоимостиПрочихЦенныхБумаг.Цена;
			Движение.ЦенаКотировки					= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ЦенаКотировки;
			Движение.ЦенаКупона		 				= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ЦенаКупона;
			Движение.ЦенаКотировкиКупона			= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ЦенаКотировкиКупона;
			Движение.ВидЦены 						= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ВидЦены;
			Движение.УровеньОценки 					= ТекСтрокаСтоимостиПрочихЦенныхБумаг.УровеньОценки;
			Движение.ДатаЦены 						= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ДатаЦены;
			Движение.Источник 						= ТекСтрокаСтоимостиПрочихЦенныхБумаг.Источник;
			Движение.ВалютаКотировкиКупона			= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ВалютаКотировкиКупона;
			Движение.ВалютаКотировки				= ТекСтрокаСтоимостиПрочихЦенныхБумаг.ВалютаКотировки;
			Движение.Примечание						= ТекСтрокаСтоимостиПрочихЦенныхБумаг.Примечание;
			Движение.КурсВалютыНоминала				= ТекСтрокаСтоимостиПрочихЦенныхБумаг.КурсВалютыНоминала;
		КонецЦикла;		
	
	КонецЕсли; 
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

Процедура ЗаполнитьСтоимостьПереоценки(ЗаменитьТекущиеСтоимости, ПредупредитьОРазличиях, Отказ, ТаблицаСтоимостей = Неопределено, ПровестиДокумент = Ложь, РасшифровкаРасчета = Неопределено, ТаблицаЦенныхБумаг = Неопределено, ОценкаПрочихЦенныхБумаг = Ложь, РасчетПартий = Неопределено) Экспорт

	// Определяем настройки оценки	
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ЦельРасчета, Истина);
	Если Не ЗначениеЗаполнено(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определен вариант оценки для цели '" + ЭтотОбъект.ЦельРасчета + "' для клиента " + ЭтотОбъект.СчетДоверительногоУправления,ЭтотОбъект.Ссылка,,, Отказ);
		Возврат;
	КонецЕсли;
	
	ВариантРасчетаСправедливойСтоимости	  = НастройкиОценки.ВариантРасчетаОценочнойСтоимости;
	ВыполнятьРасчетПоУказаниюЦБ			  = (НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 И Не ОценкаПрочихЦенныхБумаг) ИЛИ НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316; // прочие ц/б (не из портфеля) оцениваем как обычно
	ВестиРасчетПоПартиям				  = НастройкиОценки.ВестиРасчетПоПартиям ИЛИ ВыполнятьРасчетПоУказаниюЦБ;
	ПараметрыПолученияПартий			  = РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(ЦельРасчета, ВидУчета, ВариантРасчетаСправедливойСтоимости, Дата, РасшифровкаРасчета, ЭтотОбъект.СчетДоверительногоУправления);	
	ОчиститьКупоныСуммыИКоличество		  = Не ЭтотОбъект.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки ИЛИ ОценкаПрочихЦенныхБумаг; // Если нужна только цена бумаги, то купоны, суммы и количество очищаем	
											
	Если ДополнительныеСвойства.Свойство("ОчиститьКупоныСуммыИКоличество") Тогда
		ОчиститьКупоныСуммыИКоличество = ДополнительныеСвойства.ОчиститьКупоныСуммыИКоличество;
	КонецЕсли;
	Если ДополнительныеСвойства.Свойство("ВыполнятьРасчетПоУказаниюЦБ") Тогда  // легальная возможность отключить подмену цен
		ВыполнятьРасчетПоУказаниюЦБ = ДополнительныеСвойства.ВыполнятьРасчетПоУказаниюЦБ;
	КонецЕсли;
	
	ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета = РаботаСПереоценкой.ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета(
		ВариантРасчетаСправедливойСтоимости, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата); 
	
	#Область Чтение_таблицы_стоимостей_из_файла
	
	// Таблица стоимостей может быть передана в файле 
	
	Если ЗначениеЗаполнено(ТаблицаСтоимостей) И ТипЗнч(ТаблицаСтоимостей) = Тип("Строка") Тогда
		
		ТаблицаСтоимостей = ПолучитьТаблицуСтоимостейИзФайла(ТаблицаСтоимостей);
		
		Если ТаблицаСтоимостей = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ДополнительныеСвойства.Вставить("ТаблицаСтоимостейИзФайла", ТаблицаСтоимостей);
		
	КонецЕсли;	
	
	// Если оценка "заморожена", то актуальные цены от клиента не нужны 
	
	Если ВариантРасчетаСправедливойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда		
	
		Если Не ЗначениеЗаполнено(ТаблицаСтоимостей) Тогда
			
			Если ВыполнятьРасчетПоУказаниюЦБ Тогда
				ТаблицаСтоимостей = ПустаяТаблицаСтоимостей();	
			Иначе
				Отказ = Истина;
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;

	#КонецОбласти
	
	// Новая схема расчета - это оценка ц/б по остаткам, а старая - по партиям
	
	ИспользованаМетодикаРасчетаПоНовойСхеме =
		Не ВестиРасчетПоПартиям
		И Не ВыполнятьРасчетПоУказаниюЦБ
		И Справочники.ВариантыРасчетаОценочнойСтоимости.ИспользованаМетодикаРасчетаПоНовойСхеме(ЦельРасчета, ВариантРасчетаСправедливойСтоимости)
		И НЕ (БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ЕстьВозможностьУчитыватьЦенныеБумагиПоАмортизированнойСтоимости")
			И ЕстьАктивыПоАС());
	
	Если ИспользованаМетодикаРасчетаПоНовойСхеме Тогда
		
		#Область Расчет_по_остаткам
		
		ПараметрыПолученияОстатков = Неопределено;
		
		Если ОценкаПрочихЦенныхБумаг Или РасшифровкаРасчета <> Неопределено Тогда
		
			ТипыЗадолженностейПоЦеннымБумагам = Новый Массив;
			ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Дебиторская);
			ТипыЗадолженностейПоЦеннымБумагам.Добавить(Перечисления.ТипыЗадолженности.Кредиторская);
			
			ПараметрыПолученияОстатков = Новый Структура;
			ПараметрыПолученияОстатков.Вставить("ОстаткиЦенныхБумаг",					Истина);
			ПараметрыПолученияОстатков.Вставить("ТипыЗадолженностейПоЦеннымБумагам",	ТипыЗадолженностейПоЦеннымБумагам);
			ПараметрыПолученияОстатков.Вставить("ЗадолженностиПоВторойЧастиРЕПО",		Истина);
			ПараметрыПолученияОстатков.Вставить("НеУчитыватьЦБКупленныеПоРЕПО",			Ложь);
		    ПараметрыПолученияОстатков.Вставить("УчитыватьЦБПроданныеВРЕПО",			Истина);
		КонецЕсли; 
		
		ТаблицаСтоимостейЦБ = Справочники.ВариантыРасчетаОценочнойСтоимости.ПолучитьСтоимостиЦенныхБумаг(ВариантРасчетаСправедливойСтоимости, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, НачалоДня(ЭтотОбъект.Дата), Отказ, ПараметрыПолученияОстатков, ПараметрыПолученияПартий, , , РасшифровкаРасчета, ТаблицаЦенныхБумаг, , ЭтотОбъект.ДополнительныеСвойства);
		
		Если ТаблицаСтоимостейЦБ = Неопределено Тогда
		    Возврат;		
		КонецЕсли;
		
		ТаблицаСтоимостейЦБ.Колонки.Добавить("ДатаЦеныКупона", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
		ТаблицаСтоимостейЦБ.ЗаполнитьЗначения(ЭтотОбъект.Дата, "ДатаЦеныКупона");
		
		ТаблицаСтоимостейЦББезПартий = ТаблицаСтоимостейЦБ; 
		
		#КонецОбласти
		
	Иначе
		
		#Область Расчет_по_партиям

		Если Не Справочники.ВариантыРасчетаОценочнойСтоимости.ПроверитьКотировки(ВариантРасчетаСправедливойСтоимости, ЭтотОбъект.Организация, ЭтотОбъект.Дата, Отказ) Тогда
			Возврат;
		КонецЕсли;
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		#Область Получение_партий_ценных_бумаг_и_помещение_в_ВТ
		
		Если ТаблицаЦенныхБумаг = Неопределено Тогда
			
			РаботаСПереоценкой.ПолучитьЦенныеБумаги(ЭтотОбъект, МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", ПараметрыПолученияПартий, РасчетПартий, , РасшифровкаРасчета);
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
				|	ТаблицаПартийЦБ.Рынок КАК Рынок,
				|	ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
				|	СУММА(ТаблицаПартийЦБ.Количество) КАК Количество
				|ИЗ
				|	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ
				|
				|СГРУППИРОВАТЬ ПО
				|	ТаблицаПартийЦБ.Рынок,
				|	ТаблицаПартийЦБ.ЦеннаяБумага";
			
			ТаблицаЦБ = Запрос.Выполнить().Выгрузить();
			
			СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(МенеджерВременныхТаблиц, , "_КонечныеОстаткиПартий");
			
		Иначе
			
			ТаблицаЦБ = ТаблицаЦенныхБумаг.Скопировать(, "Рынок, ЦеннаяБумага, Количество");
			ТаблицаЦБ.Свернуть("Рынок, ЦеннаяБумага", "Количество");
			
			СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаЦенныхБумаг, "_КонечныеОстаткиПартий", МенеджерВременныхТаблиц); 
			
		КонецЕсли;
		
		#КонецОбласти
		
		РеквизитыПереоценки = Новый Структура;
		
		РеквизитыПереоценки.Вставить("Дата",									НачалоДня(ЭтотОбъект.Дата));
		РеквизитыПереоценки.Вставить("Организация",								ЭтотОбъект.Организация);
	    РеквизитыПереоценки.Вставить("СчетДоверительногоУправления",			ЭтотОбъект.СчетДоверительногоУправления);
	    РеквизитыПереоценки.Вставить("ЦельРасчета",								ЭтотОбъект.ЦельРасчета);
	    РеквизитыПереоценки.Вставить("ВидУчета",								ЭтотОбъект.ВидУчета);
	    РеквизитыПереоценки.Вставить("ПереоцениватьНаОснованииНастроекУчета",	Ложь);
	    РеквизитыПереоценки.Вставить("ВариантРасчетаОценочнойСтоимости",		ВариантРасчетаСправедливойСтоимости);
	    РеквизитыПереоценки.Вставить("ВариантРасчетаСправедливойСтоимости",		ВариантРасчетаСправедливойСтоимости);
	    РеквизитыПереоценки.Вставить("ЦенныеБумаги",							Новый ТаблицаЗначений);
	    РеквизитыПереоценки.Вставить("ПараметрыПолученияПартий",				Неопределено);
		РеквизитыПереоценки.Вставить("Клиент",									Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(РеквизитыПереоценки.СчетДоверительногоУправления, РеквизитыПереоценки.Дата));
		РеквизитыПереоценки.Вставить("ДополнительныеСвойства",					ЭтотОбъект.ДополнительныеСвойства);  
		РеквизитыПереоценки.Вставить("ОценкаПрочихЦенныхБумаг", 				ОценкаПрочихЦенныхБумаг);
		
		Если МенеджерВременныхТаблиц.Таблицы.Найти("_КонечныеОстаткиПартий") <> Неопределено Тогда
			РеквизитыПереоценки.Вставить("ТаблицаПартийЦБ", МенеджерВременныхТаблиц.Таблицы["_КонечныеОстаткиПартий"].ПолучитьДанные().Выгрузить()); // см. РаботаСПереоценкой.ПоместитьБумагиОцениваемыеПоАмортизированнойСтоимостиВМенеджерВременныхТаблиц
		КонецЕсли;		
		
		Если ВариантРасчетаСправедливойСтоимости.ПринадлежитЭлементу(Справочники.ВариантыРасчетаОценочнойСтоимости.ЕПС) Тогда
			
			#Область Получение_таблицы_стоимостей_и_помещение_в_ВТ
			
			ТаблицаСтоимостейЦБ = РаботаСПереоценкой.РассчитатьСтоимостьПереоценкиЕПС(РеквизитыПереоценки, НачалоДня(ЭтотОбъект.Дата), ТаблицаЦБ, ТаблицаСтоимостей, Отказ, РасшифровкаРасчета);
			
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	&Период КАК Период,
				|	&СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	&ВидУчета КАК ВидУчета,
				|	&ЦельРасчета КАК ЦельРасчета,
				|	 ТаблицаСтоимостейЦБ.*				
				|ПОМЕСТИТЬ СтоимостьПереоценки
				|ИЗ
				|	&ТаблицаСтоимостейЦБ КАК ТаблицаСтоимостейЦБ
				|ГДЕ
				|	(ТаблицаСтоимостейЦБ.ЦенаКотировки > 0
				|			ИЛИ ТаблицаСтоимостейЦБ.ВидЦены <> 0)";
			
			Запрос.УстановитьПараметр("ТаблицаСтоимостейЦБ",			ТаблицаСтоимостейЦБ);
			Запрос.УстановитьПараметр("Период",							НачалоДня(ЭтотОбъект.Дата));
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("ВидУчета",						ЭтотОбъект.ВидУчета);
			Запрос.УстановитьПараметр("ЦельРасчета",					ЭтотОбъект.ЦельРасчета);
			
			Запрос.Выполнить();
			
			#КонецОбласти
			
		КонецЕсли;		
				
		РаботаСПереоценкой.ПолучитьТабличнуюЧастьПереоценки(РеквизитыПереоценки, МенеджерВременныхТаблиц, Отказ, РасшифровкаРасчета);
		
		Если Отказ = Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заполнить таблицу бумаг", ЭтотОбъект.Ссылка);
			Возврат;
		КонецЕсли;
		
		ТаблицаСтоимостейЦББезПартий = ТаблицаСтоимостейЦБ;
		ТаблицаСтоимостейЦБ = РеквизитыПереоценки.ЦенныеБумаги;
		
		Документы.РегистрацияСтоимостиПереоценки.ЗаменитьКолонкиПереоценки(ТаблицаСтоимостейЦБ);
		
		#КонецОбласти
		
	КонецЕсли;

	Если ВыполнятьРасчетПоУказаниюЦБ Тогда
	
		#Область Подмена_цен_в_соответствии_с_указаниями_ЦБ

		Если НастройкиОценки.ВыполнятьРасчетПоУказаниюЦБ5419 Тогда
			
			ОбновитьСтоимостиВСоответствииСУказаниемЦБРФ5419У(ТаблицаСтоимостейЦБ, Не ОчиститьКупоныСуммыИКоличество, ПараметрыПолученияПартий, Отказ, РасшифровкаРасчета);				
			
		ИначеЕсли НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316 Тогда
			
			РеквизитыПереоценки.Вставить("НастройкиОценки",											 НастройкиОценки);
			РеквизитыПереоценки.Вставить("ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета", ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета);
			
			ОбновитьСтоимостиВСоответствииСУказаниемЦБРФ6073У(ТаблицаСтоимостейЦБ, Не ОчиститьКупоныСуммыИКоличество, РеквизитыПереоценки, Отказ, РасшифровкаРасчета);				
			
		КонецЕсли;
		
		ТаблицаСтоимостейЦББезПартий = Новый ТаблицаЗначений; // таблица без партий в данном случае некорректна

		#КонецОбласти
	
	КонецЕсли;
			
	// Обновление стоимости погашенных бумаг 
	
	Если Не ОценкаПрочихЦенныхБумаг Тогда
		
		ПараметрыОценки = Новый Структура("Дата, Организация, СчетДоверительногоУправления, ЦельРасчета");
		ЗаполнитьЗначенияСвойств(ПараметрыОценки, ЭтотОбъект);
		ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости", ВариантРасчетаСправедливойСтоимости);
		  		
		ОбновитьСтоимостиПогашенныхБумаг(ТаблицаСтоимостейЦБ, РаботаСПереоценкой.СпособОценкиПогашенныхЦенныхБумаг(ПараметрыОценки), ВестиРасчетПоПартиям, Отказ, РасшифровкаРасчета, ТаблицаЦенныхБумаг <> Неопределено);

	КонецЕсли;
	
	// 1. Если оценка прочих ц/б, то удаляем партии с одинаковой ценой.	
	// 2. Если ВыполнятьРасчетПоУказаниюЦБ5419, то партии оставляем.
	// 3. Если оценка объектов управлении:
	//    3.1. Если ВестиРасчетПоПартиям, тогда партии оставляем.
	//    3.2. Иначе удаляем партии с одинаковой ценой
	// 4. Иначе удаляем партии с одинаковой ценой.
	
	СвернутьПартииСОдинаковойЦеной = Ложь;
	Если ОценкаПрочихЦенныхБумаг Тогда
		СвернутьПартииСОдинаковойЦеной = Истина;
	ИначеЕсли Не ВыполнятьРасчетПоУказаниюЦБ Тогда
		СвернутьПартииСОдинаковойЦеной = Не (ЭтотОбъект.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки И ВестиРасчетПоПартиям);
	КонецЕсли;
	
	Если СвернутьПартииСОдинаковойЦеной Тогда
	
		#Область Удаление_партий_с_ценой_определенной_по_всей_бумаге
		
		Если ОценкаПрочихЦенныхБумаг И ВыполнятьРасчетПоУказаниюЦБ Тогда
			
			// в этом случае берем средневзвешенную цену покупки
			
			ТаблицаСвернуто = ТаблицаСтоимостейЦБ.Скопировать(, "ЦеннаяБумага, Цена, ЦенаКотировки, Количество");
			ТаблицаСвернуто.Колонки.Добавить("СуммаВВалютеУчета", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
			ТаблицаСвернуто.Колонки.Добавить("Сумма", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
			
			Для каждого СтрокаСвернуто Из ТаблицаСвернуто Цикл
			    СтрокаСвернуто.СуммаВВалютеУчета = СтрокаСвернуто.Цена * СтрокаСвернуто.Количество;				
				СтрокаСвернуто.Сумма = СтрокаСвернуто.ЦенаКотировки * СтрокаСвернуто.Количество;				
			КонецЦикла; 
			
			ТаблицаСвернуто.Свернуть("ЦеннаяБумага", "СуммаВВалютеУчета, Сумма, Количество");
			ТаблицаСтоимостейЦБ.Сортировать("ЦеннаяБумага, ДатаЦены Убыв");
			
			Для каждого СтрокаСвернуто Из ТаблицаСвернуто Цикл
			
				СтрокиПоЦеннойБумаге = ТаблицаСтоимостейЦБ.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаСвернуто.ЦеннаяБумага));
				ПерваяСтрока = Неопределено;
				
				Для каждого СтрокаПоЦеннойБумаге Из СтрокиПоЦеннойБумаге Цикл
				
					Если ПерваяСтрока = Неопределено Тогда
						ПерваяСтрока = СтрокаПоЦеннойБумаге;
						ПерваяСтрока.Цена = СтрокаСвернуто.СуммаВВалютеУчета / СтрокаСвернуто.Количество;
						ПерваяСтрока.ЦенаКотировки = СтрокаСвернуто.Сумма / СтрокаСвернуто.Количество;
					Иначе
						ТаблицаСтоимостейЦБ.Удалить(СтрокаПоЦеннойБумаге);
					КонецЕсли; 
				
				КонецЦикла; 
			
			КонецЦикла; 
			
		КонецЕсли;
		
		ПоляУникальностиЦены = "ЦеннаяБумага, ЦенаКотировки, ДатаЦены, ВалютаКотировки, ВидЦены, УровеньОценки, Источник";
		
		УникальныеЦены = ТаблицаСтоимостейЦБ.Скопировать(Неопределено, ПоляУникальностиЦены);
		УникальныеЦены.Колонки.Добавить("КоличествоСтрок", Новый ОписаниеТипов("Число"));
		УникальныеЦены.ЗаполнитьЗначения(1, "КоличествоСтрок");
		УникальныеЦены.Свернуть(ПоляУникальностиЦены, "КоличествоСтрок");
		УникальныеЦены.Индексы.Добавить("ЦеннаяБумага");
		
		УникальныеЦенныеБумаги = УникальныеЦены.Скопировать(Неопределено, "ЦеннаяБумага");
		УникальныеЦенныеБумаги.Колонки.Добавить("КоличествоЦен", Новый ОписаниеТипов("Число"));
		УникальныеЦенныеБумаги.ЗаполнитьЗначения(1, "КоличествоЦен");
		УникальныеЦенныеБумаги.Свернуть("ЦеннаяБумага", "КоличествоЦен");
		
		// Если цена одна для бумаги, то очищаем партию у всех
		// Если несколько цен для бумаги, то очищаем партию только там, где больше всего строк
		
		УникальныеЦеныДляОчисткиПартий = Новый Массив;
		
		Для Каждого СтрокаЦенныеБумаги Из УникальныеЦенныеБумаги Цикл
			Если СтрокаЦенныеБумаги.КоличествоЦен = 1 Тогда
				УникальныеЦеныДляОчисткиПартий.Добавить(УникальныеЦены.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага, "ЦеннаяБумага"));
			Иначе
				СтрокиСЦенами = УникальныеЦены.Скопировать(Новый Структура("ЦеннаяБумага", СтрокаЦенныеБумаги.ЦеннаяБумага));
				СтрокиСЦенами.Сортировать("КоличествоСтрок Убыв");
				УникальныеЦеныДляОчисткиПартий.Добавить(СтрокиСЦенами[0]);
			КонецЕсли;
		КонецЦикла;
		
		// Непосредственно зачистка партий
		
		СтруктураОтбораЦен = Новый Структура(ПоляУникальностиЦены);
		ТаблицаСтоимостейЦБ.Индексы.Добавить(ПоляУникальностиЦены);
		
		Для Каждого УникальнаяЦена Из УникальныеЦеныДляОчисткиПартий Цикл
			Если УникальнаяЦена.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтруктураОтбораЦен, УникальнаяЦена);
			
			СтрокиСЦенами		= ТаблицаСтоимостейЦБ.НайтиСтроки(СтруктураОтбораЦен);
			СтрокаСТекущейЦеной	= Неопределено;
			
			Для Каждого СтрокаСЦеной Из СтрокиСЦенами Цикл
				Если СтрокаСТекущейЦеной = Неопределено Тогда
					СтрокаСТекущейЦеной = СтрокаСЦеной;
					СтрокаСТекущейЦеной.Партия			= Неопределено;
					СтрокаСТекущейЦеной.СтрокаПартии	= 0;
				Иначе
					Если Не ОчиститьКупоныСуммыИКоличество Тогда
						СтрокаСТекущейЦеной.Количество				= СтрокаСТекущейЦеной.Количество			  + СтрокаСЦеной.Количество;
						СтрокаСТекущейЦеной.Сумма					= СтрокаСТекущейЦеной.Сумма					  + СтрокаСЦеной.Сумма;
						СтрокаСТекущейЦеной.СуммаКупона				= СтрокаСТекущейЦеной.СуммаКупона			  + СтрокаСЦеной.СуммаКупона;
						СтрокаСТекущейЦеной.СуммаВВалютеУчета		= СтрокаСТекущейЦеной.СуммаВВалютеУчета		  + СтрокаСЦеной.СуммаВВалютеУчета;						
						СтрокаСТекущейЦеной.СуммаКупонаВВалютеУчета	= СтрокаСТекущейЦеной.СуммаКупонаВВалютеУчета + СтрокаСЦеной.СуммаКупонаВВалютеУчета;
					КонецЕсли;
					
					ТаблицаСтоимостейЦБ.Удалить(СтрокаСЦеной);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		#КонецОбласти
		
	КонецЕсли;	
	
	// Удаление балансовых цен
	Если НЕ ЭтотОбъект.ЦельРасчета.ТолькоДляФиксацииСтоимостиОценки Тогда
		СтрокиБалансовые = ТаблицаСтоимостейЦБ.НайтиСтроки(Новый Структура("ВидЦены", Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена));
		Для Каждого СтрокаБалансовая Из СтрокиБалансовые Цикл
			ТаблицаСтоимостейЦБ.Удалить(СтрокаБалансовая);
		КонецЦикла;
	КонецЕсли;

	// Удаление купонов, сумм и количества
	
	Если ОчиститьКупоныСуммыИКоличество Тогда
		
		ТаблицаСтоимостейЦБ.ЗаполнитьЗначения(0, "Сумма, СуммаКупона, СуммаВВалютеУчета, СуммаКупонаВВалютеУчета, Количество");
		
	КонецЕсли;
	
	// Если ТаблицаСтоимостейЦБ была получена с разбивкой по партиям, а затем свернута в этом модуле,
	// то все суммы нужно перерассчитать по ценам и курсам заново, иначе возникнут расхождения.
	// Также пересчет необходим, если валютные суммы при пересчете в рубли следует предварительно округлять.  
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Пересчет_сумм
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСтоимостейЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСтоимостейЦБ.Партия КАК Партия,
		|	ТаблицаСтоимостейЦБ.СтрокаПартии КАК СтрокаПартии,
		|	ТаблицаСтоимостейЦБ.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ТаблицаСтоимостейЦБ.Рынок КАК Рынок,
		|	ТаблицаСтоимостейЦБ.Цена КАК Цена,
		|	ТаблицаСтоимостейЦБ.ЦенаКотировки КАК ЦенаКотировки,
		|	ТаблицаСтоимостейЦБ.Сумма КАК Сумма,
		|	ТаблицаСтоимостейЦБ.Количество КАК Количество,
		|	ТаблицаСтоимостейЦБ.ЦенаКупона КАК ЦенаКупона,
		|	ТаблицаСтоимостейЦБ.ЦенаКотировкиКупона КАК ЦенаКотировкиКупона,
		|	ВЫБОР
		|		КОГДА ТаблицаСтоимостейЦБ.ВидЦены = 0
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.ПустаяСсылка)
		|		ИНАЧЕ ТаблицаСтоимостейЦБ.ВидЦены
		|	КОНЕЦ КАК ВидЦены,
		|	ТаблицаСтоимостейЦБ.УровеньОценки КАК УровеньОценки,
		|	ВЫБОР
		|		КОГДА ТаблицаСтоимостейЦБ.ДатаЦены = 0
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ТаблицаСтоимостейЦБ.ДатаЦены
		|	КОНЕЦ КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА ТаблицаСтоимостейЦБ.ДатаЦеныКупона = 0
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ ТаблицаСтоимостейЦБ.ДатаЦеныКупона
		|	КОНЕЦ КАК ДатаЦеныКупона,
		|	ВЫБОР
		|		КОГДА ТаблицаСтоимостейЦБ.Источник = 0
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|		ИНАЧЕ ТаблицаСтоимостейЦБ.Источник
		|	КОНЕЦ КАК Источник,
		|	ТаблицаСтоимостейЦБ.СуммаКупона КАК СуммаКупона,
		|	ТаблицаСтоимостейЦБ.СуммаВВалютеУчета КАК СуммаВВалютеУчета,
		|	ТаблицаСтоимостейЦБ.СуммаКупонаВВалютеУчета КАК СуммаКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА ТаблицаСтоимостейЦБ.ВалютаКотировкиКупона = 0
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|		ИНАЧЕ ТаблицаСтоимостейЦБ.ВалютаКотировкиКупона
		|	КОНЕЦ КАК ВалютаКотировкиКупона,
		|	ТаблицаСтоимостейЦБ.Примечание КАК Примечание,
		|	ВЫБОР
		|		КОГДА ТаблицаСтоимостейЦБ.ВалютаКотировки = 0
