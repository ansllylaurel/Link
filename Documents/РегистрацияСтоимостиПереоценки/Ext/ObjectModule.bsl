		|				И (ДатыИзмененийНоминалаНаДатуОценки.Период = НоминалНаДатуОценки.Период)
		|		ПО (НоминалНаДатуОценки.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалНаДатуЦены
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ПодменяемыеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|				_ПодменяемыеБумаги.ДатаНоминала КАК ДатаНоминала,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_ПодменяемыеБумаги КАК _ПодменяемыеБумаги
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|						И (НоминалыЦенныхБумаг.Период <= _ПодменяемыеБумаги.ДатаНоминала)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ПодменяемыеБумаги.ЦеннаяБумага,
		|				_ПодменяемыеБумаги.ДатаНоминала) КАК ДатыИзмененийНоминалаНаДатуЦены
		|			ПО (ДатыИзмененийНоминалаНаДатуЦены.ЦеннаяБумага = НоминалНаДатуЦены.ЦеннаяБумага)
		|				И (ДатыИзмененийНоминалаНаДатуЦены.Период = НоминалНаДатуЦены.Период)
		|		ПО (НоминалНаДатуЦены.ЦеннаяБумага = _ПодменяемыеБумаги.ЦеннаяБумага)
		|			И (ДатыИзмененийНоминалаНаДатуЦены.ДатаНоминала = _ПодменяемыеБумаги.ДатаНоминала)
		|ГДЕ
		|	_ПодменяемыеБумаги.ДатаОценки ЕСТЬ НЕ NULL ");
	
	#КонецОбласти
	
	НачалоЗаморозкиСтоимости = '20220218';
	
	#Область Дата_последних_цен	
	
	ДатаПоследнихЦен = НачалоЗаморозкиСтоимости;
	
	// По письму Волги-Капитал СС берем на 17.02 (#421991)
	
	Если РеквизитыПереоценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал") Тогда
		ДатаПоследнихЦен = '20220217';	
	КонецЕсли;
	
    // Цены на 18.02.2022 в ЕПС у Достойного Будущего неправильные, т.к. СС дали только 28.02,
	// поэтому для него цены на 18.02 не берем

	Если НачалоДня(ЭтотОбъект.Дата) >= '20220228'
		И РеквизитыПереоценки.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов
		И РеквизитыПереоценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар")
	Тогда
		ДатаПоследнихЦен = '20220228';
	КонецЕсли;
	
	#КонецОбласти	
	
	// Профсуждения с повышенным приоритетом в приоритете
	
	ИсключаемыеБумаги = РеквизитыПереоценки.ДополнительныеСвойства.ОценкиСтоимости.Скопировать(Новый Структура("ОценкаЦены, ПовышенныйПриоритет", Истина, Истина));
	ИсключаемыеБумаги.Свернуть("ЦеннаяБумага");
	
	ДатыИЦеныПокупки = БухгалтерскийУчетЕПС.ПолучитьДатыИЦеныПокупки(ТаблицаСтоимостейЦБ, ЭтотОбъект.СчетДоверительногоУправления, НачалоДня(ЭтотОбъект.Дата)).Выгрузить();   	
		
	ИспользуетсяОценкаПоАмортизированнойСтоимости = РаботаСПереоценкой.ИспользуетсяОценкаПоАмортизированнойСтоимости(РеквизитыПереоценки.ВариантРасчетаОценочнойСтоимости, ЭтотОбъект.Дата);	
	УчетныеАктивыОцениваемыеПоАС				  = ?(ИспользуетсяОценкаПоАмортизированнойСтоимости, Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости(), Неопределено);
	
	// Сургутнефтегаз не применяет послабления для бумаг по РЕПО (#424568)
	
	ИсключатьПартииРЕПОиТПлюс = 
		РеквизитыПереоценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сургутнефтегаз")
			И РеквизитыПереоценки.ЦельРасчета <> Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	ЗапросПодмен.УстановитьПараметр("НачалоЗаморозкиСтоимости",				НачалоЗаморозкиСтоимости);
	ЗапросПодмен.УстановитьПараметр("ДатаПоследнихЦен",						ДатаПоследнихЦен);
	ЗапросПодмен.УстановитьПараметр("КонецДняПереоценкиГраницаВключая",		Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));	
	ЗапросПодмен.УстановитьПараметр("ДатаПереоценки",						НачалоДня(ЭтотОбъект.Дата));	
	ЗапросПодмен.УстановитьПараметр("Организация",							ЭтотОбъект.Организация);
	ЗапросПодмен.УстановитьПараметр("СчетДоверительногоУправления",			ЭтотОбъект.СчетДоверительногоУправления);
	ЗапросПодмен.УстановитьПараметр("ЦельРасчета",							ЭтотОбъект.ЦельРасчета);
	ЗапросПодмен.УстановитьПараметр("ВидЦеныОценки",						Перечисления.ВидыЦенОценки.ЦенаОценки);
	ЗапросПодмен.УстановитьПараметр("СтоимостиПереоценки",					ТаблицаСтоимостейЦБ);
	ЗапросПодмен.УстановитьПараметр("ДатыИЦеныПокупки",						ДатыИЦеныПокупки);
	
	ЗапросПодмен.УстановитьПараметр("ИсключатьБумагиОцениваемыеПоАС",		ИспользуетсяОценкаПоАмортизированнойСтоимости);
	ЗапросПодмен.УстановитьПараметр("УчетныеАктивыОцениваемыеПоАС",			УчетныеАктивыОцениваемыеПоАС);
	ЗапросПодмен.УстановитьПараметр("ИсключаемыеБумаги",					ИсключаемыеБумаги);
	ЗапросПодмен.УстановитьПараметр("ИсключатьПартииРЕПОиТПлюс",			ИсключатьПартииРЕПОиТПлюс);
	
	ВыборкаПодмен = ЗапросПодмен.Выполнить().Выбрать();
	
	ВыполнитьПодменуЦен(ТаблицаСтоимостейЦБ, ВыборкаПодмен, ПересчитыватьСуммы, Отказ, РеквизитыПереоценки);
	
	#Область Учет_изменения_дисконт_премии
	
	// Цены Сургутнефтегаза нужно корректировать на изменения дисконта/премии с 09.03 (#424568)
	
	Если ПересчитыватьСуммы
		И РеквизитыПереоценки.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сургутнефтегаз")
		И РеквизитыПереоценки.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении
	Тогда
		
		РаспределитьПогрешностиОкругленияСуммНаПартии(ТаблицаСтоимостейЦБ, РеквизитыПереоценки.НастройкиОценки, РеквизитыПереоценки.ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета, Отказ);
		
		// Проверяем дату запрета редактирования партий:
		// а) если дата запрета стоит (контроль СЧА прошлых периодов), то берем остатки на дату оценки из регистра;
		// б) иначе берем остатки на дату запрета партий, рассчитываем партии до даты оценки (полный расчет всех сумм) и корректируем полученные остатки с учетом рассчитанных движений.		
		
		НастройкиУчетаОбщие = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);

		Облигации = ТаблицаСтоимостейЦБ.Скопировать(Новый Структура("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации), "ЦеннаяБумага");
		Облигации.Свернуть("ЦеннаяБумага");
		Облигации = Облигации.ВыгрузитьКолонку(0);
		
		ОтборДатЗапрета = Новый Структура("Организация, СчетДоверительногоУправления, ГруппаЗапрета, ВидУчета",
			ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Перечисления.ГруппыЗапретаРедактирования.Партии, ЭтотОбъект.ВидУчета);
			
		ДатыЗапретаРедактированияПартий = РегистрыСведений.ДатыЗапретаРедактирования.ПолучитьДатыЗапретаРедактирования(ОтборДатЗапрета);
		ДатаЗапретаРедактированияПартий = ?(ДатыЗапретаРедактированияПартий.Количество() > 0, ДатыЗапретаРедактированияПартий[0].ДатаЗапретаРедактирования, '00010101');
				
		Если КонецДня(ДатаЗапретаРедактированияПартий) >= КонецДня(ЭтотОбъект.Дата) Тогда
			
			#Область Получение_остатков_партий_из_регистра	
			
			ЗапросПоследнейПереоценки = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумаг.Партия КАК Партия,
				|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
				|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
				|	БухПартииЦенныхБумаг.Период КАК Период,
				|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчетаКонечныйОстаток КАК СтоимостьВВалютеУчета,
				|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчетаКонечныйОстаток КАК ПереоценкаВВалютеУчета,
				|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчетаКонечныйОстаток КАК БалансовыеДисконтПремия,
				|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ) КАК ПродававшиесяСегодня
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.ОстаткиИОбороты(
				|			&НачалоПериода,
				|			&КонецПериода,
				|			ДЕНЬ,
				|			ДвиженияИГраницыПериода,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидУчета = &ВидУчета
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага В (&ЦенныеБумаги)) КАК БухПартииЦенныхБумаг
				|ГДЕ
				|	(БухПартииЦенныхБумаг.СтоимостьВВалютеУчетаОборот <> 0
				|			ИЛИ БухПартииЦенныхБумаг.ПереоценкаВВалютеУчетаОборот <> 0
				|			ИЛИ БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчетаОборот <> 0)
				|
				|УПОРЯДОЧИТЬ ПО
				|	БухПартииЦенныхБумаг.Партия,
				|	БухПартииЦенныхБумаг.СтрокаПартии,
				|	БухПартииЦенныхБумаг.УчетныйАктивЕПС,
				|	БухПартииЦенныхБумаг.Период УБЫВ");
			
			ЗапросПоследнейПереоценки.УстановитьПараметр("НачалоПериода",					'20220310');
			ЗапросПоследнейПереоценки.УстановитьПараметр("КонецПериода",					КонецДня(ЭтотОбъект.Дата));
			ЗапросПоследнейПереоценки.УстановитьПараметр("Организация",						ЭтотОбъект.Организация);
			ЗапросПоследнейПереоценки.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
			ЗапросПоследнейПереоценки.УстановитьПараметр("ВидУчета",						ЭтотОбъект.ВидУчета);
			ЗапросПоследнейПереоценки.УстановитьПараметр("Рынок",							Перечисления.РынкиЦенныхБумаг.Облигации);
			ЗапросПоследнейПереоценки.УстановитьПараметр("ЦенныеБумаги",					Облигации);
			
			ПоследниеПереоценки = ЗапросПоследнейПереоценки.Выполнить().Выгрузить();
			ПоследниеПереоценки.Индексы.Добавить("Партия, СтрокаПартии, УчетныйАктивЕПС");
			
			#КонецОбласти
			
		Иначе
			
			#Область Расчет_остатков_партий
			
			НастройкиВидаУчета = БухгалтерскийУчет.ОпределитьНастройкиПоВидуУчета(
				КонецДня(ЭтотОбъект.Дата), ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ВидУчета, Отказ);
			
			ПараметрыРасчетаПартий = Новый Структура;
			ПараметрыРасчетаПартий.Вставить("Организация", 					ЭтотОбъект.Организация);
			ПараметрыРасчетаПартий.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			ПараметрыРасчетаПартий.Вставить("ВидУчета", 					ЭтотОбъект.ВидУчета);
			ПараметрыРасчетаПартий.Вставить("НачалоПериода", 				НачалоДня(ДатаЗапретаРедактированияПартий) + 86400);
			ПараметрыРасчетаПартий.Вставить("КонецПериода", 				КонецДня(ЭтотОбъект.Дата));
			ПараметрыРасчетаПартий.Вставить("ТаблицаПлановыхОпераций", 		Неопределено);
			ПараметрыРасчетаПартий.Вставить("ОбъектДокумента", 				ЭтотОбъект);
			ПараметрыРасчетаПартий.Вставить("НастройкиПоВидуУчета", 		НастройкиВидаУчета);
			ПараметрыРасчетаПартий.Вставить("КоличественныйРасчет", 		Ложь);		
			
			РасчетПартий = РаботаСПереоценкой.ДинамическийРасчетПартий(ПараметрыРасчетаПартий, Ложь);
			
			// Получаем конечные остатки
			
			ЗапросПоследнейПереоценки = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумаг.Партия КАК Партия,
				|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
				|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
				|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета,
				|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчетаОстаток КАК ПереоценкаВВалютеУчета,
				|	БухПартииЦенныхБумаг.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК БалансовыеДисконтПремия,
				|	ЛОЖЬ КАК ПродававшиесяСегодня
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|			&КонецПериода,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидУчета = &ВидУчета
				|				И Рынок = &Рынок
				|				И ЦеннаяБумага В (&ЦенныеБумаги)) КАК БухПартииЦенныхБумаг");
			
			ЗапросПоследнейПереоценки.УстановитьПараметр("КонецПериода",					Новый Граница(КонецДня(ДатаЗапретаРедактированияПартий), ВидГраницы.Включая));
			ЗапросПоследнейПереоценки.УстановитьПараметр("Организация",						ЭтотОбъект.Организация);
			ЗапросПоследнейПереоценки.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
			ЗапросПоследнейПереоценки.УстановитьПараметр("ВидУчета",						ЭтотОбъект.ВидУчета);
			ЗапросПоследнейПереоценки.УстановитьПараметр("Рынок",							Перечисления.РынкиЦенныхБумаг.Облигации);
			ЗапросПоследнейПереоценки.УстановитьПараметр("ЦенныеБумаги",					Облигации);
			
			ПоследниеПереоценки = ЗапросПоследнейПереоценки.Выполнить().Выгрузить();
			ПоследниеПереоценки.Индексы.Добавить("Партия, СтрокаПартии, УчетныйАктивЕПС");			
			
			Для каждого ДвижениеПереоценки Из РасчетПартий.РассчитанныеПартии Цикл
			
				Если ЗначениеЗаполнено(ДвижениеПереоценки.Регистратор)
					И Не (ДвижениеПереоценки.СтоимостьВВалютеУчета = 0 И ДвижениеПереоценки.ПереоценкаВВалютеУчета = 0 И ДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета = 0)
				Тогда
					
					ПоследняяПереоценка = ПоследниеПереоценки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии, УчетныйАктивЕПС", ДвижениеПереоценки.Партия, ДвижениеПереоценки.СтрокаПартии, ДвижениеПереоценки.УчетныйАктивЕПС));
					
					Если ПоследняяПереоценка.Количество() > 0 Тогда
						
						ПоследняяПереоценка = ПоследняяПереоценка[0];
						
						ЗнакДвижения = ?(ДвижениеПереоценки.ВидДвижения = Перечисления.ВидыДвижений.Расход, -1, 1);
						
						ПоследняяПереоценка.СтоимостьВВалютеУчета	= ПоследняяПереоценка.СтоимостьВВалютеУчета + ЗнакДвижения * ДвижениеПереоценки.СтоимостьВВалютеУчета;
						ПоследняяПереоценка.ПереоценкаВВалютеУчета	= ПоследняяПереоценка.ПереоценкаВВалютеУчета + ЗнакДвижения * ДвижениеПереоценки.ПереоценкаВВалютеУчета;
						ПоследняяПереоценка.БалансовыеДисконтПремия	= ПоследняяПереоценка.БалансовыеДисконтПремия + ЗнакДвижения * ДвижениеПереоценки.ДисконтПремияНачисленныйВВалютеУчета;
						
						Если НастройкиУчетаОбщие.УтреннееНачислениеДисконтаПремии
							И НачалоДня(ДвижениеПереоценки.Период) = НачалоДня(ЭтотОбъект.Дата)
							И ДвижениеПереоценки.ВидДвижения = Перечисления.ВидыДвижений.Расход
							И ДвижениеПереоценки.Количество <> 0
							И Не (ТипЗнч(ДвижениеПереоценки.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг")
								И НастройкиУчетаОбщие.НеСчитатьВводыВыводыЦенныхБумагОперациямиДляНачисленияПроцентногоДохода)
						Тогда
							ПоследняяПереоценка.ПродававшиесяСегодня = Истина;
						КонецЕсли;

					КонецЕсли;
					
				КонецЕсли;
			
			КонецЦикла; 
			
			#КонецОбласти
			
		КонецЕсли;		
		
		// Расчет изменения дисконт/премии
		
		Для Каждого СтрокаЦенныеБумаги Из ТаблицаСтоимостейЦБ Цикл 		
			
			НастройкиУчетаЦеннойБумаги = БухгалтерскийУчет.ПолучитьОбщиеНастройкиСУчетомНастроекЦеннойБумаги(
				НастройкиУчетаОбщие,
				СтрокаЦенныеБумаги.ЦеннаяБумага,
				СтрокаЦенныеБумаги.УчетныйАктивЕПС,
				СтрокаЦенныеБумаги.Партия,
				СтрокаЦенныеБумаги.СтрокаПартии);
			
			Если ИсключаемыеБумаги.Найти(СтрокаЦенныеБумаги.ЦеннаяБумага) <> Неопределено Тогда // Профсуждения с повышенным приоритетом в приоритете
				Продолжить;
			КонецЕсли;
			
			// Строка покупки
			
			СтрокиПокупки = ДатыИЦеныПокупки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии));
			
			Если СтрокиПокупки.Количество() = 0 Тогда
				Продолжить;	
			Иначе
				СтрокаПокупки = СтрокиПокупки[0];		
			КонецЕсли;
			
			// Последняя переоценка
			
			ПоследняяПереоценка = ПоследниеПереоценки.НайтиСтроки(Новый Структура("Партия, СтрокаПартии, УчетныйАктивЕПС", СтрокаЦенныеБумаги.Партия, СтрокаЦенныеБумаги.СтрокаПартии, СтрокаЦенныеБумаги.УчетныйАктивЕПС));
			
			Если ПоследняяПереоценка.Количество() = 0 Тогда
				
				РасчетОтПереоценки		= Ложь;
				БалансовыеДисконтПремия	= Неопределено;
				
			Иначе
				
				РасчетОтПереоценки		= Истина;
				ПоследняяПереоценка		= ПоследняяПереоценка[0];
				БалансовыеДисконтПремия	= ПоследняяПереоценка.БалансовыеДисконтПремия;
				
				Если СтрокаЦенныеБумаги.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации И СтрокаЦенныеБумаги.ЦеннаяБумага.ИндексируемыйНоминал Тогда
					РасчетОтПереоценки = Ложь; // Не знаю, что с этим поделать
				КонецЕсли;
				
			КонецЕсли;	
				
			// Текущие дисконт/премия
			ДанныеПереоценки = Новый Структура;
			ДанныеПереоценки.Вставить("ДатаПереоценки", КонецДня(ЭтотОбъект.Дата));
			ДанныеПереоценки.Вставить("Количество", СтрокаЦенныеБумаги.Количество);
			ДанныеПереоценки.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
			ДанныеПереоценки.Вставить("УчетныйАктивЕПС", СтрокаЦенныеБумаги.УчетныйАктивЕПС);
			
			ДанныеПокупки = Новый Структура;
			ДанныеПокупки.Вставить("НачальныйДисконт", СтрокаПокупки.НачальныйДисконт);
			ДанныеПокупки.Вставить("ДатаПокупки", СтрокаПокупки.ДатаПокупки);
			ДанныеПокупки.Вставить("ЦенаПокупки", СтрокаПокупки.ЦенаПокупки);
			
			РасчетДисконтПремии = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчетаЦеннойБумаги, ДанныеПереоценки, ДанныеПокупки, Отказ);
				
			ОценочныеДисконтПремия = Окр(РасчетДисконтПремии.ОценочныеДисконтПремия, 2);
			
			Если БалансовыеДисконтПремия <> Неопределено И СтрокаПокупки.НачальныйДисконт > 0 И ОценочныеДисконтПремия > БалансовыеДисконтПремия	// недосписали премии
				ИЛИ БалансовыеДисконтПремия <> Неопределено И СтрокаПокупки.НачальныйДисконт < 0 И ОценочныеДисконтПремия < БалансовыеДисконтПремия	// недоначислили дисконта
			Тогда
				ОценочныеДисконтПремия = БалансовыеДисконтПремия;	
			КонецЕсли;
			
			// Учет изменения дисконт/премии
			
			Если РасчетОтПереоценки Тогда
				
				Если НастройкиУчетаОбщие.УтреннееНачислениеДисконтаПремии И ПоследняяПереоценка.ПродававшиесяСегодня Тогда
					ОценочныеДисконтПремия = БалансовыеДисконтПремия; // Не нужно начислять дисконт/премию по тем бумагам и партиям, которые сегодня продавались - все уже начислено
				КонецЕсли;
				
				СтрокаЦенныеБумаги.Сумма = ПоследняяПереоценка.СтоимостьВВалютеУчета + ПоследняяПереоценка.ПереоценкаВВалютеУчета + ОценочныеДисконтПремия;
				
			Иначе
				
				// Балансовые дисконт/премия:
				// - на 09.03.2022 для бумаг, купленных до 09.03.2022
				// - на дату покупки - для бумаг, купленных после 09.03.2022
				
				ДатаБалансовыхДисконтПремия = ?(СтрокаПокупки.ДатаПокупки < '20220309', '20220309', СтрокаПокупки.ДатаПокупки);  
				
				// Текущие дисконт/премия
				ДанныеПереоценки = Новый Структура;
				ДанныеПереоценки.Вставить("ДатаПереоценки", КонецДня(ДатаБалансовыхДисконтПремия));
				ДанныеПереоценки.Вставить("Количество", СтрокаЦенныеБумаги.Количество);
				ДанныеПереоценки.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
				ДанныеПереоценки.Вставить("УчетныйАктивЕПС", СтрокаЦенныеБумаги.УчетныйАктивЕПС);
				
				ДанныеПокупки = Новый Структура;
				ДанныеПокупки.Вставить("НачальныйДисконт", СтрокаПокупки.НачальныйДисконт);
				ДанныеПокупки.Вставить("ДатаПокупки", СтрокаПокупки.ДатаПокупки);
				ДанныеПокупки.Вставить("ЦенаПокупки", СтрокаПокупки.ЦенаПокупки);
				
				РасчетБалансовыхДисконтПремии = БухгалтерскийУчетЕПС.РассчитатьАмортизациюДисконтаПремии(СтрокаЦенныеБумаги.ЦеннаяБумага, НастройкиУчетаЦеннойБумаги, ДанныеПереоценки, ДанныеПокупки, Отказ);
				
				БалансовыеДисконтПремия	= Окр(РасчетБалансовыхДисконтПремии.ОценочныеДисконтПремия, 2);
				
				СтрокаЦенныеБумаги.Сумма = СтрокаЦенныеБумаги.Сумма + (ОценочныеДисконтПремия - БалансовыеДисконтПремия);
				
			КонецЕсли;
			
			СтрокаЦенныеБумаги.СуммаВВалютеУчета	= СтрокаЦенныеБумаги.Сумма;
			СтрокаЦенныеБумаги.Цена					= СтрокаЦенныеБумаги.Сумма / СтрокаЦенныеБумаги.Количество;
			СтрокаЦенныеБумаги.ЦенаКотировки		= СтрокаЦенныеБумаги.Цена;
			
		КонецЦикла;		
		
	КонецЕсли;
	
	#КонецОбласти	
	
КонецПроцедуры

Процедура ВыполнитьПодменуЦен(ТаблицаСтоимостейЦБ, ВыборкаПодмен, ПересчитыватьСуммы, Отказ, РеквизитыПереоценки = Неопределено)

	// Заполняем вспомогательные при пересчете сумм реквизиты
	
	Если ПересчитыватьСуммы И РеквизитыПереоценки <> Неопределено Тогда
		ВалютаУчета = РеквизитыПереоценки.Организация.ВалютаУчета;	
	КонецЕсли;
	
	// Выполняем замену и пересчет сумм
	
	ТаблицаСтоимостейЦБ.Индексы.Добавить("НомерСтроки");
	
	Пока ВыборкаПодмен.Следующий() Цикл
		
		// Проверка, что все данные получены
		
		ОшибкаПодмены = Ложь;
		
		Если ВыборкаПодмен.Цена = NULL Тогда
		    ТекстОшибки = СтрШаблон("Не удалось определить цену '%1' на %2",
				ВыборкаПодмен.ЦеннаяБумага, Формат(ВыборкаПодмен.ДатаОценки, "ДФ=dd.MM.yyyy")); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , , ОшибкаПодмены);
		КонецЕсли;
		
		Если ВыборкаПодмен.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации
			И (ВыборкаПодмен.НоминалНаДатуОценки = NULL ИЛИ ВыборкаПодмен.НоминалНаДатуЦены = NULL)
		Тогда
		    ТекстОшибки = СтрШаблон("Не удалось определить номинал '%1' на %2",
				ВыборкаПодмен.ЦеннаяБумага, Формат(?(ВыборкаПодмен.НоминалНаДатуЦены = NULL, ВыборкаПодмен.ДатаОценки, ЭтотОбъект.Дата), "ДФ=dd.MM.yyyy")); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, , , ОшибкаПодмены);
		КонецЕсли;
		
		// Подмена цен и перерасчет сумм
		
		СтрокаТабличнойЧасти = ТаблицаСтоимостейЦБ.Найти(ВыборкаПодмен.НомерСтроки, "НомерСтроки");
		
		Если ОшибкаПодмены Тогда
			
			РаботаСПереоценкой.ЗаполнитьСтрокуЦеннойБумагиПриОшибкеРасчетаЦены(СтрокаТабличнойЧасти);
			
		Иначе
		
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ВыборкаПодмен, "ДатаЦены, Источник, УровеньОценки, ВидЦены, Цена, ВалютаКотировки"); 
			
			Если ВыборкаПодмен.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				СтрокаТабличнойЧасти.Цена = СтрокаТабличнойЧасти.Цена * (ВыборкаПодмен.НоминалНаДатуОценки / ВыборкаПодмен.НоминалНаДатуЦены);
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаТабличнойЧасти.ЦенаКотировки = СтрокаТабличнойЧасти.Цена;
		
		Если ПересчитыватьСуммы Тогда
			
			Если СтрокаТабличнойЧасти.ВалютаНоминала = ВалютаУчета Тогда
				
				СтрокаТабличнойЧасти.Сумма				= Окр(СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество, 2);
				СтрокаТабличнойЧасти.СуммаВВалютеУчета	= СтрокаТабличнойЧасти.Сумма;
				
			Иначе
				
				СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Цена * СтрокаТабличнойЧасти.Количество;

				СтрокаТабличнойЧасти.СуммаВВалютеУчета = РаботаСВалютами.ПолучитьСуммыВВалютеУчета(
					Новый Структура("Сумма", СтрокаТабличнойЧасти.Сумма),
					СтрокаТабличнойЧасти.ВалютаНоминала,
					ЭтотОбъект.Организация,
					ЭтотОбъект.Дата,
					?(ЗначениеЗаполнено(СтрокаТабличнойЧасти.КурсВалютыНоминала), СтрокаТабличнойЧасти.КурсВалютыНоминала, Неопределено),
					Отказ).Сумма;

			КонецЕсли;

		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Обновляет стоимости погашенных, но еще не списанных бумаг
//
// Параметры:
//	ТаблицаСтоимостейЦБ - ТаблицаЗначений - таблица ценных бумаг
//	ВариантУчетаПогашенныхБумаг - Строка, варианты:
//  	ОцениватьПоНулевойСтоимостиСВидомЦеныПогашена 	- ЦБ с ценой 0 и видом цены Погашена		
//      ОцениватьПоОстаткуЗадолженности 				- ЦБ ценой пропорционально неоплаченной части номинала, видом цены Номинал
//      СписыватьПриПолномПогашенииВМоментПогашения 	- ЦБ не учитывается в стоимости переоценки с момента начисления задолженности по полному погашению
//      ОцениватьПоБалансовойСтоимости				 	- ЦБ удаляется из таблицы стоимостей, это для цели расчета ЕПС: бумагу не оцениваем, в переоценки идет по балансу
//	Отказ - Булево
//	РасшифровкаРасчета - Структура, Неопределено - расшифровка расчета
//
Процедура ОбновитьСтоимостиПогашенныхБумаг(ТаблицаСтоимостейЦБ, СпособОценкиПогашенныхБумаг, ВестиРасчетПоПартиям, Отказ, РасшифровкаРасчета, ОтборПоТаблицеСтоимостей)
	
	Запрос = Новый Запрос;
	
	#Область Текст_запроса_заблокированных_бумаг
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСтоимостейЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаСтоимостейЦБ.Количество КАК Количество
		|ПОМЕСТИТЬ _ТаблицаСтоимостейЦБ
		|ИЗ
		|	&ТаблицаСтоимостейЦБ КАК ТаблицаСтоимостейЦБ
		|ГДЕ
		|	ТаблицаСтоимостейЦБ.Рынок В(&ТипыПогашаемыхЦБ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагЗаблокированныеОстатки.КоличествоОстаток КАК КоличествоПогашено,
		|	СУММА(ЕСТЬNULL(_ТаблицаСтоимостейЦБ.Количество, 0)) КАК КоличествоПоДокументу,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
		|	КОНЕЦ КАК ВалютаНоминала
		|ПОМЕСТИТЬ _Заблокированные
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные.Остатки(
		|			&Период,
		|			ВидБлокировкиАктива = ЗНАЧЕНИЕ(Перечисление.ВидыБлокировокАктивов.Погашение)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок В (&ТипыПогашаемыхЦБ)
		|				И &ФильтрПоЦеннойБумаге) КАК ОстаткиЦенныхБумагЗаблокированныеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаСтоимостейЦБ КАК _ТаблицаСтоимостейЦБ
		|		ПО (_ТаблицаСтоимостейЦБ.ЦеннаяБумага = ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &СписыватьПриПолномПогашенииВМоментПогашения
		|				ТОГДА ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага В
		|						(ВЫБРАТЬ
		|							_ТаблицаСтоимостейЦБ.ЦеннаяБумага
		|						ИЗ
		|							_ТаблицаСтоимостейЦБ)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага,
		|	ОстаткиЦенныхБумагЗаблокированныеОстатки.КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагЗаблокированныеОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
		|	КОНЕЦ" + "
		|;";
	
	ТипыПогашаемыхЦБ = Новый Массив;
	ТипыПогашаемыхЦБ.Добавить(Перечисления.РынкиЦенныхБумаг.Облигации);
	ТипыПогашаемыхЦБ.Добавить(Перечисления.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия);
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦеннойБумаге", "ЦеннаяБумага = &ЦеннаяБумага");
		Запрос.УстановитьПараметр("ЦеннаяБумага", РасшифровкаРасчета.ЦеннаяБумага);
	ИначеЕсли ОтборПоТаблицеСтоимостей Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦеннойБумаге", "ЦеннаяБумага В (
			|ВЫБРАТЬ 
			|	_ТаблицаСтоимостейЦБ.ЦеннаяБумага 
			|ИЗ 
			|	_ТаблицаСтоимостейЦБ КАК _ТаблицаСтоимостейЦБ)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ФильтрПоЦеннойБумаге", "ИСТИНА");
	КонецЕсли;	
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период",											Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",									ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",					ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСтоимостейЦБ",							ТаблицаСтоимостейЦБ);
	Запрос.УстановитьПараметр("ТипыПогашаемыхЦБ",								ТипыПогашаемыхЦБ);
	Запрос.УстановитьПараметр("ПериодНачалоДня", 								НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ПериодКонецДня",	 								КонецДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СписыватьПриПолномПогашенииВМоментПогашения", 	СпособОценкиПогашенныхБумаг = "СписыватьПриПолномПогашенииВМоментПогашения");
	
	Если СпособОценкиПогашенныхБумаг = "ОцениватьПоОстаткуЗадолженности" Тогда
		
		#Область Текст_запроса_оценки_по_остатку_задолженности
		
		Запрос.Текст = Запрос.Текст + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Заблокированные.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_Заблокированные.КоличествоПогашено КАК КоличествоПогашено,
			|	_Заблокированные.КоличествоПоДокументу КАК КоличествоПоДокументу,
			|	ВЫРАЗИТЬ(ЕСТЬNULL(ОстатокЗадолженности.Сумма, 0) / _Заблокированные.КоличествоПогашено КАК ЧИСЛО(1, 0)) КАК ЦенаКотировки,
			|	ВЫРАЗИТЬ(ЕСТЬNULL(ОстатокЗадолженности.Сумма, 0) / _Заблокированные.КоличествоПогашено КАК ЧИСЛО(1, 0)) КАК Цена,
			|	ЕСТЬNULL(ОстатокЗадолженности.Сумма, 0) КАК Сумма,
			|	ЕСТЬNULL(ОстатокЗадолженности.СуммаВВалютеУчета, 0) КАК СуммаВВалютеУчета,
			|	_Заблокированные.ВалютаНоминала КАК ВалютаКотировки,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(ОстатокЗадолженности.Сумма, 0) = 0
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена)
			|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Номинал)
			|	КОНЕЦ КАК ВидЦены,
			|	0 КАК ЦенаКотировкиКупона,
			|	0 КАК ЦенаКупона,
			|	0 КАК СуммаКупона,
			|	0 КАК СуммаКупонаВВалютеУчета,
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКотировкиКупона,
			|	0 КАК УровеньОценки,
			|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Источник,
			|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс,
			|	&ПериодНачалоДня КАК ДатаЦены
			|ИЗ
			|	_Заблокированные КАК _Заблокированные
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
			|		ПО (КурсыВалют.Валюта = _Заблокированные.ВалютаНоминала)
			|			И (КурсыВалют.Период = &ПериодНачалоДня)
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			СУММА(ЗадолженностьПоДСОстатки.СуммаОстаток * КурсыВалютОплаты.Курс / КурсыВалютОплаты.Кратность) КАК СуммаВВалютеУчета,
			|			СУММА(ЗадолженностьПоДСОстатки.СуммаОстаток * (КурсыВалютОплаты.Курс * КурсыВалютНоминала.Кратность) / (КурсыВалютНоминала.Курс * КурсыВалютОплаты.Кратность)) КАК Сумма,
			|			ВЫРАЗИТЬ(ЗадолженностьПоДСОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК ЦеннаяБумага
			|		ИЗ
			|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
			|					&Период,
			|					Организация = &Организация
			|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|						И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
			|						И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
			|						И Основание ССЫЛКА Документ.ПогашениеЦеннойБумаги) КАК ЗадолженностьПоДСОстатки
			|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютОплаты
			|				ПО (КурсыВалютОплаты.Валюта = ЗадолженностьПоДСОстатки.Валюта)
			|					И (КурсыВалютОплаты.Период = &ПериодНачалоДня)
			|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютНоминала
			|				ПО (КурсыВалютНоминала.Валюта = ВЫБОР
			|						КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностьПоДСОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.Облигации)
			|							ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЗадолженностьПоДСОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
			|						КОГДА ТИПЗНАЧЕНИЯ(ВЫРАЗИТЬ(ЗадолженностьПоДСОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|							ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЗадолженностьПоДСОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
			|					КОНЕЦ)
			|					И (КурсыВалютНоминала.Период = &ПериодНачалоДня)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ВЫРАЗИТЬ(ЗадолженностьПоДСОстатки.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага) КАК ОстатокЗадолженности
			|		ПО _Заблокированные.ЦеннаяБумага = ОстатокЗадолженности.ЦеннаяБумага";
		
		
		ТипЧислаЦенаСоЗнаком = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦенаСоЗнаком.Тип.КвалификаторыЧисла;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(1, 0)", СтрШаблон("ЧИСЛО(%1, %2)", ТипЧислаЦенаСоЗнаком.Разрядность, ТипЧислаЦенаСоЗнаком.РазрядностьДробнойЧасти));
		
		#КонецОбласти
		
	Иначе
		
		#Область Текст_запроса_обнуления_стоимости_бумаг
		
		Запрос.Текст = Запрос.Текст + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Заблокированные.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_Заблокированные.КоличествоПогашено КАК КоличествоПогашено,
			|	_Заблокированные.КоличествоПоДокументу КАК КоличествоПоДокументу,
			|	0 КАК ЦенаКотировки,
			|	0 КАК Цена,
			|	0 КАК Курс,
			|	0 КАК Сумма,
			|	0 КАК СуммаВВалютеУчета,
			|	_Заблокированные.ВалютаНоминала КАК ВалютаКотировки,
			|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.Погашена) КАК ВидЦены,
			|	0 КАК ЦенаКотировкиКупона,
			|	0 КАК ЦенаКупона,
			|	0 КАК СуммаКупона,
			|	0 КАК СуммаКупонаВВалютеУчета,
			|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК ВалютаКотировкиКупона,
			|	0 КАК УровеньОценки,
			|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Источник,
			|	&ПериодНачалоДня КАК ДатаЦены
			|ИЗ
			|	_Заблокированные КАК _Заблокированные";
		
		#КонецОбласти
		
	КонецЕсли; 
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ЗаменяемыеПоля = "ЦенаКотировки, Цена, ВалютаКотировки, ВидЦены, ДатаЦены, ЦенаКотировкиКупона, ЦенаКупона, СуммаКупона, СуммаКупонаВВалютеУчета, ВалютаКотировкиКупона, УровеньОценки, Источник";
		
		Если Не (СпособОценкиПогашенныхБумаг = "ОцениватьПоОстаткуЗадолженности" И ВестиРасчетПоПартиям) Тогда
			ЗаменяемыеПоля = ЗаменяемыеПоля + ", Сумма, СуммаВВалютеУчета";
		КонецЕсли;	
		
		ОблигацииНаБалансеСПрошедшимПогашением = Неопределено;
	
		КонтролироватьКоличество = (ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении
			И РасшифровкаРасчета = Неопределено); // При расшифровке расчета важна только стоимость
			
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ЭтотОбъект.ЦельРасчета = Справочники.ЦелиРасчета.ЕдиныйПланСчетов
				И (Выборка.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ВейлФинанс")
					ИЛИ Выборка.ЦеннаяБумага = ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_О1Пропертиз_До2"))
			Тогда
				Продолжить; // Эволюция в ЕПС не считает погашение, продожаем оценивать бумагу по профсуждению, а в СЧА каждый день колотят руками дебиторку #464506
			КонецЕсли;
			
			Если СпособОценкиПогашенныхБумаг = "ОцениватьПоБалансовойСтоимости" Тогда
				
				Если ОблигацииНаБалансеСПрошедшимПогашением = Неопределено Тогда
					ОблигацииНаБалансеСПрошедшимПогашением = БухгалтерскийУчетЕПС.ПолучитьОблигацииНаБалансеСПрошедшимПогашением();
				КонецЕсли;
				
				Если ОблигацииНаБалансеСПрошедшимПогашением.Найти(Выборка.ЦеннаяБумага) = Неопределено Тогда
					НайденныеСтроки = ТаблицаСтоимостейЦБ.НайтиСтроки(Новый Структура("ЦеннаяБумага", Выборка.ЦеннаяБумага));
					Для каждого СтрокаТЗ Из НайденныеСтроки Цикл
						СтрокаТЗ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена;
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли КонтролироватьКоличество
				И (Выборка.КоличествоПогашено <> Выборка.КоличествоПоДокументу
					ИЛИ СпособОценкиПогашенныхБумаг = "СписыватьПриПолномПогашенииВМоментПогашения")
			Тогда
				
				ТекстОшибки = РаботаСоСтрокамиКлиентСервер.ПодставитьПараметрыВСтроку(
					"Ошибка при определении стоимости облигации %1. Количество по документу: %2, погашено: %3%4",
					Выборка.ЦеннаяБумага,
					Выборка.КоличествоПоДокументу,
					Выборка.КоличествоПогашено,
					?(СпособОценкиПогашенныхБумаг = "СписыватьПриПолномПогашенииВМоментПогашения", ". По настройкам учета, ЦБ должна быть списана при погашении", ""));
					
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,,,Отказ);
				
			Иначе
				
				Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Дата);
				НайденныеСтроки = ТаблицаСтоимостейЦБ.НайтиСтроки(Новый Структура("ЦеннаяБумага", Выборка.ЦеннаяБумага));
				Для каждого СтрокаТЗ Из НайденныеСтроки Цикл
					
					// Дефолты, установленные профсуждениями, пропускаем в любом случае. 
					// Дефолты, полученные по другим данным, пропускаем только при оценке по остатку задолженности
					Если СтрокаТЗ.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.Дефолт И (СпособОценкиПогашенныхБумаг = "ОцениватьПоОстаткуЗадолженности" 
							Или СтрокаТЗ.Источник = Клиент И ЭтотОбъект.Дата >= '20250101') Тогда
						Продолжить; 
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(СтрокаТЗ, Выборка, ЗаменяемыеПоля);
					Если ВестиРасчетПоПартиям Тогда
						СтрокаТЗ.Сумма 				= СтрокаТЗ.Количество * Выборка.Цена;
						СтрокаТЗ.СуммаВВалютеУчета 	= СтрокаТЗ.Количество * Выборка.Цена * Выборка.Курс;
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
	 
		КонецЦикла;
		
		// Добавим расшифровку расчета
		
		Если РасшифровкаРасчета <> Неопределено Тогда
			РаботаСДокументами.ДобавитьРасшифровкуОперации(РасшифровкаРасчета, , "Погашенные, но еще не списанные бумаги", РезультатЗапроса.Выгрузить());	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПустаяТаблицаСтоимостей()

	МетаданныеСтоимостиПереоценки = Метаданные.Документы.РегистрацияСтоимостиПереоценки.ТабличныеЧасти.СтоимостиПереоценки.Реквизиты;
	
	ТаблицаСтоимостей = Новый ТаблицаЗначений;
	
	ТаблицаСтоимостей.Колонки.Добавить("Рынок",				МетаданныеСтоимостиПереоценки.Рынок.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("ЦеннаяБумага",		МетаданныеСтоимостиПереоценки.ЦеннаяБумага.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("ВидЦены",			МетаданныеСтоимостиПереоценки.ВидЦены.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("ВалютаКотировки",	МетаданныеСтоимостиПереоценки.ВалютаКотировки.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("Стоимость",			МетаданныеСтоимостиПереоценки.Цена.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("ДатаЦены",			МетаданныеСтоимостиПереоценки.ДатаЦены.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("УровеньОценки",		МетаданныеСтоимостиПереоценки.УровеньОценки.Тип);
	ТаблицаСтоимостей.Колонки.Добавить("Источник",			МетаданныеСтоимостиПереоценки.Источник.Тип);
	
	Возврат ТаблицаСтоимостей;
	
КонецФункции

Функция ПолучитьТаблицуСтоимостейИзФайла(АдресФайла, СообщатьПриОшибкахПоиска = Истина)
	
	Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда		
		ПутьКФайлу				= ПолучитьИмяВременногоФайла("xml");
		УдалитьФайлПослеЧтения	= Истина;
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
		ДвоичныеДанные.Записать(ПутьКФайлу);
	Иначе
		ПутьКФайлу				= АдресФайла;
		УдалитьФайлПослеЧтения	= Ложь;
		
		ОписаниеФайла = Новый Файл(ПутьКФайлу);
		Если Не ОписаниеФайла.Существует() ИЛИ Не ОписаниеФайла.ЭтоФайл() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке стоимостей ценных бумаг из файла клиента: некорректный путь или ошибка доступа к файлу " + ПутьКФайлу);
			Возврат Неопределено;	
		КонецЕсли;
	КонецЕсли;
	
	ДанныеФайла = Новый ТаблицаЗначений;
	ДанныеФайла.Колонки.Добавить("ISIN",			Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	ДанныеФайла.Колонки.Добавить("Стоимость",		Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦенаСоЗнаком.Тип);
	ДанныеФайла.Колонки.Добавить("УровеньОценки",	Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10)));
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлу);

	ПостроительDOM	= Новый ПостроительDOM;
	ДокументDOM		= ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();

	Если УдалитьФайлПослеЧтения Тогда
		УдалитьФайлы(ПутьКФайлу);
	КонецЕсли;	
	
	Элемент			= ДокументDOM.ЭлементДокумента;
	Разыменователь	= Новый РазыменовательПространствИменDOM(Элемент);
	ВыборкаXPath	= ДокументDOM.ВычислитьВыражениеXPath("//СправедливаяСтоимость[@Дата=""" + Формат(ЭтотОбъект.Дата, "ДФ=yyyy-MM-ddT00:00:00") + """]/ЦеннаяБумага", Элемент, Разыменователь);

	Пока Истина Цикл

		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		
		Если ЭлементDOM = Неопределено Тогда
			Прервать;
		КонецЕсли; 
		
		СтрокаТаблицы = ДанныеФайла.Добавить();
		
		Для Каждого Узел Из ЭлементDOM.ДочерниеУзлы Цикл
			
			Если Узел.ИмяУзла = "ISIN" Тогда
				СтрокаТаблицы.ISIN = Узел.ТекстовоеСодержимое;
			ИначеЕсли Узел.ИмяУзла = "СС" Тогда
				СтрокаТаблицы.Стоимость = Узел.ТекстовоеСодержимое;
			ИначеЕсли Узел.ИмяУзла = "Уровень" Тогда
				СтрокаТаблицы.УровеньОценки = Узел.ТекстовоеСодержимое;
			КонецЕсли; 
		
		КонецЦикла; 
		
	КонецЦикла;
	
	Если ДанныеФайла.Количество() = 0 И СообщатьПриОшибкахПоиска Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке стоимостей ценных бумаг из файла клиента: не обнаружены данные на " + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy"));
		Возврат Неопределено;	
	КонецЕсли;
	
	// Подготовим таблицу стоимостей
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаХМЛ.ISIN КАК ISIN,
		|	ТаблицаХМЛ.Стоимость КАК Стоимость,
		|	ТаблицаХМЛ.УровеньОценки КАК УровеньОценки
		|ПОМЕСТИТЬ _ТаблицаХМЛ
		|ИЗ
		|	&ТаблицаСтоимостей КАК ТаблицаХМЛ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ISIN
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(КодыISIN.Объект, ЕСТЬNULL(КраткиеКодыНаММВБ.Объект, НЕОПРЕДЕЛЕНО)) КАК ЦеннаяБумага,
		|	_ТаблицаХМЛ.ISIN КАК ISIN,
		|	_ТаблицаХМЛ.Стоимость КАК Стоимость,
		|	_ТаблицаХМЛ.УровеньОценки КАК УровеньОценки
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	_ТаблицаХМЛ КАК _ТаблицаХМЛ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыISIN
		|		ПО _ТаблицаХМЛ.ISIN = КодыISIN.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий)) КАК КраткиеКодыНаММВБ
		|		ПО _ТаблицаХМЛ.ISIN = КраткиеКодыНаММВБ.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦенныеБумаги.ISIN КАК ISIN,
		|	_ЦенныеБумаги.Стоимость КАК Стоимость,
		|	_ЦенныеБумаги.УровеньОценки КАК УровеньОценки,
		|	ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.СредневзвешеннаяЦена) КАК ВидЦены,
		|	КлиентыДоверительногоУправления.Клиент КАК Источник,
		|	&Период КАК ДатаЦены,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|		КОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы)
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|		КОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
		|	КОНЕЦ КАК Рынок,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ПроизводныеФинансовыеИнструменты)
		|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
		|	КОНЕЦ КАК ВалютаКотировки
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправления
		|		ПО (ИСТИНА)
		|ГДЕ
		|	_ЦенныеБумаги.ЦеннаяБумага <> НЕОПРЕДЕЛЕНО");
		
	Запрос.УстановитьПараметр("Период",							НачалоДня(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ТаблицаСтоимостей",				ДанныеФайла);
	
	ТаблицаСтоимостей = Запрос.Выполнить().Выгрузить();	
	
	Возврат ТаблицаСтоимостей;
		
КонецФункции

Функция ЕстьАктивыПоАС()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределенияАктивовЕПС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РаспределенияАктивовЕПС.Сделка КАК Сделка,
		|	РаспределенияАктивовЕПС.Сделка.Дата КАК СделкаДата,
		|	РаспределенияАктивовЕПС.Сделка.ОтложенноеИсполнение КАК СделкаОтложенноеИсполнение,
		|	РаспределенияАктивовЕПС.Сделка.ДатаИсполнения КАК СделкаДатаИсполнения
		|ПОМЕСТИТЬ _Распределения
		|ИЗ
		|	РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|ГДЕ
		|	РаспределенияАктивовЕПС.Организация = &Организация
		|	И РаспределенияАктивовЕПС.Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РаспределенияАктивовЕПС.Рынок = &Рынок
		|	И РаспределенияАктивовЕПС.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|	И РаспределенияАктивовЕПС.Сделка.Дата <= &Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Распределения.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Распределения.Сделка КАК Сделка,
		|	_Распределения.СделкаДата КАК СделкаДата,
		|	_Распределения.СделкаОтложенноеИсполнение КАК СделкаОтложенноеИсполнение,
		|	_Распределения.СделкаДатаИсполнения КАК СделкаДатаИсполнения,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток
		|ИЗ
		|	_Распределения КАК _Распределения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Рынок = &Рынок) КАК ОстаткиЦенныхБумагОстатки
		|		ПО _Распределения.ЦеннаяБумага = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
		|ГДЕ
		|	(_Распределения.СделкаОтложенноеИсполнение
		|				И _Распределения.СделкаДатаИсполнения > &Период
		|			ИЛИ НЕ ОстаткиЦенныхБумагОстатки.КоличествоОстаток ЕСТЬ NULL)";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Дата);
	Запрос.УстановитьПараметр("Рынок", Перечисления.РынкиЦенныхБумаг.Облигации);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции 

Процедура РаспределитьПогрешностиОкругленияСуммНаПартии(ИтоговаяТаблица, НастройкиОценки, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета, Отказ)
	
	// Порядок определяется в РаботаСПереоценкой.ПолучитьТаблицуКотировок и больше не меняется,
	// но здесь зададим его принудительно, т.к. иногда он почему-то сбивается #438536 #Техдолг
	
	ИтоговаяТаблица.Сортировать("Рынок, ЦеннаяБумага, Партия, СтрокаПартии", Новый СравнениеЗначений);
	
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ИтоговаяТаблица, "Цена",			Метаданные.РегистрыСведений.СтоимостьПереоценки.Ресурсы.Цена.Тип);
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ИтоговаяТаблица, "ЦенаКупона",	Метаданные.РегистрыСведений.СтоимостьПереоценки.Ресурсы.ЦенаКупона.Тип);
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(ИтоговаяТаблица, "ЦенаКотировки",	Метаданные.РегистрыСведений.СтоимостьПереоценки.Ресурсы.Цена.Тип);
	
	ИтоговаяТаблица.Колонки.Источник.Имя				= "ИсточникЦены";
	ИтоговаяТаблица.Колонки.Цена.Имя					= "ОценочнаяЦена";
	ИтоговаяТаблица.Колонки.Сумма.Имя					= "ОценочнаяСумма";
	ИтоговаяТаблица.Колонки.СуммаВВалютеУчета.Имя		= "ОценочнаяСуммаВВалютеУчета";
	ИтоговаяТаблица.Колонки.ЦенаКупона.Имя				= "ОценочнаяЦенаКупона";
	ИтоговаяТаблица.Колонки.СуммаКупона.Имя				= "ОценочнаяСуммаКупона";
	ИтоговаяТаблица.Колонки.СуммаКупонаВВалютеУчета.Имя	= "ОценочнаяСуммаКупонаВВалютеУчета";

	ОбъектДляРаспределения = Новый Структура("Организация, СчетДоверительногоУправления, Дата, ЦенныеБумаги");
    ЗаполнитьЗначенияСвойств(ОбъектДляРаспределения, ЭтотОбъект, "Организация, СчетДоверительногоУправления, Дата");
    ОбъектДляРаспределения.ЦенныеБумаги = ИтоговаяТаблица;
    
    РаботаСПереоценкой.РаспределитьПогрешностьОкругленияСтоимостиЦенныхБумагНаПартии(
		ОбъектДляРаспределения, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, НастройкиОценки, Истина, Истина, Отказ, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСумму);

    РаботаСПереоценкой.РаспределитьПогрешностьОкругленияКупонаЦенныхБумагНаПартии(
		ОбъектДляРаспределения, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, НастройкиОценки, Истина, Истина, Отказ, ВариантыОкругленияВалютныхСуммПриРасчетеСуммВВалютеУчета.ОкруглятьСуммуКупона);
		
	ИтоговаяТаблица.Колонки.ИсточникЦены.Имя						= "Источник";
	ИтоговаяТаблица.Колонки.ОценочнаяЦена.Имя						= "Цена";
	ИтоговаяТаблица.Колонки.ОценочнаяСумма.Имя						= "Сумма";
	ИтоговаяТаблица.Колонки.ОценочнаяСуммаВВалютеУчета.Имя			= "СуммаВВалютеУчета";
	ИтоговаяТаблица.Колонки.ОценочнаяЦенаКупона.Имя					= "ЦенаКупона";
	ИтоговаяТаблица.Колонки.ОценочнаяСуммаКупона.Имя				= "СуммаКупона";
	ИтоговаяТаблица.Колонки.ОценочнаяСуммаКупонаВВалютеУчета.Имя	= "СуммаКупонаВВалютеУчета";	
	
КонецПроцедуры

#КонецОбласти
