			ДополнительныеСвойства.Вставить("ОчиститьДвижения", Истина);
			ЭтотОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДополнительныеСвойства.Вставить("ТаблицаСтоимостиПереоценки", ИтоговаяТаблица);
