#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") Тогда
		
		Основание = Параметры.Основание;
		ЗаполнитьЗначенияСвойств(Объект, Основание, "Организация, СчетДоверительногоУправления, ВидУчета");
		Объект.Дата = Основание.Дата;
	
	КонецЕсли; 
	
	ПриЧтенииСозданииНаСервере();
	
	Если Параметры.Свойство("ЦеннаяБумага") И ЗначениеЗаполнено(Параметры.ЦеннаяБумага) Тогда 	
		НайденныеСтроки = Объект.СтоимостиПереоценки.НайтиСтроки(Новый Структура("ЦеннаяБумага", Параметры.ЦеннаяБумага)); 
		Если НайденныеСтроки.Количество() > 0 Тогда 
			Элементы.СтоимостиПереоценки.ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;			
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
			
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЗаполнитьВалютыЦенныхБумаг("СтоимостиПереоценки");
	ЗаполнитьВалютыЦенныхБумаг("СтоимостиПрочихЦенныхБумаг");
	
	Если Объект.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении Тогда
		
		Элементы.СтоимостиПереоценкиРучнойВвод.Видимость = Ложь;
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		
		ЭлементСостояниеДокумента = Элементы.Найти("СостояниеДокумента");
		Если ЭлементСостояниеДокумента = Неопределено Тогда
			ЭлементСостояниеДокумента = Элементы.Вставить("СостояниеДокумента", Тип("ДекорацияФормы"), , ЭтаФорма.ПодчиненныеЭлементы[0]);
			ЭлементСостояниеДокумента.Шрифт						= ШрифтыСтиля.ВажнаяИнформацияНаФормеШрифт;
			ЭлементСостояниеДокумента.АвтоМаксимальнаяШирина	= Ложь;
			ЭлементСостояниеДокумента.Видимость					= Истина;
		КонецЕсли;
		ЭлементСостояниеДокумента.Заголовок	= Новый ФорматированнаяСтрока("Интерактивное изменение документа разрешено только из формы документа 'Регистрация стоимости активов'");
		
	Иначе
		
		Элементы.СтраницаПрочиеЦенныеБумаги.Видимость = Ложь;
		
	КонецЕсли; 

КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не Основание.Пустая() Тогда
	
		Заполнить();
	
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	ЗаполнитьВалютыЦенныхБумаг("СтоимостиПереоценки");
	ЗаполнитьВалютыЦенныхБумаг("СтоимостиПрочихЦенныхБумаг");
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	Если Вопрос("Перезаполнить документ?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		Объект.ВидУчета = ПолучитьВидУчета(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ЦельРасчета, Объект.Дата);
		Заполнить();		
	КонецЕсли;
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура СтоимостиПереоценкиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СтоимостиПереоценки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.РучнойВвод = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦельРасчетаПриИзменении(Элемент)
	Объект.ВидУчета = ПолучитьВидУчета(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ЦельРасчета, Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура СтоимостиПереоценкиЦеннаяБумагаПриИзменении(Элемент)
	ЗаполнитьВалютыЦенныхБумаг("СтоимостиПереоценки", Элементы.СтоимостиПереоценки.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СтоимостиПрочихЦенныхБумагЦеннаяБумагаПриИзменении(Элемент)
	ЗаполнитьВалютыЦенныхБумаг("СтоимостиПрочихЦенныхБумаг", Элементы.СтоимостиПрочихЦенныхБумаг.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СтоимостиПереоценкиКоличествоПриИзменении(Элемент)
	ПересчетТабличнойЧасти("Количество");
КонецПроцедуры

&НаКлиенте
Процедура СтоимостиПереоценкиСтоимостьПриИзменении(Элемент)
