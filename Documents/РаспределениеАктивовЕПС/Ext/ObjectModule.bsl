
#Область ОБРАБОТЧИКИ_СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект, ДанныеЗаполнения);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УниверсальныеМеханизмы.ЗаполнитьОбщиеРеквизитыДокумента(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.Сделка КАК Сделка,
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумаги.Количество КАК Количество
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	&ЦенныеБумаги КАК ЦенныеБумаги
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.Сделка КАК Сделка,
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(_ЦенныеБумаги.Количество) КАК Количество
		|ПОМЕСТИТЬ _КлассификацияЦБ
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|ГДЕ
		|	НЕ ВЫРАЗИТЬ(_ЦенныеБумаги.Сделка КАК Документ.Сделка).ПриобретениеПаев
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЦенныеБумаги.Сделка,
		|	_ЦенныеБумаги.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.Ссылка КАК Ссылка,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(СделкаЦенныеБумаги.Количество) КАК Количество
		|ПОМЕСТИТЬ _СделкиЦБ
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка В
		|			(ВЫБРАТЬ
		|				_КлассификацияЦБ.Сделка
		|			ИЗ
		|				_КлассификацияЦБ КАК _КлассификацияЦБ)
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкаЦенныеБумаги.Ссылка,
		|	СделкаЦенныеБумаги.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлассификацияЦБ.Сделка КАК Сделка,
		|	_КлассификацияЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КлассификацияЦБ.Количество КАК КоличествоКлассификации,
		|	ЕСТЬNULL(_СделкиЦБ.Количество, 0) КАК КоличествоСделки
		|ИЗ
		|	_КлассификацияЦБ КАК _КлассификацияЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиЦБ КАК _СделкиЦБ
		|		ПО _КлассификацияЦБ.Сделка = _СделкиЦБ.Ссылка
		|			И _КлассификацияЦБ.ЦеннаяБумага = _СделкиЦБ.ЦеннаяБумага
		|ГДЕ
		|	_КлассификацияЦБ.Количество > ЕСТЬNULL(_СделкиЦБ.Количество, 0)";
	
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЭтотОбъект.ЦенныеБумаги.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru=""По сделке " + ВыборкаДетальныеЗаписи.Сделка
		+ " распределено большее количество актива " + ВыборкаДетальныеЗаписи.ЦеннаяБумага 
		+ ", чем указано в сделке: "+ВыборкаДетальныеЗаписи.КоличествоКлассификации+" из "++ВыборкаДетальныеЗаписи.КоличествоСделки+""""), ,,, Отказ);
	КонецЦикла;
	
	Для Каждого СтрокаЦБ Из ЭтотОбъект.ЦенныеБумаги Цикл
		Если СтрокаЦБ.Сделка.СчетДоверительногоУправления <> ЭтотОбъект.СчетДоверительногоУправления Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru=""В строке " + СтрокаЦБ.НомерСтроки
			+ " выбрана сделка другого счета ДУ """),ЭтотОбъект ,"ЦенныеБумаги["+(СтрокаЦБ.НомерСтроки-1)+"].Сделка",, Отказ);
		КонецЕсли;	
		Если НачалоДня(СтрокаЦБ.Сделка.Дата) <> НачалоДня(ЭтотОбъект.Дата) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru=""В строке " + СтрокаЦБ.НомерСтроки + " выбрана сделка за другую дату"""),ЭтотОбъект ,"ЦенныеБумаги["+(СтрокаЦБ.НомерСтроки-1)+"].Сделка",, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.РаспределенияАктивовЕПС.Очистить();
	
	Движения.РаспределенияАктивовЕПС.Записывать = Истина;
	Для Каждого ТекСтрокаЦенныеБумаги Из ЦенныеБумаги Цикл
		Движение = Движения.РаспределенияАктивовЕПС.Добавить();
		Движение.Организация = Организация;
		Движение.Сделка = ТекСтрокаЦенныеБумаги.Сделка;
		Движение.Рынок = ТекСтрокаЦенныеБумаги.Рынок;
		Движение.ЦеннаяБумага = ТекСтрокаЦенныеБумаги.ЦеннаяБумага;
		Движение.УчетныйАктивЕПС = ТекСтрокаЦенныеБумаги.УчетныйАктивЕПС;
		Движение.Количество = ТекСтрокаЦенныеБумаги.Количество;
	КонецЦикла;

	Движения.РаспределенияАктивовЕПС.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РаспределениеАктивовЕПСЦенныеБумаги.НомерСтроки КАК НомерСтроки,
		|	РаспределениеАктивовЕПСЦенныеБумаги.Сделка КАК Сделка,
		|	РаспределенияАктивовЕПС.Регистратор КАК Регистратор,
		|	РаспределениеАктивовЕПСЦенныеБумаги.Количество КАК КоличествоРаспределение,
		|	СделкаЦенныеБумаги.Количество КАК КоличествоСделка
		|ИЗ
		|	Документ.РаспределениеАктивовЕПС.ЦенныеБумаги КАК РаспределениеАктивовЕПСЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|		ПО РаспределениеАктивовЕПСЦенныеБумаги.Сделка = РаспределенияАктивовЕПС.Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО РаспределениеАктивовЕПСЦенныеБумаги.Сделка = СделкаЦенныеБумаги.Ссылка
		|ГДЕ
		|	РаспределениеАктивовЕПСЦенныеБумаги.Ссылка = &Ссылка
		|	И (РаспределенияАктивовЕПС.Регистратор <> &Ссылка
		|			ИЛИ РаспределениеАктивовЕПСЦенныеБумаги.Количество <> СделкаЦенныеБумаги.Количество)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.Регистратор <> Ссылка Тогда
		
			ТекстСообщения = СтрШаблон("В строке %1 выбрана сделка %2, по которой активы уже распределены документом %3", ВыборкаДетальныеЗаписи.НомерСтроки, ВыборкаДетальныеЗаписи.Сделка, ВыборкаДетальныеЗаписи.Регистратор);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект , "ЦенныеБумаги["+(ВыборкаДетальныеЗаписи.НомерСтроки-1)+"].Сделка",, Отказ);
		
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.КоличествоРаспределение <> ВыборкаДетальныеЗаписи.КоличествоСделка Тогда
		
			ТекстСообщения = СтрШаблон("В настоящее время не поддерживается частичное распределение активов: строка %1, сделка %2", ВыборкаДетальныеЗаписи.НомерСтроки, ВыборкаДетальныеЗаписи.Сделка);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ЭтотОбъект , "ЦенныеБумаги["+(ВыборкаДетальныеЗаписи.НомерСтроки-1)+"].Сделка",, Отказ);
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
