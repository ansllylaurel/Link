
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Период", Параметры.Период);
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("ЮрФизЛицо", Параметры.ЮрФизЛицо);
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Организация", Параметры.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	Для Индекс = 0 По Значение.ВГраница() Цикл
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(Значение[Индекс]);
		ДанныеСтрокиСтруктура = Новый Структура("ВидДоговора, ДатаЗаключения, ДатаРасторжения, Договор, Номер"); 
		ЗаполнитьЗначенияСвойств(ДанныеСтрокиСтруктура, ДанныеСтроки);
		Значение[Индекс] = ДанныеСтрокиСтруктура;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасторгнутыеДоговоры(Команда)
	
	Элементы.СписокПоказатьРасторгнутыеДоговоры.Пометка = Не Элементы.СписокПоказатьРасторгнутыеДоговоры.Пометка;
	
	Если Элементы.СписокПоказатьРасторгнутыеДоговоры.Пометка Тогда
		ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Период", '00010101');
	Иначе
		ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("Период", Параметры.Период);
	КонецЕсли; 
	
КонецПроцедуры
