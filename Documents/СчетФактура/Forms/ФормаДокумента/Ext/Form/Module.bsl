&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы      = Форма.Элементы;
	ДанныеОбъекта = Форма.Объект;
	
	Элементы.ДатаСчетаФактурыПолученного.Видимость = 
		ДанныеОбъекта.ТипСчетаФактуры = ПредопределенноеЗначение("Перечисление.ТипыСчетовФактур.Полученный");
		
	Элементы.КомандаПрисвоитьНомерСчетаФактурыВыданного.Видимость = 
		ДанныеОбъекта.ТипСчетаФактуры = ПредопределенноеЗначение("Перечисление.ТипыСчетовФактур.Выданный");
		
	Элементы.Грузоотправитель.Видимость = Форма.ГрузоотправительНужен;
	
	Если Форма.Модифицированность Тогда
		
		ПутьКДаннымСкрываемыхПолей = Новый Структура();
		
		ПутьКДаннымСкрываемыхПолей.Вставить("Грузоотправитель"  			, "Объект.Грузоотправитель");
		ПутьКДаннымСкрываемыхПолей.Вставить("НомерСчетаФактуры" 		 	, "Объект.НомерСчетаФактуры");
		ПутьКДаннымСкрываемыхПолей.Вставить("ДатаСчетаФактурыПолученного"  	, "Объект.ДатаСчетаФактурыПолученного");
			
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, ПутьКДаннымСкрываемыхПолей);
		
	КонецЕсли;
	
КонецПроцедуры // НастроитьВидимостьИДоступность

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ЭтаФорма.ГрузоотправительНужен = ЗначениеЗаполнено(Объект.Грузоотправитель);
	ОбновитьКПП();
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСчетаФактурыПриИзменении(Элемент)
	
	Если Объект.ТипСчетаФактуры <> ПредопределенноеЗначение("Перечисление.ТипыСчетовФактур.Полученный") Тогда
		Объект.ДатаСчетаФактурыПолученного = Дата(1,1,1,0,0,0);
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура КомандаПрисвоитьНомерСчетаФактурыВыданногоНаСервере()
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	
	ОбъектНаСервере.НомерСчетаФактуры = РаботаСНДС.ПолучитьНомерСчетаФактуры(ОбъектНаСервере);
	
	ЗначениеВРеквизитФормы(ОбъектНаСервере, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура КомандаПрисвоитьНомерСчетаФактурыВыданного(Команда)
	
	КомандаПрисвоитьНомерСчетаФактурыВыданногоНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОснованияСтавкаНДСПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте 
Процедура РассчитатьСуммуНДС(ТекущиеДанные)
	
	СтавкаНДС = РаботаСНалогамиКлиентСервер.ПолучитьСтавкуНДС(ТекущиеДанные.СтавкаНДС);

	ТекущиеДанные.СуммаНДС = ТекущиеДанные.СуммаСНДС * СтавкаНДС/(100 + СтавкаНДС);
	
КонецПроцедуры	


&НаКлиенте
Процедура ОснованияСуммаСНДСПриИзменении(Элемент)
	
	РассчитатьСуммуНДС(Элементы.Основания.ТекущиеДанные);

КонецПроцедуры

&НаСервере
Процедура ОбновитьКПП()
	
	ЭтаФорма.КПП = "";

	Если ЗначениеЗаполнено(Объект.Контрагент) ИЛИ ЗначениеЗаполнено(Объект.Грузоотправитель) Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫБОР
			|		КОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика <> """"
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.КППКрупнейшегоНалогоплательщика
			|		ИНАЧЕ РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП
			|	КОНЕЦ КАК КПП
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|			&Дата,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
		
		Запрос.УстановитьПараметр("Дата", Объект.Дата);
		Запрос.УстановитьПараметр("ЮрФизЛицо", ?(ЗначениеЗаполнено(Объект.Грузоотправитель), Объект.Грузоотправитель, Объект.Контрагент));
		Запрос.УстановитьПараметр("Организация", Объект.Организация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ЭтаФорма.КПП = ВыборкаДетальныеЗаписи.КПП;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрузоотправительНуженПриИзменении(Элемент)
	
	Если НЕ ГрузоотправительНужен Тогда
		Объект.Грузоотправитель = ПредопределенноеЗначение("Справочник.ЮрФизЛица.ПустаяСсылка");
		ЭтаФорма.Модифицированность = Истина;
		ОбновитьКПП();
	КонецЕсли;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ГрузоотправительПриИзменении(Элемент)
	ОбновитьКПП();
КонецПроцедуры


&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	ОбновитьКПП();
КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

