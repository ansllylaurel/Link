&НаСервере
Процедура ЗаполнитьПредставлениеВидаДоговора()
 
	СоответсвиеВидовДоговоров = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСоответствияВидовДоговоров);
	
	Если ТипЗнч(СоответсвиеВидовДоговоров) = Тип("Соответствие") Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Сделки", ЭтаФорма.Сделки.Выгрузить(, "Счет, ВидСчета"));
		Запрос.УстановитьПараметр("ДепозитныеВклады", ЭтаФорма.ДепозитныеВклады.Выгрузить(, "Счет, ВидСчета"));
		Запрос.УстановитьПараметр("ЦенныеБумаги", ЭтаФорма.ЦенныеБумаги.Выгрузить(, "Счет, ВидСвязи"));
		#Область ТекстЗапроса
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Сделки.Счет КАК Счет
			|ПОМЕСТИТЬ _Сделки
			|ИЗ
			|	&Сделки КАК Сделки
			|ГДЕ
			|	Сделки.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Клиент)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДепозитныеВклады.Счет КАК Счет
			|ПОМЕСТИТЬ _ДепозитныеВклады
			|ИЗ
			|	&ДепозитныеВклады КАК ДепозитныеВклады
			|ГДЕ
			|	ДепозитныеВклады.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Клиент)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЦенныеБумаги.Счет КАК Счет
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	&ЦенныеБумаги КАК ЦенныеБумаги
			|ГДЕ
			|	ЦенныеБумаги.ВидСвязи = ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Клиент)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Сделки.Счет КАК Счет
			|ПОМЕСТИТЬ _Объединение
			|ИЗ
			|	_Сделки КАК _Сделки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ДепозитныеВклады.Счет
			|ИЗ
			|	_ДепозитныеВклады КАК _ДепозитныеВклады
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ЦенныеБумаги.Счет
			|ИЗ
			|	_ЦенныеБумаги КАК _ЦенныеБумаги
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
			|ИЗ
			|	_Объединение КАК _Объединение
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО _Объединение.Счет = СчетаДоверительногоУправления.Ссылка";
		#КонецОбласти 
		Выборка = Запрос.Выполнить().Выбрать();
		
		ЭтаФорма.ПредставлениеВидаДоговора = "";
		
		Пока Выборка.Следующий() Цикл
			ТекВидКодекса = СоответсвиеВидовДоговоров.Получить(Выборка.ВидДоговораДоверительногоУправления);
			Если ТекВидКодекса <> Неопределено И СтрНайти(ЭтаФорма.ПредставлениеВидаДоговора, ТекВидКодекса) = 0 Тогда
				ЭтаФорма.ПредставлениеВидаДоговора = ЭтаФорма.ПредставлениеВидаДоговора + ", " + ТекВидКодекса;
			КонецЕсли;
		КонецЦикла; 
		
		ЭтаФорма.ПредставлениеВидаДоговора = Сред(ЭтаФорма.ПредставлениеВидаДоговора, 3);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбстоятельствоВозникновенияКонфликтаИнтересовПриИзменении(Элемент)
	
	УстановитьВидимостьИЗаполнитьТаблицы(Объект.ОбстоятельствоВозникновенияКонфликтаИнтересов);
	
