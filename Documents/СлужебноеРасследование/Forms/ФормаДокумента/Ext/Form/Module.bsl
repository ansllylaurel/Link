
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	ПриЧтенииСозданииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
КонецПроцедуры
	
#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура СделкаРЕПОПриИзменении(Элемент)
	
	Элементы.СрокРЕПО.Видимость = ЭтаФорма.СделкаРЕПО;
	Если Не ЭтаФорма.СделкаРЕПО Тогда
		Объект.СрокРЕПО = 0;
	КонецЕсли; 
	
	ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	
	СтатусПриИзмененииНаКлиентеНаСервере(ЭтаФорма);
	
	СтатусНаРассмотрении = ПредопределенноеЗначение("Перечисление.СтатусыСлужебныхРасследований.НаРассмотрении");
	
	Если ЗначениеЗаполнено(Объект.ДатаРассмотрения) Тогда
		
		// обновим или очистим дату рассмотрения
		Если Объект.Статус = СтатусНаРассмотрении И Вопрос("Очистить дату рассмотрения?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Объект.ДатаРассмотрения = Неопределено;
		ИначеЕсли Объект.Статус <> СтатусНаРассмотрении И Объект.ДатаРассмотрения <> НачалоДня(ТекущаяДата())
			И Вопрос("Обновить дату рассмотрения?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Объект.ДатаРассмотрения = ТекущаяДата();
		КонецЕсли; 
		
	ИначеЕсли Объект.Статус <> СтатусНаРассмотрении Тогда 
		
		// заполним дату рассмотрения
		Объект.ДатаРассмотрения = ТекущаяДата();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСделкиПриИзменении(Элемент)
	
	ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСделкиПриИзменении(Элемент)
	
	ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокРЕПОПриИзменении(Элемент)
	
	ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеннаяБумагаПриИзменении(Элемент)
	
	ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура КомандаНастройкаШаблонов(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокШаблонов", ЭтаФорма.СписокШаблонов);
	ПараметрыФормы.Вставить("АдресСоответствияВидовДоговоров", АдресСоответствияВидовДоговоров);
	ПараметрыФормы.Вставить("ОписаниеВидаШаблонов", "условий возникновения конфликта.");
	
	Результат = ОткрытьФормуМодально("Документ.СлужебноеРасследование.Форма.ФормаСпискаШаблонов", ПараметрыФормы); 
	
	Если ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		ЭтаФорма.СписокШаблонов = Результат;
		СохранитьСписокШаблоновНаСервере();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборШаблонаПодключаемый(Команда)
	
	ПозицияИдентификатора = СтрНайти(Команда.Имя, "_") + 1;
	Идентификатор = Число(Сред(Команда.Имя, ПозицияИдентификатора));
	Шаблон = ЭтаФорма.СписокШаблонов.НайтиПоИдентификатору(Идентификатор);
	Если ТипЗнч(Шаблон) = Тип("ЭлементСпискаЗначений") Тогда
	
		НоваяСтрока = Объект.УсловияВозниковенияКонфликта.Добавить();
		НоваяСтрока.ОписаниеУсловий = СтрЗаменить(Шаблон.Значение, "[ВидДоговора]", ЭтаФорма.ПредставлениеВидаДоговора);
		ЭтаФорма.Модифицированность = Истина;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНастройкаШаблоновОбоснований(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СписокШаблонов", ЭтаФорма.СписокШаблоновОбоснований);
	ПараметрыФормы.Вставить("АдресСоответствияВидовДоговоров", АдресСоответствияВидовДоговоров);
	ПараметрыФормы.Вставить("ОписаниеВидаШаблонов", "обоснований.");
	
	Результат = ОткрытьФормуМодально("Документ.СлужебноеРасследование.Форма.ФормаСпискаШаблонов", ПараметрыФормы); 
	Если ТипЗнч(Результат) = Тип("СписокЗначений") Тогда
		ЭтаФорма.СписокШаблоновОбоснований = Результат;
		СохранитьСписокШаблоновНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборШаблонаОбоснованийПодключаемый(Команда)
	
	ПозицияИдентификатора = СтрНайти(Команда.Имя, "_") + 1;
	Идентификатор = Число(Сред(Команда.Имя, ПозицияИдентификатора));
	Шаблон = ЭтаФорма.СписокШаблоновОбоснований.НайтиПоИдентификатору(Идентификатор);
	Если ТипЗнч(Шаблон) = Тип("ЭлементСпискаЗначений") Тогда
		Объект.Обоснование = СтрЗаменить(Шаблон.Значение, "[ВидДоговора]", ЭтаФорма.ПредставлениеВидаДоговора);
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаСервере 
Процедура СохранитьСписокШаблоновНаСервере()

	УстановитьПривилегированныйРежим(Истина);
	
	Структура = Новый Структура;
	Структура.Вставить("СписокШаблонов", ЭтаФорма.СписокШаблонов.ВыгрузитьЗначения());
	Структура.Вставить("СписокШаблоновОбоснований", ЭтаФорма.СписокШаблоновОбоснований.ВыгрузитьЗначения());
	Структура.Вставить("СоответствиеВидовДоговоров", ПолучитьИзВременногоХранилища(ЭтаФорма.АдресСоответствияВидовДоговоров));
	ХранилищеОбщихНастроек.Сохранить("Документ.СлужебноеРасследование", "СписокШаблонов", Новый ХранилищеЗначения(Структура, Новый СжатиеДанных(9)),, "ВсеПользователи");
	ОбновитьКнопкиШаблонов();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаполнитьПредставлениеВидаДоговора();

КонецПроцедуры
 
&НаСервере 
Процедура ОбновитьКнопкиШаблонов()
	
	МассивДобавленныхКоманд = ПолучитьИзВременногоХранилища(АдресМассиваДобавленныхКоманд);
	Если МассивДобавленныхКоманд = Неопределено Тогда
		МассивДобавленныхКоманд = Новый Массив;
	Иначе
		// удалим ранее созданные команды
		Для каждого ИмяКоманды Из МассивДобавленныхКоманд Цикл
			ЭтаФорма.Команды.Удалить(ЭтаФорма.Команды.Найти(ИмяКоманды));
			ЭтаФорма.Элементы.Удалить(ЭтаФорма.Элементы.Найти(ИмяКоманды));
		КонецЦикла; 
		МассивДобавленныхКоманд.Очистить();
	КонецЕсли; 
	
	Для каждого ЭлементСписка Из ЭтаФорма.СписокШаблонов Цикл
		
		ИмяКоманды = "Шаблон_" + ЭлементСписка.ПолучитьИдентификатор();
		
		НоваяКоманда = ЭтаФорма.Команды.Найти(ИмяКоманды);
		Если НоваяКоманда = Неопределено Тогда
			НоваяКоманда = ЭтаФорма.Команды.Добавить(ИмяКоманды);	
			НоваяКоманда.Действие = "ВыборШаблонаПодключаемый";
		КонецЕсли; 
		НоваяКоманда.Заголовок = ЭлементСписка.Значение;
		
		КнопкаФормы = Элементы.Найти(ИмяКоманды);
		Если КнопкаФормы = Неопределено Тогда
			КнопкаФормы = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы.УсловияВозниковенияКонфликтаГруппаСохраненныеШаблоны);
			КнопкаФормы.ИмяКоманды = ИмяКоманды;
		КонецЕсли; 
		КнопкаФормы.Заголовок = ЭлементСписка.Значение;
		
		МассивДобавленныхКоманд.Добавить(ИмяКоманды);
		
	КонецЦикла;
	
	Для каждого ЭлементСписка Из ЭтаФорма.СписокШаблоновОбоснований Цикл
		
		ИмяКоманды = "ШаблонОбоснования_" + ЭлементСписка.ПолучитьИдентификатор();
		
		НоваяКоманда = ЭтаФорма.Команды.Найти(ИмяКоманды);
		Если НоваяКоманда = Неопределено Тогда
			НоваяКоманда = ЭтаФорма.Команды.Добавить(ИмяКоманды);	
			НоваяКоманда.Действие = "ВыборШаблонаОбоснованийПодключаемый";
		КонецЕсли; 
		НоваяКоманда.Заголовок = ЭлементСписка.Значение;
		
		КнопкаФормы = Элементы.Найти(ИмяКоманды);
		Если КнопкаФормы = Неопределено Тогда
			КнопкаФормы = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Элементы.ОбоснованияГруппаСохраненныеШаблоны);
			КнопкаФормы.ИмяКоманды = ИмяКоманды;
		КонецЕсли; 
		КнопкаФормы.Заголовок = ЭлементСписка.Значение;
		
		МассивДобавленныхКоманд.Добавить(ИмяКоманды);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(МассивДобавленныхКоманд, АдресМассиваДобавленныхКоманд);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИЗаполнитьТаблицы(Обстоятельство)
	
	Если ЗначениеЗаполнено(Обстоятельство) И Обстоятельство.ПринадлежитЭлементу(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.КодексПрофессиональнойЭтики) Тогда
		
		Элементы.ОбстоятельствоВозникновенияКонфликтаИнтересов.ТолькоПросмотр = Не Объект.Ссылка.Пустая();
		
		Элементы.ДатаПолученияИнформации.Видимость 					= Истина;
		Элементы.СтраницаУсловияВозниковенияКонфликта.Видимость 	= Истина;
		
		Если Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДепозитныйВклад Тогда
			
			Элементы.ГруппаИнформацияОДепозитномВкладе.Видимость 	= Истина;
			Элементы.ГруппаИнформацияОСделке.Видимость 				= Ложь;
			Элементы.ДатаВозникновенияКонфликта.Видимость 			= Ложь;
			
			Элементы.СтраницаДепозитныеВклады.Видимость 			= Истина;
			Элементы.СтраницаИнформацияОКонфликте.Видимость			= Ложь;
			Элементы.СтраницаСделки.Видимость 						= Ложь;
			Элементы.СтраницаЦенныеБумаги.Видимость 				= Ложь;
						
			ОбновитьЗаголовокИнформацииОДепозитномВкладе(ЭтаФорма);
			ЗаполнитьДепозитныеВклады();
			
		ИначеЕсли Обстоятельство = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.СовместноеВладение Тогда
			
			Элементы.ГруппаИнформацияОДепозитномВкладе.Видимость 	= Ложь;
			Элементы.ГруппаИнформацияОСделке.Видимость 				= Ложь;
			Элементы.ДатаВозникновенияКонфликта.Видимость 			= Истина;
			Элементы.ДатаВозникновенияКонфликта.Заголовок			= "Дата совместного владения";
			
			Элементы.СтраницаДепозитныеВклады.Видимость 			= Ложь;
			Элементы.СтраницаИнформацияОКонфликте.Видимость			= Ложь;
			Элементы.СтраницаСделки.Видимость 						= Ложь;
			Элементы.СтраницаЦенныеБумаги.Видимость 				= Истина;
			
			ЗаполнитьЦенныеБумаги();
			
		Иначе
			
			// сделка или сделка РЕПО
			Элементы.ГруппаИнформацияОДепозитномВкладе.Видимость 	= Ложь;
			Элементы.ГруппаИнформацияОСделке.Видимость 				= Истина;
			Элементы.ДатаВозникновенияКонфликта.Видимость 			= Ложь;
						
			Элементы.СтраницаДепозитныеВклады.Видимость 			= Ложь;
			Элементы.СтраницаИнформацияОКонфликте.Видимость			= Ложь;
			Элементы.СтраницаСделки.Видимость 						= Истина;			
			Элементы.СтраницаЦенныеБумаги.Видимость 				= Ложь;
			
			ЭтаФорма.СделкаРЕПО = (Объект.СрокРЕПО > 0);
			Элементы.СрокРЕПО.Видимость = ЭтаФорма.СделкаРЕПО;
			Элементы.СделкиСтавкаРЕПО.Видимость = ЭтаФорма.СделкаРЕПО;
			ЭтаФорма.УровеньЛистинга = ПолучитьУровеньЛистинга(Объект.ЦеннаяБумага, Объект.ДатаСделки);
			ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма);
			ЗаполнитьСделки();
		
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Обстоятельство) И (Обстоятельство.ПринадлежитЭлементу(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии5511У)
		Или Обстоятельство.ПринадлежитЭлементу(Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.УказаниеБанкаРоссии5899У)) Тогда
		
		Элементы.ОбстоятельствоВозникновенияКонфликтаИнтересов.ТолькоПросмотр = Ложь;
		
		Элементы.ДатаПолученияИнформации.Видимость 				= Ложь;
		Элементы.СтраницаУсловияВозниковенияКонфликта.Видимость = Ложь;
				
		Элементы.ГруппаИнформацияОДепозитномВкладе.Видимость 	= Ложь;
		Элементы.ГруппаИнформацияОСделке.Видимость 				= Ложь;
		Элементы.ДатаВозникновенияКонфликта.Видимость 			= Истина;
		Элементы.ДатаВозникновенияКонфликта.Заголовок			= "Дата возникновения конфликта интересов";
		
		Элементы.СтраницаДепозитныеВклады.Видимость 			= Ложь;
		Элементы.СтраницаИнформацияОКонфликте.Видимость			= Истина;
		Элементы.СтраницаСделки.Видимость 						= Ложь;
		Элементы.СтраницаЦенныеБумаги.Видимость 				= Ложь;
		
		ПараметрыОбстоятельства = Справочники.ОбстоятельстваВозникновенияКонфликтаИнтересов.ПолучитьПараметрыОбстоятельства(Обстоятельство);
		
		Элементы.ИнформацияОКонфликтеЦенныеБумаги.Видимость = ПараметрыОбстоятельства.ЦенныеБумаги;
		Элементы.ИнформацияОКонфликте.Видимость = Не ПараметрыОбстоятельства.ЦенныеБумаги;
		
		Если ПараметрыОбстоятельства.ОграничениеТипа = Неопределено Тогда
		
			Элементы.ИнформацияОКонфликте.Доступность = Ложь;
			Элементы.ИнформацияОКонфликтеПредметКонфликта.Заголовок = "Предмет конфликта";
			
		Иначе
			
			Элементы.ИнформацияОКонфликте.Доступность = Истина;
			Элементы.ИнформацияОКонфликтеПредметКонфликта.Заголовок = ПараметрыОбстоятельства.Заголовок;
			Элементы.ИнформацияОКонфликтеПредметКонфликта.ОграничениеТипа = ПараметрыОбстоятельства.ОграничениеТипа;
			
		КонецЕсли; 
		
	Иначе
		
		Элементы.ОбстоятельствоВозникновенияКонфликтаИнтересов.ТолькоПросмотр = Ложь;
		
		Элементы.ДатаПолученияИнформации.Видимость 				= Ложь;
		Элементы.СтраницаУсловияВозниковенияКонфликта.Видимость = Ложь;
				
		Элементы.ГруппаИнформацияОДепозитномВкладе.Видимость 	= Ложь;
		Элементы.ГруппаИнформацияОСделке.Видимость 				= Ложь;
		Элементы.ДатаВозникновенияКонфликта.Видимость 			= Ложь;
		
		Элементы.СтраницаДепозитныеВклады.Видимость 			= Ложь;
		Элементы.СтраницаИнформацияОКонфликте.Видимость			= Ложь;
		Элементы.СтраницаСделки.Видимость 						= Ложь;
		Элементы.СтраницаЦенныеБумаги.Видимость 				= Ложь;
				
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()

	СтатусПриИзмененииНаКлиентеНаСервере(ЭтаФорма);
	
	Если Объект.Ссылка.Пустая() Тогда
	
		Элементы.ГруппаИнформацияОСделке.Заголовок = "Информация о сделке";
		Элементы.ГруппаИнформацияОДепозитномВкладе.Заголовок = "Информация о депозитном вкладе";
	
	КонецЕсли; 
	
	УстановитьВидимостьИЗаполнитьТаблицы(Объект.ОбстоятельствоВозникновенияКонфликтаИнтересов);
	
	ЭтаФорма.АдресМассиваДобавленныхКоманд = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Хранилище = ХранилищеОбщихНастроек.Загрузить("Документ.СлужебноеРасследование", "СписокШаблонов", , "ВсеПользователи");
	СоответствиеВидовДоговоров = Неопределено;
	
	Если ТипЗнч(Хранилище) = Тип("ХранилищеЗначения") Тогда
		
		СтруктураНастроек = Хранилище.Получить();
		// шаблоны условий возникновения конфликта
		Если СтруктураНастроек.Свойство("СписокШаблонов") Тогда
			ЭтаФорма.СписокШаблонов.ЗагрузитьЗначения(СтруктураНастроек.СписокШаблонов);
		КонецЕсли; 
		
		// шаблоны обоснований отсутствия конфликта интересов. 
		Если СтруктураНастроек.Свойство("СписокШаблоновОбоснований") Тогда
			ЭтаФорма.СписокШаблоновОбоснований.ЗагрузитьЗначения(СтруктураНастроек.СписокШаблоновОбоснований);
		КонецЕсли; 
		
		СтруктураНастроек.Свойство("СоответствиеВидовДоговоров", СоответствиеВидовДоговоров);
		
		ОбновитьКнопкиШаблонов();
		
	КонецЕсли;
	
	ЭтаФорма.АдресСоответствияВидовДоговоров = ПоместитьВоВременноеХранилище(СоответствиеВидовДоговоров, ЭтаФорма.УникальныйИдентификатор);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаполнитьПредставлениеВидаДоговора();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьУровеньЛистинга(ЦеннаяБумага, Период)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	Запрос.УстановитьПараметр("Биржа", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КотировкиТорговыхПлощадок.LISTNAME КАК LISTNAME
		|ИЗ
		|	РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|ГДЕ
		|	КотировкиТорговыхПлощадок.Биржа = &Биржа
		|	И КотировкиТорговыхПлощадок.Период = &Период
		|	И КотировкиТорговыхПлощадок.ЦеннаяБумага = &ЦеннаяБумага
		|	И КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим";		
	#КонецОбласти 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.LISTNAME;
	
	КонецЕсли; 

КонецФункции
 
&НаКлиентеНаСервереБезКонтекста
Процедура СтатусПриИзмененииНаКлиентеНаСервере(ЭтаФорма)

	Статус = ЭтаФорма.Объект.Статус;
	
	ЭтаФорма.Элементы.Обоснование.Доступность = Истина;
	ЭтаФорма.Элементы.ЗаголовокОбоснование.Доступность = Истина;
	ЭтаФорма.Элементы.ОбоснованияГруппаСохраненныеШаблоны.Доступность = Истина;
	ЭтаФорма.Элементы.ПринятыеМеры.Доступность = Ложь;
	ЭтаФорма.Элементы.УсловияВозникновенияКонфликтаУстановлены.Доступность = Истина;
	
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыСлужебныхРасследований.НаРассмотрении") Тогда
		ЭтаФорма.Элементы.Обоснование.Доступность = Ложь;
		ЭтаФорма.Элементы.ЗаголовокОбоснование.Доступность = Ложь;
		ЭтаФорма.Элементы.ОбоснованияГруппаСохраненныеШаблоны.Доступность = Ложь;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыСлужебныхРасследований.ВыявленКонфликтИнтересов") Тогда
		ЭтаФорма.Элементы.Обоснование.Заголовок = "Причины возникновения нарушений";
		ЭтаФорма.Элементы.ПринятыеМеры.Доступность = Истина;
		ЭтаФорма.Объект.УсловияВозникновенияКонфликтаУстановлены = Истина;
		ЭтаФорма.Элементы.УсловияВозникновенияКонфликтаУстановлены.Доступность = Ложь;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыСлужебныхРасследований.КонфликтИнтересовНеВыявлен") Тогда
		ЭтаФорма.Элементы.Обоснование.Заголовок = "Обоснование отсутствия конфликта интересов / условий возникновения конфликта интересов";
	КонецЕсли;                         

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокИнформацииОСделке(ЭтаФорма)

	Объект = ЭтаФорма.Объект;
	
	СрокРЕПО = СтрокаСЧислом(";%1 день; ;%1 дня;%1 дней;%1 дня", Объект.СрокРЕПО, ВидЧисловогоЗначения.Количественное, "L=ru");
	ДатаСделки = Формат(Объект.ДатаСделки, "ДФ=dd.MM.yyyy");
	
	ЭтаФорма.Элементы.ГруппаИнформацияОСделке.Заголовок = СтрШаблон("%1 %2" + Символы.ПС + "%3: %4", 
		Строка(Объект.ВидСделки) + ?(Объект.СрокРЕПО = 0, "", " (РЕПО) " + СрокРЕПО), 
		ДатаСделки,
		РаботаСЦеннымиБумагамиКлиентСервер.ТипЦеннойБумагиВЗависимостиОтРынка(Объект.Рынок),
		Объект.ЦеннаяБумага);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокИнформацииОДепозитномВкладе(ЭтаФорма)

	Объект = ЭтаФорма.Объект;
	СрокДепозита = СтрокаСЧислом("; %1 день; ; %1 дня; %1 дней; %1 дня", Объект.СрокДепозита, ВидЧисловогоЗначения.Количественное, "L=ru");
	ЭтаФорма.Элементы.ГруппаИнформацияОДепозитномВкладе.Заголовок = СтрШаблон("%1. Договор от %2 на %3",
		Объект.Банк,
		Формат(Объект.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy"),
		СрокДепозита);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЗаголовокИнформацииОРаскрытии(ЭтаФорма)

	Объект = ЭтаФорма.Объект;
	
	Если Объект.СпособРаскрытияИнформации = "ПубликацияНаСайте" Тогда
		Заголовок = "Информация опубликована на сайте " + Формат(Объект.ДатаРаскрытияИнформации, "ДФ=dd.MM.yyyy");
	ИначеЕсли Объект.СпособРаскрытияИнформации = "Предоставление" Тогда
		Заголовок = "Информация предоставлена " + Формат(Объект.ДатаРаскрытияИнформации, "ДФ=dd.MM.yyyy");
	Иначе	
		Заголовок = "Раскрытие (предоставление) информации";
	КонецЕсли; 
	
	ЭтаФорма.Элементы.ГруппаРаскрытиеИнформации.Заголовок = Заголовок;
	
КонецПроцедуры
 
