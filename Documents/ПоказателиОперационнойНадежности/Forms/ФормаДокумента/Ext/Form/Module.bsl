#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда

		Возврат; 
		
	КонецЕсли;
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда

		ПриЧтенииСозданииНаСервере();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	ЗаполнитьПредставлениеСвязанныхДанных(ЭтаФорма, , , Ложь);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СтрокиТЧДляУдаления = Объект.ИнформационныеСистемы.НайтиСтроки(Новый Структура("Удалить", Истина));
	Для Каждого СтрокаТЧ Из СтрокиТЧДляУдаления Цикл
		
		ТекущийОбъект.ИнформационныеСистемы.Удалить(
			ТекущийОбъект.ИнформационныеСистемы.Найти(СтрокаТЧ.ИдентификаторСтроки, "ИдентификаторСтроки"));
		
	КонецЦикла;	
	СтрокиТЧДляУдаления = Объект.ТехнологическиеПроцессы.НайтиСтроки(Новый Структура("Удалить", Истина));
	Для Каждого СтрокаТЧ Из СтрокиТЧДляУдаления Цикл
		
		СтрокаТабЧасти = ТекущийОбъект.ТехнологическиеПроцессы.Найти(СтрокаТЧ.ТехнологическийПроцесс, "ТехнологическийПроцесс"); 
		Если СтрокаТабЧасти <> Неопределено Тогда
			
			ТекущийОбъект.ТехнологическиеПроцессы.Удалить(СтрокаТабЧасти);	
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	СтрокиТЧДляУдаления = Объект.ИнформационныеСистемы.НайтиСтроки(Новый Структура("Удалить", Истина));
	Если СтрокиТЧДляУдаления.Количество() Тогда
		
		Ответ = Вопрос("Имеются помеченные на удаление строки и они будут удалены при записи. 
			|Вы уверены, что хотите записать документ?", 
			РежимДиалогаВопрос.ДаНет,
			,
			КодВозвратаДиалога.Да);
									
		Если Ответ = КодВозвратаДиалога.Нет Тогда
										
			Отказ = Истина;
										
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьПредставлениеПериодаОтчета(ЭтаФорма);
	
КонецПроцедуры
	
#КонецОбласти

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ИнформационныеСистемыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	Элемент.ТекущиеДанные.Удалить = Не Элемент.ТекущиеДанные.Удалить;
	ЭтаФорма.Модифицированность = Истина;
	ОбновитьТехнологическиеПроцессы();
	Если Не ОбучениеПройдено Тогда

		ТекстСообщенияПользователю = "Вместо удаления строка помечена для удаления при записи документа.
									|Снять пометку для удаления строки можно повторной командой удаления.";
		ПоказатьПредупреждение(, ТекстСообщенияПользователю);
		ОбучениеПройдено = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеСистемыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ИнформационныеСистемыПриАктивизацииСтрокиОбработчик", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеСистемыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ИдентификаторНовойСтроки			      = Новый УникальныйИдентификатор;
		ИдентификаторКопируемойСтроки		      = Элемент.ТекущиеДанные.ИдентификаторСтроки;
		Элемент.ТекущиеДанные.ИдентификаторСтроки = ИдентификаторНовойСтроки;
		
		Если Копирование Тогда			
			
			СкопироватьСвязанныеДанные("ТехнологическиеУчастки", 
				ИдентификаторНовойСтроки, ИдентификаторКопируемойСтроки);
			СкопироватьСвязанныеДанные("ИсточникиДанных",        
				ИдентификаторНовойСтроки, ИдентификаторКопируемойСтроки);
			СкопироватьСвязанныеДанные("ПолучателиДанных",       
				ИдентификаторНовойСтроки, ИдентификаторКопируемойСтроки);
			
		КонецЕсли;
		УстановитьОтборСтрокСвязанныхДанных(ИдентификаторНовойСтроки);	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформационныеСистемыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)

	Если НоваяСтрока И ОтменаРедактирования Тогда
		
		ИдентификаторТекущейСтроки = Элемент.ТекущиеДанные.ИдентификаторСтроки;
		УдалитьСвязанныеДанные("ТехнологическиеУчастки", ИдентификаторТекущейСтроки);
		УдалитьСвязанныеДанные("ИсточникиДанных",        ИдентификаторТекущейСтроки);
		УдалитьСвязанныеДанные("ПолучателиДанных",       ИдентификаторТекущейСтроки);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвязанныеТехнологическиеУчасткиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда

		Элемент.ТекущиеДанные.ИдентификаторСтроки = 
			Элементы.ИнформационныеСистемы.ТекущиеДанные.ИдентификаторСтроки;
		
	КонецЕсли;	
	
КонецПроцедуры

