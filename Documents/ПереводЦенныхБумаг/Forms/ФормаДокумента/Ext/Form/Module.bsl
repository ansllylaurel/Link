
#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не УниверсальныеМеханизмы.ПриСозданииФормыНаСервере(ЭтаФорма,,, Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	// т.к. страницами удобно пользоваться на этапе разработки, отключим их на этапе исполнения
	Элементы.ГруппаЦенныеБумаги.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ПриЧтенииСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если УниверсальныеМеханизмы.ФормаСоздана(ЭтаФорма) Тогда
		ПриЧтенииСозданииНаСервере();
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтаФорма.КорзинаЦенныхБумаг Тогда
		РаботаСКорзинойЦенныхБумагКлиентСервер.ПеренестиРеквизитыИзФормыВТаблицу(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// после записи теряются значения реквизитов, добавленных к т.ч. объекта
	Если ЭтаФорма.КорзинаЦенныхБумаг Тогда
		ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	КонецЕсли;

	ЗаполнитьПодтверждениеОперацииНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		
	РаботаСЖурналамиОперацийКлиентСервер.ОповеститьЖурналыОбИзменении();
	
	РаботаСДокументамиКлиент.ПроверитьПараметрыПодтвержденияОперации(ЭтаФорма, Объект, ПараметрыЗаписи);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = Объект.Ссылка
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(Объект.Ссылка) <> Неопределено)
		Тогда
			ЗаполнитьПодтверждениеОперацииНаСервере();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ЭЛЕМЕНТОВ_ШАПКИ_ФОРМЫ

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	Объект.Дата = РаботаСДокументами.ПолучитьВремяДокумента(Объект.Дата, Объект.Ссылка);
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
	// проверим актуальность депо/счета
	РеквизитыИсполнителя = ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(Объект, "Дата, Организация, СчетДоверительногоУправления, ДепозитарныйСчет");
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоЦеннымБумагам", РеквизитыИсполнителя) Тогда
		Объект.ДепозитарныйСчет = Неопределено;
	КонецЕсли;
	
	// проверим актуальность депо/счета-получателя
	РеквизитыИсполнителя.ДепозитарныйСчет = Объект.ДепозитарныйСчетПолучатель;
	
	Если Не РаботаСИсполнителями.ЕстьИсполнитель("ИсполнителиПоЦеннымБумагам", РеквизитыИсполнителя) Тогда
		Объект.ДепозитарныйСчетПолучатель = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РынокПриИзменении(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзмененииРынка(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиЦеннаяБумага1ПриИзменении(Элемент)
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_СОБЫТИЙ_ТАБЛИЦ_ФОРМЫ

&НаКлиенте
Процедура ЦенныеБумагиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзменении(ЭтаФорма,, НоваяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура ЦенныеБумагиПослеУдаления(Элемент)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ПриИзменении(ЭтаФорма);
	
КонецПроцедуры


&НаКлиенте
Процедура ЦенныеБумагиЦеннаяБумагаПриИзменении(Элемент)
	
	ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(Элементы.ЦенныеБумаги.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОБРАБОТЧИКИ_КОМАНД

&НаКлиенте
Процедура КомандаКорзинаЦенныхБумаг(Команда)
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ИзменитьРежим(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьОстаткамиЦенныхБумаг(Команда)

	ЗаполнениеДоступно = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения документа необходимо указать дату документа!",, "Дата", "Объект.Дата");
		ЗаполнениеДоступно = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения документа необходимо указать счет ДУ!",, "СчетДоверительногоУправления", "Объект.СчетДоверительногоУправления");
		ЗаполнениеДоступно = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Рынок) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения документа необходимо указать рынок!",, "Рынок", "Объект.Рынок");
		ЗаполнениеДоступно = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДепозитарныйСчет) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для заполнения документа необходимо указать депозитарный счет-отправитель!",, "ДепозитарныйСчет", "Объект.ДепозитарныйСчет");
		ЗаполнениеДоступно = Ложь;
	КонецЕсли;
	
	Если ЗаполнениеДоступно Тогда
		
		ЭтаФорма.Модифицированность = Истина;
		
		Если Объект.ЦенныеБумаги.Количество() > 0
			И Вопрос("Список ценных бумаг будет перезаполнен с предварительной очисткой. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		
		ОтчетПоРЕПО = Неопределено;
		ЗаполнитьОстаткамиЦенныхБумагНаСервере(ОтчетПоРЕПО);
		Если ОтчетПоРЕПО <> Неопределено Тогда
			ОтчетПоРЕПО.Показать("Ценные бумаги, купленные по РЕПО");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбратьИсполнителяОткуда(Команда)
	
	РаботаСДокументамиКлиент.ВыбратьИсполнителяПоЦеннымБумагам(ЭтаФорма,);
	
КонецПроцедуры

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
	УниверсальныеМеханизмы.УстановитьЗаголовокФормы(ЭтаФорма);
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры // ПриЧтенииСозданииНаСервере

&НаСервере
Процедура ЗаполнитьОстаткамиЦенныхБумагНаСервере(Отчет)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток) КАК Количество,
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО КАК ДатаВозврата
		|ПОМЕСТИТЬ _ТаблицаЦБПоРЕПО
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|			&ПериодГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = &Рынок) КАК ЗадолженностиПоВторойЧастиРЕПООстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ПериодГраница,
		|				Организация = &Организация
		|					И ДепозитарныйСчет = &ДепозитарныйСчет
		|					И Рынок = &Рынок
		|					И ЧастьСделкиРЕПО = 1
		|					И СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО ЗадолженностиПоВторойЧастиРЕПООстатки.СделкаРЕПО = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|			И ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|ГДЕ
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.КоличествоОстаток <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоВторойЧастиРЕПООстатки.ЦеннаяБумага,
		|	УсловияСделокРЕПОСрезПоследних.ДатаВторойЧастиРЕПО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага, ВложенныйЗапрос.ЦеннаяБумага) КАК ЦеннаяБумага,
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВложенныйЗапросОстаткиПоРЕПО.КоличествоОстаток, 0) + ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) КАК Количество
		|ПОМЕСТИТЬ _ТаблицаЦБОстатки
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ПериодГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ДепозитарныйСчет = &ДепозитарныйСчет
		|				И Рынок = &Рынок) КАК ОстаткиЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ТаблицаЦБПоРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(_ТаблицаЦБПоРЕПО.Количество) КАК КоличествоОстаток
		|		ИЗ
		|			_ТаблицаЦБПоРЕПО КАК _ТаблицаЦБПоРЕПО
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ТаблицаЦБПоРЕПО.ЦеннаяБумага) КАК ВложенныйЗапросОстаткиПоРЕПО
		|		ПО ОстаткиЦенныхБумагОстатки.ЦеннаяБумага = ВложенныйЗапросОстаткиПоРЕПО.ЦеннаяБумага
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ОстаткиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(ОстаткиЦенныхБумаг.Количество) КАК Количество
		|		ИЗ
		|			РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|		ГДЕ
		|			ОстаткиЦенныхБумаг.Регистратор = &Регистратор
		|			И ОстаткиЦенныхБумаг.Организация = &Организация
		|			И ОстаткиЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И ОстаткиЦенныхБумаг.ДепозитарныйСчет = &ДепозитарныйСчет
		|			И ОстаткиЦенныхБумаг.Рынок = &Рынок
		|			И ОстаткиЦенныхБумаг.ВидДвижения = &ВидДвижения
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ОстаткиЦенныхБумаг.ЦеннаяБумага) КАК ВложенныйЗапрос
		|		ПО ОстаткиЦенныхБумагОстатки.ЦеннаяБумага = ВложенныйЗапрос.ЦеннаяБумага
		|ГДЕ
		|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ВложенныйЗапросОстаткиПоРЕПО.КоличествоОстаток, 0) + ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) <> 0";
	
	Запрос.УстановитьПараметр("ПериодГраница", 					Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВидДвижения",				  	ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("Организация",                  	Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Объект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДепозитарныйСчет",             	Объект.ДепозитарныйСчет);
	Запрос.УстановитьПараметр("Рынок",                        	Объект.Рынок);
	Запрос.УстановитьПараметр("Регистратор",                   	Объект.Ссылка);
	
	Запрос.Выполнить();
	
	ТаблицаЦБОстатки = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ТаблицаЦБОстатки").ПолучитьДанные().Выгрузить();
	
	Объект.ЦенныеБумаги.Загрузить(ТаблицаЦБОстатки);
	
	ТаблицаЦБПоРЕПО = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("_ТаблицаЦБПоРЕПО").ПолучитьДанные().Выгрузить();
	
	Если ТаблицаЦБПоРЕПО.Количество() > 0 Тогда 
		ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент(, , ,); 

		РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, ТаблицаЦБПоРЕПО, , , , Истина); 
		РаботаСОтчетами.УстановитьШиринуКолонок(ПараметрыВывода);
		
		Отчет = ПараметрыВывода.ДокументРезультат;
	КонецЕсли;	
		
	РаботаСКорзинойЦенныхБумагКлиентСервер.НастроитьОтображение(ЭтаФорма, Истина);
	
КонецПроцедуры // ЗаполнитьОстаткамиЦенныхБумагНаСервере

&НаСервере
Процедура ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере(ИдСтрокиКорзины = Неопределено) Экспорт
	
	НомерСтрокиКорзины = ?(ИдСтрокиКорзины = Неопределено, Неопределено,
		Объект.ЦенныеБумаги.Индекс(Объект.ЦенныеБумаги.НайтиПоИдентификатору(ИдСтрокиКорзины)));
	
	РаботаСКорзинойЦенныхБумагКлиентСервер.ЗаполнитьНоминалыЦенныхБумагИСуммыВсего(ЭтаФорма, Объект,, НомерСтрокиКорзины);
	
КонецПроцедуры // ЗаполнитьРасчетныеПоляКорзиныЦенныхБумагНаСервере

&НаСервере
Процедура ЗаполнитьПодтверждениеОперацииНаСервере()

	РаботаСДокументами.ЗаполнитьПодтверждениеОперации(ЭтаФорма, Объект.Ссылка);		

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Данные		= Форма.Объект;
	Элементы	= Форма.Элементы;
	
	Элементы.ОписаниеНоминалаЦеннойБумаги.Видимость = РаботаСЦеннымиБумагамиКлиентСервер.ЭтоРынокЦенныхБумагСНоминалом(Данные.Рынок);

КонецПроцедуры

#КонецОбласти
