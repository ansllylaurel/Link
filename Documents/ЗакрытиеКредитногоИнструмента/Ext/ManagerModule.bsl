
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(Данные.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		Если      Данные.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Полное Тогда
			Представление = "Закрытие депозитного вклада ";
		ИначеЕсли Данные.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
			Представление = "Частичное закрытие депозитного вклада ";
		ИначеЕсли Данные.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное Тогда
			Представление = "Досрочное закрытие депозитного вклада ";
		КонецЕсли; 
	ИначеЕсли ТипЗнч(Данные.КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
		Если  Данные.КредитныйИнструмент.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный Тогда
			ВидЗаймаРодительныйПадеж = "займа выданного";
		Иначе
			ВидЗаймаРодительныйПадеж = "займа полученного";
		КонецЕсли;
		Если      Данные.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Полное Тогда
			Представление = "Закрытие " + ВидЗаймаРодительныйПадеж + " ";
		ИначеЕсли Данные.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Частичное Тогда
			Представление = "Частичное закрытие " + ВидЗаймаРодительныйПадеж + " ";
		ИначеЕсли Данные.РежимЗакрытия = Перечисления.РежимыЗакрытияКредитногоИнструмента.Досрочное Тогда
			Представление = "Досрочное закрытие " + ВидЗаймаРодительныйПадеж + " ";
		КонецЕсли; 
	КонецЕсли;
	
	Представление = Представление + Данные.Номер + " от " + Данные.Дата;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	Поля.Добавить("РежимЗакрытия");
	Поля.Добавить("КредитныйИнструмент");
	
КонецПроцедуры
