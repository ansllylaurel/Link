#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

	Объект.ДатаНастроек = НачалоГода(ТекущаяДата());

	НайтиОтчетыАвтоматически();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура КомандаЗаполнить(Команда)

	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
		ПоказатьПредупреждение(, "Не указан исходный отчет 482 (квартальный).");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
		ПоказатьПредупреждение(, "Не указан целевой отчет 482 ЦК >45 млн (годовой).");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаНастроек) Тогда
		ПоказатьПредупреждение(, "Не указана дата настроек.");
		Возврат;
	КонецЕсли;

	Если ТаблицаОтчетов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица пуста. Нажмите ""Заполнить"" для анализа.");
		Возврат;
	КонецЕсли;

	ВыполнитьКопированиеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Находит оба отчёта автоматически по наименованию в справочнике Отчеты.
&НаСервере
Процедура НайтиОтчетыАвтоматически()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Отчеты.Ссылка       КАК Ссылка,
		|	Отчеты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Отчеты КАК Отчеты
		|ГДЕ
		|	НЕ Отчеты.ЭтоГруппа
		|	И НЕ Отчеты.ПометкаУдаления
		|	И Отчеты.Наименование ПОДОБНО ""%482%""
		|УПОРЯДОЧИТЬ ПО
		|	Отчеты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если СтрНайти(Выборка.Наименование, "45") > 0 Тогда
			Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
				Объект.Отчет482ЦК = Выборка.Ссылка;
			КонецЕсли;
		Иначе
			Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
				Объект.Отчет482 = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Заполняет таблицу предпросмотра.
// Строки = счета ДУ ЦК, которым будет добавлена настройка 482ЦК годовой.
// КоличествоНастроек = число записей регистра для конкретного счета + общие.
&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()

	ТаблицаОтчетов.Очистить();

	Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не указан исходный отчет 482 (квартальный). Заполните поле ""Отчет 482"".");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не указан целевой отчет 482 ЦК >45 млн. Заполните поле ""Отчет 482 ЦК"".");
		Возврат;
	КонецЕсли;

	СчетаДляОбработки = ПолучитьСчетаДляОбработки();

	Для Каждого СтрокаСчета Из СчетаДляОбработки Цикл

		НастройкиСчета = ПолучитьНастройки482ДляСчета(СтрокаСчета.СчетДУ, СтрокаСчета.Клиент);
		КолНастроек    = НастройкиСчета.Количество();

		НоваяСтрока = ТаблицаОтчетов.Добавить();
		НоваяСтрока.СчетДУ             = СтрокаСчета.СчетДУ;
		НоваяСтрока.Организация        = СтрокаСчета.Организация;
		НоваяСтрока.КоличествоНастроек = КолНастроек;

		Если КолНастроек > 0 Тогда
			НоваяСтрока.Статус = "Ожидает копирования (" + КолНастроек + " настроек)";
		Иначе
			НоваяСтрока.Статус = "Нет квартальных настроек 482 для копирования";
		КонецЕсли;

	КонецЦикла;

	Если ТаблицаОтчетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найдено счетов ДУ ""Управление активами целевых капиталов"" "
			+ "без годовых настроек отчета 482.");
	КонецЕсли;

КонецПроцедуры

// Возвращает счета ДУ с видом договора "Управление активами целевых капиталов",
// у которых нет ни одной записи отчета 482 (исходного) с периодичностью Ежегодно.
// Также возвращает Клиент (Владелец счета ДУ) для последующей фильтрации настроек.
&НаСервере
Функция ПолучитьСчетаДляОбработки()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДоговора",
		Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	Запрос.УстановитьПараметр("Отчет482",
		Объект.Отчет482);
	Запрос.УстановитьПараметр("Ежегодно",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	СчетаДУ.Ссылка      КАК СчетДУ,
		|	СчетаДУ.Организация КАК Организация,
		|	СчетаДУ.Владелец    КАК Клиент
		|ПОМЕСТИТЬ _СчетаЦК
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|ГДЕ
		|	СчетаДУ.ВидДоговораДоверительногоУправления = &ВидДоговора
		|	И НЕ СчетаДУ.ЭтоГруппа
		|	И НЕ СчетаДУ.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// Счета, у которых уже есть запись 482 с периодичностью Ежегодно — пропускаем.
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(Настройки.Субъект КАК Справочник.СчетаДоверительногоУправления) КАК СчетДУ
		|ПОМЕСТИТЬ _СчетаСГодовыми482
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК Настройки
		|ГДЕ
		|	Настройки.Отчет = &Отчет482
		|	И Настройки.Периодичность = &Ежегодно
		|	И ТИПЗНЧ(Настройки.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|	И ВЫРАЗИТЬ(Настройки.Субъект КАК Справочник.СчетаДоверительногоУправления) В
		|		(ВЫБРАТЬ СчетДУ ИЗ _СчетаЦК)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_СчетаЦК.СчетДУ      КАК СчетДУ,
		|	_СчетаЦК.Организация КАК Организация,
		|	_СчетаЦК.Клиент      КАК Клиент
		|ИЗ
		|	_СчетаЦК КАК _СчетаЦК
		|ГДЕ
		|	НЕ _СчетаЦК.СчетДУ В (ВЫБРАТЬ СчетДУ ИЗ _СчетаСГодовыми482)
		|УПОРЯДОЧИТЬ ПО
		|	_СчетаЦК.Организация,
		|	_СчетаЦК.СчетДУ";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает записи регистра для квартального отчёта 482, применимые к указанному счету ДУ:
//   - настройки конкретно по этому счету (приоритет 19-24)
//   - настройки по клиенту этого счета (приоритет 7-18)
//   - общие настройки без субъекта (приоритет 1-6)
// Включает как записи с периодичностью Ежеквартально, так и без периодичности (приоритет 5, 11).
&НаСервере
Функция ПолучитьНастройки482ДляСчета(СчетДУ, Клиент)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отчет482",
		Объект.Отчет482);
	Запрос.УстановитьПараметр("Ежеквартально",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально);
	Запрос.УстановитьПараметр("СчетДУ",  СчетДУ);
	Запрос.УстановитьПараметр("Клиент",  Клиент);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Настройки.Период      КАК Период,
		|	Настройки.Организация КАК Организация,
		|	Настройки.Субъект     КАК Субъект,
		|	Настройки.ВидДоговора КАК ВидДоговора,
		|	Настройки.Настройка   КАК Настройка,
		|	Настройки.ВидЗначения КАК ВидЗначения,
		|	Настройки.Значение    КАК Значение,
		|	Настройки.Примечание  КАК Примечание
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК Настройки
		|ГДЕ
		|	Настройки.Отчет = &Отчет482
		|	И (Настройки.Периодичность = &Ежеквартально
		|	   ИЛИ НЕ ЗНАЧЕНИЕЗАПОЛНЕНО(Настройки.Периодичность))
		|	И (Настройки.Субъект = &СчетДУ
		|	   ИЛИ Настройки.Субъект = &Клиент
		|	   ИЛИ НЕ ЗНАЧЕНИЕЗАПОЛНЕНО(Настройки.Субъект))";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Копирует настройки 482 в 482ЦК годовой — поаккаунтно.
// Для каждого ЦК-счёта берём его настройки + настройки его клиента + общие (без субъекта).
// При Замещение=Истина общие записи при совпадении ключа просто перезаписываются — дублей нет.
&НаСервере
Процедура ВыполнитьКопированиеНаСервере()

	УстановитьПривилегированныйРежим(Истина);

	СчетаДляОбработки = ПолучитьСчетаДляОбработки();

	Если СчетаДляОбработки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Нет счетов для обработки.");
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;

	КоличествоСкопировано = 0;
	КоличествоОшибок      = 0;

	НачатьТранзакцию();

	Попытка

		Для Каждого СтрокаСчета Из СчетаДляОбработки Цикл

			НастройкиСчета = ПолучитьНастройки482ДляСчета(СтрокаСчета.СчетДУ, СтрокаСчета.Клиент);

			Для Каждого НастройкаСтрока Из НастройкиСчета Цикл

				ЗначенияКлюча = Новый Структура;
				ЗначенияКлюча.Вставить("Период",       Объект.ДатаНастроек);
				ЗначенияКлюча.Вставить("Организация",  НастройкаСтрока.Организация);
				ЗначенияКлюча.Вставить("Субъект",      НастройкаСтрока.Субъект);
				ЗначенияКлюча.Вставить("ВидДоговора",  НастройкаСтрока.ВидДоговора);
				ЗначенияКлюча.Вставить("Отчет",        Объект.Отчет482ЦК);
				ЗначенияКлюча.Вставить("Периодичность",
					Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);
				ЗначенияКлюча.Вставить("Настройка",    НастройкаСтрока.Настройка);

				РегистрыСведений.СоставИНастройкиОтчетов.ДобавитьЗапись(
					ЗначенияКлюча,
					НастройкаСтрока.ВидЗначения,
					НастройкаСтрока.Значение,
					Истина,
					НастройкаСтрока.Примечание);

				КоличествоСкопировано = КоличествоСкопировано + 1;

			КонецЦикла;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

		Для Каждого СтрокаТаблицы Из ТаблицаОтчетов Цикл
			СтрокаТаблицы.Статус = "Выполнено";
		КонецЦикла;

	Исключение

		ОтменитьТранзакцию();

		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			"НастройкиОтчета482ЦК",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(Информация));

		КоличествоОшибок = КоличествоОшибок + 1;

		Для Каждого СтрокаТаблицы Из ТаблицаОтчетов Цикл
			СтрокаТаблицы.Статус = "Ошибка: " + КраткоеПредставлениеОшибки(Информация);
		КонецЦикла;

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Обработка завершена."
		+ Символы.ПС + "Скопировано настроек: " + КоличествоСкопировано
		+ Символы.ПС + "Ошибок: "               + КоличествоОшибок);

КонецПроцедуры

#КонецОбласти