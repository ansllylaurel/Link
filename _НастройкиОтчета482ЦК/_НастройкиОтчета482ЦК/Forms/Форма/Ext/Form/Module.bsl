#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

	Объект.ДатаНастроек = НачалоГода(ТекущаяДата());

	НайтиОтчетыАвтоматически();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура КомандаЗаполнить(Команда)

	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)

	Если Не ПараметрыЗаполнены() Тогда
		Возврат;
	КонецЕсли;

	Если ТаблицаОтчетов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица пуста. Нажмите ""Заполнить"" для анализа.");
		Возврат;
	КонецЕсли;

	ВыполнитьКопированиеНаСервере();

КонецПроцедуры

&НаКлиенте
Функция ПараметрыЗаполнены()

	Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
		ПоказатьПредупреждение(, "Не указан исходный отчет 482 (квартальный).");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
		ПоказатьПредупреждение(, "Не указан целевой отчет 482 ЦК >45 млн (годовой).");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаНастроек) Тогда
		ПоказатьПредупреждение(, "Не указана дата настроек.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Автоподстановка ссылок на отчёты 482 и 482ЦК из справочника Отчёты.
&НаСервере
Процедура НайтиОтчетыАвтоматически()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Отчеты.Ссылка КАК Ссылка,
		|	Отчеты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Отчеты КАК Отчеты
		|ГДЕ
		|	НЕ Отчеты.ЭтоГруппа
		|	И НЕ Отчеты.ПометкаУдаления
		|	И Отчеты.Наименование ПОДОБНО ""%482%""
		|УПОРЯДОЧИТЬ ПО
		|	Отчеты.Наименование");

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если СтрНайти(Выборка.Наименование, "45") > 0 Тогда
			Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
				Объект.Отчет482ЦК = Выборка.Ссылка;
			КонецЕсли;
		Иначе
			Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
				Объект.Отчет482 = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Счета ДУ "Управление активами ЦК", у которых нет годовой настройки исходного 482.
// Возвращает: СчетДУ, Организация, Клиент.
&НаСервере
Функция ПолучитьЭлигибельныеСчета()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДоговораЦК",
		Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	Запрос.УстановитьПараметр("Отчет482", Объект.Отчет482);
	Запрос.УстановитьПараметр("Ежегодно",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДУ.Ссылка КАК СчетДУ,
		|	СчетаДУ.Организация КАК Организация,
		|	КлиентыДУ.Клиент КАК Клиент
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДУ
		|		ПО КлиентыДУ.СчетДоверительногоУправления = СчетаДУ.Ссылка
		|ГДЕ
		|	СчетаДУ.ВидДоговораДоверительногоУправления = &ВидДоговораЦК
		|	И НЕ СчетаДУ.ПометкаУдаления
		|	И НЕ СчетаДУ.Ссылка В (
		|			ВЫБРАТЬ
		|				ВЫРАЗИТЬ(Настройки.Субъект КАК Справочник.СчетаДоверительногоУправления)
		|			ИЗ
		|				РегистрСведений.СоставИНастройкиОтчетов КАК Настройки
		|			ГДЕ
		|				Настройки.Отчет = &Отчет482
		|				И Настройки.Периодичность = &Ежегодно
		|				И ТИПЗНАЧЕНИЯ(Настройки.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления))
		|УПОРЯДОЧИТЬ ПО
		|	СчетаДУ.Организация,
		|	СчетаДУ.Ссылка";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Дедуплицированный список записей-источников для копирования в 482ЦК годовой.
// Берём все записи 482, у которых:
//   - периодичность Ежеквартально ИЛИ пустая
//   - субъект — один из счетов ЦК, один из клиентов счетов ЦК, ИЛИ пустой (общая настройка)
// Дубли (общие настройки, клиентские настройки общих клиентов) сворачивает РАЗЛИЧНЫЕ.
// Периодичность преобразуется: Ежеквартально → Ежегодно, пустая остаётся пустой.
&НаСервере
Функция ПолучитьЗаписиДляКопирования()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДоговораЦК",
		Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	Запрос.УстановитьПараметр("Отчет482", Объект.Отчет482);
	Запрос.УстановитьПараметр("Ежегодно",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);
	Запрос.УстановитьПараметр("Ежеквартально",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально);
	Запрос.УстановитьПараметр("Организация",
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДУ.Ссылка КАК СчетДУ,
		|	КлиентыДУ.Клиент КАК Клиент
		|ПОМЕСТИТЬ ВТ_СчетаЦК
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДУ
		|		ПО КлиентыДУ.СчетДоверительногоУправления = СчетаДУ.Ссылка
		|ГДЕ
		|	СчетаДУ.ВидДоговораДоверительногоУправления = &ВидДоговораЦК
		|	И НЕ СчетаДУ.ПометкаУдаления
		|	И НЕ СчетаДУ.Ссылка В (
		|			ВЫБРАТЬ
		|				ВЫРАЗИТЬ(Настройки.Субъект КАК Справочник.СчетаДоверительногоУправления)
		|			ИЗ
		|				РегистрСведений.СоставИНастройкиОтчетов КАК Настройки
		|			ГДЕ
		|				Настройки.Отчет = &Отчет482
		|				И Настройки.Периодичность = &Ежегодно
		|				И ТИПЗНАЧЕНИЯ(Настройки.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Настройки.Организация КАК Организация,
		|	Настройки.Субъект КАК Субъект,
		|	Настройки.ВидДоговора КАК ВидДоговора,
		|	Настройки.Настройка КАК Настройка,
		|	Настройки.ВидЗначения КАК ВидЗначения,
		|	Настройки.Значение КАК Значение,
		|	Настройки.Примечание КАК Примечание,
		|	ВЫБОР
		|		КОГДА Настройки.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)
		|			ТОГДА Настройки.Периодичность
		|		ИНАЧЕ &Ежегодно
		|	КОНЕЦ КАК Периодичность
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК Настройки
		|ГДЕ
		|	Настройки.Отчет = &Отчет482
		|	И Настройки.Организация = &Организация
		|	И (Настройки.Периодичность = &Ежеквартально
		|			ИЛИ Настройки.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка))
		|	И (Настройки.Субъект = НЕОПРЕДЕЛЕНО
		|			ИЛИ Настройки.Субъект В (ВЫБРАТЬ СчетДУ ИЗ ВТ_СчетаЦК)
		|			ИЛИ Настройки.Субъект В (ВЫБРАТЬ Клиент ИЗ ВТ_СчетаЦК ГДЕ НЕ Клиент ЕСТЬ NULL))";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Заполняет таблицу-предпросмотр: эликибельные ЦК-счета + общее число записей к копированию.
&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()

	ТаблицаОтчетов.Очистить();

	Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан исходный отчет 482.");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан целевой отчет 482 ЦК.");
		Возврат;
	КонецЕсли;

	Счета         = ПолучитьЭлигибельныеСчета();
	КолВсегоЗапис = ПолучитьЗаписиДляКопирования().Количество();

	Для Каждого СтрокаСчета Из Счета Цикл
		НоваяСтрока = ТаблицаОтчетов.Добавить();
		НоваяСтрока.СчетДУ             = СтрокаСчета.СчетДУ;
		НоваяСтрока.Организация        = СтрокаСчета.Организация;
		НоваяСтрока.КоличествоНастроек = КолВсегоЗапис;
		НоваяСтрока.Статус = ?(КолВсегоЗапис > 0,
			"Готово к копированию (" + КолВсегоЗапис + " уникальных записей всего)",
			"Нет записей-источников для копирования");
	КонецЦикла;

	Если ТаблицаОтчетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найдено счетов ДУ ""Управление активами ЦК"" без годовых настроек 482.");
	КонецЕсли;

КонецПроцедуры

// Копирование: один проход по дедуплицированному списку записей-источников.
// Каждая запись пишется один раз с сохранением исходного Субъект и преобразованной Периодичностью.
&НаСервере
Процедура ВыполнитьКопированиеНаСервере()

	УстановитьПривилегированныйРежим(Истина);

	Записи = ПолучитьЗаписиДляКопирования();

	Если Записи.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет записей для копирования.");
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;

	КоличествоСкопировано = 0;
	КоличествоОшибок      = 0;

	НачатьТранзакцию();

	Попытка

		Для Каждого Запись Из Записи Цикл

			ЗначенияКлюча = Новый Структура;
			ЗначенияКлюча.Вставить("Период",        Объект.ДатаНастроек);
			ЗначенияКлюча.Вставить("Организация",   Запись.Организация);
			ЗначенияКлюча.Вставить("Субъект",       Запись.Субъект);
			ЗначенияКлюча.Вставить("ВидДоговора",   Запись.ВидДоговора);
			ЗначенияКлюча.Вставить("Отчет",         Объект.Отчет482ЦК);
			ЗначенияКлюча.Вставить("Периодичность", Запись.Периодичность);
			ЗначенияКлюча.Вставить("Настройка",     Запись.Настройка);

			РегистрыСведений.СоставИНастройкиОтчетов.ДобавитьЗапись(
				ЗначенияКлюча,
				Запись.ВидЗначения,
				Запись.Значение,
				Истина,
				Запись.Примечание);

			КоличествоСкопировано = КоличествоСкопировано + 1;

		КонецЦикла;

		ЗафиксироватьТранзакцию();

		Для Каждого СтрокаТаблицы Из ТаблицаОтчетов Цикл
			СтрокаТаблицы.Статус = "Выполнено";
		КонецЦикла;

	Исключение

		ОтменитьТранзакцию();

		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			"НастройкиОтчета482ЦК",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(Инфо));

		КоличествоОшибок = КоличествоОшибок + 1;

		Для Каждого СтрокаТаблицы Из ТаблицаОтчетов Цикл
			СтрокаТаблицы.Статус = "Ошибка: " + КраткоеПредставлениеОшибки(Инфо);
		КонецЦикла;

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Обработка завершена."
		+ Символы.ПС + "Скопировано записей: " + КоличествоСкопировано
		+ Символы.ПС + "Ошибок: "              + КоличествоОшибок);

КонецПроцедуры

#КонецОбласти