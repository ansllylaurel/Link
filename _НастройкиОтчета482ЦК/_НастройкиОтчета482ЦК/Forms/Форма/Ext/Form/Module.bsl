
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

	Объект.ДатаНастроек = НачалоГода(ТекущаяДата());

	НайтиОтчетыАвтоматически();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура КомандаЗаполнить(Команда)

	ЗаполнитьТаблицуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
		ПоказатьПредупреждение(, "Не указан исходный отчет 482 (квартальный).");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
		ПоказатьПредупреждение(, "Не указан целевой отчет 482 ЦК >45 млн (годовой).");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ДатаНастроек) Тогда
		ПоказатьПредупреждение(, "Не указана дата настроек.");
		Возврат;
	КонецЕсли;

	Если ТаблицаОтчетов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Таблица пуста. Нажмите ""Заполнить"" для анализа.");
		Возврат;
	КонецЕсли;

	ВыполнитьКопированиеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НайтиОтчетыАвтоматически()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Отчеты.Ссылка КАК Ссылка,
		|	Отчеты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Отчеты КАК Отчеты
		|ГДЕ
		|	НЕ Отчеты.ЭтоГруппа
		|	И НЕ Отчеты.ПометкаУдаления
		|	И Отчеты.Наименование ПОДОБНО ""%482%""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Отчеты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если СтрНайти(Выборка.Наименование, "45") > 0 Тогда
			Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
				Объект.Отчет482ЦК = Выборка.Ссылка;
			КонецЕсли;
		Иначе
			Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
				Объект.Отчет482 = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()

	ТаблицаОтчетов.Очистить();

	Если Не ЗначениеЗаполнено(Объект.Отчет482) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не указан исходный отчет 482 (квартальный). Заполните поле ""Отчет 482"".");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Отчет482ЦК) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не указан целевой отчет 482 ЦК >45 млн. Заполните поле ""Отчет 482 ЦК"".");
		Возврат;
	КонецЕсли;

	СчетаДляОбработки = ПолучитьСчетаДляОбработки();

	Для Каждого СтрокаСчета Из СчетаДляОбработки Цикл

		НастройкиКварт = ПолучитьНастройки482Квартальные(СтрокаСчета.СчетДУ);

		НоваяСтрока = ТаблицаОтчетов.Добавить();
		НоваяСтрока.СчетДУ             = СтрокаСчета.СчетДУ;
		НоваяСтрока.Организация        = СтрокаСчета.Организация;
		НоваяСтрока.КоличествоНастроек = НастройкиКварт.Количество();

		Если НастройкиКварт.Количество() > 0 Тогда
			НоваяСтрока.Статус = "Готово к копированию (" + НастройкиКварт.Количество() + " настроек)";
		Иначе
			НоваяСтрока.Статус = "Нет квартальных настроек 482 для копирования";
		КонецЕсли;

	КонецЦикла;

	Если ТаблицаОтчетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найдено счетов ДУ ""Управление активами целевых капиталов"" "
			+ "без годовых настроек отчета 482.");
	КонецЕсли;

КонецПроцедуры

// Возвращает счета ДУ с видом договора "Управление активами целевых капиталов",
// у которых нет записей отчета 482 (исходного) с периодичностью Ежегодно.
&НаСервере
Функция ПолучитьСчетаДляОбработки()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидДоговора",
		Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	Запрос.УстановитьПараметр("Отчет482",
		Объект.Отчет482);
	Запрос.УстановитьПараметр("Ежегодно",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДУ.Ссылка КАК СчетДУ,
		|	СчетаДУ.Организация КАК Организация
		|ПОМЕСТИТЬ _СчетаЦК
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДУ
		|ГДЕ
		|	СчетаДУ.ВидДоговораДоверительногоУправления = &ВидДоговора
		|	И НЕ СчетаДУ.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(НастройкиОтчетов.Субъект КАК Справочник.СчетаДоверительногоУправления) КАК СчетДУ
		|ПОМЕСТИТЬ _СчетаСГодовыми482
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НастройкиОтчетов.Отчет = &Отчет482
		|	И НастройкиОтчетов.Периодичность = &Ежегодно
		|	И ТИПЗНАЧЕНИЯ(НастройкиОтчетов.Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|	И ВЫРАЗИТЬ(НастройкиОтчетов.Субъект КАК Справочник.СчетаДоверительногоУправления) В
		|			(ВЫБРАТЬ
		|				_СчетаЦК.СчетДУ
		|			ИЗ
		|				_СчетаЦК)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаЦК.СчетДУ КАК СчетДУ,
		|	_СчетаЦК.Организация КАК Организация
		|ИЗ
		|	_СчетаЦК КАК _СчетаЦК
		|ГДЕ
		|	НЕ _СчетаЦК.СчетДУ В
		|				(ВЫБРАТЬ
		|					_СчетаСГодовыми482.СчетДУ
		|				ИЗ
		|					_СчетаСГодовыми482)
		|
		|УПОРЯДОЧИТЬ ПО
		|	_СчетаЦК.Организация,
		|	_СчетаЦК.СчетДУ";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает записи регистра СоставИНастройкиОтчетов для счета ДУ:
// отчет 482 квартальный, на уровне конкретного счета ДУ (Субъект = СчетДУ).
&НаСервере
Функция ПолучитьНастройки482Квартальные(СчетДУ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетДУ",       СчетДУ);
	Запрос.УстановитьПараметр("Отчет482",     Объект.Отчет482);
	Запрос.УстановитьПараметр("Ежеквартально",
		Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОтчетов.Период КАК Период,
		|	НастройкиОтчетов.Организация КАК Организация,
		|	НастройкиОтчетов.Субъект КАК Субъект,
		|	НастройкиОтчетов.ВидДоговора КАК ВидДоговора,
		|	НастройкиОтчетов.Настройка КАК Настройка,
		|	НастройкиОтчетов.ВидЗначения КАК ВидЗначения,
		|	НастройкиОтчетов.Значение КАК Значение,
		|	НастройкиОтчетов.Примечание КАК Примечание
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НастройкиОтчетов.Субъект = &СчетДУ
		|	И НастройкиОтчетов.Отчет = &Отчет482
		|	И НастройкиОтчетов.Периодичность = &Ежеквартально";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Процедура ВыполнитьКопированиеНаСервере()

	УстановитьПривилегированныйРежим(Истина);

	КоличествоОбработано = 0;
	КоличествоОшибок     = 0;

	Для Каждого СтрокаТаблицы Из ТаблицаОтчетов Цикл

		Если СтрокаТаблицы.КоличествоНастроек = 0 Тогда
			Продолжить;
		КонецЕсли;

		НастройкиКварт = ПолучитьНастройки482Квартальные(СтрокаТаблицы.СчетДУ);

		НачатьТранзакцию();

		Попытка

			Для Каждого НастройкаСтрока Из НастройкиКварт Цикл

				ЗначенияКлюча = Новый Структура;
				ЗначенияКлюча.Вставить("Период",       Объект.ДатаНастроек);
				ЗначенияКлюча.Вставить("Организация",  НастройкаСтрока.Организация);
				ЗначенияКлюча.Вставить("Субъект",      НастройкаСтрока.Субъект);
				ЗначенияКлюча.Вставить("ВидДоговора",  НастройкаСтрока.ВидДоговора);
				ЗначенияКлюча.Вставить("Отчет",        Объект.Отчет482ЦК);
				ЗначенияКлюча.Вставить("Периодичность",
					Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);
				ЗначенияКлюча.Вставить("Настройка",    НастройкаСтрока.Настройка);

				РегистрыСведений.СоставИНастройкиОтчетов.ДобавитьЗапись(
					ЗначенияКлюча,
					НастройкаСтрока.ВидЗначения,
					НастройкаСтрока.Значение,
					Истина,
					НастройкаСтрока.Примечание);

			КонецЦикла;

			ЗафиксироватьТранзакцию();

			СтрокаТаблицы.Статус = "Выполнено (" + НастройкиКварт.Количество() + " настроек)";
			КоличествоОбработано = КоличествоОбработано + 1;

		Исключение

			ОтменитьТранзакцию();

			Информация = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				"НастройкиОтчета482ЦК",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаТаблицы.СчетДУ,
				ПодробноеПредставлениеОшибки(Информация));

			СтрокаТаблицы.Статус = "Ошибка: " + КраткоеПредставлениеОшибки(Информация);
			КоличествоОшибок     = КоличествоОшибок + 1;

		КонецПопытки;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		"Обработка завершена."
		+ Символы.ПС + "Успешно обработано:  " + КоличествоОбработано
		+ Символы.ПС + "С ошибками: "          + КоличествоОшибок);

КонецПроцедуры

#КонецОбласти
