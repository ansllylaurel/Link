
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВсеРеквизиты = ЭтаФорма.Параметры.ВсеРеквизиты;
	
	Для каждого КлючЗначение Из ВсеРеквизиты Цикл
		Если Лев(КлючЗначение.Ключ, 3) = "Тек" Тогда
			
			ИмяПоля       = Сред(КлючЗначение.Ключ, 4);
			НовоеЗначение = ВсеРеквизиты["Нов" + ИмяПоля];
			
			Если (ЗначениеЗаполнено(КлючЗначение.Значение) ИЛИ ЗначениеЗаполнено(НовоеЗначение))
				И КлючЗначение.Значение <> НовоеЗначение Тогда
				НоваяСтрокаРасхождения = ЭтаФорма.Расхождения.Добавить();
				НоваяСтрокаРасхождения.ИмяПоля         = ИмяПоля;
				НоваяСтрокаРасхождения.ТекущееЗначение = КлючЗначение.Значение;
				НоваяСтрокаРасхождения.НовоеЗначение   = НовоеЗначение;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
