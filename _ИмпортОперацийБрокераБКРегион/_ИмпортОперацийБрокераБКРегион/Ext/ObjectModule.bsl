Функция ОпределитьЗагрузкуКонтрагентаПоВнебиржевымСделкам(Организация) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект = &Объект
		|	И ЗначенияДополнительныхСведений.Свойство.Ключ = &Ключ");
		
	Запрос.УстановитьПараметр("Объект", Организация);
	Запрос.УстановитьПараметр("Ключ",   "ЗагружатьКонтрагентаПоВнебиржевымСделкам");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда		
		Возврат Выборка.Значение;	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ФайлИмпортаСоответствуетСхемеXSD(ТаблицаДанных, ИмяМакета) Экспорт
		
	//исключил из проверки, что бы в схему не добовлять старьё
	//из выгрузки на стороне матрих удалены элементы (REPO_Changes) которые присутствовали в прошлом.
	Если ЭтотОбъект.ДатаИмпорта < Дата(2021, 04, 01) И ИмяМакета = "Схема_OTBR" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Дата сверки [" + ЭтотОбъект.ДатаИмпорта + "] меньше даты перехода на формат OTBR [01.04.2021]");
		Возврат Ложь;	
	КонецЕсли;
	
	ФайлСхемы = Новый Файл(КаталогВременныхФайлов() + "XMLSchema.xsd");
	
	Если ФайлСхемы.Существует() Тогда
		УдалитьФайлы(ФайлСхемы.ПолноеИмя);
	КонецЕсли;
		
	Макет = ЭтотОбъект.ПолучитьМакет(ИмяМакета);

	Попытка
		Макет.Записать(ФайлСхемы.ПолноеИмя);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось записать файл схемы в каталог временных файлов!" + Символы.ПС + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
		
	Попытка
		КомОбъектКэшСхем = Новый COMОбъект("MSXML2.XMLSchemaCache.6.0");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось создать объект XMLSchemaCache" + Символы.ПС + ОписаниеОшибки());
		УдалитьФайлы(ФайлСхемы.ПолноеИмя);
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		КомОбъектКэшСхем.add(, ФайлСхемы.ПолноеИмя);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось подключить схему: " + Символы.ПС + ОписаниеОшибки());
		УдалитьФайлы(ФайлСхемы.ПолноеИмя);
		Возврат Ложь;
	КонецПопытки;
	
	ИмяФайлаДанных = ПолучитьИмяВременногоФайла("xml");
		
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		
		СтрокаТаблицыДанных.ДанныеФайла.Записать(ИмяФайлаДанных);
		
		Попытка
			КомОбъектДок = Новый COMОбъект("MSXML2.DOMDocument.6.0");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось создать объект DOMDocument" + Символы.ПС + ОписаниеОшибки());
			УдалитьФайлы(ФайлСхемы.ПолноеИмя);
			Возврат Ложь;
		КонецПопытки;
		
		КомОбъектДок.schemas          = КомОбъектКэшСхем;
		КомОбъектДок.async            = Ложь;
		КомОбъектДок.validateOnParse  = Истина;
		КомОбъектДок.resolveExternals = Истина;
		КомОбъектДок.SetProperty("MultipleErrorMessages", Истина);
		
		Попытка
			КомОбъектДок.load(ИмяФайлаДанных);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("XML файл не прошел проверку! Ошибка: Не удалось загрузить файл [" + СтрокаТаблицыДанных.ИмяФайла + "] в объект DOMDocument" + Символы.ПС + ОписаниеОшибки());
			УдалитьФайлы(ИмяФайлаДанных);
			УдалитьФайлы(ФайлСхемы.ПолноеИмя);
			Возврат Ложь;
		КонецПопытки;

		
		Если КомОбъектДок.parseError.errorCode <> 0 Тогда //erorcode -1072898027
			
			ТекстСообщения = "Файл импорта [" + СтрокаТаблицыДанных.ИмяФайла + "] не соответствует схеме XSD."; 
		
			Для Каждого Ошибка из КомОбъектДок.parseError.AllErrors  Цикл
				ТекстСообщения = ТекстСообщения + Символы.ПС + СокрЛП(Ошибка.errorXPath) + " Ошибка: " + СокрЛП(Ошибка.reason);
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			УдалитьФайлы(ИмяФайлаДанных);
			УдалитьФайлы(ФайлСхемы.ПолноеИмя);
			Возврат Ложь;
			
		КонецЕсли;
			
	КонецЦикла;
	
	УдалитьФайлы(ФайлСхемы.ПолноеИмя);
	УдалитьФайлы(ИмяФайлаДанных);

	Возврат Истина;
	
КонецФункции

Функция ПолучитьПрочиеДоходыИРасходы(ВидЗадолженности)
	
	Если ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии") Тогда
		Возврат Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам брокера");
	ИначеЕсли ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии")
		ИЛИ ПринадлежитГруппеЗадолженностей(ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия")) Тогда 	
		Возврат Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Общие расходы по услугам депозитария");
	ИначеЕсли ВидЗадолженности = ПредопределенноеЗначение("Справочник.ВидыЗадолженности.ПоБанковскойКомиссии")
		ИЛИ ПринадлежитГруппеЗадолженностей(ВидЗадолженности, ПредопределенноеЗначение("Справочник.ВидыЗадолженности.БанковскаяКомиссия")) Тогда 	
		Возврат Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Комиссия банка");	
	Иначе
		Возврат Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции 

Функция ПринадлежитГруппеЗадолженностей(ВидЗадолженности, Группа)
	Если НЕ ЗначениеЗаполнено(ВидЗадолженности) Тогда
		Возврат Ложь;
	Иначе
		Возврат ВидЗадолженности.ПринадлежитЭлементу(Группа);
	КонецЕсли;
КонецФункции

Функция ПолучитьНезагружаемыеРеквизиты(ПолноеИмяОбъектаМД, Внебиржа = Ложь)
	
	Если ПропуститьРеквизитыСписок = Неопределено Тогда
		ПропуститьРеквизитыСписок = Новый СписокЗначений;
		ПропуститьРеквизитыСписок.Добавить("Ответственный");
		ПропуститьРеквизитыСписок.Добавить("Комментарий");
		ПропуститьРеквизитыСписок.Добавить("СтрокаПартии");
		ПропуститьРеквизитыСписок.Добавить("УчетныйАктивЕПС");
		ПропуститьРеквизитыСписок.Добавить("ГруппаФинансовогоУчетаДоходовРасходов");
		ПропуститьРеквизитыСписок.Добавить("ВидВходящегоДокумента");
		ПропуститьРеквизитыСписок.Добавить("НомерВходящегоДокумента");
		ПропуститьРеквизитыСписок.Добавить("ДатаВходящегоДокумента");
		ПропуститьРеквизитыСписок.Добавить("Резерв");
		ПропуститьРеквизитыСписок.Добавить("НалогИлиВзнос");
		ПропуститьРеквизитыСписок.Добавить("УровеньБюджета");
	КонецЕсли;
	
	Результат = ПропуститьРеквизитыСписок.Скопировать();
	
	Если ПолноеИмяОбъектаМД = "Документ.ПоставкаЦенныхБумаг" Тогда
		Результат.Добавить("Взаимозачет");
	КонецЕсли;
	
	Если ПолноеИмяОбъектаМД = "Документ.Оплата" Тогда
		Результат.Добавить("ОбеспечительныйПлатеж");
		Результат.Добавить("КоррСчет");
		Результат.Добавить("Субконто1");
		Результат.Добавить("Субконто2");
		Результат.Добавить("Субконто3");
		Результат.Добавить("КоррСчетЕПС");
		Результат.Добавить("СубконтоЕПС1");
		Результат.Добавить("СубконтоЕПС2");
		Результат.Добавить("СубконтоЕПС3");
		Результат.Добавить("ДатаПлановогоПогашенияЗадолженности");
		Результат.Добавить("Поручение");
	КонецЕсли;
	
	Если ПолноеИмяОбъектаМД = "Документ.Оплата.ТабличнаяЧасть.Основания" Тогда
		Результат.Добавить("СтавкаНДС");
		Результат.Добавить("СуммаНДС");
	КонецЕсли;

	Если ПолноеИмяОбъектаМД = "Документ.НачислениеЗадолженности" Тогда
		Результат.Добавить("НомерСчетаФактуры");
		Результат.Добавить("ДатаСчетаФактуры");
		Результат.Добавить("НДСВключатьВСтоимость");
		Результат.Добавить("ЗачестьНДС");
		Результат.Добавить("НДСПоОбщимРасходам");
		Результат.Добавить("Предварительно");
		Результат.Добавить("Грузоотправитель");
		Результат.Добавить("Арендатор");
		Результат.Добавить("ДоговорАренды");
		Результат.Добавить("ДатаОплатыАренды");
		Результат.Добавить("СчетФактураСводный");
	КонецЕсли;
	
	Если ПолноеИмяОбъектаМД = "Документ.НачислениеЗадолженности.ТабличнаяЧасть.Основания" Тогда
		Результат.Добавить("Содержание");
	КонецЕсли;
	
	Если ПолноеИмяОбъектаМД = "Документ.СделкаСПФИ" Тогда
		Результат.Добавить("СтавкаВходящихПлатежей");
		Результат.Добавить("СтавкаИсходящихПлатежей");
		Результат.Добавить("ПериодичностьВходящихПлатежей");
		Результат.Добавить("ПериодичностьИсходящихПлатежей");
		Результат.Добавить("Поставочный");
		Результат.Добавить("РежимБиржевыхТоргов");
	КонецЕсли;

	Если Внебиржа И НЕ ЗагружатьКонтрагентаПоВнебиржевымСделкам Тогда
		//Не грузим и не сверяем контрагента по внебирже, т.к. в отчете брокера его нет
		Если ПолноеИмяОбъектаМД = "Документ.СделкаРЕПО" ИЛИ ПолноеИмяОбъектаМД = "Документ.Сделка" Тогда
			Результат.Добавить("Контрагент");
		ИначеЕсли ПолноеИмяОбъектаМД = "Документ.Оплата" Тогда
			Результат.Добавить("Контрагент");
			Результат.Добавить("Договор");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПоляОбъектаНаОснованииМетаданных(ОбъектМД, Знач ИменаПолейОбъектаМД = Неопределено, Внебиржа = Ложь)
	
	ПоляОбъекта = Новый Структура();
	
	ИменаПолейОбъектаМД = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаПолейОбъектаМД, ",", Истина, Истина);
	ПолноеИмяОбъектаМД  = ОбъектМД.ПолноеИмя();
	
	Если Найти(ПолноеИмяОбъектаМД, "Документ.") = 1 Тогда
		Если Найти(ПолноеИмяОбъектаМД, ".ТабличнаяЧасть.") = 0 Тогда
			ПоляОбъекта.Вставить("Дата");
			ПоляОбъекта.Вставить("Проведен");
			ПоляОбъекта.Вставить("ПометкаУдаления");
		Иначе
			ПоляОбъекта.Вставить("НомерСтроки");
		КонецЕсли;
		
		НезагружаемыеРеквизиты = ПолучитьНезагружаемыеРеквизиты(ПолноеИмяОбъектаМД, Внебиржа);
		
		Для каждого РеквизитМД Из ОбъектМД.Реквизиты Цикл
			Если НезагружаемыеРеквизиты.НайтиПоЗначению(РеквизитМД.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПоляОбъекта.Вставить(РеквизитМД.Имя);
		КонецЦикла;
		
	Иначе
		ВызватьИсключение "Получение таблицы полей на основании объекта '" + ПолноеИмяОбъектаМД + "' не поддерживается";
		
	КонецЕсли;
	
	Возврат
		Новый ФиксированнаяСтруктура(ПоляОбъекта);
	
КонецФункции

