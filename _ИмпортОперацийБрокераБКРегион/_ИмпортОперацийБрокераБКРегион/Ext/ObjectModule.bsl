// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

Процедура ЗагрузитьОперации(ДанныеСФормы)
			
	ТаблицаНовыхДокументов = Новый ТаблицаЗначений;
	
	ВидыОпераций = Новый Соответствие();
	ВидыОпераций.Вставить("БиржевыеСделки", "Сделка");
	ВидыОпераций.Вставить("ВнебиржевыеСделки", "Сделка");
	ВидыОпераций.Вставить("ИзмененияСделок", "ИзменениеУсловийСделки");
	ВидыОпераций.Вставить("БиржевыеСделкиРЕПО1", "СделкаРЕПО");
	ВидыОпераций.Вставить("БиржевыеСделкиРЕПО2", "СделкаРЕПО");
	ВидыОпераций.Вставить("ИзмененияСделокРЕПО2", "ИзменениеУсловийСделки");
	ВидыОпераций.Вставить("ВнебиржевыеСделкиРЕПО", "СделкаРЕПО");
	ВидыОпераций.Вставить("СделкиСВалютой", "СделкаСвалютой");
	ВидыОпераций.Вставить("ФорвардыПоставочные", "СделкаСвалютой");
	ВидыОпераций.Вставить("ПоставкиЦенныхБумаг", "ПоставкаЦенныхБумаг");
	ВидыОпераций.Вставить("ОплатыВнебиржевыхСделок", "Оплата");
	ВидыОпераций.Вставить("ОплатыБиржевыхСделок", "Оплата");
	ВидыОпераций.Вставить("ИсполненияБиржевыхСделок", "ИсполнениеОбязательствПоСделке");
	ВидыОпераций.Вставить("ВариационнаяМаржа", "Маржа");
	ВидыОпераций.Вставить("ПереводыДенежныхСредств", "ПереводДенежныхСредств");
	ВидыОпераций.Вставить("НачисленияКомиссии", "НачислениеЗадолженности");
	ВидыОпераций.Вставить("ОплатыКомиссии", "Оплата");
	ВидыОпераций.Вставить("ОтменыСделок", "ОтменаСделки");
	ВидыОпераций.Вставить("ОплатыПоПогашениям", "Оплата");
	ВидыОпераций.Вставить("ОплатыПоВозвратуКупона", "Оплата");
	ВидыОпераций.Вставить("СписанияЦенныхБумаг", "СписаниеЦеннойБумаги");
	ВидыОпераций.Вставить("СделкиСПФИ", "СделкаСПФИ");
	ВидыОпераций.Вставить("МаржаСПФИ", "Маржа");
	
	Для Каждого ТаблицаОпераций Из ДанныеСФормы Цикл
	
		ВидОперации = ВидыОпераций.Получить(ТаблицаОпераций.Ключ);
		
		Если ТаблицаОпераций.Ключ = "БиржевыеСделки" Или ТаблицаОпераций.Ключ = "БиржевыеСделкиРЕПО1"
			Или ТаблицаОпераций.Ключ = "БиржевыеСделкиРЕПО2" Или ТаблицаОпераций.Ключ = "СделкиСВалютой"
			Или ТаблицаОпераций.Ключ = "ИсполненияБиржевыхСделок" 
				Тогда
			
			МассивНовыхДокументов = ТаблицаОпераций.Значение.НайтиСтроки(Новый Структура("Статус", "Новый"));
			
			Если МассивНовыхДокументов.Количество() > 0 Тогда
				
				Если ТаблицаНовыхДокументов.Количество() > 0 Тогда
					РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ТаблицаОпераций.Значение.Скопировать(МассивНовыхДокументов), ТаблицаНовыхДокументов);
				Иначе
					ТаблицаНовыхДокументов = ТаблицаОпераций.Значение.Скопировать(МассивНовыхДокументов);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
					
		Если ВидОперации = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УстранитьРасхождения(ВидОперации, ТаблицаОпераций.Значение);
		
	КонецЦикла;
	
	Если ЭтотОбъект.Организация <> ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") И ТаблицаНовыхДокументов.Количество() > 0 Тогда
		ОповеститьОНовыхБиржевыхОперациях(ТаблицаНовыхДокументов);	
	КонецЕсли;
			
КонецПроцедуры

Функция УстранитьРасхождения(ВидДокумента, Операции)
		
	Для каждого СтрокаОперации Из Операции Цикл
					
		НовыеРеквизиты = СтрокаОперации.НовыеРеквизиты.Получить();
		
		Если СтрокаОперации.Статус = "Расхождения в доп сведениях" Тогда
			
			РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(СтрокаОперации.Ссылка, "_РаскрытыйКонтрагент", НовыеРеквизиты.ДопСведения.РаскрытыйКонтрагент);
			Продолжить;
			
		ИначеЕсли СтрокаОперации.Статус = "Отсутствует" Тогда			
								
			Документ = СтрокаОперации.Ссылка.ПолучитьОбъект();
			
			Попытка
				
				Документ.УстановитьПометкуУдаления(Истина);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ помечен на удаление '" + Документ + "'");
				Продолжить;
				
			Исключение
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка установки пометки на удаление документа '" + ВидДокумента + "'. Система сообщает: " + ОписаниеОшибки());
				Продолжить;
				
			КонецПопытки;
			
		ИначеЕсли СтрокаОперации.Статус = "Новый" Тогда
			
			Документ = Документы[ВидДокумента].СоздатьДокумент();
			
			Документ.Комментарий   = "Создан аппаратно-техническими средствами " + ТекущаяДата();
			Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
						
		ИначеЕсли СтрокаОперации.Статус = "Есть расхождения" Тогда
			
			Документ = СтрокаОперации.Ссылка.ПолучитьОбъект();
			
		Иначе
			Продолжить;
		КонецЕсли;
						
		Для каждого НаборПолей Из НовыеРеквизиты Цикл
			
			Если НаборПолей.Ключ = "Шапка" Тогда
				
				ЗаполнитьЗначенияСвойств(Документ, НаборПолей.Значение);
				
			ИначеЕсли НаборПолей.Ключ = "ДопСведения" Тогда
				//запись в доп сведения осуществляется после записи сделки.	
			Иначе
				Документ[НаборПолей.Ключ].Очистить();
				
				Для каждого СтрокаНабора Из НаборПолей.Значение Цикл
					ЗаполнитьЗначенияСвойств(Документ[НаборПолей.Ключ].Добавить(), СтрокаНабора,, "НомерСтроки");
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		//Логика проведения:
		//1. Проводим все документы в Т-1
		//2. Если есть непроведенные биржевые операции в Т0 сообщаем об этом + вносим изменения (если есть) и пытаемся провести.
		//3. Если в проведенный документ в Т0 вносятся изменения и при этом документ не проводится (с внесенными изменениями) - не вносим изменения и оставляем проведенным со старыми данными.
		//4. Если в документ с датой больше Т0 вносим изменения и оставляем его в том состоянии, в котором он был до внесения изменения.
		
		ОшибкаПроведения = Ложь;
		ДокументПроведен = Документ.Проведен;
		
		//Если новый док - Первый раз пробуем провести. Во второй раз пробуем записать.
		//Если НЕ новый док не проводится после внесения изменений - оставляем проведенным без изменений.
		Пока Истина Цикл 
			
			НачатьТранзакцию();
						
			Если Документ.ПроверитьЗаполнение() И ДокументПроведен И Не ОшибкаПроведения Тогда
				
				Попытка
					Документ.Записать(РежимЗаписиДокумента.Проведение);
					Прервать;
				Исключение
					
					ОтменитьТранзакцию();
					ОшибкаПроведения = Истина;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ '" + ВидДокумента + "'. Система сообщает: " + ОписаниеОшибки());
					Продолжить;
					
				КонецПопытки;
				
			Иначе
				
				Попытка
					
					Если Документ.ЭтоНовый() Или Не ДокументПроведен Тогда
						
						Документ.Проведен = Ложь;
						Документ.Записать(РежимЗаписиДокумента.Запись);
						
					КонецЕсли;
					
				Исключение
					
					ОтменитьТранзакцию();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ '" + ВидДокумента + "'. Система сообщает: " + ОписаниеОшибки());
					
				КонецПопытки;
				
				Прервать;
					
			КонецЕсли;
			
		КонецЦикла;
								
		Если Не ТранзакцияАктивна() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидДокумента = "Сделка" И НовыеРеквизиты.Свойство("ДопСведения") Тогда
			
			ТекущиеРеквизиты = СтрокаОперации.ТекущиеРеквизиты.Получить();
			
			Если ТекущиеРеквизиты = Неопределено Или ТекущиеРеквизиты.Свойство("ДопСведения") И НовыеРеквизиты.ДопСведения.Свойство("РаскрытыйКонтрагент") И НовыеРеквизиты.ДопСведения.РаскрытыйКонтрагент <> ТекущиеРеквизиты.ДопСведения.РаскрытыйКонтрагент Тогда
				РаботаСФормами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Документ.Ссылка, "_РаскрытыйКонтрагент", НовыеРеквизиты.ДопСведения.РаскрытыйКонтрагент);	
			КонецЕсли;
		
		КонецЕсли;
					
		КодВоВнешнейСистеме = СтрокаОперации.КодВоВнешнейСистеме.Получить();
		
		Если ТипЗнч(КодВоВнешнейСистеме) = Тип("Структура") Тогда
			УстановитьПривилегированныйРежим(Истина);
			
			КодыДокументаВоВнешнейСистеме = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьНаборЗаписей();
			
			КодыДокументаВоВнешнейСистеме.Отбор.ВнешняяСистема.Установить(КодВоВнешнейСистеме.ВнешняяСистема);
			КодыДокументаВоВнешнейСистеме.Отбор.ГруппаОбъектов.Установить(КодВоВнешнейСистеме.ГруппаОбъектов);
			КодыДокументаВоВнешнейСистеме.Отбор.Объект.Установить(Документ.Ссылка);
			КодыДокументаВоВнешнейСистеме.Прочитать();
			
			Если КодыДокументаВоВнешнейСистеме.Количество() = 0 Тогда
				Запись = КодыДокументаВоВнешнейСистеме.Добавить();
				Запись.ВнешняяСистема = КодВоВнешнейСистеме.ВнешняяСистема;
				Запись.ГруппаОбъектов = КодВоВнешнейСистеме.ГруппаОбъектов;
				Запись.Объект         = Документ.Ссылка;
				Запись.Период         = Дата(1980, 1, 1);
				Запись.Код            = КодВоВнешнейСистеме.Код;
				
				КодыДокументаВоВнешнейСистеме.Записать();
			КонецЕсли;
			
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
			
		ЗафиксироватьТранзакцию();

	КонецЦикла;
	
КонецФункции

Процедура НайтиРасхожденияИУстановитьСтатус(НовыеРеквизиты, ТекущиеРеквизиты, Статус, ОшибкиЧтения, СтрокаРеквизитов = "")
	
	Статус = ?(Статус = "Ошибка чтения", Статус, "Нет расхождений");
	// Для нижеследующих реквизитов (в случае если не удалось определить значение по данным из файла), значение заполняем значениями текущих реквизитов. #219002
	ФильтрРеквизитов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРеквизитов, ",", Истина, Истина);
	
	Для каждого КлючЗначение Из НовыеРеквизиты Цикл
		
		Если КлючЗначение.Ключ = "Шапка" Тогда // это структура
			
			Для Каждого Реквизит Из КлючЗначение.Значение Цикл
				
				Если ФильтрРеквизитов.Найти(Реквизит.Ключ) <> Неопределено Тогда//И ЗначениеЗаполнено(ТекущиеРеквизиты.Шапка[Реквизит.Ключ]) Тогда
					КлючЗначение.Значение[Реквизит.Ключ] = ТекущиеРеквизиты.Шапка[Реквизит.Ключ];
					Продолжить;
				КонецЕсли;
				
				Если Реквизит.Значение <> ТекущиеРеквизиты.Шапка[Реквизит.Ключ] И Статус <> "Ошибка чтения" Тогда
					Статус = "Есть расхождения";
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли КлючЗначение.Ключ = "ДопСведения" Тогда
			
			Для Каждого Реквизит Из КлючЗначение.Значение Цикл
				
				Если Реквизит.Значение <> ТекущиеРеквизиты.ДопСведения[Реквизит.Ключ] И Статус <> "Ошибка чтения" Тогда
					Статус = ?(Статус = "Есть расхождения", Статус, "Расхождения в доп сведениях");
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе // это табличная часть представленная массивом структур
			Если НовыеРеквизиты[КлючЗначение.Ключ].Количество() <> ТекущиеРеквизиты[КлючЗначение.Ключ].Количество() И Статус <> "Ошибка чтения" Тогда
				Статус = "Есть расхождения";
			КонецЕсли;
			
			Для Инд = 0 По НовыеРеквизиты[КлючЗначение.Ключ].Количество() - 1 Цикл
				НовыеРеквизитыТабЧасти   = НовыеРеквизиты[КлючЗначение.Ключ][Инд];
				
				//может поменяться количество строк в табл.части
				Попытка
					ТекущиеРеквизитыТабЧасти = ТекущиеРеквизиты[КлючЗначение.Ключ][Инд];
				Исключение
					Статус = ?(Статус = "Ошибка чтения", Статус, "Есть расхождения");
					Возврат;
				КонецПопытки;
				
				Для Каждого Реквизит Из НовыеРеквизитыТабЧасти Цикл
					
					Если ФильтрРеквизитов.Найти(КлючЗначение.Ключ + "." + Реквизит.Ключ) <> Неопределено Тогда
						
						Если Не ЗначениеЗаполнено(ТекущиеРеквизитыТабЧасти[Реквизит.Ключ]) Тогда
							
							Если Реквизит.Ключ = "ДепозитарныйСчет" Тогда 
								Статус = "Требуется ручной ввод";
								
								ТекстСообщения = "При импорте данных не удалось получить реквизит [" + Реквизит.Ключ + "]. Заполните [" + Реквизит.Ключ + "] и проведите документ."; 
								Если ОшибкиЧтения.Найти(ТекстСообщения) = Неопределено Тогда
									ОшибкиЧтения.Добавить(ТекстСообщения);
								КонецЕсли;
							КонецЕсли;
							
						ИначеЕсли Реквизит.Значение <> ТекущиеРеквизитыТабЧасти[Реквизит.Ключ] Тогда 
							
							НовыеРеквизитыТабЧасти[Реквизит.Ключ] = ТекущиеРеквизитыТабЧасти[Реквизит.Ключ];	
							
						КонецЕсли;
						
						Продолжить;
						
					КонецЕсли;
					
					Если Реквизит.Значение <> ТекущиеРеквизитыТабЧасти[Реквизит.Ключ] И Статус <> "Ошибка чтения" Тогда
						Статус = "Есть расхождения";
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ОповеститьОНовыхБиржевыхОперациях(ТаблицаНовыхОпераций)
	
	//Биржевые операции должны загружаться из QUIKа, если они загружаются из файла брокера - нам нужно об этом знать.
	ТаблицаСообщений = Новый ТаблицаЗначений;
	ТаблицаСообщений.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаСообщений.Колонки.Добавить("ТекстСообщения", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаНовыхОпераций Цикл
		
		НовыеРеквизиты = СтрокаТаблицы.НовыеРеквизиты.Получить();
		
		Если СтрНайти(СтрокаТаблицы.Описание, "РЕПО") > 0 Тогда
			НомерСделки = ?(НовыеРеквизиты.Шапка.НомерСделки = Неопределено, НовыеРеквизиты.Шапка.НомерСделкиСЦентральнымКонтрагентом, НовыеРеквизиты.Шапка.НомерСделки); 
			ТекстСообщения = "Сделка Репо № " + НомерСделки + ", режим торгов [" + НовыеРеквизиты.Шапка.РежимБиржевыхТоргов.Код + "]";
		ИначеЕсли СтрНайти(СтрокаТаблицы.Описание, "Бирж. сделка") > 0 Тогда
			ТекстСообщения = "Сделка № " + НовыеРеквизиты.Шапка.НомерСделки + ", режим торгов [" + НовыеРеквизиты.Шапка.РежимБиржевыхТоргов.Код + "]";
		ИначеЕсли СтрНайти(СтрокаТаблицы.Описание, "Сделка с валютой") > 0 И НовыеРеквизиты.Шапка.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок Тогда
			ТекстСообщения = "Сделка с валютой № " + НовыеРеквизиты.Шапка.НомерСделки;
		ИначеЕсли СтрНайти(СтрокаТаблицы.описание, "Исполн. бирж. сделки") > 0 Тогда
			ТекстСообщения = "Исполнение по сделке № " + НовыеРеквизиты.Шапка.Основание.НомерСделки;
		Иначе
			Продолжить;
		КонецЕсли;
		
		НоваяСтрокаТаблицыСообщений = ТаблицаСообщений.Добавить();
		НоваяСтрокаТаблицыСообщений.СчетДоверительногоУправления = НовыеРеквизиты.Шапка.СчетДоверительногоУправления;
		НоваяСтрокаТаблицыСообщений.ТекстСообщения = ТекстСообщения;
	
	КонецЦикла;
	
	Если ТаблицаСообщений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСообщений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТаблицаСообщений.ТекстСообщения КАК ТекстСообщения
		|ПОМЕСТИТЬ _ТаблицаСообщений
		|ИЗ
		|	&ТаблицаСообщений КАК ТаблицаСообщений
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСообщений.ТекстСообщения КАК ТекстСообщения,
		|	 "", счет ДУ ["" + КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.Наименование + ""], код у брокера ["" + КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код + ""]"" КАК ТекстДополнение
		|ИЗ
		|	_ТаблицаСообщений КАК _ТаблицаСообщений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Брокер = &Брокер
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_ТаблицаСообщений.СчетДоверительногоУправления
		|						ИЗ
		|							_ТаблицаСообщений)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО _ТаблицаСообщений.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления";
#КонецОбласти
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Брокер", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ТаблицаСообщений", ТаблицаСообщений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщения = "";
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = ТекстСообщения + Символы.ПС + Выборка.ТекстСообщения + Выборка.ТекстДополнение;	
	КонецЦикла;

	Если ТекстСообщения = "" Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = "При импорте операций из файла брокера на дату " + Формат(ЭтотОбъект.ДатаИмпорта, "ДЛФ=Д")  + " загружены новые биржевые сделки: " + ТекстСообщения;
	
	СформироватьОповещение("Импорт операции БК Регион. Уведомление о новых биржевых операциях.", ТекстСообщения);
	   	
КонецПроцедуры

Функция ПолучитьОписаниеПолейКомиссии()
	
	ПоляКомиссии = Новый Структура;
	
	ПоляКомиссии.Вставить("Operation_ID",                Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Charge_ID",                   Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Charge_Operation_ID",         Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Operation_Time",              Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(8)));
	ПоляКомиссии.Вставить("Commission_Type_ID",          Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Commission_Type",             Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Client_Code",                 Метаданные.РегистрыСведений.КодыВоВнешнихСистемах.Ресурсы.Код.Тип);
	ПоляКомиссии.Вставить("Briefcase_Code",              Метаданные.РегистрыСведений.КодыВоВнешнихСистемах.Ресурсы.Код.Тип);
	ПоляКомиссии.Вставить("Deal_ID",                     Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Deal_Number",                 Метаданные.Документы.Сделка.Реквизиты.НомерСделки.Тип);
	ПоляКомиссии.Вставить("Deal_Type",                   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ПоляКомиссии.Вставить("Deal_Direction",              Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1)));
	ПоляКомиссии.Вставить("Currency_Code",               Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(Метаданные.Справочники.Валюты.ДлинаКода)));
	ПоляКомиссии.Вставить("Amount",                      Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
	ПоляКомиссии.Вставить("Money_Account_Division_Type", Метаданные.РегистрыСведений.КодыВоВнешнихСистемах.Ресурсы.Код.Тип);	
	ПоляКомиссии.Вставить("Security_ID",                 Новый ОписаниеТипов("Строка"));
	ПоляКомиссии.Вставить("Security_Type_Name",          Новый ОписаниеТипов("Строка"));
	
	Возврат ПоляКомиссии;
	
КонецФункции

