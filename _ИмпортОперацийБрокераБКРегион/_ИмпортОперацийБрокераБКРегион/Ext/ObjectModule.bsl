		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ВнешниеДанные";
#КонецОбласти
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("РоссийскийРубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
		
	ОплатыВнебиржевыхСделокДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ОплатыВнебиржевыхСделокВнешниеДанные"].ПолучитьДанные().Выбрать();
			
	Пока Выборка.Следующий() Цикл
						
		ОшибкиЧтения                     = Новый Массив;
		НоваяСтрокаОперации              = Операции.Добавить();					
		НоваяСтрокаОперации.Ключ         = Выборка.Record_UID;
		НоваяСтрокаОперации.Описание     = "Оплата / " + Выборка.ВидЗадолженности + " / " + Выборка.Record_UID;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
				Справочники.ВнешниеСистемы.Матрих, Группа_Payment, Выборка.Record_UID);
		
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = ?(Выборка.ВидДвижения = Перечисления.ВидыДвижений.Расход, ЭтотОбъект.ДатаИмпорта + ((19 * 60 + 30) * 60), ?(ЗначениеЗаполнено(Выборка.Основание) И НачалоДня(Выборка.Основание.Дата) = ЭтотОбъект.ДатаИмпорта, Выборка.Основание.Дата + 2, ЭтотОбъект.ДатаИмпорта + (9 * 60 + 30) *60));
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.ВидДвижения                  = Выборка.ВидДвижения;
		РеквизитыШапки.ВидЗадолженности             = Выборка.ВидЗадолженности;
		РеквизитыШапки.Аванс                        = Ложь;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.МестоХранения                = Выборка.МестоХраненияДенежныхСредств;
		РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.ВалютаОплаты                 = Выборка.ВалютаОплаты;
		РеквизитыШапки.Брокер                       = Брокер;
		РеквизитыШапки.СтрокаБанковскойВыписки      = Документы.СтрокаБанковскойВыписки.ПустаяСсылка();
		РеквизитыШапки.Контрагент 					= Справочники.ЮрФизЛица.ПустаяСсылка();
		РеквизитыШапки.РасчетныйСчетКонтрагента 	= Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.Договор               		= Справочники.Договоры.ПустаяСсылка();	
				

		Основания = Новый Массив;
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, Основания", РеквизитыШапки, Основания);
					
		РеквизитыОснования = Новый Структура(ПоляДокумента.Основания);
		РеквизитыОснования.НомерСтроки = 1;
		
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда 
			
			РеквизитыОснования.Основание = Выборка.Основание;
			
			Если РеквизитыШапки.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО Тогда
				РеквизитыШапки.Контрагент = Выборка.Основание.Контрагент;
			КонецЕсли;

		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить документ основание по коду матрих [" + Выборка.Deal_Record_UID + "]");
		КонецЕсли;
		
		РеквизитыОснования.СобственныйКурсОплаты = Ложь;
		РеквизитыОснования.КурсОплаты            = Неопределено;
		РеквизитыОснования.Сумма                 = Выборка.СуммаВВалютеСделки;
		РеквизитыОснования.СуммаКупона           = Выборка.СуммаКупонаВВалютеСделки;
		РеквизитыОснования.Валюта                = ?(ЗначениеЗаполнено(Выборка.ВалютаСделки), Выборка.ВалютаСделки, Выборка.ВалютаОплаты);
		РеквизитыОснования.СуммаОплаты           = Выборка.СуммаОплаты;
		РеквизитыОснования.СуммаОплатыКупона     = Выборка.СуммаОплатыКупона;
										
		Основания.Добавить(РеквизитыОснования);
									
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
										
	КонецЦикла;
	
	ИсключитьИзСверки = "Дата";
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ОплатыВнебиржевыхСделокДанныеСистемы, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьОплатыПоВозвратуКупона_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	Группа_Payment = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Payment");
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Оплата, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Money_Operations.Ключ КАК Ключ,
		|	_Money_Operations.Record_UID КАК Record_UID,
		|	_Money_Operations.Date КАК Date,
		|	_Money_Operations.Origin_Operation_Type КАК Origin_Operation_Type,
		|	_Money_Operations.Payment_Amount КАК Payment_Amount,
		|	_Money_Operations.Coupon_Amount КАК Coupon_Amount,
		|	_Money_Operations.Direction КАК Direction,
		|	_Money_Operations.Inner_Account_Division_ID КАК Inner_Account_Division_ID,
		|	_Money_Operations.Money_Storage_Place КАК Money_Storage_Place,
		|	_Money_Operations.Payment_Currency_Code КАК Payment_Currency_Code,
		|	_Money_Operations.Security_ID КАК Security_ID,
		|	_Money_Operations.Deal_Record_UID КАК Deal_Record_UID,
		|	_Money_Operations.Market_Number КАК Market_Number
		|ПОМЕСТИТЬ _Money_Operations_Instructions
		|ИЗ
		|	_Money_Operations КАК _Money_Operations
		|ГДЕ
		|	_Money_Operations.Date = &НачалоПериода
		|	И _Money_Operations.Origin_Operation_Type В (""Operations.Group.Payments.IncomeReturn"", ""Operations.Group.Payments.CouponReturn"")
		|	И _Money_Operations.Direction = ""-1""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Money_Instructions.Ключ,
		|	_Money_Instructions.Record_UID,
		|	_Money_Instructions.Date,
		|	_Money_Instructions.Operation_Type,
		|	0,
		|	_Money_Instructions.Amount,
		|	""-1"",
		|	_Money_Instructions.Inner_Account_Division_ID,
		|	_Money_Instructions.Money_Storage_Place,
		|	_Money_Instructions.Currency_Code,
		|	"""",
		|	_Money_Instructions.Deal_Record_UID,
		|	_Money_Instructions.Market_Number
		|ИЗ
		|	_Money_Instructions КАК _Money_Instructions
		|ГДЕ
		|	_Money_Instructions.Date = &НачалоПериода
		|	И _Money_Instructions.Deal_Record_UID <> """"
		|	И _Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.Out""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Money_Operations_Instructions.Record_UID КАК Record_UID,
		|	_Money_Operations_Instructions.Date КАК Date,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода) КАК ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА _Money_Operations_Instructions.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		КОГДА _Money_Operations_Instructions.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	_Money_Operations_Instructions.Payment_Amount КАК Сумма,
		|	_Money_Operations_Instructions.Coupon_Amount КАК СуммаКупона,
		|	_Money_Operations_Instructions.Inner_Account_Division_ID КАК Inner_Account_Division_ID,
		|	_Money_Operations_Instructions.Money_Storage_Place КАК Money_Storage_Place,
		|	_Money_Operations_Instructions.Payment_Currency_Code КАК Payment_Currency_Code,
		|	_Money_Operations_Instructions.Security_ID КАК Security_ID,
		|	_Money_Operations_Instructions.Deal_Record_UID КАК Deal_Record_UID,
		|	_Money_Operations_Instructions.Market_Number КАК Market_Number,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_Валюты.Валюта КАК ВалютаОплаты,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number КАК КодУБрокера,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций КАК КодДляСверкиОпераций
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	_Money_Operations_Instructions КАК _Money_Operations_Instructions
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Money_Operations_Instructions.Ключ = _ДанныеПервыхУзлов.Ключ
		|			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
		|		ПО _Money_Operations_Instructions.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _Money_Operations_Instructions.Payment_Currency_Code = _Валюты.ISO_Code
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Money_Operations_Instructions.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|ГДЕ
		|	НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанные.Record_UID КАК Record_UID,
		|	_ВнешниеДанные.Deal_Record_UID КАК Deal_Record_UID,
		|	_ВнешниеДанные.Market_Number КАК Market_Number,
		|	_ВнешниеДанные.Date КАК Date,
		|	_ВнешниеДанные.ВидЗадолженности КАК ВидЗадолженности,
		|	_ВнешниеДанные.ВидДвижения КАК ВидДвижения,
		|	_ВнешниеДанные.МестоХраненияДенежныхСредств КАК МестоХраненияДенежныхСредств,
		|	_ВнешниеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВнешниеДанные.КодУБрокера КАК КодУБрокера,
		|	_ВнешниеДанные.КодДляСверкиОпераций КАК КодДляСверкиОпераций,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.Market_Number = """"
		|			ТОГДА _ВнебиржевыеСделки.Объект
		|		ИНАЧЕ ЕСТЬNULL(СделкаРЕПО.Ссылка, Сделка.Ссылка)
		|	КОНЕЦ КАК Основание,
		|	_ВнешниеДанные.Сумма КАК СуммаОплаты,
		|	_ВнешниеДанные.Security_ID КАК КодМатрихЦБ,
		|	_ВнешниеДанные.СуммаКупона КАК СуммаОплатыКупона,
		|	_ВнешниеДанные.ВалютаОплаты КАК ВалютаОплаты
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ПО _ВнешниеДанные.Deal_Record_UID = _ВнебиржевыеСделки.НомерОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (ВЫБОР
		|				КОГДА СделкаРЕПО.СделкаСЦентральнымКонтрагентом
		|					ТОГДА _ВнешниеДанные.Market_Number = СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом
		|				ИНАЧЕ _ВнешниеДанные.Market_Number = СделкаРЕПО.НомерСделки
		|			КОНЕЦ)
		|			И (СделкаРЕПО.ЧастьСделкиРЕПО = 1)
		|			И (_ВнешниеДанные.Market_Number <> """")
		|			И (СделкаРЕПО.Организация = &Организация)
		|			И (СделкаРЕПО.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО _ВнешниеДанные.Market_Number = Сделка.НомерСделки
		|			И (_ВнешниеДанные.Market_Number <> """")
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетДоверительногоУправления,
		|	МестоХраненияДенежныхСредств,
		|	Deal_Record_UID УБЫВ,
		|	Market_Number УБЫВ
		|ИТОГИ ПО
		|	СчетДоверительногоУправления,
		|	МестоХраненияДенежныхСредств
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Money_Operations_Instructions
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ВнешниеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _УсловияСделок";
#КонецОбласти
		
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
		
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ГруппировкаПоСчету.Следующий() Цикл
		
		ГруппировкаПоМестуХранения = ГруппировкаПоСчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ГруппировкаПоМестуХранения.Следующий() Цикл
	
			Выборка = ГруппировкаПоМестуХранения.Выбрать();
			
			НомерСтроки = 0;
			Пока Выборка.Следующий() Цикл
				
				Если НомерСтроки = 0 Тогда
				
					ОшибкиЧтения                     = Новый Массив;
					НоваяСтрокаОперации              = Операции.Добавить();
					НоваяСтрокаОперации.Ключ         = Выборка.МестоХраненияДенежныхСредств.Наименование + "/" + Выборка.КодДляСверкиОпераций;	
					НоваяСтрокаОперации.Описание     = "Оплата / " + Выборка.ВидЗадолженности + " / " + ?(ЗначениеЗаполнено(Выборка.Market_Number), Выборка.КодУБрокера, Выборка.Record_UID);
					НоваяСтрокаОперации.Статус       = "Новый";
					НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
					НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
										
					РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
					РеквизитыШапки.Проведен                     = Истина;
					РеквизитыШапки.ПометкаУдаления              = Ложь;
					РеквизитыШапки.Дата                         = ?(Выборка.ВидДвижения = Перечисления.ВидыДвижений.Расход, ЭтотОбъект.ДатаИмпорта + ((19 * 60 + 30) * 60), ?(ЗначениеЗаполнено(Выборка.Основание) И НачалоДня(Выборка.Основание.Дата) = ЭтотОбъект.ДатаИмпорта, Выборка.Основание.Дата + 2, ЭтотОбъект.ДатаИмпорта + (9 * 60 + 30) *60));
					РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
					РеквизитыШапки.ВидДвижения                  = Выборка.ВидДвижения;
					РеквизитыШапки.ВидЗадолженности             = Выборка.ВидЗадолженности;
					РеквизитыШапки.Аванс                        = Ложь;
					РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
					РеквизитыШапки.МестоХранения                = Выборка.МестоХраненияДенежныхСредств;
					РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
					РеквизитыШапки.ВалютаОплаты                 = Выборка.ВалютаОплаты;
					РеквизитыШапки.Брокер                       = Брокер;
					РеквизитыШапки.СтрокаБанковскойВыписки      = Документы.СтрокаБанковскойВыписки.ПустаяСсылка();
					РеквизитыШапки.РасчетныйСчетКонтрагента 	= Справочники.БанковскиеСчета.ПустаяСсылка();
					РеквизитыШапки.Договор               		= Справочники.Договоры.ПустаяСсылка();	
							
					
					Основания = Новый Массив;
					НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, Основания", РеквизитыШапки, Основания);

				КонецЕсли;
				
				НомерСтроки = НомерСтроки + 1;
				РеквизитыОснования = Новый Структура(ПоляДокумента.Основания);
				
				РеквизитыОснования.НомерСтроки = НомерСтроки;
				
				Если ЗначениеЗаполнено(Выборка.Основание) Тогда 
					
					РеквизитыОснования.Основание = Выборка.Основание;
					
					Если Выборка.Основание.Брокер <> Справочники.БрокерскиеКомпании.ПустаяСсылка() Тогда
						РеквизитыШапки.Контрагент = Выборка.Основание.Брокер.ЮрФизЛицо
					Иначе 
						РеквизитыШапки.Контрагент = Выборка.Основание.Контрагент;
					КонецЕсли;

				Иначе
					ОшибкиЧтения.Добавить("Не удалось определить " + ?(Выборка.Market_Number = "", " документ основание по коду матрих [" + Выборка.Deal_Record_UID + "]", "сделку Репо по номеру сделки [" + Выборка.Market_Number + "]"));
				КонецЕсли;
				
				РеквизитыОснования.СобственныйКурсОплаты = Ложь;
				РеквизитыОснования.КурсОплаты            = Неопределено;
				РеквизитыОснования.Сумма                 = Выборка.СуммаОплаты;
				РеквизитыОснования.СуммаКупона           = Выборка.СуммаОплатыКупона;
				РеквизитыОснования.Валюта                = Выборка.ВалютаОплаты;
				РеквизитыОснования.СуммаОплаты           = Выборка.СуммаОплаты;
				РеквизитыОснования.СуммаОплатыКупона     = Выборка.СуммаОплатыКупона;
												
				Основания.Добавить(РеквизитыОснования);
											
				Если ОшибкиЧтения.Количество() > 0 Тогда
					НоваяСтрокаОперации.Статус = "Ошибка чтения";
				КонецЕсли;
									
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.МестоХранения.Наименование + ""/"" + _КодыСчетовУБрокера.КодДляСверкиОпераций КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовУБрокера КАК _КодыСчетовУБрокера
		|		ПО Оплата.СчетДоверительногоУправления = _КодыСчетовУБрокера.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО Оплата.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	Оплата.Организация = &Организация
		|	И НЕ Оплата.ПометкаУдаления
		|	И Оплата.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|	И Оплата.Брокер = &Брокер
		|	И НЕ Оплата.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
#КонецОбласти

	ИсключитьИзСверки = "Дата";
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, Запрос.Выполнить().Выгрузить(), ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьОплатыПоПогашениям_OTBR(МВТ)
	
	Перем Операции, ПоляДокумента;
		
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Оплата, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи))
		|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.НачислениеДивидендов).ЦеннаяБумага
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
