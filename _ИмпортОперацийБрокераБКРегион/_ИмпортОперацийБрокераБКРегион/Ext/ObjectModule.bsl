				|Operations.Group.Settlements.Payment, Operations.Group.Settlements.ACI, Operations.Group.Settlements.REPO.Payment.Near, Operations.Group.Settlements.REPO.ACI.Near,
				|Operations.Group.Settlements.REPO.Payment.Far, Operations.Group.Settlements.REPO.ACI.Far, Operations.Group.Payments.IncomeReturn, Operations.Group.Payments.Coupon, Operations.Group.Payments.CouponReturn,
				|Operations.Group.Payments.Redemption, Operations.Group.Payments.PartialRedemption, Operations.Group.Payments.Dividend, Operations.Group.Payments.SharesIncome,
				|Operations.Group.Payments.Percents, Operations.Group.Payments.VariationMarginRevaluation, Operations.Group.Settlements.VariationMargin, Operations.Group.Settlements.Add.PayOff, Operations.Group.Charges.SE.Transaction,
				|Operations.Group.Payments.DepositMargin";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*"); 
	Запрос.УстановитьПараметр("ДатаИмпорта", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	
	Запрос.УстановитьПараметр("Deals", СтруктураВнешнихДанных.Deals);
	Запрос.УстановитьПараметр("Deals_Details", СтруктураВнешнихДанных.Deals_Details);
	Запрос.УстановитьПараметр("Deals_Incomplete", СтруктураВнешнихДанных.Deals_Incomplete);
	Запрос.УстановитьПараметр("Deals_Details_Incomplete", СтруктураВнешнихДанных.Deals_Details_Incomplete);
	Запрос.УстановитьПараметр("Deals_Operations_States", СтруктураВнешнихДанных.Deals_Operations_States);
	
	Запрос.УстановитьПараметр("Money_Operations", СтруктураВнешнихДанных.Money_Operations);
	Запрос.УстановитьПараметр("Money_Instructions", СтруктураВнешнихДанных.Money_Instructions);
	Запрос.УстановитьПараметр("Charges_Operations", СтруктураВнешнихДанных.Charges_Operations);
	Запрос.УстановитьПараметр("Depo_Operations", СтруктураВнешнихДанных.Depo_Operations);
		
	Запрос.УстановитьПараметр("ТипыКомиссии", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипыКомиссий, ",", Истина, Истина));
	Запрос.УстановитьПараметр("ТипыОплат", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипыОплат, ",", Истина, Истина));
	
	Запрос.Выполнить();
	
	ВыборкаОшибокОпределенияТипаОперации = МВТ.Таблицы["_ОшибкиОпределенияТипаОпераций"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибокОпределенияТипаОперации.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ВыборкаОшибокОпределенияТипаОперации.Ключ + "] в элементе [" + ВыборкаОшибокОпределенияТипаОперации.Таблица + "] присутствуют записи со значением атрибута Operation_Type = " + ВыборкаОшибокОпределенияТипаОперации.Operation_Type + ", для которого не описаны правила обработки.");	
	КонецЦикла;
	
	СтруктураВнешнихДанных = Неопределено;
		
	ИмпортируемыеДанные = Новый Структура;
	ИмпортируемыеДанные.Вставить("БиржевыеСделки", ОбработатьБиржевыеСделки_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ИсполненияБиржевыхСделок", ОбработатьИсполненияБиржевыхСделок_OTBR(МВТ, КонтролироватьНепроведенныеДокументы));
	
	ИмпортируемыеДанные.Вставить("БиржевыеСделкиРЕПО1", ОбработатьБиржевыеСделкиРЕПО_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("БиржевыеСделкиРЕПО2", ОбработатьБиржевыеСделкиРЕПО2_OTBR(МВТ, КонтролироватьНепроведенныеДокументы));
	
	ИмпортируемыеДанные.Вставить("СделкиСВалютой", ОбработатьСделкиСВалютой_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ПереводыДенежныхСредств", ОбработатьПереводыДенежныхСредств_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("НачисленияКомиссии", ОбработатьНачисленияКомиссии_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ОплатыКомиссии", ОбработатьОплатыКомиссий_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("ОплатыВнебиржевыхСделок", ОбработатьОплатыВнебиржевыхСделок_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ОплатыБиржевыхСделок", ОбработатьОплатыБиржевыхСделокСВалютой_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("ОплатыПоПогашениям", ОбработатьОплатыПоПогашениям_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ОплатыПоВозвратуКупона", ОбработатьОплатыПоВозвратуКупона_OTBR(МВТ));

	ИмпортируемыеДанные.Вставить("ВариационнаяМаржа", ОбработатьВариационнуюМаржу_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ВнебиржевыеСделки", ОбработатьВнебиржевыеСделки_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("СделкиСПФИ", ОбработатьСделкиСПФИ_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("МаржаСПФИ", ОбработатьМаржуСПФИ_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("ВнебиржевыеСделкиРЕПО", ОбработатьВнебиржевыеСделкиРЕПО_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("ИзмененияСделок", ОбработатьИзмененияСделок_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ИзмененияСделокРЕПО2", ОбработатьИзмененияСделокРЕПО2_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("ПоставкиЦенныхБумаг", ОбработатьПоставкиЦенныхБумаг_OTBR(МВТ));
	ИмпортируемыеДанные.Вставить("ОтменыСделок", ОбработатьОтменыСделок_OTBR(МВТ));
	
	ИмпортируемыеДанные.Вставить("СписанияЦенныхБумаг", ОбработатьСписанияЦенныхБумаг_OTBR(МВТ));
	
	Если ДанныеСФормы = Неопределено Тогда
		
		СообщениеОбИсполнениях = "";
		
		ВыборкаИсполнений = МВТ.Таблицы["_НепроведенныеИсполнения"].ПолучитьДанные().Выбрать();
		
		Пока ВыборкаИсполнений.Следующий() Цикл
			СообщениеОбИсполнениях = СообщениеОбИсполнениях + Символы.ПС + "Дата [" + Формат(ВыборкаИсполнений.ПроверяемаяДата, "ДФ=dd.MM.yyyy") + "] " + ВыборкаИсполнений.СчетДоверительногоУправления + " [" + ВыборкаИсполнений.Количество + "] шт.";	
		КонецЦикла;

		Если СообщениеОбИсполнениях <> "" Тогда
			СообщениеОбИсполнениях = Символы.ПС + "Исполнения обязательств по сделкам:" + СообщениеОбИсполнениях;
		КонецЕсли;
		
		СообщениеОСделкахРепо = "";
		
		ВыборкаВторыхЧастей = МВТ.Таблицы["_НепроведенныеВторыеЧасти"].ПолучитьДанные().Выбрать();
		
		Пока ВыборкаВторыхЧастей.Следующий() Цикл
			СообщениеОСделкахРепо = СообщениеОСделкахРепо + Символы.ПС + "Дата [" + Формат(ВыборкаВторыхЧастей.ПроверяемаяДата, "ДФ=dd.MM.yyyy") + "] " + ВыборкаВторыхЧастей.СчетДоверительногоУправления + " [" + ВыборкаВторыхЧастей.Количество + "] шт.";	
		КонецЦикла;

		Если СообщениеОСделкахРепо <> "" Тогда
			СообщениеОСделкахРепо = Символы.ПС + "Вторые части сделок репо:" + СообщениеОСделкахРепо;
		КонецЕсли;
		
		Если СообщениеОбИсполнениях <> "" Или СообщениеОСделкахРепо <> "" Тогда
			
			ТекстСообщения = "При импорте операций брокера обнаружены непроведенные документы:" + ?(СообщениеОбИсполнениях <> "", СообщениеОбИсполнениях, "") + ?(СообщениеОСделкахРепо <> "", СообщениеОСделкахРепо, ""); 
			СформироватьОповещение("Импорт операции БК Регион. Уведомление о непроведенных документах.", ТекстСообщения);
						
		КонецЕсли;
			
	КонецЕсли;
				
	Возврат ИмпортируемыеДанные;
	
КонецФункции

#Область Сделки_РЕПО_М

Функция ИмпортироватьТаблицуСделокРЕПО_М(ФайлыИмпорта) Экспорт 
	
	ПараметрыПолей = ПолучитьПараметрыПолейФайлаСделокРЕПО_М();
	
	ТаблицаСделокРЕПО_М = Новый ТаблицаЗначений;
	
	Для каждого Поле Из ПараметрыПолей Цикл
		ТаблицаСделокРЕПО_М.Колонки.Добавить(Поле.Ключ, Поле.Значение.Тип);
	КонецЦикла; 
	
	ИмяФайлаДанныхНаСервере = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".xlsx";
	
	Для каждого СтрокаФайловИмпорта Из ФайлыИмпорта Цикл
		
		СтрокаФайловИмпорта.ДанныеФайла.Записать(ИмяФайлаДанныхНаСервере);
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(ИмяФайлаДанныхНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		ПерваяЧастьЗагружена = Ложь;
		ВтораяЧастьЗагружена = Ложь;
		
		Для НомерСтроки = 14 По ТабличныйДокумент.ВысотаТаблицы Цикл
		
			ЗаголовокРаздела = ТабличныйДокумент.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
			
			ЭтоСделки = ЗаголовокРаздела = "Сделки с ценными бумагами по счету клиента за отчетный период:";
			ЭтоНезавершенныеСделки = ЗаголовокРаздела = "Незавершенные сделки с ценными бумагами по счету клиента за отчетный период:";
			
			Если ЭтоСделки Или ЭтоНезавершенныеСделки Тогда
				НомерСтроки = НомерСтроки + 4;
			КонецЕсли;
			
			МестоЗаключенияСделки = ТабличныйДокумент.Область(НомерСтроки, ПараметрыПолей["МестоЗаключенияСделки"].Колонка, НомерСтроки, ПараметрыПолей["МестоЗаключенияСделки"].Колонка).Текст;
			//ЧастьСделкиРЕПО = ТабличныйДокумент.Область(НомерСтроки, ПараметрыПолей["ЧастьСделкиРЕПО"].Колонка, НомерСтроки, ПараметрыПолей["ЧастьСделкиРЕПО"].Колонка).Текст;
			Если МестоЗаключенияСделки = "ММВБ / RPMO: РЕПО-М" Тогда //И Не СтрНачинаетсяС(ЧастьСделкиРЕПО, "Закрытие") Тогда
				
				СтруктураПолей = Новый Структура;
				
				Для каждого Поле Из ПараметрыПолей Цикл
				
					Значение = ТабличныйДокумент.Область(НомерСтроки, Поле.Значение.Колонка, НомерСтроки, Поле.Значение.Колонка).Текст;
					
					Если Поле.Ключ = "РегНомер" Тогда
						Значение = ПолучитьКодЦеннойБумагиИзСтроки(Значение);
					ИначеЕсли Поле.Ключ = "ЧастьСделкиРЕПО" Тогда 
						Если СтрНачинаетсяС(Значение, "Закрытие") Тогда
						    Значение = 2;
						Иначе
							Значение = 1;						
						КонецЕсли; 
					ИначеЕсли Поле.Ключ = "НомерСделки" Тогда
						НачалоНомера = СтрНайти(Значение, "Бирж. № ") + 8;
						Значение = Сред(Значение, НачалоНомера);
					ИначеЕсли Поле.Ключ = "ИНН" Тогда
						НачалоИНН = СтрНайти(Значение, " ", НаправлениеПоиска.СКонца) + 1;
						Значение = Сред(Значение, НачалоИНН);
					КонецЕсли; 
					
					СтруктураПолей.Вставить(Поле.Ключ, Поле.Значение.Тип.ПривестиЗначение(Значение));
					
				КонецЦикла; 
				
				СтруктураПолей.Вставить("НезавершенныеСделки", ЭтоНезавершенныеСделки);
				
				ЗаполнитьЗначенияСвойств(ТаблицаСделокРЕПО_М.Добавить(), СтруктураПолей) 
								
			КонецЕсли; 
		
		КонецЦикла; 
		
		УдалитьФайлы(ИмяФайлаДанныхНаСервере);
	
	КонецЦикла; 
	
	ЗаполнитьРаскрытыхКонтрагентовВТаблицеСделокРЕПО_М(ТаблицаСделокРЕПО_М);
	
	Возврат ТаблицаСделокРЕПО_М;
	
КонецФункции

Функция ПолучитьКодЦеннойБумагиИзСтроки(Строка)

	Код = "";
	
	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить("ГОС.РЕГ. ");
	Идентификаторы.Добавить("ISIN ");
	
	Для каждого Идентификатор Из Идентификаторы Цикл
	
		ПозицияИдентификатора = СтрНайти(ВРег(Строка), Идентификатор);
		Если ПозицияИдентификатора > 0 Тогда
			
			Код = Сред(Строка, ПозицияИдентификатора + СтрДлина(Идентификатор));
			Прервать;
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Если Код = "" Тогда
		Код = Строка;
	КонецЕсли; 
	
	Если СтрНачинаетсяС(ВРег(Код), ВРег("не предусмотрен")) Тогда
		
		Код = ВРег("не предусмотрен");
		
	КонецЕсли; 
		
	Возврат Код;

КонецФункции

Функция ПолучитьПараметрыПолейФайлаСделокРЕПО_М()
	
	ПараметрыПолей = Новый Соответствие;
	
	ПараметрыПолей.Вставить("ДатаВремяСделки", 			Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Дата"), 1));
	ПараметрыПолей.Вставить("МестоЗаключенияСделки", 	Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)), 9));
	ПараметрыПолей.Вставить("РегНомер", 				Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)), 14));
	ПараметрыПолей.Вставить("ЧастьСделкиРЕПО", 			Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1)), 20));
	ПараметрыПолей.Вставить("НомерСделки", 				Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25)), 20));
	ПараметрыПолей.Вставить("Дисконт", 					Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 6)), 53));
	ПараметрыПолей.Вставить("ИНН", 						Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)), 54));
	ПараметрыПолей.Вставить("НезавершенныеСделки", 		Новый Структура("Тип, Колонка", Новый ОписаниеТипов("Булево"), 0));
		
	Возврат ПараметрыПолей;

КонецФункции

Процедура ЗаполнитьРаскрытыхКонтрагентовВТаблицеСделокРЕПО_М(ТаблицаСделокРЕПО_М)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСделокРЕПО_М, "_ТаблицаСделокРЕПО_М", Запрос.МенеджерВременныхТаблиц, Истина);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаСделокРЕПО_М.ДатаВремяСделки КАК ДатаВремяСделки,
		|	_ТаблицаСделокРЕПО_М.ИНН КАК ИНН
		|ПОМЕСТИТЬ _ТаблицаИНН
		|ИЗ
		|	_ТаблицаСделокРЕПО_М КАК _ТаблицаСделокРЕПО_М
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ДатаВремяСделки КАК ДатаВремяСделки,
		|	ВложенныйЗапрос.ИНН КАК ИНН,
		|	_ТаблицаСделокРЕПО_М.МестоЗаключенияСделки КАК МестоЗаключенияСделки,
		|	_ТаблицаСделокРЕПО_М.РегНомер КАК РегНомер,
		|	_ТаблицаСделокРЕПО_М.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_ТаблицаСделокРЕПО_М.НомерСделки КАК НомерСделки,
		|	_ТаблицаСделокРЕПО_М.Дисконт КАК Дисконт,
		|	_ТаблицаСделокРЕПО_М.НезавершенныеСделки КАК НезавершенныеСделки,
		|	РеквизитыЮридическихЛиц.ЮрФизЛицо КАК РаскрытыйКонтрагент
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ТаблицаИНН.ДатаВремяСделки КАК ДатаВремяСделки,
		|		_ТаблицаИНН.ИНН КАК ИНН,
		|		МАКСИМУМ(РеквизитыЮридическихЛиц.Период) КАК Период
		|	ИЗ
		|		_ТаблицаИНН КАК _ТаблицаИНН
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|			ПО _ТаблицаИНН.ИНН = РеквизитыЮридическихЛиц.ИНН
		|				И _ТаблицаИНН.ДатаВремяСделки >= РеквизитыЮридическихЛиц.Период
		|				И (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|				И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ТаблицаИНН.ДатаВремяСделки,
		|		_ТаблицаИНН.ИНН) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|		ПО ВложенныйЗапрос.Период = РеквизитыЮридическихЛиц.Период
		|			И ВложенныйЗапрос.ИНН = РеквизитыЮридическихЛиц.ИНН
		|			И (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаСделокРЕПО_М КАК _ТаблицаСделокРЕПО_М
		|		ПО ВложенныйЗапрос.ДатаВремяСделки = _ТаблицаСделокРЕПО_М.ДатаВремяСделки
		|			И ВложенныйЗапрос.ИНН = _ТаблицаСделокРЕПО_М.ИНН";
	
	ТаблицаСделокРЕПО_М = Запрос.Выполнить().Выгрузить();

КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO(ОбъектXDTO, СтруктураДанных, ИмяФайла, ИспользуютсяСоставныеКодыУБрокера, ИмяТаблицы = "")
	
	ДанныеПервогоУзла = Неопределено;
	
	Для Каждого СвойствоОбъектаXDTO Из ОбъектXDTO.Свойства() Цикл
		
		Если ИмяТаблицы = "" И ДанныеПервогоУзла = Неопределено Тогда
			
#Область Данные_первого_узла	
	        ЕстьОшибки = Ложь;
			ДанныеПервогоУзла = Новый Структура("Account_Number, Date_From, Date_To, Recipient, Sender, Sender_System");
			
			ЗаполнитьЗначенияСвойств(ДанныеПервогоУзла, ОбъектXDTO);
			
			Если Не ЗначениеЗаполнено(ДанныеПервогоУзла.Account_Number)  Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] не заполнено значение атрибута первого узла [Account_Number]!");	
				ЕстьОшибки = Истина;
			КонецЕсли;
				
			Если ДанныеПервогоУзла.Date_From <> Формат(ЭтотОбъект.ДатаИмпорта, "ДФ=""гггг-ММ-дд""") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Date_From = " + ДанныеПервогоУзла.Date_From + "] не соответствет дате импорта!");
				ЕстьОшибки = Истина;
			КонецЕсли;
				
			Если ДанныеПервогоУзла.Date_To <> Формат(ЭтотОбъект.ДатаИмпорта, "ДФ=""гггг-ММ-дд""") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Date_To = " + ДанныеПервогоУзла.Date_To + "] не соответствет дате импорта!");
				ЕстьОшибки = Истина;
			КонецЕсли;
					
			Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") И Не (ДанныеПервогоУзла.Recipient = "OTBR.RegionAM" Или ДанныеПервогоУзла.Recipient = "OTBR.RegionAM.PIF")  
				Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") И Не (ДанныеПервогоУзла.Recipient = "OTBR.RegionTR" Или ДанныеПервогоУзла.Recipient = "OTBR.RegionTR.PIF") 
				Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") И Не (ДанныеПервогоУзла.Recipient = "OTBR.RegionPI" Или ДанныеПервогоУзла.Recipient = "OTBR.RegionPI.PIF") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Recipient = " + ДанныеПервогоУзла.Recipient + "] не соответствет организации [" + ЭтотОбъект.Организация + "]!");	
				ЕстьОшибки = Истина;
			КонецЕсли;
					
			Если ДанныеПервогоУзла.Sender <> "Region.BC" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Sender = " + ДанныеПервогоУзла.Sender + "] не соответствет формату обмена данных!");
				ЕстьОшибки = Истина;
			КонецЕсли;
						
			Если ДанныеПервогоУзла.Sender_System <> "MX1" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле импорта [" + ИмяФайла + "] значение атрибута первого узла [Sender_System = " + ДанныеПервогоУзла.Sender_System + "] не соответствет формату обмена данных!");
				ЕстьОшибки = Истина;
			КонецЕсли;
			
			НоваяСтрока                          = СтруктураДанных.ДанныеПервыхУзлов.Добавить();
			НоваяСтрока.Ключ                     = ИмяФайла;
			НоваяСтрока.ЗначенияАтрибутов        = ДанныеПервогоУзла;
			НоваяСтрока.ФайлСоответствуетФормату = Не ЕстьОшибки;
			
			Продолжить;
#КонецОбласти
	
		КонецЕсли;

		//Исключен из сверки блок с остатками. При импорте операции остатки не сверяются.
		Если СвойствоОбъектаXDTO.Имя = "Remains" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СвойствоОбъектаXDTO.Форма = ФормаXML.Элемент Тогда
			
			Если СвойствоОбъектаXDTO.ВерхняяГраница = 1 Тогда  //у cписка XDTO ВерхняяГраница = -1 
				ЗначениеСвойстваОбъектаXDTO = ОбъектXDTO.Получить(СвойствоОбъектаXDTO);
			Иначе
				ЗначениеСвойстваОбъектаXDTO = ОбъектXDTO.ПолучитьСписок(СвойствоОбъектаXDTO);
			КонецЕсли;
			
			Если СвойствоОбъектаXDTO.Имя = "Record" Тогда //Может состоять из списка, может состоять из атрибутов (если одна запись)
				
				Если СтруктураДанных.Свойство(ИмяТаблицы) Тогда
					ЗаполнитьТаблицуЗначенийДаннымиИзОбъектаXTDO(ЗначениеСвойстваОбъектаXDTO, СтруктураДанных[ИмяТаблицы], ИмяТаблицы, ИмяФайла, ИспользуютсяСоставныеКодыУБрокера);
				Иначе 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не настроена загрузка для элемента файла " + ИмяТаблицы + "");
				КонецЕсли;
			
				Продолжить;
			
			Иначе
				ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO(ЗначениеСвойстваОбъектаXDTO, СтруктураДанных, ИмяФайла, ИспользуютсяСоставныеКодыУБрокера, СвойствоОбъектаXDTO.Имя);
			КонецЕсли;
					
		КонецЕсли;
				
	КонецЦикла;
						
КонецПроцедуры

Функция ПолучитьСтруктуруДанных()
	
	СтруктураДанных = Новый Структура();
	
	НаименованиеТаблиц = "Deals, Deals_Details, Deals_Operations_States, Deals_Incomplete, Deals_Details_Incomplete,
						 |Money_Operations, Money_Instructions,
						 |Charges, Charges_Operations,
						 |Depo_Operations, Depo_Instructions, Depo_Instructions_Details,
						 |Accounts, Accounts_Divisions, Agreements,
						 |Currencies, Currencies_Pairs, Bonds, Shares, Bills, Derivatives, DRs, Funds,
						 |Firms, Persons, Enums_Values";
	
	Для Каждого ИмяТаблицы Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаименованиеТаблиц, ",", Истина, Истина) Цикл 
	
		Если ИмяТаблицы = "Deals" Или ИмяТаблицы = "Deals_Incomplete" Тогда //сделки
			
			ИменаПолей = "Record_UID, Market, Market_Board, Market_Number, Market_Order_Number, Is_Market_Maker, Date, Time, Operation_Type, Direction,
						 |Currency, Payment_Currency, Payment_Rate_Base, Is_Payment_Rate_Fixed, Is_Payment_Rate_Inverted, Payment_Rate, Payment_Date,
						 |Delivery_Date, Money_Storage_Place, Depo_Storage_Place, SE_Charge_Amount, PSA_Settlement_Type, Far_Execution_Date, Far_Interest_Rate,
						 |Is_Deal_Info, Deal_Info_Type, Reason_Type, Is_Cancelled, Date_Cancelled, Time_Cancelled, Order_Number, Order_Date, Parent_Order_Number,
						 |Parent_Order_Date, Near_Deal_Record_UID, Parent_Record_UID, Is_Not_Confirmed, Is_Outer_Broker_Execution, Partner_ID, External_Reference,
						 |SettleCode, SE_Charge_Date, Parent_External_Reference";			

		ИначеЕсли ИмяТаблицы = "Deals_Details" Или ИмяТаблицы = "Deals_Details_Incomplete" Тогда //детали сделок
			
			ИменаПолей = "Record_UID, Parent_Record_UID, Security_ID, Price, Price_Points, Volume, Amount, ACI_Amount, Margin_Amount, Payment_Amount,
						 |Payment_ACI_Amount, Payment_Margin_Amount, Far_Price, Far_Amount, Far_ACI_Amount, Account_Division_ID, Price_Percent";
			
		ИначеЕсли ИмяТаблицы = "Deals_Operations_States" Тогда //статусы сделок, исполнение
			
			ИменаПолей = "Record_UID, Date, Operation_Step, State, Market_Number";
			
		ИначеЕсли ИмяТаблицы = "Money_Operations" Тогда //неторговые операции с ДС
			
			ИменаПолей = "Record_UID, Date, Origin_Operation_Type, Direction, Client_ID, Inner_Account_Division_ID, Money_Storage_Place, Payment_Amount,
						 |Payment_Currency_Code, Deal_Record_UID, Charge_Record_UID, Security_ID, Volume, External_Reference, Market_Number, Is_Netted";
			
		ИначеЕсли ИмяТаблицы = "Money_Instructions" Тогда //неторговые операции с ДС
			
			ИменаПолей = "Record_UID, Date, Operation_Type, Transfer_Type, Amount, Currency_Code, Client_ID, Inner_Account_Division_ID,
						 |Money_Storage_Place, Partner_ID, Partner_Inner_Account_Division_ID, Partner_Money_Storage_Place, Order_Number,
						 |Order_Date, Reason_Type, Description, Deal_Record_UID, External_Reference, Market_Number";

		ИначеЕсли ИмяТаблицы = "Charges" Тогда //услуги
			
			ИменаПолей = "Record_UID, Date, Charge_Type, Period, Operation_Description";

		ИначеЕсли ИмяТаблицы = "Charges_Operations" Тогда //начисления комиссий
			
			ИменаПолей = "Record_UID, Date, Origin_Operation_Type, Payment_Amount, Payment_Currency_Code, Security_ID, Volume, Market, Invoice_Number,
						 |Charge_Record_UID, Deal_Record_UID, Inner_Account_Division_ID, Storage_Place, Market_Number";
			
		ИначеЕсли  ИмяТаблицы = "Depo_Operations" Тогда //операции по депозитарным счетам
			
			ИменаПолей = "Record_UID, Date, Origin_Operation_Type, Direction, Client_ID, Inner_Account_Division_ID, Depo_Storage_Place, Security_ID, Volume, Deal_Record_UID, Is_Netted, Market_Number";	
			
		ИначеЕсли ИмяТаблицы = "Depo_Instructions" Тогда //
			
			ИменаПолей = "Record_UID, Date, Operation_Type, Transfer_Type, Client_ID, Inner_Account_Division_ID, Depo_Storage_Place, Partner_ID,
						 |Partner_Inner_Account_Division_ID, Partner_Depo_Storage_Place, Order_Number, Order_Date, Reason_Type, Description, External_Reference";
			
		ИначеЕсли ИмяТаблицы = "Depo_Instructions_Details" Тогда
			
			ИменаПолей = "Record_UID, Parent_Record_UID, Security_ID, Volume";		
				
		ИначеЕсли ИмяТаблицы = "Accounts" Тогда //счета
			
			ИменаПолей = "ID, Firm_ID, Partner_ID, Agreement_ID, Number, Type, Sub_Type";
			
		ИначеЕсли ИмяТаблицы = "Accounts_Divisions" Тогда //портфели
			
			ИменаПолей = "ID, Account_ID, Number, Секция";
			
		ИначеЕсли ИмяТаблицы = "Agreements" Тогда //договоры
			
			ИменаПолей = "ID, Number, Type, Date_Signed";
			
		ИначеЕсли ИмяТаблицы = "Currencies" Тогда //валюты
			
			ИменаПолей = "ID, ISO_Code";
			
		ИначеЕсли ИмяТаблицы = "Currencies_Pairs" Тогда //валютные пары
			
			ИменаПолей = "ID, Code";
	
		ИначеЕсли ИмяТаблицы = "Bonds" Тогда  //облигации
			
			ИменаПолей = "ID, Issuer_ID, ISIN, CFI, Register_Number, Register_Date, Face_Value, Currency, Code_MOEX, Face_Value_Current";
			
		ИначеЕсли ИмяТаблицы = "Shares" Тогда //акции
			
			ИменаПолей = "ID, Issuer_ID, Type, ISIN, CFI, Register_Number, Register_Date, Code_MOEX";
			
		ИначеЕсли ИмяТаблицы = "Bills" Тогда //векселя
			
			ИменаПолей = "ID, Issuer_ID, Type, Payment_Type, Number_Series, Number_Blank, Number, Face_Value, Currency, Issue_Date, Interest_Rate,
						 |Retirement_Type, Retirement_Date_From, Retirement_Date_To, Retirement_After_Days";
			
		ИначеЕсли ИмяТаблицы = "Derivatives" Тогда //фьючерсы, опционы
			
			ИменаПолей = "ID, Name_Ru, Name_En, Type, Trading_Type, Settlement_Type, Currency, Kind_Type, Execution_Type, Date_Execution, 
						 |Base_Asset_Type, Base_Asset_Issuer_ID, Base_Asset_Security_ID, Base_Asset_Volume, Strike_Price, Strike_Currency,
						 |Is_Futures_Style, Description, Code_FORTS, Code_FORTS_Short";
			
		ИначеЕсли ИмяТаблицы = "DRs" Тогда //депозитарные расписки
			
			ИменаПолей = "ID, Share_ID, Issuer_ID, Type, ISIN, CFI, CUSIP, Register_Number, Register_Date, Share_Type, Level_Type, Bank_Custodian_ID,
						 |Factor_DRs, Factor_Shares, Code_MOEX";
			
		ИначеЕсли ИмяТаблицы = "Funds" Тогда //паи
			
			ИменаПолей = "ID, Issuer_ID, Type, Asset_Type, ISIN, CFI, Name_Ru, Name_En, Register_Number, Register_Date, Code_MOEX";
			
		ИначеЕсли ИмяТаблицы = "Firms" Тогда //юр.лица
			
			ИменаПолей = "ID, Name_Official_Ru, Name_Official_En, INN, Legal_Form_Type";
			
		ИначеЕсли ИмяТаблицы = "Persons" Тогда
			
			ИменаПолей = "ID, Name_Official_Ru, Name_Official_En";
			
		ИначеЕсли ИмяТаблицы = "Enums_Values" Тогда //описание типов
			
			ИменаПолей = "ID, UID, Enum_UID, Name_Ru, Name_En";
						
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для таблицы [" + ИмяТаблицы + "] не описаны поля");
			Продолжить;
		КонецЕсли;
		
		ТаблицаПриемникДанных = Новый ТаблицаЗначений;
		МассивИменПолей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаПолей, ",", Истина, Истина);
		
		Для Каждого ИмяПоля Из МассивИменПолей Цикл
			Если (СтрНайти(ИмяПоля, "Amount") > 0) Или (СтрНайти(ИмяПоля, "Price") > 0) Или ИмяПоля = "Payment_Rate" Или ИмяПоля = "Volume" Или ИмяПоля = "Face_Value_Current" Тогда
				ТаблицаПриемникДанных.Колонки.Добавить(ИмяПоля, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(27, 12)));
			ИначеЕсли СтрНайти(ИмяПоля, "Date") > 0 Или СтрНайти(ИмяПоля, "Time") > 0 Тогда
				ТаблицаПриемникДанных.Колонки.Добавить(ИмяПоля, Новый ОписаниеТипов("Дата"));	
			Иначе
				ТаблицаПриемникДанных.Колонки.Добавить(ИмяПоля, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаПриемникДанных.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
		СтруктураДанных.Вставить(ИмяТаблицы, ТаблицаПриемникДанных);
		
	КонецЦикла;
	
	ДанныеПервыхУзлов = Новый ТаблицаЗначений;
	ДанныеПервыхУзлов.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ДанныеПервыхУзлов.Колонки.Добавить("ЗначенияАтрибутов");
	ДанныеПервыхУзлов.Колонки.Добавить("ФайлСоответствуетФормату", Новый ОписаниеТипов("Булево"));
	
	СтруктураДанных.Вставить("ДанныеПервыхУзлов", ДанныеПервыхУзлов);
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ЗаполнитьТаблицуЗначенийДаннымиИзОбъектаXTDO(ЗначниеОбъектаXDTO, ТаблицаПриемникДанных, ИмяТаблицы, ИмяФайла, ИспользуютсяСоставныеКодыУБрокера)
	
	ПоляДляКонвертацииЗначений = "";
	
	Для Каждого КолонкаТаблицы Из ТаблицаПриемникДанных.Колонки Цикл
		
		Если СтрНайти(КолонкаТаблицы.Имя, "Time") > 0 Или СтрНайти(КолонкаТаблицы.Имя, "Date") > 0 Тогда
			ПоляДляКонвертацииЗначений = ?(ПоляДляКонвертацииЗначений = "", "", ПоляДляКонвертацииЗначений + ",") + КолонкаТаблицы.Имя;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТипЗнч(ЗначниеОбъектаXDTO) = Тип("ОбъектXDTO") Тогда
						
		НоваяСтрокаТаблицы = ТаблицаПриемникДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, ЗначниеОбъектаXDTO);
		НоваяСтрокаТаблицы.Ключ = ИмяФайла;
		
		Если ИмяТаблицы = "Accounts_Divisions" Тогда	
			ЗаполнитьКодБрокераИСекцию(НоваяСтрокаТаблицы, ИспользуютсяСоставныеКодыУБрокера); 	
		КонецЕсли;
		
		Если ПоляДляКонвертацииЗначений <> "" Тогда 
			КонвертироватьЗначенияПолей(НоваяСтрокаТаблицы, ЗначниеОбъектаXDTO, ПоляДляКонвертацииЗначений);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЗначниеОбъектаXDTO) = Тип("СписокXDTO") Тогда
		
		Для Каждого СтрокаСписка Из ЗначниеОбъектаXDTO Цикл
			
			НоваяСтрокаТаблицы = ТаблицаПриемникДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаСписка);
			НоваяСтрокаТаблицы.Ключ = ИмяФайла;
			
			Если ИмяТаблицы = "Accounts_Divisions" Тогда	
				ЗаполнитьКодБрокераИСекцию(НоваяСтрокаТаблицы, ИспользуютсяСоставныеКодыУБрокера);	
			КонецЕсли;

			Если ПоляДляКонвертацииЗначений <> "" Тогда 
				КонвертироватьЗначенияПолей(НоваяСтрокаТаблицы, СтрокаСписка, ПоляДляКонвертацииЗначений);
			КонецЕсли;
			
		КонецЦикла;
			
	КонецЕсли;
				
КонецПроцедуры

Процедура ЗаполнитьКодБрокераИСекцию(СтрокаТаблицы, ИспользуютсяСоставныеКодыУБрокера)
	
	Номер =	СтрокаТаблицы.Number;	
	
	Код = "";
	Секция = "";
		
	Если СтрНайти(Номер, "_VN") > 0 Тогда
		Код = СтрЗаменить(Номер, "_VN", "");
		Секция = "Внебиржевая";
	ИначеЕсли СтрНайти(Номер, "_OTC") > 0 Тогда
		Код = СтрЗаменить(Номер, "_OTC", "");
		Секция = "Внебиржевая";
	ИначеЕсли СтрНайти(Номер, "_FX") > 0 Тогда
		Код = СтрЗаменить(Номер, "_FX", "");
		Секция = "Валютная";
	ИначеЕсли СтрНайти(Номер, "_V") > 0 Тогда
		Код = СтрЗаменить(Номер, "_V", "");
		Секция = "Валютная";	
	ИначеЕсли СтрНайти(Номер, "V") > 0 Тогда
		Код = СтрЗаменить(Номер, "V", "");
		Секция = "Валютная";
	ИначеЕсли СтрНайти(Номер, "_R") > 0 Тогда 
		Код = СтрЗаменить(Номер, "_R", "");
		Секция = "Репо";
	ИначеЕсли СтрНайти(Номер, "_FO") > 0 Тогда
		Код = СтрЗаменить(Номер, "_FO", "");
		Секция = "Фортс";
	ИначеЕсли СтрНайти(Номер, "_F") > 0 Тогда
		Код = СтрЗаменить(Номер, "_F", "");
		Секция = "Фортс";
	ИначеЕсли СтрНайти(Номер, "_SPFI") > 0 Тогда
		Код = СтрЗаменить(Номер, "_SPFI", "");
		Секция = "Деривативы";
	Иначе
		
		Если ИспользуютсяСоставныеКодыУБрокера И СтрНайти(Номер, "_") > 0 Тогда
			Код = Лев(Номер, СтрНайти(Номер, "_") - 1);	
		Иначе
			Код = Номер;
		КонецЕсли;
		
		Секция = "Основная";
		
	КонецЕсли;

	СтрокаТаблицы.Number = Код;
	СтрокаТаблицы.Секция = Секция;
	
КонецПроцедуры

Процедура КонвертироватьЗначенияПолей(СтрокаПриемник, СтрокаИсточник, ПоляДляКонвертацииЗначений)
	
	СтруктураЗначений = Новый Структура(ПоляДляКонвертацииЗначений);
	
	ЗаполнитьЗначенияСвойств(СтруктураЗначений, СтрокаИсточник);
	
	Для Каждого ЭлементСтруктурыЗначений Из СтруктураЗначений Цикл
		
		Если ЗначениеЗаполнено(ЭлементСтруктурыЗначений.Значение) Тогда
			
			Если СтрНайти(ЭлементСтруктурыЗначений.Ключ, "Date") > 0 Тогда
				СтрокаПриемник[ЭлементСтруктурыЗначений.Ключ] = Дата(СтрЗаменить(ЭлементСтруктурыЗначений.Значение, "-", ""));
			ИначеЕсли СтрНайти(ЭлементСтруктурыЗначений.Ключ, "Time") > 0 Тогда
				СтрокаПриемник[ЭлементСтруктурыЗначений.Ключ] = Дата("00010101" + СтрЗаменить(ЭлементСтруктурыЗначений.Значение, ":", ""));
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьБиржевыеСделки_OTBR(МВТ)
	
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Сделка, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_Deals_With_Details.Date КАК ДатаСделки,
	    |	_Deals_With_Details.Time КАК ВремяСделки,
	    |	_Deals_With_Details.Market_Number КАК НомерСделки,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Direction = ""-1""
	    |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	    |		КОГДА _Deals_With_Details.Direction = ""1""
	    |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	    |		ИНАЧЕ """"
	    |	КОНЕЦ КАК ВидСделки,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Date <> _Deals_With_Details.Payment_Date
	    |				ИЛИ _Deals_With_Details.Date <> _Deals_With_Details.Delivery_Date
	    |			ТОГДА ИСТИНА
	    |		ИНАЧЕ ЛОЖЬ
	    |	КОНЕЦ КАК ОтложенноеИсполнение,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
	    |			ТОГДА ИСТИНА
	    |		ИНАЧЕ ЛОЖЬ
	    |	КОНЕЦ КАК РаздельноеИсполнение,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Payment_Date = _Deals_With_Details.Date
	    |			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	    |		ИНАЧЕ _Deals_With_Details.Payment_Date
	    |	КОНЕЦ КАК ДатаОплаты,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Delivery_Date = _Deals_With_Details.Date
	    |			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	    |		ИНАЧЕ _Deals_With_Details.Delivery_Date
	    |	КОНЕЦ КАК ДатаПоставки,
	    |	_Deals_With_Details.Security_ID КАК Security_ID,
	    |	_Deals_With_Details.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_Deals_With_Details.Рынок КАК Рынок,
	    |	_Deals_With_Details.ВалютаСделки КАК ВалютаСделки,
	    |	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
	    |	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_Deals_With_Details.Partner_ID КАК Partner_ID,
	    |	ВЫБОР
	    |		КОГДА _РежимыБиржевыхТоргов.РежимПереговорныхСделок
	    |			ТОГДА ЕСТЬNULL(_Deals_With_Details.КонтрагентСсылка, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
	    |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
	    |	КОНЕЦ КАК Контрагент,
	    |	_РежимыБиржевыхТоргов.Ссылка КАК РежимБиржевыхТоргов,
	    |	ЕСТЬNULL(_РежимыБиржевыхТоргов.РежимПереговорныхСделок, ЛОЖЬ) КАК РежимПереговорныхСделок,
	    |	ЕСТЬNULL(_РежимыБиржевыхТоргов.ВыкупЭмитентом, ЛОЖЬ) КАК ВыкупЭмитентом,
	    |	ЕСТЬNULL(_РежимыБиржевыхТоргов.ПервичноеРазмещение, ЛОЖЬ) КАК ПервичноеРазмещение,
	    |	ЕСТЬNULL(_РежимыБиржевыхТоргов.РепоСЦК, ЛОЖЬ) КАК РепоСЦК,
	    |	_Deals_With_Details.Market_Board КАК Market_Board,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Market_Board = ""SMAL""
	    |			ТОГДА ИСТИНА
	    |		ИНАЧЕ ЛОЖЬ
	    |	КОНЕЦ КАК НеполныеЛоты,
	    |	_Deals_With_Details.SettleCode КАК SettleCode,
	    |	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
	    |	_Deals_With_Details.Depo_Storage_Place КАК Depo_Storage_Place,
	    |	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Depo_Storage_Place = ""FORTS""
	    |			ТОГДА ЗНАЧЕНИЕ(Справочник.ДепозитарныеСчета.СчетУчетаДеривативов)
	    |		ИНАЧЕ _ДепозитарныеСчета.Счет
	    |	КОНЕЦ КАК ДепозитарныйСчет,
	    |	_Deals_With_Details.Price КАК Цена,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	    |			ТОГДА _Deals_With_Details.Price_Percent
	    |		ИНАЧЕ 0
	    |	КОНЕЦ КАК ЦенаПроцент,
	    |	_Deals_With_Details.Volume КАК Количество,
	    |	_Deals_With_Details.Amount КАК Сумма,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	    |			ТОГДА _Deals_With_Details.ACI_Amount
	    |		ИНАЧЕ 0
	    |	КОНЕЦ КАК СуммаКупона,
	    |	_Deals_With_Details.SE_Charge_Date КАК ДатаОплатыТорговойКомиссии,
	    |	_Deals_With_Details.SE_Charge_Amount КАК СуммаТорговойКомиссии,
	    |	ЕСТЬNULL(ВалютыТорговойКомиссии.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаТорговойКомиссии,
	    |	ВЫБОР
	    |		КОГДА _Deals_With_Details.Market <> ""OTC""
	    |				И _Deals_With_Details.Date <> _Deals_With_Details.SE_Charge_Date
	    |				И _Deals_With_Details.SE_Charge_Date <> ДАТАВРЕМЯ(1, 1, 1)
	    |			ТОГДА ИСТИНА
	    |		ИНАЧЕ ЛОЖЬ
	    |	КОНЕЦ КАК ОтложеннаяОплатаТорговойКомиссии,
	    |	ВЫБОР
	    |		КОГДА &ЭтоРэм_Траст
	    |				И (ЕСТЬNULL(_РежимыБиржевыхТоргов.ПервичноеРазмещение, ЛОЖЬ) = ИСТИНА
	    |					ИЛИ ЕСТЬNULL(_РежимыБиржевыхТоргов.ВыкупЭмитентом, ЛОЖЬ) = ИСТИНА
	    |					ИЛИ ЕСТЬNULL(_РежимыБиржевыхТоргов.Аукцион, ЛОЖЬ) = ИСТИНА)
	    |				И ЕСТЬNULL(_РежимыБиржевыхТоргов.флагРепо, ЛОЖЬ) = ЛОЖЬ
	    |				И _Deals_With_Details.Date >= ДАТАВРЕМЯ(2021, 4, 1)
	    |				И (_Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	    |					ИЛИ _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Акции
	    |					ИЛИ _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки)
	    |			ТОГДА _Deals_With_Details.ЭмитентЮрФизЛицо
	    |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |	КОНЕЦ КАК РаскрытыйКонтрагент
	    |ПОМЕСТИТЬ _СделкиВнешниеДанные
	    |ИЗ
	    |	_Deals_With_Details КАК _Deals_With_Details
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _Money_Operations КАК _Money_Operations
	    |			ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыТорговойКомиссии
	    |			ПО _Money_Operations.Payment_Currency_Code = ВалютыТорговойКомиссии.ISO_Code
	    |		ПО _Deals_With_Details.Record_UID = _Money_Operations.Deal_Record_UID
	    |			И _Deals_With_Details.SE_Charge_Amount = _Money_Operations.Payment_Amount
	    |			И (_Money_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.Add.SE.Fee"")
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыБиржевыхТоргов КАК _РежимыБиржевыхТоргов
	    |		ПО _Deals_With_Details.Market_Board = _РежимыБиржевыхТоргов.Код
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
	    |		ПО _Deals_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
	    |		ПО _Deals_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
	    |			И _Deals_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
	    |ГДЕ
	    |	_Deals_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"", ""Operations.Group.Deals.IPO"")
	    |	И _Deals_With_Details.Is_Deal_Info = ""0""
	    |	И _Deals_With_Details.Market В (""MICEX"", ""FORTS"")
	    |	И _Deals_With_Details.Date = &НачалоПериода
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВЫБОР
	    |		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	    |			ТОГДА ""Покупка""
	    |		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	    |			ТОГДА ""Продажа""
	    |		ИНАЧЕ """"
	    |	КОНЕЦ + ""/"" + Сделка.НомерСделки КАК Ключ,
	    |	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, НЕОПРЕДЕЛЕНО) КАК РаскрытыйКонтрагент,
	    |	&Звездочка КАК Звездочка
	    |ИЗ
	    |	Документ.Сделка КАК Сделка
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	    |		ПО Сделка.Ссылка = ЗначенияДополнительныхСведений.Объект
	    |			И (ЗначенияДополнительныхСведений.Свойство = &РаскрытыйКонтрагент)
	    |			И (&ЭтоРэм_Траст)
	    |ГДЕ
	    |	Сделка.Организация = &Организация
	    |	И НЕ Сделка.ПометкаУдаления
	    |	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	    |	И Сделка.Брокер = &Брокер
	    |	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
	    |	И НЕ Сделка.РежимБиржевыхТоргов.РежимВнебиржевыхСделок
	    |	И НЕ Сделка.СчетДоверительногоУправления В
	    |				(ВЫБРАТЬ
	    |					_СчетаИсключеныИзЗагрузки.Счет
	    |				ИЗ
	    |					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";

#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*"); 

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("ЭтоРэм_Траст", (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")));
	Запрос.УстановитьПараметр("РаскрытыйКонтрагент", ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "_РаскрытыйКонтрагент"));
	
	СделкиДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_СделкиВнешниеДанные"].ПолучитьДанные().Выбрать();
						
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;
						
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Строка(Выборка.ВидСделки) + "/" + Выборка.НомерСделки;
		НоваяСтрокаОперации.Описание     = "Бирж. сделка № " + Выборка.НомерСделки + " [" + Строка(Выборка.ВидСделки) + "]";
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = Выборка.ДатаСделки + (Выборка.ВремяСделки - Дата(1, 1, 1));
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.ВидСделки                    = Выборка.ВидСделки;
		РеквизитыШапки.Брокер                       = Брокер;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;	
		РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.ВалютаСделки                 = Выборка.ВалютаСделки;
		РеквизитыШапки.НомерСделки                  = Выборка.НомерСделки;
		РеквизитыШапки.ВремяСделки                  = Выборка.ВремяСделки;
		РеквизитыШапки.КодРасчетовНаБирже           = Выборка.SettleCode;
		РеквизитыШапки.НеполныеЛоты                 = Выборка.НеполныеЛоты;
		РеквизитыШапки.Контрагент                   = Выборка.Контрагент;
		РеквизитыШапки.РасчетныйСчетКонтрагента     = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.НомерДоговораКонтрагента     = "";
		РеквизитыШапки.Договор                 		= Справочники.Договоры.ПустаяСсылка();
		РеквизитыШапки.ОтложенноеИсполнение         = Выборка.ОтложенноеИсполнение;
		РеквизитыШапки.ДатаИсполнения               = ?(Выборка.ОтложенноеИсполнение, Выборка.ДатаОплаты, Дата(1, 1, 1));
		РеквизитыШапки.РаздельноеИсполнение         = Выборка.РаздельноеИсполнение;
		РеквизитыШапки.ДатаОплаты                   = Выборка.ДатаОплаты;
		РеквизитыШапки.ДатаПоставки                 = Выборка.ДатаПоставки;
		РеквизитыШапки.ВалютаОплаты                 = Выборка.ВалютаОплаты;
		РеквизитыШапки.СобственныйКурсОплаты        = Ложь;
		РеквизитыШапки.КурсОплаты                   = Неопределено;
		РеквизитыШапки.ПлатежноеУсловиеСделки       = "";
		РеквизитыШапки.НомерПорученияУБрокера       = "";
		РеквизитыШапки.ДатаПорученияУБрокера        = Дата(1, 1, 1);

		Если Не ЗначениеЗаполнено(Выборка.РежимБиржевыхТоргов) Тогда
			Если Выборка.Рынок <> Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда 
				ОшибкиЧтения.Добавить("Не удалось определить режим торгов по коду. Проверьте наличие режима биржевых торгов [" + Выборка.Market_Board + "] в справочнике!");
			КонецЕсли;	
			РеквизитыШапки.РежимБиржевыхТоргов      = Справочники.РежимыБиржевыхТоргов.ПустаяСсылка();
		Иначе
			РеквизитыШапки.РежимБиржевыхТоргов      = Выборка.РежимБиржевыхТоргов;
		КонецЕсли;
		
			РеквизитыШапки.РежимПереговорныхСделок  = Выборка.РежимПереговорныхСделок;
			РеквизитыШапки.ВыкупЭмитентом           = Выборка.ВыкупЭмитентом;
			РеквизитыШапки.ПервичноеРазмещение      = Выборка.ПервичноеРазмещение;
		
		Если Выборка.РежимПереговорныхСделок И ЗначениеЗаполнено(Выборка.Partner_ID) И Не ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			ОшибкиЧтения.Добавить("Не удалось определить контрагента по матрих ID [" + Выборка.Partner_ID + "]! Проверьте наличие кода в регистре [Коды во внешних системах].");
		КонецЕсли;
			
		РеквизитыШапки.ПриобретениеПаев				= Ложь;
		РеквизитыШапки.ДепозитарныйСчетКонтрагента	= Справочники.ДепозитарныеСчета.ПустаяСсылка();
		РеквизитыШапки.Рынок                        = Выборка.Рынок;
		РеквизитыШапки.ВалютаТорговойКомиссии       = ?(ЭтотОбъект.ДатаИмпорта < Дата(2024, 07, 10) И Не ЗначениеЗаполнено(Выборка.ВалютаТорговойКомиссии), ЭтотОбъект.Организация.ВалютаУчета, Выборка.ВалютаТорговойКомиссии);
		
		РеквизитыШапки.ОтложеннаяОплатаТорговойКомиссии = Выборка.ОтложеннаяОплатаТорговойКомиссии;
		РеквизитыШапки.ДатаОплатыТорговойКомиссии       = ?(Выборка.ОтложеннаяОплатаТорговойКомиссии, Выборка.ДатаОплатыТорговойКомиссии, Дата(1, 1, 1));
		
		Если Не ЗначениеЗаполнено(Выборка.МестоХраненияДенежныхСредств) Тогда
			ОшибкиЧтения.Добавить("Не удалось определить место хранения денежных средств по коду [" + Выборка.Money_Storage_Place + "]!");
		Иначе
			РеквизитыШапки.МестоХранения = Выборка.МестоХраненияДенежныхСредств;
		КонецЕсли;
		
		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		РеквизитыЦенныеБумаги.НомерСтроки      = 1;
		
		Если ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
			РеквизитыЦенныеБумаги.ЦеннаяБумага     = Выборка.ЦеннаяБумага;
		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить ценную бумагу по коду во внешней системе [" + Выборка.Security_ID + "]!");
		КонецЕсли;
		
		РеквизитыЦенныеБумаги.Количество       = ?(Выборка.Количество = 0, 1, Выборка.Количество);		
		РеквизитыЦенныеБумаги.Сумма            = Выборка.Сумма;
		РеквизитыЦенныеБумаги.СуммаКупона      = Выборка.СуммаКупона;
		РеквизитыЦенныеБумаги.Цена             = Выборка.Цена;
		РеквизитыЦенныеБумаги.ЦенаПроцент      = Выборка.ЦенаПроцент;
		РеквизитыЦенныеБумаги.ЦенаКупона       = Окр(Выборка.СуммаКупона / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги);
		РеквизитыЦенныеБумаги.ТорговаяКомиссия = Выборка.СуммаТорговойКомиссии;
		
		Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
		Иначе
			Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
			КонецЕсли;
		КонецЕсли;
		
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги", РеквизитыШапки, ЦенныеБумаги);
		
		Если ЗначениеЗаполнено(Выборка.РаскрытыйКонтрагент) Тогда	
			НоваяСтрокаОперации.НовыеРеквизиты.Вставить("ДопСведения", Новый Структура("РаскрытыйКонтрагент", Выборка.РаскрытыйКонтрагент));	
		КонецЕсли;
				
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, СделкиДанныеСистемы, ПоляДокумента, "КонтрагентНаБирже");
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьИсполненияБиржевыхСделок_OTBR(МВТ, КонтролироватьНепроведенныеДокументы)
	
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.ИсполнениеОбязательствПоСделке, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК ЗначенияПолученыИзРегистра,
		|	УсловияСделокСрезПоследних.Сделка.НомерСделки КАК НомерСделки,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(УсловияСделокСрезПоследних.ДатаИсполнения, ДЕНЬ) <= &ТекущаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Проведен,
		|	ЛОЖЬ КАК ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА УсловияСделокСрезПоследних.Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ДОБАВИТЬКДАТЕ(УсловияСделокСрезПоследних.ДатаИсполнения, СЕКУНДА, 34200)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(УсловияСделокСрезПоследних.ДатаИсполнения, СЕКУНДА, 34201)
		|	КОНЕЦ КАК Дата,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОплаты,
		|	ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПоставки,
		|	УсловияСделокСрезПоследних.Организация КАК Организация,
		|	УсловияСделокСрезПоследних.Сделка КАК Основание,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке) КАК ВидЗадолженности,
		|	УсловияСделокСрезПоследних.Сделка.ВидСделки КАК ВидСделки,
		|	УсловияСделокСрезПоследних.Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокСрезПоследних.Рынок КАК Рынок,
		|	УсловияСделокСрезПоследних.Сделка.Брокер КАК Брокер,
		|	УсловияСделокСрезПоследних.Сделка.МестоХранения КАК МестоХранения,
		|	УсловияСделокСрезПоследних.Сделка.РасчетныйСчет КАК РасчетныйСчет,
		|	УсловияСделокСрезПоследних.Сделка.ВалютаСделки КАК ВалютаСделки,
		|	1 КАК НомерСтроки,
		|	УсловияСделокСрезПоследних.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	УсловияСделокСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокСрезПоследних.Количество КАК Количество,
		|	УсловияСделокСрезПоследних.Цена КАК Цена,
		|	УсловияСделокСрезПоследних.ЦенаПроцент КАК ЦенаПроцент,
		|	УсловияСделокСрезПоследних.ЦенаКупона КАК ЦенаКупона,
		|	УсловияСделокСрезПоследних.Сумма КАК Сумма,
		|	УсловияСделокСрезПоследних.СуммаКупона КАК СуммаКупона
		|ПОМЕСТИТЬ _УсловияСделок
		|ИЗ
		|	РегистрСведений.УсловияСделок.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокСрезПоследних
		|ГДЕ
		|	УсловияСделокСрезПоследних.Отменено = ЛОЖЬ
		|	И УсловияСделокСрезПоследних.ДатаИсполнения >= &НачалоПериода
		|	И НЕ УсловияСделокСрезПоследних.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|	И УсловияСделокСрезПоследних.Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И НАЧАЛОПЕРИОДА(УсловияСделокСрезПоследних.Сделка.Дата, ДЕНЬ) <= &НачалоПериода
		|	И УсловияСделокСрезПоследних.Сделка.Брокер = &Брокер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ""покупка""
		|		КОГДА ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ""продажа""
		|		ИНАЧЕ """"
		|	КОНЕЦ + ""/"" + ИсполнениеОбязательствПоСделке.Основание.НомерСделки КАК Ключ,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ) <= &ТекущаяДата
		|				И НЕ ИсполнениеОбязательствПоСделке.Проведен
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлОшибкаНепроведенногоДокумента,
		|	НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ) КАК ПроверяемаяДата,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ТекущиеОперации
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО ИсполнениеОбязательствПоСделке.Основание = Сделка.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ПО ИсполнениеОбязательствПоСделке.Ссылка = ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И НЕ ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|	И НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ) >= &НачалоПериода
		|	И НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) <= &НачалоПериода
		|	И ИсполнениеОбязательствПоСделке.Брокер = &Брокер
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И НЕ ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|	И Сделка.Организация = &Организация
		|	И Сделка.Брокер = &Брокер
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТекущиеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТекущиеОперации.ПроверяемаяДата КАК ПроверяемаяДата,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ТекущиеОперации.Ключ) КАК Количество
		|ПОМЕСТИТЬ _НепроведенныеИсполнения
		|ИЗ
		|	_ТекущиеОперации КАК _ТекущиеОперации
		|ГДЕ
		|	&КонтролироватьНепроведенные
		|	И _ТекущиеОперации.ФлОшибкаНепроведенногоДокумента = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	_ТекущиеОперации.СчетДоверительногоУправления,
		|	_ТекущиеОперации.ПроверяемаяДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_УсловияСделок.ЗначенияПолученыИзРегистра КАК ЗначенияПолученыИзРегистра,
		|	_ИсполненныеСделки.Market_Number КАК НомерСделки,
		|	_УсловияСделок.Проведен КАК Проведен,
		|	_УсловияСделок.ПометкаУдаления КАК ПометкаУдаления,
		|	_УсловияСделок.Дата КАК Дата,
		|	_УсловияСделок.ДатаОплаты КАК ДатаОплаты,
		|	_УсловияСделок.ДатаПоставки КАК ДатаПоставки,
		|	_УсловияСделок.Организация КАК Организация,
		|	_УсловияСделок.Основание КАК Основание,
		|	_УсловияСделок.ВидЗадолженности КАК ВидЗадолженности,
		|	_УсловияСделок.ВидСделки КАК ВидСделки,
		|	_УсловияСделок.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_УсловияСделок.Рынок КАК Рынок,
		|	_УсловияСделок.Брокер КАК Брокер,
		|	_УсловияСделок.МестоХранения КАК МестоХранения,
		|	_УсловияСделок.РасчетныйСчет КАК РасчетныйСчет,
		|	_УсловияСделок.ВалютаСделки КАК ВалютаСделки,
		|	_УсловияСделок.НомерСтроки КАК НомерСтроки,
		|	_УсловияСделок.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	_УсловияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_УсловияСделок.Количество КАК Количество,
		|	_УсловияСделок.Цена КАК Цена,
		|	_УсловияСделок.ЦенаПроцент КАК ЦенаПроцент,
		|	_УсловияСделок.ЦенаКупона КАК ЦенаКупона,
		|	_УсловияСделок.Сумма КАК Сумма,
		|	_УсловияСделок.СуммаКупона КАК СуммаКупона,
		|	_ИсполненныеСделки.Ключ КАК ИмяФайла,
		|	"""" КАК Depo_Storage_Place,
		|	"""" КАК КоличествоДепозитарныхСчетов
		|ПОМЕСТИТЬ _ИсполненияСделокВнешниеДанные
		|ИЗ
		|	_ИсполненныеСделки КАК _ИсполненныеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияСделок КАК _УсловияСделок
		|		ПО _ИсполненныеСделки.Market_Number = _УсловияСделок.НомерСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО _ИсполненныеСделки.Market_Number = СделкаСВалютой.НомерСделки
		|			И (СделкаСВалютой.ПометкаУдаления = ЛОЖЬ)
		|			И (СделкаСВалютой.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|ГДЕ
		|	_ИсполненныеСделки.Date = &НачалоПериода
		|	И _ИсполненныеСделки.Deal_Date <> &НачалоПериода
		|	И _ИсполненныеСделки.ТипСделки = ""Сделка""
		|	И _ИсполненныеСделки.Оплата = 1
		|	И _ИсполненныеСделки.Поставка = 1
		|	И СделкаСВалютой.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	_Deals_Incomplete_With_Details.Market_Number,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	_Deals_Incomplete_With_Details.Date,
		|	_Deals_Incomplete_With_Details.Payment_Date,
		|	_Deals_Incomplete_With_Details.Delivery_Date,
		|	_УсловияСделок.Организация,
		|	_УсловияСделок.Основание,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке),
		|	ВЫБОР
		|		КОГДА _Deals_Incomplete_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_Incomplete_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	_Deals_Incomplete_With_Details.СчетДоверительногоУправления,
		|	_Deals_Incomplete_With_Details.Рынок,
		|	_УсловияСделок.Брокер,
		|	_МестаХраненияДенежныхСредств.Ссылка,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка),
		|	_Deals_Incomplete_With_Details.ВалютаСделки КАК ВалютаСделки,
		|	1,
		|	_ДепозитарныеСчета.Счет,
		|	_Deals_Incomplete_With_Details.ЦеннаяБумага,
		|	_Deals_Incomplete_With_Details.Volume,
		|	_Deals_Incomplete_With_Details.Price,
		|	ВЫБОР
		|		КОГДА _Deals_Incomplete_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_Incomplete_With_Details.Price_Percent
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	0,
		|	_Deals_Incomplete_With_Details.Amount,
		|	ВЫБОР
		|		КОГДА _Deals_Incomplete_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_Incomplete_With_Details.ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	"""",
		|	_Deals_Incomplete_With_Details.Depo_Storage_Place,
		|	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0)
		|ИЗ
		|	_Deals_Incomplete_With_Details КАК _Deals_Incomplete_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Deals_Incomplete_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _Deals_Incomplete_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
		|			И _Deals_Incomplete_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияСделок КАК _УсловияСделок
		|		ПО _Deals_Incomplete_With_Details.Market_Number = _УсловияСделок.НомерСделки
		|			И _Deals_Incomplete_With_Details.СчетДоверительногоУправления = _УсловияСделок.СчетДоверительногоУправления
		|ГДЕ
		|	_Deals_Incomplete_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"", ""Operations.Group.Deals.IPO"")
		|	И _Deals_Incomplete_With_Details.Is_Deal_Info = ""0""
		|	И _Deals_Incomplete_With_Details.Is_Cancelled <> ""1""
		|	И _Deals_Incomplete_With_Details.Market = ""MICEX""
		|	И _Deals_Incomplete_With_Details.Deal_Info_Type <> ""Deals.Info.Type.Cancellation""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ) = &ТекущаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ИсполнениеОбязательствПоСделке.Проведен
		|	КОНЕЦ КАК Проведен,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТекущиеОперации КАК _ТекущиеОперации
		|		ПО ИсполнениеОбязательствПоСделке.Ссылка = _ТекущиеОперации.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _УсловияСделок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ТекущиеОперации";
#КонецОбласти

	ТекДата = НачалоДня(ТекущаяДатаСеанса()); 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");  
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("КонтролироватьНепроведенные", КонтролироватьНепроведенныеДокументы);
		
	ИсполненияСделокДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ИсполненияСделокВнешниеДанные"].ПолучитьДанные().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = НРег(Выборка.ВидСделки) + "/" + Выборка.НомерСделки;
		НоваяСтрокаОперации.Описание     = "Исполн. бирж. сделки, № " + Выборка.НомерСделки + ?(ЗначениеЗаполнено(Выборка.ВидСделки), ", [" + Строка(Выборка.ВидСделки) + "], " + Выборка.ЦеннаяБумага, "");
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;

		РеквизитыШапки        = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		
		РеквизитыШапки.КонтрагентНаБирже = "";
		
		Если Не ЗначениеЗаполнено(Выборка.ЗначенияПолученыИзРегистра) Тогда
			
		 	ОшибкиЧтения.Добавить("Не удалось сформировать документ [исполнение обязательств по сделке]. Не найдена биржевая сделка по номеру [" + Выборка.НомерСделки + "]. Данные загружены из файла [" + Выборка.ИмяФайла + "].");
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
			Продолжить;

		ИначеЕсли Выборка.ЗначенияПолученыИзРегистра Тогда

			ЗаполнитьЗначенияСвойств(РеквизитыШапки, Выборка);
			ЗаполнитьЗначенияСвойств(РеквизитыЦенныеБумаги, Выборка);
			
		Иначе //данные получены из файла брокера (Deals_Incomplete - незавершенные сделки)
	
			РеквизитыШапки.Проведен          = ?(Выборка.ДатаОплаты <= ТекДата И Выборка.ДатаПоставки <= ТекДата, Истина, Ложь);
			РеквизитыШапки.ПометкаУдаления   = ЛОЖЬ;
			РеквизитыШапки.Дата              = Выборка.ДатаОплаты + ?(Выборка.ВидСделки = Перечисления.ВидыСделок.Покупка, 34200, 34201);
			РеквизитыШапки.Организация       = Выборка.Организация;
			
			Если ЗначениеЗаполнено(Выборка.Основание) Тогда
				РеквизитыШапки.Основание     = Выборка.Основание;
			Иначе
				ОшибкиЧтения.Добавить("Не удалось сформировать документ [исполнение обязательств по сделке]. Не найдена биржевая сделка-основание по номеру [" + Выборка.НомерСделки + "].");	
			КонецЕсли;
			
			РеквизитыШапки.ВидЗадолженности  = Выборка.ВидЗадолженности;
			РеквизитыШапки.ВидСделки         = Выборка.ВидСделки;
			РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
			РеквизитыШапки.Рынок             = Выборка.Рынок;
			РеквизитыШапки.Брокер            = Выборка.Брокер;
			РеквизитыШапки.МестоХранения     = Выборка.МестоХранения;
			РеквизитыШапки.РасчетныйСчет     = Выборка.РасчетныйСчет;
			РеквизитыШапки.ВалютаСделки      = Выборка.Валютасделки;
			
			РеквизитыЦенныеБумаги.НомерСтроки = Выборка.НомерСтроки;
			
			Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
				РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
			Иначе
				Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
					ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
				Иначе
					ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
				КонецЕсли;
			КонецЕсли;

			РеквизитыЦенныеБумаги.ЦеннаяБумага = Выборка.ЦеннаяБумага;
			РеквизитыЦенныеБумаги.Количество   = ?(Выборка.Количество = 0, 1, Выборка.Количество);
			РеквизитыЦенныеБумаги.Цена         = Выборка.Цена;
			РеквизитыЦенныеБумаги.ЦенаПроцент  = Выборка.ЦенаПроцент;
			РеквизитыЦенныеБумаги.СуммаКупона  = Выборка.СуммаКупона;
			РеквизитыЦенныеБумаги.ЦенаКупона   = Окр(Выборка.СуммаКупона / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги);
			РеквизитыЦенныеБумаги.Сумма        = Выборка.Сумма;
			
		КонецЕсли;
		
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги", РеквизитыШапки, ЦенныеБумаги);
				
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
		
	КонецЦикла;
		
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ИсполненияСделокДанныеСистемы, ПоляДокумента);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьОплатыБиржевыхСделокСВалютой_OTBR(МВТ)
	
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Оплата, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
		
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаСВалютой.Ссылка КАК Ссылка,
		|	СделкаСВалютой.ПометкаУдаления КАК ПометкаУдаления,
		|	СделкаСВалютой.Проведен КАК Проведен,
		|	СделкаСВалютой.Организация КАК Организация,
		|	СделкаСВалютой.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СделкаСВалютой.ВидСделки КАК ВидСделки,
		|	СделкаСВалютой.МестоХранения КАК МестоХранения,
		|	СделкаСВалютой.Брокер КАК Брокер,
		|	СделкаСВалютой.Валюта КАК Валюта,
		|	СделкаСВалютой.Контрвалюта КАК Контрвалюта,
		|	СделкаСВалютой.Сумма КАК Сумма,
		|	СделкаСВалютой.СуммаКонтрвалюты КАК СуммаКонтрвалюты,
		|	СделкаСВалютой.ДатаИсполнения КАК ДатаИсполнения,
		|	СделкаСВалютой.НомерСделки КАК НомерСделки,
		|	"""" + СделкаСВалютой.НомерСделки + ВЫБОР
		|		КОГДА СделкаСВалютой.ТипСделки = ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопВтораяЧасть)
		|			ТОГДА ""/2""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Ключ
		|ПОМЕСТИТЬ _СделкиСВалютой
		|ИЗ
		|	Документ.СделкаСВалютой КАК СделкаСВалютой
		|ГДЕ
		|	СделкаСВалютой.Организация = &Организация
		|	И СделкаСВалютой.Брокер = &Брокер
		|	И СделкаСВалютой.Проведен
		|	И НЕ СделкаСВалютой.ПометкаУдаления
		|	И СделкаСВалютой.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И (НАЧАЛОПЕРИОДА(СделкаСВалютой.Дата, ДЕНЬ) = &НачалоПериода
		|			ИЛИ СделкаСВалютой.ДатаИсполнения = &НачалоПериода)
		|	И НАЧАЛОПЕРИОДА(СделкаСВалютой.Дата, ДЕНЬ) <> НАЧАЛОПЕРИОДА(СделкаСВалютой.ДатаИсполнения, ДЕНЬ)
		|	И НЕ СделкаСВалютой.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|	И СделкаСВалютой.НомерСделки В
		|			(ВЫБРАТЬ
		|				_ИсполненныеСделки.Market_Number
		|			ИЗ
		|				_ИсполненныеСделки КАК _ИсполненныеСделки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкиСВалютой.Ссылка КАК Основание,
		|	ЛОЖЬ КАК ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА СделкиСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ДОБАВИТЬКДАТЕ(СделкиСВалютой.ДатаИсполнения, СЕКУНДА, 61201)
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(СделкиСВалютой.ДатаИсполнения, СЕКУНДА, 36000)
		|	КОНЕЦ КАК Дата,
		|	ВЫБОР
		|		КОГДА СделкиСВалютой.ДатаИсполнения <= &ТекущаяДата
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Проведен,
		|	СделкиСВалютой.Организация КАК Организация,
		|	СделкиСВалютой.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА СделкиСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке) КАК ВидЗадолженности,
		|	ЛОЖЬ КАК Аванс,
		|	СделкиСВалютой.Брокер КАК Брокер,
		|	СделкиСВалютой.МестоХранения КАК МестоХранения,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчет,
		|	СделкиСВалютой.Валюта КАК ВалютаОплаты,
		|	ЗНАЧЕНИЕ(Документ.СтрокаБанковскойВыписки.ПустаяСсылка) КАК СтрокаБанковскойВыписки,
		|	ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка) КАК Контрагент,
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчетКонтрагента,
		|	СделкиСВалютой.Валюта КАК Валюта,
		|	СделкиСВалютой.Сумма КАК Сумма,
		|	0 КАК СуммаКупона,
