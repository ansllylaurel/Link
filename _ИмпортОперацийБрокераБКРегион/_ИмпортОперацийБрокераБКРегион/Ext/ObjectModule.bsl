Функция ИмпортироватьИзXMLФайлов_ФорматOTBR(ФайлыИмпорта, ТаблицаСделокРЕПО_М, ДанныеСФормы) Экспорт
		
	ТочностьЦеныЦеннойБумаги = Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион");      
	
	Организация_ДК = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК");
	КонтролироватьНепроведенныеДокументы = ЭтотОбъект.Организация <> Организация_ДК;
	ИспользуютсяСоставныеКодыУБрокера = ЭтотОбъект.Организация = Организация_ДК
					Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ");
	
	Если ДанныеСФормы <> Неопределено Тогда
		ЗагрузитьОперации(ДанныеСФормы);	
	КонецЕсли;
	
	Макет = ЭтотОбъект.ПолучитьМакет("Схема_OTBR");

	ЧтениеСхемыOTBR = Новый ЧтениеXML;
	ЧтениеСхемыOTBR.УстановитьСтроку(Макет.ПолучитьТекст());
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеСхемыOTBR);
	
	ПостроительСхемXML = Новый ПостроительСхемXML;
	СхемаXML = ПостроительСхемXML.СоздатьСхемуXML(ДокументDOM);
	
	НаборСхемXML = Новый НаборСхемXML;
	НаборСхемXML.Добавить(СхемаXML);
	
	СвояФабрикаXDTO = Новый ФабрикаXDTO(НаборСхемXML);
	ТипXDTO = СвояФабрикаXDTO.Тип("xmlns:xs=""xmlns:xs=""http://www.w3.org/2001/XMLSchema""", "Data");
	
	ИмяФайлаДанныхНаСервере = ПолучитьИмяВременногоФайла("xml");
		
	СтруктураВнешнихДанных = ПолучитьСтруктуруДанных();
	
	Для Каждого СтрокаФайловИмпорта Из ФайлыИмпорта Цикл
			
		СтрокаФайловИмпорта.ДанныеФайла.Записать(ИмяФайлаДанныхНаСервере);
		
		ЧтениеТекста = Новый ЧтениеТекста(ИмяФайлаДанныхНаСервере, КодировкаТекста.UTF8);
		СтрокаXML = ЧтениеТекста.Прочитать();
		СтрокаXML = СтрЗаменить(СтрокаXML, "<Data", "<Data xmlns:xs=""http://www.w3.org/2001/XMLSchema"" ");
		                                                                                              
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		
		ОбъектXDTO = СвояФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		
		Если ТипЗнч(ОбъектXDTO) = Тип("ОбъектXDTO") Тогда
			
			ЗаполнитьСтруктуруДаннымиИзОбъектаXTDO(ОбъектXDTO, СтруктураВнешнихДанных, СтрокаФайловИмпорта.ИмяФайла, ИспользуютсяСоставныеКодыУБрокера);
											
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить объект XDTO");
			Возврат Неопределено;
		КонецЕсли;
		
		ЧтениеТекста.Закрыть();
	КонецЦикла;
	
	МВТ = Новый МенеджерВременныхТаблиц;
//Справочники
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РежимыБиржевыхТоргов.Ссылка КАК Ссылка,
		|	РежимыБиржевыхТоргов.Код КАК Код,
		|	РежимыБиржевыхТоргов.РЕПО КАК флагРепо,
		|	РежимыБиржевыхТоргов.Наименование КАК Наименование,
		|	РежимыБиржевыхТоргов.РежимПереговорныхСделок КАК РежимПереговорныхСделок,
		|	РежимыБиржевыхТоргов.ПервичноеРазмещение КАК ПервичноеРазмещение,
		|	РежимыБиржевыхТоргов.ВыкупЭмитентом КАК ВыкупЭмитентом,
		|	РежимыБиржевыхТоргов.Аукцион КАК Аукцион,
		|	ЛОЖЬ КАК РепоСЦК
		|ИЗ
		|	Справочник.РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
		|ГДЕ
		|	НЕ РежимыБиржевыхТоргов.ПометкаУдаления";
	
	РежимыБиржевыхТоргов = Запрос.Выполнить().Выгрузить();
		
	Для Каждого СтрокаРежимов Из РежимыБиржевыхТоргов Цикл
		
		Если СтрокаРежимов.ФлагРепо = Истина И СтрНайти(СтрокаРежимов.Наименование, "с ЦК") > 0 Тогда
			СтрокаРежимов.РепоСЦК = Истина;	
		КонецЕсли;
		
	КонецЦикла;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПервыхУзлов.Ключ КАК Ключ,
		|	ДанныеПервыхУзлов.ФайлСоответствуетФормату КАК ФайлСоответствуетФормату
		|ПОМЕСТИТЬ _ДанныеПервыхУзлов
		|ИЗ
		|	&ДанныеПервыхУзлов КАК ДанныеПервыхУзлов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РежимыБиржевыхТоргов.Ссылка КАК Ссылка,
		|	РежимыБиржевыхТоргов.Код КАК Код,
		|	РежимыБиржевыхТоргов.РепоСЦК КАК РепоСЦК,
		|	РежимыБиржевыхТоргов.РежимПереговорныхСделок КАК РежимПереговорныхСделок,
		|	РежимыБиржевыхТоргов.ПервичноеРазмещение КАК ПервичноеРазмещение,
		|	РежимыБиржевыхТоргов.ВыкупЭмитентом КАК ВыкупЭмитентом,
		|	РежимыБиржевыхТоргов.Аукцион КАК Аукцион,
		|	РежимыБиржевыхТоргов.флагРепо КАК флагРепо
		|ПОМЕСТИТЬ _РежимыБиржевыхТоргов
		|ИЗ
		|	&РежимыБиржевыхТоргов КАК РежимыБиржевыхТоргов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Firms.ID КАК ID,
		|	Firms.Name_Official_Ru КАК Name_Official_Ru
		|ПОМЕСТИТЬ _Firms
		|ИЗ
		|	&Firms КАК Firms
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Bonds.ID КАК ID,
		|	Bonds.Code_MOEX КАК Code_MOEX,
		|	Bonds.Face_Value_Current КАК Face_Value_Current,
		|	Bonds.Currency КАК Currency
		|ПОМЕСТИТЬ _Bonds
		|ИЗ
		|	&Bonds КАК Bonds
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Shares.ID КАК ID,
		|	Shares.Code_MOEX КАК Code_MOEX
		|ПОМЕСТИТЬ _Shares
		|ИЗ
		|	&Shares КАК Shares
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Bills.ID КАК ID
		|ПОМЕСТИТЬ _Bills
		|ИЗ
		|	&Bills КАК Bills
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Derivatives.ID КАК ID,
		|	Derivatives.Code_FORTS КАК Code_FORTS,
		|	Derivatives.Type КАК Type,
		|	Derivatives.Date_Execution КАК Date_Execution
		|ПОМЕСТИТЬ _Derivatives
		|ИЗ
		|	&Derivatives КАК Derivatives
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	DRs.ID КАК ID,
		|	DRs.Code_MOEX КАК Code_MOEX
		|ПОМЕСТИТЬ _DRs
		|ИЗ
		|	&DRs КАК DRs
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
