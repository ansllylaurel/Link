#КонецОбласти

	//добавить валютные пары
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Bonds", СтруктураВнешнихДанных.Bonds);
	Запрос.УстановитьПараметр("Shares", СтруктураВнешнихДанных.Shares);
	Запрос.УстановитьПараметр("Bills", СтруктураВнешнихДанных.Bills);
	Запрос.УстановитьПараметр("Derivatives", СтруктураВнешнихДанных.Derivatives);
	Запрос.УстановитьПараметр("DRs", СтруктураВнешнихДанных.DRs);
	Запрос.УстановитьПараметр("Funds", СтруктураВнешнихДанных.Funds);
	Запрос.УстановитьПараметр("Currencies", СтруктураВнешнихДанных.Currencies);
	Запрос.УстановитьПараметр("Firms", СтруктураВнешнихДанных.Firms);
	Запрос.УстановитьПараметр("ДанныеПервыхУзлов", СтруктураВнешнихДанных.ДанныеПервыхУзлов);
	Запрос.УстановитьПараметр("РежимыБиржевыхТоргов", РежимыБиржевыхТоргов);
	
	Запрос.Выполнить();
	
	ВыборкаНовыхЦенныхБумаг = МВТ.Таблицы["_НовыеЦенныеБумаги"].ПолучитьДанные().Выбрать();
	
	ЗагруженыНовыеЦенныеБумаги = Ложь;
	
	Пока ВыборкаНовыхЦенныхБумаг.Следующий() Цикл
		
		Если ВыборкаНовыхЦенныхБумаг.ГруппаИмпорта = Справочники.ГруппыИмпортируемыхОбъектов.Валюты Тогда
			Продолжить;
		ИначеЕсли ВыборкаНовыхЦенныхБумаг.ГруппаИмпорта = Справочники.ГруппыИмпортируемыхОбъектов.ПустаяСсылка() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить группу импортируемых объектов для ценной бумаги [Derivatives]. Код [" + ВыборкаНовыхЦенныхБумаг.Matrix_ID + "].");	
		Иначе
			
			ЗагрузитьЦеннуюБумагу(ВыборкаНовыхЦенныхБумаг.Matrix_ID, ВыборкаНовыхЦенныхБумаг.ГруппаИмпорта);
			ЗагруженыНовыеЦенныеБумаги = Истина;
			
		КонецЕсли;
			
	КонецЦикла;
	
	Если ЗагруженыНовыеЦенныеБумаги Тогда
		
		МВТ = Новый МенеджерВременныхТаблиц; // после того как загруженны ценные бумаги еще раз выполняем запрос.
		Запрос.МенеджерВременныхТаблиц = МВТ;
		Запрос.Выполнить();
	
	КонецЕсли;
		
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаСделокРЕПО_М, "_ТаблицаСделокРЕПО_М", МВТ, , , , "НомерСделки, ЧастьСделкиРЕПО");
		
	ВыборкаОшибокОпределнияВалюты = МВТ.Таблицы["_ОшибкиОпределенияВалюты"].ПолучитьДанные().Выбрать();	
		
	Пока ВыборкаОшибокОпределнияВалюты.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В регистре [Коды во внешних системах] не найдена валюта [" + ВыборкаОшибокОпределнияВалюты.ISO_Code + "] по коду [" + ВыборкаОшибокОпределнияВалюты.Matrix_ID + "].");	
	КонецЦикла;
		
	Если МВТ.Таблицы["_ФайлыСоответствующиеФормату"].ПолучитьДанные().Пустой() Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В папке [" + ЭтотОбъект.КаталогФайловОТБР + "] отсутствуют файлы соответствующие параметрам импорта.");	
		Возврат Неопределено;
	КонецЕсли;	
	
//Счета ДУ, депозитарные счета	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Ссылка КАК Счет
		|ПОМЕСТИТЬ _СчетаИсключеныИзЗагрузки
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Объект ССЫЛКА Справочник.СчетаДоверительногоУправления
		|	И ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Справочник.СчетаДоверительногоУправления).Организация = &Организация
