		|	_ЗадолженностиАльт.Основание КАК ОснованиеАльт,
		|	_ЗадолженностиАльт.Контрагент КАК КонтрагентАльт,
		|	ЕСТЬNULL(_ЗадолженностиАльт.СуммаОстаток, 0) КАК СуммаОстатокАльт,
		|	ЕСТЬNULL(_ЗадолженностиАльт.СуммаКупонаОстаток, 0) КАК СуммаКупонаОстатокАльт,
		|	ЕСТЬNULL(_ЗадолженностиАльт.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаЗадолженностиАльт,
		|	ЕСТЬNULL(ЗадолженностиСКоличествомОснованийАльт.КоличествоОснований, 0) КАК КоличествоОснованийАльт,
		|	ЕСТЬNULL(_ЗадолженностиАльт.Количество, 0) КАК КоличествоАльт
		|ПОМЕСТИТЬ _ОплатыПоПогашениямВнешниеДанные
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Задолженности.ЦеннаяБумага КАК ЦеннаяБумага,
		|			_Задолженности.Количество КАК Количество,
		|			_Задолженности.ВидЗадолженности КАК ВидЗадолженности,
		|			_Задолженности.Организация КАК Организация,
		|			_Задолженности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Задолженности.Основание) КАК КоличествоОснований
		|		ИЗ
		|			_Задолженности КАК _Задолженности
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Задолженности.ЦеннаяБумага,
		|			_Задолженности.Количество,
		|			_Задолженности.ВидЗадолженности,
		|			_Задолженности.Организация,
		|			_Задолженности.СчетДоверительногоУправления) КАК ЗадолженностиСКоличествомОснований
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Задолженности КАК _Задолженности
		|			ПО ЗадолженностиСКоличествомОснований.СчетДоверительногоУправления = _Задолженности.СчетДоверительногоУправления
		|				И ЗадолженностиСКоличествомОснований.ВидЗадолженности = _Задолженности.ВидЗадолженности
		|				И ЗадолженностиСКоличествомОснований.ЦеннаяБумага = _Задолженности.ЦеннаяБумага
		|				И ЗадолженностиСКоличествомОснований.Количество = _Задолженности.Количество
		|				И (ЗадолженностиСКоличествомОснований.КоличествоОснований = 1)
		|		ПО _ВнешниеДанные.СчетДоверительногоУправления = ЗадолженностиСКоличествомОснований.СчетДоверительногоУправления
		|			И _ВнешниеДанные.ВидЗадолженности = ЗадолженностиСКоличествомОснований.ВидЗадолженности
		|			И _ВнешниеДанные.ЦеннаяБумага = ЗадолженностиСКоличествомОснований.ЦеннаяБумага
		|			И _ВнешниеДанные.Volume = ЗадолженностиСКоличествомОснований.Количество
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Задолженности.ЦеннаяБумага КАК ЦеннаяБумага,
		|			_Задолженности.Количество КАК Количество,
		|			_Задолженности.ВидЗадолженности КАК ВидЗадолженности,
		|			_Задолженности.Организация КАК Организация,
		|			_Задолженности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Задолженности.Основание) КАК КоличествоОснований
		|		ИЗ
		|			_Задолженности КАК _Задолженности
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Задолженности.ЦеннаяБумага,
		|			_Задолженности.Количество,
		|			_Задолженности.ВидЗадолженности,
		|			_Задолженности.Организация,
		|			_Задолженности.СчетДоверительногоУправления) КАК ЗадолженностиСКоличествомОснованийАльт
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Задолженности КАК _ЗадолженностиАльт
		|			ПО ЗадолженностиСКоличествомОснованийАльт.СчетДоверительногоУправления = _ЗадолженностиАльт.СчетДоверительногоУправления
		|				И ЗадолженностиСКоличествомОснованийАльт.ВидЗадолженности = _ЗадолженностиАльт.ВидЗадолженности
		|				И ЗадолженностиСКоличествомОснованийАльт.ЦеннаяБумага = _ЗадолженностиАльт.ЦеннаяБумага
		|				И ЗадолженностиСКоличествомОснованийАльт.Количество = _ЗадолженностиАльт.Количество
		|				И (ЗадолженностиСКоличествомОснованийАльт.КоличествоОснований = 1)
		|		ПО _ВнешниеДанные.СчетДоверительногоУправления = ЗадолженностиСКоличествомОснованийАльт.СчетДоверительногоУправления
		|			И _ВнешниеДанные.ЦеннаяБумага = ЗадолженностиСКоличествомОснованийАльт.ЦеннаяБумага
		|			И _ВнешниеДанные.Volume = ЗадолженностиСКоличествомОснованийАльт.Количество
		|			И ЗадолженностиСКоличествомОснованийАльт.ВидЗадолженности = ВЫБОР
		|				КОГДА _ВнешниеДанные.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|					ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|				КОГДА _ВнешниеДанные.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|					ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПустаяСсылка)
		|			КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.ВидЗадолженности.ИмяПредопределенныхДанных КАК Ключ,
		|	Оплата.СчетДоверительногоУправления.Наименование КАК НаименованиеСчета,
		|	ВЫБОР
		|		КОГДА Оплата.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи))
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеДивидендов).ЦеннаяБумага.Наименование
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеКупона).Облигация.Наименование
		|		КОГДА Оплата.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага.Наименование
		|	КОНЕЦ КАК ЦеннаяБумагаНаименование,
		|	ВЫБОР
		|		КОГДА Оплата.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи))
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеДивидендов).Количество
		|		КОГДА Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеКупона).Количество
		|		КОГДА Оплата.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеЦеннойБумаги).Количество
		|	КОНЕЦ КАК Количество,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО Оплата.Ссылка = ОплатаОснования.Ссылка
		|ГДЕ
		|	Оплата.Организация = &Организация
		|	И НЕ Оплата.ПометкаУдаления
		|	И Оплата.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Оплата.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона))
		|	И Оплата.Брокер = &Брокер
		|	И НЕ Оплата.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Задолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ВнешниеДанные";
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	
	// обычно оплата от брокера по погашенным ценным бумагам приходит на следующий рабочий день,
	// однако 15.12.2021 она пришла в день погашения; остатков задолженности на начало дня не было,
	// т.к. документы Погашение ц/б заводятся в 09:30, поэтому пришлось сместить период анализа задолженности
	Запрос.УстановитьПараметр("ПериодВозникновенияЗадолженности", Новый Граница(НачалоДня(ЭтотОбъект.ДатаИмпорта) + 09 * 3600 + 30 * 60, ВидГраницы.Включая));

	ТекущиеОперации = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ОплатыПоПогашениямВнешниеДанные"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
			
		ОшибкиЧтения                     = Новый Массив;
		НоваяСтрокаОперации              = Операции.Добавить();					
		ВидЗадолженностиОперации         = Выборка.ВидЗадолженности;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.ВидДвижения                  = Выборка.ВидДвижения;
		РеквизитыШапки.ВидЗадолженности             = ВидЗадолженностиОперации;
		РеквизитыШапки.Аванс                        = Ложь;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.МестоХранения                = Выборка.МестоХраненияДенежныхСредств;
		РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.ВалютаОплаты                 = Выборка.ВалютаОплаты;
		РеквизитыШапки.Брокер                       = Брокер;
		РеквизитыШапки.СтрокаБанковскойВыписки      = Документы.СтрокаБанковскойВыписки.ПустаяСсылка();
		РеквизитыШапки.Контрагент               	= Выборка.Контрагент;		
		РеквизитыШапки.РасчетныйСчетКонтрагента 	= Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.Договор                  	= Справочники.Договоры.ПустаяСсылка();
				
		РеквизитыОснования = Новый Структура(ПоляДокумента.Основания);
		РеквизитыОснования.НомерСтроки              = 1;						
		РеквизитыОснования.Валюта                   = Выборка.ВалютаЗадолженности;
		РеквизитыОснования.Сумма                    = Выборка.СуммаОстаток;
		РеквизитыОснования.СуммаКупона              = Выборка.СуммаКупонаОстаток;
		РеквизитыОснования.СобственныйКурсОплаты    = Ложь;
		РеквизитыОснования.КурсОплаты               = Неопределено;
		РеквизитыОснования.СуммаОплаты              = Выборка.Сумма;
		РеквизитыОснования.СуммаОплатыКупона        = Выборка.СуммаКупона;
		
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			РеквизитыОснования.Основание = Выборка.Основание;
			
			Если Выборка.Volume <> Выборка.Количество Тогда
				ОшибкиЧтения.Добавить("В документе основания [" + Выборка.Основание + "] количество [" + Выборка.Количество + "] ценных бумаг не соответствует количеству [" + Выборка.Volume + "] бумаг в данных импорта");	
			КонецЕсли;

		Иначе
			Если Выборка.ЕстьПогашениеВДень
				И (Выборка.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
					Или Выборка.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
				И ЗначениеЗаполнено(Выборка.ОснованиеАльт) Тогда
				
				// Переключим вид задолженности и основание на альтернативные данные из основного запроса
				ВидЗадолженностиОперации = ?(Выборка.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона,
					Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона,
					Справочники.ВидыЗадолженности.ПоПогашениюКупона);
				
				РеквизитыШапки.ВидЗадолженности = ВидЗадолженностиОперации;
				РеквизитыШапки.Контрагент       = Выборка.КонтрагентАльт;
				
				РеквизитыОснования.Валюта      = Выборка.ВалютаЗадолженностиАльт;
				РеквизитыОснования.Сумма       = Выборка.СуммаОстатокАльт;
				РеквизитыОснования.СуммаКупона = Выборка.СуммаКупонаОстатокАльт;
				РеквизитыОснования.Основание   = Выборка.ОснованиеАльт;
				
			Иначе
				Если Выборка.КоличествоОснований = 0 Тогда
					ОшибкиЧтения.Добавить("Не удалось определить документ основание по виду задолженности [" + Выборка.ВидЗадолженности + "] и счету внутреннего учета [" + Выборка.СчетДоверительногоУправления + "] в регистре [Задолженности по денежным средствам].");
				Иначе
					ОшибкиЧтения.Добавить("Не удалось определить документ основание. В регистре [Задолженности по денежным средствам] по виду задолженности [" + Выборка.ВидЗадолженности + "] и счету внутреннего учета [" + Выборка.СчетДоверительногоУправления + "] найдено более одного документа основания. Количество оснований: " + Выборка.КоличествоОснований + "");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Дата считается здесь — после того, как определено финальное основание (первичное или альтернативное)
		РеквизитыШапки.Дата = ?(ЗначениеЗаполнено(РеквизитыОснования.Основание) И НачалоДня(РеквизитыОснования.Основание.Дата) = ЭтотОбъект.ДатаИмпорта, РеквизитыОснования.Основание.Дата + 1, ЭтотОбъект.ДатаИмпорта + (9 * 60 + 30) * 60); //"9:30:00"
		
		НоваяСтрокаОперации.Ключ         = ВидЗадолженностиОперации.ИмяПредопределенныхДанных + "/" + Выборка.СчетДоверительногоУправления.Наименование + "/" + Выборка.ЦеннаяБумага.Наименование + "/" + Выборка.Volume;
		НоваяСтрокаОперации.Описание     = "Оплата / " + ВидЗадолженностиОперации + " / " + Выборка.Record_UID + " / " + Выборка.ЦеннаяБумага;
				
		Основания = Новый Массив;								
		Основания.Добавить(РеквизитыОснования);
									
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, Основания", РеквизитыШапки, Основания);
		
	КонецЦикла;
			
	Для каждого СтрокаТекущиеОперации Из ТекущиеОперации Цикл
		СтрокаТекущиеОперации.Ключ = СтрокаТекущиеОперации.Ключ + "/" + СтрокаТекущиеОперации.НаименованиеСчета + "/" + СтрокаТекущиеОперации.ЦеннаяБумагаНаименование + "/" + СтрокаТекущиеОперации.Количество;
	КонецЦикла;
	
	ИсключитьИзСверки = "Дата";
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьВариационнуюМаржу_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Маржа, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_Money_Operations.Record_UID) КАК Record_UID,
		|	СУММА(ВЫБОР
		|			КОГДА _Money_Operations.Direction = ""-1""
		|				ТОГДА -_Money_Operations.Payment_Amount
		|			КОГДА _Money_Operations.Direction = ""1""
		|				ТОГДА _Money_Operations.Payment_Amount
		|		КОНЕЦ) КАК Сумма,
		|	_Money_Operations.Security_ID КАК Security_ID,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага,
		|	_ЦенныеБумаги.Code КАК КодБумаги,
		|	_Валюты.Валюта КАК ВалютаОплаты,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number КАК КодУБрокера,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций КАК КодДляСверкиОпераций
		|ИЗ
		|	_Money_Operations КАК _Money_Operations
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Money_Operations.Ключ = _ДанныеПервыхУзлов.Ключ
		|			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
		|		ПО _Money_Operations.Security_ID = _ЦенныеБумаги.Matrix_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
		|		ПО _Money_Operations.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _Money_Operations.Payment_Currency_Code = _Валюты.ISO_Code
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Money_Operations.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|ГДЕ
		|	_Money_Operations.Date = &Дата
		|	И _Money_Operations.Origin_Operation_Type В (""Operations.Group.Payments.VariationMarginRevaluation"", ""Operations.Group.Settlements.VariationMargin"")
		|	И НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	_Money_Operations.Security_ID,
		|	_МестаХраненияДенежныхСредств.Ссылка,
		|	_ЦенныеБумаги.Ссылка,
		|	_ЦенныеБумаги.Code,
		|	_Валюты.Валюта,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций
		|
		|УПОРЯДОЧИТЬ ПО
		|	КодБумаги
		|ИТОГИ ПО
		|	СчетДоверительногоУправления";
#КонецОбласти

	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
		
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
	Пока ГруппировкаПоСчету.Следующий() Цикл
				
		ВыборкаЗаписей = ГруппировкаПоСчету.Выбрать();
				
	    НомерСтроки = 0;
								
		Пока ВыборкаЗаписей.Следующий() Цикл
			
			Если НомерСтроки = 0 Тогда
				
				ОшибкиЧтения = Новый Массив;
			
				НоваяСтрокаОперации = Операции.Добавить();
				НоваяСтрокаОперации.Ключ         = ВыборкаЗаписей.КодДляСверкиОпераций;
				НоваяСтрокаОперации.Описание     = "Вариационная маржа, " + ВыборкаЗаписей.Record_UID + ", " + ВыборкаЗаписей.Сумма;
				НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
				НоваяСтрокаОперации.Статус       = "Новый";
				НоваяСтрокаОперации.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
						
				РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
				РеквизитыШапки.Проведен                     = Истина;
				РеквизитыШапки.ПометкаУдаления              = Ложь;
				РеквизитыШапки.Дата                         = ЭтотОбъект.ДатаИмпорта + (19 * 60 * 60);
				РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
				РеквизитыШапки.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
				РеквизитыШапки.Брокер                       = Брокер;
				РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
				РеквизитыШапки.МестоХранения                = ВыборкаЗаписей.МестоХраненияДенежныхСредств;
				РеквизитыШапки.ОтложеннаяОплата 			= Ложь;
				РеквизитыШапки.ВалютаОплаты                 = ВыборкаЗаписей.ВалютаОплаты;
				РеквизитыШапки.Сумма                        = 0;
				
				Инструменты = Новый Массив;
				НоваяСтрокаОперации.НовыеРеквизиты          = Новый Структура("Шапка, Инструменты", РеквизитыШапки, Инструменты);
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;
			
			РеквизитыИнструменты = Новый Структура(ПоляДокумента.Инструменты);
			РеквизитыИнструменты.НомерСтроки = НомерСтроки;
			РеквизитыИнструменты.Сумма       = ВыборкаЗаписей.Сумма;
			
			Если ЗначениеЗаполнено(ВыборкаЗаписей.ЦеннаяБумага) Тогда
				РеквизитыИнструменты.Инструмент = ВыборкаЗаписей.ЦеннаяБумага;
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить ценную бумагу по коду во внешней системе [" + ВыборкаЗаписей.Security_ID + "]!");
			КонецЕсли;
			
			РеквизитыШапки.Сумма = РеквизитыШапки.Сумма + РеквизитыИнструменты.Сумма;
			
			Инструменты.Добавить(РеквизитыИнструменты);		
			
			Если ОшибкиЧтения.Количество() > 0 Тогда
				НоваяСтрокаОперации.Статус = "Ошибка чтения";
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;

#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыСчетовУБрокера.КодДляСверкиОпераций КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Маржа КАК Маржа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыСчетовУБрокера КАК _КодыСчетовУБрокера
		|		ПО Маржа.СчетДоверительногоУправления = _КодыСчетовУБрокера.СчетДоверительногоУправления
		|ГДЕ
		|	Маржа.Организация = &Организация
		|	И НЕ Маржа.ПометкаУдаления
		|	И Маржа.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И Маржа.Брокер = &Брокер
		|	И НЕ Маржа.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|	И НЕ Маржа.РынокСПФИ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
#КонецОбласти
								
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, Запрос.Выполнить().Выгрузить(), ПоляДокумента);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьМаржуСПФИ_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Маржа, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(_Money_OperationsDepositMargin.Record_UID) КАК Record_UID,
		|	СУММА(ВЫБОР
		|			КОГДА _Money_OperationsDepositMargin.Direction = ""-1""
		|				ТОГДА -_Money_OperationsDepositMargin.Payment_Amount
		|			КОГДА _Money_OperationsDepositMargin.Direction = ""1""
		|				ТОГДА _Money_OperationsDepositMargin.Payment_Amount
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА _Money_Operations.Direction = ""-1""
		|				ТОГДА -_Money_Operations.Payment_Amount
		|			КОГДА _Money_Operations.Direction = ""1""
		|				ТОГДА _Money_Operations.Payment_Amount
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Процент,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number КАК КодУБрокера,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций КАК КодДляСверкиОпераций,
		|	_Валюты.Валюта КАК ВалютаОплаты,
		|	ЕСТЬNULL(_МестаХраненияДенежныхСредств.Ссылка, """") КАК МестоХраненияДенежныхСредств,
		|	ЕСТЬNULL(_Money_OperationsDepositMargin.Security_ID, """") КАК Security_ID,
		|	МАКСИМУМ(СделкаСПФИ.Ссылка) КАК СсылкаСПФИ,
		|	_Money_OperationsDepositMargin.Market_Number КАК Market_Number
		|ИЗ
		|	_Money_Operations КАК _Money_OperationsDepositMargin
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Money_OperationsDepositMargin.Ключ = _ДанныеПервыхУзлов.Ключ
		|			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Money_Operations КАК _Money_Operations
		|		ПО _Money_OperationsDepositMargin.Date = _Money_Operations.Date
		|			И _Money_OperationsDepositMargin.Client_ID = _Money_Operations.Client_ID
		|			И _Money_OperationsDepositMargin.Inner_Account_Division_ID = _Money_Operations.Inner_Account_Division_ID
		|			И _Money_OperationsDepositMargin.Market_Number = _Money_Operations.Market_Number
		|			И (_Money_Operations.Origin_Operation_Type В (""Operations.Group.Payments.VariationMarginRevaluation"", ""Operations.Group.Settlements.VariationMargin"", ""Operations.Group.Payments.Percents""))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
		|		ПО _Money_OperationsDepositMargin.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _Money_OperationsDepositMargin.Payment_Currency_Code = _Валюты.ISO_Code
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Money_OperationsDepositMargin.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСПФИ КАК СделкаСПФИ
		|		ПО _Money_OperationsDepositMargin.Market_Number = СделкаСПФИ.НомерСделки
		|			И (НЕ СделкаСПФИ.ПометкаУдаления)
		|ГДЕ
		|	_Money_OperationsDepositMargin.Date = &Дата
		|	И _Money_OperationsDepositMargin.Origin_Operation_Type В (""Operations.Group.Payments.DepositMargin"")
		|	И _Money_OperationsDepositMargin.Money_Storage_Place = ""MICEX""
		|	И НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	_Money_Operations.Security_ID,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number,
		|	_Валюты.Валюта,
		|	_МестаХраненияДенежныхСредств.Ссылка,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций,
		|	_Money_OperationsDepositMargin.Security_ID,
		|	_Money_OperationsDepositMargin.Market_Number
		|ИТОГИ ПО
		|	СчетДоверительногоУправления";
	
#КонецОбласти

	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
		
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
	Пока ГруппировкаПоСчету.Следующий() Цикл
				
		ВыборкаЗаписей = ГруппировкаПоСчету.Выбрать();
				
	    НомерСтроки = 0;
								
		Пока ВыборкаЗаписей.Следующий() Цикл
			
			Если НомерСтроки = 0 Тогда
				
				ОшибкиЧтения = Новый Массив;
			
				НоваяСтрокаОперации = Операции.Добавить();
				НоваяСтрокаОперации.Ключ         = ВыборкаЗаписей.КодДляСверкиОпераций;
				НоваяСтрокаОперации.Описание     = "Вариационная маржа, " + ВыборкаЗаписей.Record_UID + ", " + ВыборкаЗаписей.Сумма;
				НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
				НоваяСтрокаОперации.Статус       = "Новый";
				НоваяСтрокаОперации.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
						
				РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
				РеквизитыШапки.Проведен                     = Истина;
				РеквизитыШапки.ПометкаУдаления              = Ложь;
				РеквизитыШапки.Дата                         = ЭтотОбъект.ДатаИмпорта + (19 * 60 * 60);
				РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
				РеквизитыШапки.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
				РеквизитыШапки.Брокер                       = Брокер;
				РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
				РеквизитыШапки.МестоХранения                = ВыборкаЗаписей.МестоХраненияДенежныхСредств;
				РеквизитыШапки.ОтложеннаяОплата 			= Ложь;
				РеквизитыШапки.ВалютаОплаты                 = ВыборкаЗаписей.ВалютаОплаты;
				РеквизитыШапки.Сумма                        = 0;
				РеквизитыШапки.РынокСПФИ                    = Истина;
				
				Инструменты = Новый Массив;
				НоваяСтрокаОперации.НовыеРеквизиты          = Новый Структура("Шапка, Инструменты", РеквизитыШапки, Инструменты);
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;
			
			РеквизитыИнструменты = Новый Структура(ПоляДокумента.Инструменты);
			РеквизитыИнструменты.НомерСтроки = НомерСтроки;
			РеквизитыИнструменты.Сумма       = ВыборкаЗаписей.Сумма;
			РеквизитыИнструменты.Процент     = ВыборкаЗаписей.Процент;
			
			Если ЗначениеЗаполнено(ВыборкаЗаписей.СсылкаСПФИ) Тогда
				РеквизитыИнструменты.Инструмент = ВыборкаЗаписей.СсылкаСПФИ;
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить сделку СПФИ [" + ВыборкаЗаписей.Market_Number + "]!");
			КонецЕсли;
			
			РеквизитыШапки.Сумма = РеквизитыШапки.Сумма + РеквизитыИнструменты.Сумма;
			
			Инструменты.Добавить(РеквизитыИнструменты);		
			
			Если ОшибкиЧтения.Количество() > 0 Тогда
				НоваяСтрокаОперации.Статус = "Ошибка чтения";
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;

#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодыСчетовУБрокера.КодДляСверкиОпераций КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Маржа КАК Маржа
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыСчетовУБрокера КАК _КодыСчетовУБрокера
		|		ПО Маржа.СчетДоверительногоУправления = _КодыСчетовУБрокера.СчетДоверительногоУправления
		|ГДЕ
		|	Маржа.Организация = &Организация
		|	И НЕ Маржа.ПометкаУдаления
		|	И Маржа.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И Маржа.Брокер = &Брокер
		|	И НЕ Маржа.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|	И Маржа.РынокСПФИ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
#КонецОбласти
								
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, Запрос.Выполнить().Выгрузить(), ПоляДокумента);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьВнебиржевыеСделки_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Сделка, Операции, ПоляДокумента);
	
	ГруппаИмпортируемыхОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("OTC");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Deals_With_Details.Record_UID КАК Record_UID,
		|	_Deals_With_Details.Date КАК ДатаСделки,
		|	_Deals_With_Details.Time КАК ВремяСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаздельноеИсполнение,
		|	_Deals_With_Details.Payment_Date КАК ДатаОплаты,
		|	_Deals_With_Details.Delivery_Date КАК ДатаПоставки,
		|	_Deals_With_Details.Payment_Rate КАК Курс,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Rate > 0
		|				И _Deals_With_Details.Is_Payment_Rate_Fixed = ""1""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СобственныйКурсОплаты,
		|	_Deals_With_Details.PSA_Settlement_Type КАК PSA_Settlement_Type,
		|	_Deals_With_Details.Security_ID КАК Security_ID,
		|	_Deals_With_Details.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Deals_With_Details.Рынок КАК Рынок,
		|	_Deals_With_Details.ВалютаСделки КАК ВалютаСделки,
	    |	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Deals_With_Details.Partner_ID КАК Partner_ID,
		|	ЕСТЬNULL(_Deals_With_Details.КонтрагентСсылка, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) КАК Контрагент,
		|	_Deals_With_Details.SettleCode КАК SettleCode,
		|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок) КАК МестоХраненияДенежныхСредств,
		|	_Deals_With_Details.Depo_Storage_Place КАК Depo_Storage_Place,
		|	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
		|	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
		|	_Deals_With_Details.Price КАК Цена,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|				ИЛИ _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА _Deals_With_Details.Price_Percent
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаПроцент,
		|	_Deals_With_Details.Volume КАК Количество,
		|	_Deals_With_Details.Amount КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКупона,
		|	_Deals_With_Details.Order_Number КАК НомерПоручения,
		|	_Deals_With_Details.Order_Date КАК ДатаПоручения
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _Deals_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
		|			И _Deals_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
		|ГДЕ
		|	_Deals_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"", ""Operations.Group.Deals.IPO"")
		|	И НЕ _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Валюты
		|	И _Deals_With_Details.Is_Deal_Info = ""0""
		|	И _Deals_With_Details.Market = ""OTC""
		|	И _Deals_With_Details.Date = &НачалоПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Record_UID
		|ИТОГИ ПО
		|	СчетДоверительногоУправления,
		|	Record_UID";
		
#КонецОбласти

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
	Пока ГруппировкаПоСчету.Следующий() Цикл
				
		ГруппировкаПоСделке = ГруппировкаПоСчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ГруппировкаПоСделке.Следующий() Цикл

	    	ДетальныеЗаписи = ГруппировкаПоСделке.Выбрать();
			
			НомерСтроки = 0;
			
			Пока ДетальныеЗаписи.Следующий() Цикл
				
				Если НомерСтроки = 0 Тогда
					
					ОшибкиЧтения = Новый Массив;
		
					НоваяСтрокаОперации = Операции.Добавить();
					НоваяСтрокаОперации.Ключ         = ДетальныеЗаписи.Record_UID;
					НоваяСтрокаОперации.Описание     = "Внебирж. сделка, " + ДетальныеЗаписи.Record_UID + " [" + Строка(ДетальныеЗаписи.ВидСделки) + "] " + ДетальныеЗаписи.ЦеннаяБумага;
					НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
					НоваяСтрокаОперации.Статус       = "Новый";
					НоваяСтрокаОперации.СчетДоверительногоУправления = ДетальныеЗаписи.СчетДоверительногоУправления;
					
					НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
					Справочники.ВнешниеСистемы.Матрих, ГруппаИмпортируемыхОбъектов, ДетальныеЗаписи.Record_UID);	
					
					РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
					РеквизитыШапки.Проведен                     = Истина;
					РеквизитыШапки.ПометкаУдаления              = Ложь;
					РеквизитыШапки.Дата                         = ДетальныеЗаписи.ДатаСделки + (ДетальныеЗаписи.ВремяСделки - Дата(1, 1, 1));
					РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
					РеквизитыШапки.ВидСделки                    = ДетальныеЗаписи.ВидСделки;
					РеквизитыШапки.Рынок                        = ДетальныеЗаписи.Рынок;
					РеквизитыШапки.Брокер                       = Брокер;
					РеквизитыШапки.МестоХранения                = ДетальныеЗаписи.МестоХраненияДенежныхСредств;
					РеквизитыШапки.СчетДоверительногоУправления = ДетальныеЗаписи.СчетДоверительногоУправления;
					РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
					РеквизитыШапки.ВалютаСделки                 = ДетальныеЗаписи.ВалютаСделки;
					РеквизитыШапки.НомерСделки                  = "";
					РеквизитыШапки.ВремяСделки                  = Дата(1, 1, 1);
					РеквизитыШапки.КодРасчетовНаБирже           = "";
					РеквизитыШапки.НеполныеЛоты                 = Ложь;
					РеквизитыШапки.РежимПереговорныхСделок      = Ложь;
					РеквизитыШапки.ВыкупЭмитентом               = Ложь;
					РеквизитыШапки.ПервичноеРазмещение          = Ложь;
					РеквизитыШапки.РасчетныйСчетКонтрагента     = Справочники.БанковскиеСчета.ПустаяСсылка();
					РеквизитыШапки.НомерДоговораКонтрагента     = "";
					РеквизитыШапки.Договор                 		= Справочники.Договоры.ПустаяСсылка();
					РеквизитыШапки.ОтложенноеИсполнение         = Истина;
					РеквизитыШапки.ДатаИсполнения               = Дата(1,1,1);
					РеквизитыШапки.РаздельноеИсполнение         = Истина;
					РеквизитыШапки.ДатаОплаты                   = ДетальныеЗаписи.ДатаОплаты;
					РеквизитыШапки.ДатаПоставки                 = ДетальныеЗаписи.ДатаПоставки;
					РеквизитыШапки.ВалютаОплаты                 = ДетальныеЗаписи.ВалютаОплаты;
					РеквизитыШапки.СобственныйКурсОплаты        = ДетальныеЗаписи.СобственныйКурсОплаты;
					РеквизитыШапки.КурсОплаты                   = ?(ДетальныеЗаписи.ВалютаСделки <> ДетальныеЗаписи.ВалютаОплаты, ?(ДетальныеЗаписи.Курс > 0, ДетальныеЗаписи.Курс, ДетальныеЗаписи.ДатаОплаты), Неопределено);
					РеквизитыШапки.ВалютаТорговойКомиссии       = Справочники.Валюты.ПустаяСсылка();
					РеквизитыШапки.ПлатежноеУсловиеСделки       = СокрЛП(ДетальныеЗаписи.PSA_Settlement_Type);
					РеквизитыШапки.РежимБиржевыхТоргов			= Справочники.РежимыБиржевыхТоргов.ПустаяСсылка();
					РеквизитыШапки.ПриобретениеПаев				= Ложь;
					РеквизитыШапки.ДепозитарныйСчетКонтрагента	= Справочники.ДепозитарныеСчета.ПустаяСсылка();
					РеквизитыШапки.НомерПорученияУБрокера       = ДетальныеЗаписи.НомерПоручения;
					РеквизитыШапки.ДатаПорученияУБрокера        = ДетальныеЗаписи.ДатаПоручения;
					РеквизитыШапки.КонтрагентНаБирже            = "";
					
					Если ЗначениеЗаполнено(ДетальныеЗаписи.Partner_ID) И Не ЗначениеЗаполнено(ДетальныеЗаписи.Контрагент) Тогда
						ОшибкиЧтения.Добавить("Не удалось определить контрагента по матрих ID [" + ДетальныеЗаписи.Partner_ID + "]! Проверьте наличие кода в регистре [Коды во внешних системах].");	
					Иначе
						РеквизитыШапки.Контрагент = ДетальныеЗаписи.Контрагент;
					КонецЕсли;
					
					РеквизитыШапки.ОтложеннаяОплатаТорговойКомиссии = Ложь;
					РеквизитыШапки.ДатаОплатыТорговойКомиссии       = Дата(1, 1, 1);
					
					ЦенныеБумаги  = Новый Массив;
					
					НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги", РеквизитыШапки, ЦенныеБумаги);

				КонецЕсли;
				
				НомерСтроки = НомерСтроки + 1;
				РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
				РеквизитыЦенныеБумаги.НомерСтроки = НомерСтроки;
				
				Если ЗначениеЗаполнено(ДетальныеЗаписи.ЦеннаяБумага) Тогда
					РеквизитыЦенныеБумаги.ЦеннаяБумага = ДетальныеЗаписи.ЦеннаяБумага;
				Иначе
					ОшибкиЧтения.Добавить("В сделке [" + ДетальныеЗаписи.НомерСделки + "] не удалось определить ценную бумагу по коду во внешней системе. [" + ДетальныеЗаписи.Security_ID + "]!");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДетальныеЗаписи.ДепозитарныйСчет) Тогда
					РеквизитыЦенныеБумаги.ДепозитарныйСчет = ДетальныеЗаписи.ДепозитарныйСчет;
				Иначе
					Если ДетальныеЗаписи.КоличествоДепозитарныхСчетов = 0 Тогда
						ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(ДетальныеЗаписи.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + ДетальныеЗаписи.Depo_Storage_Place + "]!"));
					Иначе
						ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + ДетальныеЗаписи.КоличествоДепозитарныхСчетов + "]" + ?(ДетальныеЗаписи.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + ДетальныеЗаписи.Depo_Storage_Place + "]!"));
					КонецЕсли;
				КонецЕсли;

				РеквизитыЦенныеБумаги.Количество       = ?(ДетальныеЗаписи.Количество = 0, 1, ДетальныеЗаписи.Количество);
				РеквизитыЦенныеБумаги.Сумма            = ДетальныеЗаписи.Сумма;
				РеквизитыЦенныеБумаги.СуммаКупона      = ДетальныеЗаписи.СуммаКупона;
				РеквизитыЦенныеБумаги.Цена             = ДетальныеЗаписи.Цена;
				РеквизитыЦенныеБумаги.ЦенаПроцент      = ?(ЗначениеЗаполнено(ДетальныеЗаписи.ЦенаПроцент), ДетальныеЗаписи.ЦенаПроцент, 0);
				РеквизитыЦенныеБумаги.ЦенаКупона       = ?(ДетальныеЗаписи.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации, Окр(ДетальныеЗаписи.СуммаКупона / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги), 0);
				РеквизитыЦенныеБумаги.ТорговаяКомиссия = 0;
				
				ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
				
				Если ОшибкиЧтения.Количество() > 0 Тогда
					НоваяСтрокаОперации.Статус = "Ошибка чтения";
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнебиржевыеОперации.НомерОперации КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО Сделка.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И НЕ Сделка.ПометкаУдаления
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Сделка.Брокер = &Брокер
		|	И (Сделка.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ИЛИ Сделка.РежимБиржевыхТоргов.РежимВнебиржевыхСделок)
		|	И НЕ Сделка.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
#КонецОбласти

	ИсключитьИзСверки = "ЦенныеБумаги.ДепозитарныйСчет";
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, Запрос.Выполнить().Выгрузить(), ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьСделкиСПФИ_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.СделкаСПФИ, Операции, ПоляДокумента);
	
	ГруппаИмпортируемыхОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("OTC");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Deals_With_Details.Record_UID КАК Record_UID,
		|	_Deals_With_Details.Date КАК ДатаСделки,
	    |	_Deals_With_Details.Time КАК ВремяСделки,
	    |	_Deals_With_Details.Market_Number КАК НомерСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаздельноеИсполнение,
		|	_Deals_With_Details.Payment_Date КАК ДатаОплаты,
		|	_Deals_With_Details.Delivery_Date КАК ДатаПоставки,
		|	_Deals_With_Details.Payment_Rate КАК Курс,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Rate > 0
		|				И _Deals_With_Details.Is_Payment_Rate_Fixed = ""1""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СобственныйКурсОплаты,
		|	_Deals_With_Details.PSA_Settlement_Type КАК PSA_Settlement_Type,
		|	_Deals_With_Details.Security_ID КАК Security_ID,
		|	_Deals_With_Details.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Deals_With_Details.Рынок КАК Рынок,
		|	_Deals_With_Details.ВалютаСделки КАК ВалютаСделки,
	    |	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Deals_With_Details.Partner_ID КАК Partner_ID,
		|	ЕСТЬNULL(_Deals_With_Details.КонтрагентСсылка, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) КАК Контрагент,
		|	_Deals_With_Details.SettleCode КАК SettleCode,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_Deals_With_Details.Depo_Storage_Place КАК Depo_Storage_Place,
		|	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
		|	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
		|	_Deals_With_Details.SE_Charge_Amount КАК КлиринговыйСбор,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.SE_Charge_Date <> _Deals_With_Details.Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложеннаяОплатаКлиринговогоСбора,
		|	_Deals_With_Details.Amount КАК Номинал,
		|	_Deals_With_Details.Order_Number КАК НомерПоручения,
		|	_Deals_With_Details.Order_Date КАК ДатаПоручения,
		|	ЕСТЬNULL(_Derivatives.Date_Execution, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаИсполнения
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _Deals_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
		|			И _Deals_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Deals_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Derivatives КАК _Derivatives
		|		ПО _Deals_With_Details.Security_ID = _Derivatives.ID
		|ГДЕ
		|	_Deals_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"")
		|	И _Deals_With_Details.Is_Deal_Info = ""0""
		|	И _Deals_With_Details.Market_Board = ""NSDSPFINEG""
		|	И _Deals_With_Details.Date = &НачалоПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Record_UID
		|ИТОГИ ПО
		|	СчетДоверительногоУправления,
		|	Record_UID";
		
#КонецОбласти

	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
	Пока ГруппировкаПоСчету.Следующий() Цикл
				
		ГруппировкаПоСделке = ГруппировкаПоСчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ГруппировкаПоСделке.Следующий() Цикл

	    	ДетальныеЗаписи = ГруппировкаПоСделке.Выбрать();
			
			НомерСтроки = 0;
			
			Пока ДетальныеЗаписи.Следующий() Цикл
				
				Если НомерСтроки = 0 Тогда
					
					ОшибкиЧтения = Новый Массив;
		
					НоваяСтрокаОперации = Операции.Добавить();
					НоваяСтрокаОперации.Ключ         = ДетальныеЗаписи.НомерСделки;
					НоваяСтрокаОперации.Описание     = "Сделка СПФИ, " + ДетальныеЗаписи.НомерСделки + " [" + Строка(ДетальныеЗаписи.ВидСделки) + "]";
					НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
					НоваяСтрокаОперации.Статус       = "Новый";
					НоваяСтрокаОперации.СчетДоверительногоУправления = ДетальныеЗаписи.СчетДоверительногоУправления;
					
					НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
					Справочники.ВнешниеСистемы.Матрих, ГруппаИмпортируемыхОбъектов, ДетальныеЗаписи.Record_UID);	
					
					РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
					РеквизитыШапки.Проведен                     = Истина;
					РеквизитыШапки.ПометкаУдаления              = Ложь;
					РеквизитыШапки.Дата                         = ДетальныеЗаписи.ДатаСделки + (ДетальныеЗаписи.ВремяСделки - Дата(1, 1, 1));
					РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
					//РеквизитыШапки.ВидСделки                    = ДетальныеЗаписи.ВидСделки;
					РеквизитыШапки.Брокер                       = Брокер;
					РеквизитыШапки.МестоХранения                = ДетальныеЗаписи.МестоХраненияДенежныхСредств;
					РеквизитыШапки.СчетДоверительногоУправления = ДетальныеЗаписи.СчетДоверительногоУправления;
					РеквизитыШапки.Валюта             		    = ДетальныеЗаписи.ВалютаСделки;
					РеквизитыШапки.НомерСделки                  = ДетальныеЗаписи.НомерСделки;
					//РеквизитыШапки.ВремяСделки                  = ДетальныеЗаписи.ВремяСделки;
					РеквизитыШапки.Номинал					    = ДетальныеЗаписи.Номинал;
					РеквизитыШапки.Контрагент					= ДетальныеЗаписи.Контрагент;
					РеквизитыШапки.КлиринговыйСбор       		= ДетальныеЗаписи.КлиринговыйСбор;
					РеквизитыШапки.ОтложеннаяОплатаКлиринговогоСбора	= ДетальныеЗаписи.ОтложеннаяОплатаКлиринговогоСбора;
					РеквизитыШапки.ДатаИсполнения				= ДетальныеЗаписи.ДатаИсполнения;

					
					Если ЗначениеЗаполнено(ДетальныеЗаписи.Partner_ID) И Не ЗначениеЗаполнено(ДетальныеЗаписи.Контрагент) Тогда
						ОшибкиЧтения.Добавить("Не удалось определить контрагента по матрих ID [" + ДетальныеЗаписи.Partner_ID + "]! Проверьте наличие кода в регистре [Коды во внешних системах].");	
					Иначе
						РеквизитыШапки.Контрагент = ДетальныеЗаписи.Контрагент;
					КонецЕсли;
					
					НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка", РеквизитыШапки);

				КонецЕсли;
				
				НомерСтроки = НомерСтроки + 1;
				
				Если ОшибкиЧтения.Количество() > 0 Тогда
					НоваяСтрокаОперации.Статус = "Ошибка чтения";
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СделкаСПФИ.НомерСделки КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.СделкаСПФИ КАК СделкаСПФИ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО СделкаСПФИ.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	СделкаСПФИ.Организация = &Организация
		|	И НЕ СделкаСПФИ.ПометкаУдаления
		|	И СделкаСПФИ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СделкаСПФИ.Брокер = &Брокер
		|	И НЕ СделкаСПФИ.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
#КонецОбласти

	ИсключитьИзСверки = "";
	//ИсключитьИзСверки = "ЦенныеБумаги.ДепозитарныйСчет";
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, Запрос.Выполнить().Выгрузить(), ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьВнебиржевыеСделкиРЕПО_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.СделкаРЕПО, Операции, ПоляДокумента);
	
	ГруппаИмпортируемыхОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("OTC_REPO");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Deals_With_Details.Record_UID КАК Record_UID,
		|	_Deals_With_Details.Date КАК ДатаСделки,
		|	_Deals_With_Details.Time КАК ВремяСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Date <> _Deals_With_Details.Payment_Date
		|				ИЛИ _Deals_With_Details.Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложенноеИсполнение,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаздельноеИсполнение,
		|	_Deals_With_Details.Payment_Date КАК ДатаОплаты,
		|	_Deals_With_Details.Delivery_Date КАК ДатаПоставки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Rate > 0
		|				И _Deals_With_Details.Is_Payment_Rate_Fixed = ""1""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СобственныйКурсОплаты,
		|	_Deals_With_Details.Payment_Rate КАК Курс,
		|	_Deals_With_Details.Far_Execution_Date КАК ДатаВторойЧастиРЕПО,
		|	_Deals_With_Details.Far_Interest_Rate КАК СтавкаРЕПО,
		|	_Deals_With_Details.PSA_Settlement_Type КАК PSA_Settlement_Type,
		|	_Deals_With_Details.Security_ID КАК Security_ID,
		|	_Deals_With_Details.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_НоминалыЦенныхБумаг.Номинал КАК Номинал,
		|	_КурсыВалют.КурсВалютыОплаты / (_КурсыВалют.КратностьКурсаВалютыОплаты * _НоминалыЦенныхБумаг.КратностьКурсаВалютыНоминала * _НоминалыЦенныхБумаг.КурсВалютыНоминала) КАК КоэффициентКонвертации,
		|	_Deals_With_Details.Рынок КАК Рынок,
		|	_Deals_With_Details.ВалютаСделки КАК ВалютаСделки,
		|	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Deals_With_Details.Partner_ID КАК Partner_ID,
		|	ЕСТЬNULL(_Deals_With_Details.КонтрагентСсылка, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) КАК Контрагент,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_Deals_With_Details.Depo_Storage_Place КАК Depo_Storage_Place,
		|	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
		|	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
		|	_Deals_With_Details.Price КАК Цена,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.Price_Percent
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаПроцент,
		|	_Deals_With_Details.Volume КАК Количество,
		|	_Deals_With_Details.Amount КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКупона,
		|	_Deals_With_Details.Far_Price КАК ЦенаВторойЧасти,
		|	_Deals_With_Details.Far_Amount КАК СуммаВторойЧасти,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.Far_ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКупонаВторойЧасти,
		|	_Deals_With_Details.Order_Number КАК НомерПоручения,
		|	_Deals_With_Details.Order_Date КАК ДатаПоручения
		|ПОМЕСТИТЬ _ВнебиржевыеСделкиРЕПОВнешниеДанные
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _Deals_With_Details.ВалютаОплаты = _КурсыВалют.ВалютаОплаты
		|			И _Deals_With_Details.ДатаСделки = _КурсыВалют.ДатаСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Deals_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _Deals_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
		|			И _Deals_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НоминалыЦенныхБумаг КАК _НоминалыЦенныхБумаг
		|		ПО _Deals_With_Details.ЦеннаяБумага = _НоминалыЦенныхБумаг.ЦеннаяБумага
		|			И _Deals_With_Details.ДатаСделки = _НоминалыЦенныхБумаг.ДатаСделки
		|ГДЕ
		|	_Deals_With_Details.Operation_Type = ""Operations.Group.Deals.REPO""
		|	И _Deals_With_Details.Is_Deal_Info = ""0""
		|	И _Deals_With_Details.Market = ""OTC""
		|	И _Deals_With_Details.Date = &НачалоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнебиржевыеОперации.НомерОперации КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО СделкаРЕПО.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	СделкаРЕПО.Организация = &Организация
		|	И НЕ СделкаРЕПО.ПометкаУдаления
		|	И СделкаРЕПО.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СделкаРЕПО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И СделкаРЕПО.Брокер = &Брокер
		|	И НЕ СделкаРЕПО.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";
#КонецОбласти		

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	
	ВнебиржевыеСделкиРЕПОДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ВнебиржевыеСделкиРЕПОВнешниеДанные"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Выборка.Record_UID;
		НоваяСтрокаОперации.Описание     = "Внебирж. сделка РЕПО, " + Выборка.Record_UID + " [" + Строка(Выборка.ВидСделки) + "] " + Выборка.ЦеннаяБумага + ", " + Выборка.Количество;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
			Справочники.ВнешниеСистемы.Матрих, ГруппаИмпортируемыхОбъектов, Выборка.Record_UID);
			
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = Выборка.ДатаСделки + (Выборка.ВремяСделки - Дата(1, 1, 1));
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.ВидСделки                    = Выборка.ВидСделки;
		РеквизитыШапки.ДвеЧастиСделкиРЕПО           = Ложь;
		РеквизитыШапки.ЧастьСделкиРЕПО              = 0;
		РеквизитыШапки.ДатаВторойЧастиРЕПО          = Дата(1, 1, 1);
		РеквизитыШапки.ПерваяЧастьРЕПО              = Документы.СделкаРЕПО.ПустаяСсылка();
		РеквизитыШапки.СтавкаРЕПО                   = Число(Выборка.СтавкаРЕПО);
		РеквизитыШапки.БазаРасчетаПроцентов         = 0;
		РеквизитыШапки.Брокер                       = Брокер;
		РеквизитыШапки.МестоХранения                = Выборка.МестоХраненияДенежныхСредств;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.ВалютаСделки                 = Выборка.ВалютаСделки;
		РеквизитыШапки.ВремяСделки                  = Дата(1, 1, 1);
		РеквизитыШапки.КодРасчетовНаБирже           = "";
		РеквизитыШапки.НеполныеЛоты                 = Ложь;
		РеквизитыШапки.НомерПорученияУБрокера       = Выборка.НомерПоручения;
		РеквизитыШапки.ДатаПорученияУБрокера        = Выборка.ДатаПоручения;
		
		Если ЗначениеЗаполнено(Выборка.Partner_ID) И Не ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			ОшибкиЧтения.Добавить("Не удалось определить контрагента по матрих ID [" + Выборка.Partner_ID + "]! Проверьте наличие кода в регистре [Коды во внешних системах].");	
		Иначе
			РеквизитыШапки.Контрагент = Выборка.Контрагент;
		КонецЕсли;
						
		РеквизитыШапки.РасчетныйСчетКонтрагента = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.НомерДоговораКонтрагента = "";
		РеквизитыШапки.Договор                  = Справочники.Договоры.ПустаяСсылка();
		РеквизитыШапки.ПлатежноеУсловиеСделки   = СокрЛП(Выборка.PSA_Settlement_Type);
		РеквизитыШапки.РежимБиржевыхТоргов	    = Справочники.РежимыБиржевыхТоргов.ПустаяСсылка();
		РеквизитыШапки.Рынок                    = Выборка.Рынок;

		РеквизитыШапки.СделкаСЦентральнымКонтрагентом      = Ложь;
		РеквизитыШапки.НомерСделки                         = "";
		РеквизитыШапки.НомерСделкиСЦентральнымКонтрагентом = "";
		
		РеквизитыШапки.ОтложенноеИсполнение  = Истина;
		РеквизитыШапки.РаздельноеИсполнение  = Истина;
		РеквизитыШапки.ДатаИсполнения        = Дата(1, 1, 1);
		РеквизитыШапки.ДатаОплаты            = Выборка.ДатаОплаты;
		РеквизитыШапки.ДатаПоставки          = Выборка.ДатаПоставки;
		РеквизитыШапки.ВалютаОплаты          = Выборка.ВалютаОплаты;
		РеквизитыШапки.СобственныйКурсОплаты = Выборка.СобственныйКурсОплаты;
		РеквизитыШапки.КурсОплаты            = ?(Выборка.ВалютаСделки <> Выборка.ВалютаОплаты, ?(Выборка.Курс > 0, Выборка.Курс, Выборка.ДатаОплаты), Неопределено);
		
		РеквизитыШапки.ОтложенноеИсполнениеВторойЧасти  = Истина;
		РеквизитыШапки.РаздельноеИсполнениеВторойЧасти  = Истина;
		РеквизитыШапки.ДатаИсполненияВторойЧасти        = Дата(1, 1, 1);
		РеквизитыШапки.ДатаОплатыВторойЧасти            = Выборка.ДатаВторойЧастиРЕПО;
		РеквизитыШапки.ДатаПоставкиВторойЧасти          = Выборка.ДатаВторойЧастиРЕПО;
		РеквизитыШапки.ВалютаОплатыВторойЧасти          = Выборка.ВалютаОплаты;
		РеквизитыШапки.СобственныйКурсОплатыВторойЧасти = Выборка.СобственныйКурсОплаты;
		РеквизитыШапки.КурсОплатыВторойЧасти            = ?(Выборка.ВалютаСделки <> Выборка.ВалютаОплаты, ?(Выборка.Курс > 0, Выборка.Курс, РеквизитыШапки.ДатаВторойЧастиРЕПО), Неопределено);
				
		РеквизитыШапки.ОтложеннаяОплатаТорговойКомиссии = Ложь;
		РеквизитыШапки.ДатаОплатыТорговойКомиссии       = Дата(1, 1, 1);
		РеквизитыШапки.ВалютаТорговойКомиссии           = Справочники.Валюты.ПустаяСсылка();
		РеквизитыШапки.КонтрагентНабирже                = "";
		РеквизитыШапки.Дисконт                          = 0;
				
		// ценные бумаги 1-й части
		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		РеквизитыЦенныеБумаги.НомерСтроки = 1;
		
		Если ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
			РеквизитыЦенныеБумаги.ЦеннаяБумага     = Выборка.ЦеннаяБумага;
		Иначе
			ОшибкиЧтения.Добавить("Внебиржевая сделка Репо [" + Выборка.Record_UID + "]. Не удалось определить ценную бумагу по коду во внешней системе. [" + Выборка.Security_ID + "]!");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
		Иначе
			Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
			КонецЕсли;
		КонецЕсли;

		РеквизитыЦенныеБумаги.Количество       = ?(Выборка.Количество = 0, 1, Выборка.Количество);
		РеквизитыЦенныеБумаги.Сумма            = Выборка.Сумма;
		РеквизитыЦенныеБумаги.СуммаКупона      = Выборка.СуммаКупона;
		РеквизитыЦенныеБумаги.Цена             = Выборка.Цена;
		РеквизитыЦенныеБумаги.ЦенаПроцент      = Выборка.ЦенаПроцент;
		РеквизитыЦенныеБумаги.ЦенаКупона       = ?(Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации, Окр(Выборка.СуммаКупона / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги), 0);
		РеквизитыЦенныеБумаги.ТорговаяКомиссия = 0;
				
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		// ценные бумаги 2-й части
		ЦенныеБумагиВторойЧасти = Новый Массив;
		
		РеквизитыЦенныеБумагиВторойЧасти = Новый Структура(ПоляДокумента.ЦенныеБумагиВторойЧасти);
		ЗаполнитьЗначенияСвойств(РеквизитыЦенныеБумагиВторойЧасти, РеквизитыЦенныеБумаги, "НомерСтроки, ДепозитарныйСчет, ЦеннаяБумага, Количество");
		
		РеквизитыЦенныеБумагиВторойЧасти.Сумма       = Выборка.СуммаВторойЧасти;
		РеквизитыЦенныеБумагиВторойЧасти.СуммаКупона = Выборка.СуммаКупонаВторойЧасти;
		РеквизитыЦенныеБумагиВторойЧасти.Цена        = Выборка.ЦенаВторойЧасти;
		
		Если Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если Не ЗначениеЗаполнено(Выборка.Номинал) Тогда
				
				ОшибкиЧтения.Добавить("Не удалось рассчитать значение реквизита [ЦенаПроцент] второй части сделки, т.к. отсутствует значение номинала для бумаги [" + РеквизитыЦенныеБумагиВторойЧасти.ЦеннаяБумага + "]!");
				
			ИначеЕсли Не ЗначениеЗаполнено(Выборка.КоэффициентКонвертации) Тогда
				
				ВалютаНоминалаЦБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЦенныеБумагиВторойЧасти.ЦеннаяБумага, "ВалютаНоминала");

				ОшибкиЧтения.Добавить("Не удалось рассчитать значение реквизита [ЦенаПроцент] второй части сделки, т.к. не удалось определить курс конвертации валюты оплаты [" + Выборка.ВалютаОплаты + "] в валюту номинала [" + ВалютаНоминалаЦБ + "]. Возможно отсутствуют курсы валют на дату [" + Выборка.ДатаСделки + "]!");	
				
			Иначе
				
				РеквизитыЦенныеБумагиВторойЧасти.ЦенаПроцент = Окр(Выборка.ЦенаВторойЧасти * Выборка.КоэффициентКонвертации * 100 / Выборка.Номинал, 4);
	
			КонецЕсли;
			
			РеквизитыЦенныеБумагиВторойЧасти.ЦенаКупона = Окр(Выборка.СуммаКупонаВторойЧасти / РеквизитыЦенныеБумагиВторойЧасти.Количество, ТочностьЦеныЦеннойБумаги);
				
		Иначе
			РеквизитыЦенныеБумагиВторойЧасти.ЦенаПроцент = 0;
			РеквизитыЦенныеБумагиВторойЧасти.ЦенаКупона  = 0;	
		КонецЕсли;
			
		ЦенныеБумагиВторойЧасти.Добавить(РеквизитыЦенныеБумагиВторойЧасти);
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги, ЦенныеБумагиВторойЧасти", РеквизитыШапки, ЦенныеБумаги, ЦенныеБумагиВторойЧасти);
		
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;		
		
	КонецЦикла;
	
	ИсключитьИзСверки = "ЦенныеБумаги.ДепозитарныйСчет";
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ВнебиржевыеСделкиРЕПОДанныеСистемы, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьИзмененияСделок_OTBR(МВТ)
	
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.ИзменениеУсловийСделки, Операции, ПоляДокумента);
	
	ГруппаИмпортируемыхОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Deals_Changes");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Deals_With_Details.Record_UID КАК Record_UID,
		|	_Deals_With_Details.Record_UID КАК Parent_Record_UID,
		|	_Deals_With_Details.Date КАК ДатаСделки,
		|	_Deals_With_Details.Time КАК ВремяСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Date <> _Deals_With_Details.Payment_Date
		|				ИЛИ _Deals_With_Details.Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложенноеИсполнение,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаздельноеИсполнение,
		|	_Deals_With_Details.Payment_Date КАК ДатаОплаты,
		|	_Deals_With_Details.Delivery_Date КАК ДатаПоставки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Rate > 0
		|				И _Deals_With_Details.Is_Payment_Rate_Fixed = ""1""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СобственныйКурсОплаты,
		|	_Deals_With_Details.Payment_Rate КАК Курс,
		|	_Deals_With_Details.PSA_Settlement_Type КАК PSA_Settlement_Type,
		|	_Deals_With_Details.Security_ID КАК Security_ID,
		|	_Deals_With_Details.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Deals_With_Details.Рынок КАК Рынок,		
		|	_Deals_With_Details.ВалютаСделки КАК ВалютаСделки,
	    |	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_Deals_With_Details.КонтрагентСсылка, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) КАК Контрагент,
		|	_ВнебиржевыеОперации.Объект КАК Основание,
		|	_Deals_With_Details.SettleCode КАК SettleCode,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_Deals_With_Details.Depo_Storage_Place КАК Depo_Storage_Place,
		|	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
		|	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
		|	_Deals_With_Details.Price КАК Цена,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|				ИЛИ _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА _Deals_With_Details.Price_Percent
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаПроцент,
		|	_Deals_With_Details.Volume КАК Количество,
		|	_Deals_With_Details.Amount КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКупона
		|ПОМЕСТИТЬ _ИзмененияСделокВнешниеДанные
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Deals_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _Deals_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
		|			И _Deals_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО _Deals_With_Details.Parent_Record_UID = _ВнебиржевыеОперации.НомерОперации
		|ГДЕ
		|	_Deals_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"", ""Operations.Group.Deals.IPO"")
		|	И _Deals_With_Details.Deal_Info_Type = ""Deals.Info.Type.Regular""
		|	И _Deals_With_Details.Is_Deal_Info = ""1""
		|	И _Deals_With_Details.Market = ""OTC""
		|	И _Deals_With_Details.Date = &НачалоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнебиржевыеОперации.НомерОперации КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.ИзменениеУсловийСделки КАК ИзменениеУсловийСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО ИзменениеУсловийСделки.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	ИзменениеУсловийСделки.Организация = &Организация
		|	И НЕ ИзменениеУсловийСделки.ПометкаУдаления
		|	И ИзменениеУсловийСделки.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ИзменениеУсловийСделки.Основание.Брокер = &Брокер
		|	И НЕ ИзменениеУсловийСделки.Основание ССЫЛКА Документ.СделкаРЕПО
		|	И НЕ ИзменениеУсловийСделки.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
		
	ИзмененияСделокДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ИзмененияСделокВнешниеДанные"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
						
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Выборка.Record_UID;
		НоваяСтрокаОперации.Описание     = "Изм. сделки, " + Выборка.Record_UID + " [" + Выборка.ВидСделки + "] " + Выборка.ЦеннаяБумага;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;

		
		НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
			Справочники.ВнешниеСистемы.Матрих, ГруппаИмпортируемыхОбъектов, Выборка.Record_UID);
		
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.Дата                         = ?(ЗначениеЗаполнено(Выборка.Основание) И НачалоДня(Выборка.Основание.Дата) = ЭтотОбъект.ДатаИмпорта, Выборка.Основание.Дата + 1, ЭтотОбъект.ДатаИмпорта + (9 * 60 + 29) * 60);
		РеквизитыШапки.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоСделке;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.ДатаИсполнения               = Дата(1, 1, 1);
		РеквизитыШапки.ДатаОплаты                   = Выборка.ДатаОплаты;
		РеквизитыШапки.ДатаПоставки                 = Выборка.ДатаПоставки;
		РеквизитыШапки.ДатаВторойЧастиРЕПО			= Дата(1, 1, 1);
		РеквизитыШапки.ВалютаОплаты					= Выборка.ВалютаОплаты;
		РеквизитыШапки.СобственныйКурсОплаты        = Выборка.СобственныйКурсОплаты;
		РеквизитыШапки.КурсОплаты                   = ?(Выборка.ВалютаСделки <> Выборка.ВалютаОплаты, ?(Выборка.Курс > 0, Выборка.Курс, Выборка.ДатаОплаты), Неопределено);
		РеквизитыШапки.ВозвратныйКупонКЗачету		= 0;
		РеквизитыШапки.Рынок                        = Выборка.Рынок;
		РеквизитыШапки.ПлатежноеУсловиеСделки       = СокрЛП(Выборка.PSA_Settlement_Type);
		РеквизитыШапки.СтавкаРЕПО                   = 0;
		
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			РеквизитыШапки.Основание = Выборка.Основание;
		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить сделку основание по коду матрих [" + Выборка.Parent_Record_UID + "]");
		КонецЕсли;
		
		РеквизитыШапки.ВалютаЗадолженностиПоКупону		 = Справочники.Валюты.ПустаяСсылка();
		РеквизитыШапки.СуммаЗаймаКПогашениюВВалютеСделки = 0;
				
		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		РеквизитыЦенныеБумаги.НомерСтроки = 1;
		РеквизитыЦенныеБумаги.Исполнено   = Ложь;
		
		Если ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
			РеквизитыЦенныеБумаги.ЦеннаяБумага = Выборка.ЦеннаяБумага;
		Иначе
			ОшибкиЧтения.Добавить("Изменение условий сделки [" + Выборка.Record_UID + "]. Не удалось определить ценную бумагу по коду во внешней системе. [" + Выборка.Security_ID + "]!");
		КонецЕсли;
		 
		Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
		Иначе
			Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
			КонецЕсли;
		КонецЕсли;

		РеквизитыЦенныеБумаги.Количество  = ?(Выборка.Количество = 0, 1, Выборка.Количество);
		РеквизитыЦенныеБумаги.ЦенаПроцент = Выборка.ЦенаПроцент;				
		РеквизитыЦенныеБумаги.Сумма       = Выборка.Сумма;
		РеквизитыЦенныеБумаги.СуммаКупона = Выборка.СуммаКупона;
		РеквизитыЦенныеБумаги.Цена        = Выборка.Цена;
		РеквизитыЦенныеБумаги.ЦенаКупона  = Окр(РеквизитыЦенныеБумаги.СуммаКупона / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги);
		
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги", РеквизитыШапки, ЦенныеБумаги);
				
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;		
		
	КонецЦикла;
	
	ИсключитьИзСверки = "Дата";	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ИзмененияСделокДанныеСистемы, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьИзмененияСделокРЕПО2_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.ИзменениеУсловийСделки, Операции, ПоляДокумента);
	
	ГруппаИмпортируемыхОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("REPO_Close_Changes");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Market_Number = """"
		|			ТОГДА _Deals_With_Details.Parent_Record_UID
		|		ИНАЧЕ _Deals_With_Details.Market_Number
		|	КОНЕЦ КАК НомерСделки,
		|	_Deals_With_Details.Parent_Record_UID КАК Parent_Record_UID,
		|	_Deals_With_Details.Date КАК ДатаСделки,
		|	_Deals_With_Details.Time КАК ВремяСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Date <> _Deals_With_Details.Payment_Date
		|				ИЛИ _Deals_With_Details.Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложенноеИсполнение,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаздельноеИсполнение,
		|	_Deals_With_Details.Payment_Date КАК ДатаОплаты,
		|	_Deals_With_Details.Delivery_Date КАК ДатаПоставки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Rate > 0
		|				И _Deals_With_Details.Is_Payment_Rate_Fixed = ""1""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СобственныйКурсОплаты,
		|	_Deals_With_Details.Payment_Rate КАК Курс,
		|	_Deals_With_Details.Far_Execution_Date КАК ДатаВторойЧастиРЕПО,
		|	_Deals_With_Details.Far_Interest_Rate КАК СтавкаРЕПО,
		|	_Deals_With_Details.PSA_Settlement_Type КАК PSA_Settlement_Type,
		|	_Deals_With_Details.Security_ID КАК Security_ID,
		|	_Deals_With_Details.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_НоминалыЦенныхБумаг.Номинал КАК Номинал,
		|	_КурсыВалют.КурсВалютыОплаты / (_КурсыВалют.КратностьКурсаВалютыОплаты * _НоминалыЦенныхБумаг.КратностьКурсаВалютыНоминала * _НоминалыЦенныхБумаг.КурсВалютыНоминала) КАК КоэффициентКонвертации,
		|	_Deals_With_Details.Рынок КАК Рынок,
		|	_Deals_With_Details.ВалютаСделки КАК ВалютаСделки,
		|	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_Deals_With_Details.КонтрагентСсылка, ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)) КАК Контрагент,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Market = ""OTC""
		|			ТОГДА _ВнебиржевыеОперации.Объект
		|		КОГДА _Deals_With_Details.Market = ""MICEX""
		|			ТОГДА СделкаРЕПО.Ссылка
		|	КОНЕЦ КАК Основание,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
		|	_Deals_With_Details.Depo_Storage_Place КАК Depo_Storage_Place,
		|	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
		|	_Deals_With_Details.Price КАК Цена,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.Price_Percent
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаПроцент,
		|	_Deals_With_Details.Volume КАК Количество,
		|	_Deals_With_Details.Amount КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКупона,
		|	_Deals_With_Details.Far_Price КАК ЦенаВторойЧасти,
		|	_Deals_With_Details.Far_Amount КАК СуммаВторойЧасти,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА _Deals_With_Details.Far_ACI_Amount
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СуммаКупонаВторойЧасти
		|ПОМЕСТИТЬ _ИзмененияСделокРЕПО2ВнешниеДанные
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
		|		ПО _Deals_With_Details.ВалютаОплаты = _КурсыВалют.ВалютаОплаты
		|			И _Deals_With_Details.ДатаСделки = _КурсыВалют.ДатаСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НоминалыЦенныхБумаг КАК _НоминалыЦенныхБумаг
		|		ПО _Deals_With_Details.ЦеннаяБумага = _НоминалыЦенныхБумаг.ЦеннаяБумага
		|			И _Deals_With_Details.ДатаСделки = _НоминалыЦенныхБумаг.ДатаСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Deals_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
		|		ПО _Deals_With_Details.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
		|			И _Deals_With_Details.Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО _Deals_With_Details.Parent_Record_UID = _ВнебиржевыеОперации.НомерОперации
		|			И (_Deals_With_Details.Market = ""OTC"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (ВЫБОР
		|				КОГДА СделкаРЕПО.СделкаСЦентральнымКонтрагентом
		|					ТОГДА _Deals_With_Details.Market_Number = СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом
		|				ИНАЧЕ _Deals_With_Details.Market_Number = СделкаРЕПО.НомерСделки
		|			КОНЕЦ)
		|			И (СделкаРЕПО.ЧастьСделкиРЕПО = 1)
		|			И (_Deals_With_Details.Operation_Type = ""Operations.Group.Deals.REPO"")
		|			И (_Deals_With_Details.Market = ""MICEX"")
		|ГДЕ
		|	_Deals_With_Details.Operation_Type = ""Operations.Group.Deals.REPO""
		|	И _Deals_With_Details.Deal_Info_Type В (""Deals.Info.Type.Regular"", ""Deals.Info.Type.Coupon"")
		|	И _Deals_With_Details.Is_Deal_Info = ""1""
		|	И _Deals_With_Details.Date = &НачалоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ВнебиржевыеОперации.НомерОперации ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА ИзменениеУсловийСделки.Основание ССЫЛКА Документ.СделкаРЕПО
		|							И ВЫРАЗИТЬ(ИзменениеУсловийСделки.Основание КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом
		|						ТОГДА ВЫРАЗИТЬ(ИзменениеУсловийСделки.Основание КАК Документ.СделкаРЕПО).НомерСделкиСЦентральнымКонтрагентом
		|					ИНАЧЕ ВЫРАЗИТЬ(ИзменениеУсловийСделки.Основание КАК Документ.СделкаРЕПО).НомерСделки
		|				КОНЕЦ
		|		ИНАЧЕ _ВнебиржевыеОперации.НомерОперации
		|	КОНЕЦ КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.ИзменениеУсловийСделки КАК ИзменениеУсловийСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО ИзменениеУсловийСделки.Основание = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	ИзменениеУсловийСделки.Организация = &Организация
		|	И НЕ ИзменениеУсловийСделки.ПометкаУдаления
		|	И ИзменениеУсловийСделки.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ИзменениеУсловийСделки.Основание.Брокер = &Брокер
		|	И ИзменениеУсловийСделки.Основание ССЫЛКА Документ.СделкаРЕПО
		|	И НЕ ИзменениеУсловийСделки.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";

#КонецОбласти		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	
	ИзмененияСделокРЕПО2ДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ИзмененияСделокРЕПО2ВнешниеДанные"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
			
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Выборка.НомерСделки;
		НоваяСтрокаОперации.Описание     = "Изм. сделки РЕПО, " + Выборка.НомерСделки + " [" + Выборка.ВидСделки + "] " + Выборка.ЦеннаяБумага;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
				
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.Дата                         = ?(ЗначениеЗаполнено(Выборка.Основание) И НачалоДня(Выборка.Основание.Дата) = ЭтотОбъект.ДатаИмпорта, Выборка.Основание.Дата + 1, ЭтотОбъект.ДатаИмпорта + (9 * 60 + 29) * 60);
		РеквизитыШапки.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.ДатаИсполнения               = Дата(1, 1, 1);
		РеквизитыШапки.ДатаОплаты                   = Выборка.ДатаВторойЧастиРЕПО;
		РеквизитыШапки.ДатаПоставки                 = Выборка.ДатаВторойЧастиРЕПО;
		РеквизитыШапки.ДатаВторойЧастиРЕПО          = ?(ЗначениеЗаполнено(Выборка.Основание) и Выборка.Основание.МестоХранения <> Справочники.МестаХранения.ВнебиржевойРынок, РеквизитыШапки.ДатаПоставки, Дата(1, 1, 1));
		РеквизитыШапки.ВозвратныйКупонКЗачету       = 0;
		РеквизитыШапки.ВалютаОплаты          	    = Выборка.ВалютаОплаты;
		РеквизитыШапки.СобственныйКурсОплаты        = Выборка.СобственныйКурсОплаты;
		РеквизитыШапки.КурсОплаты                   = ?(Выборка.ВалютаСделки <> Выборка.ВалютаОплаты, ?(Выборка.Курс > 0, Выборка.Курс, Выборка.ДатаОплаты), Неопределено);
		РеквизитыШапки.Рынок                        = Выборка.Рынок;
		РеквизитыШапки.ПлатежноеУсловиеСделки       = СокрЛП(Выборка.PSA_Settlement_Type);
		РеквизитыШапки.СтавкаРЕПО			        = Число(Выборка.СтавкаРЕПО);
		
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			РеквизитыШапки.Основание = Выборка.Основание;
		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить сделку Репо (основание) по коду матрих [" + Выборка.Parent_Record_UID + "]");
		КонецЕсли;
		
		РеквизитыШапки.ВалютаЗадолженностиПоКупону		 = Справочники.Валюты.ПустаяСсылка();
		РеквизитыШапки.СуммаЗаймаКПогашениюВВалютеСделки = 0;
		
		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		РеквизитыЦенныеБумаги.НомерСтроки = 1;
		РеквизитыЦенныеБумаги.Исполнено   = Ложь;
		
		Если ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
			РеквизитыЦенныеБумаги.ЦеннаяБумага	= Выборка.ЦеннаяБумага;
		Иначе
			ОшибкиЧтения.Добавить("Изменение условий сделки [" + Выборка.Record_UID + "]. Не удалось определить ценную бумагу по коду во внешней системе [" + Выборка.Security_ID + "]!");
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
		Иначе
			Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
			КонецЕсли;
		КонецЕсли;

		РеквизитыЦенныеБумаги.Количество  = ?(Выборка.Количество = 0, 1, Выборка.Количество);
		РеквизитыЦенныеБумаги.Сумма       = Выборка.СуммаВторойЧасти;
		РеквизитыЦенныеБумаги.СуммаКупона = Выборка.СуммаКупонаВторойЧасти;
		РеквизитыЦенныеБумаги.Цена        = Выборка.ЦенаВторойЧасти;	
		
		Если Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Если Не ЗначениеЗаполнено(Выборка.Номинал) Тогда
				
				ОшибкиЧтения.Добавить("Не удалось рассчитать значение реквизита [ЦенаПроцент], т.к. отсутствует значение номинала для бумаги [" + РеквизитыЦенныеБумаги.ЦеннаяБумага + "]!");
				
			ИначеЕсли Не ЗначениеЗаполнено(Выборка.КоэффициентКонвертации) Тогда
				
				ВалютаНоминалаЦБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЦенныеБумаги.ЦеннаяБумага, "ВалютаНоминала");

				ОшибкиЧтения.Добавить("Не удалось рассчитать значение реквизита [ЦенаПроцент], т.к. не удалось определить курс конвертации валюты оплаты [" + Выборка.ВалютаОплаты + "] в валюту номинала [" + ВалютаНоминалаЦБ + "]. Возможно отсутствуют курсы валют на дату [" + Выборка.ДатаСделки + "]!");	
				
			Иначе
				
				РеквизитыЦенныеБумаги.ЦенаПроцент = Окр(Выборка.ЦенаВторойЧасти * Выборка.КоэффициентКонвертации * 100 / Выборка.Номинал, 4);
	
			КонецЕсли;
			
			РеквизитыЦенныеБумаги.ЦенаКупона = Окр(Выборка.СуммаКупонаВторойЧасти / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги);
		
		Иначе	
			РеквизитыЦенныеБумаги.ЦенаПроцент = 0;
			РеквизитыЦенныеБумаги.ЦенаКупона = 0;	
		КонецЕсли;
				
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги", РеквизитыШапки, ЦенныеБумаги);
				
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;		
		
	КонецЦикла;
	
	ИсключитьИзСверки = "Дата";	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ИзмененияСделокРЕПО2ДанныеСистемы, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьПоставкиЦенныхБумаг_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.ПоставкаЦенныхБумаг, Операции, ПоляДокумента);
	
	Группа_Delivery = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Delivery");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_Depo_Operations.Record_UID КАК Record_UID,
	    |	_Depo_Operations.Deal_Record_UID КАК Deal_Record_UID,
	    |	_Depo_Operations.Date КАК Дата,
	    |	ВЫБОР
	    |		КОГДА _Depo_Operations.Direction = ""1""
	    |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
	    |		КОГДА _Depo_Operations.Direction = ""-1""
	    |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
	    |	КОНЕЦ КАК ВидДвижения,
	    |	_ВнебиржевыеОперации.Объект КАК Основание,
	    |	_ВнебиржевыеОперации.ГруппаОбъектов КАК ГруппаОбъектов,
	    |	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага,
	    |	_ЦенныеБумаги.Рынок КАК Рынок,
	    |	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
	    |	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
	    |	_Depo_Operations.Depo_Storage_Place КАК Depo_Storage_Place,
	    |	_Depo_Operations.Volume КАК Количество,
	    |	ВЫБОР
	    |		КОГДА _Depo_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.Delivery""
	    |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
	    |		КОГДА _Depo_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.REPO.Delivery.Near""
	    |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
	    |		КОГДА _Depo_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.REPO.Delivery.Far""
	    |			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
	    |	КОНЕЦ КАК ВидЗадолженности
	    |ПОМЕСТИТЬ _ВнешниеДанные
	    |ИЗ
	    |	_Depo_Operations КАК _Depo_Operations
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
	    |		ПО _Depo_Operations.Ключ = _ДанныеПервыхУзлов.Ключ
	    |			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
	    |		ПО _Depo_Operations.Security_ID = _ЦенныеБумаги.Matrix_ID
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
	    |		ПО _Depo_Operations.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
	    |		ПО _Depo_Operations.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
	    |			И _Depo_Operations.Inner_Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
	    |		ПО _Depo_Operations.Deal_Record_UID = _ВнебиржевыеОперации.НомерОперации
	    |ГДЕ
	    |	НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
	    |	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
	    |	И _Depo_Operations.Date = &НачалоПериода
	    |	И _Depo_Operations.Origin_Operation_Type В (""Operations.Group.Settlements.Delivery"", ""Operations.Group.Settlements.REPO.Delivery.Near"", ""Operations.Group.Settlements.REPO.Delivery.Far"")
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ВнешниеДанные.Record_UID КАК Record_UID,
	    |	_ВнешниеДанные.Deal_Record_UID КАК Deal_Record_UID,
	    |	_ВнешниеДанные.Дата КАК ДатаПоставки,
	    |	_ВнешниеДанные.ВидДвижения КАК ВидДвижения,
	    |	_ВнешниеДанные.ВидЗадолженности КАК ВидЗадолженности,
	    |	_ВнешниеДанные.Основание КАК Основание,
	    |	_ВнешниеДанные.ГруппаОбъектов КАК ГруппаОбъектов,
	    |	_ВнешниеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_ВнешниеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_ВнешниеДанные.Рынок КАК Рынок,
	    |	_ВнешниеДанные.Depo_Storage_Place КАК Depo_Storage_Place,
	    |	_ВнешниеДанные.КоличествоДепозитарныхСчетов КАК КоличествоДепозитарныхСчетов,
	    |	_ВнешниеДанные.ДепозитарныйСчет КАК ДепозитарныйСчет,
	    |	ВЫБОР
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.Сделка
	    |			ТОГДА ВЫРАЗИТЬ(_ВнешниеДанные.Основание КАК Документ.Сделка).ВалютаСделки
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.СделкаРЕПО
	    |			ТОГДА ВЫРАЗИТЬ(_ВнешниеДанные.Основание КАК Документ.СделкаРЕПО).ВалютаСделки
	    |	КОНЕЦ КАК ВалютаСделки,
	    |	_ВнешниеДанные.Количество КАК Количество,
	    |	ВЫБОР
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.Сделка
	    |			ТОГДА УсловияСделокСрезПоследних.Цена
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.СделкаРЕПО
	    |			ТОГДА УсловияСделокРЕПОСрезПоследних.Цена
	    |		ИНАЧЕ 0
	    |	КОНЕЦ КАК Цена,
	    |	ВЫБОР
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.Сделка
	    |			ТОГДА УсловияСделокСрезПоследних.ЦенаПроцент
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.СделкаРЕПО
	    |			ТОГДА УсловияСделокРЕПОСрезПоследних.ЦенаПроцент
	    |		ИНАЧЕ 0
	    |	КОНЕЦ КАК ЦенаПроцент,
	    |	ВЫБОР
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.Сделка
	    |			ТОГДА УсловияСделокСрезПоследних.ЦенаКупона
	    |		КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.СделкаРЕПО
	    |			ТОГДА УсловияСделокРЕПОСрезПоследних.ЦенаКупона
	    |		ИНАЧЕ 0
	    |	КОНЕЦ КАК ЦенаКупона,
	    |	ВЫРАЗИТЬ(ВЫБОР
	    |			КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.Сделка
	    |				ТОГДА УсловияСделокСрезПоследних.Сумма / УсловияСделокСрезПоследних.Количество * _ВнешниеДанные.Количество
	    |			КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.СделкаРЕПО
	    |				ТОГДА УсловияСделокРЕПОСрезПоследних.Сумма / УсловияСделокРЕПОСрезПоследних.Количество * _ВнешниеДанные.Количество
	    |			ИНАЧЕ 0
	    |		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК Сумма,
	    |	ВЫРАЗИТЬ(ВЫБОР
	    |			КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.Сделка
	    |				ТОГДА УсловияСделокСрезПоследних.СуммаКупона / УсловияСделокСрезПоследних.Количество * _ВнешниеДанные.Количество
	    |			КОГДА _ВнешниеДанные.Основание ССЫЛКА Документ.СделкаРЕПО
	    |				ТОГДА УсловияСделокРЕПОСрезПоследних.СуммаКупона / УсловияСделокРЕПОСрезПоследних.Количество * _ВнешниеДанные.Количество
	    |			ИНАЧЕ 0
	    |		КОНЕЦ КАК ЧИСЛО(19, 2)) КАК СуммаКупона
	    |ПОМЕСТИТЬ _ПоставкиЦенныхБумагВнешниеДанные
	    |ИЗ
	    |	_ВнешниеДанные КАК _ВнешниеДанные
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокСрезПоследних
	    |		ПО _ВнешниеДанные.СчетДоверительногоУправления = УсловияСделокСрезПоследних.СчетДоверительногоУправления
	    |			И _ВнешниеДанные.Основание = УсловияСделокСрезПоследних.Сделка
	    |			И _ВнешниеДанные.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
	    |		ПО _ВнешниеДанные.СчетДоверительногоУправления = УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления
	    |			И _ВнешниеДанные.Основание = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
	    |			И _ВнешниеДанные.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
	    |			И _ВнешниеДанные.ВидЗадолженности = УсловияСделокРЕПОСрезПоследних.ВидЗадолженности
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ВнебиржевыеОперации.НомерОперации КАК Ключ,
	    |	&Звездочка КАК Звездочка
	    |ИЗ
	    |	Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
	    |		ПО ПоставкаЦенныхБумаг.Ссылка = _ВнебиржевыеОперации.Объект
	    |ГДЕ
	    |	ПоставкаЦенныхБумаг.Организация = &Организация
	    |	И НЕ ПоставкаЦенныхБумаг.ПометкаУдаления
	    |	И ПоставкаЦенныхБумаг.Основание.Брокер = &Брокер
	    |	И ПоставкаЦенныхБумаг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	    |	И НЕ ПоставкаЦенныхБумаг.СчетДоверительногоУправления В
	    |				(ВЫБРАТЬ
	    |					_СчетаИсключеныИзЗагрузки.Счет
	    |				ИЗ
	    |					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |УНИЧТОЖИТЬ _ВнешниеДанные";
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*"); 
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	
	ПоставкиЦенныхБумагДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_ПоставкиЦенныхБумагВнешниеДанные"].ПолучитьДанные().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Выборка.Record_UID;
		НоваяСтрокаОперации.Описание     = "Поставка ц/б, " + Выборка.ВидДвижения + ", " + Выборка.ЦеннаяБумага + ", " + Выборка.Количество;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;

		НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
			Справочники.ВнешниеСистемы.Матрих, Группа_Delivery, Выборка.Record_UID);
			
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = ?(ЗначениеЗаполнено(Выборка.Основание) И НачалоДня(Выборка.Основание.Дата) = Выборка.ДатаПоставки, Выборка.Основание.Дата + 2, Выборка.ДатаПоставки + ?(Выборка.ВидДвижения = Перечисления.ВидыДвижений.Приход, (9 * 60 + 30) * 60, (19 * 60 + 30) * 60));
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		
		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			РеквизитыШапки.Основание = Выборка.Основание;
		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить документ основание по коду [" + Выборка.Deal_Record_UID + "]!");
		КонецЕсли;
		
		РеквизитыШапки.ВидДвижения                  = Выборка.ВидДвижения;
		РеквизитыШапки.ВидЗадолженности             = Выборка.ВидЗадолженности;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.ВалютаСделки                 = Выборка.ВалютаСделки;
		РеквизитыШапки.Рынок                        = Выборка.Рынок;

		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		РеквизитыЦенныеБумаги.НомерСтроки = 1;
				
		Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
		Иначе
			Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
			КонецЕсли;
		КонецЕсли;

		РеквизитыЦенныеБумаги.ЦеннаяБумага = Выборка.ЦеннаяБумага;
		РеквизитыЦенныеБумаги.Количество   = ?(Выборка.Количество = 0, 1, Выборка.Количество);
		РеквизитыЦенныеБумаги.Сумма        = Выборка.Сумма;
		РеквизитыЦенныеБумаги.СуммаКупона  = Выборка.СуммаКупона;
		РеквизитыЦенныеБумаги.Цена         = Выборка.Цена;
		РеквизитыЦенныеБумаги.ЦенаПроцент  = Выборка.ЦенаПроцент;
		РеквизитыЦенныеБумаги.ЦенаКупона   = Выборка.ЦенаКупона;
				
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги", РеквизитыШапки, ЦенныеБумаги);
				
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
	КонецЦикла;
	
	ИсключитьИзСверки = "Дата";
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ПоставкиЦенныхБумагДанныеСистемы, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьОтменыСделок_OTBR(МВТ)
	
	Перем Операции, ПоляДокумента;
		
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.ОтменаСделки, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА _ВнебиржевыеОперации.НомерОперации ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА ОтменаСделки.Сделка ССЫЛКА Документ.СделкаРЕПО
		|							И ВЫРАЗИТЬ(ОтменаСделки.Сделка КАК Документ.СделкаРЕПО).СделкаСЦентральнымКонтрагентом
		|						ТОГДА ВЫРАЗИТЬ(ОтменаСделки.Сделка КАК Документ.СделкаРЕПО).НомерСделкиСЦентральнымКонтрагентом
		|					ИНАЧЕ ОтменаСделки.Сделка.НомерСделки
		|				КОНЕЦ
		|		ИНАЧЕ _ВнебиржевыеОперации.НомерОперации
		|	КОНЕЦ КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ПОМЕСТИТЬ _ОтменыСделокДанныеСистемы
		|ИЗ
		|	Документ.ОтменаСделки КАК ОтменаСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО ОтменаСделки.Сделка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	ОтменаСделки.Организация = &Организация
		|	И НЕ ОтменаСделки.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|	И НЕ ОтменаСделки.ПометкаУдаления
		|	И ОтменаСделки.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Deals_With_Details.Date КАК ДатаСделки,
		|	_Deals_With_Details.Date_Cancelled КАК ДатаОтмены,
		|	_Deals_With_Details.Time_Cancelled КАК ВремяОтмены,
		|	_Deals_With_Details.Market КАК Market,
		|	_Deals_With_Details.Operation_Type КАК Operation_Type,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Market_Number = """"
		|			ТОГДА _Deals_With_Details.Parent_Record_UID
		|		ИНАЧЕ _Deals_With_Details.Market_Number
		|	КОНЕЦ КАК НомерСделки,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА НЕ _ВнебиржевыеОперации.Объект ЕСТЬ NULL
		|			ТОГДА _ВнебиржевыеОперации.Объект
		|		КОГДА НЕ Сделка.Ссылка ЕСТЬ NULL
		|			ТОГДА Сделка.Ссылка
		|		КОГДА НЕ СделкаРЕПО.Ссылка ЕСТЬ NULL
		|			ТОГДА СделкаРЕПО.Ссылка
		|	КОНЕЦ КАК Сделка,
		|	ЕСТЬNULL(_Money_Operations.Payment_Amount, 0) КАК СуммаОтступных,
		|	ВалютыОтступных.Валюта КАК ВалютаОтступных
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО _Deals_With_Details.Parent_Record_UID = _ВнебиржевыеОперации.НомерОперации
		|			И (_Deals_With_Details.Market = ""OTC"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО _Deals_With_Details.Market_Number = Сделка.Номер
		|			И (_Deals_With_Details.Operation_Type = ""Operations.Group.Deals.Trade"")
		|			И (_Deals_With_Details.Market = ""MICEX"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (ВЫБОР
		|				КОГДА СделкаРЕПО.СделкаСЦентральнымКонтрагентом
		|					ТОГДА _Deals_With_Details.Market_Number = СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом
		|				ИНАЧЕ _Deals_With_Details.Market_Number = СделкаРЕПО.НомерСделки
		|			КОНЕЦ)
		|			И (СделкаРЕПО.ЧастьСделкиРЕПО = 1)
		|			И (_Deals_With_Details.Operation_Type = ""Operations.Group.Deals.REPO"")
		|			И (_Deals_With_Details.Market = ""MICEX"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Money_Operations КАК _Money_Operations
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыОтступных
		|			ПО _Money_Operations.Payment_Currency_Code = ВалютыОтступных.ISO_Code
		|		ПО _Deals_With_Details.Parent_Record_UID = _Money_Operations.Deal_Record_UID
		|			И (_Money_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.Add.PayOff"")
		|ГДЕ
		|	_Deals_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"", ""Operations.Group.Deals.REPO"")
		|	И _Deals_With_Details.Is_Deal_Info = ""1""
		|	И _Deals_With_Details.Deal_Info_Type = ""Deals.Info.Type.Cancellation""
		|	И _Deals_With_Details.Date = &НачалоПериода";
		
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*"); 
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
			
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Выборка.НомерСделки;
		НоваяСтрокаОперации.Описание     = "Отмена сделки" + ?(Выборка.Operation_Type = "Operations.Group.Deals.REPO", " РЕПО, ", ", ") + Выборка.НомерСделки;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
				
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = ?(ЗначениеЗаполнено(Выборка.ВремяОтмены), Выборка.ДатаОтмены + (Выборка.ВремяОтмены - Дата(1, 1, 1)), ЭтотОбъект.ДатаИмпорта + ((19 * 60 + 30) * 60));
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.Валюта                       = ?(ЗначениеЗаполнено(Выборка.ВалютаОтступных), Выборка.ВалютаОтступных, ЭтотОбъект.Организация.ВалютаУчета);
		РеквизитыШапки.СуммаОтступных               = Выборка.СуммаОтступных;
		
		Если ЗначениеЗаполнено(Выборка.Сделка) Тогда
			РеквизитыШапки.Сделка = Выборка.Сделка;
		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить " + ?(ЗначениеЗаполнено(Выборка.Market), "биржевую", "внебиржевую") + " сделку " + ?(Выборка.Operation_Type = "Operations.Group.Deals.REPO", "РЕПО", "") + " по номеру [" + Выборка.НомерСделки  + "].");
		КонецЕсли; 
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка", РеквизитыШапки);
		
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
	КонецЦикла;
			
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, МВТ.Таблицы["_ОтменыСделокДанныеСистемы"].ПолучитьДанные().Выгрузить(), ПоляДокумента);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьСписанияЦенныхБумаг_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.СписаниеЦеннойБумаги, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_Depo_Operations.Record_UID КАК Record_UID,
	    |	_Depo_Operations.Date КАК Дата,
	    |	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_Depo_Operations.Security_ID КАК Security_ID,
	    |	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага,
	    |	_ЦенныеБумаги.Рынок КАК Рынок,
	    |	_ДепозитарныеСчета.Счет КАК ДепозитарныйСчет,
	    |	ЕСТЬNULL(_ДепозитарныеСчета.КоличествоСчетов, 0) КАК КоличествоДепозитарныхСчетов,
	    |	_Depo_Operations.Depo_Storage_Place КАК Depo_Storage_Place,
	    |	_Depo_Operations.Volume КАК Количество
	    |ПОМЕСТИТЬ _ВнешниеДанные
	    |ИЗ
	    |	_Depo_Operations КАК _Depo_Operations
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
	    |		ПО _Depo_Operations.Ключ = _ДанныеПервыхУзлов.Ключ
	    |			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
	    |		ПО _Depo_Operations.Security_ID = _ЦенныеБумаги.Matrix_ID
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
	    |		ПО _Depo_Operations.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитарныеСчета КАК _ДепозитарныеСчета
	    |		ПО _Depo_Operations.Depo_Storage_Place = _ДепозитарныеСчета.КодДепозитарногоСчета
	    |			И _Depo_Operations.Inner_Account_Division_ID = _ДепозитарныеСчета.Account_Division_ID
	    |ГДЕ
	    |	НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
	    |	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
	    |	И _Depo_Operations.Date = &НачалоПериода
	    |	И _Depo_Operations.Origin_Operation_Type В (""Operations.Group.CorporateActions.WriteOff"")
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	СписаниеЦеннойБумаги.СчетДоверительногоУправления.Наименование КАК Ключ,
	    |	&Звездочка КАК Звездочка
	    |ПОМЕСТИТЬ _СписанияЦенныхБумагДанныеСистемы
	    |ИЗ
	    |	Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
	    |ГДЕ
	    |	СписаниеЦеннойБумаги.Организация = &Организация
	    |	И НЕ СписаниеЦеннойБумаги.СчетДоверительногоУправления В
	    |				(ВЫБРАТЬ
	    |					_СчетаИсключеныИзЗагрузки.Счет
	    |				ИЗ
	    |					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
	    |	И СписаниеЦеннойБумаги.Проведен
	    |	И СписаниеЦеннойБумаги.ДепозитарныйСчет.Депозитарий = &ДБК_Регион
	    |	И НАЧАЛОПЕРИОДА(СписаниеЦеннойБумаги.Дата, ДЕНЬ) = &НачалоПериода
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ВнешниеДанные.Record_UID КАК Record_UID,
	    |	_ВнешниеДанные.Дата КАК Дата,
	    |	_ВнешниеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	_ВнешниеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
	    |	_ВнешниеДанные.Security_ID КАК Security_ID,
	    |	_ВнешниеДанные.Рынок КАК Рынок,
	    |	_ВнешниеДанные.ДепозитарныйСчет КАК ДепозитарныйСчет,
	    |	_ВнешниеДанные.КоличествоДепозитарныхСчетов КАК КоличествоДепозитарныхСчетов,
	    |	_ВнешниеДанные.Depo_Storage_Place КАК Depo_Storage_Place,
	    |	_ВнешниеДанные.Количество КАК Количество,
	    |	ОстаткиЦенныхБумагЗаблокированные.Регистратор КАК Основание
	    |ИЗ
	    |	_ВнешниеДанные КАК _ВнешниеДанные
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумагЗаблокированные КАК ОстаткиЦенныхБумагЗаблокированные
	    |		ПО _ВнешниеДанные.СчетДоверительногоУправления = ОстаткиЦенныхБумагЗаблокированные.СчетДоверительногоУправления
	    |			И _ВнешниеДанные.ДепозитарныйСчет = ОстаткиЦенныхБумагЗаблокированные.ДепозитарныйСчет
	    |			И _ВнешниеДанные.ЦеннаяБумага = ОстаткиЦенныхБумагЗаблокированные.ЦеннаяБумага
	    |			И _ВнешниеДанные.Количество = ОстаткиЦенныхБумагЗаблокированные.Количество
	    |			И (ОстаткиЦенныхБумагЗаблокированные.ВидБлокировкиАктива = ЗНАЧЕНИЕ(Перечисление.ВидыБлокировокАктивов.Погашение))
	    |			И (ОстаткиЦенныхБумагЗаблокированные.Регистратор ССЫЛКА Документ.ПогашениеЦеннойБумаги)
	    |			И (ОстаткиЦенныхБумагЗаблокированные.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |УНИЧТОЖИТЬ _ВнешниеДанные";
#КонецОбласти

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*"); 
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", ЭтотОбъект.ДатаИмпорта + (17 * 60 + 29) * 60 + 59); //17:29:59
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДБК_Регион", ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_БК_Регион"));
			
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Выборка.СчетДоверительногоУправления.Наименование + "/" + Выборка.ЦеннаяБумага.Наименование + "/" + Выборка.Количество;
		НоваяСтрокаОперации.Описание     = "Списание ц/б, " + Выборка.ЦеннаяБумага + ", " + Выборка.Количество;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
			
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = Выборка.Дата + ((17 * 60 + 30) * 60);
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		РеквизитыШапки.Рынок                        = Выборка.Рынок;
		РеквизитыШапки.Количество                   = Выборка.Количество;
		
		Если ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Тогда
			РеквизитыШапки.ЦеннаяБумага = Выборка.ЦеннаяБумага;
		Иначе
			ОшибкиЧтения.Добавить("Не удалось определить ценную бумагу по коду во внешней системе [" + Выборка.Security_ID + "]!");
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Основание) Тогда
			РеквизитыШапки.ПогашениеЦеннойБумаги = Выборка.Основание;
		Иначе
			ОшибкиЧтения.Добавить("Не найден документ основание [Погашение ценной бумаги " + Выборка.ЦеннаяБумага + "]");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
			РеквизитыШапки.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
		Иначе
			Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
			Иначе
				ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка", РеквизитыШапки);
				
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
	КонецЦикла;
	
	ТекущиеОперации = МВТ.Таблицы["_СписанияЦенныхБумагДанныеСистемы"].ПолучитьДанные().Выгрузить();
	
	Для каждого СтрокаТекущиеОперации Из ТекущиеОперации Цикл
		СтрокаТекущиеОперации.Ключ = СтрокаТекущиеОперации.Ключ + "/" + СтрокаТекущиеОперации.ЦеннаяБумага.Наименование + "/" + СтрокаТекущиеОперации.Количество;
	КонецЦикла;
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента);
	
	Возврат Операции;	
	
КонецФункции

Процедура ПодготовитьОбработкуОпераций_OTBR(ДокументМД, Операции, ПоляДокумента, Внебиржа = Ложь)
		
	Операции = Новый ТаблицаЗначений;
	Операции.Колонки.Добавить("Ключ");
	Операции.Колонки.Добавить("Статус");
	Операции.Колонки.Добавить("Описание");
	Операции.Колонки.Добавить("Ссылка");
	Операции.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	Операции.Колонки.Добавить("ТекущиеРеквизиты");
	Операции.Колонки.Добавить("НовыеРеквизиты");
	Операции.Колонки.Добавить("ОшибкиЧтения");
	Операции.Колонки.Добавить("КодВоВнешнейСистеме");
	
	ПоляДокумента = Новый Структура("Шапка", ПолучитьПоляОбъектаНаОснованииМетаданных(ДокументМД,,Внебиржа));
	
	Для каждого ТаблицаМД Из ДокументМД.ТабличныеЧасти Цикл
		ПоляДокумента.Вставить(ТаблицаМД.Имя, ПолучитьПоляОбъектаНаОснованииМетаданных(ТаблицаМД,,Внебиржа));
	КонецЦикла;
	
	ПоляДокумента.Вставить("ДопСведения", Новый ФиксированнаяСтруктура("РаскрытыйКонтрагент")); 
	
КонецПроцедуры

Процедура УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента, РеквизитыИсключенныеИзСверки = "")
	
	ТекущиеОперации.Сортировать("Проведен УБЫВ");
	
	Для Каждого СтрокаТекущиеОперации Из ТекущиеОперации Цикл
		// соберем реквизиты текущей операции
		РеквизитыТекущейОперации = Новый Структура;
		
		Для Каждого НаборПолей Из ПоляДокумента Цикл
			
			Если НаборПолей.Ключ = "Шапка" Или НаборПолей.Ключ = "ДопСведения" Тогда
				
				Реквизиты = Новый Структура(НаборПолей.Значение);
				ЗаполнитьЗначенияСвойств(Реквизиты, СтрокаТекущиеОперации); 
				
			Иначе // табличная часть
				
				Реквизиты = Новый Массив;
				
				Для Каждого Строка Из СтрокаТекущиеОперации[НаборПолей.Ключ] Цикл
					РеквизитыСтроки = Новый Структура(НаборПолей.Значение);
					ЗаполнитьЗначенияСвойств(РеквизитыСтроки, Строка);
					
					Реквизиты.Добавить(РеквизитыСтроки);
				КонецЦикла;
				
			КонецЕсли;
		
			РеквизитыТекущейОперации.Вставить(НаборПолей.Ключ, Реквизиты);
		КонецЦикла;
		//17.11.22 брокер исполнил поручения несколькими переводами.
		Если НачалоДня(СтрокаТекущиеОперации.Дата) = Дата(2022,11,17) И ТипЗнч(СтрокаТекущиеОперации.Ссылка) = Тип("ДокументСсылка.ПереводДенежныхСредств") Тогда
			СтрокаОперации = Операции.НайтиСтроки(Новый Структура("Ключ, Статус", СтрокаТекущиеОперации.Ключ, "Новый"))[0];
		Иначе
			СтрокаОперации = Операции.Найти(СтрокаТекущиеОперации.Ключ, "Ключ");  //ТаблицаЗначений
		КонецЕсли;
				
		//Если (СтрокаОперации = Неопределено Или ЗначениеЗаполнено(СтрокаОперации.Ссылка)) или ((СтрокаОперации <> Неопределено) и (СтрокаОперации.Статус = "Ошибка чтения")) Тогда		
		Если (СтрокаОперации = Неопределено Или ЗначениеЗаполнено(СтрокаОперации.Ссылка)) Тогда
			
			НоваяСтрокаОперации = Операции.Добавить();
			НоваяСтрокаОперации.Ссылка                       = СтрокаТекущиеОперации.Ссылка;
			НоваяСтрокаОперации.Описание                     = "";
			НоваяСтрокаОперации.СчетДоверительногоУправления = СтрокаТекущиеОперации.СчетДоверительногоУправления;
			НоваяСтрокаОперации.Статус                       = "Отсутствует";
			НоваяСтрокаОперации.ТекущиеРеквизиты             = РеквизитыТекущейОперации;
			
		Иначе
			
			СтрокаОперации.Ссылка           = СтрокаТекущиеОперации.Ссылка; 
			СтрокаОперации.ТекущиеРеквизиты = РеквизитыТекущейОперации;
			НайтиРасхожденияИУстановитьСтатус(СтрокаОперации.НовыеРеквизиты, РеквизитыТекущейОперации, СтрокаОперации.Статус, СтрокаОперации.ОшибкиЧтения, РеквизитыИсключенныеИзСверки);

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЦеннуюБумагу(МатрихИД, ГруппаИмпортируемыхОбъектов)
		
	ИмпортНСИ = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
		
	ИмпортНСИ.Организация    = ЭтотОбъект.Организация;
	ИмпортНСИ.Подразделение  = Справочники.Подразделения.ГруппаКомпаний;
	ИмпортНСИ.Язык           = Справочники.Языки.Русский;
	ИмпортНСИ.ГруппаПравил   = "Матрих";
	ИмпортНСИ.ГруппаОбъектов = ГруппаИмпортируемыхОбъектов;
	
	ИмпортНСИ.НеСообщатьОСозданииНовыхОбъектов = Истина;
		
	ДанныеНовогоОбъекта = ИмпортНСИ.ПолучитьДанныеДляВыбора(МатрихИД);
	
	Если ДанныеНовогоОбъекта = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось загрузить ценную бумагу (" + ГруппаИмпортируемыхОбъектов + ") по коду матрих " + МатрихИД);
		Возврат;
	КонецЕсли;
	
	Если ДанныеНовогоОбъекта.Количество() > 0 Тогда
		
		Для Каждого НовыйОбъект Из ДанныеНовогоОбъекта Цикл
			
			СтрокаИмпортируемыйОбъект = ИмпортНСИ.ИмпортируемыеОбъекты.Добавить();
			СтрокаИмпортируемыйОбъект.КодВоВнешнейСистеме = НовыйОбъект.Идентификатор;
			СтрокаИмпортируемыйОбъект.Объект			  = НовыйОбъект.Объект;
			ЗагруженныйОбъект = ИмпортНСИ.ИмпортироватьДанные();
			
			Если ЗагруженныйОбъект = Неопределено Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось загрузить ценную бумагу по коду матрих [" + МатрихИД + "]");
			
			ИначеЕсли ТипЗнч(ЗагруженныйОбъект) = Тип("Массив") Тогда
				
				Если ЗагруженныйОбъект.Количество() = 1 Тогда
				
					МассивСообщений = ПолучитьСообщенияПользователю(Истина);
					ТекстСообщения = "";
					
					Для Каждого Сообщение Из МассивСообщений Цикл
						ТекстСообщения = ?(ТекстСообщения = "", "", ТекстСообщения + ". ") + Сообщение.Текст;	
					КонецЦикла;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Загружена новая ценная бумага [" + ЗагруженныйОбъект[0].Наименование + "]. " + ТекстСообщения);				
					ИмпортНСИ.ИмпортируемыеОбъекты.Очистить();
				Иначе
					
					Для Каждого Объект Из ЗагруженныйОбъект Цикл
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке ценной бумаги. По коду матрих [" + МатрихИД + "] загружено " + ЗагруженныйОбъект.Количество() + " бумаг. [" + ЗагруженныйОбъект[0].Наименование + "]"); 
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По коду матрих [" + МатрихИД + "] не удалось найти ценную бумагу для загрузки.");
	КонецЕсли;	
	
КонецПроцедуры

Процедура СформироватьОповещение(ТемаСообщения, ТекстСообщения)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхКОбработке.Текст КАК ТекстПисьма
		|ИЗ
		|	Справочник.ПакетыДанныхКОбработке КАК ПакетыДанныхКОбработке
		|ГДЕ
		|	ПакетыДанныхКОбработке.ДатаСоздания >= &ДатаИмпорта
		|	И ПакетыДанныхКОбработке.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыПакетовДанныхКОбработке.ЭлектронноеПисьмо)
		|	И (ВЫРАЗИТЬ(ПакетыДанныхКОбработке.Тема КАК СТРОКА(100))) = (ВЫРАЗИТЬ(&ТемаСообщения КАК СТРОКА(100)))
		|	И НЕ ПакетыДанныхКОбработке.ОбработкаОтменена";
	
	Запрос.УстановитьПараметр("ДатаИмпорта", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("ТемаСообщения", ТемаСообщения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если СтрНайти(Выборка.ТекстПисьма, ТекстСообщения) > 0 Тогда
			Возврат;		
		КонецЕсли;
		
	КонецЦикла;
		
	РеквизитыОповещения = Новый Структура("Тема, Текст", ТемаСообщения, ТекстСообщения);
	Справочники.Оповещения.СформироватьОповещения("Обработка._ИмпортОперацийБрокераБКРегион", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры

Функция ПолучитьХешСуммуМассива(Массив)
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.SHA256);
	СуммыТекстом = СтрСоединить(Массив, ";");
	ХешированиеДанных.Добавить(СуммыТекстом);
	ХешСуммыДляКлюча = СтрЗаменить(Строка(ХешированиеДанных.ХешСумма), " ", "");
	Возврат ХешСуммыДляКлюча;
КонецФункции

