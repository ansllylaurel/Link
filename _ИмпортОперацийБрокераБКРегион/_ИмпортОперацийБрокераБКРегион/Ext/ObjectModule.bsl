		|	_ВнешниеДанные.ВидДвижения КАК ВидДвижения,
		|	_ВнешниеДанные.МестоХраненияДенежныхСредств КАК МестоХраненияДенежныхСредств,
		|	_ВнешниеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ВнешниеДанные.КодУБрокера КАК КодУБрокера,
		|	ЕСТЬNULL(_УсловияСделок.Сделка, _ВнебиржевыеСделки.Объект) КАК Основание,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.ВалютаОплаты <> _УсловияСделок.Сделка.ВалютаСделки
		|				И _ВнешниеДанные.ВалютаОплаты = &РоссийскийРубль
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(_УсловияСделок.СобственныйКурсОплаты, ЛОЖЬ) = ИСТИНА
		|						ТОГДА ВЫБОР
		|								КОГДА ТИПЗНАЧЕНИЯ(_УсловияСделок.КурсОплаты) = ТИП(ЧИСЛО)
		|										И _УсловияСделок.КурсОплаты <> 0
		|									ТОГДА ВЫРАЗИТЬ(_ВнешниеДанные.Сумма / (ВЫРАЗИТЬ(_УсловияСделок.КурсОплаты КАК ЧИСЛО(10, 4))) КАК ЧИСЛО(19, 2))
		|								КОГДА ТИПЗНАЧЕНИЯ(_УсловияСделок.КурсОплаты) = ТИП(ДАТА)
		|										И _УсловияСделок.КурсОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|									ТОГДА ВЫРАЗИТЬ(_ВнешниеДанные.Сумма * СобственныйКурс.Кратность / СобственныйКурс.Курс КАК ЧИСЛО(19, 2))
		|							КОНЕЦ
		|					ИНАЧЕ ВЫРАЗИТЬ(_ВнешниеДанные.Сумма * КурсыВалют.Кратность / КурсыВалют.Курс КАК ЧИСЛО(19, 2))
		|				КОНЕЦ
		|		ИНАЧЕ _ВнешниеДанные.Сумма
		|	КОНЕЦ КАК СуммаВВалютеСделки,
		|	_ВнешниеДанные.Сумма КАК СуммаОплаты,
		|	ВЫБОР
		|		КОГДА _ВнешниеДанные.ВалютаОплаты <> _УсловияСделок.Сделка.ВалютаСделки
		|				И _ВнешниеДанные.ВалютаОплаты = &РоссийскийРубль
		|			ТОГДА ВЫБОР
		|					КОГДА ЕСТЬNULL(_УсловияСделок.СобственныйКурсОплаты, ЛОЖЬ) = ИСТИНА
		|						ТОГДА ВЫБОР
		|								КОГДА ТИПЗНАЧЕНИЯ(_УсловияСделок.КурсОплаты) = ТИП(ЧИСЛО)
		|										И _УсловияСделок.КурсОплаты <> 0
		|									ТОГДА ВЫРАЗИТЬ(_ВнешниеДанные.СуммаКупона / (ВЫРАЗИТЬ(_УсловияСделок.КурсОплаты КАК ЧИСЛО(10, 4))) КАК ЧИСЛО(19, 2))
		|								КОГДА ТИПЗНАЧЕНИЯ(_УсловияСделок.КурсОплаты) = ТИП(ДАТА)
		|										И _УсловияСделок.КурсОплаты <> ДАТАВРЕМЯ(1, 1, 1)
		|									ТОГДА ВЫРАЗИТЬ(_ВнешниеДанные.СуммаКупона * СобственныйКурс.Кратность / СобственныйКурс.Курс КАК ЧИСЛО(19, 2))
		|							КОНЕЦ
		|					ИНАЧЕ ВЫРАЗИТЬ(_ВнешниеДанные.СуммаКупона * КурсыВалют.Кратность / КурсыВалют.Курс КАК ЧИСЛО(19, 2))
		|				КОНЕЦ
		|		ИНАЧЕ _ВнешниеДанные.СуммаКупона
		|	КОНЕЦ КАК СуммаКупонаВВалютеСделки,
		|	_ВнешниеДанные.СуммаКупона КАК СуммаОплатыКупона,
		|	_УсловияСделок.Сделка.ВалютаСделки КАК ВалютаСделки,
		|	_ВнешниеДанные.ВалютаОплаты КАК ВалютаОплаты,
		|	_УсловияСделок.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	_УсловияСделок.КурсОплаты КАК КурсОплаты
		|ПОМЕСТИТЬ _ОплатыВнебиржевыхСделокВнешниеДанные
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияСделок КАК _УсловияСделок
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО _УсловияСделок.Сделка.ВалютаСделки = КурсыВалют.Валюта
		|				И (КурсыВалют.Период = &НачалоПериода)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК СобственныйКурс
		|			ПО _УсловияСделок.Сделка.ВалютаСделки = СобственныйКурс.Валюта
		|				И (_УсловияСделок.СобственныйКурсОплаты = ИСТИНА)
		|				И (ТИПЗНАЧЕНИЯ(_УсловияСделок.КурсОплаты) = ТИП(ДАТА))
		|				И (_УсловияСделок.КурсОплаты <> ДАТАВРЕМЯ(1, 1, 1))
		|				И _УсловияСделок.КурсОплаты = СобственныйКурс.Период
		|		ПО _ВнешниеДанные.Deal_Record_UID = _УсловияСделок.НомерОперации
		|			И _ВнешниеДанные.СчетДоверительногоУправления = _УсловияСделок.СчетДоверительногоУправления
		|			И _ВнешниеДанные.ВидЗадолженности = _УсловияСделок.ВидЗадолженности
		|			И (_УсловияСделок.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ПО _ВнешниеДанные.Deal_Record_UID = _ВнебиржевыеСделки.НомерОперации
		|			И (_ВнешниеДанные.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|				ИЛИ _ВнебиржевыеСделки.Объект ССЫЛКА Документ.СделкаСВалютой)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнебиржевыеОперации.НомерОперации КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО Оплата.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	Оплата.Организация = &Организация
		|	И НЕ Оплата.ПометкаУдаления
		|	И Оплата.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Оплата.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И Оплата.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|	И Оплата.Брокер = &Брокер
		|	И НЕ Оплата.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|;
