	    |			ТОГДА ИСТИНА
	    |		ИНАЧЕ СделкаРЕПО.Проведен
	    |	КОНЕЦ КАК Проведен,
	    |	&Звездочка КАК Звездочка
	    |ИЗ
	    |	Документ.СделкаРЕПО КАК СделкаРЕПО
	    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТекущиеОперации КАК _ТекущиеОперации
	    |		ПО СделкаРЕПО.Ссылка = _ТекущиеОперации.Ссылка
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |УНИЧТОЖИТЬ _ТекущиеОперации
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |УНИЧТОЖИТЬ _УсловияСделокРепо";
#КонецОбласти

	ТекДата = НачалоДня(ТекущаяДатаСеанса());
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("КонтролироватьНепроведенные", КонтролироватьНепроведенныеДокументы);
	
	СделкиРепо2ДанныеСистемы = Запрос.Выполнить().Выгрузить();
	
	Выборка = МВТ.Таблицы["_СделкиРепо2ВнешниеДанные"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Строка(Выборка.ВидСделки) + "/" + Выборка.Ключ + "/2";
		НоваяСтрокаОперации.Описание     = "Бирж. сделка РЕПО #2, № " + Выборка.Ключ + ?(ЗначениеЗаполнено(Выборка.ВидСделки), ", " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy") + " [" + Строка(Выборка.ВидСделки) + "]", "");
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		Если Не ЗначениеЗаполнено(Выборка.ЗначенияПолученыИзРегистра) Тогда
			
			ОшибкиЧтения.Добавить("Не удалось сформировать документ [сделка РЕПО часть 2]. Не найдена первая часть сделки Репо по номеру сделки (номеру сделки с центральным контрагентом) [" + Выборка.Ключ + "].  Данные загружены из файла [" + Выборка.ИмяФайла + "].");
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
			Продолжить;
			
		КонецЕсли;
		
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыЦенныеБумаги = Новый Структура(ПоляДокумента.ЦенныеБумаги);
		
		ЗаполнитьЗначенияСвойств(РеквизитыШапки, Выборка);
		ЗаполнитьЗначенияСвойств(РеквизитыЦенныеБумаги, Выборка);
		
		РеквизитыШапки.НомерСделки = ?(Выборка.СделкаСЦентральнымКонтрагентом, Строка(Формат(Число(Выборка.НомерСделки) + 2, "ЧГ=0")), Выборка.НомерСделки);
		РеквизитыШапки.КонтрагентНаБирже = "";
		РеквизитыШапки.Дисконт = Выборка.Дисконт;
		
		Если Не Выборка.ЗначенияПолученыИзРегистра Тогда
			
			РеквизитыШапки.Проведен = ?(Выборка.Дата <= ТекДата, Истина, Ложь);
			РеквизитыШапки.Дата     = ?(ЗначениеЗаполнено(Выборка.ПерваяЧастьРЕПО) И Выборка.Дата = НачалоДня(Выборка.ПерваяЧастьРЕПО.Дата), Выборка.ПерваяЧастьРЕПО.Дата + 1, Выборка.Дата + ?(Выборка.ВидСделки = Перечисления.ВидыСделок.Покупка, 34200, 34260)); //9:30, 9:31
			
			РеквизитыЦенныеБумаги.Количество  = ?(Выборка.Количество = 0, 1, Выборка.Количество) ;
			РеквизитыЦенныеБумаги.Сумма       = Выборка.Сумма;
			РеквизитыЦенныеБумаги.СуммаКупона = Выборка.СуммаКупона;
			РеквизитыЦенныеБумаги.Цена        = Выборка.Цена;
			РеквизитыЦенныеБумаги.ЦенаКупона  = ?(Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации, Окр(Выборка.СуммаКупона / РеквизитыЦенныеБумаги.Количество, ТочностьЦеныЦеннойБумаги), 0);
						
			Если Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
				
				
				Если Не ЗначениеЗаполнено(Выборка.Номинал) Тогда
					
					ОшибкиЧтения.Добавить("Не удалось рассчитать значение реквизита [ЦенаПроцент], т.к. отсутствует значение номинала для бумаги [" + РеквизитыЦенныеБумаги.ЦеннаяБумага + "]!");
					
				ИначеЕсли Не ЗначениеЗаполнено(Выборка.КоэффициентКонвертации) Тогда
	
					ВалютаНоминалаЦБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЦенныеБумаги.ЦеннаяБумага, "ВалютаНоминала");
				
					ОшибкиЧтения.Добавить("Не удалось рассчитать значение реквизита [ЦенаПроцент], т.к. не удалось определить курс конвертации валюты оплаты [" + Выборка.ВалютаОплаты + "] в валюту номинала [" + ВалютаНоминалаЦБ + "]. Возможно отсутствуют курсы валют на дату [" + Выборка.ДатаПервойЧасти + "]!");	
				
				Иначе
					
					РеквизитыЦенныеБумаги.ЦенаПроцент = Окр(Выборка.Цена * Выборка.КоэффициентКонвертации * 100 / Выборка.Номинал, 4);					
					
				КонецЕсли;
				
			Иначе
				РеквизитыЦенныеБумаги.ЦенаПроцент = 0;	
			КонецЕсли;
						
			Если Не ЗначениеЗаполнено(Выборка.ПерваяЧастьРЕПО) Тогда
				ОшибкиЧтения.Добавить("Не удалось сформировать документ [сделка РЕПО часть 2]. Не найдена первая часть сделки Репо по номеру сделки (номеру сделки с центральным контрагентом) [" + Выборка.Ключ + "].");	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.ДепозитарныйСчет) Тогда
				РеквизитыЦенныеБумаги.ДепозитарныйСчет = Выборка.ДепозитарныйСчет;
			Иначе
				Если Выборка.КоличествоДепозитарныхСчетов = 0 Тогда
					ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Не найден " + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", "36-ой раздел.", "депозитарный счет по коду [" + Выборка.Depo_Storage_Place + "]!"));
				Иначе
					ОшибкиЧтения.Добавить("Не удалось определить место хранения ЦБ. Найдено несколько [" + Выборка.КоличествоДепозитарныхСчетов + "]" + ?(Выборка.Depo_Storage_Place = "СпецДЕП Т+", " 36-ых разделов.", " депозитраных счетов по коду [" + Выборка.Depo_Storage_Place + "]!"));
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		ЦенныеБумаги = Новый Массив;
		ЦенныеБумаги.Добавить(РеквизитыЦенныеБумаги);
		
		ЦенныеБумагиВторойЧасти = Новый Массив;		
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, ЦенныеБумаги, ЦенныеБумагиВторойЧасти", РеквизитыШапки, ЦенныеБумаги, ЦенныеБумагиВторойЧасти);
		
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, СделкиРепо2ДанныеСистемы, ПоляДокумента, "КодРасчетовНаБирже");
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьСделкиСВалютой_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
		
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.СделкаСВалютой, Операции, ПоляДокумента);
		
	Группа_FX = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("FX");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СделкаСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ""Покупка""
		|		КОГДА СделкаСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ""Продажа""
		|		ИНАЧЕ """"
		|	КОНЕЦ + ""/"" + ВЫБОР
		|		КОГДА СделкаСВалютой.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА _ВнебиржевыеСделки.НомерОперации
		|		ИНАЧЕ СделкаСВалютой.НомерСделки
		|	КОНЕЦ + """" + ВЫБОР
		|		КОГДА СделкаСВалютой.ТипСделки = ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопВтораяЧасть)
		|			ТОГДА ""/2""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ПОМЕСТИТЬ _СделкиСВалютойДанныеСистемы
		|ИЗ
		|	Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ПО СделкаСВалютой.Ссылка = _ВнебиржевыеСделки.Объект
		|ГДЕ
		|	СделкаСВалютой.Организация = &Организация
		|	И НЕ СделкаСВалютой.ПометкаУдаления
		|	И СделкаСВалютой.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И СделкаСВалютой.Брокер = &Брокер
		|	И НЕ СделкаСВалютой.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Deals_With_Details.Record_UID КАК Record_UID,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Market = ""OTC""
		|			ТОГДА _Deals_With_Details.Record_UID
		|		ИНАЧЕ _Deals_With_Details.Market_Number
		|	КОНЕЦ КАК Ключ,
		|	_Deals_With_Details.Near_Deal_Record_UID КАК Near_Deal_Record_UID,
		|	_Deals_With_Details.Market_Number КАК НомерСделки,
		|	_Deals_With_Details.Date КАК ДатаСделки,
		|	_Deals_With_Details.Time КАК ВремяСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		КОГДА _Deals_With_Details.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Operation_Type = ""Operations.Group.Deals.Trade""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.Конверсионная)
		|		КОГДА _Deals_With_Details.Operation_Type = ""Operations.Group.Deals.Forward""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.ФорвардПоставочный)
		|		КОГДА _Deals_With_Details.Operation_Type = ""Operations.Group.Deals.Swap""
		|			ТОГДА ВЫБОР
		|					КОГДА _Deals_With_Details.Near_Deal_Record_UID = """"
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопПерваяЧасть)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопВтораяЧасть)
		|				КОНЕЦ
		|	КОНЕЦ КАК ТипСделки,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Date <> _Deals_With_Details.Payment_Date
		|				ИЛИ _Deals_With_Details.Date <> _Deals_With_Details.Delivery_Date
		|				ИЛИ _Deals_With_Details.Market = ""OTC""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложенноеИсполнение,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Payment_Date <> _Deals_With_Details.Delivery_Date
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК РаздельноеИсполнение,
		|	_Deals_With_Details.Payment_Date КАК ДатаОплаты,
		|	_Deals_With_Details.Delivery_Date КАК ДатаПоставки,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_Deals_With_Details.ВалютаСделки КАК Контрвалюта,
		|	_Deals_With_Details.ВалютаОплаты КАК ВалютаОплаты,
		|	_Deals_With_Details.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА НЕ _ВнебиржевыеСделки.Объект ЕСТЬ NULL
		|			ТОГДА _ВнебиржевыеСделки.Объект
		|		КОГДА НЕ СделкаСВалютой.Ссылка ЕСТЬ NULL
		|			ТОГДА СделкаСВалютой.Ссылка
		|		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СделкаСВалютой.ПустаяСсылка)
		|	КОНЕЦ КАК Основание,
		|	_Deals_With_Details.Price КАК Курс,
		|	_Deals_With_Details.Volume КАК Сумма,
		|	_Deals_With_Details.Amount КАК СуммаКонтрвалюты,
		|	_Deals_With_Details.ЦеннаяБумага КАК Валюта,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Market <> ""OTC""
		|				И _Deals_With_Details.Date <> _Deals_With_Details.SE_Charge_Date
		|				И _Deals_With_Details.SE_Charge_Date <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОтложеннаяОплатаТорговойКомиссии,
		|	ВЫБОР
		|		КОГДА _Deals_With_Details.Market <> ""OTC""
		|				И _Deals_With_Details.Date <> _Deals_With_Details.SE_Charge_Date
		|				И _Deals_With_Details.SE_Charge_Date <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА _Deals_With_Details.SE_Charge_Date
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаОплатыТорговойКомиссии,
		|	_Deals_With_Details.SE_Charge_Amount КАК СуммаТорговойКомиссии,
		|	ЕСТЬNULL(ВалютыТорговойКомиссии.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаТорговойКомиссии
		|ИЗ
		|	_Deals_With_Details КАК _Deals_With_Details
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Money_Operations КАК _Money_Operations
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыТорговойКомиссии
		|			ПО _Money_Operations.Payment_Currency_Code = ВалютыТорговойКомиссии.ISO_Code
		|		ПО _Deals_With_Details.Record_UID = _Money_Operations.Deal_Record_UID
		|			И _Deals_With_Details.SE_Charge_Amount = _Money_Operations.Payment_Amount
		|			И (_Money_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.Add.SE.Fee"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РежимыБиржевыхТоргов КАК _РежимыБиржевыхТоргов
		|		ПО _Deals_With_Details.Market_Board = _РежимыБиржевыхТоргов.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Deals_With_Details.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ПО _Deals_With_Details.Near_Deal_Record_UID = _ВнебиржевыеСделки.НомерОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО _Deals_With_Details.Market_Number = СделкаСВалютой.НомерСделки
		|			И (_Deals_With_Details.Market_Number <> """")
		|			И (_Deals_With_Details.Near_Deal_Record_UID <> """")
		|			И (СделкаСВалютой.Проведен = ИСТИНА)
		|			И (СделкаСВалютой.Организация = &Организация)
		|			И (СделкаСВалютой.Брокер = &Брокер)
		|			И (СделкаСВалютой.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаСВалютой.ТипСделки В (ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.СвопПерваяЧасть), ЗНАЧЕНИЕ(Перечисление.ТипыСделокСВалютой.ФорвардПоставочный)))
		|ГДЕ
		|	_Deals_With_Details.ЦеннаяБумага ССЫЛКА Справочник.Валюты
		|	И _Deals_With_Details.Operation_Type В (""Operations.Group.Deals.Trade"", ""Operations.Group.Deals.Forward"", ""Operations.Group.Deals.Swap"")
		|	И _Deals_With_Details.Is_Deal_Info = ""0""
		|	И _Deals_With_Details.Date = &НачалоПериода";
	
#КонецОбласти		

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("Группа_Forwards", Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Forwards"));
	Запрос.УстановитьПараметр("Группа_FX", Группа_FX);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОшибкиЧтения = Новый Массив;  
				
		НоваяСтрокаОперации = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = Строка(Выборка.ВидСделки) + "/" + Выборка.Ключ + ?(Выборка.ТипСделки = Перечисления.ТипыСделокСВалютой.СвопВтораяЧасть, "/2", "");
		НоваяСтрокаОперации.Описание     = "Сделка с валютой, № " + Выборка.Ключ + ", [" + Выборка.ТипСделки + "] ," + Выборка.Валюта + " / " + Выборка.Контрвалюта;
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		Если Выборка.МестоХраненияДенежныхСредств = Справочники.МестаХранения.ВнебиржевойРынок И Не ЗначениеЗаполнено(Выборка.НомерСделки) Тогда
			НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
				Справочники.ВнешниеСистемы.Матрих, Группа_FX, Выборка.Record_UID);			
		КонецЕсли;
				
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = Выборка.ДатаСделки + (Выборка.ВремяСделки - Дата(1, 1, 1));
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.ТипСделки                    = Выборка.ТипСделки;
		РеквизитыШапки.ВидСделки                    = Выборка.ВидСделки;
		РеквизитыШапки.НомерСделки                  = Выборка.НомерСделки;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;	
		РеквизитыШапки.Брокер                       = Брокер;
		РеквизитыШапки.Валюта                       = Выборка.Валюта;
		РеквизитыШапки.Контрвалюта                  = Выборка.Контрвалюта;
		РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.РасчетныйСчетКонтрвалюты     = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.МестоХранения                = Выборка.МестоХраненияДенежныхСредств;
		РеквизитыШапки.ДатаИсполнения 			    = Выборка.ДатаПоставки;
		РеквизитыШапки.ОтложенноеИсполнение         = Выборка.ОтложенноеИсполнение;
		РеквизитыШапки.Сумма                        = Выборка.Сумма;
		РеквизитыШапки.СуммаКонтрвалюты             = Выборка.СуммаКонтрвалюты;
		РеквизитыШапки.Курс                         = Выборка.Курс;
		РеквизитыШапки.СуммаКомиссии				= Выборка.СуммаТорговойКомиссии;
		РеквизитыШапки.ВалютаКомиссии				= Выборка.ВалютаТорговойКомиссии;
		РеквизитыШапки.ОтложеннаяОплатаКомиссии		= Выборка.ОтложеннаяОплатаТорговойКомиссии;
		РеквизитыШапки.ДатаОплатыКомиссии			= Выборка.ДатаОплатыТорговойКомиссии;
		
		Если Не ЗначениеЗаполнено(Выборка.Основание) И (ЗначениеЗаполнено(Выборка.НомерСделки) И Выборка.ТипСделки <> Перечисления.ТипыСделокСВалютой.Конверсионная Или ЗначениеЗаполнено(Выборка.Near_Deal_Record_UID)) Тогда
			ОшибкиЧтения.Добавить("Не удалось определить документ основание по " + ?(ЗначениеЗаполнено(Выборка.НомерСделки), "номеру сделки [" + Выборка.НомерСделки + "]!", "коду [" + Выборка.Near_Deal_Record_UID + "]!"));
		Иначе
			РеквизитыШапки.Основание = Выборка.Основание;
		КонецЕсли;
				
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка", РеквизитыШапки);
		
		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
		
	КонецЦикла;                                   
	
	ТекущиеОперации = МВТ.Таблицы["_СделкиСВалютойДанныеСистемы"].ПолучитьДанные().Выгрузить();
	ТекущиеОперации.Колонки.Удалить("НомерПодтверждения");
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента);
		
	Возврат Операции;
	
КонецФункции

Функция ОбработатьПереводыДенежныхСредств_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.ПереводДенежныхСредств, Операции, ПоляДокумента);
	
	Группа_MoneyTransfer = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Money_Transfer");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаБэкОфисаСрезПоследних.АвтоматизированаПодачаПоручений КАК АвтоматизированаПодачаПоручений
		|ПОМЕСТИТЬ _НастройкаУчетаБэкОфиса
		|ИЗ
		|	РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(КодыПорученийВоВнешнихСистемахСрезПоследних.Код, _ВнебиржевыеОперации.НомерОперации) КАК Ключ,
		|	&Звездочка КАК Звездочка
		|ПОМЕСТИТЬ _ПереводыДанныеСистемы
		|ИЗ
		|	Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО ПереводДенежныхСредств.Ссылка = _ВнебиржевыеОперации.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкаУчетаБэкОфиса КАК _НастройкаУчетаБэкОфиса
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&КонецПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.QUIK)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.НомераПоручений)) КАК КодыПорученийВоВнешнихСистемахСрезПоследних
		|		ПО ПереводДенежныхСредств.Основание = КодыПорученийВоВнешнихСистемахСрезПоследних.Объект
		|ГДЕ
		|	ПереводДенежныхСредств.Организация = &Организация
		|	И НЕ ПереводДенежныхСредств.ПометкаУдаления
		|	И ПереводДенежныхСредств.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ПереводДенежныхСредств.Брокер = &Брокер
		|	И НЕ(ПереводДенежныхСредств.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|				И НЕ _НастройкаУчетаБэкОфиса.АвтоматизированаПодачаПоручений)
		|	И НЕ ПереводДенежныхСредств.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Money_Instructions.Record_UID КАК Record_UID,
		|	_Money_Instructions.Date КАК Дата,
		|	ВЫБОР
		|		КОГДА _НастройкаУчетаБэкОфиса.АвтоматизированаПодачаПоручений
		|			ТОГДА _Money_Instructions.External_Reference
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК External_Reference,
		|	_Money_Instructions.Amount КАК Сумма,
		|	ВалютыПеревода.Валюта КАК Валюта,
		|	_КодыСчетовВнутреннегоУчетаОсновные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчетаОсновные.Секция КАК Секция_1,
		|	_КодыСчетовВнутреннегоУчетаДополнительные.Секция КАК Секция_2,
		|	ВЫБОР
		|		КОГДА _Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.In""
		|			ТОГДА ЕСТЬNULL(_МестаХраненияДенежныхСредств_2.Ссылка, ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|		ИНАЧЕ _МестаХраненияДенежныхСредств_1.Ссылка
		|	КОНЕЦ КАК МестоХранения,
		|	ВЫБОР
		|		КОГДА _Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.In""
		|			ТОГДА _МестаХраненияДенежныхСредств_1.Ссылка
		|		ИНАЧЕ ЕСТЬNULL(_МестаХраненияДенежныхСредств_2.Ссылка, ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|	КОНЕЦ КАК МестоХраненияПолучатель,
		|	ВЫБОР
		|		КОГДА КодыВоВнешнихСистемахСрезПоследних.Объект ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Документ.ПоручениеНаПереводДенежныхСредств.ПустаяСсылка)
		|		ИНАЧЕ ВЫРАЗИТЬ(КодыВоВнешнихСистемахСрезПоследних.Объект КАК Документ.ПоручениеНаПереводДенежныхСредств).Ссылка
		|	КОНЕЦ КАК Основание,
		|	ВЫБОР
		|		КОГДА _Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.In""
		|				И _МестаХраненияДенежныхСредств_2.Ссылка ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|		ИНАЧЕ &Брокер
		|	КОНЕЦ КАК Брокер,
		|	ВЫБОР
		|		КОГДА _Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.Out""
		|				И _МестаХраненияДенежныхСредств_2.Ссылка ЕСТЬ NULL
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|		ИНАЧЕ &Брокер
		|	КОНЕЦ КАК БрокерПолучатель
		|ИЗ
		|	_Money_Instructions КАК _Money_Instructions
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Money_Instructions.Ключ = _ДанныеПервыхУзлов.Ключ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК ВалютыПеревода
		|		ПО _Money_Instructions.Currency_Code = ВалютыПеревода.ISO_Code
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств_1
		|		ПО _Money_Instructions.Money_Storage_Place = _МестаХраненияДенежныхСредств_1.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств_2
		|		ПО _Money_Instructions.Partner_Money_Storage_Place = _МестаХраненияДенежныхСредств_2.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчетаОсновные
		|		ПО _Money_Instructions.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчетаОсновные.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчетаДополнительные
		|		ПО _Money_Instructions.Partner_Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчетаДополнительные.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкаУчетаБэкОфиса КАК _НастройкаУчетаБэкОфиса
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&КонецПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.QUIK)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.НомераПоручений)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО _Money_Instructions.External_Reference = КодыВоВнешнихСистемахСрезПоследних.Код
		|			И (_Money_Instructions.External_Reference <> """")
		|ГДЕ
		|	НЕ _КодыСчетовВнутреннегоУчетаОсновные.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _КодыСчетовВнутреннегоУчетаОсновные.ИсключенИзЗагрузки = ЛОЖЬ
		|	И НЕ(_Money_Instructions.Money_Storage_Place = ""MICEX""
		|				И _Money_Instructions.Partner_Money_Storage_Place = ""MICEX"")
		|	И НЕ(_Money_Instructions.Money_Storage_Place = ""OTC""
		|				И _Money_Instructions.Partner_Money_Storage_Place = ""OTC""
		|				И НЕ(_КодыСчетовВнутреннегоУчетаОсновные.Секция = ""Валютная""
		|						ИЛИ _КодыСчетовВнутреннегоУчетаДополнительные.Секция = ""Валютная""))
		|	И НЕ((_Money_Instructions.Transfer_Type = ""Transfer.Type.Account""
		|				ИЛИ _Money_Instructions.Transfer_Type = ""Transfer.Type.Portfolio""
		|					И (&УК_Траст
		|							И &НачалоПериода > ДАТАВРЕМЯ(2021, 11, 3)
		|						ИЛИ НЕ &УК_Траст
		|							И (_КодыСчетовВнутреннегоУчетаОсновные.ДатаЗаключенияСчета > ДАТАВРЕМЯ(2021, 11, 1)
		|								ИЛИ &НачалоПериода > ДАТАВРЕМЯ(2022, 6, 9))))
		|				И _Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.Transfer""
		|				И _Money_Instructions.Money_Storage_Place = _Money_Instructions.Partner_Money_Storage_Place)
		|	И НЕ(_Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.In""
		|				И _Money_Instructions.Partner_Money_Storage_Place = """")
		|	И НЕ(_Money_Instructions.Operation_Type = ""Operations.Group.MoneyInstructions.Out""
		|				И _Money_Instructions.Partner_Money_Storage_Place = """"
		|				И НЕ _НастройкаУчетаБэкОфиса.АвтоматизированаПодачаПоручений)
		|	И _Money_Instructions.Deal_Record_UID = """"
		|	И _Money_Instructions.Date = &НачалоПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сумма УБЫВ";
#КонецОбласти
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	
	//В УК РЭМ и Траст переводы создаются через НТП (на основании поручений поданых через QUIK) 
	//При сверке исключаем Расчетный счет.
	//Для других УК исключены выводы с брокера/биржи на расчетный счет. Брокер не раскрывает инфу о р/с получателе.
	ЭтоУК_Траст  = (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ")); 
	ЭтоРЭМ_Траст = (ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Или ЭтоУК_Траст);
	
	Запрос.УстановитьПараметр("УК_Траст", ЭтоУК_Траст); 

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
				
		ОшибкиЧтения = Новый Массив;
		
		НоваяСтрокаОперации              = Операции.Добавить();
		НоваяСтрокаОперации.Ключ         = ?(Выборка.External_Reference = "", Выборка.Record_UID, Выборка.External_Reference);
		НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
		НоваяСтрокаОперации.Статус       = "Новый";
		НоваяСтрокаОперации.Описание     = "Перевод д/с, " + Строка(Выборка.МестоХранения) + " -> " + Строка(Выборка.МестоХраненияПолучатель) + ", " + Выборка.Сумма + " " + Выборка.Валюта;
		НоваяСтрокаОперации.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		Если Выборка.External_Reference = "" Тогда //если перевод создан не на основании поручения
			НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код",
				Справочники.ВнешниеСистемы.Матрих, Группа_MoneyTransfer, Выборка.Record_UID);
		КонецЕсли;
				
		РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
		РеквизитыШапки.Проведен                     = Истина;
		РеквизитыШапки.ПометкаУдаления              = Ложь;
		РеквизитыШапки.Дата                         = ?(ЗначениеЗаполнено(Выборка.Основание) И ЭтотОбъект.ДатаИмпорта = НачалоДня(Выборка.Основание.Дата), Выборка.Основание.Дата + 1, ЭтотОбъект.ДатаИмпорта + (?(ЭтоРЭМ_Траст, 10, 14) * 60 + 30) * 60); //Для РПИ 14:30, Для РЭМа и Траста 10:30
		РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
		РеквизитыШапки.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
		
		Если ЗначениеЗаполнено(Выборка.External_Reference) И Не ЗначениеЗаполнено(Выборка.Основание) Тогда
			ОшибкиЧтения.Добавить("Не удалось определить поручение на перевод денежных средств по номеру [" + Выборка.External_Reference + "].");
		Иначе
			РеквизитыШапки.Основание = Выборка.Основание;
		КонецЕсли;

		РеквизитыШапки.ВариантПеревода      = Перечисления.ВариантыПереводаДенежныхСредств.Перевод;
		РеквизитыШапки.Сумма                = Выборка.Сумма;
		РеквизитыШапки.Валюта               = Выборка.Валюта;
		РеквизитыШапки.ФормаДенежныхСредств = Перечисления.ФормыДенежныхСредств.Безналичная;
		РеквизитыШапки.Брокер               = Выборка.Брокер;
		РеквизитыШапки.РасчетныйСчет        = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.МестоХранения        = Выборка.МестоХранения;
		РеквизитыШапки.Касса                = Справочники.Кассы.ПустаяСсылка();   
		
		РеквизитыШапки.ФормаДенежныхСредствПолучатель = Перечисления.ФормыДенежныхСредств.Безналичная;
		РеквизитыШапки.БрокерПолучатель               = Выборка.БрокерПолучатель;
		РеквизитыШапки.РасчетныйСчетПолучатель        = Справочники.БанковскиеСчета.ПустаяСсылка();
		РеквизитыШапки.МестоХраненияПолучатель        = Выборка.МестоХраненияПолучатель;
		РеквизитыШапки.КассаПолучатель                = Справочники.Кассы.ПустаяСсылка();
		
		РеквизитыШапки.СтрокаБанковскойВыписки           = Документы.СтрокаБанковскойВыписки.ПустаяСсылка();
		РеквизитыШапки.СтрокаБанковскойВыпискиПолучатель = Документы.СтрокаБанковскойВыписки.ПустаяСсылка();
		
		НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка", РеквизитыШапки);

		Если ОшибкиЧтения.Количество() > 0 Тогда
			НоваяСтрокаОперации.Статус = "Ошибка чтения";
		КонецЕсли;
		
	КонецЦикла;
	
	ИсключитьИзСверки = "Дата, СтрокаБанковскойВыпискиПолучатель, СтрокаБанковскойВыписки, РасчетныйСчетПолучатель"; //брокер не предоставляет данные
	
	ТекущиеОперации = МВТ.Таблицы["_ПереводыДанныеСистемы"].ПолучитьДанные().Выгрузить();
	ТекущиеОперации.Сортировать("Сумма УБЫВ");
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьНачисленияКомиссии_OTBR(МВТ)
	
	Перем Операции, ПоляДокумента;
	
	ГруппаИмпортируемыхОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Commission");
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.НачислениеЗадолженности, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
		
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор КАК Договор,
		|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор.ДатаЗаключения КАК ДепозитарныйСчетДоговорДатаЗаключения
		|ПОМЕСТИТЬ _ВсеДоговорыДепозитарногоОбслуживания
		|ИЗ
		|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Дата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Договор)
		|ГДЕ
		|	ИсполнителиПоЦеннымБумагам.Организация = &Организация
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &Дата)
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Дата)
		|	И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо = &ДепозитарийЮрЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВложенныйЗапрос.КоличествоДоговоров КАК КоличествоДоговоров,
		|	_ВсеДоговорыДепозитарногоОбслуживания.Договор КАК Договор
		|ПОМЕСТИТЬ _Договоры
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ВсеДоговорыДепозитарногоОбслуживания.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеДоговорыДепозитарногоОбслуживания.Договор) КАК КоличествоДоговоров,
		|		МИНИМУМ(_ВсеДоговорыДепозитарногоОбслуживания.ДепозитарныйСчетДоговорДатаЗаключения) КАК ДатаМаксимум
		|	ИЗ
		|		_ВсеДоговорыДепозитарногоОбслуживания КАК _ВсеДоговорыДепозитарногоОбслуживания
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ВсеДоговорыДепозитарногоОбслуживания.СчетДоверительногоУправления) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсеДоговорыДепозитарногоОбслуживания КАК _ВсеДоговорыДепозитарногоОбслуживания
		|		ПО ВложенныйЗапрос.СчетДоверительногоУправления = _ВсеДоговорыДепозитарногоОбслуживания.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.ДатаМаксимум = _ВсеДоговорыДепозитарногоОбслуживания.ДепозитарныйСчетДоговорДатаЗаключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Charges_Operations.Record_UID КАК Record_UID,
		|	_Charges_Operations.Date КАК Date,
		|	_Charges_Operations.Origin_Operation_Type КАК Origin_Operation_Type,
		|	ВЫБОР
		|		КОГДА _Charges_Operations.Origin_Operation_Type В (&ТипыБрокерскойКомиссии)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|		КОГДА _Charges_Operations.Origin_Operation_Type В (""Operations.Group.Charges.SE.Transaction"", ""Operations.Group.Settlements.Add.SE.Fee"")
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|		КОГДА _Charges_Operations.Origin_Operation_Type = ""Operations.Group.Charges.Depository""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидЗадолженности,
		|	_Charges_Operations.Payment_Amount КАК Payment_Amount,
		|	_Charges_Operations.Payment_Currency_Code КАК Payment_Currency_Code,
		|	_Charges_Operations.Security_ID КАК Security_ID,
		|	_Charges_Operations.Volume КАК Volume,
		|	_Charges_Operations.Market КАК Market,
		|	ВЫБОР
		|		КОГДА _Charges_Operations.Market = ""MOEX.FX""
		|				ИЛИ _КодыСчетовВнутреннегоУчета.Секция = ""Валютная""
		|			ТОГДА ""MOEX.FX""
		|		ИНАЧЕ ""MICEX""
		|	КОНЕЦ КАК Money_Market,
		|	_Charges_Operations.Invoice_Number КАК Invoice_Number,
		|	_Charges_Operations.Charge_Record_UID КАК Charge_Record_UID,
		|	_Charges_Operations.Deal_Record_UID КАК Deal_Record_UID,
		|	_Charges_Operations.Inner_Account_Division_ID КАК Inner_Account_Division_ID,
		|	_Charges_Operations.Storage_Place КАК Storage_Place,
		|	_Charges_Operations.Market_Number КАК Market_Number,
		|	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага,
		|	_Валюты.Валюта КАК ВалютаОплаты,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number КАК КодУБрокера,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций КАК КодДляСверкиОпераций
		|ПОМЕСТИТЬ _НачисленияКомиссий
		|ИЗ
		|	_Charges_Operations КАК _Charges_Operations
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Charges_Operations.Ключ = _ДанныеПервыхУзлов.Ключ
		|			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
		|		ПО _Charges_Operations.Security_ID = _ЦенныеБумаги.Matrix_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
		|		ПО _Charges_Operations.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _Charges_Operations.Payment_Currency_Code = _Валюты.ISO_Code
		|ГДЕ
		|	_Charges_Operations.Date = &Дата
		|	И НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НачисленияКомиссий.Record_UID КАК Record_UID,
		|	_НачисленияКомиссий.Date КАК Date,
		|	_НачисленияКомиссий.Origin_Operation_Type КАК Origin_Operation_Type,
		|	_НачисленияКомиссий.ВидЗадолженности КАК ВидЗадолженности,
		|	_НачисленияКомиссий.Payment_Amount КАК Сумма,
		|	_НачисленияКомиссий.Payment_Currency_Code КАК Payment_Currency_Code,
		|	_НачисленияКомиссий.Security_ID КАК Security_ID,
		|	_НачисленияКомиссий.Volume КАК Volume,
		|	_НачисленияКомиссий.Market КАК Market,
		|	_НачисленияКомиссий.Invoice_Number КАК Invoice_Number,
		|	_НачисленияКомиссий.Charge_Record_UID КАК Charge_Record_UID,
		|	_НачисленияКомиссий.Deal_Record_UID КАК Deal_Record_UID,
		|	_НачисленияКомиссий.Inner_Account_Division_ID КАК Inner_Account_Division_ID,
		|	_НачисленияКомиссий.Storage_Place КАК Storage_Place,
		|	_НачисленияКомиссий.Market_Number КАК Market_Number,
		|	_НачисленияКомиссий.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_НачисленияКомиссий.ВалютаОплаты КАК ВалютаОплаты,
		|	_НачисленияКомиссий.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НачисленияКомиссий.КодУБрокера КАК КодУБрокера,
		|	_НачисленияКомиссий.КодДляСверкиОпераций КАК КодДляСверкиОпераций,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	ЕСТЬNULL(_Договоры.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК Договор,
		|	_Договоры.КоличествоДоговоров КАК КоличествоДоговоров,
		|	ВЫБОР
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.REPO"", ""Operations.Group.Charges.SE.Transaction"")
		|				И _НачисленияКомиссий.Market = ""MICEX""
		|			ТОГДА СделкаРЕПО.Ссылка
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.FX"", ""Operations.Group.Charges.SE.Transaction"")
		|				И _НачисленияКомиссий.Market = ""MOEX.FX""
		|			ТОГДА СделкаСВалютой.Ссылка
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Charges.SE.Transaction"", ""Operations.Group.Charges.Broker.Derivatives"")
		|				И _НачисленияКомиссий.Market В (""MICEX"", ""FORTS"")
		|				И _НачисленияКомиссий.Market_Number <> """"
		|			ТОГДА Сделка.Ссылка
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.SE.Transaction""
		|				И _НачисленияКомиссий.Market = ""FORTS""
		|				И _НачисленияКомиссий.Market_Number = """"
		|			ТОГДА _СделкиИсполненияФьючерсныхКонтрактов.Ссылка
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Charges.Broker.Bills"", ""Operations.Group.Settlements.Add.SE.Fee"")
		|				И _НачисленияКомиссий.Market = ""OTC""
		|			ТОГДА _ВнебиржевыеСделки.Объект
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.Broker.REPO""
		|				И _НачисленияКомиссий.Market = ""OTC""
		|			ТОГДА _ВнебиржевыеСделкиРепо.Объект
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.Broker.FX""
		|				И _НачисленияКомиссий.Market = ""OTC""
		|			ТОГДА _ВнебиржевыеСделкиСВалютой.Объект
		|		КОГДА _НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker"", ""Operations.Group.Charges.Broker.Derivatives"")
		|				И _НачисленияКомиссий.Market = ""OTC""
		|			ТОГДА СделкаСПФИ.Ссылка
		|	КОНЕЦ КАК Основание,
		|	ВЫБОР
		|		КОГДА _НачисленияКомиссий.Market_Number = """"
		|				И _НачисленияКомиссий.Deal_Record_UID = """"
		|				И НЕ(_НачисленияКомиссий.Market = ""FORTS""
		|						И _НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.SE.Transaction"")
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ФлагЕстьОснование
		|ИЗ
		|	_НачисленияКомиссий КАК _НачисленияКомиссий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _НачисленияКомиссий.Money_Market = _МестаХраненияДенежныхСредств.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО _НачисленияКомиссий.Market_Number = Сделка.НомерСделки
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = Сделка.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Charges.SE.Transaction"", ""Operations.Group.Charges.Broker.Derivatives""))
		|			И (_НачисленияКомиссий.Market В (""MICEX"", ""FORTS""))
		|			И (_НачисленияКомиссий.Market_Number <> """")
		|			И (Сделка.Проведен = ИСТИНА)
		|			И (Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (Сделка.Организация = &Организация)
		|			И (Сделка.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиИсполненияФьючерсныхКонтрактов КАК _СделкиИсполненияФьючерсныхКонтрактов
		|		ПО _НачисленияКомиссий.СчетДоверительногоУправления = _СделкиИсполненияФьючерсныхКонтрактов.СчетДоверительногоУправления
		|			И _НачисленияКомиссий.ЦеннаяБумага = _СделкиИсполненияФьючерсныхКонтрактов.ЦеннаяБумага
		|			И _НачисленияКомиссий.Volume = _СделкиИсполненияФьючерсныхКонтрактов.Количество
		|			И (_НачисленияКомиссий.Market_Number = """")
		|			И (_НачисленияКомиссий.Market = ""FORTS"")
		|			И (_НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.SE.Transaction"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (ВЫБОР
		|				КОГДА СделкаРЕПО.СделкаСЦентральнымКонтрагентом = ЛОЖЬ
		|					ТОГДА _НачисленияКомиссий.Market_Number = СделкаРЕПО.НомерСделки
		|				ИНАЧЕ _НачисленияКомиссий.Market_Number = СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом
		|			КОНЕЦ)
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = СделкаРЕПО.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.REPO"", ""Operations.Group.Charges.SE.Transaction""))
		|			И (_НачисленияКомиссий.Market = ""MICEX"")
		|			И (_НачисленияКомиссий.Market_Number <> """")
		|			И (СделкаРЕПО.ЧастьСделкиРЕПО = 1)
		|			И (СделкаРЕПО.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаРЕПО.Проведен = ИСТИНА)
		|			И (СделкаРЕПО.Организация = &Организация)
		|			И (СделкаРЕПО.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО _НачисленияКомиссий.Market_Number = СделкаСВалютой.НомерСделки
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = СделкаСВалютой.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.FX"", ""Operations.Group.Charges.SE.Transaction""))
		|			И (_НачисленияКомиссий.Market = ""MOEX.FX"")
		|			И (_НачисленияКомиссий.Market_Number <> """")
		|			И (СделкаСВалютой.Проведен = ИСТИНА)
		|			И (СделкаСВалютой.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаСВалютой.Организация = &Организация)
		|			И (СделкаСВалютой.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСПФИ КАК СделкаСПФИ
		|		ПО _НачисленияКомиссий.Market_Number = СделкаСПФИ.НомерСделки
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = СделкаСПФИ.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker"", ""Operations.Group.Charges.Broker.Derivatives""))
		|			И (_НачисленияКомиссий.Market = ""OTC"")
		|			И (_НачисленияКомиссий.Market_Number <> """")
		|			И (СделкаСПФИ.Проведен = ИСТИНА)
		|			И (СделкаСПФИ.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаСПФИ.Организация = &Организация)
		|			И (СделкаСПФИ.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ПО _НачисленияКомиссий.Deal_Record_UID = _ВнебиржевыеСделки.НомерОперации
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = _ВнебиржевыеСделки.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Market = ""OTC"")
		|			И (_НачисленияКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Charges.Broker.Bills"", ""Operations.Group.Settlements.Add.SE.Fee""))
		|			И (_НачисленияКомиссий.Deal_Record_UID <> """")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделкиРепо
		|		ПО _НачисленияКомиссий.Deal_Record_UID = _ВнебиржевыеСделкиРепо.НомерОперации
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = _ВнебиржевыеСделкиРепо.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Market = ""OTC"")
		|			И (_НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.Broker.REPO"")
		|			И (_НачисленияКомиссий.Deal_Record_UID <> """")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделкиСВалютой
		|		ПО _НачисленияКомиссий.Deal_Record_UID = _ВнебиржевыеСделкиСВалютой.НомерОперации
		|			И _НачисленияКомиссий.СчетДоверительногоУправления = _ВнебиржевыеСделкиСВалютой.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Market = ""OTC"")
		|			И (_НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.Broker.FX"")
		|			И (_НачисленияКомиссий.Deal_Record_UID <> """")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Договоры КАК _Договоры
		|		ПО _НачисленияКомиссий.СчетДоверительногоУправления = _Договоры.СчетДоверительногоУправления
		|			И (_НачисленияКомиссий.Origin_Operation_Type = ""Operations.Group.Charges.Depository"")
		|
		|УПОРЯДОЧИТЬ ПО
		|	Deal_Record_UID,
		|	Record_UID
		|ИТОГИ ПО
		|	СчетДоверительногоУправления,
		|	МестоХраненияДенежныхСредств,
		|	ВидЗадолженности,
		|	ВалютаОплаты,
		|	ФлагЕстьОснование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _НачисленияКомиссий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ВсеДоговорыДепозитарногоОбслуживания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Договоры";
#КонецОбласти
	
	СтрокаТиповБрокерскойКомиссии = "Operations.Group.Charges.Broker, Operations.Group.Charges.Broker.Equities, Operations.Group.Charges.Broker.FX, Operations.Group.Charges.Broker.REPO,
									|Operations.Group.Charges.Recovery, Operations.Group.Charges.Agent, Operations.Group.Charges.Broker.FX.REPO,
									|Operations.Group.Charges.Clearing, Operations.Group.Charges.Broker.Derivatives, Operations.Group.Charges.Broker.Bills";
	
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("ДепозитарийЮрЛицо", Брокер.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ТипыБрокерскойКомиссии", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаТиповБрокерскойКомиссии, ",", Истина, Истина));
			
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	МассивКодовНачислений = Новый Массив;
	
	Пока ГруппировкаПоСчету.Следующий() Цикл
		
		ГруппировкаПоМестуХранения = ГруппировкаПоСчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ГруппировкаПоМестуХранения.Следующий() Цикл
	
			ГруппировкаПоВидуЗадолженности = ГруппировкаПоМестуХранения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ГруппировкаПоВидуЗадолженности.Следующий() Цикл
				
				ГруппировкаПоВалютеОплаты = ГруппировкаПоВидуЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ГруппировкаПоВалютеОплаты.Следующий() Цикл
					
					ГруппировкаПоФлагуЕстьОснование = ГруппировкаПоВалютеОплаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ГруппировкаПоФлагуЕстьОснование.Следующий() Цикл
					
						ВыборкаЗаписей = ГруппировкаПоФлагуЕстьОснование.Выбрать();
												
						НомерСтроки = 0;
									
						Пока ВыборкаЗаписей.Следующий() Цикл
							
							Если НомерСтроки = 0 Тогда
								
								ОшибкиЧтения        = Новый Массив;
								НоваяСтрокаОперации = Операции.Добавить();
								
								Если ЗначениеЗаполнено(ВыборкаЗаписей.Deal_Record_UID) Или ВыборкаЗаписей.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария Тогда 
									НоваяСтрокаОперации.Ключ = СокрЛП(ВыборкаЗаписей.КодДляСверкиОпераций) + "/" + ВыборкаЗаписей.ВидЗадолженности.ИмяПредопределенныхДанных + "/" + ВыборкаЗаписей.ВалютаОплаты.Наименование + "/" + ВыборкаЗаписей.МестоХраненияДенежныхСредств.Наименование;
								ИначеЕсли Не ПустаяСтрока(ВыборкаЗаписей.Record_UID) Тогда
									НоваяСтрокаОперации.Ключ                = ?(ВыборкаЗаписей.Origin_Operation_Type = "Operations.Group.Charges.Broker", ВыборкаЗаписей.Charge_Record_UID, ВыборкаЗаписей.Record_UID);
									НоваяСтрокаОперации.КодВоВнешнейСистеме = Новый Структура("ВнешняяСистема, ГруппаОбъектов, Код", Справочники.ВнешниеСистемы.Матрих, ГруппаИмпортируемыхОбъектов, НоваяСтрокаОперации.Ключ);
								КонецЕсли;
								
								НоваяСтрокаОперации.Описание     = "Начисление комиссии / " + ?(ВыборкаЗаписей.Origin_Operation_Type = "Operations.Group.Charges.Broker", ВыборкаЗаписей.Charge_Record_UID, ВыборкаЗаписей.Record_UID);;
								НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
								НоваяСтрокаОперации.Статус       = "Новый";
								НоваяСтрокаОперации.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
														
								РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
								РеквизитыШапки.Проведен                     = Истина;
								РеквизитыШапки.ПометкаУдаления              = Ложь;
								РеквизитыШапки.Дата                         = ЭтотОбъект.ДатаИмпорта + 73799; // "20:29:59"
								РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
								РеквизитыШапки.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
								
								Если ЗначениеЗаполнено(ВыборкаЗаписей.ВидЗадолженности) Тогда
									РеквизитыШапки.ВидЗадолженности         = ВыборкаЗаписей.ВидЗадолженности;
								Иначе
									ОшибкиЧтения.Добавить("Не удалось определить вид задолженности по Origin_Operation_Type = [" + ВыборкаЗаписей.Origin_Operation_Type + "]");	
								КонецЕсли;
								
								РеквизитыШапки.ПрочиеДоходыИРасходы			= ПолучитьПрочиеДоходыИРасходы(ВыборкаЗаписей.ВидЗадолженности);
								РеквизитыШапки.МестоХранения                = ВыборкаЗаписей.МестоХраненияДенежныхСредств;
								РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
								РеквизитыШапки.Брокер                       = Брокер;
								РеквизитыШапки.Контрагент                   = РеквизитыШапки.Брокер.ЮрФизЛицо;
								РеквизитыШапки.Валюта                       = ВыборкаЗаписей.ВалютаОплаты;
								РеквизитыШапки.ДополнительнаяАналитика		= Справочники.ДополнительныеАналитикиЛицевыхСчетов.ПустаяСсылка();
								РеквизитыШапки.ДатаПолученияДокумента		= НачалоДня(РеквизитыШапки.Дата);
								РеквизитыШапки.Договор                      = ВыборкаЗаписей.Договор;
								РеквизитыШапки.НачалоПериодаНачисления		= '00010101';
								РеквизитыШапки.ОкончаниеПериодаНачисления	= '00010101';
								РеквизитыШапки.Вознаграждение                    = Ложь;
								РеквизитыШапки.НеУчитыватьВСЧА                   = Ложь;
								РеквизитыШапки.ПоКлиентскомуОтноситьНаДатуОплаты = Ложь;
								
								Если ВыборкаЗаписей.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария Тогда
									
									Если ЗначениеЗаполнено(ВыборкаЗаписей.Договор) Тогда
										Если ВыборкаЗаписей.КоличествоДоговоров > 1 Тогда
											ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента [" + ВыборкаЗаписей.СчетДоверительногоУправления + "] на " + Формат(ДатаИмпорта, "ДФ=dd.MM.yyyy") + " обнаружено несколько действующих договоров депозитарного обслуживания! Для документов по депозитарной комиссии будет установлен договор " + ВыборкаЗаписей.Договор + ".");
										КонецЕсли;
									Иначе
										ОшибкиЧтения.Добавить("Не удалось определить договор депозитарного обслуживания для клиента [" + ВыборкаЗаписей.СчетДоверительногоУправления + "] на " + Формат(ДатаИмпорта, "ДФ=dd.MM.yyyy"));
									КонецЕсли;
									
								КонецЕсли;
								
								Основания = Новый Массив;
								НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, Основания", РеквизитыШапки, Основания);
								
							КонецЕсли;
							
							НомерСтроки = НомерСтроки + 1;										
							РеквизитыОснования = Новый Структура(ПоляДокумента.Основания);
							РеквизитыОснования.НомерСтроки = НомерСтроки;
							РеквизитыОснования.ДатаОплаты  = НачалоДня(ЭтотОбъект.ДатаИмпорта);
							РеквизитыОснования.Сумма       = ВыборкаЗаписей.Сумма;
							РеквизитыОснования.СтавкаНДС   = Перечисления.СтавкиНДС.ПустаяСсылка();
							РеквизитыОснования.СуммаНДС    = 0;
												
							Если ЗначениеЗаполнено(ВыборкаЗаписей.Основание) Тогда
								РеквизитыОснования.Основание = ВыборкаЗаписей.Основание;
							Иначе
								Если ВыборкаЗаписей.Market = "MICEX" Тогда
									
									Если ЗначениеЗаполнено(ВыборкаЗаписей.Market_Number) Тогда
										ОшибкиЧтения.Добавить("Не удалось определить документ основание по номеру сделки/сделки Репо [" + ВыборкаЗаписей.Market_Number + "].");
									Иначе
										ОшибкиЧтения.Добавить("Не удалось определить документ основание. Отсутствует номер сделки [Market_Number]. Операция Record_UID [" + ВыборкаЗаписей.Record_UID + "].");
									КонецЕсли;
									
								ИначеЕсли ВыборкаЗаписей.Market = "MOEX.FX" Тогда
									
									Если ЗначениеЗаполнено(ВыборкаЗаписей.Market_Number) Тогда
										ОшибкиЧтения.Добавить("Не удалось определить документ основание по номеру сделки с валютой [" + ВыборкаЗаписей.Market_Number + "].");
									Иначе
										ОшибкиЧтения.Добавить("Не удалось определить документ основание. Отсутствует номер сделки с валютой [Market_Number]. Операция Record_UID [" + ВыборкаЗаписей.Record_UID + "].");
									КонецЕсли;
									
								ИначеЕсли ВыборкаЗаписей.Market = "OTC" Тогда
									
									Если ЗначениеЗаполнено(ВыборкаЗаписей.Market_Number) Тогда
										ОшибкиЧтения.Добавить("Не удалось определить документ основание по номеру сделки/сделки Репо [" + ВыборкаЗаписей.Market_Number + "].");
									ИначеЕсли ЗначениеЗаполнено(ВыборкаЗаписей.Deal_Record_UID) Тогда
										ОшибкиЧтения.Добавить("Не удалось определить документ основание по Matrix ID [" + ВыборкаЗаписей.Deal_Record_UID + "].");
									КонецЕсли;
									
								Иначе
									 ОшибкиЧтения.Добавить("Не удалось определить документ основание. Операция Record_UID [" + ВыборкаЗаписей.Record_UID + "], место хранения [" + ВыборкаЗаписей.Market + "].");
								КонецЕсли;
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ВыборкаЗаписей.Основание) И ТипЗнч(ВыборкаЗаписей.Основание) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(ВыборкаЗаписей.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
							    РеквизитыОснования.ЦеннаяБумага = ВыборкаЗаписей.ЦеннаяБумага;
							КонецЕсли;
							
							Основания.Добавить(РеквизитыОснования);
							
							Если ОшибкиЧтения.Количество() > 0 Тогда
								НоваяСтрокаОперации.Статус = "Ошибка чтения";
							КонецЕсли;
							//есть начисления без основания, в прошлой загрузке они загружались отдельными документами
							Если ЗначениеЗаполнено(НоваяСтрокаОперации.КодВоВнешнейСистеме) И ВыборкаЗаписей.Origin_Operation_Type <> "Operations.Group.Charges.Broker" Тогда 
								НомерСтроки = 0;
							КонецЕсли;
											
						КонецЦикла;
																
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ВнебиржевыеОперации.НомерОперации, _КодыСчетовУБрокера.КодДляСверкиОпераций) КАК Ключ,
		|	НачислениеЗадолженности.ВидЗадолженности.ИмяПредопределенныхДанных КАК ВидЗадолженностиИмяПредопределенныхДанных,
		|	НачислениеЗадолженности.Валюта.Наименование КАК ВалютаНаименование,
		|	НачислениеЗадолженности.МестоХранения.Наименование КАК МестоХраненияНаименование,
		|	ВЫБОР
		|		КОГДА _ВнебиржевыеОперации.НомерОперации ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагСформироватьКлюч,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовУБрокера КАК _КодыСчетовУБрокера
		|		ПО НачислениеЗадолженности.СчетДоверительногоУправления = _КодыСчетовУБрокера.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеОперации
		|		ПО НачислениеЗадолженности.Ссылка = _ВнебиржевыеОперации.Объект
		|ГДЕ
		|	НачислениеЗадолженности.Организация = &Организация
		|	И НЕ НачислениеЗадолженности.ПометкаУдаления
		|	И НачислениеЗадолженности.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
		|	И (НачислениеЗадолженности.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ИЛИ НачислениеЗадолженности.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			ИЛИ НачислениеЗадолженности.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария))
		|	И НачислениеЗадолженности.Брокер = &Брокер
		|	И НЕ НачислениеЗадолженности.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
#КонецОбласти	

	ТекущиеОперации = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаТекущиеОперации Из ТекущиеОперации Цикл
		Если СтрокаТекущиеОперации.ФлагСформироватьКлюч Тогда
			СтрокаТекущиеОперации.Ключ = "" + СокрЛП(СтрокаТекущиеОперации.Ключ) + "/" + СтрокаТекущиеОперации.ВидЗадолженностиИмяПредопределенныхДанных + "/" + СтрокаТекущиеОперации.ВалютаНаименование + "/" + СтрокаТекущиеОперации.МестоХраненияНаименование;
		КонецЕсли;	
	КонецЦикла;	
	
	ИсключитьИзСверки = "РасчетныйСчетКонтрагента";	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента, ИсключитьИзСверки);
	
	Возврат Операции;
		
КонецФункции 

Функция ОбработатьОплатыКомиссий_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
		
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Оплата, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Документ.НачислениеЗадолженности).Дата КАК Дата,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание.Договор КАК Договор,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _НачисленнаяЗадолженность
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&ГраницаОплат,
		|			Организация = &Организация
		|				И НЕ СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_СчетаИсключеныИзЗагрузки.Счет
		|						ИЗ
		|							_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария)
		|				И Контрагент = &Контрагент) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НачисленнаяЗадолженность.Дата КАК ДатаДок,
		|	_НачисленнаяЗадолженность.Основание КАК ДокНачислениеЗадолженности,
		|	_НачисленнаяЗадолженность.Договор КАК Договор,
		|	_НачисленнаяЗадолженность.Организация КАК Организация,
		|	_НачисленнаяЗадолженность.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НачисленнаяЗадолженность.Валюта КАК Валюта,
		|	_НачисленнаяЗадолженность.Контрагент КАК Контрагент,
		|	_НачисленнаяЗадолженность.СуммаОстаток КАК СуммаОстаток,
		|	СУММА(_НачисленнаяЗадолженность1.СуммаОстаток) КАК СуммаИтого,
		|	_НачисленнаяЗадолженность.ВидЗадолженности КАК ВидЗадолженности
		|ПОМЕСТИТЬ _ЗадолженностьСИтогами
		|ИЗ
		|	_НачисленнаяЗадолженность КАК _НачисленнаяЗадолженность
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачисленнаяЗадолженность КАК _НачисленнаяЗадолженность1
		|		ПО _НачисленнаяЗадолженность.Дата >= _НачисленнаяЗадолженность1.Дата
		|			И _НачисленнаяЗадолженность.СчетДоверительногоУправления = _НачисленнаяЗадолженность1.СчетДоверительногоУправления
		|			И _НачисленнаяЗадолженность.Валюта = _НачисленнаяЗадолженность1.Валюта
		|			И _НачисленнаяЗадолженность.Договор = _НачисленнаяЗадолженность1.Договор
		|			И _НачисленнаяЗадолженность.Контрагент = _НачисленнаяЗадолженность1.Контрагент
		|
		|СГРУППИРОВАТЬ ПО
		|	_НачисленнаяЗадолженность.Дата,
		|	_НачисленнаяЗадолженность.Основание,
		|	_НачисленнаяЗадолженность.Договор,
		|	_НачисленнаяЗадолженность.Организация,
		|	_НачисленнаяЗадолженность.СчетДоверительногоУправления,
		|	_НачисленнаяЗадолженность.Валюта,
		|	_НачисленнаяЗадолженность.Контрагент,
		|	_НачисленнаяЗадолженность.СуммаОстаток,
		|	_НачисленнаяЗадолженность.ВидЗадолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Money_Operations.Record_UID КАК Record_UID,
		|	_Money_Operations.Date КАК Date,
		|	_Money_Operations.Deal_Record_UID КАК Deal_Record_UID,
		|	_Money_Operations.Charge_Record_UID КАК Charge_Record_UID,
		|	_Money_Operations.Origin_Operation_Type КАК Origin_Operation_Type,
		|	_Money_Operations.Money_Storage_Place КАК Money_Storage_Place,
		|	_Money_Operations.Volume КАК Volume,
		|	ВЫБОР
		|		КОГДА _Money_Operations.Origin_Operation_Type В (&ТипыБрокерскойКомиссии)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|		КОГДА _Money_Operations.Origin_Operation_Type = ""Operations.Group.Charges.Depository""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария)
		|		КОГДА _Money_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.Add.SE.Fee""
		|				ИЛИ _Money_Operations.Origin_Operation_Type = ""Operations.Group.Charges.SE.Transaction""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА _Money_Operations.Direction = ""1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|		КОГДА _Money_Operations.Direction = ""-1""
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|	КОНЕЦ КАК ВидДвижения,
		|	ВЫБОР
		|		КОГДА _Money_Operations.Money_Storage_Place = ""OTC""
		|				И _Money_Operations.Origin_Operation_Type = ""Operations.Group.Charges.Broker.FX""
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОснованиеСделкаСВалютой,
		|	_Money_Operations.Payment_Amount КАК Сумма,
		|	_Money_Operations.Market_Number КАК Market_Number,
		|	_Money_Operations.ЗадолженностьНачисленаВТекущемДне КАК ЗадолженностьНачисленаВТекущемДне,
		|	_МестаХраненияДенежныхСредств.Ссылка КАК МестоХраненияДенежныхСредств,
		|	_Валюты.Валюта КАК ВалютаОплаты,
		|	_КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КодыСчетовВнутреннегоУчета.Account_Division_Number КАК КодУБрокера,
		|	_КодыСчетовВнутреннегоУчета.КодДляСверкиОпераций КАК КодДляСверкиОпераций,
		|	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ОплатыКомиссийБезОснований
		|ИЗ
		|	_Money_Operations КАК _Money_Operations
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеПервыхУзлов КАК _ДанныеПервыхУзлов
		|		ПО _Money_Operations.Ключ = _ДанныеПервыхУзлов.Ключ
		|			И (_ДанныеПервыхУзлов.ФайлСоответствуетФормату = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Deals КАК _Deals
		|		ПО _Money_Operations.Deal_Record_UID = _Deals.Record_UID
		|			И _Money_Operations.Market_Number = _Deals.Market_Number
		|			И _Money_Operations.Date = _Deals.Date
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
		|		ПО _Money_Operations.Security_ID = _ЦенныеБумаги.Matrix_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовВнутреннегоУчета КАК _КодыСчетовВнутреннегоУчета
		|		ПО _Money_Operations.Inner_Account_Division_ID = _КодыСчетовВнутреннегоУчета.Account_Division_ID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Валюты КАК _Валюты
		|		ПО _Money_Operations.Payment_Currency_Code = _Валюты.ISO_Code
		|		ЛЕВОЕ СОЕДИНЕНИЕ _МестаХраненияДенежныхСредств КАК _МестаХраненияДенежныхСредств
		|		ПО _Money_Operations.Money_Storage_Place = _МестаХраненияДенежныхСредств.Код
		|ГДЕ
		|	_Money_Operations.Date = &НачалоПериода
		|	И _Money_Operations.Origin_Operation_Type В (&ТипыБрокерскойКомиссии, ""Operations.Group.Charges.Depository"", ""Operations.Group.Settlements.Add.SE.Fee"", ""Operations.Group.Charges.SE.Transaction"")
		|	И НЕ _КодыСчетовВнутреннегоУчета.СчетДоверительногоУправления ЕСТЬ NULL
		|	И _КодыСчетовВнутреннегоУчета.ИсключенИзЗагрузки = ЛОЖЬ
		|	И НЕ(_Money_Operations.Origin_Operation_Type = ""Operations.Group.Settlements.Add.SE.Fee""
		|				И НЕ _Deals.Record_UID ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОплатыКомиссийБезОснований.Record_UID КАК Record_UID,
		|	_ОплатыКомиссийБезОснований.Date КАК Date,
		|	_ОплатыКомиссийБезОснований.Origin_Operation_Type КАК Origin_Operation_Type,
		|	_ОплатыКомиссийБезОснований.Deal_Record_UID КАК Deal_Record_UID,
		|	_ОплатыКомиссийБезОснований.Charge_Record_UID КАК Charge_Record_UID,
		|	_ОплатыКомиссийБезОснований.ВидДвижения КАК ВидДвижения,
		|	_ОплатыКомиссийБезОснований.ОснованиеСделкаСВалютой КАК ОснованиеСделкаСВалютой,
		|	_ОплатыКомиссийБезОснований.Market_Number КАК Market_Number,
		|	_ОплатыКомиссийБезОснований.МестоХраненияДенежныхСредств КАК МестоХраненияДенежныхСредств,
		|	_ОплатыКомиссийБезОснований.ВалютаОплаты КАК ВалютаОплаты,
		|	_ОплатыКомиссийБезОснований.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОплатыКомиссийБезОснований.КодУБрокера КАК КодУБрокера,
		|	_ОплатыКомиссийБезОснований.КодДляСверкиОпераций КАК КодДляСверкиОпераций,
		|	_ОплатыКомиссийБезОснований.ВидЗадолженности КАК ВидЗадолженности,
		|	_ОплатыКомиссийБезОснований.ЗадолженностьНачисленаВТекущемДне КАК ЗадолженностьНачисленаВТекущемДне,
		|	_ОплатыКомиссийБезОснований.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.REPO"", ""Operations.Group.Settlements.Add.SE.Fee"")
		|				И _ОплатыКомиссийБезОснований.Money_Storage_Place <> ""FORTS""
		|				И _ОплатыКомиссийБезОснований.Market_Number <> """"
		|			ТОГДА СделкаРЕПО.Ссылка
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.FX"", ""Operations.Group.Settlements.Add.SE.Fee"")
		|				И _ОплатыКомиссийБезОснований.Market_Number <> """"
		|			ТОГДА СделкаСВалютой.Ссылка
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Clearing"", ""Operations.Group.Charges.Broker"", ""Operations.Group.Charges.Broker.Derivatives"")
		|				И _ОплатыКомиссийБезОснований.Market_Number <> """"
		|				И НЕ СделкаСПФИ.Ссылка ЕСТЬ NULL
		|			ТОГДА СделкаСПФИ.Ссылка
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Settlements.Add.SE.Fee"", ""Operations.Group.Charges.Broker.Derivatives"")
		|				И _ОплатыКомиссийБезОснований.Market_Number <> """"
		|			ТОГДА ЕСТЬNULL(Сделка.Ссылка, _ВнебиржевыеСделки.Объект)
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type = ""Operations.Group.Charges.SE.Transaction""
		|				И _ОплатыКомиссийБезОснований.Market_Number = """"
		|				И _ОплатыКомиссийБезОснований.Money_Storage_Place = ""FORTS""
		|			ТОГДА _СделкиИсполненияФьючерсныхКонтрактов.Ссылка
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Charges.Broker.FX"", ""Operations.Group.Charges.Broker.Bills"")
		|				И _ОплатыКомиссийБезОснований.Market_Number = """"
		|			ТОГДА _ВнебиржевыеСделки.Объект
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type = ""Operations.Group.Charges.Broker.REPO""
		|				И _ОплатыКомиссийБезОснований.Market_Number = """"
		|			ТОГДА _ВнебиржевыеСделкиРепо.Объект
		|		КОГДА _ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Recovery"", ""Operations.Group.Charges.Clearing"", ""Operations.Group.Charges.Agent"", ""Operations.Group.Charges.Broker"")
		|			ТОГДА _НачисленияКомиссий.Объект
		|	КОНЕЦ КАК Основание
		|ПОМЕСТИТЬ _ОплатыКомиссий
		|ИЗ
		|	_ОплатыКомиссийБезОснований КАК _ОплатыКомиссийБезОснований
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО (ВЫБОР
		|				КОГДА СделкаРЕПО.СделкаСЦентральнымКонтрагентом = ЛОЖЬ
		|					ТОГДА _ОплатыКомиссийБезОснований.Market_Number = СделкаРЕПО.НомерСделки
		|				ИНАЧЕ _ОплатыКомиссийБезОснований.Market_Number = СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом
		|			КОНЕЦ)
		|			И (НЕ _ОплатыКомиссийБезОснований.Market_Number = """")
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.REPO"", ""Operations.Group.Settlements.Add.SE.Fee""))
		|			И (_ОплатыКомиссийБезОснований.Money_Storage_Place <> ""FORTS"")
		|			И (СделкаРЕПО.ЧастьСделкиРЕПО = 1)
		|			И (СделкаРЕПО.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаРЕПО.Проведен = ИСТИНА)
		|			И (СделкаРЕПО.Организация = &Организация)
		|			И (СделкаРЕПО.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСВалютой КАК СделкаСВалютой
		|		ПО _ОплатыКомиссийБезОснований.Market_Number = СделкаСВалютой.НомерСделки
		|			И (НЕ _ОплатыКомиссийБезОснований.Market_Number = """")
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.FX"", ""Operations.Group.Settlements.Add.SE.Fee""))
		|			И (СделкаСВалютой.Проведен = ИСТИНА)
		|			И (СделкаСВалютой.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаСВалютой.Организация = &Организация)
		|			И (СделкаСВалютой.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|		ПО _ОплатыКомиссийБезОснований.Market_Number = Сделка.НомерСделки
		|			И (НЕ _ОплатыКомиссийБезОснований.Market_Number = """")
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Settlements.Add.SE.Fee"", ""Operations.Group.Charges.Broker.Derivatives""))
		|			И (Сделка.Проведен = ИСТИНА)
		|			И (Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (Сделка.Организация = &Организация)
		|			И (Сделка.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСПФИ КАК СделкаСПФИ
		|		ПО _ОплатыКомиссийБезОснований.Market_Number = СделкаСПФИ.НомерСделки
		|			И _ОплатыКомиссийБезОснований.СчетДоверительногоУправления = СделкаСПФИ.СчетДоверительногоУправления
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Clearing"", ""Operations.Group.Charges.Broker"", ""Operations.Group.Charges.Broker.Derivatives""))
		|			И (_ОплатыКомиссийБезОснований.Market_Number <> """")
		|			И (СделкаСПФИ.Проведен = ИСТИНА)
		|			И (СделкаСПФИ.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|			И (СделкаСПФИ.Организация = &Организация)
		|			И (СделкаСПФИ.Брокер = &Брокер)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиИсполненияФьючерсныхКонтрактов КАК _СделкиИсполненияФьючерсныхКонтрактов
		|		ПО _ОплатыКомиссийБезОснований.СчетДоверительногоУправления = _СделкиИсполненияФьючерсныхКонтрактов.СчетДоверительногоУправления
		|			И _ОплатыКомиссийБезОснований.ЦеннаяБумага = _СделкиИсполненияФьючерсныхКонтрактов.ЦеннаяБумага
		|			И _ОплатыКомиссийБезОснований.Volume = _СделкиИсполненияФьючерсныхКонтрактов.Количество
		|			И (_ОплатыКомиссийБезОснований.Market_Number = """")
		|			И (_ОплатыКомиссийБезОснований.Money_Storage_Place = ""FORTS"")
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type = ""Operations.Group.Charges.SE.Transaction"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ПО _ОплатыКомиссийБезОснований.Deal_Record_UID = _ВнебиржевыеСделки.НомерОперации
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Broker.Equities"", ""Operations.Group.Charges.Broker.FX"", ""Operations.Group.Charges.Broker.Bills""))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _ВнебиржевыеСделкиРепо
		|		ПО _ОплатыКомиссийБезОснований.Deal_Record_UID = _ВнебиржевыеСделкиРепо.НомерОперации
		|			И (_ОплатыКомиссийБезОснований.Market_Number = """")
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type = ""Operations.Group.Charges.Broker.REPO"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВнебиржевыеОперации КАК _НачисленияКомиссий
		|		ПО _ОплатыКомиссийБезОснований.Charge_Record_UID = _НачисленияКомиссий.НомерОперации
		|			И (_ОплатыКомиссийБезОснований.Origin_Operation_Type В (""Operations.Group.Charges.Recovery"", ""Operations.Group.Charges.Clearing"", ""Operations.Group.Charges.Agent"", ""Operations.Group.Charges.Broker""))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОплатыКомиссий.Record_UID КАК Record_UID,
		|	_ОплатыКомиссий.Date КАК Date,
		|	_ОплатыКомиссий.Origin_Operation_Type КАК Origin_Operation_Type,
		|	_ОплатыКомиссий.Deal_Record_UID КАК Deal_Record_UID,
		|	_ОплатыКомиссий.Charge_Record_UID КАК Charge_Record_UID,
		|	_ОплатыКомиссий.ВидДвижения КАК ВидДвижения,
		|	_ОплатыКомиссий.ОснованиеСделкаСВалютой КАК ОснованиеСделкаСВалютой,
		|	ВЫБОР
		|		КОГДА _ОплатыКомиссий.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария)
		|				И НЕ _ЗадолженностьСИтогами.СуммаИтого ЕСТЬ NULL
		|				И НЕ _ОплатыКомиссий.ЗадолженностьНачисленаВТекущемДне
		|			ТОГДА ВЫБОР
		|					КОГДА _ОплатыКомиссий.Сумма >= _ЗадолженностьСИтогами.СуммаИтого
		|						ТОГДА _ЗадолженностьСИтогами.СуммаОстаток
		|					ИНАЧЕ _ОплатыКомиссий.Сумма - (_ЗадолженностьСИтогами.СуммаИтого - _ЗадолженностьСИтогами.СуммаОстаток)
		|				КОНЕЦ
		|		ИНАЧЕ _ОплатыКомиссий.Сумма
		|	КОНЕЦ КАК Сумма,
		|	_ОплатыКомиссий.Market_Number КАК Market_Number,
		|	_ОплатыКомиссий.МестоХраненияДенежныхСредств КАК МестоХраненияДенежныхСредств,
		|	_ОплатыКомиссий.ВалютаОплаты КАК ВалютаОплаты,
		|	_ОплатыКомиссий.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОплатыКомиссий.КодУБрокера КАК КодУБрокера,
		|	_ОплатыКомиссий.КодДляСверкиОпераций КАК КодДляСверкиОпераций,
		|	ЕСТЬNULL(_ОплатыКомиссий.Основание, _ЗадолженностьСИтогами.ДокНачислениеЗадолженности) КАК Основание,
		|	ЕСТЬNULL(_ЗадолженностьСИтогами.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК Договор,
		|	_ОплатыКомиссий.ВидЗадолженности КАК ВидЗадолженности
		|ИЗ
		|	_ОплатыКомиссий КАК _ОплатыКомиссий
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьСИтогами КАК _ЗадолженностьСИтогами
		|		ПО _ОплатыКомиссий.СчетДоверительногоУправления = _ЗадолженностьСИтогами.СчетДоверительногоУправления
		|			И _ОплатыКомиссий.ВидЗадолженности = _ЗадолженностьСИтогами.ВидЗадолженности
		|			И (ВЫБОР
		|				КОГДА _ОплатыКомиссий.ЗадолженностьНачисленаВТекущемДне
		|					ТОГДА НАЧАЛОПЕРИОДА(_ЗадолженностьСИтогами.ДатаДок, ДЕНЬ) = &НачалоПериода
		|				ИНАЧЕ _ОплатыКомиссий.Сумма > ЕСТЬNULL(_ЗадолженностьСИтогами.СуммаИтого, 0) - ЕСТЬNULL(_ЗадолженностьСИтогами.СуммаОстаток, 0)
		|			КОНЕЦ)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(_ОплатыКомиссий.Основание) = ТИП(Документ.СделкаСПФИ)
		|				ТОГДА ВЫБОР
		|						КОГДА НЕ ВЫРАЗИТЬ(_ОплатыКомиссий.Основание КАК Документ.СделкаСПФИ).ОтложеннаяОплатаКлиринговогоСбора
		|								И _ОплатыКомиссий.Origin_Operation_Type В (""Operations.Group.Charges.Clearing"")
		|							ТОГДА ЛОЖЬ
		|						ИНАЧЕ ИСТИНА
		|					КОНЕЦ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Deal_Record_UID,
		|	Record_UID
		|ИТОГИ ПО
		|	СчетДоверительногоУправления,
		|	МестоХраненияДенежныхСредств,
		|	ВидЗадолженности,
		|	ВалютаОплаты,
		|	ОснованиеСделкаСВалютой
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _НачисленнаяЗадолженность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЗадолженностьСИтогами
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОплатыКомиссий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОплатыКомиссийБезОснований";
#КонецОбласти
	
	СтрокаТиповБрокерскойКомиссии = "Operations.Group.Charges.Broker, Operations.Group.Charges.Broker.Equities, Operations.Group.Charges.Broker.FX, Operations.Group.Charges.Broker.REPO,
									|Operations.Group.Charges.Recovery, Operations.Group.Charges.Agent, Operations.Group.Charges.Broker.FX.REPO,
									|Operations.Group.Charges.Clearing, Operations.Group.Charges.Broker.Derivatives, Operations.Group.Charges.Broker.Bills";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ЭтотОбъект.ДатаИмпорта));
	Запрос.УстановитьПараметр("ГраницаОплат", Новый Граница(ЭтотОбъект.ДатаИмпорта + (20 * 60 + 30) * 60, ВидГраницы.Исключая)); // время оплат 20:30:00
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", Брокер);
	Запрос.УстановитьПараметр("Контрагент", Брокер.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ТипыБрокерскойКомиссии", РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаТиповБрокерскойКомиссии, ",", Истина, Истина));
	
	ГруппировкаПоСчету = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МаксимальныйНомерСтроки = 1000;
	Пока ГруппировкаПоСчету.Следующий() Цикл
		
		ГруппировкаПоМестуХранения = ГруппировкаПоСчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ГруппировкаПоМестуХранения.Следующий() Цикл
	
			ГруппировкаПоВидуЗадолженности = ГруппировкаПоМестуХранения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ГруппировкаПоВидуЗадолженности.Следующий() Цикл
				
				ГруппировкаПоВалютеОплаты = ГруппировкаПоВидуЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ГруппировкаПоВалютеОплаты.Следующий() Цикл
					//оплаты комиссий по сделкам с валютой нужно выделить в отдельный документ.
					ГруппировкаПоДокументуОснования = ГруппировкаПоВалютеОплаты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ГруппировкаПоДокументуОснования.Следующий() Цикл
						
						ВыборкаЗаписей = ГруппировкаПоДокументуОснования.Выбрать();
						НомерСтроки = 0;
						МассивСуммТекстом = Новый Массив; // Массив(Строка)
						НоваяСтрокаОперации = Неопределено;
						
						Пока ВыборкаЗаписей.Следующий() Цикл
							
							НомерСтроки = НомерСтроки + 1;
							
							Если НомерСтроки = 1 Тогда
								ОшибкиЧтения = Новый Массив;
								НоваяСтрокаОперации = Операции.Добавить();
								
								НоваяСтрокаОперации.Ключ = СокрЛП(ВыборкаЗаписей.КодДляСверкиОпераций)
									+ ?(ВыборкаЗаписей.ОснованиеСделкаСВалютой, "/FX", "")
									+ "/" + ВыборкаЗаписей.ВидЗадолженности.ИмяПредопределенныхДанных
									+ "/" + ВыборкаЗаписей.ВалютаОплаты.Наименование
									+ "/" + ВыборкаЗаписей.МестоХраненияДенежныхСредств.Наименование + "/"; // Сумму добавим потом
								
								НоваяСтрокаОперации.Описание     = "Оплата комиссии / "
									+ ?(ВыборкаЗаписей.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария,
										ВыборкаЗаписей.КодУБрокера, ВыборкаЗаписей.Record_UID);
								НоваяСтрокаОперации.Статус       = "Новый";
								НоваяСтрокаОперации.ОшибкиЧтения = ОшибкиЧтения;
								НоваяСтрокаОперации.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
								
								РеквизитыШапки = Новый Структура(ПоляДокумента.Шапка);
								РеквизитыШапки.Проведен                     = Истина;
								РеквизитыШапки.ПометкаУдаления              = Ложь;
								РеквизитыШапки.Дата                         = ЭтотОбъект.ДатаИмпорта + (20 * 60 + 30) * 60; //"20:30:00"
								РеквизитыШапки.Организация                  = ЭтотОбъект.Организация;
								РеквизитыШапки.ВидДвижения                  = ВыборкаЗаписей.ВидДвижения;
								
								Если ЗначениеЗаполнено(ВыборкаЗаписей.ВидЗадолженности) Тогда
									РеквизитыШапки.ВидЗадолженности         = ВыборкаЗаписей.ВидЗадолженности;
								Иначе
									ОшибкиЧтения.Добавить("Не удалось определить вид задолженности по Origin_Operation_Type = [" + ВыборкаЗаписей.Origin_Operation_Type + "]");	
								КонецЕсли;
								
								РеквизитыШапки.Аванс                        = Ложь;
								РеквизитыШапки.СчетДоверительногоУправления = ВыборкаЗаписей.СчетДоверительногоУправления;
								РеквизитыШапки.МестоХранения                = ВыборкаЗаписей.МестоХраненияДенежныхСредств;
								РеквизитыШапки.РасчетныйСчет                = Справочники.БанковскиеСчета.ПустаяСсылка();
								РеквизитыШапки.ВалютаОплаты                 = ВыборкаЗаписей.ВалютаОплаты;
								РеквизитыШапки.Брокер                       = Брокер;
								РеквизитыШапки.СтрокаБанковскойВыписки      = Документы.СтрокаБанковскойВыписки.ПустаяСсылка();
								РеквизитыШапки.Контрагент                   = РеквизитыШапки.Брокер.ЮрФизЛицо;
								РеквизитыШапки.РасчетныйСчетКонтрагента     = Справочники.БанковскиеСчета.ПустаяСсылка();
								РеквизитыШапки.Договор                      = ВыборкаЗаписей.Договор;
								
								Основания = Новый Массив;
								НоваяСтрокаОперации.НовыеРеквизиты = Новый Структура("Шапка, Основания", РеквизитыШапки, Основания);
							КонецЕсли;
							
							РеквизитыОснования = Новый Структура(ПоляДокумента.Основания);
							РеквизитыОснования.НомерСтроки           = НомерСтроки;
							РеквизитыОснования.Валюта                = ВыборкаЗаписей.ВалютаОплаты;
							РеквизитыОснования.Сумма                 = ВыборкаЗаписей.Сумма;
							РеквизитыОснования.СуммаКупона           = 0;
							РеквизитыОснования.СобственныйКурсОплаты = Ложь;
							РеквизитыОснования.КурсОплаты            = Неопределено;
							РеквизитыОснования.СуммаОплаты           = ВыборкаЗаписей.Сумма;
							РеквизитыОснования.СуммаОплатыКупона     = 0;
							
							Если ЗначениеЗаполнено(ВыборкаЗаписей.Основание) Тогда
								РеквизитыОснования.Основание = ВыборкаЗаписей.Основание;
							Иначе
								Если ВыборкаЗаписей.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария Тогда
									ОшибкиЧтения.Добавить("Не удалось определить начисление задолженности для оплаты расходов депозитария по клиенту [" + ВыборкаЗаписей.СчетДоверительногоУправления + "] на сумму " + ВыборкаЗаписей.Сумма + " " + ВыборкаЗаписей.ВалютаОплаты + " !");
								Иначе
									ОшибкиЧтения.Добавить("Не удалось определить документ основание по " + ?(ЗначениеЗаполнено(ВыборкаЗаписей.Market_Number), "номеру сделки [" + ВыборкаЗаписей.Market_Number + "]", "ID операции [" + ?(ЗначениеЗаполнено(ВыборкаЗаписей.Deal_Record_UID), ВыборкаЗаписей.Deal_Record_UID, ВыборкаЗаписей.Charge_Record_UID) + "]"));
								КонецЕсли;
							КонецЕсли;
							
							Основания.Добавить(РеквизитыОснования);
							
							Если ОшибкиЧтения.Количество() > 0 Тогда
								НоваяСтрокаОперации.Статус = "Ошибка чтения";
							КонецЕсли;
							
							МассивСуммТекстом.Добавить(Формат(ВыборкаЗаписей.Сумма, "ЧРД=.; ЧГ="));
							
							// Как только проходит 1000 строк, создаётся новая операция
							Если НомерСтроки = МаксимальныйНомерСтроки Тогда
								НоваяСтрокаОперации.Ключ = НоваяСтрокаОперации.Ключ + ПолучитьХешСуммуМассива(МассивСуммТекстом);
								НомерСтроки = 0;
								МассивСуммТекстом = Новый Массив;
							КонецЕсли;
						КонецЦикла;
						
						// Хеширование сумм для ключа
						Если НоваяСтрокаОперации <> Неопределено Тогда
							НоваяСтрокаОперации.Ключ = НоваяСтрокаОперации.Ключ + ПолучитьХешСуммуМассива(МассивСуммТекстом);
						КонецЕсли;
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
				
		КонецЦикла;
		
	КонецЦикла;
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Оплата.Ссылка КАК Ссылка,
		|	Оплата.ВидЗадолженности КАК ВидЗадолженности,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ОплатаОснования.Основание ССЫЛКА Документ.СделкаСВалютой
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ФлагСделкаСВалютой
		|ПОМЕСТИТЬ _Основания
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО Оплата.Ссылка = ОплатаОснования.Ссылка
		|ГДЕ
		|	Оплата.Организация = &Организация
		|	И НЕ Оплата.ПометкаУдаления
		|	И Оплата.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И (Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			ИЛИ Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария))
		|	И Оплата.Брокер = &Брокер
		|	И НЕ Оплата.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|
		|СГРУППИРОВАТЬ ПО
		|	Оплата.Ссылка,
		|	Оплата.ВидЗадолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основания.Ссылка КАК Ссылка,
		|	ОплатаОснования.Сумма КАК Сумма
		|ИЗ
		|	_Основания КАК Основания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО Основания.Ссылка = ОплатаОснования.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Основания.Ссылка,
		|	ОплатаОснования.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ВЫБОР
		|		КОГДА _Основания.ФлагСделкаСВалютой
		|				И Оплата.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ТОГДА _КодыСчетовУБрокера.КодДляСверкиОпераций + ""/FX""
		|		ИНАЧЕ _КодыСчетовУБрокера.КодДляСверкиОпераций
		|	КОНЕЦ КАК СТРОКА(256)) КАК Ключ,
		|	Оплата.ВидЗадолженности.ИмяПредопределенныхДанных КАК ВидЗадолженностиИмяПредопределенныхДанных,
		|	Оплата.ВалютаОплаты.Наименование КАК ВалютаОплатыНаименование,
		|	Оплата.МестоХранения.Наименование КАК МестоХраненияНаименование,
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовУБрокера КАК _КодыСчетовУБрокера
		|		ПО Оплата.СчетДоверительногоУправления = _КодыСчетовУБрокера.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Основания КАК _Основания
		|		ПО Оплата.Ссылка = _Основания.Ссылка
		|ГДЕ
		|	Оплата.Ссылка В
		|			(ВЫБРАТЬ
		|				_Основания.Ссылка
		|			ИЗ
		|				_Основания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Основания";
	#КонецОбласти
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	СуммыОснований = РезультатыЗапроса[1].Выбрать();
	ТекущиеОперации = РезультатыЗапроса[2].Выгрузить();
	
	// Распределение сумм оснований по каждому документу для подсчёта хеш-сумм
	МассивыСуммТекстомПоОплатам = Новый Соответствие; // Соответствие(ДокументСсылка.Оплата, Массив(Строка))
	ПоследняяСсылка = Неопределено;
	МассивСуммТекстом = Неопределено;
	Пока СуммыОснований.Следующий() Цикл
		Если СуммыОснований.Ссылка <> ПоследняяСсылка Тогда
			МассивСуммТекстом = МассивыСуммТекстомПоОплатам.Получить(СуммыОснований.Ссылка);
		КонецЕсли;
		Если МассивСуммТекстом = Неопределено Тогда
			МассивСуммТекстом = Новый Массив;
			МассивыСуммТекстомПоОплатам.Вставить(СуммыОснований.Ссылка, МассивСуммТекстом);
		КонецЕсли;
		МассивСуммТекстом.Добавить(Формат(СуммыОснований.Сумма, "ЧРД=.; ЧГ="));
		ПоследняяСсылка = СуммыОснований.Ссылка;
	КонецЦикла;
	
	// Подсчёт хеш-сумм по суммам оснований документов оплат комиссий
	ХешСуммыПоОплатам = Новый Соответствие; // Соответствие(ДокументСсылка.Оплата, Строка)
	Для Каждого КлючЗначение Из МассивыСуммТекстомПоОплатам Цикл
		ХешСуммыПоОплатам.Вставить(КлючЗначение.Ключ, ПолучитьХешСуммуМассива(КлючЗначение.Значение));
	КонецЦикла;
	
	Для Каждого СтрокаТекущиеОперации Из ТекущиеОперации Цикл
		ХешСумма = ХешСуммыПоОплатам.Получить(СтрокаТекущиеОперации.Ссылка);
		Если ХешСумма = Неопределено Тогда
			ХешСумма = "";
		КонецЕсли;
		СтрокаТекущиеОперации.Ключ = "" + СокрЛП(СтрокаТекущиеОперации.Ключ)
			+ "/" + СтрокаТекущиеОперации.ВидЗадолженностиИмяПредопределенныхДанных
			+ "/" + СтрокаТекущиеОперации.ВалютаОплатыНаименование
			+ "/" + СтрокаТекущиеОперации.МестоХраненияНаименование
			+ "/" + ХешСумма;
	КонецЦикла;
	
	УстановитьСоответствияСТекущимиОперациями_OTBR(Операции, ТекущиеОперации, ПоляДокумента);
	
	Возврат Операции;
	
КонецФункции

Функция ОбработатьОплатыВнебиржевыхСделок_OTBR(МВТ)
	Перем Операции, ПоляДокумента;
	
	Группа_Payment = Справочники.ГруппыИмпортируемыхОбъектов.ПолучитьГруппуПоНаименованию("Payment");
	
	ПодготовитьОбработкуОпераций_OTBR(Метаданные.Документы.Оплата, Операции, ПоляДокумента);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнебиржевыеСделки.Брокер КАК Брокер,
		|	_ВнебиржевыеСделки.Организация КАК Организация,
		|	_ВнебиржевыеСделки.ГруппаОбъектов КАК ГруппаОбъектов,
		|	_ВнебиржевыеСделки.НомерОперации КАК НомерОперации,
		|	УсловияСделокСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияСделокСрезПоследних.Сделка КАК Сделка,
		|	СУММА(УсловияСделокСрезПоследних.Сумма) КАК Сумма,
		|	СУММА(УсловияСделокСрезПоследних.СуммаКупона) КАК СуммаКупона,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке) КАК ВидЗадолженности,
		|	УсловияСделокСрезПоследних.ВалютаОплаты КАК Валюта,
		|	УсловияСделокСрезПоследних.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	УсловияСделокСрезПоследних.КурсОплаты КАК КурсОплаты
		|ПОМЕСТИТЬ _УсловияСделок
		|ИЗ
		|	_ВнебиржевыеОперации КАК _ВнебиржевыеСделки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокСрезПоследних
		|		ПО _ВнебиржевыеСделки.Объект = УсловияСделокСрезПоследних.Сделка
		|			И _ВнебиржевыеСделки.Организация = УсловияСделокСрезПоследних.Организация
		|ГДЕ
		|	НЕ _ВнебиржевыеСделки.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВнебиржевыеСделки.Брокер,
		|	_ВнебиржевыеСделки.Организация,
		|	_ВнебиржевыеСделки.ГруппаОбъектов,
		|	_ВнебиржевыеСделки.НомерОперации,
		|	УсловияСделокСрезПоследних.СчетДоверительногоУправления,
		|	УсловияСделокСрезПоследних.Сделка,
		|	УсловияСделокСрезПоследних.ВалютаОплаты,
		|	УсловияСделокСрезПоследних.СобственныйКурсОплаты,
		|	УсловияСделокСрезПоследних.КурсОплаты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ВнебиржевыеСделкиРепо.Брокер,
		|	_ВнебиржевыеСделкиРепо.Организация,
		|	_ВнебиржевыеСделкиРепо.ГруппаОбъектов,
		|	_ВнебиржевыеСделкиРепо.НомерОперации,
		|	УсловияСделокРЕПОСрезПоследних.СчетДоверительногоУправления,
		|	УсловияСделокРЕПОСрезПоследних.СделкаРЕПО,
		|	УсловияСделокРЕПОСрезПоследних.Сумма,
		|	УсловияСделокРЕПОСрезПоследних.СуммаКупона,
		|	УсловияСделокРЕПОСрезПоследних.ВидЗадолженности,
		|	УсловияСделокРЕПОСрезПоследних.ВалютаОплаты,
		|	УсловияСделокРЕПОСрезПоследних.СобственныйКурсОплаты,
		|	УсловияСделокРЕПОСрезПоследних.КурсОплаты
		|ИЗ
		|	_ВнебиржевыеОперации КАК _ВнебиржевыеСделкиРепо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО _ВнебиржевыеСделкиРепо.Организация = УсловияСделокРЕПОСрезПоследних.Организация
		|			И _ВнебиржевыеСделкиРепо.Объект = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|ГДЕ
		|	НЕ _ВнебиржевыеСделкиРепо.СчетДоверительногоУправления В
		|				(ВЫБРАТЬ
		|					_СчетаИсключеныИзЗагрузки.Счет
		|				ИЗ
		|					_СчетаИсключеныИзЗагрузки КАК _СчетаИсключеныИзЗагрузки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Money_Operations.Ключ КАК Ключ,
		|	_Money_Operations.Record_UID КАК Record_UID,
		|	_Money_Operations.Date КАК Date,
		|	_Money_Operations.Origin_Operation_Type КАК Origin_Operation_Type,
		|	_Money_Operations.Payment_Amount КАК Payment_Amount,
		|	_Money_Operations.Coupon_Amount КАК Coupon_Amount,
		|	_Money_Operations.Direction КАК Direction,
		|	_Money_Operations.Inner_Account_Division_ID КАК Inner_Account_Division_ID,
		|	_Money_Operations.Money_Storage_Place КАК Money_Storage_Place,
		|	_Money_Operations.Payment_Currency_Code КАК Payment_Currency_Code,
		|	_Money_Operations.Deal_Record_UID КАК Deal_Record_UID
		|ПОМЕСТИТЬ _Money_Operations_OTC
		|ИЗ
		|	_Money_Operations КАК _Money_Operations
		|ГДЕ
		|	_Money_Operations.Date = &НачалоПериода
		|	И _Money_Operations.Origin_Operation_Type В (""Operations.Group.Settlements.Delivery"", ""Operations.Group.Settlements.Payment"", ""Operations.Group.Settlements.REPO.Payment.Near"", ""Operations.Group.Settlements.REPO.Payment.Far"")
		|	И _Money_Operations.Money_Storage_Place = ""OTC""
		|	И _Money_Operations.Market_Number = """"
		|;
		|
