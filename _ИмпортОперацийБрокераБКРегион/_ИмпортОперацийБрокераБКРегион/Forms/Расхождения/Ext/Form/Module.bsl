
&НаСервере
Процедура ОтобразитьНаборРеквизитов(НаборРеквизитов, ТипЗначения)
	
	НомерТабЧасти = 0;
	
	Для каждого ГруппаРеквизитов Из НаборРеквизитов Цикл
		
		Если ГруппаРеквизитов.Ключ = "Шапка" Тогда
			
			Для Каждого Реквизит Из ГруппаРеквизитов.Значение Цикл
				
				НоваяСтрокаШапка = ЭтаФорма.Шапка.Добавить();
				НоваяСтрокаШапка.ИмяПоля                   = Реквизит.Ключ;
				НоваяСтрокаШапка[ТипЗначения + "Значение"] = Реквизит.Значение;
				
			КонецЦикла;
			
		ИначеЕсли ГруппаРеквизитов.Ключ = "ДопСведения" Тогда
			
			Для Каждого Реквизит Из ГруппаРеквизитов.Значение Цикл
				
				НоваяСтрокаШапка = ЭтаФорма.ДопСведения.Добавить();
				НоваяСтрокаШапка.ИмяПоля                   = Реквизит.Ключ;
				НоваяСтрокаШапка[ТипЗначения + "Значение"] = Реквизит.Значение;
				
			КонецЦикла;
			
		Иначе // это табличные части 
			НомерТабЧасти = НомерТабЧасти + 1;
			
			Элементы["СтраницаТабЧасть" + НомерТабЧасти].Заголовок = ГруппаРеквизитов.Ключ;
			
			Для Каждого Реквизиты Из ГруппаРеквизитов.Значение Цикл
				
				НоваяСтрокаДереваУровень1 = Неопределено;
				
				Для Каждого Реквизит Из Реквизиты Цикл
					
					Если Реквизит.Ключ = "НомерСтроки" Тогда
						Продолжить;
					КонецЕсли;
					
					Если НоваяСтрокаДереваУровень1 = Неопределено Тогда
						НоваяСтрокаДереваУровень1 = ЭтаФорма["ТабЧасть" + НомерТабЧасти].ПолучитьЭлементы().Добавить();
						НоваяСтрокаДереваУровень1.ИмяПоля = "[" + Реквизиты.НомерСтроки + "]";
					КонецЕсли;
					
					НоваяСтрокаДереваУровень2 = НоваяСтрокаДереваУровень1.ПолучитьЭлементы().Добавить();
					НоваяСтрокаДереваУровень2.ИмяПоля                   = Реквизит.Ключ;
					НоваяСтрокаДереваУровень2[ТипЗначения + "Значение"] = Реквизит.Значение;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.СтраницаТабЧасть1.Видимость = (НомерТабЧасти > 0);
	Элементы.СтраницаТабЧасть2.Видимость = (НомерТабЧасти > 1);
	Элементы.ДопСведения.Видимость = (ЭтаФорма.ДопСведения.Количество() > 0);
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьСравнениеНаборовРеквизитов(НовыйНабор, ТекущийНабор)
	
	НомерТабЧасти = 0;
		
	Для каждого ГруппаРеквизитов Из НовыйНабор Цикл
		
		Если ГруппаРеквизитов.Ключ = "Шапка" Тогда
			
			Для Каждого Реквизит Из ГруппаРеквизитов.Значение Цикл
				
				Если (Реквизит.Значение <> ТекущийНабор.Шапка[Реквизит.Ключ] Или Не ЭтаФорма.ОтображатьТолькоРасхождения) Тогда
					
					НоваяСтрокаШапка = ЭтаФорма.Шапка.Добавить();
					НоваяСтрокаШапка.ИмяПоля         = Реквизит.Ключ;
					НоваяСтрокаШапка.НовоеЗначение   = Реквизит.Значение;
					НоваяСтрокаШапка.ТекущееЗначение = ТекущийНабор.Шапка[Реквизит.Ключ];
					
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ГруппаРеквизитов.Ключ = "ДопСведения" Тогда
			
			Для Каждого Реквизит Из ГруппаРеквизитов.Значение Цикл
				
				Если (Реквизит.Значение <> ТекущийНабор.ДопСведения[Реквизит.Ключ] Или Не ЭтаФорма.ОтображатьТолькоРасхождения) Тогда
					
					НоваяСтрокаШапка = ЭтаФорма.ДопСведения.Добавить();
					НоваяСтрокаШапка.ИмяПоля         = Реквизит.Ключ;
					НоваяСтрокаШапка.НовоеЗначение   = Реквизит.Значение;
					НоваяСтрокаШапка.ТекущееЗначение = ТекущийНабор.ДопСведения[Реквизит.Ключ];
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе // это табличные части (считаем, что структура наборов одинаковая)
			
			НомерТабЧасти = НомерТабЧасти + 1;
			
			Элементы["СтраницаТабЧасть" + НомерТабЧасти].Заголовок = ГруппаРеквизитов.Ключ;
			
			СтрокиНовТабЧасти = ГруппаРеквизитов.Значение; // массив
			СтрокиТекТабЧасти = ТекущийНабор[ГруппаРеквизитов.Ключ];
			
			КолСтрокНовТабЧасти = СтрокиНовТабЧасти.Количество();
			КолСтрокТекТабЧасти = СтрокиТекТабЧасти.Количество();
			
			Для НомТекСтроки = 1 По Макс(КолСтрокНовТабЧасти, КолСтрокТекТабЧасти) Цикл
				
				НовРеквизиты = ?(НомТекСтроки <= КолСтрокНовТабЧасти, СтрокиНовТабЧасти[НомТекСтроки - 1], Неопределено);
				ТекРеквизиты = ?(НомТекСтроки <= КолСтрокТекТабЧасти, СтрокиТекТабЧасти[НомТекСтроки - 1], Неопределено);
				
				НоваяСтрокаДереваУровень1 = Неопределено;
				
				Для Каждого Реквизит Из ?(КолСтрокНовТабЧасти > КолСтрокТекТабЧасти, НовРеквизиты, ТекРеквизиты) Цикл
					
					Если Реквизит.Ключ = "НомерСтроки" Тогда
						Продолжить;
					КонецЕсли;
					
					НовЗначение = ?(НомТекСтроки <= КолСтрокНовТабЧасти, НовРеквизиты[Реквизит.Ключ], Неопределено);
					ТекЗначение = ?(НомТекСтроки <= КолСтрокТекТабЧасти, ТекРеквизиты[Реквизит.Ключ], Неопределено);
					
					Если НовЗначение <> ТекЗначение Или (Реквизит.Ключ = "ДепозитарныйСчет" И ПустаяСтрока(НовЗначение)) Или Не ЭтаФорма.ОтображатьТолькоРасхождения Тогда
						
						Если НоваяСтрокаДереваУровень1 = Неопределено Тогда
							НоваяСтрокаДереваУровень1 = ЭтаФорма["ТабЧасть" + НомерТабЧасти].ПолучитьЭлементы().Добавить();
							НоваяСтрокаДереваУровень1.ИмяПоля = "[" + ?(КолСтрокНовТабЧасти > КолСтрокТекТабЧасти, НовРеквизиты.НомерСтроки, ТекРеквизиты.НомерСтроки) + "]";
						КонецЕсли;
						
						НоваяСтрокаДереваУровень2 = НоваяСтрокаДереваУровень1.ПолучитьЭлементы().Добавить();
						НоваяСтрокаДереваУровень2.ИмяПоля         = Реквизит.Ключ;
						НоваяСтрокаДереваУровень2.НовоеЗначение   = НовЗначение;
						НоваяСтрокаДереваУровень2.ТекущееЗначение = ТекЗначение;
		
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.СтраницаТабЧасть1.Видимость = (НомерТабЧасти > 0);
	Элементы.СтраницаТабЧасть2.Видимость = (НомерТабЧасти > 1);
	Элементы.ДопСведения.Видимость = (ЭтаФорма.ДопСведения.Количество() > 0);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтотОбъект.НовыеРеквизиты   = ЭтаФорма.Параметры.НовыеРеквизиты.Получить();
	ЭтотОбъект.ТекущиеРеквизиты = ЭтаФорма.Параметры.ТекущиеРеквизиты.Получить();
	ЭтотОбъект.ДатаИмпорта      = ЭтаФорма.Параметры.ДатаИмпорта;
	ЭтотОбъект.Организация      = ЭтаФорма.Параметры.Организация;
	
	Если ЭтаФорма.Параметры.Свойство("ОтображатьТолькоРасхождения") Тогда
		ЭтаФорма.ОтображатьТолькоРасхождения = ЭтаФорма.Параметры.ОтображатьТолькоРасхождения;
	Иначе
		ЭтаФорма.ОтображатьТолькоРасхождения = Истина;
	КонецЕсли;	
	
	Если ЭтотОбъект.НовыеРеквизиты = Неопределено И ЭтотОбъект.ТекущиеРеквизиты <> Неопределено Тогда // отобразим только текущие реквизиты
		ОтобразитьНаборРеквизитов(ТекущиеРеквизиты, "Текущее");
	ИначеЕсли ЭтотОбъект.ТекущиеРеквизиты = Неопределено И ЭтотОбъект.НовыеРеквизиты <> Неопределено Тогда // отобразим только новые реквизиты
		ОтобразитьНаборРеквизитов(ЭтотОбъект.НовыеРеквизиты, "Новое");
	Иначе // найдем и отобразим расхождения (считаем, что структуры хранения реквизитов совпадают)
		ОтобразитьСравнениеНаборовРеквизитов(ЭтотОбъект.НовыеРеквизиты, ЭтотОбъект.ТекущиеРеквизиты);		
	КонецЕсли;
	
	Если Элементы.СтраницаТабЧасть1.Видимость Тогда
		Элементы.СтраницаТабЧасть1.Заголовок = Элементы.СтраницаТабЧасть1.Заголовок + " (" + ЭтаФорма.ТабЧасть1.ПолучитьЭлементы().Количество() + ")";
	КонецЕсли;
	
	Если Элементы.СтраницаТабЧасть2.Видимость Тогда
		Элементы.СтраницаТабЧасть2.Заголовок = Элементы.СтраницаТабЧасть2.Заголовок + " (" + ЭтаФорма.ТабЧасть2.ПолучитьЭлементы().Количество() + ")";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРедактированияЗначенийНаФорме(Элемент, Отказ = Неопределено)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ИмяТаблицы    = Элемент.Имя;
	
	Если ТекущиеДанные <> Неопределено И Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "НовоеЗначение" И ТекущиеДанные.ИмяПоля = "ДепозитарныйСчет" Тогда
				
		ПараметрыОтбора = Новый Структура("Период, ИсполнителиБрокерские, Организация, СчетДоверительногоУправления",
											ЭтотОбъект.ДатаИмпорта,
											Истина,
											ЭтотОбъект.Организация,
											ЭтотОбъект.НовыеРеквизиты.Шапка.СчетДоверительногоУправления);
		НовЗначение = ОткрытьФормуМодально("Справочник.ДепозитарныеСчета.Форма.ФормаВыбораИзИсполнителей", ПараметрыОтбора);
		
		Если ЗначениеЗаполнено(НовЗначение) Тогда
			
		    ТекущиеДанные.НовоеЗначение = НовЗначение;			
			Инд = Число(СтрЗаменить(ИмяТаблицы,"ТабЧасть",""))- 1;
			ЭтотОбъект.НовыеРеквизиты.ЦенныеБумаги[Инд][ТекущиеДанные.ИмяПоля] = НовЗначение;
			
		КонецЕсли;
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Редактировать можно только значение реквизита [Депозитарный счет]!");
	КонецЕсли;
						
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаИзмененияЗначенийНаФорме(Элемент)
	
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ИмяТаблицы    = Элемент.Имя;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.НовоеЗначение) Тогда
				
		Если ИмяТаблицы = "Шапка" Тогда
			ЭтотОбъект.НовыеРеквизиты.Шапка[ТекущиеДанные.ИмяПоля] = ТекущиеДанные.НовоеЗначение;
		Иначе
			Инд = Число(СтрЗаменить(ИмяТаблицы,"ТабЧасть",""))- 1;
			ЭтотОбъект.НовыеРеквизиты.ЦенныеБумаги[Инд][ТекущиеДанные.ИмяПоля] = ТекущиеДанные.НовоеЗначение;
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьНовыеЗначенияНаСервере()
		
	Возврат(Новый Структура("НовыеРеквизиты", Новый ХранилищеЗначения(ЭтотОбъект.НовыеРеквизиты)));
		
КонецФункции

&НаКлиенте
Процедура ТабЧасть2ПередНачаломИзменения(Элемент, Отказ)
	
	ОбработкаРедактированияЗначенийНаФорме(Элемент, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНовыеЗначения(Команда)
	
	Закрыть(ЗаписатьНовыеЗначенияНаСервере());
	
КонецПроцедуры

&НаКлиенте
Процедура ТабЧасть1ПередНачаломИзменения(Элемент, Отказ)
	
	ОбработкаРедактированияЗначенийНаФорме(Элемент, Отказ);

КонецПроцедуры