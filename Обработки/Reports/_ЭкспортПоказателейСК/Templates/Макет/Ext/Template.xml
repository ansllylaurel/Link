			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВидыПоказателейСтраховыхКомпаний.Ссылка КАК Ссылка,
	ВЫБОР
		КОГДА ВидыПоказателейСтраховыхКомпаний.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюИномуЧемСтрахованиеЖизни)
			ТОГДА "иному чем жизни"
		КОГДА ВидыПоказателейСтраховыхКомпаний.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.МинимальныйРазмерУставногоКапитала)
			ТОГДА "норм"
		КОГДА ВидыПоказателейСтраховыхКомпаний.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.НормативныйРазмерМаржиПлатежеспособности)
			ТОГДА "норм"
		КОГДА ВидыПоказателейСтраховыхКомпаний.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.ПревышенияРазмераСобственныхСредствНадНаибольшимПоказателем)
			ТОГДА "сверх"
		КОГДА ВидыПоказателейСтраховыхКомпаний.Ссылка = ЗНАЧЕНИЕ(Перечисление.ВидыПоказателейСтраховыхКомпаний.СтраховыеРезервыПоСтрахованиюЖизни)
			ТОГДА "жизни"
		ИНАЧЕ NULL
	КОНЕЦ КАК Ярлык
ПОМЕСТИТЬ _ПоказателиСК
ИЗ
	Перечисление.ВидыПоказателейСтраховыхКомпаний КАК ВидыПоказателейСтраховыхКомпаний
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления.Родитель КАК СчетДоверительногоУправления,
	_ПоказателиСК.Ярлык КАК ВидПоказателя,
	МАКСИМУМ(ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ЗначениеПоказателя) КАК ЗначениеПоказателя,
	ВЫБОР
		КОГДА _ПоказателиСК.Ярлык = "иному чем жизни"
			ТОГДА 1
		КОГДА _ПоказателиСК.Ярлык = "норм"
			ТОГДА 2
		КОГДА _ПоказателиСК.Ярлык = "сверх"
			ТОГДА 3
		КОГДА _ПоказателиСК.Ярлык = "жизни"
			ТОГДА 4
		ИНАЧЕ 5
	КОНЕЦ КАК ПорядокПоказателей,
	ВЫБОР СчетаДоверительногоУправления.КодСчета
		КОГДА "8/DSK"
			ТОГДА 1
		КОГДА "6/DSK"
			ТОГДА 2
		КОГДА "15/DSK"
			ТОГДА 3
		КОГДА "1/DSK"
			ТОГДА 4
		КОГДА "13/DSK"
			ТОГДА 5
		ИНАЧЕ 7
	КОНЕЦ КАК ПорядокСчетов,
	ВЫБОР СчетаДоверительногоУправления.КодСчета
		КОГДА "8/DSK"
			ТОГДА "ск согласие"
		КОГДА "6/DSK"
			ТОГДА "мегарус"
		КОГДА "15/DSK"
			ТОГДА "СК Югория-Жизнь АО"
		КОГДА "1/DSK"
			ТОГДА "сао геополис"
		КОГДА "13/DSK"
			ТОГДА "ГСК Югория АО"
		ИНАЧЕ 7
	КОНЕЦ КАК ПсевдонимСчета
ИЗ
	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПредоставляемыеПоказателиСтраховыхКомпаний.СрезПоследних(&amp;Период, Организация = &amp;Организация) КАК ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних
			ЛЕВОЕ СОЕДИНЕНИЕ _ПоказателиСК КАК _ПоказателиСК
			ПО (_ПоказателиСК.Ссылка = ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.ВидПоказателя)
		ПО СчетаДоверительногоУправления.Ссылка = ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления
ГДЕ
	СчетаДоверительногоУправления.КодСчета В(&amp;КодыСчетовДоверительногоУправления)
	И НЕ _ПоказателиСК.Ярлык ЕСТЬ NULL

СГРУППИРОВАТЬ ПО
	_ПоказателиСК.Ярлык,
	ПредоставляемыеПоказателиСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления.Родитель,
	ВЫБОР СчетаДоверительногоУправления.КодСчета
		КОГДА "8/DSK"
			ТОГДА 1
		КОГДА "6/DSK"
			ТОГДА 2
		КОГДА "15/DSK"
			ТОГДА 3
		КОГДА "1/DSK"
			ТОГДА 4
		КОГДА "13/DSK"
			ТОГДА 5
		ИНАЧЕ 7
	КОНЕЦ,
	ВЫБОР СчетаДоверительногоУправления.КодСчета
		КОГДА "8/DSK"
			ТОГДА "ск согласие"
		КОГДА "6/DSK"
			ТОГДА "мегарус"
		КОГДА "15/DSK"
			ТОГДА "СК Югория-Жизнь АО"
		КОГДА "1/DSK"
			ТОГДА "сао геополис"
		КОГДА "13/DSK"
			ТОГДА "ГСК Югория АО"
		ИНАЧЕ 7
	КОНЕЦ</query>
