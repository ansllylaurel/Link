// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Показатели страховщиков (экспорт)",
		"0.33",
		"",
		Истина);
		
	// команды
	           
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();

	// Объявить команду для регламентного исполнения.
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортироватьПоказателиСК", "Экспорт показателей СК",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт

	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	// Отчет на предыдущий рабочий день
	// ЭтотОбъект.Период		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ТекущаяДата() - 60 * 60 * 24); 
	// Нужен отчет на любой ПРЕДЫДУЩИЙ день ( неважно, рабочий/нерабочий )
	
	//ЭтотОбъект.Период = ТекущаяДата() - 60 * 60 * 24;
	// -3 дня назад теперь требуется
	ЭтотОбъект.Период = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -3);

	ЭтотОбъект.Организация	= ПараметрыКоманды.Организация; 
	КаталогСохранения		= ПараметрыКоманды.КаталогСохранения; 
	
	Результат = Новый ТабличныйДокумент;
	ПриКомпоновкеРезультата(Результат, NULL, Ложь);
	ИмяФайла = КаталогСохранения + "/Показатели СК " + Формат(ЭтотОбъект.Период,"ДФ=""дд.ММ.гггг""") + ".xls";
	Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLS); 
	 	
КонецПроцедуры // ВыполнитьКоманду

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Настройки 	= КомпоновщикНастроек.Настройки;	
	ДатаОтчета 		= ЭтотОбъект.Период;
	Организация = ЭтотОбъект.Организация; 	
	СтандартнаяОбработка = Ложь;

	
	Если НЕ ЗначениеЗаполнено(ДатаОтчета) Тогда   // Вызов не из расписания
		
		Настройки = КомпоновщикНастроек.ПолучитьНастройки();
		
		ДатаОтчета = Настройки.ПараметрыДанных.Элементы.Найти("Период").Значение.Дата;
		Организация = Настройки.ПараметрыДанных.Элементы.Найти("Организация").Значение;

	КонецЕсли;	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", 	Организация);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", 		ДатаОтчета) ;
	
	СтоимостьАктивов = РассчитатьСтоимостьАктивов(ДатаОтчета, Организация);
		
	ВнешниеНаборыДанных = Новый Структура();
	ВнешниеНаборыДанных.Вставить("СтоимостьАктивов", СтоимостьАктивов); 	
	 	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка,,,, ВнешниеНаборыДанных);
	
КонецПроцедуры

Функция РассчитатьСтоимостьАктивов(Период, Организация)
	

	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления.Родитель КАК СчетДоверительногоУправления,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СубъектПрочегоАктива КАК СубъектПрочегоАктива,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив КАК Актив,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Валюта КАК Валюта,
	|	СУММА(СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма) КАК Сумма,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправленияИсходный
	|ИЗ
	|	РегистрСведений.СтоимостьАктивовСтраховыхКомпаний.СрезПоследних(&Период, Организация = &Организация) КАК СтоимостьАктивовСтраховыхКомпанийСрезПоследних
	|ГДЕ
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Сумма <> 0
	|	И СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления.Родитель.КодСчета В (""*1/DSK"", ""*15/DSK"", ""*6/DSK"", ""*8/DSK"", ""*13/DSK"")
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Валюта,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправления.Родитель,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.Актив,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СубъектПрочегоАктива,
	|	СтоимостьАктивовСтраховыхКомпанийСрезПоследних.СчетДоверительногоУправленияИсходный";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ВсеАктивы = Запрос.Выполнить().Выгрузить(); 	
	Для Каждого АктивСтраховойКомпании Из ВсеАктивы Цикл
		
		Если АктивСтраховойКомпании.Валюта <> Организация.ВалютаУчета и АктивСтраховойКомпании.Сумма <> 0 Тогда
			
			АктивСтраховойКомпании.Сумма = Документы.РаспределениеАктивовСтраховыхКомпаний
					.ПолучитьБалансовуюСтоимостьАктиваСтраховойКомпанииВВалютеУчета(
						АктивСтраховойКомпании.СчетДоверительногоУправленияИсходный, 
						Организация, 
						КонецДня(Период), 
						АктивСтраховойКомпании.Актив, 
						АктивСтраховойКомпании.Валюта, 
						АктивСтраховойКомпании.СубъектПрочегоАктива).БалансоваяСтоимость;			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивов.СубъектПрочегоАктива КАК СубъектПрочегоАктива,
		|	СтоимостьАктивов.Актив КАК Актив,
		|	СтоимостьАктивов.Валюта КАК Валюта,
		|	СтоимостьАктивов.Сумма КАК Сумма,
		|	СтоимостьАктивов.СчетДоверительногоУправленияИсходный КАК СчетДоверительногоУправленияИсходный
		|ПОМЕСТИТЬ _СтоимостьАктивов
		|ИЗ
		|	&СтоимостьАктивов КАК СтоимостьАктивов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	""баланс"" КАК ВидПоказателя,
		|	СУММА(_СтоимостьАктивов.Сумма) КАК ЗначениеПоказателя,
		|	7 КАК ПорядокПоказателей,
		|	ВЫБОР ВЫРАЗИТЬ(_СтоимостьАктивов.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).КодСчета
		|		КОГДА ""*8/DSK""
		|			ТОГДА 1
		|		КОГДА ""*6/DSK""
		|			ТОГДА 2
		|		КОГДА ""*15/DSK""
		|			ТОГДА 3
		|		КОГДА ""*1/DSK""
		|			ТОГДА 4
		|		КОГДА ""*13/DSK""
		|			ТОГДА 5
		|		ИНАЧЕ 7
		|	КОНЕЦ КАК ПорядокСчетов,
		|	ВЫБОР ВЫРАЗИТЬ(_СтоимостьАктивов.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).КодСчета
		|		КОГДА ""*8/DSK""
		|			ТОГДА ""ск согласие""
		|		КОГДА ""*6/DSK""
		|			ТОГДА ""мегарус""
		|		КОГДА ""*15/DSK""
		|			ТОГДА ""СК Югория-Жизнь АО""
		|		КОГДА ""*1/DSK""
		|			ТОГДА ""сао геополис""
		|		КОГДА ""*13/DSK""
		|			ТОГДА ""ГСК Югория АО""
		|		ИНАЧЕ 7
		|	КОНЕЦ КАК ПсевдонимСчета
		|ИЗ
		|	_СтоимостьАктивов КАК _СтоимостьАктивов
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьАктивов.СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(_СтоимостьАктивов.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).КодСчета";
	Запрос.УстановитьПараметр( "СтоимостьАктивов",ВсеАктивы);
	
	Возврат Запрос.Выполнить().Выгрузить()

	
КонецФункции


