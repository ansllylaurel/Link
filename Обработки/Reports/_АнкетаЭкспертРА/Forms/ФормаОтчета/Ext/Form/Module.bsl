
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Отчет.Период.Вариант = ВариантСтандартногоПериода.ПрошлыйКвартал;
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьОтчет(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;	
	КонецЕсли;
	
	Механизм = ЭтаФорма.ИмяФормы + ".КомандаВыгрузитьОтчет()";
	Сессия = Неопределено;
	ОткрытьСессиюСбораСтатистикиНаСервере(Механизм, Сессия);
	
	ВерсияОтчета = 0;
	Данные = ПолучитьДанныеНаСервере(ВерсияОтчета);
	
	Шаблон = ПолучитьШаблонИзМакета(ВерсияОтчета);
	ИмяФайла = КаталогВременныхФайлов() + "АнкетаЭкспертРА.xlsx";
	Шаблон.Записать(ИмяФайла);
	
	Excel = Новый COMОбъект("Excel.Application");
	Excel.WorkBooks.Add(ИмяФайла);
	
	УдалитьФайлы(ИмяФайла);
	
	Для каждого Показатель Из Данные Цикл
		Excel.Range(Показатель.Ячейка).Value = Показатель.Значение;
	КонецЦикла; 
	
	Excel.Range("A1:L36").Replace("%Дата%", Формат(Отчет.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	Excel.Range("A1:L36").Replace("%Период%", ПредставлениеПериода(Отчет.Период.ДатаНачала, Отчет.Период.ДатаОкончания));
	
	Excel.Visible = 1;
	
	ЗакрытьСессиюСбораСтатистики(Механизм, Сессия);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьШаблонИзМакета(ВерсияОтчета)

	Возврат РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ШаблонАнкеты_" + ВерсияОтчета);

КонецФункции

&НаСервере
Функция ПолучитьДанныеНаСервере(ВерсияОтчета)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ВерсияОтчета = ОтчетОбъект.ПолучитьВерсиюОтчета(Отчет.Период.ДатаОкончания);
	
	СКД = ОтчетОбъект.СхемаКомпоновкиДанных;
	Настройки = ПолучитьНастройкиКомпоновкиДанныхДляВыгрузки(ВерсияОтчета);
	
	ТаблицаРезультат = ПолучитьРезультатКомпоновки(СКД, Настройки, ОтчетОбъект.ПолучитьДанныеОтчета());
	
	СтруктураОтчета = ПолучитьСтруктуруОтчета(ОтчетОбъект.ПолучитьМакет("ЗаполняемыеПоля"), ВерсияОтчета);
	МассивПолей = Новый Массив;
	
	СредствВУправлении = 0;
	
	Для каждого ЭлементСтруктуры Из СтруктураОтчета Цикл
		СтрокаРезультат = ТаблицаРезультат.Найти(ЭлементСтруктуры.Раздел, "ПорядокРазделов");
		Для каждого Колонка Из ТаблицаРезультат.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Ячейка = ?(ИмяКолонки = "ПорядокРазделов", "", ЭлементСтруктуры[ИмяКолонки]);
			Если ЗначениеЗаполнено(Ячейка) Тогда
				
				Коэффициент = ?(ИмяКолонки = "СЧА", 1000000, 1);
				Значение = ?(СтрокаРезультат = Неопределено, 0, СтрокаРезультат[Колонка.Имя]) / Коэффициент;
				
				Если ИмяКолонки = "СЧА" И ЭлементСтруктуры.Раздел <> Неопределено И ЭлементСтруктуры.Раздел > 0 Тогда
					СредствВУправлении = СредствВУправлении + Значение;
				КонецЕсли; 
				
				МассивПолей.Добавить(Новый Структура("Ячейка, Значение", Ячейка, Значение));
				
			КонецЕсли; 
		КонецЦикла; 
	КонецЦикла; 
	
	Если ВерсияОтчета = 1 Тогда
	
		МассивПолей.Добавить(Новый Структура("Ячейка, Значение", "B7", СредствВУправлении));
		МассивПолей.Добавить(Новый Структура("Ячейка, Значение", "B14", НачалоДня(Отчет.Период.ДатаОкончания)));		
		
		ЯчейкаНаименование = "B3";
		ЯчейкаИНН = "B4";
		ЯчейкаЧисленностьПерсонала = "B28";
		
	ИначеЕсли ВерсияОтчета = 2 Или ВерсияОтчета = 3 Тогда 
		
		ЯчейкаНаименование = "B3";
		ЯчейкаИНН = "B5";
		ЯчейкаЧисленностьПерсонала = "B31";
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	Запрос.УстановитьПараметр("Период", Отчет.Период.ДатаОкончания);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	ЗначенияДополнительныхСведений.Значение КАК Значение
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО Организации.Ссылка = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ВнешниеОбработки._ОтчетностьЦБ.ОКУД0420520.КоличествоСотрудниковКомпанииПоФорме0420520"")
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		МассивПолей.Добавить(Новый Структура("Ячейка, Значение", ЯчейкаНаименование, Выборка.ПолноеНаименованиеПоУставу));
		МассивПолей.Добавить(Новый Структура("Ячейка, Значение", ЯчейкаИНН, Выборка.ИНН));
		МассивПолей.Добавить(Новый Структура("Ячейка, Значение", ЯчейкаЧисленностьПерсонала, Выборка.Значение));
	КонецЕсли; 
	
	Возврат МассивПолей;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРезультатКомпоновки(СКД, Настройки, ДанныеОтчета)

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, Новый Структура("ДанныеОтчета", ДанныеОтчета));
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат ТаблицаРезультат;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНастройкиКомпоновкиДанныхДляВыгрузки(ВерсияОтчета)

	Настройки = Новый НастройкиКомпоновкиДанных;
	
	// параметры
	Если ВерсияОтчета = 3 Тогда
		ВертикальноеРасположениеОбщихИтогов = РасположениеИтоговКомпоновкиДанных.Начало;
	Иначе
		ВертикальноеРасположениеОбщихИтогов = РасположениеИтоговКомпоновкиДанных.Нет;
	КонецЕсли; 
	
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", ВертикальноеРасположениеОбщихИтогов);
	
	// структура
	ПерваяГруппировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	НовоеПолеГруппировки = ПерваяГруппировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	НовоеПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ПорядокРазделов");
	
	ПерваяГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ПерваяГруппировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	// выбранные поля
	ДобавляемыеПоля = СтрРазделить("ПорядокРазделов,КоличествоКлиентов,КоличествоЮрЛиц,КоличествоФизЛиц,СЧА", ",", Ложь);
	
	Для каждого ИмяПоля Из ДобавляемыеПоля Цикл
		НовоеПолеВыбор = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПолеВыбор.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла; 
	
	Возврат Настройки;

КонецФункции
 
&НаСервереБезКонтекста
Функция ПолучитьСтруктуруОтчета(ЗаполняемыеПоля, ВерсияОтчета)

	СтруктураОтчета = Новый ТаблицаЗначений;
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	МассивТипов.Добавить(Тип("Строка"));
	СтруктураОтчета.Колонки.Добавить("Раздел", Новый ОписаниеТипов(МассивТипов));
	СтруктураОтчета.Колонки.Добавить("КоличествоЮрЛиц", Новый ОписаниеТипов("Строка"));
	СтруктураОтчета.Колонки.Добавить("КоличествоФизЛиц", Новый ОписаниеТипов("Строка"));
	СтруктураОтчета.Колонки.Добавить("КоличествоКлиентов", Новый ОписаниеТипов("Строка"));
	СтруктураОтчета.Колонки.Добавить("СЧА", Новый ОписаниеТипов("Строка"));
	
	СоответствиеКолонок = Новый Соответствие;
	СоответствиеКолонок.Вставить("Раздел", 2);
	СоответствиеКолонок.Вставить("КоличествоЮрЛиц", 3);
	СоответствиеКолонок.Вставить("КоличествоФизЛиц", 4);
	СоответствиеКолонок.Вставить("КоличествоКлиентов", 5);
	СоответствиеКолонок.Вставить("СЧА", 6);
	
	Для НомерСтроки = 2 По ЗаполняемыеПоля.ВысотаТаблицы Цикл
	
		Если ЗаполняемыеПоля.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = Строка(ВерсияОтчета) Тогда
		
			НоваяСтрока = СтруктураОтчета.Добавить();
			Для каждого Колонка Из СоответствиеКолонок Цикл
				
				Значение = ЗаполняемыеПоля.Область(НомерСтроки, Колонка.Значение, НомерСтроки, Колонка.Значение).Текст;
				
				Если Колонка.Ключ = "Раздел" Тогда
					Если Значение = "Итог" Тогда
						Значение = Неопределено;
					Иначе
						Значение = Число(Значение);
					КонецЕсли; 
				КонецЕсли; 
				
				НоваяСтрока[Колонка.Ключ] = Значение;
				
			КонецЦикла; 
		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Возврат СтруктураОтчета;

КонецФункции

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОткрытьСессиюСбораСтатистикиНаСервере(Механизм, Сессия)

	ОбъектНаСервере = РеквизитФормыВЗначение("Отчет");
	ПараметрыВыполненияДляСбораСтатистики = ОбъектНаСервере.ПолучитьПараметрыВыполненияДляСбораСтатистики();
	
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
КонецПроцедуры
 
&НаСервереБезКонтекста
Процедура ЗакрытьСессиюСбораСтатистики(Механизм, Сессия)

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";

	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ);
	КонецЕсли;
	
КонецПроцедуры
 