
Перем ДополнительныеСвойства Экспорт;

#Область Интерфейс_внешнего_отчета

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Расшифровка стоимости активов для группы Будущего",
		"0.15",
		"",
		Истина);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ФормированиеИОтправкаОтчета", "Формирование и отправка отчета", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска обработки
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	// Заполнение реквизитов обработки
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыКоманды); 
	
	Если ПараметрыКоманды.Свойство("Клиенты") И ТипЗнч(ПараметрыКоманды.Клиенты) = Тип("Массив") Тогда
		ЭтотОбъект.Клиенты.ЗагрузитьЗначения(ПараметрыКоманды.Клиенты);	
	КонецЕсли;
	
	// Обработка команд
	
	Если ИдентификаторКоманды = "ФормированиеИОтправкаОтчета" Тогда
		
		#Область Обработка_команды
		
		Если Не ПараметрыКоманды.Свойство("Получатели") ИЛИ Не ЗначениеЗаполнено(ПараметрыКоманды.Получатели) Тогда
			ЗарегистрироватьОшибки("Не заполнен обязательный параметр: 'Получатели'");
			Возврат;
		КонецЕсли;
		
		Если Не ПараметрыКоманды.Свойство("ПолучателиОшибок") ИЛИ Не ЗначениеЗаполнено(ПараметрыКоманды.ПолучателиОшибок) Тогда
			ЗарегистрироватьОшибки("Не заполнен обязательный параметр: 'ПолучателиОшибок'");
			Возврат;
		КонецЕсли;
		
		// Отправляем по рабочим дням за Т-2 
		
		ОтчетнаяДата	= Неопределено;
		ТекущийДень		= НачалоДня(ТекущаяДатаСеанса());
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущийДень) Тогда
			ОтчетнаяДата = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущийДень - 1, -2);		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтчетнаяДата) Тогда
			
			ЭтотОбъект.Период = ОтчетнаяДата;
			
			Если Не ЭтотОбъект.ПроверитьЗаполнение() Тогда 
				ЗарегистрироватьОшибки("Не заполнены обязательные параметры.", ОбщегоНазначения.ПолучитьТекстСообщенийПользователю(Символы.ПС, Истина));
				Возврат;
			КонецЕсли;
			
			СформироватьИОтправитьОтчет(ПараметрыКоманды.Получатели, ПараметрыКоманды.ПолучателиОшибок);
			
		КонецЕсли;
		
		#КонецОбласти
			
	Иначе
		
		ВызватьИсключение СтрШаблон("Неизвестный идентификатор команды: ""%1""", ИдентификаторКоманды);	
		
	КонецЕсли;
		
КонецПроцедуры

Процедура СформироватьИОтправитьОтчет(Получатели, ПолучателиОшибок)
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("РегистрироватьВЖурналеОшибокТолькоСистемныеОшибки");
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОтключитьУведомленияОбОшибкахРасчетаЦены");	
	
	// Формируем отчет
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ЭтотОбъект.СкомпоноватьРезультат(ДокументРезультат);
	
	// Формируем письмо
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому",		Получатели);
	ПараметрыПисьма.Вставить("Тема",		"Стоимость активов группы Будущего без учета письма ЦБ РФ № ИН-018-53/16");
	ПараметрыПисьма.Вставить("Тело",		"Во вложении отчет за " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"));
	ПараметрыПисьма.Вставить("ТипТекста",	"ПростойТекст");
	ПараметрыПисьма.Вставить("Вложения",	Новый Соответствие);
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗарегистрированныеОшибки") Тогда
		
		// Уведомим об ошибках
		
		ПараметрыПисьма.Кому = ПолучателиОшибок;
		ПараметрыПисьма.Тело =
			СтрШаблон(
				"Ошибка формирования! После устранения проблемы отчет за %1 следует сформировать и отправить вручную.
				|
				|%2",
			Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"),
			СтрСоединить(ЭтотОбъект.ДополнительныеСвойства.ЗарегистрированныеОшибки, Символы.ПС));
		
	Иначе
		
		// Вложим файл с результатом отчета
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		
		ДокументРезультат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
		
		ПараметрыПисьма.Вложения.Вставить("Расшифровка стоимости активов.xlsx", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла)));
		
		УдалитьФайлы(ИмяВременногоФайла);
		
		// Добавим ошибки расчета цены в письмо 
		
		ТекстСообщения = ОписаниеОшибкиРасчетаЦен();
		
		Если Не ПустаяСтрока(ТекстСообщения) Тогда
			
			ПараметрыПисьма.Тело = ПараметрыПисьма.Тело + Символы.ПС + Символы.ПС + ТекстСообщения;		
			
		КонецЕсли;
		
	КонецЕсли;
	
	РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма, , Истина);			
	
КонецПроцедуры

#КонецОбласти

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Ошибки				 = Неопределено;
	
	// Начало сессии статистики
	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя();
	ПараметрыВыполнения	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Сессия	 			= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполнения.Хранилище, ПараметрыВыполнения.Описание);
	
	// Получаем данные для отчета
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, "_СчетаДоверительногоУправления"); 
	
	#Область Проверяем_готовность_данных
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ПропуститьПредварительнуюПроверкуГотовностиДанных") Тогда
	
		СчетаДУБезДатЗапрета = Неопределено;
		СчетаДУБезСЧА		 = Неопределено; 
		
		Если Не ПроверитьГотовностьДанных(Запрос.МенеджерВременныхТаблиц, "_СчетаДоверительногоУправления", СчетаДУБезДатЗапрета, СчетаДУБезСЧА) Тогда
			
			ОшибкаЗарегистрирована = Ложь;
			
			Если ЗначениеЗаполнено(СчетаДУБезДатЗапрета) Тогда
				ЗарегистрироватьОшибки(СтрШаблон("На %1 не установлены даты запрета редактирования: %2", Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"), СтрСоединить(СчетаДУБезДатЗапрета, ", ")), , Ложь);
				ОшибкаЗарегистрирована = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СчетаДУБезСЧА) Тогда
				ЗарегистрироватьОшибки(СтрШаблон("Не зарегистрирована СЧА: %1", СтрСоединить(СчетаДУБезСЧА, ", ")), , Ложь);
				ОшибкаЗарегистрирована = Истина;
			КонецЕсли;
			
			Если Не ОшибкаЗарегистрирована Тогда
				ЗарегистрироватьОшибки("Ошибка проверки готовности данных", , Ложь);
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
	
	КонецЕсли;
	
	#КонецОбласти
	
	РассчитываемыеПоПисьмуЦБ0185316 = Новый ТаблицаЗначений;
	РассчитываемыеПоПисьмуЦБ0185316.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	
	РегистрСтоимостьПереоценкиПоПисьмуЦБ0185316	 = РегистрыСведений.СтоимостьПереоценки.СоздатьНаборЗаписей().Выгрузить();
	РегистрСтоимостьАктивовНеЦБПоПисьмуЦБ0185316 = РегистрыСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СоздатьНаборЗаписей().Выгрузить();
	
	Если ЭтотОбъект.БезУчетаРасчетаПоПисьмуЦБ0185316 Тогда
		
		#Область Получаем_данные_без_расчета_по_письму
		
		Отказ = Ложь;
		
		ЗаполнитьСчетаДоверительногоУправленияРассчитываемыеПоПисьмуЦБ0185316(РассчитываемыеПоПисьмуЦБ0185316, ЭтотОбъект.Период, Запрос, "_СчетаДоверительногоУправления");
		
		Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ"); 
		Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.Организация	= ЭтотОбъект.Организация;
		Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.Период		= ЭтотОбъект.Период;
	
		Для каждого СчетДоверительногоУправления Из РассчитываемыеПоПисьмуЦБ0185316 Цикл
			
			#Область Проверяем_даты_запрета_редактирования
			
			Если Не ПроверитьДатыЗапретаРедактирования(СчетДоверительногоУправления.Ссылка) Тогда
				
				ТекстОшибки = СтрШаблон("На %1 не установлены даты запрета редактирования: %2", Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"), СчетДоверительногоУправления.Ссылка);
				
				Если СистемныеФункции.ЭтоФоновоеЗадание() Тогда
					ЗарегистрироватьОшибки(ТекстОшибки, , Ложь);
					Возврат;
				Иначе
					ЗарегистрироватьОшибки(ТекстОшибки + ". Активы данного счета д/у не выведены в отчет.", , Ложь);
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			#КонецОбласти
			
			Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.СчетДоверительногоУправления = СчетДоверительногоУправления.Ссылка;
			
			СообщенияДоРасчета = ПолучитьСообщенияПользователю(Истина);
			
			Попытка
				
				РСА = Отчет_СведенияОбОценкеВСоответствииСИнформационнымПисьмомЦБРФ.ПолучитьРегистрациюСтоимостиАктивовБезРасчетаПоПисьму(Отказ);
				
				Если Не Отказ Тогда
				
					// ЦБ
					
					РегистрацияСтоимости = РСА.ДополнительныеСвойства.РегистрацияСтоимости;
					
					Для Каждого ТекСтрока Из РегистрацияСтоимости.СтоимостиПереоценки Цикл
						
						Движение = РегистрСтоимостьПереоценкиПоПисьмуЦБ0185316.Добавить();
						
						Движение.Период			= РегистрацияСтоимости.Дата;
						Движение.ВидЦеныОценки	= Перечисления.ВидыЦенОценки.ЦенаОценки;
						
						ЗаполнитьЗначенияСвойств(Движение, РегистрацияСтоимости); 
						ЗаполнитьЗначенияСвойств(Движение, ТекСтрока); 
						
						Если ТекСтрока.ВидЦены = Перечисления.ИсточникиЦеныДляПереоценки.ОшибкаРасчета
							ИЛИ ТекСтрока.Цена = 0 И Не Документы.РегистрацияСтоимостиПереоценки.ДопустимаНулеваяЦена(ТекСтрока)
						Тогда
						    ДобавитьОшибкуРасчетаЦены(ЭтотОбъект.Период, СчетДоверительногоУправления.Ссылка, ТекСтрока.ЦеннаяБумага);
						КонецЕсли;
						
					КонецЦикла;
					
					// Не ЦБ
					
					Для Каждого ТекСтрока Из РСА.АктивыНеОтносящиесяКЦеннымБумагам Цикл
						
						Движение = РегистрСтоимостьАктивовНеЦБПоПисьмуЦБ0185316.Добавить();
						
						Движение.Период = РегистрацияСтоимости.Дата;
						Движение.Валюта = ТекСтрока.ВалютаСтроки;
						
						ЗаполнитьЗначенияСвойств(Движение, РегистрацияСтоимости); 
						ЗаполнитьЗначенияСвойств(Движение, ТекСтрока); 
						
					КонецЦикла;
					
				КонецЕсли;
		
			Исключение
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(), , , , Отказ);
				
			КонецПопытки;
			
			ТекстСообщенийПользователю = ОбщегоНазначения.ПолучитьТекстСообщенийПользователю(Символы.ПС, Истина);
			
			ОбщегоНазначения.ВывестиСообщенияПользователю(СообщенияДоРасчета);
			
			Если Отказ Тогда
				ЗарегистрироватьОшибки(СтрШаблон("Ошибка оценки СЧА для '%1' без учета настроек расчета по письму ЦБ РФ № ИН-018-53/16", СчетДоверительногоУправления.Ссылка), ТекстСообщенийПользователю);
				Возврат;
			КонецЕсли;
			
		КонецЦикла; 	
		
		// Уведомляем о накопленных ошибках расчета цены
		
		Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтключитьУведомленияОбОшибкахРасчетаЦены") Тогда
			
			ТекстСообщения = ОписаниеОшибкиРасчетаЦен();
			
			Если Не ПустаяСтрока(ТекстСообщения) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
