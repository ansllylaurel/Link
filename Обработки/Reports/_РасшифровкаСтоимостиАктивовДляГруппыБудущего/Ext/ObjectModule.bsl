		|	_ДанныеОтчета.AssetType,
		|	_ДанныеОтчета.Эмитент,
		|	_ДанныеОтчета.Quantity";
	
	#КонецОбласти	
	
	ДанныеОтчета = Запрос.Выполнить().Выбрать();
	
	Если ДанныеОтчета.Количество() <> ТаблицаДанныхДляВыгрузки.Количество() Тогда
		ЗарегистрироватьОшибки("Дублирование строк в отчете!");
		Возврат;
	КонецЕсли;
	
	// Выводим результат в табличный документ

	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Пока ДанныеОтчета.Следующий() Цикл
		
		ОбластьСтрока.Параметры.Заполнить(ДанныеОтчета);
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	// Параметры печати и пр.
	
	ДокументРезультат.ФиксацияСверху = ОбластьШапка.ВысотаТаблицы;
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, Механизм, Ложь, ОриентацияСтраницы.Ландшафт);
	
	// Фиксация сессии статистики
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия); 
	
КонецПроцедуры

#Область Служебные_процедуры_и_функции

Процедура ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ИмяВременнойТаблицы)
	
	ОтборСчетовДоверительногоУправления = Новый Структура("Организация, Клиент",
		ЭтотОбъект.Организация, ?(ЗначениеЗаполнено(ЭтотОбъект.Клиенты), ЭтотОбъект.Клиенты, Неопределено));
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ИсключаемыеСчетаДоверительногоУправления")
		И ЗначениеЗаполнено(ЭтотОбъект.ДополнительныеСвойства.ИсключаемыеСчетаДоверительногоУправления)
	Тогда
	
		ИмяВременнойТаблицыБезИсключений = ИмяВременнойТаблицы + "БезИсключений"; 
	
		Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
			МенеджерВременныхТаблиц, ЭтотОбъект.Период, ОтборСчетовДоверительногоУправления, ИмяВременнойТаблицыБезИсключений);
			
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	*
			|ПОМЕСТИТЬ #СчетаДоверительногоУправления#
			|ИЗ
			|	#СчетаДоверительногоУправленияБезИсключений# КАК СчетаДоверительногоУправления
			|ГДЕ
			|	НЕ СчетаДоверительногоУправления.Ссылка В (&ИсключаемыеСчета)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ #СчетаДоверительногоУправленияБезИсключений#";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СчетаДоверительногоУправления#",				 ИмяВременнойТаблицы);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СчетаДоверительногоУправленияБезИсключений#", ИмяВременнойТаблицыБезИсключений);
		
		Запрос.УстановитьПараметр("ИсключаемыеСчета", ЭтотОбъект.ДополнительныеСвойства.ИсключаемыеСчетаДоверительногоУправления);
		
		Запрос.Выполнить();
		
	Иначе
	
		Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
			МенеджерВременныхТаблиц, ЭтотОбъект.Период, ОтборСчетовДоверительногоУправления, ИмяВременнойТаблицы);
		
	КонецЕсли;
			
КонецПроцедуры

Функция ПроверитьГотовностьДанных(МенеджерВременныхТаблиц = Неопределено, ИмяВременнойТаблицыСчетовДУ = "_СчетаДоверительногоУправления", СчетаДоверительногоУправленияБезДатЗапрета = Неопределено, СчетаДоверительногоУправленияБезСЧА = Неопределено) Экспорт

	ПроверкаПройдена = Истина;	
	
	Если МенеджерВременныхТаблиц = Неопределено Тогда
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Если МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицыСчетовДУ) = Неопределено Тогда
		ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ИмяВременнойТаблицыСчетовДУ)	
	КонецЕсли;
	
	Если Не ПроверитьДатыЗапретаРедактирования(ИмяВременнойТаблицыСчетовДУ, МенеджерВременныхТаблиц, СчетаДоверительногоУправленияБезДатЗапрета) Тогда
		ПроверкаПройдена = Ложь;
	КонецЕсли;
	
	Если Не ПроверитьРегистрациюСЧА(ИмяВременнойТаблицыСчетовДУ, МенеджерВременныхТаблиц, СчетаДоверительногоУправленияБезСЧА) Тогда
		ПроверкаПройдена = Ложь;
	КонецЕсли;
	
	Возврат ПроверкаПройдена;
	
КонецФункции

Функция ПроверитьДатыЗапретаРедактирования(СчетаДоверительногоУправления = Неопределено, ИсточникВременныхТаблиц = Неопределено, СчетаДоверительногоУправленияБезДатЗапрета = Неопределено)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	#СчетаДоверительногоУправления# КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|		ПО (ДатыЗапретаРедактирования.Организация = &Организация)
		|			И (ДатыЗапретаРедактирования.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|			И (ДатыЗапретаРедактирования.ГруппаЗапрета = &ГруппаЗапрета)
		|			И (ДатыЗапретаРедактирования.ВидУчета = &ВидУчета)
		|			И (ДатыЗапретаРедактирования.ДатаЗапретаРедактирования <> ДАТАВРЕМЯ(1, 1, 1))
		|			И (КОНЕЦПЕРИОДА(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, ДЕНЬ) < КОНЕЦПЕРИОДА(&Период, ДЕНЬ))");	
	
	Если ТипЗнч(СчетаДоверительногоУправления) = Тип("Строка") Тогда
		
		Запрос.МенеджерВременныхТаблиц = ?(ТипЗнч(ИсточникВременныхТаблиц) = Тип("МенеджерВременныхТаблиц"), ИсточникВременныхТаблиц, ИсточникВременныхТаблиц.МенеджерВременныхТаблиц);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СчетаДоверительногоУправления#", СчетаДоверительногоУправления);
		
	Иначе
		
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СчетаДоверительногоУправления#", "(ВЫБРАТЬ Ссылка ИЗ Справочник.СчетаДоверительногоУправления ГДЕ Ссылка В (&СчетаДоверительногоУправления))");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",			ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ГруппаЗапрета",	Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
	Запрос.УстановитьПараметр("ВидУчета",		Перечисления.ВидыУчета.ПустаяСсылка());
	
	СчетаДоверительногоУправленияБезДатЗапрета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат (СчетаДоверительногоУправленияБезДатЗапрета.Количество() = 0);
	
КонецФункции

Функция ПроверитьРегистрациюСЧА(СчетаДоверительногоУправления = Неопределено, ИсточникВременныхТаблиц = Неопределено, СчетаДоверительногоУправленияБезСЧА = Неопределено)
	
	// Оставим только тех, у кого есть остатки денег и/или бумаг
	// #Техдолг т.к. такой же фильтр есть в обработке ПроведениеРегламентныхОпераций
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СчетаБезСЧА
		|ИЗ
		|	#СчетаДоверительногоУправления# КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК РегистрацииСЧА
		|		ПО (РегистрацииСЧА.Организация = &Организация)
		|			И (РегистрацииСЧА.СубъектАналитики = СчетаДоверительногоУправления.Ссылка)
		|			И (РегистрацииСЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И (ТИПЗНАЧЕНИЯ(РегистрацииСЧА.Регистратор) = ТИП(Документ.РегистрацияСтоимостиАктивов))
		|			И (РегистрацииСЧА.Период = &Период)
		|ГДЕ
		|	РегистрацииСЧА.Значение ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаБезСЧА.Ссылка КАК Ссылка
		|ИЗ
		|	_СчетаБезСЧА КАК _СчетаБезСЧА
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ПО (ОстаткиДенежныхСредств.СчетДоверительногоУправления = _СчетаБезСЧА.Ссылка)
		|			И (ОстаткиДенежныхСредств.Организация = &Организация)
		|			И (ОстаткиДенежныхСредств.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_СчетаБезСЧА.Ссылка
		|ИЗ
		|	_СчетаБезСЧА КАК _СчетаБезСЧА
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|		ПО (ОстаткиЦенныхБумаг.СчетДоверительногоУправления = _СчетаБезСЧА.Ссылка)
		|			И (ОстаткиЦенныхБумаг.Организация = &Организация)
		|			И (ОстаткиЦенныхБумаг.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СчетаБезСЧА");	
	
	Если ТипЗнч(СчетаДоверительногоУправления) = Тип("Строка") Тогда
		
		Запрос.МенеджерВременныхТаблиц = ?(ТипЗнч(ИсточникВременныхТаблиц) = Тип("МенеджерВременныхТаблиц"), ИсточникВременныхТаблиц, ИсточникВременныхТаблиц.МенеджерВременныхТаблиц);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СчетаДоверительногоУправления#", СчетаДоверительногоУправления);
		
	Иначе
		
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#СчетаДоверительногоУправления#", "(ВЫБРАТЬ Ссылка ИЗ Справочник.СчетаДоверительногоУправления ГДЕ Ссылка В (&СчетаДоверительногоУправления))");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",			ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ГруппаЗапрета",	Перечисления.ГруппыЗапретаРедактирования.БэкОфис);
	Запрос.УстановитьПараметр("ВидУчета",		Перечисления.ВидыУчета.ПустаяСсылка());
	
	СчетаДоверительногоУправленияБезСЧА = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
	Возврат (СчетаДоверительногоУправленияБезСЧА.Количество() = 0);
	
КонецФункции

Процедура ЗаполнитьСчетаДоверительногоУправленияРассчитываемыеПоПисьмуЦБ0185316(РассчитываемыеПоПисьмуЦБ0185316, Период, ИсточникВременныхТаблиц, ИмяВременнойТаблицыСчетовДоверительногоУправления)
	
	МенеджерВременныхТаблиц = ?(ТипЗнч(ИсточникВременныхТаблиц) = Тип("МенеджерВременныхТаблиц"), ИсточникВременныхТаблиц, ИсточникВременныхТаблиц.МенеджерВременныхТаблиц);	
	
	СчетаДоверительногоУправления = МенеджерВременныхТаблиц.Таблицы[ИмяВременнойТаблицыСчетовДоверительногоУправления].ПолучитьДанные().Выбрать();	
	
	Пока СчетаДоверительногоУправления.Следующий() Цикл
		
		НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
			Период, ЭтотОбъект.Организация, СчетаДоверительногоУправления.Ссылка, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		
		Если НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316 Тогда
			ЗаполнитьЗначенияСвойств(РассчитываемыеПоПисьмуЦБ0185316.Добавить(), СчетаДоверительногоУправления); 	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОшибкуРасчетаЦены(Дата, СчетДоверительногоУправления, ЦеннаяБумага)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкиРасчетаЦены") Тогда
		
		ИзмеренияСтоимостиПереоценки = Метаданные.РегистрыСведений.СтоимостьПереоценки.Измерения;
		
		ОшибкиРасчетаЦены = Новый ТаблицаЗначений;
		ОшибкиРасчетаЦены.Колонки.Добавить("Дата",						Новый ОписаниеТипов("Дата"));
		ОшибкиРасчетаЦены.Колонки.Добавить("СчетДоверительногоУправления",	ИзмеренияСтоимостиПереоценки.СчетДоверительногоУправления.Тип);
		ОшибкиРасчетаЦены.Колонки.Добавить("ЦеннаяБумага",					ИзмеренияСтоимостиПереоценки.ЦеннаяБумага.Тип);
		
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ОшибкиРасчетаЦены", ОшибкиРасчетаЦены);
		
	КонецЕсли;
	
	ОшибкаРасчетаЦены = ЭтотОбъект.ДополнительныеСвойства.ОшибкиРасчетаЦены.Добавить();
	ОшибкаРасчетаЦены.Дата							= Дата;
	ОшибкаРасчетаЦены.СчетДоверительногоУправления	= СчетДоверительногоУправления;
	ОшибкаРасчетаЦены.ЦеннаяБумага					= ЦеннаяБумага;
	
КонецПроцедуры

Функция ОписаниеОшибкиРасчетаЦен()
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ОшибкиРасчетаЦены") Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ЭтотОбъект.ДополнительныеСвойства.ОшибкиРасчетаЦены, "_ОшибкиРасчетаЦены", Запрос, Истина);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОшибкиРасчетаЦены.Дата КАК Дата,
		|	ПРЕДСТАВЛЕНИЕ(_ОшибкиРасчетаЦены.СчетДоверительногоУправления) КАК СчетДоверительногоУправления,
		|	ПРЕДСТАВЛЕНИЕ(_ОшибкиРасчетаЦены.ЦеннаяБумага) КАК ЦеннаяБумага
		|ИЗ
		|	_ОшибкиРасчетаЦены КАК _ОшибкиРасчетаЦены
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ОшибкиРасчетаЦены.СчетДоверительногоУправления,
		|	_ОшибкиРасчетаЦены.ЦеннаяБумага,
		|	_ОшибкиРасчетаЦены.Дата
		|ИТОГИ ПО
		|	Дата,
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	ТекстОшибки = "Не удалось определить стоимость ценной бумаги:";
	
	ВыборкаПоДате = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДате.Следующий() Цикл
		
		ТекстОшибки = ТекстОшибки + СтрШаблон("
			|	%1", Формат(ВыборкаПоДате.Дата, "ДФ=dd.MM.yyyy"));
		
		ВыборкаПоСчетуДУ = ВыборкаПоДате.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоСчетуДУ.Следующий() Цикл
			
			МассивБумаг = Новый Массив;
			
			ВыборкаПоБумаге = ВыборкаПоСчетуДУ.Выбрать();
			Пока ВыборкаПоБумаге.Следующий() Цикл
				МассивБумаг.Добавить(ВыборкаПоБумаге.ЦеннаяБумага);
			КонецЦикла;
			
			ТекстОшибки = ТекстОшибки + СтрШаблон("
				|	- %1: %2", ВыборкаПоСчетуДУ.СчетДоверительногоУправления, СтрСоединить(МассивБумаг, ", ")); 
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТекстОшибки;
	
КонецФункции

Процедура ЗарегистрироватьОшибки(ОписаниеОшибки, Ошибки = Неопределено, СистемнаяОшибка = Истина)
	
	РегистрируемыеОшибки = РаботаСКоллекциями.ЗначениеВМассив(ОписаниеОшибки);
	
	Если Ошибки <> Неопределено Тогда
		РаботаСКоллекциями.ДополнитьМассив(РегистрируемыеОшибки, Ошибки); 
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		Источник = ЭтотОбъект.ДополнительныеСвойства.Источник;
	Иначе
		Источник = ЭтотОбъект.Метаданные().ПолноеИмя();
	КонецЕсли;
	
	Если СистемныеФункции.ЭтоФоновоеЗадание() Тогда
		
		Если СистемнаяОшибка
			ИЛИ Не ЭтотОбъект.ДополнительныеСвойства.Свойство("РегистрироватьВЖурналеОшибокТолькоСистемныеОшибки")
		Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(РегистрируемыеОшибки, Источник);
		КонецЕсли;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(РегистрируемыеОшибки, Символы.ПС));
		
	КонецЕсли;		
	
	// Запоминаем зарегистрированные ошибки
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗарегистрированныеОшибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ЗарегистрированныеОшибки", Новый Массив);
	КонецЕсли;
	
	РаботаСКоллекциями.ДополнитьМассив(ЭтотОбъект.ДополнительныеСвойства.ЗарегистрированныеОшибки, РегистрируемыеОшибки); 
	
КонецПроцедуры

#КонецОбласти

ДополнительныеСвойства = Новый Структура;
