	|		КОГДА ЕСТЬNULL(_Итоги.СчетРодитель, _ИтогиНач.СчетРодитель) В (""710"", ""711"", ""712"", ""713"", ""715"", ""717"", ""718"", ""720"", ""725"")
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокДт, _Итоги.СуммаНачальныйОстатокДт) - ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокКт, _Итоги.СуммаНачальныйОстатокКт) + ЕСТЬNULL(_Итоги.СуммаОборотДт, 0) - ЕСТЬNULL(_Итоги.СуммаОборотКт, 0) > 0
	|						ТОГДА ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокДт, _Итоги.СуммаНачальныйОстатокДт) - ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокКт, _Итоги.СуммаНачальныйОстатокКт) + ЕСТЬNULL(_Итоги.СуммаОборотДт, 0) - ЕСТЬNULL(_Итоги.СуммаОборотКт, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(_Итоги.СуммаКонечныйОстатокДт, _ИтогиНач.СуммаКонечныйОстатокДт)
	|	КОНЕЦ - ВЫБОР
	|		КОГДА ЕСТЬNULL(_Итоги.СчетРодитель, _ИтогиНач.СчетРодитель) В (""710"", ""711"", ""712"", ""713"", ""715"", ""717"", ""718"", ""720"", ""725"")
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокДт, _Итоги.СуммаНачальныйОстатокДт) - ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокКт, _Итоги.СуммаНачальныйОстатокКт) + ЕСТЬNULL(_Итоги.СуммаОборотДт, 0) - ЕСТЬNULL(_Итоги.СуммаОборотКт, 0) < 0
	|						ТОГДА -ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокДт, _Итоги.СуммаНачальныйОстатокДт) + ЕСТЬNULL(_ИтогиНач.СуммаКонечныйОстатокКт, _Итоги.СуммаНачальныйОстатокКт) - ЕСТЬNULL(_Итоги.СуммаОборотДт, 0) + ЕСТЬNULL(_Итоги.СуммаОборотКт, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(_Итоги.СуммаКонечныйОстатокКт, _ИтогиНач.СуммаКонечныйОстатокКт)
	|	КОНЕЦ КАК КонечноеСальдо
	|ПОМЕСТИТЬ _Вывод
	|ИЗ
	|	_Итоги КАК _Итоги
	|		ПОЛНОЕ СОЕДИНЕНИЕ _ИтогиНач КАК _ИтогиНач
	|		ПО _Итоги.Счет = _ИтогиНач.Счет
	|			И _Итоги.НомерДоговора = _ИтогиНач.НомерДоговора
	|			И _Итоги.СимволОФР = _ИтогиНач.СимволОФР
	|			И _Итоги.Эмитент = _ИтогиНач.Эмитент
	|			И _Итоги.ТипФИ = _ИтогиНач.ТипФИ
	|			И _Итоги.ГосударственныйРегистрационныйНомер = _ИтогиНач.ГосударственныйРегистрационныйНомер
	|			И _Итоги.ЭлементБалансовойСтоимости = _ИтогиНач.ЭлементБалансовойСтоимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Вывод.СчетЗабалансовый КАК СчетЗабалансовый,
	|	_Вывод.СчетРодитель КАК СчетРодитель,
	|	_Вывод.Счет КАК Счет,
	|	_Вывод.СчетНаименование КАК СчетНаименование,
	|	_Вывод.СимволОФР КАК СимволОФР,
	|	_Вывод.ВидАктива КАК ВидАктива,
	|	_Вывод.НомерДоговора КАК НомерДоговора,
	|	_Вывод.ДатаЗаключения КАК ДатаЗаключения,
	|	_Вывод.Эмитент КАК Эмитент,
	|	_Вывод.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
	|	_Вывод.ISIN КАК ISIN,
	|	_Вывод.ТипФИ КАК ТипФИ,
	|	_Вывод.ЭлементБалансовойСтоимости КАК ЭлементБалансовойСтоимости,
	|	_Вывод.СуммаНачальныйОстатокДт КАК СуммаНачальныйОстатокДт,
	|	_Вывод.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт,
	|	_Вывод.СуммаОборотДт КАК СуммаОборотДт,
	|	_Вывод.СуммаОборотКт КАК СуммаОборотКт,
	|	_Вывод.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
	|	_Вывод.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт,
	|	_Вывод.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
	|	_Вывод.КоличествоОборотДт КАК КоличествоОборотДт,
	|	_Вывод.КоличествоОборотКт КАК КоличествоОборотКт,
	|	_Вывод.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
	|	_Вывод.НачальноеСальдо КАК НачальноеСальдо,
	|	_Вывод.КонечноеСальдо КАК КонечноеСальдо
	|ИЗ
	|	_Вывод КАК _Вывод
	|ГДЕ
	|	(_Вывод.СуммаНачальныйОстатокДт <> 0
	|			ИЛИ _Вывод.СуммаНачальныйОстатокКт <> 0
	|			ИЛИ _Вывод.СуммаОборотДт <> 0
	|			ИЛИ _Вывод.СуммаОборотКт <> 0
	|			ИЛИ _Вывод.СуммаКонечныйОстатокДт <> 0
	|			ИЛИ _Вывод.СуммаКонечныйОстатокКт <> 0
	|			ИЛИ _Вывод.КоличествоНачальныйОстаток <> 0
	|			ИЛИ _Вывод.КоличествоОборотДт <> 0
	|			ИЛИ _Вывод.КоличествоОборотКт <> 0
	|			ИЛИ _Вывод.КоличествоКонечныйОстаток <> 0)";
	
		
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(Макс(ЭтотОбъект.Период.ДатаНачала, ДатаРеформации), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериодаИсключая", Новый Граница(Макс(ЭтотОбъект.Период.ДатаНачала, ДатаРеформации), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("НачалоГода", Новый Граница(Макс(НачалоГода(ЭтотОбъект.Период.ДатаНачала), ДатаРеформации), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("Счет47903", ПланыСчетов.Единый.АктивыВДУ03);
	
	СчетаДоходыРасходы = Новый Массив;
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПрибыльУбытокПрошлогоГода);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПроцентныеДоходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПроцентныеРасходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоРезервам);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыОтОпераций);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПрочиеДоходыРасходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПроцентныеДоходыПрошлогоГода);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыИРасходыКромеПроцентныхОтОперацийСФинансовымиИнструментамиПрошлогоГода);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыИРасходыПоДеятельностиПоНПО);

	Запрос.УстановитьПараметр("СчетаДоходыРасходы", СчетаДоходыРасходы);
		
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Возврат Выборка;
	
КонецФункции	

Функция ПолучитьДатыРеформаций(СписокСчетовДУ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РеформацииБалансов.ДатаРеформации, ДАТАВРЕМЯ(1, 1, 1)) < НАЧАЛОПЕРИОДА(&Период, ГОД)
	|			ТОГДА НАЧАЛОПЕРИОДА(&Период, ГОД)
	|		КОГДА ЕСТЬNULL(РеформацииБалансов.ДатаРеформации, ДАТАВРЕМЯ(1, 1, 1)) >= &Период
	|			ТОГДА НАЧАЛОПЕРИОДА(&Период, ГОД)
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(РеформацииБалансов.ДатаРеформации, ДЕНЬ, 1)
	|	КОНЕЦ КАК ДатаНачалаЗапроса,
	|	1 КАК Счетчик
	|ИЗ
	|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
	|		ПО СчетаДоверительногоУправления.Ссылка = РеформацииБалансов.СчетДоверительногоУправления
	|			И (ДОБАВИТЬКДАТЕ(РеформацииБалансов.ДатаРеформации, ДЕНЬ, 1) <= &Период)
	|ГДЕ
	|	СчетаДоверительногоУправления.Организация = &Организация
	|	И СчетаДоверительногоУправления.Ссылка В(&СчетДУ)
	|ИТОГИ
	|	СУММА(Счетчик)
	|ПО
	|	ДатаНачалаЗапроса";
	
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДУ", СписокСчетовДУ);
	
	Возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции	

Функция Сформировать(СписокСчетовДУ, РасширенныйВариант = Ложь, ФормироватьSCV = Ложь) Экспорт
	
	ДокументРезультат = Новый ТабличныйДокумент;
		
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,Клиент");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДокументРезультат.Очистить();
		
	Макет = ПолучитьМакет("Отчет");
	Если РасширенныйВариант ИЛИ ФормироватьSCV Тогда        // для CSV добавляем сальдо начальное и сальдо конечное
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаВ2");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаВ2");
		ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	Иначе 
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	КонецЕсли;
	
	СтрокаСписокДоговоровДУ = "Договоры ДУ: ";
	Для Каждого ЭлементМассива из СписокСчетовДУ Цикл 
		СтрокаСписокДоговоровДУ = СтрокаСписокДоговоровДУ + ЭлементМассива.НомерДоговора + ", ";
	КонецЦикла;
	
	ОбластьШапка.Параметры.СписокДоговоровДУ = СтрокаСписокДоговоровДУ;
	ОбластьШапка.Параметры.ЗаголовокОтчета = "Сводная оборотно-сальдовая ведомость за " + ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	ОбластьШапка.Параметры.Клиент = "Клиент: " + ЭтотОбъект.Клиент;

	ДокументРезультат.Вывести(ОбластьШапка);
	
	// из-за того, что у разных счетов ДУ может быть/не быть дата реформации, дата реформации может быть в разные даты
	// запрос выполняется в цикле для всех счетов ДУ с одной датой реформации
	
	ТаблицаРезультат = Новый ТаблицаЗначений;	
	
	ВыборкаРеформации = ПолучитьДатыРеформаций(СписокСчетовДУ);
	Пока ВыборкаРеформации.Следующий() Цикл
		ДатаРеформации = ВыборкаРеформации.ДатаНачалаЗапроса;
		МассивСчетовДУ = Новый Массив;
		ВыборкаСчетаДУ = ВыборкаРеформации.Выбрать();
		Пока ВыборкаСчетаДУ.Следующий() Цикл 
			МассивСчетовДУ.Добавить(ВыборкаСчетаДУ.СчетДоверительногоУправления);
		КонецЦикла;
		
		 //теперь выполняем запрос для N счетов ДУ. 
		 // если повезло, запрос будет один
		 
		Выборка = ВыполнитьЗапрос(МассивСчетовДУ, ДатаРеформации);
		Если НЕ ЗначениеЗаполнено(ТаблицаРезультат) Тогда 
			Для Каждого Колонка из Выборка.Колонки Цикл
				ТаблицаРезультат.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
			КонецЦикла;	
		КонецЕсли;	
		Для Каждого СтрокаВыборка из Выборка Цикл 
			НоваяСтрока = ТаблицаРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВыборка);
		КонецЦикла;	
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТаблицаРезультат) Тогда 
		
		ТаблицаРезультат.Сортировать("СчетЗабалансовый, СчетРодитель, Счет, ВидАктива, НомерДоговора, Эмитент, ГосударственныйРегистрационныйНомер, ЭлементБалансовойСтоимости, СимволОФР");
		
		Если РасширенныйВариант Тогда 
			
			ИтогСуммаНачальныйОстатокДт = 0;
			ИтогСуммаНачальныйОстатокКт = 0;
			ИтогСуммаОборотДт = 0;	
			ИтогСуммаОборотКт = 0;	
			ИтогСуммаКонечныйОстатокДт = 0;	
			ИтогСуммаКонечныйОстатокКт = 0;	
			ИтогНачальноеСальдо = 0;	
			ИтогКонечноеСальдо = 0;
			
			ТекущийРазделитель = "";
			Для Каждого СтрокаРезультат из ТаблицаРезультат Цикл
				Если ТекущийРазделитель <> СтрокаРезультат.СчетЗабалансовый 
					И ТекущийРазделитель <> "" Тогда 
								
					ОбластьИтог.Параметры.ИтогСуммаНачальныйОстатокДт = ИтогСуммаНачальныйОстатокДт;
					ОбластьИтог.Параметры.ИтогСуммаНачальныйОстатокКт = ИтогСуммаНачальныйОстатокКт;
					ОбластьИтог.Параметры.ИтогСуммаОборотДт = ИтогСуммаОборотДт;
					ОбластьИтог.Параметры.ИтогСуммаОборотКт = ИтогСуммаОборотКт;
					ОбластьИтог.Параметры.ИтогСуммаКонечныйОстатокДт = ИтогСуммаКонечныйОстатокДт;
					ОбластьИтог.Параметры.ИтогСуммаКонечныйОстатокКт = ИтогСуммаКонечныйОстатокКт;
					ОбластьИтог.Параметры.ИтогНачальноеСальдо = ИтогНачальноеСальдо;
					ОбластьИтог.Параметры.ИтогКонечноеСальдо = ИтогКонечноеСальдо;
					
					ДокументРезультат.Вывести(ОбластьИтог);
							
					ИтогСуммаНачальныйОстатокДт = 0;
					ИтогСуммаНачальныйОстатокКт = 0;
					ИтогСуммаОборотДт = 0;	
					ИтогСуммаОборотКт = 0;	
					ИтогСуммаКонечныйОстатокДт = 0;	
					ИтогСуммаКонечныйОстатокКт = 0;	
					ИтогНачальноеСальдо = 0;	
					ИтогКонечноеСальдо = 0;
				КонецЕсли;	
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаРезультат); 
				ОбластьСтрока.Параметры.ДоговорДУ = СокрЛП(СтрокаРезультат.НомерДоговора) + " от " + Формат(СтрокаРезультат.ДатаЗаключения,"ДФ=dd.MM.yyyy");
				ДокументРезультат.Вывести(ОбластьСтрока);
				
				ИтогСуммаНачальныйОстатокДт = ИтогСуммаНачальныйОстатокДт + СтрокаРезультат.СуммаНачальныйОстатокДт;
				ИтогСуммаНачальныйОстатокКт = ИтогСуммаНачальныйОстатокКт + СтрокаРезультат.СуммаНачальныйОстатокКт;
				ИтогСуммаОборотДт = ИтогСуммаОборотДт + СтрокаРезультат.СуммаОборотДт;	
				ИтогСуммаОборотКт = ИтогСуммаОборотКт + СтрокаРезультат.СуммаОборотКт;	
				ИтогСуммаКонечныйОстатокДт = ИтогСуммаКонечныйОстатокДт + СтрокаРезультат.СуммаКонечныйОстатокДт;	
				ИтогСуммаКонечныйОстатокКт = ИтогСуммаКонечныйОстатокКт + СтрокаРезультат.СуммаКонечныйОстатокКт;	
				ИтогНачальноеСальдо = ИтогНачальноеСальдо + СтрокаРезультат.НачальноеСальдо;	
				ИтогКонечноеСальдо = ИтогКонечноеСальдо + СтрокаРезультат.КонечноеСальдо;
				ТекущийРазделитель = СтрокаРезультат.СчетЗабалансовый;
			КонецЦикла;	
			
			ОбластьИтог.Параметры.ИтогСуммаНачальныйОстатокДт = ИтогСуммаНачальныйОстатокДт;
			ОбластьИтог.Параметры.ИтогСуммаНачальныйОстатокКт = ИтогСуммаНачальныйОстатокКт;
			ОбластьИтог.Параметры.ИтогСуммаОборотДт = ИтогСуммаОборотДт;
			ОбластьИтог.Параметры.ИтогСуммаОборотКт = ИтогСуммаОборотКт;
			ОбластьИтог.Параметры.ИтогСуммаКонечныйОстатокДт = ИтогСуммаКонечныйОстатокДт;
			ОбластьИтог.Параметры.ИтогСуммаКонечныйОстатокКт = ИтогСуммаКонечныйОстатокКт;
			ОбластьИтог.Параметры.ИтогНачальноеСальдо = ИтогНачальноеСальдо;
			ОбластьИтог.Параметры.ИтогКонечноеСальдо = ИтогКонечноеСальдо;
			
			ДокументРезультат.Вывести(ОбластьИтог);
			
		Иначе
			Для Каждого СтрокаРезультат из ТаблицаРезультат Цикл
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаРезультат); 
				ОбластьСтрока.Параметры.ДоговорДУ = СокрЛП(СтрокаРезультат.НомерДоговора) + " от " + Формат(СтрокаРезультат.ДатаЗаключения,"ДФ=dd.MM.yyyy");
				Если СтрокаРезультат.ЭлементБалансовойСтоимости = "корректировка процентного дохода по ЭСП" Тогда 
					ОбластьСтрока.Параметры.ЭлементБалансовойСтоимости = "";
				КонецЕсли;	
				ДокументРезультат.Вывести(ОбластьСтрока);
			КонецЦикла;	
			
		КонецЕсли;
	КонецЕсли;          
	
	ДокументРезультат.ФиксацияСверху = 5;
	ДокументРезультат.ФиксацияСлева = 2;
	
	Если ЗначениеЗаполнено(ТаблицаРезультат) И ФормироватьSCV Тогда
		ШиринаТаблицы = 23;
		КонецОбластиДанных = ТаблицаРезультат.Количество() + 9; //7 - начало таблицы. + 2 - возможные группировки в Табличном документе, вариант Расширенный

		ОбластьЗаголовки = ДокументРезультат.ПолучитьОбласть("R6C1:R6C" + ШиринаТаблицы);
		ОбластьДанные = ДокументРезультат.ПолучитьОбласть("R7C1:R" + Формат(КонецОбластиДанных, "ЧГ=0") + "C" + ШиринаТаблицы);
		
		Текст = Новый ТекстовыйДокумент; 
		
		//заголовки    
		ТекстоваяСтрока = "Начало периода;Конец периода;УК;Фонд;";
		Для НомерКолонки = 1 по ШиринаТаблицы Цикл 
			ТекстоваяСтрока = ТекстоваяСтрока + ОбластьЗаголовки.ПолучитьОбласть("R1C" +  НомерКолонки).ТекущаяОбласть.Текст + ?(НомерКолонки <> ШиринаТаблицы, ";", "");
		КонецЦикла; 
		Текст.ДобавитьСтроку(ТекстоваяСтрока);
		
		НачалоСтроки = Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + ";" 
						+ Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy")+ ";"  
						+ ЭтотОбъект.Организация + ";"   
						+ ЭтотОбъект.Клиент + ";";
		
		Для НомерСтроки = 1 по (ТаблицаРезультат.Количество() + 2) Цикл   //добавка на возможные итоговые строки
			ТекстоваяСтрока = "";
			Для НомерКолонки = 1 по ШиринаТаблицы Цикл
				ТекстЯчейки = ОбластьДанные.ПолучитьОбласть("R" + Формат(НомерСтроки, "ЧГ=0") + "C" +  НомерКолонки).ТекущаяОбласть.Текст;
				Если ТекстЯчейки = "Итого:" Тогда 
					Прервать; //в расширенном варианте может быть промежуточный итог баланс/забаланс
				КонецЕсли;
				Если НомерКолонки > 11 Тогда //это числовые данные. Отформатируем, чтобы не было пробелов
					ТекстЯчейки = СтрЗаменить(ТекстЯчейки, Символ(160), "");
				КонецЕсли;
				ТекстоваяСтрока = ТекстоваяСтрока + ТекстЯчейки + ?(НомерКолонки <> ШиринаТаблицы, ";", "");
			КонецЦикла;
			Если Не ПустаяСтрока(ТекстоваяСтрока) И Не СтрНачинаетсяС(ТекстоваяСтрока, ";") Тогда  // в расширенном варианте может быть 1 или 2 строки "Итого". Могли захватить пустую строку, ее не печатаем
				Текст.ДобавитьСтроку(НачалоСтроки + ТекстоваяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		Результат = Текст;
		
	ИначеЕсли ЗначениеЗаполнено(ТаблицаРезультат) Тогда 
		Результат = ДокументРезультат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИмяФайла()
	
	ИмяФайла = "Сводная ОСВ ";	
	ИмяФайла = ИмяФайла + СокрЛП(ЭтотОбъект.Клиент);
	ИмяФайла = ИмяФайла + "_" + ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	
	Возврат ИмяФайла;
	
КонецФункции

