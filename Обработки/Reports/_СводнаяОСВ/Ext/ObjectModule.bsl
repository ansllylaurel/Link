Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Сводная Оборотно-сальдовая ведомость",
		"0.62",
		"",
		Истина);
	
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантПолученияКонечнойДатыПриЕженедФормировании");
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
    Настройки.Добавить("АвтоматическаяОтправка");
    Настройки.Добавить("АдресЭлектроннойПочты");
    Настройки.Добавить("АдресОтправителя");
	Настройки.Добавить("ВидДоговораДоверительногоУправления");
	Настройки.Добавить("ВариантОтчета");

	
	Возврат Настройки;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	Перем Отказ;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	Если НастройкиОтчета.Свойство("КлючТекущегоВарианта")
		И ЗначениеЗаполнено(НастройкиОтчета.КлючТекущегоВарианта) Тогда 
		ВариантОтчета = НастройкиОтчета.КлючТекущегоВарианта;
	Иначе
		ВариантОтчета = "СводнаяОСВ.ПоКлиенту";
	КонецЕсли;
	
	//СводнаяОСВ.ПоКлиентуCSV //значения настроек отчетов КлючТекущегоВарианта. Добавил только этот вариант
	ЭтотОбъект.Клиент = ПолучитьКлиентаДляСчетаДУ(НастройкиОтчета.СчетДоверительногоУправления);	
	
	ФормироватьSCV = Ложь;
	Если Найти(ВариантОтчета, "CSV") > 0 Тогда
		ФормироватьSCV = Истина;
	КонецЕсли;
	
	РасширенныйВариант = Ложь;
	Если ВариантОтчета = "СводнаяОСВ.ПоКлиенту" ИЛИ ВариантОтчета = "СводнаяОСВ.ПоКлиентуCSV" Тогда 
		СписокСчетовДУ = ПолучитьСписокСчетовДУ();	
	ИначеЕсли ВариантОтчета = "СводнаяОСВ.ПоДоговору" ИЛИ ВариантОтчета = "СводнаяОСВ.ПоДоговоруCSV" Тогда 
		СписокСчетовДУ = Новый Массив;
		СписокСчетовДУ.Добавить(НастройкиОтчета.СчетДоверительногоУправления);
		РасширенныйВариант = Истина;
	ИначеЕсли ВариантОтчета = "СводнаяОСВ.ПоВидуДоговора" ИЛИ ВариантОтчета = "СводнаяОСВ.ПоВидуДоговораCSV" Тогда    // если что надо добавить. 
		ВидДоговораСтрока = НастройкиОтчета.ВидДоговораДоверительногоУправления;
		Если Не ЗначениеЗаполнено(ВидДоговораСтрока) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не установлен вид договора");
			Возврат;
		КонецЕсли;	
		СписокСчетовДУ = ПолучитьСписокСчетовДУ(Перечисления.ВидыДоговоровДоверительногоУправления[ВидДоговораСтрока]);	
	КонецЕсли;	
	
	ДокументРезультат = Сформировать(СписокСчетовДУ, РасширенныйВариант, ФормироватьSCV);  
	Если ФормироватьSCV Тогда
		ИмяВремФайла = ПолучитьИмяВременногоФайла(".csv");
		ДокументРезультат.Записать(ИмяВремФайла, "windows-1251");
		АдресРезультатаВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВремФайла), Новый УникальныйИдентификатор());
		НастройкиОтчета.Вставить("Результат", АдресРезультатаВХранилище);
		УдалитьФайлы(ИмяВремФайла);
	Иначе
		НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	КонецЕсли;

КонецПроцедуры	

Функция ПолучитьСписокСчетовДУ(ВидыДоговоров = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Клиент = &Клиент
		|				И СчетДоверительногоУправления.Организация = &Организация
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &НачалоПериода)
		|				И &ОтборПоВидуДоговора) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	Запрос.УстановитьПараметр("НачалоПериода",	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Клиент",			ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Если ВидыДоговоров <> Неопределено Тогда 
		Запрос.УстановитьПараметр("ВидыДоговоров",	ВидыДоговоров);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВидуДоговора", "СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)");
	Иначе 	
		Запрос.УстановитьПараметр("ОтборПоВидуДоговора", Истина);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокСчетовДУ = Новый Массив;
	
	Пока Выборка.Следующий() Цикл 
		СписокСчетовДУ.Добавить(Выборка.СчетДоверительногоУправления);
	КонецЦикла;		
	 	
	Возврат СписокСчетовДУ;
	
КонецФункции

Функция ПолучитьСписокВидовДоговоровДУ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Клиент = &Клиент
		|				И СчетДоверительногоУправления.Организация = &Организация
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &НачалоПериода)) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	Запрос.УстановитьПараметр("НачалоПериода",	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Клиент",			ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокВидовДоговоровДУ = Новый Массив;
	
	Пока Выборка.Следующий() Цикл 
		СписокВидовДоговоровДУ.Добавить(Выборка.ВидДоговораДоверительногоУправления);
	КонецЦикла;		
	 	
	Возврат СписокВидовДоговоровДУ;
	
КонецФункции

Функция ПолучитьКлиентаДляСчетаДУ(СчетДУ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Клиент;
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции	

