
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);	
	
КонецПроцедуры

&НаСервере
Функция КомандаСформироватьОтчетНаСервере(СписокСчетовДУ)
	
	Результат.Очистить();
	
	ВозвращаемоеЗначение = РеквизитФормыВЗначение("Отчет").Сформировать(СписокСчетовДУ, ЭтаФорма.РасширенныйВариант, ЭтаФорма.ВФорматеCSV);
	Если НЕ ЭтаФорма.ВФорматеCSV Тогда
		Результат = ВозвращаемоеЗначение;
		Возврат Неопределено;
	Иначе
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КомандаСформироватьОтчет(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда		
		Возврат;
	КонецЕсли;
	
	СписокСчетовДУ = Новый Массив;
	Для Каждого Элемент Из ЭтаФорма.СчетаДоверительногоУправления Цикл 
		Если Элемент.Пометка Тогда 
			СписокСчетовДУ.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ВозвращаемоеЗначение = КомандаСформироватьОтчетНаСервере(СписокСчетовДУ);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат);
	
	Если ЭтаФорма.ВФорматеCSV Тогда     
		
		ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогВыбора.МножественныйВыбор = Ложь;
		ДиалогВыбора.Фильтр = "Файлы CSV (*.csv)|*.csv";
		ДиалогВыбора.Расширение = "csv";
		
		Если ДиалогВыбора.Выбрать() Тогда
			ВозвращаемоеЗначение.Записать(ДиалогВыбора.ПолноеИмяФайла);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура КлиентПриИзмененииНаСервере()
	
	ЭтотОбъект.ВидыДоговоровДУ.Очистить();
	СписокВидовДоговоровДУ = РеквизитФормыВЗначение("Отчет").ПолучитьСписокВидовДоговоровДУ();
	Для Каждого Элемент Из СписокВидовДоговоровДУ Цикл 
		ЭтотОбъект.ВидыДоговоровДУ.Добавить(Элемент, ,Истина);
	КонецЦикла;	
	
	ЭтотОбъект.СчетаДоверительногоУправления.Очистить();
	СписокСчетовДУ = РеквизитФормыВЗначение("Отчет").ПолучитьСписокСчетовДУ();
	Для Каждого Элемент из СписокСчетовДУ Цикл 	
		ЭтотОбъект.СчетаДоверительногоУправления.Добавить(Элемент,,Истина);
	КонецЦикла;	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьКлиентаДляСчетаДУНаСервере(СчетДУ)
	
	Отчет.Клиент = РеквизитФормыВЗначение("Отчет").ПолучитьКлиентаДляСчетаДУ(СчетДУ);
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда 
		КлиентПриИзмененииНаСервере();		
	КонецЕсли;	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда 
		КлиентПриИзмененииНаСервере();
	КонецЕсли;	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
КонецПроцедуры

&НаКлиенте
Процедура АвтоматическоеФормирование() Экспорт
	Перем Отказ;
	
	ЗаполнитьЗначенияСвойств(Отчет, ЭтаФорма.НастройкиОтчета);	
	//ЭтаФорма.Отчет.Период      =  ЭтаФорма.НастройкиОтчета.Период;
	
	ПолучитьКлиентаДляСчетаДУНаСервере(ЭтаФорма.НастройкиОтчета.СчетДоверительногоУправления);
	КлиентПриИзмененииНаСервере();
	
	СписокСчетовДУ = Новый Массив;	
	Для Каждого Элемент Из ЭтаФорма.СчетаДоверительногоУправления Цикл 
		Если Элемент.Пометка Тогда 
			СписокСчетовДУ.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;			
	
	КомандаСформироватьОтчетНаСервере(СписокСчетовДУ);
	РаботаСОтчетамиКлиент.АвтоматическоеФормированиеОтчета(ЭтаФорма, ЭтаФорма.Результат);

	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Отчет.Клиент) Тогда 
		КлиентПриИзмененииНаСервере();
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыДоговоровДУПриИзменении(Элемент)
	// Вставить содержимое обработчика.
	СписокВидовДоговоровДУ = Новый Массив;
	
	Для Каждого Элемент Из ЭтаФорма.ВидыДоговоровДУ Цикл 
		Если Элемент.Пометка Тогда 
			СписокВидовДоговоровДУ.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;			
	
	Для Каждого Элемент Из ЭтаФорма.СчетаДоверительногоУправления Цикл 
		Если СписокВидовДоговоровДУ.Найти(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.Значение, "ВидДоговораДоверительногоУправления")) = Неопределено Тогда 
			Элемент.Пометка = Ложь;
		Иначе 
			Элемент.Пометка = Истина;
		КонецЕсли;	
	КонецЦикла;	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";

	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ);
	КонецЕсли;
	
КонецПроцедуры
