&НаСервере
Функция ПолучитьШаблонExcelСНГ()
	Возврат РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ШаблонExcelСНГ");
КонецФункции

&НаКлиенте
Функция НайтиPD(ТаблицаPD, ЗначениеРейтинга)
	
	Если ЗначениеЗаполнено(ЗначениеРейтинга) Тогда
		Для Каждого СтрокаТаблицыPD Из ТаблицаPD Цикл
			Если СтрокаТаблицыPD.СтрокаРейтинга = ЗначениеРейтинга Тогда
				Возврат СтрокаТаблицыPD.PD/100;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат "";	
	Иначе
		Возврат "";	
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Функция НайтиКонтрагентМНОДепозит(МассивКонтрагентовМНОДепозитов, Актив)
	
	Если ЗначениеЗаполнено(Актив) Тогда
		Для Каждого СтрокаМассивКонтрагентовМНОДепозитов Из МассивКонтрагентовМНОДепозитов Цикл
			Если СтрокаМассивКонтрагентовМНОДепозитов.Актив = Актив Тогда
				Возврат СтрокаМассивКонтрагентовМНОДепозитов.Контрагент;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат "";	
	Иначе
		Возврат "";	
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Функция ПустаяСтруктураЦеннаяБумага()
	ПустаяСтруктура = Новый Структура;
	ПустаяСтруктура.Вставить("Актив", "");
	ПустаяСтруктура.Вставить("Контрагент", "");
	ПустаяСтруктура.Вставить("Договор", "");
	ПустаяСтруктура.Вставить("ЦеннаяБумага", "");
	
	Возврат ПустаяСтруктура;
КонецФункции	

&НаКлиенте
Функция НайтиКонтрагентДоговорРЕПО(МассивЦенныхБумагРЕПО, Актив)
	
	
	Если ЗначениеЗаполнено(Актив) Тогда
		Для Каждого СтрокаМассивЦенныхБумагРЕПО Из МассивЦенныхБумагРЕПО Цикл
			Если СтрокаМассивЦенныхБумагРЕПО.Актив = Актив Тогда
				Возврат СтрокаМассивЦенныхБумагРЕПО;
			КонецЕсли;	
		КонецЦикла;	
		
		Возврат ПустаяСтруктураЦеннаяБумага();
	Иначе
		Возврат ПустаяСтруктураЦеннаяБумага();
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Асинх Процедура Сформировать(Команда)
	
	xlDown = -4121;
	
	Отчет.УказательНаВременноеХранилище = Неопределено;
	
	СкомпоноватьРезультат();
	
	Если ЗначениеЗаполнено(Отчет.УказательНаВременноеХранилище) Тогда
		СтруктураВозврата = ПолучитьИзВременногоХранилища(Отчет.УказательНаВременноеХранилище);
		
		ТаблицаPD = СтруктураВозврата.ТаблицаPD;
		ТаблицаНачисленныхРезервов = СтруктураВозврата.ОсновнаяТаблица;
		МассивКонтрагентовМНОДепозитов = СтруктураВозврата.МассивКонтрагентовМНОДепозитов;
		МассивЦенныхБумагРЕПО = СтруктураВозврата.МассивЦенныхБумагРЕПО;
		
		ExcelApp =  РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
		
		Если ExcelApp <> Неопределено Тогда
			
			ИмяВременногоКаталогаШаблонаExcel = СтрЗаменить(ПолучитьИмяВременногоФайла("xlsx"), ".xlsx", "");
			
			Попытка
				ИмяВременногоКаталогаШаблонаExcel = Ждать СоздатьКаталогАсинх(ИмяВременногоКаталогаШаблонаExcel);	
			Исключение
				ИмяВременногоКаталогаШаблонаExcel = Ждать КаталогВременныхФайловАсинх();
			КонецПопытки;	
			
			
			ИмяВременногоФайлаШаблонаExcel = ИмяВременногоКаталогаШаблонаExcel + "\" + РаботаСФайламиКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СтруктураВозврата.СчетДоверительногоУправленияНаименование 
				+ "_" +  СтруктураВозврата.СчетДоверительногоУправленияНомер + "_Расшифровка резерва на " + Формат(Отчет.Период, "ДФ=dd.MM.yyyy") + ".xlsx");
			
			ШаблонExcel = ПолучитьШаблонExcelСНГ();
			
			ШаблонExcel.Записать(ИмяВременногоФайлаШаблонаExcel);
			
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыПриложения(ExcelApp, Ложь);
			РаботаСВнешнимиСистемамиКлиентСервер.ExcelУстановитьПараметрыИнтерактивностиПриложения(ExcelApp, Ложь, Ложь, Ложь, Ложь);
			
			ExcelApp.Application.Workbooks.Open(ИмяВременногоФайлаШаблонаExcel);
			
			ВысотаЗаголовка = 4;
			НомерСтрокиЗакладкаРЕПО = 2 + ВысотаЗаголовка;
			НомерСтрокиЗакладкаМНО = 2 + ВысотаЗаголовка;
			НомерСтрокиЗакладкаДолговые = 2 + ВысотаЗаголовка;
			НомерСтрокиЗакладкаПрочие = 2 + ВысотаЗаголовка;
			
			Для Каждого СтрокаТаблицаНачисленныхРезервов Из ТаблицаНачисленныхРезервов Цикл
				
				ЗначениеPD = НайтиPD(ТаблицаPD, СтрокаТаблицаНачисленныхРезервов.ЗначениеРейтинга);
				
				Если СтрокаТаблицаНачисленныхРезервов.ВидРезерва = "РЕПО" Тогда 
					// Закладка РЕПО
					
					СтруктураКонтрагента = НайтиКонтрагентДоговорРЕПО(МассивЦенныхБумагРЕПО, СтрокаТаблицаНачисленныхРезервов.Актив);
					
					xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets("РЕПО");
					
					xlSheet.Range(Формат(НомерСтрокиЗакладкаРЕПО + 1, "ЧГ=") + ":" + Формат(НомерСтрокиЗакладкаРЕПО + 1, "ЧГ=")).Insert(xlDown);
					
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 1).Value = Строка(НомерСтрокиЗакладкаРЕПО - 1 - ВысотаЗаголовка);
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 2).Value = Строка(СтрокаТаблицаНачисленныхРезервов.ВидРезерва);
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 3).Value = СтруктураКонтрагента.Контрагент;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 4).Value = СтруктураКонтрагента.Договор;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 5).Value = СтруктураКонтрагента.ЦеннаяБумага;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 6).Value = Строка(СтрокаТаблицаНачисленныхРезервов.Актив);
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 7).Value = Формат(СтрокаТаблицаНачисленныхРезервов.ДатаПогашения, "ДФ=dd.MM.yyyy");
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 8).Value = Формат(СтрокаТаблицаНачисленныхРезервов.ДнейДоПогашения, "ЧЦ=4; ЧДЦ=0; ЧН=0");
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 9).FormulaR1C1Local = СтрокаТаблицаНачисленныхРезервов.EAD;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 10).Value = Строка(СтрокаТаблицаНачисленныхРезервов.ЗначениеРейтинга);
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 11).FormulaR1C1Local = СтрокаТаблицаНачисленныхРезервов.macro;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 12).FormulaR1C1Local = ЗначениеPD;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 13).FormulaR1C1Local = СтрокаТаблицаНачисленныхРезервов.КоэффициентРезерва;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 14).FormulaR1C1Local = СтрокаТаблицаНачисленныхРезервов.LGD;
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 15).FormulaR1C1Local = "=ОКРУГЛ(RC[-6]*RC[-2]*RC[-1]*RC[-4];2)";
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 16).Value = Строка(СтрокаТаблицаНачисленныхРезервов.СтадияОбесценения);
					xlSheet.Cells(НомерСтрокиЗакладкаРЕПО, 17).Value = Строка(СтрокаТаблицаНачисленныхРезервов.АналитикаРезерва);
					
					НомерСтрокиЗакладкаРЕПО = НомерСтрокиЗакладкаРЕПО + 1;
				ИначеЕсли СтрокаТаблицаНачисленныхРезервов.ВидРезерва = "МНО" Или СтрокаТаблицаНачисленныхРезервов.ВидРезерва = "Депозиты в кредитных организациях" Тогда 	
					// Закладка депозиты и МНО
					
					xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets("Депозиты, МНО");
					
					xlSheet.Range(Формат(НомерСтрокиЗакладкаМНО + 1, "ЧГ=") + ":" + Формат(НомерСтрокиЗакладкаМНО + 1, "ЧГ=")).Insert(xlDown);
					
					xlSheet.Cells(НомерСтрокиЗакладкаМНО, 1).Value = Строка(НомерСтрокиЗакладкаМНО - 1 - ВысотаЗаголовка);
					xlSheet.Cells(НомерСтрокиЗакладкаМНО, 2).Value = Строка(СтрокаТаблицаНачисленныхРезервов.ВидРезерва);
					xlSheet.Cells(НомерСтрокиЗакладкаМНО, 3).Value = НайтиКонтрагентМНОДепозит(МассивКонтрагентовМНОДепозитов, СтрокаТаблицаНачисленныхРезервов.Актив);
					xlSheet.Cells(НомерСтрокиЗакладкаМНО, 4).Value = Строка(СтрокаТаблицаНачисленныхРезервов.Актив);
					xlSheet.Cells(НомерСтрокиЗакладкаМНО, 5).Value = Формат(СтрокаТаблицаНачисленныхРезервов.ДатаПогашения, "ДФ=dd.MM.yyyy");
