Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет по партиям",
		"0.6",
		"",
		Истина
	);
	
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
КонецФункции

Функция ПолучитьДанныеЭСП(Период, Организация, СчетаДоверительногоУправления, Клиенты, ЦенныеБумаги)

	ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ВидУчета);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия КАК Партия,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии КАК СтрокаПартии,
		|	МАКСИМУМ(РешенияКлиентовПоЗначениямЭСПСрезПоследних.ДатаНачалаДействия) КАК ДатаНачалаДействия
		|ПОМЕСТИТЬ _Решения
		|ИЗ
		|	РегистрСведений.РешенияКлиентовПоЗначениямЭСП.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
		|				И ЦеннаяБумага В (&ЦенныеБумаги)) КАК РешенияКлиентовПоЗначениямЭСПСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.ЦеннаяБумага,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.Партия,
		|	РешенияКлиентовПоЗначениямЭСПСрезПоследних.СтрокаПартии
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	ЕСТЬNULL(ВЫБОР
		|			КОГДА НЕ РешенияКлиентовПоЗначениямЭСП.Используется
		|				ТОГДА ""Не используется""
		|			ИНАЧЕ РешенияКлиентовПоЗначениямЭСП.ЭСП
		|		КОНЕЦ, 0) КАК ЭСП,
		|	(БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток + БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток) / БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК ЦенаПриобретения,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток / БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК ЦенаПриобретенияКупона,
		|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.ДатаПокупки, ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, БухПартииЦенныхБумагОстатки.Партия.Дата)) КАК ДатаПокупки,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
		|				И ЦеннаяБумага В (&ЦенныеБумаги)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|			И (ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО БухПартииЦенныхБумагОстатки.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
		|			И (РеклассификацияАктивовЕПСПартии.Ссылка.Проведен)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Решения КАК _Решения
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РешенияКлиентовПоЗначениямЭСП КАК РешенияКлиентовПоЗначениямЭСП
		|			ПО _Решения.ЦеннаяБумага = РешенияКлиентовПоЗначениямЭСП.ЦеннаяБумага
		|				И _Решения.Партия = РешенияКлиентовПоЗначениямЭСП.Партия
		|				И _Решения.СтрокаПартии = РешенияКлиентовПоЗначениямЭСП.СтрокаПартии
		|				И _Решения.ДатаНачалаДействия = РешенияКлиентовПоЗначениямЭСП.ДатаНачалаДействия
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = _Решения.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстатки.Партия = _Решения.Партия
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = _Решения.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО БухПартииЦенныхБумагОстатки.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент В(&Клиенты)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиенты", Клиенты);
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);	
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "Истина");	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(СчетаДоверительногоУправления) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетДоверительногоУправления В (&СчетаДоверительногоУправления)", "Истина");	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ЦенныеБумаги) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЦеннаяБумага В (&ЦенныеБумаги)", "Истина");	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Клиенты) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КлиентыДоверительногоУправленияСрезПоследних.Клиент В(&Клиенты)", "Истина");	
	КонецЕсли;	
	
	ДанныеЭСП = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДанныеЭСП Из ДанныеЭСП Цикл
	
		Если СтрокаДанныеЭСП.ЭСП = 0 Тогда
		
			Отказ = Ложь;
			
			СчетДоверительногоУправления = СтрокаДанныеЭСП.СчетДоверительногоУправления;
			
			НастройкиЦелиРасчета = БухгалтерскийУчетПовтИсп.ОпределитьНастройкиЦелиРасчета(Период, Организация, СчетДоверительногоУправления, ЦельРасчета);
			ВариантРасчетаОценочнойСтоимости = НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости;
			
			ПараметрыОценки = Новый Структура;
			ПараметрыОценки.Вставить("Организация",							Организация);
			ПараметрыОценки.Вставить("СчетДоверительногоУправления",		СчетДоверительногоУправления);
			ПараметрыОценки.Вставить("ВидУчета",							ВидУчета);
			ПараметрыОценки.Вставить("ВариантРасчетаСправедливойСтоимости",	ВариантРасчетаОценочнойСтоимости);
			ПараметрыОценки.Вставить("Клиент",								Кэширование.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период));
			ПараметрыОценки.Вставить("ПараметрыПолученияПартий",			РаботаСПереоценкой.ПолучитьПараметрыПолученияПартийПоМетодике(ЦельРасчета, ВидУчета, ВариантРасчетаОценочнойСтоимости, Период));
			
			ПараметрыДенежногоПотока = РаботаСПереоценкой.ПолучитьПараметрыДенежногоПотока(ПараметрыОценки, Период, СтрокаДанныеЭСП.ЦеннаяБумага, Отказ);
			
			ОшибкаРасчета = Ложь;
			
			ДенежныеПотоки = Справочники.Облигации.ПолучитьДенежныйПоток(СтрокаДанныеЭСП.ЦеннаяБумага, ПараметрыДенежногоПотока, ПараметрыОценки, ОшибкаРасчета);
			
			СтрокаДанныеЭСП.ЭСП = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
				СтрокаДанныеЭСП.ЦеннаяБумага,
				ПараметрыДенежногоПотока.ДоДатыПогашения,
				СтрокаДанныеЭСП.ДатаПокупки,
				СтрокаДанныеЭСП.ЦенаПриобретения,
				СчетДоверительногоУправления,
				ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"),
				Период,
				,
				СтрокаДанныеЭСП.ЦенаПриобретенияКупона).Доходность;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ДанныеЭСП;

КонецФункции

Функция ПолучитьДанныеСчетДЕПО(Период, Организация, СчетаДоверительногоУправления, Клиенты, ЦенныеБумаги)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиЦенныхБумагОстатки.Организация КАК Организация,
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстатки.Рынок КАК Рынок,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПРЕДСТАВЛЕНИЕ(ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет) КАК ДепозитарныйСчет,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
		|				И ЦеннаяБумага В (&ЦенныеБумаги)) КАК ОстаткиЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ОстаткиЦенныхБумагОстатки.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент В(&Клиенты)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиенты", Клиенты);
	Запрос.УстановитьПараметр("ЦенныеБумаги", ЦенныеБумаги);	
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "Истина");	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(СчетаДоверительногоУправления) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетДоверительногоУправления В (&СчетаДоверительногоУправления)", "Истина");	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ЦенныеБумаги) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЦеннаяБумага В (&ЦенныеБумаги)", "Истина");	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Клиенты) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КлиентыДоверительногоУправленияСрезПоследних.Клиент В(&Клиенты)", "Истина");	
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	РезультатПолучитьДанныеСчетДЕПО = РезультатЗапроса.СкопироватьКолонки();
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(РезультатПолучитьДанныеСчетДЕПО, "ДепозитарныйСчет", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)));
	РаботаСКоллекциями.ТаблицаЗначений_ИзменитьТипЗначенияКолонки(РезультатПолучитьДанныеСчетДЕПО, "ИНН", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255)));
	
	
	ВсеВариантыИзмерений = РезультатЗапроса.Скопировать( , "Организация, СчетДоверительногоУправления, Рынок, ЦеннаяБумага");
	
	ВсеВариантыИзмерений.Свернуть("Организация, СчетДоверительногоУправления, Рынок, ЦеннаяБумага", "");

	Для Каждого СтрокаВсеВариантыИзмерений Из ВсеВариантыИзмерений Цикл
		ОтборВсеВариантыИзмерений = Новый Структура();
		ОтборВсеВариантыИзмерений.Вставить("Организация", СтрокаВсеВариантыИзмерений.Организация);
		ОтборВсеВариантыИзмерений.Вставить("СчетДоверительногоУправления", СтрокаВсеВариантыИзмерений.СчетДоверительногоУправления);
		ОтборВсеВариантыИзмерений.Вставить("Рынок", СтрокаВсеВариантыИзмерений.Рынок);
		ОтборВсеВариантыИзмерений.Вставить("ЦеннаяБумага", СтрокаВсеВариантыИзмерений.ЦеннаяБумага);
		
		СтрокиРезультатЗапроса = РезультатЗапроса.НайтиСтроки(ОтборВсеВариантыИзмерений);
		
		НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО = РезультатПолучитьДанныеСчетДЕПО.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО, СтрокаВсеВариантыИзмерений);
		
		Для Каждого СтрокаРезультатЗапроса Из СтрокиРезультатЗапроса Цикл
			Если СтрЧислоВхождений(НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ДепозитарныйСчет, СтрокаРезультатЗапроса.ДепозитарныйСчет) = 0 Тогда
				НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ДепозитарныйСчет = ?(ЗначениеЗаполнено(НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ДепозитарныйСчет), ", ", "") + НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ДепозитарныйСчет + СтрокаРезультатЗапроса.ДепозитарныйСчет;	
			КонецЕсли;	
			
			Если СтрЧислоВхождений(НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ИНН, СтрокаРезультатЗапроса.ИНН) = 0 Тогда
				НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ИНН = ?(ЗначениеЗаполнено(НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ИНН), ", ", "") + НоваяСтрокаРезультатПолучитьДанныеСчетДЕПО.ИНН + СтрокаРезультатЗапроса.ИНН;	
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЦикла;	
	
	Возврат РезультатПолучитьДанныеСчетДЕПО;
	
КонецФункции	

Процедура УстановитьОтбор(ИмяПоляКомпановки, Значение)
	
	НовыйЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));

    ПолеОтбора = Новый ПолеКомпоновкиДанных(ИмяПоляКомпановки);

    НовыйЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
      
    НовыйЭлементОтбора.Использование = Истина;
      
    НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
      
    НовыйЭлементОтбора.ПравоеЗначение = Значение; 	
	
КонецПроцедуры	

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Период = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Период;
	Организация = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Организация;
	СчетаДоверительногоУправления = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.СчетаДоверительногоУправления;
	ВидыАктивов = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.ВидыАктивов;
	Клиенты = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Клиенты;
	ЦенныеБумаги = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.ЦенныеБумаги;
	
	Если ВидыАктивов.Количество() = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	УчетныеАктивыЕПС.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
			|ГДЕ
			|	УчетныеАктивыЕПС.Родитель В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеДляПродажи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеДляПродажи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливой))";
		ВидыАктивов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Настройки = КомпоновщикНастроек.Настройки;
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", КонецДня(Период));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", Организация);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидыАктивов", ВидыАктивов);
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	
	Если ЗначениеЗаполнено(Клиенты) Тогда
		УстановитьОтбор("Клиент", Клиенты)	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЦенныеБумаги) Тогда
		УстановитьОтбор("ЦеннаяБумага", ЦенныеБумаги)	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Организация) Тогда
		УстановитьОтбор("Организация", Организация)	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СчетаДоверительногоУправления) Тогда
		УстановитьОтбор("СчетДоверительногоУправления", СчетаДоверительногоУправления)	
	КонецЕсли;	
	
	ВнешниеНаборыДанных = Новый Структура("НаборДанных2", ПолучитьДанныеЭСП(Период, Организация, СчетаДоверительногоУправления, Клиенты, ЦенныеБумаги));
	ДополнительныеПараметры = Новый Структура("РегистрацияСтатистики, МенеджерВременныхТаблиц", Ложь, Новый МенеджерВременныхТаблиц);
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(ДополнительныеПараметры.МенеджерВременныхТаблиц,, Период);
	
	ТаблицаДепозитарныхСчетов = ПолучитьДанныеСчетДЕПО(Период, Организация, СчетаДоверительногоУправления, Клиенты, ЦенныеБумаги);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаДепозитарныхСчетов, "_ТаблицаДепозитарныхСчетов", ДополнительныеПараметры.МенеджерВременныхТаблиц, Истина, , ,"Организация, СчетДоверительногоУправления, Рынок, ЦеннаяБумага");
	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка,,,, ВнешниеНаборыДанных, ДополнительныеПараметры);
	
КонецПроцедуры
