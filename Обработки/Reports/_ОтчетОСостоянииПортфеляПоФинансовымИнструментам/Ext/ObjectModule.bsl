Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о состоянии портфеля по финансовым инструментам",
		"0.15",
		"",
		Истина);
		                                                                                             
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Подписант	= НастройкиОтчета.Подписант.КонтактноеЛицо;
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	Сформировать(ДокументРезультат);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");

	Возврат Настройки;

КонецФункции

Процедура Сформировать(ДокументРезультат)  Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,Подписант");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДокументРезультат.Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст  = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|				ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КомиссияБиржа,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|				ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КомиссияБрокера,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход) КАК СуммаПриход,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Основание
		|ПОМЕСТИТЬ _КомиссияБрокера
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			,
		|			,
		|			Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.ЦенаКотировки КАК ЦенаКотировки
		|ПОМЕСТИТЬ _СправедливыеЦены
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И ВЫРАЗИТЬ(СтоимостьПереоценки.Регистратор КАК Документ.РегистрацияСтоимостиПереоценки).ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК ISIN,
		|	БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК РегНомер,
		|	БухПартииЦенныхБумагОстаткиЕПС.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстаткиЕПС.СтрокаПартии КАК СтрокаПартии,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки ЕСТЬ NULL
		|			ТОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия.Дата
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата
		|		ИНАЧЕ ВводЦенныхБумагЦенныеБумаги.ДатаПокупки
		|	КОНЕЦ КАК ДатаПартии,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиЕПС.Партия) = ТИП(Документ.Сделка)
		|			ТОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия.НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстаткиЕПС.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиЕПС.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание.НомерСделки
		|	КОНЕЦ КАК НомерСделки,
		|	БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
		|	БухПартииЦенныхБумагОстаткиЕПС.КоличествоОстаток КАК КоличествоОстаток,
		|	БухПартииЦенныхБумагОстаткиЕПС.СтоимостьВВалютеУчетаОстаток КАК СтоимостьОстаток,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.ДисконтПремияПокупкиОстаток < 0
		|			ТОГДА БухПартииЦенныхБумагОстаткиЕПС.ДисконтПремияНачисленныйВВалютеУчетаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОстатокДисконта,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.ДисконтПремияПокупкиОстаток > 0
		|			ТОГДА БухПартииЦенныхБумагОстаткиЕПС.ДисконтПремияНачисленныйВВалютеУчетаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОстатокПремия,
		|	БухПартииЦенныхБумагОстаткиЕПС.СтоимостьКупонаВВалютеУчетаОстаток КАК НКДуплаченный,
		|	БухПартииЦенныхБумагОстаткиЕПС.ПереоценкаКупонаВВалютеУчетаОстаток КАК НКДНачисленный,
		|	БухПартииЦенныхБумагОстаткиЕПС.ПереоценкаВВалютеУчетаОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагОстаткиЕПС.КорректировкаЭСПВВалютеУчетаОстаток + БухПартииЦенныхБумагОстаткиЕПС.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК Корректировка,
		|	БухПартииЦенныхБумагОстаткиЕПС.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
		|	БухПартииЦенныхБумагОстаткиЕПС.СуммаРезервовПоСомнительнымДолгамОстаток КАК СуммаРезервовПоСомнительнымДолгам,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиНУ.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток, 0) КАК КомиссияОстаток,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.Количество
		|		ИНАЧЕ ЕСТЬNULL(СделкаЦенныеБумаги.Количество, ИсполнениеОбязательствПоСделкеЦенныеБумаги.Количество)
		|	КОНЕЦ КАК КоличествоПокупка,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.Сумма
		|		ИНАЧЕ ЕСТЬNULL(СделкаЦенныеБумаги.Сумма, ИсполнениеОбязательствПоСделкеЦенныеБумаги.Сумма)
		|	КОНЕЦ КАК СуммаПокупка,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.Сумма / ВводЦенныхБумагЦенныеБумаги.Количество
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия ССЫЛКА Документ.РеклассификацияАктивовЕПС
		|			ТОГДА (ВЫРАЗИТЬ(РеклассификацияАктивовЕПСПартии.СуммаПокупки КАК ЧИСЛО(27, 12))) / РеклассификацияАктивовЕПСПартии.Количество
		|		ИНАЧЕ ЕСТЬNULL(СделкаЦенныеБумаги.Цена, ИсполнениеОбязательствПоСделкеЦенныеБумаги.Цена)
		|	КОНЕЦ КАК ЦенаПокупка,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.Партия ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.СуммаКупона
		|		ИНАЧЕ ЕСТЬNULL(СделкаЦенныеБумаги.СуммаКупона, ИсполнениеОбязательствПоСделкеЦенныеБумаги.СуммаКупона)
		|	КОНЕЦ КАК СуммаКупонаПокупка,
		|	ЕСТЬNULL(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка.Основание, БухПартииЦенныхБумагОстаткиЕПС.Партия) КАК Основание,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиНУ.СтоимостьПокупкиОстаток, 0) КАК СтоимостьОстатокНУ,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиНУ.СтоимостьКупонаВВалютеУчетаОстаток, 0) КАК НКДУплаченныйНУ,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиНУ.ПереоценкаКупонаВВалютеУчетаОстаток, 0) КАК НКДНачисленныйНУ,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиНУ.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток, 0) КАК КомиссияОстатокНУ,
		|	БухПартииЦенныхБумагОстаткиЕПС.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценениеНУ,
		|	БухПартииЦенныхБумагОстаткиЕПС.СуммаРезервовПоСомнительнымДолгамОстаток КАК СуммаРезервовПоСомнительнымДолгамНУ,
		|	УчетныеАктивыЕПС.СчетУчета КАК СчетУчета,
		|	БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага.УчетныйАктивЦБРФ КАК ЦеннаяБумагаУчетныйАктивЦБРФ,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага КАК Справочник.Акции).Номинал
		|	КОНЕЦ КАК Номинал,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага КАК Справочник.Облигации).ДатаПогашения
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК ДатаПогашения,
		|	БухПартииЦенныхБумагОстаткиЕПС.ИндексацияНоминалаОстаток КАК ИндексацияНоминала,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстаткиНУ.ИндексацияНоминалаОстаток, 0) КАК ИндексацияНоминалаНУ
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ОтчетнаяДата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстаткиЕПС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|			И (КодыВТорговыхСистемахСрезПоследних.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстаткиЕПС.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстаткиЕПС.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&ОтчетнаяДата,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)) КАК БухПартииЦенныхБумагОстаткиНУ
		|		ПО БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага = БухПартииЦенныхБумагОстаткиНУ.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстаткиЕПС.Партия = БухПартииЦенныхБумагОстаткиНУ.Партия
		|			И БухПартииЦенныхБумагОстаткиЕПС.СтрокаПартии = БухПартииЦенныхБумагОстаткиНУ.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага = ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстаткиЕПС.Партия = ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстаткиЕПС.СтрокаПартии = ИсполнениеОбязательствПоСделкеЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстаткиЕПС.ЦеннаяБумага = СделкаЦенныеБумаги.ЦеннаяБумага
		|			И БухПартииЦенныхБумагОстаткиЕПС.Партия = СделкаЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстаткиЕПС.СтрокаПартии = СделкаЦенныеБумаги.СтрокаПартии
