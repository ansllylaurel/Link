Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Расчетные денежные потоки по НКД",
		"0.03",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, Неопределено);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	
	Параметры = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	
	ЗначениеОблигация = Неопределено;
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Облигация");
	Если Параметр <> Неопределено  Тогда
		Элемент = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Параметр.ИдентификаторПользовательскойНастройки);
		Если Элемент <> Неопределено И Элемент.Использование Тогда
			ЗначениеОблигация = Элемент.Значение;
		КонецЕсли;
	КонецЕсли;	
	
	МассивТиповСтавкаФормулаРасчетаСтавки = Новый Массив;
	МассивТиповСтавкаФормулаРасчетаСтавки.Добавить(Тип("Число"));
	МассивТиповСтавкаФормулаРасчетаСтавки.Добавить(Тип("СправочникСсылка.НастройкиРасчета"));

	_ТаблицаРасчетныхДенежныхПотоковПоНКД = Новый ТаблицаЗначений;
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("НомерКупона", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0)));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("ДатаОкончанияКупона", Новый ОписаниеТипов("Дата"));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("Срок", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 0)));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("ДатаФиксации", Новый ОписаниеТипов("Дата"));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("ДатаПубликации", Новый ОписаниеТипов("Дата"));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("СтавкаФормулаРасчетаСтавки", Новый ОписаниеТипов(МассивТиповСтавкаФормулаРасчетаСтавки));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("СуммаНКД", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	_ТаблицаРасчетныхДенежныхПотоковПоНКД.Колонки.Добавить("ВалютаОплаты", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КупонныйДоходПоОблигациям.НомерКупона КАК НомерКупона,
		|	КупонныйДоходПоОблигациям.Период КАК Период,
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупона,
		|	КупонныйДоходПоОблигациям.ДатаФиксации КАК ДатаФиксации,
		|	КупонныйДоходПоОблигациям.ДатаПубликации КАК ДатаПубликации,
		|	КупонныйДоходПоОблигациям.ФормулаРасчетаСтавки КАК ФормулаРасчетаСтавки,
		|	КупонныйДоходПоОблигациям.ВалютаОплаты КАК ВалютаОплаты,
		|	КупонныйДоходПоОблигациям.Срок КАК Срок,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК СтавкаКупона
		|ИЗ
		|	РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|ГДЕ
		|	КупонныйДоходПоОблигациям.Облигация = &Облигация";
	
	Запрос.УстановитьПараметр("Облигация", ЗначениеОблигация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока_ТаблицаРасчетныхДенежныхПотоковПоНКД = _ТаблицаРасчетныхДенежныхПотоковПоНКД.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока_ТаблицаРасчетныхДенежныхПотоковПоНКД, ВыборкаДетальныеЗаписи);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ФормулаРасчетаСтавки) Тогда
			НоваяСтрока_ТаблицаРасчетныхДенежныхПотоковПоНКД.СтавкаФормулаРасчетаСтавки = ВыборкаДетальныеЗаписи.ФормулаРасчетаСтавки;
		Иначе
			НоваяСтрока_ТаблицаРасчетныхДенежныхПотоковПоНКД.СтавкаФормулаРасчетаСтавки = ВыборкаДетальныеЗаписи.СтавкаКупона;
		КонецЕсли;
		
		НоваяСтрока_ТаблицаРасчетныхДенежныхПотоковПоНКД.СуммаНКД = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ЗначениеОблигация, ВыборкаДетальныеЗаписи.ДатаОкончанияКупона, Справочники.СчетаДоверительногоУправления.ПустаяСсылка(), , 2, Неопределено, Истина);
		
	КонецЦикла;

	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("_ТаблицаРасчетныхДенежныхПотоковПоНКД", _ТаблицаРасчетныхДенежныхПотоковПоНКД);
	
	ДополнительныеПараметры = Новый Структура("РегистрацияСтатистики", Ложь);
	
	// Выполняем программную компоновку
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка, , , , ВнешниеНаборыДанных, ДополнительныеПараметры);		
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры
