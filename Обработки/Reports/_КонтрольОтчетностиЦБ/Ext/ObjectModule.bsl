Функция КонтрольПоследовательностиОтчетов(ДанныеТекущие, ДанныеПредыдущие)
	
	Отказ = Ложь;
	
	Если НЕ ДанныеТекущие.Количество() ИЛИ НЕ ДанныеПредыдущие.Количество() Тогда
		Возврат Истина; //Один из отчётов нулевой, нечего проверять
	КонецЕсли;
	
	Если ДанныеТекущие[0].ДатаНачала <> ДанныеПредыдущие[0].ДатаОкончания
		И ДанныеТекущие[0].ДатаНачала <> ДанныеПредыдущие[0].ДатаОкончания + 86400 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(
				"Отчёты не являются последовательными. Дата окончания предыдущего отчёта %1 не равна дате начала текущего отчёта %2", 
				Формат(ДанныеПредыдущие[0].ДатаОкончания, "ДФ=dd.MM.yy"),
				Формат(ДанныеТекущие[0].ДатаНачала, "ДФ=dd.MM.yy")),,,, Отказ);
	КонецЕсли;
			
	Возврат НЕ Отказ;		
	
КонецФункции

Функция ПолучитьТаблицуИзМакета(ИмяМакета, ВерсияТаксономии, ПараметрыПоиска = Неопределено, Сортировка = Неопределено, Отказ = Ложь)
	
	Таблица = Новый ТаблицаЗначений;
	Макет	= ПолучитьМакет(ИмяМакета);
	
	КолонкиМакета = Новый Соответствие;
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ПараметрыКолонки = СтрРазделить(СокрЛП(Макет.Область(1, НомерКолонки, 1, НомерКолонки).Текст), "()", Ложь);
		
		КолонкиМакета.Вставить(ПараметрыКолонки[0], НомерКолонки);
		Если ПараметрыКолонки.Количество() = 1 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов("Строка"));
		ИначеЕсли ПараметрыКолонки.Количество() = 2 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1]));
		ИначеЕсли ПараметрыКолонки.Количество() = 3 И ПараметрыКолонки[1] = "Строка" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1], Новый КвалификаторыСтроки(ПараметрыКолонки[2])));	
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НомерКолонки = КолонкиМакета.Получить("ТаксономияС");
		Если НомерКолонки <> Неопределено Тогда
			ВерсияТаксономииС	= СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
			Если ЗначениеЗаполнено(ВерсияТаксономииС) И ВерсияТаксономииС > ВерсияТаксономии Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НомерКолонки = КолонкиМакета.Получить("ТаксономияПо");
		Если НомерКолонки <> Неопределено Тогда
			ВерсияТаксономииПо	= СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
			Если ЗначениеЗаполнено(ВерсияТаксономииПо) И ВерсияТаксономииПо < ВерсияТаксономии Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КолонкаМакета Из КолонкиМакета Цикл
			Значение = СокрЛП(Макет.Область(НомерСтроки, КолонкаМакета.Значение, НомерСтроки, КолонкаМакета.Значение).Текст);
			
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ])) Тогда
				Если ЗначениеЗаполнено(Значение) Тогда
					Если СтрЧислоВхождений(Значение, "-") = 4 Тогда
						Попытка 
							УникальныйИдентификатор = Новый УникальныйИдентификатор(Значение);
							НоваяСтрока[КолонкаМакета.Ключ]	= ОбщегоНазначения.МенеджерОбъектаПоСсылке(НоваяСтрока[КолонкаМакета.Ключ]).ПолучитьСсылку(УникальныйИдентификатор);
						Исключение
							НоваяСтрока[КолонкаМакета.Ключ] = ОбщегоНазначения.ПолучитьИменованныйОбъект(Значение);
						КонецПопытки;
					Иначе
						НоваяСтрока[КолонкаМакета.Ключ] = ОбщегоНазначения.ПолучитьИменованныйОбъект(Значение);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Тип") Тогда
				Если ЗначениеЗаполнено(Значение) Тогда // на 23 платформе возникает ошибка если передается пустая строка
					НоваяСтрока[КолонкаМакета.Ключ]	= Тип(Значение);
				КонецЕсли;	
			Иначе
				НоваяСтрока[КолонкаМакета.Ключ]	= Значение;
			КонецЕсли;
				
			Если ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Строка") И НоваяСтрока[КолонкаМакета.Ключ] <> Значение Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неверно указана ширина колонки %1 в макете %2, не поместилось значение %3, обратитесь к программисту.", КолонкаМакета.Ключ, ИмяМакета, Значение),,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Если ТипЗнч(ПараметрыПоиска) = Тип("Структура") Тогда
		Результат = Таблица.Скопировать(ПараметрыПоиска);
	Иначе
		Результат = Таблица;
	КонецЕсли;
	
	Если Сортировка <> Неопределено Тогда
		Результат.Сортировать(Сортировка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТаблицуИзИсточникаПоПравилам(Данные, ДанныеXDTO, ИмяПравила, ВерсияТаксономии = "")
	
	ВерсияТаксономии = ПолучитьВерсиюТаксономииИзXDTO(ДанныеXDTO);	
	
	ПравилаИмпортаДанныхИзФайла = ПолучитьТаблицуИзМакета("ПравилаИмпортаДанныхИзФайла", ВерсияТаксономии, Новый Структура("ИмяПравила", ИмяПравила));
	БиблиотекаЗначений	= БиблиотекаСтандартныхЗначений();
	
	ГруппыПравил = Новый Соответствие;
	Для Каждого Правило Из ПравилаИмпортаДанныхИзФайла Цикл
		Если ГруппыПравил.Получить(Правило.ТаблицаИсточник + Правило.НомерПравила) = Неопределено Тогда
			ГруппыПравил.Вставить(Правило.ТаблицаИсточник + Правило.НомерПравила, Новый Структура("ТаблицаИсточник, НомерПравила", Правило.ТаблицаИсточник, Правило.НомерПравила));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ГруппаПравил Из ГруппыПравил Цикл 
		Если НЕ ДанныеXDTO.Свойства().Получить(ГруппаПравил.Значение.ТаблицаИсточник) = Неопределено Тогда
			Для Каждого СтрокаДанныхXDTO Из ПолучитьМассивСтрокXDTO(ДанныеXDTO, ГруппаПравил.Значение.ТаблицаИсточник) Цикл
				
				НайденныеСтроки = ПравилаИмпортаДанныхИзФайла.НайтиСтроки(ГруппаПравил.Значение);
				ПервоеПравило 	= НайденныеСтроки[0];
				ПолучитьДанные	= Ложь;
				
				Если ПустаяСтрока(ПервоеПравило.ПолеОтбора) Тогда
					ПолучитьДанные = Истина;
				ИначеЕсли ПустаяСтрока(ПервоеПравило.ЗначениеОтбора) Тогда
					ПолучитьДанные = ЗначениеЗаполнено(ПолучитьЗначениеСвойства(СтрокаДанныхXDTO, ПервоеПравило.ПолеОтбора));
				Иначе
					ПолучитьДанные = (ПолучитьЗначениеСвойства(СтрокаДанныхXDTO, ПервоеПравило.ПолеОтбора) = ПервоеПравило.ЗначениеОтбора);
				КонецЕсли;
				
				Если ПолучитьДанные Тогда
					СтрокаДанных = Данные.Добавить();
					
					Для Каждого Правило Из НайденныеСтроки Цикл
						
						Если ЗначениеЗаполнено(Правило.ФиксированноеЗначение) Тогда
							СтрокаДанных[Правило.ПолеПриемник] = Вычислить(Правило.ФиксированноеЗначение);
						Иначе
							Если Правило.Тип = "БиблиотекаЗначений" Тогда
								Тип = БиблиотекаЗначений;
							ИначеЕсли ЗначениеЗаполнено(Правило.Тип) Тогда
								Тип = Тип(Правило.Тип);
							Иначе 
								Тип = Неопределено;
							КонецЕсли;
							
							МассивПолейИсточника = СтрРазделить(Правило.ПолеИсточник, ",");
							Для Каждого ПолеИсточник Из МассивПолейИсточника Цикл
								Если ЗначениеЗаполнено(СтрокаДанных[Правило.ПолеПриемник]) Тогда
									СтрокаДанных[Правило.ПолеПриемник] = СтрокаДанных[Правило.ПолеПриемник] + ПолучитьЗначениеСвойства(СтрокаДанныхXDTO, ПолеИсточник, Тип);
								Иначе
									СтрокаДанных[Правило.ПолеПриемник] = ПолучитьЗначениеСвойства(СтрокаДанныхXDTO, ПолеИсточник, Тип);
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						
					КонецЦикла;
					
					Если Данные.Колонки.Найти("ДатаНачала") <> Неопределено Тогда
						СтрокаДанных.ДатаНачала		= XMLЗначение(Тип("Дата"), СтрокаДанныхXDTO.Date_From);
						СтрокаДанных.ДатаОкончания	= XMLЗначение(Тип("Дата"), СтрокаДанныхXDTO.Date_To);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВерсиюТаксономииИзXDTO(ДанныеXDTO)
	
	ВерсияТаксономии = "";
	
	Если ДанныеXDTO.Свойства().Получить("Taxonomy") <> Неопределено Тогда
		ВерсияТаксономии = СтрЗаменить(ДанныеXDTO.Taxonomy, ".", "_");
	Иначе
		ОтчетнаяДата = "";
		
		Для Каждого Свойство Из ДанныеXDTO.Свойства() Цикл
			Если НЕ ЗначениеЗаполнено(ОтчетнаяДата) И ТипЗнч(ДанныеXDTO[Свойство.Имя]) = Тип("ОбъектXDTO") Тогда
				Для Каждого Свойство1 Из ДанныеXDTO[Свойство.Имя].Свойства() Цикл
					Если НЕ ЗначениеЗаполнено(ОтчетнаяДата) И ТипЗнч(ДанныеXDTO[Свойство.Имя][Свойство1.Имя]) = Тип("СписокXDTO") Тогда
						СтрокаДанныхXDTO = ДанныеXDTO[Свойство.Имя][Свойство1.Имя][0];
						Если СтрокаДанныхXDTO.Свойства().Получить("Date_To") <> Неопределено Тогда
							ОтчетнаяДата = XMLЗначение(Тип("Дата"), СтрокаДанныхXDTO.Date_To);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(ОтчетнаяДата) Тогда
			Если ОтчетнаяДата > Дата(2023, 4, 1) Тогда
				ВерсияТаксономии = "5_2";
			ИначеЕсли ОтчетнаяДата > Дата(2021, 10, 1) Тогда
				ВерсияТаксономии = "4_2";
			ИначеЕсли ОтчетнаяДата > Дата(2021, 4, 1) Тогда
				ВерсияТаксономии = "3_2";
			ИначеЕсли ОтчетнаяДата > Дата(2019, 9, 1) Тогда
				ВерсияТаксономии = "3_1";
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВерсияТаксономии;
	
КонецФункции

Функция ВДанныхЕстьОшибки(Запрос, ИмяТаблицыКонтроля, Отказ, Данные = Неопределено)
	
	Таблица_Контроля = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицыКонтроля).ПолучитьДанные().Выгрузить();
	
	Если Таблица_Контроля.Количество() > 0 Тогда
		Для Каждого Строка_Контроля Из Таблица_Контроля Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СформироватьСтрокуПоШаблону(Строка_Контроля, Строка_Контроля.ТекстОшибки),,,, Отказ);
		КонецЦикла;
		
		Если Данные <> Неопределено Тогда
			Данные.Очистить();
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции	

Функция СформироватьСтрокуПоШаблону(СтрокаДанных, Шаблон)
	
	ПараметрыСообщения = Новый Структура;
	Для Каждого Колонка Из СтрокаДанных.Владелец().Колонки Цикл
		Если Колонка.Имя = "ШаблонСообщения" Тогда
			ШаблонСообщения = СтрокаДанных[Колонка.Имя];
		ИначеЕсли Колонка.Имя = "Отказ" Тогда
			ВызватьОтказ = СтрокаДанных[Колонка.Имя];
		ИначеЕсли ТипЗнч(СтрокаДанных[Колонка.Имя]) = Тип("Дата") Тогда
			ПараметрыСообщения.Вставить(Колонка.Имя, Формат(СтрокаДанных[Колонка.Имя], "ДФ=dd.MM.yyyy; ДП=отсутствует"));	
		Иначе
			ПараметрыСообщения.Вставить(Колонка.Имя, СтрокаДанных[Колонка.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыСообщения);
	
КонецФункции

