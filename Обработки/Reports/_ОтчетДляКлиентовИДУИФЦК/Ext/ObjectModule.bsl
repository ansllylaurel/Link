			//ТаблицаОтчета.ВерхнийКолонтитул.ТекстСправа = ТекстСправа;
			//
			
			ТаблицаОтчета.ДвусторонняяПечать = ТипДвустороннейПечати.Нет;
			
			ТаблицаОтчета.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			ТаблицаОтчета.РазмерКолонтитулаСверху = 15; 
			ТаблицаОтчета.ПолеСверху = 15; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры 

Процедура ВывестиПервуюСтраницу(МакетОтчета, ТаблицаОтчета)
	
	Область = МакетОтчета.ПолучитьОбласть("ПерваяСтраница");
	Область.Параметры.ФИО = ЭтотОбъект.СчетДУ.Наименование;
	Область.Параметры.НомерДоговора = ЭтотОбъект.СчетДУ.НомерДоговора; 
	Область.Параметры.ДатаДоговора = Формат(ЭтотОбъект.СчетДУ.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	Область.Параметры.ДатаНачала = Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy");
	Область.Параметры.ДатаОкончания = Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		
	ТаблицаОтчета.Вывести(Область); 
	
	ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
	
КонецПроцедуры

Процедура ВывестиДисклеймер(МакетОтчета, ТаблицаОтчета)
	
	Область = МакетОтчета.ПолучитьОбласть("СтраницаДислеймер");
		
	ТаблицаОтчета.Вывести(Область); 
	
КонецПроцедуры

Процедура ВывестиСтраницуСГрафиками(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям, ВалютаИнвестиционногоПрофиля)
	
	Область = МакетОтчета.ПолучитьОбласть("СтраницаСГрафиками");
	Область.Параметры.ФИО = ЭтотОбъект.СчетДУ.Наименование;
	Область.Параметры.НомерДоговора = ЭтотОбъект.СчетДУ.НомерДоговора; 
	Область.Параметры.ДатаДоговора = Формат(ЭтотОбъект.СчетДУ.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	Область.Параметры.ДатаНачала = Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy");
	Область.Параметры.ДатаОкончания = Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	Область.Параметры.ВалютаДоговора = ВалютаИнвестиционногоПрофиля;	
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|				ТОГДА ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость
		|			ИНАЧЕ -ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость
		|		КОНЕЦ) КАК РыночнаяСтоимость
		|ИЗ
		|	_ВводыВыводыАктивов КАК ВводыВыводыАктивовВВалютеУчета
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(ВЫБОР
		|				КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|					ТОГДА ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость
		|				ИНАЧЕ -ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость
		|			КОНЕЦ) ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СальдоВводовВыводов = 0;
	Пока Выборка.Следующий() Цикл
		СальдоВводовВыводов = Выборка.РыночнаяСтоимость;	
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК ТекущаяСтоимость
		|ИЗ
		|	_СуммыДляИтогов КАК _СуммыДляИтогов
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(_СуммыДляИтогов.ТекущаяСтоимость) ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	-СУММА(_КредиторскаяЗадолженность.СуммаОстаток)
		|ИЗ
		|	_КредиторскаяЗадолженность КАК _КредиторскаяЗадолженность
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(_КредиторскаяЗадолженность.СуммаОстаток) ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтоимостьПортфеля = 0;
	Пока Выборка.Следующий() Цикл
		СтоимостьПортфеля = СтоимостьПортфеля + Выборка.ТекущаяСтоимость;	
	КонецЦикла;
	
	Область.Параметры.СальдоВводовВыводов = СальдоВводовВыводов;	
	Область.Параметры.СтоимостьПортфеля = СтоимостьПортфеля;	
	Область.Параметры.ДоходЗаОтчетныйПериод = СтоимостьПортфеля - СальдоВводовВыводов;	
	
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаОкончания КАК ОкончаниеПериода
		|ПОМЕСТИТЬ _ПериодыРасчетаДоходностиПредварительно
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПервыйВводАктивов.Период КАК НачалоПериода,
		|	_ПериодыРасчетаДоходности.ОкончаниеПериода КАК ОкончаниеПериода
		|ПОМЕСТИТЬ _ПериодыРасчетаДоходности
		|ИЗ
		|	_ПериодыРасчетаДоходностиПредварительно КАК _ПериодыРасчетаДоходности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПервыйВводАктивов КАК _ПервыйВводАктивов
		|		ПО (ИСТИНА)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПервыйВводАктивов.Период,
		|	_ПериодыРасчетаДоходности.ОкончаниеПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыРасчетаДоходности.НачалоПериода КАК НачалоПериода,
		|	_ПериодыРасчетаДоходности.ОкончаниеПериода КАК ОкончаниеПериода,
		|	СУММА(ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость * ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|				ТОГДА 1
		|			ИНАЧЕ -1
		|		КОНЕЦ / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2))) КАК СальдоВВ,
		|	СУММА(ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость * ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|				ТОГДА 1
		|			ИНАЧЕ -1
		|		КОНЕЦ / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2)) * (РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ), _ПериодыРасчетаДоходности.ОкончаниеПериода, ДЕНЬ) + 1)) КАК СредневзвешеннаяВДУ
		|ПОМЕСТИТЬ _ПериодыСВВ
		|ИЗ
		|	_ПериодыРасчетаДоходности КАК _ПериодыРасчетаДоходности
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|		ПО (ВводыВыводыАктивовВВалютеУчета.Организация = &Организация)
		|			И (ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (ВводыВыводыАктивовВВалютеУчета.Период <= КОНЕЦПЕРИОДА(_ПериодыРасчетаДоходности.ОкончаниеПериода, ДЕНЬ))
		|			И (ВводыВыводыАктивовВВалютеУчета.Период >= НАЧАЛОПЕРИОДА(_ПериодыРасчетаДоходности.НачалоПериода, ДЕНЬ))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
		|			ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
		|				И (НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПериодыРасчетаДоходности.НачалоПериода,
		|	_ПериодыРасчетаДоходности.ОкончаниеПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыСВВ.НачалоПериода КАК НачалоПериода,
		|	_ПериодыСВВ.ОкончаниеПериода КАК ОкончаниеПериода,
		|	_ПериодыСВВ.СальдоВВ КАК СальдоВВ,
		|	_ПериодыСВВ.СредневзвешеннаяВДУ / 365 КАК СредневзвешеннаяВДУ,
		|	ВЫРАЗИТЬ(ФинансовыеПоказателиНачало.Значение / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляНачало.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляНачало.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК АктивыНачало,
		|	ВЫРАЗИТЬ(ФинансовыеПоказателиОкончание.Значение / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляОкончание.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляОкончание.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК АктивыКонец
		|ПОМЕСТИТЬ _ПериодыСВВиАктивами
		|ИЗ
		|	_ПериодыСВВ КАК _ПериодыСВВ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиНачало
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиляНачало
		|				ПО (КурсВалютыИнвестиционногоПрофиляНачало.Валюта = &ВалютаИнвестиционногоПрофиля)
		|					И (НАЧАЛОПЕРИОДА(ФинансовыеПоказателиНачало.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиляНачало.Период, ДЕНЬ))
		|		ПО _ПериодыСВВ.НачалоПериода = ФинансовыеПоказателиНачало.Период
		|			И (ФинансовыеПоказателиНачало.Организация = &Организация)
		|			И (ФинансовыеПоказателиНачало.СубъектАналитики = &СчетДоверительногоУправления)
		|			И (ФинансовыеПоказателиНачало.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиОкончание
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиляОкончание
		|				ПО (КурсВалютыИнвестиционногоПрофиляОкончание.Валюта = &ВалютаИнвестиционногоПрофиля)
		|					И (НАЧАЛОПЕРИОДА(ФинансовыеПоказателиОкончание.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиляОкончание.Период, ДЕНЬ))
		|		ПО _ПериодыСВВ.ОкончаниеПериода = ФинансовыеПоказателиОкончание.Период
		|			И (ФинансовыеПоказателиОкончание.Организация = &Организация)
		|			И (ФинансовыеПоказателиОкончание.СубъектАналитики = &СчетДоверительногоУправления)
		|			И (ФинансовыеПоказателиОкончание.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ((_ПериодыСВВиАктивами.АктивыКонец - ЕСТЬNULL(_ПериодыСВВиАктивами.СальдоВВ, 0)) / _ПериодыСВВиАктивами.СредневзвешеннаяВДУ * 100 КАК ЧИСЛО(15, 2)) КАК Доходность
		|ИЗ
		|	_ПериодыСВВиАктивами КАК _ПериодыСВВиАктивами";
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Область.Параметры.ДоходностьЗаОтчетныйПериодГодовых = Выборка.Доходность;	
	КонецЦикла;
	
	ОтобразитьДиаграммуСоставПортфеля(Область, МенеджерВременныхТаблицПоПартям);
	ОтобразитьГрафикДоходностей(Область, МенеджерВременныхТаблицПоПартям, ВалютаИнвестиционногоПрофиля);
	ОтобразитьТаблицуДоходностиПоПериодам(Область, МакетОтчета, ВалютаИнвестиционногоПрофиля);
	
	ТаблицаОтчета.Вывести(Область);
	
КонецПроцедуры

Процедура ОтобразитьДиаграммуРаспределениеПоСтранам(Область, МенеджерВременныхТаблицПоПартям)
	
    Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_СуммыДляИтогов.Страна КАК Регион,
	               |	СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаВВалютеУчета
	               |ИЗ
	               |	_СуммыДляИтогов КАК _СуммыДляИтогов
	               |ГДЕ
	               |	_СуммыДляИтогов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_СуммыДляИтогов.Страна
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СуммаВВалютеУчета УБЫВ
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
    Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Диаграмма=Область.Рисунки.D1.Объект;    
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	
	ТекущаяТочка = Диаграмма.УстановитьТочку("Регион: ");
	Пока Выборка.Следующий() Цикл
		ТекущаяСерия = Диаграмма.Серии.Добавить();
		ТекущаяСерия.Текст = Выборка.Регион;		
		Диаграмма.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Выборка.СуммаВВалютеУчета);
	КонецЦикла;
	
	Диаграмма.Обновление = Истина;
	
КонецПроцедуры

Процедура ОтобразитьДиаграммуРаспределениеПоДюрации(Область, МенеджерВременныхТаблицПоПартям)
	
    Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаВВалютеУчета
	               |ПОМЕСТИТЬ _ВсегоОблигацииДляДюрации
	               |ИЗ
	               |	_СуммыДляИтогов КАК _СуммыДляИтогов
	               |ГДЕ
	               |	_СуммыДляИтогов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_СуммыДляИтогов.ТекущаяСтоимость КАК ТекущаяСтоимость,
	               |	_СуммыДляИтогов.ДнейДоПогашенияОферты КАК ДнейДоПогашенияОферты,
	               |	(ВЫРАЗИТЬ(_СуммыДляИтогов.ДнейДоПогашенияОферты КАК ЧИСЛО(27, 12))) / 0.5 КАК Множитель,
	               |	ВЫРАЗИТЬ((ВЫРАЗИТЬ(_СуммыДляИтогов.ДнейДоПогашенияОферты КАК ЧИСЛО(27, 12))) / 0.5 - 0.5 КАК ЧИСЛО(15, 0)) КАК ЦелыйМножитель
	               |ПОМЕСТИТЬ _РасчетДнейДоПогашенияОфертыПромежуточныйИтог
	               |ИЗ
	               |	_СуммыДляИтогов КАК _СуммыДляИтогов
	               |ГДЕ
	               |	_СуммыДляИтогов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СУММА(ЕСТЬNULL(ВЫБОР
	               |				КОГДА _ВсегоОблигацииДляДюрации.СуммаВВалютеУчета > 0
	               |					ТОГДА _РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ТекущаяСтоимость / _ВсегоОблигацииДляДюрации.СуммаВВалютеУчета * 100
	               |				ИНАЧЕ 0
	               |			КОНЕЦ, 0)) КАК СуммаВВалютеУчета,
	               |	ВЫБОР
	               |		КОГДА _РасчетДнейДоПогашенияОфертыПромежуточныйИтог.Множитель = _РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ЦелыйМножитель
	               |			ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ(_РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ДнейДоПогашенияОферты КАК ЧИСЛО(27, 12))) - 0.5 КАК ЧИСЛО(15, 0))
	               |		ИНАЧЕ ВЫРАЗИТЬ(_РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ЦелыйМножитель * 0.5 КАК ЧИСЛО(15, 0))
	               |	КОНЕЦ КАК ДнейДоПогашенияОфертыДляТаблицы
	               |ИЗ
	               |	_РасчетДнейДоПогашенияОфертыПромежуточныйИтог КАК _РасчетДнейДоПогашенияОфертыПромежуточныйИтог,
	               |	_ВсегоОблигацииДляДюрации КАК _ВсегоОблигацииДляДюрации
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА _РасчетДнейДоПогашенияОфертыПромежуточныйИтог.Множитель = _РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ЦелыйМножитель
	               |			ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ(_РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ДнейДоПогашенияОферты КАК ЧИСЛО(27, 12))) - 0.5 КАК ЧИСЛО(15, 0))
	               |		ИНАЧЕ ВЫРАЗИТЬ(_РасчетДнейДоПогашенияОфертыПромежуточныйИтог.ЦелыйМножитель * 0.5 КАК ЧИСЛО(15, 0))
	               |	КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДнейДоПогашенияОфертыДляТаблицы
	               |АВТОУПОРЯДОЧИВАНИЕ";
	
    Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Диаграмма=Область.Рисунки.D3.Объект;    
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	
	ТекущаяСерия = Диаграмма.Серии.Добавить(" ");
	
	МаксимальноеЗначениеДиаграммы = 0;

	Пока Выборка.Следующий() Цикл
		ТекущаяТочка = Диаграмма.УстановитьТочку(Выборка.ДнейДоПогашенияОфертыДляТаблицы);
		ТекущаяТочка.Текст = ?(Выборка.ДнейДоПогашенияОфертыДляТаблицы = 0, "<0.5", Формат(Выборка.ДнейДоПогашенияОфертыДляТаблицы, "ЧЦ=2; ЧДЦ=0"));
		Диаграмма.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Выборка.СуммаВВалютеУчета);
		
		Если Выборка.СуммаВВалютеУчета > МаксимальноеЗначениеДиаграммы Тогда
			МаксимальноеЗначениеДиаграммы = Выборка.СуммаВВалютеУчета;	
		КонецЕсли;	
	КонецЦикла;
	
	МаксимальноеЗначениеДиаграммы = Макс(МаксимальноеЗначениеДиаграммы * 1.1, МаксимальноеЗначениеДиаграммы + 7);
	
	Диаграмма.ОсьЗначений.МаксимальноеЗначение = МаксимальноеЗначениеДиаграммы;
	
	Диаграмма.Обновление = Истина;
	
КонецПроцедуры

Процедура ОтобразитьДиаграммуСоставПортфеля(Область, МенеджерВременныхТаблицПоПартям)
	
    Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	_СуммыДляИтогов.Рынок КАК Рынок,
	               |	СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаВВалютеУчета
	               |ИЗ
	               |	_СуммыДляИтогов КАК _СуммыДляИтогов
	               |ГДЕ
	               |	НЕ _СуммыДляИтогов.Рынок ЕСТЬ NULL
	               |	И _СуммыДляИтогов.Рынок <> НЕОПРЕДЕЛЕНО
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_СуммыДляИтогов.Рынок
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СуммаВВалютеУчета УБЫВ";
	
    Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Диаграмма = Область.Рисунки.D3.Объект;    
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	
	ТекущаяТочка = Диаграмма.УстановитьТочку("Инструмент: ");
	Пока Выборка.Следующий() Цикл
		ТекущаяСерия = Диаграмма.Серии.Добавить();
		ТекущаяСерия.Текст = Выборка.Рынок;		
		Диаграмма.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Выборка.СуммаВВалютеУчета);
	КонецЦикла;
	
	Диаграмма.Обновление = Истина;
	
КонецПроцедуры

Процедура ОтобразитьДиаграммуРаспределениеПоСекторам(Область, МенеджерВременныхТаблицПоПартям)
	
    Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_СуммыДляИтогов.Отрасль КАК Отрасль,
	               |	СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаВВалютеУчета
	               |ИЗ
	               |	_СуммыДляИтогов КАК _СуммыДляИтогов
	               |ГДЕ
	               |	НЕ _СуммыДляИтогов.Отрасль ЕСТЬ NULL
	               |	И _СуммыДляИтогов.Отрасль <> ЗНАЧЕНИЕ(Справочник.Отрасли.ПустаяСсылка)
	               |	И _СуммыДляИтогов.Отрасль <> НЕОПРЕДЕЛЕНО
	               |	И _СуммыДляИтогов.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_СуммыДляИтогов.Отрасль
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СуммаВВалютеУчета УБЫВ";
	
    Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Диаграмма = Область.Рисунки.D2.Объект;    
	Диаграмма.Обновление = Ложь;
	Диаграмма.Очистить();
	
	ТекущаяТочка = Диаграмма.УстановитьТочку("Отрасль: ");
	Пока Выборка.Следующий() Цикл
		ТекущаяСерия = Диаграмма.Серии.Добавить();
		ТекущаяСерия.Текст = Выборка.Отрасль;		
		Диаграмма.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Выборка.СуммаВВалютеУчета);
	КонецЦикла;
	
	Диаграмма.Обновление = Истина;
	
КонецПроцедуры

Процедура ОтобразитьГрафикДоходностей(Область, МенеджерВременныхТаблицПоПартям, ВалютаИнвестиционногоПрофиля)
	
    Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ФинансовыеПоказатели.Период КАК Период,
	               |	ВЫРАЗИТЬ(ФинансовыеПоказатели.Значение / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК Значение
	               |ПОМЕСТИТЬ _всеСЧА
	               |ИЗ
	               |	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПервыйВводАктивов КАК _ПервыйВводАктивов
	               |		ПО ФинансовыеПоказатели.Период >= _ПервыйВводАктивов.Период
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
	               |		ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
	               |			И (НАЧАЛОПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
	               |ГДЕ
	               |	ФинансовыеПоказатели.Организация = &Организация
	               |	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
	               |	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
	               |	И ФинансовыеПоказатели.Период <= &ДатаОкончания
	               |	И ФинансовыеПоказатели.Активность
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_всеСЧА.Период КАК Период,
	               |	_всеСЧА.Значение КАК Значение
	               |ПОМЕСТИТЬ _СЧАдляДоходности
	               |ИЗ
	               |	_всеСЧА КАК _всеСЧА
	               |ГДЕ
	               |	(_всеСЧА.Период В
	               |				(ВЫБРАТЬ
	               |					_ПервыйВводАктивов.Период
	               |				ИЗ
	               |					_ПервыйВводАктивов)
	               |			ИЛИ _всеСЧА.Период = &ДатаОкончания
	               |			ИЛИ НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(_всеСЧА.Период, ДЕНЬ), ДЕНЬ) = _всеСЧА.Период)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_СЧАдляДоходности.Период КАК Период,
	               |	_СЧАдляДоходности.Значение КАК Значение,
	               |	СУММА(ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость * ВЫБОР
	               |				КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
	               |					ТОГДА 1
	               |				ИНАЧЕ -1
	               |			КОНЕЦ / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2))) КАК СальдоВВ
	               |ПОМЕСТИТЬ _СЧАсВВ
	               |ИЗ
	               |	_СЧАдляДоходности КАК _СЧАдляДоходности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
	               |		ПО (ВводыВыводыАктивовВВалютеУчета.Организация = &Организация)
	               |			И (ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления)
	               |			И (ВводыВыводыАктивовВВалютеУчета.Период < КОНЕЦПЕРИОДА(_СЧАдляДоходности.Период, ДЕНЬ))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
	               |		ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
	               |			И (НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_СЧАдляДоходности.Период,
	               |	_СЧАдляДоходности.Значение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	_СЧАсВВ.Период КАК Период,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(_СЧАсВВ.СальдоВВ, 0) > 0
	               |			ТОГДА ВЫРАЗИТЬ((_СЧАсВВ.Значение - _СЧАсВВ.СальдоВВ) / _СЧАсВВ.СальдоВВ * 100 КАК ЧИСЛО(15, 2))
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ДоходностьНарастающимИтогом,
	               |	_СЧАсВВ.СальдоВВ КАК СальдоВВ
	               |ИЗ
	               |	_СЧАсВВ КАК _СЧАсВВ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период";
	
    Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ГрафикДоходностей = Область.Рисунки.D2.Объект;    
	ГрафикДоходностей.Обновление = Ложь;
	ТекущаяСерия = ГрафикДоходностей.Серии.Получить(0);
	
	МинимальнаяТочка = 0;
	МаксимальнаяТочка = 0;
	ЕстьОтрицательноеСальдоВВ = Ложь;
	
	Пока Выборка.Следующий() Цикл
		ТекущаяТочка = ГрафикДоходностей.УстановитьТочку(Выборка.Период);
		ТекущаяТочка.Текст = Формат(Выборка.Период, "ДФ=dd.MM.yyyy");
		ГрафикДоходностей.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, Выборка.ДоходностьНарастающимИтогом);
		
		Если Выборка.ДоходностьНарастающимИтогом < МинимальнаяТочка Тогда
			МинимальнаяТочка = Выборка.ДоходностьНарастающимИтогом	
		КонецЕсли;	
		
		Если Выборка.ДоходностьНарастающимИтогом > МаксимальнаяТочка Тогда
			МаксимальнаяТочка = Выборка.ДоходностьНарастающимИтогом	
		КонецЕсли;	
		
		Область.Параметры.ДоходностьЗаОтчетныйПериод = Выборка.ДоходностьНарастающимИтогом;	
		
		Если Выборка.СальдоВВ <= 0 Тогда
			ЕстьОтрицательноеСальдоВВ = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если Не ЕстьОтрицательноеСальдоВВ Тогда
		
		Если МинимальнаяТочка < 0 Тогда
			ГрафикДоходностей.ОсьЗначений.БазовоеЗначение = Мин(МинимальнаяТочка * 1.2, МинимальнаяТочка - 2);
		КонецЕсли;	
		
		ГрафикДоходностей.Обновление = Истина;
		
	Иначе
		// Если было отрицательное сальдо вводов-выводов, то данный способ расчета доходности не работает.
		// Это "аварийный режим" и тогда всё считаем совершенно другим способом. Эта "Идея" не наша - так сказала Светлана Трушина, а нам пришлось это делать так. Нам можно сказать выкрутили яйца.
		// основа расчета доп отчет "_РасчетДоходностиПоМетодикеПФР"
		
		Сообщить("По клиенту " + Строка(ЭтотОбъект.СчетДУ) + " сальдо вводов-выводов отрицательное, поэтому расчет доходности производится по методике СФР.");
		
		МинимальнаяТочка = 0;
		МаксимальнаяТочка = 0;
		
		Область.Параметры.ДоходностьЗаОтчетныйПериод = 0;
		
		ГрафикДоходностей.Точки.Очистить();
		
		ЗапросРасчетаПоМетодикеЦБ = Новый Запрос;
		ЗапросРасчетаПоМетодикеЦБ.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		#Область ТекстЗапроса
		ЗапросРасчетаПоМетодикеЦБ.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу, РеквизитыФизическихЛицКлиента.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Отчество, 1, 1) + ""."") КАК УчредительУправления,
		|	ЕСТЬNULL(ВводыВыводы.ДатаПервогоВвода, &ДатаНачала) КАК ДатаНачалаРасчетаДоходности
		|ПОМЕСТИТЬ _ДанныеШапки
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентДоверительногоУправления.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизации
		|		ПО СчетаДоверительногоУправления.Организация.ЮрФизЛицо = РеквизитыОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицКлиента
		|		ПО (КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицКлиента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКлиента
		|		ПО (КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыВыводыАктивовВВалютеУчета.Период), ДЕНЬ) КАК ДатаПервогоВвода
		|		ИЗ
		|			РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|		ГДЕ
		|			ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
		|			И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			И ВводыВыводыАктивовВВалютеУчета.ВидОперацииВводаВыводаДС В(&МассивВидыОпераций)) КАК ВводыВыводы
		|		ПО (ВводыВыводы.ДатаПервогоВвода >= &ДатаНачала)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказателиСрезПоследних.Период КАК Период,
		|	ФинансовыеПоказателиСрезПоследних.Значение КАК СЧА
		|ПОМЕСТИТЬ _СЧА
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели.СрезПоследних(
		|			&ДатаНачала,
		|			Организация = &Организация
		|				И СубъектАналитики = &СчетДоверительногоУправления
		|				И ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)) КАК ФинансовыеПоказателиСрезПоследних
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ФинансовыеПоказатели.Период,
		|	ФинансовыеПоказатели.Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ФинансовыеПоказатели.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ) КАК Период,
		|	СУММА(ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|				ТОГДА ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Приход,
		|	СУММА(ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|				ТОГДА ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Расход
		|ПОМЕСТИТЬ _ВводыВыводы
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
		|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВводыВыводыАктивовВВалютеУчета.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВводыВыводыАктивовВВалютеУчета.ВидОперацииВводаВыводаДС В(&МассивВидыОпераций)
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыПредыдущихСЧА.ДатаСЧА КАК ДатаСЧА,
		|	ДатыПредыдущихСЧА.ДатаПредыдущейСЧА КАК ДатаПредыдущейСЧА,
		|	ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) КАК ПредыдущаяСЧА
		|ПОМЕСТИТЬ _ПредыдущаяСЧА
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СЧА.Период КАК ДатаСЧА,
		|		МАКСИМУМ(ФинансовыеПоказатели.Период) КАК ДатаПредыдущейСЧА
		|	ИЗ
		|		_СЧА КАК _СЧА
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|			ПО (ФинансовыеПоказатели.Организация = &Организация)
		|				И (ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления)
		|				И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|				И _СЧА.Период > ФинансовыеПоказатели.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СЧА.Период) КАК ДатыПредыдущихСЧА
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ФинансовыеПоказатели.Организация = &Организация)
		|			И (ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления)
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И ДатыПредыдущихСЧА.ДатаПредыдущейСЧА = ФинансовыеПоказатели.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СЧА.Период КАК Период,
		|	ЕСТЬNULL(_ВводыВыводы.Приход, 0) КАК Приход,
		|	ЕСТЬNULL(_ВводыВыводы.Расход, 0) КАК Расход,
		|	ВЫБОР
		|		КОГДА _ПредыдущаяСЧА.ПредыдущаяСЧА = 0
		|			ТОГДА ЕСТЬNULL(_ВводыВыводы.Приход, 0) - ЕСТЬNULL(_ВводыВыводы.Расход, 0)
		|		ИНАЧЕ _СЧА.СЧА
		|	КОНЕЦ КАК СЧА,
		|	ЕСТЬNULL(_ВводыВыводы.Приход, 0) - ЕСТЬNULL(_ВводыВыводы.Расход, 0) КАК РазницаВВ,
		|	ВЫБОР
		|		КОГДА _ПредыдущаяСЧА.ПредыдущаяСЧА = 0
		|			ТОГДА 0
		|		ИНАЧЕ _СЧА.СЧА - (ЕСТЬNULL(_ВводыВыводы.Приход, 0) - ЕСТЬNULL(_ВводыВыводы.Расход, 0))
		|	КОНЕЦ КАК СЧАдляРасчета,
		|	_ПредыдущаяСЧА.ПредыдущаяСЧА = 0 КАК ПредыдущаяСЧАРавна0
		|ПОМЕСТИТЬ _ДанныеОтчета
		|ИЗ
		|	_СЧА КАК _СЧА
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВводыВыводы КАК _ВводыВыводы
		|		ПО _СЧА.Период = _ВводыВыводы.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПредыдущаяСЧА КАК _ПредыдущаяСЧА
		|		ПО _СЧА.Период = _ПредыдущаяСЧА.ДатаСЧА
		|ГДЕ
		|	(НЕ &ТолькоВводыВыводы
		|			ИЛИ НЕ _ВводыВыводы.Период ЕСТЬ NULL
		|			ИЛИ _СЧА.Период <= &ДатаНачала
		|			ИЛИ РАЗНОСТЬДАТ(_СЧА.Период, &ДатаОкончания, ДЕНЬ) = 0)";
		#КонецОбласти
		
		МассивВидыОпераций = Новый Массив;
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводУчредителюДоходаПолученногоОтРазмещения);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы);
		МассивВидыОпераций.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПустаяСсылка());
		
		ЗапросРасчетаПоМетодикеЦБ.УстановитьПараметр("МассивВидыОпераций"	, МассивВидыОпераций);	
		
		ЗапросРасчетаПоМетодикеЦБ.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
		ЗапросРасчетаПоМетодикеЦБ.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
		ЗапросРасчетаПоМетодикеЦБ.УстановитьПараметр("ДатаНачала"					, ЭтотОбъект.Период.ДатаНачала);
		ЗапросРасчетаПоМетодикеЦБ.УстановитьПараметр("ДатаОкончания"				, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
		ЗапросРасчетаПоМетодикеЦБ.УстановитьПараметр("ТолькоВводыВыводы"			, Ложь);
		
		ЗапросРасчетаПоМетодикеЦБ.Выполнить();
		
		ДанныеОтчета = ЗапросРасчетаПоМетодикеЦБ.МенеджерВременныхТаблиц.Таблицы.Найти("_ДанныеОтчета").ПолучитьДанные().Выгрузить();
		ДанныеОтчета.Сортировать("Период");
		
		СЧАвчерашнее = 0; 
		Произведение = 1;
		НакопленнаяДоходность = 1;
		
		Для Каждого СтрокаДанных Из ДанныеОтчета Цикл	
			Если СЧАвчерашнее = 0 Тогда 
				СЧАвчерашнее = СтрокаДанных.СЧА;
			КонецЕсли;
			
			Если СЧАвчерашнее <> 0 Тогда 
				Доходность	 = СтрокаДанных.СЧАдляРасчета/СЧАвчерашнее;
				Произведение = Произведение * Доходность;
				НакопленнаяДоходность = НакопленнаяДоходность * Доходность;
			Иначе
				Доходность	 = 0;
			КонецЕсли;
			
			Если Доходность = 0 Тогда
				Произведение = 1;
				НакопленнаяДоходность = 1;
			КонецЕсли;
			
			СЧАвчерашнее = СтрокаДанных.СЧА;
			
			ДоходностьНарастающимИтогом = Окр((НакопленнаяДоходность - 1) * 100, 2);
			
			ТекущаяТочка = ГрафикДоходностей.УстановитьТочку(СтрокаДанных.Период);
			ТекущаяТочка.Текст = Формат(СтрокаДанных.Период, "ДФ=dd.MM.yyyy");
			ГрафикДоходностей.УстановитьЗначение(ТекущаяТочка, ТекущаяСерия, ДоходностьНарастающимИтогом);
			
			Если ДоходностьНарастающимИтогом < МинимальнаяТочка Тогда
				МинимальнаяТочка = ДоходностьНарастающимИтогом	
			КонецЕсли;	
			
			Если ДоходностьНарастающимИтогом > МаксимальнаяТочка Тогда
				МаксимальнаяТочка = ДоходностьНарастающимИтогом	
			КонецЕсли;	
			
			Область.Параметры.ДоходностьЗаОтчетныйПериод = ДоходностьНарастающимИтогом;	
			
		КонецЦикла;	
		
		ДнейВГоду = 365;  //  #534640
		ДатаНачалаРасчетаДоходности = ЭтотОбъект.Период.ДатаНачала;
		
		//расчет доходности 
		ДлительностьПериода = (КонецДня(ЭтотОбъект.Период.ДатаОкончания) + 1 - ДатаНачалаРасчетаДоходности)/24/60/60;
		Если ЗначениеЗаполнено(ДлительностьПериода) Тогда
			ДоходностьПериода	= (Произведение-1) * ДнейВГоду / ДлительностьПериода * 100;
			Область.Параметры.ДоходностьЗаОтчетныйПериодГодовых = Окр(ДоходностьПериода, 2);	
		КонецЕсли;	
		
		Если МинимальнаяТочка < 0 Тогда
			ГрафикДоходностей.ОсьЗначений.БазовоеЗначение = Мин(МинимальнаяТочка * 1.2, МинимальнаяТочка - 2);
		КонецЕсли;	
		
		ГрафикДоходностей.Обновление = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОтобразитьТаблицуДоходностиПоПериодам(Область, МакетОтчета, ВалютаИнвестиционногоПрофиля)
	
    Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	1 КАК Порядок,
	               |	""1 месяц"" КАК ОписаниеПериода,
	               |	ДОБАВИТЬКДАТЕ(&ДатаОкончания, МЕСЯЦ, -1) КАК _НачалоПериода,
	               |	&ДатаОкончания КАК ОкончаниеПериода
	               |ПОМЕСТИТЬ _ПериодыРасчетаДоходностиПредварительно
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	2,
	               |	""3 месяца"",
	               |	ДОБАВИТЬКДАТЕ(&ДатаОкончания, МЕСЯЦ, -3),
	               |	&ДатаОкончания
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	3,
	               |	""6 месяцев"",
	               |	ДОБАВИТЬКДАТЕ(&ДатаОкончания, МЕСЯЦ, -6),
	               |	&ДатаОкончания
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	4,
	               |	""1 год"",
	               |	ДОБАВИТЬКДАТЕ(&ДатаОкончания, ГОД, -1),
	               |	&ДатаОкончания
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	5,
	               |	""с начала года"",
	               |	НАЧАЛОПЕРИОДА(&ДатаОкончания, ГОД),
	               |	&ДатаОкончания
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	МИНИМУМ(НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ)) КАК Период
	               |ПОМЕСТИТЬ _ПервыйВводАктивов
	               |ИЗ
	               |	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
	               |ГДЕ
	               |	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
	               |	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ПериодыРасчетаДоходности.Порядок КАК Порядок,
	               |	_ПериодыРасчетаДоходности.ОписаниеПериода КАК ОписаниеПериода,
	               |	ВЫБОР
	               |		КОГДА МАКСИМУМ(ЕСТЬNULL(ФинансовыеПоказатели.Период, _ПервыйВводАктивов.Период)) < _ПервыйВводАктивов.Период
	               |			ТОГДА _ПервыйВводАктивов.Период
	               |		ИНАЧЕ МАКСИМУМ(ЕСТЬNULL(ФинансовыеПоказатели.Период, _ПервыйВводАктивов.Период))
	               |	КОНЕЦ КАК НачалоПериода,
	               |	_ПериодыРасчетаДоходности.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	_ПервыйВводАктивов.Период КАК ПервыйВВодАктивов
	               |ПОМЕСТИТЬ _ПериодыРасчетаДоходности
	               |ИЗ
	               |	_ПериодыРасчетаДоходностиПредварительно КАК _ПериодыРасчетаДоходности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
	               |		ПО (ФинансовыеПоказатели.Период <= _ПериодыРасчетаДоходности._НачалоПериода)
	               |			И (ФинансовыеПоказатели.Активность)
	               |			И (ФинансовыеПоказатели.Организация = &Организация)
	               |			И (ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления)
	               |			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ПервыйВводАктивов КАК _ПервыйВводАктивов
	               |		ПО (ИСТИНА)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_ПериодыРасчетаДоходности.ОкончаниеПериода,
	               |	_ПериодыРасчетаДоходности.ОписаниеПериода,
	               |	_ПериодыРасчетаДоходности.Порядок,
	               |	_ПервыйВводАктивов.Период
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ПериодыРасчетаДоходности.Порядок КАК Порядок,
	               |	_ПериодыРасчетаДоходности.ОписаниеПериода КАК ОписаниеПериода,
	               |	_ПериодыРасчетаДоходности.НачалоПериода КАК НачалоПериода,
	               |	_ПериодыРасчетаДоходности.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	СУММА(ВЫРАЗИТЬ(ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость * ВЫБОР
	               |				КОГДА ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
	               |					ТОГДА 1
	               |				ИНАЧЕ -1
	               |			КОНЕЦ / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2))) КАК СальдоВВ
	               |ПОМЕСТИТЬ _ПериодыСВВ
	               |ИЗ
	               |	_ПериодыРасчетаДоходности КАК _ПериодыРасчетаДоходности
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
	               |			ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
	               |				И (НАЧАЛОПЕРИОДА(ВводыВыводыАктивовВВалютеУчета.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
	               |		ПО (ВводыВыводыАктивовВВалютеУчета.Организация = &Организация)
	               |			И (ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления)
	               |			И (ВводыВыводыАктивовВВалютеУчета.Период <= КОНЕЦПЕРИОДА(_ПериодыРасчетаДоходности.ОкончаниеПериода, ДЕНЬ))
	               |			И (ВводыВыводыАктивовВВалютеУчета.Период > КОНЕЦПЕРИОДА(_ПериодыРасчетаДоходности.НачалоПериода, ДЕНЬ))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_ПериодыРасчетаДоходности.Порядок,
	               |	_ПериодыРасчетаДоходности.ОписаниеПериода,
	               |	_ПериодыРасчетаДоходности.НачалоПериода,
	               |	_ПериодыРасчетаДоходности.ОкончаниеПериода
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ПериодыСВВ.Порядок КАК Порядок,
	               |	_ПериодыСВВ.ОписаниеПериода КАК ОписаниеПериода,
	               |	_ПериодыСВВ.НачалоПериода КАК НачалоПериода,
	               |	_ПериодыСВВ.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	_ПериодыСВВ.СальдоВВ КАК СальдоВВ,
	               |	ВЫРАЗИТЬ(ФинансовыеПоказателиНачало.Значение / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляНачало.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляНачало.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК АктивыНачало,
	               |	ВЫРАЗИТЬ(ФинансовыеПоказателиОкончание.Значение / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляОкончание.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиляОкончание.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК АктивыКонец,
	               |	ВЫБОР
	               |		КОГДА ФинансовыеПоказателиОкончание.Значение ЕСТЬ NULL
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК РассчитаныФинансовыеПоказатели
	               |ПОМЕСТИТЬ _ПериодыСВВиАктивами
	               |ИЗ
	               |	_ПериодыСВВ КАК _ПериодыСВВ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиНачало
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиляНачало
	               |			ПО (КурсВалютыИнвестиционногоПрофиляНачало.Валюта = &ВалютаИнвестиционногоПрофиля)
	               |				И (НАЧАЛОПЕРИОДА(ФинансовыеПоказателиНачало.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиляНачало.Период, ДЕНЬ))
	               |		ПО _ПериодыСВВ.НачалоПериода = ФинансовыеПоказателиНачало.Период
	               |			И (ФинансовыеПоказателиНачало.Организация = &Организация)
	               |			И (ФинансовыеПоказателиНачало.СубъектАналитики = &СчетДоверительногоУправления)
	               |			И (ФинансовыеПоказателиНачало.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказателиОкончание
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиляОкончание
	               |			ПО (КурсВалютыИнвестиционногоПрофиляОкончание.Валюта = &ВалютаИнвестиционногоПрофиля)
	               |				И (НАЧАЛОПЕРИОДА(ФинансовыеПоказателиОкончание.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиляОкончание.Период, ДЕНЬ))
	               |		ПО _ПериодыСВВ.ОкончаниеПериода = ФинансовыеПоказателиОкончание.Период
	               |			И (ФинансовыеПоказателиОкончание.Организация = &Организация)
	               |			И (ФинансовыеПоказателиОкончание.СубъектАналитики = &СчетДоверительногоУправления)
	               |			И (ФинансовыеПоказателиОкончание.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ПериодыСВВиАктивами.ОписаниеПериода КАК ОписаниеПериода,
	               |	ВЫРАЗИТЬ((_ПериодыСВВиАктивами.АктивыКонец - _ПериодыСВВиАктивами.АктивыНачало - ЕСТЬNULL(_ПериодыСВВиАктивами.СальдоВВ, 0)) / _ПериодыСВВиАктивами.АктивыНачало * 100 КАК ЧИСЛО(15, 2)) КАК Доходность,
	               |	_ПериодыСВВиАктивами.РассчитаныФинансовыеПоказатели КАК РассчитаныФинансовыеПоказатели
	               |ИЗ
	               |	_ПериодыСВВиАктивами КАК _ПериодыСВВиАктивами
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	_ПериодыСВВиАктивами.Порядок";
	
    Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СтрокаДоходностьПоПериодам = МакетОтчета.ПолучитьОбласть("СтрокаДоходностьПоПериодам");
	
	Если Выборка.Количество() > 0 Тогда
		ШапкаДоходностьПоПериодам = МакетОтчета.ПолучитьОбласть("ШапкаДоходностьПоПериодам");
		Область.ВставитьОбласть(ШапкаДоходностьПоПериодам.Область(1,1,1,4), Область.Область(17,1,17,4), ТипСмещенияТабличногоДокумента.БезСмещения, Истина);
	КонецЕсли;
	
	НомерСтроки = 18;
	
	Пока Выборка.Следующий() Цикл
		СтрокаДоходностьПоПериодам.Параметры.Заполнить(Выборка);
		
		Область.ВставитьОбласть(СтрокаДоходностьПоПериодам.Область(1,1,1,4), Область.Область(НомерСтроки,1,НомерСтроки,4), ТипСмещенияТабличногоДокумента.БезСмещения, Истина);
		
		Если Не Выборка.РассчитаныФинансовыеПоказатели Тогда
			Сообщить(СтрШаблон("Расчет показателя Доходность %1 по счету %2 невозможен, т.к. стоимость портфеля на %3 не зарегистрирована!", Выборка.ОписаниеПериода, Запрос.Параметры.СчетДоверительногоУправления, Формат(Запрос.Параметры.ДатаОкончания, "ДЛФ=DD")));
		КонецЕсли;	
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиВводыВыводыИРасходы(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям, ВалютаИнвестиционногоПрофиля)
	
	СтрокаВводыВыводы = МакетОтчета.ПолучитьОбласть("СтрокаВводыВыводы");
	СтрокаВводыВыводыИтого = МакетОтчета.ПолучитьОбласть("СтрокаВводыВыводыИтого");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчета.Период КАК Период,
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения КАК НаправлениеДвижения,
		|	ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость КАК РыночнаяСтоимость
		|ИЗ
		|	_ВводыВыводыАктивов КАК ВводыВыводыАктивовВВалютеУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	НаправлениеДвижения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГОД(ВводыВыводыАктивовВВалютеУчета.Период) КАК Год,
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения КАК НаправлениеДвижения,
		|	СУММА(ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость) КАК Сумма
		|ИЗ
		|	_ВводыВыводыАктивов КАК ВводыВыводыАктивовВВалютеУчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ГОД(ВводыВыводыАктивовВВалютеУчета.Период),
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГОД(ВводыВыводыАктивовВВалютеУчета.Период),
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения";
	
	ВременнаяТаблицаВводыВыводы = Новый ТабличныйДокумент;
	
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаВводыВыводы = РезультатЗапроса[0].Выбрать();
	ВыборкаВводыВыводыИтого = РезультатЗапроса[1].Выбрать();
	
	КоличествоВводовВыводов = ВыборкаВводыВыводы.Количество();
	
	Если ВыборкаВводыВыводы.Количество() > 0 Тогда
		ШапкаВводыВыводы = МакетОтчета.ПолучитьОбласть("ШапкаВводыВыводы");
		ВременнаяТаблицаВводыВыводы.Вывести(ШапкаВводыВыводы);
	КонецЕсли;
	
	Пока ВыборкаВводыВыводы.Следующий() Цикл
    	СтрокаВводыВыводы.Параметры.Дата = Формат(ВыборкаВводыВыводы.Период, "ДФ=dd.MM.yyyy");
		СтрокаВводыВыводы.Параметры.Назначение = 
			?(ВыборкаВводыВыводы.НаправлениеДвижения = Перечисления.ВидыДвижений.Приход, "Ввод", "Вывод");
		СтрокаВводыВыводы.Параметры.Сумма = ВыборкаВводыВыводы.РыночнаяСтоимость;
		ВременнаяТаблицаВводыВыводы.Вывести(СтрокаВводыВыводы);
	КонецЦикла;
	
	Пока ВыборкаВводыВыводыИтого.Следующий() Цикл
    	СтрокаВводыВыводыИтого.Параметры.Год = Формат(ВыборкаВводыВыводыИтого.Год, "ЧГ=0");
		СтрокаВводыВыводыИтого.Параметры.Назначение = 
			?(ВыборкаВводыВыводыИтого.НаправлениеДвижения = Перечисления.ВидыДвижений.Приход, "вводов", "выводов");
		СтрокаВводыВыводыИтого.Параметры.Сумма = ВыборкаВводыВыводыИтого.Сумма;
		ВременнаяТаблицаВводыВыводы.Вывести(СтрокаВводыВыводыИтого);
	КонецЦикла;
	
	СтрокаРасходы = МакетОтчета.ПолучитьОбласть("СтрокаРасходы|Расходы");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатьиРасходов.СтатьяРасхода КАК СтатьяРасхода,
		|	СтатьиРасходов.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА ОбщаяСумма.СуммаИтог = 0
		|			ТОГДА 0
		|		ИНАЧЕ СтатьиРасходов.Сумма / ОбщаяСумма.СуммаИтог * 100
		|	КОНЕЦ КАК Доля
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК СтатьяРасхода,
		|		СУММА(ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2))) КАК Сумма
		|	ИЗ
		|		РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|				&ДатаНачала,
		|				&ДатаОкончания,
		|				День,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|					И НЕ ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Сделки))) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
		|			ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
		|				И (НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствамОбороты.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
		|	ГДЕ
		|		ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход > 0
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности) КАК СтатьиРасходов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(ВЫРАЗИТЬ(Подсчет.СуммаПриход / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2))) КАК СуммаИтог
		|		ИЗ
		|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|					&ДатаНачала,
		|					&ДатаОкончания,
		|					День,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|						И НЕ ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Сделки))) КАК Подсчет
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
		|				ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
		|					И (НАЧАЛОПЕРИОДА(Подсчет.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
		|		ГДЕ
		|			Подсчет.СуммаПриход > 0) КАК ОбщаяСумма
		|		ПО (ИСТИНА)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтатьиРасходов.СтатьяРасхода";
	
	ВременнаяТаблицаРасходы = Новый ТабличныйДокумент;
	
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	ВыборкаРасходы = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаРасходы.Количество() > КоличествоВводовВыводов Тогда
		СтрокаВводыВыводыПустая = МакетОтчета.ПолучитьОбласть("СтрокаВводыВыводыПустая");
		Для Сч = КоличествоВводовВыводов + 1 По ВыборкаРасходы.Количество() Цикл
			ВременнаяТаблицаВводыВыводы.Вывести(СтрокаВводыВыводыПустая);
		КонецЦикла;	
	КонецЕсли;	
	
	Если ВыборкаРасходы.Количество() > 0 Тогда
		ШапкаРасходы = МакетОтчета.ПолучитьОбласть("ШапкаРасходы|Расходы");
		ВременнаяТаблицаРасходы.Вывести(ШапкаРасходы);
	КонецЕсли;
	
	Пока ВыборкаРасходы.Следующий() Цикл
		СтрокаРасходы.Параметры.Вид = ВыборкаРасходы.СтатьяРасхода;
		СтрокаРасходы.Параметры.Сумма = ВыборкаРасходы.Сумма;
		СтрокаРасходы.Параметры.Доля = ВыборкаРасходы.Доля;
		ВременнаяТаблицаРасходы.Вывести(СтрокаРасходы);
	КонецЦикла;
	
	ВременнаяТаблицаОтчета = Новый ТабличныйДокумент;
	
	Если ВременнаяТаблицаВводыВыводы.ВысотаТаблицы > 0 Тогда
		ВременнаяТаблицаОтчета.Вывести(ВременнаяТаблицаВводыВыводы);	
	КонецЕсли;	
	
	Если ВременнаяТаблицаРасходы.ВысотаТаблицы > 0 Тогда
		Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
			//ВременнаяТаблицаОтчета.Присоединить(ВременнаяТаблицаРасходы.ПолучитьОбласть(1,1,ВременнаяТаблицаРасходы.ВысотаТаблицы,ВременнаяТаблицаРасходы.ШиринаТаблицы));	
			
			ВременнаяТаблицаОтчета.ВставитьОбласть(ВременнаяТаблицаРасходы.Область(1,1,ВременнаяТаблицаРасходы.ВысотаТаблицы,ВременнаяТаблицаРасходы.ШиринаТаблицы), ВременнаяТаблицаОтчета.Область(1, 5, ВременнаяТаблицаРасходы.ВысотаТаблицы, 5 + ВременнаяТаблицаРасходы.ШиринаТаблицы), ТипСмещенияТабличногоДокумента.БезСмещения, Истина);

		Иначе
			ВременнаяТаблицаОтчета.Вывести(ВременнаяТаблицаРасходы);	
		КонецЕсли;	
	КонецЕсли;	
	
	Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
		
		Если Не ТаблицаОтчета.ПроверитьВывод(ВременнаяТаблицаОтчета) Тогда
			ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ВывестиВводыВыводы(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям)
	
	СтрокаВводыВыводы = МакетОтчета.ПолучитьОбласть("СтрокаВводыВыводы");
	СтрокаВводыВыводыИтого = МакетОтчета.ПолучитьОбласть("СтрокаВводыВыводыИтого");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводыАктивовВВалютеУчета.Период КАК Период,
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения КАК НаправлениеДвижения,
		|	ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость КАК РыночнаяСтоимость
		|ИЗ
		|	_ВводыВыводыАктивов КАК ВводыВыводыАктивовВВалютеУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГОД(ВводыВыводыАктивовВВалютеУчета.Период) КАК Год,
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения КАК НаправлениеДвижения,
		|	СУММА(ВводыВыводыАктивовВВалютеУчета.РыночнаяСтоимость) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.Активность
		|	И ВводыВыводыАктивовВВалютеУчета.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
		|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	ГОД(ВводыВыводыАктивовВВалютеУчета.Период),
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГОД(ВводыВыводыАктивовВВалютеУчета.Период),
		|	ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения";
	
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаВводыВыводы = РезультатЗапроса[0].Выбрать();
	ВыборкаВводыВыводыИтого = РезультатЗапроса[1].Выбрать();
	
	Если ВыборкаВводыВыводы.Количество() > 0 Тогда
		ШапкаВводыВыводы = МакетОтчета.ПолучитьОбласть("ШапкаВводыВыводы");
		ТаблицаОтчета.Вывести(ШапкаВводыВыводы);
	КонецЕсли;
	
	Пока ВыборкаВводыВыводы.Следующий() Цикл
    	СтрокаВводыВыводы.Параметры.Дата = Формат(ВыборкаВводыВыводы.Период, "ДФ=dd.MM.yyyy");
		СтрокаВводыВыводы.Параметры.Назначение = 
			?(ВыборкаВводыВыводы.НаправлениеДвижения = Перечисления.ВидыДвижений.Приход, "Ввод", "Вывод");
		СтрокаВводыВыводы.Параметры.Сумма = ВыборкаВводыВыводы.РыночнаяСтоимость;
		ТаблицаОтчета.Вывести(СтрокаВводыВыводы);
	КонецЦикла;
	
	Пока ВыборкаВводыВыводыИтого.Следующий() Цикл
    	СтрокаВводыВыводыИтого.Параметры.Год = Формат(ВыборкаВводыВыводыИтого.Год, "ЧГ=0");
		СтрокаВводыВыводыИтого.Параметры.Назначение = 
			?(ВыборкаВводыВыводыИтого.НаправлениеДвижения = Перечисления.ВидыДвижений.Приход, "вводов", "выводов");
		СтрокаВводыВыводыИтого.Параметры.Сумма = ВыборкаВводыВыводыИтого.Сумма;
		ТаблицаОтчета.Вывести(СтрокаВводыВыводыИтого);
	КонецЦикла;
	
КонецПроцедуры

