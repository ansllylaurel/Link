		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _АкцииДивидендыЗачисленные.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|ГДЕ
		|	_ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) ЕСТЬ NULL";		
	
	ВыборкаАкции = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаАкции.Следующий() Цикл
		ПодвалАкции = МакетОтчета.ПолучитьОбласть("ПодвалАкции");
		ПодвалАкции.Параметры.Заполнить(ВыборкаАкции);
		
		ПодвалАкции.Параметры.ИзмененияСУчетомДивидендов = ВыборкаАкции.ТекущаяСтоимость + ВыборкаАкции.ДивидендыЗачисленные - ВыборкаАкции.СтоимостьПриобретения;
		
		ВременнаяТаблицаОтчета.Вывести(ПодвалАкции);
	КонецЦикла;	
	
	Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
		
		Если Не ТаблицаОтчета.ПроверитьВывод(ВременнаяТаблицаОтчета) Тогда
			ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиПаи(МакетОтчета, ТаблицаОтчета, ВидУчета, ДатаЗапретаРедактирования, МенеджерВременныхТаблицПоПартям, ТекущиеВременныеТаблицы)
	
	СтрокаПаи = МакетОтчета.ПолучитьОбласть("СтрокаПаи");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, , ТекущиеВременныеТаблицы);	
	
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследнихISIN.Код КАК ISIN,
		|	ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Код, ПРЕДСТАВЛЕНИЕ(_ЦенныеБумаги.ЦеннаяБумага.ПаевойИнвестиционныйФонд)) КАК Наименование,
		|	ЕСТЬNULL(_ЦенныеБумаги.Количество, _ЦеныИзСЧА.Количество) КАК Количество,
		|	ПРЕДСТАВЛЕНИЕ(_ЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала) КАК Валюта,
		|	ЕСТЬNULL(_ЦеныИзСЧА.Цена, 0) + ЕСТЬNULL(_ЦеныИзСЧА.ЦенаКупона, 0) КАК ТекущаяЦена,
		|	ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0) КАК ТекущаяСтоимость,
		|	ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0) + ЕСТЬNULL(_ЦенныеБумаги.РасходыПриПокупкеВСтоимостиВВалютеУчета, 0) КАК СтоимостьПриобретения,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЦенныеБумаги.Количество, 0) <> 0
		|			ТОГДА (ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0)) / ЕСТЬNULL(_ЦенныеБумаги.Количество, 1)
		|		ИНАЧЕ ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0)
		|	КОНЕЦ КАК ЦенаПриобретения,
		|	_ЦенныеБумаги.ЦеннаяБумага.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
		|ПОМЕСТИТЬ _ДанныеПоПаям
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныИзСЧА КАК _ЦеныИзСЧА
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ЦеныИзСЧА.ЦеннаяБумага
		|			И _ЦенныеБумаги.Рынок = _ЦеныИзСЧА.Рынок
		|ГДЕ
		|	_ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПоПаям.ISIN КАК ISIN,
		|	_ДанныеПоПаям.Наименование КАК Наименование,
		|	_ДанныеПоПаям.Количество КАК Количество,
		|	_ДанныеПоПаям.Валюта КАК Валюта,
		|	_ДанныеПоПаям.ТекущаяЦена КАК ТекущаяЦена,
		|	_ДанныеПоПаям.ТекущаяСтоимость КАК ТекущаяСтоимость,
		|	_ДанныеПоПаям.СтоимостьПриобретения КАК СтоимостьПриобретения,
		|	_ДанныеПоПаям.ЦенаПриобретения КАК ЦенаПриобретения,
		|	_ДанныеПоПаям.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|			ТОГДА 0
		|		ИНАЧЕ _ДанныеПоПаям.ТекущаяСтоимость / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|	КОНЕЦ КАК Доля
		|ИЗ
		|	_ДанныеПоПаям КАК _ДанныеПоПаям
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|АВТОУПОРЯДОЧИВАНИЕ";		
	
	ВременнаяТаблицаОтчета = Новый ТабличныйДокумент;
	
	ВыборкаПаи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаПаи.Количество() > 0 Тогда
		ШапкаПаи = МакетОтчета.ПолучитьОбласть("ШапкаПаи");
		ВременнаяТаблицаОтчета.Вывести(ШапкаПаи);
	КонецЕсли;
	
	Пока ВыборкаПаи.Следующий() Цикл
		СтрокаПаи.Параметры.Заполнить(ВыборкаПаи);
		
		Если ЗначениеЗаполнено(ВыборкаПаи.ПаевойИнвестиционныйФонд) Тогда
			СтрокаПаи.Параметры.Наименование = Строка(Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФНаДату(ЭтотОбъект.Период.ДатаОкончания, ВыборкаПаи.ПаевойИнвестиционныйФонд)) + " " + СтрокаПаи.Параметры.Наименование;
		КонецЕсли;
		
		СтрокаПаи.Параметры.Изменения = ВыборкаПаи.ТекущаяСтоимость - ВыборкаПаи.СтоимостьПриобретения;
		
		ВременнаяТаблицаОтчета.Вывести(СтрокаПаи);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ДанныеПоПаям.ТекущаяСтоимость) КАК ТекущаяСтоимость,
		|	СУММА(_ДанныеПоПаям.СтоимостьПриобретения) КАК СтоимостьПриобретения,
		|	СУММА(ВЫБОР
		|			КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|				ТОГДА 0
		|			ИНАЧЕ _ДанныеПоПаям.ТекущаяСтоимость / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|		КОНЕЦ) КАК Доля
		|ИЗ
		|	_ДанныеПоПаям КАК _ДанныеПоПаям
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(_ДанныеПоПаям.ТекущаяСтоимость) ЕСТЬ NULL";		
	
	ВыборкаПаи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаПаи.Следующий() Цикл
		ПодвалПаи = МакетОтчета.ПолучитьОбласть("ПодвалПаи");
		
		ПодвалПаи.Параметры.Заполнить(ВыборкаПаи);
		
		ПодвалПаи.Параметры.Изменения = ВыборкаПаи.ТекущаяСтоимость - ВыборкаПаи.СтоимостьПриобретения;
		
		ВременнаяТаблицаОтчета.Вывести(ПодвалПаи);
	КонецЦикла;	
	
	Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
		
		Если Не ТаблицаОтчета.ПроверитьВывод(ВременнаяТаблицаОтчета) Тогда
			ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

