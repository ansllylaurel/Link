		|УПОРЯДОЧИТЬ ПО
		|	СтатьиРасходов.СтатьяРасхода";
	
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	
	ВыборкаРасходы = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаРасходы.Количество() > 0 Тогда
		ШапкаРасходы = МакетОтчета.ПолучитьОбласть("ШапкаРасходы");
		ТаблицаОтчета.Вывести(ШапкаРасходы);
	КонецЕсли;
	
	Пока ВыборкаРасходы.Следующий() Цикл
		СтрокаРасходы.Параметры.Вид = ВыборкаРасходы.СтатьяРасхода;
		СтрокаРасходы.Параметры.Сумма = ВыборкаРасходы.Сумма;
		СтрокаРасходы.Параметры.Доля = ВыборкаРасходы.Доля;
		ТаблицаОтчета.Вывести(СтрокаРасходы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиИнформациюОбЭмитнетах(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям)
	
	СтрокаИнформацияОбЭмитентах = МакетОтчета.ПолучитьОбласть("СтрокаИнформацияОбЭмитентах");
	
	Биржа_ММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.Рынок КАК ВидЦеннойБумаги,
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд)
		|		ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу
		|	КОНЕЦ КАК НаименованиеЭмитента,
		|	ВЫБОР
		|		КОГДА _ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Код, РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу + "" "" + ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер)
		|		КОГДА _ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Код, РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу + "" "" + ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер)
		|		КОГДА _ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Код, ПРЕДСТАВЛЕНИЕ(ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд))
		|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(_ЦенныеБумаги.ЦеннаяБумага)
		|	КОНЕЦ КАК Наименование,
		|	РеквизитыЮридическихЛицСрезПоследних.Отрасль КАК Отрасль,
		|	_ЦенныеБумаги.ЦеннаяБумага.СтранаРазмещения КАК Регион,
		|	_ЦенныеБумаги.ЦеннаяБумага.ДатаПогашения КАК ДатаПогашения,
		|	МИНИМУМ(УсловияОферт.ДатаВыкупа) КАК ДатаОферты,
		|	КупонныйДоходПоОблигациямСрезПоследних.ДатаОкончанияКупона КАК БлижайшаяКупоннаяДата,
		|	КупонныйДоходПоОблигациямСрезПоследних.СтавкаКупона КАК ТекущийКупон,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЦенныеБумаги.Количество, 0) <> 0
		|			ТОГДА (ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиВВалютеНоминала, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупонаВВалютеНоминала, 0)) / ЕСТЬNULL(_ЦенныеБумаги.Количество, 1)
		|		ИНАЧЕ ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиВВалютеНоминала, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупонаВВалютеНоминала, 0)
		|	КОНЕЦ КАК ЦенаПриобретения,
		|	КодыВТорговыхСистемахСрезПоследнихISIN.Код КАК ISIN,
		|	ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|	МАКСИМУМ(КотировкиТорговыхПлощадок.YIELDATWAP) КАК ДоходностьКПогашениюОферте
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям.СрезПоследних(&ДатаОкончания, ) КАК КупонныйДоходПоОблигациямСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КупонныйДоходПоОблигациямСрезПоследних.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = УсловияОферт.Облигация
		|			И (УсловияОферт.ДатаВыкупа >= &ДатаОкончания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КотировкиТорговыхПлощадок.ЦеннаяБумага
		|			И _ЦенныеБумаги.Рынок = КотировкиТорговыхПлощадок.Рынок
		|			И (КотировкиТорговыхПлощадок.Биржа = &Биржа_ММВБ)
		|
		|СГРУППИРОВАТЬ ПО
		|	КупонныйДоходПоОблигациямСрезПоследних.ДатаОкончанияКупона,
		|	_ЦенныеБумаги.ЦеннаяБумага.СтранаРазмещения,
		|	КодыВТорговыхСистемахСрезПоследнихISIN.Код,
		|	КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Код,
		|	_ЦенныеБумаги.ЦеннаяБумага.ДатаПогашения,
		|	_ЦенныеБумаги.ЦеннаяБумага,
		|	РеквизитыЮридическихЛицСрезПоследних.Отрасль,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу,
		|	КупонныйДоходПоОблигациямСрезПоследних.СтавкаКупона,
		|	_ЦенныеБумаги.Рынок,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЦенныеБумаги.Количество, 0) <> 0
		|			ТОГДА (ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиВВалютеНоминала, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупонаВВалютеНоминала, 0)) / ЕСТЬNULL(_ЦенныеБумаги.Количество, 1)
		|		ИНАЧЕ ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиВВалютеНоминала, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупонаВВалютеНоминала, 0)
		|	КОНЕЦ,
		|	ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидЦеннойБумаги,
		|	НаименованиеЭмитента
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("Биржа_ММВБ", Биржа_ММВБ);
	
	ВыборкаИнформацияОбЭмитентах = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаИнформацияОбЭмитентах.Количество() > 0 Тогда
		ШапкаИнформацияОбЭмитентах = МакетОтчета.ПолучитьОбласть("ШапкаИнформацияОбЭмитентах");
		ТаблицаОтчета.Вывести(ШапкаИнформацияОбЭмитентах);
	КонецЕсли;
	
	Пока ВыборкаИнформацияОбЭмитентах.Следующий() Цикл
		СтрокаИнформацияОбЭмитентах.Параметры.Заполнить(ВыборкаИнформацияОбЭмитентах);
		
		Если ВыборкаИнформацияОбЭмитентах.ВидЦеннойБумаги = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
		ИначеЕсли ВыборкаИнформацияОбЭмитентах.ВидЦеннойБумаги = Перечисления.РынкиЦенныхБумаг.Паи Тогда
			Если ЗначениеЗаполнено(ВыборкаИнформацияОбЭмитентах.ПаевойИнвестиционныйФонд) Тогда
				СтрокаИнформацияОбЭмитентах.Параметры.НаименованиеЭмитента = Строка(Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФНаДату(ЭтотОбъект.Период.ДатаОкончания, ВыборкаИнформацияОбЭмитентах.ПаевойИнвестиционныйФонд)) + " " + СтрокаИнформацияОбЭмитентах.Параметры.НаименованиеЭмитента;
				
				СтрокаИнформацияОбЭмитентах.Параметры.Наименование = Строка(Справочники.УправляющиеКомпании.ПолучитьУправляющуюКомпаниюПИФНаДату(ЭтотОбъект.Период.ДатаОкончания, ВыборкаИнформацияОбЭмитентах.ПаевойИнвестиционныйФонд)) + " " + СтрокаИнформацияОбЭмитентах.Параметры.Наименование;
				
			КонецЕсли;
			СтрокаИнформацияОбЭмитентах.Параметры.ДоходностьКПогашениюОферте = 0;
		Иначе	
			СтрокаИнформацияОбЭмитентах.Параметры.ДоходностьКПогашениюОферте = 0;
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(СтрокаИнформацияОбЭмитентах);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиОблигации(МакетОтчета, ТаблицаОтчета, ВидУчета, ДатаЗапретаРедактирования, МенеджерВременныхТаблицПоПартям, ТекущиеВременныеТаблицы, ВалютаИнвестиционногоПрофиля)
	
	СтрокаОблигации = МакетОтчета.ПолучитьОбласть("СтрокаОблигации");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, , ТекущиеВременныеТаблицы);	
	
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПартииЦенныхБумаг.Партия.Дата КАК ДатаПокупки,
		|	_ПартииЦенныхБумаг.Количество КАК Количество,
		|	_ЦенныеБумагиДоЗамещения.ЦеннаяБумагаДоЗамещения КАК ЦеннаяБумагаДоЗамещения
		|ПОМЕСТИТЬ _ДатыПокупкиОблигаций
		|ИЗ
		|	_ПартииЦенныхБумаг КАК _ПартииЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО _ПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И _ПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|			И (ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен)
		|			И (НЕ ВводЦенныхБумагЦенныеБумаги.Ссылка.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|		ПО _ПартииЦенныхБумаг.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
		|			И _ПартииЦенныхБумаг.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
		|			И (РеклассификацияАктивовЕПСПартии.Ссылка.Проведен)
		|			И (НЕ РеклассификацияАктивовЕПСПартии.Ссылка.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиДоЗамещения КАК _ЦенныеБумагиДоЗамещения
		|		ПО _ПартииЦенныхБумаг.ЦеннаяБумага = _ЦенныеБумагиДоЗамещения.ЦеннаяБумага
		|ГДЕ
		|	_ПартииЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	ДатаПокупки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыПокупкиОблигаций.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МИНИМУМ(_ДатыПокупкиОблигаций.ЦеннаяБумагаДоЗамещения) КАК ЦеннаяБумагаДоЗамещения,
		|	МИНИМУМ(_ДатыПокупкиОблигаций.ДатаПокупки) КАК ДатаПокупки
		|ПОМЕСТИТЬ _ПервоначальнаяДатаПокупкиОблигаций
		|ИЗ
		|	_ДатыПокупкиОблигаций КАК _ДатыПокупкиОблигаций
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыПокупкиОблигаций.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПервоначальнаяДатаПокупкиОблигаций.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ВЫРАЗИТЬ(ВЫБОР
		|				КОГДА КурсВалюты.Валюта = КурсВалютыИнвестиционногоПрофиля.Валюта
		|					ТОГДА ОплатаОснования.СуммаОплатыКупона
		|				ИНАЧЕ ОплатаОснования.СуммаОплатыКупона * (ЕСТЬNULL(КурсВалюты.Курс, 1) / ЕСТЬNULL(КурсВалюты.Кратность, 1)) / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1))
		|			КОНЕЦ КАК ЧИСЛО(15, 2))) КАК КупонныйДоходЗачисленный,
		|	СУММА(ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.ПогашениеКупона).Количество) КАК Количество,
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ) КАК ДатаОперации
		|ПОМЕСТИТЬ _ВсегоЗачисленоКупонов
		|ИЗ
		|	_ПервоначальнаяДатаПокупкиОблигаций КАК _ПервоначальнаяДатаПокупкиОблигаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|			ПО ОперацииСЦеннымиБумагами.Операция = ОплатаОснования.Ссылка
		|				И (ОплатаОснования.Основание = ОперацииСЦеннымиБумагами.Основание)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалюты
		|			ПО (КурсВалюты.Валюта = ОплатаОснования.Ссылка.ВалютаОплаты)
		|				И (НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.Основание.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалюты.Период, ДЕНЬ))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
		|			ПО (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
		|				И (НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.Основание.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(КурсВалютыИнвестиционногоПрофиля.Период, ДЕНЬ))
		|		ПО (_ПервоначальнаяДатаПокупкиОблигаций.ЦеннаяБумага = ОперацииСЦеннымиБумагами.ЦеннаяБумага
		|				ИЛИ _ПервоначальнаяДатаПокупкиОблигаций.ЦеннаяБумагаДоЗамещения = ОперацииСЦеннымиБумагами.ЦеннаяБумага)
		|			И (ОперацииСЦеннымиБумагами.Организация = &Организация)
		|			И (ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (ОперацииСЦеннымиБумагами.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			И (ОперацииСЦеннымиБумагами.Основание ССЫЛКА Документ.ПогашениеКупона)
		|			И (ОперацииСЦеннымиБумагами.Операция ССЫЛКА Документ.Оплата)
		|			И (ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ НАЧАЛОПЕРИОДА(_ПервоначальнаяДатаПокупкиОблигаций.ДатаПокупки, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПервоначальнаяДатаПокупкиОблигаций.ЦеннаяБумага,
		|	НАЧАЛОПЕРИОДА(ОперацииСЦеннымиБумагами.ДатаОперации, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыПокупкиОблигаций.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ВЫРАЗИТЬ(ВЫБОР
		|				КОГДА _ДатыПокупкиОблигаций.Количество >= _ВсегоЗачисленоКупонов.Количество
		|					ТОГДА _ВсегоЗачисленоКупонов.КупонныйДоходЗачисленный
		|				ИНАЧЕ _ВсегоЗачисленоКупонов.КупонныйДоходЗачисленный * _ДатыПокупкиОблигаций.Количество / _ВсегоЗачисленоКупонов.Количество
		|			КОНЕЦ КАК ЧИСЛО(15, 2))) КАК КупонныйДоходЗачисленный
		|ПОМЕСТИТЬ _ОблигацииКупонныйДоходЗачисленный
		|ИЗ
		|	_ДатыПокупкиОблигаций КАК _ДатыПокупкиОблигаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВсегоЗачисленоКупонов КАК _ВсегоЗачисленоКупонов
		|		ПО _ДатыПокупкиОблигаций.ЦеннаяБумага = _ВсегоЗачисленоКупонов.ЦеннаяБумага
		|			И (_ВсегоЗачисленоКупонов.ДатаОперации МЕЖДУ НАЧАЛОПЕРИОДА(_ДатыПокупкиОблигаций.ДатаПокупки, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДатыПокупкиОблигаций.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследнихISIN.Код КАК ISIN,
		|	ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Код, РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу + "" "" + _ЦенныеБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер) КАК Наименование,
		|	ЕСТЬNULL(_ЦенныеБумаги.Количество, _ЦеныИзСЧА.Количество) КАК Количество,
		|	ПРЕДСТАВЛЕНИЕ(_ЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала) КАК Валюта,
		|	ЕСТЬNULL(_ЦеныИзСЧА.Цена, 0) КАК ТекущаяЦена,
		|	ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0) КАК ТекущаяСтоимость,
		|	ЕСТЬNULL(_ОблигацииКупонныйДоходЗачисленный.КупонныйДоходЗачисленный, 0) КАК КупонныйДоходЗачисленный,
		|	ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0) + ЕСТЬNULL(_ЦенныеБумаги.РасходыПриПокупкеВСтоимостиВВалютеУчета, 0) КАК СтоимостьПриобретения,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_ЦенныеБумаги.Количество, 0) <> 0
		|			ТОГДА ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) / ЕСТЬNULL(_ЦенныеБумаги.Количество, 1)
		|		ИНАЧЕ ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0)
		|	КОНЕЦ КАК ЦенаПриобретения,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|			ТОГДА 0
		|		ИНАЧЕ (ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|	КОНЕЦ КАК Доля
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _ЦенныеБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБКраткий)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБКраткий.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныИзСЧА КАК _ЦеныИзСЧА
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ЦеныИзСЧА.ЦеннаяБумага
		|			И _ЦенныеБумаги.Рынок = _ЦеныИзСЧА.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОблигацииКупонныйДоходЗачисленный КАК _ОблигацииКупонныйДоходЗачисленный
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ОблигацииКупонныйДоходЗачисленный.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|ГДЕ
		|	_ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
