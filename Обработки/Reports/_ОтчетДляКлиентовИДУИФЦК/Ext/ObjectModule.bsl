		ПодвалДепозитыМНО = МакетОтчета.ПолучитьОбласть("ПодвалДепозитыМНО");
		ПодвалДепозитыМНО.Параметры.Заполнить(ВыборкаДепозитыМНО);
		
		ПодвалДепозитыМНО.Параметры.Изменения = ВыборкаДепозитыМНО.ТекущаяСтоимость + ВыборкаДепозитыМНО.ПроцентныйДоходЗачисленный - ВыборкаДепозитыМНО.СуммаРазмещения;
		
		ВременнаяТаблицаОтчета.Вывести(ПодвалДепозитыМНО);
	КонецЦикла;
	
	Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
		
		Если Не ТаблицаОтчета.ПроверитьВывод(ВременнаяТаблицаОтчета) Тогда
			ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиДенежныеСредства(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям)
	
	СтрокаДенежныеСредства = МакетОтчета.ПолучитьОбласть("СтрокаДенежныеСредства");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДенежныеСредства.Валюта КАК Валюта,
		|	_ДанныеДенежныеСредства.ТекущаяСтоимость КАК ТекущаяСтоимость,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|			ТОГДА 0
		|		ИНАЧЕ _ДанныеДенежныеСредства.ТекущаяСтоимость / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|	КОНЕЦ КАК Доля
		|ИЗ
		|	_ДанныеДенежныеСредства КАК _ДанныеДенежныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Валюта
		|АВТОУПОРЯДОЧИВАНИЕ";		
	
	ВременнаяТаблицаОтчета = Новый ТабличныйДокумент;
	
	ВыборкаДенежныеСредства = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДенежныеСредства.Количество() > 0 Тогда
		ШапкаДенежныеСредства = МакетОтчета.ПолучитьОбласть("ШапкаДенежныеСредства");
		ВременнаяТаблицаОтчета.Вывести(ШапкаДенежныеСредства);
	КонецЕсли;
	
	Пока ВыборкаДенежныеСредства.Следующий() Цикл
		СтрокаДенежныеСредства.Параметры.Заполнить(ВыборкаДенежныеСредства);
		
		ВременнаяТаблицаОтчета.Вывести(СтрокаДенежныеСредства);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ДанныеДенежныеСредства.ТекущаяСтоимость) КАК ТекущаяСтоимость,
		|	СУММА(ВЫБОР
		|			КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|				ТОГДА 0
		|			ИНАЧЕ _ДанныеДенежныеСредства.ТекущаяСтоимость / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|		КОНЕЦ) КАК Доля
		|ИЗ
		|	_ДанныеДенежныеСредства КАК _ДанныеДенежныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(_ДанныеДенежныеСредства.ТекущаяСтоимость) ЕСТЬ NULL";		
	
	ВыборкаДенежныеСредства = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДенежныеСредства.Следующий() Цикл
		ПодвалДенежныеСредства = МакетОтчета.ПолучитьОбласть("ПодвалДенежныеСредства");
		
		ПодвалДенежныеСредства.Параметры.Заполнить(ВыборкаДенежныеСредства);
		
		ВременнаяТаблицаОтчета.Вывести(ПодвалДенежныеСредства);
	КонецЦикла;
	
	Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
		
		Если Не ТаблицаОтчета.ПроверитьВывод(ВременнаяТаблицаОтчета) Тогда
			ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиСтраницаИнформацияПоОблигациям(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям)
	
	Область = МакетОтчета.ПолучитьОбласть("СтраницаИнформацияПоОблигациям");
	
	ОтобразитьДиаграммуРаспределениеПоСтранам(Область, МенеджерВременныхТаблицПоПартям);
	ОтобразитьДиаграммуРаспределениеПоСекторам(Область, МенеджерВременныхТаблицПоПартям);
	ОтобразитьДиаграммуРаспределениеПоДюрации(Область, МенеджерВременныхТаблицПоПартям);
	
	ТаблицаОтчета.Вывести(Область);
	
КонецПроцедуры

Процедура ВывестиИтогоПоПортфелю(МакетОтчета, ТаблицаОтчета, МенеджерВременныхТаблицПоПартям)
	
	РыночнаяСтоимостьАктивов = 0;
	СЧА = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаВВалютеУчета
	               |ИЗ
	               |	_СуммыДляИтогов КАК _СуммыДляИтогов";
	
	ВыборкаИтогоПоПортфелю = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаИтогоПоПортфелю.Следующий() Цикл
		РыночнаяСтоимостьАктивов = ВыборкаИтогоПоПортфелю.СуммаВВалютеУчета;
		СЧА = РыночнаяСтоимостьАктивов;
	КонецЦикла;
	
	ВременнаяТаблицаОтчета = Новый ТабличныйДокумент;
	
	ШапкаИтогоПоПорфелю = МакетОтчета.ПолучитьОбласть("ШапкаИтогоПоПорфелю");
	ВременнаяТаблицаОтчета.Вывести(ШапкаИтогоПоПорфелю);
	
	СтрокаИтогоПоПорфелю = МакетОтчета.ПолучитьОбласть("СтрокаИтогоПоПорфелю");
	
	СтрокаИтогоПоПорфелю.Параметры.Показатель = "Рыночная стоимость активов";
	СтрокаИтогоПоПорфелю.Параметры.ТекущаяСтоимость = РыночнаяСтоимостьАктивов;
	СтрокаИтогоПоПорфелю.Параметры.Доля = 100;
	
	ВременнаяТаблицаОтчета.Вывести(СтрокаИтогоПоПорфелю);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_КредиторскаяЗадолженность.ВидЗадолженности КАК ВидЗадолженности,
	               |	СУММА(_КредиторскаяЗадолженность.СуммаОстаток) КАК СуммаВВалютеУчета
	               |ИЗ
	               |	_КредиторскаяЗадолженность КАК _КредиторскаяЗадолженность
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	_КредиторскаяЗадолженность.ВидЗадолженности
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВидЗадолженности";
	
	ВыборкаИтогоПоПортфелю = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаИтогоПоПортфелю.Следующий() Цикл
		СтрокаИтогоПоПорфелю.Параметры.Показатель = ВыборкаИтогоПоПортфелю.ВидЗадолженности;
		СтрокаИтогоПоПорфелю.Параметры.ТекущаяСтоимость = ВыборкаИтогоПоПортфелю.СуммаВВалютеУчета;
		СтрокаИтогоПоПорфелю.Параметры.Доля = 0;
		
		ВременнаяТаблицаОтчета.Вывести(СтрокаИтогоПоПорфелю);
		
		СЧА = СЧА - ВыборкаИтогоПоПортфелю.СуммаВВалютеУчета;
	КонецЦикла;
	
	СтрокаИтогоПоПорфелю.Параметры.Показатель = "Стоимость чистых активов";
	СтрокаИтогоПоПорфелю.Параметры.ТекущаяСтоимость = СЧА;
	СтрокаИтогоПоПорфелю.Параметры.Доля = 0;
	
	ВременнаяТаблицаОтчета.Вывести(СтрокаИтогоПоПорфелю);
	
	Если ВременнаяТаблицаОтчета.ВысотаТаблицы > 0 Тогда
		
		Если Не ТаблицаОтчета.ПроверитьВывод(ВременнаяТаблицаОтчета) Тогда
			ТаблицаОтчета.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
		
	КонецЕсли;	
КонецПроцедуры

