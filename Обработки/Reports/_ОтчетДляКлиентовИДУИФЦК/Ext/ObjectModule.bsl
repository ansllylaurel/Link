		|	Наименование
		|АВТОУПОРЯДОЧИВАНИЕ";		
	
	ВременнаяТаблицаОтчета = Новый ТабличныйДокумент;
	
	КоличествоСтраницДоПрисоединенияРаздела = ТаблицаОтчета.КоличествоСтраниц();
	
	ВыборкаАкции = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаАкции.Количество() > 0 Тогда
		ШапкаАкции = МакетОтчета.ПолучитьОбласть("ШапкаАкции");
		ВременнаяТаблицаОтчета.Вывести(ШапкаАкции);
	КонецЕсли;
	
	Пока ВыборкаАкции.Следующий() Цикл
		СтрокаАкции.Параметры.Заполнить(ВыборкаАкции);
		
		Если ЗначениеЗаполнено(ВыборкаАкции.ЦенаПриобретения) Тогда
			СтрокаАкции.Параметры.Изменение = (ВыборкаАкции.ТекущаяЦена/ВыборкаАкции.ЦенаПриобретения - 1)*100;
		Иначе
			СтрокаАкции.Параметры.Изменение = 0;
		КонецЕсли;	
		
		СтрокаАкции.Параметры.ИзмененияСУчетомДивидендов = ВыборкаАкции.ТекущаяСтоимость + ВыборкаАкции.ДивидендыЗачисленные - ВыборкаАкции.СтоимостьПриобретения;
		
		ВременнаяТаблицаОтчета.Вывести(СтрокаАкции);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) КАК ТекущаяСтоимость,
		|	СУММА(ЕСТЬNULL(_АкцииДивидендыЗачисленные.ЗачисленныеДивиденды, 0)) КАК ДивидендыЗачисленные,
		|	СУММА(ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0) + ЕСТЬNULL(_ЦенныеБумаги.РасходыПриПокупкеВСтоимостиВВалютеУчета, 0)) КАК СтоимостьПриобретения,
		|	СУММА(ВЫБОР
		|			КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|				ТОГДА 0
		|			ИНАЧЕ (ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|		КОНЕЦ) КАК Доля
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныИзСЧА КАК _ЦеныИзСЧА
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ЦеныИзСЧА.ЦеннаяБумага
		|			И _ЦенныеБумаги.Рынок = _ЦеныИзСЧА.Рынок
