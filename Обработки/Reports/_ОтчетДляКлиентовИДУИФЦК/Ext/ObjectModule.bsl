			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	_ПервыйВводАктивов.Период КАК Период
			|ИЗ
			|	_ПервыйВводАктивов КАК _ПервыйВводАктивов";
			
			РезультатЗапроса = ЗапросПоПартиям.Выполнить();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				ЭтотОбъект.Период.ДатаНачала = НачалоДня(Выборка.Период);
				ЗапросПоПартиям.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
