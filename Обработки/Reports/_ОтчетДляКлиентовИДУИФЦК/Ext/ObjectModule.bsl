// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет для клиентов ИДУ и ФЦК",
		"0.18",
		,
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции 

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СтандартнаяОбработка = Ложь;
	
	ДокументРезультат.Очистить();
	
	ВидУчета = Неопределено;
	ДатаЗапретаРедактирования = Дата(1, 1, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет КАК ВестиЕдиныйБухгалтерскийУчет,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет КАК ВестиНалоговыйУчет,
		|	ДЗ_БУ.ДатаЗапретаРедактирования КАК БухгалтерскийУчетДата,
		|	ДЗ_НУ.ДатаЗапретаРедактирования КАК НалоговыйУчетДата,
		|	ДЗ_ЕПС.ДатаЗапретаРедактирования КАК ЕдиныйБухгалтерскийУчетДата,
		|	ЕСТЬNULL(ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта, &ВалютаРубль) КАК ВалютаИнвестиционногоПрофиля,
		|	ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) / ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1) КАК КурсВалютыИнвестиционногоПрофиля
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДЗ_БУ
		|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ДЗ_БУ.СчетДоверительногоУправления
		|			И (ДЗ_БУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		|			И (ДЗ_БУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДЗ_НУ
		|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ДЗ_НУ.СчетДоверительногоУправления
		|			И (ДЗ_НУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		|			И (ДЗ_НУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДЗ_ЕПС
		|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ДЗ_ЕПС.СчетДоверительногоУправления
		|			И (ДЗ_ЕПС.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		|			И (ДЗ_ЕПС.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеПрофили.СрезПоследних(&КонецПериода, Организация = &Организация) КАК ИнвестиционныеПрофилиСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&КонецПериода, ) КАК КурсыВалютСрезПоследних
		|			ПО (ЕСТЬNULL(ИнвестиционныеПрофилиСрезПоследних.Цель.Валюта, &ВалютаРубль) = КурсыВалютСрезПоследних.Валюта)
		|		ПО НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления = ИнвестиционныеПрофилиСрезПоследних.СубъектУчета
		|			И (&КонецПериода МЕЖДУ ВЫБОР
		|				КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|					ТОГДА ИнвестиционныеПрофилиСрезПоследних.НачалоПериодаГоризонта
		|				КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|					ТОГДА НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения
		|				ИНАЧЕ ИнвестиционныеПрофилиСрезПоследних.Период
		|			КОНЕЦ И ВЫБОР
		|				КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|					ТОГДА ИнвестиционныеПрофилиСрезПоследних.ОкончаниеПериодаГоризонта
		|				КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|					ТОГДА ДОБАВИТЬКДАТЕ(НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения, ГОД, ИнвестиционныеПрофилиСрезПоследних.ОтносительныйСрокГоризонта)
		|				ИНАЧЕ ДОБАВИТЬКДАТЕ(ИнвестиционныеПрофилиСрезПоследних.Период, ГОД, ИнвестиционныеПрофилиСрезПоследних.ОтносительныйСрокГоризонта)
		|			КОНЕЦ)";
	
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВалютаРубль", ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	КурсВалютыИнвестиционногоПрофиля = 1;
	ВалютаИнвестиционногоПрофиля = ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.ВестиЕдиныйБухгалтерскийУчет Тогда
				ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
				ДатаЗапретаРедактирования = ВыборкаДетальныеЗаписи.ЕдиныйБухгалтерскийУчетДата;
			ИначеЕсли ВыборкаДетальныеЗаписи.ВестиБухгалтерскийУчет Тогда	
				ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет;
				ДатаЗапретаРедактирования = ВыборкаДетальныеЗаписи.БухгалтерскийУчетДата;
			ИначеЕсли ВыборкаДетальныеЗаписи.ВестиНалоговыйУчет Тогда	
				ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет;
				ДатаЗапретаРедактирования = ВыборкаДетальныеЗаписи.НалоговыйУчетДата;
			КонецЕсли;	
			
			КурсВалютыИнвестиционногоПрофиля = ВыборкаДетальныеЗаписи.КурсВалютыИнвестиционногоПрофиля;
			ВалютаИнвестиционногоПрофиля = ВыборкаДетальныеЗаписи.ВалютаИнвестиционногоПрофиля;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ВидУчета) Тогда
			
			#Область Запрос
			
			МенеджерВременныхТаблицПоПартям = Новый МенеджерВременныхТаблиц;
			
			ЗапросПоПартиям = Новый Запрос;
			ЗапросПоПартиям.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
			
			ЗапросПоПартиям.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
			ЗапросПоПартиям.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
			ЗапросПоПартиям.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
			ЗапросПоПартиям.УстановитьПараметр("ВидУчета", ВидУчета);
			ЗапросПоПартиям.УстановитьПараметр("ВалютаРубль", ОбщегоНазначенияПовтИсп.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
			ЗапросПоПартиям.УстановитьПараметр("КурсВалютыИнвестиционногоПрофиля", КурсВалютыИнвестиционногоПрофиля);
			ЗапросПоПартиям.УстановитьПараметр("БиржаММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
			ЗапросПоПартиям.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
			
			
			Если НачалоДня(ДатаЗапретаРедактирования) >= НачалоДня(ЭтотОбъект.Период.ДатаОкончания) Тогда
				//Партии сформированы. Получаем по партиям.
				
				ЗапросПоПартиям.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
				|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = ВводЦенныхБумагЦенныеБумаги.Количество
				|							ТОГДА ВводЦенныхБумагЦенныеБумаги.СуммаРынокВВалютеУчета
				|						ИНАЧЕ ВводЦенныхБумагЦенныеБумаги.СуммаРынокВВалютеУчета * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ВводЦенныхБумагЦенныеБумаги.Количество
				|					КОНЕЦ
				|			КОГДА ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Замещающая, ЛОЖЬ) = ИСТИНА
				|					И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ПоставкаЦенныхБумаг))
				|					И НЕ ОперацииСЦеннымиБумагами.Количество ЕСТЬ NULL
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = ОперацииСЦеннымиБумагами.Количество
				|							ТОГДА ОперацииСЦеннымиБумагами.Сумма
				|						ИНАЧЕ ОперацииСЦеннымиБумагами.Сумма * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ОперацииСЦеннымиБумагами.Количество
				|					КОНЕЦ
				|			КОГДА ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Замещающая, ЛОЖЬ) = ИСТИНА
				|					И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ПоставкаЦенныхБумаг))
				|					И НЕ ОперацииСЦеннымиБумагамиДоЗамещения.Количество ЕСТЬ NULL
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = ОперацииСЦеннымиБумагамиДоЗамещения.Количество
				|							ТОГДА ОперацииСЦеннымиБумагамиДоЗамещения.Сумма * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
				|						ИНАЧЕ ОперацииСЦеннымиБумагамиДоЗамещения.Сумма * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ОперацииСЦеннымиБумагамиДоЗамещения.Количество * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
				|					КОНЕЦ
				|			ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
				|		КОНЕЦ / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК СтоимостьПокупки,
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = ВводЦенныхБумагЦенныеБумаги.Количество
				|							ТОГДА ВводЦенныхБумагЦенныеБумаги.СуммаКупонаРынокВВалютеУчета
				|						ИНАЧЕ ВводЦенныхБумагЦенныеБумаги.СуммаКупонаРынокВВалютеУчета * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ВводЦенныхБумагЦенныеБумаги.Количество
				|					КОНЕЦ
				|			КОГДА ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Замещающая, ЛОЖЬ) = ИСТИНА
				|					И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ПоставкаЦенныхБумаг))
				|					И НЕ ОперацииСЦеннымиБумагами.Количество ЕСТЬ NULL
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = ОперацииСЦеннымиБумагами.Количество
				|							ТОГДА ОперацииСЦеннымиБумагами.СуммаКупона
				|						ИНАЧЕ ОперацииСЦеннымиБумагами.СуммаКупона * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ОперацииСЦеннымиБумагами.Количество
				|					КОНЕЦ
				|			КОГДА ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Замещающая, ЛОЖЬ) = ИСТИНА
				|					И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
				|						ИЛИ ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ПоставкаЦенныхБумаг))
				|					И НЕ ОперацииСЦеннымиБумагамиДоЗамещения.Количество ЕСТЬ NULL
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = ОперацииСЦеннымиБумагамиДоЗамещения.Количество
				|							ТОГДА ОперацииСЦеннымиБумагамиДоЗамещения.СуммаКупона * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
				|						ИНАЧЕ ОперацииСЦеннымиБумагамиДоЗамещения.СуммаКупона * БухПартииЦенныхБумагОстатки.КоличествоОстаток / ОперацииСЦеннымиБумагамиДоЗамещения.Количество * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
				|					КОНЕЦ
				|			ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток * ЕСТЬNULL(КурсыВалют.Курс, 1) / ЕСТЬNULL(КурсыВалют.Кратность, 1)
				|		КОНЕЦ / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК СтоимостьПокупкиКупона,
				|	ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток / (ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Курс, 1) / ЕСТЬNULL(КурсВалютыИнвестиционногоПрофиля.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК РасходыПриПокупкеВСтоимостиВВалютеУчета,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|			ТОГДА ВводЦенныхБумагЦенныеБумаги.СуммаРынок
				|		ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток
				|	КОНЕЦ КАК СтоимостьПокупкиВВалютеНоминала,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|			ТОГДА ВводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок
				|		ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток
				|	КОНЕЦ КАК СтоимостьПокупкиКупонаВВалютеНоминала,
				|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК Стоимость,
				|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупона,
				|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК СтоимостьВВалютеУчета,
				|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК СтоимостьКупонаВВалютеУчета,
				|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
				|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|			ТОГДА ВЫБОР
				|					КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки ЕСТЬ NULL
				|						ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ)
				|					КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки = ДАТАВРЕМЯ(1, 1, 1)
				|						ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ)
				|					ИНАЧЕ НАЧАЛОПЕРИОДА(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, ДЕНЬ)
				|				КОНЕЦ
				|		ИНАЧЕ НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ)
				|	КОНЕЦ КАК ДатаПриобретения,
				|	ОперацииСЦеннымиБумагамиДоЗамещения.ЦеннаяБумага КАК ЦеннаяБумагаДоЗамещения
				|ПОМЕСТИТЬ _ПартииЦенныхБумаг
				|ИЗ
				|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
				|			&ДатаОкончания,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидУчета = &ВидУчета) КАК БухПартииЦенныхБумагОстатки
				|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
				|		ПО БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
				|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
				|		ПО (БухПартииЦенныхБумагОстатки.Партия = ОперацииСЦеннымиБумагами.Регистратор
				|			И БухПартииЦенныхБумагОстатки.ЦеннаяБумага = ОперацииСЦеннымиБумагами.ЦеннаяБумага И ОперацииСЦеннымиБумагами.СтрокаПартии = 0)
				|				ИЛИ (БухПартииЦенныхБумагОстатки.Партия = ОперацииСЦеннымиБумагами.Регистратор И БухПартииЦенныхБумагОстатки.СтрокаПартии = ОперацииСЦеннымиБумагами.СтрокаПартии И ОперацииСЦеннымиБумагами.СтрокаПартии <> 0)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагамиДоЗамещения
				|		ПО БухПартииЦенныхБумагОстатки.Партия = ОперацииСЦеннымиБумагамиДоЗамещения.Регистратор
				|			И БухПартииЦенныхБумагОстатки.ЦеннаяБумага <> ОперацииСЦеннымиБумагамиДоЗамещения.ЦеннаяБумага
				|			И (ОперацииСЦеннымиБумагамиДоЗамещения.СтрокаПартии = 0
				|				ИЛИ БухПартииЦенныхБумагОстатки.СтрокаПартии = ОперацииСЦеннымиБумагамиДоЗамещения.СтрокаПартии)
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
				|		ПО (ВЫБОР
				|				КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|					ТОГДА ВЫБОР
				|							КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки ЕСТЬ NULL
				|								ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ)
				|							КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки = ДАТАВРЕМЯ(1, 1, 1)
				|								ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ)
				|							ИНАЧЕ НАЧАЛОПЕРИОДА(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, ДЕНЬ)
				|						КОНЕЦ
				|				КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
				|					ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Дата, ДЕНЬ)
				|				ИНАЧЕ НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ)
				|			КОНЕЦ = КурсыВалют.Период)
				|			И БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ВалютаНоминала = КурсыВалют.Валюта
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыИнвестиционногоПрофиля
				|		ПО (ВЫБОР
				|				КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|					ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ)
				|				КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
				|					ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Дата, ДЕНЬ)
				|				ИНАЧЕ НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ)
				|			КОНЕЦ = КурсВалютыИнвестиционногоПрофиля.Период)
				|			И (КурсВалютыИнвестиционногоПрофиля.Валюта = &ВалютаИнвестиционногоПрофиля)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ПартииЦенныхБумаг.Рынок КАК Рынок,
				|	_ПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
				|	СУММА(_ПартииЦенныхБумаг.Количество) КАК Количество,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьПокупки) КАК СтоимостьПокупки,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьПокупкиКупона) КАК СтоимостьПокупкиКупона,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьПокупкиВВалютеНоминала) КАК СтоимостьПокупкиВВалютеНоминала,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьПокупкиКупонаВВалютеНоминала) КАК СтоимостьПокупкиКупонаВВалютеНоминала,
				|	СУММА(_ПартииЦенныхБумаг.Стоимость) КАК Стоимость,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьКупона) КАК СтоимостьКупона,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчета,
				|	СУММА(_ПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчета,
				|	СУММА(_ПартииЦенныхБумаг.РасходыПриПокупкеВСтоимостиВВалютеУчета) КАК РасходыПриПокупкеВСтоимостиВВалютеУчета
				|ПОМЕСТИТЬ _ЦенныеБумаги
				|ИЗ
				|	_ПартииЦенныхБумаг КАК _ПартииЦенныхБумаг
				|
				|СГРУППИРОВАТЬ ПО
				|	_ПартииЦенныхБумаг.Рынок,
				|	_ПартииЦенныхБумаг.ЦеннаяБумага";
				
				РезультатЗапроса = ЗапросПоПартиям.Выполнить();
				
			Иначе
				//Партий ещё нет, запускаем формирование партий.
				
				УстановитьПривилегированныйРежим(Истина);
				
				Отказ = Ложь;
				
				РасчетПартий = Обработки.РасчетПартий.Создать();
				
				РасчетПартий.Организация                  = ЭтотОбъект.Организация;
				РасчетПартий.СчетДоверительногоУправления = ЭтотОбъект.СчетДУ;
				РасчетПартий.ВидУчета                     = ВидУчета;
				РасчетПартий.НачалоПериода                = НачалоДня(ДатаЗапретаРедактирования) + 86400;
				РасчетПартий.КонецПериода                 = КонецДня(ЭтотОбъект.Период.ДатаОкончания);
				РасчетПартий.ТаблицаПлановыхОпераций	  = Неопределено;
				РасчетПартий.ВариантРасчета				  = Перечисления.ВариантыРасчетаПартий.ПолныйРасчет;
				
				РасчетПартий.РассчитатьПартии(Отказ);
				
				Если Отказ Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось динамически рассчитать партий по '" + ЭтотОбъект.СчетДУ + "' за период с " + Формат(НачалоДня(ДатаЗапретаРедактирования) + 86400, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"),,,, Отказ);
					Возврат;
				КонецЕсли;
				
				ПартииЦенныхБумаг = РасчетПартий.КонечныеОстаткиПартий.Выгрузить();
				
				УстановитьПривилегированныйРежим(Ложь);
				
				ПартииЦенныхБумаг.Свернуть("Рынок,ЦеннаяБумага,Партия,СтрокаПартии", "Количество,СтоимостьПокупки,СтоимостьПокупкиКупона,Стоимость,СтоимостьКупона,СтоимостьВВалютеУчета,СтоимостьКупонаВВалютеУчета,РасходыПриПокупкеВСтоимостиВВалютеУчета");
				
				СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПартииЦенныхБумаг, "_ПартииЦенныхБумагБезПерекурсовки", ЗапросПоПартиям.МенеджерВременныхТаблиц);
				
				ЗапросПоПартиям.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
				|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
				|	БухПартииЦенныхБумагОстатки.Количество КАК Количество,
				|	ВЫРАЗИТЬ(ВЫБОР
				|			КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.ВводЦенныхБумаг)
				|				ТОГДА ВЫБОР
				|						КОГДА БухПартииЦенныхБумагОстатки.Количество = ВводЦенныхБумагЦенныеБумаги.Количество
				|							ТОГДА ВводЦенныхБумагЦенныеБумаги.СуммаРынокВВалютеУчета
				|						ИНАЧЕ ВводЦенныхБумагЦенныеБумаги.СуммаРынокВВалютеУчета * БухПартииЦенныхБумагОстатки.Количество / ВводЦенныхБумагЦенныеБумаги.Количество
				|					КОНЕЦ
				|			КОГДА ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Замещающая, ЛОЖЬ) = ИСТИНА
				|					И (ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОстатки.Партия) = ТИП(Документ.Сделка)
