		|	Наименование
		|АВТОУПОРЯДОЧИВАНИЕ";	
	
	ВременнаяТаблицаОтчета = Новый ТабличныйДокумент;
	
	ВыборкаОблигации = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаОблигации.Количество() > 0 Тогда
		ШапкаОблигации = МакетОтчета.ПолучитьОбласть("ШапкаОблигации");
		ВременнаяТаблицаОтчета.Вывести(ШапкаОблигации);
	КонецЕсли;
	
	Пока ВыборкаОблигации.Следующий() Цикл
		СтрокаОблигации.Параметры.Заполнить(ВыборкаОблигации);
		
		Если ЗначениеЗаполнено(ВыборкаОблигации.ЦенаПриобретения) Тогда
			СтрокаОблигации.Параметры.Изменение = (ВыборкаОблигации.ТекущаяЦена/ВыборкаОблигации.ЦенаПриобретения - 1)*100;
		Иначе
			СтрокаОблигации.Параметры.Изменение = 0;
		КонецЕсли;	
		
		СтрокаОблигации.Параметры.ИзмененияСУчетомКупонногоДохода = ВыборкаОблигации.ТекущаяСтоимость + ВыборкаОблигации.КупонныйДоходЗачисленный - ВыборкаОблигации.СтоимостьПриобретения;
		
		ВременнаяТаблицаОтчета.Вывести(СтрокаОблигации);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) КАК ТекущаяСтоимость,
		|	СУММА(ЕСТЬNULL(_ОблигацииКупонныйДоходЗачисленный.КупонныйДоходЗачисленный, 0)) КАК КупонныйДоходЗачисленный,
		|	СУММА(ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупки, 0) + ЕСТЬNULL(_ЦенныеБумаги.СтоимостьПокупкиКупона, 0) + ЕСТЬNULL(_ЦенныеБумаги.РасходыПриПокупкеВСтоимостиВВалютеУчета, 0)) КАК СтоимостьПриобретения,
		|	СУММА(ВЫБОР
		|			КОГДА СтоимостьПереоценкиОбщая.СуммаИтог = 0
		|				ТОГДА 0
		|			ИНАЧЕ (ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) / СтоимостьПереоценкиОбщая.СуммаИтог * 100
		|		КОНЕЦ) КАК Доля
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныИзСЧА КАК _ЦеныИзСЧА
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ЦеныИзСЧА.ЦеннаяБумага
		|			И _ЦенныеБумаги.Рынок = _ЦеныИзСЧА.Рынок
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОблигацииКупонныйДоходЗачисленный КАК _ОблигацииКупонныйДоходЗачисленный
		|		ПО _ЦенныеБумаги.ЦеннаяБумага = _ОблигацииКупонныйДоходЗачисленный.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(_СуммыДляИтогов.ТекущаяСтоимость) КАК СуммаИтог
		|		ИЗ
		|			_СуммыДляИтогов КАК _СуммыДляИтогов) КАК СтоимостьПереоценкиОбщая
		|		ПО (ИСТИНА)
		|ГДЕ
		|	_ЦенныеБумаги.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|
		|ИМЕЮЩИЕ
		|	НЕ СУММА(ЕСТЬNULL(_ЦеныИзСЧА.Сумма, 0) + ЕСТЬNULL(_ЦеныИзСЧА.СуммаКупона, 0)) ЕСТЬ NULL";		
	
	ВыборкаОблигации = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаОблигации.Следующий() Цикл
		ПодвалОблигации = МакетОтчета.ПолучитьОбласть("ПодвалОблигации");
		
		ПодвалОблигации.Параметры.Заполнить(ВыборкаОблигации);
		
		ПодвалОблигации.Параметры.ИзмененияСУчетомКупонногоДохода = ВыборкаОблигации.ТекущаяСтоимость + ВыборкаОблигации.КупонныйДоходЗачисленный - ВыборкаОблигации.СтоимостьПриобретения;
		
		ВременнаяТаблицаОтчета.Вывести(ПодвалОблигации);
	КонецЦикла;
	
	ТаблицаОтчета.Вывести(ВременнаяТаблицаОтчета);
	
КонецПроцедуры

Процедура ВывестиАкции(МакетОтчета, ТаблицаОтчета, ВидУчета, ДатаЗапретаРедактирования, МенеджерВременныхТаблицПоПартям, ТекущиеВременныеТаблицы, ВалютаИнвестиционногоПрофиля)
	
	СтрокаАкции = МакетОтчета.ПолучитьОбласть("СтрокаАкции");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицПоПартям;
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, , ТекущиеВременныеТаблицы);	
	
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДУ);
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("ВалютаИнвестиционногоПрофиля", ВалютаИнвестиционногоПрофиля);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_ПартииЦенныхБумаг.Партия) = ТИП(Документ.ВводЦенныхБумаг)
		|			ТОГДА ВЫБОР
		|					КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки ЕСТЬ NULL
		|						ТОГДА ВЫРАЗИТЬ(_ПартииЦенныхБумаг.Партия КАК Документ.ВводЦенныхБумаг).Дата
		|					КОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки = ДАТАВРЕМЯ(1, 1, 1)
		|						ТОГДА ВЫРАЗИТЬ(_ПартииЦенныхБумаг.Партия КАК Документ.ВводЦенныхБумаг).Дата
		|					ИНАЧЕ ВводЦенныхБумагЦенныеБумаги.ДатаПокупки
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(_ПартииЦенныхБумаг.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
		|			ТОГДА ВЫБОР
		|					КОГДА РеклассификацияАктивовЕПСПартии.ДатаПокупки ЕСТЬ NULL
		|						ТОГДА ВЫРАЗИТЬ(_ПартииЦенныхБумаг.Партия КАК Документ.РеклассификацияАктивовЕПС).Дата
		|					КОГДА РеклассификацияАктивовЕПСПартии.ДатаПокупки = ДАТАВРЕМЯ(1, 1, 1)
		|						ТОГДА ВЫРАЗИТЬ(_ПартииЦенныхБумаг.Партия КАК Документ.РеклассификацияАктивовЕПС).Дата
		|					ИНАЧЕ РеклассификацияАктивовЕПСПартии.ДатаПокупки
