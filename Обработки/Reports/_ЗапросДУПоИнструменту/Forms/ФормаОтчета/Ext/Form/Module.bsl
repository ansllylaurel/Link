&НаКлиенте
Процедура СохранитьВWord(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Подписант) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран подписант");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан каталог для сохранения файла");
		Возврат;
	КонецЕсли;
	
	// Если отчет неактуален, сформируем заново
	Если Элементы.Результат.ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность	Тогда
		СкомпоноватьРезультат();
	КонецЕсли;	
	
	ВысотаТаблицы = Результат.ВысотаТаблицы;
	Если ВысотаТаблицы <= 2 Тогда		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для сохранения");
		Возврат;
	КонецЕсли;
	
	ШиринаТаблицы = Результат.ШиринаТаблицы;
	
	ОбщиеДанные = ПолучитьОбщиеРеквизиты();
	
	ИмяФайлаШаблона = ПолучитьИмяВременногоФайла("docx");
	ШаблонПисьма.Записать(ИмяФайлаШаблона);
	
	Отказ = Ложь;
	Попытка
		
		WordApp = Новый COMОбъект("Word.Application");
		WordApp.Application.Visible = Истина;		
						
		NewDoc = WordApp.Application.Documents.Add(ИмяФайлаШаблона, False, , True);
		
		WordVars = NewDoc.Variables;
				
		Для Каждого Реквизит Из ОбщиеДанные Цикл			
			WordVars.Item(Реквизит.Ключ).Value = Реквизит.Значение;
		КонецЦикла;
		
		NewDoc.Fields.Update();
		
		СчетаДЕПО = Новый Массив;
		
		WordTable = NewDoc.Application.ActiveDocument.Tables(1);
		WordRows = WordTable.Rows;
		Для НомерСтроки = 3 По ВысотаТаблицы Цикл
	                            		
			BeforeRow = WordRows.Item(НомерСтроки);
						
			Если НомерСтроки < ВысотаТаблицы Тогда
				WordRows.Add(BeforeRow);
			КонецЕсли;
						
			Для НомерКолонки = 1 По ШиринаТаблицы Цикл 
				
				InRow = WordRows.Item(НомерСтроки);	
				
				ТекОбласть = Результат.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
				ТекЗначение = СокрЛП(ТекОбласть.Текст);			
				
				// Номер счета ДЕПО
				Если НомерКолонки = 5 Тогда
					Если СчетаДЕПО.Найти(ТекЗначение) = Неопределено Тогда
						СчетаДЕПО.Добавить(ТекЗначение);
					КонецЕсли;
				КонецЕсли;
				
				InRow.Cells(НомерКолонки).Select();
				NewDoc.Application.Selection.InsertAfter(ТекЗначение);
				
				WordTable.Rows(НомерСтроки).AllowBreakAcrossPages = False;
				
			КонецЦикла;   
			     		
		КонецЦикла;   	
		
		WordTable.Borders.InsideLineStyle = 1;
		
		WordVars.Item("СчетаДЕПО").Value = ?(СчетаДепо.Количество() = 1, "счету ДЕПО ", "счетам ДЕПО ") + РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(СчетаДЕПО, ", ");
		
		NewDoc.Fields.Update();
						
		ТекИмяФайла = "Письмо_" + Формат(Отчет.Период, "ДФ=dd.MM.yyyy") + ".docx";
		NewDoc.SaveAs(Отчет.КаталогДанных + "\" + ТекИмяФайла);	                
				
	Исключение
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);	
				
	КонецПопытки;
	 	
	// удалим файлы шаблона
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаШаблона);
	Исключение
	КонецПопытки;
	
	Если Отказ Тогда
		ПоказатьПредупреждение(,"Формирование отчета в Word завершилось с ошибкой!");
	КонецЕсли;
	     
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Отчет.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Отчет.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Отчет.КаталогДанных + "\");

КонецПроцедуры


#КонецОбласти

#Область СЛУЖЕБНЫЕ_ПРОЦЕДУРЫ_И_ФУНКЦИИ

&НаСервере
Процедура УстановитьСвязиПараметровВыбораАктива()
	
	МассивСвязей = Новый Массив();
		
	Если ЗначениеЗаполнено(Отчет.Эмитент) Тогда
		
		НовыйОтбор = Новый СвязьПараметраВыбора("Отбор.Эмитент", "Отчет.Эмитент", РежимИзмененияСвязанногоЗначения.Очищать);	
		МассивСвязей.Добавить(НовыйОтбор);
			
	КонецЕсли;
	
	ФиксМассив = Новый ФиксированныйМассив(МассивСвязей);		
	Элементы.Актив.СвязиПараметровВыбора = ФиксМассив;

КонецПроцедуры

&НаСервере
Функция ПолучитьОбщиеРеквизиты()
	
	Реквизиты = Новый Структура("НаименованиеУК, Подписант, ПодписантДолжность", "", "", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеУК
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	                       
	Запрос.УстановитьПараметр("Период", Отчет.Период);
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Реквизиты, Выборка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Подписант) Тогда
		Реквизиты.Вставить("Подписант", СокрЛП(ЭтаФорма.Подписант));
		Реквизиты.Вставить("ПодписантДолжность", СокрЛП(ЭтаФорма.ПодписантДолжность));
	КонецЕсли;
	
	Возврат Реквизиты;
	
КонецФункции // ПолучитьОбщиеРеквизитыДляПечати

