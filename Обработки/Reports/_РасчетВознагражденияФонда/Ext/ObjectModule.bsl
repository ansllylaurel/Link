	#КонецОбласти
			
	РезультатПакета = Запрос.ВыполнитьПакет();	
	
	БазыРасчета						= РезультатПакета[РезультатПакета.ВГраница() - 2].Выгрузить();
	Клиенты							= РезультатПакета[РезультатПакета.ВГраница() - 1].Выгрузить();
	НастройкиРасчетаВознаграждения	= РезультатПакета[РезультатПакета.ВГраница()].Выгрузить();
		
	Клиенты.Индексы.Добавить("СчетДоверительногоУправления");
	НастройкиРасчетаВознаграждения.Индексы.Добавить("БазаРасчета");
	
	Если БазыРасчета.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена база для расчета вознаграждения");
		Возврат;
	КонецЕсли;
	
	Если Клиенты.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены данные по счету доверительного управления");
		Возврат;
	КонецЕсли;
	
	ТекущаяБазаРасчета = БазыРасчета[0];
		
	ДанныеДляРасчета = НастройкиРасчетаВознаграждения.Скопировать(
		Новый Структура("БазаРасчета", ТекущаяБазаРасчета.БазаРасчета));
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация",				ЭтотОбъект.Организация);
	ПараметрыРасчета.Вставить("ДатаРасчета",				ЭтотОбъект.Период.ДатаОкончания);
	ПараметрыРасчета.Вставить("БазаРасчета",				ТекущаяБазаРасчета.БазаРасчета);
	ПараметрыРасчета.Вставить("ДанныеДляРасчета",			ДанныеДляРасчета);
	ПараметрыРасчета.Вставить("РассчитанноеВознаграждение",	Неопределено); // для расчета ВУК по средней СЧА не требуется
	
	ВознаграждениеПоБазеРасчета = Справочники.БазыРасчета.РассчитатьВознаграждениеПоБазеРасчета(ПараметрыРасчета);
	
	Если ВознаграждениеПоБазеРасчета.Результат.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не рассчитано вознаграждение по настройкам");
		Возврат;
	КонецЕсли;

	Расчет = ВознаграждениеПоБазеРасчета.Результат[0];
	Если Расчет.СуммаВознаграждения = NULL Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не рассчитано вознаграждение: вероятно, СЧА рассчитано не за все дни выбранного периода");
		Возврат;
	КонецЕсли;
	
	СтрокаКлиента = Клиенты[0];
	ОбластьШапка.Параметры.Заполнить(СтрокаКлиента);
	ОбластьШапка.Параметры.Заполнить(Расчет);	
	
	ОбластьШапка.Параметры.КоличествоРабочихДнейВГоду 	= Расчет.ДнейВГоду;
	ОбластьШапка.Параметры.СуммаВознаграждения 			= Расчет.СуммаВознаграждения - СтрокаКлиента.НеобходимыеРасходыУК;
	Областьшапка.Параметры.ДатаЗаключения 				= Формат(СтрокаКлиента.ДатаЗаключения, "ДЛФ=DD");
	Областьшапка.Параметры.ДатаОтчета 					= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	Областьшапка.Параметры.ПериодОтчета 				= "с " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");	
	Областьшапка.Параметры.ПериодМесяц 					= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ='MMMM yyyy'");

	Если ТипЗнч(ЭтотОбъект.Подписант) = Тип("Структура") И ЭтотОбъект.Подписант.Свойство("КонтактноеЛицо") Тогда
		ОбластьШапка.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;	
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	
КонецПроцедуры
