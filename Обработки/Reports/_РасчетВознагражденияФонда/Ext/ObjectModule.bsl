// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Расчет вознаграждения Фонда",
		"0.14",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	Макет = ПолучитьМакет("Макет"); 
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	ДокументРезультат.Очистить();

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	Запрос.УстановитьПараметр("ДатаНачала",  					ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",  				КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация",   					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации",   		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НастройкаРасчетаВознаграждения", ОбщегоНазначения.ПолучитьИменованныйОбъект("Вознаграждение_ХМ_ПН"));

	#Область Текст_Запроса
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Наименование КАК Наименование,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	СчетаДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета,
		|	&ДатаНачала КАК НачалоБазовогоПериода,
		|	&ДатаОкончания КАК КонецБазовогоПериода,
		|	ВЫБОР
		|		КОГДА &ДатаНачала >= СчетаДоверительногоУправления.ДатаЗаключения
		|			ТОГДА &ДатаНачала
		|		ИНАЧЕ СчетаДоверительногоУправления.ДатаЗаключения
		|	КОНЕЦ КАК НачалоПериодаНачисления,
		|	ВЫБОР
		|		КОГДА &ДатаОкончания < СчетаДоверительногоУправления.ДатаРасторжения
		|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА &ДатаОкончания
		|		ИНАЧЕ КОНЕЦПЕРИОДА(СчетаДоверительногоУправления.ДатаРасторжения, ДЕНЬ)
		|	КОНЕЦ КАК КонецПериодаНачисления
		|ПОМЕСТИТЬ _КлиентыДействующиеНаДатуРасчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|	И СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.Выполнить();
		
	ДатаПоследнейСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	Если Не ЗначениеЗаполнено(ДатаПоследнейСЧА) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить настройки формирования СЧА за выбранный период для счета ДУ " + СокрЛП(ЭтотОбъект.СчетДоверительногоУправления), ЭтотОбъект.СчетДоверительногоУправления);
		Возврат;
	КонецЕсли;
	
	// Договора еще могло не быть на начало периода, тогда используем последний рабочий день до даты начала периода
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ДатаЗаключения") < НачалоДня(ЭтотОбъект.Период.ДатаНачала) Тогда	
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала);
	Иначе
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Период.ДатаНачала) - 1 , -1);
	КонецЕсли;

	РаботаСОтчетами.ПоместитьКомиссииПоСделкамЗаПериодВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, Новый Структура("ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода", ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода), "_КлиентыДействующиеНаДатуРасчета", Истина);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеНаДатуРасчета.Организация КАК Организация,
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _КлиентыДействующиеВБазовомПериоде
		|ИЗ
		|	_КлиентыДействующиеНаДатуРасчета КАК _КлиентыДействующиеНаДатуРасчета
		|ГДЕ
		|	_КлиентыДействующиеНаДатуРасчета.ДатаЗаключения <= _КлиентыДействующиеНаДатуРасчета.КонецБазовогоПериода
		|	И (_КлиентыДействующиеНаДатуРасчета.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ _КлиентыДействующиеНаДатуРасчета.ДатаРасторжения >= _КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеВБазовомПериоде.Организация КАК Организация,
		|	_КлиентыДействующиеВБазовомПериоде.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	"""" КАК ШаблонРасшифровки,
		|	НастройкиРасчетаВознаграждения.ВалютаРасчета КАК ВалютаРасчета,
		|	СоставляющиеНастройкиРасчета.Периодичность КАК ПериодичностьРасчета,
		|	СоставляющиеНастройкиРасчета.БазаРасчета КАК БазаРасчета,
		|	СоставляющиеНастройкиРасчета.ПараметрыРасчета КАК ПараметрыБазыРасчета,
		|	СоставляющиеНастройкиРасчета.Представление КАК Представление
		|ПОМЕСТИТЬ _НастройкиРасчетаВознаграждения
		|ИЗ
		|	_КлиентыДействующиеВБазовомПериоде КАК _КлиентыДействующиеВБазовомПериоде
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета КАК НастройкиРасчетаВознаграждения
		|		ПО (НастройкиРасчетаВознаграждения.Ссылка = &НастройкаРасчетаВознаграждения)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиРасчета.Составляющие КАК СоставляющиеНастройкиРасчета
		|		ПО (СоставляющиеНастройкиРасчета.Ссылка = &НастройкаРасчетаВознаграждения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_НастройкиРасчетаВознаграждения.Организация КАК Организация,
		|	_НастройкиРасчетаВознаграждения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НастройкиРасчетаВознаграждения.ШаблонРасшифровки КАК ШаблонРасшифровки
		|ПОМЕСТИТЬ _КлиентыСНастройкамиРасчета
		|ИЗ
		|	_НастройкиРасчетаВознаграждения КАК _НастройкиРасчетаВознаграждения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыАктивов.Период), ДЕНЬ) КАК ДатаПервогоВвода
		|ПОМЕСТИТЬ _ПервыеВводыАктивов
		|ИЗ
		|	_КлиентыДействующиеНаДатуРасчета КАК _КлиентыДействующиеНаДатуРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлиентыСНастройкамиРасчета КАК _КлиентыСНастройкамиРасчета
		|		ПО (_КлиентыСНастройкамиРасчета.СчетДоверительногоУправления = _КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыАктивов
		|		ПО (ВводыАктивов.Организация = _КлиентыДействующиеНаДатуРасчета.Организация)
		|			И (ВводыАктивов.СчетДоверительногоУправления = _КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления)
		|			И (ВводыАктивов.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход))
		|			И (ВводыАктивов.Период <= _КлиентыДействующиеНаДатуРасчета.КонецБазовогоПериода)
		|
		|СГРУППИРОВАТЬ ПО
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДействующиеНаДатуРасчета.Наименование КАК Наименование,
		|	_КлиентыДействующиеНаДатуРасчета.Организация КАК Организация,
		|	_КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КлиентыДействующиеНаДатуРасчета.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_КлиентыДействующиеНаДатуРасчета.КодСчета КАК КодСчета,
		|	_КлиентыДействующиеНаДатуРасчета.НомерДоговора КАК НомерДоговора,
		|	_КлиентыДействующиеНаДатуРасчета.ДатаЗаключения КАК ДатаЗаключения,
		|	_КлиентыДействующиеНаДатуРасчета.ДатаРасторжения КАК ДатаРасторжения,
		|	_КлиентыДействующиеНаДатуРасчета.ВалютаУчета КАК ВалютаУчета,
		|	_КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода КАК НачалоБазовогоПериода,
		|	_КлиентыДействующиеНаДатуРасчета.КонецБазовогоПериода КАК КонецБазовогоПериода,
		|	_КлиентыДействующиеНаДатуРасчета.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
		|	_КлиентыДействующиеНаДатуРасчета.КонецПериодаНачисления КАК КонецПериодаНачисления,
		|	_КлиентыСНастройкамиРасчета.ШаблонРасшифровки КАК ШаблонРасшифровки,
		|	КлиентыДУ.Клиент КАК Клиент,
		|	_КлиентыДействующиеНаДатуРасчета.ДатаЗаключения < НАЧАЛОПЕРИОДА(_КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода, ГОД) КАК ДоговорЗаключенДоТекущегоГода,
		|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(_КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода, ГОД), СЕКУНДА, -1) КАК КонецПредыдущегоГода,
		|	НАЧАЛОПЕРИОДА(_КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода, ГОД) КАК НачалоГода,
		|	ДЕНЬГОДА(КОНЕЦПЕРИОДА(_КлиентыДействующиеНаДатуРасчета.НачалоБазовогоПериода, ГОД)) КАК ДнейВГоду,
		|	_ПервыеВводыАктивов.ДатаПервогоВвода КАК ДатаПервогоВвода
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	_КлиентыДействующиеНаДатуРасчета КАК _КлиентыДействующиеНаДатуРасчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлиентыСНастройкамиРасчета КАК _КлиентыСНастройкамиРасчета
		|		ПО (_КлиентыСНастройкамиРасчета.СчетДоверительногоУправления = _КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПервыеВводыАктивов КАК _ПервыеВводыАктивов
		|		ПО (_ПервыеВводыАктивов.СчетДоверительногоУправления = _КлиентыДействующиеНаДатуРасчета.СчетДоверительногоУправления)
