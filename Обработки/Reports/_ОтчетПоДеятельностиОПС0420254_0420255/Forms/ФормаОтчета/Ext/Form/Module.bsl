&НаКлиенте
Процедура РезультатВыбор(Элемент, Область, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	
	ВариантФормы = РаботаСОтчетамиКлиентСервер.ПолучитьКлючВариантаОтчета(Отчет);	
	
	Если Элемент.ОтображениеСостояния.ДополнительныйРежимОтображения <> ДополнительныйРежимОтображения.НеИспользовать
		ИЛИ Не ЗначениеЗаполнено(ВариантФормы)
		ИЛИ ТипЗнч(Элемент.ТекущаяОбласть) <> Тип("ОбластьЯчеекТабличногоДокумента")
	Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЯчейки = Элемент.ТекущаяОбласть.Расшифровка;
	Если ТипЗнч(ДанныеЯчейки) = Тип("Структура") Тогда
		ПолеРасшифровки = ДанныеЯчейки.ИмяПоля;
	Иначе
		ПолеРасшифровки = ДанныеЯчейки;
	КонецЕсли;		
	
	Если ПустаяСтрока(ПолеРасшифровки) Тогда
		Возврат;	
	КонецЕсли;
	
	Расшифровка = СформироватьРасшифровкуНаСервере(ПолеРасшифровки, ДанныеЯчейки, ВариантФормы);
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыРасшифровки = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".", НаправлениеПоиска.СКонца)) + "ФормаРасшифровки";
	
	ФормаРасшифровки = ПолучитьФорму(ИмяФормыРасшифровки, , ЭтаФорма);  
	ФормаРасшифровки.Расшифровка = Расшифровка;
	
	Если ФормаРасшифровки.Открыта() Тогда
		ФормаРасшифровки.Активизировать();		
	Иначе
		ФормаРасшифровки.Открыть();
	КонецЕсли;
			
КонецПроцедуры

