#Область События_Формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Отчет.Организация    = ПараметрыСеанса.ТекущаяОрганизация;
	Отчет.Период.Вариант = ВариантСтандартногоПериода.ПрошлыйМесяц;
	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьВидимость();
	
КонецПроцедуры

#КонецОбласти

#Область Команды_Формы

&НаСервере
Процедура СформироватьНаСервере(АдресВХранилище = "", АдресВХранилищеСДаннымиДляРасшифровки = "")
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ТабДокумент = Новый ТабличныйДокумент;
		
	ОтчетОбъект.СформироватьОтчет(Результат, АдресВХранилище, АдресВХранилищеСДаннымиДляРасшифровки);	
	
	Если АдресВХранилищеСДаннымиДляРасшифровки <> "" Тогда
		АдресВХранилищеСДаннымиДляРасшифровки = ПоместитьВоВременноеХранилище(ПолучитьИзВременногоХранилища(АдресВХранилищеСДаннымиДляРасшифровки), ЭтаФорма.УникальныйИдентификатор);	
		Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("АдресВХранилищеСДаннымиДляРасшифровки", АдресВХранилищеСДаннымиДляРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период");
		Возврат;
	КонецЕсли;
	
	Если Отчет.Период.ДатаНачала <> НачалоГода(Отчет.Период.ДатаНачала) Тогда
		// Отчет по умолчанию формируется с начала года, поэтому спрашиваем
		Если Вопрос("Отчет должен формироваться с начала года, выбрана дата начала периода " + Формат(Отчет.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + ". Продолжить формирование с этой даты?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	АдресВХранилище 							= "";	
	АдресРезультатовЗапросовДляРасшифровки 		= "";
		
	СформироватьНаСервере(АдресВХранилище, АдресРезультатовЗапросовДляРасшифровки);
			
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НЕИСПОЛЬЗОВАТЬ");
	
	Если Отчет.ВывестиРасшифровкуСредневзвешенныхВложений Тогда
		
		Расшифровка = РасшифроватьВсеСредневзвешенныеВложенияНаСервере(АдресВХранилище);

		Если Расшифровка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИмяФормыРасшифровки = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".", НаправлениеПоиска.СКонца)) + "ФормаРасшифровки";
		
		ФормаРасшифровки = ПолучитьФорму(ИмяФормыРасшифровки, , ЭтаФорма);  
		ФормаРасшифровки.Расшифровка = Расшифровка;
		
		Если ФормаРасшифровки.Открыта() Тогда
			ФормаРасшифровки.Активизировать();		
		Иначе
			ФормаРасшифровки.Открыть();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

