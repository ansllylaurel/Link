КонецФункции

Функция ЗаполнитьРасходы_ПолучитьТекстЗапроса(ВидРасходов = Неопределено)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиОплатаУслугСпецДепозитария)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплатаУслугСпецДепозитария,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиОплатаУслугСпецДепозитарияВознаграждение)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплатаУслугСпецДепозитарияВознаграждение,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиОплатаУслугСпецДепозитарияНеобходимыеРасходы)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплатаУслугСпецДепозитарияНеобходимыеРасходы,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиОплатаРасходовУправляющейКомпании)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплатаРасходовУправляющейКомпании,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиОплатаРасходовНаСтрахованиеРиска)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплатаРасходовНаСтрахованиеРиска,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиОплатаУслугБанков)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ОплатаУслугБанков,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности В (&ВидыЗадолженностиПрочиеРасходы)
		|					ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК ПрочиеРасходы,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ _ПрочиеРасходы
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности В (&ВидыЗадолженности)) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствамОбороты.Период,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ПрочиеРасходы.ОплатаУслугСпецДепозитария) КАК ОплатаУслугСпецДепозитария,
		|	СУММА(_ПрочиеРасходы.ОплатаУслугСпецДепозитарияВознаграждение) КАК ОплатаУслугСпецДепозитарияВознаграждение,
		|	СУММА(_ПрочиеРасходы.ОплатаУслугСпецДепозитарияНеобходимыеРасходы) КАК ОплатаУслугСпецДепозитарияНеобходимыеРасходы,
		|	СУММА(_ПрочиеРасходы.ОплатаРасходовУправляющейКомпании) КАК ОплатаРасходовУправляющейКомпании,
		|	СУММА(_ПрочиеРасходы.ОплатаРасходовНаСтрахованиеРиска) КАК ОплатаРасходовНаСтрахованиеРиска,
		|	СУММА(_ПрочиеРасходы.ОплатаУслугБанков) КАК ОплатаУслугБанков,
		|	СУММА(_ПрочиеРасходы.ПрочиеРасходы) КАК ПрочиеРасходы
		|ИЗ
		|	_ПрочиеРасходы КАК _ПрочиеРасходы";
	
	ВсеВидыЗадолженностиЗапроса = Новый Массив;
	
	ВидыРасходов = Новый Массив;
	ВидыРасходов.Добавить("ОплатаУслугСпецДепозитарияВознаграждение");
	ВидыРасходов.Добавить("ОплатаУслугСпецДепозитарияНеобходимыеРасходы");
	ВидыРасходов.Добавить("ОплатаУслугСпецДепозитария");
	ВидыРасходов.Добавить("ОплатаРасходовУправляющейКомпании");
	ВидыРасходов.Добавить("ОплатаВознагражденияУправляющейКомпании");
	ВидыРасходов.Добавить("ОплатаРасходовНаСтрахованиеРиска");
	ВидыРасходов.Добавить("ОплатаУслугБанков");
	ВидыРасходов.Добавить("ПрочиеРасходы");
	
	Для Каждого ТекущийВидРасходов Из ВидыРасходов Цикл
		
		ВидыЗадолженности = Новый Массив;	
		
		Если СтрНачинаетсяС(ТекущийВидРасходов, "ОплатаУслугСпецДепозитария") Тогда 	
			
			Если ТекущийВидРасходов = "ОплатаУслугСпецДепозитария"
				ИЛИ ТекущийВидРасходов = "ОплатаУслугСпецДепозитарияВознаграждение"
			Тогда
				ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
				ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецдепозитария);
				ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария);
				ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии);
			КонецЕсли;
			
			Если ТекущийВидРасходов = "ОплатаУслугСпецДепозитария"
				ИЛИ ТекущийВидРасходов = "ОплатаУслугСпецДепозитарияНеобходимыеРасходы"
			Тогда
				ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
			КонецЕсли;
			
		ИначеЕсли ТекущийВидРасходов = "ОплатаРасходовУправляющейКомпании" Тогда 	
			
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего);
			
		ИначеЕсли ТекущийВидРасходов = "ОплатаВознагражденияУправляющейКомпании" Тогда 	
			
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
			
		ИначеЕсли ТекущийВидРасходов = "ОплатаРасходовНаСтрахованиеРиска" Тогда 	
			
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий);
			
		ИначеЕсли ТекущийВидРасходов = "ОплатаУслугБанков" Тогда 	
			
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоБанковскойКомиссии);
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаЗаПереводДС);
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО);
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета);
			
		ИначеЕсли ТекущийВидРасходов = "ПрочиеРасходы" Тогда 	
			
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПрочимДоходамИРасходам);
			ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюОценщика);
			
		КонецЕсли;
		
		ВидыЗадолженностиЗапроса = Новый Массив;
		
		Для Каждого ВидЗадолженности Из ВидыЗадолженности Цикл
			ВидыЗадолженностиЗапроса.Добавить(СтрШаблон("ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.%1)", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидЗадолженности, "ИмяПредопределенныхДанных")));
		КонецЦикла;	
		
		ВидыЗадолженностиСтрокой = СтрСоединить(ВидыЗадолженностиЗапроса, ", ");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидыЗадолженности" + ТекущийВидРасходов, ВидыЗадолженностиСтрокой);
		
		Если ТекущийВидРасходов = ВидРасходов ИЛИ ВидРасходов = Неопределено Тогда
			ВсеВидыЗадолженностиЗапроса.Добавить(ВидыЗадолженностиСтрокой); 
		КонецЕсли;	
		
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВидыЗадолженности", СтрСоединить(ВсеВидыЗадолженностиЗапроса, ", "));
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаполнитьРасходы(ДанныеОтчета)
	
	Запрос = Новый Запрос(ЗаполнитьРасходы_ПолучитьТекстЗапроса());	
	
	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеОтчета, Выборка);
	КонецЕсли;
	
КонецПроцедуры

Функция ОборотДтКтЕПС_ПолучитьТекстЗапроса(МассивСтрокСчетов, УсловиеЗапроса, МенеджерВременныхТаблиц = Неопределено)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Рег.СуммаОборот
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОборотыДтКт(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			&СчетаДт,
	|			&ВидыСубконтоДт,
	|			&СчетаКт,
	|			&ВидыСубконтоКт,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И &Условие) КАК Рег";
	
	Если ПустаяСтрока(МассивСтрокСчетов[0]) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетаДт", "");	
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетаДт", "СчетДт В(&СчетаДт)");
	КонецЕсли;
	
	Если ПустаяСтрока(МассивСтрокСчетов[1]) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетаКт", "");	
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетаКт", "СчетКт В(&СчетаКт)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &Условие", ?(ПустаяСтрока(УсловиеЗапроса), "", "И " + УсловиеЗапроса));
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СчетДоверительногоУправления = &СчетДоверительногоУправления", "СчетДоверительногоУправления В (ВЫБРАТЬ _СчетаДоверительногоУправления.СчетДоверительногоУправления ИЗ _СчетаДоверительногоУправления)");			
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ОборотДтКтЕПС(Знач ОписаниеПроводки, УсловиеЗапроса = "", ВидыСубконтоДт = Неопределено, ВидыСубконтоКт = Неопределено, МенеджерВременныхТаблиц = Неопределено)
	
	ОписаниеПроводки = ВРег(ОписаниеПроводки);
	
	МассивСтрокСчетов = ПолучитьСтрокиСчетов(ОписаниеПроводки, "ДТ", "КТ");

	Запрос = Новый Запрос;                          	
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	
	ТекстЗапроса = ОборотДтКтЕПС_ПолучитьТекстЗапроса(МассивСтрокСчетов, УсловиеЗапроса);
	
	Если Не ПустаяСтрока(МассивСтрокСчетов[0]) Тогда
		Запрос.УстановитьПараметр("СчетаДт", ПолучитьМассивСчетовЕПС(МассивСтрокСчетов[0]));
	КонецЕсли;
	
	Если Не ПустаяСтрока(МассивСтрокСчетов[1]) Тогда
		Запрос.УстановитьПараметр("СчетаКт", ПолучитьМассивСчетовЕПС(МассивСтрокСчетов[1]));
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;	

	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Запрос.УстановитьПараметр("ВидыСубконтоДт", ВидыСубконтоДт);
	Запрос.УстановитьПараметр("ВидыСубконтоКт", ВидыСубконтоКт);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Значение = 0;
	Иначе
		Значение = Результат.Выгрузить()[0].СуммаОборот;
	КонецЕсли;	
	
	Возврат ?(Значение = NULL, 0, Значение);
	
КонецФункции

Функция ОборотЕПС(ОписаниеПроводки, УсловиеЗапроса = "", ВидыСубконто = Неопределено, ВидыСубконтоКор = Неопределено, МенеджерВременныхТаблиц = Неопределено)
	
	ОписаниеПроводки = ВРег(ОписаниеПроводки);
	
	МассивСтрокСчетов = ПолучитьСтрокиСчетов(ОписаниеПроводки, "СЧ", "КОРСЧ");

	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
	|ИЗ
	|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			&Счета,
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И &Условие,
	|			&КорСчета,
	|			&ВидыСубконтоКор) КАК ЕдиныйБухгалтерскийУчетОбороты";
	
	Если ПустаяСтрока(МассивСтрокСчетов[0]) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Счета", "");	
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Счета", "Счет В(&Счета)");
		Запрос.УстановитьПараметр("Счета", ПолучитьМассивСчетовЕПС(МассивСтрокСчетов[0]));
	КонецЕсли;
	
	Если ПустаяСтрока(МассивСтрокСчетов[1]) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КорСчета", "");	
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КорСчета", "КорСчет В(&КорСчета)");
		Запрос.УстановитьПараметр("КорСчета", ПолучитьМассивСчетовЕПС(МассивСтрокСчетов[1]));
	КонецЕсли;
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СчетДоверительногоУправления = &СчетДоверительногоУправления", "СчетДоверительногоУправления В (ВЫБРАТЬ _СчетаДоверительногоУправления.СчетДоверительногоУправления ИЗ _СчетаДоверительногоУправления)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И &Условие", ?(ПустаяСтрока(УсловиеЗапроса), "", "И " + УсловиеЗапроса));
	
	Запрос.Текст = ТекстЗапроса;	

	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Запрос.УстановитьПараметр("ВидыСубконто", 		ВидыСубконто);
	Запрос.УстановитьПараметр("ВидыСубконтоКор", 	ВидыСубконтоКор);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Значение = 0;
	Иначе
		Значение = Результат.Выгрузить()[0].СуммаОборот;
	КонецЕсли;	
	
	Возврат ?(Значение = NULL, 0, Значение);
	
КонецФункции

Функция ПолучитьСтрокиСчетов(СтрокаСчетов, ПервыйПрефикс, ВторойПрефикс)
	
	СтрокиСчетов = Новый Массив;
	
	Позиция1 = СтрНайти(СтрокаСчетов, ПервыйПрефикс);
	Позиция2 = СтрНайти(СтрокаСчетов, ВторойПрефикс);
	
	Если Позиция1 > Позиция2
		и Позиция2 > 0 Тогда
		ВызватьИсключение "Не верно указаны счета: " + СтрокаСчетов + " : " + ПервыйПрефикс + " : " + ВторойПрефикс;
	КонецЕсли;
	
	Если Позиция1 = 0 Тогда
		ПерваяПодстрока = "";
	ИначеЕсли Позиция2 = 0 Тогда
		ПерваяПодстрока = Сред(СтрокаСчетов, Позиция1 + СтрДлина(ПервыйПрефикс));
	Иначе
		ПерваяПодстрока = Сред(СтрокаСчетов, Позиция1 + СтрДлина(ПервыйПрефикс), Позиция2 - Позиция1 - СтрДлина(ПервыйПрефикс));
	КонецЕсли;
	
	Если Позиция2 = 0 Тогда
		ВтораяПодстрока = "";
	Иначе
		ВтораяПодстрока = Сред(СтрокаСчетов, Позиция2 + СтрДлина(ВторойПрефикс));	
	КонецЕсли;

	СтрокиСчетов.Добавить(СокрЛП(ПерваяПодстрока));
	СтрокиСчетов.Добавить(СокрЛП(ВтораяПодстрока));

	Возврат СтрокиСчетов;
	
КонецФункции

Функция ПолучитьМассивСчетовЕПС(ПереченьКодов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Единый.Ссылка
	|ИЗ
	|	ПланСчетов.Единый КАК Единый
	|ГДЕ
	|	&Условие",
	"&Условие",
	ПолучитьУсловиеПоСчету(ПереченьКодов, "Единый.Ссылка"));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

Функция ПолучитьУсловиеПоГФУ(ПереченьКодов, ПолеСубконто)
	
	Возврат ПолучитьУсловиеПоПеречнюКодов(ПереченьКодов, "Код", "(ВЫРАЗИТЬ(" + ПолеСубконто + " КАК Справочник.ГруппыФинансовогоУчетаДоходовРасходов))");
	
КонецФункции

Функция ПолучитьУсловиеПоСчету(ПереченьКодов, ПолеСчет)
	
	Возврат ПолучитьУсловиеПоПеречнюКодов(ПереченьКодов, "Код", ПолеСчет);
	
КонецФункции

Функция ПолучитьУсловиеПоПеречнюКодов(ПереченьКодов, ИмяПоля, ИмяТаблицы)
	
	Если ПустаяСтрока(ПереченьКодов) Тогда
		Возврат "ИСТИНА";
	КонецЕсли;
	
	МассивСтрок = СтрРазделить(ПереченьКодов, ",", Ложь);
	
	СоответствиеДлинОбщее = Новый Соответствие;
	СоответствиеДлинОбщее.Вставить(0, Новый Соответствие); // Условия отрицания
	СоответствиеДлинОбщее.Вставить(1, Новый Соответствие);
	
	Для каждого Подстрока из МассивСтрок Цикл
		
		ПодстрокаБезДопСимволов = СокрЛП(Подстрока);
		
		Если Лев(ПодстрокаБезДопСимволов, 1) = "!" Тогда
			СоответствиеДлин = СоответствиеДлинОбщее[0];
			ПодстрокаБезДопСимволов = СокрЛ(Сред(ПодстрокаБезДопСимволов, 2));
		Иначе
			СоответствиеДлин = СоответствиеДлинОбщее[1];	
		КонецЕсли;
		
		ДлинаПодстроки = СтрДлина(ПодстрокаБезДопСимволов);
		МассивПодстрок = СоответствиеДлин[ДлинаПодстроки];
		Если МассивПодстрок = Неопределено Тогда
			МассивПодстрок = Новый Массив;
			СоответствиеДлин.Вставить(ДлинаПодстроки, МассивПодстрок);
		КонецЕсли;
		
		МассивПодстрок.Добавить("""" + ПодстрокаБезДопСимволов + """");
		
	КонецЦикла;
	
	МассивОбщихУсловий = Новый Массив;
	Для каждого КлючИЗначОбщее из СоответствиеДлинОбщее Цикл
		
		СоответствиеДлин = КлючИЗначОбщее.Значение;
		
		Если СоответствиеДлин.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если КлючИЗначОбщее.Ключ = 0 Тогда
			Префикс    = "Не ";
			Соединение = "И ";
		Иначе
			Префикс = "";
			Соединение = "ИЛИ ";
		КонецЕсли;
		
		МассивУсловий = Новый Массив;
		Для каждого КлючИЗнач из СоответствиеДлин Цикл
			
			СтрокаУсловия = Префикс + "ПОДСТРОКА(" + ИмяТаблицы + "." + ИмяПоля + ", 1, " + Формат(КлючИЗнач.Ключ, "ЧГ=0") + ")";
			Если КлючИЗнач.Значение.Количество() = 1 Тогда
				СтрокаУсловия = СтрокаУсловия + " = " + КлючИЗнач.Значение[0];	
			Иначе
				СтрокаУсловия = СтрокаУсловия + " В(" + СтрСоединить(КлючИЗнач.Значение, ", ") + ")";
			КонецЕсли;
			
			МассивУсловий.Добавить(СтрокаУсловия);
			
		КонецЦикла;
		
		МассивОбщихУсловий.Добавить("(" + СтрСоединить(МассивУсловий, Символы.ПС + Символы.Таб + Соединение) + ")");
		
	КонецЦикла;
	
	ТекстУсловия = СтрСоединить(МассивОбщихУсловий, Символы.ПС + Символы.Таб + "И ");
	
	Возврат ТекстУсловия;

КонецФункции

Процедура УстановитьОбщиеПараметрыЗапроса(Запрос)
	
	Запрос.УстановитьПараметр("НачалоПериода", 							ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 							ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 			ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВалютаУчета", 							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("НачалоОтдельногоРасчетаВалютныхСделок", 	'20210101');
	
КонецПроцедуры

Функция ПолучитьВариантРасчетаОценочнойСтоимости()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости
	|ИЗ
	|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
	|			&ДатаОкончания,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаобъектовВУправлении)) КАК НастройкиЦелейРасчетаСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОкончания", 					КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ВариантРасчетаОценочнойСтоимости;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьДюрации(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумаги.Облигация КАК ЦеннаяБумага,
		|	КотировкиТорговыхПлощадок.DURATION КАК Дюрация,
		|	Номиналы.Номинал КАК Номинал
		|ИЗ
		|	_Облигации КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиТорговыхПлощадок КАК КотировкиТорговыхПлощадок
		|		ПО (КотировкиТорговыхПлощадок.ЦеннаяБумага = _ЦенныеБумаги.Облигация)
		|			И (КотировкиТорговыхПлощадок.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|			И (КотировкиТорговыхПлощадок.Биржа = &Биржа)
		|			И (КотировкиТорговыхПлощадок.РежимТоргов.ОсновнойРежим)
		|			И (КотировкиТорговыхПлощадок.Период = &ПоследняяДатаТоргов)
		|			И (КотировкиТорговыхПлощадок.DURATION > 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК Номиналы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ЦенныеБумаги.Облигация КАК ЦеннаяБумага,
		|				МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК Период
		|			ИЗ
		|				_Облигации КАК _ЦенныеБумаги
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
		|					ПО (НоминалыЦенныхБумаг.ЦеннаяБумага = _ЦенныеБумаги.Облигация)
		|						И (НоминалыЦенныхБумаг.Период <= &Период)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ЦенныеБумаги.Облигация) КАК ДатыИзмененийНоминала
		|			ПО (ДатыИзмененийНоминала.ЦеннаяБумага = Номиналы.ЦеннаяБумага)
		|				И (ДатыИзмененийНоминала.Период = Номиналы.Период)
		|		ПО (Номиналы.ЦеннаяБумага = _ЦенныеБумаги.Облигация)";
		
	ПоследняяДатаТоргов = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Константы.ОсновнойКалендарьКотировок.Получить(), НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	ММВБ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	
	Запрос.УстановитьПараметр("Биржа",					ММВБ);
	Запрос.УстановитьПараметр("Период",					ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПоследняяДатаТоргов",	ПоследняяДатаТоргов);

	ТаблицаДюраций = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДюрации Из ТаблицаДюраций Цикл
		Если Не ЗначениеЗаполнено(СтрокаДюрации.Дюрация) Тогда
			СтрокаДюрации.Дюрация = Справочники.Облигации.ПолучитьДоходностьИДюрацию(СтрокаДюрации.ЦеннаяБумага, Ложь, НачалоДня(Период.ДатаОкончания), СтрокаДюрации.Номинал, ЭтотОбъект.СчетДоверительногоУправления, ММВБ).Дюрация; 
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ТаблицаДюраций;
	
КонецФункции

Процедура ПолучитьСостояниеПортфеляНаДату(Запрос, Дата, ЭтоНачалоПериода = Ложь)
	
