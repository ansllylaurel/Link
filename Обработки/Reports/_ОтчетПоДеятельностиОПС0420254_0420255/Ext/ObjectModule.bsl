Процедура ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачалоПериода", 							ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 							ЭтотОбъект.Период.ДатаОкончания);	
	Запрос.УстановитьПараметр("Организация", 							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", 	ЭтотОбъект.ВидДоговораДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент",									ЭтотОбъект.Клиент);		
	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	    |			&КонецПериода,
	    |			Организация = &Организация
	    |				И Клиент = &Клиент
	    |				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
	    |				И (СчетДоверительногоУправления.ДатаРасторжения > &НачалоПериода
	    |					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))) КАК КлиентыДоверительногоУправленияСрезПоследних";

	Запрос.Выполнить();	

