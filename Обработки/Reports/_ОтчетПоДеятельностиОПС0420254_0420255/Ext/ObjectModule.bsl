		|			И (УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.ОфертаПродажа))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДефолтыПоОблигациям КАК ДефолтыПоОблигациям
		|		ПО _Результат_ОсновныеДанные.Актив = ДефолтыПоОблигациям.Облигация
		|			И (ДефолтыПоОблигациям.Период >= ВЫРАЗИТЬ(_Результат_ОсновныеДанные.Актив КАК Справочник.Облигации).ДатаПогашения)
		|			И (ДефолтыПоОблигациям.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации))
		|			И (ДефолтыПоОблигациям.СтатусДефолта В (ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.ТехническийДефолт), ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)))
		|ГДЕ
		|	НЕ(ЕСТЬNULL(_Результат_ОсновныеДанные.БалансоваяСтоимостьНачало, 0) = 0
		|				И ЕСТЬNULL(_Результат_ОсновныеДанные.БалансоваяСтоимостьКонец, 0) = 0
		|				И ЕСТЬNULL(_Результат_ОсновныеДанные.ДоходыОтПродажи, 0) = 0
		|				И ЕСТЬNULL(_Результат_ОсновныеДанные.ПроцентныеДоходы, 0) = 0
		|				И ЕСТЬNULL(_Результат_ОсновныеДанные.ДоходыОтПереоценки, 0) = 0
		|				И ЕСТЬNULL(_Результат_ОсновныеДанные.ДоходыПрочие, 0) = 0
		|				И ЕСТЬNULL(_СредневзвешенныеВложения.Сумма, 0) = 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерБлока,
		|	ИдентификаторАктива
		|ИТОГИ
		|	СУММА(СтоимостьНаНачалоПериода),
		|	СУММА(СтоимостьНаКонецПериода),
		|	СУММА(ДоходыВсего),
		|	СУММА(СредневзвешенныеВложения)
		|ПО
		|	ОБЩИЕ";  	
	
	#КонецОбласти
	
	КоличествоДнейВГоду 	= (НачалоДня(КонецГода(ЭтотОбъект.Период.ДатаНачала)) - НачалоГода(ЭтотОбъект.Период.ДатаНачала)) / (60 * 60 * 24) + 1;
	КоличествоДнейВПериоде 	= (НачалоДня(ЭтотОбъект.Период.ДатаОкончания) - ЭтотОбъект.Период.ДатаНачала) / (60 * 60 * 24) + 1;
	
	Запрос.УстановитьПараметр("КоличествоДнейВГоду", 	КоличествоДнейВГоду);
	Запрос.УстановитьПараметр("КоличествоДнейВПериоде", КоличествоДнейВПериоде);
	
	//- Номер расчетного счета для денежных средств на счетах кредитных организаций
	//- Номер и дата договора с брокером для денежных средств на счетах брокера
	//- Номер счета депозита для депозитов         
	//- Код на ММВБ для производных финансовых инструментов
	//- ISIN для дебиторской задолженности по погашению купона
	//- номер расчетного счета для дебиторской задолженности по процентам по депозитам, МНО
	//- ISIN для дебиторской и кредиторской задолженности по сделкам РЕПО
	//- наименование задолженности для прочей дебиторской и кредиторской задолженности
	//- наименование актива для прочих активов
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Заполняем итоги
	Если Не Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для клиента " + СокрЛП(ЭтотОбъект.Клиент) + " отсутствуют данные по виду договора " + СокрЛП(ЭтотОбъект.ВидДоговораДоверительногоУправления),,,, Отказ);		
		Возврат;	
	КонецЕсли;
	
	Макет = ПолучитьМакет("ДоходностьПоУК");
	
	ДопИмяОбласти = ?(ЭтотОбъект.ВывестиКолонкиДляФормы264, "_ППА", "");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка" + ДопИмяОбласти);
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Строка" + ДопИмяОбласти);
	ОбластьИтоги 	= Макет.ПолучитьОбласть("Итоги" + ДопИмяОбласти);
		
	ОбластьШапка.Параметры.НомерПодраздела = ?(ЭтотОбъект.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями, "255.5.4", "254.8.3");
	
	ДокументРезультат.Вывести(ОбластьШапка);

	ОбластьИтоги.Параметры.Заполнить(Выборка);
	
	Разницы = Новый Структура;
	Если Не ПроверитьИтоги(Запрос.МенеджерВременныхТаблиц, Выборка, Разницы) Тогда
		Возврат;
	КонецЕсли;
	
	Если Разницы.Свойство("ФинРез") Тогда
		ОбластьИтоги.Параметры.ДоходыВсего = ОбластьИтоги.Параметры.ДоходыВсего - Разницы.ФинРез;
	КонецЕсли;
	
	Если Разницы.Свойство("БалансНаНачало") Тогда
		ОбластьИтоги.Параметры.СтоимостьНаНачалоПериода = ОбластьИтоги.Параметры.СтоимостьНаНачалоПериода - Разницы.БалансНаНачало;
	КонецЕсли;
	
	Если Разницы.Свойство("БалансНаКонец") Тогда
		ОбластьИтоги.Параметры.СтоимостьНаКонецПериода = ОбластьИтоги.Параметры.СтоимостьНаКонецПериода - Разницы.БалансНаКонец;
	КонецЕсли;
	
	ТаблицаДюраций = ПолучитьДюрации(Запрос);
	
	СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО = Новый Соответствие;
	СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД, 								"Долговые ценные бумаги, удерживаемые до погашения");
	СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток, 					"Ценные бумаги, оцениваемые по справедливой стоимости через прибыль или убыток");
	СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО.Вставить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой, 						"Ценные бумаги, оцениваемые по справедливой стоимости через прибыль или убыток");
	СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи, 							?(ЭтотОбъект.СтандартМСФО = Перечисления.СтандартыФинансовойОтчетности.МСФО39, "Ценные бумаги, имеющиеся в наличии для продажи", "ценные бумаги, оцениваемые по справедливой стоимости через прочий совокупный доход"));
	СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО.Вставить(Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения, 	"Ценные бумаги, оцениваемые по амортизированной стоимости");
	
	МассивАктивовДляРасшифровки = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
				
		Дюрация = "-";
		Если ТипЗнч(Выборка.Актив) = Тип("СправочникСсылка.Облигации") И (Выборка.НомерБлока >= 1 И Выборка.НомерБлока <= 15) Тогда
				
			НайдСтрокиДюрации = ТаблицаДюраций.НайтиСтроки(Новый Структура("ЦеннаяБумага", Выборка.Актив));
			Дюрация = ?(НайдСтрокиДюрации[0].Дюрация <> 0, НайдСтрокиДюрации[0].Дюрация, Дюрация);
					
		КонецЕсли;
				
		ОбластьСтрока.Параметры.Заполнить(ДанныеОтчета);
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		
		Если (Выборка.НомерБлока >= 1 И Выборка.НомерБлока <= 15) Или Выборка.НомерБлока = 23 Или Выборка.НомерБлока = 26 Или Выборка.НомерБлока = 28 Тогда
			//Составляем идентификатор ценной бумаги
			ГосРегНомер = ?(ПустаяСтрока(Выборка.ГосРегНомер), "000", Выборка.ГосРегНомер); 
			ISIN = ?(ПустаяСтрока(Выборка.ИдентификаторАктива), "000", Выборка.ИдентификаторАктива); 
			CFI = ?(ПустаяСтрока(Выборка.CFI), "000", Выборка.CFI); 
			ОбластьСтрока.Параметры.ИдентификаторАктива = ГосРегНомер + "_" + ISIN + "_" + CFI;
		КонецЕсли;
		
		Если ДопИмяОбласти = "_ППА" Тогда
			// Приводим код ЦБ РФ к стандарту
			ОбластьСтрока.Параметры.КодТипаЦеннойБумаги = ПолучитьКодЦБРФ(Выборка.КодТипаЦеннойБумаги);			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ИдентификаторАктиваДата) Тогда
			ОбластьСтрока.Параметры.ИдентификаторАктива = СокрЛП(Выборка.ИдентификаторАктива) + " от " + Формат(Выборка.ИдентификаторАктиваДата, "ДФ=dd.MM.yyyy");
		КонецЕсли;
				
		ОбластьСтрока.Параметры.СтандартМСФО = ?(ЭтотОбъект.СтандартМСФО = Перечисления.СтандартыФинансовойОтчетности.МСФО39, "IAS 39", "IFRS 9");
		КлассификацияАктива = СоответствиеУчетныхАктивовЕПСИКлассификацииЦенныхБумагМСФО.Получить(Выборка.УчетныйАктивЕПС);
		КлассификацияАктива = ?(КлассификацияАктива = Неопределено, Выборка.УчетныйАктивЕПС, КлассификацияАктива);
		ОбластьСтрока.Параметры.КлассификацияАктива39	= ?(ЭтотОбъект.СтандартМСФО = Перечисления.СтандартыФинансовойОтчетности.МСФО39, 	КлассификацияАктива, "");
		ОбластьСтрока.Параметры.КлассификацияАктива9 	= ?(ЭтотОбъект.СтандартМСФО = Перечисления.СтандартыФинансовойОтчетности.МСФО9,		КлассификацияАктива, "");
					
		ОбластьСтрока.Параметры.Дюрация = Дюрация;
						
		ОбластьСтрока.Параметры.ДоходностьВсего = Выборка.ДоходностьОтПродажи + Выборка.ДоходностьОтПроцентныхДоходов + Выборка.ДоходностьОтПереоценки + Выборка.ДоходностьПрочихДоходов;
		
		СтруктураРасшифровки = Новый Структура("ИмяПоля,Актив,НомерБлока,Контрагент, КлассАктива, КлассификацияАктива, ИдентификаторАктива, ФинансовыйРезультат", "СредневзвешенныеВложения", Выборка.Актив, Выборка.НомерБлока, Выборка.Контрагент, Выборка.КлассАктива, Выборка.УчетныйАктивЕПС, Выборка.ИдентификаторАктива, Выборка.ДоходыВсего);
		ОбластьСтрока.Параметры.РасшифровкаСредневзвешенныеВложения = СтруктураРасшифровки;
		
		СтруктураРасшифровки = Новый Структура("ИмяПоля,Актив,НомерБлока,Контрагент, КлассАктива, КлассификацияАктива, ИдентификаторАктива", "ДоходыОтПродажи", Выборка.Актив, Выборка.НомерБлока, Выборка.Контрагент, Выборка.КлассАктива, Выборка.УчетныйАктивЕПС, Выборка.ИдентификаторАктива);
		ОбластьСтрока.Параметры.РасшифровкаДоходыОтПродажи = СтруктураРасшифровки;
		
		СтруктураРасшифровки = Новый Структура("ИмяПоля,Актив,НомерБлока,Контрагент, КлассАктива, КлассификацияАктива, ИдентификаторАктива", "ПроцентныеДоходы", Выборка.Актив, Выборка.НомерБлока, Выборка.Контрагент, Выборка.КлассАктива, Выборка.УчетныйАктивЕПС, Выборка.ИдентификаторАктива);
		ОбластьСтрока.Параметры.РасшифровкаПроцентныеДоходы = СтруктураРасшифровки;
		
		СтруктураРасшифровки = Новый Структура("ИмяПоля,Актив,НомерБлока,Контрагент, КлассАктива, КлассификацияАктива, ИдентификаторАктива", "ДоходыОтПереоценки", Выборка.Актив, Выборка.НомерБлока, Выборка.Контрагент, Выборка.КлассАктива, Выборка.УчетныйАктивЕПС, Выборка.ИдентификаторАктива);
		ОбластьСтрока.Параметры.РасшифровкаДоходыОтПереоценки = СтруктураРасшифровки;
		
		СтруктураРасшифровки = Новый Структура("ИмяПоля,Актив,НомерБлока,Контрагент, КлассАктива, КлассификацияАктива, ИдентификаторАктива", "ДоходыПрочие", Выборка.Актив, Выборка.НомерБлока, Выборка.Контрагент, Выборка.КлассАктива, Выборка.УчетныйАктивЕПС, Выборка.ИдентификаторАктива);
		ОбластьСтрока.Параметры.РасшифровкаДоходыПрочие = СтруктураРасшифровки;
		
		СтруктураРасшифровки = Новый Структура("ИмяПоля,Актив,НомерБлока,Контрагент, КлассАктива, КлассификацияАктива, ИдентификаторАктива", "ДоходыВсего", Выборка.Актив, Выборка.НомерБлока, Выборка.Контрагент, Выборка.КлассАктива, Выборка.УчетныйАктивЕПС, Выборка.ИдентификаторАктива);
		ОбластьСтрока.Параметры.РасшифровкаДоходыВсего = СтруктураРасшифровки;

		Если ВывестиРасшифровкуСредневзвешенныхВложений Тогда 
			МассивАктивовДляРасшифровки.Добавить(СтруктураРасшифровки);
		КонецЕсли;
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;	
	
	Если Разницы.Количество() <> 0 Тогда
		// Добавляем строку с разницей в прочие доходы
		ОбластьСтрока.Параметры.ДоходыОтПродажи 	= 0;
		ОбластьСтрока.Параметры.ПроцентныеДоходы 	= 0;
		ОбластьСтрока.Параметры.ДоходыОтПереоценки 	= 0;
		ОбластьСтрока.Параметры.ДоходыПрочие 		= ?(Разницы.Свойство("ФинРез"), - Разницы.ФинРез, 0);
		ОбластьСтрока.Параметры.ДоходыВсего 		= ?(Разницы.Свойство("ФинРез"), - Разницы.ФинРез, 0);
		
		Если ЭтотОбъект.ВывестиКолонкиДляФормы264 Тогда
			ОбластьСтрока.Параметры.ИдентификаторКонтрагента_ИНН 	= "-";
			ОбластьСтрока.Параметры.ИдентификаторКонтрагента_ОГРН 	= "-";			
		Иначе
			ОбластьСтрока.Параметры.НомерБлока	 					= 27;
			ОбластьСтрока.Параметры.ИдентификаторКонтрагента	 	= "-";		
		КонецЕсли;
		
		ОбластьСтрока.Параметры.КлассАктива 					= "Прочие активы";
		
		ОбластьСтрока.Параметры.ИдентификаторАктива		 		= "-";
		ОбластьСтрока.Параметры.НаименованиеКонтрагента	 		= "-";
		ОбластьСтрока.Параметры.КлассификацияАктива39	 		= "-";
		ОбластьСтрока.Параметры.КлассификацияАктива9	 		= "-";
		ОбластьСтрока.Параметры.СтоимостьНаНачалоПериода	 	= ?(Разницы.Свойство("БалансНаНачало"), - Разницы.БалансНаНачало, 0);
		ОбластьСтрока.Параметры.СтоимостьНаКонецПериода	 		= ?(Разницы.Свойство("БалансНаКонец"), - Разницы.БалансНаКонец, 0);;
		ОбластьСтрока.Параметры.СредневзвешенныеВложения	 	= 0;
		ОбластьСтрока.Параметры.Дюрация 						= "";
		ОбластьСтрока.Параметры.ДоходностьОтПродажи             = 0;
		ОбластьСтрока.Параметры.ДоходностьОтПроцентныхДоходов   = 0;
		ОбластьСтрока.Параметры.ДоходностьОтПереоценки          = 0;
		ОбластьСтрока.Параметры.ДоходностьПрочихДоходов         = 0;
		ОбластьСтрока.Параметры.ДоходностьВсего                 = 0;		
				
		ДокументРезультат.Вывести(ОбластьСтрока);
	КонецЕсли;		
		
	ДокументРезультат.Вывести(ОбластьИтоги);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ВывестиРасшифровкуСредневзвешенныхВложений Тогда
		АдресВХранилище = ПоместитьВоВременноеХранилище(МассивАктивовДляРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьКодЦБРФ(КодТипаЦеннойБумаги)
	
	Если ПустаяСтрока(КодТипаЦеннойБумаги) Тогда
		Возврат КодТипаЦеннойБумаги;
	КонецЕсли;
	
	ПоследняяТочка = СтрНайти(КодТипаЦеннойБумаги, ".", НаправлениеПоиска.СКонца);
	
	Если ПоследняяТочка = 0 Тогда 
		Возврат КодТипаЦеннойБумаги;
	Иначе
		Возврат Сред(КодТипаЦеннойБумаги, ПоследняяТочка + 1);
	КонецЕсли;
	
КонецФункции

Функция ПроверитьИтоги(МенеджерВременныхТаблиц, СтрокаИтогов, Разницы)
		
	ОбщийФинРез = - ОборотЕПС("Сч 710,712,713,715,717,718,720,725,727,728 КорСч !479",,,, МенеджерВременныхТаблиц) - СуммаРезервовПриПереходеНаМСФО9(МенеджерВременныхТаблиц); 
	ВидыСубконтоГФУ = ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов;
	ВознаграждениеУК = ПолучитьВознаграждениеУК(МенеджерВременныхТаблиц);
	
	ОбщийФинРез 	= ОбщийФинРез - ВознаграждениеУК;	
		
	Если ОбщийФинРез <> СтрокаИтогов.ДоходыВсего Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Общий финансовый результат в отчете " + Формат(СтрокаИтогов.ДоходыВсего, "ЧДЦ=2") + " отличается от финансового результата по ОФР " +  Формат(ОбщийФинРез, "ЧДЦ=2") + ". Возможно, был доработан отчет по ОФР");		
		Разницы.Вставить("ФинРез", СтрокаИтогов.ДоходыВсего - ОбщийФинРез);
	КонецЕсли;  	
	
	СписокСчетов = СписокБалансовыхСчетов();
	БалансНаНачало 	= ОбщаяБалансоваяСтоимость(МенеджерВременныхТаблиц, СписокСчетов, ЭтотОбъект.Период.ДатаНачала - 24 * 60 * 60);
	БалансНаКонец 	= ОбщаяБалансоваяСтоимость(МенеджерВременныхТаблиц, СписокСчетов, ЭтотОбъект.Период.ДатаОкончания);
	
	Если БалансНаНачало <> СтрокаИтогов.СтоимостьНаНачалоПериода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Общая стоимость на начало периода в отчете " + Формат(СтрокаИтогов.СтоимостьНаНачалоПериода, "ЧДЦ=2") + " отличается от балансовой стоимости по ОСВ " +  Формат(БалансНаНачало, "ЧДЦ=2"));
		Разницы.Вставить("БалансНаНачало",  СтрокаИтогов.СтоимостьНаНачалоПериода - БалансНаНачало);
	КонецЕсли;  	
	
	Если БалансНаКонец <> СтрокаИтогов.СтоимостьНаКонецПериода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Общая стоимость на конец периода в отчете " + Формат(СтрокаИтогов.СтоимостьНаКонецПериода, "ЧДЦ=2") + " отличается от балансовой стоимости по ОСВ " +  Формат(БалансНаКонец, "ЧДЦ=2"));
		Разницы.Вставить("БалансНаКонец", СтрокаИтогов.СтоимостьНаКонецПериода - БалансНаКонец);
	КонецЕсли;  	
		
	Возврат Истина;
	
КонецФункции

Функция СписокБалансовыхСчетов()
	
	СписокСчетов = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВыборкаСчетов = ПланыСчетов.Единый.Выбрать();
	Пока ВыборкаСчетов.Следующий() Цикл
		
		Если СтрДлина(ВыборкаСчетов.Код) <> 3 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВыборкаСчетов.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВыборкаСчетов.Код = "000" Или ВыборкаСчетов.Код = "479" Тогда
			Продолжить;
		КонецЕсли;
		
		ПервыйСимвол = Лев(ВыборкаСчетов.Код, 1);
		
		Если Число(ПервыйСимвол) >= 7 Тогда
			Продолжить;
		КонецЕсли;
		
		СписокСчетов.Добавить(ВыборкаСчетов.Ссылка);
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СписокСчетов;
	
КонецФункции

Функция ОбщаяБалансоваяСтоимость(МенеджерВременныхТаблиц, МассивСчетов, Дата)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВложенныйЗапрос.Баланс) КАК Баланс
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт КАК Баланс
		|	ИЗ
		|		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Дата,
		|				Счет В ИЕРАРХИИ (&Счета),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|						ИЗ
		|							_СчетаДоверительногоУправления)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего)
		|				ТОГДА -ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт
		|			ИНАЧЕ 0
		|		КОНЕЦ
		|	ИЗ
		|		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Дата,
		|				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ)),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|						ИЗ
		|							_СчетаДоверительногоУправления)) КАК ЕдиныйБухгалтерскийУчетОстатки) КАК ВложенныйЗапрос";
	
	Запрос.УстановитьПараметр("Дата", 			Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счета", 			МассивСчетов);
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Возврат ?(Выборка.Следующий(), Выборка.Баланс, 0);
	
