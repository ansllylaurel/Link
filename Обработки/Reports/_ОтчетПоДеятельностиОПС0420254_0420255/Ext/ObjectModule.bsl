
#Область Сведения_о_внешней_обработке

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительныйОтчет",
		"Отчет по деятельности ОПС № 0420254 / 0420255",
		"2.68",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("ФорматВывода");	
	Настройки.Добавить("ВывестиКолонкиДляФормы264");
	Настройки.Добавить("ВидДоговораДоверительногоУправления");
	Настройки.Добавить("СформироватьРазделДоходностиПоУК");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	Отказ = Ложь;
	
	Если ЭтотОбъект.СформироватьРазделДоходностиПоУК Тогда
		
		// Дозаполняем реквизиты отчета
		ЭтотОбъект.Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
		ЭтотОбъект.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления[СокрЛП(НастройкиОтчета.ВидДоговораДоверительногоУправления)];
		ЭтотОбъект.СтандартМСФО = СтандартМСФОИзНастроек(Клиент, Отказ); 
		
	КонецЕсли;
	
	Если Отказ Тогда
		НастройкиОтчета.Вставить("Отказ");
		Возврат;
	КонецЕсли;
	
	ДокументРезультат = Новый ТабличныйДокумент;	
	
	СформироватьОтчет(ДокументРезультат, , Неопределено, Отказ);
	
	Если Отказ Тогда
		НастройкиОтчета.Вставить("Отказ");
		Возврат;
	КонецЕсли;
	
	Если ДокументРезультат.ВысотаТаблицы > 0 Тогда	
		НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Формирование_отчета

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	Если ЭтотОбъект.СформироватьРазделДоходностиПоУК Тогда
		ПроверяемыеРеквизиты.Добавить("Клиент");
		ПроверяемыеРеквизиты.Добавить("ВидДоговораДоверительногоУправления");
		ПроверяемыеРеквизиты.Добавить("СтандартМСФО");
	Иначе
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
	КонецЕсли;
	
	// Проверяем дату запрета редактирования проводок ЕПС
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачалоПериода", 							ЭтотОбъект.Период.ДатаНачала);	
	Запрос.УстановитьПараметр("КонецПериода", 							ЭтотОбъект.Период.ДатаОкончания);	
	Запрос.УстановитьПараметр("Организация", 							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", 	ЭтотОбъект.ВидДоговораДоверительногоУправления);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 			ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент",									ЭтотОбъект.Клиент);		
	Запрос.УстановитьПараметр("СформироватьРазделДоходностиПоУК",		СформироватьРазделДоходностиПоУК);
	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	    |			&КонецПериода,
	    |			Организация = &Организация
	    |				И ВЫБОР
	    |					КОГДА &СформироватьРазделДоходностиПоУК
	    |						ТОГДА Клиент = &Клиент
	    |								И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
	    |					ИНАЧЕ СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |				КОНЕЦ
	    |				И (СчетДоверительногоУправления.ДатаРасторжения > &НачалоПериода
	    |					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))) КАК КлиентыДоверительногоУправленияСрезПоследних";
		
	Выборка = Запрос.Выполнить();
	
	Если РаботаСОтчетами.ЕстьДатыЗапретаРедактированияСчетовДоверительногоУправленияДоДатыПроверки(Запрос.МенеджерВременныхТаблиц, ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, Перечисления.ГруппыЗапретаРедактирования.Проводки, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет) Тогда	
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет не сформирован");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыВыполненияДляСбораСтатистики()
	
	СтрСохраняемыеДанные = ?(ЭтотОбъект.СформироватьРазделДоходностиПоУК, "Период,Организация,Клиент,ВидДоговораДоверительногоУправления", "Период,Организация,СчетДоверительногоУправления,ФорматВывода");
	ПараметрыОтчета = Новый Структура(СтрСохраняемыеДанные);
	ЗаполнитьЗначенияСвойств(ПараметрыОтчета, ЭтотОбъект);
	
	Описание = "";
	
	Для каждого Реквизит Из СтрРазделить(СтрСохраняемыеДанные, ",") Цикл
	
		Описание = Описание + Символы.ПС + Реквизит + ": " + ПараметрыОтчета[Реквизит];
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

Процедура СформироватьОтчет(ДокументРезультат, АдресВХранилище = "", АдресВХранилищеСДаннымиДляРасшифровки = "", Отказ = Ложь) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.СформироватьРазделДоходностиПоУК И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Клиент, "ВидЮрФизЛица") <> Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбран клиент-физическое лицо",,,, Отказ);
		Возврат;
	КонецЕсли;
	
	// С этой даты обновляются заголовки у фин. реза. Сумма фин. реза приведена в соответствие заголовку.
	ДатаОбновленияЗаголовкаФинРезультата = '20220101';
	
	ДокументРезультат.Очистить();
	
	Если ЭтотОбъект.СформироватьРазделДоходностиПоУК Тогда
		ВариантФормы = ?(ЭтотОбъект.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами, "0420254", "0420255");		
	ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		ВариантФормы = "0420254";
	ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ВариантФормы = "0420255";
	Иначе
		ВызватьИсключение "Неверный вид договора доверительного управления: " + СчетДоверительногоУправления.ВидДоговораДоверительногоУправления;
	КонецЕсли;
	
	//Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,Клиент,ВидДоговораДоверительногоУправления,СчетДоверительногоУправления,ФорматВывода,СформироватьРазделДоходностиПоУК");	
	ДопИмя = ?(ЭтотОбъект.СформироватьРазделДоходностиПоУК, ".ДоходностьПоУК" , "");
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ДопИмя;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	РаботаСОтчетами.ЗапомнитьКлючВариантаОтчета(ЭтотОбъект, ВариантФормы); 
	
	ДанныеОтчета = ПолучитьДанныеОтчета(ВариантФормы, ЭтотОбъект.СформироватьРазделДоходностиПоУК, ДатаОбновленияЗаголовкаФинРезультата);
	Если ДанныеОтчета.Свойство("Отказ") Тогда
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
		
	Если Не ЭтотОбъект.СформироватьРазделДоходностиПоУК Тогда  	
				
		Если ВариантФормы = "0420254" Тогда
			МакетОтчета = ПолучитьМакет("Макет17Подраздел1");                            		
		ИначеЕсли ВариантФормы = "0420255" И ЭтотОбъект.Период.ДатаОкончания >= '20190419' Тогда // Дата публикации нового указания ЦБ
			МакетОтчета = ПолучитьМакет("Макет51_Ред20190404");	
		ИначеЕсли ВариантФормы = "0420255" Тогда
			МакетОтчета = ПолучитьМакет("Макет51");
		Иначе 
			ВызватьИсключение "Нет макета для варианта формы: " + ВариантФормы;
		КонецЕсли;
		
		УстановитьФорматРесурсов(МакетОтчета);
		
		ОбластьШапка  = МакетОтчета.ПолучитьОбласть("ШапкаТаблицы");
		ОбластьСтрока = МакетОтчета.ПолучитьОбласть("СтрокаТаблицы");
		ОбластьИтогов = МакетОтчета.ПолучитьОбласть("СтрокаИтогов");
		
		Если ВариантФормы = "0420254" Тогда
			ЗаголовокКолонкиФинРеза = "Финансовый результат от размещения средств пенсионных резервов (до выплаты вознаграждения управляющей компании)";
			ЗаголовокКолонкиФинРеза_Таблица2 = "Финансовый результат от размещения средств пенсионных резервов (до выплаты вознаграждения управляющей компании), в том числе:";
			
			Если ЭтотОбъект.Период.ДатаНачала >= ДатаОбновленияЗаголовкаФинРезультата Тогда
				ЗаголовокКолонкиФинРеза = "Финансовый результат от размещения средств пенсионных резервов (до выплаты вознаграждения управляющей компании, специализированному депозитарию и фонду)";
				ЗаголовокКолонкиФинРеза_Таблица2 = "Финансовый результат от размещения средств пенсионных резервов (до выплаты вознаграждения фонду), в том числе:";
			КонецЕсли;
		Иначе
			ЗаголовокКолонкиФинРеза = "Финансовый результат от инвестирования средств пенсионных накоплений (до выплаты вознаграждения управляющей компании)";
			ЗаголовокКолонкиФинРеза_Таблица2 = "Финансовый результат от инвестирования пенсионных накоплений (до выплаты вознаграждения управляющей компании), в том числе:";
			
			Если ЭтотОбъект.Период.ДатаНачала >= ДатаОбновленияЗаголовкаФинРезультата Тогда
				ЗаголовокКолонкиФинРеза = "Финансовый результат от инвестирования средств пенсионных накоплений (до вычета вознаграждения фонду)";
				ЗаголовокКолонкиФинРеза_Таблица2 = "Финансовый результат от инвестирования пенсионных накоплений (до выплаты вознаграждения фонду), в том числе:";
			КонецЕсли;
		КонецЕсли;	
		
		ЗаголовокКолонкиФинРеза = ЗаголовокКолонкиФинРеза + ?(ЭтотОбъект.ФорматВывода = 0, ", тыс. руб.", ", руб.");
		ОбластьШапка.Параметры.Заполнить(ДанныеОтчета);
		ОбластьШапка.Параметры.ЗаголовокКолонкиФинРеза = ЗаголовокКолонкиФинРеза;
				
		ОбластьСтрока.Параметры.Заполнить(ДанныеОтчета);
		ОбластьИтогов.Параметры.Заполнить(ДанныеОтчета);

		ДокументРезультат.Вывести(ОбластьШапка);
		ДокументРезультат.Вывести(ОбластьСтрока);
		ДокументРезультат.Вывести(ОбластьИтогов);

		ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		
		Если ВариантФормы = "0420254" Тогда
			МакетОтчета = ПолучитьМакет("Макет17Подраздел2");
		ИначеЕсли ВариантФормы = "0420255" Тогда
			МакетОтчета = ПолучитьМакет("Макет52");
		Иначе 
			ВызватьИсключение "Нет макета для варианта формы: " + ВариантФормы;
		КонецЕсли;
		
		УстановитьФорматРесурсов(МакетОтчета);
		
		МакетОтчета.Параметры.Заполнить(ДанныеОтчета);
		МакетОтчета.Параметры.ЗаголовокКолонкиФинРеза_Таблица2 = ЗаголовокКолонкиФинРеза_Таблица2;
		
		// Ресурсы по которым считается доля в %
		РесурсыСДолей = Новый Структура("ФинансовыйРезультатВсего, ДивидендыИПроценты, РеализацияАктивов, ИзменениеРыночнойСтоимости, ДругиеВидыДохода");
		ЗаполнитьЗначенияСвойств(РесурсыСДолей, ДанныеОтчета);
		Если ДанныеОтчета.ФинансовыйРезультат <> 0 Тогда
			Для каждого КлючИЗнач из РесурсыСДолей Цикл
				МакетОтчета.Параметры[СокрЛП(КлючИЗнач.Ключ) + "Доля"] = 100 * КлючИЗнач.Значение / ДанныеОтчета.ФинансовыйРезультат; 	
			КонецЦикла;
		КонецЕсли;			
		
		ДокументРезультат.Вывести(МакетОтчета);
		
	ИначеЕсли ЭтотОбъект.Период.ДатаОкончания >= '20210930' И ЭтотОбъект.СформироватьРазделДоходностиПоУК Тогда  			
		
		// Выводим новый раздел с 01.10.2021 				
		ПодготовитьИВывестиРезультатПоДоходностиУК(ДокументРезультат, ДанныеОтчета, АдресВХранилище, АдресВХранилищеСДаннымиДляРасшифровки, Отказ); 
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;	
		
	КонецЕсли;
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);		
			
КонецПроцедуры

Процедура УстановитьФорматРесурсов(МакетОтчета)
	
	Если ЭтотОбъект.ФорматВывода = 1 Тогда
		МакетОтчета.Область("ОбластьРесурсы").Формат = "ЧДЦ=2";
		Для СчГор = 1 по МакетОтчета.ШиринаТаблицы Цикл
			Для СчВерт = 1 по МакетОтчета.ВысотаТаблицы Цикл
				Ячейка = МакетОтчета.Область(СчГор, СчВерт);
				Если СтрНайти(Ячейка.Текст, " тыс.") Тогда
					Ячейка.Текст = СтрЗаменить(Ячейка.Текст, " тыс.", "");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ЭтотОбъект.ФорматВывода = 0 Тогда
		МакетОтчета.Область("ОбластьРесурсы").Формат = "ЧДЦ=5; ЧС=3";
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеОтчета(ВариантФормы, ТолькоОсновныеДанные, ДатаОбновленияЗаголовкаФинРезультата)
	
	ВидыСубконтоГФУ = ПланыВидовХарактеристик.ВидыСубконто.ГруппыФинансовогоУчетаДоходовРасходов;
	
	ДанныеОтчета = Новый Структура;
	
	ЮрФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",			Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ЮрФизЛицо",		ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация",	Организация);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)
		|					И ЮрФизЛицо = &ЮрФизЛицо) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)";
	
	ДанныеЮрЛицаОрганизации = Запрос.Выполнить().Выгрузить();
	
	Если ДанныеЮрЛицаОрганизации.Количество() = 0 Тогда
		ВызватьИсключение "Не указаны реквизиты юр. лица " + ЮрФизЛицо;
	КонецЕсли;
	
	// Справочные данные
	ДанныеОтчета.Вставить("НомерСтроки", 1);
	ДанныеОтчета.Вставить("ИНН",  		 ДанныеЮрЛицаОрганизации[0].ИНН);
	ДанныеОтчета.Вставить("ОГРН",        ДанныеЮрЛицаОрганизации[0].ОГРН);
	
	ДанныеОтчета.Вставить("ПредставлениеОрганизации", ДанныеЮрЛицаОрганизации[0].КраткоеНаименованиеПоУставу);
	ДанныеОтчета.Вставить("НаименованиеУК", 		ДанныеЮрЛицаОрганизации[0].КраткоеНаименованиеПоУставу);
	ДанныеОтчета.Вставить("ИдентификаторУК", 		ДанныеЮрЛицаОрганизации[0].ПолноеНаименованиеПоУставу + "_" + ДанныеОтчета.ИНН + "_" + ДанныеОтчета.ОГРН);
	ДанныеОтчета.Вставить("ИдентификаторУК_ИНН", 	ДанныеОтчета.ИНН);
	ДанныеОтчета.Вставить("ИдентификаторУК_ОГРН", 	ДанныеОтчета.ОГРН);
	
	ДанныеОтчета.Вставить("ПредставлениеПериода", "с " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	ДанныеОтчета.Вставить("НомерДоговора",        ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора);
	
	ДанныеОтчета.Вставить("ДатаДоговора",          Формат(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
	ДанныеОтчета.Вставить("ДатаДоговораПолностью", Формат(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения, "ДФ='«dd» MMMM yyyy'"));
	
	КлиентДоверительногоУправления = ?(ЭтотОбъект.СформироватьРазделДоходностиПоУК, ЭтотОбъект.Клиент, Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления));
	Если ТипЗнч(КлиентДоверительногоУправления) = Тип("СправочникСсылка.ЮрФизЛица") Тогда		
		ПредставлениеЮрФизЛица = РегистрыСведений.РеквизитыЮридическихЛиц.СрезПоследних(Период.ДатаОкончания, Новый Структура("ЮрФизЛицо,Подразделение,Язык", КлиентДоверительногоУправления, Справочники.Подразделения.ГруппаКомпаний, Справочники.Языки.Русский))[0].КраткоеНаименованиеПоУставу;		
	КонецЕсли;
	
	ДанныеОтчета.Вставить("ПредставлениеЮрФизЛица", ПредставлениеЮрФизЛица);
	
	Если ТолькоОсновныеДанные Тогда
		Возврат ДанныеОтчета;
	КонецЕсли;
		
	// Показатели
	
	ДанныеОтчета.Вставить("ОплатаУслугУК",        ПолучитьВознаграждениеУК());
	
	СР = СуммаРезервовПриПереходеНаМСФО9();
		
	ФинРез = -ОборотЕПС("Сч 710,712,713,715,717,718,720,725,727,728 КорСч !479") - СР;
	ДанныеОтчета.Вставить("ФинансовыйРезультат", Финрез);
	ДанныеОтчета.Вставить("ФинансовыйРезультатВсего",  Финрез);
	
	Если ВариантФормы = "0420254" И ЭтотОбъект.Период.ДатаНачала >= ДатаОбновленияЗаголовкаФинРезультата Тогда
		ВознаграждениеСпецдепа = ПолучитьВознаграждениеСпецдепозитария();
		ДанныеОтчета.Вставить("ФинансовыйРезультат", Финрез + ВознаграждениеСпецдепа);				
		ДанныеОтчета.Вставить("ФинансовыйРезультатВсего",  Финрез - ДанныеОтчета.ОплатаУслугУК);
	КонецЕсли;
		
	ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов;
		
	ДанныеОтчета.Вставить("ОборотыПоСделкам",				0);
	ДанныеОтчета.Вставить("ОборотыПоСделкамНебиржевым",		0);
	ДанныеОтчета.Вставить("ОборотыПоСделкамБиржевым",		0);
	
	ЗаполнитьОборотыПоСделкам(ДанныеОтчета);
	
	ДанныеОтчета.Вставить("ОплатаУслугБрокера",     		  0);
	ДанныеОтчета.Вставить("ОплатаУслугБрокераПоБиржевым",     0);
	ДанныеОтчета.Вставить("ОплатаУслугБрокераПоНебиржевым",   0);
	ДанныеОтчета.Вставить("ОплатаУслугБиржи", 0);
	
	Отказ = Ложь;
	ЗаполнитьОплатыБрокеруИБирже(ДанныеОтчета, Отказ);
	
	Если Отказ Тогда
		ДанныеОтчета.Вставить("Отказ", Отказ);
		Возврат ДанныеОтчета;
	КонецЕсли;
			
	ДанныеОтчета.Вставить("ОплатаУслугСпецДепозитария",						0);
	ДанныеОтчета.Вставить("ОплатаУслугСпецДепозитарияВознаграждение",		0);
	ДанныеОтчета.Вставить("ОплатаУслугСпецДепозитарияНеобходимыеРасходы",	0);
	ДанныеОтчета.Вставить("ОплатаРасходовУправляющейКомпании",				0);
	ДанныеОтчета.Вставить("ОплатаВознагражденияУправляющейКомпании",		0);
	ДанныеОтчета.Вставить("ОплатаРасходовНаСтрахованиеРиска",				0);
	ДанныеОтчета.Вставить("ОплатаУслугБанков",								0);
	ДанныеОтчета.Вставить("ПрочиеРасходы",									0);
	
	ЗаполнитьРасходы(ДанныеОтчета);	
	
	ДанныеОтчета.Вставить("ДивидендыИПроценты",         -ОборотЕПС("Сч 715,725 КорСч !479", ПолучитьУсловиеПоГФУ("345,346", "Субконто1"), ВидыСубконтоГФУ)
														-ОборотЕПС("Сч 710     КорСч !479")
														-ОборотЕПС("Сч 71506   КорСч 60347"));
	ДанныеОтчета.Вставить("РеализацияАктивов",          -ОборотЕПС("Сч 715,725 КорСч !479", ПолучитьУсловиеПоГФУ("331,333,334,335,336,341,343,349,371,421,423,424,425,426,431,433,471", "Субконто1"), ВидыСубконтоГФУ)
														+ОборотЕПС("Сч 71506   КорСч 60347"));
	ДанныеОтчета.Вставить("ИзменениеРыночнойСтоимости", -ОборотЕПС("Сч 715,725 КорСч !479", ПолучитьУсловиеПоГФУ("332,342,372,422,432,472", "Субконто1"), ВидыСубконтоГФУ));
	
	ДанныеОтчета.Вставить("ДругиеВидыДохода",           ДанныеОтчета.ФинансовыйРезультатВсего - ДанныеОтчета.ДивидендыИПроценты - ДанныеОтчета.РеализацияАктивов - ДанныеОтчета.ИзменениеРыночнойСтоимости);
	
	// Для расшифровки

	ПоляРасшифровки = Новый Структура;	
	
	Для Каждого Поле Из ДанныеОтчета Цикл
		ПоляРасшифровки.Вставить("Расшифровка" + Поле.Ключ, Поле.Ключ);						
	КонецЦикла;
	
	РаботаСКоллекциями.ДополнитьСтруктуру(ДанныеОтчета, ПоляРасшифровки);	
	
	Возврат ДанныеОтчета;
	
КонецФункции

Функция ЗаполнитьОборотыПоСделкам_ПолучитьТекстЗапроса()
		
	ТекстЗапроса = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	    |			&КонецПериода,
	    |			СчетДоверительногоУправления = &СчетДоверительногоУправления
	    |				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
	    |;
