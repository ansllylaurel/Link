Процедура ЗаполнитьОборотыПоСделкам(ДанныеОтчета)
	
	ТекстЗапроса = ЗаполнитьОборотыПоСделкам_ПолучитьТекстЗапроса();
	
	Запрос = Новый Запрос(ТекстЗапроса);	
	
	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()
		и Выборка.ОборотыПоСделкам <> NULL Тогда
		ЗаполнитьЗначенияСвойств(ДанныеОтчета, Выборка);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВознаграждениеСпецдепозитария()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход КАК СуммаПриход
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецдепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамДепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии))) КАК ЗадолженностиПоДенежнымСредствамОбороты";
	
	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.СуммаПриход, 0);
	
КонецФункции

Функция ПолучитьЗначениеДопСведенийНеУчитыватьРЕПО(ЮрФизЛицо);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""НеУчитыватьСделкиРЕПОВОборотахПоСделкам""
		|	И ЗначенияДополнительныхСведений.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Ключ", 	"СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании");
	Запрос.УстановитьПараметр("Объект", ЮрФизЛицо);
		
