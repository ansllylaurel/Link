Функция СтандартМСФОИзНастроек(Субъект, Отказ = Ложь) Экспорт
		
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НастройкиУчетаОбщиеСрезПоследних.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов КАК СтандартМСФО
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(&Субъект) = ТИП(Справочник.СчетаДоверительногоУправления)
		|						ТОГДА СчетДоверительногоУправления = &Субъект
		|					ИНАЧЕ СчетДоверительногоУправления.ДатаЗаключения < &Дата
		|							И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|								ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &Дата)
		|							И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговора
		|				КОНЕЦ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Дата, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Организация = НастройкиУчетаОбщиеСрезПоследних.Организация
		|			И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(&Субъект) = ТИП(Справочник.ЮрФизЛица)
		|				ТОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Субъект
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И НастройкиУчетаОбщиеСрезПоследних.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов ЕСТЬ НЕ NULL 
		|
		|УПОРЯДОЧИТЬ ПО
		|	КлиентыДоверительногоУправленияСрезПоследних.Период УБЫВ");
	
	Запрос.УстановитьПараметр("Дата",			ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Субъект", 		Субъект);
	Запрос.УстановитьПараметр("ВидДоговора",	ЭтотОбъект.ВидДоговораДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.СтандартМСФО;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В регистре 'Настройки учета общие' отсутсвтуют настройки по портфелям клиента",,,, Отказ);
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область Формирование_расшифровки

Функция ПолучитьВыборкуРасшифровкиЯчейки(ПолеРасшифровки, ДополнительныеДанные, ВариантФормы = Неопределено, МенеджерВременныхТаблиц = Неопределено) Экспорт
				
	// Текст запроса варьируется в зависимости от колонки
		
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = ?(МенеджерВременныхТаблиц = Неопределено, Новый МенеджерВременныхТаблиц, МенеджерВременныхТаблиц);
	
	Если ПолеРасшифровки = "СредневзвешенныеВложения" Тогда
		
		#Область Средневзвешенные_вложения
		
		// Дополнительные данные: Актив,НомерБлока,Контрагент
						
		// Определяем имя таблицы, из которой брать данные для расшифровки		
		Если ДополнительныеДанные.НомерБлока = 21
				Или (ДополнительныеДанные.НомерБлока >= 1 И ДополнительныеДанные.НомерБлока <= 15) Тогда
				
			ИмяТаблицыРасшифровки = "_Средневзвешенные_ЦенныеБумаги_Развернуто";
				
		ИначеЕсли ДополнительныеДанные.НомерБлока = 16 
				Или ДополнительныеДанные.НомерБлока = 17 
				Или ДополнительныеДанные.НомерБлока = 18 Тогда
			
			ИмяТаблицыРасшифровки = "_Средневзвешенные_ДенежныеСредства_Развернуто";
			
		ИначеЕсли ДополнительныеДанные.НомерБлока = 19 Тогда
						
			ИмяТаблицыРасшифровки = "_Средневзвешенные_Депозиты_Развернуто";
			
		ИначеЕсли ДополнительныеДанные.НомерБлока = 23 Тогда
			
			ИмяТаблицыРасшифровки = "_Средневзвешенные_ДЗпоНКД_Развернуто";
			
		ИначеЕсли ДополнительныеДанные.НомерБлока = 26 
				Или ДополнительныеДанные.НомерБлока = 28 Тогда
			
			ИмяТаблицыРасшифровки = "_Средневзвешенные_СделкиРЕПО_Развернуто";
			
		Иначе
			
			ИмяТаблицыРасшифровки = "_Средневзвешенные_Задолженность_Развернуто";
			
		КонецЕсли;	
				
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&КлассАктива КАК КлассАктива,
			|	&ИдентификаторАктива КАК ИдентификаторАктива,
			|	_ТаблицаРасшифровки.Актив КАК Актив,
			|	_ТаблицаРасшифровки.Дата КАК Дата,
			|	_ТаблицаРасшифровки.Действие КАК Действие,
			|	СУММА(_ТаблицаРасшифровки.СправедливаяСтоимость) КАК СправедливаяСтоимость,
			|	СУММА(_ТаблицаРасшифровки.Поток) КАК Поток,
			|	СУММА(_ТаблицаРасшифровки.Количество) КАК Количество,
			|	_ТаблицаРасшифровки.ДнейВРаботе КАК ДнейВРаботе,
			|	_ТаблицаРасшифровки.ДнейВРаботе_Процент КАК ДнейВРаботе_Процент,
			|	СУММА(_ТаблицаРасшифровки.СредневзвешенныеВложения) КАК СредневзвешенныеВложения,
			|	ВЫБОР
			|		КОГДА _ТаблицаРасшифровки.Действие = ""(входящий остаток)""
			|			ТОГДА 0
			|		КОГДА _ТаблицаРасшифровки.Действие = ""(исходящий остаток)""
			|			ТОГДА 10
			|		ИНАЧЕ 1
			|	КОНЕЦ КАК Порядок
			|ИЗ
			|	&ИмяТаблицыРасшифровки КАК _ТаблицаРасшифровки
			|ГДЕ
			|	_ТаблицаРасшифровки.Актив В(&Актив)
			|	И &ДополнительноеУсловие
			|
			|СГРУППИРОВАТЬ ПО
			|	_ТаблицаРасшифровки.Актив,
			|	_ТаблицаРасшифровки.Дата,
			|	_ТаблицаРасшифровки.Действие,
			|	_ТаблицаРасшифровки.ДнейВРаботе,
			|	_ТаблицаРасшифровки.ДнейВРаботе_Процент
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата,
			|	Порядок
			|ИТОГИ
			|	СУММА(Поток),
			|	СУММА(СредневзвешенныеВложения)
			|ПО
			|	ОБЩИЕ";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяТаблицыРасшифровки", ИмяТаблицыРасшифровки);
		
		// Дополнительные условия в зависимости от актива			
		Если (ДополнительныеДанные.НомерБлока = 25 
			Или ДополнительныеДанные.НомерБлока = 29) И Не ДополнительныеДанные.Актив = "Комиссии по сделкам" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие", "_ТаблицаРасшифровки.Контрагент = &Контрагент");

			Запрос.УстановитьПараметр("Контрагент", ДополнительныеДанные.Контрагент);
			
		ИначеЕсли ИмяТаблицыРасшифровки = "_Средневзвешенные_ЦенныеБумаги_Развернуто" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие", "_ТаблицаРасшифровки.УчетныйАктивЕПС = &КлассификацияАктива");
			
			Запрос.УстановитьПараметр("КлассификацияАктива", 	ДополнительныеДанные.КлассификацияАктива);
					
		Иначе 
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие", "ИСТИНА");
			
		КонецЕсли;	
				
		Запрос.УстановитьПараметр("Актив", 					ДополнительныеДанные.Актив);
		Запрос.УстановитьПараметр("КлассАктива", 			ДополнительныеДанные.КлассАктива);
		Запрос.УстановитьПараметр("ИдентификаторАктива", 	ДополнительныеДанные.ИдентификаторАктива);
				
		Возврат Запрос.Выполнить().Выбрать();  		
		
		#КонецОбласти		
		
	ИначеЕсли ПолеРасшифровки = "ДоходыОтПродажи" 
		Или ПолеРасшифровки = "ПроцентныеДоходы"
		Или ПолеРасшифровки = "ДоходыОтПереоценки"
		Или ПолеРасшифровки = "ДоходыПрочие"
		Или ПолеРасшифровки = "ДоходыВсего" Тогда
		
		#Область Доходы_расходы
				
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&КлассАктива КАК КлассАктива,
			|	&ИдентификаторАктива КАК ИдентификаторАктива,
			|	_ТаблицаРасшифровки.ЦеннаяБумага КАК Актив,
			|	_ТаблицаРасшифровки.ВидЗадолженности КАК ВидЗадолженности,
			|	_ТаблицаРасшифровки.Контрагент КАК Контрагент,
			|	_ТаблицаРасшифровки.Регистратор КАК Регистратор,
			|	_ТаблицаРасшифровки.РазделОтчета КАК РазделОтчета,
			|	_ТаблицаРасшифровки.Дата КАК Дата,
			|	СУММА(_ТаблицаРасшифровки.ДоходРасход) КАК Сумма
			|ИЗ
			|	_ДоходыРасходыДляРасшифровки КАК _ТаблицаРасшифровки
			|ГДЕ
			|	_ТаблицаРасшифровки.ЦеннаяБумага В(&Актив)
			|	И _ТаблицаРасшифровки.НомерБлока = &НомерБлока
			|	И &УсловиеНаКолонку
			|	И &ДополнительноеУсловие
			|
			|СГРУППИРОВАТЬ ПО
			|	_ТаблицаРасшифровки.ЦеннаяБумага,
			|	_ТаблицаРасшифровки.Регистратор,
			|	_ТаблицаРасшифровки.ВидЗадолженности,
			|	_ТаблицаРасшифровки.Контрагент,
			|	_ТаблицаРасшифровки.РазделОтчета,
			|	_ТаблицаРасшифровки.Дата
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата
			|ИТОГИ ПО
			|	ОБЩИЕ";		
		
		//// Дополнительные условия в зависимости от актива			
		Если (ДополнительныеДанные.НомерБлока = 25 
			Или ДополнительныеДанные.НомерБлока = 29) И Не ДополнительныеДанные.Актив = "Комиссии по сделкам" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие", "_ТаблицаРасшифровки.Контрагент = &Контрагент");

			Запрос.УстановитьПараметр("Контрагент", ДополнительныеДанные.Контрагент);
							
		Иначе 
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие", "ИСТИНА");
			
		КонецЕсли;	
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаКолонку", ?(ПолеРасшифровки = "ДоходыВсего", "ИСТИНА", "_ТаблицаРасшифровки.РазделОтчета = &РазделОтчета"));
				
		Запрос.УстановитьПараметр("Актив", 					ДополнительныеДанные.Актив);
		Запрос.УстановитьПараметр("КлассАктива", 			ДополнительныеДанные.КлассАктива);
		Запрос.УстановитьПараметр("ИдентификаторАктива", 	ДополнительныеДанные.ИдентификаторАктива);
		Запрос.УстановитьПараметр("НомерБлока", 			ДополнительныеДанные.НомерБлока);
		Запрос.УстановитьПараметр("РазделОтчета", 			ПолеРасшифровки);
		
		Возврат Запрос.Выполнить().Выбрать();  		
		
		#КонецОбласти	
		
	ИначеЕсли Лев(ПолеРасшифровки, 16) = "ОборотыПоСделкам" Тогда
		
		#Область Обороты_по_сделкам
		
		ТекстЗапроса = ЗаполнитьОборотыПоСделкам_ПолучитьТекстЗапроса();		
		ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, ПолеРасшифровки);
		
		#КонецОбласти		
		
	ИначеЕсли Лев(ПолеРасшифровки, 18) = "ОплатаУслугБрокера" Тогда
		
		#Область Комиссия_брокера
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Отказ = Ложь;
		ДанныеПоКомиссиям(Запрос, Отказ);
		
		Если Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;

		ТекстЗапроса = ЗаполнитьОплатыБрокеру_ПолучитьТекстЗапроса();
		ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, ПолеРасшифровки);
				
		#КонецОбласти		
		
	ИначеЕсли ПолеРасшифровки = "ОплатаУслугБиржи" Тогда
		
		#Область Комиссия_биржи 		
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Отказ = Ложь;
		ДанныеПоКомиссиям(Запрос, Отказ);

		Если Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТекстЗапроса = ЗаполнитьОплатыБирже_ПолучитьТекстЗапроса(); 		
		ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, ПолеРасшифровки);
			
		#КонецОбласти		
		
	Иначе
		
		#Область Остальные_расходы		
		
		ТекстЗапроса = ЗаполнитьРасходы_ПолучитьТекстЗапроса(ПолеРасшифровки);
		
		ТекстЗапроса = ТекстЗапроса + ";
		|";
		
		ТекстЗапроса = ТекстЗапроса +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ПолеСуммы КАК Сумма,
		|	_ПрочиеРасходы.Период КАК Дата,
		|	_ПрочиеРасходы.Регистратор КАК Регистратор
		|ИЗ
		|	_ПрочиеРасходы КАК _ПрочиеРасходы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	ОБЩИЕ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСуммы", "_ПрочиеРасходы." + ПолеРасшифровки);
		
		#КонецОбласти		
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, ПолеРасшифровки) 
	
	СоответствиеКолонок = Новый Соответствие;
	СоответствиеКолонок.Вставить("ОборотыПоСделкам", 				"СуммаОборотДт");
	СоответствиеКолонок.Вставить("ОборотыПоСделкамБиржевым", 		"СуммаБиржевых");
	СоответствиеКолонок.Вставить("ОборотыПоСделкамНебиржевым", 		"СуммаВнебиржевых");
	СоответствиеКолонок.Вставить("ОплатаУслугБрокера", 				"ОплатаУслугБрокера");
	СоответствиеКолонок.Вставить("ОплатаУслугБрокераПоБиржевым", 	"ОплатаУслугБрокераПоБиржевым");
	СоответствиеКолонок.Вставить("ОплатаУслугБрокераПоНебиржевым", 	"ОплатаУслугБрокераПоНебиржевым");
	СоответствиеКолонок.Вставить("ОплатаУслугБиржи", 				"ОплатаУслугБиржи");
			
	НайдКолонка = СоответствиеКолонок.Получить(ПолеРасшифровки);
	Если НайдКолонка = Неопределено Тогда		
		Возврат;
	КонецЕсли;
	
	Если Лев(ПолеРасшифровки, 16) = "ОборотыПоСделкам" Тогда 
		
		// Обороты по сделкам обрабатываем отдельно, т. к. нужна колонка с ценными бумагами				
		ТекстЗапроса = ТекстЗапроса + "; 
		|";
		
		ТекстЗапроса = ТекстЗапроса +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОборотыПоСделкам.Сделка КАК Регистратор,
		|	СУММА(&ПолеСуммы) КАК Сумма,
		|	_ОборотыПоСделкам.Сделка.Дата КАК Дата,
		|	_ОборотыПоСделкам.ДатаОперации КАК ДатаОперации,
		|	_ЦенныеБумагиСделок.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	_ОборотыПоСделкамРазвернутые КАК _ОборотыПоСделкам
