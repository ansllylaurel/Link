Процедура ПодготовитьИВывестиРезультатПоДоходностиУК(ДокументРезультат, ДанныеОтчета, АдресВХранилище = "", АдресВХранилищеСДаннымиДляРасшифровки = "", Отказ = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
	ПоместитьСоответствиеУчетныхАктивовЕПСИГФУВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	
	ПолучитьТаблицуВидовАктивов(Запрос);
	
	ПолучитьДоходыИРасходыЗаПериод(Запрос, АдресВХранилищеСДаннымиДляРасшифровки);	
	
	ПолучитьСостояниеПортфеляНаДату(Запрос, ЭтотОбъект.Период.ДатаНачала, Истина);
	ПолучитьСостояниеПортфеляНаДату(Запрос, ЭтотОбъект.Период.ДатаОкончания, Ложь);
	
	ПолучитьСредневзвешенныеВложенияЗаПериод(Запрос.МенеджерВременныхТаблиц, АдресВХранилищеСДаннымиДляРасшифровки);
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ПортфельНаНачалоПериода.КлассАктива, _ПортфельНаКонецПериода.КлассАктива) КАК КлассАктива,
		|	ЕСТЬNULL(_ПортфельНаНачалоПериода.НомерБлока, _ПортфельНаКонецПериода.НомерБлока) КАК НомерБлока,
		|	ЕСТЬNULL(_ПортфельНаНачалоПериода.Актив, _ПортфельНаКонецПериода.Актив) КАК Актив,
		|	ЕСТЬNULL(_ПортфельНаНачалоПериода.Контрагент, _ПортфельНаКонецПериода.Контрагент) КАК Контрагент,
		|	ЕСТЬNULL(_ПортфельНаНачалоПериода.БалансоваяСтоимость, 0) КАК БалансоваяСтоимостьНачало,
		|	ЕСТЬNULL(_ПортфельНаКонецПериода.БалансоваяСтоимость, 0) КАК БалансоваяСтоимостьКонец,
		|	ЕСТЬNULL(_ПортфельНаНачалоПериода.УчетныйАктивЕПС, ЕСТЬNULL(_ПортфельНаКонецПериода.УчетныйАктивЕПС, НЕОПРЕДЕЛЕНО)) КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ _Портфель
		|ИЗ
		|	_ПортфельНаНачалоПериода КАК _ПортфельНаНачалоПериода
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ПортфельНаКонецПериода КАК _ПортфельНаКонецПериода
		|		ПО _ПортфельНаНачалоПериода.НомерБлока = _ПортфельНаКонецПериода.НомерБлока
		|			И _ПортфельНаНачалоПериода.Актив = _ПортфельНаКонецПериода.Актив
		|			И _ПортфельНаНачалоПериода.Контрагент = _ПортфельНаКонецПериода.Контрагент
		|			И (ЕСТЬNULL(_ПортфельНаНачалоПериода.УчетныйАктивЕПС, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(_ПортфельНаКонецПериода.УчетныйАктивЕПС, НЕОПРЕДЕЛЕНО))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НЕ _СредневзвешенныеВложения.Актив ЕСТЬ NULL
		|			ТОГДА ""Дебиторская задолженность по накопленному купонному доходу (НКД)""
		|		ИНАЧЕ ЕСТЬNULL(_Портфель.КлассАктива, _ДоходыРасходы.КлассАктива)
		|	КОНЕЦ КАК КлассАктива,
		|	ЕСТЬNULL(_Портфель.УчетныйАктивЕПС, ЕСТЬNULL(_ДоходыРасходы.УчетныйАктивЕПС, НЕОПРЕДЕЛЕНО)) КАК УчетныйАктивЕПС,
		|	ВЫБОР
		|		КОГДА НЕ _СредневзвешенныеВложения.Актив ЕСТЬ NULL
		|			ТОГДА 23
		|		ИНАЧЕ ЕСТЬNULL(_Портфель.НомерБлока, _ДоходыРасходы.НомерБлока)
		|	КОНЕЦ КАК НомерБлока,
		|	ЕСТЬNULL(_СредневзвешенныеВложения.Актив, ЕСТЬNULL(_Портфель.Актив, _ДоходыРасходы.ЦеннаяБумага)) КАК Актив,
		|	ЕСТЬNULL(_Портфель.Контрагент, _ДоходыРасходы.Контрагент) КАК Контрагент,
		|	ЕСТЬNULL(_Портфель.БалансоваяСтоимостьНачало, 0) КАК БалансоваяСтоимостьНачало,
		|	ЕСТЬNULL(_Портфель.БалансоваяСтоимостьКонец, 0) КАК БалансоваяСтоимостьКонец,
		|	ЕСТЬNULL(_ДоходыРасходы.ДоходыОтПродажи, 0) КАК ДоходыОтПродажи,
		|	ЕСТЬNULL(_ДоходыРасходы.ПроцентныеДоходы, 0) КАК ПроцентныеДоходы,
		|	ЕСТЬNULL(_ДоходыРасходы.ДоходыОтПереоценки, 0) КАК ДоходыОтПереоценки,
		|	ЕСТЬNULL(_ДоходыРасходы.ДоходыПрочие, 0) КАК ДоходыПрочие
		|ПОМЕСТИТЬ _Результат_ОсновныеДанные
		|ИЗ
		|	_Портфель КАК _Портфель
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ДоходыРасходы КАК _ДоходыРасходы
		|		ПО _Портфель.НомерБлока = _ДоходыРасходы.НомерБлока
		|			И _Портфель.Актив = _ДоходыРасходы.ЦеннаяБумага
		|			И _Портфель.Контрагент = _ДоходыРасходы.Контрагент
		|			И (ЕСТЬNULL(_Портфель.УчетныйАктивЕПС, НЕОПРЕДЕЛЕНО) = ЕСТЬNULL(_ДоходыРасходы.УчетныйАктивЕПС, НЕОПРЕДЕЛЕНО))
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_СредневзвешенныеВложения.Актив КАК Актив
		|		ИЗ
		|			_СредневзвешенныеВложения КАК _СредневзвешенныеВложения
		|		ГДЕ
		|			_СредневзвешенныеВложения.Раздел = ""Дебиторская задолженность по накопленному купонному доходу (НКД)"") КАК _СредневзвешенныеВложения
		|		ПО _Портфель.Актив = _СредневзвешенныеВложения.Актив
		|			И (_Портфель.НомерБлока = 23)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Результат_ОсновныеДанные.Актив КАК Облигация
		|ПОМЕСТИТЬ _Облигации
		|ИЗ
		|	_Результат_ОсновныеДанные КАК _Результат_ОсновныеДанные
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(_Результат_ОсновныеДанные.Актив) = ТИП(Справочник.Облигации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК Актив,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.Родитель КАК УчетныйАктивЕПС,
		|	МАКСИМУМ(БухПартииЦенныхБумаг.Период) КАК Дата
		|ПОМЕСТИТЬ _УчетныеАктивыЕПС
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Организация = &Организация
		|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И БухПартииЦенныхБумаг.Активность
		|	И БухПартииЦенныхБумаг.ЦеннаяБумага В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_Результат_ОсновныеДанные.Актив
		|			ИЗ
		|				_Результат_ОсновныеДанные
		|			ГДЕ
		|				(_Результат_ОсновныеДанные.НомерБлока МЕЖДУ 1 И 15
		|					ИЛИ _Результат_ОсновныеДанные.НомерБлока = 21))
		|
		|СГРУППИРОВАТЬ ПО
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС.Родитель
		|;
