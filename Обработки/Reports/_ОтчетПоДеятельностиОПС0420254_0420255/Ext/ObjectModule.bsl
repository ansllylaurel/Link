	|				ТОГДА _КомиссииПоСделкам.Сумма
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОплатаУслугБрокераПоНебиржевым,
	|	СУММА(ВЫБОР
	|			КОГДА _КомиссииПоСделкам.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
	|				ТОГДА 0
	|			ИНАЧЕ _КомиссииПоСделкам.Сумма
	|		КОНЕЦ) КАК ОплатаУслугБрокераПоБиржевым,
	|	_КомиссииПоСделкам.Период КАК Период,
	|	_КомиссииПоСделкам.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ _ОплатыБрокеру
	|ИЗ
	|	_КомиссииПоСделкам КАК _КомиссииПоСделкам
	|ГДЕ
	|	_КомиссииПоСделкам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
	|
	|СГРУППИРОВАТЬ ПО
	|	_КомиссииПоСделкам.Период,
	|	_КомиссииПоСделкам.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(_ОплатыБрокеру.ОплатаУслугБрокера) КАК ОплатаУслугБрокера,
	|	СУММА(_ОплатыБрокеру.ОплатаУслугБрокераПоНебиржевым) КАК ОплатаУслугБрокераПоНебиржевым,
	|	СУММА(_ОплатыБрокеру.ОплатаУслугБрокераПоБиржевым) КАК ОплатаУслугБрокераПоБиржевым
	|ИЗ
	|	_ОплатыБрокеру КАК _ОплатыБрокеру";
	
	Возврат ТекстЗапроса;
	
КонецФункции
	
Процедура ДанныеПоКомиссиям(Запрос, Отказ = Ложь)
	
	УстановитьОбщиеПараметрыЗапроса(Запрос);	
	
	ДатаПоследнейСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	Если Не ЗначениеЗаполнено(ДатаПоследнейСЧА) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить настройки формирования СЧА за выбранный период для счета ДУ " + СокрЛП(ЭтотОбъект.СчетДоверительногоУправления), ЭтотОбъект.СчетДоверительногоУправления);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Договора еще могло не быть на начало периода, тогда используем последний рабочий день до даты начала периода
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "ДатаЗаключения") < НачалоДня(ЭтотОбъект.Период.ДатаНачала) Тогда	
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала);
	Иначе
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Период.ДатаНачала) - 1 , -1);
	КонецЕсли;
		
	Запрос.УстановитьПараметр("ДатаПоследнейСЧАДоНачалаПериода", ДатаПоследнейСЧАДоНачалаПериода);  
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	|ПОМЕСТИТЬ _СчетаДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	|			&КонецПериода,
	|			СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
	|;";
	
	Запрос.Выполнить();
	
	РаботаСОтчетами.ПоместитьКомиссииПоСделкамЗаПериодВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, Новый Структура("ДатаПоследнейСЧА, ДатаПоследнейСЧАДоначалаПериода", ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода),,, Отказ);
	  
КонецПроцедуры

Процедура ЗаполнитьОплатыБрокеруИБирже(ДанныеОтчета, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ДанныеПоКомиссиям(Запрос, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = ЗаполнитьОплатыБрокеру_ПолучитьТекстЗапроса();   	
				
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()
		и Выборка.ОплатаУслугБрокера <> NULL Тогда
		ЗаполнитьЗначенияСвойств(ДанныеОтчета, Выборка);
	КонецЕсли;
	
	Запрос.Текст = ЗаполнитьОплатыБирже_ПолучитьТекстЗапроса();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий()
		и Выборка.ОплатаУслугБиржи <> NULL Тогда
		ЗаполнитьЗначенияСвойств(ДанныеОтчета, Выборка);
	КонецЕсли;

КонецПроцедуры

