Процедура СредневзвешенныеВложения_УстановитьПараметры(Запрос)
	
	Запрос.УстановитьПараметр("НачалоПериода",								ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",								ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериодаГраница",						Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",								Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",				СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДЗПоЦБКупонуИДивидендамВключатьВРазделыЦБ", 	ДЗПоЦБКупонуИДивидендамВключатьВРазделыЦБ());
    Запрос.УстановитьПараметр("НачалоПериодаСРВЗ", 							?(ЭтотОбъект.Период.ДатаНачала = '20250101', '20250101000002', ЭтотОбъект.Период.ДатаНачала));
	
	МассивСубконтоКонтрагентыОснованиеРасчетов = Новый Массив;
	МассивСубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	МассивСубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);	
	
	Запрос.УстановитьПараметр("СубконтоКонтрагентыОснованиеРасчетов", МассивСубконтоКонтрагентыОснованиеРасчетов);

	СчетаДС = Новый Массив;
	СчетаДС.Добавить(ПланыСчетов.Единый.РасчетныеСчета);
	СчетаДС.Добавить(ПланыСчетов.Единый.РасчетыСБрокерами);
	СчетаДС.Добавить(ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами05);
	СчетаДС.Добавить(ПланыСчетов.Единый.Расчеты22);

	Запрос.УстановитьПараметр("СчетаДС", СчетаДС);
	
КонецПроцедуры

Процедура СредневзвешенныеВложения_ОсновнойЗапрос(Запрос, ИмяТаблицы = Неопределено, СоответствиеРезультатовЗапросаДляРасшифровки = Неопределено)
	
	// Процедура используется и для всего отчета, и для расшифровки.
	// Поэтому запрос собирается и выполняется по частям
	
	Если ИмяТаблицы <> Неопределено Тогда
		ПоместитьСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
		ПоместитьСоответствиеУчетныхАктивовЕПСИГФУВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц);
	КонецЕсли;
	
	#Область Общие_таблицы
	
	// Таблицы курсов и количества дней нужны в любом случае
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РАЗНОСТЬДАТ(&НачалоПериода, &КонецПериода, ДЕНЬ) + 1 КАК ДнейВПериоде
		|ПОМЕСТИТЬ _КоличествоДней
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Период КАК Период,
		|	КурсыВалют.Валюта КАК Валюта,
		|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
		|ПОМЕСТИТЬ _КурсыВалют
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период МЕЖДУ ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, -1) И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _ДниПериода
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, -1) И &КонецПериода";
	
	Запрос.Выполнить(); 		
		
	Если ИмяТаблицы = Неопределено 
		Или ИмяТаблицы = "_Средневзвешенные_ДенежныеСредства_Развернуто"
		Или ИмяТаблицы = "_Средневзвешенные_Депозиты_Развернуто" Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент КАК ДепозитныйВклад,
			|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет КАК РасчетныйСчет
			|ПОМЕСТИТЬ _СписокДепозитов
			|ИЗ
			|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
			|			&НачалоПериодаСРВЗ,
			|			&КонецПериодаГраница,
			|			,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДоверительногоУправления)
			|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
			|				И ВидКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ВидыКредитныхИнструментов.Выданный)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты";
		
		Запрос.Выполнить();
		
	КонецЕсли;	
	
	#КонецОбласти
	
	#Область Денежные_средства
	
	Если ИмяТаблицы = Неопределено 
		Или ИмяТаблицы = "_Средневзвешенные_ДенежныеСредства_Развернуто" Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК СчетУчета,
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ДепозитныйВклад,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
			|ПОМЕСТИТЬ _ДепозитныеВкладыОстатки_Начало
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&НачалоПериодаСРВЗ,
			|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты09), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты11)),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДепозитныеВклады),
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДоверительногоУправления)) КАК ЕдиныйБухгалтерскийУчетОстатки
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|			&НачалоПериодаСРВЗ,
			|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты13)),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В
			|					(ВЫБРАТЬ
			|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
			|					ИЗ
			|						_СчетаДоверительногоУправления)) КАК ЕдиныйБухгалтерскийУчетОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК СчетУчета,
			|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ДепозитныйВклад,
			|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
