Функция СуммаРезервовПриПереходеНаМСФО9(МенеджерВременныхТаблиц = Неопределено)
	
	Если ЭтотОбъект.Период.ДатаНачала <> '20250101' Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕдиныйБухгалтерскийУчетОбороты.СуммаОборотДт) КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
		|			,
		|			) КАК ЕдиныйБухгалтерскийУчетОбороты";
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетДоверительногоУправления = &СчетДоверительногоУправления", "СчетДоверительногоУправления В (ВЫБРАТЬ _СчетаДоверительногоУправления.СчетДоверительногоУправления ИЗ _СчетаДоверительногоУправления)");
	КонецЕсли;
	
	УстановитьОбщиеПараметрыЗапроса(Запрос);
	
	Запрос.УстановитьПараметр("НачалоПериода", '20250101000001');
	Запрос.УстановитьПараметр("КонецПериода", '20250101000001');
	
	Выборка = Запрос.Выполнить().Выбрать();
      
	Возврат ?(Выборка.Следующий(), Выборка.Сумма, 0);
	
