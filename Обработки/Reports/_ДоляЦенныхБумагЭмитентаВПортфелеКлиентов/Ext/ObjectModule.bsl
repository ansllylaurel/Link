// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Доля ценных бумаг эмитента в портфеле клиентов",
		"1.03",
		"",
		Истина
	);
		
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Если ВсеСчаСформированы() Тогда
	
		Настройки = КомпоновщикНастроек.Настройки;
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация",	ЭтотОбъект.Организация);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период",			ЭтотОбъект.Период);
		
		РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
		
	Иначе
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли; 
		
КонецПроцедуры

Функция ВсеСчаСформированы()

	МВТ = Новый МенеджерВременныхТаблиц;
	
	Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
		ЭтотОбъект.Период, 
		Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(ЭтотОбъект.Организация),
		Истина,
		,
		МВТ);
	
	СКДКонтрольНаличияСЧА = ПолучитьМакет("СКДКонтрольНаличияСЧА");
	
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	НастройкиКонтроля = СКДКонтрольНаличияСЧА.НастройкиПоУмолчанию;
	НастройкиКонтроля.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ЭтотОбъект.Период);
	
	Справочники.ИнвестиционныеДекларации.ЗаполнитьОтбор(НастройкиКонтроля.Отбор, НастройкиОтчета.Отбор);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКДКонтрольНаличияСЧА));
	Компоновщик.ЗагрузитьНастройки(НастройкиКонтроля);
	Компоновщик.Восстановить();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	СчетаБезСЧА = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(СчетаБезСЧА);
		
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКДКонтрольНаличияСЧА, Компоновщик.ПолучитьНастройки(),,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,,,, МВТ);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	КоличествоСчетовБезСЧА = СчетаБезСЧА.Количество();
	
	Результат = Истина;
	
	Если КоличествоСчетовБезСЧА > 0 Тогда
		
		Результат = Ложь;
		
		Ограничитель = ?(КоличествоСчетовБезСЧА < 6, КоличествоСчетовБезСЧА, 5); 
		МассивСчетов = Новый Массив;
		
		Для Индекс = 0 По Ограничитель-1 Цикл
			МассивСчетов.Добавить(СчетаБезСЧА[Индекс].СчетДоверительногоУправления);
		КонецЦикла; 
		
		ТекстСообщения = СтрШаблон("Отсутствует документ Регистрация стоимости активов по: '%1'", СтрСоединить(МассивСчетов, "', '"));
		
		Если Ограничитель <> КоличествоСчетовБезСЧА Тогда
		
			ТекстСообщения = ТекстСообщения + ", а также еще по " + (КоличествоСчетовБезСЧА - Ограничитель) + " счетам.";
		
		КонецЕсли; 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения); 
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции 