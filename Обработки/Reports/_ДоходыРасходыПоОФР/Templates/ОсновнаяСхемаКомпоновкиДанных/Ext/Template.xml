		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕдиныйБухгалтерскийУчетОбороты.Счет КАК Счет,
	ЕдиныйБухгалтерскийУчетОбороты.Счет.Наименование КАК СчетНаименование,
	ЕдиныйБухгалтерскийУчетОбороты.Организация КАК Организация,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.Субконто1
		ИНАЧЕ НЕОПРЕДЕЛЕНО
	КОНЕЦ КАК СимволОФРПоДТ,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.Субконто1
		ИНАЧЕ НЕОПРЕДЕЛЕНО
	КОНЕЦ КАК СимволОФРПоКТ,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		ИНАЧЕ 0
	КОНЕЦ КАК ОстатокПоДТ,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			ТОГДА -ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		ИНАЧЕ 0
	КОНЕЦ КАК ОстатокПоКТ
ПОМЕСТИТЬ _ИтоговаяТаблица
ИЗ
	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			,
			Счет В ИЕРАРХИИ (&amp;Счет),
			,
			Организация = &amp;Организация
				И СчетДоверительногоУправления = &amp;СчетДоверительногоУправления,
			НЕ КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03),
			) КАК ЕдиныйБухгалтерскийУчетОбороты

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЕдиныйБухгалтерскийУчетОбороты.Счет,
	ЕдиныйБухгалтерскийУчетОбороты.Счет.Наименование,
	ЕдиныйБухгалтерскийУчетОбороты.Организация,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.Субконто1
		ИНАЧЕ НЕОПРЕДЕЛЕНО
	КОНЕЦ,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.Субконто1
		ИНАЧЕ НЕОПРЕДЕЛЕНО
	КОНЕЦ,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫБОР
		КОГДА ЕдиныйБухгалтерскийУчетОбороты.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
			ТОГДА -ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот
		ИНАЧЕ 0
	КОНЕЦ
ИЗ
	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			,
			Счет В ИЕРАРХИИ (&amp;Счет),
			,
			Организация = &amp;Организация
				И СчетДоверительногоУправления = &amp;СчетДоверительногоУправления
				И ЛицевойСчетКор.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего),
			КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03),
			) КАК ЕдиныйБухгалтерскийУчетОбороты
;

