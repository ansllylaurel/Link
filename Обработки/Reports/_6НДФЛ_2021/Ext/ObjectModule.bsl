Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Данные для 6-НДФЛ (2021)",
		"0.07",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
		
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ЭтотОбъект.Организация);
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);

	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", ЭтотОбъект.Период.ДатаНачала);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", ЭтотОбъект.Период.ДатаОкончания);
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачалаРасчетов", НачалоГода(ДобавитьМесяц(ЭтотОбъект.Период.ДатаНачала, -1)));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончанияРасчетов", ЭтотОбъект.Период.ДатаОкончания+1);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаСледующийКвартал", КонецКвартала(ЭтотОбъект.Период.ДатаОкончания+1));
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачалаДивиденды", НачалоГода(ЭтотОбъект.Период.ДатаНачала));
		
	СписокДивиденды = Новый Массив;
	СписокДивиденды.Добавить(Справочники.ВидыДоходовНДФЛ.Код1010);
	СписокДивиденды.Добавить(Справочники.ВидыВычетовНДФЛ.Код601);
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Дивиденды", СписокДивиденды);
	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
	
КонецПроцедуры
