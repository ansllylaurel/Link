		СтрокаОтчета.СебестоимостьВыбытия = СтрокаОтчета.СебестоимостьВыбытия - СтрокаТаблицыРезультов.Расходы;
		СтрокаОтчета.РасходыРеализация = СтрокаТаблицыРезультов.Расходы;
	Иначе
		СтрокаОтчета.ПрочиеРасходы = СтрокаТаблицыРезультов.СуммаОборотДт;
	КонецЕсли;	
	
	Если ГрафаРасход = "СебестоимостьВыбытия" Тогда
		СтрокаОтчета.ВыручкаРеализация = СтрокаТаблицыРезультов.СуммаОборотКт;
	Иначе
		СтрокаОтчета.ПрочиеДоходы = СтрокаТаблицыРезультов.СуммаОборотКт;
	КонецЕсли;	
	
	//конец
	СтрокаОтчета.РасходыКП = СтрокаТаблицыРезультов.СуммаКонечныйОстатокДт;
	СтрокаОтчета.ДоходыКП = СтрокаТаблицыРезультов.СуммаКонечныйОстатокКт;	

КонецПроцедуры	

Функция ВходитВФильтр(вхЦеннаяБумага, Фильтр)
	
	Если ПустаяСтрока(Фильтр) Тогда 
		Возврат Истина;
	КонецЕсли;
	
	
	Если Фильтр = "Корпоративные20" Тогда 
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда 
				Если вхЦеннаяБумага.ДатаНачалаРазмещения < Дата(2017,1,1) Тогда 
					Возврат Истина;
				КонецЕсли;					
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли Фильтр = "Корпоративные15" Тогда 
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда 
				Если вхЦеннаяБумага.ДатаНачалаРазмещения >= Дата(2017,1,1) Тогда 
					Возврат Истина;
				КонецЕсли;	
		    КонецЕсли;			
		КонецЕсли;			
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции	

Процедура РаспределениеРезультата(ТаблицаОтчета, ТаблицаРезультат, ТаблицаНастройки)
	
	ТаблицаРезультат.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастройки Цикл 
		
		Отбор = Новый Структура;
		Отбор.Вставить("ПрочиеДоходыРасходы", СтрокаТаблицыНастроек.ПрочиеДоходыРасходы);
		Отбор.Вставить("СчетДоверительногоУправления", СтрокаТаблицыНастроек.СчетДоверительногоУправления);
		Если СтрокаТаблицыНастроек.ПризнакОРЦБ <> Перечисления.ВидыОбращенияНаОРЦБ.ПустаяСсылка() Тогда
			Отбор.Вставить("ОбращаетсяНаОРЦБ", СтрокаТаблицыНастроек.ПризнакОРЦБ);
		КонецЕсли;
		Отбор.Вставить("Используется", Ложь);      // если два вида актива (гос и гос в валюте) используют одну статью дохода, задвоения не будет 
		
		НайденныеСтроки =  ТаблицаРезультат.НайтиСтроки(Отбор);
		Для Каждого СтрокаТаблицыРезультов Из НайденныеСтроки Цикл 
			
			Если НЕ ПустаяСтрока(СтрокаТаблицыНастроек.Счет) Тогда 
				Если СокрЛП(СтрокаТаблицыНастроек.Счет) <> СтрокаТаблицыРезультов.Счет.Код Тогда 
					Продолжить;
				КонецЕсли; 
				//сделано для индексируемого номинала. Доход 15%, Расход 20%
			КонецЕсли;	
			
			//УсловиеКоррСчет = ФильтрКоррСчет(СтрокаТаблицыРезультов.КорСчет,СтрокаТаблицыНастроек.ФильтрКорСчет); 
			УсловиеЦеннаяБумага = ВходитВФильтр(СтрокаТаблицыРезультов.ЦенныеБумаги, СтрокаТаблицыНастроек.Фильтр);  
			//УсловиеРегистратор = ФильрДок(СтрокаТаблицыРезультов.Регистратор, СтрокаТаблицыНастроек.ФильтрДок);
			
			//Если УсловиеКоррСчет И УсловиеЦеннаяБумага И УсловиеРегистратор Тогда 
			Если УсловиеЦеннаяБумага Тогда 
				СтрокаТаблицыРезультов.Используется = Истина;
				ДобавитьДанныеВОтчет(ТаблицаОтчета, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Код, СтрокаТаблицыНастроек.ГрафаРасход, СтрокаТаблицыНастроек.ГрафаПриход);			
			КонецЕсли;				
		КонецЦикла;		
	КонецЦикла;	
		
	Для Каждого СтрокаТаблицыРезультов из ТаблицаРезультат Цикл
		Если СтрокаТаблицыРезультов.Используется Тогда 
			Продолжить;
		КонецЕсли;		
		ДобавитьДанныеВОтчет(ТаблицаОтчета, СтрокаТаблицыРезультов);			
	КонецЦикла;
	
КонецПроцедуры 

Процедура РассчитатьИтоги(ТаблицаОтчета, ТаблицаГруппировок)
	
	Для Каждого СтрокаТаблицаОтчета из ТаблицаОтчета Цикл
		
		СтрокаГруппировки = ТаблицаГруппировок.Найти(СтрокаТаблицаОтчета.Код, "Код");
		Если СтрокаГруппировки<>Неопределено Тогда 
			СтрокаТаблицаОтчета.Группировка2 = СтрокаГруппировки.Группа2;
			СтрокаТаблицаОтчета.Группировка1 = СтрокаГруппировки.Группа1;
			СтрокаТаблицаОтчета.Ставка = Число(СтрокаГруппировки.Ставка);
		Иначе
			Сообщить("Ошибка распределения по группам");
		КонецЕсли;	
		
		Если ТипЗнч(СтрокаТаблицаОтчета.ЦеннаяБумага) = Тип("ДокументСсылка.МНО") Тогда 	
			СтрокаТаблицаОтчета.ЦеннаяБумага = "";   //МНО, Депозиты и прочее. Расшифровка не нужна
		КонецЕсли;
		
	КонецЦикла;		
	
	ИтоговыеСтроки = "РасходыНП, ДоходыНП, УбытокНП, ПрибыльНП, РезНачало,";
	ИтоговыеСтроки = ИтоговыеСтроки + "СебестоимостьВыбытия, РасходыРеализация, ПрочиеРасходы, ИтогоРасходы,";
	ИтоговыеСтроки = ИтоговыеСтроки + "ВыручкаРеализация, ПрочиеДоходы, ИтогоДоходы, Убыток, Прибыль,РезПериод,";
	ИтоговыеСтроки = ИтоговыеСтроки + "РасходыКП, ДоходыКП, УбытокКП, ПрибыльКП,РезКонец";
	
	
	ТаблицаОтчета.Свернуть("Группировка1,Группировка2,Код,ПрочиеДоходыИРасходы, СчетДоверительногоУправления, ЦеннаяБумага, ЦеннаяБумагаНаименование, Ставка",ИтоговыеСтроки);	
	ТаблицаОтчета.Сортировать("Код, ПрочиеДоходыИРасходы, ЦеннаяБумага");
	
	//вычисляемые поля
	Для каждого СтрокаТаблицаОтчета из ТаблицаОтчета Цикл 
		
		СтрокаТаблицаОтчета.РезНачало = СтрокаТаблицаОтчета.ДоходыНП - СтрокаТаблицаОтчета.РасходыНП;
		Если СтрокаТаблицаОтчета.РезНачало >0 Тогда 
			СтрокаТаблицаОтчета.ПрибыльНП = СтрокаТаблицаОтчета.РезНачало;
		Иначе
			СтрокаТаблицаОтчета.УбытокНП = - СтрокаТаблицаОтчета.РезНачало;
		КонецЕсли;	
		
		СтрокаТаблицаОтчета.РезКонец = СтрокаТаблицаОтчета.ДоходыКП - СтрокаТаблицаОтчета.РасходыКП;
		Если СтрокаТаблицаОтчета.РезКонец >0 Тогда 
			СтрокаТаблицаОтчета.ПрибыльКП = СтрокаТаблицаОтчета.РезКонец;
		Иначе
			СтрокаТаблицаОтчета.УбытокКП = - СтрокаТаблицаОтчета.РезКонец;
		КонецЕсли;	
		
		СтрокаТаблицаОтчета.ИтогоРасходы = СтрокаТаблицаОтчета.СебестоимостьВыбытия + СтрокаТаблицаОтчета.РасходыРеализация + СтрокаТаблицаОтчета.ПрочиеРасходы;
		СтрокаТаблицаОтчета.ИтогоДоходы = СтрокаТаблицаОтчета.ВыручкаРеализация + СтрокаТаблицаОтчета.ПрочиеДоходы;
		
		СтрокаТаблицаОтчета.РезПериод = СтрокаТаблицаОтчета.ИтогоДоходы - СтрокаТаблицаОтчета.ИтогоРасходы;
		Если СтрокаТаблицаОтчета.РезПериод >0 Тогда 
			СтрокаТаблицаОтчета.Прибыль = СтрокаТаблицаОтчета.РезПериод;
		Иначе
			СтрокаТаблицаОтчета.Убыток = - СтрокаТаблицаОтчета.РезПериод;
		КонецЕсли;	
				
	КонецЦикла;	
	
	
КонецПроцедуры

Функция НайтиИдНастройки(Знач Настройки, ИмяНастройки)
	
	Результат = Неопределено;	
	Для Каждого Элемент из Настройки Цикл 
		Если Элемент.Имя = ИмяНастройки Тогда 
			Результат = Элемент.ИдентификаторПользовательскойНастройки;
		КонецЕсли;	
		Если Результат = Неопределено Тогда 
			Если Элемент.Структура <> Неопределено Тогда 
				Результат = НайтиИдНастройки(Элемент.Структура, ИмяНастройки);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции	

Функция СформироватьТаблицуОтчета(ПоВидуУчета, СписокСчетовДУ)
	Перем ТаблицаНастройкаИтоговая;
		
	ИнициализацияПеременных(ПоВидуУчета, СписокСчетовДУ);
	
	КвалЧисло = Новый КвалификаторыЧисла(19.2);
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	ТаблицаОтчета = Новый ТаблицаЗначений;
	
	МассивВидов = Новый Массив;
	МассивВидов.Добавить(Тип("СправочникСсылка.Акции"));
	МассивВидов.Добавить(Тип("СправочникСсылка.БанковскиеСчета"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.ВалютныеПары"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.Векселя"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.ДепозитарныеРасписки"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.ДепозитныеВклады"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.Доли"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.Займы"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.ИпотечныеСертификатыУчастия"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.Облигации"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.Паи"));	
	МассивВидов.Добавить(Тип("СправочникСсылка.ПроизводныеФинансовыеИнструменты"));	
	
	//группировки
	ТаблицаОтчета.Колонки.Добавить("Группировка1");
	ТаблицаОтчета.Колонки.Добавить("Группировка2");
	ТаблицаОтчета.Колонки.Добавить("ПрочиеДоходыИРасходы");
	ТаблицаОтчета.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов(МассивВидов));
	
	//вспомогательное поле. По этому полю будем потом проставлять группировки
	ТаблицаОтчета.Колонки.Добавить("Код");
	// налоговая ставка 20/15/9. Нужно для выделения справочной секции 
	ТаблицаОтчета.Колонки.Добавить("Ставка", ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ЦеннаяБумагаНаименование");
	
	//Колонки
	ТаблицаОтчета.Колонки.Добавить("РасходыНП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ДоходыНП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("УбытокНП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ПрибыльНП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("РезНачало",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("СебестоимостьВыбытия",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("РасходыРеализация",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ПрочиеРасходы",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ИтогоРасходы",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ВыручкаРеализация",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ПрочиеДоходы",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ИтогоДоходы",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("Убыток",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("Прибыль",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("РезПериод",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("РасходыКП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ДоходыКП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("УбытокКП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("ПрибыльКП",ТипЧисло);
	ТаблицаОтчета.Колонки.Добавить("РезКонец",ТипЧисло);	
	ТаблицаОтчета.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));	
	
	Если ПоВидуУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда 
		ТаблицаГруппировок = СчитатьТабличныйДокументВТаблицуЗначений("НастройкаОтчетОФинрезультатахНУ","ЗаголовкиГруппы|КолонкиГруппы", "СтрокиГруппы|КолонкиГруппы");		
		ТаблицаНастройкиФЛ = СчитатьТабличныйДокументВТаблицуЗначений("НастройкаОтчетОФинрезультатахНУ","ЗаголовкиМакет|КолонкиНастройки", "СтрокиМакетФЛ|КолонкиНастройки");		
		ТаблицаНастройкиЮЛ = СчитатьТабличныйДокументВТаблицуЗначений("НастройкаОтчетОФинрезультатахНУ","ЗаголовкиМакет|КолонкиНастройки", "СтрокиМакет|КолонкиНастройки");
	ИначеЕсли ПоВидуУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		ТаблицаГруппировок = СчитатьТабличныйДокументВТаблицуЗначений("НастройкаОтчетОФинрезультатахБУ","ЗаголовкиГруппы|КолонкиГруппы", "СтрокиГруппы|КолонкиГруппы");
		ТаблицаНастройкиЮЛ = СчитатьТабличныйДокументВТаблицуЗначений("НастройкаОтчетОФинрезультатахБУ","ЗаголовкиМакет|КолонкиНастройки", "СтрокиМакет|КолонкиНастройки");	
	КонецЕсли;
	
	Для Каждого СчетДУ из СписокСчетовДУ Цикл 
		Если ПоВидуУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда 
			Если СчетДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица 
				ИЛИ СчетДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда 
				ТаблицаНастройки = ТаблицаНастройкиФЛ.Скопировать();
			Иначе
				ТаблицаНастройки = ТаблицаНастройкиЮЛ.Скопировать();
			КонецЕсли;
		Иначе
			ТаблицаНастройки = ТаблицаНастройкиЮЛ.Скопировать();
		КонецЕсли;	
		Преобразовать(ТаблицаНастройки, СчетДУ, ТаблицаНастройкаИтоговая);
	КонецЦикла;	
	
	ТаблицаРезультат = ЗапросДоходыРасходы(ПоВидуУчета, СписокСчетовДУ);	
	РаспределениеРезультата(ТаблицаОтчета, ТаблицаРезультат, ТаблицаНастройкаИтоговая);
	РассчитатьИтоги(ТаблицаОтчета, ТаблицаГруппировок);

	Возврат ТаблицаОтчета;
	
КонецФункции	

Функция ПолучитьСписокСчетовДУ()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет
	|ИЗ
	|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
	|ГДЕ
	|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет";
	
	Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВестиБухгалтерскийУчет", "ВестиНалоговыйУчет");		
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
		
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса.ВыгрузитьКолонку("СчетДоверительногоУправления");
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	Перем СписокЦенныхБумаг;
	Перем ФильтрЦБ;
	Перем РазворачиватьПоЦеннымБумагам;
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("РазворачиватьПоЦеннымБумагам", РазворачиватьПоЦеннымБумагам);	
	
	ЕстьОтборПоСчетамДУ = Ложь;
	Если ЭтотОбъект.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
		ЕстьОтборПоСчетамДУ = Истина;
	КонецЕсли;
		
	Для Каждого Элемент из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл 
		Если (Найти(Элемент.ЛевоеЗначение, "СчетДоверительногоУправления") = 1) Тогда 			
			ЕстьОтборПоСчетамДУ = Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Если ЕстьОтборПоСчетамДУ Тогда 
	ЭтотОбъект.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
		СписокСчетовДУ = ПолучитьСписокСчетовДУ();
	Иначе	
		СписокСчетовДУ = Новый Массив;
		СписокСчетовДУ.Добавить(ЭтотОбъект.СчетДоверительногоУправления);
	КонецЕсли;	
	
	ТаблицаОтчета = СформироватьТаблицуОтчета(ЭтотОбъект.ВидУчета, СписокСчетовДУ);
	
	ВнешниеНаборыДанных = Новый Структура("ТаблицаОтчета", ТаблицаОтчета);
	
	Для Каждого ГруппировкаКомпановки ИЗ ЭтотОбъект.КомпоновщикНастроек.Настройки.Структура Цикл 
		Если ГруппировкаКомпановки.Имя = "СекцияСтавкаНалогообложения" Тогда 
			Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет Тогда 
				ГруппировкаКомпановки.Использование = Ложь;
			ИначеЕсли ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда 
				ГруппировкаКомпановки.Использование = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
		
	Настройки = КомпоновщикНастроек.Настройки;
	
	ИдРазворачивать = НайтиИдНастройки(Настройки.Структура, "ЦеннаяБумага");
	ПараметрПользовательскойНастройки = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдРазворачивать);	
	Если РазворачиватьПоЦеннымБумагам <> Неопределено Тогда 
		ПараметрПользовательскойНастройки.Использование = РазворачиватьПоЦеннымБумагам;
	КонецЕсли;		
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", 				Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", 				Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидУчета", 					ЭтотОбъект.ВидУчета);
	
	ДанныеШапки = ПолучитьДанныеШапки();
	Если НЕ ДанныеШапки = Неопределено Тогда
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеОрганизации", 	ДанныеШапки.НаименованиеОрганизации);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеСчетаДУ", 		ДанныеШапки.НаименованиеСчетаДУ);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаДоговора", 				Формат(ДанныеШапки.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НомерДоговора", 				ДанныеШапки.НомерДоговора);		
	Иначе 	
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеОрганизации", 	"");
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеСчетаДУ", 		"");
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаДоговора", 				"");
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НомерДоговора", 				"");				
	КонецЕсли; 
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
	
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);
	
	КонецЕсли; 
	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект,ДокументРезультат,ДанныеРасшифровки,СтандартнаяОбработка,ПараметрыВыводаПодписей,,,ВнешниеНаборыДанных);
	
	ДокументРезультат.ФиксацияСверху = 11;	
	ДокументРезультат.ФиксацияСлева = 1;		
	
КонецПроцедуры

Функция ПолучитьДанныеШапки()

	НаименованияКлиента = РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _КлиентДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентДУ.НомерДоговора КАК НомерДоговора,
		|	_КлиентДУ.ДатаЗаключения КАК ДатаДоговора,
		|	&НаименованиеКлиента КАК НаименованиеСчетаДУ,
		|	РеквизитыОрганизацийСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ИЗ
		|	_КлиентДУ КАК _КлиентДУ,
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицоОрганизации) КАК РеквизитыОрганизацийСрезПоследних";
		
	Запрос.УстановитьПараметр("Период", 						ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации", 			ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НаименованиеКлиента", 			
	?(ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица 
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет, 
			НаименованияКлиента.ПолноеНаименование, 
			НаименованияКлиента.КраткоеНаименование));
			
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда		
		Возврат ВыборкаДетальныеЗаписи;          		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 