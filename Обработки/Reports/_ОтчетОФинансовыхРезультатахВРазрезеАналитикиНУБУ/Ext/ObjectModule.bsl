	//начало
	СтрокаОтчета.РасходыНП = СтрокаТаблицыРезультов.СуммаНачальныйОстатокДт;
	СтрокаОтчета.ДоходыНП = СтрокаТаблицыРезультов.СуммаНачальныйОстатокКт;	
