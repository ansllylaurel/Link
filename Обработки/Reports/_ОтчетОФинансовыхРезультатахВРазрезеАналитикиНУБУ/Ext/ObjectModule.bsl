Перем НастройкиУчетаАктивов;
Перем НастройкиУчетаКомиссии;  

Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о финансовых результатах в разрезе аналитики (НУ и БУ)",
		"1.53",
		"",
		Истина);
		                                                                                             
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	Если ЗначениеЗаполнено(НастройкиОтчета.КлючТекущегоВарианта) Тогда
		КлючТекущегоВарианта = НастройкиОтчета.КлючТекущегоВарианта;
	Иначе
		КлючТекущегоВарианта = "Свернутый";
	КонецЕсли;
	
	ТекущийВариант = ЭтотОбъект.СхемаКомпоновкиДанных.ВариантыНастроек.Найти(КлючТекущегоВарианта);
    
    ЭтотОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(ТекущийВариант.Настройки);
	                                                     	
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица",	НастройкиОтчета.Подписант);
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("РазворачиватьПоЦеннымБумагам",	НастройкиОтчета.РазворачиватьПоЦеннымБумагам);
	
	Если КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество()>0 Тогда
		КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();	
	КонецЕсли;		
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СкомпоноватьРезультат(ДокументРезультат);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("ВидУчета");
	Настройки.Добавить("КлючТекущегоВарианта");
	Настройки.Добавить("РазворачиватьПоЦеннымБумагам");

	Возврат Настройки;

КонецФункции

Процедура ИнициализацияПеременных(ПоВидуУчета, СчетДУ)	
	
	ЗапросНастройкиУчетаАктивов = Новый Запрос;
	ЗапросНастройкиУчетаАктивов.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК АналитикаДоходов,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
	|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаДоходовОтРеализации,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
	|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаДоходовПоследнееПогашение,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
	|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
	|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаДоходовОтПереоценки,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаПерекурсовки КАК АналитикаПерекурсовки,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовИндексацииНоминала КАК АналитикаДоходовИндексацииНоминала,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПогашенияИндексируемогоНоминала КАК АналитикаДоходовПогашенияИндексируемогоНоминала
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&ОтчетнаяДата,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДУ)
	|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";
	
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("СчетДУ", СчетДУ);
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("Организация", Организация);
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("ОтчетнаяДата", КонецДня(Период.ДатаОкончания));
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("ВидУчета", ПоВидуУчета);
	
	НастройкиУчетаАктивов = ЗапросНастройкиУчетаАктивов.Выполнить().Выгрузить();	
	
	
	ЗапросНастройкиУчетаКомиссии = Новый Запрос;
	ЗапросНастройкиУчетаКомиссии.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаКомиссииСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности КАК ВидЗадолженности,
	|	НастройкиУчетаКомиссииСрезПоследних.Аналитика КАК Аналитика,
	|	НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО КАК АналитикаРЕПО
	|ИЗ
	|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
	|			&ОтчетнаяДата,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДУ)
	|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаКомиссииСрезПоследних";
	
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("СчетДУ", СчетДУ);
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("Организация", Организация);
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("ОтчетнаяДата", КонецДня(Период.ДатаОкончания));
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("ВидУчета", ПоВидуУчета);
	
	НастройкиУчетаКомиссии = ЗапросНастройкиУчетаКомиссии.Выполнить().Выгрузить();	
	
КонецПроцедуры	

Функция ПолучитьСтатьюДоходаРасходаИзНастройки(МестоХраненияНастройки, УчетныйАктив, ВидАналитики, СчетДУ)
	
	Если МестоХраненияНастройки <> "ПоКоду" Тогда
		Если ПустаяСтрока(УчетныйАктив) ИЛИ ПустаяСтрока(ВидАналитики) Тогда 
			ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
			Возврат ПрочиеДоходыРасходы;
		КонецЕсли;	
	КонецЕсли;
	
	Если МестоХраненияНастройки = "НастройкиУчетаАктивов" Тогда 		
		
		
		Актив = Справочники.УчетныеАктивы[СокрЛП(УчетныйАктив)];
		
		Колонка = НастройкиУчетаАктивов.Колонки.Найти(ВидАналитики);
		
		Отбор = Новый Структура("СчетДоверительногоУправления, УчетныйАктив", СчетДУ, Актив); 
		НайденныеСтроки = НастройкиУчетаАктивов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество()>0 Тогда 
			ПрочиеДоходыРасходы = НайденныеСтроки[0][Колонка.Имя];
		Иначе
			ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
		КонецЕсли;	
				
		Возврат ПрочиеДоходыРасходы;
	ИначеЕсли МестоХраненияНастройки = "НастройкиУчетаКомиссии" Тогда 
		
		Актив = Справочники.ВидыЗадолженности[СокрЛП(УчетныйАктив)];
		
		Отбор = Новый Структура("СчетДоверительногоУправления, ВидЗадолженности", СчетДУ, Актив); 
		НайденныеСтроки = НастройкиУчетаАктивов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество()>0 Тогда 
			ПрочиеДоходыРасходы = НайденныеСтроки[0][ВидАналитики];
		Иначе
			ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
		КонецЕсли;	
				
		Возврат ПрочиеДоходыРасходы;
		
	ИначеЕсли МестоХраненияНастройки = "НастройкиУчетаОбщие" Тогда 
		
	ИначеЕсли МестоХраненияНастройки = "ПоКоду" Тогда 
				
		ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.НайтиПоКоду(СокрЛП(УчетныйАктив));
		Возврат ПрочиеДоходыРасходы;
		
	КонецЕсли;
		
КонецФункции	

Функция СчитатьТабличныйДокументВТаблицуЗначений(ИмяМакета, Заголовки, Строки);
	
	Макет = ПолучитьМакет(ИмяМакета);
	
	ОбластьЗаголовки = Макет.ПолучитьОбласть(Заголовки);
	ОбластьДанные = Макет.ПолучитьОбласть(Строки);
	
	Рез = Новый ТаблицаЗначений;
	
	Если ОбластьЗаголовки.ВысотаТаблицы > 1 Тогда 
		Сообщить("Неправильная структура секции заголовков в Макете " + ИмяМакета);
		Возврат Рез;
	КонецЕсли;	
	
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		Рез.Колонки.Добавить(ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст);
	КонецЦикла;	
		
	Для индСтроки = 1 по КоличествоСтрок Цикл 
		НоваяСтрока = Рез.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл 
			НоваяСтрока[ИндКолонки-1] = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;		
		КонецЦикла;	
	КонецЦикла;		

	Возврат Рез;
	
КонецФункции	

Процедура Преобразовать(ТаблицаНастройки, СчетДУ, ТаблицаНастройкаИтоговая)
	
	//преобразование значений в удобные типы
	
	ТаблицаНастройки.Колонки.Добавить("ПрочиеДоходыРасходы");	
	
	Для Каждого СтрокаТЗ из ТаблицаНастройки Цикл 
		
		Если СтрокаТЗ.ПризнакОРЦБ = "Обращается" Тогда
			СтрокаТЗ.ПризнакОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.Обращается;
		ИначеЕсли СтрокаТЗ.ПризнакОРЦБ= "НеОбращается" Тогда	
			СтрокаТЗ.ПризнакОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.НеОбращается;
		Иначе	
			СтрокаТЗ.ПризнакОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.ПустаяСсылка();
		КонецЕсли;	
		СтрокаТЗ.ПрочиеДоходыРасходы = ПолучитьСтатьюДоходаРасходаИзНастройки(СтрокаТЗ.Регистр, СтрокаТЗ.УчетныйАктив, СтрокаТз.Аналитика, СчетДУ);
		
	КонецЦикла;

	МассивКолонок = Новый Массив;
	Для Каждого Колонка из ТаблицаНастройки.Колонки Цикл 
		Если Колонка.Имя <> "УчетныйАктив" Тогда 
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЕсли;			
	КонецЦикла;	
	ТаблицаНастройки.Свернуть(СтрСоединить(МассивКолонок, ","));	
	
	Если ТаблицаНастройкаИтоговая = Неопределено Тогда 
		ТаблицаНастройкаИтоговая = ТаблицаНастройки.Скопировать();
		ТаблицаНастройкаИтоговая.Колонки.Добавить("СчетДоверительногоУправления");
		ТаблицаНастройкаИтоговая.ЗаполнитьЗначения(СчетДУ, "СчетДоверительногоУправления"); 
	Иначе
		Для Каждого СтрокаНастройка из ТаблицаНастройки Цикл 
			НоваяСтрока = ТаблицаНастройкаИтоговая.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройка);
			НоваяСтрока.СчетДоверительногоУправления = СчетДУ;
		КонецЦикла;
	КонецЕсли;	
		
КонецПроцедуры	

Функция ЗапросДоходыРасходы(ВидУчета, СчетДУ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РегистрОбороты.Счет КАК Счет,
		|	РегистрОбороты.Субконто1 КАК Субконто1,
		|	РегистрОбороты.Субконто2 КАК Субконто2,
		|	РегистрОбороты.Субконто3 КАК Субконто3,
		|	РегистрОбороты.СуммаОборотДт КАК СуммаОборотДт
		|ПОМЕСТИТЬ _Расходы
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&ДатаНачальная,
		|			&ДатаКонечная,
		|			Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы), ЗНАЧЕНИЕ(ПланСчетов.Основной.СебестоимостьПродажи)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В (&СчетДУ),
		|			НЕ КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Основной.ФинансовыеВложения))
		|				ИЛИ КорСчет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы), ЗНАЧЕНИЕ(ПланСчетов.Основной.Выручка)),
		|			) КАК РегистрОбороты
		|ГДЕ
		|	РегистрОбороты.Субконто1 В
		|			(ВЫБРАТЬ
		|				НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации КАК АналитикаДоходовОтРеализации
		|			ИЗ
		|				РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(&ДатаКонечная, Организация = &Организация
		|					И СчетДоверительногоУправления В (&СчетДУ)
		|					И ВидУчета = ЗНАЧЕНИЕ(ПЕречисление.ВидыУчета.НалоговыйУчет)) КАК НастройкиУчетаАктивовСрезПоследних
		|			ГДЕ
		|				НастройкиУчетаАктивовСрезПоследних.УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ПаиИностранныхЭмитентов), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации)))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
