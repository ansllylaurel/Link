
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Проверка на обесценение активов",
		"0.02",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение",	ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	СтруктураКлюча.Вставить("Язык",				ПредопределенноеЗначение("Справочник.Языки.Русский"));
	СтруктураКлюча.Вставить("Объект",			ЭтотОбъект.Организация);
	
	СтруктураКлюча.Вставить("КонтактноеЛицо", НастройкиОтчета.ПодписантРуководитель);
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча));
	
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение",	ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	СтруктураКлюча.Вставить("Язык",				ПредопределенноеЗначение("Справочник.Языки.Русский"));
	СтруктураКлюча.Вставить("Объект",			ЭтотОбъект.Клиент);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	Сформировать(ДокументРезультат);	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
		
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ПодписантРуководитель");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("ПодписантОтКлиента");
	Возврат Настройки;

КонецФункции

Функция ВернутьФИОПодписанта(Подписант)
	
	ФИО = Новый Структура;
	
	Если ТипЗнч(Подписант) = Тип("СправочникСсылка.ЮрФизЛица") Тогда 
		Запрос = Новый Запрос;
		Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество КАК ФИОПолностью,
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицСрезПоследних.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицСрезПоследних.Отчество, 1, 1) + ""."" КАК ФИОСокращенно
		|ИЗ
		|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних";
		
		Запрос.УстановитьПараметр("Период", Период.ДатаОкончания);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ЮрФизЛицо", Подписант);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			ФИО.Вставить("ФИОПолностью", Выборка.ФИОПолностью);
			ФИО.Вставить("ФИОСокращенно", Выборка.ФИОСокращенно);
			
		КонецЕсли;	
	Иначе //строка	
		СтрокаФИО = Подписант;
		
		Если Найти(СтрокаФИО, ".") > 0 Тогда         //только Фамилия И. О. 
			ФИО.Вставить("ФИОПолностью", СтрокаФИО);
			ФИО.Вставить("ФИОСокращенно", СтрокаФИО);
		Иначе	
			МассивФИО = СтрРазделить(СтрокаФИО, " ");
			Если МассивФИО.Количество() = 3 Тогда
				ФИОСокращенно = МассивФИО[0] + " " + Лев(МассивФИО[1],1) + ". " + Лев(МассивФИО[2],1) + ". ";
				
				ФИО.Вставить("ФИОПолностью", СтрокаФИО);
				ФИО.Вставить("ФИОСокращенно", ФИОСокращенно);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаФИО + " не является строкой типа ФИО");
			КонецЕсли;	
		КонецЕсли;
	
	КонецЕсли;	
	
	Возврат ФИО;
	
	
КонецФункции	

Функция УстановитьСтатусыНарушений(Выборка, ЕстьСвиделельтва)
	
	Результат = Новый Структура("Затруднения, НарушенияДоговора, Банкрот, Активность, НаблюдаемыеДанные",
				"не выявлено",
				"не выявлено",
				"не выявлено",
				"не выявлено",
				"не наблюдается");
	
	СостояниеДефолта = "";
	Если Выборка.ДефолтПоКупону Тогда 
		СостояниеДефолта = "дефолт по купону"; 
	КонецЕсли;	
	Если Выборка.ДефолтПоТелу Тогда 
		СтрДополнение = "дефолт по телу";		
		СостояниеДефолта = ?(ПустаяСтрока(СостояниеДефолта), СтрДополнение, СостояниеДефолта + ", " + СтрДополнение);
	КонецЕсли;	
	Если Выборка.НеисполнениеОферты Тогда 
		СтрДополнение = "неисполнение оферты";
		СостояниеДефолта = ?(ПустаяСтрока(СостояниеДефолта), СтрДополнение, СостояниеДефолта + ", " + СтрДополнение);
	КонецЕсли;	
	
	Если Не ПустаяСтрока(СостояниеДефолта) Тогда 
		Результат.НарушенияДоговора = СостояниеДефолта;
	КонецЕсли;	
	
	Если Выборка.Банкротство Тогда 
		Результат.Банкрот = "банкрот";  //может быть скоро будет расшифрофка состояний банкротства
	КонецЕсли;	
	
	Если НЕ Выборка.Активен Тогда
		Результат.Активность = "выявлено";
	КонецЕсли;	
	
	Если Выборка.Резерв ИЛИ Выборка.ДефолтПоКупону ИЛИ Выборка.ДефолтПоТелу ИЛИ Выборка.НеисполнениеОферты ИЛИ Выборка.Банкротство ИЛИ НЕ Выборка.Активен Тогда
		Результат.Затруднения = "есть затруднения";
		Результат.НаблюдаемыеДанные = "наблюдаются";
		ЕстьСвиделельтва = Истина;
	КонецЕсли;	
			
	Возврат Результат;	
	
КонецФункции	

Процедура Сформировать(ДокументРезультат)	Экспорт
	
	Сессия = Неопределено;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,Клиент");
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	Попытка
		Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
	КонецПопытки;
	
	ДокументРезультат.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаОтчета,
		|			Организация = &Организация
		|				И Клиент = &Клиент) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1.Банк КАК Банк
		|ПОМЕСТИТЬ _Банки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДатаОтчета,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1.Контрагент КАК Брокер
		|ПОМЕСТИТЬ _Брокеры
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДатаОтчета,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами02)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.КупонныеВыплаты)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоКупону,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ИсполнениеОферты)
		|					И (ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.НеисполнениеОферты)
		|						ИЛИ ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт))
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК НеисполнениеОферты,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|					И ДефолтыПоОблигациямСрезПоследних.СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ДефолтПоТелу,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДефолтыПоОблигациямСрезПоследних.ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.Банкротство)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК Банкротство,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация
		|ПОМЕСТИТЬ _Дефолты
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(&ДатаОтчета, ) КАК ДефолтыПоОблигациямСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ДефолтыПоОблигациямСрезПоследних.Облигация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаРезерв
		|ПОМЕСТИТЬ _ЦБРезервы
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ДатаОтчета,
		|			Счет В (&СчетаРезервов),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации).Эмитент
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции).Эмитент
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.Паи
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто1 ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК РегНомер,
		|	НЕ _ЦБРезервы.ЦеннаяБумага ЕСТЬ NULL КАК Резерв,
