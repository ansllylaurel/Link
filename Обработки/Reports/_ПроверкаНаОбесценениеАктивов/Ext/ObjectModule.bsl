	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ДатаОтчета", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));


	СчетаУчетаЦенныхБумаг = КонсолидированнаяОтчетность.ПолучитьСчетаУчетаЦенныхБумаг();
	Запрос.УстановитьПараметр("СчетаРезервов", СчетаУчетаЦенныхБумаг.СчетаРезервовДолговых);

	ДатаОтчета = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	ДатаОтчетаСМесяцем = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДЛФ=DD");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Отчет = ПолучитьМакет("Отчет"); 
	ОбластьЗаголовок = Отчет.ПолучитьОбласть("Заголовок"); 
	ОбластьБанк = Отчет.ПолучитьОбласть("Банк"); 
	ОбластьБрокер = Отчет.ПолучитьОбласть("Брокер"); 
	ОбластьЦБАмортизация = Отчет.ПолучитьОбласть("ЦБАмортизация"); 
	ОбластьЦБСправедливая = Отчет.ПолучитьОбласть("ЦБСправедливая"); 
	ОбластьРЕПО = Отчет.ПолучитьОбласть("РЕПО"); 
	ОбластьДебиторка = Отчет.ПолучитьОбласть("Дебиторка"); 
	ОбластьПодписи = Отчет.ПолучитьОбласть("Подписи");
	ОбластьПустаяСтрока = Отчет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьРезерв = Отчет.ПолучитьОбласть("Резерв");
	
