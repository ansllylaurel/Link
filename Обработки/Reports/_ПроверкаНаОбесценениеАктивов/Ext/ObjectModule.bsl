	ВыборкаСчетаДУ.Сортировать("НомерДоговора");
	
	СписокДоговоров = ""; 
	СведенияОбОрганизации = Неопределено;
	Для Каждого СчетДУ Из ВыборкаСчетаДУ Цикл 
		
		Если СведенияОбОрганизации = Неопределено Тогда 
			СведенияОбОрганизации = КонсолидированнаяОтчетность.СведенияОЮрФизЛице(СчетДУ.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);	
		КонецЕсли;	

		СписокДоговоров = СписокДоговоров + "№" + СчетДУ.НомерДоговора + ", ";
	КонецЦикла;	
	СписокДоговоров = Лев(СписокДоговоров, СтрДлина(СписокДоговоров)-2) + ".";
	
	ОбластьЗаголовок.Параметры.НаименованиеКлиент = ПолучитьСклоненияСтроки(СведенияОбОрганизации.ПолноеНаименование, , "ПД=Творительный")[0]; 
	ОбластьЗаголовок.Параметры.НаименованиеУК = ПолучитьСклоненияСтроки(СведенияОбОрганизации.ПолноеНаименованиеОрганизации, , "ПД=Творительный")[0]; 	
	ОбластьЗаголовок.Параметры.СписокДоговоров = СписокДоговоров;
	ОбластьЗаголовок.Параметры.ДатаОтчетаСМесяцем = ДатаОтчетаСМесяцем;
	ОбластьЗаголовок.Параметры.Год = Формат (Год(ЭтотОбъект.Период.ДатаОкончания), "ЧГ=0");
		
	ДокументРезультат.Вывести(ОбластьЗаголовок);
	ДокументРезультат.Вывести(ОбластьПустаяСтрока);

	ЕстьСвиделельтваОбОбесценении = Ложь;
	//банки
	ВыборкаБанки = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Банки").ПолучитьДанные().Выбрать();
	Пока ВыборкаБанки.Следующий() Цикл 
		
		ОбластьБанк.Параметры.Банк = ВыборкаБанки.Банк;
		ОбластьБанк.Параметры.ДатаОтчета = ДатаОтчета;
		ДокументРезультат.Вывести(ОбластьБанк);
		ДокументРезультат.Вывести(ОбластьПустаяСтрока);
		
	КонецЦикла;	
	
	//Брокеры
	ВыборкаБрокеры = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Брокеры").ПолучитьДанные().Выбрать();
	Пока ВыборкаБрокеры.Следующий() Цикл 
		
		ОбластьБрокер.Параметры.Брокер = ВыборкаБрокеры.Брокер;
		ОбластьБрокер.Параметры.ДатаОтчета = ДатаОтчета;
		ДокументРезультат.Вывести(ОбластьБрокер);
		ДокументРезультат.Вывести(ОбластьПустаяСтрока);
		
	КонецЦикла;	
	
	//ЦБ по амортизированной 
	ВыборкаЦБ  = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЦБпоАмортизированной").ПолучитьДанные().Выбрать();
	Пока ВыборкаЦБ.Следующий() Цикл 
		Нарушения =  УстановитьСтатусыНарушений(ВыборкаЦБ, ЕстьСвиделельтваОбОбесценении);
		ЗаполнитьЗначенияСвойств(ОбластьЦБАмортизация.Параметры, Нарушения);
				
		ОбластьЦБАмортизация.Параметры.Эмитент = ВыборкаЦБ.Эмитент;
		ОбластьЦБАмортизация.Параметры.РегНомер = ВыборкаЦБ.РегНомер;
		ОбластьЦБАмортизация.Параметры.ДатаОтчета = ДатаОтчета;
		
		ДокументРезультат.Вывести(ОбластьЦБАмортизация);
		Если ВыборкаЦБ.СуммаРезерва <> 0 Тогда 
			ОбластьРезерв.Параметры.СуммаРезерва = ВыборкаЦБ.СуммаРезерва;
			ДокументРезультат.Вывести(ОбластьРезерв);	
		КонецЕсли;	
		ДокументРезультат.Вывести(ОбластьПустаяСтрока);

		
	КонецЦикла;	
	         
	//ЦБ по справедливой 
	ВыборкаЦБ  = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЦБпоСправедливой").ПолучитьДанные().Выбрать();
	Пока ВыборкаЦБ.Следующий() Цикл 
		
		Нарушения =  УстановитьСтатусыНарушений(ВыборкаЦБ, ЕстьСвиделельтваОбОбесценении);
		ЗаполнитьЗначенияСвойств(ОбластьЦБСправедливая.Параметры, Нарушения);
				
		ОбластьЦБСправедливая.Параметры.Эмитент = ВыборкаЦБ.Эмитент;
		ОбластьЦБСправедливая.Параметры.РегНомер = ВыборкаЦБ.РегНомер;
		ОбластьЦБСправедливая.Параметры.ДатаОтчета = ДатаОтчета;
		
		ДокументРезультат.Вывести(ОбластьЦБСправедливая);
		Если ВыборкаЦБ.СуммаРезерва <> 0 Тогда 
			ОбластьРезерв.Параметры.СуммаРезерва = ВыборкаЦБ.СуммаРезерва;
			ДокументРезультат.Вывести(ОбластьРезерв);	
		КонецЕсли;			
		ДокументРезультат.Вывести(ОбластьПустаяСтрока);
		
	КонецЦикла;	
	
	//РЕПО
	ВыборкаКонтрагенты  = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РЕПО").ПолучитьДанные().Выбрать();
	Пока ВыборкаКонтрагенты.Следующий() Цикл 
		
		Нарушения = Новый Структура("Затруднения, НарушенияДоговора, Банкрот",
				"не выявлено",
				"не выявлено",
				"не выявлено");
		
		Если  ВыборкаКонтрагенты.СуммаРезерва <> 0 Тогда 
			Нарушения.Затруднения = "есть затруднения";		
			ЕстьСвиделельтваОбОбесценении = Истина;
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(ОбластьРЕПО.Параметры, Нарушения);		
			
		ОбластьРЕПО.Параметры.Контрагент = ВыборкаКонтрагенты.Контрагент;
		ОбластьРЕПО.Параметры.ДатаОтчета = ДатаОтчета;
		ДокументРезультат.Вывести(ОбластьРЕПО);
		Если ВыборкаКонтрагенты.СуммаРезерва <> 0 Тогда 
			ОбластьРезерв.Параметры.СуммаРезерва = ВыборкаКонтрагенты.СуммаРезерва;
			ДокументРезультат.Вывести(ОбластьРезерв);	
		КонецЕсли;			
		
		ДокументРезультат.Вывести(ОбластьПустаяСтрока);
		
	КонецЦикла;	
	
	//Дебиторка
	ВыборкаКонтрагенты  = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Дебиторка").ПолучитьДанные().Выбрать();
	Пока ВыборкаКонтрагенты.Следующий() Цикл 
		
		Нарушения = Новый Структура("Затруднения, НарушенияДоговора, Банкрот",
				"не выявлено",
				"не выявлено",
				"не выявлено");
		
		Если  ВыборкаКонтрагенты.СуммаРезерва <> 0 Тогда 
			Нарушения.Затруднения = "есть затруднения";	
			ЕстьСвиделельтваОбОбесценении = Истина;
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(ОбластьДебиторка.Параметры, Нарушения);		
		
		ОбластьДебиторка.Параметры.Контрагент = ВыборкаКонтрагенты.Контрагент;
		ОбластьДебиторка.Параметры.ДатаОтчета = ДатаОтчета;
		ДокументРезультат.Вывести(ОбластьДебиторка);
		Если ВыборкаКонтрагенты.СуммаРезерва <> 0 Тогда 
			ОбластьРезерв.Параметры.СуммаРезерва = ВыборкаКонтрагенты.СуммаРезерва;
			ДокументРезультат.Вывести(ОбластьРезерв);	
		КонецЕсли;					
		ДокументРезультат.Вывести(ОбластьПустаяСтрока);	
		
	КонецЦикла;	
	
	//Заключение	
	Если ЕстьСвиделельтваОбОбесценении Тогда 
		ОбластьЗаключение = Отчет.ПолучитьОбласть("Заключение2"); 
	Иначе	
		ОбластьЗаключение = Отчет.ПолучитьОбласть("Заключение"); 
		ОбластьЗаключение.Параметры.ДатаОтчетаСМесяцем = ДатаОтчетаСМесяцем;
	КонецЕсли;
	ДокументРезультат.Вывести(ОбластьЗаключение);
	ДокументРезультат.Вывести(ОбластьПустаяСтрока);
	
	//Подписи			
	Если КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхРуководитель") Тогда 
		СтруктураДанныхРуководитель = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.СтруктураДанныхРуководитель;	
		Если ЗначениеЗаполнено(СтруктураДанныхРуководитель) Тогда
			ОбластьПодписи.Параметры.Подписант = ВернутьФИОПодписанта(СтруктураДанныхРуководитель.КонтактноеЛицо).ФИОСокращенно;		
			ОбластьПодписи.Параметры.Должность = СтруктураДанныхРуководитель.Должность;
		КонецЕсли;	
	КонецЕсли;
	ДокументРезультат.Вывести(ОбластьПодписи);
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, "Отчет.ПроверкаНаОбесценение", , ОриентацияСтраницы.Портрет);
	
	Если Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
		
КонецПроцедуры	
