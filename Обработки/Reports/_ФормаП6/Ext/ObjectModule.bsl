Процедура ДобавитьВРасшифровку(ДокументРасшифровка, ОбластьСтрока, СтрокаРезультат, СтатусНачало, СтатусКонец, СтрокаН, СтрокаК, СтрокаВД, СтрокаНеРезидент);	

	СтрокаОтчета = "";
	Если СтрокаН = СтрокаК Тогда 
		СтрокаОтчета = СтрокаН;
	Иначе	
		СтрокаОтчета = СтрокаН + "->"+ СтрокаК;
	КонецЕсли;	
	Если Не ПустаяСтрока(СтрокаВД) Тогда 
		СтрокаОтчета = СтрокаОтчета + ", " + СтрокаВД;
	КонецЕсли;	
	Если Не ПустаяСтрока(СтрокаНеРезидент) Тогда 
		СтрокаОтчета = СтрокаОтчета + ", " + СтрокаНеРезидент;
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаРезультат);	
	ОбластьСтрока.Параметры.СтатусНачало = СтатусНачало;
	ОбластьСтрока.Параметры.СтатусКонец = СтатусКонец;
	ОбластьСтрока.Параметры.СтрокаОтчета = СтрокаОтчета;
	ДокументРасшифровка.Вывести(ОбластьСтрока);
	
КонецПроцедуры

Функция ВернутьКодВидаДеятельности(Отрасль)
	
	Код = 1; //Прочие
	
	СтрокаОтрасль = СокрЛП(Отрасль.Наименование);
	Если СтрокаОтрасль = "Банки" Тогда 
		Код = 2;
	ИначеЕсли СтрокаОтрасль = "Финансовые компании" Тогда
		Код = 5;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

Процедура ЗаполнитьРаздел1(ДокументРаздел1, ДокументРасшифровка)
	
	//настройки долгосрочности /краткосрочности
	// смотрю на конец периода. В течение года настройки не меняются.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
