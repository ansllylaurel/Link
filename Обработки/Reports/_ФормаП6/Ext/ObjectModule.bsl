Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Подписант = НастройкиОтчета.Подписант.КонтактноеЛицо;
		
	ДокументТитул	= Новый ТабличныйДокумент;
	ДокументРаздел1	= Новый ТабличныйДокумент;
	ДокументРаздел2	= Новый ТабличныйДокумент;
	ДокументРаздел3	= Новый ТабличныйДокумент;
	Расшифровка	= Новый ТабличныйДокумент;
	
	Сформировать(ДокументТитул, ДокументРаздел1, ДокументРаздел2, ДокументРаздел3, Расшифровка);
		
	КнигаЭксель = Новый ПакетОтображаемыхДокументов;
	
	Элемент1 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ДокументТитул, Новый УникальныйИдентификатор));		
	Элемент1.Наименование = "Титул";
		
	Элемент2 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ДокументРаздел1, Новый УникальныйИдентификатор));
	Элемент2.Наименование = "Раздел1";
		
	Элемент3 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ДокументРаздел2, Новый УникальныйИдентификатор));
	Элемент3.Наименование = "Раздел2";		
		
	Элемент4 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ДокументРаздел3, Новый УникальныйИдентификатор));
	Элемент4.Наименование = "Раздел3";		
		
	Элемент5 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(Расшифровка, Новый УникальныйИдентификатор));
	Элемент5.Наименование = "Расшифровка";			
	
	НастройкиОтчета.Вставить("Результат", КнигаЭксель);
		
КонецПроцедуры

Процедура ЗаполнитьТитульныйЛист(ДокументТитул)
	
	Макет = ПолучитьМакет("МакетТитульнаяСтраница");
	ОбластьТС = Макет.ПолучитьОбласть("ОбластьТС");
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	|ПОМЕСТИТЬ _КлиентДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицКлиента.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
	|	РеквизитыЮридическихЛицКлиента.ЮридическийАдрес КАК ЮридическийАдрес
	|ИЗ
	|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(, ) КАК РеквизитыЮридическихЛицКлиента
	|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
	|			И (РеквизитыЮридическихЛицКлиента.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))" ;
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(ОбластьТС.Параметры, Выборка);			
	КонецЕсли;	
	
	ОбластьТС.Параметры.Год = Год(ЭтотОбъект.Период.ДатаОкончания) - 2000;
	ОбластьТС.Параметры.Месяц = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=ММММ");
	ОбластьТС.Параметры.Приказ = "от 27.08.2014 № 535";
	
	ДокументТитул.Вывести(ОбластьТС);
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументТитул, "ФормаП6.Титул", , ОриентацияСтраницы.Портрет);		
	
	
КонецПроцедуры

Функция ОпеределитьСрочность(ДатаМинор, ДатаМажор)
	
	Если ДобавитьМесяц(ДатаМинор, 12) <= ДатаМажор Тогда 
		Срочность = "Д";
	Иначе
		Срочность = "К";
	КонецЕсли;						
			
	Возврат Срочность;		
	
КонецФункции	

Функция ПолучитьСтатусДолгосрочнаяКраткосрочная(ЦеннаяБумага, Рынок, Настройка, ДатаСтатуса, ДатаПокупки, ДатаПогашения) Экспорт
	
	Если ТипЗнч(ЦеннаяБумага)=Тип("СправочникСсылка.ДепозитныеВклады") Тогда
		ВидАктиваЦБ = Справочники.УчетныеАктивы.ДепозитныеВклады;
	Иначе	
		ВидАктиваЦБ = БухгалтерскийУчет.ОпределитьУчетныйАктив(ДатаСтатуса, Рынок, ЦеннаяБумага);
	КонецЕсли;	
			
		//теперь как классификация по сроку
		СтрокаНастройка = Настройка.Найти(ВидАктиваЦБ, "УчетныйАктив");
		Если СтрокаНастройка<>Неопределено Тогда
			КлассификаторСрочностиЦБ = СтрокаНастройка.КлассификацияАктиваПоСрочности;
		КонецЕсли;	
				
		//определяем вид
		Если КлассификаторСрочностиЦБ = Справочники.КлассификаторАктивовПоСрочности.ПустаяСсылка()
			ИЛИ КлассификаторСрочностиЦБ = Справочники.КлассификаторАктивовПоСрочности.ВсегдаКраткосрочные Тогда 
			ДелениеПоСрокуЦБ = "К";
		ИначеЕсли КлассификаторСрочностиЦБ = Справочники.КлассификаторАктивовПоСрочности.ВсегдаДолгосрочные Тогда
			ДелениеПоСрокуЦБ = "Д";
		ИначеЕсли КлассификаторСрочностиЦБ = Справочники.КлассификаторАктивовПоСрочности.ОтОтчетнойДоПогашения Тогда
			ДелениеПоСрокуЦБ = ОпеределитьСрочность(ДатаСтатуса, ДатаПогашения);
		ИначеЕсли КлассификаторСрочностиЦБ = Справочники.КлассификаторАктивовПоСрочности.ОтПокупкиДоПогашения	Тогда
			ДелениеПоСрокуЦБ = ОпеределитьСрочность(ДатаПокупки, ДатаПогашения); 
		ИначеЕсли КлассификаторСрочностиЦБ = Справочники.КлассификаторАктивовПоСрочности.ОтПокупкиДоОтчетной Тогда
			ДелениеПоСрокуЦБ = ОпеределитьСрочность(ДатаПокупки, ДатаСтатуса); 
		КонецЕсли;		
			
	Возврат ДелениеПоСрокуЦБ;	
		
КонецФункции	

Процедура ВнестиЗначениеВЯчейку(Область, Адрес, Значение)
	
	Ячейка = Область.Области.Найти(Адрес);
	Ячейка.Значение = Ячейка.Значение + Значение;
	
КонецПроцедуры	

Процедура ЗаполнитьСтроку(Область, СтрокаН, СтрокаК, СтрокаРезультат, Раздел);

	Если Раздел = 1 Тогда 
		ЧислоКолонок = 7;
	ИначеЕсли Раздел = 2 Тогда 
		ЧислоКолонок = 6;
	ИначеЕсли Раздел = 3 Тогда 
		ЧислоКолонок = 2;
	КонецЕсли;	
	
	Если СтрокаН = СтрокаК Тогда
		Для инд = 1 по ЧислоКолонок Цикл 
			Адрес = "П"+СтрокаН+ "0" + инд; 
			ВнестиЗначениеВЯчейку(Область, Адрес,СтрокаРезультат["_0"+инд]); 
		КонецЦикла;
	Иначе		
		Если Раздел <> 1 Тогда     //переход кратко/долгосрочка делим только в 1-м разделе
			Возврат
		КонецЕсли;	
		// в СтрокаН оставляем только начальный остаток 01
		ВнестиЗначениеВЯчейку(ОБласть, "П"+СтрокаН+ "01",СтрокаРезультат["_01"]);
		// нач остаток вставим в расход . перешло в другую срочностть
		ВнестиЗначениеВЯчейку(ОБласть, "П"+СтрокаН+ "03",СтрокаРезультат["_01"]);
		// Приход = Приход + НачОстаток, 01+02, как приход по другой срочности. 		
		ВнестиЗначениеВЯчейку(Область, "П"+СтрокаК+ "02",СтрокаРезультат["_01"]);
		ВнестиЗначениеВЯчейку(Область, "П"+СтрокаК+ "02",СтрокаРезультат["_02"]);		
		//// Расход = Расход + НачОстаток 01+03
		//ВнестиЗначениеВЯчейку(Область, "П"+СтрокаК+ "03",СтрокаРезультат["_01"]);
		//ВнестиЗначениеВЯчейку(Область, "П"+СтрокаК+ "03",СтрокаРезультат["_03"]);
	
		
		Для инд = 3 по ЧислоКолонок Цикл 
			Адрес = "П"+СтрокаК+ "0" + инд; 
			ВнестиЗначениеВЯчейку(Область, Адрес,СтрокаРезультат["_0"+инд]); 
		КонецЦикла;
		
		// произошел переход из раздела в раздел. НачОстаток прокрутим через приход и расход
		// эти значения будут распередяться по видам деятельности
		КорректировкаПриход =  СтрокаРезультат["_01"] + СтрокаРезультат["_02"];
		КорректировкаРасход =  СтрокаРезультат["_01"] + СтрокаРезультат["_03"];
		
		СтрокаРезультат["_02"] = КорректировкаПриход;
		СтрокаРезультат["_03"] = КорректировкаРасход;
			
		//СтрокаРезультат["_02"] = СтрокаРезультат["_02"] + СтрокаРезультат["_01"];
		//СтрокаРезультат["_03"] = СтрокаРезультат["_03"] + СтрокаРезультат["_01"];
				
	КонецЕсли;	
	
КонецПроцедуры 	

Процедура СуммированиеСтрок(ИтоговаяСтрока, МассивСтрок, Область, Раздел)
	
	Если Раздел = 1 Тогда 
		ЧислоКолонок = 7;
	ИначеЕсли Раздел = 2 Тогда 
		ЧислоКолонок = 6;
	ИначеЕсли Раздел = 3 Тогда 
		ЧислоКолонок = 2;
	КонецЕсли;		
	
	Для Каждого СтрокаИсточник из МассивСтрок Цикл 
		Для инд=1 по ЧислоКолонок Цикл 
			АдресКуда = "П" + ИтоговаяСтрока + "0" + инд;
			АдресОткуда = "П" + СтрокаИсточник + "0" + инд;
			Значение = Область.Области.Найти(АдресОткуда).Значение;
			ВнестиЗначениеВЯчейку(Область, АдресКуда, Значение);
		КонецЦикла;	
	КонецЦикла;	

КонецПроцедуры 	
	
