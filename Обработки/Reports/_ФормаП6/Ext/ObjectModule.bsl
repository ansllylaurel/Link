	|	РегистрБухгалтерии.БухгалтерскийУчет.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Период,
	|			,
	|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКраткосрочнымКредитамИЗаймам)),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухгалтерскийУчетОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	БухгалтерскийУчетОстаткиИОбороты.Субконто1";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", ЭтотОбъект.Период.ДатаОкончания);
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();

	//распределение
	Для Каждого СтрокаРезультат из ТаблицаЗапроса Цикл 
		СтрокаН = "570";  //	
		Если Не ПустаяСтрока(СтрокаН) Тогда 
			ЗаполнитьСтроку(ОбластьРаздел, СтрокаН, СтрокаН, СтрокаРезультат, 2);
		КонецЕсли;	
	КонецЦикла;
	
	РасчетИтоговРаздел2(ОбластьРаздел);
	ДокументРаздел2.Вывести(ОбластьРаздел);
	
КонецПроцедуры	

Процедура ЗаполнитьРаздел3(ДокументРаздел3, Расшифровка)
	
	Макет = ПолучитьМакет("МакетРаздел3");
	ОбластьРаздел = Макет.ПолучитьОбласть("Раздел3");
	
	//заполнение показателей
	
	ДокументРаздел3.Вывести(ОбластьРаздел);
	
КонецПроцедуры	

Процедура Сформировать(ДокументТитул, ДокументРаздел1, ДокументРаздел2, ДокументРаздел3, Расшифровка) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,Подписант");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДокументТитул.Очистить(); 
	ДокументРаздел1.Очистить(); 
	ДокументРаздел2.Очистить(); 
	ДокументРаздел3.Очистить(); 
	Расшифровка.Очистить();	
	
	ЗаполнитьТитульныйЛист(ДокументТитул);
	ЗаполнитьРаздел1(ДокументРаздел1, Расшифровка);
	ЗаполнитьРаздел2(ДокументРаздел2, Расшифровка);
	ЗаполнитьРаздел3(ДокументРаздел3, Расшифровка);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры	