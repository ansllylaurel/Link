		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеМНО.КодДепозитария КАК КодДепозитария,
		|	_ДанныеМНО.ИнвестСчет КАК ИнвестСчет,
		|	_ДанныеМНО.Дата КАК Дата,
		|	_ДанныеМНО.НомерПодтверждения КАК НомерПодтверждения,
		|	_ДанныеМНО.Номер КАК Номер,
		|	_ДанныеМНО.Сумма КАК Сумма,
		|	_ДанныеМНО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеМНО.КонтрольМНО КАК КонтрольМНО,
		|	_ДанныеМНО.СтрокаПоиска1 КАК СтрокаПоиска1
		|ПОМЕСТИТЬ _МНО
		|ИЗ
		|	_ДанныеМНО КАК _ДанныеМНО
		|ГДЕ
		|	_ДанныеМНО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеМНО.КодДепозитария КАК КодДепозитария,
		|	_ДанныеМНО.ИнвестСчет КАК ИнвестСчет,
		|	_ДанныеМНО.Дата КАК Дата,
		|	_ДанныеМНО.НомерПодтверждения КАК НомерПодтверждения,
		|	_ДанныеМНО.Номер КАК Номер,
		|	_ДанныеМНО.Сумма КАК Сумма,
		|	_ДанныеМНО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеМНО.СтрокаПоиска1 КАК СтрокаПоиска1
		|ПОМЕСТИТЬ _МНОЗаСледующийДень
		|ИЗ
		|	_ДанныеМНО КАК _ДанныеМНО
		|ГДЕ
		|	_ДанныеМНО.Дата МЕЖДУ &ДатаНачалаПлюсОдин И &ДатаОкончанияПлюсОдин
		|	И _ДанныеМНО.КонтрольМНО";
#КонецОбласти		

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ДатаНачалаПлюсОдин", ДобавитьКДатеРабочиеДниКеш(ЭтотОбъект.Период, 1));
	Запрос.УстановитьПараметр("ДатаОкончанияПлюсОдин", КонецДня(ДобавитьКДатеРабочиеДниКеш(ЭтотОбъект.Период, 1)));
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ВидыДоговоровДоверительногоУправления", ВидыДоговоровДоверительногоУправления.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("МассивСпецДеповДляАвтоформирования",	МассивСпецДеповДляАвтоформирования);
	Запрос.УстановитьПараметр("Банк_ГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ГПБ"));
	
	Запрос.Выполнить();
	
	ДанныеДляСверки = Новый Структура;
	ДанныеДляСверки.Вставить("СчетаДоверительногоУправления", Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выгрузить());
	ДанныеДляСверки.Вставить("ДвиженияПоРасчетнымСчетам", Запрос.МенеджерВременныхТаблиц.Таблицы["_ДвиженияПоРасчетнымСчетам"].ПолучитьДанные().Выгрузить());	
