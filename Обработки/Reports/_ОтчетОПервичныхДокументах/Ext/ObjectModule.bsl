	ДанныеДляСверки.Вставить("СЧА_РСА", Запрос.МенеджерВременныхТаблиц.Таблицы["_СЧА_РСА"].ПолучитьДанные().Выгрузить());
	ДанныеДляСверки.Вставить("МНО", Запрос.МенеджерВременныхТаблиц.Таблицы["_МНО"].ПолучитьДанные().Выгрузить());
	ДанныеДляСверки.Вставить("МНОЗаСледующийДень", Запрос.МенеджерВременныхТаблиц.Таблицы["_МНОЗаСледующийДень"].ПолучитьДанные().Выгрузить());
	
	ДанныеДляСверки.СчетаДоверительногоУправления.Сортировать("Наименование");
	ДанныеДляСверки.ДвиженияПоРасчетнымСчетам.Сортировать("ИнвестСчет, Дата");
	
	Возврат ДанныеДляСверки;
	
КонецФункции

Функция ПроверкаИнвестСчета(СтрокаСчетаДоверительногоУправления, ДокументРезультат)
	
	Успешно = Истина;
	
	Если СтрокаСчетаДоверительногоУправления.НеВыбранСпецДепозитарий Тогда
		ВывестиПоказатель("Депозитарий:", "Отсутствует", ДокументРезультат);
		Успешно = Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(СтрокаСчетаДоверительногоУправления.ИнвестСчет)  Тогда
		ВывестиПоказатель("Инвест.счет:", "Отсутствует", ДокументРезультат);
		Успешно = Ложь;
	Иначе 
		ВывестиПоказатель("Инвест.счет:", СтрокаСчетаДоверительногоУправления.ИнвестСчет, ДокументРезультат,,Новый Цвет(0, 150, 0));
	КонецЕсли;
	
	Возврат Успешно;
	
КонецФункции

Процедура СверкаДвиженияПоРасчетнымСчетам(СтрокаСчетаДоверительногоУправления, ДвиженияПоРасчетнымСчетам, ДокументыЭДО, ДокументРезультат)
	
	НайденныеСтроки = ДвиженияПоРасчетнымСчетам.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаСчетаДоверительногоУправления.СчетДоверительногоУправления));
	
	Показатель = "";
	Для Каждого СтрокаДвиженияПоРасчетнымСчетам Из НайденныеСтроки Цикл
		Если Показатель <> СтрокаДвиженияПоРасчетнымСчетам.Банк + " " + СтрокаДвиженияПоРасчетнымСчетам.НомерСчета Тогда
			Показатель = СтрокаДвиженияПоРасчетнымСчетам.Банк + " " + СтрокаДвиженияПоРасчетнымСчетам.НомерСчета;
			ВывестиПоказатель(Показатель,, ДокументРезультат, "Банк");
			ПроверитьВЭДО("520", СтрокаДвиженияПоРасчетнымСчетам.Дата,  "Выписка по счету (520)", , СтрокаДвиженияПоРасчетнымСчетам.НомерСчета,, СтрокаДвиженияПоРасчетнымСчетам, ДокументРезультат, ДокументыЭДО);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

