Процедура ПроверкаМНО(СтрокаСчетаДоверительногоУправления, МНО, ДокументыЭДО, ДокументРезультат)
	
	НайденныеСтроки = МНО.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СтрокаСчетаДоверительногоУправления.СчетДоверительногоУправления));
	Для Каждого СтрокаМНО Из НайденныеСтроки Цикл
		ВывестиПоказатель("МНО №" + СтрокаМНО.Номер,, ДокументРезультат);
		
		Если СтрокаМНО.КонтрольМНО Тогда
			ПроверитьВЭДО("530", СтрокаМНО.Дата, Строка(СтрокаМНО.Сумма) + " (530)", СтрокаМНО.Сумма,,, СтрокаМНО, ДокументРезультат, ДокументыЭДО,,,Истина);
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаМНО.НомерПодтверждения) Тогда
			ВывестиПоказатель("Номер подтверждения в МНО" + СтрокаМНО.Номер, "Отсутствует", ДокументРезультат);
		Иначе
			ПроверитьВЭДО("NTD", ДобавитьКДатеРабочиеДниКеш(СтрокаМНО.Дата, 1), "Подтверждение (NTD)",, СтрокаМНО.СтрокаПоиска1, "№" + Строка(СтрокаМНО.НомерПодтверждения), СтрокаМНО, ДокументРезультат, ДокументыЭДО);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверкаМНОЗаСледующийДень(СтрокаСчетаДоверительногоУправления, МНОЗаСледующийДень, ДокументыЭДО, ДокументРезультат)
	
