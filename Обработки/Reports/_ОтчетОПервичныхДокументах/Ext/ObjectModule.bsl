	Если НайденныеСтроки.Количество() > 0 Тогда
		ВывестиПоказатель("",, ДокументРезультат);
		ВывестиПоказатель(Формат(ДобавитьКДатеРабочиеДниКеш(ЭтотОбъект.Период, 1), "ДФ=dd.MM.yy"),, ДокументРезультат,,Новый Цвет(0, 0, 100));
	КонецЕсли;
	
	Для Каждого СтрокаМНО Из НайденныеСтроки Цикл
		ВывестиПоказатель("МНО №" + СтрокаМНО.Номер,, ДокументРезультат);
		ПроверитьВЭДО("530", СтрокаМНО.Дата, Строка(СтрокаМНО.Сумма) + " (530)", СтрокаМНО.Сумма,,, СтрокаМНО, ДокументРезультат, ДокументыЭДО,,,Истина);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПоказатель(НазвПоказателя, Статус = "", ДокументРезультат, ИмяОбласти = "Показатель", Цвет = Неопределено)
	
	Если ИмяОбласти = "Показатель" И НЕ ЗначениеЗаполнено(Статус) Тогда
		ИмяОбласти = "ПоказательБезСтатуса";
	КонецЕсли;
	
	Область = ПолучитьМакет("Макет").ПолучитьОбласть(ИмяОбласти);
	
	ЗаполнитьЗначенияСвойств(Область.Параметры, Новый Структура("НазвПоказателя, Статус", НазвПоказателя, Статус));
	
	Если Статус = "Отсутствует" Тогда
		Область.Области[ИмяОбласти].ЦветТекста = Новый Цвет(255, 0, 0);
	ИначеЕсли Статус = "Ок" Тогда
		Область.Области[ИмяОбласти].ЦветТекста = Новый Цвет(0, 150, 0);
	ИначеЕсли Цвет <> Неопределено Тогда
		Область.Области[ИмяОбласти].ЦветТекста = Цвет;
	КонецЕсли;
	
	ДокументРезультат.Вывести(Область);
	
КонецПроцедуры	

Процедура ПроверитьВЭДО(КодДокумента, Дата,  НазвПоказателя, Сумма = 0, СтрокаПоиска1 = "", СтрокаПоиска2 = "", ПараметрыПроверки, ДокументРезультат, ДокументыЭДО, Количество = 1, УдалятьСтроки = Истина, УдалятьВсеСтроки = Ложь, КодВалюты = Неопределено)
	
	Если Количество = 0 Тогда Возврат; КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("КодДепозитария, ИнвестСчет");
	ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ПараметрыПроверки);
	ПараметрыОтбора.Вставить("Дата"			, Дата); 
	ПараметрыОтбора.Вставить("КодДокумента"	, КодДокумента); 
	ПараметрыОтбора.Вставить("Сумма"		, Сумма); 
	
	Если КодВалюты <> Неопределено Тогда
		ПараметрыОтбора.Вставить("Валюта", КодВалюты); 
	КонецЕсли;
	
	НайденныеСтроки = ДокументыЭДО.НайтиСтроки(ПараметрыОтбора);
	УдаляемыеСтроки = Новый Массив;
	
	Для Каждого ДокументЭДО Из НайденныеСтроки Цикл
		Если (ПустаяСтрока(СтрокаПоиска2) ИЛИ Найти(НРег(ДокументЭДО.Инфо), НРег(СтрокаПоиска1)) > 0)
			И (ПустаяСтрока(СтрокаПоиска2) ИЛИ Найти(НРег(ДокументЭДО.Инфо), НРег(СтрокаПоиска2)) > 0) Тогда
			УдаляемыеСтроки.Добавить(ДокументЭДО);
			Количество = Количество - 1;
			
			Если Количество = 0 И НЕ УдалятьВсеСтроки Тогда
				Прервать;
			КонецЕсли;
	    КонецЕсли;
	КонецЦикла;
	
	Если УдалятьСтроки ИЛИ УдалятьВсеСтроки Тогда 
		Для Каждого ДокументЭДО Из УдаляемыеСтроки Цикл 
			ДокументыЭДО.Удалить(ДокументЭДО);
		КонецЦикла;	
	КонецЕсли;
	
	Статус = ?(Количество < 1, "Ок", "Отсутствует");
	
	Если ЗначениеЗаполнено(Сумма) Тогда
		ВывестиПоказатель(НазвПоказателя, Статус, ДокументРезультат, "Сумма");
	Иначе
		ВывестиПоказатель(НазвПоказателя, Статус, ДокументРезультат);
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьКДатеРабочиеДниКеш(ВходящаяДата, КоличествоДней)
	
	Если ТипЗнч(ТаблицаРабочихДат) <> Тип("ТаблицаЗначений") Тогда
		ТаблицаРабочихДат = Новый ТаблицаЗначений;
		ТаблицаРабочихДат.Колонки.Добавить("ВходящаяДата");
		ТаблицаРабочихДат.Колонки.Добавить("КоличествоДней");
		ТаблицаРабочихДат.Колонки.Добавить("ИсходящаяДата");
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ВходящаяДата, КоличествоДней", ВходящаяДата, КоличествоДней);
	НайденныеСтроки = ТаблицаРабочихДат.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		НоваяСтрока = ТаблицаРабочихДат.Добавить();
		НоваяСтрока.ВходящаяДата	= ВходящаяДата;
		НоваяСтрока.КоличествоДней	= КоличествоДней;
		НоваяСтрока.ИсходящаяДата	= ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ВходящаяДата, КоличествоДней);
		Возврат НоваяСтрока.ИсходящаяДата;
	Иначе
		Возврат НайденныеСтроки[0].ИсходящаяДата;
	КонецЕсли;
	
КонецФункции

Функция ДобавитьКДатеРабочиеДни(Календарь, Дата, РабочиеДни) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
		|	ДанныеКалендаря.Дата КАК РабочаяДата
		|ПОМЕСТИТЬ РабочиеДни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = &Календарь
		|	И ДанныеКалендаря.Дата < &Дата
		|	И (ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
		|			ИЛИ ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|УПОРЯДОЧИТЬ ПО
		|	РабочаяДата УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(РабочиеДни.РабочаяДата) КАК РабочаяДата
		|ИЗ
		|	РабочиеДни КАК РабочиеДни";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "10", Строка(РабочиеДни * ?(РабочиеДни>0,1,-1)));
	Если РабочиеДни>0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДанныеКалендаря.Дата < &Дата", "ДанныеКалендаря.Дата > &Дата");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УБЫВ", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "МИНИМУМ", "МАКСИМУМ");
	КонецЕсли;
	Запрос.УстановитьПараметр("Дата"		, НачалоДня(Дата));
	Запрос.УстановитьПараметр("Календарь"	, Календарь);

	РезультатЗапроса = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
