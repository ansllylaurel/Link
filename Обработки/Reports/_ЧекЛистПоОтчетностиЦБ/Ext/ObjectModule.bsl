
#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Чек лист по отчетности ЦБ",
		"0.36",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповеститьОНаступленииКрайнегоСрокаСдачиОтчетности", "Оповестить о наступлении крайнего срока сдачи отчетности", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	
#Область НачалоСбораСтатистики
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя();
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);	
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
#КонецОбласти	
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "ОповеститьОНаступленииКрайнегоСрокаСдачиОтчетности") Тогда
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата()) Тогда
		
			ОтчетнаяДата = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецДня(ТекущаяДата()), ПараметрыКоманды.КоличествоДнейДоСдачи);
			ЭтотОбъект.Период = Новый СтандартныйПериод(НачалоДня(ОтчетнаяДата), КонецДня(ОтчетнаяДата));
			
			Результат		= Новый ТабличныйДокумент;
			ОтправитьОтчет	= Ложь;
			
			ЗаполнитьОтчет(Результат, ОтправитьОтчет, Ложь);
			
			Если ОтправитьОтчет Тогда
				
				ПараметрыПисьма = Новый Структура;
				ПараметрыПисьма.Вставить("Кому", 		ПараметрыКоманды.ПолучателиОтчета);
				ПараметрыПисьма.Вставить("Тема", 		СтрШаблон("Срок сдачи отчётов ЦБ истекает через %1 дня", ПараметрыКоманды.КоличествоДнейДоСдачи));
				ПараметрыПисьма.Вставить("Тело", 		РаботаСОтчетами.ТабличныйДокументВHTML(Результат));
				ПараметрыПисьма.Вставить("ТипТекста", 	ТипТекстаПочтовогоСообщения.HTML);
				
				РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма,, Истина);

			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	

КонецПроцедуры

#КонецОбласти

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
#Область НачалоСбораСтатистики
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя();
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);	
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
#КонецОбласти	
	
 	СтандартнаяОбработка = Ложь;
	Отказ = Ложь;
	
	ЗаполнитьОтчет(ДокументРезультат,, Отказ);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	
КонецПроцедуры

Процедура ЗаполнитьОтчет(ДокументРезультат, ЕстьДанные = Ложь, Отказ)
	
	ДокументРезультат.ФиксацияСверху = 5;
	
	УчетДолжностныхЛиц = ВедетсяУчетДолжностныхЛиц(ЭтотОбъект.Организация);
	
	Если ОбщегоНазначения.ЗначениеПараметраСеанса("ЭтоРабочаяИнформационнаяБаза") ИЛИ СистемныеФункции.ЭтоФоновоеЗадание() Тогда 
		ОтчетностьЦБ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_ОтчетностьЦБ");
	Иначе
		ОтчетностьЦБ = ВнешниеОтчеты.Создать("\\ap69\Developers\Дима\Epf\_ОтчетностьЦБ.erf");  // ВАЖНО !!! При использовании на копии обработка берется из каталога!
	КонецЕсли;
	
	ОтчетностьЦБ.Организация = ЭтотОбъект.Организация;
	ОтчетностьЦБ.Период		 = ЭтотОбъект.Период;
	
	ТочкиВходаСрокиСдачи = ОтчетностьЦБ.ПолучитьТаблицуИзМакета("ТочкиВходаСрокиСдачи", , , , , Ложь);
	
	МаксимальноеКоличествоДней = 0;
	МаксимальноеКоличествоРабочихДней = 0;
	
	Для Каждого СтрокаТочкиВходаСрокиСдачи Из ТочкиВходаСрокиСдачи Цикл
		Если СтрокаТочкиВходаСрокиСдачи.ВРабочихДнях Тогда
			МаксимальноеКоличествоРабочихДней = Макс(МаксимальноеКоличествоРабочихДней, СтрокаТочкиВходаСрокиСдачи.Срок);
		Иначе
			МаксимальноеКоличествоДней = Макс(МаксимальноеКоличествоДней, СтрокаТочкиВходаСрокиСдачи.Срок);
		КонецЕсли;
	КонецЦикла;
	
	ПерваяОтчетнаяДата = Мин(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала, - МаксимальноеКоличествоРабочихДней - 1), ЭтотОбъект.Период.ДатаНачала - МаксимальноеКоличествоДней * 86400); 
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала", 		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",		ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПерваяОтчетнаяДата",	ПерваяОтчетнаяДата);
	Запрос.УстановитьПараметр("ПредыдущийРабочийДеньОтДатыНачала", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала - 1, - 1));
	
	ВерсииТаксономии = Новый Массив;
	ТочкиВхода = ОтчетностьЦБ.ПолучитьТочкиВхода();
	ТочкиВхода.Колонки.Добавить("ФормируетсяНаПоследнийРабочийДень", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТочкаВхода Из ТочкиВхода Цикл
		Если ВерсииТаксономии.Найти(СтрокаТочкаВхода.ВерсияТаксономии) = Неопределено Тогда
			ВерсииТаксономии.Добавить(СтрокаТочкаВхода.ВерсияТаксономии);
		КонецЕсли;
		СтрокаТочкаВхода.ФормируетсяНаПоследнийРабочийДень = ОтчетностьЦБ.ОтчетФормируетсяНаПоследнийРабочийДень(СтрокаТочкаВхода.ИмяПакета);
	КонецЦикла;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТочкиВходаСрокиСдачи, "_ТочкиВходаСрокиСдачи", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТочкиВхода, "_ТочкиВхода", Запрос);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ОтчетностьЦБ.ПолучитьТаблицуИзМакета("ОтборПоВидамДоговоровДУ"), 	"_ОтборПоВидамДоговоровДУ", Запрос);
	
	РазделыXBRL = ПодготовитьРазделыXBRL(ОтчетностьЦБ, ВерсииТаксономии);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(РазделыXBRL, 	"_РазделыXBRL", Запрос);
	
#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) КАК Дата,
		|	ЛОЖЬ КАК Нерегулярная,
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) <> КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, КВАРТАЛ)
		|		И КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) <> КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, ГОД) КАК Месяц,
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) = КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, КВАРТАЛ)
		|		И КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) <> КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, ГОД) КАК Квартал,
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, МЕСЯЦ) = КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, ГОД) КАК Год
		|ПОМЕСТИТЬ _ОтчетныеДаты
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &ПерваяОтчетнаяДата И &ДатаОкончания
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, ДЕНЬ),
		|	ИСТИНА,
		|	ЛОЖЬ,
		|	ЛОЖЬ,
		|	ЛОЖЬ
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &ПерваяОтчетнаяДата И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(_ОтчетныеДаты.Дата, ДЕНЬ) КАК Дата,
		|	МАКСИМУМ(РабочиеДниПередОтчетнойДатой.Дата) КАК РабочаяДата,
		|	ДатыСдачи.Дата КАК ДатаСдачи,
		|	_ОтчетныеДаты.Нерегулярная КАК Нерегулярная,
		|	_ОтчетныеДаты.Месяц КАК Месяц,
		|	_ОтчетныеДаты.Квартал КАК Квартал,
		|	_ОтчетныеДаты.Год КАК Год,
		|	ИСТИНА КАК ВРабочихДнях,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаря.Дата) КАК Срок
		|ПОМЕСТИТЬ _ОтчетныеДатыСоСрокамиСдачи
		|ИЗ
		|	_ОтчетныеДаты КАК _ОтчетныеДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДатыСдачи
		|		ПО (ДатыСдачи.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (ДатыСдачи.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|			И (ДатыСдачи.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (ДанныеКалендаря.Дата МЕЖДУ _ОтчетныеДаты.Дата И ДатыСдачи.Дата)
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК РабочиеДниПередОтчетнойДатой
		|		ПО _ОтчетныеДаты.Дата >= РабочиеДниПередОтчетнойДатой.Дата
		|			И (РабочиеДниПередОтчетнойДатой.Дата МЕЖДУ &ПерваяОтчетнаяДата И &ДатаОкончания)
		|			И (РабочиеДниПередОтчетнойДатой.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (РабочиеДниПередОтчетнойДатой.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(_ОтчетныеДаты.Дата, ДЕНЬ),
		|	ДатыСдачи.Дата,
		|	_ОтчетныеДаты.Нерегулярная,
		|	_ОтчетныеДаты.Месяц,
		|	_ОтчетныеДаты.Квартал,
		|	_ОтчетныеДаты.Год
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(_ОтчетныеДаты.Дата, ДЕНЬ),
		|	МАКСИМУМ(РабочиеДниПередОтчетнойДатой.Дата),
		|	МИНИМУМ(ДатыСдачи.Дата),
		|	_ОтчетныеДаты.Нерегулярная,
		|	_ОтчетныеДаты.Месяц,
		|	_ОтчетныеДаты.Квартал,
		|	_ОтчетныеДаты.Год,
		|	ЛОЖЬ,
		|	РАЗНОСТЬДАТ(_ОтчетныеДаты.Дата, ДанныеКалендаря.Дата, ДЕНЬ)
		|ИЗ
		|	_ОтчетныеДаты КАК _ОтчетныеДаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (ДанныеКалендаря.Дата МЕЖДУ &ПредыдущийРабочийДеньОтДатыНачала И &ДатаОкончания)
