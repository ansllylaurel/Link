				ПараметрыПоиска = Новый Структура("ТочкаВхода,ОтчетнаяДата", СтрокаОтчета.ТочкаВхода, СтрокаОтчета.ОтчетнаяДата);
				НайденныеСтроки = ТаблицаОтчеты.НайтиСтроки(ПараметрыПоиска);
				
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					НайденнаяСтрока.Вывести = Истина;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаОтчеты.Сортировать("ИмяПакета, ИсточникДанных,");
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(РаботаСВнешнимиСистемами.СтрокаСоединенияСXE());
	
	ВыборкаДатыСдачи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДатыСдачи.Следующий() Цикл
		ВыборкаТочкиВхода = ВыборкаДатыСдачи.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаТочкиВхода.Следующий() Цикл
			
			Отбор = Новый Структура("ДатаСдачи, ТочкаВхода, Вывести", ВыборкаТочкиВхода.ДатаСдачи, ВыборкаТочкиВхода.ТочкаВхода, Истина);

			НазначенИО = ВыборкаТочкиВхода.НазначениеИО И УчетДолжностныхЛиц;
			
			// Получение отчетов точки входа
			ОтчетыТочкиВхода = СоздатьТаблицуОтчетовТочкиВхода(ТаблицаОтчеты, Отбор, НазначенИО);

			Если ОтчетыТочкиВхода.Количество() Тогда
				
				// Получение файлов точки входа
				ФайлыОтчетовТочкиВхода = СоздатьТаблицуФайловТочкиВхода(Соединение, ОтчетыТочкиВхода);
				
				// Вывод строк отчета
				ВывестиСтрокиОтчета(Новый Структура("ДатаСдачи, ТочкаВхода", ВыборкаТочкиВхода.ДатаСдачи, ВыборкаТочкиВхода.ТочкаВхода), 
									ОтчетыТочкиВхода, ФайлыОтчетовТочкиВхода, Макет, ДокументРезультат);
									
				ЕстьДанные = Истина;
				
			КонецЕсли;	
			
		КонецЦикла;
	КонецЦикла;	
	
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	
КонецПроцедуры

Функция ПолучитьТаблицуФайловИзXE(Соединение, ВерсияТаксономии = "", ТочкаВхода = "", ОГРН = "", Дата = Неопределено, СписокРазделов = "", УсловиеОтбора = "", ВключатьСодержимоеФайла = Ложь) Экспорт
	
	ТекстЗапроса = 
		"SELECT 
		|	ID AS ИдентификаторОтчета,
		|	Taxonomy_Version AS ВерсияТаксономии,
		|	Entry_Point_Code AS ТочкаВхода,
		|	Firm_Code AS ОГРН,
		|	Date_From AS ДатаНачала,
		|   Date_To AS ДатаОкончания,
		|	[File_Name] AS ИмяФайла,
		|	--[File_Data] AS ДанныеXML,
		|	CAST(Load_Date AS datetime)  AS ДатаЗагрузки,
		|	[Description] AS Примечание,
		|	Forms AS РазделыОтчета,
		|   Is_XBRL AS Is_XBRL,
		|   Items AS Items
		|FROM 
		|	API_AM.udf_Get_Instances(&ВерсияТаксономии, &ТочкаВхода, &ОГРН, &Дата, &СписокРазделов)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ВерсияТаксономии",	?(ПустаяСтрока(ВерсияТаксономии),	"null", "'" + СтрЗаменить(ВерсияТаксономии, "_", ".") + "'"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТочкаВхода",			?(ПустаяСтрока(ТочкаВхода), 		"null", "'" + ТочкаВхода + "'"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОГРН",				?(ПустаяСтрока(ОГРН), 				"null", "'" + ОГРН + "'"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Дата",				?(ПустаяСтрока(Дата), 				"null", "'" + Формат(Дата, "ДФ=yyyyMMdd") + "'"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СписокРазделов",		?(ПустаяСтрока(СписокРазделов), 	"null", "'" + СписокРазделов + "'"));
	
	Если  ЗначениеЗаполнено(УсловиеОтбора) Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|WHERE
			|	" + УсловиеОтбора;
	КонецЕсли;
	
	Если ВключатьСодержимоеФайла Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "--[File_Data]", "[File_Data]");
	КонецЕсли;
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("ИдентификаторОтчета", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("ВерсияТаксономии", 	Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ТочкаВхода", 			Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ОГРН", 				Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ДатаНачала", 			Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("ДатаОкончания",		Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("ИмяФайла", 			Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ДатаЗагрузки", 		Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТипыКолонок.Вставить("ДанныеXML", 			Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("Примечание", 			Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("РазделыОтчета", 		Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("Is_XBRL", 			Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("Items", 			    Новый ОписаниеТипов("Строка"));
	ДополнительныеПараметры = Новый Структура("ВозвращатьПустуюТаблицу", Истина);
	
	Возврат РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса, ДополнительныеПараметры), ТипыКолонок, ДополнительныеПараметры);
	
КонецФункции

Функция ПолучитьТаблицуФайлов(Соединение, СтрокаОтчета)
	
	КэшДанныхXML = Новый Соответствие;
	
	ТаблицаФайловXE = ПолучитьТаблицуФайловИзXE(Соединение, 
												СтрокаОтчета.ВерсияТаксономии, 
												СтрокаОтчета.ТочкаВхода, 
												СтрокаОтчета.ОГРН, 
												СтрокаОтчета.ОтчетнаяДата, 
												?(СтрНайти("ОКУД0420431", СтрокаОтчета.ИмяПакета) > 0, "", СтрокаОтчета.РазделыXBRL), 
												СтрокаОтчета.УсловиеОтбора,
												Истина); 
												
	ТаблицаФайловXE.Сортировать("ИдентификаторОтчета, ДатаЗагрузки");
	
	Ном = ТаблицаФайловXE.Количество() - 1;
	Пока Ном >= 0 Цикл
		
		КонтрольныйНомерОтчета = ВРег(Сред(СтрокаОтчета.ИмяПакета, 5, 7));
		СтрокаФайловXE = ТаблицаФайловXE[Ном];
		Если (СтрНайти(ВРег(СтрокаФайловXE.ИмяФайла), КонтрольныйНомерОтчета) = 0 
			И СтрНачинаетсяС(ВРег(СтрокаОтчета.ИмяПакета), "ОКУД") 
			И СтрокаОтчета.ИсточникДанных <> "СД" 
			И ВРег(СтрокаОтчета.ИмяПакета) <> "ОКУД0420459"
			И ВРег(СтрокаОтчета.ИмяПакета) <> "ОКУД0420437")
			Или ВРег(СтрокаОтчета.ИмяПакета = "SR_INFO") И Не СтрНачинаетсяС(ВРег(СтрокаФайловXE.ИмяФайла), "SR_INFO")
			Или ВРег(СтрокаОтчета.ИмяПакета = "SR_SVED") И Не СтрНачинаетсяС(ВРег(СтрокаФайловXE.ИмяФайла), "SR_SVED")
			Или СтрНайти(ВРег(СтрокаФайловXE.Примечание), "ТЕСТ") > 0 
			Или СтрНайти(ВРег(СтрокаФайловXE.Примечание), "TEST") > 0 
			Или КэшДанныхXML.Получить(СтрШаблон("%1#%2", 
				СтрокаФайловXE.ИдентификаторОтчета, СтрокаОтчета.ИмяПакета)) <> Неопределено Тогда
			
			ТаблицаФайловXE.Удалить(СтрокаФайловXE); 
			// Чтобы не задваивать строки с файлами, когда при поиске по разделу, 
			// который есть в разных отчетах, возвращаются несколько файлов с другими отчетами 
			// Второе - избавляемся от полных дублей с одинаковым именем пакета, именем файла и содержимым данных XML
		Иначе	
			
			КэшДанныхXML.Вставить(СтрШаблон("%1#%2", СтрокаФайловXE.ИдентификаторОтчета,СтрокаОтчета.ИмяПакета), 0);
			
		КонецЕсли;	
		Ном = Ном - 1;
		
	КонецЦикла;	
 		
	Возврат ТаблицаФайловXE;
	
КонецФункции	

Функция СоздатьТаблицуОтчетовТочкиВхода(ТаблицаОтчеты, Отбор, НазначенИО)
	
	ОтчетыТочкиВхода = ТаблицаОтчеты.Скопировать(Отбор);
	ОтчетыТочкиВхода.Колонки.Добавить("ID_Строки", Новый ОписаниеТипов("Число"));
	Ном = 0;
	Для Каждого СтрокаТЗ Из ОтчетыТочкиВхода Цикл
		Ном = Ном + 1;
		СтрокаТЗ.ID_Строки = Ном;
	КонецЦикла;	
	
	Если ОтчетыТочкиВхода.Количество() Тогда
		
		ОтчетПакета = ОтчетыТочкиВхода[0].ИмяПакета;
		Если СтрНачинаетсяС(ОтчетПакета, "ОКУД04204") Тогда
			
			НоваяСтрока = ОтчетыТочкиВхода.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОтчетыТочкиВхода[0], , "Ответственный");
			НоваяСтрока.ID_Строки      = ОтчетыТочкиВхода.Количество();
			НоваяСтрока.ИмяПакета      = "SR_INFO";
			НоваяСтрока.РазделыXBRL    = "SR_INFO";
			НоваяСтрока.ИсточникДанных = "УФО";
			
		ИначеЕсли СтрНачинаетсяС(ОтчетПакета, "ОКУД04205") И Не (ОтчетПакета = "ОКУД0420504" 
			И ОтчетыТочкиВхода[0].ИсточникДанных = "СД") Или ОтчетПакета = "ВладельцыИИСвПИФ" Тогда
			
			НоваяСтрока = ОтчетыТочкиВхода.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОтчетыТочкиВхода[0], , "Ответственный, СубъектАналитики, УсловиеОтбора");
			НоваяСтрока.ID_Строки      = ОтчетыТочкиВхода.Количество();
			НоваяСтрока.ИмяПакета      = "SR_SVED"; 
			НоваяСтрока.РазделыXBRL    = "sr_sved_otch_org_podpisant,sr_sved_otch_org_uk";
			НоваяСтрока.ИсточникДанных = "УФО";
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Расширение отчетов точки входа приказом и доверенностью
	Если НазначенИО И ОтчетыТочкиВхода.Количество() Тогда
		
		НоваяСтрока = ОтчетыТочкиВхода.Добавить();
		НоваяСтрока.ID_Строки = ОтчетыТочкиВхода.Количество();
		НоваяСтрока.ИмяПакета = "ORDER";
		
		// Отключаем контроль доверенности по задаче #557248
		Если Отбор.ДатаСдачи < Дата(2024, 9, 1) Тогда
			НоваяСтрока = ОтчетыТочкиВхода.Добавить();
			НоваяСтрока.ID_Строки = ОтчетыТочкиВхода.Количество();
			НоваяСтрока.ИмяПакета = "ORDER_dov";
		КонецЕсли;
	
	КонецЕсли;	
	
	Возврат ОтчетыТочкиВхода;
	
КонецФункции	

Функция ПустаяТаблицаФайловТочкиВхода()
	
	ФайлыТочкиВхода = Новый ТаблицаЗначений;
	ФайлыТочкиВхода.Колонки.Добавить("ИмяПакета",              Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("ИдентификаторОтчета",    Новый ОписаниеТипов("Число"));
	ФайлыТочкиВхода.Колонки.Добавить("ИмяФайла", 			   Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("ДатаЗагрузки", 		   Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ФайлыТочкиВхода.Колонки.Добавить("Примечание", 			   Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("ID_Строки", 			   Новый ОписаниеТипов("Число"));
	ФайлыТочкиВхода.Колонки.Добавить("ДанныеXML", 			   Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("РазделыОтчета",		   Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("СубъектАналитики",	   Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("КонтрольНулевого", 	   Новый ОписаниеТипов("Строка"));
	ФайлыТочкиВхода.Колонки.Добавить("КонтрольОтветственного", Новый ОписаниеТипов("Булево"));
	ФайлыТочкиВхода.Колонки.Добавить("ПараметрыСкачивания");
	Возврат ФайлыТочкиВхода;
	 
КонецФункции	

Функция СоздатьТаблицуФайловТочкиВхода(Соединение, ОтчетыТочкиВхода)

	ФайлыТочкиВхода = ПустаяТаблицаФайловТочкиВхода();
	
	Для Каждого СтрокаОтчета Из ОтчетыТочкиВхода Цикл
		
		Если СтрНачинаетсяС(ВРег(СтрокаОтчета.ИмяПакета), "ORDER") Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		ТаблицаФайловXE = ПолучитьТаблицуФайлов(Соединение, СтрокаОтчета);
		Для Каждого СтрокаФайловXE Из ТаблицаФайловXE Цикл
			
			Если ПроверитьПоПериоду(СтрокаОтчета, СтрокаФайловXE) Тогда

				ПараметрыПроверки = Новый Структура("ДанныеXML, РазделыОтчета, ИмяОтчета, ИсточникДанных", 
													СтрокаФайловXE.ДанныеXML, 
													СтрокаФайловXE.РазделыОтчета, 
													СтрокаОтчета.ИмяПакета,
													СтрокаОтчета.ИсточникДанных);
				РезультатПроверкиНулевогоОтчета = КонтрольНулевогоОтчета(ПараметрыПроверки);
				
				НоваяСтрока = ФайлыТочкиВхода.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФайловXE); 
				НоваяСтрока.ID_Строки              = СтрокаОтчета.ID_Строки;				
				НоваяСтрока.ИмяПакета              = СтрокаОтчета.ИмяПакета;
				НоваяСтрока.СубъектАналитики       = СтрокаОтчета.СубъектАналитики;
				НоваяСтрока.КонтрольНулевого       = РезультатПроверкиНулевогоОтчета;
				НоваяСтрока.КонтрольОтветственного = КонтрольОтветственногоОтчета(ПараметрыПроверки);
				
				Если Истина Или РаботаСПользователями.РолиДоступны("ПолныеПрава") Тогда

					НоваяСтрока.ПараметрыСкачивания = Новый Структура("ВерсияТаксономии, 
						|ТочкаВхода, 
						|ОГРН, 
						|ОтчетнаяДата, 
						|РазделыXBRL, 
						|УсловиеОтбора, 
						|ИдентификаторОтчета, 
						|ДатаЗагрузки, 
						|Примечание, 
						|ИмяФайла", 
						СтрокаОтчета.ВерсияТаксономии, 
						СтрокаОтчета.ТочкаВхода, 
						СтрокаОтчета.ОГРН, 
						СтрокаОтчета.ОтчетнаяДата, 
						СтрокаОтчета.РазделыXBRL, 
						СтрокаОтчета.УсловиеОтбора, 
						СтрокаФайловXE.ИдентификаторОтчета, 
						СтрокаФайловXE.ДатаЗагрузки, 
						СтрокаФайловXE.Примечание, 
						СтрокаФайловXE.ИмяФайла); 
																		
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЦикла;	
		
	КонецЦикла;
	
	СтрокаОтборПоИдентификаторам = СтрЗаменить(СтрСоединить(ФайлыТочкиВхода.Скопировать(, "ИдентификаторОтчета").ВыгрузитьКолонку("ИдентификаторОтчета"), ","), Символы.НПП, "");
	ВложенияПакетов              = РаботаСВнешнимиСистемами.ТаблицаВложенийИзXE(Соединение, СтрокаОтборПоИдентификаторам); 
	Вложения                     = ВложенияПриказовИДоверенностей(ВложенияПакетов);
	
	Для Каждого Вложение Из Вложения Цикл
		ЗаполнитьЗначенияСвойств(ФайлыТочкиВхода.Добавить(), Вложение);
	КонецЦикла;	
	
	ФайлыТочкиВхода.Сортировать("ИмяПакета, ИдентификаторОтчета, ИмяФайла");
	
	Возврат ФайлыТочкиВхода;
	
КонецФункции

Функция КонтрольНулевогоОтчета(ДанныеОтчета)
	
	Если СтрНайти(ДанныеОтчета.ДанныеXML, "XBRL_Entry_Point") > 0 Тогда // Это наш промежуточный формат XML

		ОтчетыФайла   = ОтчетыПоРазделамИзОтчетаXML(ДанныеОтчета);
		НулевыеОтчеты = НулевыеОтчетыИзОтчетаXML(ДанныеОтчета);
		
	Иначе // Тут ожидаем отчет XBRL
		
		// Пока у нас был случай получения от спец.депа отчета в XBRL по форме 504
		// Считаем, что в отчете всё соответствует. Проверка не реализована, т.к. работа с полноценным XBRL у нас не ведется
		ОтчетыФайла   = ОтчетыИзОтчетаXBRL(ДанныеОтчета);
		НулевыеОтчеты = НулевыеОтчетыИзОтчетаXBRL(ДанныеОтчета);
		
	КонецЕсли;	
	
	КонтрольНулевогоОтчета = ПроверкаПризнакаНулевогоОтчета(ДанныеОтчета.ИмяОтчета, 
																		ОтчетыФайла, 
																		НулевыеОтчеты);
	Возврат КонтрольНулевогоОтчета;																		
			
КонецФункции	

