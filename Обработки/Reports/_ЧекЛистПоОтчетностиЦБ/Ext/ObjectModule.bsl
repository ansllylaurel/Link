Функция НулевыеОтчетыИзОтчетаXML(ДанныеОтчета)
	
    ВариантыЭлементов = Новый Массив;
	ВариантыЭлементов.Добавить(ВРег("OKUDAxis"));
	ВариантыЭлементов.Добавить(ВРег("OKUDEnumerator"));
	
	НулевыеОтчеты = Новый Массив;
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ДанныеОтчета.ДанныеXML);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(Чтение);
	
	СтрокаЗапросаXPath = "//*[@Value=""ZnachPokOtsMember""]";
	ВыборкаXPath = ДокументDOM.ВычислитьВыражениеXPath(СтрокаЗапросаXPath, ДокументDOM.ЭлементДокумента, Новый РазыменовательПространствИменDOM(ДокументDOM.ЭлементДокумента));
	ЭлементDOM   = ВыборкаXPath.ПолучитьСледующий();
	Пока ЭлементDOM <> Неопределено Цикл
		
		Если ДанныеОтчета.ИмяОтчета = "ОКУД0420011" Тогда // 011-й отчет один в точке входа и в нем наличие "ZnachPokOtsMember" уже достаточно для определения нулевого отчета
			
			НулевыеОтчеты.Добавить("ОКУД0420011");
			Прервать;
			
		КонецЕсли;	
		
		Для Каждого ПодчиненныйЭлементDOM Из ЭлементDOM.РодительскийУзел.ДочерниеУзлы Цикл
			
			Если ВариантыЭлементов.Найти(ВРег(ПодчиненныйЭлементDOM.ИмяЭлемента)) <> Неопределено Тогда

				НулевойОтчет = ИзвлечьИмяОтчета(ДанныеОтчета.ИмяОтчета, ПодчиненныйЭлементDOM.Атрибуты.ПолучитьИменованныйЭлемент("Value").Значение);
				Если НулевойОтчет = ДанныеОтчета.ИмяОтчета Тогда
					
					НулевыеОтчеты.Добавить(НулевойОтчет);	
					//Сообщить(СтрШаблон("Найден отчет %1 с признаком нулевого отчета в элементе %2", ДанныеОтчета.ИмяОтчета, ЭлементDOM.ИмяЭлемента));
					
				Иначе	
					
					//Сообщить(СтрШаблон("Найден отчет %1 с признаком нулевого отчета для отчета %2 в элементе %3", ДанныеОтчета.ИмяОтчета, НулевойОтчет, ЭлементDOM.ИмяЭлемента));

				КонецЕсли;	
				
			КонецЕсли;
		
		КонецЦикла;	
		
		ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
		
	КонецЦикла;	
	Возврат НулевыеОтчеты;
	
КонецФункции	

Функция ОтчетыСОтветственнымИзОтчетаXML(ДанныеОтчета)

	ОтчетыСОтветственным = Новый Массив;
	
	// 011-й отчет и ВладельцыИИСвПИФ одни в точке входа и в них просто достаточно проверить наличие элемента с ответственным
	Если ДанныеОтчета.ИмяОтчета = "ОКУД0420011" Или ДанныеОтчета.ИмяОтчета = "ВладельцыИИСвПИФ"	Тогда 
		
		Если КонтрольОтветственногоОтчетаПоПоказателю(ДанныеОтчета.ДанныеXML) Тогда
			
			ОтчетыСОтветственным.Добавить(ДанныеОтчета.ИмяОтчета);
			Возврат ОтчетыСОтветственным;
			
		КонецЕсли;	
			
	КонецЕсли;	
	
	ВариантыЭлементов = СтрРазделить(ВРег("OKUDAxis,OKUDEnumerator,PrOblastOtcetnostiTaxis"), ",", Ложь);
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ДанныеОтчета.ДанныеXML);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(Чтение);
	
	ВариантыСтрокиЗапросаXPath = СтрРазделить("//FIOLiczaOtvZaPrOblast,//LiczoOtvZaPrOblast", ",", Ложь);
	
	Для Каждого СтрокаЗапросаXPath Из ВариантыСтрокиЗапросаXPath Цикл 
		
		ВыборкаXPath = ДокументDOM.ВычислитьВыражениеXPath(СтрокаЗапросаXPath, ДокументDOM.ЭлементДокумента, Новый РазыменовательПространствИменDOM(ДокументDOM.ЭлементДокумента));
		ЭлементDOM   = ВыборкаXPath.ПолучитьСледующий();
		Пока ЭлементDOM <> Неопределено Цикл
			
			Для Каждого ПодчиненныйЭлементDOM Из ЭлементDOM.РодительскийУзел.ДочерниеУзлы Цикл
				
				Если ВариантыЭлементов.Найти(ВРег(ПодчиненныйЭлементDOM.ИмяЭлемента)) <> Неопределено Тогда
					
					ИмяОтчета = ИзвлечьИмяОтчета(ДанныеОтчета.ИмяОтчета, ПодчиненныйЭлементDOM.Атрибуты.ПолучитьИменованныйЭлемент("Value").Значение);
					ОтчетыСОтветственным.Добавить(ИмяОтчета);
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;	
			
			ЭлементDOM = ВыборкаXPath.ПолучитьСледующий();
			
		КонецЦикла;
		
	КонецЦикла;
	Возврат ОтчетыСОтветственным;
	
КонецФункции	

Функция ОтчетыПоРазделамИзОтчетаXML(ДанныеОтчета)
	
	ОтчетыИсключения = ОтчетыСодержащиеТолькоРазделОтветственныхВУФО();
	
	РазделыОтчета = СтрРазделить(ДанныеОтчета.РазделыОтчета, ",", Ложь);
	
    ОбщиеРазделы = Новый Массив;
	Если Не (ОтчетыИсключения.Найти(ДанныеОтчета.ИмяОтчета) <> Неопределено И ДанныеОтчета.ИсточникДанных = "УФО") Тогда
		
		ОбщиеРазделы.Добавить(ВРег("SR_Sved_ObOtchOrg_OtvLicza"));
		
	КонецЕсли;	
	ОбщиеРазделы.Добавить(ВРег("sr_sved_otch_org_otv_predm_obl"));
	ОбщиеРазделы.Добавить(ВРег("sr_sved_otch_org_inf_ob_otch"));
	Если ВРег(ДанныеОтчета.ИмяОтчета) <> "SR_INFO" Тогда
		
		ОбщиеРазделы.Добавить(ВРег("SR_INFO"));
		
	КонецЕсли;	
	Если ВРег(ДанныеОтчета.ИмяОтчета) <> "SR_SVED" Тогда

		ОбщиеРазделы.Добавить(ВРег("SR_SVED_OTCH_ORG_PODPISANT"));
		ОбщиеРазделы.Добавить(ВРег("SR_SVED_OTCH_ORG_UK"));
		
	КонецЕсли;

	АктуальныеОтчеты = Новый ТаблицаЗначений;
	АктуальныеОтчеты.Колонки.Добавить("Отчет", Новый ОписаниеТипов("Строка"));
	Для Каждого Раздел Из РазделыОтчета Цикл
		
		Если ОбщиеРазделы.Найти(СтрЗаменить(ВРег(Раздел), "_ITEM", "")) <> Неопределено Тогда

			Продолжить;
			
		КонецЕсли;	
		НоваяСтрока = АктуальныеОтчеты.Добавить();
		НоваяСтрока.Отчет = ИзвлечьИмяОтчета(ДанныеОтчета.ИмяОтчета, СтрЗаменить(ВРег(Раздел), "_ITEM", ""));
		
	КонецЦикла;
	АктуальныеОтчеты.Свернуть("Отчет");
	Возврат АктуальныеОтчеты.ВыгрузитьКолонку("Отчет");
	
КонецФункции

Функция ОтчетыСодержащиеТолькоРазделОтветственныхВУФО() 
	
	Результат = Новый Массив;
	Результат.Добавить("ОКУД0420402");
	Результат.Добавить("ОКУД0420404");
	Возврат Результат;
	
КонецФункции

Функция ПроверкаПризнакаНулевогоОтчета(ИмяОтчета, ОтчетыФайла, НулевыеОтчеты)
	
	ДанныеОтчетаЕстьВФайле        = ОтчетыФайла.Найти(ИмяОтчета) <> Неопределено;
	ПризнакНулевогоОтчетаВыгружен = НулевыеОтчеты.Найти(ИмяОтчета) <> Неопределено;
	
	Результат = "";
	Если ДанныеОтчетаЕстьВФайле И ПризнакНулевогоОтчетаВыгружен Тогда
		
		Результат = "Установлен ошибочно!";
		
	ИначеЕсли Не ДанныеОтчетаЕстьВФайле И Не ПризнакНулевогоОтчетаВыгружен Тогда
		
		Результат = "Не установлен!";
		
	ИначеЕсли Не ДанныеОтчетаЕстьВФайле И ПризнакНулевогоОтчетаВыгружен Тогда	
		
		Результат = "Установлен";
		
	КонецЕсли;	
	Возврат Результат;
	
КонецФункции

Функция ИзвлечьИмяОтчета(ТекущееИмяОтчета, ПредставлениеОтчета)
	
	Результат = ПредставлениеОтчета;
	
	Позиция0420 = СтрНайти(ПредставлениеОтчета, "0420");
	Если Позиция0420 > 0 Тогда
		
		Результат = "ОКУД" + ВРег(Сред(ПредставлениеОтчета, Позиция0420, 7));	
		
	ИначеЕсли ВРег(ПредставлениеОтчета) = ВРег("SvedOKolVldInvPaiPIFuchitIIS") Тогда	
		               
		Результат = "ВладельцыИИСвПИФ";
		
	ИначеЕсли ТекущееИмяОтчета = "БФО" Тогда
		
		Результат = "БФО";
		
	ИначеЕсли ТекущееИмяОтчета = "ГКФО_СопроводительноеПисьмо" Тогда 
		
		Результат = "ГКФО_СопроводительноеПисьмо";
		

	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420432" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_2") > 0 Тогда	
		
		Результат = "ОКУД0420432";	
		
	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420523" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_2") > 0 Тогда	
		
		Результат = "ОКУД0420523";	


	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420419" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_3") > 0 Тогда	
		
		Результат = "ОКУД0420419";	
		
	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420510" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_3") > 0 Тогда	
		
		Результат = "ОКУД0420510";	

		
	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420520" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_4") > 0 Тогда	
		
		Результат = "ОКУД0420520";	

		
	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420515" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_5") > 0 Тогда	
		
		Результат = "ОКУД0420515";	
		
		
	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420406" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_6") > 0 Тогда	
		
		Результат = "ОКУД0420406";	
		
	ИначеЕсли ТекущееИмяОтчета = "ОКУД0420516" И СтрНайти(ВРег(ПредставлениеОтчета), "SR_NFO_6") > 0 Тогда	
		
		Результат = "ОКУД0420516";	
		
	ИначеЕсли ТекущееИмяОтчета = "SR_INFO" Тогда	
		
		Результат = ТекущееИмяОтчета;
		
	ИначеЕсли ТекущееИмяОтчета = "SR_SVED" Тогда	
		
		Результат = ТекущееИмяОтчета;
		
	ИначеЕсли ОтчетыСодержащиеТолькоРазделОтветственныхВУФО().Найти(ТекущееИмяОтчета) <> Неопределено Тогда
		
		Результат = ТекущееИмяОтчета;
		
	Иначе
		
		Сообщить(СтрШаблон("Не удалось определить имя отчета по представлению %1 для текущего отчета %2", ПредставлениеОтчета, ТекущееИмяОтчета));
		
	КонецЕсли;	
	Возврат Результат;
	
КонецФункции	

Процедура ВывестиСтрокиОтчета(ДатаТочка, ОтчетыТочкиВхода, ФайлыОтчетовТочкиВхода, Макет, ДокументРезультат)

	ID_Пакетов = ФайлыОтчетовТочкиВхода.Скопировать(, "ИдентификаторОтчета");
	ID_Пакетов.Свернуть("ИдентификаторОтчета");
	ID_Пакетов.Сортировать("ИдентификаторОтчета");
	
	Если ID_Пакетов.Количество() = 0 Тогда
		НоваяСтрока = ID_Пакетов.Добавить();
	КонецЕсли;	
	
	ОтчетыСЗаполненнымОтветственным = Новый Соответствие;
	Для Каждого СтрокаФайлов Из ФайлыОтчетовТочкиВхода Цикл
		
		Если СтрокаФайлов.КонтрольОтветственного Тогда
			
			ОтчетыСЗаполненнымОтветственным.Вставить(СтрШаблон("%1#%2#%3", 
			СтрокаФайлов.ИдентификаторОтчета, СтрокаФайлов.ИмяПакета, СтрокаФайлов.СубъектАналитики), 0);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	НачальнаяСтрокаОбласти = ДокументРезультат.ВысотаТаблицы + 1;

	Для Каждого СтрокаID_Пакетов Из ID_Пакетов Цикл
		
		НачальнаяСтрокаОбластиПакет = ДокументРезультат.ВысотаТаблицы + 1;
		
		ОтчетыБезФайлов = Новый Массив;
		
		Для Каждого СтрокаОтчета Из ОтчетыТочкиВхода Цикл

			Если СтрокаОтчета.ИмяПакета = "SR_INFO" И Раздел_SR_INFO_ЕстьВФайлахПакета(ФайлыОтчетовТочкиВхода) Тогда
				// Если среди файлов пакета раздел SR_INFO уже есть в каком-то файле кроме файла SR_INFO, 
				// то вывод отчета SR_INFO отдельной строкой не имеет смысла
				Продолжить; 
				
			КонецЕсли;	
  			Если СтрНайти("ORDER, ORDER_dov", СтрокаОтчета.ИмяПакета) = 0 Тогда

				Отбор = Новый Структура("ID_Строки, ИдентификаторОтчета", СтрокаОтчета.ID_Строки, СтрокаID_Пакетов.ИдентификаторОтчета); 
				
			Иначе

				Отбор = Новый Структура("ИмяПакета, ИдентификаторОтчета", СтрокаОтчета.ИмяПакета, СтрокаID_Пакетов.ИдентификаторОтчета); 
				
			КонецЕсли;	
			
			НайденныеСтроки = ФайлыОтчетовТочкиВхода.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				
				Для Каждого СтрокаФайлов Из НайденныеСтроки Цикл
					
					ОбластьОтчета = ВывестиСтрокуОтчета(ДатаТочка, СтрокаОтчета, СтрокаФайлов, СтрокаID_Пакетов, Макет, ДокументРезультат, ОтчетыСЗаполненнымОтветственным);  
					
				КонецЦикла;	 
				
			Иначе	

				ОтчетыБезФайлов.Добавить(СтрокаОтчета);
				
			КонецЕсли;	
			
		КонецЦикла;
		
		Для Каждого СтрокаОтчета Из ОтчетыБезФайлов Цикл
			ОбластьОтчета = ВывестиСтрокуОтчета(ДатаТочка, СтрокаОтчета, , СтрокаID_Пакетов, Макет, ДокументРезультат);  
		КонецЦикла;	
		
		ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет,     3, ДокументРезультат.ВысотаТаблицы, 3).Объединить(); // Версия таксономии
		ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет,     4, ДокументРезультат.ВысотаТаблицы, 4).Объединить(); // ID отчета
		ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет,    15, ДокументРезультат.ВысотаТаблицы, 15).Объединить(); // Примечание
		ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет,     4, ДокументРезультат.ВысотаТаблицы, 4).ГраницаСнизу  = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Пунктир, 2);
		ДокументРезультат.Область(ДокументРезультат.ВысотаТаблицы, 4, ДокументРезультат.ВысотаТаблицы, 13).ГраницаСнизу = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Пунктир, 2);
		ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет,    14, ДокументРезультат.ВысотаТаблицы, 14).ГраницаСнизу = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Пунктир, 2);
		
	КонецЦикла;
	
	ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет,  4, ДокументРезультат.ВысотаТаблицы,  4).ГраницаСнизу = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
	ДокументРезультат.Область(НачальнаяСтрокаОбластиПакет, 14, ДокументРезультат.ВысотаТаблицы, 14).ГраницаСнизу = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
	
	ДокументРезультат.Область(НачальнаяСтрокаОбласти, 1, ДокументРезультат.ВысотаТаблицы, 1).Объединить();
	ДокументРезультат.Область(НачальнаяСтрокаОбласти, 2, ДокументРезультат.ВысотаТаблицы, 2).Объединить();
	ДокументРезультат.Область(НачальнаяСтрокаОбласти, 3, ДокументРезультат.ВысотаТаблицы, 3).Объединить();
	
	ДокументРезультат.Область(НачальнаяСтрокаОбласти, 1, ДокументРезультат.ВысотаТаблицы, 2).ГраницаСнизу = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
	ДокументРезультат.Область(ДокументРезультат.ВысотаТаблицы, 1, ДокументРезультат.ВысотаТаблицы, 14).ГраницаСнизу = Новый Линия(ТипЛинииРисункаТабличногоДокумента.Сплошная, 1);
	
КонецПроцедуры

Функция Раздел_SR_INFO_ЕстьВФайлахПакета(ФайлыОтчетовТочкиВхода)
	
	ФлагSR_INFO = Ложь;
	Для Каждого СтрокаФайловXE Из ФайлыОтчетовТочкиВхода Цикл
		
		Если СтрНайти(СтрокаФайловXE.ДанныеXML, "SR_INFO") > 0 И Не СтрНачинаетсяС(ВРег(СтрокаФайловXE.ИмяФайла), "SR_INFO") Тогда
			
			ФлагSR_INFO = Истина;
			Прервать;
			
		КонецЕсли;	
		
	КонецЦикла;
	Возврат ФлагSR_INFO;
	
КонецФункции

Функция ВывестиСтрокуОтчета(ДатаТочка, СтрокаОтчета, СтрокаФайлов = Неопределено, СтрокаID_Пакетов, Макет, ДокументРезультат, ОтчетыСЗаполненнымОтветственным = Неопределено)
	
	Если ОтчетыСЗаполненнымОтветственным = Неопределено Тогда
		
		ОтчетыСЗаполненнымОтветственным = Новый Соответствие;
		
	КонецЕсли;	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка" + ?(СтрокаФайлов = Неопределено, "К", ""));
	ОбластьСтрока.Параметры.Заполнить(ДатаТочка);
	ОбластьСтрока.Параметры.Заполнить(СтрокаОтчета);
	Если СтрокаФайлов <> Неопределено Тогда
		
		ОбластьСтрока.Параметры.ИмяФайла            = СтрокаФайлов.ИмяФайла;
		ОбластьСтрока.Параметры.Примечание          = СтрокаФайлов.Примечание;
		ОбластьСтрока.Параметры.ДатаЗагрузки        = СтрокаФайлов.ДатаЗагрузки;
		ОбластьСтрока.Параметры.ПараметрыСкачивания = СтрокаФайлов.ПараметрыСкачивания;
		Если ВРег(СтрокаФайлов.КонтрольНулевого) = ВРег("Установлен") Тогда
			
			ОбластьСтрока.Область("КонтрольНулевого").Картинка = БиблиотекаКартинок.ПроверкаУспешна;
			
		Иначе	
			
			ОбластьСтрока.Параметры.КонтрольНулевого = СтрокаФайлов.КонтрольНулевого;
			Если ЗначениеЗаполнено(СтрокаФайлов.КонтрольНулевого) Тогда
				
				ОбластьСтрока.Область("ИмяОтчета").ЦветТекста = Новый Цвет(255, 0, 0);	
				
			КонецЕсли;	
			
		КонецЕсли;	
		Если СтрокаФайлов.КонтрольОтветственного Тогда
			
			ОбластьСтрока.Область("КонтрольОтветственного").Картинка = БиблиотекаКартинок.ПроверкаУспешна;
			
		ИначеЕсли СтрНайти("SR_INFO, SR_SVED, ORDER, ОКУД0420508, ОКУД0420509, БФО", СтрокаОтчета.ИмяПакета) = 0 Тогда
			
			// Здесь идет проверка для отчетов, которые выгружаются из нескольких источников (БУХ, УФО) Например, 402, 404, 501...
			// Если ответственный заполнен в отчете выгруженном из одного источника, тогда не нужно 
			// сигнализировать об отсутствии заполнении ответственного в отчетах выгруженных из остальных источников
			ТребуетсяКонтрольОтветственного = ОтчетыСЗаполненнымОтветственным.Получить(СтрШаблон("%1#%2#%3", 
				СтрокаФайлов.ИдентификаторОтчета, СтрокаОтчета.ИмяПакета, СтрокаОтчета.СубъектАналитики)) = Неопределено
				И Не (СтрНайти(СтрокаОтчета.ИмяПакета, "04205") > 0 И ВРег(СтрокаФайлов.КонтрольНулевого) = ВРег("Установлен"))
				И Не ОтчетыБезРазделаСОтветственными().Найти(СтрокаОтчета.ИмяПакета) <> Неопределено;			
				
			Если ТребуетсяКонтрольОтветственного Тогда
					
				ОбластьСтрока.Параметры.КонтрольОтветственного = "Не заполнен";
				ОбластьСтрока.Область("ИмяОтчета").ЦветТекста = Новый Цвет(255, 0, 0);	
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;	
	ОбластьСтрока.Параметры.Заполнить(СтрокаID_Пакетов);
    ОбластьСтрока.Параметры.Контроль = (СтрокаФайлов <> Неопределено);
	
	Возврат ДокументРезультат.Вывести(ОбластьСтрока);
		
КонецФункции

// В некоторых отчетах встречаются периоды из другого отчетного периода. Например, в 0420011 за июнь могут быть остатки и на 30.06 и на 31.05
// Если не фильтровать отчеты по имени файла, примечанию, тогда к отчету за май, например, может подтянуться файл с отчетом за июнь
Функция ПроверитьПоПериоду(СтрокаОтчета, СтрокаФайловXE)
	
	Результат = Истина;
	
	Месяц = ВРег(Формат(СтрокаОтчета.ОтчетнаяДата, "ДФ=MMММ"));

	Если ЕстьМесяцВСтроке(СтрокаФайловXE.ИмяФайла + СтрокаФайловXE.Примечание) И СтрНайти(ВРег(СтрокаФайловXE.ИмяФайла + СтрокаФайловXE.Примечание), Месяц) = 0 Тогда
		Результат = Ложь;
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции	

Функция ЕстьМесяцВСтроке(ПроверяемаяСтрока)
	
	Результат = Ложь;
	
	ПроверяемаяСтрокаВРег = ВРег(ПроверяемаяСтрока);
	
	ТекДата = Дата(2024, 1, 1);
	Пока ТекДата < Дата(2025, 1, 1) Цикл
		Если СтрНайти(ПроверяемаяСтрокаВРег, ВРег(Формат(ТекДата, "ДФ=MMММ"))) > 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;	
		ТекДата = ДобавитьМесяц(ТекДата, 1);
	КонецЦикла;	
	
	Возврат Результат;	
	
КонецФункции

Функция ВложенияПриказовИДоверенностей(ВложенияПакетов)
	
	Вложения = ВложенияПакетов.Скопировать(, "File_Path, Instance_ID");
	Вложения.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(100)));
	
	Для Каждого СтрокаВложений Из Вложения Цикл
		СтрокаВложений.Имя = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(СтрокаВложений.File_Path).Имя;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаВложений", Вложения);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таб.Instance_ID КАК ИдентификаторОтчета,
		|	Таб.File_Path КАК ИмяФайла,
		|	Таб.Имя КАК Имя
		|ПОМЕСТИТЬ _Вложения
		|ИЗ
		|	&ТаблицаВложений КАК Таб
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""ORDER"" КАК КонтрольныйФайл
		|ПОМЕСТИТЬ _КонтрольныеФайлы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ORDER_dov""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.ИдентификаторОтчета КАК ИдентификаторОтчета,
		|	_КонтрольныеФайлы.КонтрольныйФайл КАК КонтрольныйФайл
		|ПОМЕСТИТЬ ТаблицаКонтроля
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_Вложения.ИдентификаторОтчета КАК ИдентификаторОтчета
		|	ИЗ
		|		_Вложения КАК _Вложения) КАК ВложенныйЗапрос,
		|	_КонтрольныеФайлы КАК _КонтрольныеФайлы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаКонтроля.ИдентификаторОтчета КАК ИдентификаторОтчета,
		|	ТаблицаКонтроля.КонтрольныйФайл КАК ИмяПакета,
		|	МАКСИМУМ(_Вложения.ИдентификаторОтчета ЕСТЬ НЕ NULL ) КАК Контроль,
		|	МАКСИМУМ(_Вложения.Имя) КАК ИмяФайла
		|ПОМЕСТИТЬ _Предварительная
		|ИЗ
		|	ТаблицаКонтроля КАК ТаблицаКонтроля
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Вложения КАК _Вложения
		|		ПО ТаблицаКонтроля.ИдентификаторОтчета = _Вложения.ИдентификаторОтчета
		|			И (ВЫБОР
		|				КОГДА ТаблицаКонтроля.КонтрольныйФайл = ""ORDER""
		|					ТОГДА _Вложения.ИмяФайла ПОДОБНО ""%\ORDER_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].pdf""
		|				ИНАЧЕ _Вложения.ИмяФайла ПОДОБНО ""%\ORDER_dov_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].pdf""
		|			КОНЕЦ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаКонтроля.ИдентификаторОтчета,
		|	ТаблицаКонтроля.КонтрольныйФайл,
		|	_Вложения.Имя
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Предварительная.ИдентификаторОтчета КАК ИдентификаторОтчета,
		|	_Предварительная.ИмяПакета КАК ИмяПакета,
		|	_Предварительная.ИмяФайла КАК ИмяФайла
		|ИЗ
		|	_Предварительная КАК _Предварительная
		|ГДЕ
		|	_Предварительная.Контроль";
	
	Возврат  Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция ПодготовитьРазделыXBRL(ОтчетностьЦБ, ВерсииТаксономии)
	
	ТипыБулевоИNull = Новый Массив;
	ТипыБулевоИNull.Добавить(Тип("Null"));
	ТипыБулевоИNull.Добавить(Тип("Булево"));
	
	РазделыXBRLНаКонецПериода = Новый ТаблицаЗначений;
	РазделыXBRLНаКонецПериода.Колонки.Добавить("ИмяПакета", 	   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	РазделыXBRLНаКонецПериода.Колонки.Добавить("ВерсияТаксономии", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	РазделыXBRLНаКонецПериода.Колонки.Добавить("МалоеПредприятие", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	РазделыXBRLНаКонецПериода.Колонки.Добавить("КонецПериода", 	   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	РазделыXBRLНаКонецПериода.Колонки.Добавить("ИсточникДанных",   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	РазделыXBRLНаКонецПериода.Колонки.Добавить("РазделыXBRL", 	   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	
	ВремРазделыXBRL = ОтчетностьЦБ.ПолучитьТаблицуИзМакета("РазделыXBRL", , , , , Ложь);
	ВремРазделыXBRL.Сортировать("ИмяПакета,ТаксономияС,ТаксономияПо,МалоеПредприятие,КонецПериода,ИсточникДанных");
	
	Для Каждого СтрокаРазделыXBRL Из ВремРазделыXBRL Цикл
		Для Каждого ВерсияТаксономии Из ВерсииТаксономии Цикл
			
			Если ЗначениеЗаполнено(СтрокаРазделыXBRL.ТаксономияС) И ВерсияТаксономии < СтрокаРазделыXBRL.ТаксономияС Тогда
				Продолжить;
			ИначеЕсли ЗначениеЗаполнено(СтрокаРазделыXBRL.ТаксономияПо) И ВерсияТаксономии > СтрокаРазделыXBRL.ТаксономияПо Тогда
				Продолжить;
			КонецЕсли;
			
			КонцыПериодов = СтрРазделить(СтрокаРазделыXBRL.КонецПериода, ",", Ложь);
			Если КонцыПериодов.Количество() = 0 Тогда
				
				КонцыПериодов = СтрРазделить("Месяц,Квартал,Год,Годовая", ",", Ложь);
				
			КонецЕсли;	
			
			Для Каждого КонецПериода Из КонцыПериодов Цикл
				
				ПараметрыПоиска = Новый Структура("ИмяПакета, ВерсияТаксономии, МалоеПредприятие, КонецПериода, ИсточникДанных", 
					СтрокаРазделыXBRL.ИмяПакета, ВерсияТаксономии, ВРЕГ(СтрокаРазделыXBRL.МалоеПредприятие), 
					КонецПериода, СтрокаРазделыXBRL.ИсточникДанных);
				НайденныеСтроки = РазделыXBRLНаКонецПериода.НайтиСтроки(ПараметрыПоиска);
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					НайденныеСтроки[0].РазделыXBRL = НайденныеСтроки[0].РазделыXBRL + "," + СтрокаРазделыXBRL.ИмяРаздела;
					
				Иначе	
					
					НоваяСтрокаРазделыXBRL = РазделыXBRLНаКонецПериода.Добавить();
					НоваяСтрокаРазделыXBRL.ВерсияТаксономии = ВерсияТаксономии;
					НоваяСтрокаРазделыXBRL.МалоеПредприятие = ВРЕГ(СтрокаРазделыXBRL.МалоеПредприятие);
					НоваяСтрокаРазделыXBRL.КонецПериода     = КонецПериода;
					НоваяСтрокаРазделыXBRL.РазделыXBRL      = СтрокаРазделыXBRL.ИмяРаздела;
					ЗаполнитьЗначенияСвойств(НоваяСтрокаРазделыXBRL, СтрокаРазделыXBRL, , "МалоеПредприятие, КонецПериода");
					
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаРазделыXBRL Из РазделыXBRLНаКонецПериода Цикл
		СтрокаРазделыXBRL.РазделыXBRL = СтрокаРазделыXBRL.РазделыXBRL + ?(ЗначениеЗаполнено(СтрокаРазделыXBRL.РазделыXBRL), ",", "") + "OKUD" + СтрЗаменить(СтрокаРазделыXBRL.ИмяПакета, "ОКУД", "") + "Member";
		// Понадобилось выгрузить нулевой 401-й отчет и чек-лист не видит его. Добавляем к списку разделов раздел с ответственными, но с этим нужно быть аккуратнее, т.к. могут подтянуться ненужные файлы
		Если СтрНачинаетсяС(СтрокаРазделыXBRL.ИмяПакета, "ОКУД0420401") И ПустаяСтрока(СтрокаРазделыXBRL.ИсточникДанных) Тогда
			СтрокаРазделыXBRL.РазделыXBRL = СтрокаРазделыXBRL.РазделыXBRL + "," + "SR_Sved_ObOtchOrg_OtvLicza";
		КонецЕсли;	
	КонецЦикла;
	
	Возврат РазделыXBRLНаКонецПериода;
	
КонецФункции

Процедура ЗаполнитьУсловияОтбора(ОтчетностьЦБ, ТаблицаОтчеты, Отказ)
	
	ТаблицаОтчеты.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	МассивЗначей = ТаблицаОтчеты.ВыгрузитьКолонку("ЗначениеОсиДляОтбора"); 
	ТаблицаОтчеты.Колонки.Удалить("ЗначениеОсиДляОтбора");
	ТаблицаОтчеты.Колонки.Добавить("ЗначениеОсиДляОтбора");
	ТаблицаОтчеты.ЗагрузитьКолонку(МассивЗначей, "ЗначениеОсиДляОтбора");
	
	ВерсииТаксономии = Новый Массив;
	Для Каждого СтрокаОтчета Из ТаблицаОтчеты Цикл
		СтрокаОтчета.Идентификатор = Новый УникальныйИдентификатор;
		Если ВерсииТаксономии.Найти(СтрокаОтчета.ВерсияТаксономии) = Неопределено Тогда
			ВерсииТаксономии.Добавить(СтрокаОтчета.ВерсияТаксономии);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ВерсияТаксономии Из ВерсииТаксономии Цикл
		ТаблицаОсей = ТаблицаОтчеты.Скопировать(Новый Структура("ВерсияТаксономии", ВерсияТаксономии), "Идентификатор,ЗначениеОсиДляОтбора");
		Если ТаблицаОсей.Количество() > 0 Тогда
			ОтчетностьЦБ.ВерсияТаксономии = ВерсияТаксономии;
			МассивЗначенийОсей = ОтчетностьЦБ.ПолучитьМассивЗначенийОсей(ТаблицаОсей, "ЗначениеОсиДляОтбора", Ложь, Отказ);	
			ТаблицаОсей.ЗагрузитьКолонку(МассивЗначенийОсей, "ЗначениеОсиДляОтбора");
			Для Каждого СтрокаОсей Из ТаблицаОсей Цикл
				ТаблицаОтчеты.Найти(СтрокаОсей.Идентификатор, "Идентификатор").ЗначениеОсиДляОтбора = СтрокаОсей.ЗначениеОсиДляОтбора;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаОтчеты.Колонки.Удалить("Идентификатор");
	ТаблицаОтчеты.Колонки.Добавить("УсловиеОтбора", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрокаОтчета Из ТаблицаОтчеты Цикл
		Если ЗначениеЗаполнено(СтрокаОтчета.ЗначениеОсиДляОтбора) Тогда
			Если СтрокаОтчета.ИмяПакета = "ОКУД0420502" Тогда
				СтрокаОтчета.УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420502_R1/sr_0420502_R1_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
			ИначеЕсли СтрокаОтчета.ИмяПакета = "ОКУД0420503" Тогда
				СтрокаОтчета.УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420503_R1/sr_0420503_R1_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
			ИначеЕсли СтрокаОтчета.ИмяПакета = "ОКУД0420504" Тогда
				УсловиеОтбора1 = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420504_r4_2/sr_0420504_r4_2_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
				// Т.к. у нас 504-й отчет может быть прикреплен сразу в XBRL, то нужно было как-то проверить, что это именно он возвращается из XE. Но всё оказалось проще потому что..
				// 504-й отчет в точке входа один и для точки входа из XE не должен подтянуться какой-то другой отчет, где тоже есть показатель RegNomPravilDoverUpravFondom
				// Поэтому проверка, что в прикрепленном файле находится именно он оказалась не нужна. Просто делаем отбор по номеру правил ПИФ-а, чтобы отобрать 504-й отчет нужного ПИФ-а
				УсловиеОтбора2 = СтрШаблон("Convert(XML, [File_Data]).value('declare namespace uk-dic=""http://www.cbr.ru/xbrl/nso/uk/dic""; (//uk-dic:RegNomPravilDoverUpravFondom)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
				СтрокаОтчета.УсловиеОтбора = СтрШаблон("%1 OR %2", УсловиеОтбора1, УсловиеОтбора2) ;
			ИначеЕсли СтрокаОтчета.ИмяПакета = "ОКУД0420505" Тогда
				СтрокаОтчета.УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420505_R1/sr_0420505_R1_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
			ИначеЕсли СтрокаОтчета.ИмяПакета = "ОКУД0420506" Тогда
				СтрокаОтчета.УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420506/sr_0420506_Item/ID_fondaTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
			ИначеЕсли СтрокаОтчета.ИмяПакета = "ОКУД0420507" Тогда
				СтрокаОтчета.УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420507/sr_0420507_Item/ID_fondaTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаОтчета.ЗначениеОсиДляОтбора);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ВедетсяУчетДолжностныхЛиц(Организация)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",		 ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДолжностныеЛицаОрганизаций.Период КАК Период
		|ИЗ
		|	РегистрСведений.ДолжностныеЛицаОрганизаций КАК ДолжностныеЛицаОрганизаций
		|ГДЕ
		|	ДолжностныеЛицаОрганизаций.Организация = &Организация
		|	И ДолжностныеЛицаОрганизаций.Период <= &Период";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции