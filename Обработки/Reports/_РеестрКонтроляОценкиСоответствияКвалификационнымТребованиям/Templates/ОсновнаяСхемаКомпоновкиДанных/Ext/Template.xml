				<condition>true</condition>
			</useRestriction>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериодДолжность</dataPath>
			<field>ПериодДолжность</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период должность</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<condition>true</condition>
			</useRestriction>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВнутреннийДокумент.Ссылка КАК Ссылка,
	ВнутреннийДокумент.ДатаОценки КАК ДатаОценки,
	ВнутреннийДокумент.Заместитель КАК Заместитель,
	Сотрудники.ЮрФизЛицо КАК ЮрФизЛицоЗаместитель
ПОМЕСТИТЬ _Документы
ИЗ
	Документ.ВнутреннийДокумент КАК ВнутреннийДокумент
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		ПО ВнутреннийДокумент.Заместитель = Сотрудники.Ссылка
ГДЕ
	ВнутреннийДокумент.ДатаОценки МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
	И ВнутреннийДокумент.Проведен
	И ВнутреннийДокумент.Организация = &amp;Организация
	И ВнутреннийДокумент.ВидВнутреннегоДокумента = ЗНАЧЕНИЕ(Справочник.ВидыВнутреннихДокументов.Приказ)
	И ВнутреннийДокумент.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийВнутреннихДокументов.НазначениеИсполняющегоОбязанности)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	_Документы.Ссылка КАК Ссылка,
	_Документы.Заместитель КАК Заместитель,
	РеквизитыСотрудниковОрганизации.Фамилия + " " + РеквизитыСотрудниковОрганизации.Имя + " " + РеквизитыСотрудниковОрганизации.Отчество КАК ФИО,
	СотрудникиОрганизации.Должность КАК Должность,
	_Документы.ДатаОценки КАК ДатаОценки,
	"Соответствует" КАК РезультатОценки,
	"" КАК Примечание
ИЗ
	_Документы КАК _Документы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			_Документы.Ссылка КАК Ссылка,
			МАКСИМУМ(СотрудникиОрганизации.Период) КАК ПериодДолжность,
			МАКСИМУМ(РеквизитыСотрудниковОрганизации.Период) КАК ПериодРеквизиты
		ИЗ
			_Документы КАК _Документы
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
				ПО (СотрудникиОрганизации.Организация = &amp;Организация)
					И _Документы.Заместитель = СотрудникиОрганизации.Сотрудник
					И _Документы.ДатаОценки &gt;= СотрудникиОрганизации.Период
				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизации
				ПО (РеквизитыСотрудниковОрганизации.Организация = &amp;Организация)
					И _Документы.ЮрФизЛицоЗаместитель = РеквизитыСотрудниковОрганизации.ЮрФизЛицо
					И (РеквизитыСотрудниковОрганизации.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		
		СГРУППИРОВАТЬ ПО
			_Документы.Ссылка) КАК ВложенныйЗапрос
		ПО _Документы.Ссылка = ВложенныйЗапрос.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		ПО (ВложенныйЗапрос.ПериодДолжность = СотрудникиОрганизации.Период)
			И (СотрудникиОрганизации.Организация = &amp;Организация)
			И _Документы.Заместитель = СотрудникиОрганизации.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации КАК РеквизитыСотрудниковОрганизации
		ПО (ВложенныйЗапрос.ПериодРеквизиты = РеквизитыСотрудниковОрганизации.Период)
			И (РеквизитыСотрудниковОрганизации.Организация = &amp;Организация)
			И _Документы.ЮрФизЛицоЗаместитель = РеквизитыСотрудниковОрганизации.ЮрФизЛицо
			И (РеквизитыСотрудниковОрганизации.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))</query>
	</dataSet>
