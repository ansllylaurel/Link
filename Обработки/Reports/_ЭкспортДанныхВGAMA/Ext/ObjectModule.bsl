Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
	
	Если Не (СтрНачинаетсяС(ИмяПредопределенногоВарианта, "СКДСделки")
		Или СтрНачинаетсяС(ИмяПредопределенногоВарианта, "СКДДвиженияДС")
		Или ИмяПредопределенногоВарианта = "СКДНезакрытыеСделкиРЕПО")
	Тогда
		ТекущийВариант = СхемаКомпоновкиДанных.ВариантыНастроек.Найти(ИмяПредопределенногоВарианта);
		
		Если ТекущийВариант <> Неопределено Тогда
			КомпоновщикНастроек.ЗагрузитьНастройки(ТекущийВариант.Настройки);
		КонецЕсли;
		
		РаботаСОтчетами.КонтрольМультивалютностиРасходовПоСделкам(ЭтотОбъект.СчетДоверительногоУправления, Неопределено, ЭтотОбъект.Период.ДатаОкончания);
		
		Настройки = КомпоновщикНастроек.Настройки;
		Параметры = Настройки.ПараметрыДанных;
		
		Параметры.УстановитьЗначениеПараметра("Период",							Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
		Параметры.УстановитьЗначениеПараметра("Дата",							ЭтотОбъект.Период.ДатаОкончания);
		Параметры.УстановитьЗначениеПараметра("ПериодСтрока",					Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		Параметры.УстановитьЗначениеПараметра("Организация",					ЭтотОбъект.Организация);
		Параметры.УстановитьЗначениеПараметра("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
		Параметры.УстановитьЗначениеПараметра("НомерДоговора",					ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора);
	Иначе
		// Фиксируем запуск процедуры
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
			ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления", Новый Структура("ИмяПредопределенногоВарианта", ИмяПредопределенногоВарианта));
		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
		
		ЭтоСделки = СтрНачинаетсяС(ИмяПредопределенногоВарианта, "СКДСделки") Или ИмяПредопределенногоВарианта = "СКДНезакрытыеСделкиРЕПО";
		
		ИмяМакета = СтрЗаменить(ИмяПредопределенногоВарианта, "СКД", "Макет");
		ИмяМакета = СтрЗаменить(ИмяМакета, "Эволюция", ""); // для Эволюции используется общий макет
		
		Если ИмяПредопределенногоВарианта = "СКДНезакрытыеСделкиРЕПО" Тогда
			ИмяМакета = "МакетСделки";
		КонецЕсли;
		
		Макет = ПолучитьМакет(ИмяМакета);
		
		Шапка				= Макет.ПолучитьОбласть("Шапка");
		ГруппаОднаЦБ		= Макет.ПолучитьОбласть("ГруппаОднаЦБ");
		ГруппаНесколькоЦБ	= Макет.ПолучитьОбласть("ГруппаНесколькоЦБ");
		ДетальныеЗаписи		= Макет.ПолучитьОбласть("ДетальныеЗаписи");
		
		ТаблицаРезультат = ПолучитьТаблицуЗначений(ЭтоСделки);
		
		ДокументРезультат.Вывести(Шапка);
		ПоследняяСтрока = ТаблицаРезультат.Количество() - 1;
		
		ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
		
		Для ИндексСтроки = 0 По ПоследняяСтрока Цикл
			ТекСтрока = ТаблицаРезультат[ИндексСтроки];
			
			Если ИндексСтроки < ПоследняяСтрока И ИмяПредопределенногоВарианта <> "СКДДвиженияДСИОстаткиРПИ" Тогда
				СледСтрока = ТаблицаРезультат[ИндексСтроки + 1];
				ЭтоПередача = Лев(ТекСтрока.Операция, 8) = "Передача";
				
				Если (ЭтоСделки Или ТекСтрока.НомерСтроки = СледСтрока.НомерСтроки)
					И Не ЭтоПередача
					И ТекСтрока.Регистратор = СледСтрока.Регистратор
					И (Не ЭтоСделки Или ТекСтрока.ЧастьСделкиРЕПО = СледСтрока.ЧастьСделкиРЕПО)
				Тогда
					ОбластьНесколькоЦБ = ГруппаНесколькоЦБ;
					ЗаполнитьЗначенияСвойств(ОбластьНесколькоЦБ.Параметры, ТекСтрока);
					
					ЗаполнитьИДСделки(ОбластьНесколькоЦБ, ТекСтрока, ЭтоСделки);
					ЗаполнитьСхемуПлатежей(ОбластьНесколькоЦБ, ТекСтрока, ЭтоСделки);
					
					ДокументРезультат.Вывести(ОбластьНесколькоЦБ);
					ДокументРезультат.НачатьГруппуСтрок();
					Область = ДетальныеЗаписи;
					ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
					ДокументРезультат.Вывести(Область);
					
					Пока Истина Цикл
						ИндексСтроки = ИндексСтроки + 1;
						ТекСтрока = ТаблицаРезультат[ИндексСтроки];
						Область = ДетальныеЗаписи;
						ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
						ДокументРезультат.Вывести(Область);
						Если ИндексСтроки < ПоследняяСтрока Тогда
							СледСтрока = ТаблицаРезультат[ИндексСтроки + 1];
							Если Не ((ЭтоСделки Или ТекСтрока.НомерСтроки = СледСтрока.НомерСтроки) И ТекСтрока.Регистратор = СледСтрока.Регистратор) Тогда
								Прервать;
							КонецЕсли;
						Иначе
							Прервать;
						КонецЕсли;
					КонецЦикла;
					ДокументРезультат.ЗакончитьГруппуСтрок();
				Иначе
					Область = ГруппаОднаЦБ;
					ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
					ЗаполнитьИДСделки(Область, ТекСтрока, ЭтоСделки); 
					ЗаполнитьСхемуПлатежей(Область, ТекСтрока, ЭтоСделки);
					ДокументРезультат.Вывести(Область);
				КонецЕсли;
			Иначе
				Область = ГруппаОднаЦБ;
				ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
				ЗаполнитьИДСделки(Область, ТекСтрока, ЭтоСделки);
				ЗаполнитьСхемуПлатежей(Область, ТекСтрока, ЭтоСделки);
				ДокументРезультат.Вывести(Область);
			КонецЕсли;
		КонецЦикла;
		
		// Заполнение настроек печати
		РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
		
		// Фиксация завершения процедуры
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
	
	// Добавление дополнительных временных таблиц перед выполнением компоновки СКД
	ДополнительныеПараметры = Новый Структура("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(
		ДополнительныеПараметры.МенеджерВременныхТаблиц,, ЭтотОбъект.Период.ДатаОкончания);
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(
		ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка,,,,, ДополнительныеПараметры);
КонецПроцедуры // ПриКомпоновкеРезультата

Функция СформироватьОтчет(МассивСчетовДоверительногоУправления, Выгрузить, КаталогВыгрузки) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	
	Для Каждого ТекСчетДоверительногоУправления Из МассивСчетовДоверительногоУправления Цикл
		
		Если Не ЗначениеЗаполнено(ТекСчетДоверительногоУправления) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекРезультат = Новый ТабличныйДокумент;
		ЭтотОбъект.СчетДоверительногоУправления = ТекСчетДоверительногоУправления;
		
		ПриКомпоновкеРезультата(ТекРезультат, Неопределено, Ложь);
		
		Если Выгрузить Тогда  			
			ИмяФайла = КаталогВыгрузки + "\" + ПолучитьИмяФайла(ТекСчетДоверительногоУправления);
			Попытка
				ТекРезультат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		Результат.Вывести(ТекРезультат);
		
		Результат.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИмяФайла(ТекСчетДоверительногоУправления)
	
	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
	
	Если СтрНачинаетсяС(ИмяПредопределенногоВарианта, "СКДСделки") Тогда
		ТекОтчет = ОбщегоНазначения.ПолучитьИменованныйОбъект("_Отчет_ЭскпортВGAMA_ПереченьСделок");
	ИначеЕсли СтрНачинаетсяС(ИмяПредопределенногоВарианта, "СКДДвиженияДС") Тогда
		ТекОтчет = ОбщегоНазначения.ПолучитьИменованныйОбъект("_Отчет_ЭскпортВGAMA_ДвиженияДС");
	Иначе
		ТекОтчет = ОбщегоНазначения.ПолучитьИменованныйОбъект("_Отчет_ЭскпортВGAMA_Остатки");
	КонецЕсли;
	
	НастройкиОтчета = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьНастройкиОтчета(ЭтотОбъект.Период.ДатаОкончания, ТекСчетДоверительногоУправления, ТекОтчет);
		
	Если ЗначениеЗаполнено(НастройкиОтчета.ПутьКФайлу) Тогда
		
		ДанныеОтчета = Новый Структура;
		
		ДанныеОтчета.Вставить("Субъект",		ТекСчетДоверительногоУправления);
		ДанныеОтчета.Вставить("Отчет",			ТекОтчет);
		ДанныеОтчета.Вставить("Периодичность",	Неопределено);
		ДанныеОтчета.Вставить("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
		ДанныеОтчета.Вставить("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
		
		ИмяФайла = РегистрыСведений.СоставИНастройкиОтчетов.ОбработатьПутьКФайлу(НастройкиОтчета.ПутьКФайлу, ДанныеОтчета);
		ИмяФайла = Сред(ИмяФайла, СтрНайти(ИмяФайла, "\", НаправлениеПоиска.СКонца) + 1);
		
	Иначе
	
		ИмяФайла = "Выгрузка в GAMMA ";
			
		ИмяФайла = ИмяФайла + СокрЛП(ТекСчетДоверительногоУправления);
			
		ИмяФайла = ИмяФайла + " c " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ".xlsx";	
	
	КонецЕсли;

	Возврат ИмяФайла;
	
КонецФункции
