			|		КОГДА _ИтоговаяТаблица.Операция = ""Прочие""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБанковскойКомиссии)
			|			ТОГДА ""Оплата комиссии банка""
			|		КОГДА _ИтоговаяТаблица.Операция = ""Прочие""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
			|			ТОГДА ""Оплата комиссии биржи""
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК КлассификацияДоходовРасходов,
			|	_ИтоговаяТаблица.НомерСтроки КАК НомерСтроки,
			|	_ИтоговаяТаблица.Сделка КАК Сделка,
			|	_ИтоговаяТаблица.КПП КАК КППКонтрагента,
			|	ВЫБОР
			|		КОГДА _ИтоговаяТаблица.Операция = ""Депозит""
			|			ТОГДА _ИтоговаяТаблица.ДепозитныйДоговор
			|	КОНЕЦ КАК ДепозитныйДоговор,
			|	ВЫБОР
			|		КОГДА _ИтоговаяТаблица.Операция = ""Депозит""
			|			ТОГДА _ИтоговаяТаблица.БанкДепозита
			|	КОНЕЦ КАК БанкДепозита,
			|	ВЫБОР
			|		КОГДА _ИтоговаяТаблица.Операция = ""Депозит""
			|			ТОГДА _ИтоговаяТаблица.ДатаРегистрацииДепозита
			|	КОНЕЦ КАК ДатаРегистрацииДепозита,
			|	ВЫБОР
			|		КОГДА _ИтоговаяТаблица.Операция = ""Депозит""
			|			ТОГДА _ИтоговаяТаблица.ПроцентПоДепозиту
			|	КОНЕЦ КАК ПроцентПоДепозиту
			|ИЗ
			|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВТоргСистемах КАК _КодыISIN
			|		ПО _ИтоговаяТаблица.ДатаОперации = _КодыISIN.Период
			|			И _ИтоговаяТаблица.ЦеннаяБумага = _КодыISIN.ЦеннаяБумага
			|			И (_КодыISIN.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN))
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВТоргСистемах КАК _КодыКонтрактов
			|		ПО _ИтоговаяТаблица.ДатаОперации = _КодыКонтрактов.Период
			|			И _ИтоговаяТаблица.ЦеннаяБумага = _КодыКонтрактов.ЦеннаяБумага
			|			И (_КодыКонтрактов.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
			|		ПО _ИтоговаяТаблица.Регистратор = ЗадолженностиПоДенежнымСредствам.Регистратор
			|			И _ИтоговаяТаблица.Сделка = ЗадолженностиПоДенежнымСредствам.Основание
			|			И (ЗадолженностиПоДенежнымСредствам.Регистратор ССЫЛКА Документ.Оплата)
			|			И (_ИтоговаяТаблица.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата))
			|			И (_ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МНО КАК ДокМНО
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
			|			ПО ДокМНО.Организация = НомераОбъектов.Организация
			|				И ДокМНО.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
			|				И ДокМНО.Основание = НомераОбъектов.Объект
			|				И (ГОД(ДокМНО.Дата) = НомераОбъектов.Год)
			|				И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
			|		ПО (_ИтоговаяТаблица.Операция = ""Сделка МНО"")
			|			И (ВЫРАЗИТЬ(_ИтоговаяТаблица.Регистратор КАК Документ.ПриходПроцентовМНО).МНО = ДокМНО.Ссылка)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаОперации,
			|	Регистратор,
			|	НомерСтроки";
		#КонецОбласти
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ЕстьОборотыИлиОстаткиПоВалютеНаВнебиржеПоБрокеруБК(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
       |	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
       |	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
       |	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаОборот
       |ИЗ
       |	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
       |			&НачалоПериода,
       |			&КонецПериода,
       |			Период,
       |			,
       |			Организация = &Организация
       |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
       |				И Брокер = &БрокерБК
       |				И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
       |				И Организация.ВалютаУчета <> Валюта) КАК ОстаткиДенежныхСредствОстаткиИОбороты";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ЗаполнитьИДСделки(Область, ТекСтрока, ЗаполнитьНомерСвязи)

	Если НЕ ЗначениеЗаполнено(ТекСтрока.ИДСделки) И ЗначениеЗаполнено(ТекСтрока.Сделка) И 
		(ТипЗнч(ТекСтрока.Сделка) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(ТекСтрока.Сделка) = Тип("ДокументСсылка.СделкаРЕПО") Или ТипЗнч(ТекСтрока.Сделка) = Тип("ДокументСсылка.СделкаСВалютой")  ) Тогда
		
		Область.Параметры.ИДСделки = ТекСтрока.Сделка.УникальныйИдентификатор();
		
		Если ЗаполнитьНомерСвязи И ЗначениеЗаполнено(ТекСтрока.ПерваяЧастьРЕПО) Тогда
		
			Область.Параметры.НомерСвязи = ТекСтрока.Сделка.УникальныйИдентификатор();
		
		КонецЕсли; 
		
	КонецЕсли; 

КонецПроцедуры

Процедура ЗаполнитьСхемуПлатежей(Область, ТекСтрока, ЭтоСделки)

	//Если ЭтоСделки и ЗначениеЗаполнено(ТекСтрока.ДатаПеререгистрации) Тогда
	//	
	//	КоличествоДнейОтсрочки = (НачалоДня(ТекСтрока.ДатаПеререгистрации) - НачалоДня(ТекСтрока.ДатаОперации)) / 3600 / 24;
	//	Если КоличествоДнейОтсрочки = 0 Тогда
	//	
	//		Постфикс = "0";
	//		
	//	ИначеЕсли КоличествоДнейОтсрочки = 1 Тогда
	//		
	//		Постфикс = "+";
	//		
	//	Иначе
	//		
