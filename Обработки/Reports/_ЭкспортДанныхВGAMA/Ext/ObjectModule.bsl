			|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.Основание КАК Документ.НачислениеЗадолженности).Договор.НомерДоговора
			|		КОГДА _ИтоговаяТаблица.Операция = ""Прочие""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимУслугам)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.Основание КАК Документ.НачислениеЗадолженности).НомерВходящегоДокумента
			|		КОГДА _ИтоговаяТаблица.Операция = ""Перевод""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера)
			|			ТОГДА _ИтоговаяТаблица.НомерПлатежногоДокумента
			|		КОГДА _ИтоговаяТаблица.Операция = ""Перевод""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет)
			|			ТОГДА """"
			|		КОГДА _ИтоговаяТаблица.Операция = ""Фонд""
			|			ТОГДА """"
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК НомерДокументаОснования,
			|	ВЫБОР
			|		КОГДА _ИтоговаяТаблица.Операция = ""Сделка МНО""
			|				ИЛИ _ИтоговаяТаблица.Операция = ""Погашение""
			|				ИЛИ _ИтоговаяТаблица.Операция = ""Дивиденды""
			|			ТОГДА """"
			|		КОГДА _ИтоговаяТаблица.Операция = ""Проценты""
			|				ИЛИ _ИтоговаяТаблица.Операция = ""Депозит""
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.Регистратор.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.ДатаЗаключения
			|		КОГДА _ИтоговаяТаблица.Операция = ""Сделка с ЦБ""
			|				ИЛИ _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
			|			ТОГДА _ИтоговаяТаблица.ДатаОперации
			|		КОГДА _ИтоговаяТаблица.Операция = ""Прочие""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБанковскойКомиссии)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.Основание КАК Документ.НачислениеЗадолженности).РасчетныйСчет.Договор.ДатаЗаключения
			|		КОГДА _ИтоговаяТаблица.Операция = ""Депозитарий""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.Основание КАК Документ.НачислениеЗадолженности).Договор.ДатаЗаключения
			|		КОГДА _ИтоговаяТаблица.Операция = ""Прочие""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимУслугам)
			|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.Основание КАК Документ.НачислениеЗадолженности).ДатаВходящегоДокумента
			|		КОГДА _ИтоговаяТаблица.Операция = ""Перевод""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера)
			|			ТОГДА _ИтоговаяТаблица.ДатаПлатежногоДокумента
			|		КОГДА _ИтоговаяТаблица.Операция = ""Перевод""
			|				И _ИтоговаяТаблица.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет)
			|			ТОГДА """"
			|		КОГДА _ИтоговаяТаблица.Операция = ""Фонд""
			|			ТОГДА _ИтоговаяТаблица.ДатаОперации
			|		КОГДА _ИтоговаяТаблица.Операция = ""Вознаграждение""
