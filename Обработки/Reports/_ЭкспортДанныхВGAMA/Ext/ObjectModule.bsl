// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки".
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//         |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//         |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Экспорт данных в GAMA",
		"1.24",
		"",
		Истина);
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	Возврат РегистрационныеДанные;
КонецФункции

////////////////////////////////////////////////////////////////////////////////

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	РаботаСОтчетамиКлиентСервер.ЗаполнитьДополнительныеСвойстваВариантаОтчета(ЭтотОбъект, НастройкиОтчета.ВариантОтчета);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ПриКомпоновкеРезультата(ДокументРезультат, Неопределено, Ложь);
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт
	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ВариантОтчета");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("АвтоматическаяОтправка");
	Настройки.Добавить("АдресЭлектроннойПочты");
	Настройки.Добавить("АдресОтправителя");
	Возврат Настройки;
КонецФункции

Функция ПолучитьТаблицуЗначений(ЭтоСделки)
	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(Запрос.МенеджерВременныхТаблиц,, ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.УстановитьПараметр("НачалоПериода",						ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",						ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",		ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НомерДоговора",						ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора);
	Запрос.УстановитьПараметр("Организация",						ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВыводитьВидСделкиВторойЧастиРЕПО",	Истина);
	Запрос.УстановитьПараметр("КомиссиюБрокераОтноситьКСделкамСЦБ",	ИмяПредопределенногоВарианта = "СКДДвиженияДСЭволюция"
																		ИЛИ ИмяПредопределенногоВарианта = "СКДНезакрытыеСделкиРЕПО");
	Запрос.УстановитьПараметр("ДобавитьВОтчетСделкиСВалютой",		ИмяПредопределенногоВарианта = "СКДСделкиБудущее");
	Запрос.УстановитьПараметр("БрокерБК",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	Запрос.УстановитьПараметр("РазделFX",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС_раздел_FX"));
	
	Если ИмяПредопределенногоВарианта = "СКДДвиженияДСИОстаткиРПИ" Тогда
		ТекстЗапроса =
		#Область СКДДвиженияДСИОстаткиРПИ
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухПартииЦенныхБумагОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумагОбороты.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
			|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОбороты.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание
			|		ИНАЧЕ БухПартииЦенныхБумагОбороты.Партия
			|	КОНЕЦ КАК Партия,
			|	ПРЕДСТАВЛЕНИЕ(_КлассификацииЦенныхБумаг.КлассификацияЦенныхБумагЦифровая) КАК УчетныйАктивЕПС
			|ПОМЕСТИТЬ _УчетныеАктивыЕПС
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Обороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОбороты
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КлассификацииЦенныхБумаг КАК _КлассификацииЦенныхБумаг
			|		ПО БухПартииЦенныхБумагОбороты.УчетныйАктивЕПС = _КлассификацииЦенныхБумаг.УчетныйАктивЕПС
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Период КАК Период,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.НомерСтроки КАК НомерСтроки,
			|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Регистратор,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Организация КАК Организация,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.КоличествоОборот КАК КоличествоОборот,
			|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
			|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
			|	ОстаткиДенежныхСредств.МоментВремени КАК МоментВремени,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
			|				И ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
			|				И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|				И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств)
			|				ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовМНО)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств)
			|				И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств)
			|				И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.РазмещениеДенежныхСредствНаДепозитномВкладе)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовСМО)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК СуммаСделки,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК КупонныйДоход,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
			|				И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
			|			ТОГДА -1 * ЗадолженностиПоДенежнымСредствам.Сумма
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК КомиссияБрокера,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
			|				И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
			|			ТОГДА -1 * ЗадолженностиПоДенежнымСредствам.Сумма
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК КомиссияБиржи,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.ДатаПеререгистрации КАК ДатаПеререгистрации,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
			|				ИЛИ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.Период
			|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств)
			|			ТОГДА ОстаткиДенежныхСредствОстаткиИОбороты.Период
			|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
			|	КОНЕЦ КАК ДатаОплаты
			|ПОМЕСТИТЬ _ДвиженияЗаОтчетныйПериод
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиДенежныхСредствОстаткиИОбороты.Период КАК Период,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.НомерСтроки КАК НомерСтроки,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Регистратор,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.Организация КАК Организация,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК СальдоНачальное,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК СальдоКонечное,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
			|		0 КАК КоличествоОборот,
			|		ДАТАВРЕМЯ(1, 1, 1) КАК ДатаПеререгистрации,
			|		ОстаткиДенежныхСредствОстаткиИОбороты.МестоХранения КАК МестоХранения
			|	ИЗ
			|		РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
			|				&НачалоПериода,
			|				&КонецПериода,
			|				Запись,
			|				Движения,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И НЕ РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)) КАК ОстаткиДенежныхСредствОстаткиИОбороты
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ОстаткиЦенныхБумагОстаткиИОбороты.Период,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.НомерСтроки,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.Регистратор,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.Организация,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.ДепозитарныйСчет.Брокер,
			|		ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка),
			|		NULL,
			|		NULL,
			|		0,
			|		0,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоОборот,
			|		ОстаткиЦенныхБумагОстаткиИОбороты.Период,
			|		NULL
			|	ИЗ
			|		РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
			|				&НачалоПериода,
			|				&КонецПериода,
			|				Запись,
