			|	_ОперацииСЦБ.Цена КАК Цена,
			|	_ОперацииСЦБ.ВалютаСделки КАК ВалютаСделки,
			|	_ОперацииСЦБ.СуммаСделки КАК СуммаСделки,
			|	_ОперацииСЦБ.НКД КАК КупонныйДоход,
			|	_ОперацииСЦБ.КомиссияБрокера КАК КомиссияБрокера,
			|	_ОперацииСЦБ.ТорговаяКомиссия КАК КомиссияБиржи,
			|	ВЫБОР
			|		КОГДА _ОперацииСЦБ.СчетБрокера = """"
			|			ТОГДА _КодыСчетовДУ.Код
			|		ИНАЧЕ _ОперацииСЦБ.СчетБрокера
			|	КОНЕЦ КАК СчетБрокера,
			|	ВЫБОР
			|		КОГДА _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|				ИЛИ _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
			|				ИЛИ _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
			|				ИЛИ _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
			|				ИЛИ _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА _ОперацииСЦБ.ЦеннаяБумага.Эмитент
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Эмитенты.ПустаяСсылка)
			|	КОНЕЦ КАК Эмитент,
			|	ВЫБОР
			|		КОГДА _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ВЫРАЗИТЬ(_ОперацииСЦБ.ЦеннаяБумага КАК Справочник.Акции).Номинал
			|		ИНАЧЕ _НоминалыЦенныхБумаг.Номинал
			|	КОНЕЦ КАК Номинал,
			|	ВЫБОР
			|		КОГДА _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|			ТОГДА ВЫРАЗИТЬ(_ОперацииСЦБ.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
			|		КОГДА _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|			ТОГДА ВЫРАЗИТЬ(_ОперацииСЦБ.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|	КОНЕЦ КАК ВалютаНоминала,
			|	ВЫБОР
			|		КОГДА _ОперацииСЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
			|			ТОГДА _КодыММВБ.Код
			|	КОНЕЦ КАК КодКонтракта,
			|	_ОперацииСЦБ.НомерСвязи КАК НомерСвязи,
			|	_ОперацииСЦБ.ПланДатаИсполнения КАК ПланДатаИсполнения,
			|	_ОперацииСЦБ.ПерваяЧастьРЕПО КАК ПерваяЧастьРЕПО,
			|	1 КАК НомерСтроки,
			|	_ОперацииСЦБ.Регистратор КАК Регистратор,
			|	_ОперацииСЦБ.ОперацияСсылка КАК Сделка,
			|	_ОперацииСЦБ.КодРасчетовНаБирже КАК СхемаПлатежей,
			|	_ОперацииСЦБ.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
			|	_ОперацииСЦБ.ДатаИсполнения КАК ДатаПеререгистрации,
			|	ЕСТЬNULL(_УчетныеАктивыЕПС.УчетныйАктивЕПС, ""1"") КАК КлассификацияЦБОСБУ,
			|	ЕСТЬNULL(_ОперацииСЦБ.ЧастьСделкиРЕПО, 0) КАК ЧастьСделкиРЕПО,
			|	_ОперацииСЦБ.СтавкаРЕПО КАК СтавкаРЕПО
			|ИЗ
			|	_ОперацииСЦБ КАК _ОперацииСЦБ
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛиц КАК _РеквизитыОрганизаций
			|		ПО _ОперацииСЦБ.ОрганизацияЮрФизЛицо = _РеквизитыОрганизаций.ЮрФизЛицо
			|			И _ОперацииСЦБ.ДатаОперации = _РеквизитыОрганизаций.ДатаОперации
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛиц КАК _РеквизитыБирж
			|		ПО _ОперацииСЦБ.Биржа = _РеквизитыБирж.ЮрФизЛицо
			|			И _ОперацииСЦБ.ДатаОперации = _РеквизитыБирж.ДатаОперации
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВТоргСистемах КАК _КодыISIN
			|		ПО _ОперацииСЦБ.ЦеннаяБумага = _КодыISIN.ЦеннаяБумага
			|			И _ОперацииСЦБ.ДатаОперации = _КодыISIN.ДатаОперации
			|			И (_КодыISIN.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN))
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыВТоргСистемах КАК _КодыММВБ
			|		ПО _ОперацииСЦБ.ЦеннаяБумага = _КодыММВБ.ЦеннаяБумага
			|			И _ОперацииСЦБ.ДатаОперации = _КодыММВБ.ДатаОперации
			|			И (_КодыММВБ.ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ))
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыСчетовДУ КАК _КодыСчетовДУ
			|		ПО _ОперацииСЦБ.СчетДоверительногоУправления = _КодыСчетовДУ.СчетДоверительногоУправления
			|			И _ОперацииСЦБ.Брокер = _КодыСчетовДУ.Брокер
			|			И _ОперацииСЦБ.ДатаОперации = _КодыСчетовДУ.ДатаОперации
			|		ЛЕВОЕ СОЕДИНЕНИЕ _НоминалыЦенныхБумаг КАК _НоминалыЦенныхБумаг
			|		ПО _ОперацииСЦБ.ЦеннаяБумага = _НоминалыЦенныхБумаг.ЦеннаяБумага
			|			И _ОперацииСЦБ.ДатаОперации = _НоминалыЦенныхБумаг.ДатаОперации
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
			|		ПО _ОперацииСЦБ.ОперацияСсылка = ОперацииСЦеннымиБумагами.Основание
			|			И _ОперацииСЦБ.ЦеннаяБумага = ОперацииСЦеннымиБумагами.ЦеннаяБумага
			|			И (НЕ ВЫРАЗИТЬ(ОперацииСЦеннымиБумагами.Операция КАК Документ.ИсполнениеОбязательствПоСделке) ЕСТЬ NULL)
			|		ЛЕВОЕ СОЕДИНЕНИЕ _УчетныеАктивыЕПС КАК _УчетныеАктивыЕПС
			|		ПО _ОперацииСЦБ.ОперацияСсылка = _УчетныеАктивыЕПС.Партия
			|			И _ОперацииСЦБ.ЦеннаяБумага = _УчетныеАктивыЕПС.ЦеннаяБумага
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаОперации,
			|	Регистратор,
			|	НомерСтроки,
			|	ЧастьСделкиРЕПО";
		#КонецОбласти
	Иначе
		Если ЕстьОборотыИлиОстаткиПоВалютеНаВнебиржеПоБрокеруБК(Запрос) Тогда
			ВызватьИсключение "Невозможно построить отчёт. Есть валютные остатки/обороты по брокеру БК Регион на внебирже";
		КонецЕсли;
		
		ТекстЗапроса =
		#Область Остатки
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Период КАК Период,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.НомерСтроки КАК НомерСтроки,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Регистратор,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Организация КАК Организация,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	&НомерДоговора КАК НомерДоговора,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
			|	ЛОЖЬ КАК ВалютнаяСекция,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК СальдоНачальное,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПриход КАК СуммаПрихода,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаРасход КАК СуммаВыбытия,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК СальдоКонечное
			|ПОМЕСТИТЬ _ОстаткиДенежныхСредствОстаткиИОбороты
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Запись,
			|			Движения,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И НЕ РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
			|				И НЕ(МестоХранения = &РазделFX
			|						И Брокер = &БрокерБК)) КАК ОстаткиДенежныхСредствОстаткиИОбороты
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Период,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.НомерСтроки,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Организация,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления,
			|	&НомерДоговора,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Брокер,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта,
			|	ИСТИНА,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПриход,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаРасход,
			|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&КонецПериода,
			|			Запись,
			|			Движения,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И НЕ РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ДенежныеСредстваВПути)
			|				И (МестоХранения = &РазделFX
			|					И Брокер = &БрокерБК)) КАК ОстаткиДенежныхСредствОстаткиИОбороты
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Регистратор,
			|	НомерСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.Период КАК Период,
			|	МИНИМУМ(_ОстаткиДенежныхСредствОстаткиИОбороты.НомерСтроки) КАК НомерСтроки,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор КАК Регистратор,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.Организация КАК Организация,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.НомерДоговора КАК НомерДоговора,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.Валюта КАК Валюта,
			|	_ОстаткиДенежныхСредствОстаткиИОбороты.ВалютнаяСекция КАК ВалютнаяСекция,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|			ТОГДА МАКСИМУМ(_ОстаткиДенежныхСредствОстаткиИОбороты.СальдоНачальное)
			|		ИНАЧЕ МИНИМУМ(_ОстаткиДенежныхСредствОстаткиИОбороты.СальдоНачальное)
			|	КОНЕЦ КАК СальдоНачальное,
			|	СУММА(ВЫБОР
			|			КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПрихода <= 0
			|				ТОГДА 0
			|			ИНАЧЕ ВЫБОР
			|					КОГДА ЗадолженностиПоДенежнымСредствам.Регистратор ЕСТЬ NULL
			|						ТОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПрихода
			|					КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПрихода = ЗадолженностиПоДенежнымСредствам.Сумма
			|						ТОГДА ЗадолженностиПоДенежнымСредствам.Сумма
			|					КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПрихода = ЗадолженностиПоДенежнымСредствам.СуммаКупона
			|						ТОГДА ЗадолженностиПоДенежнымСредствам.СуммаКупона
			|					ИНАЧЕ ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона
			|				КОНЕЦ
			|		КОНЕЦ) КАК СуммаПрихода,
			|	СУММА(ВЫБОР
			|			КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаВыбытия <= 0
			|				ТОГДА 0
			|			ИНАЧЕ ВЫБОР
			|					КОГДА ЗадолженностиПоДенежнымСредствам.Регистратор ЕСТЬ NULL
			|						ТОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаВыбытия
			|					КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаВыбытия = ЗадолженностиПоДенежнымСредствам.Сумма
			|						ТОГДА ЗадолженностиПоДенежнымСредствам.Сумма
			|					КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.СуммаВыбытия = ЗадолженностиПоДенежнымСредствам.СуммаКупона
			|						ТОГДА ЗадолженностиПоДенежнымСредствам.СуммаКупона
			|					ИНАЧЕ ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона
			|				КОНЕЦ
			|		КОНЕЦ) КАК СуммаВыбытия,
			|	ВЫБОР
			|		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|			ТОГДА МИНИМУМ(_ОстаткиДенежныхСредствОстаткиИОбороты.СальдоКонечное)
			|		ИНАЧЕ МАКСИМУМ(_ОстаткиДенежныхСредствОстаткиИОбороты.СальдоКонечное)
			|	КОНЕЦ КАК СальдоКонечное,
			|	ВЫБОР
			|		КОГДА _ОстаткиДенежныхСредствОстаткиИОбороты.Регистратор ССЫЛКА Документ.Оплата
			|				И (ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.Сделка
			|					ИЛИ ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.СделкаРЕПО
			|					ИЛИ ЗадолженностиПоДенежнымСредствам.Основание ССЫЛКА Документ.ИсполнениеОбязательствПоСделке)
			|				И ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ОплатаКупона)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.Оплата)
			|		ИНАЧЕ ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств
			|	КОНЕЦ КАК ВидДвиженияДенежныхСредств,
			|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
			|	РеестрПлатежей.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки,
