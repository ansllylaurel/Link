	//	
	//	Область.Параметры.СхемаПлатежей = "Т" + Постфикс;
	//
	//КонецЕсли; 
	Если ЭтоСделки Тогда
		
		Постфикс = "";
		СхемаПлатежей = "Т";
		Если ТекСтрока.ОтложенноеИсполнение = Неопределено Тогда
			СхемаПлатежей = ТекСтрока.СхемаПлатежей;
		ИначеЕсли ТекСтрока.СхемаПлатежей = "Z0" Тогда
			СхемаПлатежей = "Z0";
		ИначеЕсли НЕ ТекСтрока.ОтложенноеИсполнение Тогда
			Постфикс = "0";
		ИначеЕсли ТекСтрока.СхемаПлатежей = "Y1" Тогда
			Постфикс = "+";
		ИначеЕсли ТекСтрока.СхемаПлатежей = "Y2" Тогда
			Постфикс = "+2";
		Иначе
			СхемаПлатежей = ТекСтрока.СхемаПлатежей;
		КонецЕсли; 
		
		НовыеПараметры = Новый Структура("СхемаПлатежей", СхемаПлатежей + Постфикс);
		ЗаполнитьЗначенияСвойств(Область.Параметры, НовыеПараметры);
		
	КонецЕсли;

