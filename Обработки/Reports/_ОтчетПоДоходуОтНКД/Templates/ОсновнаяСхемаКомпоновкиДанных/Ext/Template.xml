		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫРАЗИТЬ(НКД.Облигация КАК Справочник.Облигации) КАК Облигация,
	НКД.Облигация.ГосударственныйРегистрационныйНомер КАК РегистрационныйНомер,
	КодыВТорговыхСистемах.Код КАК ISIN,
	СУММА(НКД.КупонНаНачало) + СУММА(НКД.КупонКупленный) КАК КупонНачалоИКупленный,
	СУММА(НКД.Реализация) КАК Реализация,
	СУММА(НКД.Погашение) КАК Погашение,
	СУММА(НКД.КупонНаКонец - НКД.КупонНаНачало - НКД.КупонКупленный + НКД.Реализация + НКД.Погашение) КАК Доход
ИЗ
	(ВЫБРАТЬ
		БухгалтерскийУчетОстатки.Субконто1 КАК Облигация,
		БухгалтерскийУчетОстатки.СуммаКонечныйОстаток КАК КупонНаКонец,
		БухгалтерскийУчетОстатки.СуммаНачальныйОстаток КАК КупонНаНачало,
		0 КАК КупонКупленный,
		0 КАК Реализация,
		0 КАК Погашение
	ИЗ
		РегистрБухгалтерии.БухгалтерскийУчет.ОстаткиИОбороты(
				&amp;НачалоПериода,
				&amp;КонецПериода,
				Период,
				,
				Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.КупонУплаченныйПриПокупкеКорпоративныеОблигации), ЗНАЧЕНИЕ(ПланСчетов.Основной.КупонУплаченныйПриПокупкеГосударственныеОблигации), ЗНАЧЕНИЕ(ПланСчетов.Основной.КупонУплаченныйПриПокупкеЕврооблигации), ЗНАЧЕНИЕ(ПланСчетов.Основной.СделкиРЕПОКорпоративныеОблигацииКупон), ЗНАЧЕНИЕ(ПланСчетов.Основной.СделкиРЕПОКорпоративныеОблигацииКупонНачисленный), ЗНАЧЕНИЕ(ПланСчетов.Основной.СделкиРЕПОГосударственныеОблигацииКупон), ЗНАЧЕНИЕ(ПланСчетов.Основной.СделкиРЕПОГосударственныеОблигацииКупонНачисленный), ЗНАЧЕНИЕ(ПланСчетов.Основной.СделкиРЕПОЕврооблигацииКупон), ЗНАЧЕНИЕ(ПланСчетов.Основной.СделкиРЕПОЕврооблигацииКупонНачисленный), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЦенныхБумагКорпоративныеОблигацииКупонНачисленный), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЦенныхБумагГосударственныеОблигацииКупонНачисленный), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЦенныхБумагЕврооблигацииКупонНачисленный)),
				,
				Организация = &amp;Организация
					И СчетДоверительногоУправления = &amp;СчетДУ) КАК БухгалтерскийУчетОстатки
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		БухгалтерскийУчетОбороты.Субконто1,
		0,
		0,
		БухгалтерскийУчетОбороты.СуммаОборот,
		0,
		0
	ИЗ
		РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
				&amp;НачалоПериода,
				&amp;КонецПериода,
				Период,
				Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.КупонУплаченныйПриПокупкеКорпоративныеОблигации), ЗНАЧЕНИЕ(ПланСчетов.Основной.КупонУплаченныйПриПокупкеГосударственныеОблигации), ЗНАЧЕНИЕ(ПланСчетов.Основной.КупонУплаченныйПриПокупкеЕврооблигации)),
				,
				Организация = &amp;Организация
					И СчетДоверительногоУправления = &amp;СчетДУ,
				КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыЧерезБрокера),
				) КАК БухгалтерскийУчетОбороты
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ПрочиеДоходы.Облигация,
		0,
		0,
		0,
		ПрочиеДоходы.Реализация,
		ПрочиеДоходы.Погашение
	ИЗ
		(ВЫБРАТЬ
			БухгалтерскийУчетОбороты.Субконто2 КАК Облигация,
			СУММА(ВЫБОР
					КОГДА БухгалтерскийУчетОбороты.Субконто1 = НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
						ТОГДА -БухгалтерскийУчетОбороты.СуммаОборот
					ИНАЧЕ 0
				КОНЕЦ) КАК Погашение,
			СУММА(ВЫБОР
					КОГДА БухгалтерскийУчетОбороты.Субконто1 = НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
						ТОГДА -БухгалтерскийУчетОбороты.СуммаОборот
					ИНАЧЕ 0
				КОНЕЦ) КАК Реализация
		ИЗ
			РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
					&amp;КонецПериода,
					Организация = &amp;Организация
						И СчетДоверительногоУправления = &amp;СчетДУ
						И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет)
						И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон))) КАК НастройкиУчетаАктивовСрезПоследних
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.БухгалтерскийУчет.Обороты(
						&amp;НачалоПериода,
						&amp;КонецПериода,
						Период,
						Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
						,
						Организация = &amp;Организация
							И СчетДоверительногоУправления = &amp;СчетДУ,
						,
						) КАК БухгалтерскийУчетОбороты
				ПО (БухгалтерскийУчетОбороты.Субконто1 В (НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов, НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации))
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
				ПО (Облигации.Ссылка = БухгалтерскийУчетОбороты.Субконто2)
		ГДЕ
			(Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
						И НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон)
					ИЛИ Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
						И НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон)
					ИЛИ Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
						И НастройкиУчетаАктивовСрезПоследних.УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон)))
		
		СГРУППИРОВАТЬ ПО
			БухгалтерскийУчетОбороты.Субконто2) КАК ПрочиеДоходы) КАК НКД
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&amp;КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемах
		ПО (КодыВТорговыхСистемах.Объект = НКД.Облигация)

СГРУППИРОВАТЬ ПО
	НКД.Облигация,
	КодыВТорговыхСистемах.Код,
	НКД.Облигация.ГосударственныйРегистрационныйНомер

УПОРЯДОЧИТЬ ПО
	НКД.Облигация</query>
