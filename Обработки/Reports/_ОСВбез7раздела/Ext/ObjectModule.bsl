		|	СУММА(ОстаткиСчета.СуммаКонечныйОстатокДт),
		|	СУММА(ОстаткиСчета.СуммаКонечныйОстатокКт),
		|	""Итого""
		|ИЗ
		|	ОстаткиСчета КАК ОстаткиСчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетКод";
	
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(ЭтотОбъект.Период.ДатаНачала), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГода", Новый Граница(НачалоГода(ЭтотОбъект.Период.ДатаНачала), ВидГраницы.Включая)); 
	
	СчетаДоходыРасходы = Новый Массив;
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПрибыльУбытокПрошлогоГода);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПроцентныеДоходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПроцентныеРасходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоРезервам);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыОтОпераций);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПрочиеДоходыРасходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПроцентныеДоходыПрошлогоГода);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыИРасходыКромеПроцентныхОтОперацийСФинансовымиИнструментамиПрошлогоГода);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыИРасходыПоДеятельностиПоНПО);

	Запрос.УстановитьПараметр("СчетаДоходыРасходы", СчетаДоходыРасходы);	
	
	Возврат Запрос.Выполнить().Выгрузить();

