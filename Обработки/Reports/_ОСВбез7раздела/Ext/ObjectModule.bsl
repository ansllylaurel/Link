КонецФункции	

Процедура ВывестиПоСчету(Результат, Счет, ВыборкаДетали, КоличествоГруппировок, СписокГруппировкиЗапроса)
			
	ВыборкаДетали.Сбросить();
		
	Если ВыборкаДетали.НайтиСледующий(Новый Структура("Счет", Счет)) Тогда 
		
		Если ВыборкаДетали.КоличествоСубконто = 0 Тогда 
			Возврат;
		КонецЕсли;
		
		ВывестиПодчиненныеГруппировки(КоличествоГруппировок, Результат, ВыборкаДетали, 1, СписокГруппировкиЗапроса);
			
	КонецЕсли;	
	
КонецПроцедуры

Процедура ВывестиПодчиненныеГруппировки(КоличествоГруппировок, Результат, ВыборкаУровеньВыше, НомерГруппировки, СписокГруппировкиЗапроса)	
	
	Если НомерГруппировки > КоличествоГруппировок Тогда 
		Возврат;
	КонецЕсли;	
	
	ИмяГруппировки = СписокГруппировкиЗапроса[НомерГруппировки-1].Значение; 
	ТекущаяВыборка = ВыборкаУровеньВыше.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	Область = Макет.ПолучитьОбласть("ОбластьУровень" + НомерГруппировки);
	
	ВыводитьПоАналитике = Ложь;
	Если ИмяГруппировки = "Субконто1" Тогда 
		ВыводитьПоАналитике = Истина;
	ИначеЕсли (ИмяГруппировки = "Субконто2" И ВыборкаУровеньВыше.КоличествоСубконто = 2) Тогда 
		ВыводитьПоАналитике = Истина;
	ИначеЕсли (ИмяГруппировки = "Партия" И ВыборкаУровеньВыше.ЕстьПартииИДопАналитики) Тогда
		ВыводитьПоАналитике = Истина;
	ИначеЕсли (ИмяГруппировки = "ДополнительнаяАналитика" И ВыборкаУровеньВыше.ЕстьПартииИДопАналитики) Тогда	
		ВыводитьПоАналитике = Истина;
	ИначеЕсли ИмяГруппировки = "ЛицевойСчет" Тогда 
		ВыводитьПоАналитике = Истина;
	КонецЕсли;
	
	Если ВыводитьПоАналитике Тогда 
		Результат.НачатьГруппуСтрок();
	КонецЕсли;	
	Пока ТекущаяВыборка.Следующий() Цикл 
		Если ВыводитьПоАналитике Тогда 
			ВывестиПоАналитике(Результат, ТекущаяВыборка, ТекущаяВыборка[ИмяГруппировки], Область);
		КонецЕсли;
		ВывестиПодчиненныеГруппировки(КоличествоГруппировок, Результат, ТекущаяВыборка, НомерГруппировки + 1, СписокГруппировкиЗапроса);
	КонецЦикла;	
	Если ВыводитьПоАналитике Тогда 
		Результат.ЗакончитьГруппуСтрок();
	КонецЕсли;	
		
КонецПроцедуры 	

#КонецОбласти

#Область ВспомогательныйВывод

Функция ВывестиДанныеСчета(Результат, ОбластьСчет, Счет, СчетКод, СчетНаименование, Субсчет)

	Если ЭтотОбъект.ВыводитьНаименованиеСчета И СчетКод <> "Итого" Тогда
		ОбластьСчет.Параметры.Счет = СчетКод + ", " + СчетНаименование;
	Иначе
		ОбластьСчет.Параметры.Счет = СчетКод;
	КонецЕсли;
	ОбластьСчет.Области.НаименованиеСчета.Отступ = ?(Субсчет, 2, 0);
	
	Уровень = 1;
	Если СчетКод = "Итого" Тогда
		
		ОбластьСчет.Области.ОбластьСчет.Шрифт = Новый Шрифт(ОбластьСчет.ТекущаяОбласть.Шрифт,,, Истина);
		//Уровень = 0;
		
	ИначеЕсли Счет.Вид = ВидСчета.АктивноПассивный Тогда //Аня настаивает на активном или пассивном, а не на активно-пассивном сальдо
	
		Если ОбластьСчет.Параметры.СНД <> Null И ОбластьСчет.Параметры.СНК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СНД >= ОбластьСчет.Параметры.СНК Тогда
			
				ОбластьСчет.Параметры.СНД = ОбластьСчет.Параметры.СНД - ОбластьСчет.Параметры.СНК;
				ОбластьСчет.Параметры.СНК = 0;
				
			Иначе
				
				ОбластьСчет.Параметры.СНК = ОбластьСчет.Параметры.СНК - ОбластьСчет.Параметры.СНД;
				ОбластьСчет.Параметры.СНД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ОбластьСчет.Параметры.СКД <> Null И ОбластьСчет.Параметры.СКК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СКД >= ОбластьСчет.Параметры.СКК Тогда
			
				ОбластьСчет.Параметры.СКД = ОбластьСчет.Параметры.СКД - ОбластьСчет.Параметры.СКК;
				ОбластьСчет.Параметры.СКК = 0;
				
			Иначе
			
				ОбластьСчет.Параметры.СКК = ОбластьСчет.Параметры.СКК - ОбластьСчет.Параметры.СКД;
				ОбластьСчет.Параметры.СКД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
	ИначеЕсли Счет.Вид = ВидСчета.Активный Тогда  	
		
		Если ОбластьСчет.Параметры.СНД <> Null И ОбластьСчет.Параметры.СНК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СНК > 0 Тогда 
				ОбластьСчет.Параметры.СНД = ОбластьСчет.Параметры.СНД - ОбластьСчет.Параметры.СНК;
				ОбластьСчет.Параметры.СНК = 0;
			КонецЕсли;	
							
		КонецЕсли;	
		
		Если ОбластьСчет.Параметры.СКД <> Null И ОбластьСчет.Параметры.СКК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СКК > 0 Тогда 
				ОбластьСчет.Параметры.СКД = ОбластьСчет.Параметры.СКД - ОбластьСчет.Параметры.СКК;
				ОбластьСчет.Параметры.СКК = 0;
			КонецЕсли;	
			
		КонецЕсли;	
	ИначеЕсли Счет.Вид = ВидСчета.Пассивный Тогда  	
		
		Если ОбластьСчет.Параметры.СНД <> Null И ОбластьСчет.Параметры.СНК <> Null Тогда			
			
			Если ОбластьСчет.Параметры.СНД > 0 Тогда 
				ОбластьСчет.Параметры.СНК = ОбластьСчет.Параметры.СНК - ОбластьСчет.Параметры.СНД;
				ОбластьСчет.Параметры.СНД = 0;	
			КонецЕсли;	
			
		КонецЕсли;	
		
		Если ОбластьСчет.Параметры.СКД <> Null И ОбластьСчет.Параметры.СКК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СКД > 0 Тогда 
				ОбластьСчет.Параметры.СКК = ОбластьСчет.Параметры.СКК - ОбластьСчет.Параметры.СКД;
				ОбластьСчет.Параметры.СКД = 0;
			КонецЕсли;	
					
		КонецЕсли;		
	КонецЕсли;
	
	Результат.Вывести(ОбластьСчет, Уровень);
	
	Возврат ОбластьСчет.Параметры;
	
КонецФункции

Процедура ВывестиПоАналитике(Результат, Выборка, Аналитика, ОбластьАналитика)

	Если (Выборка.СНД = 0 ИЛИ Выборка.СНД = Null)
		И (Выборка.СНК = 0 ИЛИ Выборка.СНК = Null)
		И (Выборка.ДО = 0 ИЛИ Выборка.ДО = Null)
		И (Выборка.КО = 0 ИЛИ Выборка.КО = Null)
		И (Выборка.СКД = 0 ИЛИ Выборка.СКД = Null)
		И (Выборка.СКК = 0 ИЛИ Выборка.СКК = Null) Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьАналитика.Параметры, Выборка);
	ОбластьАналитика.Параметры.Аналитика = Аналитика;
	Результат.Вывести(ОбластьАналитика);

КонецПроцедуры


#КонецОбласти

Функция СформироватьОтчет(Результат, Подписант, ГруппировкиОтчета) Экспорт
	
	КоличествоГруппировок = 0;
	СписокГруппировкиЗапроса = Новый СписокЗначений;
	Для Каждого Элемент Из ГруппировкиОтчета Цикл 
		Если Элемент.Значение = "ПоСубконто" И Элемент.Пометка Тогда 
			СписокГруппировкиЗапроса.Добавить("Субконто1");
			СписокГруппировкиЗапроса.Добавить("Субконто2");
			КоличествоГруппировок = КоличествоГруппировок + 2;
		КонецЕсли;	
		Если Элемент.Значение = "ПоПартиям" И Элемент.Пометка Тогда 
			СписокГруппировкиЗапроса.Добавить("Партия");
			КоличествоГруппировок = КоличествоГруппировок + 1;
		КонецЕсли;	
		Если Элемент.Значение = "ПоДополнительнойАналитике" И Элемент.Пометка Тогда 
			СписокГруппировкиЗапроса.Добавить("ДополнительнаяАналитика");
			КоличествоГруппировок = КоличествоГруппировок + 1;
		КонецЕсли;	
		Если Элемент.Значение = "ПоЛицевымСчетам" И Элемент.Пометка Тогда 
			СписокГруппировкиЗапроса.Добавить("ЛицевойСчет");
			КоличествоГруппировок = КоличествоГруппировок + 1;
		КонецЕсли;	
	КонецЦикла;	
			
	Сессия = Неопределено;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,ПоЛицевымСчетам,ПоСубконто", Новый Структура("Подписант", Подписант));
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	
	Попытка
    	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
	КонецПопытки;
	
	Результат.Очистить();
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСчет = Макет.ПолучитьОбласть("ОбластьСчет");
	
	ОбластьЗаголовок.Параметры.Организация   = ЭтотОбъект.Организация;
	ОбластьЗаголовок.Параметры.Заголовок   = "Оборотно-сальдовая ведомость без учета закрытия 7-го раздела " + РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	ОбластьЗаголовок.Параметры.Параметры   = "Счет д/у: """ + ЭтотОбъект.СчетДоверительногоУправления + """" + Символы.ПС +
			" По договору: №" + ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора + 
			" от " + Формат(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " года";
	
	Результат.Вывести(ОбластьЗаголовок);
	
	Результат.НачатьАвтогруппировкуСтрок();
	
	// Бухгалтерские остатки и обороты по счетам и субсчетам
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПолучитьЗакрытие7гоРаздела(МенеджерВременныхТаблиц);
	
	ТаблицаСчетов = ПолучитьТаблицуСчетов(МенеджерВременныхТаблиц);
	ВыборкаДетали = ПолучитьДанныеПоСубконто(МенеджерВременныхТаблиц, СписокГруппировкиЗапроса);
		
		
	ИтоговыеСуммы = Новый Структура("СНД,СНК,ДО,КО,СКД,СКК",0,0,0,0,0,0);
	
	Для Каждого СтрокаТаблицыСчетов Из ТаблицаСчетов Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, СтрокаТаблицыСчетов);
		
		Если СтрокаТаблицыСчетов.СчетКод = "Итого" Тогда
			ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ИтоговыеСуммы);
		КонецЕсли;
		
		// Счет, наименование
		СуммыСчета = ВывестиДанныеСчета(Результат, ОбластьСчет, СтрокаТаблицыСчетов.Счет, СтрокаТаблицыСчетов.СчетКод, СтрокаТаблицыСчетов.СчетНаименование, СтрокаТаблицыСчетов.Субсчет);
		
		Если НЕ СтрокаТаблицыСчетов.Субсчет Тогда
			ИтоговыеСуммы.СНД	= ИтоговыеСуммы.СНД + СуммыСчета.СНД;
			ИтоговыеСуммы.СНК	= ИтоговыеСуммы.СНК + СуммыСчета.СНК;
			ИтоговыеСуммы.ДО	= ИтоговыеСуммы.ДО + СуммыСчета.ДО;
			ИтоговыеСуммы.КО	= ИтоговыеСуммы.КО + СуммыСчета.КО;
			ИтоговыеСуммы.СКД	= ИтоговыеСуммы.СКД + СуммыСчета.СКД;
			ИтоговыеСуммы.СКК	= ИтоговыеСуммы.СКК + СуммыСчета.СКК;
		ИначеЕсли СтрокаТаблицыСчетов.Субсчет Тогда 
			// По группировкам
			ВывестиПоСчету(Результат, СтрокаТаблицыСчетов.Счет, ВыборкаДетали, КоличествоГруппировок, СписокГруппировкиЗапроса);	 
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ЗакончитьАвтогруппировкуСтрок();
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛица(Подписант, ЭтотОбъект.Организация);
		
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
	
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);
	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(Результат, ПараметрыВыводаПодписей);
	
	Если Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
	
КонецФункции