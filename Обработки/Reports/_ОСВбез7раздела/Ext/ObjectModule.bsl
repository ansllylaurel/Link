Функция ПолучитьДанныеПоСубконто(МенеджерВременныхТаблиц, СписокГруппировкиЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц; 
	Запрос.Текст =  
		"ВЫБРАТЬ
		|	_ОСВдляОтчета.Счет КАК Счет,
		|	_ОСВдляОтчета.Субконто1 КАК Субконто1,
		|	_ОСВдляОтчета.Субконто2 КАК Субконто2,
		|	_ОСВдляОтчета.ЛицевойСчет КАК ЛицевойСчет,
		|	_ОСВдляОтчета.Партия КАК Партия,
		|	_ОСВдляОтчета.ДополнительнаяАналитика КАК ДополнительнаяАналитика,
		|	_ОСВдляОтчета.СНД КАК СНД,
		|	_ОСВдляОтчета.СНК КАК СНК,
		|	_ОСВдляОтчета.ДО КАК ДО,
		|	_ОСВдляОтчета.КО КАК КО,
		|	_ОСВдляОтчета.СКД КАК СКД,
		|	_ОСВдляОтчета.СКК КАК СКК,
		|	ЕСТЬNULL(ДанныеСчета.КоличествоСубконто, 0) КАК КоличествоСубконто,
		|	ВЫБОР
		|		КОГДА _ОСВдляОтчета.Счет В ИЕРАРХИИ (&СчетаПартииИДопаналитики)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьПартииИДопАналитики
		|ИЗ
		|	_ОСВдляОтчета КАК _ОСВдляОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЕдиныйВидыСубконто.Ссылка КАК Счет,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕдиныйВидыСубконто.ВидСубконто) КАК КоличествоСубконто
		|		ИЗ
		|			ПланСчетов.Единый.ВидыСубконто КАК ЕдиныйВидыСубконто
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЕдиныйВидыСубконто.Ссылка) КАК ДанныеСчета
		|		ПО _ОСВдляОтчета.Счет = ДанныеСчета.Счет
		|ИТОГИ
		|	СУММА(СНД),
		|	СУММА(СНК),
		|	СУММА(ДО),
		|	СУММА(КО),
		|	СУММА(СКД),
		|	СУММА(СКК),
		|	МАКСИМУМ(КоличествоСубконто)
		|ПО
		|	Счет";
	
	
	Для Каждого Элемент из СписокГруппировкиЗапроса Цикл 
		Запрос.Текст = Запрос.Текст + ",
		|	" + Элемент.Значение;
	КонецЦикла;		
	
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДолговыеПрибыльУбыток);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажи);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДолговыеЧерезПСД);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажиИДоПогашения);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДолевыеПоСправедливой);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДолевыеДляПродажи);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПрибыльУбытокПрошлогоГода);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПроцентныеДоходы);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПроцентныеРасходы);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоРезервам);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыРасходыОтОпераций);	
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПрочиеДоходыРасходы);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ПроцентныеДоходыПрошлогоГода);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыИРасходыКромеПроцентныхОтОперацийСФинансовымиИнструментамиПрошлогоГода);
	МассивСчетов.Добавить(ПланыСчетов.Единый.ДоходыИРасходыПоДеятельностиПоНПО);
	
	
	Запрос.УстановитьПараметр("СчетаПартииИДопаналитики", МассивСчетов);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Возврат Выборка;
	
КонецФункции	

