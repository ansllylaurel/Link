Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Период = НачалоДня(НастройкиОтчета.Период.ДатаОкончания);
		
	ЭтотОбъект.ВариантФормирования = ?(НастройкиОтчета.ПоКлиенту, 1, 0);
	
	Если ЭтотОбъект.ВариантФормирования = 1 Тогда
		ЭтотОбъект.Клиент = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период);
		ЭтотОбъект.ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	КонецЕсли;
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СкомпоноватьРезультат(ДокументРезультат);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ВариантФормирования = 0 Тогда
		
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
		
		Если ПроверяемыеРеквизиты.Найти("Клиент") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить("Клиент");
		КонецЕсли;
		
		Если ПроверяемыеРеквизиты.Найти("ВидДоговораДоверительногоУправления") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить("ВидДоговораДоверительногоУправления");
		КонецЕсли;
		
	Иначе
		
		ПроверяемыеРеквизиты.Добавить("Клиент");
		ПроверяемыеРеквизиты.Добавить("ВидДоговораДоверительногоУправления");
				
		Если ПроверяемыеРеквизиты.Найти("СчетДоверительногоУправления") <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить("СчетДоверительногоУправления");
		КонецЕсли;
		
	КонецЕсли;
	
