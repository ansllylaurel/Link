
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет по активам в портфеле (Атомгарант)",
		"0.07",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьПараметрыВыполненияДляСбораСтатистики()
	
	СтрСохраняемыеДанные = "Период,Организация," + ?(ЭтотОбъект.ВариантФормирования = 0, "СчетДоверительногоУправления" ,"Клиент,ВидДоговораДоверительногоУправления");
	ПараметрыОтчета = Новый Структура(СтрСохраняемыеДанные);
	ЗаполнитьЗначенияСвойств(ПараметрыОтчета, ЭтотОбъект);
	
	Описание = "";
	
	Для каждого Реквизит Из СтрРазделить(СтрСохраняемыеДанные, ",") Цикл
	
		Описание = Описание + Символы.ПС + Реквизит + ": " + ПараметрыОтчета[Реквизит];
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	//Если ЭтотОбъект.ВФорматеCSV Тогда
	//	Если Не ПроверитьКаталог() Тогда
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка отменена");
	//		СтандартнаяОбработка = Ложь;
	//		Возврат;
	//	КонецЕсли;
	//КонецЕсли;

	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
			
	Настройки = КомпоновщикНастроек.Настройки;
	Параметры = Настройки.ПараметрыДанных;
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,ВариантФормирования,СчетДоверительногоУправления,Клиент,ВидДоговораДоверительногоУправления");	
	ПолноеИмяОтчета = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	СессияСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		ПолноеИмяОтчета,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	МВТРезультата = ПолучитьРезультатЗапроса();
	
	ЦенныеБумаги 	= МВТРезультата.Таблицы["_Результат_ЦенныеБумаги"].ПолучитьДанные().Выгрузить();
	ПрочиеАктивы 	= МВТРезультата.Таблицы["_Результат_ПрочиеАктивы"].ПолучитьДанные().Выгрузить();
	ОсновныеДанные 	= МВТРезультата.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выгрузить();
	
	Если ОсновныеДанные.Количество() = 0 Тогда		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных для вывода в отчет");
	Иначе
		
		Макет = ПолучитьМакет("Макет");
	
		ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока 		= Макет.ПолучитьОбласть("Строка");
		ОбластьПрочиеАктивы = Макет.ПолучитьОбласть("ПрочиеАктивы");
		
		НаименованиеКлиентаИПортфеля =  ОсновныеДанные[0].НаименованиеКлиента;
		Если ЭтотОбъект.ВариантФормирования = 0 Тогда
			ТекВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
			НаименованиеКлиентаИПортфеля = НаименованиеКлиентаИПортфеля + " по договору № " + ОсновныеДанные[0].НомерДоговора + " от "  + Формат(ОсновныеДанные[0].ДатаЗаключения, "ДФ=dd.MM.yyyy") + " г.";
		Иначе
			ТекВидДоговора = ЭтотОбъект.ВидДоговораДоверительногоУправления;
		КонецЕсли;
		
		Если ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			СтрВидДоговора = "средств пенсионных накоплений";
		ИначеЕсли ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			СтрВидДоговора = "средств пенсионных резервов";
		Иначе
			СтрВидДоговора = "собственных средств";
		КонецЕсли;
		
		ОбластьШапка.Параметры.ДатаОтчета = Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.ВидДоговора = СтрВидДоговора;
		ОбластьШапка.Параметры.НаименованиеКлиентаИПортфеля = НаименованиеКлиентаИПортфеля;
		
		ДокументРезультат.Вывести(ОбластьШапка);
		Для Каждого ТекСтрока Из ЦенныеБумаги Цикл
			
			ОбластьСтрока.Параметры.Заполнить(ТекСтрока);
			ДокументРезультат.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		ДокументРезультат.Вывести(ОбластьПрочиеАктивы);
		
		Для Каждого ТекСтрока Из ПрочиеАктивы Цикл
			
			ОбластьСтрока.Параметры.Заполнить(ТекСтрока);
			
			Если ТипЗнч(ТекСтрока.КодАктива) = Тип("ДокументСсылка.МНО") Тогда
				ОбластьСтрока.Параметры.КодАктива = ПолучитьПредставлениеМНО(ТекСтрока.КодАктива);
			КонецЕсли;
				
			Если ТипЗнч(ТекСтрока.КодАктива_ДатаДоп) = Тип("Дата") Тогда
				ОбластьСтрока.Параметры.КодАктива = СтрЗаменить(ОбластьСтрока.Параметры.КодАктива, "<КодАктива_ДатаДоп>", Формат(ТекСтрока.КодАктива_ДатаДоп, "ДФ=dd.MM.yyyy"));
			КонецЕсли;
			
			Если ТипЗнч(ТекСтрока.КодАктива_Дата) = Тип("Дата") Тогда
				ОбластьСтрока.Параметры.КодАктива = СтрЗаменить(ОбластьСтрока.Параметры.КодАктива, "<КодАктива_Дата>", Формат(ТекСтрока.КодАктива_Дата, "ДФ=dd.MM.yyyy"));
			КонецЕсли;
			
			ДокументРезультат.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
	КонецЕсли;

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПолноеИмяОтчета, СессияСбораСтатистики);
	
КонецПроцедуры

Функция ПолучитьПредставлениеМНО(МНО)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МНО.РасчетныйСчет.ДоговорМНО.НомерДоговора КАК НомерДоговораМНО,
		|	НомераОбъектов.Номер КАК НомерПодтверждения
		|ИЗ
		|	Документ.МНО КАК МНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|		ПО МНО.Организация = НомераОбъектов.Организация
		|			И МНО.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
		|			И МНО.Основание = НомераОбъектов.Объект
		|			И (ГОД(МНО.Дата) = НомераОбъектов.Год)
		|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
		|ГДЕ
		|	МНО.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", МНО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат "Ген.согл.МНО №" + Выборка.НомерДоговораМНО + " от <КодАктива_Дата> г. Подтв. №" 
				+ РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(Выборка.НомерПодтверждения) + " от <КодАктива_ДатаДоп> г.";		
	КонецЕсли;
		
КонецФункции

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

Функция ПолучитьРезультатЗапроса()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",									НачалоДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("Организация", 							ЭтотОбъект.Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 			ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент", 								ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления",	ЭтотОбъект.ВидДоговораДоверительногоУправления);
	Запрос.УстановитьПараметр("ВариантФормирования", 					ЭтотОбъект.ВариантФормирования);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу, """") КАК НаименованиеКлиента
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			ВЫБОР
		|					КОГДА &ВариантФормирования = 0
		|						ТОГДА СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					ИНАЧЕ Клиент = &Клиент
		|							И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
		|				КОНЕЦ
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &Период)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.Рынок КАК Рынок,
		|	ВЫРАЗИТЬ(СтоимостьПереоценки.Цена КАК ЧИСЛО(27, 12)) КАК Стоимость,
		|	СтоимостьПереоценки.ВидЦены КАК ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньОценки,
		|	СтоимостьПереоценки.ДатаЦены КАК ДатаЦены,
		|	СтоимостьПереоценки.Источник КАК Источник,
		|	СтоимостьПереоценки.РучнойВвод КАК РучнойВвод,
		|	СтоимостьПереоценки.ВидЦеныОценки КАК ВидЦеныОценки,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК Сумма,
		|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК Купон,
		|	СУММА(СтоимостьПереоценки.Количество) КАК Количество,
		|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета + СтоимостьПереоценки.СуммаВВалютеУчета) КАК ИтогоРынок,
		|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ТаблицаЦБ
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Период = &Период
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.Рынок,
		|	СтоимостьПереоценки.ВидЦены,
		|	СтоимостьПереоценки.УровеньОценки,
		|	СтоимостьПереоценки.ДатаЦены,
		|	СтоимостьПереоценки.Источник,
