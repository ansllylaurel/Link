		|				ТОГДА _ЦенныеБумагиПортфель.НКДНаКонецРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	СУММА(ВЫБОР
		|			КОГДА _ДефолтыОблигацийНаКонец.Облигация ЕСТЬ NULL
		|				ТОГДА _ЦенныеБумагиПортфель.СтоимостьНаКонецРынок + _ЦенныеБумагиПортфель.НКДНаКонецРынок
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	ВЫБОР
		|		КОГДА НЕ _ДефолтыОблигацийНаКонец.Облигация ЕСТЬ NULL
		|				ИЛИ _ЦенныеБумагиПортфель.КоличествоНаКонец = 0
		|			ТОГДА 0
		|		ИНАЧЕ _ЦенныеБумагиПортфель.СтоимостьНаКонецБаланс / _ЦенныеБумагиПортфель.КоличествоНаКонец
		|	КОНЕЦ,
		|	_ЦенныеБумагиПортфель.КотировкаНаКонецРынок,
		|	СРЕДНЕЕ(ВЫБОР
		|			КОГДА _ЦенныеБумагиПортфель.КоличествоНаКонец = 0
		|				ТОГДА 0
		|			ИНАЧЕ ВЫБОР
		|					КОГДА _ДефолтыОблигацийНаКонец.Облигация ЕСТЬ NULL
		|						ТОГДА _ЦенныеБумагиПортфель.НКДНаКонецРынок / _ЦенныеБумагиПортфель.КоличествоНаКонец
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОНЕЦ)
		|ИЗ
		|	_ЦенныеБумагиПортфель КАК _ЦенныеБумагиПортфель
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДефолтыОблигацийНаКонец КАК _ДефолтыОблигацийНаКонец
		|		ПО _ЦенныеБумагиПортфель.ЦеннаяБумага = _ДефолтыОблигацийНаКонец.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|				&КонецПериода,
		|				ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|					И Объект В
		|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|							_ЦенныеБумагиПортфель.ЦеннаяБумага КАК ЦеннаяБумага
		|						ИЗ
		|							_ЦенныеБумагиПортфель КАК _ЦенныеБумагиПортфель)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ЦенныеБумагиПортфель.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|ГДЕ
		|	(_ЦенныеБумагиПортфель.КоличествоНаКонец <> 0
		|			ИЛИ _ЦенныеБумагиПортфель.СтоимостьНаКонецБаланс <> 0
		|			ИЛИ _ЦенныеБумагиПортфель.НКДНаКонецБаланс <> 0
		|			ИЛИ _ЦенныеБумагиПортфель.СтоимостьНаКонецРынок <> 0
		|			ИЛИ _ЦенныеБумагиПортфель.НКДНаКонецРынок <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	НЕ _ДефолтыОблигацийНаКонец.Облигация ЕСТЬ NULL,
		|	_ЦенныеБумагиПортфель.ВидАктива,
		|	_ЦенныеБумагиПортфель.ПодвидАктива,
		|	_ЦенныеБумагиПортфель.Эмитент,
		|	_ЦенныеБумагиПортфель.ЦеннаяБумага,
		|	_ЦенныеБумагиПортфель.ГосударственныйРегистрационныйНомер,
		|	_ЦенныеБумагиПортфель.ПорядокПоВидуАктива,
		|	_ЦенныеБумагиПортфель.ПорядокПоПодвидуАктива,
		|	КодыВТорговыхСистемахСрезПоследних.Код,
		|	_ЦенныеБумагиПортфель.КотировкаНаКонецРынок,
		|	ВЫБОР
		|		КОГДА НЕ _ДефолтыОблигацийНаКонец.Облигация ЕСТЬ NULL
		|				ИЛИ _ЦенныеБумагиПортфель.КоличествоНаКонец = 0
		|			ТОГДА 0
		|		ИНАЧЕ _ЦенныеБумагиПортфель.СтоимостьНаКонецБаланс / _ЦенныеБумагиПортфель.КоличествоНаКонец
		|	КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Депозитные вклады"",
		|	НЕОПРЕДЕЛЕНО,
		|	_ДепозитныеВкладыПортфель.Аналитика,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	2,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	СУММА(_ДепозитныеВкладыПортфель.СтоимостьНаКонецБаланс),
		|	СУММА(_ДепозитныеВкладыПортфель.НКДНаКонецБаланс),
		|	СУММА(_ДепозитныеВкладыПортфель.СтоимостьНаКонецБаланс + _ДепозитныеВкладыПортфель.НКДНаКонецБаланс),
		|	СУММА(_ДепозитныеВкладыПортфель.СтоимостьНаКонецРынок),
		|	СУММА(_ДепозитныеВкладыПортфель.НКДНаКонецРынок),
		|	СУММА(_ДепозитныеВкладыПортфель.СтоимостьНаКонецРынок + _ДепозитныеВкладыПортфель.НКДНаКонецРынок),
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	_ДепозитныеВкладыПортфель КАК _ДепозитныеВкладыПортфель
		|ГДЕ
		|	(_ДепозитныеВкладыПортфель.СтоимостьНаКонецБаланс <> 0
		|			ИЛИ _ДепозитныеВкладыПортфель.НКДНаКонецБаланс <> 0
		|			ИЛИ _ДепозитныеВкладыПортфель.СтоимостьНаКонецРынок <> 0
		|			ИЛИ _ДепозитныеВкладыПортфель.НКДНаКонецРынок <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДепозитныеВкладыПортфель.Аналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Дебиторская задолженность"",
		|	НЕОПРЕДЕЛЕНО,
		|	_ЗадолженностьПортфель.Аналитика,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	3,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	СУММА(_ЗадолженностьПортфель.ДЗНаКонецБаланс),
		|	0,
		|	СУММА(_ЗадолженностьПортфель.ДЗНаКонецБаланс),
		|	СУММА(_ЗадолженностьПортфель.ДЗНаКонецРынок),
		|	0,
		|	СУММА(_ЗадолженностьПортфель.ДЗНаКонецРынок),
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	_ЗадолженностьПортфель КАК _ЗадолженностьПортфель
		|ГДЕ
		|	(_ЗадолженностьПортфель.ДЗНаКонецБаланс <> 0
		|			ИЛИ _ЗадолженностьПортфель.ДЗНаКонецРынок <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностьПортфель.Аналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Кредиторская задолженность"",
		|	НЕОПРЕДЕЛЕНО,
		|	_ЗадолженностьПортфель.Аналитика,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	4,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	СУММА(-1 * _ЗадолженностьПортфель.КЗНаКонецБаланс),
		|	0,
		|	СУММА(-1 * _ЗадолженностьПортфель.КЗНаКонецБаланс),
		|	СУММА(_ЗадолженностьПортфель.КЗНаКонецРынок),
		|	НЕОПРЕДЕЛЕНО,
		|	СУММА(_ЗадолженностьПортфель.КЗНаКонецРынок),
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	_ЗадолженностьПортфель КАК _ЗадолженностьПортфель
		|ГДЕ
		|	(_ЗадолженностьПортфель.КЗНаКонецБаланс <> 0
		|			ИЛИ _ЗадолженностьПортфель.КЗНаКонецРынок <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностьПортфель.Аналитика
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	ПорядокПоВидуАктива,
		|	ПорядокПоПодвидуАктива,
		|	Эмитент,
		|	ГосударственныйРегистрационныйНомер,
		|	Представление
		|ИТОГИ
		|	СУММА(СтоимостьБаланс),
		|	СУММА(НКДБаланс),
		|	СУММА(СтоимостьСНКДБаланс),
		|	СУММА(СтоимостьРынок),
		|	СУММА(НКДРынок),
		|	СУММА(СтоимостьСНКДРынок)
		|ПО
		|	ОБЩИЕ,
		|	ВидАктива,
		|	ПодвидАктива";
	#КонецОбласти
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	
	
	ДанныеШапки			= РезультатЗапроса[РезультатЗапроса.Количество()-7].Выбрать();
	Сделки				= РезультатЗапроса[РезультатЗапроса.Количество()-6].Выбрать();
	НезавершенныеСделки	= РезультатЗапроса[РезультатЗапроса.Количество()-5].Выбрать();
	ДвиженияДСРС		= РезультатЗапроса[РезультатЗапроса.Количество()-4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВводыВыводыДСОбщие	= РезультатЗапроса[РезультатЗапроса.Количество()-3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПортфельНаНачало	= РезультатЗапроса[РезультатЗапроса.Количество()-2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПортфельНаКонец		= РезультатЗапроса[РезультатЗапроса.Количество()-1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Вывод шакпи.
	Если ДанныеШапки.Следующий() Тогда
		
		Шапка.Параметры.Заполнить(ДанныеШапки);
		
		Шапка.Параметры.ДатаДоговора	= Формат(ДанныеШапки.ДатаДоговора,	"ДФ='dd.MM.yyyy ''г.'''");
		Шапка.Параметры.НачалоПериода	= Формат(ДанныеШапки.НачалоПериода,	"ДФ=dd.MM.yyyy");
		Шапка.Параметры.КонецПериода	= Формат(ДанныеШапки.КонецПериода,	"ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
	Результат.Вывести(Шапка);
	
	// Вывод сделок.
	Результат.Вывести(ЗаголовокТаблицы_1_1);
	Результат.Вывести(ШапкаТаблиц_1_1_И_1_2);
	
	Пока Сделки.Следующий() Цикл
		СтрокаТаблиц_1_1_И_1_2.Параметры.Заполнить(Сделки);
		Результат.Вывести(СтрокаТаблиц_1_1_И_1_2);
	КонецЦикла;
	
	// Вывод незавершенных сделок.
	Результат.Вывести(ЗаголовокТаблицы_1_2);
	Результат.Вывести(ШапкаТаблиц_1_1_И_1_2);
	
	Пока НезавершенныеСделки.Следующий() Цикл
		СтрокаТаблиц_1_1_И_1_2.Параметры.Заполнить(НезавершенныеСделки);
		Результат.Вывести(СтрокаТаблиц_1_1_И_1_2);
	КонецЦикла;
	
	// Вывод срочных сделок.
	Результат.Вывести(ЗаголовокТаблицы_1_3);
	
	// Вывод движений ДС.
	Результат.Вывести(ЗаголовокТаблицы_1_4);
	
	Пока ДвиженияДСРС.Следующий() Цикл
		
		ШапкаТаблицы_1_4.Параметры.Остаток	= Неопределено;
		ПодвалТаблицы_1_4.Параметры.Приход	= Неопределено;
		ПодвалТаблицы_1_4.Параметры.Расход	= Неопределено;
		ПодвалТаблицы_1_4.Параметры.Остаток	= Неопределено;
		
		ШапкаТаблицы_1_4.Параметры.НомерРасчетногоСчета	= ДвиженияДСРС.НомерРасчетногоСчета;
		ШапкаТаблицы_1_4.Параметры.НаименованиеБанка	= ДвиженияДСРС.НаименованиеБанка;
		
		ДвиженияДС = ДвиженияДСРС.Выбрать();
		
		Пока ДвиженияДС.Следующий() Цикл
			
			Если ДвиженияДС.Порядок = 0 Тогда
				
				ШапкаТаблицы_1_4.Параметры.Остаток = ДвиженияДС.Остаток;
				
				Результат.Вывести(ШапкаТаблицы_1_4);
				
			ИначеЕсли ДвиженияДС.Порядок = 1 Тогда
				
				СтрокаТаблицы_1_4.Параметры.Заполнить(ДвиженияДС);
				
				Результат.Вывести(СтрокаТаблицы_1_4);
				
			ИначеЕсли ДвиженияДС.Порядок = 2 Тогда
				ПодвалТаблицы_1_4.Параметры.Остаток = ДвиженияДС.Остаток;
			КонецЕсли;
			
		КонецЦикла;
		
		ПодвалТаблицы_1_4.Параметры.Приход	= ДвиженияДСРС.Приход;
		ПодвалТаблицы_1_4.Параметры.Расход	= ДвиженияДСРС.Расход;
		
		Результат.Вывести(ПодвалТаблицы_1_4);
		
	КонецЦикла;
	
	// Вывод раздел 2.
	Результат.Вывести(ЗаголовокРаздела_2);
	
	// Вывод вводы/выводы ДС.
	Результат.Вывести(ЗаголовокТаблицы_2_1);
	
	Если ВводыВыводыДСОбщие.Следующий() Тогда
		
		ПодвалТаблицы_2_1.Параметры.Заполнить(ВводыВыводыДСОбщие);
		
		ВводыВыводыДС = ВводыВыводыДСОбщие.Выбрать();
		
		Пока ВводыВыводыДС.Следующий() Цикл
			
			СтрокаТаблицы_2_1.Параметры.Заполнить(ВводыВыводыДС);
			
			Результат.Вывести(СтрокаТаблицы_2_1);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Результат.Вывести(ПодвалТаблицы_2_1);
	
	// Вывод вводы/выводы ЦБ.
	Результат.Вывести(ЗаголовокТаблицы_2_2);
	
	// Вывод раздел 3.
	Результат.Вывести(ЗаголовокРаздела_3);
	
	// Вывод портфель на начало периода.
	Результат.Вывести(ЗаголовокТаблицы_3_1);
	
	Результат.Вывести(ШапкаТаблиц_3_1_И_3_2);
	
	Если ПортфельНаНачало.Следующий() Тогда
		
		ВидАктива = ПортфельНаНачало.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВидАктива.Следующий() Цикл
			
			Если ВидАктива.ВидАктива = "Кредиторская задолженность" Тогда
				Коэффициент = -1;
			Иначе
				Коэффициент = 1;
			КонецЕсли;
			
			ГруппировкаВидАктива.Параметры.Заполнить(ВидАктива);
			
			Результат.Вывести(ГруппировкаВидАктива);
			
			ПодвидАктива = ВидАктива.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ПодвидАктива.Следующий() Цикл
				
				Если ПодвидАктива.ПодвидАктива <> Неопределено Тогда
					
					ГруппировкаПодвидАктива.Параметры.Заполнить(ПодвидАктива);
					
					Результат.Вывести(ГруппировкаПодвидАктива);
					
				КонецЕсли;
				
				Детали = ПодвидАктива.Выбрать();
				
				Пока Детали.Следующий() Цикл
					
					СтрокаТаблиц_3_1_И_3_2.Параметры.Заполнить(Детали);
					
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьБаланс		= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьБаланс * Коэффициент;
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДБаланс	= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДБаланс * Коэффициент;
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьРынок			= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьРынок * Коэффициент;
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДРынок		= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДРынок * Коэффициент;
					
					Если Детали.Представление = Неопределено Тогда
						СтрокаТаблиц_3_1_И_3_2.Параметры.Представление = Строка(Детали.Эмитент) + ", " + Строка(Детали.ГосударственныйРегистрационныйНомер);
					КонецЕсли;
					
					Результат.Вывести(СтрокаТаблиц_3_1_И_3_2);
					
				КонецЦикла;
				
				Если ПодвидАктива.ПодвидАктива <> Неопределено Тогда
					
					ИтогПоПодвидуАктива.Параметры.Заполнить(ПодвидАктива);
					
					Результат.Вывести(ИтогПоПодвидуАктива);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ИтогПоВидуАктива.Параметры.Заполнить(ВидАктива);
			
			ИтогПоВидуАктива.Параметры.СтоимостьБаланс		= ИтогПоВидуАктива.Параметры.СтоимостьБаланс * Коэффициент;
			ИтогПоВидуАктива.Параметры.СтоимостьСНКДБаланс	= ИтогПоВидуАктива.Параметры.СтоимостьСНКДБаланс * Коэффициент;
			ИтогПоВидуАктива.Параметры.СтоимостьРынок		= ИтогПоВидуАктива.Параметры.СтоимостьРынок * Коэффициент;
			ИтогПоВидуАктива.Параметры.СтоимостьСНКДРынок	= ИтогПоВидуАктива.Параметры.СтоимостьСНКДРынок * Коэффициент;
			
			Результат.Вывести(ИтогПоВидуАктива);
			
		КонецЦикла;
		
		ПодвалТаблиц_3_1_И_3_2.Параметры.Заполнить(ПортфельНаНачало);
		
		Результат.Вывести(ПодвалТаблиц_3_1_И_3_2);
		
	КонецЕсли;
	
	// Вывод портфель на конец периода.
	Результат.Вывести(ЗаголовокТаблицы_3_2);
	
	Результат.Вывести(ШапкаТаблиц_3_1_И_3_2);
	
	Если ПортфельНаКонец.Следующий() Тогда
		
		ВидАктива = ПортфельНаКонец.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВидАктива.Следующий() Цикл
			
			Если ВидАктива.ВидАктива = "Кредиторская задолженность" Тогда
				Коэффициент = -1;
			Иначе
				Коэффициент = 1;
			КонецЕсли;
			
			ГруппировкаВидАктива.Параметры.Заполнить(ВидАктива);
			
			Результат.Вывести(ГруппировкаВидАктива);
			
			ПодвидАктива = ВидАктива.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ПодвидАктива.Следующий() Цикл
				
				Если ПодвидАктива.ПодвидАктива <> Неопределено Тогда
					
					ГруппировкаПодвидАктива.Параметры.Заполнить(ПодвидАктива);
					
					Результат.Вывести(ГруппировкаПодвидАктива);
					
				КонецЕсли;
				
				Детали = ПодвидАктива.Выбрать();
				
				Пока Детали.Следующий() Цикл
					
					СтрокаТаблиц_3_1_И_3_2.Параметры.Заполнить(Детали);
					
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьБаланс		= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьБаланс * Коэффициент;
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДБаланс	= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДБаланс * Коэффициент;
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьРынок			= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьРынок * Коэффициент;
					СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДРынок		= СтрокаТаблиц_3_1_И_3_2.Параметры.СтоимостьСНКДРынок * Коэффициент;
					
					Если Детали.Представление = Неопределено Тогда
						СтрокаТаблиц_3_1_И_3_2.Параметры.Представление = Строка(Детали.Эмитент) + ", " + Строка(Детали.ГосударственныйРегистрационныйНомер);
					КонецЕсли;
					
					Результат.Вывести(СтрокаТаблиц_3_1_И_3_2);
					
				КонецЦикла;
				
				Если ПодвидАктива.ПодвидАктива <> Неопределено Тогда
					
					ИтогПоПодвидуАктива.Параметры.Заполнить(ПодвидАктива);
					
					Результат.Вывести(ИтогПоПодвидуАктива);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ИтогПоВидуАктива.Параметры.Заполнить(ВидАктива);
			
			ИтогПоВидуАктива.Параметры.СтоимостьБаланс		= ИтогПоВидуАктива.Параметры.СтоимостьБаланс * Коэффициент;
			ИтогПоВидуАктива.Параметры.СтоимостьСНКДБаланс	= ИтогПоВидуАктива.Параметры.СтоимостьСНКДБаланс * Коэффициент;
			ИтогПоВидуАктива.Параметры.СтоимостьРынок		= ИтогПоВидуАктива.Параметры.СтоимостьРынок * Коэффициент;
			ИтогПоВидуАктива.Параметры.СтоимостьСНКДРынок	= ИтогПоВидуАктива.Параметры.СтоимостьСНКДРынок * Коэффициент;
			
			Результат.Вывести(ИтогПоВидуАктива);
			
		КонецЦикла;
		
		ПодвалТаблиц_3_1_И_3_2.Параметры.Заполнить(ПортфельНаКонец);
		
		Результат.Вывести(ПодвалТаблиц_3_1_И_3_2);
		
	КонецЕсли;
	
	// Заполняем настройки печати	
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Результат, ЭтотОбъект.Метаданные().ПолноеИмя(), Истина, ОриентацияСтраницы.Ландшафт);
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	
КонецПроцедуры

Функция ПолучитьОперацииДДС()
	
	ТипыВариантов = Новый Массив;
	
	ТипыВариантов.Добавить(Тип("СправочникСсылка.ВидыЗадолженности"));
	ТипыВариантов.Добавить(Тип("СправочникСсылка.ВидыОперацийПриВводеВыводеДенежныхСредств"));
	ТипыВариантов.Добавить(Тип("ПеречислениеСсылка.ВидыПереводовДенежныхСредств"));
	
	ОперацииДДС = Новый ТаблицаЗначений;
	
	ОперацииДДС.Колонки.Добавить("Вид",			Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийДенежныхСредств"));
	ОперацииДДС.Колонки.Добавить("Вариант",		Новый ОписаниеТипов(ТипыВариантов));
	ОперацииДДС.Колонки.Добавить("Операция",	Новый ОписаниеТипов("Строка"));
	
	Макет = ПолучитьМакет("ОперацииДДС");
	
	Индекс = 2;
	
	Пока Макет.Область(Индекс, 1).Текст <> "" Цикл
		
		НоваяСтрока = ОперацииДДС.Добавить();
		
		Попытка
			НоваяСтрока.Вид = Вычислить(Макет.Область(Индекс, 1).Текст);
		Исключение
			ОперацииДДС.Удалить(НоваяСтрока);
			Индекс = Индекс + 1;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить значение вида ДДС при сборке таблицы операций ДДС! Вычисляемое выражение '" + Макет.Область(Индекс, 1).Текст + "'.");
			Продолжить;
		КонецПопытки;
		
		Попытка
			НоваяСтрока.Вариант = Вычислить(Макет.Область(Индекс, 2).Текст);
		Исключение
			ОперацииДДС.Удалить(НоваяСтрока);
			Индекс = Индекс + 1;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить значение варианта ДДС при сборке таблицы операций ДДС! Вычисляемое выражение '" + Макет.Область(Индекс, 2).Текст + "'.");
			Продолжить;
		КонецПопытки;
		
		НоваяСтрока.Операция = Макет.Область(Индекс, 3).Текст;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Возврат ОперацииДДС;
	
КонецФункции

#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	// Заполняем настройки отчета	

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Клиент = НастройкиОтчета.СчетДоверительногоУправления; 
	
	// Формируем отчет	
	
	СформироватьОтчет();
	
	НастройкиОтчета.Вставить("Результат", ЭтотОбъект.Результат);
	
КонецПроцедуры

#КонецОбласти