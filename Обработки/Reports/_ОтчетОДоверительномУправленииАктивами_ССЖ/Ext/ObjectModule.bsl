// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт	
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о доверительном управлении активами (Сбербанк страхование жизни)",
		"1.19",
		"",
		Истина
	);
		
	// команды отсутствуют - только интерактивный запуск
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьПроверкуНаНаличиеУКлиентНедопустимыхСделок()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("НачалоПериода",	Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",	Период.ДатаОкончания);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СделкаРЕПО.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СделкиРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.СчетДоверительногоУправления = &Клиент
		|	И СделкаРЕПО.Проведен
		|	И СделкаРЕПО.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Сделка.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СделкиПоНеподдерживаемымРынкам
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И Сделка.СчетДоверительногоУправления = &Клиент
		|	И Сделка.Проведен
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ Сделка.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Клиент,
		|	НЕ _СделкиПоНеподдерживаемымРынкам.Ссылка ЕСТЬ NULL КАК НеподдерживаемыеРынки,
		|	НЕ _СделкиРЕПО.Ссылка ЕСТЬ NULL КАК СделкиРЕПО
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиРЕПО КАК _СделкиРЕПО
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиПоНеподдерживаемымРынкам КАК _СделкиПоНеподдерживаемымРынкам
		|		ПО (ИСТИНА)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &Клиент";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.НеподдерживаемыеРынки Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента " + Выборка.Клиент + " в отчетном периоде обнаружено наличие сделок по рынкам ценных бумаг, отличных от Акций и Облигаций. Данный отчет не поддерживает сделки по таким рынкам.");
		КонецЕсли;
		
		Если Выборка.СделкиРЕПО Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента " + Выборка.Клиент + " обнаружено наличие сделок РЕПО в отчетном периоде. Данный отчет не поддерживает этот вид сделок");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьОтчет() Экспорт
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,Клиент");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьОтчет()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	// Проверка и формирование		
	ВыполнитьПроверкуНаНаличиеУКлиентНедопустимыхСделок();
	
	Результат.Очистить();
	
	Макет = ПолучитьМакет("Макет");
	
	Шапка					= Макет.ПолучитьОбласть("Шапка");
	ЗаголовокТаблицы_1_1	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_1_1");
	ШапкаТаблиц_1_1_И_1_2	= Макет.ПолучитьОбласть("ШапкаТаблиц_1_1_И_1_2");
	СтрокаТаблиц_1_1_И_1_2	= Макет.ПолучитьОбласть("СтрокаТаблиц_1_1_И_1_2");
	ЗаголовокТаблицы_1_2	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_1_2");
	ЗаголовокТаблицы_1_3	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_1_3");
	ЗаголовокТаблицы_1_4	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_1_4");
	ШапкаТаблицы_1_4		= Макет.ПолучитьОбласть("ШапкаТаблицы_1_4");
	СтрокаТаблицы_1_4		= Макет.ПолучитьОбласть("СтрокаТаблицы_1_4");
	ПодвалТаблицы_1_4		= Макет.ПолучитьОбласть("ПодвалТаблицы_1_4");
	ЗаголовокРаздела_2		= Макет.ПолучитьОбласть("ЗаголовокРаздела_2");
	ЗаголовокТаблицы_2_1	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_2_1");
	СтрокаТаблицы_2_1		= Макет.ПолучитьОбласть("СтрокаТаблицы_2_1");
	ПодвалТаблицы_2_1		= Макет.ПолучитьОбласть("ПодвалТаблицы_2_1");
	ЗаголовокТаблицы_2_2	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_2_2");
	ЗаголовокРаздела_3		= Макет.ПолучитьОбласть("ЗаголовокРаздела_3");
	ЗаголовокТаблицы_3_1	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_3_1");
	ШапкаТаблиц_3_1_И_3_2	= Макет.ПолучитьОбласть("ШапкаТаблиц_3_1_И_3_2");
	ГруппировкаВидАктива	= Макет.ПолучитьОбласть("ГруппировкаВидАктива");
	ГруппировкаПодвидАктива	= Макет.ПолучитьОбласть("ГруппировкаПодвидАктива");
	СтрокаТаблиц_3_1_И_3_2	= Макет.ПолучитьОбласть("СтрокаТаблиц_3_1_И_3_2");
	ИтогПоПодвидуАктива		= Макет.ПолучитьОбласть("ИтогПоПодвидуАктива");
	ИтогПоВидуАктива		= Макет.ПолучитьОбласть("ИтогПоВидуАктива");
	ПодвалТаблиц_3_1_И_3_2	= Макет.ПолучитьОбласть("ПодвалТаблиц_3_1_И_3_2");
	ЗаголовокТаблицы_3_2	= Макет.ПолучитьОбласть("ЗаголовокТаблицы_3_2");
	
	ВидУчетаБаланс	= РаботаСПереоценкой.ОпределитьВидУчета(Организация, Клиент, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении, Период.ДатаНачала);
	ВидДоговораДУ	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Клиент, "ВидДоговораДоверительногоУправления");
	
	Если ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями 
		ИЛИ ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		ИЛИ ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов ТОГДА
		ВидУчетаБаланс = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	КонецЕсли;
	
	МассивСубконтоКонтрагентыОснованиеРасчетов = Новый Массив;
	МассивСубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	МассивСубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	ДатаСЧАНачало = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(ЭтотОбъект.Клиент, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаНачала);
	ДатаСЧАКонец = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(ЭтотОбъект.Клиент, ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Период.ДатаОкончания);
	
	Если ДатаСЧАНачало = Неопределено Тогда
		ДатаСЧАНачало = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ЭтотОбъект.Клиент, ЭтотОбъект.Период.ДатаНачала);
	КонецЕсли;
	
	Если ДатаСЧАКонец = Неопределено Тогда
		ДатаСЧАКонец = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ЭтотОбъект.Клиент, ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;
	
	Если Не РаботаСОтчетами.ПроверитьРегистрациюСЧА(ЭтотОбъект.Организация, ЭтотОбъект.Клиент, ДатаСЧАНачало) Тогда
		Сообщить("Стоимость активов на " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " не зарегистрирована. Сведения о рыночной стоимости в таблице 3.1 выведены не будут.");	
	КонецЕсли;
	
	Если Не РаботаСОтчетами.ПроверитьРегистрациюСЧА(ЭтотОбъект.Организация, ЭтотОбъект.Клиент, ДатаСЧАКонец) Тогда
		Сообщить("Стоимость активов на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " не зарегистрирована. Сведения о рыночной стоимости в таблице 3.2 выведены не будут.");	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ГраницаНачалоПериода",					Новый Граница(Период.ДатаНачала, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ГраницаКонецПериода",					Новый Граница(Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериода",							Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",							Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаСЧАНачало",							ДатаСЧАНачало);
	Запрос.УстановитьПараметр("ДатаСЧАКонец",							ДатаСЧАКонец);
	Запрос.УстановитьПараметр("Клиент",									Клиент);
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("Рубль",									Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ДефолтнаяМОИА2",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ДефолтнаяМОИА2"));
	Запрос.УстановитьПараметр("ДефолтнаяМОИА2Эмитент",					ОбщегоНазначения.ПолучитьИменованныйОбъект("ДефолтнаяМОИА2").Эмитент);
	Запрос.УстановитьПараметр("ВидУчетаБаланс",							ВидУчетаБаланс);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыОснованиеРасчетов",	МассивСубконтоКонтрагентыОснованиеРасчетов);
	Запрос.УстановитьПараметр("ОперацииДДС",							ПолучитьОперацииДДС());
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииДДС.Вид КАК Вид,
		|	ОперацииДДС.Вариант КАК Вариант,
		|	ОперацииДДС.Операция КАК Операция
		|ПОМЕСТИТЬ _ОперацииДДС
		|ИЗ
		|	&ОперацииДДС КАК ОперацииДДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _ДанныеДоговора
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, СчетДоверительногоУправления = &Клиент) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.Основание КАК Сделка
		|ПОМЕСТИТЬ _НезавершенныеСделки
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&ГраницаКонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &Клиент
		|				И Основание ССЫЛКА Документ.Сделка) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|ГДЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК Сделка
		|ПОМЕСТИТЬ _СписокСделок
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И Сделка.СчетДоверительногоУправления = &Клиент
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Сделка.Проведен
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_НезавершенныеСделки.Сделка
		|ИЗ
		|	_НезавершенныеСделки КАК _НезавершенныеСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.Ссылка КАК Сделка,
		|	СделкаЦенныеБумаги.Ссылка.Дата КАК ДатаСделки,
		|	СделкаЦенныеБумаги.Ссылка.ВидСделки КАК ВидСделки,
		|	СделкаЦенныеБумаги.Ссылка.Рынок КАК Рынок,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
