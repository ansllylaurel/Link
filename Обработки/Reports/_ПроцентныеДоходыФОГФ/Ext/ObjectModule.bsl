
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о доходах в виде процентов (ФОГФ)",
		"1.08",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение",	ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	СтруктураКлюча.Вставить("Язык",				ПредопределенноеЗначение("Справочник.Языки.Русский"));
	СтруктураКлюча.Вставить("Объект",			ЭтотОбъект.Организация);
	
	СтруктураКлюча.Вставить("КонтактноеЛицо", НастройкиОтчета.ПодписантРуководитель);
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча));
	
	СтруктураКлюча.Вставить("КонтактноеЛицо", НастройкиОтчета.ПодписантГлавбух);
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлавбух", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча));
	
	СписокДокументов = Новый Структура;
	СписокДокументов.Вставить("ДокументГос",	Новый ТабличныйДокумент);
	СписокДокументов.Вставить("ДокументКорп15", Новый ТабличныйДокумент);
	СписокДокументов.Вставить("ДокументКорп20", Новый ТабличныйДокумент);
	
	Сформировать(СписокДокументов);
	
	КнигаЭксель = Новый ПакетОтображаемыхДокументов;
	
	Элемент1 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(СписокДокументов.ДокументГос, Новый УникальныйИдентификатор));
	Элемент1.Наименование = "Государственные";
	
	Если ЭтотОбъект.Период.ДатаОкончания>= '20250101' Тогда 
		Ставка = 15;
	Иначе         
		Ставка = 20;
	КонецЕсли;
	
	Элемент2 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(СписокДокументов.ДокументКорп15, Новый УникальныйИдентификатор));
	Элемент2.Наименование = "Корпоративные по ставке " + Формат(Ставка, "ЧЦ=2") + "%";
	
	Элемент3 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(СписокДокументов.ДокументКорп20, Новый УникальныйИдентификатор));
	Элемент3.Наименование = "Корпоративные по ставке " + Формат(Ставка + 5, "ЧЦ=2") + "%";
	
	НастройкиОтчета.Вставить("Результат", КнигаЭксель);
	
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПодписантРуководитель");
	Настройки.Добавить("ПодписантГлавбух");	
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

Функция РезультатЗапроса()	
	
	// В запросе специально не использовалась виртуальная таблица БухПартииЦенныхБумаг.Обороты или БухПартииЦенныхБумаг.ОстаткиИОбороты. Отбор по регистраторам 
	// и соединение записей регистра БухПартииЦенныхБумаг работает за месяц в 3-4 раза быстрее чем эти виртуальные таблицы
	
	
	Запрос = Новый Запрос;
	запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК АналитикаДоходов,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение КАК АналитикаДоходовПоследнееПогашение,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации КАК АналитикаДоходовОтРеализации,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки
	|ПОМЕСТИТЬ _НастройкиУчетаАктивов
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДУ
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон))
	|				И АналитикаДоходов <> ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)) КАК НастройкиУчетаАктивовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_НастройкиУчетаАктивов.АналитикаДоходов КАК Аналитика,
	|	""Погашение"" КАК Операция
	|ПОМЕСТИТЬ _АналитикиДоходов
	|ИЗ
	|	_НастройкиУчетаАктивов КАК _НастройкиУчетаАктивов
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	_НастройкиУчетаАктивов.АналитикаДоходовПоследнееПогашение,
	|	""Погашение""
	|ИЗ
	|	_НастройкиУчетаАктивов КАК _НастройкиУчетаАктивов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	_НастройкиУчетаАктивов.АналитикаДоходовОтРеализации,
	|	""Реализация""
	|ИЗ
	|	_НастройкиУчетаАктивов КАК _НастройкиУчетаАктивов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	_НастройкиУчетаАктивов.АналитикаДоходовОтПереоценки,
	|	""Переоценка""
	|ИЗ
	|	_НастройкиУчетаАктивов КАК _НастройкиУчетаАктивов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
	|	ОперацииСЦеннымиБумагами.Регистратор.МоментВремени КАК МоментВремени
	|ПОМЕСТИТЬ _Регистраторы
	|ИЗ
	|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
	|ГДЕ
	|	ОперацииСЦеннымиБумагами.Активность
	|	И ОперацииСЦеннымиБумагами.Организация = &Организация
	|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДУ
	|	И ОперацииСЦеннымиБумагами.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПереоценкаЦенныхБумаг.Ссылка,
	|	NULL
	|ИЗ
	|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
	|ГДЕ
	|	ПереоценкаЦенныхБумаг.Проведен
	|	И НЕ ПереоценкаЦенныхБумаг.ПометкаУдаления
	|	И ПереоценкаЦенныхБумаг.Организация = &Организация
	|	И ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДУ
	|	И ПереоценкаЦенныхБумаг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ПереоценкаЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
	|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоНачальныйОстаток,
	|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК СтоимостьКупонаВВалютеУчетаНачальныйОстаток,
	|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК ПереоценкаКупонаВВалютеУчетаНачальныйОстаток,
	|	0 КАК СтоимостьКупонаВВалютеУчетаКонечныйОстаток,
	|	0 КАК КоличествоКонечныйОстаток,
	|	0 КАК КоличествоПриход,
	|	0 КАК СтоимостьКупонаВВалютеУчетаПриход,
	|	0 КАК КоличествоРасход,
	|	0 КАК СтоимостьКупонаВВалютеУчетаРасход,
	|	0 КАК ПереоценкаКупонаВВалютеУчетаПриход,
	|	0 КАК ПереоценкаКупонаВВалютеУчетаРасход,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумагОстатки.Партия.Дата < &НачалоПериода
	|			ТОГДА &НачалоПериода
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(БухПартииЦенныхБумагОстатки.Партия.Дата, ДЕНЬ)
	|	КОНЕЦ КАК ДатаПартии,
	|	NULL КАК Регистратор,
	|	&НачалоПериода КАК Период,
	|	&НачалоПериода КАК МоментВремени
	|ПОМЕСТИТЬ _ПартииВременная
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|			&НачалоПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДУ
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК БухПартииЦенныхБумагОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ЦеннаяБумага,
	|	ВложенныйЗапрос.Партия,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	ВложенныйЗапрос.КоличествоПриход,
	|	ВложенныйЗапрос.СтоимостьКупонаВВалютеУчетаПриход,
	|	ВложенныйЗапрос.КоличествоРасход,
	|	ВложенныйЗапрос.СтоимостьКупонаВВалютеУчетаРасход,
	|	ВложенныйЗапрос.ПереоценкаКупонаВВалютеУчетаПриход,
	|	ВложенныйЗапрос.ПереоценкаКупонаВВалютеУчетаРасход,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.Партия.Дата < &НачалоПериода
	|			ТОГДА &НачалоПериода
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(ВложенныйЗапрос.Партия.Дата, ДЕНЬ)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ВложенныйЗапрос.Регистратор) = ТИП(Документ.СписаниеЦеннойБумаги)
	|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Регистратор КАК Документ.СписаниеЦеннойБумаги).ПогашениеЦеннойБумаги
	|		ИНАЧЕ ВложенныйЗапрос.Регистратор
	|	КОНЕЦ,
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.МоментВремени
	|ИЗ
	|	(ВЫБРАТЬ
	|		БухПартииЦенныхБумаг.Регистратор КАК Регистратор,
	|		БухПартииЦенныхБумаг.МоментВремени КАК МоментВремени,
	|		БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
	|		БухПартииЦенныхБумаг.Партия КАК Партия,
	|		СУММА(ВЫБОР
	|				КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА БухПартииЦенныхБумаг.Количество
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК КоличествоПриход,
	|		СУММА(ВЫБОР
	|				КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА БухПартииЦенныхБумаг.Количество
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК КоличествоРасход,
	|		СУММА(ВЫБОР
	|				КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК СтоимостьКупонаВВалютеУчетаПриход,
	|		СУММА(ВЫБОР
	|				КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК СтоимостьКупонаВВалютеУчетаРасход,
	|		СУММА(ВЫБОР
	|				КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК ПереоценкаКупонаВВалютеУчетаПриход,
	|		СУММА(ВЫБОР
	|				КОГДА БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК ПереоценкаКупонаВВалютеУчетаРасход,
	|		БухПартииЦенныхБумаг.Период КАК Период
	|	ИЗ
	|		_Регистраторы КАК _Регистраторы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
	|			ПО _Регистраторы.Регистратор = БухПартииЦенныхБумаг.Регистратор
	|				И (БухПартииЦенныхБумаг.Активность)
	|				И (БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &КонецПериода)
	|				И (БухПартииЦенныхБумаг.Организация = &Организация)
	|				И (БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДУ)
	|				И (БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
	|				И (БухПартииЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
	|	ГДЕ
	|		БухПартииЦенныхБумаг.Активность
	|		И БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|		И БухПартииЦенныхБумаг.Организация = &Организация
	|		И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДУ
	|		И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|		И БухПартииЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		БухПартииЦенныхБумаг.Регистратор,
	|		БухПартииЦенныхБумаг.МоментВремени,
	|		БухПартииЦенныхБумаг.Период,
	|		БухПартииЦенныхБумаг.ЦеннаяБумага,
	|		БухПартииЦенныхБумаг.Партия) КАК ВложенныйЗапрос
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ПартииВременная.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ПартииВременная.Партия КАК Партия,
