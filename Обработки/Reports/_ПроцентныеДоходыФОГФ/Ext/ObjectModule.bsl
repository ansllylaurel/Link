Функция ПараметрыРаздела(Раздел, Дата)
	
	Результат = Новый Структура("НазваниеРаздела, Ставка, Документ");
	
	Если Дата >= '20250101' Тогда 
		Инкримент = 5;
	Иначе         
		Инкримент = 0;
	КонецЕсли;
	
	Если Раздел = "Гос" Тогда
		Результат.Вставить("НазваниеРаздела","Отчет о доходах в виде процентов по государственным и муниципальным ценным бумагам");
		Результат.Вставить("Ставка", 15 + Инкримент);
		Результат.Вставить("Документ","ДокументГос");
	ИначеЕсли Раздел = "Корп15" Тогда 
		Результат.Вставить("НазваниеРаздела","Отчет о процентных доходах по корпоративным облигациям");
		Результат.Вставить("Ставка", 15 + Инкримент);
		Результат.Вставить("Документ","ДокументКорп15");
	ИначеЕсли Раздел = "Корп20" Тогда 
		Результат.Вставить("НазваниеРаздела","Отчет о процентных доходах по корпоративным облигациям");
		Результат.Вставить("Ставка", 20 + Инкримент);
		Результат.Вставить("Документ","ДокументКорп20");
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

Процедура Сформировать(СписокДокументов) Экспорт
		
	// Фиксируем запуск процедуры
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период, Организация, СчетДоверительногоУправления");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Макет = ПолучитьМакет("Макет");
	
	Результат = РезультатЗапроса();
	
	ВыборкаИтог = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//параметры шапки
	ПараметрыШапки = РаботаСОтчетами.ПолучитьПараметрыШапки(Период.ДатаОкончания, Организация, СчетДоверительногоУправления);
	
	ОбластьСтрокаЦБ = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрокаДвижение = Макет.ПолучитьОбласть("Строка2");
	
	
	//параметры подписей
	Если КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхРуководитель") Тогда
		СтруктураДанныхРуководитель = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.СтруктураДанныхРуководитель;
	Иначе
		СтруктураДанныхРуководитель = Неопределено;
	КонецЕсли;	
	Если КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхГлавбух") Тогда
		СтруктураДанныхГлавбух = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.СтруктураДанныхГлавбух;
	Иначе	
		СтруктураДанныхГлавбух = Неопределено;
	КонецЕсли;	
	
	Пока ВыборкаИтог.Следующий() Цикл 
		
		ПараметрыРаздела = ПараметрыРаздела(ВыборкаИтог.Раздел, Период.ДатаНачала);
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ПараметрыРаздела);	
		
		ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
		ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания, "ФП=Истина");
		
		ДокументРезультат = СписокДокументов[ПараметрыРаздела.Документ];	
		ДокументРезультат.Вывести(ОбластьШапка); 		
		
		ВыборкаЦБ = ВыборкаИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаЦБ.Следующий() Цикл 
				
			Выборка = ВыборкаЦБ.Выбрать();
			ПерваяСтрокаЦБ = Истина;
			Пока Выборка.Следующий() Цикл 
				
				Если Выборка.Таблица = "Остатки" И ПерваяСтрокаЦБ Тогда 
					ОбластьСтрока = ОбластьСтрокаЦБ; 
				ИначеЕсли Выборка.Таблица = "Движения" Тогда 
					ОбластьСтрока = ОбластьСтрокаДвижение;
				КонецЕсли;	
				
				ПерваяСтрокаЦБ = Ложь;
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
				ДокументРезультат.Вывести(ОбластьСтрока);
				
			КонецЦикла;
								
		КонецЦикла;
		
		ОбластьИтог = Макет.ПолучитьОбласть("Итог");
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, ВыборкаИтог);
		
		СуммаНалога= ВыборкаИтог.Прибыль * ПараметрыРаздела.Ставка/100;
		ОбластьФинРез = Макет.ПолучитьОбласть("ФинРез");
		ОбластьФинРез.Параметры.Ставка = ПараметрыРаздела.Ставка;
		ОбластьФинРез.Параметры.СуммаНалога= СуммаНалога;
			
		ДокументРезультат.Вывести(ОбластьИтог);
		ДокументРезультат.Вывести(ОбластьФинРез);		
		
		//подписи
		ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
		
		Если СтруктураДанныхРуководитель <> Неопределено Тогда 
			ОбластьПодписи.Параметры.ДолжностьРуководитель = СтруктураДанныхРуководитель.Должность + " (на основании " + СтруктураДанныхРуководитель.ОснованиеПолномочий +  ")";
			ОбластьПодписи.Параметры.Руководитель = СтруктураДанныхРуководитель.КонтактноеЛицо;
		КонецЕсли;
		Если СтруктураДанныхГлавбух <> Неопределено Тогда 	
			ОбластьПодписи.Параметры.ДолжностьГлавбух = СтруктураДанныхГлавбух.Должность;
			ОбластьПодписи.Параметры.ГлавБух = СтруктураДанныхГлавбух.КонтактноеЛицо;
		КонецЕсли;	
		
		ДокументРезультат.Вывести(ОбластьПодписи);
				
	КонецЦикла;	
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры	