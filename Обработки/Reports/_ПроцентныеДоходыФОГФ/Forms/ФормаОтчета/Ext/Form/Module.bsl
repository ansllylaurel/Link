&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Отчет.Период      =  КонецМесяца(ДобавитьМесяц(ТекущаяДата(),-1));
	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);

	
КонецПроцедуры

&НаСервере
Процедура КомандаВыполнитьОтчетНаСервере()
	
	СписокДокументов = Новый Структура;
	СписокДокументов.Вставить("ДокументГос", РезультатГос);
	СписокДокументов.Вставить("ДокументКорп15", РезультатКорп15);
	СписокДокументов.Вставить("ДокументКорп20", РезультатКорп20);
	
	РезультатГос.Очистить();
	РезультатКорп15.Очистить();
	РезультатКорп20.Очистить();
	
	РеквизитФормыВЗначение("Отчет").Сформировать(СписокДокументов);

КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьОтчет(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПодписантРуководитель) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан руководитель");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПодписантГлавбух) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан главный бухгалтер");
		Возврат;
	КонецЕсли;
	
	КомандаВыполнитьОтчетНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.Имя = "ПодписантРуководитель" Тогда 
		Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Отчет.Организация, ПодписантРуководитель));		
	ИначеЕсли Элемент.Имя = "ПодписантГлавбух" Тогда
		Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Отчет.Организация, ПодписантГлавбух));	
	КонецЕсли;	
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОчистка(Элемент, СтандартнаяОбработка)
	
	Если Элемент.Имя = "ПодписантРуководитель" Тогда 
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", Неопределено);		
	ИначеЕсли Элемент.Имя = "ПодписантГлавбух" Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлавбух", Неопределено);	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);	
	ВыбранноеЗначение = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;	
	
	Если Элемент.Имя = "ПодписантРуководитель" Тогда 
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", СтруктураДанныхКонтактногоЛица);	
	ИначеЕсли Элемент.Имя = "ПодписантГлавбух" Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлавбух", СтруктураДанныхКонтактногоЛица);	
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте 
Процедура АвтоматическоеФормирование() Экспорт

	ЗаполнитьЗначенияСвойств(Отчет, ЭтаФорма.НастройкиОтчета);
	
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	СтруктураКлюча.Вставить("Язык", ПредопределенноеЗначение("Справочник.Языки.Русский"));
	СтруктураКлюча.Вставить("Объект", Отчет.Организация);
	
	СтруктураКлюча.Вставить("КонтактноеЛицо", ЭтаФорма.НастройкиОтчета.ПодписантРуководитель);
	СтруктураДанныхРуководитель = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
	
	
	СтруктураКлюча.Вставить("КонтактноеЛицо", ЭтаФорма.НастройкиОтчета.ПодписантГлавбух);
	СтруктураДанныхГлавбух = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
	
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", СтруктураДанныхРуководитель);
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлавбух", СтруктураДанныхГлавбух);
	ЭтаФорма.Отчет.Период      =  ЭтаФорма.НастройкиОтчета.Период;
	
	КомандаВыполнитьОтчетНаСервере();
	
	
	КнигаЭксель = Новый ПакетОтображаемыхДокументов;
	
	Элемент1 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ЭтаФорма.РезультатГос, УникальныйИдентификатор));
	Элемент1.Наименование = "Государственные";
	
	Элемент2 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ЭтаФорма.РезультатКорп15, УникальныйИдентификатор));
	Элемент2.Наименование = "Корпоративные 15%";
	
	Элемент3 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(ЭтаФорма.РезультатКорп20, УникальныйИдентификатор));
	Элемент3.Наименование = "Корпоративные 20%";
		
	РаботаСОтчетамиКлиент.АвтоматическоеФормированиеОтчета(ЭтаФорма, КнигаЭксель);
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";

	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатГосПриАктивизацииОбласти(Элемент)
	
	Если ТипЗнч(РезультатГос.ВыделенныеОбласти) = Тип("ВыделенныеОбластиТабличногоДокумента") Тогда
		ИнтервалОжидания = ?(ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая, 1, 0.2);
		ПодключитьОбработчикОжидания("Подключаемый_РезультатГосПриАктивизацииОбластиПодключаемый", ИнтервалОжидания, Истина);
	КонецЕсли;
	
КонецПроцедуры

