Функция ПолучитьДанныеПоСубконто(МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц; 
	Запрос.Текст =  
		"ВЫБРАТЬ
		|	_ОСВдляОтчета.Счет КАК Счет,
		|	_ОСВдляОтчета.Субконто1 КАК Субконто1,
		|	_ОСВдляОтчета.Субконто2 КАК Субконто2,
		|	_ОСВдляОтчета.Субконто3 КАК Субконто3,
		|	_ОСВдляОтчета.СНД КАК СНД,
		|	_ОСВдляОтчета.СНК КАК СНК,
		|	_ОСВдляОтчета.ДО КАК ДО,
		|	_ОСВдляОтчета.КО КАК КО,
		|	_ОСВдляОтчета.СКД КАК СКД,
		|	_ОСВдляОтчета.СКК КАК СКК,
		|	ЕСТЬNULL(ДанныеСчета.КоличествоСубконто, 0) КАК КоличествоСубконто
		|ИЗ
		|	_ОСВдляОтчета КАК _ОСВдляОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ОсновнойВидыСубконто.Ссылка КАК Счет,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОсновнойВидыСубконто.ВидСубконто) КАК КоличествоСубконто
		|		ИЗ
		|			ПланСчетов.Основной.ВидыСубконто КАК ОсновнойВидыСубконто
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ОсновнойВидыСубконто.Ссылка) КАК ДанныеСчета
		|		ПО _ОСВдляОтчета.Счет = ДанныеСчета.Счет
		|ИТОГИ
		|	СУММА(СНД),
		|	СУММА(СНК),
		|	СУММА(ДО),
		|	СУММА(КО),
		|	СУММА(СКД),
		|	СУММА(СКК),
		|	МАКСИМУМ(КоличествоСубконто)
		|ПО
		|	Счет";
	
		//|	Субконто1,
		//|	Субконто2,
		//|	ЛицевойСчет";
	
	
	Если ЭтотОбъект.ПоСубконто Тогда
		Запрос.Текст = Запрос.Текст + ",
		|	Субконто1,
		|	Субконто2,
		|	Субконто3";
	//ИначеЕсли НЕ ЭтотОбъект.ПоСубконто И ЭтотОбъект.ПоЛицевымСчетам Тогда 
	//	Запрос.Текст = Запрос.Текст + " 
	//	|	ЛицевойСчет";
	//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ОСВдляОтчета.Субконто2 КАК Субконто1,", "");
	//	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ОСВдляОтчета.Субконто2 КАК Субконто2,", "");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Возврат Выборка;
	
