Процедура ВывестиПоСчету(Результат, Счет, ВыборкаДетали,  ОбластьАналитика1, ОбластьАналитика2, ОбластьАналитика3)

	ВыборкаДетали.Сбросить();
		
	Если ВыборкаДетали.НайтиСледующий(Новый Структура("Счет", Счет)) Тогда 
		
		Если ВыборкаДетали.КоличествоСубконто = 0 Тогда 
			Возврат;
		КонецЕсли;
		
		
		ВыборкаСубконто1 = ВыборкаДетали.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Результат.НачатьГруппуСтрок();
		Пока ВыборкаСубконто1.Следующий() Цикл
			
			ВывестиПоАналитике(Результат, ВыборкаСубконто1, ВыборкаСубконто1.Субконто1, ОбластьАналитика1);
			
			ВыборкаСубконто2 = ВыборкаСубконто1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Результат.НачатьГруппуСтрок();
			Пока ВыборкаСубконто2.Следующий() Цикл
				
				Если ВыборкаДетали.КоличествоСубконто > 1 Тогда 
					ВывестиПоАналитике(Результат, ВыборкаСубконто2, ВыборкаСубконто2.Субконто2, ОбластьАналитика2);
				КонецЕсли;	
				
				ВыборкаСубконто3 = ВыборкаСубконто2.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Результат.НачатьГруппуСтрок();
				Пока ВыборкаСубконто3.Следующий() Цикл
					Если ВыборкаДетали.КоличествоСубконто > 2 Тогда
						ВывестиПоАналитике(Результат, ВыборкаСубконто3, ВыборкаСубконто3.Субконто3, ОбластьАналитика3);
					КонецЕсли;	
				КонецЦикла;
				Результат.ЗакончитьГруппуСтрок();	
			КонецЦикла;		
			Результат.ЗакончитьГруппуСтрок();
		КонецЦикла;
		Результат.ЗакончитьГруппуСтрок();		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныйВывод

Функция ВывестиДанныеСчета(Результат, ОбластьСчет, Счет, УровентСчета)

	Если ЭтотОбъект.ВыводитьНаименованиеСчета И Счет.Код <> "Итого" Тогда
		ОбластьСчет.Параметры.Счет = Счет.Код + ", " + Счет.Наименование;
	Иначе
		ОбластьСчет.Параметры.Счет = Счет.Код;
	КонецЕсли;
	
	ОбластьСчет.Области.НаименованиеСчета.Отступ = УровентСчета - 1;
	
	Если Счет.Вид = ВидСчета.АктивноПассивный Тогда //Аня настаивает на активном или пассивном, а не на активно-пассивном сальдо
	
		Если ОбластьСчет.Параметры.СНД <> Null И ОбластьСчет.Параметры.СНК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СНД >= ОбластьСчет.Параметры.СНК Тогда
			
				ОбластьСчет.Параметры.СНД = ОбластьСчет.Параметры.СНД - ОбластьСчет.Параметры.СНК;
				ОбластьСчет.Параметры.СНК = 0;
				
			Иначе
				
				ОбластьСчет.Параметры.СНК = ОбластьСчет.Параметры.СНК - ОбластьСчет.Параметры.СНД;
				ОбластьСчет.Параметры.СНД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ОбластьСчет.Параметры.СКД <> Null И ОбластьСчет.Параметры.СКК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СКД >= ОбластьСчет.Параметры.СКК Тогда
			
				ОбластьСчет.Параметры.СКД = ОбластьСчет.Параметры.СКД - ОбластьСчет.Параметры.СКК;
				ОбластьСчет.Параметры.СКК = 0;
				
			Иначе
			
				ОбластьСчет.Параметры.СКК = ОбластьСчет.Параметры.СКК - ОбластьСчет.Параметры.СКД;
				ОбластьСчет.Параметры.СКД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
	ИначеЕсли Счет.Вид = ВидСчета.Активный Тогда 
		
		Если ОбластьСчет.Параметры.СНД <> Null И ОбластьСчет.Параметры.СНК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СНК > 0 И ОбластьСчет.Параметры.СНД >= ОбластьСчет.Параметры.СНК Тогда
			
				ОбластьСчет.Параметры.СНД = ОбластьСчет.Параметры.СНД - ОбластьСчет.Параметры.СНК;
				ОбластьСчет.Параметры.СНК = 0;
				
			//Иначе
			//	
			//	ОбластьСчет.Параметры.СНК = ОбластьСчет.Параметры.СНК - ОбластьСчет.Параметры.СНД;
			//	ОбластьСчет.Параметры.СНД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ОбластьСчет.Параметры.СКД <> Null И ОбластьСчет.Параметры.СКК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СКК > 0 И ОбластьСчет.Параметры.СКД >= ОбластьСчет.Параметры.СКК Тогда
			
				ОбластьСчет.Параметры.СКД = ОбластьСчет.Параметры.СКД - ОбластьСчет.Параметры.СКК;
				ОбластьСчет.Параметры.СКК = 0;
				
			//Иначе
			//
			//	ОбластьСчет.Параметры.СКК = ОбластьСчет.Параметры.СКК - ОбластьСчет.Параметры.СКД;
			//	ОбластьСчет.Параметры.СКД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		
		
	КонецЕсли;
	
	Результат.Вывести(ОбластьСчет, УровентСчета);
	
	Возврат ОбластьСчет.Параметры;
	
КонецФункции

Процедура ВывестиПоАналитике(Результат, Выборка, Аналитика, ОбластьАналитика)

	Если (Выборка.СНД = 0 ИЛИ Выборка.СНД = Null)
		И (Выборка.СНК = 0 ИЛИ Выборка.СНК = Null)
		И (Выборка.ДО = 0 ИЛИ Выборка.ДО = Null)
		И (Выборка.КО = 0 ИЛИ Выборка.КО = Null)
		И (Выборка.СКД = 0 ИЛИ Выборка.СКД = Null)
		И (Выборка.СКК = 0 ИЛИ Выборка.СКК = Null) Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьАналитика.Параметры, Выборка);
	ОбластьАналитика.Параметры.Аналитика = Аналитика;
	Результат.Вывести(ОбластьАналитика);

КонецПроцедуры


#КонецОбласти

Функция СформироватьОтчет(Результат, Подписант) Экспорт
	
	Сессия = Неопределено;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,ПоСубконто", Новый Структура("Подписант", Подписант));
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	
	Попытка
    	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
	КонецПопытки;
	
	Результат.Очистить();
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСчет = Макет.ПолучитьОбласть("ОбластьСчет");
	ОбластьИтог = Макет.ПолучитьОбласть("ОбластьИтог");
	ОбластьАналитика1 = Макет.ПолучитьОбласть("ОбластьАналитика1");
	ОбластьАналитика2 = Макет.ПолучитьОбласть("ОбластьАналитика2");
	ОбластьАналитика3 = Макет.ПолучитьОбласть("ОбластьАналитика3");
	
	
	ОбластьЗаголовок.Параметры.Организация   = ЭтотОбъект.Организация;
	ОбластьЗаголовок.Параметры.Заголовок   = "Оборотно-сальдовая ведомость без учета закрытия " + РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	ОбластьЗаголовок.Параметры.Параметры   = "Счет д/у: """ + ЭтотОбъект.СчетДоверительногоУправления + """" + Символы.ПС +
			" По договору: №" + ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора + 
			" от " + Формат(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " года";
	
	Результат.Вывести(ОбластьЗаголовок);
	
	//Результат.НачатьАвтогруппировкуСтрок();
	
	// Бухгалтерские остатки и обороты по счетам и субсчетам
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ПолучитьЗакрытие(МенеджерВременныхТаблиц);
	
	ВыборкаИтог = ПолучитьВыборкуСчетов(МенеджерВременныхТаблиц);
	Если ЭтотОбъект.ПоСубконто Тогда
		ВыборкаДетали = ПолучитьДанныеПоСубконто(МенеджерВременныхТаблиц);
	КонецЕсли;	
	
	Итоги = Новый Структура("СНД, СНК, ДО, КО, СКД, СКК", 0, 0, 0, 0, 0, 0);
		
	Пока ВыборкаИтог.Следующий() Цикл 
		
		ВыборкаУровень1 = ВыборкаИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУровень1.Следующий() Цикл 
			
			Если ВыборкаУровень1.Родитель1.Вид = ВидСчета.АктивноПассивный Тогда
				Если ВыборкаУровень1.СНД > ВыборкаУровень1.СНК Тогда 
					Итоги.СНД = Итоги.СНД + ВыборкаУровень1.СНД - ВыборкаУровень1.СНК;
				Иначе 
					Итоги.СНК = Итоги.СНК + ВыборкаУровень1.СНК - ВыборкаУровень1.СНД;
				КонецЕсли;	
				
				Если ВыборкаУровень1.СКД > ВыборкаУровень1.СКК Тогда 
					Итоги.СКД = Итоги.СКД + ВыборкаУровень1.СКД - ВыборкаУровень1.СКК;
				Иначе 
					Итоги.СКК = Итоги.СКК + ВыборкаУровень1.СКК - ВыборкаУровень1.СКД;
				КонецЕсли;	
				
				Итоги.ДО = Итоги.ДО + ВыборкаУровень1.ДО;
				Итоги.КО = Итоги.КО + ВыборкаУровень1.КО;
												
			Иначе				
				Итоги.СНД = Итоги.СНД + ВыборкаУровень1.СНД;
				Итоги.СНК = Итоги.СНК + ВыборкаУровень1.СНК;
				Итоги.ДО = Итоги.ДО + ВыборкаУровень1.ДО;
				Итоги.КО = Итоги.КО + ВыборкаУровень1.КО;
				Итоги.СКД = Итоги.СКД + ВыборкаУровень1.СКД;
				Итоги.СКК = Итоги.СКК + ВыборкаУровень1.СКК;
			КонецЕсли;
						
			Если ВыборкаУровень1.УровеньСчета > 1 Тогда 
				ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ВыборкаУровень1);
				ВывестиДанныеСчета(Результат, ОбластьСчет, ВыборкаУровень1.Родитель1, 1);
				Результат.НачатьГруппуСтрок();
			КонецЕсли;	
			
			ВыборкаУровень2 = ВыборкаУровень1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаУровень2.Следующий() Цикл 
				
				Если ВыборкаУровень2.УровеньСчета > 2 Тогда 
					ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ВыборкаУровень2);
					ВывестиДанныеСчета(Результат, ОбластьСчет, ВыборкаУровень2.Родитель2, 2);
					Результат.НачатьГруппуСтрок();
				КонецЕсли;				
				
				ВыборкаУровень3 = ВыборкаУровень2.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаУровень3.Следующий() Цикл 
					
					Если ВыборкаУровень3.УровеньСчета > 3 Тогда 
						ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ВыборкаУровень3);
						ВывестиДанныеСчета(Результат, ОбластьСчет, ВыборкаУровень3.Родитель3, 3);
						Результат.НачатьГруппуСтрок();
					КонецЕсли;				
					
					ВыборкаСчет = ВыборкаУровень3.Выбрать(ОбходРезультатаЗапроса.Прямой);
					
					Пока ВыборкаСчет.Следующий() Цикл 
						ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ВыборкаСчет);
						ВывестиДанныеСчета(Результат, ОбластьСчет, ВыборкаСчет.Счет, ВыборкаСчет.УровеньСчета);
						
						Если ЭтотОбъект.ПоСубконто Тогда 
							ВывестиПоСчету(Результат, ВыборкаСчет.Счет, ВыборкаДетали, ОбластьАналитика1, ОбластьАналитика2, ОбластьАналитика3);
						КонецЕсли;	
						
					КонецЦикла;
					
					Если ВыборкаУровень3.УровеньСчета > 3 Тогда 
						Результат.ЗакончитьГруппуСтрок();					
					КонецЕсли;				
					
				КонецЦикла;		
				
				Если ВыборкаУровень2.УровеньСчета > 2 Тогда 
					Результат.ЗакончитьГруппуСтрок();
				КонецЕсли;				
				
			КонецЦикла;		
			
			Если ВыборкаУровень1.УровеньСчета > 1 Тогда
				Результат.ЗакончитьГруппуСтрок();
			Конецесли;	
			
		КонецЦикла;	
		//Итог
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, Итоги);
		Результат.Вывести(ОбластьИтог, 1);
			
	КонецЦикла;	
		
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛица(Подписант, ЭтотОбъект.Организация);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
	
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);
	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(Результат, ПараметрыВыводаПодписей);
	
	Если Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
	
КонецФункции