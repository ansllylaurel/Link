	|	ЕСТЬNULL(НалоговыйУчетОборотыДтКт.СубконтоДт1, """") КАК СубконтоДт1,
	|	ЕСТЬNULL(НалоговыйУчетОборотыДтКт.СубконтоДт2, """") КАК СубконтоДт2,
	|	ЕСТЬNULL(НалоговыйУчетОборотыДтКт.СубконтоДт3, """") КАК СубконтоДт3,
	|	НалоговыйУчетОборотыДтКт.СчетКт КАК СчетКт,
	|	ЕСТЬNULL(НалоговыйУчетОборотыДтКт.СубконтоКт1, """") КАК СубконтоКт1,
	|	ЕСТЬNULL(НалоговыйУчетОборотыДтКт.СубконтоКт2, """") КАК СубконтоКт2,
	|	ЕСТЬNULL(НалоговыйУчетОборотыДтКт.СубконтоКт3, """") КАК СубконтоКт3,
