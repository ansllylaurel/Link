#Область Регистрационные_данные

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о составе и размере необходимых расходов",
		"0.62",
		"",
		Истина);
	
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"УведомлениеОбИсчерпанииЛимитовРЭМ", "Уведомление об исчерпании лимитов необходимых расходов (РЭМ)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды,
		"УведомлениеОбИсчерпанииЛимитовТраст", "Уведомление об исчерпании лимитов необходимых расходов (Траст)",, Ложь, "ВызовСерверногоМетода");
		
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область Работа_с_регламентными_заданиями

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	//Выполняем в первый рабочий день каждого месяца
	Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата()) Тогда
		Возврат;
	КонецЕсли;
	
	Если Месяц(ТекущаяДата()) = Месяц(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2)) Тогда
		Возврат;
	КонецЕсли;
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "УведомлениеОбИсчерпанииЛимитов") Тогда
		
		ЭтотОбъект.Период.ДатаОкончания	= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2);
		ЭтотОбъект.Период.ДатаНачала	= НачалоГода(ЭтотОбъект.Период.ДатаОкончания);
		ЭтотОбъект.Организация			= ПараметрыКоманды.Организация;
		ЭтотОбъект.РежимОтбора 			= 1;
				
#Область СборСтатистики_начало

		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
		
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
			ЭтотОбъект, 
			"Период,Организация", 
			Новый Структура("ИдентификаторКоманды, Вариант", ИдентификаторКоманды, "Сводный"));
			
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);

#КонецОбласти

		СформироватьУведомления(ИдентификаторКоманды);

#Область СборСтатистики_конец
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
#КонецОбласти

	КонецЕсли;   	
	
КонецПроцедуры 

#КонецОбласти

#Область Стандартные_процедуры_и_функции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(ЭтотОбъект.Период.ДатаНачала) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата начала"" не заполнено", ЭтотОбъект, , "Отчет.Период.ДатаНачала", Отказ);	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Период.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле ""Дата окончания"" не заполнено", ЭтотОбъект, , "Отчет.Период.ДатаОкончания", Отказ);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Период.ДатаНачала) И ЗначениеЗаполнено(ЭтотОбъект.Период.ДатаОкончания)
		И ЭтотОбъект.Период.ДатаНачала > ЭтотОбъект.Период.ДатаОкончания Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Значение поля ""Дата начала"" должно быть больше или равно значению поля ""Дата окончания""", ЭтотОбъект, , "Отчет.Период.ДатаНачала", Отказ);	
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты.Найти("Период") Тогда
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Период"));
	КонецЕсли;
	
	Вариант = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);	
	Если (Вариант <> "Сводный" И Вариант <> "НачисленныеИОплаченныеРасходы") 
			И ТипЗнч(ЭтотОбъект.Подписант) <> Тип("Структура") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан подписант", ,"Подписант", , Отказ);		
	КонецЕсли;                                                                                      
	
	// Проверяем режим отбора и заполненность соответствующих ему реквизитов	
	Если Вариант = "Сводный" Тогда
		// Не проверяем
	ИначеЕсли ЭтотОбъект.РежимОтбора = 0 И Не ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан счет доверительного управления",,,, Отказ);
		Возврат;		
	ИначеЕсли ЭтотОбъект.РежимОтбора = 1 
		И (Не ЗначениеЗаполнено(ЭтотОбъект.Клиент) Или Не ЗначениеЗаполнено(ЭтотОбъект.ВидДоговораДоверительногоУправления)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного режима формирования нужно указать клиента и вид договора доверительного управления",,,, Отказ);
		Возврат;  	
	КонецЕсли;
			
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	Вариант = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);	
	КлючТекущегоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьКлючВариантаОтчета(ЭтотОбъект);
	
	ДополнительныеСвойства = ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;	
	
	Если ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	
	Если Вариант = "НачисленныеИОплаченныеРасходы"
		ИЛИ Вариант = "ГАЗФОНД"
	Тогда
		
		ТекущийВариант = ЭтотОбъект.СхемаКомпоновкиДанных.ВариантыНастроек.Найти(Вариант);
	    
	    ЭтотОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(ТекущийВариант.Настройки);
		
		РаботаСОтчетамиКлиентСервер.ЗаполнитьДополнительныеСвойстваВариантаОтчета(ЭтотОбъект, КлючТекущегоВарианта);
	
		РаботаСОтчетами.ЗапомнитьКлючВариантаОтчета(ЭтотОбъект, КлючТекущегоВарианта); 
		
		// СКД
		
		ПараметрыДанных = ЭтотОбъект.КомпоновщикНастроек.Настройки.ПараметрыДанных;
		ПараметрыДанных.УстановитьЗначениеПараметра("ВариантОтчета", Вариант);
		ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ЭтотОбъект.Организация);
		ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ПараметрыДанных.УстановитьЗначениеПараметра("Клиент", ЭтотОбъект.Клиент);
		ПараметрыДанных.УстановитьЗначениеПараметра("ВидДоговораДоверительногоУправления", ЭтотОбъект.ВидДоговораДоверительногоУправления);
		ПараметрыДанных.УстановитьЗначениеПараметра("РежимОтбора", ЭтотОбъект.РежимОтбора);		
		ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода", ЭтотОбъект.Период.ДатаНачала);
		ПараметрыДанных.УстановитьЗначениеПараметра("КонецПериода", ЭтотОбъект.Период.ДатаОкончания);		
		ПараметрыДанных.УстановитьЗначениеПараметра("ПредставлениеПериода", Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		
		ЭтотОбъект.СхемаКомпоновкиДанных.Параметры.ВидДоговораДоверительногоУправления.ОграничениеИспользования = ЭтотОбъект.РежимОтбора = 0;
		ЭтотОбъект.СхемаКомпоновкиДанных.Параметры.Клиент.ОграничениеИспользования = ЭтотОбъект.РежимОтбора = 0;
		ЭтотОбъект.СхемаКомпоновкиДанных.Параметры.СчетДоверительногоУправления.ОграничениеИспользования = ЭтотОбъект.РежимОтбора = 1;
						
		РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);
		
	Иначе
		
		// Программное формирование отчетов
		СтандартнаяОбработка = Ложь;
		Отказ = Ложь;
		ПроверитьВидДоговора(Вариант, Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ПолноеИмяОтчета		= ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";	
		
		СтрокаПараметров = "Организация,Период";
		Если Вариант <> "Сводный" Тогда			
			Если ЭтотОбъект.РежимОтбора = 0 Тогда				
				СтрокаПараметров = СтрокаПараметров + ",СчетДоверительногоУправления,НакопительныйИтог";
			ИначеЕсли ЭтотОбъект.РежимОтбора = 1 Тогда
				СтрокаПараметров = СтрокаПараметров + ",Клиент,ВидДоговораДоверительногоУправления,НакопительныйИтог";
			Иначе
				СтрокаПараметров = СтрокаПараметров + ",ВидДоговораДоверительногоУправления,НакопительныйИтог";
			КонецЕсли;
		КонецЕсли;	
		
		ПараметрыВыполнения	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, СтрокаПараметров, Новый Структура("Вариант", Вариант));
		СессияСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
				ПолноеИмяОтчета,
				ПараметрыВыполнения.Хранилище,
				ПараметрыВыполнения.Описание);
							
		Если Вариант = "Основной" Тогда // НПФ Сбербанка
			
			СформироватьОтчетПоВарианту_Основной(ДокументРезультат, Истина, Отказ);
						
		ИначеЕсли Вариант = "САФМАР" Тогда
			
			СформироватьОтчетПоВарианту_Сафмар(ДокументРезультат, Отказ);
						
		ИначеЕсли Вариант = "НАЦИОНАЛЬНЫЙ" Тогда
					
			СформироватьОтчетПоВарианту_Национальный(ДокументРезультат, Отказ);	
			
		ИначеЕсли Вариант = "СРОиЦК" Тогда
					
			СформироватьОтчетПоВарианту_СРОиЦК(ДокументРезультат, Отказ);	
			
		ИначеЕсли Вариант = "Сводный" Тогда
			
			СформироватьОтчетПоВарианту_Сводный(ДокументРезультат, Отказ);
			
		ИначеЕсли Вариант = "ПоКлиентуИВидуДоговораВЦелом" Тогда
			
			СформироватьОтчетПоВарианту_ПоКлиентуИВидуДоговораВЦелом(ДокументРезультат, Отказ);
			
		КонецЕсли;
		
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПолноеИмяОтчета, СессияСбораСтатистики);
			
		Если Отказ Тогда
			ОповеститьОбОшибках();
			ДокументРезультат.Очистить();
			Возврат;
		КонецЕсли;
			
	КонецЕсли;
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя() + "." + Вариант, Истина);	
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

Процедура СформироватьУведомления(ИдентификаторКоманды) 
	
	Отказ = Ложь;	
	Результат = ПолучитьДанныеДляУведомлений(ИдентификаторКоманды, Отказ);
	
	ТекстОповещения = "";
	
	Для Каждого СтрокаРезультата Из Результат Цикл			
	
		ТекстОповещения = ТекстОповещения + СтрШаблон("%1 %2 израсходовано %3 руб. при нормативе %4 руб. %5",
		                                        ?(СтрокаРезультата.КодСчета = "-", "По портфелям ПН клиента", "По счету ДУ"),
												СтрокаРезультата.СчетДоверительногоУправления,
												Формат(СтрокаРезультата.ИтогоРасходы, "ЧДЦ=2"),
												Формат(СтрокаРезультата.НормативРасходов, "ЧДЦ=2"),
												СтрокаРезультата.ВидРезерва) + Символы.ПС;
													
																	
	КонецЦикла;
	
	Если Не ПустаяСтрока(ТекстОповещения) Или Отказ Тогда
		ОповеститьОбОшибках(ТекстОповещения);
		СформироватьОповещение(ТекстОповещения);
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьДанныеДляУведомлений(ИдентификаторКоманды = "", Отказ = Ложь) 
	
	Результат = Новый Массив;
			
	// У разных видов договоров разные критерии и алгоритмы расчета, поэтому собираем последовательно
	МассивВидоговДоговоровНПФ = Новый Массив;
	МассивВидоговДоговоровНПФ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	МассивВидоговДоговоровНПФ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	МассивВидоговДоговоровНПФ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
	
	ДобавитьДанныеПроверки_НПФ(Результат, МассивВидоговДоговоровНПФ, Ложь, Истина, Отказ);			
	ДобавитьДанныеПроверки_СРО(Результат, Отказ);
	ДобавитьДанныеПроверки_ЦК_ФОГФ(Результат, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов, Отказ);
	ДобавитьДанныеПроверки_ЦК_ФОГФ(Результат, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ, Отказ);
	ДобавитьДанныеПроверки_ПИФ(Результат, Отказ);	
					
	ОбработанныеВидыДоговоров = Новый Массив;
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ);
	ОбработанныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	
	ОбработатьПрочиеДоговоры(Результат, ОбработанныеВидыДоговоров);
		
	//При отказе ничего не выводим, чтобы не вводить пользователей в заблуждение
	Если Отказ Тогда
		Результат.Очистить();	
	КонецЕсли; 
		
	Возврат Результат;
	
КонецФункции

Процедура ОбработатьПрочиеДоговоры(Результат, ВидыДоговоров)
	
	// У других видов договоров нет сопоставленного алгоритма расчета, поэтому найдем счета ДУ с установленным размером необходимых расходов
	// и сообщим о них
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.НеобходимыеРасходы КАК НеобходимыеРасходы
		|ИЗ
		|	РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И НЕ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения > &Дата)) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.НеобходимыеРасходы <> 0");
	
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Дата", 			ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ВидыДоговоров",	ВидыДоговоров);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		ЗарегистрироватьОшибку(СтрШаблон("У счета ДУ %1 установлен процент необходимых расходов %2, но не определен алгоритм контроля расходов",
								Выборка.СчетДоверительногоУправления,
								Выборка.НеобходимыеРасходы));
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеПроверки_ПоКлиентамИВидуДоговораВЦелом(Результат, Клиенты, ВидДоговора)
	
	ЭтотОбъект.ВидДоговораДоверительногоУправления = ВидДоговора;
	
	Для Каждого КлиентДляПроверки Из Клиенты Цикл
		
		ЭтотОбъект.Клиент = КлиентДляПроверки;
		
		Отказ = Ложь;
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ДанныеОтчета = ПолучитьРезультатПоВарианту_ПоКлиентуИВидуДоговораВЦелом(МенеджерВременныхТаблиц);
	
		Если ДанныеОтчета.Свойство("Отказ") И ДанныеОтчета.Отказ 
			Или ДанныеОтчета.Свойство("ОбработкаНеТребуется") И ДанныеОтчета.ОбработкаНеТребуется Тогда
			Возврат;
		КонецЕсли;

		Для Каждого ТекСтрока Из ДанныеОтчета.СредняяСЧА Цикл
							
			ДобавитьСтрокуВРезультат(Результат, 
								КлиентДляПроверки, 
								"-",
								ЭтотОбъект.ВидДоговораДоверительногоУправления, 
								ТекСтрока.СправочноСредняяСЧА,
								ТекСтрока.ПроцентНеобходимыхРасходов,									 
								ТекСтрока.НормативНеобходимыхРасходов,
								ТекСтрока.СправочноИтогоРасходы);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеПроверки_НПФ(Результат, ВидыДоговоровДоверительногоУправления, ТребуетсяРасшифровкаРасходов, ПроверятьТолькоСчетаДУСЗаполненнымПроцентом = Ложь, Отказ = Ложь) 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
		
	ЭтотОбъект.РежимОтбора = 1;
	
	// Отдельно проверяем договоры с контролем необходимых расходов на уровне клиента и вида договора
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	РегистрыСведений.УсловияДоговоровДоверительногоУправления.ПоместитьДоговорыСКонтролемНеобходимыхРасходовПоКлиентуИВидуДоговораВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаДУСКонтролемПоКлиентуИВидуДоговора.Клиент КАК Клиент,
		|	_СчетаДУСКонтролемПоКлиентуИВидуДоговора.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ИЗ
		|	_СчетаДУСКонтролемПоКлиентуИВидуДоговора КАК _СчетаДУСКонтролемПоКлиентуИВидуДоговора
		|ИТОГИ ПО
		|	ВидДоговораДоверительногоУправления";
	
	ВыборкаВидДоговора = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидДоговора.Следующий() Цикл
				
		ВыборкаКлиенты = ВыборкаВидДоговора.Выбрать();
		
		МассивКлиентов = Новый Массив;
		Пока ВыборкаКлиенты.Следующий() Цикл	
			МассивКлиентов.Добавить(ВыборкаКлиенты.Клиент);
		КонецЦикла;
		
		ДобавитьДанныеПроверки_ПоКлиентамИВидуДоговораВЦелом(Результат, МассивКлиентов, ВыборкаВидДоговора.ВидДоговораДоверительногоУправления);	
		
	КонецЦикла;			
	
	ЭтотОбъект.ВидДоговораДоверительногоУправления = "";
	
	// Формируем в цикле по каждому клиенту (юр.лицу)
	РезультатЗапроса = РезультатЗапросаПоКлиентамИВидамДоговоров(Запрос.МенеджерВременныхТаблиц, ВидыДоговоровДоверительногоУправления);
	ВыборкаКлиенты = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКлиенты.Следующий() Цикл
		
		ЭтотОбъект.Клиент = ВыборкаКлиенты.Клиент;
		
		МассивВидовДоговоров = Новый Массив;
		ВыборкаВидыДоговоров = ВыборкаКлиенты.Выбрать();
		Пока ВыборкаВидыДоговоров.Следующий() Цикл
			МассивВидовДоговоров.Добавить(ВыборкаВидыДоговоров.ВидДоговораДоверительногоУправления);	
		КонецЦикла;
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ДанныеОтчета = ПолучитьРезультатПоВарианту_Основной(МенеджерВременныхТаблиц, ТребуетсяРасшифровкаРасходов, МассивВидовДоговоров);
	
		Если ДанныеОтчета.Свойство("Отказ") И ДанныеОтчета.Отказ Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если ДанныеОтчета.Свойство("ОбработкаНеТребуется") И ДанныеОтчета.ОбработкаНеТребуется Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТекСтрока Из ДанныеОтчета.СредняяСЧА Цикл
			
			Если ТекСтрока.НормативНеобходимыхРасходов = "-" Тогда
				Если ПроверятьТолькоСчетаДУСЗаполненнымПроцентом Тогда
					Продолжить;
				КонецЕсли;
				ЗарегистрироватьОшибку("Для счета ДУ " + СокрЛП(ТекСтрока.СчетДоверительногоУправления) + " не задан процент необходимых расходов");	
				Продолжить;
			КонецЕсли;
				
			ДобавитьСтрокуВРезультат(Результат, 
								ТекСтрока.СчетДоверительногоУправления, 
								ТекСтрока.КодСчетаДУ, 
								ТекСтрока.ВидДоговораДоверительногоУправления, 
								ТекСтрока.СправочноСредняяСЧА,
								ТекСтрока.ПроцентНеобходимыхРасходов,									 
								ТекСтрока.НормативНеобходимыхРасходов,
								ТекСтрока.СправочноИтогоРасходы);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РезультатЗапросаПоКлиентамИВидамДоговоров(МенеджерВременныхТаблиц, ВидыДоговоровДоверительногоУправления)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
																		
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &Дата)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|ГДЕ
		|	НЕ (КлиентыДоверительногоУправленияСрезПоследних.Клиент, КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления) В
		|				(ВЫБРАТЬ
		|					_СчетаДУСКонтролемПоКлиентуИВидуДоговора.Клиент КАК Клиент,
		|					_СчетаДУСКонтролемПоКлиентуИВидуДоговора.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|				ИЗ
		|					_СчетаДУСКонтролемПоКлиентуИВидуДоговора)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент.Наименование
		|ИТОГИ ПО
		|	Клиент";
	
	Запрос.УстановитьПараметр("Дата", 			ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидыДоговоров", 	ВидыДоговоровДоверительногоУправления);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура СформироватьОповещение(ТекстОповещения)

	РеквизитыОповещения = Новый Структура();				
				
	РеквизитыОповещения.Вставить("Организация",						ЭтотОбъект.Организация);
	РеквизитыОповещения.Вставить("Текст",							ТекстОповещения);
	
	Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
	
КонецПроцедуры

Процедура ДобавитьСтрокуВРезультат(Результат, СчетДоверительногоУправления, КодСчета, ВидДоговора, СредняяСЧА, ПроцентРасходов, НормативРасходов, ИтогоРасходы, ВидРезерва = "", Примечание = "")
	
	Если ЭтотОбъект.ВыводитьВсеДоговорыСУстановленнымПроцентомРасходов 
		Или НормативРасходов = 0
		Или ИтогоРасходы / НормативРасходов >= 0.9 Тогда
	
		Результат.Добавить(Новый Структура("СчетДоверительногоУправления, КодСчета, ВидДоговора, СредняяСЧА, ПроцентРасходов, НормативРасходов, ИтогоРасходы, ВидРезерва, Примечание",
									СчетДоверительногоУправления, 
									КодСчета,
									ВидДоговора,
									СредняяСЧА,
									ПроцентРасходов,
									НормативРасходов, 
									ИтогоРасходы,								
									ВидРезерва, 
									Примечание));
	
	КонецЕсли;
								
КонецПроцедуры

Процедура ДобавитьДанныеПроверки_СРО(Результат, Отказ = Ложь)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.РежимОтбора = 1;
	ЭтотОбъект.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций;
	
	// Формируем в цикле по каждому клиенту (юр.лицу)
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &Дата)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент.Наименование";
	
	Запрос.УстановитьПараметр("Дата", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		
		ЭтотОбъект.Клиент = Выборка.Клиент;
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		РезультатЗапроса = ПолучитьРезультатПоВарианту_СРОиЦК(МенеджерВременныхТаблиц, Отказ);

		Если Отказ Или РезультатЗапроса = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Инвестиционныйдоход = МенеджерВременныхТаблиц.Таблицы.Найти("_Инвестиционныйдоход").ПолучитьДанные().Выгрузить();
		ВыборкаСчетаДУ 		= МенеджерВременныхТаблиц.Таблицы.Найти("_СчетаДоверительногоУправления").ПолучитьДанные().Выбрать();
		Операции			= РезультатЗапроса[РезультатЗапроса.ВГраница()-1].Выгрузить();
		
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов) Тогда				
				Продолжить;
			КонецЕсли;  
			
			НайдСтрокиИнвестиционныйДоход = ИнвестиционныйДоход.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетаДУ.СчетДоверительногоУправления));
			Если НайдСтрокиИнвестиционныйДоход.Количество() > 0 Тогда
				
				НормативРасходов = Окр(НайдСтрокиИнвестиционныйДоход[0].СуммаВВалютеРасчета * ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов / 100, 2, 1);
				
				ИтогоРасходы = 0;
				НайдСтрокиОперации = Операции.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетаДУ.СчетДоверительногоУправления));
				Для Каждого Операция Из НайдСтрокиОперации Цикл									
					ИтогоРасходы = ИтогоРасходы + Операция.ИтогоРасходы;					
				КонецЦикла;
			    										
				ДобавитьСтрокуВРезультат(Результат, 
								ВыборкаСчетаДУ.СчетДоверительногоУправления, 
								ВыборкаСчетаДУ.КодСчетаДУ, 
								ВыборкаСчетаДУ.ВидДоговораДоверительногоУправления, 
								НайдСтрокиИнвестиционныйДоход[0].СуммаВВалютеРасчета,
								ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов,									 
								НормативРасходов,
								ИтогоРасходы);							
			    				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеПроверки_ЦК_ФОГФ(Результат, ВидДоговора, Отказ = Ложь)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.РежимОтбора 							= 2;
	ЭтотОбъект.Клиент 								= "";
	ЭтотОбъект.СчетДоверительногоУправления 		= "";
	ЭтотОбъект.ВидДоговораДоверительногоУправления 	= ВидДоговора;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	РезультатЗапроса = ПолучитьРезультатПоВарианту_СРОиЦК(МенеджерВременныхТаблиц, Отказ);

	Если Отказ Или РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СредняяСЧА = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
	
	Для Каждого ТекСтрока Из СредняяСЧА Цикл
		
		Если Не ЗначениеЗаполнено(ТекСтрока.НормативНеобходимыхРасходов) Тогда
			ЗарегистрироватьОшибку("Для счета ДУ " + СокрЛП(ТекСтрока.СчетДоверительногоУправления) + " не задан процент необходимых расходов");	
			Продолжить;
		КонецЕсли;
					
		ДобавитьСтрокуВРезультат(Результат, 
								ТекСтрока.СчетДоверительногоУправления,
								ТекСтрока.КодСчетаДУ,
								ВидДоговора, 
								ТекСтрока.СредняяСЧА,
								ТекСтрока.ПроцентНеобходимыхРасходов,									 
								ТекСтрока.НормативНеобходимыхРасходов,
								ТекСтрока.НеобходимыеРасходы);
			
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьДанныеПроверки_ПИФ(Результат, Отказ = Ложь)
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПИФОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РезервыПИФОбороты.Резерв КАК Резерв,
		|	РезервыПИФОбороты.СуммаПриход КАК НормативНеобходимыхРасходов,
		|	РезервыПИФОбороты.СуммаРасход КАК НеобходимыеРасходы,
		|	ВЫБОР
		|		КОГДА РезервыПИФОбороты.Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеУправляющего)
		|			ТОГДА УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаВознаграждениеУправляющего
		|		КОГДА РезервыПИФОбороты.Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ВознаграждениеДепозитарияАудитораОценщика)
		|			ТОГДА УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаВознаграждениеДепозитария
		|		КОГДА РезервыПИФОбороты.Резерв = ЗНАЧЕНИЕ(Справочник.Резервы.ПрочиеВозмещаемыеРасходыУправляющего)
		|			ТОГДА УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаПрочиеВозмещаемыеРасходыУправляющего
		|	КОНЕЦ КАК НастройкаРасчета,
		|	РезервыПИФОбороты.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ
		|ИЗ
		|	РегистрНакопления.РезервыПИФ.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания)) КАК РезервыПИФОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ДатаОкончания, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд
		|		ПО РезервыПИФОбороты.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И РезервыПИФОбороты.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления";
	
	// Рассчитываем от первого рабочего дня года
	НачалоПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоГода(ЭтотОбъект.Период.ДатаОкончания), 1);
	Запрос.УстановитьПараметр("ДатаНачала", 	НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", 	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	                                            	
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		
		
		ДобавитьСтрокуВРезультат(Результат, 
								Выборка.СчетДоверительногоУправления, 
								Выборка.КодСчетаДУ,
								Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда, 
								"-",
								?(Справочники.НастройкиРасчета.НастройкаРасчетаРезерваПИФСодержитСтавку(Выборка.НастройкаРасчета), 
									Справочники.НастройкиРасчета.Рассчитать(Выборка.НастройкаРасчета, Новый Структура("Период", ЭтотОбъект.Период.ДатаОкончания)), "-"),
								Выборка.НормативНеобходимыхРасходов,
								Выборка.НеобходимыеРасходы,
								"по виду резерва " + "'" + СокрЛП(Выборка.Резерв) + "'");
			
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьПараметрыИПолучитьКомиссии(Запрос, Отказ = Ложь, ВидыДоговоровДоверительногоУправления = Неопределено, НетСчетовДУПоУсловиям = Ложь, ПроверятьУровеньКонтроляНеобходимыхРасходов = Истина, ВключатьКомиссииПоПокупкамПоАСВРасходы = Ложь)
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда 
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",			ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент",									ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления",	?(ВидыДоговоровДоверительногоУправления = Неопределено, ЭтотОбъект.ВидДоговораДоверительногоУправления, ВидыДоговоровДоверительногоУправления));
	Запрос.УстановитьПараметр("РежимОтбора",							ЭтотОбъект.РежимОтбора);
	Запрос.УстановитьПараметр("НачалоПериода",							ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",							ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ВалютаРубли",							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеОрганизации,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.НеобходимыеРасходы КАК ПроцентНеобходимыхРасходов
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ДатаЗаключения <= &КонецПериода
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ КОНЕЦПЕРИОДА(СчетДоверительногоУправления.ДатаРасторжения,ДЕНЬ) >= &КонецПериода)
		|				И ВЫБОР
		|					КОГДА &РежимОтбора = 0
		|						ТОГДА СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					ИНАЧЕ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидДоговораДоверительногоУправления)
		|				КОНЕЦ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Организация.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &РежимОтбора = 1
		|				ТОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.Выполнить();
		
	ТаблицаСчетовДУ = Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выгрузить();
	
	Если ТаблицаСчетовДУ.Количество() = 0 Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют счета доверительного управления по выбранным параметрам");
		НетСчетовДУПоУсловиям = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПроверятьУровеньКонтроляНеобходимыхРасходов Тогда
		
		ПроверитьУровеньКонтроляНеобходимыхРасходов(Запрос.МенеджерВременныхТаблиц, Отказ);	
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	
	
	ТаблицаСчетовДУ.Сортировать("ДатаЗаключения");
	ДатаПоследнейСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(ТаблицаСчетовДУ[0].СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	Если Не ЗначениеЗаполнено(ДатаПоследнейСЧА) Тогда
		ЗарегистрироватьОшибку("Не удалось определить настройки формирования СЧА за выбранный период для счета ДУ " + СокрЛП(ТаблицаСчетовДУ[0].СчетДоверительногоУправления));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Договора еще могло не быть на начало периода, тогда используем последний рабочий день до даты начала периода
	Если ТаблицаСчетовДУ[0].ДатаЗаключения < НачалоДня(ЭтотОбъект.Период.ДатаНачала) Тогда	
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ТаблицаСчетовДУ[0].СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала);
	Иначе
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Период.ДатаНачала) - 1 , -1);
	КонецЕсли;
	
	ВключатьКомиссииПоПокупкамПоАСВРасходы = ТаблицаСчетовДУ[0].Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ХантыМансийский");
	РаботаСОтчетами.ПоместитьКомиссииПоСделкамЗаПериодВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, Новый Структура("ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода", ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода),, Истина, Отказ);

	// Нужны также даты СЧА по настройкам регламентных действий
	Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями", "СЧА", ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, Ложь));
	
КонецПроцедуры

Процедура ПоместитьДанныеОтчетаПоНПФВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ТребуетсяРасшифровкаРасходов, СтатусыВыполнения, ВидыДоговоровДоверительногоУправления = Неопределено, ПроверятьУровеньКонтроляНеобходимыхРасходов = Истина)

	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	НетСчетовДУПоУсловиям 	= Ложь;
	Отказ 					= Ложь;
	ВключатьКомиссииПоПокупкамПоАСВРасходы = Ложь;
