			|	_Операции.СчетДоверительногоУправления,
			|	_Операции.Период,
			|	_Операции.ВидЗадолженности
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_РазнесенныеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_РазнесенныеОперации.ПредставлениеОперации КАК ПредставлениеОперации,
			|	_РазнесенныеОперации.Период КАК Период,
			|	_РазнесенныеОперации.ИныеРасходы КАК ИныеРасходы,
			|	_РазнесенныеОперации.РасходыНаУслугиПоДоговоруБанковскогоСчета КАК РасходыНаУслугиПоДоговоруБанковскогоСчета,
			|	_РазнесенныеОперации.РасходыНаУслугиПоДоговоруОБрокерскомОбслуживании КАК РасходыНаУслугиПоДоговоруОБрокерскомОбслуживании,
			|	_РазнесенныеОперации.РасходыНаУслугиПоДоговоруДепозитарногоОбслуживания КАК РасходыНаУслугиПоДоговоруДепозитарногоОбслуживания,
			|	_РазнесенныеОперации.ИтогоРасходы КАК ИтогоРасходы
			|ИЗ
			|	_РазнесенныеОперации КАК _РазнесенныеОперации
			|
			|УПОРЯДОЧИТЬ ПО
			|	_РазнесенныеОперации.Период
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_РазнесенныеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	""ИтогоОперацииИтог"" КАК ОбластьМакета,
			|	""Итого необходимые расходы, связанные с инвестированием средств:"" КАК ИтогоПоказатель,
			|	СУММА(_РазнесенныеОперации.ИныеРасходы) КАК ИтогоИныеРасходы,
			|	СУММА(_РазнесенныеОперации.РасходыНаУслугиПоДоговоруБанковскогоСчета) КАК ИтогоРасходыНаУслугиПоДоговоруБанковскогоСчета,
			|	СУММА(_РазнесенныеОперации.РасходыНаУслугиПоДоговоруОБрокерскомОбслуживании) КАК ИтогоРасходыНаУслугиПоДоговоруОБрокерскомОбслуживании,
			|	СУММА(_РазнесенныеОперации.РасходыНаУслугиПоДоговоруДепозитарногоОбслуживания) КАК ИтогоРасходыНаУслугиПоДоговоруДепозитарногоОбслуживания,
			|	СУММА(_РазнесенныеОперации.ИтогоРасходы) КАК ИтогоИтогоРасходыПоОперации
			|ИЗ
			|	_РазнесенныеОперации КАК _РазнесенныеОперации
			|
			|СГРУППИРОВАТЬ ПО
			|	_РазнесенныеОперации.СчетДоверительногоУправления;";
		    		
		Если НормативОтСреднейСЧА Тогда
			// Рассчитываем среднюю СЧА
			Запрос.Текст = Запрос.Текст + "
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СредняяСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|	СредняяСЧА.Сумма КАК СправочноСредняяСЧА,
				|	ЕСТЬNULL(ИтогоРасходы.Сумма, 0) КАК СправочноИтогоРасходы,
				|	ВЫБОР
				|		КОГДА СредняяСЧА.Сумма = 0
				|			ТОГДА ""-""
				|		ИНАЧЕ ЕСТЬNULL(ИтогоРасходы.Сумма / СредняяСЧА.Сумма, 0)
				|	КОНЕЦ КАК СправочноДоляРасходовВСЧА,
				|	ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) КАК ПроцентНеобходимыхРасходов,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) = 0
				|			ТОГДА ""-""
				|		ИНАЧЕ ВЫРАЗИТЬ(СредняяСЧА.Сумма * _СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов / 100 КАК ЧИСЛО(19, 2))
				|	КОНЕЦ КАК НормативНеобходимыхРасходов,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) = 0
				|			ТОГДА 0
				|		ИНАЧЕ ЕСТЬNULL(ИтогоРасходы.Сумма, 0) - (ВЫРАЗИТЬ(СредняяСЧА.Сумма * _СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов / 100 КАК ЧИСЛО(19, 2)))
				|	КОНЕЦ КАК СуммаПревышенияНорматива
				|ИЗ
				|	(ВЫБРАТЬ
				|		_СЧАПоДням.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|		СРЕДНЕЕ(ЕСТЬNULL(_СЧАПоДням.Сумма, 0)) КАК Сумма
				|	ИЗ
				|		_СЧАПоДням КАК _СЧАПоДням
				|	
				|	СГРУППИРОВАТЬ ПО
				|		_СЧАПоДням.СчетДоверительногоУправления) КАК СредняяСЧА
				|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			_РазнесенныеОперации.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				|			ЕСТЬNULL(СУММА(_РазнесенныеОперации.ИтогоРасходы), 0) КАК Сумма
				|		ИЗ
				|			_РазнесенныеОперации КАК _РазнесенныеОперации
				|		
				|		СГРУППИРОВАТЬ ПО
				|			_РазнесенныеОперации.СчетДоверительногоУправления) КАК ИтогоРасходы
				|		ПО СредняяСЧА.СчетДоверительногоУправления = ИтогоРасходы.СчетДоверительногоУправления
				|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
				|		ПО СредняяСЧА.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления";

		КонецЕсли;
			
		#КонецОбласти
		              
		РезультатЗапроса = Запрос.ВыполнитьПакет();
			
		ПроверитьЗарегистрированныеСЧАЗаПериод(Запрос.МенеджерВременныхТаблиц, "_СЧАПоДням", "_ДатыПоследнейСЧА", ?(НормативОтСреднейСЧА, "Средняя СЧА", "Инвестиционный доход"),Отказ);
		
		Если Отказ Тогда 
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат РезультатЗапроса;
		
	#КонецОбласти
	
	КонецЕсли;
	
КонецФункции
	
Процедура ПроверитьВидДоговора(Вариант, Отказ)
	
	Если Вариант = "Сводный" Или Вариант = "ПоКлиентуИВидуДоговораВЦелом" Тогда 		
		Возврат;
	ИначеЕсли ЭтотОбъект.РежимОтбора = 0 Тогда
		ТекВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Иначе
		ТекВидДоговора = ЭтотОбъект.ВидДоговораДоверительногоУправления;
	КонецЕсли;
	
	МассивРазрешенныхВидовДоговоров = Новый Массив;
		
	Если Вариант = "Основной" Или Вариант = "САФМАР" Или Вариант = "НАЦИОНАЛЬНЫЙ" Тогда
		// Для вариантов Основной, Сафмар, Национальный допустимы ПН, ПР, СС, Страховые и ПФР
		МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
		МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
		МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
		МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
		МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний);
		МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний); 		
	Иначе
		// Допустимы виды договора Целевые капиталы, СРО и ФОГФ
		Если ЭтотОбъект.РежимОтбора = 2 Тогда
			МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
		Иначе
			МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
			МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
			МассивРазрешенныхВидовДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ);
		КонецЕсли;
	КонецЕсли;
	
	Если МассивРазрешенныхВидовДоговоров.Найти(ТекВидДоговора) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранный вариант отчета не предназначен для вида договора '" + СокрЛП(ТекВидДоговора) + "'",,,, Отказ);
	КонецЕсли;
	 		
КонецПроцедуры

Процедура ПроверитьЗарегистрированныеСЧАЗаПериод(МенеджерВременныхТаблиц, ИмяТаблицы, ИмяТаблицыДатПоследнейСЧА, ИмяПоказателя, Отказ)
	
	ПроверкаСЧА = МенеджерВременныхТаблиц.Таблицы[ИмяТаблицы].ПолучитьДанные().Выгрузить();
	
	Если ПроверкаСЧА.Количество() = 0 Тогда
		ЗарегистрироватьОшибку("Нет данных для формирования отчета по выбранным параметрам");		
		Возврат;
	КонецЕсли;
	
	ПроверкаСЧА.Сортировать("СчетДоверительногоУправления, Дата");
	
	МассивСчетовДУСОтсутствующимиСЧА = Новый Массив;	
	НайдСтрокиСЧАНеЗарегистрирована = ПроверкаСЧА.НайтиСтроки(Новый Структура("Сумма", NULL));		
	Для Каждого ТекСтрокаСЧАНеЗарегистрирована Из НайдСтрокиСЧАНеЗарегистрирована Цикл
		
		ТекстОшибки = "Для счета ДУ " + СокрЛП(ТекСтрокаСЧАНеЗарегистрирована.СчетДоверительногоУправления) + " не зарегистрирована СЧА на дату " + Формат(ТекСтрокаСЧАНеЗарегистрирована.Дата, "ДФ=dd.MM.yyyy");
			
		ЗарегистрироватьОшибку(ТекстОшибки);
		
		РаботаСКоллекциями.ДополнитьМассив(МассивСчетовДУСОтсутствующимиСЧА, ТекСтрокаСЧАНеЗарегистрирована.СчетДоверительногоУправления, Истина);		   			
		
		Отказ = Истина;
		
	КонецЦикла;
	
	Если МассивСчетовДУСОтсутствующимиСЧА.Количество() > 0 Тогда
		
		ТаблицаДатПоследнихСЧА = МенеджерВременныхТаблиц.Таблицы[ИмяТаблицыДатПоследнейСЧА].ПолучитьДанные().Выгрузить();
	
		Для Каждого СчетДУ Из МассивСчетовДУСОтсутствующимиСЧА Цикл
			НайдСтрокаПоследняяСЧА = ТаблицаДатПоследнихСЧА.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СчетДУ));
			Если НайдСтрокаПоследняяСЧА.Количество() > 0 Тогда
				ТекстОшибки = "Для счета ДУ " + СокрЛП(СчетДУ) + " последняя СЧА зарегистрирована " + Формат(НайдСтрокаПоследняяСЧА[0].Дата, "ДФ=dd.MM.yyyy") + 
				". Отчет не сформирован, т. к. не удалось рассчитать показатель '" + ИмяПоказателя + "' за выбранный период";;
				ЗарегистрироватьОшибку(ТекстОшибки);
			КонецЕсли;	
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьДанныеСЧА(Запрос, ТолькоРабочиеДни = Истина)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МИНИМУМ(НАЧАЛОПЕРИОДА(ВложенныйЗапрос.Дата, ДЕНЬ)) КАК Дата
		|ПОМЕСТИТЬ _ДатыНачалаДействияСчетовДУ
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		МИНИМУМ(ОстаткиДенежныхСредств.Период) КАК Дата
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|			ПО (ОстаткиДенежныхСредств.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|				И (ОстаткиДенежныхСредств.Организация = &Организация)
		|				И (ОстаткиДенежныхСредств.Период <= КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		_СчетаДоверительногоУправления.СчетДоверительногоУправления,
		|		МИНИМУМ(ОстаткиЦенныхБумаг.Период)
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|			ПО (ОстаткиЦенныхБумаг.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления)
		|				И (ОстаткиЦенныхБумаг.Организация = &Организация)
		|				И (ОстаткиЦенныхБумаг.Период <= КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СчетаДоверительногоУправления.СчетДоверительногоУправления) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.СчетДоверительногоУправления";
	
	Запрос.Выполнить();	
	
	// СредняяСЧА рассчитывается только по рабочим дням, в этом случае список дат составляем на основе данных календаря. Иначе - по настройкам регламентных действий
	
	Если ТолькоРабочиеДни Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДатыНачалаДействияСчетовДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ДанныеКалендаря.Дата КАК Дата
			|ПОМЕСТИТЬ _ДанныеКалендаря
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыНачалаДействияСчетовДУ КАК _ДатыНачалаДействияСчетовДУ
			|		ПО ДанныеКалендаря.Дата >= _ДатыНачалаДействияСчетовДУ.Дата
			|ГДЕ
			|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
			|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
			|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
		
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДатыДействияЗаПериод.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДатыДействияЗаПериод.Дата КАК Дата
			|ПОМЕСТИТЬ _ДанныеКалендаря
			|ИЗ
			|	_ДатыДействияЗаПериод КАК _ДатыДействияЗаПериод
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыНачалаДействияСчетовДУ КАК _ДатыНачалаДействияСчетовДУ
			|		ПО _ДатыДействияЗаПериод.СчетДоверительногоУправления = _ДатыНачалаДействияСчетовДУ.СчетДоверительногоУправления
			|			И (_ДатыДействияЗаПериод.Дата >= _ДатыНачалаДействияСчетовДУ.Дата)";
		
	КонецЕсли;
	
	Запрос.Выполнить();

	Запрос.Текст = 
	 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	_ДанныеКалендаря.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	_ДанныеКалендаря.Дата КАК Дата,
	 	|	СЧА.Значение КАК Сумма
	 	|ПОМЕСТИТЬ _СЧАПоДням
	 	|ИЗ
	 	|	_ДанныеКалендаря КАК _ДанныеКалендаря
	 	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК СЧА
	 	|		ПО (СЧА.Организация = &Организация)
	 	|			И (СЧА.СубъектАналитики В
	 	|				(ВЫБРАТЬ
	 	|					_СчетаДоверительногоУправления.СчетДоверительногоУправления
	 	|				ИЗ
	 	|					_СчетаДоверительногоУправления))
	 	|			И (СЧА.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
	 	|			И (СЧА.Период = _ДанныеКалендаря.Дата)
	 	|			И (СЧА.СубъектАналитики = _ДанныеКалендаря.СчетДоверительногоУправления)
	 	|;
	 	|
	 	|////////////////////////////////////////////////////////////////////////////////
	 	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	_СЧАПоДням.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	МАКСИМУМ(_СЧАПоДням.Дата) КАК Дата
	 	|ПОМЕСТИТЬ _ДатыПоследнейСЧА
	 	|ИЗ
	 	|	_СЧАПоДням КАК _СЧАПоДням
	 	|ГДЕ
	 	|	НЕ _СЧАПоДням.Сумма ЕСТЬ NULL
	 	|
	 	|СГРУППИРОВАТЬ ПО
	 	|	_СЧАПоДням.СчетДоверительногоУправления";

	Запрос.Выполнить();
	
КонецПроцедуры   

Процедура ПроверитьУровеньКонтроляНеобходимыхРасходов(МенеджерВременныхТаблиц, Отказ)
	
	// Проверяем, что среди счетов ДУ в отчете нет таких, по которым контроль необходимых расходов производится в целом по клиенту и виду договора. Для них нужно использовать отдельные варианты 
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	РегистрыСведений.УсловияДоговоровДоверительногоУправления.ПоместитьДоговорыСКонтролемНеобходимыхРасходовПоКлиентуИВидуДоговораВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДУСКонтролемПоКлиентуИВидуДоговора КАК _СчетаДУСКонтролемПоКлиентуИВидуДоговора
		|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _СчетаДУСКонтролемПоКлиентуИВидуДоговора.Ссылка";
	
	СчетаДУСКонтролемНаУровнеКлиентаИВидаДоговора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
		
	Если СчетаДУСКонтролемНаУровнеКлиентаИВидаДоговора.Количество() > 0 Тогда
		
		ЗарегистрироватьОшибку(СтрШаблон("Для следующих счетов ДУ необходимые расходы контролируются в целом по клиенту и виду договора, для них необходимо использовать вариант отчета 'По клиенту (Без деления на договоры)' или 'Сводный':%1%2", 
											Символы.ПС, 
											СтрСоединить(СчетаДУСКонтролемНаУровнеКлиентаИВидаДоговора, Символы.ПС))); 
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	
	Настройки.Добавить("ВариантОтчета");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("АвтоматическаяОтправка");
	Настройки.Добавить("АдресЭлектроннойПочты");
	Настройки.Добавить("АдресОтправителя");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	РаботаСОтчетамиКлиентСервер.ЗаполнитьДополнительныеСвойстваВариантаОтчета(ЭтотОбъект, НастройкиОтчета.ВариантОтчета);

	ДокументРезультат = Новый ТабличныйДокумент;
	
	ЭтотОбъект.СкомпоноватьРезультат(ДокументРезультат); 
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

#КонецОбласти

#Область Обработка_ошибок

Процедура ЗарегистрироватьОшибку(ТекстОшибки)	
	
	ДополнительныеСвойства = ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;	
	
	Если Не ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ТекстОповещения = Неопределено)
	
	ДополнительныеСвойства = ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;	
		
	Если Не ДополнительныеСвойства.Свойство("Ошибки") Или ДополнительныеСвойства.Ошибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекстОповещения <> Неопределено Тогда
		ТекстОповещения = ТекстОповещения + Символы.ПС + СтрСоединить(ДополнительныеСвойства.Ошибки, Символы.ПС);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти