		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СЧАПоДням.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СРЕДНЕЕ(ЕСТЬNULL(_СЧАПоДням.Сумма, 0)) КАК Сумма
		|ПОМЕСТИТЬ _СредняяСЧА
		|ИЗ
		|	_СЧАПоДням КАК _СЧАПоДням
		|
		|СГРУППИРОВАТЬ ПО
		|	_СЧАПоДням.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Расходы.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(_Расходы.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _РасходыИтого
		|ИЗ
		|	_Расходы КАК _Расходы
		|
		|СГРУППИРОВАТЬ ПО
		|	_Расходы.СчетДоверительногоУправления";
		
	#КонецОбласти
							
	Запрос.Выполнить();
	
	ПроверитьЗарегистрированныеСЧАЗаПериод(Запрос.МенеджерВременныхТаблиц, "_СЧАПоДням", "_ДатыПоследнейСЧА", "Средняя СЧА", Отказ);
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;	
	
	ДанныеОтчета = Новый Структура("Расходы, РасходыИтого, СредняяСЧА",
		Запрос.МенеджерВременныхТаблиц.Таблицы["_Расходы"].ПолучитьДанные().Выгрузить(),
		Запрос.МенеджерВременныхТаблиц.Таблицы["_РасходыИтого"].ПолучитьДанные().Выгрузить(),
		Запрос.МенеджерВременныхТаблиц.Таблицы["_СредняяСЧА"].ПолучитьДанные().Выгрузить()
	);		
	
	ДанныеОтчета.Расходы.Сортировать("Категория, Показатель");
	
	ВыборкаСчетовДУ = Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выбрать();
	
	// Компоновка отчета
	
	Макет = ПолучитьМакет("МакетСафмар");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьПоказатель	= Макет.ПолучитьОбласть("Показатель");	
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	Пока ВыборкаСчетовДУ.Следующий() Цикл
	
		// Шапка
		
		ТекВидДоговора = ВыборкаСчетовДУ.ВидДоговораДоверительногоУправления; 
		Если ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			ВидАктивов = "пенсионных накоплений";
		ИначеЕсли ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			ВидАктивов = "пенсионных резервов";
		Иначе
			ВидАктивов = "_____________________";
		КонецЕсли;

		ОбластьШапка.Параметры.НачалоПериода	= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"); 
		ОбластьШапка.Параметры.КонецПериода		= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.ДатаФормирования	= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ='«dd» MMMM yyyy ''г.'''");
		ОбластьШапка.Параметры.НомерДоговора	= ВыборкаСчетовДУ.НомерДоговора;
		ОбластьШапка.Параметры.ДатаДоговора		= Формат(ВыборкаСчетовДУ.ДатаЗаключения, "ДФ='«dd» MMMM yyyy ''г.'''");
		ОбластьШапка.Параметры.ВидАктивов		= ВидАктивов;
		
		ДокументРезультат.Вывести(ОбластьШапка);
		
		// Средняя СЧА
		
		ТекСтрокиСредняяСЧА = ДанныеОтчета.СредняяСЧА.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетовДУ.СчетДоверительногоУправления));
		СредняяСЧА = ?(ТекСтрокиСредняяСЧА.Количество() = 0, 0, ТекСтрокиСредняяСЧА[0].Сумма);
		
		ОбластьПоказатель.Параметры.НомерСтроки	= 1;
		ОбластьПоказатель.Параметры.Показатель	= "Средняя стоимость чистых активов";
		ОбластьПоказатель.Параметры.Сумма		= СредняяСЧА;
		ОбластьПоказатель.Параметры.Доля		= "-";
		
		ДокументРезультат.Вывести(ОбластьПоказатель);
		
		// Расходы
		
		ТекСтрокиРасходыИтого = ДанныеОтчета.РасходыИтого.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетовДУ.СчетДоверительногоУправления));
		ВсегоРасходы = ?(ТекСтрокиРасходыИтого.Количество() = 0, 0, ТекСтрокиРасходыИтого[0].Сумма);
		
		ОбластьПоказатель.Параметры.НомерСтроки	= 2;
		ОбластьПоказатель.Параметры.Показатель	= "Необходимые расходы (всего)";
		ОбластьПоказатель.Параметры.Сумма		= ВсегоРасходы;
		ОбластьПоказатель.Параметры.Доля		= ?(СредняяСЧА > 0, ВсегоРасходы / СредняяСЧА, "-");
		
		ДокументРезультат.Вывести(ОбластьПоказатель);
		
		ОбластьПоказатель.Параметры.НомерСтроки	= "";
		ОбластьПоказатель.Параметры.Показатель	= "в том числе:";
		ОбластьПоказатель.Параметры.Сумма		= "";
		ОбластьПоказатель.Параметры.Доля		= "";
		
		ДокументРезультат.Вывести(ОбластьПоказатель);
		
		ТекСтрокиРасходы = ДанныеОтчета.Расходы.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетовДУ.СчетДоверительногоУправления));
		НомерСтроки = 0;		
		Для Каждого Показатель Из ТекСтрокиРасходы Цикл
			НомерСтроки = НомерСтроки + 1;
			
			ОбластьПоказатель.Параметры.НомерСтроки = "2." + Формат(НомерСтроки, "ЧГ=");
			ОбластьПоказатель.Параметры.Доля		= ?(СредняяСЧА > 0, Показатель.Сумма / СредняяСЧА, "-");
			ОбластьПоказатель.Параметры.Заполнить(Показатель);
			
			ДокументРезультат.Вывести(ОбластьПоказатель);
		КонецЦикла;
		
		// Подвал
		ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
		ОбластьПодвал.Параметры.ВидАктивов		= ВидАктивов;
		ДокументРезультат.Вывести(ОбластьПодвал);
		
		ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;		
	
КонецПроцедуры

Процедура СформироватьОтчетПоВарианту_Национальный(ДокументРезультат, Отказ)
	
	// Данные отчета		
			
	#Область Национальный_Запрос
	
	Запрос = Новый Запрос;				
	
	НетСчетовДУПоУсловиям = Ложь;
	УстановитьПараметрыИПолучитьКомиссии(Запрос, Отказ,, НетСчетовДУПоУсловиям);
	
	Если Отказ Или НетСчетовДУПоУсловиям Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОбороты.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Аванс КАК Аванс,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход КАК Сумма,
		|	0 КАК СуммаКупона
		|ПОМЕСТИТЬ _ЗадолженностьПоДСРазвернуто
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДоверительногоУправления)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюАудитора))) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(_ЗадолженностьПоДСРазвернуто.Период, ДЕНЬ) КАК Период,
		|	_ЗадолженностьПоДСРазвернуто.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЗадолженностьПоДСРазвернуто.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностьПоДСРазвернуто.Валюта КАК Валюта,
		|	СУММА(_ЗадолженностьПоДСРазвернуто.Сумма) КАК Сумма,
		|	СУММА(_ЗадолженностьПоДСРазвернуто.СуммаКупона) КАК СуммаКупона
		|ПОМЕСТИТЬ _ЗадолженностьПоДС
		|ИЗ
		|	_ЗадолженностьПоДСРазвернуто КАК _ЗадолженностьПоДСРазвернуто
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностьПоДСРазвернуто.СчетДоверительногоУправления,
		|	_ЗадолженностьПоДСРазвернуто.ВидЗадолженности,
		|	_ЗадолженностьПоДСРазвернуто.Валюта,
		|	НАЧАЛОПЕРИОДА(_ЗадолженностьПоДСРазвернуто.Период, ДЕНЬ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_КомиссииПоСделкам.Период,
		|	_КомиссииПоСделкам.СчетДоверительногоУправления,
		|	_КомиссииПоСделкам.ВидЗадолженности,
		|	&ВалютаРубли,
		|	СУММА(_КомиссииПоСделкам.Сумма),
		|	СУММА(0)
		|ИЗ
		|	_КомиссииПоСделкам КАК _КомиссииПоСделкам
		|
		|СГРУППИРОВАТЬ ПО
		|	_КомиссииПоСделкам.СчетДоверительногоУправления,
		|	_КомиссииПоСделкам.Период,
		|	_КомиссииПоСделкам.ВидЗадолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС))
		|			ТОГДА ""БанковскиеРасходы""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))
		|			ТОГДА ""РасходыПоСделкам""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика)
		|			ТОГДА ""УслугиОценщика""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюАудитора)
		|			ТОГДА ""УслугиАудитора""
		|	КОНЕЦ КАК Категория,
		|	СУММА(ВЫБОР
		|			КОГДА КурсВалютыОперации.Валюта = Организации.ВалютаУчета
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|			ИНАЧЕ (ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона) * КурсВалютыОперации.Курс / КурсВалютыОперации.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность
		|		КОНЕЦ) КАК Сумма
		|ИЗ
		|	_ЗадолженностьПоДС КАК ЗадолженностиПоДенежнымСредствам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО (Организации.Ссылка = &Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыУчета
		|		ПО (КурсВалютыУчета.Валюта = Организации.ВалютаУчета)
		|			И (КурсВалютыУчета.Период = ЗадолженностиПоДенежнымСредствам.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсВалютыОперации
		|		ПО (КурсВалютыОперации.Валюта = ЗадолженностиПоДенежнымСредствам.Валюта)
		|			И (КурсВалютыОперации.Период = НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствам.Период, ДЕНЬ))
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС))
		|			ТОГДА ""БанковскиеРасходы""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))
		|			ТОГДА ""РасходыПоСделкам""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика)
		|			ТОГДА ""УслугиОценщика""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюАудитора)
		|			ТОГДА ""УслугиАудитора""
		|	КОНЕЦ
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР
		|			КОГДА КурсВалютыОперации.Валюта = Организации.ВалютаУчета
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|			ИНАЧЕ (ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона) * КурсВалютыОперации.Курс / КурсВалютыОперации.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность
		|		КОНЕЦ) <> 0";
	
	#КонецОбласти
	       		
	ТЗРезультата = Запрос.Выполнить().Выгрузить();
	
	ВыборкаСчетовДУ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СчетаДоверительногоУправления").ПолучитьДанные().Выбрать();	
	Если ВыборкаСчетовДУ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("МакетНациональный");
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");	
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	Пока ВыборкаСчетовДУ.Следующий() Цикл
	    		
		// Компоновка отчета                            		
		
		// Шапка
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаСчетовДУ);
		ОбластьШапка.Параметры.ПериодОтчета		= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " г.";
		ОбластьШапка.Параметры.НомерДоговора	= ВыборкаСчетовДУ.НомерДоговора;
		ОбластьШапка.Параметры.ДатаДоговора		= Формат(ВыборкаСчетовДУ.ДатаЗаключения, "ДФ='«dd» MMMM yyyy ''г.'''");
										
		// Расходы 
		
		ОбластьШапка.Параметры.КомиссииБанка 		= 0;						
		ОбластьШапка.Параметры.КомиссииПоСделкам 	= 0;				
		ОбластьШапка.Параметры.УслугиОценщика		= 0;
		ОбластьШапка.Параметры.УслугиАудитора 		= 0;
		
		НайдСтроки = ТЗРезультата.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетовДУ.СчетДоверительногоУправления));
		СуммаВсего = 0;
		Для Каждого ТекСтрокаРезультата Из НайдСтроки Цикл 				
			
			Если ТекСтрокаРезультата.Категория = "БанковскиеРасходы" Тогда
				ОбластьШапка.Параметры.КомиссииБанка = ТекСтрокаРезультата.Сумма;	
			ИначеЕсли ТекСтрокаРезультата.Категория = "РасходыПоСделкам" Тогда	
				ОбластьШапка.Параметры.КомиссииПоСделкам = ТекСтрокаРезультата.Сумма;
			ИначеЕсли ТекСтрокаРезультата.Категория = "УслугиОценщика" Тогда	
				ОбластьШапка.Параметры.УслугиОценщика = ТекСтрокаРезультата.Сумма;
			ИначеЕсли ТекСтрокаРезультата.Категория = "УслугиАудитора" Тогда
				ОбластьШапка.Параметры.УслугиАудитора = ТекСтрокаРезультата.Сумма;
			Иначе 
				Продолжить;
			КонецЕсли;
			
			СуммаВсего = СуммаВсего + ТекСтрокаРезультата.Сумма;
			
		КонецЦикла;		
		
		ОбластьШапка.Параметры.СуммаВсего = СуммаВсего;			
		ДокументРезультат.Вывести(ОбластьШапка);
		
		// Подвал
		ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
		ДокументРезультат.Вывести(ОбластьПодвал);
		
	 	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;

КонецПроцедуры

Процедура СформироватьОтчетПоВарианту_СРОиЦК(ДокументРезультат, Отказ)
			
	// Данные шапки	
	
	ПредставлениеПериода	= ?(ЭтотОбъект.НакопительныйИтог, Строка(ЭтотОбъект.Период), ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));	
	Год						= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=yyyy");	
	
	ТекВидДоговора = ?(ЭтотОбъект.РежимОтбора = 1 Или ЭтотОбъект.РежимОтбора = 2, ЭтотОбъект.ВидДоговораДоверительногоУправления, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"));
		
	НормативОтСреднейСЧА = ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ
				Или	ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов И ЭтотОбъект.Период.ДатаНачала >= '20220101';
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	РезультатЗапроса = ПолучитьРезультатПоВарианту_СРОиЦК(МенеджерВременныхТаблиц, Отказ);
	
	Если Отказ = Истина Или РезультатЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Компоновка результата
	Если ЭтотОбъект.РежимОтбора = 2 И НормативОтСреднейСЧА Тогда
		
		ВыборкаСчетаДУ = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выбрать();
		
		Если ВыборкаСчетаДУ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Макет = ПолучитьМакет("МакетСРОиЦК_Сводный");
		
		ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");	
		ОбластьПодвал	= Макет.ПолучитьОбласть("Подвал");
		
		// Шапка
		ОбластьШапка.Параметры.ПредставлениеПериода			= ПредставлениеПериода; 
		ОбластьШапка.Параметры.ВидАктивов					= "целевых капиталов";
		ОбластьШапка.Параметры.Организация					= ЭтотОбъект.Организация;
		ОбластьШапка.Параметры.ВидДоговора					= "Управление активами целевых капиталов";
		
		ДокументРезультат.Вывести(ОбластьШапка);
		
		Сч = 1;
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			
			Если ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ " + СокрЛП(ВыборкаСчетаДУ.СчетДоверительногоУправления) + " не задан процент необходимых расходов", ВыборкаСчетаДУ.СчетДоверительногоУправления,,, Отказ);
				Возврат;
			КонецЕсли;
			
			// Строка
			ОбластьСтрока.Параметры.Заполнить(ВыборкаСчетаДУ);
			ОбластьСтрока.Параметры.НомерСтроки = Формат(Сч, "ЧГ=0");
			ДокументРезультат.Вывести(ОбластьСтрока);	
			
			Сч = Сч + 1;
												
		КонецЦикла;

		ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
		ДокументРезультат.Вывести(ОбластьПодвал);

	Иначе
		
		ВыборкаСчетаДУ = МенеджерВременныхТаблиц.Таблицы.Найти("_СчетаДоверительногоУправления").ПолучитьДанные().Выбрать();
		
		Если ВыборкаСчетаДУ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если НормативОтСреднейСЧА Тогда
			ДанныеОтчета = Новый Структура("Операции, ИтогоОперации, СредняяСЧА",
				РезультатЗапроса[РезультатЗапроса.ВГраница() - 2].Выгрузить(),
				РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить(),
				РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить()
			);
		Иначе		
				
			ДанныеОтчета = Новый Структура("Операции, ИтогоОперации, ИнвестиционныйДоход",
				РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить(),
				РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить(),
				МенеджерВременныхТаблиц.Таблицы.Найти("_Инвестиционныйдоход").ПолучитьДанные().Выгрузить()
			);	
		КонецЕсли;	
			
		// Компоновка отчета
		
		Макет = ПолучитьМакет("МакетСРОиЦК");
		
		ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
		ОбластьОперация	= Макет.ПолучитьОбласть("Операция");	
		ОбластьПодвал	= ?(НормативОтСреднейСЧА, Макет.ПолучитьОбласть("ПодвалСредняяСЧА"), Макет.ПолучитьОбласть("Подвал"));
		
		Пока ВыборкаСчетаДУ.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ " + СокрЛП(ВыборкаСчетаДУ.СчетДоверительногоУправления) + " не задан процент необходимых расходов", ВыборкаСчетаДУ.СчетДоверительногоУправления,,, Отказ);
				Возврат;
			КонецЕсли;

			Если ВыборкаСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций Тогда
				ВидАктивов = "саморегулируемых организаций";
			ИначеЕсли ВыборкаСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов Тогда
				ВидАктивов = "целевых капиталов";
			ИначеЕсли ВыборкаСчетаДУ.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ Тогда
				ВидАктивов = "ФОГФ";
			Иначе
				ВидАктивов = "_____________________";
			КонецЕсли;
		
			// Шапка
			
			ОбластьШапка.Параметры.ПредставлениеПериода			= ПредставлениеПериода; 
			ОбластьШапка.Параметры.ВидАктивов					= ВидАктивов;
			ОбластьШапка.Параметры.НомерИДатаДоговораДУ			= "№ " + СокрЛП(ВыборкаСчетаДУ.НомерДоговора) + " от " + Формат(ВыборкаСчетаДУ.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " г.";
			ОбластьШапка.Параметры.Организация					= ЭтотОбъект.Организация;
			ОбластьШапка.Параметры.СчетДоверительногоУправления	= ВыборкаСчетаДУ.СчетДоверительногоУправления;
			
			ДокументРезультат.Вывести(ОбластьШапка);
			
			// Операции
			
			НомерСтроки = 0;
			ИтогоРасходы = 0;
			НайдСтрокиОперации = ДанныеОтчета.Операции.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетаДУ.СчетДоверительногоУправления));
			Для Каждого Операция Из НайдСтрокиОперации Цикл
				НомерСтроки = НомерСтроки + 1;
				
				ОбластьОперация.Параметры.НомерСтроки = НомерСтроки;
				ОбластьОперация.Параметры.Заполнить(Операция);
				
				ИтогоРасходы = ИтогоРасходы + Операция.ИтогоРасходы;
				ДокументРезультат.Вывести(ОбластьОперация);
			КонецЦикла;
			
			// Итог операций
			НайдСтрокиИтогоОперации = ДанныеОтчета.ИтогоОперации.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетаДУ.СчетДоверительногоУправления));
			Для Каждого ИтогОпераций Из НайдСтрокиИтогоОперации Цикл
				Область = Макет.ПолучитьОбласть(ИтогОпераций.ОбластьМакета);
				
				Область.Параметры.Заполнить(ИтогОпераций);
				
				ДокументРезультат.Вывести(Область);
			КонецЦикла;
			
			// Подвал
			
			ОбластьПодвал.Параметры.ВидАктивов = ВидАктивов;
			
			Если НормативОтСреднейСЧА Тогда
				
				НайдСтрокиСредняяСЧА = ДанныеОтчета.СредняяСЧА.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетаДУ.СчетДоверительногоУправления));
				Если НайдСтрокиСредняяСЧА.Количество() > 0 Тогда
					Если НайдСтрокиСредняяСЧА[0].НормативНеобходимыхРасходов = "-" Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ " + СокрЛП(ВыборкаСчетаДУ.СчетДоверительногоУправления) + " не задан процент необходимых расходов", ВыборкаСчетаДУ.СчетДоверительногоУправления,,, Отказ);
						Возврат;
					КонецЕсли;
					ОбластьПодвал.Параметры.Заполнить(НайдСтрокиСредняяСЧА[0]);
					ОбластьПодвал.Параметры.СуммаПревышенияНорматива = ?(ОбластьПодвал.Параметры.СуммаПревышенияНорматива < 0, 0, ОбластьПодвал.Параметры.СуммаПревышенияНорматива);
				КонецЕсли;
			
			Иначе
				
				НайдСтрокиИнвестиционныйДоход = ДанныеОтчета.ИнвестиционныйДоход.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыборкаСчетаДУ.СчетДоверительногоУправления));
				Если НайдСтрокиИнвестиционныйДоход.Количество() > 0 Тогда
						
					ОбластьПодвал.Параметры.СправочноСуммаДохода = НайдСтрокиИнвестиционныйДоход[0].СуммаВВалютеРасчета;
					ОбластьПодвал.Параметры.СправочноИтогоРасходы = ИтогоРасходы;
					ОбластьПодвал.Параметры.ПроцентНеобходимыхРасходов = ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов;
					СправочноДоляРасходовДоходе = Окр(НайдСтрокиИнвестиционныйДоход[0].СуммаВВалютеРасчета * ВыборкаСчетаДУ.ПроцентНеобходимыхРасходов / 100, 2, 1);
					ОбластьПодвал.Параметры.СправочноДоляРасходовДоходе = СправочноДоляРасходовДоходе;
					ОбластьПодвал.Параметры.СуммаПревышенияНорматива = ?(ИтогоРасходы > СправочноДоляРасходовДоходе, ИтогоРасходы - СправочноДоляРасходовДоходе, 0);
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
			ДокументРезультат.Вывести(ОбластьПодвал);
			
			ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла;

	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьОтчетПоВарианту_Сводный(ДокументРезультат, Отказ)
		
	ПредставлениеПериода	= ?(ЭтотОбъект.НакопительныйИтог, Строка(ЭтотОбъект.Период), ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));	
				
	Макет = ПолучитьМакет("МакетСводный");
		
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");	
		
	Результат = ПолучитьДанныеДляУведомлений( , Отказ);
	
	ОбластьШапка.Параметры.ПредставлениеПериода = ПредставлениеПериода;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	Сч = 1;
	Для Каждого СтрокаРезультата Из Результат Цикл
		
		ОбластьСтрока.Параметры.Заполнить(СтрокаРезультата);
		ОбластьСтрока.Параметры.НПП = Формат(Сч, "ЧДЦ=0; ЧГ=0");
		ОбластьСтрока.Параметры.УК = СокрЛП(ЭтотОбъект.Организация);
		ОбластьСтрока.Параметры.ОстатокНорматива = ?(СтрокаРезультата.НормативРасходов - СтрокаРезультата.ИтогоРасходы <= 0, 0, СтрокаРезультата.НормативРасходов - СтрокаРезультата.ИтогоРасходы); 
		ДокументРезультат.Вывести(ОбластьСтрока);
		Сч = Сч + 1;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ПолучитьРезультатПоВарианту_СРОиЦК(МенеджерВременныхТаблиц, Отказ)
	
	// Данные отчета
	
	Запрос = Новый Запрос; 	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
	Запрос.УстановитьПараметр("Организация",							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",			ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Клиент",									ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления",	ЭтотОбъект.ВидДоговораДоверительногоУправления);
	Запрос.УстановитьПараметр("РежимОтбора",							ЭтотОбъект.РежимОтбора);
	Запрос.УстановитьПараметр("НачалоПериода",							ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",							ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаРасчета",							ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ВалютаРубли",							ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеОрганизации,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	КлиентыДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|	УсловияДоговоровДоверительногоУправленияСрезПоследних.НеобходимыеРасходы КАК ПроцентНеобходимыхРасходов,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Наименование КАК НаименованиеПортфеля,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.КодСчета КАК КодСчетаДУ
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ДатаЗаключения <= &КонецПериода
		|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения >= &КонецПериода)
		|				И ВЫБОР
		|					КОГДА &РежимОтбора = 0
		|						ТОГДА СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					ИНАЧЕ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
		|				КОНЕЦ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Организация.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровДоверительногоУправления.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияДоговоровДоверительногоУправленияСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = УсловияДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &РежимОтбора = 1
		|				ТОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.Выполнить();
	
	СчетаДоверительногоУправления = Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выгрузить();
	
	Если СчетаДоверительногоУправления.Количество() = 0 Тогда		
		Возврат Неопределено;
	КонецЕсли;
	
	РаботаСОтчетами.ДобавитьДанныеПоБазеРасчетаВЗапрос(Запрос, Новый Структура("НачалоПериода, КонецПериода", ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания), "_СчетаДоверительногоУправления", "_ИнвестиционныйДоход", Отказ);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	Справочники.НастройкиРегламентныхДействий.ПоместитьДатыДействияЗаПериодВоВременнуюТаблицу(Запрос, Новый Структура("ВидДействия, ДатаС, ДатаПо, ДополнитьРабочимиДнями", "СЧА", ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, Ложь));

	ТекВидДоговора = ?(ЭтотОбъект.РежимОтбора = 1 Или ЭтотОбъект.РежимОтбора = 2, ЭтотОбъект.ВидДоговораДоверительногоУправления, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления"));
		
	НормативОтСреднейСЧА = ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ
				Или ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов И ЭтотОбъект.Период.ДатаНачала >= '20220101';

	ПолучитьДанныеСЧА(Запрос, Ложь); 
	
	Если ЭтотОбъект.РежимОтбора = 2 И НормативОтСреднейСЧА Тогда
		
		#Область Режим_по_виду_договора	
	
		#Область Текст_запроса
	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
			|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
			|	ЗадолженностиПоДенежнымСредствам.НомерСтроки КАК НомерСтроки,
			|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
