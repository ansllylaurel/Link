				|			_РазнесенныеОперации.СчетДоверительногоУправления) КАК ВсеРасходы
				|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = ВсеРасходы.СчетДоверительногоУправления
				|		ЛЕВОЕ СОЕДИНЕНИЕ _РасходыВключенныеВСтоимость КАК _РасходыВключенныеВСтоимость
				|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _РасходыВключенныеВСтоимость.СчетДоверительногоУправления";
			
	Иначе
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,			
			|	СУММА(ЕСТЬNULL(_РазнесенныеОперации.РасходыСвязанныеСОсуществлениемПравПоЦеннымБумагам, 0)) КАК ИтогоРасходыСвязанныеСОсуществлениемПравПоЦеннымБумагам,
			|	СУММА(ЕСТЬNULL(_РазнесенныеОперации.РасходыНаУслугиПоДоговоруБанковскогоСчета, 0)) КАК ИтогоРасходыНаУслугиПоДоговоруБанковскогоСчета,
			|	СУММА(ЕСТЬNULL(_РазнесенныеОперации.РасходыНаУслугиПоДоговоруОБрокерскомОбслуживании, 0)) КАК ИтогоРасходыНаУслугиПоДоговоруОБрокерскомОбслуживании,
			|	СУММА(ЕСТЬNULL(_РазнесенныеОперации.РасходыНаУслугиПоДоговоруОбОказанииУслугПоХранениюИмущества, 0)) КАК ИтогоРасходыНаУслугиПоДоговоруОбОказанииУслугПоХранениюИмущества,
			|	СУММА(ЕСТЬNULL(_РазнесенныеОперации.ИтогоРасходы, 0)) КАК ИтогоИтогоРасходыПоОперации
			|ПОМЕСТИТЬ _ИтогоОперации
			|ИЗ
			|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ _РазнесенныеОперации КАК _РазнесенныеОперации
			|		ПО _СчетаДоверительногоУправления.СчетДоверительногоУправления = _РазнесенныеОперации.СчетДоверительногоУправления
			|
			|СГРУППИРОВАТЬ ПО
			|	_СчетаДоверительногоУправления.СчетДоверительногоУправления";

	КонецЕсли;	
	
	Запрос.Выполнить();
	
	Запрос.Текст = 			
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СредняяСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(СредняяСЧА.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ВЫРАЗИТЬ(СредняяСЧА.СчетДоверительногоУправления КАК Справочник.СчетаДоверительногоУправления).КодСчета КАК КодСчетаДУ,
		|	СредняяСЧА.Сумма КАК СправочноСредняяСЧА,
		|	ЕСТЬNULL(ИтогоРасходы.Сумма, 0) КАК СправочноИтогоРасходы,
		|	ВЫБОР
		|		КОГДА СредняяСЧА.Сумма = 0
		|			ТОГДА ""-""
		|		ИНАЧЕ ЕСТЬNULL(ИтогоРасходы.Сумма / СредняяСЧА.Сумма, 0)
		|	КОНЕЦ КАК СправочноДоляРасходовВСЧА,
		|	ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) КАК ПроцентНеобходимыхРасходов,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) = 0
		|			ТОГДА ""-""
		|		ИНАЧЕ ВЫРАЗИТЬ(СредняяСЧА.Сумма * _СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов / 100 КАК ЧИСЛО(19, 2))
		|	КОНЕЦ КАК НормативНеобходимыхРасходов,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ИтогоРасходы.Сумма, 0) - (ВЫРАЗИТЬ(СредняяСЧА.Сумма * _СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов / 100 КАК ЧИСЛО(19, 2)))
		|	КОНЕЦ КАК СуммаПревышенияНорматива
		|ПОМЕСТИТЬ _СредняяСЧА
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СЧАПоДням.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		СРЕДНЕЕ(ЕСТЬNULL(_СЧАПоДням.Сумма, 0)) КАК Сумма
		|	ИЗ
		|		_СЧАПоДням КАК _СЧАПоДням
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СЧАПоДням.СчетДоверительногоУправления) КАК СредняяСЧА
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Операции.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			ЕСТЬNULL(СУММА(_Операции.Сумма), 0) КАК Сумма
		|		ИЗ
		|			_Операции КАК _Операции
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Операции.СчетДоверительногоУправления) КАК ИтогоРасходы
		|		ПО СредняяСЧА.СчетДоверительногоУправления = ИтогоРасходы.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО СредняяСЧА.СчетДоверительногоУправления = _СчетаДоверительногоУправления.СчетДоверительногоУправления";
		
	#КонецОбласти
				
	РезультатЗапроса = Запрос.Выполнить();
		
КонецПроцедуры
	
Функция ПолучитьРезультатПоВарианту_Основной(МенеджерВременныхТаблиц, ТребуетсяРасшифровкаРасходов, ВидыДоговоровДоверительногоУправления = Неопределено)
	
	СтатусыВыполнения = Новый Структура("ОбработкаНеТребуется, Отказ", Истина, Ложь);
	ПоместитьДанныеОтчетаПоНПФВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ТребуетсяРасшифровкаРасходов, СтатусыВыполнения, ВидыДоговоровДоверительногоУправления);
	
	Если СтатусыВыполнения.Отказ Или СтатусыВыполнения.ОбработкаНеТребуется Тогда
		Возврат СтатусыВыполнения;
	КонецЕсли;
	
	_ОперацииСтроки = МенеджерВременныхТаблиц.Таблицы.Получить("_ОперацииСтроки").ПолучитьДанные().Выгрузить();
	_ОперацииСтроки.Сортировать("Период");
		
	ДанныеОтчета = Новый Структура("Операции, ИтогоОперации, СредняяСЧА",
		_ОперацииСтроки,		
		МенеджерВременныхТаблиц.Таблицы.Получить("_ИтогоОперации").ПолучитьДанные().Выгрузить(),
		МенеджерВременныхТаблиц.Таблицы.Получить("_СредняяСЧА").ПолучитьДанные().Выгрузить()
	);	
	
	Отказ = Ложь;
	ПроверитьЗарегистрированныеСЧАЗаПериод(МенеджерВременныхТаблиц, "_СЧАПоДням", "_ДатыПоследнейСЧА", "Средняя СЧА", Отказ);
		
	Если Отказ Тогда
		СтатусыВыполнения.Вставить("Отказ", Отказ);
		Возврат СтатусыВыполнения;
	КонецЕсли;
	
	Возврат ДанныеОтчета;
	
КонецФункции

Функция ПолучитьРезультатПоВарианту_ПоКлиентуИВидуДоговораВЦелом(МенеджерВременныхТаблиц)
	
	// Используем готовую процедуру
	СтатусыВыполнения = Новый Структура("ОбработкаНеТребуется, Отказ", Истина, Ложь);
	ПоместитьДанныеОтчетаПоНПФВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, Истина, СтатусыВыполнения, , Ложь);
	
	Если СтатусыВыполнения.Отказ Или СтатусыВыполнения.ОбработкаНеТребуется Тогда
		Возврат СтатусыВыполнения;
	КонецЕсли;
	
	// Осталось убрать из таблиц группировку по счетам ДУ, чтобы получить общие суммы по клиенту
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 			
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииСтроки.ПредставлениеОперации КАК ПредставлениеОперации,
		|	_ОперацииСтроки.Период КАК Период,
		|	СУММА(_ОперацииСтроки.РасходыСвязанныеСОсуществлениемПравПоЦеннымБумагам) КАК РасходыСвязанныеСОсуществлениемПравПоЦеннымБумагам,
		|	СУММА(_ОперацииСтроки.РасходыНаУслугиПоДоговоруБанковскогоСчета) КАК РасходыНаУслугиПоДоговоруБанковскогоСчета,
		|	СУММА(_ОперацииСтроки.РасходыНаУслугиПоДоговоруОБрокерскомОбслуживании) КАК РасходыНаУслугиПоДоговоруОБрокерскомОбслуживании,
		|	СУММА(_ОперацииСтроки.РасходыНаУслугиПоДоговоруОбОказанииУслугПоХранениюИмущества) КАК РасходыНаУслугиПоДоговоруОбОказанииУслугПоХранениюИмущества,
		|	СУММА(_ОперацииСтроки.ИтогоРасходы) КАК ИтогоРасходы
		|ПОМЕСТИТЬ _ОперацииПоКлиенту
		|ИЗ
		|	_ОперацииСтроки КАК _ОперацииСтроки
		|ГДЕ
		|	НЕ _ОперацииСтроки.ПредставлениеОперации ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОперацииСтроки.ПредставлениеОперации,
		|	_ОперацииСтроки.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтогоОперации.ОбластьМакета КАК ОбластьМакета,
		|	_ИтогоОперации.ИтогоПоказатель КАК ИтогоПоказатель,
		|	СУММА(ЕСТЬNULL(_ИтогоОперации.ИтогоРасходыСвязанныеСОсуществлениемПравПоЦеннымБумагам, 0)) КАК ИтогоРасходыСвязанныеСОсуществлениемПравПоЦеннымБумагам,
		|	СУММА(ЕСТЬNULL(_ИтогоОперации.ИтогоРасходыНаУслугиПоДоговоруБанковскогоСчета, 0)) КАК ИтогоРасходыНаУслугиПоДоговоруБанковскогоСчета,
		|	СУММА(ЕСТЬNULL(_ИтогоОперации.ИтогоРасходыНаУслугиПоДоговоруОБрокерскомОбслуживании, 0)) КАК ИтогоРасходыНаУслугиПоДоговоруОБрокерскомОбслуживании,
		|	СУММА(ЕСТЬNULL(_ИтогоОперации.ИтогоРасходыНаУслугиПоДоговоруОбОказанииУслугПоХранениюИмущества, 0)) КАК ИтогоРасходыНаУслугиПоДоговоруОбОказанииУслугПоХранениюИмущества,
		|	СУММА(ЕСТЬNULL(_ИтогоОперации.ИтогоИтогоРасходыПоОперации, 0)) КАК ИтогоИтогоРасходыПоОперации
		|ПОМЕСТИТЬ _ИтогоОперацииПоКлиенту
		|ИЗ
		|	_ИтогоОперации КАК _ИтогоОперации
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИтогоОперации.ОбластьМакета,
		|	_ИтогоОперации.ИтогоПоказатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СредняяСЧА.Сумма КАК СправочноСредняяСЧА,
		|	ЕСТЬNULL(ИтогоРасходы.Сумма, 0) КАК СправочноИтогоРасходы,
		|	ВЫБОР
		|		КОГДА СредняяСЧА.Сумма = 0
		|			ТОГДА ""-""
		|		ИНАЧЕ ЕСТЬNULL(ИтогоРасходы.Сумма / СредняяСЧА.Сумма, 0)
		|	КОНЕЦ КАК СправочноДоляРасходовВСЧА,
		|	ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) КАК ПроцентНеобходимыхРасходов,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) = 0
		|			ТОГДА ""-""
		|		ИНАЧЕ ВЫРАЗИТЬ(СредняяСЧА.Сумма * _СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов / 100 КАК ЧИСЛО(19, 2))
		|	КОНЕЦ КАК НормативНеобходимыхРасходов,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ИтогоРасходы.Сумма, 0) - (ВЫРАЗИТЬ(СредняяСЧА.Сумма * _СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов / 100 КАК ЧИСЛО(19, 2)))
		|	КОНЕЦ КАК СуммаПревышенияНорматива
		|ПОМЕСТИТЬ _СредняяСЧАПоКлиенту
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов КАК ПроцентНеобходимыхРасходов
		|	ИЗ
		|		_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления) КАК _СчетаДоверительногоУправления,
		|	(ВЫБРАТЬ
		|		СУММА(СредняяСЧАПоСчетамДУ.Сумма) КАК Сумма
		|	ИЗ
		|		(ВЫБРАТЬ
		|			_СЧАПоДням.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			СРЕДНЕЕ(ЕСТЬNULL(_СЧАПоДням.Сумма, 0)) КАК Сумма
		|		ИЗ
		|			_СЧАПоДням КАК _СЧАПоДням
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_СЧАПоДням.СчетДоверительногоУправления) КАК СредняяСЧАПоСчетамДУ) КАК СредняяСЧА,
		|	(ВЫБРАТЬ
		|		ЕСТЬNULL(СУММА(_Операции.Сумма), 0) КАК Сумма
		|	ИЗ
		|		_Операции КАК _Операции) КАК ИтогоРасходы";
	
	Запрос.Выполнить();
	
	Операции = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОперацииПоКлиенту"].ПолучитьДанные().Выгрузить();
	Операции.Сортировать("Период");
	
	ДанныеОтчета = Новый Структура("Операции,ИтогоОперации,СредняяСЧА",
							Операции,
							Запрос.МенеджерВременныхТаблиц.Таблицы["_ИтогоОперацииПоКлиенту"].ПолучитьДанные().Выгрузить(),
							Запрос.МенеджерВременныхТаблиц.Таблицы["_СредняяСЧАПоКлиенту"].ПолучитьДанные().Выгрузить());
	                               	
	Если СтавкиНеобходимыхРасходовРазличаются(Запрос.МенеджерВременныхТаблиц) Тогда  								
		СтатусыВыполнения.Вставить("Отказ", Истина);						
		Возврат СтатусыВыполнения;
	КонецЕсли;

	Возврат ДанныеОтчета;
	
КонецФункции

Процедура СформироватьОтчетПоВарианту_Основной(ДокументРезультат, ТребуетсяРасшифровкаРасходов, Отказ)
	
	ПредставлениеПериода	= ?(ЭтотОбъект.НакопительныйИтог, Строка(ЭтотОбъект.Период), ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));
	Год						= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=yyyy");	
					
	// Данные отчета
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ДанныеОтчета = ПолучитьРезультатПоВарианту_Основной(МенеджерВременныхТаблиц, ТребуетсяРасшифровкаРасходов);
	
	Если ДанныеОтчета.Свойство("Отказ") И ДанныеОтчета.Отказ Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ДанныеОтчета.Свойство("ОбработкаНеТребуется") И ДанныеОтчета.ОбработкаНеТребуется Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаСчетовДУ = МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выбрать();
	
	// Компоновка отчета
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьОперация	= Макет.ПолучитьОбласть("Операция");	
	ОбластьПодвал	= Макет.ПолучитьОбласть("Подвал");
	
	// Шапка
	Пока ВыборкаСчетовДУ.Следующий() Цикл
				
		ТекСчетДУ = ВыборкаСчетовДУ.СчетДоверительногоУправления;
					
		Если Не БухгалтерскийУчет.ВедетсяУчетЕПС(?(ВыборкаСчетовДУ.ДатаЗаключения < ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаНачала, ВыборкаСчетовДУ.ДатаЗаключения), ЭтотОбъект.Организация, ТекСчетДУ) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Учет по ЕПС на " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " для """ + Строка(ТекСчетДУ) + """ еще не велся. Расходы, включенные в стоимость приобретенных активов, рассчитаны не будут", ЭтотОбъект, , "Отчет.Период.ДатаНачала");	
		КонецЕсли;
		
		ТекВидДоговора = ВыборкаСчетовДУ.ВидДоговораДоверительногоУправления; 
		Если ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			ВидАктивов = "пенсионных накоплений";
		ИначеЕсли ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
			ВидАктивов = "пенсионных резервов";
		Иначе
			ВидАктивов = "_____________________";
		КонецЕсли;
	
		// Данные шапки	                                                            	
		НомерИДатаДоговораДУ	= СтрШаблон("№ %1 от %2", ВыборкаСчетовДУ.НомерДоговора, Формат(ВыборкаСчетовДУ.ДатаЗаключения, "ДФ='«dd» MMMM yyyy ''года'''"));
	                                                                            	
		ОбластьШапка.Параметры.ПредставлениеПериода			= ПредставлениеПериода; 
		ОбластьШапка.Параметры.ВидАктивов					= ВидАктивов;
		ОбластьШапка.Параметры.СчетДоверительногоУправления	= ТекСчетДУ;
		ОбластьШапка.Параметры.НомерИДатаДоговораДУ			= НомерИДатаДоговораДУ;
		ОбластьШапка.Параметры.Организация					= ЭтотОбъект.Организация;
				
		ДокументРезультат.Вывести(ОбластьШапка);
		
		// Операции
		НайдСтрокиОпераций = ДанныеОтчета.Операции.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ТекСчетДУ));
		
		НомерСтроки = 0;
		Для Каждого Операция Из НайдСтрокиОпераций Цикл
			НомерСтроки = НомерСтроки + 1;
			
			ОбластьОперация.Параметры.НомерСтроки = НомерСтроки;
			ОбластьОперация.Параметры.Заполнить(Операция);
			
			ДокументРезультат.Вывести(ОбластьОперация);
		КонецЦикла;
		
		// Итог операций
		
		НайдСтрокиИтогОпераций = ДанныеОтчета.ИтогоОперации.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ТекСчетДУ));
		Для Каждого ИтогОпераций Из НайдСтрокиИтогОпераций Цикл
			Область = Макет.ПолучитьОбласть(ИтогОпераций.ОбластьМакета);
			
			Область.Параметры.Заполнить(ИтогОпераций);
			Область.Параметры.ИтогоПоказатель = СтрЗаменить(Область.Параметры.ИтогоПоказатель, "[ВидАктивов]", ВидАктивов);
			
			ДокументРезультат.Вывести(Область);
		КонецЦикла;
		
		// Подвал
		
		ОбластьПодвал.Параметры.ВидАктивов = ВидАктивов;
		
		НайдСтрокиСредняяСЧА = ДанныеОтчета.СредняяСЧА.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ТекСчетДУ));
		Если НайдСтрокиСредняяСЧА.Количество() > 0 Тогда
			Если НайдСтрокиСредняяСЧА[0].НормативНеобходимыхРасходов = "-" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ " + СокрЛП(ТекСчетДУ) + " не задан процент необходимых расходов", ТекСчетДУ,,, Отказ);
				Возврат;
			КонецЕсли;
			ОбластьПодвал.Параметры.Заполнить(НайдСтрокиСредняяСЧА[0]);
			ОбластьПодвал.Параметры.СуммаПревышенияНорматива = ?(ОбластьПодвал.Параметры.СуммаПревышенияНорматива < 0, 0, ОбластьПодвал.Параметры.СуммаПревышенияНорматива);
		КонецЕсли;
		
		ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
		
		ДокументРезультат.Вывести(ОбластьПодвал);
		
		ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
			
КонецПроцедуры

Процедура СформироватьОтчетПоВарианту_ПоКлиентуИВидуДоговораВЦелом(ДокументРезультат, Отказ)

	ПредставлениеПериода	= ?(ЭтотОбъект.НакопительныйИтог, Строка(ЭтотОбъект.Период), ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания));
	Год						= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=yyyy");	
					
	// Данные отчета
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ДанныеОтчета = ПолучитьРезультатПоВарианту_ПоКлиентуИВидуДоговораВЦелом(МенеджерВременныхТаблиц);
	
	Если ДанныеОтчета.Свойство("Отказ") И ДанныеОтчета.Отказ Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ДанныеОтчета.Свойство("ОбработкаНеТребуется") И ДанныеОтчета.ОбработкаНеТребуется Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаСчетовДУ = МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выбрать();
	
	ПроверитьЗарегистрированныеСЧАЗаПериод(МенеджерВременныхТаблиц, "_СЧАПоДням", "_ДатыПоследнейСЧА", "Средняя СЧА", Отказ);
	
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	// Компоновка отчета
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьОперация	= Макет.ПолучитьОбласть("Операция");	
	ОбластьПодвал	= Макет.ПолучитьОбласть("Подвал");
	
	// Шапка
	Если Не ВыборкаСчетовДУ.Следующий() Тогда
		Возврат;	 	
	КонецЕсли;
	
	ПроцентНеобходимыхРасходов = ВыборкаСчетовДУ.ПроцентНеобходимыхРасходов;	
	Если ПроцентНеобходимыхРасходов = 0 Тогда		
		ЗарегистрироватьОшибку("Для счета ДУ " + СокрЛП(ВыборкаСчетовДУ.СчетДоверительногоУправления) + " не задан процент необходимых расходов");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекВидДоговора = ВыборкаСчетовДУ.ВидДоговораДоверительногоУправления; 
	Если ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ВидАктивов = "пенсионных накоплений";
	ИначеЕсли ТекВидДоговора = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда
		ВидАктивов = "пенсионных резервов";
	Иначе
		ВидАктивов = "_____________________";
	КонецЕсли;

	// Данные шапки                                                                            	
	ОбластьШапка.Параметры.ПредставлениеПериода			= ПредставлениеПериода; 
	ОбластьШапка.Параметры.ВидАктивов					= ВидАктивов;
	ОбластьШапка.Параметры.СчетДоверительногоУправления	= СокрЛП(Клиент);	
	ОбластьШапка.Параметры.Организация					= ЭтотОбъект.Организация;
			
	ДокументРезультат.Вывести(ОбластьШапка);
	
	// Операции	
	НомерСтроки = 0;
	Для Каждого Операция Из ДанныеОтчета.Операции Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ОбластьОперация.Параметры.НомерСтроки = НомерСтроки;
		ОбластьОперация.Параметры.Заполнить(Операция);
		
		ДокументРезультат.Вывести(ОбластьОперация);
	КонецЦикла;
	
	// Итог операций 		
	Для Каждого ИтогОпераций Из ДанныеОтчета.ИтогоОперации Цикл
		Область = Макет.ПолучитьОбласть(ИтогОпераций.ОбластьМакета);
		
		Область.Параметры.Заполнить(ИтогОпераций);
		Область.Параметры.ИтогоПоказатель = СтрЗаменить(Область.Параметры.ИтогоПоказатель, "[ВидАктивов]", ВидАктивов);
		
		ДокументРезультат.Вывести(Область);
	КонецЦикла;
	
	// Подвал	
	ОбластьПодвал.Параметры.ВидАктивов = ВидАктивов;
	       	
	Если ДанныеОтчета.СредняяСЧА.Количество() > 0 Тогда		
		ОбластьПодвал.Параметры.Заполнить(ДанныеОтчета.СредняяСЧА[0]);
		ОбластьПодвал.Параметры.СуммаПревышенияНорматива = ?(ОбластьПодвал.Параметры.СуммаПревышенияНорматива < 0, 0, ОбластьПодвал.Параметры.СуммаПревышенияНорматива);
	КонецЕсли;
	
	ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
	
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры	

Функция СтавкиНеобходимыхРасходовРазличаются(МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(_СчетаДоверительногоУправления.ПроцентНеобходимыхРасходов, 0) КАК НеобходимыеРасходы
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		
		ТекстСообщения = СтрШаблон("Необходимо проверить ставки необходимых расходов у договоров клиента '%1'. Обнаружены ставки: %2", ЭтотОбъект.Клиент, Символы.ПС);
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = ТекстСообщения + Формат(Выборка.НеобходимыеРасходы, "ЧДЦ=2; ЧРД=,; ЧН=0") + Символы.ПС;
		КонецЦикла;
		
		ЗарегистрироватьОшибку(ТекстСообщения);
		
		Возврат Истина;
		
	КонецЕсли;                                 	
	
	Возврат Ложь;
	
КонецФункции

Процедура СформироватьОтчетПоВарианту_Сафмар(ДокументРезультат, Отказ)
	          	
	// Данные отчета		
	
	Запрос = Новый Запрос;
	
	НетСчетовДУПоУсловиям = Ложь;
	УстановитьПараметрыИПолучитьКомиссии(Запрос, Отказ,, НетСчетовДУПоУсловиям);
	
	Если Отказ Или НетСчетовДУПоУсловиям Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПолучитьДанныеСЧА(Запрос);
	
	#Область Сафмар_Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.НомерСтроки КАК НомерСтроки,
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствам.Аванс КАК Аванс,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма,
		|	ЗадолженностиПоДенежнымСредствам.СуммаКупона КАК СуммаКупона
		|ПОМЕСТИТЬ _СторнирующиеЗаписи
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария))
		|	И ЗадолженностиПоДенежнымСредствам.Сумма <= 0
		|	И ЗадолженностиПоДенежнымСредствам.СуммаКупона <= 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СторнирующиеЗаписи.Основание КАК Основание,
		|	_СторнирующиеЗаписи.ТипЗадолженности КАК ТипЗадолженности,
		|	_СторнирующиеЗаписи.ВидЗадолженности КАК ВидЗадолженности,
		|	_СторнирующиеЗаписи.Организация КАК Организация,
		|	_СторнирующиеЗаписи.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СторнирующиеЗаписи.Валюта КАК Валюта,
		|	_СторнирующиеЗаписи.Контрагент КАК Контрагент,
		|	_СторнирующиеЗаписи.Аванс КАК Аванс,
		|	СУММА(_СторнирующиеЗаписи.Сумма) КАК Сумма,
		|	СУММА(_СторнирующиеЗаписи.СуммаКупона) КАК СуммаКупона
		|ПОМЕСТИТЬ _СторнированныеЗадолженности
		|ИЗ
		|	_СторнирующиеЗаписи КАК _СторнирующиеЗаписи
		|
		|СГРУППИРОВАТЬ ПО
		|	_СторнирующиеЗаписи.Основание,
		|	_СторнирующиеЗаписи.ТипЗадолженности,
		|	_СторнирующиеЗаписи.ВидЗадолженности,
		|	_СторнирующиеЗаписи.Организация,
		|	_СторнирующиеЗаписи.СчетДоверительногоУправления,
		|	_СторнирующиеЗаписи.Валюта,
		|	_СторнирующиеЗаписи.Контрагент,
		|	_СторнирующиеЗаписи.Аванс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент,
		|	СУММА(ВЫБОР
		|			КОГДА _СторнирующиеЗаписи.Регистратор ЕСТЬ НЕ NULL 
		|				ТОГДА 0
		|			КОГДА КурсВалютыОперации.Валюта = Организации.ВалютаУчета
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона + ЕСТЬNULL(_СторнированныеЗадолженности.Сумма, 0) + ЕСТЬNULL(_СторнированныеЗадолженности.СуммаКупона, 0)
		|			ИНАЧЕ (ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона + ЕСТЬNULL(_СторнированныеЗадолженности.Сумма, 0) + ЕСТЬNULL(_СторнированныеЗадолженности.СуммаКупона, 0)) * КурсВалютыОперации.Курс / КурсВалютыОперации.Кратность / КурсВалютыУчета.Курс * КурсВалютыУчета.Кратность
		|		КОНЕЦ) КАК Сумма
		|ПОМЕСТИТЬ _РасходыРазвернуто
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|		ПО (Организации.Ссылка = &Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СторнирующиеЗаписи КАК _СторнирующиеЗаписи
		|		ПО (_СторнирующиеЗаписи.Регистратор = ЗадолженностиПоДенежнымСредствам.Регистратор)
