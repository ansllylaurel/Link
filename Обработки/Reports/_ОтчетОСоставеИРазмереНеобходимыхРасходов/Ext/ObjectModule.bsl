		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС))
		|			ТОГДА 1
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ТОГДА 2
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			ТОГДА 3
		|	КОНЕЦ КАК Категория,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС))
		|			ТОГДА ""Расходы по договору банковского обслуживания""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ТОГДА ""Расходы по договору брокерского обслуживания"" + ЕСТЬNULL("" ("" + РеквизитыКонтрагента.КраткоеНаименованиеПоУставу + "")"", ЕСТЬNULL("" ("" + ЗадолженностиПоДенежнымСредствам.Контрагент.Наименование + "")"", """"))
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			ТОГДА ""Расходы по договору брокерского обслуживания (ММВБ)""
		|	КОНЕЦ КАК Показатель,
		|	СУММА(ЗадолженностиПоДенежнымСредствам.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _Расходы
		|ИЗ
