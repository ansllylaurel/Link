&НаКлиенте
Процедура ВывестиНезвершенныеСделки(Excel, ДанныеОтчета, ТекущаяСтрока, ВидСделки)
	
	Лист1 = Excel.WorkSheets(1);
	
	Данные = ДанныеОтчета.Таблица_НезавершенныеСделки;
	
	МассивВалют = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если СтрокаДанных.ВидСделки = ВидСделки Тогда
			Если МассивВалют.Найти(СтрокаДанных.Валюта) = Неопределено Тогда
				МассивВалют.Добавить(СтрокаДанных.Валюта);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда
		СтрРаздел		= "Незавершенные сделки по покупке в USD";
		СтрЗаголовки	= "Бумага, ISIN, Количество, Цена покупки USD, Стоимость покупки USD, НКД при покупке USD, Общая сумма покупки (с НКД) USD, Дата сделки, Дата расчета";
	Иначе
		СтрРаздел		= "Незавершенные сделки по продаже в USD";
		СтрЗаголовки	= "Бумага, ISIN, Количество, Цена продажи USD, Стоимость продажи USD, НКД при продаже USD, Общая сумма продажи (с НКД) USD, Дата сделки, Дата расчета";
	КонецЕсли;
	
	Для Каждого Валюта Из МассивВалют Цикл
		Если СтрокаДанных.ВидСделки = ВидСделки Тогда
			
			ПодготовитьОбласть(Excel, ТекущаяСтрока, "A1:P5");
			
			Лист1.Cells(ТекущаяСтрока, 1).Value = СтрЗаменить(СтрРаздел, "USD", Валюта);
			
			ТекущаяСтрока = ТекущаяСтрока + 1;
			
			Заголовки = СтрРазделить(СтрЗаменить(СтрЗаголовки, "USD", Валюта), ",");
			
			Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
				Лист1.Cells(ТекущаяСтрока, Индекс + 1).Value = СокрЛП(Заголовки[Индекс]);
			КонецЦикла;
			
			ТекущаяСтрока = ТекущаяСтрока + 1;
			
			НачальнаяСтрока = ТекущаяСтрока;
			
			Для Каждого СтрокаДанных Из Данные Цикл
				Если СтрокаДанных.Валюта = Валюта Тогда
					
					Если НачальнаяСтрока <> ТекущаяСтрока Тогда
						Область = Лист1.Cells(ТекущаяСтрока - 1, 2);
						Область.EntireRow.Select();
						Область.EntireRow.Copy();
						Область.EntireRow.Insert();
					КонецЕсли;
					
					Лист1.Cells(ТекущаяСтрока, 1).Value = СтрокаДанных.ЦеннаяБумага;
					Лист1.Cells(ТекущаяСтрока, 2).Value = СтрокаДанных.ISIN;
					Лист1.Cells(ТекущаяСтрока, 3).Value = СтрокаДанных.КоличествоОстаток;
					Лист1.Cells(ТекущаяСтрока, 4).Value = СтрокаДанных.Цена;
					Лист1.Cells(ТекущаяСтрока, 5).FormulaLocal = Заменить("=C01*D01", ТекущаяСтрока);
					
					Лист1.Cells(ТекущаяСтрока, 6).Value = СтрокаДанных.СуммаКупонаОстаток;
					
					Лист1.Cells(ТекущаяСтрока, 7).FormulaLocal = Заменить("=E01+F01", ТекущаяСтрока);
					Лист1.Cells(ТекущаяСтрока, 8).Value = СтрокаДанных.ДатаСделки;
					Лист1.Cells(ТекущаяСтрока, 9).Value = СтрокаДанных.ДатаИсполнения;
					
					ТекущаяСтрока = ТекущаяСтрока + 1;
					
				КонецЕсли;
			КонецЦикла;
			
			Лист1.Cells(ТекущаяСтрока, 5).FormulaLocal = Заменить("=СУММ(E01:E02)", НачальнаяСтрока, ТекущаяСтрока - 1);
			Лист1.Cells(ТекущаяСтрока, 6).FormulaLocal = Заменить("=СУММ(F01:F02)", НачальнаяСтрока, ТекущаяСтрока - 1);
			Лист1.Cells(ТекущаяСтрока, 7).FormulaLocal = Заменить("=СУММ(G01:G02)", НачальнаяСтрока, ТекущаяСтрока - 1);
			
			ИмяФормулы	= "НезавершенныеСделки";
			Знак		= ?(ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"), "+", "-");
			ЯчейкаКурса = ?(Валюта = Строка(Отчет.Валюта), "", "*" + Строка(Валюта));
			
			ДобавитьВФормулу(ИмяФормулы, Заменить(Знак + "G01" + ЯчейкаКурса, ТекущаяСтрока));
			
		
			ТекущаяСтрока = ТекущаяСтрока + 1;

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПортфельЦБ(Excel, ДанныеОтчета, ТекущаяСтрока)
	
	Лист1 = Excel.WorkSheets(1);
	
	Данные = ДанныеОтчета.Таблица_ПортфельЦБ;
	
	МассивВалют = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если МассивВалют.Найти(СтрокаДанных.Валюта) = Неопределено Тогда
			МассивВалют.Добавить(СтрокаДанных.Валюта);
		КонецЕсли;
	КонецЦикла;
	
	СтрРаздел		= "Портфель ЦБ, USD";
	СтрЗаголовки	= "Бумага, ISIN, Количество, Из них в РЕПО, Цена на начало USD, Дата цены, Стоимость на начало (без НКД) USD, НКД на начало USD, Общая сумма на начало (с НКД) USD, Текущая оценка USD, НКД USD, Текущая стоимость (с НКД) USD, Доход от переоценки бумаг USD, Выплаченный НКД USD, Прибыль/Убыток по бумаге USD, НКД на 1 бумагу";
	
	Для Каждого Валюта Из МассивВалют Цикл
			
		ПодготовитьОбласть(Excel, ТекущаяСтрока, "A6:P10");
		
		Лист1.Cells(ТекущаяСтрока, 1).Value = СтрЗаменить(СтрРаздел, "USD", Валюта);
		
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
		Заголовки = СтрРазделить(СтрЗаменить(СтрЗаголовки, "USD", Валюта), ",");
		
		Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
			Лист1.Cells(ТекущаяСтрока, Индекс + 1).Value = СокрЛП(Заголовки[Индекс]);
		КонецЦикла;
		
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
		НачальнаяСтрока = ТекущаяСтрока;
		
		Для Каждого СтрокаДанных Из Данные Цикл
			Если СтрокаДанных.Валюта = Валюта Тогда
				
				Если НачальнаяСтрока <> ТекущаяСтрока Тогда
					Область = Лист1.Cells(ТекущаяСтрока - 1, 2);
					Область.EntireRow.Select();
					Область.EntireRow.Copy();
					Область.EntireRow.Insert();
				КонецЕсли;
				
				Лист1.Cells(ТекущаяСтрока, 1).Value = СтрокаДанных.Эмитент;
				Лист1.Cells(ТекущаяСтрока, 2).Value = СтрокаДанных.ISIN;
				Лист1.Cells(ТекущаяСтрока, 3).Value = СтрокаДанных.Количество;
				Лист1.Cells(ТекущаяСтрока, 4).Value = СтрокаДанных.ВРепо;
				Лист1.Cells(ТекущаяСтрока, 5).Value = СтрокаДанных.ЦенаПокупки;
				Лист1.Cells(ТекущаяСтрока, 6).Value = СтрокаДанных.ДатаЦены;
				
				Лист1.Cells(ТекущаяСтрока, 7).FormulaLocal = Заменить("=C01*E01", ТекущаяСтрока);
				
				Лист1.Cells(ТекущаяСтрока, 8).Value = СтрокаДанных.СтоимостьПокупкиКупона;
				
				Лист1.Cells(ТекущаяСтрока, 9).FormulaLocal = Заменить("=G01+H01", ТекущаяСтрока);
				
				Лист1.Cells(ТекущаяСтрока, 10).Value = СтрокаДанных.ЦенаТекущая;
				
				Лист1.Cells(ТекущаяСтрока, 11).FormulaLocal = Заменить("=C01*P01", ТекущаяСтрока);
				Лист1.Cells(ТекущаяСтрока, 12).FormulaLocal = Заменить("=C01*J01+K01", ТекущаяСтрока);
				Лист1.Cells(ТекущаяСтрока, 13).FormulaLocal = Заменить("=L01-I01", ТекущаяСтрока);
				
				Лист1.Cells(ТекущаяСтрока, 14).Value = СтрокаДанных.НКДНачисленный;
				
				Лист1.Cells(ТекущаяСтрока, 15).FormulaLocal = Заменить("=M01+N01", ТекущаяСтрока);
				
				Лист1.Cells(ТекущаяСтрока, 16).Value = СтрокаДанных.Купон;
				
				ТекущаяСтрока = ТекущаяСтрока + 1;
				
			КонецЕсли;
		КонецЦикла;
		
		Лист1.Cells(ТекущаяСтрока, 7).FormulaLocal = Заменить("=СУММ(G01:G02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 8).FormulaLocal = Заменить("=СУММ(H01:H02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 9).FormulaLocal = Заменить("=СУММ(I01:I02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 11).FormulaLocal = Заменить("=СУММ(K01:K02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 12).FormulaLocal = Заменить("=СУММ(L01:L02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 13).FormulaLocal = Заменить("=СУММ(M01:M02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 14).FormulaLocal = Заменить("=СУММ(N01:N02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		Лист1.Cells(ТекущаяСтрока, 15).FormulaLocal = Заменить("=СУММ(O01:O02)", НачальнаяСтрока, ТекущаяСтрока - 1);
		
		Если Валюта = Строка(Отчет.Валюта) Тогда
			ДобавитьВФормулу("ТекущаяСтоимостьКупленныхЦБ", Заменить("+L01", ТекущаяСтрока));
		Иначе
			ДобавитьВФормулу("ТекущаяСтоимостьКупленныхЦБ", Заменить("+L01*" + Строка(Валюта), ТекущаяСтрока));
		КонецЕсли;
		
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиРепо(Excel, ДанныеОтчета, ТекущаяСтрока, ВидСделки, СделкаЗаключена = Истина)
	
	Лист1 = Excel.WorkSheets(1);
	
	Данные = ДанныеОтчета.Таблица_РЕПО;
	
	МассивВалют = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если СтрокаДанных.ВидСделки = ВидСделки И СтрокаДанных.СделкаЗаключена = СделкаЗаключена Тогда
			Если МассивВалют.Найти(СтрокаДанных.Валюта) = Неопределено Тогда
				МассивВалют.Добавить(СтрокаДанных.Валюта);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка") Тогда
		СтрРаздел = ?(СделкаЗаключена, "Обратное", "Планируемое обратное") + " РЕПО (цб получены по РЕПО), USD";
	Иначе
		СтрРаздел = ?(СделкаЗаключена, "Прямое", "Планируемое прямое") + " РЕПО (цб отданы в РЕПО), USD";
	КонецЕсли;
	
	СтрЗаголовки	= "Бумага; ISIN; Количество; Стоимость 1 части РЕПО USD; Стоимость 2 части РЕПО USD; Дата второй части РЕПО; Доход/расход от операции РЕПО USD; Ставка РЕПО, %";
		
	Для Каждого Валюта Из МассивВалют Цикл
		Если СтрокаДанных.ВидСделки = ВидСделки И СтрокаДанных.СделкаЗаключена = СделкаЗаключена Тогда
			
			ПодготовитьОбласть(Excel, ТекущаяСтрока, "A11:P15");
			
			Лист1.Cells(ТекущаяСтрока, 1).Value = СтрЗаменить(СтрРаздел, "USD", Валюта);
			
			ТекущаяСтрока = ТекущаяСтрока + 1;
			
			Заголовки = СтрРазделить(СтрЗаменить(СтрЗаголовки, "USD", Валюта), ";");
			
			Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
				Лист1.Cells(ТекущаяСтрока, Индекс + 1).Value = СокрЛП(Заголовки[Индекс]);
			КонецЦикла;
			
			ТекущаяСтрока = ТекущаяСтрока + 1;
			
			НачальнаяСтрока = ТекущаяСтрока;
			
			Для Каждого СтрокаДанных Из Данные Цикл
				Если СтрокаДанных.Валюта = Валюта Тогда
					
					Если НачальнаяСтрока <> ТекущаяСтрока Тогда
						Область = Лист1.Cells(ТекущаяСтрока - 1, 2);
						Область.EntireRow.Select();
						Область.EntireRow.Copy();
						Область.EntireRow.Insert();
					КонецЕсли;
					
					Лист1.Cells(ТекущаяСтрока, 1).Value = СтрокаДанных.Эмитент;
					Лист1.Cells(ТекущаяСтрока, 2).Value = СтрокаДанных.ISIN;
					Лист1.Cells(ТекущаяСтрока, 3).Value = СтрокаДанных.Количество;
					Лист1.Cells(ТекущаяСтрока, 4).Value = СтрокаДанных.СтоимостьПервойЧасти;
					Лист1.Cells(ТекущаяСтрока, 5).Value = СтрокаДанных.СтоимостьВторойЧасти;
					Лист1.Cells(ТекущаяСтрока, 6).Value = СтрокаДанных.ДатаВторойЧасти;
					
					Лист1.Cells(ТекущаяСтрока, 7).FormulaLocal = Заменить("=D01-E01", ТекущаяСтрока);
					
					Лист1.Cells(ТекущаяСтрока, 8).Value = СтрокаДанных.СтавкаРЕПО;
					
					ТекущаяСтрока = ТекущаяСтрока + 1;
					
				КонецЕсли;
			КонецЦикла;
			
			Лист1.Cells(ТекущаяСтрока, 4).FormulaLocal = Заменить("=СУММ(D01:D02)", НачальнаяСтрока, ТекущаяСтрока - 1);
			Лист1.Cells(ТекущаяСтрока, 5).FormulaLocal = Заменить("=СУММ(E01:E02)", НачальнаяСтрока, ТекущаяСтрока - 1);
			Лист1.Cells(ТекущаяСтрока, 7).FormulaLocal = Заменить("=СУММ(G01:G02)", НачальнаяСтрока, ТекущаяСтрока - 1);
			
			ИмяФормулы	= ?(ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"), "ДСПереданныеПоРЕПО", "ДСПолученныеПоРЕПО");
			Знак		= ?(ВидСделки = ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"), "+", "-");
			ЯчейкаКурса = ?(Валюта = Строка(Отчет.Валюта), "", "*" + Строка(Валюта));
			
			ДобавитьВФормулу(ИмяФормулы, Заменить(Знак + "E01" + ЯчейкаКурса, ТекущаяСтрока));
			
			ТекущаяСтрока = ТекущаяСтрока + 1;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСвопы(Excel, ДанныеОтчета, ТекущаяСтрока)
	
	Лист1 = Excel.WorkSheets(1);
	
	Данные = ДанныеОтчета.Таблица_Свопы;
	
	МассивВалют = Новый Массив;
		
	ПодготовитьОбласть(Excel, ТекущаяСтрока, "A16:P20");
	
	ТекущаяСтрока = ТекущаяСтрока + 2;
	НачальнаяСтрока = ТекущаяСтрока;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если НачальнаяСтрока <> ТекущаяСтрока Тогда
			Область = Лист1.Cells(ТекущаяСтрока - 1, 2);
			Область.EntireRow.Select();
			Область.EntireRow.Copy();
			Область.EntireRow.Insert();
		КонецЕсли;
		
		Если СтрокаДанных.ПоКурсуЦБ Тогда
			Лист1.Cells(ТекущаяСтрока, 1).Value = СтрокаДанных.Валюта + " (по курсу ЦБ)";
		Иначе
			Лист1.Cells(ТекущаяСтрока, 1).Value = СтрокаДанных.Валюта;
		КонецЕсли;
		
		Лист1.Cells(ТекущаяСтрока, 2).Value = СтрокаДанных.Сумма;
		Лист1.Cells(ТекущаяСтрока, 3).Value = СтрокаДанных.Курс;
		Лист1.Cells(ТекущаяСтрока, 4).FormulaLocal = Заменить("=B01*C01", ТекущаяСтрока);
		Лист1.Cells(ТекущаяСтрока, 5).Value = СтрокаДанных.ВалютаОплаты;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ДатаСделки) Тогда
			Лист1.Cells(ТекущаяСтрока, 6).Value = СтрокаДанных.ДатаСделки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ДатаИсполнения) Тогда
			Лист1.Cells(ТекущаяСтрока, 7).Value = СтрокаДанных.ДатаИсполнения;
		КонецЕсли;
		
		ЗаменитьВФормуле("НезавершенныеСделки"			, Строка(СтрокаДанных.Валюта), Заменить("C01", ТекущаяСтрока));
		ЗаменитьВФормуле("ТекущаяСтоимостьКупленныхЦБ"	, Строка(СтрокаДанных.Валюта), Заменить("C01", ТекущаяСтрока));
		ЗаменитьВФормуле("ДСПереданныеПоРЕПО"			, Строка(СтрокаДанных.Валюта), Заменить("C01", ТекущаяСтрока));
		ЗаменитьВФормуле("ДСПолученныеПоРЕПО"			, Строка(СтрокаДанных.Валюта), Заменить("C01", ТекущаяСтрока));
		                                
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
	КонецЦикла;
	
	Лист1.Cells(ТекущаяСтрока, 4).FormulaLocal = Заменить("=СУММ(D01:D02)", НачальнаяСтрока, ТекущаяСтрока - 1);
	
	ТекущаяСтрока = ТекущаяСтрока + 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиИтоги(Excel, ДанныеОтчета, ТекущаяСтрока)
	
	Лист1 = Excel.WorkSheets(1);
	
	УстановитьИтоговоеЗначение(Excel, 3, "Задолженность по сделкам, " + Строка(Отчет.Валюта), "НезавершенныеСделки");

	ТекущаяСтрока = ТекущаяСтрока + 2;
	
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Текущая стоимость купленных ЦБ, " + Строка(Отчет.Валюта)		, "ТекущаяСтоимостьКупленныхЦБ");
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Д/c, полученные по РЕПО, " + Строка(Отчет.Валюта)				, "ДСПолученныеПоРЕПО");
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока,  "Д/c, переданные по РЕПО, " + Строка(Отчет.Валюта)			, "ДСПереданныеПоРЕПО");
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Текущая СЧА портфеля, " + Строка(Отчет.Валюта)				,, "=B2+B3" + Заменить("+B01", ТекущаяСтрока - 3) + Заменить("-B01", ТекущаяСтрока - 2) + Заменить("+B01", ТекущаяСтрока - 1));
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Передано в ДУ. " + Строка(Отчет.Валюта)						, "ПереданоВДУ");
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Средняя стоимость вложенных активов, " + Строка(Отчет.Валюта)	, "СредняяСтоимостьАктивов");
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Срок управления, дней"										,, "=E1-B1+1");
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Общий доход, " + Строка(Отчет.Валюта)							,, "=" + Заменить("B01", ТекущаяСтрока - 4) + Заменить("-B01", ТекущаяСтрока - 3));
	
	Лист1.Cells(ТекущаяСтрока, 2).Value = ДанныеОтчета.ЗадолженностьПоНДФЛЗаТекущийГод;
	ТекущаяСтрока = ТекущаяСтрока + 1;
	
	ДнейВГодуСтр = Строка(ДеньГода(КонецГода(Отчет.Период.ДатаОкончания)));
	
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Доходность, % годовых"		,, "=(" + Заменить("B01", ТекущаяСтрока - 2) + Заменить("+B01)", ТекущаяСтрока - 1) + Заменить("/B01", ТекущаяСтрока - 4) + Заменить("/B01", ТекущаяСтрока - 3) + "*100*" + ДнейВГодуСтр);
	УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, "Чистая доходность, % годовых"	,, "=" + Заменить("B01", ТекущаяСтрока - 3) + Заменить("/B01", ТекущаяСтрока - 5) + Заменить("/B01", ТекущаяСтрока - 4) + "*100*" + ДнейВГодуСтр);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьИтоговоеЗначение(Excel, ТекущаяСтрока, Представление, ИмяФормулы = "", Формула = "")
	
	Лист1 = Excel.WorkSheets(1);

	Лист1.Cells(ТекущаяСтрока, 1).Value = Представление;
	
	Если ЗначениеЗаполнено(Формула) Тогда
		Лист1.Cells(ТекущаяСтрока , 2).FormulaLocal = Формула;	
	ИначеЕсли ЗначениеЗаполнено(Формулы[ИмяФормулы]) Тогда
		Лист1.Cells(ТекущаяСтрока , 2).FormulaLocal = "=" + Сред(Формулы[ИмяФормулы], 2);	
	Иначе
		Лист1.Cells(ТекущаяСтрока, 2).Value = 0;
	КонецЕсли;
	
	ТекущаяСтрока = ТекущаяСтрока + 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВФормулу(ИмяФормулы, Формула)
	
	Формула = Формулы[ИмяФормулы] + Формула;
	Формулы.Вставить(ИмяФормулы, Формула);

КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьВФормуле(ИмяФормулы, СтрокаПоиска, СтрокаЗамены)
	
	Формулы.Вставить(ИмяФормулы, СтрЗаменить(Формулы[ИмяФормулы], СтрокаПоиска, СтрокаЗамены));

КонецПроцедуры
	
&НаКлиенте
Процедура ПодготовитьОбласть(Excel, ТекущаяСтрока, АдресШаблона)

	Лист1 = Excel.WorkSheets(1);
	Excel.WorkSheets(1).Activate();
	
	ОбластьПолучатель = Лист1.Range(Заменить("A01:P02", ТекущаяСтрока, ТекущаяСтрока + 4));
	ОбластьПолучатель.EntireRow.Select();
	ОбластьПолучатель.EntireRow.Insert();
	
	Excel.WorkSheets(3).Range(АдресШаблона).Copy(Лист1.Range(Заменить("A01:P02", ТекущаяСтрока, ТекущаяСтрока + 4)));
	
	ТекущаяСтрока = ТекущаяСтрока + 1;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти






