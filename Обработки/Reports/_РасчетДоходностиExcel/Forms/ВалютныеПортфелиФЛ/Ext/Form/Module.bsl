&НаКлиенте
Процедура ВывестиДенежныеСредства(Excel, ДанныеОтчета, ТекущаяСтрока)
	
	Лист2 = Excel.WorkSheets(2);
	
	Лист2.Cells(ТекущаяСтрока, 4).Value = "Курс к " + Строка(Отчет.Валюта);
	Лист2.Cells(ТекущаяСтрока, 5).Value = "Сумма в " + Строка(Отчет.Валюта);
	
	ТекущаяСтрока = ТекущаяСтрока + 1;
	
	НачальнаяСтрока = ТекущаяСтрока;
	
	Для Индекс = 0 По ДанныеОтчета.Таблица_ДенежныеСредства.Количество() - 1 Цикл 
		СтрокаДанных = ДанныеОтчета.Таблица_ДенежныеСредства[Индекс];

		Если Индекс > 0 Тогда
			Область = Лист2.Cells(ТекущаяСтрока - 1, 2);
			Область.EntireRow.Select();
			Область.EntireRow.Copy();
			Область.EntireRow.Insert();
		КонецЕсли;
		
		Лист2.Cells(ТекущаяСтрока, 1).Value = СтрокаДанных.ВидЗадолженности;
		Лист2.Cells(ТекущаяСтрока, 1).HorizontalAlignment  = СтрокаДанных.ВидЗадолженностиВыравнивание;
		
		Лист2.Cells(ТекущаяСтрока, 2).Value = СтрокаДанных.Сумма;
		Лист2.Cells(ТекущаяСтрока, 3).Value = СтрокаДанных.Валюта;
		Лист2.Cells(ТекущаяСтрока, 4).Value = СтрокаДанных.Курс;
		
		Лист2.Cells(ТекущаяСтрока, 5).FormulaLocal = Заменить("=B01/D01", ТекущаяСтрока);
		
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
	КонецЦикла;
	
	Лист2.Cells(ТекущаяСтрока, 1).Value = "Итого сумма в " + Строка(Отчет.Валюта);
	Лист2.Cells(ТекущаяСтрока, 5).FormulaLocal = Заменить("=СУММ(E01:E02)", НачальнаяСтрока, ТекущаяСтрока - 1);
	
	Лист1 = Excel.WorkSheets(1);
	Лист1.Cells(2, 2).FormulaLocal = Заменить("='ДС и Вводы выводы'!E01", ТекущаяСтрока);
	
КонецПроцедуры

