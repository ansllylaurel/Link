#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЗаполнитьЗначенияСвойств(Отчет, Параметры);
	
	ШаблонExcel = РеквизитФормыВЗначение("Отчет").ПолучитьМакет(СтрРазделить(ЭтаФорма.ИмяФормы, ".")[3]); //Шаблон по имени формы
	
	ЗаполнитьФормулыПоУмолчанию();
	
	КонтрольДатыЗапретаРедактирования(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область Контроль

Процедура КонтрольДатыЗапретаРедактирования(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)
		|	И ДатыЗапретаРедактирования.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|	И ДатыЗапретаРедактирования.ДатаЗапретаРедактирования < НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)";
	
	Запрос.УстановитьПараметр("Организация"					, Отчет.СчетДоверительногоУправления.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отчет.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаОкончания"				, Отчет.Период.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счёту '" + Отчет.СчетДоверительногоУправления + "' не сформирован налоговый учёт, формирование отчёта невозможно. Дата запрета редактирования налогового учёта:" + Формат(Выборка.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"),,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеОтчета

&НаКлиенте
Процедура СформироватьОтчет() Экспорт

	ДанныеОтчета = ПолучитьДанныеОтчета();
	
	ИмяФайлаШаблонаExcel = ПолучитьИмяВременногоФайла("xlsx");

	ШаблонExcel.Записать(ИмяФайлаШаблонаExcel);
	
	// создадим документ MS Excel на основании сохраненного шаблона
	Excel = Новый COMОбъект("Excel.Application");
	Excel.Visible = Ложь;
	
	Excel.Workbooks.Open(ИмяФайлаШаблонаExcel);
	Excel.WorkSheets(2).Activate();

	ТекущаяСтрока = 1;
	
	ВывестиДенежныеСредства(Excel, ДанныеОтчета, ТекущаяСтрока);
	ВывестиВводыВыводы(Excel, ДанныеОтчета, ТекущаяСтрока);
	
	
	Excel.WorkSheets(1).Activate();
	
	ВывестиШапкуОтчета(Excel, ДанныеОтчета);
	
	ТекущаяСтрока = 4;
	
	ВывестиНезвершенныеСделки(Excel, ДанныеОтчета, ТекущаяСтрока, ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"));
	ВывестиНезвершенныеСделки(Excel, ДанныеОтчета, ТекущаяСтрока, ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа"));	
	
	ВывестиПортфельЦБ(Excel, ДанныеОтчета, ТекущаяСтрока);
	
	ВывестиРепо(Excel, ДанныеОтчета, ТекущаяСтрока, ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа"));
	ВывестиРепо(Excel, ДанныеОтчета, ТекущаяСтрока, ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"));
	
	ВывестиРепо(Excel, ДанныеОтчета, ТекущаяСтрока, ПредопределенноеЗначение("Перечисление.ВидыСделок.Продажа"), Ложь);
	ВывестиРепо(Excel, ДанныеОтчета, ТекущаяСтрока, ПредопределенноеЗначение("Перечисление.ВидыСделок.Покупка"), Ложь);
	
	ВывестиСвопы(Excel, ДанныеОтчета, ТекущаяСтрока);
	
	ВывестиИтоги(Excel, ДанныеОтчета, ТекущаяСтрока);
	
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаШаблонаExcel);
	Исключение
	КонецПопытки;
	
	Excel.Visible = True;

КонецПроцедуры

&НаКлиенте
Функция Заменить(Адрес, НачальнаяСтрока, КонечнаяСтрока = "")
	
	Возврат СтрЗаменить(СтрЗаменить(Адрес, 
					"01", Формат(НачальнаяСтрока, "ЧГ=0")), 
					"02", Формат(КонечнаяСтрока, "ЧГ=0"));
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеОтчета()
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Отчет, "Период,Организация,СчетДоверительногоУправления,Валюта", Новый Структура("ВариантОтчета", "ВалютныеПортфелиФЛ"));
	Механизм = РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДанныеОтчета = Новый Структура;
	
	ДанныеОтчета.Вставить("ДатаНачалаСтратегии"	, Отчет.Период.ДатаНачала);
	ДанныеОтчета.Вставить("ДатаОтчета"			, Отчет.Период.ДатаОкончания);
	ДанныеОтчета.Вставить("ВалютаОтчета"		, Строка(Отчет.Валюта));
	ДанныеОтчета.Вставить("Субпортфель"			, Отчет.Валюта.НаименованиеПолное);
	
	ДанныеОтчета.Вставить("ВознаграждениеУК", 0);
	ДанныеОтчета.Вставить("НДФЛ"			, 0);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация"					, Отчет.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отчет.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Валюта"						, Отчет.Валюта);
	Запрос.УстановитьПараметр("Bloomberg"					, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("СтоимостьПортфеляНаНачало"	, 0);
	
	#Область СтоимостьПортфеляНаНачало
	
	Запрос.УстановитьПараметр("ДатаНачала"					, Отчет.Период.ДатаНачала - 1);
	Запрос.УстановитьПараметр("ДатаОкончания"				, Отчет.Период.ДатаНачала - 1);
	Запрос.УстановитьПараметр("ГраницаДатыОкончания"		, Новый Граница(Отчет.Период.ДатаНачала - 1, ВидГраницы.Включая));
	
	Запрос.Текст = ПолучитьТекстЗапросаОстатки();
	
	Запрос.Выполнить();
	
	Запрос.УстановитьПараметр("СтоимостьПортфеляНаНачало", Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Итог").ПолучитьДанные().Выгрузить().Итог("СуммаВВалютеОтчета"));
	
	#КонецОбласти
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала"			, Отчет.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"		, Отчет.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ГраницаДатыОкончания", Новый Граница(Отчет.Период.ДатаОкончания, ВидГраницы.Включая));
	
	Запрос.Выполнить();
	
	ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, "Таблица_ДенежныеСредства", "Валюта,ВидЗадолженности");
	ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, "Таблица_ВводыВыводы", "Период");
	ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, "Таблица_НезавершенныеСделки");
	ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, "Таблица_ПортфельЦБ");
	ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, "Таблица_РЕПО");
	ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, "Таблица_Свопы");
	
	ДанныеОтчета.Вставить("ЗадолженностьПоНДФЛЗаТекущийГод", Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЗадолженностьПоНДФЛЗаТекущийГод").ПолучитьДанные().Выгрузить().Итог("СуммаВВалютеОтчета"));
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ДанныеОтчета;
	
КонецФункции

&НаСервере
Процедура ПоместитьТаблицуВДанныеОтчета(ДанныеОтчета, Запрос, ИмяТаблицы, Сортировка = "")
	
	Данные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_" + ИмяТаблицы).ПолучитьДанные().Выгрузить();
	
	Если ЗначениеЗаполнено(Сортировка) Тогда
		Данные.Сортировать(Сортировка);
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ДанныеСтроки = Новый Структура;
		
		Для Каждого Колонка Из Данные.Колонки Цикл
			Значение = СериализоватьЗначение(СтрокаДанных[Колонка.Имя], СтрокаДанных, ИмяТаблицы, Колонка.Имя);
			
			ДанныеСтроки.Вставить(Колонка.Имя, Значение);
		КонецЦикла;
		
		МассивСтрок.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	ДанныеОтчета.Вставить(ИмяТаблицы, МассивСтрок);
	
КонецПроцедуры

&НаСервере
Функция СериализоватьЗначение(Знач Значение, СтрокаДанных, ИмяТаблицы, ИмяКолонки)
	
	Если ИмяТаблицы = "Таблица_ДенежныеСредства" И ИмяКолонки = "ВидЗадолженности" Тогда
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Значение = "Остаток в " + СтрокаДанных.Валюта; 
		Иначе
			Значение = Символы.Таб + Строка(Значение);
		КонецЕсли;
		
	ИначеЕсли СтрЗаканчиваетсяНа(ИмяКолонки, "Выравнивание") Тогда
	ИначеЕсли ИмяКолонки = "ВидСделки" И ИмяТаблицы = "Таблица_НезавершенныеСделки" Тогда	
	ИначеЕсли ИмяКолонки = "ВидСделки" И ИмяТаблицы = "Таблица_РЕПО" Тогда	
	ИначеЕсли ИмяКолонки = "СделкаЗаключена" И ИмяТаблицы = "Таблица_РЕПО" Тогда	
	ИначеЕсли ИмяКолонки = "ПоКурсуЦБ" И ИмяТаблицы = "_Таблица_Свопы" Тогда	
		
	ИначеЕсли ИмяКолонки = "Сумма" Тогда
		Значение = Окр(Значение, 2);
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		//Примитивные типы не преобразовываем	
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Значение = НачалоДня(Значение);
		
	Иначе 
		Значение = Строка(Значение);
	
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаОстатки()
	Возврат
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокСВалютойСрезПоследних.СделкаСВалютой КАК Сделка,
		|	ВЫБОР
		|		КОГДА УсловияСделокСВалютойСрезПоследних.СделкаСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА УсловияСделокСВалютойСрезПоследних.Валюта
		|		ИНАЧЕ УсловияСделокСВалютойСрезПоследних.Контрвалюта
		|	КОНЕЦ КАК Валюта,
		|	УсловияСделокСВалютойСрезПоследних.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА УсловияСделокСВалютойСрезПоследних.СделкаСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА УсловияСделокСВалютойСрезПоследних.Валюта
		|		ИНАЧЕ УсловияСделокСВалютойСрезПоследних.Контрвалюта
		|	КОНЕЦ КАК ВалютаОплаты,
		|	УсловияСделокСВалютойСрезПоследних.СуммаКонтрвалюты КАК СуммаКонтрвалюты,
		|	ВЫБОР
		|		КОГДА УсловияСделокСВалютойСрезПоследних.СделкаСВалютой.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА УсловияСделокСВалютойСрезПоследних.Курс
		|		ИНАЧЕ 1 / УсловияСделокСВалютойСрезПоследних.Курс
		|	КОНЕЦ КАК Курс,
		|	УсловияСделокСВалютойСрезПоследних.СделкаСВалютой.Дата КАК ДатаСделки,
		|	УсловияСделокСВалютойСрезПоследних.ДатаИсполнения КАК ДатаИсполнения
		|ПОМЕСТИТЬ _Свопы
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&ГраницаДатыОкончания,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|				И Основание ССЫЛКА Документ.СделкаСВалютой) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокСВалютой.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК УсловияСделокСВалютойСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствамОстатки.Основание = УсловияСделокСВалютойСрезПоследних.СделкаСВалютой
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Свопы.Валюта КАК ВалютаАктива,
		|	_Свопы.ВалютаОплаты КАК КонтрВалютаАктива,
		|	МАКСИМУМ(_Свопы.Курс) КАК Курс,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Свопы.Сделка) КАК КоличествоСделок
		|ПОМЕСТИТЬ _КурсыСвопов
		|ИЗ
		|	_Свопы КАК _Свопы
		|
		|СГРУППИРОВАТЬ ПО
		|	_Свопы.Валюта,
		|	_Свопы.ВалютаОплаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК Сумма,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Валюта = &Валюта
		|			ТОГДА 1
		|		ИНАЧЕ КурсыВалютОтчета.Курс * КурсыВалютДС.Кратность / КурсыВалютОтчета.Кратность / КурсыВалютДС.Курс
		|	КОНЕЦ КАК Курс,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток * ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Валюта = &Валюта
		|			ТОГДА 1
		|		ИНАЧЕ КурсыВалютДС.Курс * КурсыВалютОтчета.Кратность / КурсыВалютДС.Кратность / КурсыВалютОтчета.Курс
		|	КОНЕЦ КАК СуммаВВалютеОтчета
		|ПОМЕСТИТЬ _ДенежныеСредства
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&ГраницаДатыОкончания,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютДС
		|		ПО (КурсыВалютДС.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|			И (КурсыВалютДС.Валюта = ОстаткиДенежныхСредствОстатки.Валюта)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютОтчета
