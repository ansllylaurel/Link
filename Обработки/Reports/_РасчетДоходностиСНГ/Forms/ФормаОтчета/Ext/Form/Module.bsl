		МаксДатаОперации    = Макс(СтрокаПродажи.ДатаПродажи, МаксДатаОперации);
		
	КонецЦикла;

    xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
    ExcelApp.Selection.Delete(xlUp);
	
	ЧИСТВНДОХ_Равна0 = (НачалоДня(МинДатаОперации) = НачалоДня(МаксДатаОперации));

	Если ЧИСТВНДОХ_Равна0 Тогда
		xlSheet.Cells(НомСтр, 10).Value = 0;
	Иначе
		xlSheet.Range("J" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(J12:J" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";$B$12:$B$" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";0)";
	КонецЕсли;
	
	Если НачалоОткрытые = НачалоПогашения ИЛИ ЧИСТВНДОХ_Равна0 Тогда //все продали
		xlSheet.Cells(НомСтр,16).Value = 0;
	Иначе
		xlSheet.Range("P" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(P" + СокрЛП(Формат(НачалоОткрытые, "ЧГ=")) + ":P" + СокрЛП(Формат(НачалоПереоценка, "ЧГ=")) + ";$B$" + СокрЛП(Формат(НачалоОткрытые, "ЧГ=")) + ":$B$" + СокрЛП(Формат(НачалоПереоценка, "ЧГ=")) + ";0)";
	КонецЕсли;
	
	Если КоличествоПродажи = 0 Тогда //ничо не продавали
