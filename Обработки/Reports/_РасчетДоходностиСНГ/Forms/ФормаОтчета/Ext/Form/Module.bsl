		xlSheet.Range("D8").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";R12:R" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(R12:R" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
