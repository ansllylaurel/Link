		ИтогПродано = ИтогПродано + СумПродано;
		
		МинДатаОперации		= Мин(СтрокаПогашения.ДатаПогашения, МинДатаОперации);
		МаксДатаОперации    = Макс(СтрокаПогашения.ДатаПогашения, МаксДатаОперации);
		
	КонецЦикла;
	
	НачалоПереоценка = НомСтр;
	
	Для каждого СтрокаПереоценка Из ЭтаФорма.Переоценка Цикл
	
		Если СтрокаПереоценка.ЦеннаяБумага <> СтрокаВсеЦБ.ЦеннаяБумага Тогда
			Продолжить;
		КонецЕсли;
		
		xlSheet.Range(Формат(НомСтр + 1, "ЧГ=") + ":" + Формат(НомСтр + 1, "ЧГ=")).Insert(xlDown);
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//ExcelApp.Selection.Copy();
		//ExcelApp.Selection.Insert(xlDown);
		
