	xlSheet.Range("E8").FormulaLocal = СтрШаблон("=СУММ(R12:R%1)*-1", СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")));

	
	СтрокаВсеЦБ.НомерПоследнейСтроки = НомСтр;
