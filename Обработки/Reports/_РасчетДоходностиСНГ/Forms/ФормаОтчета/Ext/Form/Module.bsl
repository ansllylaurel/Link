		//ExcelApp.Selection.Copy();
		//ExcelApp.Selection.Insert(xlDown);
		
		xlSheet.Cells(НомСтр, 2).Value = СтрокаПокупки.ДатаПартии;
		xlSheet.Cells(НомСтр, 3).Value = "открытие";
		xlSheet.Cells(НомСтр, 4).Value = СтрокаПокупки.КоличествоПокупки;
		xlSheet.Cells(НомСтр, 5).Value = СтрокаПокупки.СуммаПокупки / СтрокаПокупки.КоличествоПокупки;
		xlSheet.Cells(НомСтр, 6).Value = СтрокаПокупки.КомиссияПокупки / СтрокаПокупки.КоличествоПокупки;
		xlSheet.Cells(НомСтр, 7).Value = СтрокаПокупки.КупонПокупки;
		xlSheet.Cells(НомСтр, 8).Value = СтрокаПокупки.СуммаПокупки;
		xlSheet.Cells(НомСтр, 9).Value = СтрокаПокупки.КомиссияПокупки;
		xlSheet.Cells(НомСтр,10).Value = - (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки + СтрокаПокупки.КомиссияПокупки);

		xlSheet.Cells(НомСтр,11).Value = СтрокаПокупки.Доходность;
		xlSheet.Cells(НомСтр,12).Value = СтрокаПокупки.Дней;
		xlSheet.Cells(НомСтр,13).Value = - (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки) * СтрокаПокупки.Дней;
		
		СумПродано = СтрокаПокупки.СуммаПродано + СтрокаПокупки.КупонПродано;
		
		КолОсталось = СтрокаПокупки.КоличествоПокупки - СтрокаПокупки.КоличествоПродано;
		СумОсталось = (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки + СтрокаПокупки.КомиссияПокупки) - СумПродано;
		Если КолОсталось = 0 Тогда
			СумОсталось = 0;
		КонецЕсли;
		
		xlSheet.Cells(НомСтр,15).Value = КолОсталось;
		xlSheet.Cells(НомСтр,16).Value = - СумОсталось;
		
		xlSheet.Cells(НомСтр,17).Value = СтрокаПокупки.КоличествоПродано;
		xlSheet.Cells(НомСтр,18).Value = - (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки);
		
		НомСтр = НомСтр + 1;
		КоличествоПокупки = КоличествоПокупки + 1;
		
		Если КолОсталось = 0 Тогда
			НачалоОткрытые = НачалоОткрытые + 1;
		КонецЕсли;
		
		ИтогОсталось = ИтогОсталось + СумОсталось;
		ИтогПродано = ИтогПродано + СумПродано;
		
		МинДатаОперации		= Мин(СтрокаПокупки.ДатаПартии, МинДатаОперации);
		МаксДатаОперации    = Макс(СтрокаПокупки.ДатаПартии, МаксДатаОперации);
		
	КонецЦикла;
	
	НачалоПогашения = НомСтр;
	КоличествоПогашения = 0;
	
	НачалоПереоценка = НомСтр;
	
	Для каждого СтрокаПереоценка Из ЭтаФорма.Переоценка Цикл
	
		Если СтрокаПереоценка.ЦеннаяБумага <> СтрокаВсеЦБ.ЦеннаяБумага Тогда
			Продолжить;
		КонецЕсли;
		
		xlSheet.Range(Формат(НомСтр + 1, "ЧГ=") + ":" + Формат(НомСтр + 1, "ЧГ=")).Insert(xlDown);
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//ExcelApp.Selection.Copy();
		//ExcelApp.Selection.Insert(xlDown);
		
		xlSheet.Cells(НомСтр, 2).Value = СтрокаПереоценка.Период;
		xlSheet.Cells(НомСтр, 3).Value = "переоценка";
		xlSheet.Cells(НомСтр, 4).Value = СтрокаПереоценка.Количество;
		xlSheet.Cells(НомСтр, 5).Value = СтрокаПереоценка.Сумма / СтрокаПереоценка.Количество;
		xlSheet.Cells(НомСтр, 6).Value = СтрокаПереоценка.Купон / СтрокаПереоценка.Количество;
		xlSheet.Cells(НомСтр, 7).Value = СтрокаПереоценка.Купон;
		xlSheet.Cells(НомСтр, 8).Value = СтрокаПереоценка.Сумма;
		xlSheet.Cells(НомСтр, 9).Value = 0;
		xlSheet.Cells(НомСтр,10).Value = СтрокаПереоценка.Сумма + СтрокаПереоценка.Купон;
		
		xlSheet.Cells(НомСтр,15).Value = СтрокаПереоценка.Количество;
		xlSheet.Cells(НомСтр,16).Value = СтрокаПереоценка.Сумма + СтрокаПереоценка.Купон;
		
		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.ColorIndex = 35;
		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.Pattern = xlSolid;
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//
		//ExcelApp.Selection.Interior.ColorIndex = 35;
		//ExcelApp.Selection.Interior.Pattern = xlSolid;
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	НачалоПродажи = НомСтр;
	КоличествоПродажи = 0;
	
	Для каждого СтрокаПродажи Из ЭтаФорма.Продажи Цикл
		
		Если СтрокаПродажи.ЦеннаяБумага <> СтрокаВсеЦБ.ЦеннаяБумага Тогда
			Продолжить;
		КонецЕсли;
		
		xlSheet.Range(Формат(НомСтр + 1, "ЧГ=") + ":" + Формат(НомСтр + 1, "ЧГ=")).Insert(xlDown);
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//ExcelApp.Selection.Copy();
		//ExcelApp.Selection.Insert(xlDown);
		
		xlSheet.Cells(НомСтр, 2).Value = СтрокаПродажи.ДатаПродажи;
		xlSheet.Cells(НомСтр, 3).Value = "закрытие";
		xlSheet.Cells(НомСтр, 4).Value = СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр, 5).Value = СтрокаПродажи.СуммаПродажи / СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр, 6).Value = СтрокаПродажи.КупонПродажи / СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр, 7).Value = СтрокаПродажи.КупонПродажи;
		xlSheet.Cells(НомСтр, 8).Value = СтрокаПродажи.СуммаПродажи;
		xlSheet.Cells(НомСтр, 9).Value = СтрокаПродажи.КомиссияПродажи;
		xlSheet.Cells(НомСтр,10).Value = (СтрокаПродажи.СуммаПродажи + СтрокаПродажи.КупонПродажи);
		
		xlSheet.Cells(НомСтр,17).Value = СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр,18).Value = (СтрокаПродажи.СуммаПродажи + СтрокаПродажи.КупонПродажи);
		
		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.ColorIndex = 40;
		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.Pattern = xlSolid;
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//
		//ExcelApp.Selection.Interior.ColorIndex = 40;
		//ExcelApp.Selection.Interior.Pattern = xlSolid;
		
		НомСтр = НомСтр + 1;
		КоличествоПродажи = КоличествоПродажи + 1;
		
		МинДатаОперации		= Мин(СтрокаПродажи.ДатаПродажи, МинДатаОперации);
		МаксДатаОперации    = Макс(СтрокаПродажи.ДатаПродажи, МаксДатаОперации);

	КонецЦикла;
	
	xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
	ExcelApp.Selection.Delete(xlUp);
	
	ЧИСТВНДОХ_Равна0 = (НачалоДня(МинДатаОперации) = НачалоДня(МаксДатаОперации));

	Если ЧИСТВНДОХ_Равна0 Тогда
	    xlSheet.Cells(НомСтр,10).Value = 0;
	Иначе
		xlSheet.Range("J" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(J12:J" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";$B$12:$B$" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";0)";
	КонецЕсли;
	
	Если НачалоОткрытые = НачалоПогашения ИЛИ ЧИСТВНДОХ_Равна0 Тогда //все продали
		xlSheet.Cells(НомСтр,16).Value = 0;
	Иначе
		xlSheet.Range("P" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(P" + СокрЛП(Формат(НачалоОткрытые, "ЧГ=")) + ":P" + СокрЛП(Формат(НачалоПереоценка, "ЧГ=")) + ";$B$" + СокрЛП(Формат(НачалоОткрытые, "ЧГ=")) + ":$B$" + СокрЛП(Формат(НачалоПереоценка, "ЧГ=")) + ";0)";
	КонецЕсли;
	Если КоличествоПродажи = 0 Тогда //ничо не продавали
		xlSheet.Cells(НомСтр,18).Value = 0;
	Иначе
		xlSheet.Range("R" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(R" + СокрЛП(Формат(НачалоЗакрытые, "ЧГ=")) + ":R" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";$B$" + СокрЛП(Формат(НачалоЗакрытые, "ЧГ=")) + ":$B$" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";0)";
	КонецЕсли;
	

	xlSheet.Range("J" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(J12:J" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";
	xlSheet.Range("P" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(P12:P" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";
	xlSheet.Range("R" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(R12:R" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";

	xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 2, "ЧГ="))).FormulaLocal = "=СУММ(D12:D" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")";
	xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 3, "ЧГ="))).FormulaLocal = "=D" + СокрЛП(Формат(НомСтр + 2, "ЧГ=")) + "-D" + СокрЛП(Формат(НомСтр + 4, "ЧГ="));
	Если КоличествоПродажи = 0 Тогда
		xlSheet.Cells(НомСтр + 4, 4).Value = 0;
	Иначе
		xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 4, "ЧГ="))).FormulaLocal = "=СУММ(D" + СокрЛП(Формат(НачалоПродажи, "ЧГ=")) + ":D" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";
	КонецЕсли;

	xlSheet.Range("C6").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
	Если НачалоОткрытые = НачалоПогашения Тогда
		xlSheet.Cells(7, 3).Value = 0;
	Иначе
		xlSheet.Range("C7").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";P12:P" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(P12:P" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
	КонецЕсли;
	Если КоличествоПродажи = 0 Тогда //ничо не продавали
		xlSheet.Cells(8, 3).Value = 0;
	Иначе
		xlSheet.Range("C8").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";R12:R" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(R12:R" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
	КонецЕсли;

	xlSheet.Range("D6").FormulaLocal = "=J" + СокрЛП(Формат(НомСтр, "ЧГ="));
	xlSheet.Range("D7").FormulaLocal = "=P" + СокрЛП(Формат(НомСтр, "ЧГ="));
	xlSheet.Range("D8").FormulaLocal = "=R" + СокрЛП(Формат(НомСтр, "ЧГ="));
	
	xlSheet.Range("E6").FormulaLocal = "=СУММ(J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")*-1";
	xlSheet.Range("E7").FormulaLocal = "=СУММ(P12:P" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")*-1";
	xlSheet.Range("E8").FormulaLocal = "=СУММ(R12:R" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")*-1";

	
	СтрокаВсеЦБ.НомерПоследнейСтроки = НомСтр;
	СтрокаВсеЦБ.КоличествоОткрытых = ИтогОсталось;
	СтрокаВсеЦБ.КоличествоЗакрытых = ИтогПродано;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПоВиду(ExcelApp, xlSheet, Рынок, Тип, НачСтр) //Тип: 0 - открытые, 1 - закрытые
	
	xlDown = -4121;
	xlUp = -4162;
	xlSolid = 1;
	
	НомСтр = НачСтр;
	
	Для каждого СтрокаВсеЦБ Из ЭтаФорма.ВсеЦБ Цикл
	
		Если Рынок <> СтрокаВсеЦБ.Рынок Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Тип = 0)И(Окр(СтрокаВсеЦБ.КоличествоОткрытых, 2) = 0) Тогда
			Продолжить;
		КонецЕсли;
		Если (Тип = 1)И(Окр(СтрокаВсеЦБ.КоличествоЗакрытых, 2) = 0) Тогда
			Продолжить;
		КонецЕсли;
		
		xlSheet.Range(Формат(НомСтр + 1, "ЧГ=") + ":" + Формат(НомСтр + 1, "ЧГ=")).Insert(xlDown);
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//ExcelApp.Selection.Copy();
		//ExcelApp.Selection.Insert(xlDown);
		
		xlSheet.Cells(НомСтр, 1).Value = СокрЛП(СтрокаВсеЦБ.Представление);
		xlSheet.Cells(НомСтр, 2).Value = СокрЛП(СтрокаВсеЦБ.ИмяЛиста);

		Если Тип = 0 Тогда
			xlSheet.Range("C" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!D" + СокрЛП(Формат(СтрокаВсеЦБ.НомерПоследнейСтроки + 3, "ЧГ="));
			xlSheet.Range("D" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!E7";
			xlSheet.Range("E" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЕСЛИОШИБКА(LOG((G"+СокрЛП(Формат(НомСтр, "ЧГ="))+"+D"+СокрЛП(Формат(НомСтр, "ЧГ="))+")/D"+СокрЛП(Формат(НомСтр, "ЧГ="))+";1+J"+СокрЛП(Формат(НомСтр, "ЧГ="))+")*365;0)";
			xlSheet.Range("F" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=((1+I"+СокрЛП(Формат(НомСтр, "ЧГ="))+")^(E"+СокрЛП(Формат(НомСтр, "ЧГ="))+"/365))*D"+СокрЛП(Формат(НомСтр, "ЧГ="))+"-D"+СокрЛП(Формат(НомСтр, "ЧГ="))+"";
			xlSheet.Range("G" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!P" + СокрЛП(Формат(СтрокаВсеЦБ.НомерПоследнейСтроки + 1, "ЧГ="));
			xlSheet.Range("H" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=G"+СокрЛП(Формат(НомСтр, "ЧГ="))+"-F"+СокрЛП(Формат(НомСтр, "ЧГ="))+"";
			xlSheet.Range("I" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!C7";
			xlSheet.Range("J" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!D7";
			xlSheet.Range("K" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!C4";
		Иначе
			xlSheet.Range("C" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!D" + СокрЛП(Формат(СтрокаВсеЦБ.НомерПоследнейСтроки + 4, "ЧГ="));
			xlSheet.Range("D" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!E8";
			xlSheet.Range("E" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЕСЛИОШИБКА(LOG((G"+СокрЛП(Формат(НомСтр, "ЧГ="))+"+D"+СокрЛП(Формат(НомСтр, "ЧГ="))+")/D"+СокрЛП(Формат(НомСтр, "ЧГ="))+";1+J"+СокрЛП(Формат(НомСтр, "ЧГ="))+")*365;0)";
			xlSheet.Range("F" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=((1+I"+СокрЛП(Формат(НомСтр, "ЧГ="))+")^(E"+СокрЛП(Формат(НомСтр, "ЧГ="))+"/365))*D"+СокрЛП(Формат(НомСтр, "ЧГ="))+"-D"+СокрЛП(Формат(НомСтр, "ЧГ="))+"";
			xlSheet.Range("G" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!R" + СокрЛП(Формат(СтрокаВсеЦБ.НомерПоследнейСтроки + 1, "ЧГ="));
			xlSheet.Range("H" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=G"+СокрЛП(Формат(НомСтр, "ЧГ="))+"-F"+СокрЛП(Формат(НомСтр, "ЧГ="))+"";
			xlSheet.Range("I" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!C8";
			xlSheet.Range("J" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(СтрокаВсеЦБ.ИмяЛиста) + "'!D8";
			//xlSheet.Range("K" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "='" + СокрЛП(ТЗДляСвода.ИмяЛиста) + "'!C4";
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
		
	КонецЦикла;

    xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
    ExcelApp.Selection.Delete(xlUp);
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСвод(ExcelApp)
	
	xlBook = ExcelApp.Application.ActiveWorkbook;
	xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets("ШаблонИтог");

	xlSheet.Copy(xlSheet);
	xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets("ШаблонИтог (2)");
	xlSheet.Name = "СВОД";

	xlSheet.Cells(5, 1).Value = "Управляющая компания: " + СокрЛП(Отчет.Организация);
	xlSheet.Cells(6, 1).Value = "Договор ДУ: " + ПолучитьДоговор(Отчет.СчетДоверительногоУправления);
	
	xlSheet.Cells(2, 9).Value = НачалоДня(Отчет.Период.ДатаНачала);
	xlSheet.Cells(2, 10).Value = НачалоДня(Отчет.Период.ДатаОкончания);
	
	ОткрРЕПО = 27;
	ОткрАкции = 25;
	ОткрДеп = 23;
	ОткрОбл = 21;
	
	ЗакрРЕПО = 17;
	ЗакрАкции = 15;
	ЗакрДеп = 13;
	ЗакрОбл = 11;
	
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы"), 0, ОткрРЕПО);
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Акции"), 0, ОткрАкции);
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Векселя"), 0, ОткрДеп);
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"), 0, ОткрОбл);

	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы"), 1, ЗакрРЕПО);
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Акции"), 1, ЗакрАкции);
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Векселя"), 1, ЗакрДеп);
	ВывестиПоВиду(ExcelApp, xlSheet, ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации"), 1, ЗакрОбл);
	
	ExcelApp.Application.DisplayAlerts = 0;
	ExcelApp.Application.ActiveWorkbook.Sheets("Шаблон").Delete();
	ExcelApp.Application.ActiveWorkbook.Sheets("ШаблонИтог").Delete();
	ExcelApp.Application.DisplayAlerts = -1;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если НЕ ЭтаФорма.ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	СформироватьНаСервере();
	
	Если ЭтаФорма.НеВыводитьExcel Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаШаблонаExcel = ПолучитьИмяВременногоФайла("xlt");

	ШаблонExcel.Записать(ИмяФайлаШаблонаExcel);
	
	// создадим документ MS Excel на основании сохраненного шаблона
	ExcelApp = Новый COMОбъект("Excel.Application");
	ExcelApp.Application.Visible = False;
	
	ExcelApp.Application.Workbooks.Open(ИмяФайлаШаблонаExcel);
	
	Для каждого СтрокаВсеЦБ Из ЭтаФорма.ВсеЦБ Цикл
		
		Если СтрокаВсеЦБ.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Облигации") Тогда
			
			ВывестиПоОблигации(СтрокаВсеЦБ, ExcelApp);
			
		ИначеЕсли СтрокаВсеЦБ.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Акции") Тогда
			
			ВывестиПоАкции(СтрокаВсеЦБ, ExcelApp);
		
		ИначеЕсли СтрокаВсеЦБ.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Векселя") Тогда
			
			ВывестиПоДепозиту(СтрокаВсеЦБ, ExcelApp);
			
		ИначеЕсли СтрокаВсеЦБ.Рынок = ПредопределенноеЗначение("Перечисление.РынкиЦенныхБумаг.Опционы") Тогда
			
			ВывестиПоРЕПО(СтрокаВсеЦБ, ExcelApp);
			
		КонецЕсли;
	
	КонецЦикла;
	
	ВывестиСвод(ExcelApp);
	
	ExcelApp.Application.Visible = True;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
	Для каждого СтрокаВсеЦБ Из ЭтаФорма.ВсеЦБ Цикл
		СтрокаВсеЦБ.Флажок = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	Для каждого СтрокаВсеЦБ Из ЭтаФорма.ВсеЦБ Цикл
		СтрокаВсеЦБ.Флажок = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НеВыводитьExcelПриИзменении(Элемент)
	
	Элементы.СтраницыДанных.Видимость = ЭтаФорма.НеВыводитьExcel;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";

	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ);
	КонецЕсли;
	
КонецПроцедуры

