	Иначе
		xlSheet.Range("R" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(R" + СокрЛП(Формат(НачалоЗакрытые, "ЧГ=")) + ":R" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";$B$" + СокрЛП(Формат(НачалоЗакрытые, "ЧГ=")) + ":$B$" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";0)";
	КонецЕсли;
	

	xlSheet.Range("J" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(J12:J" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";
	xlSheet.Range("P" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(P12:P" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";
	xlSheet.Range("R" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(R12:R" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";

	xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 2, "ЧГ="))).FormulaLocal = "=СУММ(D12:D" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")";
	xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 3, "ЧГ="))).FormulaLocal = "=D" + СокрЛП(Формат(НомСтр + 2, "ЧГ=")) + "-D" + СокрЛП(Формат(НомСтр + 4, "ЧГ="));
	Если КоличествоПродажи = 0 Тогда
