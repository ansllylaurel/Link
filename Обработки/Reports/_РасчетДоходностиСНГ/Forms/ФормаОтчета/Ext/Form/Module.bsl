		//ExcelApp.Selection.Interior.Pattern = xlSolid;
		
		НомСтр = НомСтр + 1;
		КоличествоПродажи = КоличествоПродажи + 1;
	
		МинДатаОперации		= Мин(СтрокаПродажи.ДатаПродажи, МинДатаОперации);
		МаксДатаОперации    = Макс(СтрокаПродажи.ДатаПродажи, МаксДатаОперации);
		
	КонецЦикла;
	
	xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
	ExcelApp.Selection.Delete(xlUp);
	
	ЧИСТВНДОХ_Равна0 = (НачалоДня(МинДатаОперации) = НачалоДня(МаксДатаОперации));

	Если ЧИСТВНДОХ_Равна0 Тогда
