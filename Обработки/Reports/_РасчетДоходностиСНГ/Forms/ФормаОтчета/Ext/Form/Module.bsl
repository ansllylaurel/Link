		xlSheet.Cells(НомСтр, 5).Value = СтрокаПродажи.СуммаПродажи / СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр, 6).Value = СтрокаПродажи.КупонПродажи / СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр, 7).Value = СтрокаПродажи.КупонПродажи;
		xlSheet.Cells(НомСтр, 8).Value = СтрокаПродажи.СуммаПродажи;
		xlSheet.Cells(НомСтр, 9).Value = СтрокаПродажи.КомиссияПродажи;
		xlSheet.Cells(НомСтр,10).Value = (СтрокаПродажи.СуммаПродажи + СтрокаПродажи.КупонПродажи);
		
		xlSheet.Cells(НомСтр,17).Value = СтрокаПродажи.КоличествоПродажи;
		xlSheet.Cells(НомСтр,18).Value = (СтрокаПродажи.СуммаПродажи + СтрокаПродажи.КупонПродажи);
		
		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.ColorIndex = 40;
		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.Pattern = xlSolid;
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//
		//ExcelApp.Selection.Interior.ColorIndex = 40;
		//ExcelApp.Selection.Interior.Pattern = xlSolid;
		
		НомСтр = НомСтр + 1;
		КоличествоПродажи = КоличествоПродажи + 1;
		
