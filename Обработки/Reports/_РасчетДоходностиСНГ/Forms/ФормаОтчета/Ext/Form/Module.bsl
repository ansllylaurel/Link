		КолОсталось = СтрокаПогашения.Количество - СтрокаПогашения.КоличествоПродано;
		
		СумПродано = (СтрокаПогашения.Сумма + СтрокаПогашения.Купон) / СтрокаПогашения.Количество * КолПродано;
		СумОсталось = (СтрокаПогашения.Сумма + СтрокаПогашения.Купон) - СумПродано;
		
