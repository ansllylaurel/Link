	Иначе
		xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 4, "ЧГ="))).FormulaLocal = "=СУММ(D" + СокрЛП(Формат(НачалоПродажи, "ЧГ=")) + ":D" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";
	КонецЕсли;

	xlSheet.Range("C6").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
	xlSheet.Range("D6").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(J12:J" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
	
