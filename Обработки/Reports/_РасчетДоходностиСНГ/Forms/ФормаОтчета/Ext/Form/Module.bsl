		|		КОГДА ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|				ИЛИ ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|				ИЛИ ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|				ИЛИ ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|				ИЛИ ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВсеЦБПредварительная.ЦеннаяБумага.Эмитент.Наименование
		|		КОГДА ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|			ТОГДА ВсеЦБПредварительная.ЦеннаяБумага.ЮрЛицо.Наименование
		|		КОГДА ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|			ТОГДА ВсеЦБПредварительная.ЦеннаяБумага.Банк.Наименование
		|		КОГДА ВсеЦБПредварительная.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ВсеЦБПредварительная.ЦеннаяБумага.ПаевойИнвестиционныйФонд.Наименование
		|		ИНАЧЕ ВсеЦБПредварительная.ЦеннаяБумага.Наименование
		|	КОНЕЦ КАК Представление
		|ИЗ
		|	ВсеЦБПредварительная КАК ВсеЦБПредварительная
		|
		|УПОРЯДОЧИТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага";
	
#КонецОбласти
	
	ЭтотОбъект.ВсеЦБ.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЭтотОбъект.Покупки.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("Покупки").ПолучитьДанные().Выгрузить());
	ЭтотОбъект.Продажи.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("Продажи").ПолучитьДанные().Выгрузить());
	ЭтотОбъект.Погашения.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("Погашения").ПолучитьДанные().Выгрузить());
	ЭтотОбъект.Переоценка.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("Переоценка").ПолучитьДанные().Выгрузить());
	
	КонтрольКоличестваВНачисленииДивидендов(Запрос);
	
	ЭтотОбъект.ВсеЦБ.Сортировать("Рынок,Представление");
	
	Для каждого СтрокаПокупки Из ЭтотОбъект.Покупки Цикл
		
		СтрокаПокупки.НомерСделки = "";
		
		Если СтрокаПокупки.Рынок = Перечисления.РынкиЦенныхБумаг.Акции Тогда
			
			СтрокаПокупки.Дней = Цел((КонецГода(Отчет.Период.ДатаОкончания) - СтрокаПокупки.ДатаПартии) / 86400);
			СтрокаПокупки.Доходность = ПолучитьСтавкуОвернайт(СтавкиОвернайт, МинДатаСтавкиОвернайт, СтрокаПокупки.ДатаПартии);
			
			Если Не ЗначениеЗаполнено(СтрокаПокупки.Доходность) Тогда
				
				РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
				
				ВызватьИсключение "Не удалось определить ставку Overnight за дату '" + СтрокаПокупки.ДатаПартии + "'";
				
			КонецЕсли;
			
		ИначеЕсли СтрокаПокупки.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации Тогда
			
			Попытка
				СтрокаПокупки.Доходность = Справочники.Облигации.ПолучитьДоходностьИДюрацию(
					СтрокаПокупки.ЦеннаяБумага,
					Ложь,
					СтрокаПокупки.ДатаПартии,
					СтрокаПокупки.СуммаПокупки / СтрокаПокупки.КоличествоПокупки,
					Отчет.СчетДоверительногоУправления,
					,
					СтрокаПокупки.ДатаПартии).Доходность;
			Исключение
				СтрокаПокупки.Доходность = 0;
			КонецПопытки;
			
			ДатаПогашения = Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(СтрокаПокупки.ЦеннаяБумага, СтрокаПокупки.ДатаПартии).ДатаВыкупа;
			
			СтрокаПокупки.Дней = (НачалоДня(ДатаПогашения) - НачалоДня(СтрокаПокупки.ДатаПартии)) / 86400;
			
			Если ТипЗнч(СтрокаПокупки.Партия) = Тип("ДокументСсылка.Сделка") Тогда
				
				СтрокаПокупки.НомерСделки = СтрокаПокупки.Партия.НомерСделки;
				
			ИначеЕсли ТипЗнч(СтрокаПокупки.Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
				
				СтрокаПокупки.НомерСделки = СтрокаПокупки.Партия.Основание.НомерСделки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтотОбъект.Покупки.Сортировать("Рынок,ЦеннаяБумага,ДатаПартии,НомерСделки");
	
	// ДЕПОЗИТЫ
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитыПриход.КредитныйИнструмент КАК ДепозитныйВклад,
		|	ДепозитыПриход.КредитныйИнструмент.ДатаРегистрации КАК ДатаРегистрации,
		|	ДепозитыПриход.СуммаПриход + ДепозитыПриход.СуммаНачальныйОстаток КАК СуммаПриход,
		|	ДепозитыПриход.Период КАК Период,
		|	ДепозитыПриход.Регистратор КАК Регистратор,
		|	1 КАК КоличествоПриход
		|ПОМЕСТИТЬ Депозиты
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Запись,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДепозитыПриход
		|ГДЕ
		|	(ДепозитыПриход.Регистратор = НЕОПРЕДЕЛЕНО
		|			ИЛИ ДепозитыПриход.СуммаПриход > 0)
		|	И ДепозитыПриход.Период <> &ОкончаниеПериодаДата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК ДепозитныйВклад,
		|	ДенежныеСредстваВКредитныхИнструментах.Период КАК Период,
		|	ДенежныеСредстваВКредитныхИнструментах.Регистратор КАК Регистратор,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваВКредитныхИнструментах.Регистратор ССЫЛКА Документ.ВыводКредитногоИнструмента
		|			ТОГДА 1
		|		КОГДА ДенежныеСредстваВКредитныхИнструментах.Регистратор ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.Регистратор КАК Документ.ЗакрытиеКредитногоИнструмента).РежимЗакрытия = ЗНАЧЕНИЕ(Перечисление.РежимыЗакрытияКредитногоИнструмента.Частичное)
		|						ТОГДА 0
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КоличествоРасход,
		|	ВЫБОР
		|		КОГДА ДенежныеСредстваВКредитныхИнструментах.Регистратор ССЫЛКА Документ.ВыводКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.Регистратор КАК Документ.ВыводКредитногоИнструмента).СуммаПроцентов
		|		КОГДА ДенежныеСредстваВКредитныхИнструментах.Регистратор ССЫЛКА Документ.ЗакрытиеКредитногоИнструмента
		|			ТОГДА ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.Регистратор КАК Документ.ЗакрытиеКредитногоИнструмента).СуммаПроцентов
		|		ИНАЧЕ 0
		|	КОНЕЦ + ДенежныеСредстваВКредитныхИнструментах.Сумма КАК СуммаРасход
		|ПОМЕСТИТЬ ДепозитыРасход
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ДенежныеСредстваВКредитныхИнструментах
		|ГДЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Период МЕЖДУ &НачалоПериодаДата И &ОкончаниеПериодаДата
		|	И ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ДенежныеСредстваВКредитныхИнструментах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ДенежныеСредстваВКредитныхИнструментах.ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
		|	И ДенежныеСредстваВКредитныхИнструментах.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период КАК Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики КАК ДепозитныйВклад,
		|	СУММА(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета) КАК Сумма
		|ПОМЕСТИТЬ ДепозитыПереоценка
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = НАЧАЛОПЕРИОДА(&ОкончаниеПериодаДата, ДЕНЬ)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитыРасход.ДепозитныйВклад КАК ДепозитныйВклад,
		|	СУММА(ДепозитыРасход.КоличествоРасход) КАК КоличествоРасход,
		|	СУММА(ДепозитыРасход.СуммаРасход) КАК СуммаРасход
		|ПОМЕСТИТЬ ДепозитыПродано
		|ИЗ
		|	ДепозитыРасход КАК ДепозитыРасход
		|
		|СГРУППИРОВАТЬ ПО
		|	ДепозитыРасход.ДепозитныйВклад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ДепозитныйВклад КАК ДепозитныйВклад,
		|	СтатусыЛицензий.Лицензия.Номер КАК ЛицензияНомер
		|ПОМЕСТИТЬ _ЛицензииБанков
		|ИЗ
		|	(ВЫБРАТЬ
		|		Депозиты.ДепозитныйВклад КАК ДепозитныйВклад,
		|		Депозиты.ДепозитныйВклад.БанковскийСчет.Банк.ЮрФизЛицо КАК ЮрФизЛицо,
		|		МАКСИМУМ(СтатусыЛицензий.Период) КАК ДатаСтатусаЛицензии
		|	ИЗ
		|		Депозиты КАК Депозиты
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|			ПО Депозиты.ДепозитныйВклад.БанковскийСчет.Банк.ЮрФизЛицо = СтатусыЛицензий.Лицензия.ЮрФизЛицо
		|				И (СтатусыЛицензий.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.ЛицензияБанкаРоссии))
		|				И Депозиты.ДатаРегистрации >= СтатусыЛицензий.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Депозиты.ДепозитныйВклад,
		|		Депозиты.ДепозитныйВклад.БанковскийСчет.Банк.ЮрФизЛицо) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|		ПО ВложенныйЗапрос.ЮрФизЛицо = СтатусыЛицензий.Лицензия.ЮрФизЛицо
		|			И (СтатусыЛицензий.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.ЛицензияБанкаРоссии))
		|			И ВложенныйЗапрос.ДатаСтатусаЛицензии = СтатусыЛицензий.Период
		|ГДЕ
		|	СтатусыЛицензий.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Депозиты.ДепозитныйВклад КАК ДепозитныйВклад,
		|	Депозиты.Период КАК Период,
		|	Депозиты.Регистратор КАК Регистратор,
		|	Депозиты.СуммаПриход КАК СуммаПриход,
		|	Депозиты.КоличествоПриход КАК КоличествоПриход,
		|	ЕСТЬNULL(ДепозитыПродано.КоличествоРасход, 0) КАК КоличествоРасход,
		|	ЕСТЬNULL(ДепозитыПродано.СуммаРасход, 0) КАК СуммаРасход,
		|	Депозиты.ДатаРегистрации КАК ДатаРегистрации,
		|	Депозиты.ДепозитныйВклад.НомерПодтверждения КАК НомерПодтверждения,
		|	_ЛицензииБанков.ЛицензияНомер КАК ЛицензияНомер
		|ПОМЕСТИТЬ ДепозитыПриход
		|ИЗ
		|	Депозиты КАК Депозиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДепозитыПродано КАК ДепозитыПродано
		|		ПО Депозиты.ДепозитныйВклад = ДепозитыПродано.ДепозитныйВклад
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛицензииБанков КАК _ЛицензииБанков
		|		ПО Депозиты.ДепозитныйВклад = _ЛицензииБанков.ДепозитныйВклад";
	
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(Отчет.Период.ДатаНачала), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецДня(Отчет.Период.ДатаОкончания), ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("НачалоПериодаДата", НачалоДня(Отчет.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериодаДата", КонецДня(Отчет.Период.ДатаОкончания));
	
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отчет.СчетДоверительногоУправления);
	
	Запрос.Выполнить();
	
	ДопНомерЛиста = Новый Соответствие;
	
	ВыборкаДепозитыПриход = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "ДепозитыПриход",,,, "ДатаРегистрации,НомерПодтверждения").Выбрать();
	
	Пока ВыборкаДепозитыПриход.Следующий() Цикл
	
		СтрокаВсеЦБ = ЭтотОбъект.ВсеЦБ.Добавить();
		
		СтрокаВсеЦБ.ИмяЛиста = "деп_" + ЗаменитьСпецСимволы(СОКРЛП(ВыборкаДепозитыПриход.ЛицензияНомер)) + "_" + Формат(ВыборкаДепозитыПриход.ДатаРегистрации, "ДФ=yyyyMMdd");
		
		Если ДопНомерЛиста.Получить(СтрокаВсеЦБ.ИмяЛиста) = Неопределено Тогда
			ДопНомерЛиста.Вставить(СтрокаВсеЦБ.ИмяЛиста, 1);
		Иначе
			ДопНомерЛиста.Вставить(СтрокаВсеЦБ.ИмяЛиста, ДопНомерЛиста.Получить(СтрокаВсеЦБ.ИмяЛиста) + 1);
		КонецЕсли;
		
		СтрокаВсеЦБ.ИмяЛиста = СтрокаВсеЦБ.ИмяЛиста + Формат(ДопНомерЛиста.Получить(СтрокаВсеЦБ.ИмяЛиста), "ЧГ=");
		
		СтрокаВсеЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя;
		СтрокаВсеЦБ.ЦеннаяБумага = ВыборкаДепозитыПриход.ДепозитныйВклад;
		СтрокаВсеЦБ.Представление = ВыборкаДепозитыПриход.ДепозитныйВклад.Наименование;
		
		СтрокаПокупки = ЭтотОбъект.Покупки.Добавить();
		
		СтрокаПокупки.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя;
		СтрокаПокупки.ЦеннаяБумага = ВыборкаДепозитыПриход.ДепозитныйВклад;
		
		Если ВыборкаДепозитыПриход.Регистратор = Неопределено Тогда
			СтрокаПокупки.Партия = NULL;
		Иначе	
			СтрокаПокупки.Партия = ВыборкаДепозитыПриход.Регистратор;
		КонецЕсли;
		
		СтрокаПокупки.КоличествоПокупки = ВыборкаДепозитыПриход.КоличествоПриход;
		СтрокаПокупки.СуммаПокупки = ВыборкаДепозитыПриход.СуммаПриход;
		СтрокаПокупки.КупонПокупки = 0;
		СтрокаПокупки.КомиссияПокупки = 0;
		
		СтрокаПокупки.КоличествоПродано = ВыборкаДепозитыПриход.КоличествоРасход;
		СтрокаПокупки.СуммаПродано = ВыборкаДепозитыПриход.СуммаРасход;
		СтрокаПокупки.КупонПродано = 0;
		
		ДанныеДепозита = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(ВыборкаДепозитыПриход.ДепозитныйВклад, ВыборкаДепозитыПриход.Период);
		
		СтрокаПокупки.Доходность = ДанныеДепозита.Процент;
		СтрокаПокупки.Дней = (НачалоДня(ДанныеДепозита.ДатаПогашения) - НачалоДня(ДанныеДепозита.ДатаОткрытия)) / 86400;
		
		СтрокаПокупки.ДатаПартии = ВыборкаДепозитыПриход.Период;
		
		СтрокаПокупки.НомерСделки = "";
		
	КонецЦикла;
	
	ВыборкаДепозитыРасход = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("ДепозитыРасход").ПолучитьДанные().Выбрать();
	Пока ВыборкаДепозитыРасход.Следующий() Цикл
		
		СтрокаПродажи = ЭтотОбъект.Продажи.Добавить();
		
		СтрокаПродажи.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя;
		СтрокаПродажи.ЦеннаяБумага = ВыборкаДепозитыРасход.ДепозитныйВклад;
		СтрокаПродажи.ДокументПродажи = ВыборкаДепозитыРасход.Регистратор;
		СтрокаПродажи.КоличествоПродажи = ВыборкаДепозитыРасход.КоличествоРасход;
		СтрокаПродажи.СуммаПродажи = ВыборкаДепозитыРасход.СуммаРасход;
		СтрокаПродажи.КупонПродажи = 0;
		СтрокаПродажи.КомиссияПродажи = 0;
		СтрокаПродажи.ДатаПродажи = ВыборкаДепозитыРасход.Регистратор.Дата;
		
	КонецЦикла;
	
	ВыборкаДепозитыПереоценка = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("ДепозитыПереоценка").ПолучитьДанные().Выбрать();
	Пока ВыборкаДепозитыПереоценка.Следующий() Цикл
		
		СтрокаПереоценка = ЭтотОбъект.Переоценка.Добавить();
		
		СтрокаПереоценка.Рынок = Перечисления.РынкиЦенныхБумаг.Векселя;
		СтрокаПереоценка.Период = ВыборкаДепозитыПереоценка.Период;
		СтрокаПереоценка.ЦеннаяБумага = ВыборкаДепозитыПереоценка.ДепозитныйВклад;
		СтрокаПереоценка.Количество = 1;
		СтрокаПереоценка.Сумма = ВыборкаДепозитыПереоценка.Сумма;
		СтрокаПереоценка.Купон = 0;
		
	КонецЦикла;
	
	// РЕПО
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокРЕПОЧасть1.СделкаРЕПО КАК СделкаРЕПО,
		|	УсловияСделокРЕПОЧасть1.ЦеннаяБумага КАК ЦеннаяБумага,
		|	УсловияСделокРЕПОЧасть1.Количество КАК Количество,
		|	УсловияСделокРЕПОЧасть1.Сумма КАК Сумма,
		|	УсловияСделокРЕПОЧасть1.СуммаКупона КАК СуммаКупона,
		|	УсловияСделокРЕПОЧасть2.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
		|	УсловияСделокРЕПОЧасть2.Сумма КАК Сумма1,
		|	УсловияСделокРЕПОЧасть2.СуммаКупона КАК СуммаКупона1,
		|	УсловияСделокРЕПОЧасть2.СтавкаРЕПО КАК СделкаРЕПОСтавкаРЕПО,
		|	ЕСТЬNULL(РасходыПоСделке.СуммаОборот, 0) КАК СуммаКомиссии
		|ПОМЕСТИТЬ РЕПО
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ОкончаниеПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СделкаРЕПО.Дата >= &НачалоПериодаДата
		|				И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОЧасть1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И СделкаРЕПО.Дата >= &НачалоПериодаДата
		|					И ЧастьСделкиРЕПО = 2) КАК УсловияСделокРЕПОЧасть2
		|		ПО УсловияСделокРЕПОЧасть1.СделкаРЕПО = УсловияСделокРЕПОЧасть2.СделкаРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
		|				&НачалоПериода,
		|				&ОкончаниеПериода,
		|				Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Организация.ВалютаУчета = Валюта
		|					И (ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|						ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК РасходыПоСделке
		|		ПО УсловияСделокРЕПОЧасть1.СделкаРЕПО = РасходыПоСделке.Сделка
		|			И УсловияСделокРЕПОЧасть1.ЦеннаяБумага = РасходыПоСделке.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период КАК Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК РЕПО,
		|	СУММА(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета) КАК Сумма
		|ПОМЕСТИТЬ РЕПОПереоценка
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = НАЧАЛОПЕРИОДА(&ОкончаниеПериодаДата, ДЕНЬ)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание";
	
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(Отчет.Период.ДатаНачала), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецДня(Отчет.Период.ДатаОкончания), ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("НачалоПериодаДата", НачалоДня(Отчет.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериодаДата", КонецДня(Отчет.Период.ДатаОкончания));
	
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отчет.СчетДоверительногоУправления);
	
	Запрос.Выполнить();
	
	ВыборкаРЕПО = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("РЕПО").ПолучитьДанные().Выбрать();
	Пока ВыборкаРЕПО.Следующий() Цикл
	
		СтрокаВсеЦБ = ЭтотОбъект.ВсеЦБ.Добавить();
		
		СтрокаВсеЦБ.Рынок = Перечисления.РынкиЦенныхБумаг.Опционы;
		СтрокаВсеЦБ.ЦеннаяБумага = ВыборкаРЕПО.СделкаРЕПО;
		СтрокаВсеЦБ.ИмяЛиста = Лев("RP_" + ЗаменитьСпецСимволы(ВыборкаРЕПО.СделкаРЕПО.Номер) + "_" + СокрЛП(ВыборкаРЕПО.ЦеннаяБумага.ГосударственныйРегистрационныйНомер), 31);
		СтрокаВсеЦБ.Представление = ВыборкаРЕПО.СделкаРЕПО;
		
		
		СтрокаПокупки = ЭтотОбъект.Покупки.Добавить();
		
		СтрокаПокупки.Рынок = Перечисления.РынкиЦенныхБумаг.Опционы;
		СтрокаПокупки.ЦеннаяБумага = ВыборкаРЕПО.СделкаРЕПО;
		
		СтрокаПокупки.Партия = ВыборкаРЕПО.СделкаРЕПО;
		
		СтрокаПокупки.КоличествоПокупки = ВыборкаРЕПО.Количество;
		СтрокаПокупки.СуммаПокупки = ВыборкаРЕПО.Сумма;
		СтрокаПокупки.КупонПокупки = ВыборкаРЕПО.СуммаКупона;
		СтрокаПокупки.КомиссияПокупки = ВыборкаРЕПО.СуммаКомиссии;
		
		СтрокаПокупки.ДатаПартии = ВыборкаРЕПО.СделкаРЕПО.Дата;
		СтрокаПокупки.Доходность = ВыборкаРЕПО.СделкаРЕПОСтавкаРЕПО;
		СтрокаПокупки.Дней = (НачалоДня(ВыборкаРЕПО.ДатаВторойЧастиРЕПО) - НачалоДня(ВыборкаРЕПО.СделкаРЕПО.Дата)) / 86400;
		
		СтрокаПокупки.НомерСделки = "";
		
		Если ВыборкаРЕПО.ДатаВторойЧастиРЕПО > КонецДня(Отчет.Период.ДатаОкончания) Тогда
			
			СтрокаПокупки.КоличествоПродано = 0;
			СтрокаПокупки.СуммаПродано = 0;
			СтрокаПокупки.КупонПродано = 0;
		
		Иначе
			
			СтрокаПокупки.КоличествоПродано = ВыборкаРЕПО.Количество;
			СтрокаПокупки.СуммаПродано = ВыборкаРЕПО.Сумма;
			СтрокаПокупки.КупонПродано = ВыборкаРЕПО.СуммаКупона;
			
			
			СтрокаПродажи = ЭтотОбъект.Продажи.Добавить();
			
			СтрокаПродажи.Рынок = Перечисления.РынкиЦенныхБумаг.Опционы;
			СтрокаПродажи.ЦеннаяБумага = ВыборкаРЕПО.СделкаРЕПО;
			СтрокаПродажи.ДокументПродажи = ВыборкаРЕПО.СделкаРЕПО;
			СтрокаПродажи.КоличествоПродажи = ВыборкаРЕПО.Количество;
			СтрокаПродажи.СуммаПродажи = ВыборкаРЕПО.Сумма1;
			СтрокаПродажи.КупонПродажи = ВыборкаРЕПО.СуммаКупона1;
			СтрокаПродажи.КомиссияПродажи = 0;
			СтрокаПродажи.ДатаПродажи = ВыборкаРЕПО.ДатаВторойЧастиРЕПО;
			
		КонецЕсли;
		
	КонецЦикла;

	ВыборкаРЕПОПереоценка = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("РЕПОПереоценка").ПолучитьДанные().Выбрать();
	
	Пока ВыборкаРЕПОПереоценка.Следующий() Цикл
		
		СтрокаПереоценка = ЭтотОбъект.Переоценка.Добавить();
		
		СтрокаПереоценка.Рынок = Перечисления.РынкиЦенныхБумаг.Опционы;
		СтрокаПереоценка.Период = ВыборкаРЕПОПереоценка.Период;
		СтрокаПереоценка.ЦеннаяБумага = ВыборкаРЕПОПереоценка.РЕПО;
		СтрокаПереоценка.Количество = ВыборкаРЕПОПереоценка.РЕПО.ЦенныеБумаги.Итог("Количество");
		СтрокаПереоценка.Сумма = ВыборкаРЕПОПереоценка.Сумма;
		СтрокаПереоценка.Купон = 0;
		
	КонецЦикла;
	
	Для Каждого СтрокаВсеЦБ Из ЭтотОбъект.ВсеЦБ Цикл
		СтрокаВсеЦБ.ИмяЛиста = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(СтрокаВсеЦБ.ИмяЛиста);
		Если СтрДлина(СтрокаВсеЦБ.ИмяЛиста) > 31 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Слишком длинное имя листа: " + СтрокаВсеЦБ.ИмяЛиста);
		КонецЕсли;
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецФункции

&НаСервере
Процедура КонтрольКоличестваВНачисленииДивидендов(Запрос)

	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КонтрольКоличестваВНачисленииДивидендов").ПолучитьДанные().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По ценной бумаге %1 количество бумаг (%2) в начислении дивидендов (дата погашения: %3) не равно количеству по партии (%4) на дату реестра",
				Выборка.ЦеннаяБумага,
				Выборка.КоличествоБумагВНачисленииДивидендов,
				Формат(Выборка.ДатаПогашения, "ДФ=dd.MM.yyyy"),
				Выборка.КоличествоОстаток));
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиПоОблигации(СтрокаВсеЦБ, ExcelApp)

	xlDown = -4121;
	xlUp = -4162;
	xlSolid = 1;

	xlBook = ExcelApp.Application.ActiveWorkbook;
	xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets("Шаблон");

	xlSheet.Copy(xlSheet);
	xlSheet = ExcelApp.Application.ActiveWorkbook.Sheets("Шаблон (2)");
	xlSheet.Name = СокрЛП(СтрокаВсеЦБ.ИмяЛиста);
	
	xlSheet.Cells(2, 3).Value = НачалоДня(Отчет.Период.ДатаОкончания);
	xlSheet.Cells(3, 3).Value = Строка(СтрокаВсеЦБ.ЦеннаяБумага);
	
	НомСтр = 12;
	
	ИтогОсталось = 0;
	ИтогПродано = 0;
	
	НачалоПокупки = 12;
	КоличествоПокупки = 0;
	НачалоОткрытые = 12;
	НачалоЗакрытые = 12;
	
	МинДатаОперации		= Отчет.Период.ДатаОкончания;
	МаксДатаОперации	= Отчет.Период.ДатаОкончания;
	
	Для Каждого СтрокаПокупки Из ЭтаФорма.Покупки Цикл
	
		Если СтрокаПокупки.ЦеннаяБумага <> СтрокаВсеЦБ.ЦеннаяБумага Тогда
			Продолжить;
		КонецЕсли;
		
		xlSheet.Range(Формат(НомСтр + 1, "ЧГ=") + ":" + Формат(НомСтр + 1, "ЧГ=")).Insert(xlDown);
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//ExcelApp.Selection.Copy();
		//ExcelApp.Selection.Insert(xlDown);
		
		xlSheet.Cells(НомСтр, 2).Value = СтрокаПокупки.ДатаПартии;
		xlSheet.Cells(НомСтр, 3).Value = СтрокаПокупки.ВидОперации;
		xlSheet.Cells(НомСтр, 4).Value = СтрокаПокупки.КоличествоПокупки;
