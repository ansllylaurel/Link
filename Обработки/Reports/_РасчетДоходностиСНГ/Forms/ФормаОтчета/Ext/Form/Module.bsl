
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ШаблонExcel = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ШаблонExcel");
	
	Элементы.НеВыводитьExcel.Видимость = РольДоступна("ПолныеПрава");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДоговор(СчетДоверительногоУправления)

	Возврат СчетДоверительногоУправления.НомерДоговора;	

КонецФункции

&НаСервереБезКонтекста
Функция ЗаменитьСпецСимволы(ВхСтрока)

	ИсхСтрока = ВхСтрока;
	ИсхСтрока = СтрЗаменить(ИсхСтрока, "/", "_");
	ИсхСтрока = СтрЗаменить(ИсхСтрока, "\", "_");
	ИсхСтрока = СтрЗаменить(ИсхСтрока, "*", "_");
	ИсхСтрока = СтрЗаменить(ИсхСтрока, "?", "_");
	ИсхСтрока = СтрЗаменить(ИсхСтрока, "[", "_");
	ИсхСтрока = СтрЗаменить(ИсхСтрока, "]", "_");
	
	Возврат ИсхСтрока;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьСтавкуОвернайт(СтавкиОвернайт, МинДатаСтавки, Знач ДатаСтавки)
	
	СтавкаОвернайт = СтавкиОвернайт[ДатаСтавки];
	
	Если СтавкаОвернайт = Неопределено Тогда // найдем первую попавшуся предыдущую
		Пока СтавкаОвернайт = Неопределено И ДатаСтавки >= МинДатаСтавки Цикл
			ДатаСтавки = ДатаСтавки - 86400;
			СтавкаОвернайт = СтавкиОвернайт[ДатаСтавки];
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтавкаОвернайт;
	
КонецФункции // ПолучитьСтавкуОвернайт

&НаСервере
Функция ПолучитьСтавкиОвернайтНаСервере(МинДатаСтавки)
	
	МинДатаСтавки  = Неопределено;
	СтавкиОвернайт = Новый Соответствие;
	
	МакетДанных = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("СтавкиОвернайт");
	
	Для НомСтр = 2 По МакетДанных.ВысотаТаблицы Цикл
		
		ДатаСтавки = МакетДанных.Область(НомСтр, 1).Текст;
		ДатаСтавки = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ДатаСтавки);
		
		ЗначСтавки = МакетДанных.Область(НомСтр, 2).Текст;
		ЗначСтавки = Число(СтрЗаменить(ЗначСтавки, ",", "."));
		
		СтавкиОвернайт.Вставить(ДатаСтавки, ЗначСтавки);
			
		Если МинДатаСтавки = Неопределено Или МинДатаСтавки > ДатаСтавки Тогда
			МинДатаСтавки = ДатаСтавки;
		КонецЕсли;
			
	КонецЦикла;
	
	Возврат СтавкиОвернайт;
	
КонецФункции // ПолучитьСтавкиОвернайтНаСервере

&НаСервере
Функция СформироватьНаСервере()
	
	Перем МинДатаСтавкиОвернайт;
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Отчет, "Период,Организация,СчетДоверительногоУправления,ДанныеСНачалаПериода");
	Механизм = РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СтавкиОвернайт = ПолучитьСтавкиОвернайтНаСервере(МинДатаСтавкиОвернайт);
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачалоПериода"		, Новый Граница(НачалоДня(Отчет.Период.ДатаНачала), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ОкончаниеПериода"	, Новый Граница(КонецДня(Отчет.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериодаДата"	, НачалоДня(Отчет.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериодаДата", КонецДня(Отчет.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"					, Отчет.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", Отчет.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ДатаНачалаНеобходимостиДанныхЕПСВоВводахЦБ", РегистрыСведений.НастройкиУчетаОбщие.ПолучитьДатуНачалаНеобходимостиДанныхЕПСВоВводахЦБ(Отчет.СчетДоверительногоУправления));
	
#Область ПокупкиПредварительные

	Если Отчет.ДанныеСНачалаПериода Тогда
		
#Область ТекстЗапроса
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.Рынок КАК Рынок,
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СтоимостьПереоценки.Партия КАК Партия,
			|	СтоимостьПереоценки.СтрокаПартии КАК СтрокаПартии,
			|	СтоимостьПереоценки.Цена КАК Цена,
			|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона
			|ПОМЕСТИТЬ _СтоимостьПереоценки
			|ИЗ
			|	(ВЫБРАТЬ
			|		МАКСИМУМ(ПоследняяПереоценка.Период) КАК Период
			|	ИЗ
			|		РегистрСведений.СтоимостьПереоценки.СрезПоследних(
			|				&НачалоПериодаДата,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|					И ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
			|					И ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)) КАК ПоследняяПереоценка) КАК ПоследняяПереоценка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ПО (СтоимостьПереоценки.Период = ПоследняяПереоценка.Период)
			|			И (СтоимостьПереоценки.Организация = &Организация)
			|			И (СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
			|			И (СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
			|			И (СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
			|			И (СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Партии.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
			|	Партии.ЦеннаяБумага КАК ЦеннаяБумага,
			|	Партии.Партия КАК Партия,
			|	Партии.СтрокаПартии КАК СтрокаПартии,
			|	Партии.КоличествоНачальныйОстаток + Партии.КоличествоПриход КАК КоличествоПокупки,
			|	ЕСТЬNULL(ЕСТЬNULL(СтоимостьПереоценкиПоПартиям.Цена, СтоимостьПереоценкиБезПартии.Цена), 0) * Партии.КоличествоНачальныйОстаток + Партии.СтоимостьПокупкиПриход КАК СуммаПокупки,
			|	ВЫБОР
			|		КОГДА Партии.Партия ССЫЛКА Документ.ВводЦенныхБумаг
			|			ТОГДА 0
			|		КОГДА Партии.Партия ССЫЛКА Документ.Сделка
			|			ТОГДА ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0) / ЕСТЬNULL(СделкаЦенныеБумаги.Количество, 1) * (Партии.КоличествоНачальныйОстаток + Партии.КоличествоПриход)
			|		КОГДА Партии.Партия ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
			|			ТОГДА ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0) / ЕСТЬNULL(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Количество, 1) * (Партии.КоличествоНачальныйОстаток + Партии.КоличествоПриход)
			|		КОГДА Партии.Партия ССЫЛКА Документ.ПоставкаЦенныхБумаг
			|			ТОГДА ЕСТЬNULL(РасходыПоСделкеОбороты.СуммаОборот, 0) / ЕСТЬNULL(ПоставкаЦенныхБумагЦенныеБумаги.Количество, 1) * (Партии.КоличествоНачальныйОстаток + Партии.КоличествоПриход)
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК КомиссияПокупки,
			|	Партии.КоличествоРасход КАК КоличествоПродано,
			|	(ЕСТЬNULL(ЕСТЬNULL(СтоимостьПереоценкиПоПартиям.Цена, СтоимостьПереоценкиБезПартии.Цена), 0) * Партии.КоличествоНачальныйОстаток + Партии.СтоимостьПокупкиПриход) / (Партии.КоличествоНачальныйОстаток + Партии.КоличествоПриход) * Партии.КоличествоРасход КАК СуммаПродано,
			|	(ЕСТЬNULL(ЕСТЬNULL(СтоимостьПереоценкиПоПартиям.ЦенаКупона, СтоимостьПереоценкиБезПартии.ЦенаКупона), 0) * Партии.КоличествоНачальныйОстаток + Партии.СтоимостьПокупкиКупонаПриход) / (Партии.КоличествоНачальныйОстаток + Партии.КоличествоПриход) * Партии.КоличествоРасход КАК КупонПродано,
			|	ЕСТЬNULL(ЕСТЬNULL(СтоимостьПереоценкиПоПартиям.ЦенаКупона, СтоимостьПереоценкиБезПартии.ЦенаКупона), 0) * Партии.КоличествоНачальныйОстаток + Партии.СтоимостьПокупкиКупонаПриход КАК КупонПокупки,
			|	Партии.Рынок КАК Рынок,
			|	ВЫБОР
			|		КОГДА Партии.КоличествоНачальныйОстаток > 0
			|			ТОГДА &НачалоПериодаДата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ВводЦенныхБумаг
			|				И ВводЦенныхБумагЦенныеБумаги.ДатаПокупки = ДАТАВРЕМЯ(1, 1, 1)
			|				И ВводЦенныхБумаг.Дата < &ДатаНачалаНеобходимостиДанныхЕПСВоВводахЦБ
			|			ТОГДА ВводЦенныхБумаг.Дата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ВводЦенныхБумаг
			|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки
			|		КОГДА Партии.Партия ССЫЛКА Документ.Сделка
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.Сделка).Дата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Дата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ПоставкаЦенныхБумаг
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ПоставкаЦенныхБумаг).Дата
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ДатаПартии,
			|	ВЫБОР
			|		КОГДА Партии.КоличествоНачальныйОстаток > 0
			|			ТОГДА &НачалоПериодаДата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ВводЦенныхБумаг
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ВводЦенныхБумаг).Дата
			|		КОГДА Партии.Партия ССЫЛКА Документ.Сделка
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.Сделка).Дата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Дата
			|		КОГДА Партии.Партия ССЫЛКА Документ.ПоставкаЦенныхБумаг
			|			ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ПоставкаЦенныхБумаг).Дата
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ДатаВвода,
			|	ВЫБОР
			|		КОГДА Партии.КоличествоНачальныйОстаток > 0
			|			ТОГДА ""переоценка""
			|		ИНАЧЕ ""приобретение""
			|	КОНЕЦ КАК ВидОперации
			|ПОМЕСТИТЬ ПокупкиПредварительные
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			Период,
			|			Движения,
			|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
			|				И Организация = &Организация) КАК Партии
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты(
			|				&НачалоПериода,
			|				&ОкончаниеПериода,
			|				Период,
			|				СчетДоверительногоУправления = &СчетДоверительногоУправления
			|					И Организация = &Организация
			|					И (ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
			|						ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК РасходыПоСделкеОбороты
			|		ПО (ВЫБОР
			|				КОГДА Партии.Партия ССЫЛКА Документ.ВводЦенныхБумаг
			|					ТОГДА ЛОЖЬ
			|				КОГДА Партии.Партия ССЫЛКА Документ.Сделка
			|					ТОГДА Партии.Партия = РасходыПоСделкеОбороты.Сделка
			|				КОГДА Партии.Партия ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
			|					ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание = РасходыПоСделкеОбороты.Сделка
			|				КОГДА Партии.Партия ССЫЛКА Документ.ПоставкаЦенныхБумаг
			|					ТОГДА ВЫРАЗИТЬ(Партии.Партия КАК Документ.ПоставкаЦенныхБумаг).Основание = РасходыПоСделкеОбороты.Сделка
			|				ИНАЧЕ ЛОЖЬ
			|			КОНЕЦ)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
			|		ПО Партии.Партия = СделкаЦенныеБумаги.Ссылка
			|			И Партии.СтрокаПартии = СделкаЦенныеБумаги.СтрокаПартии
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
			|		ПО Партии.Партия = ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
			|			И Партии.СтрокаПартии = ИсполнениеОбязательствПоСделкеЦенныеБумаги.СтрокаПартии
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоставкаЦенныхБумаг.ЦенныеБумаги КАК ПоставкаЦенныхБумагЦенныеБумаги
			|		ПО Партии.Партия = ПоставкаЦенныхБумагЦенныеБумаги.Ссылка
			|			И Партии.СтрокаПартии = ПоставкаЦенныхБумагЦенныеБумаги.СтрокаПартии
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
