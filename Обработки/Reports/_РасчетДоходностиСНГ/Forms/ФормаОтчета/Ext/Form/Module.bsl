	xlSheet.Range("R" + СокрЛП(Формат(НомСтр + 1, "ЧГ="))).FormulaLocal = "=СУММ(R12:R" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ")";

	xlSheet.Range("D" + СокрЛП(Формат(НомСтр + 2, "ЧГ="))).FormulaLocal = СтрШаблон("=СУММ(D12:D%1)", СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")));
