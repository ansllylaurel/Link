		НомСтр = НомСтр + 1;
		КоличествоПокупки = КоличествоПокупки + 1;
		
		Если КолОсталось = 0 Тогда
			НачалоОткрытые = НачалоОткрытые + 1;
		КонецЕсли;
		
		ИтогОсталось = ИтогОсталось + СумОсталось;
		ИтогПродано = ИтогПродано + СумПродано;
	
		МинДатаОперации		= Мин(СтрокаПокупки.ДатаПартии, МинДатаОперации);
		МаксДатаОперации    = Макс(СтрокаПокупки.ДатаПартии, МаксДатаОперации);
		
	КонецЦикла;
	
