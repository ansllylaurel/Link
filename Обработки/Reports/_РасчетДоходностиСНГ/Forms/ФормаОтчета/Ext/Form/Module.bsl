		xlSheet.Range(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Interior.Pattern = xlSolid;
		
		//xlSheet.Rows(Формат(НомСтр, "ЧГ=") + ":" + Формат(НомСтр, "ЧГ=")).Select();
		//
		//ExcelApp.Selection.Interior.ColorIndex = 35;
		//ExcelApp.Selection.Interior.Pattern = xlSolid;
		
		НомСтр = НомСтр + 1;

	КонецЦикла;
	
	НачалоПродажи = НомСтр;
