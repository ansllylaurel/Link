	xlSheet.Cells(10, 5).Value = "Стоимость, руб.";
	xlSheet.Cells(10, 6).Value = "";
	xlSheet.Cells(11, 7).Value = "";
	xlSheet.Cells(10,11).Value = "% (план)";
	xlSheet.Cells(10,12).Value = "Срок до закрытия, дн.";

	ИтогОсталось = 0;
	ИтогПродано = 0;
	
	НомСтр = 12;
	
	НачалоПокупки = 12;
	КоличествоПокупки = 0;
	НачалоОткрытые = 12;
	НачалоЗакрытые = 12;
	
	МинДатаОперации		= Отчет.Период.ДатаОкончания;
	МаксДатаОперации	= Отчет.Период.ДатаОкончания;
	
	Для каждого СтрокаПокупки Из ЭтаФорма.Покупки Цикл
	
		Если СтрокаПокупки.ЦеннаяБумага <> СтрокаВсеЦБ.ЦеннаяБумага Тогда
			Продолжить;
		КонецЕсли;
		
		xlSheet.Range(Формат(НомСтр + 1, "ЧГ=") + ":" + Формат(НомСтр + 1, "ЧГ=")).Insert(xlDown);
		
