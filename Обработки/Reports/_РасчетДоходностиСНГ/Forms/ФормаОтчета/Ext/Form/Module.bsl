	Иначе
		xlSheet.Range("J" + СокрЛП(Формат(НомСтр, "ЧГ="))).FormulaLocal = "=ЧИСТВНДОХ(J12:J" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";$B$12:$B$" + СокрЛП(Формат(НомСтр - 1, "ЧГ=")) + ";0)";
