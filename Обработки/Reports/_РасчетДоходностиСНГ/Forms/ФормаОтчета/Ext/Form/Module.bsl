		xlSheet.Cells(НомСтр, 7).Value = СтрокаПокупки.КупонПокупки;
		xlSheet.Cells(НомСтр, 8).Value = СтрокаПокупки.СуммаПокупки;
		xlSheet.Cells(НомСтр, 9).Value = СтрокаПокупки.КомиссияПокупки;
		xlSheet.Cells(НомСтр,10).Value = - (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки);

		xlSheet.Cells(НомСтр,11).Value = СтрокаПокупки.Доходность;
		xlSheet.Cells(НомСтр,12).Value = СтрокаПокупки.Дней;
		xlSheet.Cells(НомСтр,13).Value = - (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки) * СтрокаПокупки.Дней;
		
		СумПродано = СтрокаПокупки.СуммаПродано + СтрокаПокупки.КупонПродано;
		
		КолОсталось = СтрокаПокупки.КоличествоПокупки - СтрокаПокупки.КоличествоПродано;
		СумОсталось = (СтрокаПокупки.СуммаПокупки + СтрокаПокупки.КупонПокупки) - СумПродано;
		Если КолОсталось = 0 Тогда
			СумОсталось = 0;
		КонецЕсли;
		
		xlSheet.Cells(НомСтр,15).Value = КолОсталось;
		xlSheet.Cells(НомСтр,16).Value = - СумОсталось;
		
		xlSheet.Cells(НомСтр,17).Value = СтрокаПокупки.КоличествоПродано;
