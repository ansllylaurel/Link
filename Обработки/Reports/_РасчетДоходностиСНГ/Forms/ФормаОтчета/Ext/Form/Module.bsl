	КонецЕсли;

	xlSheet.Range("C6").FormulaLocal = СтрШаблон("=СУММПРОИЗВ(K12:K%1;J12:J%1;L12:L%1*K12:K%1/K12:K%1)/СУММПРОИЗВ(J12:J%1;L12:L%1)/100", СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")));
	Если НачалоОткрытые = НачалоПогашения Тогда
