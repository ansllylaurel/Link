		xlSheet.Cells(7, 3).Value = 0;
		xlSheet.Cells(7, 4).Value = 0;
	Иначе
		xlSheet.Range("C7").FormulaLocal = "=СУММПРОИЗВ(K12:K" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";P12:P" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/СУММПРОИЗВ(P12:P" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ";L12:L" + СокрЛП(Формат(НачалоПогашения - 1, "ЧГ=")) + ")/100";
