&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтотОбъект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтотОбъект.Дата = НачалоДня(КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1)));
	
КонецПроцедуры

&НаСервере
Процедура Обновить(Уровень) // Уровень: 1-изменили клиента, 2-выбрали счета ДУ, 3-выбрали активы ЕПС
	
	Если Уровень = 1 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И Клиент = &Клиент) КАК КлиентыДоверительногоУправленияСрезПоследних
			|ГДЕ
			|	(КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &ПериодДата
			|			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
			|
			|УПОРЯДОЧИТЬ ПО
			|	СчетДоверительногоУправления";
		
		Запрос.УстановитьПараметр("ПериодДата", КонецДня(ЭтотОбъект.Дата));
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Клиент", ЭтотОбъект.Клиент);
		
		ЭтотОбъект.СчетаДоверительногоУправления.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления"));
		ЭтотОбъект.СчетаДоверительногоУправления.ЗаполнитьПометки(Истина);
		
		Уровень = 2;
	
	КонецЕсли;
	
	Если Уровень = 2 Тогда
		
		СчетаДУ = Новый Массив;
		Для каждого СчетДоверительногоУправления Из ЭтотОбъект.СчетаДоверительногоУправления Цикл
			Если СчетДоверительногоУправления.Пометка Тогда
				СчетаДУ.Добавить(СчетДоверительногоУправления.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.Родитель КАК УчетныйАктив
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
			|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость) КАК БухПартииЦенныхБумагОстатки
			|
			|УПОРЯДОЧИТЬ ПО
			|	УчетныйАктив";
		
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДУ);
		
		ЭтотОбъект.УчетныеАктивы.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("УчетныйАктив"));
		ЭтотОбъект.УчетныеАктивы.ЗаполнитьПометки(Истина);
		
		Уровень = 3;
	
	КонецЕсли;
	
	Если Уровень = 3 Тогда
	
		СчетаДУ = Новый Массив;
		Для каждого СчетДоверительногоУправления Из ЭтотОбъект.СчетаДоверительногоУправления Цикл
			Если СчетДоверительногоУправления.Пометка Тогда
				СчетаДУ.Добавить(СчетДоверительногоУправления.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Активы = Новый Массив;
		Для каждого УчетныйАктив Из ЭтотОбъект.УчетныеАктивы Цикл
			Если УчетныйАктив.Пометка Тогда
				Активы.Добавить(УчетныйАктив.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|			&Период,
			|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
			|				И Организация = &Организация
			|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
			|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
			|				И УчетныйАктивЕПС.Родитель В (&Активы)) КАК БухПартииЦенныхБумагОстатки
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЦеннаяБумага
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДУ);
		Запрос.УстановитьПараметр("Активы", Активы);
		
		ЭтотОбъект.Облигации.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага"));
		ЭтотОбъект.Облигации.ЗаполнитьПометки(Истина);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьНачалоОкончаниеСессииНаСервере(ПараметрыСессии)
	
	Если ПараметрыСессии = Неопределено Тогда
		
		Механизм = "ВнешнийОтчет._СформироватьРасшифровкуРасчетаАСПоПортфелю.СформироватьРасшифровкуРасчетаАС()";
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтаФорма.Отчет, "", Новый Структура("Дата,Организация,Клиент", ЭтаФорма.Дата, ЭтаФорма.Организация, ЭтаФорма.Клиент));
		
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
				
		ПараметрыСессии = Новый Структура("Сессия, Механизм", Сессия, Механизм);
	
	Иначе
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	Обновить(1);
КонецПроцедуры

