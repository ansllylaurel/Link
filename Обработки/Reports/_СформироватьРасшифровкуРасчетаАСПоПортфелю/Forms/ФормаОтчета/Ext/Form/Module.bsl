&НаСервере
Функция ПолучитьМассивБумаг(СчетДУ, Активы, ЦБ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Дата,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|				И УчетныйАктивЕПС.Родитель В (&Активы)
		|				И ЦеннаяБумага В (&ЦБ)) КАК БухПартииЦенныхБумагОстатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Дата", Новый Граница(КонецДня(ЭтотОбъект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДУ);
	Запрос.УстановитьПараметр("Активы", Активы);
	Запрос.УстановитьПараметр("ЦБ", ЦБ);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЦеннаяБумага");

КонецФункции

&НаКлиенте
Процедура СформироватьРасшифровкуРасчетаАС(Команда)
		
	ПараметрыСессии = Неопределено;
	
	ЗарегистрироватьНачалоОкончаниеСессииНаСервере(ПараметрыСессии);
		
	Для каждого СчетДоверительногоУправления Из ЭтотОбъект.СчетаДоверительногоУправления Цикл
		
		Если НЕ СчетДоверительногоУправления.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		СчетДУ = СчетДоверительногоУправления.Значение;
		
		Активы = Новый Массив;
		Для каждого УчетныйАктив Из ЭтотОбъект.УчетныеАктивы Цикл
			Если УчетныйАктив.Пометка Тогда
				Активы.Добавить(УчетныйАктив.Значение);
			КонецЕсли;
		КонецЦикла;
		
		ЦБ = Новый Массив;
		Для каждого Облигация Из ЭтотОбъект.Облигации Цикл
			Если Облигация.Пометка Тогда
				ЦБ.Добавить(Облигация.Значение);
			КонецЕсли;
		КонецЦикла;
		
		МассивБумаг = ПолучитьМассивБумаг(СчетДУ, Активы, ЦБ);
		
		Если МассивБумаг.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Книга = Новый ПакетОтображаемыхДокументов;
		
		ПараметрыПереоценки	= Новый Структура;
		ПараметрыПереоценки.Вставить("Организация", ЭтотОбъект.Организация);
		ПараметрыПереоценки.Вставить("СчетДоверительногоУправления", СчетДУ);
		ПараметрыПереоценки.Вставить("ЦельРасчета", ПредопределенноеЗначение("Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении"));
		ПараметрыПереоценки.Вставить("ВидУчета", ПредопределенноеЗначение("Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет"));
		ПараметрыПереоценки.Вставить("Дата", ЭтотОбъект.Дата);
		
		Отказ						= Ложь;
		НастройкиОценки				= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПараметрыПереоценки.Дата, ПараметрыПереоценки.Организация, ПараметрыПереоценки.СчетДоверительногоУправления, ПараметрыПереоценки.ЦельРасчета, Истина);
		АдресТаблицыСтоимостей		= Неопределено;
		
		Для каждого ЦеннаяБумага Из МассивБумаг Цикл
			
			Ошибки				= Неопределено;
			РасшифровкаРасчета	= Неопределено;
			
			Если РаботаСДокументами.СформироватьРасшифровкуРасчетаСтоимостиЦеннойБумаги(РасшифровкаРасчета, ПараметрыПереоценки, ЦеннаяБумага, НастройкиОценки.ВариантРасчетаОценочнойСтоимости, АдресТаблицыСтоимостей, Ошибки) Тогда
				Страница = Книга.Состав.Добавить(ПоместитьВоВременноеХранилище(РасшифровкаРасчета, Новый УникальныйИдентификатор));		
				Страница.Наименование = Строка(ЦеннаяБумага);
			ИначеЕсли Ошибки.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расшифровка расчета стоимости для варианта '" + НастройкиОценки.ВариантРасчетаОценочнойСтоимости + "' не реализована");	
			Иначе
				ТекстОшибки = "Ошибка получения расшифровки расчета:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		
		КонецЦикла;
		
		Каталог = КаталогВременныхФайлов();
		ИмяФайла = Строка(СчетДУ) + "_" + Формат(ЭтотОбъект.Дата, "ДФ=dd.MM.yyyy") + ".xlsx";
		ПолноеИмяФайла = Каталог + ИмяФайла;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ПолноеИмяФайла);
		//ИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
		Книга.Записать(ПолноеИмяФайла, ТипФайлаПакетаОтображаемыхДокументов.XLSX);
		ЗапуститьПриложение(ПолноеИмяФайла);
		
	КонецЦикла;
	
	ЗарегистрироватьНачалоОкончаниеСессииНаСервере(ПараметрыСессии);
	
КонецПроцедуры

