Функция ВывестиОтчетнуюФорму(ОтчетнаяФорма, Данные)
	
	РезультатОтчета = Неопределено;
	
	Если ОтчетнаяФорма = "1ДПР" 
	 ИЛИ ОтчетнаяФорма = "1РПР"
	 ИЛИ ОтчетнаяФорма = "2ДПР" 
	 ИЛИ ОтчетнаяФорма = "2РПР" Тогда
		РезультатОтчета = Сформировать1_2_РПР_ДПР(Данные, ОтчетнаяФорма);
	//ИначеЕсли ОтчетнаяФорма = "2ДПР" Тогда 
		//РезультатОтчета = Сформировать2ДПР(Данные, ОтчетнаяФорма);			
	ИначеЕсли ОтчетнаяФорма = "1НБПР" Тогда	
		РезультатОтчета = Сформировать1НБПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "3РПР" Тогда
		РезультатОтчета = Сформировать3РПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "4РПР" Тогда
		РезультатОтчета = Сформировать4РПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "5РПР" Тогда
		РезультатОтчета = Сформировать5РПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "6ДПР" Тогда
		РезультатОтчета = Сформировать6ДПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "7ДПР" Тогда
		РезультатОтчета = Сформировать7ДПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "8ДПР" Тогда
		РезультатОтчета = Сформировать8ДПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "8ДПРИН" Тогда
		РезультатОтчета = Сформировать8ДПРИН(Данные);
	ИначеЕсли ОтчетнаяФорма = "9ДПР" Тогда
		РезультатОтчета = Сформировать9ДПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "9ДПР2" Тогда
		РезультатОтчета = Сформировать9ДПР2(Данные);
	ИначеЕсли ОтчетнаяФорма = "9ДПР2020" Тогда
		РезультатОтчета = Сформировать9ДПР2020(Данные);
	ИначеЕсли ОтчетнаяФорма = "10ДПР" Тогда
		РезультатОтчета = Сформировать10ДПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "11ДПР" Тогда
		РезультатОтчета = Сформировать11ДПР(Данные);
	ИначеЕсли ОтчетнаяФорма = "11ДПР_2" Тогда
		РезультатОтчета = Сформировать11ДПР(Данные, Истина);
	ИначеЕсли ОтчетнаяФорма = "ВедКД15" Тогда
		РезультатОтчета = СформироватьВедКД(Данные, "15");
	ИначеЕсли ОтчетнаяФорма = "ВедКД20" Тогда
		РезультатОтчета = СформироватьВедКД(Данные, "20");		
	ИначеЕсли ОтчетнаяФорма = "ОтчетОФинансовомРезультатеДУ" Тогда
		РезультатОтчета = СформироватьОтчетОФинансовомРезультатеДУ(Данные);
	ИначеЕсли ОтчетнаяФорма = "8ДПРИНОтр" Тогда
		РезультатОтчета = Сформировать8ДПРИН(Данные, Истина);
	ИначеЕсли ОтчетнаяФорма = "РегистрУчетаПрочихРасходовОтРазмещенияПенсионныхРезервов" Тогда
		РезультатОтчета = СформироватьРегистрУчетаПрочихРасходовОтРазмещенияПенсионныхРезервов(Данные);
	ИначеЕсли ОтчетнаяФорма = "РегистрУчетаПрочихДоходовОтРазмещенияПенсионныхРезервов" Тогда
		РезультатОтчета = СформироватьРегистрУчетаПрочихДоходовОтРазмещенияПенсионныхРезервов(Данные);			
	ИначеЕсли ОтчетнаяФорма = "5РПР_Мет" Тогда 
		РезультатОтчета = Сформировать5РПР_Мет(Данные);
	ИначеЕсли ОтчетнаяФорма = "2РПР_СНГ" Тогда 
		РезультатОтчета = Сформировать2РПР_СНГ(Данные);
	ИначеЕсли ОтчетнаяФорма = "3ДПР_СНГ" Тогда 
		РезультатОтчета = Сформировать3ДПР_СНГ(Данные);	
