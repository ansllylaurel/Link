
#Область ЭкспортныеПроцедурыИФункции

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Доходы и расходы пенсионных резервов",
		"2.21",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьДанныеДляОтчетнойФормы(ОтчетнаяФорма, ДополнительныеПараметры = Неопределено) Экспорт
	
	Данные = Новый Структура;
	
	ЗаполнитьОбщиеПараметры(Данные);
	
	Если ОтчетнаяФорма = "1ДПР" ИЛИ ОтчетнаяФорма = "2ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные1_2ДПР(ОтчетнаяФорма);
	//ИначеЕсли ОтчетнаяФорма = "2ДПР" Тогда	
	//	ДанныеДляОтчета = ПолучитьДанные2ДПР(ОтчетнаяФорма);
	ИначеЕсли ОтчетнаяФорма = "1НБПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные1НБПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "1РПР" ИЛИ ОтчетнаяФорма = "2РПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные1_2РПР(ОтчетнаяФорма);
	ИначеЕсли ОтчетнаяФорма = "3РПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные3РПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "4РПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные4РПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "5РПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные5РПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "6ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные6ДПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "7ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные7ДПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "8ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные8ДПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "8ДПРИН" Тогда
		ДанныеДляОтчета = ПолучитьДанные8ДПРИН(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "9ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные9ДПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "9ДПР2" Тогда
		ДанныеДляОтчета = ПолучитьДанные9ДПР2(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "9ДПР2020" Тогда
		ДанныеДляОтчета = ПолучитьДанные9ДПР2020(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "10ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные10ДПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "11ДПР" Тогда
		ДанныеДляОтчета = ПолучитьДанные11ДПР(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "11ДПР_2" Тогда
		ДанныеДляОтчета = ПолучитьДанные11ДПР(ДополнительныеПараметры, Истина);
	ИначеЕсли ОтчетнаяФорма = "ВедКД15" Тогда
		ДанныеДляОтчета = ПолучитьДанныеВедКД(ДополнительныеПараметры, "15");
	ИначеЕсли ОтчетнаяФорма = "ВедКД20" Тогда	
		ДанныеДляОтчета = ПолучитьДанныеВедКД(ДополнительныеПараметры, "20");
	ИначеЕсли ОтчетнаяФорма = "8ДПРИНОтр" Тогда
		ДанныеДляОтчета = ПолучитьДанные8ДПРИН(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "ОтчетОФинансовомРезультатеДУ" Тогда
		
		Если НачалоКвартала(Период.ДатаНачала) <> НачалоКвартала(Период.ДатаОкончания) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет о финансовом результате ДУ формируется в пределах одного квартала!");
			Возврат Неопределено;
		КонецЕсли;
		
		ДанныеДляОтчета = ПолучитьДанныеОтчетаОФинансовомРезультатеДУ(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "РегистрУчетаПрочихРасходовОтРазмещенияПенсионныхРезервов" Тогда
		ДанныеДляОтчета = ПолучитьДанныеРегистраУчетаПрочихРасходовОтРазмещенияПенсионныхРезервов(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "РегистрУчетаПрочихДоходовОтРазмещенияПенсионныхРезервов" Тогда
		ДанныеДляОтчета = ПолучитьДанныеРегистраУчетаПрочихДоходовОтРазмещенияПенсионныхРезервов(ДополнительныеПараметры);	
	ИначеЕсли ОтчетнаяФорма = "5РПР_Мет" Тогда
		ДанныеДляОтчета = ПолучитьДанные5РПР_Мет(ДополнительныеПараметры); 
	ИначеЕсли ОтчетнаяФорма = "2РПР_СНГ" Тогда
		ДанныеДляОтчета = ПолучитьДанные2РПР_СНГ(ДополнительныеПараметры);
	ИначеЕсли ОтчетнаяФорма = "3ДПР_СНГ" Тогда	
		ДанныеДляОтчета = ПолучитьДанные3ДПР_СНГ(ДополнительныеПараметры);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Форма отчета %1 не поддерживается!", ОтчетнаяФорма));
		Возврат Неопределено;                                                                                                  
	КонецЕсли;
	
	РаботаСКоллекциями.ДополнитьСтруктуру(Данные, ДанныеДляОтчета, Истина);
	
	Возврат Данные;
	
КонецФункции

Процедура СформироватьОтчет(Результат, ОтчетнаяФорма, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,Подписант,Руководитель", Новый Структура("ОтчетнаяФорма", ОтчетнаяФорма));
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	Данные = ПолучитьДанныеДляОтчетнойФормы(ОтчетнаяФорма, ДополнительныеПараметры);
	
	Если Данные <> Неопределено Тогда
		Результат = ВывестиОтчетнуюФорму(ОтчетнаяФорма, Данные);
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

