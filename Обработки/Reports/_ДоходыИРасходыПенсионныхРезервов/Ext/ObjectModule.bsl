КонецФункции

Функция ПолучитьДанные5РПР(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();

	Данные.Вставить("ПериодМесяц", Формат(Период.ДатаОкончания, "ДФ='ММММ гггг ''г.'''"));
	
	Если ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("Вариант") Тогда
		Вариант = ДополнительныеПараметры.Вариант;
		Данные.Вставить("ВариантПериода", ?(Вариант = 1, "до", "с"));
	Иначе
		Вариант = 0;
		Данные.Вставить("ВариантПериода", "с");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НачалоПериода",					Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("КонецПериода",					Период.ДатаОкончания);
	Запрос.УстановитьПараметр("НачалоПериодаПриобретения",		?(Вариант = 0, Дата(2014, 8, 21), Дата(1, 1, 1)));
	Запрос.УстановитьПараметр("КонецПериодаПриобретения",		?(Вариант = 0, Период.ДатаОкончания, Дата(2014, 8, 21, 23, 59, 59)));
	Запрос.УстановитьПараметр("ММВБ",							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	
	#Область ТекстЗапроса
	
	Если Период.ДатаНачала < Дата(2020,1,1) Тогда 	
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК Стоимость,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК НКД
		|ПОМЕСТИТЬ _НачальныеОстатки
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&НачалоПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи))) КАК БухПартииЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОбороты.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОбороты.Партия КАК Партия,
		|	БухПартииЦенныхБумагОбороты.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОбороты.КоличествоПриход КАК КоличествоПоступило,
		|	БухПартииЦенныхБумагОбороты.КоличествоРасход КАК КоличествоВыбыло,
		|	БухПартииЦенныхБумагОбороты.СтоимостьВВалютеУчетаРасход КАК СтоимостьВыбыло,
		|	БухПартииЦенныхБумагОбороты.СтоимостьКупонаВВалютеУчетаРасход КАК НКДВыбыло
		|ПОМЕСТИТЬ _Обороты
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
