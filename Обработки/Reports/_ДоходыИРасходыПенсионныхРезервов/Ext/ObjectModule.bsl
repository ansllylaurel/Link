Процедура ВывестиРаздел_1_2_РПР_ДПР(РезультатОтчета, Макет, Данные, Раздел, ВидАктива)
	
	ОбластьРаздел	= Макет.ПолучитьОбласть("Раздел");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог		= Макет.ПолучитьОбласть("ИтогРаздела");
	
	ОбластьРаздел.Параметры.Раздел = Раздел;
	РезультатОтчета.Вывести(ОбластьРаздел);
	
	ПараметрыПоиска = Новый Структура("ВидАктива", ВидАктива);
	НайденныеСтроки = Данные.Движения.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		РезультатОтчета.Вывести(ОбластьСтрока);
	КонецЦикла;	
	
	ВывестиИтог_1_2_РПР_ДПР(РезультатОтчета, ОбластьИтог, Данные, Раздел, ВидАктива);	
	
КонецПроцедуры

Процедура ВывестиИтог_1_2_РПР_ДПР(РезультатОтчета, ОбластьИтог, Данные, Раздел, ВидыАктива)
	
	МассивВидовАктивов = СтрРазделить(ВидыАктива, ",");
	
	Итоги = Новый Структура("СуммаПериод, СуммаСНачалаГода", 0, 0);
	
	Для Каждого ВидАктива Из МассивВидовАктивов Цикл
		ПараметрыПоиска = Новый Структура("ВидАктива", ВидАктива);
		НайденныеСтроки = Данные.Итоги.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			Для Каждого Итог Из Итоги Цикл
				Итоги[Итог.Ключ] = Итоги[Итог.Ключ] + СтрокаДанных[Итог.Ключ];
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Итоги.Вставить("Раздел", Раздел);
	
	ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, Итоги);
	
	РезультатОтчета.Вывести(ОбластьИтог);
	
КонецПроцедуры

