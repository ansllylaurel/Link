Функция ПолучитьДанные10ДПР(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации(); 
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГода",		Макс(ДатаРеформации, НачалоГода(Период.ДатаНачала)));
	Запрос.УстановитьПараметр("НачалоПериода",	Макс(ДатаРеформации, Период.ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода",	Период.ДатаОкончания);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка КАК Депозит,
		|	НоминалыКредитныхИнструментовСрезПоследних.Сумма КАК Сумма,
		|	УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент,
		|	ДепозитныеВклады.ДатаРегистрации КАК ДатаНачалаНачисленияПроцентов,
		|	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|	ЕСТЬNULL(ПроцентыПоКредитнымИнструментамСрезПоследних.Регистратор.Дата, """") КАК ДатаНачисления,
		|	РАЗНОСТЬДАТ(ДепозитныеВклады.ДатаРегистрации, ЕСТЬNULL(ПроцентыПоКредитнымИнструментамСрезПоследних.Регистратор.Дата, &КонецПериода), ДЕНЬ) КАК Дни
		|ПОМЕСТИТЬ _Депозиты
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&КонецПериода,
		|			Период,
		|			,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ДепозитныеСчета),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НалоговыйУчетОстаткиИОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
		|				УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент
		|			ИЗ
		|				(ВЫБРАТЬ
		|					УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|					МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|				ИЗ
		|					РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ГДЕ
		|					УсловияКредитныхИнструментовСрезПоследних.Действует
		|				
		|				СГРУППИРОВАТЬ ПО
		|					УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|					ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|						И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ПО ДепозитныеВклады.Ссылка = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыКредитныхИнструментов.СрезПоследних(&КонецПериода, Сумма > 0) КАК НоминалыКредитныхИнструментовСрезПоследних
		|			ПО ДепозитныеВклады.Ссылка = НоминалыКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроцентыПоКредитнымИнструментам.СрезПоследних(&КонецПериода, ) КАК ПроцентыПоКредитнымИнструментамСрезПоследних
		|			ПО ДепозитныеВклады.Ссылка = ПроцентыПоКредитнымИнструментамСрезПоследних.КредитныйИнструмент
		|		ПО НалоговыйУчетОстаткиИОбороты.Субконто1 = ДепозитныеВклады.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОстатки.Субконто1 КАК Субконто1,
		|	НалоговыйУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ПроцентыНачалоГода
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Остатки(
		|			&НачалоГода,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоМинимальномуНеснижаемомуОстатку)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НалоговыйУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА НалоговыйУчетОбороты.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам)
		|			ТОГДА ""депозиты""
		|		ИНАЧЕ ""МНО""
		|	КОНЕЦ КАК Таблица,
		|	ВЫБОР
		|		КОГДА НалоговыйУчетОбороты.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам)
		|			ТОГДА ""Начисления процентного дохода по депозитным вкладам""
		|		ИНАЧЕ ""Начисление процентного дохода на минимальный неснижаемый остаток на расчетном счете""
		|	КОНЕЦ КАК ТекстЗаголовка,
		|	ЕСТЬNULL(МНО.РасчетныйСчет.Банк, _Депозиты.Депозит) КАК Депозит,
		|	ЕСТЬNULL(МНО.Дата, _Депозиты.ДатаНачалаНачисленияПроцентов) КАК ДатаОткрытия,
		|	ЕСТЬNULL(МНО.ДатаВозврата, _Депозиты.ДатаПогашения) КАК ДатаПогашения,
		|	ЕСТЬNULL(_Депозиты.ДатаНачисления, """") КАК ДатаНачисления,
		|	ЕСТЬNULL(МНО.Сумма, _Депозиты.Сумма) КАК Сумма,
		|	ЕСТЬNULL(МНО.Процент, _Депозиты.Процент) КАК Процент,
		|	ВЫБОР
		|		КОГДА _Депозиты.Дни ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА МНО.ДатаВозврата < &КонецПериода
		|						ТОГДА РАЗНОСТЬДАТ(МНО.Дата, МНО.ДатаВозврата, ДЕНЬ)
		|					ИНАЧЕ РАЗНОСТЬДАТ(МНО.Дата, &КонецПериода, ДЕНЬ)
		|				КОНЕЦ
		|		ИНАЧЕ _Депозиты.Дни
		|	КОНЕЦ КАК Дни,
		|	СУММА(ВЫБОР
		|			КОГДА НалоговыйУчетОбороты.Период < &НачалоПериода
		|				ТОГДА НалоговыйУчетОбороты.СуммаОборотКт
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК НачисленоПредыдущийПериод,
		|	СУММА(ВЫБОР
		|			КОГДА НалоговыйУчетОбороты.Период >= &НачалоПериода
		|				ТОГДА НалоговыйУчетОбороты.СуммаОборотКт
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК НачисленоЗаПериод,
		|	СУММА(НалоговыйУчетОбороты.СуммаОборотКт) КАК НачисленоСНачалаПериода,
		|	НалоговыйУчетОбороты.Субконто2 КАК Субконто2
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоГода,
		|			&КонецПериода,
		|			День,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
		|			КорСчет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоМинимальномуНеснижаемомуОстатку)),
		|			) КАК НалоговыйУчетОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МНО КАК МНО
		|		ПО НалоговыйУчетОбороты.Субконто2 = МНО.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Депозиты КАК _Депозиты
		|		ПО НалоговыйУчетОбороты.Субконто2 = _Депозиты.Депозит
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА НалоговыйУчетОбороты.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам)
		|			ТОГДА ""депозиты""
		|		ИНАЧЕ ""МНО""
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА НалоговыйУчетОбороты.КорСчет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам)
		|			ТОГДА ""Начисления процентного дохода по депозитным вкладам""
		|		ИНАЧЕ ""Начисление процентного дохода на минимальный неснижаемый остаток на расчетном счете""
		|	КОНЕЦ,
		|	ЕСТЬNULL(МНО.РасчетныйСчет.Банк, _Депозиты.Депозит),
		|	ЕСТЬNULL(МНО.Дата, _Депозиты.ДатаНачалаНачисленияПроцентов),
		|	ЕСТЬNULL(МНО.ДатаВозврата, _Депозиты.ДатаПогашения),
		|	ЕСТЬNULL(_Депозиты.ДатаНачисления, """"),
		|	ЕСТЬNULL(МНО.Сумма, _Депозиты.Сумма),
		|	ЕСТЬNULL(МНО.Процент, _Депозиты.Процент),
		|	ВЫБОР
		|		КОГДА _Депозиты.Дни ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА МНО.ДатаВозврата < &КонецПериода
		|						ТОГДА РАЗНОСТЬДАТ(МНО.Дата, МНО.ДатаВозврата, ДЕНЬ)
		|					ИНАЧЕ РАЗНОСТЬДАТ(МНО.Дата, &КонецПериода, ДЕНЬ)
		|				КОНЕЦ
		|		ИНАЧЕ _Депозиты.Дни
		|	КОНЕЦ,
		|	НалоговыйУчетОбороты.Субконто2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.Таблица КАК Таблица,
		|	_ИтоговаяТаблица.ТекстЗаголовка КАК ТекстЗаголовка,
		|	_ИтоговаяТаблица.Депозит КАК Депозит,
		|	_ИтоговаяТаблица.ДатаОткрытия КАК ДатаОткрытия,
		|	_ИтоговаяТаблица.ДатаПогашения КАК ДатаПогашения,
		|	_ИтоговаяТаблица.ДатаНачисления КАК ДатаНачисления,
		|	_ИтоговаяТаблица.Сумма КАК Сумма,
		|	_ИтоговаяТаблица.Процент КАК Процент,
		|	_ИтоговаяТаблица.Дни КАК Дни,
		|	ЕСТЬNULL(_ПроцентыНачалоГода.СуммаОстаток, 0) + _ИтоговаяТаблица.НачисленоСНачалаПериода КАК Всего,
		|	ЕСТЬNULL(_ПроцентыНачалоГода.СуммаОстаток, 0) КАК НачисленоНаНачалоГода,
		|	_ИтоговаяТаблица.НачисленоСНачалаПериода КАК НачисленоСНачалаПериода,
		|	_ИтоговаяТаблица.НачисленоПредыдущийПериод КАК НачисленоПредыдущийПериод,
		|	_ИтоговаяТаблица.НачисленоЗаПериод КАК НачисленоЗаПериод
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПроцентыНачалоГода КАК _ПроцентыНачалоГода
		|		ПО _ИтоговаяТаблица.Субконто2 = _ПроцентыНачалоГода.Субконто1
		|
		|УПОРЯДОЧИТЬ ПО
		|	Таблица,
		|	ДатаОткрытия
		|ИТОГИ
		|	МАКСИМУМ(ТекстЗаголовка),
		|	СУММА(Всего),
		|	СУММА(НачисленоНаНачалоГода),
		|	СУММА(НачисленоСНачалаПериода),
		|	СУММА(НачисленоПредыдущийПериод),
		|	СУММА(НачисленоЗаПериод)
		|ПО
		|	ОБЩИЕ,
		|	Таблица";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Вставить("Выборка", Выборка);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанные11ДПР(ДополнительныеПараметры, ПрямоеРЕПО = Ложь)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("СчетДУ",			СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",	Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("КонецПериода",	Период.ДатаОкончания);  
	Запрос.УстановитьПараметр("КонецПредыдущегоПериода",	Макс(Период.ДатаНачала, ДатаРеформации) - 1);
	Запрос.УстановитьПараметр("ДоходыРЕПО", Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию("Проценты по РЕПО"));
	Запрос.УстановитьПараметр("НачалоПериодаМесяц",	Период.ДатаНачала);
	Если ПрямоеРЕПО Тогда
		Запрос.УстановитьПараметр("Раздел", "1. Реализация (для продавца по первой части)"); 
		Запрос.УстановитьПараметр("ВидСделки", Перечисления.ВидыСделок.Продажа);
	Иначе
		Запрос.УстановитьПараметр("Раздел", "2. Приобретение (для покупателя по первой части)");  
		Запрос.УстановитьПараметр("ВидСделки", Перечисления.ВидыСделок.Покупка)
	КонецЕсли;
	
	ТекстЗапросаОбщаяЧасть =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчета КАК СчетУчета
		|ПОМЕСТИТЬ _СчетаУчетаКомиссии
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК НастройкиУчетаКомиссииСрезПоследних
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Основной.Ссылка
		|ИЗ
		|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И МетодПризнанияРасходовПоСделкамРЕПО = ЗНАЧЕНИЕ(Перечисление.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичностиСОтражениемНаСчетеРасчетов)) КАК НастройкиПоВидуУчетаСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.Основной КАК Основной
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Основной.Ссылка = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО КАК АналитикаРЕПО
		|ПОМЕСТИТЬ _РасходыРЕПО
		|ИЗ
		|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДУ
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК НастройкиУчетаКомиссииСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОбороты.КорСубконто2 КАК СделкаРЕПО,
		|	СУММА(НалоговыйУчетОбороты.СуммаОборотДт) КАК Сумма
		|ПОМЕСТИТЬ _КомиссииРЕПО
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДУ
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						_РасходыРЕПО.АналитикаРЕПО КАК АналитикаРЕПО
		|					ИЗ
		|						_РасходыРЕПО КАК _РасходыРЕПО)
		|				И ТИПЗНАЧЕНИЯ(КорСубконто2) = ТИП(Документ.СделкаРЕПО),
		|			КорСчет В
		|				(ВЫБРАТЬ
		|					_СчетаУчетаКомиссии.СчетУчета КАК СчетУчета
		|				ИЗ
		|					_СчетаУчетаКомиссии КАК _СчетаУчетаКомиссии),
		|			) КАК НалоговыйУчетОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	НалоговыйУчетОбороты.КорСубконто2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(НалоговыйУчетДвиженияССубконто.Регистратор) = ТИП(Документ.СделкаРЕПО)
		|			ТОГДА НалоговыйУчетДвиженияССубконто.Регистратор
		|		КОГДА ТИПЗНАЧЕНИЯ(НалоговыйУчетДвиженияССубконто.Регистратор) = ТИП(Документ.НачислениеЗадолженности)
		|			ТОГДА НачислениеЗадолженностиОснования.Основание
		|		КОГДА ТИПЗНАЧЕНИЯ(НалоговыйУчетДвиженияССубконто.Регистратор) = ТИП(Документ.Оплата)
		|			ТОГДА ОплатаОснования.Основание
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК СделкаРЕПО,
		|	СУММА(НалоговыйУчетДвиженияССубконто.Сумма) КАК Сумма
		|ПОМЕСТИТЬ _КомиссииРЕПО1
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.ДвиженияССубконто(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДУ
		|				И СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы)
		|				И СубконтоДт1 В
		|					(ВЫБРАТЬ
		|						_РасходыРЕПО.АналитикаРЕПО КАК АналитикаРЕПО
		|					ИЗ
		|						_РасходыРЕПО КАК _РасходыРЕПО)
		|				И СчетКт В
		|					(ВЫБРАТЬ
		|						_СчетаУчетаКомиссии.СчетУчета КАК СчетУчета
		|					ИЗ
		|						_СчетаУчетаКомиссии КАК _СчетаУчетаКомиссии),
		|			,
		|			) КАК НалоговыйУчетДвиженияССубконто
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|		ПО НалоговыйУчетДвиженияССубконто.Регистратор = НачислениеЗадолженностиОснования.Ссылка
		|			И НалоговыйУчетДвиженияССубконто.НомерСтроки = НачислениеЗадолженностиОснования.НомерСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО НалоговыйУчетДвиженияССубконто.Регистратор = ОплатаОснования.Ссылка
		|			И НалоговыйУчетДвиженияССубконто.НомерСтроки = ОплатаОснования.НомерСтроки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(НалоговыйУчетДвиженияССубконто.Регистратор) = ТИП(Документ.СделкаРЕПО)
		|			ТОГДА НалоговыйУчетДвиженияССубконто.Регистратор
		|		КОГДА ТИПЗНАЧЕНИЯ(НалоговыйУчетДвиженияССубконто.Регистратор) = ТИП(Документ.НачислениеЗадолженности)
		|			ТОГДА НачислениеЗадолженностиОснования.Основание
		|		КОГДА ТИПЗНАЧЕНИЯ(НалоговыйУчетДвиженияССубконто.Регистратор) = ТИП(Документ.Оплата)
		|			ТОГДА ОплатаОснования.Основание
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(НАЧАЛОПЕРИОДА(НалоговыйУчетОбороты.Субконто2.Дата, ДЕНЬ)) КАК Дата
		|ПОМЕСТИТЬ _НачалоОтсчета
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО), ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДУ
		|				И КорСубконто1 = &ДоходыРЕПО,
		|			,
		|			) КАК НалоговыйУчетОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоходРасходПоРЕПО.Период КАК Период,
		|	ДоходРасходПоРЕПО.Субконто2 КАК Субконто2,
		|	СУММА(ДоходРасходПоРЕПО.СуммаНаНачалоПериода) КАК СуммаНаНачалоПериода,
		|	СУММА(ДоходРасходПоРЕПО.СуммаТекущийПериод) КАК СуммаТекущийПериод
		|ПОМЕСТИТЬ _ДоходРасходПредварительно
		|ИЗ
		|	(ВЫБРАТЬ
		|		НалоговыйУчетОбороты.Период КАК Период,
		|		НалоговыйУчетОбороты.Субконто2 КАК Субконто2,
		|		НалоговыйУчетОбороты.СуммаОборотДт КАК СуммаНаНачалоПериода,
		|		0 КАК СуммаТекущийПериод
		|	ИЗ
		|		РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|				,
		|				&КонецПредыдущегоПериода,
		|				Месяц,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДУ
		|					И КорСубконто1 = &ДоходыРЕПО,
