	//заполнение строки
	СтрокаДанных = ДанныеОтчета.Добавить();
	
	Данные1ДПР = ПолучитьДанные1_2ДПР("1ДПР"); 
	СтрокаДанных.Строка_2_1_Столбец_2 = Данные1ДПР.Итоги.Итог("СуммаСНачалаГода");
	
	Данные1РПР = ПолучитьДанные1_2РПР("1РПР");
	СтрокаДанных.Строка_2_1_Столбец_3 = Данные1РПР.Итоги.Итог("СуммаСНачалаГода");
	
	Данные8ДПР = ПолучитьДанные8ДПР(ДополнительныеПараметры);
	Выборка = Данные8ДПР.Выборка;
	Если Выборка.Следующий() Тогда 
		СтрокаДанных.Строка_4_1_Столбец_2 = Выборка.НачисленоСНачалаНалоговогоПериода;
	КонецЕсли;	
	
	Данные9ДПР_2 = ПолучитьДанные9ДПР2(ДополнительныеПараметры);
