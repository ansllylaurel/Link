Функция ПолучитьДанные6ДПР(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	Данные.Вставить("ПериодМесяц", Формат(Период.ДатаОкончания, "ДФ='ММММ гггг ''г.'''"));
	
	Данные.Вставить("СуммаЗаПериод",	0);
	Данные.Вставить("СуммаСНачалаГода",	0);
	
	СтрокиОтчета = Новый ТаблицаЗначений;
	
	СтрокиОтчета.Колонки.Добавить("ВидДохода",			Новый ОписаниеТипов("Строка"));
	СтрокиОтчета.Колонки.Добавить("Операция",			Новый ОписаниеТипов("Строка"));
	СтрокиОтчета.Колонки.Добавить("ПервичныйДокумент",	Новый ОписаниеТипов("Строка"));
	СтрокиОтчета.Колонки.Добавить("СуммаЗаПериод",		Новый ОписаниеТипов("Число"));
	СтрокиОтчета.Колонки.Добавить("СуммаСНачалаГода",	Новый ОписаниеТипов("Число"));
	
	Если Период.ДатаОкончания > '20200101' Тогда
		Данные9ДПР	= ПолучитьДанные9ДПР2020(ДополнительныеПараметры);
	Иначе	
		Данные9ДПР	= ПолучитьДанные9ДПР(ДополнительныеПараметры);
	КонецЕсли;	
	
	Выборка9ДПР = Данные9ДПР.Выборка;
	
	Если Выборка9ДПР.Следующий() Тогда
		
		НоваяСтрока = СтрокиОтчета.Добавить();
		
		НоваяСтрока.ВидДохода			= "Процентный доход по облигациям";
		НоваяСтрока.Операция			= "Начислены проценты по КД по корпоративным облигациям";
		НоваяСтрока.ПервичныйДокумент	= "Форма 9 ДПР";
		
		Если ЗначениеЗаполнено(Выборка9ДПР.НачисленоЗаТекущийПериод) Тогда
			НоваяСтрока.СуммаЗаПериод = Выборка9ДПР.НачисленоЗаТекущийПериод;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка9ДПР.НачисленоСНачалаНалоговогоПериода) Тогда
			НоваяСтрока.СуммаСНачалаГода = Выборка9ДПР.НачисленоСНачалаНалоговогоПериода;
		КонецЕсли;
		
		Данные.СуммаЗаПериод	= Данные.СуммаЗаПериод + НоваяСтрока.СуммаЗаПериод;
		Данные.СуммаСНачалаГода	= Данные.СуммаСНачалаГода + НоваяСтрока.СуммаСНачалаГода;
		
	КонецЕсли;
	
	Данные10ДПР	= ПолучитьДанные10ДПР(ДополнительныеПараметры);
	
	Выборка10ДПР = Данные10ДПР.Выборка;
	
	Если Выборка10ДПР.Следующий() Тогда
		
		НоваяСтрока = СтрокиОтчета.Добавить();
		
		НоваяСтрока.ВидДохода			= "Процентный доход по договорам депозитных вкладов";
		НоваяСтрока.Операция			= "Начислены проценты";
		НоваяСтрока.ПервичныйДокумент	= "Форма 10 ДПР";
		
		Если ЗначениеЗаполнено(Выборка10ДПР.НачисленоЗаПериод) Тогда
			НоваяСтрока.СуммаЗаПериод = Выборка10ДПР.НачисленоЗаПериод;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка10ДПР.НачисленоСНачалаПериода) Тогда
			НоваяСтрока.СуммаСНачалаГода = Выборка10ДПР.НачисленоСНачалаПериода;
		КонецЕсли;
		
		Данные.СуммаЗаПериод	= Данные.СуммаЗаПериод + НоваяСтрока.СуммаЗаПериод;
		Данные.СуммаСНачалаГода	= Данные.СуммаСНачалаГода + НоваяСтрока.СуммаСНачалаГода;
		
	КонецЕсли;
	
	Данные11ДПР	= ПолучитьДанные11ДПР(ДополнительныеПараметры);
	
	Выборка11ДПРГод		= Данные11ДПР.ВыборкаЗаГод;
	Выборка11ДПРПериод	= Данные11ДПР.ВыборкаЗаПериод;
	
	Выборка11ДПРПериод.Следующий();
	
	Если Выборка11ДПРГод.Следующий() Тогда
		
		НоваяСтрока = СтрокиОтчета.Добавить();
		
		НоваяСтрока.ВидДохода			= "Процентный доход по сделкам РЕПО";
		НоваяСтрока.Операция			= "Начислены проценты по сделкам РЕПО";
		НоваяСтрока.ПервичныйДокумент	= "Форма 11 ДПР";
		
		Если ЗначениеЗаполнено(Выборка11ДПРГод.СуммаОтчетныйПериод) Тогда
			НоваяСтрока.СуммаЗаПериод = Выборка11ДПРГод.СуммаОтчетныйПериод;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка11ДПРГод.ВсегоНачислено) Тогда
			НоваяСтрока.СуммаСНачалаГода = Выборка11ДПРГод.ВсегоНачислено;
		КонецЕсли;
		
		Данные.СуммаЗаПериод	= Данные.СуммаЗаПериод + НоваяСтрока.СуммаЗаПериод;
		Данные.СуммаСНачалаГода	= Данные.СуммаСНачалаГода + НоваяСтрока.СуммаСНачалаГода;
		
	КонецЕсли;
	
	Данные.Вставить("СтрокиОтчета", СтрокиОтчета);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанные7ДПР(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",					Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("НачалоГодаГраница",				Новый Граница(Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода",					Период.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(Период.ДатаОкончания, ВидГраницы.Включая));
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК Аналитика
		|ПОМЕСТИТЬ _Аналитика
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов))
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОбороты.Период >= &НачалоПериода КАК ОтчетныйПериод,
		|	ВЫРАЗИТЬ(НалоговыйУчетОбороты.Регистратор КАК Документ.Оплата).Дата КАК Дата,
		|	НалоговыйУчетОбороты.Субконто2 КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(НалоговыйУчетОбороты.Регистратор КАК Документ.Оплата).Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка) КАК БрокерЗаполнен,
		|	ВЫРАЗИТЬ(НалоговыйУчетОбороты.Регистратор КАК Документ.Оплата).СтрокаБанковскойВыписки.ВидПлатежногоДокумента КАК ВидПлатежногоДокумента,
		|	ВЫРАЗИТЬ(НалоговыйУчетОбороты.Регистратор КАК Документ.Оплата).СтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|	ВЫРАЗИТЬ(НалоговыйУчетОбороты.Регистратор КАК Документ.Оплата).СтрокаБанковскойВыписки.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|	НалоговыйУчетОбороты.СуммаОборотКт КАК Сумма
		|ПОМЕСТИТЬ _Оплаты
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоГодаГраница,
		|			&КонецПериодаГраница,
		|			Регистратор,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						_Аналитика.Аналитика КАК Аналитика
		|					ИЗ
		|						_Аналитика КАК _Аналитика),
		|			КорСчет <> ЗНАЧЕНИЕ(ПланСчетов.Основной.СальдоПрочихДоходовИРасходов),
		|			) КАК НалоговыйУчетОбороты
		|ГДЕ
		|	НалоговыйУчетОбороты.Регистратор ССЫЛКА Документ.Оплата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОбороты.Период >= &НачалоПериода КАК ОтчетныйПериод,
		|	ВЫРАЗИТЬ(НалоговыйУчетОбороты.Регистратор КАК Документ.КорректировкаРегистров).Дата КАК Дата,
		|	НалоговыйУчетОбороты.Субконто2 КАК ЦеннаяБумага,
		|	НалоговыйУчетОбороты.СуммаОборотКт КАК Сумма
		|ПОМЕСТИТЬ _Корректировки
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоГодаГраница,
		|			&КонецПериодаГраница,
		|			Регистратор,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						_Аналитика.Аналитика КАК Аналитика
		|					ИЗ
		|						_Аналитика КАК _Аналитика),
		|			КорСчет <> ЗНАЧЕНИЕ(ПланСчетов.Основной.СальдоПрочихДоходовИРасходов),
		|			) КАК НалоговыйУчетОбороты
		|ГДЕ
		|	НалоговыйУчетОбороты.Регистратор ССЫЛКА Документ.КорректировкаРегистров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Оплаты.ОтчетныйПериод КАК ОтчетныйПериод,
		|	_Оплаты.Дата КАК Дата,
		|	_Оплаты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Оплаты.БрокерЗаполнен КАК БрокерЗаполнен,
		|	_Оплаты.ВидПлатежногоДокумента КАК ВидПлатежногоДокумента,
		|	_Оплаты.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|	_Оплаты.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|	_Оплаты.Сумма + ЕСТЬNULL(_Корректировки.Сумма, 0) КАК Сумма
		|ПОМЕСТИТЬ _Обороты
		|ИЗ
		|	_Оплаты КАК _Оплаты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Корректировки КАК _Корректировки
		|		ПО _Оплаты.ЦеннаяБумага = _Корректировки.ЦеннаяБумага
		|			И (НАЧАЛОПЕРИОДА(_Оплаты.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(_Корректировки.Дата, ДЕНЬ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК ОтчетныйПериод,
		|	_Обороты.Дата КАК Дата,
		|	_Обороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	""Получены дивиденды на акции"" КАК Операция,
		|	_Обороты.БрокерЗаполнен КАК БрокерЗаполнен,
		|	_Обороты.ВидПлатежногоДокумента КАК ВидПлатежногоДокумента,
		|	_Обороты.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|	_Обороты.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|	_Обороты.Сумма КАК Сумма,
		|	_Обороты.Сумма КАК СуммаСНачалаГода
		|ИЗ
		|	_Обороты КАК _Обороты
		|ГДЕ
		|	_Обороты.ОтчетныйПериод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	СУММА(0),
		|	СУММА(_Обороты.Сумма)
		|ИЗ
		|	_Обороты КАК _Обороты
		|ГДЕ
		|	НЕ _Обороты.ОтчетныйПериод
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОтчетныйПериод,
		|	Дата,
		|	ДатаПлатежногоДокумента,
		|	НомерПлатежногоДокумента,
		|	ЦеннаяБумага
		|ИТОГИ
		|	СУММА(Сумма),
		|	СУММА(СуммаСНачалаГода)
		|ПО
		|	ОБЩИЕ";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Вставить("Выборка", Выборка);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанные8ДПР(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	Данные.Вставить("ПредставлениеОтчета", "Накопительная ведомость по начислению процентного дохода по государственным и муниципальным ценным бумагам по пенсионным резервам за " + ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|             КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|             РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|             РеквизитыЮридическихЛицАнкетныеОрганизации.ПолноеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|             СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|             СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|             РеквизитыЮридическихЛицАнкетныеКлиента.ПолноеНаименованиеПоУставу КАК УчредительУправления
		|ИЗ
		|             РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|                                             &Период,
		|                                             ЮрФизЛицо = &ЮрФизЛицоОрганизации
		|                                                            И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеОрганизации,
		|             Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|             _КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|                             ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних КАК РеквизитыЮридическихЛицАнкетныеКлиента
		|                             ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицАнкетныеКлиента.ЮрФизЛицо
		|                                             И (РеквизитыЮридическихЛицАнкетныеКлиента.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|             СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период",							Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации",			Организация.ЮрФизЛицо);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Данные.Вставить("ИмяФонда",				ВыборкаДетальныеЗаписи.УчредительУправления);
		Данные.Вставить("ИмяФондаСДоговором",	ВыборкаДетальныеЗаписи.ДоверительныйУправляющий + " ДУ " + ВыборкаДетальныеЗаписи.УчредительУправления + " по договору № " + ВыборкаДетальныеЗаписи.НомерДоговора + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	КонецЕсли;   
	
	// в первую секунду 2025 года в ЕПС была реклассификация бумаг
	// так как отчет использует движения по пратиям ЕПС, то первую секунду 2025 года надо выколоть. 
	Если Год(Период.ДатаНачала) = 2025 Тогда
		НачалоГодаОтчета = НачалоГода(Период.ДатаНачала) + 1;
		Если НачалоДня(Период.ДатаНачала) = НачалоГода(Период.ДатаНачала) Тогда
			НачалоПериодаОтчета = НачалоДня(Период.ДатаНачала) + 1;
		Иначе
			НачалоПериодаОтчета = НачалоДня(Период.ДатаНачала);
		КонецЕсли;
	Иначе
		НачалоГодаОтчета = НачалоГода(Период.ДатаНачала);
		НачалоПериодаОтчета = НачалоДня(Период.ДатаНачала);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",					Макс(НачалоПериодаОтчета, ДатаРеформации));
	Запрос.УстановитьПараметр("НачалоГода",						Макс(НачалоГодаОтчета, ДатаРеформации));
//	Запрос.УстановитьПараметр("КонецПериода",					НачалоДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая));
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Ссылка КАК Ссылка,
		|	ОплатаОснования.Основание КАК Основание,
		|	ПогашениеЦеннойБумаги.СуммаКупона КАК СуммаКупона,
		|	ПогашениеЦеннойБумаги.Количество КАК Количество,
		|	КупонныйДоходПоОблигациям.Период КАК ДатаНачалаКупонногоПериода,
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупонногоПериода,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК СтавкаКупона,
		|	КупонныйДоходПоОблигациям.СуммаКупона КАК КупонНаОднуОблигацию,
		|	КупонныйДоходПоОблигациям.Облигация.Номинал КАК Номинал
		|ПОМЕСТИТЬ _ПогашенияОснования
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|			ПО ПогашениеЦеннойБумаги.ЦеннаяБумага = КупонныйДоходПоОблигациям.Облигация
		|				И (НАЧАЛОПЕРИОДА(ПогашениеЦеннойБумаги.Дата, ДЕНЬ) = КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|					ИЛИ НАЧАЛОПЕРИОДА(ПогашениеЦеннойБумаги.Дата, ДЕНЬ) < КупонныйДоходПоОблигациям.ДатаОкончанияКупона
