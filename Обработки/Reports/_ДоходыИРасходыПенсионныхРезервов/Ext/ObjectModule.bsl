Функция Сформировать2ДПР(Данные, ОтчетнаяФорма)
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	РезультатОтчета.ОриентацияСтраницы		= ОриентацияСтраницы.Ландшафт;
	РезультатОтчета.АвтоМасштаб				= Истина;
	РезультатОтчета.ФиксацияСверху			= 8;
	
	Макет = ПолучитьМакет("_" + ОтчетнаяФорма);
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьРаздел		= Макет.ПолучитьОбласть("Раздел");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	Для Каждого СтрокаДанных Из Данные.РеквизитыШапки Цикл
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, СтрокаДанных);
		ОбластьШапка.Параметры.ПредставлениеПериода = ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
		ОбластьШапка.Параметры.ДатаДоговора			= Формат(СтрокаДанных.ДатаДоговора, "ДФ='dd.MM.yyyy ''г.'''");
		
		ОбластьПодвал.Параметры.Ответственный = СтрокаДанных.Ответственный;
	КонецЦикла;

	Если Данные.Свойство("Должность") Тогда 
		ОбластьПодвал.Параметры.Должность = Данные.Должность;
	КонецЕсли;
	
	РезультатОтчета.Вывести(ОбластьШапка);

	ВывестиРаздел_1_2_РПР_ДПР(РезультатОтчета, Макет, Данные, "Акции", "Акции");

	
	ВывестиРаздел_1_2_РПР_ДПР(РезультатОтчета, Макет, Данные, "Облигации государственные и муниципальные", "Государственные");
	
	Раздел = "Облигации корпоративные";
	ОбластьРаздел.Параметры.Раздел = Раздел;
	РезультатОтчета.Вывести(ОбластьРаздел);
	
	ВывестиРаздел_1_2_РПР_ДПР(РезультатОтчета, Макет, Данные, "Облигации корпоративные (без реализации НКД ипотечных)"	, "Корпоративные");
	ВывестиРаздел_1_2_РПР_ДПР(РезультатОтчета, Макет, Данные, "Облигации корпоративные (реализация НКД ипотечных)"		, "Ипотечные");
		
	ВывестиИтог_1_2_РПР_ДПР(РезультатОтчета, Макет.ПолучитьОбласть("ИтогРаздела"), Данные, Раздел, "Корпоративные,Ипотечные");
	
	ВывестиИтог_1_2_РПР_ДПР(РезультатОтчета, Макет.ПолучитьОбласть("ОбщийИтог"), Данные, Раздел, "Акции,Государственные,Корпоративные,Ипотечные");
	
	РезультатОтчета.Вывести(ОбластьПодвал);
	
	Возврат РезультатОтчета;
	
КонецФункции


