		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ
		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПереданоНКД КАК _ПереданоНКД
		|		ПО ОстаткиКонецПериода.Партия = _ПереданоНКД.Партия
		|			И ОстаткиКонецПериода.ЦеннаяБумага = _ПереданоНКД.ЦеннаяБумага
		|			И ОстаткиКонецПериода.СтрокаПартии = _ПереданоНКД.СтрокаПартии
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии,
		|	ДатаНачалаКупонногоПериода
		|ИТОГИ
		|	СУММА(НКДУплаченныйПродавцу),
		|	СУММА(ВсегоКупонногоДохода),
		|	СУММА(НачисленоНаНачалоНалоговогоПериода),
		|	СУММА(КупонВыплаченный),
		|	СУММА(НачисленоСНачалаНалоговогоПериода),
		|	СУММА(НачисленоПоПредыдущийПериод),
		|	СУММА(НачисленоЗаТекущийПериод)
		|ПО
		|	ОБЩИЕ,
		|	СтавкаНалогообложения";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Вставить("Выборка", Выборка);
	
	Возврат Данные;	
		
КонецФункции

Функция ПолучитьДанные8ДПРИН(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	Данные.Вставить("ПредставлениеОтчета", "Накопительная ведомость по начислению процентного дохода по облигациям федерального займа с индексируемым номиналом за " + ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|             КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|             РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|             РеквизитыЮридическихЛицАнкетныеОрганизации.ПолноеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|             СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|             СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|             РеквизитыЮридическихЛицАнкетныеКлиента.ПолноеНаименованиеПоУставу КАК УчредительУправления
		|ИЗ
		|             РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|                                             &Период,
		|                                             ЮрФизЛицо = &ЮрФизЛицоОрганизации
		|                                                            И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеОрганизации,
		|             Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|             _КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|                             ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних КАК РеквизитыЮридическихЛицАнкетныеКлиента
		|                             ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицАнкетныеКлиента.ЮрФизЛицо
		|                                             И (РеквизитыЮридическихЛицАнкетныеКлиента.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|             СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период",							Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации",			Организация.ЮрФизЛицо);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Данные.Вставить("ИмяФонда",				ВыборкаДетальныеЗаписи.УчредительУправления);
		Данные.Вставить("ИмяФондаСДоговором",	ВыборкаДетальныеЗаписи.ДоверительныйУправляющий + " ДУ " + ВыборкаДетальныеЗаписи.УчредительУправления + " по договору № " + ВыборкаДетальныеЗаписи.НомерДоговора + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	//запрос для определения отрицательного номинала и финреза

	Запрос = Новый Запрос;   
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц; 
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовИндексацииНоминала КАК АналитикаДоходов
		|ПОМЕСТИТЬ _АналитикаНоминал
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&КонецПериодаГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные)) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПартииБух.Период КАК Период,
		|	ПартииБух.Регистратор КАК Регистратор,
		|	ПартииБух.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ПартииБух.Партия.Дата, ДЕНЬ)) КАК ДатаПокупки,
		|	ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход КАК ИндексацияНоминала,
		|	ПартииБух.КоличествоКонечныйОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ _Партии
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&КонецПериодаГраница,
		|			Регистратор,
		|			Движения,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ЦеннаяБумага.ИндексируемыйНоминал) КАК ПартииБух
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ПартииБух.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И ПартииБух.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПартииБух.Период КАК Период,
		|	ПартииБух.Регистратор КАК Регистратор,
		|	ПартииБух.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПартииБух.КоличествоКонечныйОстаток КАК КоличествоОстаток,
		|	ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход КАК ОтрицательнаяИндексация,
		|	ВЫБОР
		|		КОГДА НЕ ПартииЕПС.ПереоценкаКупонаВВалютеУчетаРасход ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход + (ПартииЕПС.ПереоценкаКупонаВВалютеУчетаРасход - ПартииБух.ПереоценкаКупонаВВалютеУчетаНачальныйОстаток / ПартииБух.КоличествоНачальныйОстаток * ПартииБух.КоличествоРасход) < 0
		|						ТОГДА -(ПартииЕПС.ПереоценкаКупонаВВалютеУчетаРасход - ПартииБух.ПереоценкаКупонаВВалютеУчетаНачальныйОстаток / ПартииБух.КоличествоНачальныйОстаток * ПартииБух.КоличествоРасход)
		|					КОГДА ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход + (ПартииЕПС.ПереоценкаКупонаВВалютеУчетаРасход - ПартииБух.ПереоценкаКупонаВВалютеУчетаНачальныйОстаток / ПартииБух.КоличествоНачальныйОстаток * ПартииБух.КоличествоРасход) > 0
		|							И ЕСТЬNULL(НалоговыйУчетОстаткиИОбороты.СуммаОборот, 0) < 0
		|						ТОГДА -(ПартииЕПС.ПереоценкаКупонаВВалютеУчетаРасход - ПартииБух.ПереоценкаКупонаВВалютеУчетаНачальныйОстаток / ПартииБух.КоличествоНачальныйОстаток * ПартииБух.КоличествоРасход)
		|					ИНАЧЕ ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход < 0
		|						И ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход + ПартииБух.ПереоценкаКупонаВВалютеУчетаОборот < 0
		|					ТОГДА -ПартииБух.ПереоценкаКупонаВВалютеУчетаОборот
		|				КОГДА ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход > 0
		|						И ЕСТЬNULL(НалоговыйУчетОстаткиИОбороты.СуммаОборот, 0) < 0
		|					ТОГДА -ПартииБух.ПереоценкаКупонаВВалютеУчетаОборот
		|				ИНАЧЕ ПартииБух.ИндексацияНоминалаЗаВремяВладенияПриход
		|			КОНЕЦ
		|	КОНЕЦ КАК ПринятоФинрез,
		|	ЕСТЬNULL(НалоговыйУчетОстаткиИОбороты.СуммаОборот, 0) КАК ЗатратыБудущихПериодов,
		|	НалоговыйУчетОстаткиИОбороты.СуммаНачальныйОстаток КАК ЗБП_НачальныйОстаток,
		|	НалоговыйУчетОстаткиИОбороты.СуммаКонечныйОстаток КАК ЗБП_КонечныйОстаток
		|ПОМЕСТИТЬ _ПереоценкаНоминалПредварительно
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&КонецПериодаГраница,
		|			Регистратор,
		|			Движения,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ЦеннаяБумага.ИндексируемыйНоминал) КАК ПартииБух
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.ОстаткиИОбороты(
		|				&НачалоГода,
		|				&КонецПериодаГраница,
		|				Регистратор,
		|				Движения,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.ИндексируемыйНоминал) КАК ПартииЕПС
		|		ПО ПартииБух.ЦеннаяБумага = ПартииЕПС.ЦеннаяБумага
		|			И ПартииБух.Партия = ПартииЕПС.Партия
		|			И ПартииБух.СтрокаПартии = ПартииЕПС.СтрокаПартии
		|			И ПартииБух.Регистратор = ПартииЕПС.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.НалоговыйУчет.ОстаткиИОбороты(
		|				&НачалоГода,
		|				&КонецПериодаГраница,
		|				Регистратор,
		|				,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.РасходыБудущихПериодов),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И Субконто1 В
		|						(ВЫБРАТЬ
		|							_АналитикаНоминал.АналитикаДоходов КАК АналитикаДоходов
		|						ИЗ
		|							_АналитикаНоминал КАК _АналитикаНоминал)) КАК НалоговыйУчетОстаткиИОбороты
		|		ПО ПартииБух.Регистратор = НалоговыйУчетОстаткиИОбороты.Регистратор
		|			И ПартииБух.ЦеннаяБумага = НалоговыйУчетОстаткиИОбороты.Субконто2
		|ГДЕ
		|	ЕСТЬNULL(НалоговыйУчетОстаткиИОбороты.СуммаОборот, 0) <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПереоценкаНоминал.Период КАК Период,
		|	_ПереоценкаНоминал.Регистратор КАК Регистратор,
		|	_ПереоценкаНоминал.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПереоценкаНоминал.КоличествоОстаток КАК КоличествоОстаток,
		|	_ПереоценкаНоминал.ПринятоФинрез КАК ПринятоФинрез,
		|	ВЫБОР
		|		КОГДА _ПереоценкаНоминал.ОтрицательнаяИндексация < 0
		|				И _ПереоценкаНоминал.ОтрицательнаяИндексация <= _ПереоценкаНоминал.ПринятоФинрез
		|			ТОГДА _ПереоценкаНоминал.ПринятоФинрез
		|		КОГДА _ПереоценкаНоминал.ОтрицательнаяИндексация > 0
		|				И _ПереоценкаНоминал.ЗБП_НачальныйОстаток > 0
		|			ТОГДА _ПереоценкаНоминал.ЗатратыБудущихПериодов
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПринятоОтрицательнаяИндексация,
		|	_ПереоценкаНоминал.ЗатратыБудущихПериодов КАК ЗатратыБудущихПериодов
		|ПОМЕСТИТЬ _ПереоценкаНоминал
		|ИЗ
		|	_ПереоценкаНоминалПредварительно КАК _ПереоценкаНоминал";
	#КонецОбласти
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГода",						Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации));   //? брать историю надо с начала партии (?) 
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая));
	
	Результат = Запрос.Выполнить();
	ТаблицаПартии = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Партии").ПолучитьДанные().Выгрузить();
	ТаблицаНоминалы = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПереоценкаНоминал").ПолучитьДанные().Выгрузить();
	
	ПартииНоминалы = Новый ТаблицаЗначений;
	ПартииНоминалы.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ПартииНоминалы.Колонки.Добавить("ДатаПокупки", Новый ОписаниеТипов("Дата"));
	ПартииНоминалы.Колонки.Добавить("РБП_Год", Новый ОписаниеТипов("Число"));
	ПартииНоминалы.Колонки.Добавить("РБП_Период", Новый ОписаниеТипов("Число"));
	ПартииНоминалы.Колонки.Добавить("ПринятоФинрезГод", Новый ОписаниеТипов("Число"));
	ПартииНоминалы.Колонки.Добавить("ОтрицательнаяИндексацияПериод", Новый ОписаниеТипов("Число"));
	ПартииНоминалы.Колонки.Добавить("ПринятоФинрезПериод", Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаТаблицы из ТаблицаНоминалы Цикл 
		
		СтруктураПоиска = Новый Структура("Регистратор, ЦеннаяБумага", СтрокаТаблицы.Регистратор, СтрокаТаблицы.ЦеннаяБумага);
		СтрокиПартии = ТаблицаПартии.НайтиСтроки(СтруктураПоиска);
		Если СтрокиПартии.Количество() > 0 Тогда 
			Для Каждого СтрокаПартия из СтрокиПартии Цикл 
				НоваяСтрока = ПартииНоминалы.Добавить();
				НоваяСтрока.ЦеннаяБумага = СтрокаПартия.ЦеннаяБумага;
				НоваяСтрока.ДатаПокупки = СтрокаПартия.ДатаПокупки;
				
				Если СтрокаТаблицы.Период < Период.ДатаНачала  Тогда
					НоваяСтрока.РБП_Год = СтрокаТаблицы.ЗатратыБудущихПериодов / СтрокаТаблицы.КоличествоОстаток * СтрокаПартия.КоличествоОстаток;
					НоваяСтрока.РБП_Период = СтрокаТаблицы.ЗатратыБудущихПериодов / СтрокаТаблицы.КоличествоОстаток * СтрокаПартия.КоличествоОстаток;
				Иначе
					НоваяСтрока.РБП_Год = 0;
					НоваяСтрока.РБП_Период = СтрокаТаблицы.ЗатратыБудущихПериодов / СтрокаТаблицы.КоличествоОстаток * СтрокаПартия.КоличествоОстаток;
					НоваяСтрока.ОтрицательнаяИндексацияПериод =  СтрокаТаблицы.ПринятоОтрицательнаяИндексация / СтрокаТаблицы.КоличествоОстаток * СтрокаПартия.КоличествоОстаток;
					НоваяСтрока.ПринятоФинрезПериод =  СтрокаТаблицы.ПринятоФинрез / СтрокаТаблицы.КоличествоОстаток * СтрокаПартия.КоличествоОстаток;											
				КонецЕсли;	
			КонецЦикла;				
		КонецЕсли;			
	КонецЦикла;	
	
	ПартииНоминалы.Свернуть("ЦеннаяБумага, ДатаПокупки", "РБП_Год, РБП_Период, ОтрицательнаяИндексацияПериод, ПринятоФинрезПериод");
		
	// отчет
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",					Макс(НачалоДня(Период.ДатаНачала), ДатаРеформации));
	Запрос.УстановитьПараметр("НачалоГода",						Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации));
	Запрос.УстановитьПараметр("ПредыдущаяДата",					Макс(НачалоДня(Период.ДатаНачала), ДатаРеформации) - 24*60*60);
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВнешняяТаблица",					ПартииНоминалы);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеИндексируемыйНоминал.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ДанныеИндексируемыйНоминал.ДатаПокупки КАК ДатаПокупки,
		|	_ДанныеИндексируемыйНоминал.РБП_Год КАК РБП_Год,
		|	_ДанныеИндексируемыйНоминал.РБП_Период КАК РБП_Период,
		|	_ДанныеИндексируемыйНоминал.ОтрицательнаяИндексацияПериод КАК ОтрицательнаяИндексацияПериод,
		|	_ДанныеИндексируемыйНоминал.ПринятоФинрезПериод КАК ПринятоФинрезПериод
		|ПОМЕСТИТЬ _ОтрицательныйНоминалПредварительно
		|ИЗ
		|	&ВнешняяТаблица КАК _ДанныеИндексируемыйНоминал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПогашенияИПродажи.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Партия.Дата, ДЕНЬ)) КАК ДатаПокупки,
		|	НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Период, ДЕНЬ) КАК ДатаПродажи,
		|	НоминалыПокупок.Номинал КАК НоминалПокупки,
		|	НоминалыПродаж.Номинал КАК НоминалРасчета,
		|	НоминалыПредыдущаяДата.Номинал КАК НоминалПредыдущаяДата,
		|	СУММА(ПогашенияИПродажи.Количество) КАК Количество,
		|	НоминалыПродаж.Номинал - НоминалыПредыдущаяДата.Номинал КАК ДоходНаОднуОблигацию,
		|	СУММА(ПогашенияИПродажи.ИндексацияНоминалаЗаВремяВладения) КАК ВсегоДохода,
		|	СУММА(ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ПогашенияИПродажи.Количество) КАК НачисленоНа,
		|	СУММА(ПогашенияИПродажи.ИндексацияНоминалаЗаВремяВладения) КАК Выплачено,
		|	СУММА(ПогашенияИПродажи.ИндексацияНоминалаЗаВремяВладения - ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ПогашенияИПродажи.Количество) КАК НачисленоС,
		|	СУММА(ВЫБОР
		|			КОГДА ПогашенияИПродажи.Период < &НачалоПериода
		|				ТОГДА ПогашенияИПродажи.ИндексацияНоминалаЗаВремяВладения - ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ПогашенияИПродажи.Количество
		|			ИНАЧЕ ЕСТЬNULL(ОстаткиНаНачалоПериода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоПериода.КоличествоОстаток, 1) * ПогашенияИПродажи.Количество - ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ПогашенияИПродажи.Количество
		|		КОНЕЦ) КАК НачисленоПо,
		|	СУММА(ВЫБОР
		|			КОГДА ПогашенияИПродажи.Период < &НачалоПериода
		|				ТОГДА 0
		|			ИНАЧЕ ПогашенияИПродажи.ИндексацияНоминалаЗаВремяВладения - ЕСТЬNULL(ОстаткиНаНачалоПериода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоПериода.КоличествоОстаток, 1) * ПогашенияИПродажи.Количество
		|		КОНЕЦ) КАК НачисленоЗа
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК ПогашенияИПродажи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ПогашенияИПродажи.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И ПогашенияИПродажи.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыПродаж
		|		ПО ПогашенияИПродажи.ЦеннаяБумага = НоминалыПродаж.ЦеннаяБумага
		|			И (НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Период, ДЕНЬ) = НоминалыПродаж.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыПокупок
		|		ПО ПогашенияИПродажи.ЦеннаяБумага = НоминалыПокупок.ЦеннаяБумага
		|			И (ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Партия.Дата, ДЕНЬ)) = НоминалыПокупок.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыПредыдущаяДата
		|		ПО ПогашенияИПродажи.ЦеннаяБумага = НоминалыПредыдущаяДата.ЦеннаяБумага
		|			И (ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Период, МЕСЯЦ), ДЕНЬ, -1) = НоминалыПредыдущаяДата.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&НачалоГода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.ИндексируемыйНоминал) КАК ОстаткиНаНачалоГода
		|		ПО ПогашенияИПродажи.ЦеннаяБумага = ОстаткиНаНачалоГода.ЦеннаяБумага
		|			И ПогашенияИПродажи.Партия = ОстаткиНаНачалоГода.Партия
		|			И ПогашенияИПродажи.СтрокаПартии = ОстаткиНаНачалоГода.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&НачалоПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.ИндексируемыйНоминал) КАК ОстаткиНаНачалоПериода
		|		ПО ПогашенияИПродажи.ЦеннаяБумага = ОстаткиНаНачалоПериода.ЦеннаяБумага
		|			И ПогашенияИПродажи.Партия = ОстаткиНаНачалоПериода.Партия
		|			И ПогашенияИПродажи.СтрокаПартии = ОстаткиНаНачалоПериода.СтрокаПартии
		|ГДЕ
		|	ПогашенияИПродажи.Период МЕЖДУ &НачалоГода И &КонецПериода
		|	И ПогашенияИПродажи.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ПогашенияИПродажи.Организация = &Организация
		|	И ПогашенияИПродажи.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ПогашенияИПродажи.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|	И ПогашенияИПродажи.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|	И ПогашенияИПродажи.ЦеннаяБумага.ИндексируемыйНоминал
		|	И ПогашенияИПродажи.Количество <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ПогашенияИПродажи.ЦеннаяБумага,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Партия.Дата, ДЕНЬ)),
		|	НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Период, ДЕНЬ),
		|	НоминалыПокупок.Номинал,
		|	НоминалыПродаж.Номинал,
		|	НоминалыПредыдущаяДата.Номинал,
		|	НоминалыПродаж.Номинал - НоминалыПредыдущаяДата.Номинал
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиНаКонецПериода.ЦеннаяБумага,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ОстаткиНаКонецПериода.Партия.Дата, ДЕНЬ)),
		|	"""",
		|	НоминалыПокупок.Номинал,
		|	НоминалыОстатков.Номинал,
		|	НоминалыПредыдущаяДата.Номинал,
		|	СУММА(ОстаткиНаКонецПериода.КоличествоОстаток),
		|	НоминалыОстатков.Номинал - НоминалыПредыдущаяДата.Номинал,
		|	СУММА(ОстаткиНаКонецПериода.ИндексацияНоминалаЗаВремяВладенияОстаток),
		|	СУММА(ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ОстаткиНаКонецПериода.КоличествоОстаток),
		|	СУММА(0),
		|	СУММА(ОстаткиНаКонецПериода.ИндексацияНоминалаЗаВремяВладенияОстаток - ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ОстаткиНаКонецПериода.КоличествоОстаток),
		|	СУММА(ЕСТЬNULL(ОстаткиНаНачалоПериода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоПериода.КоличествоОстаток, 1) * ОстаткиНаКонецПериода.КоличествоОстаток - ЕСТЬNULL(ОстаткиНаНачалоГода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоГода.КоличествоОстаток, 1) * ОстаткиНаКонецПериода.КоличествоОстаток),
		|	СУММА(ОстаткиНаКонецПериода.ИндексацияНоминалаЗаВремяВладенияОстаток - ЕСТЬNULL(ОстаткиНаНачалоПериода.ИндексацияНоминалаЗаВремяВладенияОстаток, 0) / ЕСТЬNULL(ОстаткиНаНачалоПериода.КоличествоОстаток, 1) * ОстаткиНаКонецПериода.КоличествоОстаток)
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&КонецПериодаГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ЦеннаяБумага.ИндексируемыйНоминал) КАК ОстаткиНаКонецПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО ОстаткиНаКонецПериода.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И ОстаткиНаКонецПериода.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыПокупок
		|		ПО ОстаткиНаКонецПериода.ЦеннаяБумага = НоминалыПокупок.ЦеннаяБумага
		|			И (ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ОстаткиНаКонецПериода.Партия.Дата, ДЕНЬ)) = НоминалыПокупок.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыОстатков
		|		ПО ОстаткиНаКонецПериода.ЦеннаяБумага = НоминалыОстатков.ЦеннаяБумага
		|			И (НоминалыОстатков.Период = НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыПредыдущаяДата
		|		ПО ОстаткиНаКонецПериода.ЦеннаяБумага = НоминалыПредыдущаяДата.ЦеннаяБумага
		|			И (НоминалыПредыдущаяДата.Период = &ПредыдущаяДата)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&НачалоГода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.ИндексируемыйНоминал) КАК ОстаткиНаНачалоГода
		|		ПО ОстаткиНаКонецПериода.ЦеннаяБумага = ОстаткиНаНачалоГода.ЦеннаяБумага
		|			И ОстаткиНаКонецПериода.Партия = ОстаткиНаНачалоГода.Партия
		|			И ОстаткиНаКонецПериода.СтрокаПартии = ОстаткиНаНачалоГода.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&НачалоПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.ИндексируемыйНоминал) КАК ОстаткиНаНачалоПериода
		|		ПО ОстаткиНаКонецПериода.ЦеннаяБумага = ОстаткиНаНачалоПериода.ЦеннаяБумага
		|			И ОстаткиНаКонецПериода.Партия = ОстаткиНаНачалоПериода.Партия
		|			И ОстаткиНаКонецПериода.СтрокаПартии = ОстаткиНаНачалоПериода.СтрокаПартии
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиНаКонецПериода.ЦеннаяБумага,
		|	НоминалыПокупок.Номинал,
		|	НоминалыОстатков.Номинал,
		|	НоминалыПредыдущаяДата.Номинал,
		|	НоминалыОстатков.Номинал - НоминалыПредыдущаяДата.Номинал,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, НАЧАЛОПЕРИОДА(ОстаткиНаКонецПериода.Партия.Дата, ДЕНЬ))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Данные.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА """" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_Данные.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование) + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(_Данные.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(_Данные.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихISIN.Код, КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Код)
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(_Данные.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала.Наименование
		|		ИНАЧЕ _Данные.ЦеннаяБумага.Наименование
		|	КОНЕЦ КАК ЦеннаяБумага,
		|	_Данные.ДатаПокупки КАК ДатаПокупки,
		|	_Данные.ДатаПродажи КАК ДатаПродажи,
		|	_Данные.НоминалПокупки КАК НоминалПокупки,
		|	_Данные.НоминалРасчета КАК НоминалРасчета,
		|	_Данные.НоминалПредыдущаяДата КАК НоминалПредыдущаяДата,
		|	_Данные.Количество КАК Количество,
		|	_Данные.ДоходНаОднуОблигацию КАК ДоходНаОднуОблигацию,
		|	_Данные.ВсегоДохода КАК ВсегоДохода,
		|	_Данные.НачисленоНа КАК НачисленоНа,
		|	_Данные.Выплачено КАК Выплачено,
		|	_Данные.НачисленоС КАК НачисленоС,
		|	_Данные.НачисленоПо КАК НачисленоПо,
		|	_Данные.НачисленоПо + ЕСТЬNULL(_ОтрицательныйНоминал.РБП_Год, 0) + ЕСТЬNULL(_ОтрицательныйНоминал.ОтрицательнаяИндексацияПериод, 0) + ВЫБОР
		|		КОГДА _Данные.НачисленоЗа > 0
		|			ТОГДА _Данные.НачисленоЗа
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НачисленоСОтр,
		|	_Данные.НачисленоПо + ЕСТЬNULL(_ОтрицательныйНоминал.РБП_Год, 0) КАК НачисленоПоОтр,
		|	_Данные.НачисленоЗа КАК НачисленоЗа,
		|	ЕСТЬNULL(_ОтрицательныйНоминал.ОтрицательнаяИндексацияПериод, 0) КАК ОтрицательнаяИндексация,
		|	ЕСТЬNULL(-_ОтрицательныйНоминал.ПринятоФинрезПериод, 0) КАК КупонныйДоходЗапериод,
		|	ЕСТЬNULL(_ОтрицательныйНоминал.РБП_Период, 0) КАК РасходыБудущихПериодов
		|ИЗ
		|	_Данные КАК _Данные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОтрицательныйНоминалПредварительно КАК _ОтрицательныйНоминал
		|		ПО _Данные.ЦеннаяБумага = _ОтрицательныйНоминал.ЦеннаяБумага
		|			И _Данные.ДатаПокупки = _ОтрицательныйНоминал.ДатаПокупки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_Данные.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(_Данные.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО _Данные.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ
		|		ПО _Данные.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Объект
		|ИТОГИ
		|	СУММА(ВсегоДохода),
		|	СУММА(НачисленоНа),
		|	СУММА(Выплачено),
		|	СУММА(НачисленоС),
		|	СУММА(НачисленоПо),
		|	СУММА(НачисленоСОтр),
		|	СУММА(НачисленоПоОтр),
		|	СУММА(НачисленоЗа),
		|	СУММА(ОтрицательнаяИндексация),
		|	СУММА(КупонныйДоходЗапериод),
		|	СУММА(РасходыБудущихПериодов)
		|ПО
		|	ОБЩИЕ";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Вставить("Выборка", Выборка);
	
	Возврат Данные;	
	
КонецФункции

Функция ПолучитьДанные9ДПР(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	Данные.Вставить("ПредставлениеОтчета", "Накопительная ведомость по начислению процентного дохода по корпоративным облигациям по пенсионным резервам за " + ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|             КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|             РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|             РеквизитыЮридическихЛицАнкетныеОрганизации.ПолноеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|             СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|             СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|             РеквизитыЮридическихЛицАнкетныеКлиента.ПолноеНаименованиеПоУставу КАК УчредительУправления
		|ИЗ
		|             РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|                                             &Период,
		|                                             ЮрФизЛицо = &ЮрФизЛицоОрганизации
		|                                                            И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеОрганизации,
		|             Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|             _КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|                             ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних КАК РеквизитыЮридическихЛицАнкетныеКлиента
		|                             ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицАнкетныеКлиента.ЮрФизЛицо
		|                                             И (РеквизитыЮридическихЛицАнкетныеКлиента.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|             СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период",							Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации",			Организация.ЮрФизЛицо);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Данные.Вставить("ИмяФонда",				ВыборкаДетальныеЗаписи.УчредительУправления);
		Данные.Вставить("ИмяФондаСДоговором",	ВыборкаДетальныеЗаписи.ДоверительныйУправляющий + " ДУ " + ВыборкаДетальныеЗаписи.УчредительУправления + " по договору № " + ВыборкаДетальныеЗаписи.НомерДоговора + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",					Макс(НачалоДня(Период.ДатаНачала), ДатаРеформации));
	Запрос.УстановитьПараметр("НачалоГода",						Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации));
	Запрос.УстановитьПараметр("КонецПериода",					НачалоДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая));
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, ДЕНЬ) КАК Период,
		|	ПогашенияИПродажиЕПС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПогашенияИПродажиЕПС.Партия КАК Партия,
		|	ПогашенияИПродажиЕПС.СтрокаПартии КАК СтрокаПартии,
		|	КупонныйДоходПоОблигациям.Период КАК ДатаНачалаКупонногоПериода,
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупонногоПериода,
		|	РАЗНОСТЬДАТ(КупонныйДоходПоОблигациям.Период, ВЫБОР
		|			КОГДА НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, ДЕНЬ) > КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|				ТОГДА КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|			КОГДА ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) <> ТИП(Документ.ПогашениеКупона)
		|					И ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) <> ТИП(Документ.ПогашениеЦеннойБумаги)
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, МЕСЯЦ), ДЕНЬ, -1)
		|			ИНАЧЕ НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, ДЕНЬ)
		|		КОНЕЦ, ДЕНЬ) КАК КоличествоДнейКупонногоПериода,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК ПроцентнаяСтавка,
		|	КупонныйДоходПоОблигациям.СуммаКупона КАК КупонНаОднуОблигацию,
		|	СУММА(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) = ТИП(Документ.ПогашениеКупона)
		|				ТОГДА ПогашенияИПродажиЕПС.СтоимостьКупонаВВалютеУчета
		|			КОГДА ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|				ТОГДА ПогашенияИПродажи.СтоимостьКупонаВВалютеУчета
		|			ИНАЧЕ ПогашенияИПродажи.СтоимостьКупонаВВалютеУчета
		|		КОНЕЦ) КАК СтоимостьКупонаВВалютеУчета,
		|	СУММА(ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) = ТИП(Документ.ПогашениеКупона)
		|				ТОГДА ПогашенияИПродажиЕПС.ПереоценкаКупонаВВалютеУчета
		|			КОГДА ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|				ТОГДА ПогашенияИПродажи.ПереоценкаКупонаВВалютеУчета
		|			ИНАЧЕ ПогашенияИПродажи.ПереоценкаКупонаВВалютеУчета
		|		КОНЕЦ) КАК ПереоценкаКупонаВВалютеУчета,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашенияИПродажиЕПС.Регистратор) = ТИП(Документ.ПогашениеКупона)
		|			ТОГДА ПогашениеКупона.СуммаНаОднуОблигацию
