		Пока ВыборкаГруппы.Следующий() Цикл
			
			ОбластьЗаголовок.Параметры.Заполнить(ВыборкаГруппы);
			
			РезультатОтчета.Вывести(ОбластьЗаголовок);
			
			Выборка = ВыборкаГруппы.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выборка.Документ) Тогда
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					
					РезультатОтчета.Вывести(ОбластьСтрока);
