	Запрос.УстановитьПараметр("НачалоГодаГраница",				Новый Граница(Макс(ДатаРеформации,НачалоГода(Период.ДатаНачала)), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода",					Период.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(Период.ДатаОкончания, ВидГраницы.Включая));
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчета КАК КоррСчет,
