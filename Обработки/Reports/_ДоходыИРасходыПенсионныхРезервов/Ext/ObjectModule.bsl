#КонецОбласти

Процедура ЗаполнитьОбщиеПараметры(Данные)
	
	Данные.Вставить("ДатаНачала",				Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	Данные.Вставить("ДатаОкончания",			Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	Данные.Вставить("ПредставлениеПериода", ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания));
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",							Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации",			Организация.ЮрФизЛицо);
	
	Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица 
		ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет Тогда 
		
		Запрос.Текст = 
		#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _КлиентДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентДУ.НомерДоговора КАК НомерДоговора,
		|	_КлиентДУ.ДатаЗаключения КАК ДатаДоговора,
		|	РеквизитыКлиентаАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыКлиентаАнкетныеСрезПоследних.Имя + "" "" + РеквизитыКлиентаАнкетныеСрезПоследних.Отчество КАК НаименованиеСчетаДУ,
		|	РеквизитыОрганизацийАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ИЗ
		|	_КлиентДУ КАК _КлиентДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|					Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиентаАнкетныеСрезПоследних
		|		ПО _КлиентДУ.Клиент = РеквизитыКлиентаАнкетныеСрезПоследних.ЮрФизЛицо,
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицоОрганизации) КАК РеквизитыОрганизацийАнкетныеСрезПоследних";
		#КонецОбласти
		
	Иначе
		
		Запрос.Текст = 
		#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _КлиентДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентДУ.НомерДоговора КАК НомерДоговора,
		|	_КлиентДУ.ДатаЗаключения КАК ДатаДоговора,
		|	РеквизитыКлиентаАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеСчетаДУ,
		|	РеквизитыОрганизацийАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ИЗ
		|	_КлиентДУ КАК _КлиентДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиентаАнкетныеСрезПоследних
		|		ПО _КлиентДУ.Клиент = РеквизитыКлиентаАнкетныеСрезПоследних.ЮрФизЛицо,
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицоОрганизации) КАК РеквизитыОрганизацийАнкетныеСрезПоследних";
		#КонецОбласти
		
	КонецЕсли;
	
	ПараметрыШапки = Запрос.Выполнить().Выбрать();
	
	Если ЗначениеЗаполнено(Подписант) Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("Организация",	Организация);
		Запрос.УстановитьПараметр("Ответственный",	Подписант);
		
		Запрос.Текст =
		#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	КонтактныеЛица.КонтактноеЛицо.Наименование КАК Ответственный
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	(КонтактныеЛица.Подразделение, КонтактныеЛица.Язык, КонтактныеЛица.Объект, КонтактныеЛица.КонтактноеЛицо) В
		|			(ВЫБРАТЬ
		|				ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) КАК Подразделение,
		|				ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык,
		|				Организации.ЮрФизЛицо КАК Объект,
		|				&Ответственный КАК КонтактноеЛицо
		|			ИЗ
		|				Справочник.Организации КАК Организации
		|			ГДЕ
		|				Организации.Ссылка = &Организация)";
		#КонецОбласти
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Данные.Вставить("Должность", Выборка.Должность + ?(ЗначениеЗаполнено(Выборка.ОснованиеПолномочий), " (на основании " + Выборка.ОснованиеПолномочий + ")", ""));
			Данные.Вставить("Ответственный", Выборка.Ответственный);
		Иначе
			Данные.Вставить("Ответственный", Подписант);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Руководитель) Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("Организация",	Организация);
		Запрос.УстановитьПараметр("Ответственный",	Руководитель);
		
		Запрос.Текст =
		#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛица.Должность КАК Должность,
		|	КонтактныеЛица.ОснованиеПолномочий КАК ОснованиеПолномочий,
		|	КонтактныеЛица.КонтактноеЛицо.Наименование КАК Ответственный
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	(КонтактныеЛица.Подразделение, КонтактныеЛица.Язык, КонтактныеЛица.Объект, КонтактныеЛица.КонтактноеЛицо) В
		|			(ВЫБРАТЬ
		|				ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) КАК Подразделение,
		|				ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык,
		|				Организации.ЮрФизЛицо КАК Объект,
		|				&Ответственный КАК КонтактноеЛицо
		|			ИЗ
		|				Справочник.Организации КАК Организации
		|			ГДЕ
		|				Организации.Ссылка = &Организация)";
		#КонецОбласти
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Данные.Вставить("ДолжностьРуководителя", Выборка.Должность + ?(ЗначениеЗаполнено(Выборка.ОснованиеПолномочий), " (на основании " + Выборка.ОснованиеПолномочий + ")", ""));
			Данные.Вставить("Руководитель", Выборка.Ответственный);
		Иначе
			Данные.Вставить("Руководитель", Руководитель);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыШапки.Следующий() Тогда
		Данные.Вставить("НаименованиеОрганизации",	ПараметрыШапки.НаименованиеОрганизации);
		Данные.Вставить("НаименованиеСчетаДУ",		ПараметрыШапки.НаименованиеСчетаДУ);
		Данные.Вставить("ДатаДоговора",				Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		Данные.Вставить("НомерДоговора",			ПараметрыШапки.НомерДоговора);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДатуРеформации()
	
	ДатаРеформации = Дата(1,1,1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РеформацииБалансов.Организация КАК Организация,
	|	РеформацииБалансов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РеформацииБалансов.ДатаРеформации КАК ДатаРеформации
	|ИЗ
	|	РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
	|ГДЕ
	|	РеформацииБалансов.Организация = &Организация
	|	И РеформацииБалансов.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И РеформацииБалансов.ДатаРеформации < &ДатаОтчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаРеформации УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаОтчета", НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		ДатаРеформации = Выборка.ДатаРеформации + 24*60*60;
	КонецЦикла;
		
	Возврат ДатаРеформации;
	
КонецФункции	

#КонецОбласти