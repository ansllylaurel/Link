		|	ВЫБОР
		|		КОГДА НалоговыйУчетОбороты.Субконто2 ССЫЛКА Справочник.Облигации
		|			ТОГДА Облигации.ГосударственныйРегистрационныйНомер
		|		КОГДА НалоговыйУчетОбороты.Субконто2 ССЫЛКА Справочник.Акции
		|			ТОГДА Акции.ГосударственныйРегистрационныйНомер
		|	КОНЕЦ КАК РегНомер,
		|	ВЫБОР
		|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|			ТОГДА ""Ипотечные""
		|		ИНАЧЕ НастройкиУчетаАктивов.ВидАктива
		|	КОНЕЦ КАК ВидАктива,
		|	НастройкиУчетаАктивов.Операция КАК Операция,
		|	НастройкиУчетаАктивов.Документ КАК Документ
		|ПОМЕСТИТЬ _Движения
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Запись,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						НастройкиУчетаАктивов.Аналитика
		|					ИЗ
		|						_НастройкиУчетаАктивов КАК НастройкиУчетаАктивов),
		|			КорСчет <> ЗНАЧЕНИЕ(ПланСчетов.Основной.СальдоПрочихДоходовИРасходов),
		|			) КАК НалоговыйУчетОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НастройкиУчетаАктивов КАК НастройкиУчетаАктивов
		|		ПО НалоговыйУчетОбороты.Субконто1 = НастройкиУчетаАктивов.Аналитика
		|			И (НастройкиУчетаАктивов.Погашение = НЕОПРЕДЕЛЕНО
		|				ИЛИ НастройкиУчетаАктивов.Погашение = (ТИПЗНАЧЕНИЯ(НалоговыйУчетОбороты.Регистратор) В (ТИП(Документ.СписаниеЦеннойБумаги), ТИП(Документ.ПогашениеЦеннойБумаги))))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ПО НалоговыйУчетОбороты.Регистратор = ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ПО НалоговыйУчетОбороты.Регистратор = СделкаЦенныеБумаги.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЦеннойБумаги КАК СписаниеЦеннойБумаги
		|		ПО НалоговыйУчетОбороты.Регистратор = СписаниеЦеннойБумаги.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ДокументПогашениеЦеннойБумаги
		|		ПО НалоговыйУчетОбороты.Регистратор = ДокументПогашениеЦеннойБумаги.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО НалоговыйУчетОбороты.Субконто2 = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ОкончаниеПериодаДата,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
		|		ПО НалоговыйУчетОбороты.Субконто2.Эмитент.ЮрФизЛицо = РеквизитыЭмитента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО НалоговыйУчетОбороты.Субконто2 = Акции.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(НалоговыйУчетОбороты.Период, ДЕНЬ),
		|	НастройкиУчетаАктивов.Операция,
		|	НастройкиУчетаАктивов.Документ,
		|	РеквизитыЭмитента.КраткоеНаименованиеПоУставу,
		|	ВЫБОР
		|		КОГДА НалоговыйУчетОбороты.Субконто2 ССЫЛКА Справочник.Облигации
		|			ТОГДА Облигации.ГосударственныйРегистрационныйНомер
		|		КОГДА НалоговыйУчетОбороты.Субконто2 ССЫЛКА Справочник.Акции
		|			ТОГДА Акции.ГосударственныйРегистрационныйНомер
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|			ТОГДА ""Ипотечные""
		|		ИНАЧЕ НастройкиУчетаАктивов.ВидАктива
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|			ТОГДА ""Ипотечные""
		|		ИНАЧЕ НастройкиУчетаАктивов.ВидАктива
		|	КОНЕЦ КАК ВидАктива,
		|	СУММА(НалоговыйУчетОстаткиИОбороты.СуммаОборотКт) КАК СуммаПериод,
		|	СУММА(НалоговыйУчетОстаткиИОбороты.СуммаНачальныйОстатокКт + НалоговыйУчетОстаткиИОбороты.СуммаОборотКт) КАК СуммаСНачалаГода
		|ПОМЕСТИТЬ _Итоги
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						НастройкиУчетаАктивов.Аналитика
		|					ИЗ
		|						_НастройкиУчетаАктивов КАК НастройкиУчетаАктивов)) КАК НалоговыйУчетОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			НастройкиУчетаАктивов.Аналитика КАК Аналитика,
		|			НастройкиУчетаАктивов.ВидАктива КАК ВидАктива,
		|			НастройкиУчетаАктивов.Купон КАК Купон
		|		ИЗ
		|			_НастройкиУчетаАктивов КАК НастройкиУчетаАктивов) КАК НастройкиУчетаАктивов
		|		ПО НалоговыйУчетОстаткиИОбороты.Субконто1 = НастройкиУчетаАктивов.Аналитика
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО НалоговыйУчетОстаткиИОбороты.Субконто2 = Облигации.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|			ТОГДА ""Ипотечные""
		|		ИНАЧЕ НастройкиУчетаАктивов.ВидАктива
		|	КОНЕЦ";	
#КонецОбласти

	Запрос.Выполнить();

	Данные.Вставить("РеквизитыШапки", Запрос.МенеджерВременныхТаблиц.Таблицы["_РеквизитыШапки"].ПолучитьДанные().Выгрузить());
	Данные.Вставить("Движения"		, Запрос.МенеджерВременныхТаблиц.Таблицы["_Движения"].ПолучитьДанные().Выгрузить());
	Данные.Вставить("Итоги"			, Запрос.МенеджерВременныхТаблиц.Таблицы["_Итоги"].ПолучитьДанные().Выгрузить());
	
	Данные.Движения.Сортировать("ДатаСделки");
	
	Для Каждого СтрокаДанных Из Данные.Движения Цикл
		СтрокаДанных.Документ = СокрЛП(СтрокаДанных.Документ) + " " + Формат(СтрокаДанных.ДатаСделки, "ДФ=dd.MM.yyyy");
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанные2РПР_СНГ(ОтчетнаяФорма)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода"				, Макс(ЭтотОбъект.Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("НачалоГода"					, Макс(НачалоГода(ЭтотОбъект.Период.ДатаНачала), ДатаРеформации));
	Запрос.УстановитьПараметр("ОкончаниеПериода"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Ответственный"				, ЭтотОбъект.Подписант);
	Запрос.УстановитьПараметр("ДокументПоПриобритению"		, ?(ОтчетнаяФорма = "1РПР", "Регистр 5РПР", "Отчет брокера за дату приобретения"));
	Запрос.УстановитьПараметр("ВыводитьДатыПокупки"			, ОтчетнаяФорма = "2РПР");
	Запрос.УстановитьПараметр("ИсключитьКупоныКорп15"		, ОтчетнаяФорма <> "1РПР");
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	РеквизитыКлиента.ПолноеНаименованиеПоУставу КАК УчредительУправления,
		|	ПОДСТРОКА(РеквизитыОтветственного.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыОтветственного.Отчество, 1, 1) + "". "" + РеквизитыОтветственного.Фамилия КАК Ответственный
		|ПОМЕСТИТЬ _РеквизитыШапки
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ОкончаниеПериода, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДУ
		|		ПО (КлиентыДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиента
		|		ПО (КлиентыДУ.Клиент = РеквизитыКлиента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ ПЕРВЫЕ 1
		|							Организации.ЮрФизЛицо
		|						ИЗ
		|							Справочник.Организации КАК Организации
		|						ГДЕ
		|							Организации.Ссылка = &Организация)) КАК РеквизитыОрганизации
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Организация = &Организация
		|					И ЮрФизЛицо = &Ответственный
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОтветственного
		|		ПО (ИСТИНА)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НалоговыйУчетОбороты.Период КАК Период,
		|	НалоговыйУчетОбороты.Субконто2 КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _НеОбращаютсяНаОРЦБ
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&НачалоГода,
		|			&ОкончаниеПериода,
		|			День,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления,
		|			КорСчет <> ЗНАЧЕНИЕ(ПланСчетов.Основной.СальдоПрочихДоходовИРасходов),
		|			) КАК НалоговыйУчетОбороты
		|ГДЕ
		|	НалоговыйУчетОбороты.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
		|	И НалоговыйУчетОбороты.Субконто2 <> НЕОПРЕДЕЛЕНО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделки.ДатаИсполнения КАК ДатаИсполнения,
		|	Сделки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(Сделки.Количество) КАК Количество,
		|	СУММА(РасходыПоСделке.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность) КАК СуммаРасхода,
		|	РасходыПоСделке.ВидЗадолженности КАК ВидЗадолженности
		|ПОМЕСТИТЬ _РасходыПоСделкам
		|ИЗ
		|	_НеОбращаютсяНаОРЦБ КАК _НеОбращаютсяНаОРЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Сделка.Ссылка КАК Сделка,
		|			НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ) КАК ДатаИсполнения,
		|			СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(СделкаЦенныеБумаги.Количество) КАК Количество
		|		ИЗ
		|			Документ.Сделка КАК Сделка
		|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|				ПО (СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка)
		|		ГДЕ
		|			Сделка.Дата МЕЖДУ &НачалоГода И &ОкончаниеПериода
		|			И Сделка.Проведен
		|			И Сделка.СчетДоверительногоУправления В ИЕРАРХИИ(&СчетДоверительногоУправления)
		|			И Сделка.Организация = &Организация
		|			И Сделка.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции))
		|			И Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			И НЕ Сделка.ОтложенноеИсполнение
		|		
		|		СГРУППИРОВАТЬ ПО
		|			Сделка.Ссылка,
		|			СделкаЦенныеБумаги.ЦеннаяБумага,
		|			НАЧАЛОПЕРИОДА(Сделка.Дата, ДЕНЬ)
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ИсполнениеОбязательствПоСделке.Основание,
		|			НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ),
		|			ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага,
		|			СУММА(ИсполнениеОбязательствПоСделкеЦенныеБумаги.Количество)
		|		ИЗ
		|			Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|				ПО (ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = ИсполнениеОбязательствПоСделке.Ссылка)
		|		ГДЕ
		|			ИсполнениеОбязательствПоСделке.Дата МЕЖДУ &НачалоГода И &ОкончаниеПериода
		|			И ИсполнениеОбязательствПоСделке.Проведен
		|			И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|			И ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления В ИЕРАРХИИ(&СчетДоверительногоУправления)
		|			И ИсполнениеОбязательствПоСделке.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции))
		|			И ИсполнениеОбязательствПоСделке.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ИсполнениеОбязательствПоСделке.Основание,
		|			ИсполнениеОбязательствПоСделкеЦенныеБумаги.ЦеннаяБумага,
		|			НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Дата, ДЕНЬ)) КАК Сделки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке КАК РасходыПоСделке
		|			ПО (РасходыПоСделке.Организация = &Организация)
		|				И (РасходыПоСделке.Активность)
		|				И (РасходыПоСделке.СчетДоверительногоУправления В ИЕРАРХИИ (&СчетДоверительногоУправления))
		|				И (РасходыПоСделке.Сделка = Сделки.Сделка)
		|				И (РасходыПоСделке.ЦеннаяБумага = Сделки.ЦеннаяБумага)
		|				И (РасходыПоСделке.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)))
		|				И (РасходыПоСделке.Период <= КОНЕЦПЕРИОДА(Сделки.ДатаИсполнения, ДЕНЬ))
		|				И (РасходыПоСделке.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)))
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО Сделки.ДатаИсполнения = КурсыВалют.Период
		|				И (КурсыВалют.Валюта = РасходыПоСделке.Валюта)
		|		ПО _НеОбращаютсяНаОРЦБ.Период = Сделки.ДатаИсполнения
		|			И _НеОбращаютсяНаОРЦБ.ЦеннаяБумага = Сделки.ЦеннаяБумага
		|
		|СГРУППИРОВАТЬ ПО
		|	Сделки.ДатаИсполнения,
		|	Сделки.ЦеннаяБумага,
		|	РасходыПоСделке.ВидЗадолженности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Период, ДЕНЬ) КАК Период,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(БухПартииЦенныхБумаг.Количество) КАК КоличествоРасход,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) КАК СтоимостьВВалютеУчетаРасход,
		|	СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) КАК СтоимостьКупонаВВалютеУчетаРасход,
		|	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ЕСТЬNULL(ИсполнениеОбязательствПоСделке.Дата, Сделка.Дата), ВводЦенныхБумагЦенныеБумаги.ДатаПокупки), ДЕНЬ) КАК ДатаПокупки,
		|	НАЧАЛОПЕРИОДА(ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата, ДЕНЬ) КАК ДатаВвода
		|ПОМЕСТИТЬ _БухПартии
		|ИЗ
		|	_НеОбращаютсяНаОРЦБ КАК _НеОбращаютсяНаОРЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|			ПО (&ВыводитьДатыПокупки)
		|				И БухПартииЦенныхБумаг.Партия = ИсполнениеОбязательствПоСделке.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|			ПО (&ВыводитьДатыПокупки)
		|				И БухПартииЦенныхБумаг.Партия = Сделка.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|			ПО (&ВыводитьДатыПокупки)
		|				И БухПартииЦенныхБумаг.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|				И БухПартииЦенныхБумаг.ЦеннаяБумага = ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|				И БухПартииЦенныхБумаг.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.НомерСтроки
		|		ПО (_НеОбращаютсяНаОРЦБ.Период = НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Период, ДЕНЬ))
		|			И _НеОбращаютсяНаОРЦБ.ЦеннаяБумага = БухПартииЦенныхБумаг.ЦеннаяБумага
		|ГДЕ
		|	БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоГода И &ОкончаниеПериода
		|	И БухПартииЦенныхБумаг.Организация = &Организация
		|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|	И БухПартииЦенныхБумаг.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции))
		|	И БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И БухПартииЦенныхБумаг.Активность
		|	И ТИПЗНАЧЕНИЯ(БухПартииЦенныхБумаг.Регистратор) В (ТИП(Документ.ИсполнениеОбязательствПоСделке), ТИП(Документ.ПогашениеЦеннойБумаги), ТИП(Документ.Сделка), ТИП(Документ.СписаниеЦеннойБумаги))
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(БухПартииЦенныхБумаг.Период, ДЕНЬ),
		|	БухПартииЦенныхБумаг.ЦеннаяБумага,
		|	НАЧАЛОПЕРИОДА(ЕСТЬNULL(ЕСТЬNULL(ИсполнениеОбязательствПоСделке.Дата, Сделка.Дата), ВводЦенныхБумагЦенныеБумаги.ДатаПокупки), ДЕНЬ),
		|	НАЧАЛОПЕРИОДА(ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата, ДЕНЬ)
		|
		|ИМЕЮЩИЕ
		|	(СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) > 0
		|		ИЛИ СУММА(БухПартииЦенныхБумаг.СтоимостьВВалютеУчета) > 0
		|		ИЛИ СУММА(БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета) > 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОтчета.ДатаСделки КАК ДатаСделки,
		|	_ДанныеОтчета.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА _ДанныеОтчета.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫБОР
		|					КОГДА Облигации.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная))
		|						ТОГДА ""Государственные""
		|					КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА ""Ипотечные""
		|					КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""Корпоративные""
		|				КОНЕЦ
		|		КОГДА _ДанныеОтчета.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акции""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидАктива,
		|	РеквизитыЭмитента.КраткоеНаименованиеПоУставу КАК Эмитент,
		|	ВЫБОР
		|		КОГДА _ДанныеОтчета.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА Облигации.ГосударственныйРегистрационныйНомер
		|		КОГДА _ДанныеОтчета.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА Акции.ГосударственныйРегистрационныйНомер
		|	КОНЕЦ КАК РегНомер,
		|	_ДанныеОтчета.КоличествоРасход КАК КоличествоРасход,
		|	_ДанныеОтчета.Операция КАК Операция,
		|	ВЫРАЗИТЬ(_ДанныеОтчета.Документ КАК СТРОКА(100)) КАК Документ,
		|	_ДанныеОтчета.СуммаРасхода КАК СуммаРасхода,
		|	_ДанныеОтчета.ВидЗадолженности КАК ВидЗадолженности,
		|	_ДанныеОтчета.ДатаПокупки КАК ДатаПокупки,
		|	_ДанныеОтчета.ДатаВвода КАК ДатаВвода
		|ПОМЕСТИТЬ _ДанныеОтчета
		|ИЗ
		|	(ВЫБРАТЬ
		|		_РасходыПоСделкам.ДатаИсполнения КАК ДатаСделки,
		|		_РасходыПоСделкам.ЦеннаяБумага КАК ЦеннаяБумага,
		|		_РасходыПоСделкам.Количество КАК КоличествоРасход,
		|		""Расходы по реализации"" КАК Операция,
		|		""Отчет брокера от"" КАК Документ,
		|		_РасходыПоСделкам.СуммаРасхода КАК СуммаРасхода,
		|		_РасходыПоСделкам.ВидЗадолженности КАК ВидЗадолженности,
		|		NULL КАК ДатаПокупки,
		|		NULL КАК ДатаВвода
		|	ИЗ
		|		_РасходыПоСделкам КАК _РасходыПоСделкам
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_БухПартии.Период,
		|		_БухПартии.ЦеннаяБумага,
		|		_БухПартии.КоличествоРасход,
		|		""Расходы по приобретению"",
		|		&ДокументПоПриобритению,
		|		_БухПартии.СтоимостьКупонаВВалютеУчетаРасход,
		|		""Купон"",
		|		_БухПартии.ДатаПокупки,
		|		_БухПартии.ДатаВвода
		|	ИЗ
		|		_БухПартии КАК _БухПартии
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ПО _БухПартии.ЦеннаяБумага = Облигации.Ссылка
		|				И (Облигации.Категория <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная))
		|				И (Облигации.Категория <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная))
		|				И (Облигации.Категория <> ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная))
		|	ГДЕ
		|		_БухПартии.СтоимостьКупонаВВалютеУчетаРасход > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_БухПартии.Период,
		|		_БухПартии.ЦеннаяБумага,
		|		_БухПартии.КоличествоРасход,
		|		""Расходы по приобретению"",
		|		&ДокументПоПриобритению,
		|		_БухПартии.СтоимостьВВалютеУчетаРасход,
		|		""Тело"",
		|		_БухПартии.ДатаПокупки,
		|		_БухПартии.ДатаВвода
		|	ИЗ
		|		_БухПартии КАК _БухПартии
		|	ГДЕ
		|		_БухПартии.СтоимостьВВалютеУчетаРасход > 0) КАК _ДанныеОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО _ДанныеОтчета.ЦеннаяБумага = Облигации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
		|		ПО _ДанныеОтчета.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЭмитента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО _ДанныеОтчета.ЦеннаяБумага = Акции.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОтчета.ДатаСделки КАК ДатаСделки,
		|	_ДанныеОтчета.ВидАктива КАК ВидАктива,
		|	_ДанныеОтчета.Эмитент КАК Эмитент,
		|	_ДанныеОтчета.РегНомер КАК РегНомер,
		|	_ДанныеОтчета.КоличествоРасход КАК Количество,
		|	_ДанныеОтчета.Операция КАК Операция,
		|	_ДанныеОтчета.Документ КАК Документ,
		|	_ДанныеОтчета.СуммаРасхода КАК Сумма,
		|	_ДанныеОтчета.ДатаПокупки КАК ДатаПокупки,
		|	_ДанныеОтчета.ДатаВвода КАК ДатаВвода
		|ПОМЕСТИТЬ _Движения
		|ИЗ
		|	_ДанныеОтчета КАК _ДанныеОтчета
		|ГДЕ
		|	_ДанныеОтчета.ДатаСделки МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеОтчета.ВидАктива КАК ВидАктива,
		|	СУММА(_ДанныеОтчета.СуммаРасхода) КАК СуммаСНачалаГода,
		|	СУММА(ВЫБОР
		|			КОГДА _ДанныеОтчета.ДатаСделки МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|				ТОГДА _ДанныеОтчета.СуммаРасхода
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаПериод
		|ПОМЕСТИТЬ _Итоги
		|ИЗ
		|	_ДанныеОтчета КАК _ДанныеОтчета
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДанныеОтчета.ВидАктива";
#КонецОбласти

	Запрос.Выполнить();

	Данные.Вставить("РеквизитыШапки", Запрос.МенеджерВременныхТаблиц.Таблицы["_РеквизитыШапки"].ПолучитьДанные().Выгрузить());
	Данные.Вставить("Движения"		, Запрос.МенеджерВременныхТаблиц.Таблицы["_Движения"].ПолучитьДанные().Выгрузить());
	Данные.Вставить("Итоги"			, Запрос.МенеджерВременныхТаблиц.Таблицы["_Итоги"].ПолучитьДанные().Выгрузить());
	
	Данные.Движения.Сортировать("ДатаСделки");
	
	Для Каждого СтрокаДанных Из Данные.Движения Цикл
		Если ЗначениеЗаполнено(СтрокаДанных.ДатаВвода) Тогда
			СтрокаДанных.Документ = СтрЗаменить(СтрокаДанных.Документ, "Отчет брокера за дату приобретения", "Ввод бумаг в ДУ от " + Формат(СтрокаДанных.ДатаВвода, "ДФ=dd.MM.yyyy") + ", покупка " + Формат(СтрокаДанных.ДатаПокупки, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ДатаПокупки) Тогда
			СтрокаДанных.Документ = СтрЗаменить(СтрокаДанных.Документ, "Отчет брокера за дату приобретения", "Отчет брокера от " + Формат(СтрокаДанных.ДатаПокупки, "ДФ=dd.MM.yyyy"));
