Функция ПолучитьДанныеОтчетаОФинансовомРезультатеДУ(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	ТЗ = ПолучитьШаблонТаблицыДляОтчетаОФинансовомРезультатеДУ();
	
	// Приводим начало периода к началу квартала.
	ПараметрНачалоПериода = Макс(НачалоКвартала(Период.ДатаНачала), ДатаРеформации);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ",										ТЗ);
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",			СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГодаГраница",						Новый Граница(Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериода",							ПараметрНачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",							Период.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериодаГраница",					Новый Граница(Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоВторогоМесяца",					КонецМесяца(ПараметрНачалоПериода) + 1);
	Запрос.УстановитьПараметр("НачалоТретьегоМесяца",					КонецМесяца(КонецМесяца(ПараметрНачалоПериода) + 1) + 1);
