		|					ТОГДА ВЫРАЗИТЬ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|					ТОГДА ВЫРАЗИТЬ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|					ТОГДА ВЫРАЗИТЬ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(УсловияСделокРЕПО_Ч1.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО УсловияСделокРЕПО_Ч1.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ
		|		ПО УсловияСделокРЕПО_Ч1.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютЧ2
		|		ПО (УсловияСделокРЕПО_Ч2.ВалютаОплаты = КурсыВалютЧ2.Валюта)
		|			И (УсловияСделокРЕПО_Ч2.ДатаИсполнения = КурсыВалютЧ2.Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютКонецПериода
		|		ПО (УсловияСделокРЕПО_Ч2.ВалютаОплаты = КурсыВалютКонецПериода.Валюта)
		|			И (КурсыВалютКонецПериода.Период = НАЧАЛОПЕРИОДА(&КонецПериода, ДЕНЬ))
		|ГДЕ
		|	УсловияСделокРЕПО_Ч1.ДатаВторойЧастиРЕПО >= &НачалоПериода
		|	И УсловияСделокРЕПО_Ч1.СделкаРЕПО.ВидСделки = &ВидСделки";   
	
	Запрос.Текст = ТекстЗапросаОбщаяЧасть + "
		|;
		|
		|ВЫБРАТЬ
		|	_Данные.Раздел КАК Раздел,
		|	_Данные.СделкаРЕПО КАК СделкаРЕПО,
		|	_Данные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Данные.Количество КАК Количество,
		|	_Данные.ДатаИсполненияЧ1 КАК ДатаИсполненияЧ1,
		|	_Данные.ДатаИсполненияЧ2 КАК ДатаИсполненияЧ2,
		|	_Данные.Срок КАК Срок,
		|	_Данные.СрокМесяц КАК СрокМесяц,
		|	_Данные.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_Данные.СуммаЧ1 КАК СуммаЧ1,
		|	_Данные.СуммаЧ2 КАК СуммаЧ2,
		|	_Данные.СуммаДохода КАК СуммаДохода,
		|	_Данные.ВсегоНачислено КАК ВсегоНачислено,
		|	_Данные.СуммаНаНачалоПериода КАК СуммаНаНачалоПериода,
		|	_Данные.СуммаОтчетныйПериод КАК СуммаОтчетныйПериод,
		|	_Данные.СуммаКомиссии КАК СуммаКомиссии
		|ИЗ
		|	_Данные КАК _Данные
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаИсполненияЧ1,
		|	ДатаИсполненияЧ2
		|ИТОГИ
		|	СУММА(СуммаЧ1),
		|	СУММА(СуммаЧ2),
		|	СУММА(СуммаДохода),
		|	СУММА(ВсегоНачислено),
		|	СУММА(СуммаНаНачалоПериода),
		|	СУММА(СуммаОтчетныйПериод),
		|	СУММА(СуммаКомиссии)
		|ПО
		|	Раздел";
	
	
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Вставить("ВыборкаЗаПериод", Выборка);
	
	//годовой итог. выполним тоже самый запрос. Внутри запроса раздление данные на данные за период отчета и с начала года вызывает затруднение. 
	Запрос.УстановитьПараметр("НачалоПериода",		Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации));  
	Запрос.УстановитьПараметр("КонецПредыдущегоПериода",	Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации) - 1);
	
	Запрос.Текст =  ТекстЗапросаОбщаяЧасть + " 
		|; 
		|ВЫБРАТЬ
		|	СУММА(_Данные.СуммаЧ1) КАК СуммаЧ1,
		|	СУММА(_Данные.СуммаЧ2) КАК СуммаЧ2,
		|	СУММА(_Данные.СуммаДохода) КАК СуммаДохода,
		|	СУММА(_Данные.СуммаТекущийПериод) КАК ВсегоНачислено,
		|	СУММА(_Данные.СуммаТекущийПериод - _Данные.СуммаОтчетныйПериод) КАК СуммаНаНачалоПериода,
		|	СУММА(_Данные.СуммаОтчетныйПериод) КАК СуммаОтчетныйПериод,
		|	СУММА(_Данные.СуммаКомиссии) КАК СуммаКомиссии
		|ИЗ
		|	_Данные КАК _Данные";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Данные.Вставить("ВыборкаЗаГод", Выборка);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанныеВедКД(ДополнительныеПараметры, Режим)
	
	Данные = Новый Структура;
	
	ДатаРеформации = ПолучитьДатуРеформации();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Макс(ДатаРеформации, Период.ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Фильтр = Новый Массив;
	Если Режим = "15" Тогда 
		Фильтр.Добавить("Корп15");
		Фильтр.Добавить("Гос");
	ИначеЕсли Режим = "20" Тогда 
		Фильтр.Добавить("Корп20");
	КонецЕсли;	
	Запрос.УстановитьПараметр("Фильтр", Фильтр);
	
	СписокАктивов = Новый Массив();
	СписокАктивов.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	СписокАктивов.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);	
	
	Запрос.УстановитьПараметр("СписокАктивов", СписокАктивов);
	
	Если ЭтотОбъект.Период.ДатаНачала >= Дата(2024, 11, 1) Тогда
		Запрос.УстановитьПараметр("УчитыватьСтрануРегистрации", Истина);
	Иначе
		Запрос.УстановитьПараметр("УчитыватьСтрануРегистрации", Ложь);
	КонецЕсли;	
	
	Запрос.Текст = 
	#Область ТекстЗапроса	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК АналитикаДоходов,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации КАК АналитикаДоходовОтРеализации,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение КАК АналитикаДоходовПоследнееПогашение,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки КАК АналитикаДоходовОтПереоценки
	|ПОМЕСТИТЬ _АналитикиНКД
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&КонецПериода,
	|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И УчетныйАктив В (&СписокАктивов)) КАК НастройкиУчетаАктивовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_АналитикиНКД.АналитикаДоходов КАК АналитикаДоходов
	|ПОМЕСТИТЬ _СписокАналитик
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	_АналитикиНКД.АналитикаДоходовОтРеализации
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	_АналитикиНКД.АналитикаДоходовПоследнееПогашение
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	_АналитикиНКД.АналитикаДоходовОтПереоценки
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_АналитикиНКД.АналитикаДоходовОтПереоценки КАК АналитикаДоходовПереоценки
	|ПОМЕСТИТЬ _СписокАналитикПереоценки
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_АналитикиНКД.АналитикаДоходов КАК АналитикаДоходов
	|ПОМЕСТИТЬ _СписокАналитикДохода
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	_АналитикиНКД.АналитикаДоходовПоследнееПогашение
	|ИЗ
	|	_АналитикиНКД КАК _АналитикиНКД
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Обороты.Регистратор КАК Регистратор,
	|	Обороты.Субконто1 КАК ПрочиеДоходыРасходы,
	|	Обороты.Субконто3 КАК ОбращаетсяНаОРЦБ,
	|	Обороты.Субконто2 КАК ЦеннаяБумага,
	|	0 КАК СуммаОборотДт,
	|	Обороты.СуммаОборотКт КАК СуммаОборотКт,
	|	ВЫБОР
	|		КОГДА Обороты.Субконто2.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
	|			ТОГДА ВЫБОР
	|					КОГДА Обороты.Субконто2.ДатаНачалаРазмещения >= ДАТАВРЕМЯ(2017, 1, 1)
	|							И Обороты.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
	|							И (НЕ &УчитыватьСтрануРегистрации
	|								ИЛИ РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|									И &УчитыватьСтрануРегистрации)
	|						ТОГДА ""Корп15""
	|					ИНАЧЕ ""Корп20""
	|				КОНЕЦ
	|		ИНАЧЕ ""Гос""
	|	КОНЕЦ КАК Раздел
	|ПОМЕСТИТЬ _ДоходыРасходы
	|ИЗ
	|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						_СписокАналитик.АналитикаДоходов
	|					ИЗ
	|						_СписокАналитик),
	|			КорСчет <> ЗНАЧЕНИЕ(ПланСчетов.Основной.СальдоПрочихДоходовИРасходов),
	|			) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&КонецПериода,
	|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО (ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто2) = ТИП(Справочник.Облигации)
	|					ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
	|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Обороты.Регистратор,
	|	Обороты.Субконто1,
	|	Обороты.Субконто3,
	|	Обороты.Субконто2,
	|	Обороты.СуммаОборотДт,
	|	0,
	|	ВЫБОР
	|		КОГДА Обороты.Субконто2.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
	|			ТОГДА ВЫБОР
	|					КОГДА Обороты.Субконто2.ДатаНачалаРазмещения >= ДАТАВРЕМЯ(2017, 1, 1)
	|							И Обороты.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
	|							И (НЕ &УчитыватьСтрануРегистрации
	|								ИЛИ РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|									И &УчитыватьСтрануРегистрации)
	|						ТОГДА ""Корп15""
	|					ИНАЧЕ ""Корп20""
	|				КОНЕЦ
	|		ИНАЧЕ ""Гос""
	|	КОНЕЦ
	|ИЗ
	|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы),
	|			,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						_СписокАналитик.АналитикаДоходов
	|					ИЗ
	|						_СписокАналитик),
	|			,
	|			) КАК Обороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&КонецПериода,
	|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО (ВЫБОР
	|				КОГДА ТИПЗНАЧЕНИЯ(Обороты.Субконто2) = ТИП(Справочник.Облигации)
	|					ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
	|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
