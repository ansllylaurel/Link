Функция ПолучитьОписаниеДокумента(ВыборкаСтроки)
	
	Рез = "";
	
	Если ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.Сделка") ИЛИ
		ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		Рез = "Биржевая операция " + ВыборкаСтроки.Регистратор.Номер;	
	ИначеЕсли ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ПогашениеКупона") 
		ИЛИ ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда		
		Рез = "Погашение купона " + ВыборкаСтроки.Регистратор.Номер;
	ИначеЕсли ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") Тогда
		Рез = "Переоценка " + ВыборкаСтроки.Регистратор.Номер;
	ИначеЕсли ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда
		Рез = "Вывод ценных бумаг " + ВыборкаСтроки.Регистратор.Номер;		
	Конецесли;	
	
	Возврат Рез;
	
КонецФункции

Функция ПолучитьОписаниеОперации(ВыборкаСтроки)
	
	Рез = "";
	
	Если ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.Сделка") ИЛИ
		ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		Рез = Строка(ВыборкаСтроки.ЦенныеБумаги);
	ИначеЕсли ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ПогашениеКупона") 
		ИЛИ ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги") Тогда		
		Если ВыборкаСтроки.Доход > 0 Тогда
			Рез = "Выплачен купонный доход: " + Строка(ВыборкаСтроки.ЦенныеБумаги);
		Иначе
			Рез = Строка(ВыборкаСтроки.ЦенныеБумаги);
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") Тогда
		Рез = "Начислен НКД: " + Строка(ВыборкаСтроки.ЦенныеБумаги);
	ИначеЕсли ТипЗнч(ВыборкаСтроки.Регистратор) = Тип("ДокументСсылка.ВыводЦенныхБумаг") Тогда	
		Рез = Строка(ВыборкаСтроки.ЦенныеБумаги);	
	Конецесли;	
	
	Возврат Рез;
	
