Функция Сформировать5РПР(Данные)
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	РезультатОтчета.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	РезультатОтчета.АвтоМасштаб			= Истина;
	РезультатОтчета.ФиксацияСверху		= 12;
	
	Макет = ПолучитьМакет("РПР5");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьВид		= Макет.ПолучитьОбласть("Вид");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтого	= Макет.ПолучитьОбласть("Итого");
	ОбластьПодвал	= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьШапка, 1);
	
	ВыборкаОбщиеИтоги = Данные.Выборка;
	
	Если ВыборкаОбщиеИтоги.Следующий() Тогда
		
		ВыборкаВиды = ВыборкаОбщиеИтоги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВиды.Следующий() Цикл
			
			ОбластьВид.Параметры.Заполнить(ВыборкаВиды);
			
			РезультатОтчета.Вывести(ОбластьВид, 2);
			
			РезультатОтчета.НачатьГруппуСтрок(, Ложь);
			
			Выборка = ВыборкаВиды.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				
				ОбластьСтрока.Параметры.ЭмитентВыпуск = "" + Выборка.Эмитент + ?(ЗначениеЗаполнено(Выборка.Выпуск), ", " + Выборка.Выпуск, "") + ?(ЗначениеЗаполнено(Выборка.ГосРегНомер), ", " + Выборка.ГосРегНомер, "");
				
				РезультатОтчета.Вывести(ОбластьСтрока, 3);
				
			КонецЦикла;
			 
			ОбластьИтого.Параметры.Заполнить(ВыборкаВиды);
			
			РезультатОтчета.ЗакончитьГруппуСтрок();
			
			РезультатОтчета.Вывести(ОбластьИтого, 2);
			
		КонецЦикла;
		
		ОбластьПодвал.Параметры.Заполнить(ВыборкаОбщиеИтоги);
		
	КонецЕсли;
	
	ОбластьПодвал.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьПодвал, 1);
	
	Возврат РезультатОтчета;
	
