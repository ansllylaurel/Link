	Данные4РПР = ПолучитьДанные4РПР(ДополнительныеПараметры);
	Выборка = Данные4РПР.Выборка;
	Если Выборка.Следующий() Тогда 
		СтрокаДанных.Строка_1_Столбец_6 = Выборка.СуммаСНачалаГода;
	КонецЕсли;	
	
	//итоги
	//стр. 20
	СтрокаДанных.Строка_2_Столбец_2 = СтрокаДанных.Строка_2_1_Столбец_2;
	СтрокаДанных.Строка_2_Столбец_3 = СтрокаДанных.Строка_2_1_Столбец_3;
	СтрокаДанных.Строка_2_Столбец_4 = СтрокаДанных.Строка_2_1_Столбец_2 - СтрокаДанных.Строка_2_1_Столбец_3;
	
	//стр. 60
	СтрокаДанных.Строка_4_1_Столбец_4 = СтрокаДанных.Строка_4_1_Столбец_2;
	СтрокаДанных.Строка_4_2_Столбец_4 = СтрокаДанных.Строка_4_2_Столбец_2;
	СтрокаДанных.Строка_4_Столбец_2 = СтрокаДанных.Строка_4_1_Столбец_2 + СтрокаДанных.Строка_4_2_Столбец_2;
	СтрокаДанных.Строка_4_Столбец_4 = СтрокаДанных.Строка_4_Столбец_2;
	СтрокаДанных.Строка_4_Столбец_10 = СтрокаДанных.Строка_4_Столбец_2;
	
	//ст80 
	СтрокаДанных.Строка_6_Столбец_4 = СтрокаДанных.Строка_6_Столбец_2;
	СтрокаДанных.Строка_6_Столбец_9 = СтрокаДанных.Строка_6_Столбец_2;
	
	//стр. 110 
	СтрокаДанных.Строка_7_Столбец_4 = СтрокаДанных.Строка_7_Столбец_2 - СтрокаДанных.Строка_7_Столбец_3; 
	
	//Разделение прочих расходов
	База = ?(СтрокаДанных.Строка_2_Столбец_4>0,СтрокаДанных.Строка_2_Столбец_4,0) + 
			?(СтрокаДанных.Строка_7_Столбец_4>0,СтрокаДанных.Строка_7_Столбец_4,0) + 
			?(СтрокаДанных.Строка_3_Столбец_4>0,СтрокаДанных.Строка_3_Столбец_4,0);
	Если База > 0 Тогда
		СтрокаДанных.Строка_2_Столбец_6 = СтрокаДанных.Строка_1_Столбец_6/База * ?(СтрокаДанных.Строка_2_Столбец_4>0,СтрокаДанных.Строка_2_Столбец_4,0);
		СтрокаДанных.Строка_3_Столбец_6 = СтрокаДанных.Строка_1_Столбец_6/База * ?(СтрокаДанных.Строка_3_Столбец_4>0,СтрокаДанных.Строка_3_Столбец_4,0);
		СтрокаДанных.Строка_7_Столбец_6 = СтрокаДанных.Строка_1_Столбец_6/База * ?(СтрокаДанных.Строка_7_Столбец_4>0,СтрокаДанных.Строка_7_Столбец_4,0);
	Иначе
		СтрокаДанных.Строка_7_Столбец_6 = СтрокаДанных.Строка_1_Столбец_6;
	КонецЕсли;	
	
	//итоги. продолженние
	СтрокаДанных.Строка_2_Столбец_7 = СтрокаДанных.Строка_2_Столбец_3 + СтрокаДанных.Строка_2_Столбец_6;
	СтрокаДанных.Строка_7_Столбец_7 = СтрокаДанных.Строка_7_Столбец_3 + СтрокаДанных.Строка_7_Столбец_6;
	
	СтрокаДанных.Строка_2_Столбец_10 = СтрокаДанных.Строка_2_Столбец_4 - СтрокаДанных.Строка_2_Столбец_6;
	СтрокаДанных.Строка_7_Столбец_10 = СтрокаДанных.Строка_7_Столбец_4 - СтрокаДанных.Строка_7_Столбец_6; 
	
	//стр 10
	СтрокаДанных.Строка_1_Столбец_2 = СтрокаДанных.Строка_2_Столбец_2 + СтрокаДанных.Строка_3_Столбец_2 + СтрокаДанных.Строка_4_Столбец_2 + СтрокаДанных.Строка_6_Столбец_2 + СтрокаДанных.Строка_7_Столбец_2;
	СтрокаДанных.Строка_1_Столбец_3	= СтрокаДанных.Строка_2_Столбец_3 + СтрокаДанных.Строка_3_Стоблец_3 + СтрокаДанных.Строка_7_Столбец_3; 							
	СтрокаДанных.Строка_1_Столбец_4	= СтрокаДанных.Строка_2_Столбец_4 + СтрокаДанных.Строка_3_Столбец_4 + СтрокаДанных.Строка_4_Столбец_4 + СтрокаДанных.Строка_6_Столбец_4 + СтрокаДанных.Строка_7_Столбец_4; 									
	//СтрокаДанных.Строка_1_Столбец_6 = 4РПР. Сумму разделили 2,3,7 строки
	СтрокаДанных.Строка_1_Столбец_7 = СтрокаДанных.Строка_2_Столбец_7 + СтрокаДанных.Строка_3_Столбец_7 + СтрокаДанных.Строка_7_Столбец_7;
	СтрокаДанных.Строка_1_Столбец_9 = СтрокаДанных.Строка_6_Столбец_9;
