Функция ПолучитьДанныеРегистраУчетаПрочихДоходовОтРазмещенияПенсионныхРезервов(ДополнительныеПараметры)
	
	Данные = Новый Структура;
	ДатаРеформации = ПолучитьДатуРеформации(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",			СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоГодаГраница",						Новый Граница(Макс(НачалоГода(Период.ДатаНачала), ДатаРеформации), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериода",							Макс(Период.ДатаНачала, ДатаРеформации));
	Запрос.УстановитьПараметр("КонецПериода",							Период.ДатаОкончания);
	Запрос.УстановитьПараметр("КонецПериодаГраница",					Новый Граница(Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПрочиеДоходы",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ПрочиеВнереализацДиР"));

	Если Период.ДатаНачала >= Дата(2024, 11, 1) Тогда
		Запрос.УстановитьПараметр("УчитыватьСтрануРегистрации", Истина);
	Иначе
		Запрос.УстановитьПараметр("УчитыватьСтрануРегистрации", Ложь);
