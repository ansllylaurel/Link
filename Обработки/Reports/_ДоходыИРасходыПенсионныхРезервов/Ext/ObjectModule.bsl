		КонецЦикла;
		
		ОбластьВсего.Параметры.Заполнить(ВыборкаОбщиеИтоги);
		
	КонецЕсли;
	
	РезультатОтчета.Вывести(ОбластьВсего, 1);
	
	ОбластьПодвал.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьПодвал);
	
	РезультатОтчета.ФиксацияСверху = 8;
	
	Возврат РезультатОтчета;
	
КонецФункции

Функция Сформировать10ДПР(Данные)
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("ДПР10");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог			= Макет.ПолучитьОбласть("Итог");
	ОбластьВсего		= Макет.ПолучитьОбласть("Всего");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьШапка);
	
	ВыборкаОбщиеИтоги = Данные.Выборка;
	
	Если ВыборкаОбщиеИтоги.Следующий() Тогда
		
		ВыборкаТаблица = ВыборкаОбщиеИтоги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаТаблица.Следующий() Цикл
			
			ОбластьЗаголовок.Параметры.Заполнить(ВыборкаТаблица);
			ОбластьИтог.Параметры.Заполнить(ВыборкаТаблица);
			
			РезультатОтчета.Вывести(ОбластьЗаголовок);
			
			Выборка = ВыборкаТаблица.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				
				РезультатОтчета.Вывести(ОбластьСтрока);
				
			КонецЦикла;
			
			РезультатОтчета.Вывести(ОбластьИтог);
			
		КонецЦикла;
		
		ОбластьВсего.Параметры.Заполнить(ВыборкаОбщиеИтоги);
		
	КонецЕсли;
	
	РезультатОтчета.Вывести(ОбластьВсего);
	
	ОбластьПодвал.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьПодвал);
	
	Возврат РезультатОтчета;
	
КонецФункции

Функция Сформировать11ДПР(Данные, ПрямоеРЕПО = Ложь)
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("ДПР11");
	
	Если ПрямоеРЕПО Тогда
		ОбластьШапка			= Макет.ПолучитьОбласть("Шапка2");
	Иначе
		ОбластьШапка			= Макет.ПолучитьОбласть("Шапка");
	КонецЕсли;
	ОбластьРаздел			= Макет.ПолучитьОбласть("Раздел");
	ОбластьСтрока			= Макет.ПолучитьОбласть("Строка");
	ОбластьИтогиЗаПериод	= Макет.ПолучитьОбласть("ИтогиЗаПериод");
	ОбластьИтогиСНачалаГода	= Макет.ПолучитьОбласть("ИтогиСНачалаГода");
	ОбластьПодвал			= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьШапка, 1);
	
	ВыборкаРазделы = Данные.ВыборкаЗаПериод;
	
	Пока ВыборкаРазделы.Следующий() Цикл
		
		ОбластьРаздел.Параметры.Заполнить(ВыборкаРазделы);
		
		РезультатОтчета.Вывести(ОбластьРаздел, 2);
		
		РезультатОтчета.НачатьГруппуСтрок(, Ложь);
		
		Выборка = ВыборкаРазделы.Выбрать();
			
		Пока Выборка.Следующий()
			И ЗначениеЗаполнено(Выборка.ЦеннаяБумага) Цикл
			
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			
			РезультатОтчета.Вывести(ОбластьСтрока, 3);
			
		КонецЦикла;
		
		РезультатОтчета.ЗакончитьГруппуСтрок();
		
		ОбластьИтогиЗаПериод.Параметры.Заполнить(ВыборкаРазделы);
		
		РезультатОтчета.Вывести(ОбластьИтогиЗаПериод, 2);
		
	КонецЦикла;
	
	Если Данные.ВыборкаЗаГод.Следующий() Тогда
		ОбластьИтогиСНачалаГода.Параметры.Заполнить(Данные.ВыборкаЗаГод);
	КонецЕсли;
	
	РезультатОтчета.Вывести(ОбластьИтогиСНачалаГода, 1);
	
	ОбластьПодвал.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьПодвал, 1);
	
	Возврат РезультатОтчета;
	
КонецФункции

Функция СформироватьВедКД(Данные, Режим)
	
	РезультатОтчета = Новый ТабличныйДокумент;	
	
	Макет = ПолучитьМакет("ВедКД");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка"+Режим);	
	ОбластьЗаголовокСекции = Макет.ПолучитьОбласть("ЗаголовокСекции");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьПропуск = Макет.ПолучитьОбласть("Пропуск");
	ОбластьПодвал			= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьШапка, 1);
	
	
	//тело отчета
	ВыборкаПериод = Данные.ВыборкаПериод;
	ВыборкаСНачалаГода = Данные.ВыборкаСНачалаГода;
	
	Пока ВыборкаСНачалаГода.Следующий() Цикл 
		// для итогов с начала года
		ВыборкаСНачалаГодаРаздел = ВыборкаСНачалаГода.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЦикла;		
			
	Пока ВыборкаПериод.Следующий() Цикл
		ВыборкаПериодРаздел = ВыборкаПериод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПериодРаздел.Следующий() Цикл
			Если ВыборкаПериодРаздел.Раздел = "Гос" Тогда 
				ОписаниеРаздела = "По государственным ценным бумагам"; 
			ИначеЕсли ВыборкаПериодРаздел.Раздел = "Корп15" Тогда
				ОписаниеРаздела = "По корпоративным ценным бумагам по ставке пп 1 п. 4 ст. 284 НК РФ";
			ИначеЕсли ВыборкаПериодРаздел.Раздел = "Корп20" Тогда
				ОписаниеРаздела = "По корпоративным ценным бумагам по ставке п. 1 ст. 284 НК РФ";
			КонецЕсли;	
			
			ОбластьЗаголовокСекции.Параметры.ОписаниеРаздела = ОписаниеРаздела;
			РезультатОтчета.Вывести(ОбластьЗаголовокСекции);
			
			ВыборкаСтроки = ВыборкаПериодРаздел.Выбрать();
			Пока ВыборкаСтроки.Следующий() Цикл 
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаСтроки);
				ОбластьСтрока.Параметры.ОписаниеОперации = ПолучитьОписаниеОперации(ВыборкаСтроки);
				ОбластьСтрока.Параметры.ОписаниеДокумента = ПолучитьОписаниеДокумента(ВыборкаСтроки);
				РезультатОтчета.Вывести(ОбластьСтрока);			
			КонецЦикла;
			
			ОписаниеИтога = "Всего за отчетный период";
			ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, ВыборкаПериодРаздел);
			ОбластьИтог.Параметры.ОписаниеИтога = ОписаниеИтога;
			РезультатОтчета.Вывести(ОбластьИтог);
			
			Если ВыборкаСНачалаГодаРаздел.НайтиСледующий(Новый Структура("Раздел", ВыборкаПериодРаздел.Раздел)) Тогда   
				ОписаниеИтога = "Всего с начала налогового периода:";
				ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, ВыборкаСНачалаГодаРаздел);
				ОбластьИтог.Параметры.ОписаниеИтога = ОписаниеИтога;
				РезультатОтчета.Вывести(ОбластьИтог);
				ВыборкаСНачалаГодаРаздел.Сбросить();
			КонецЕсли;
			
		КонецЦикла;	
		
		РезультатОтчета.Вывести(ОбластьПропуск);
		ОписаниеИтога = "Всего по НКД за отчетный период";
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, ВыборкаПериод);
		ОбластьИтог.Параметры.ОписаниеИтога = ОписаниеИтога;
		РезультатОтчета.Вывести(ОбластьИтог);
		
		ВыборкаСНачалаГода.Сбросить(); ВыборкаСНачалаГода.Следующий();
		ОписаниеИтога = "Всего с начала налогового периода:";
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, ВыборкаСНачалаГода);
		ОбластьИтог.Параметры.ОписаниеИтога = ОписаниеИтога;
		РезультатОтчета.Вывести(ОбластьИтог);
				
	КонецЦикла;
		
	ОбластьПодвал.Параметры.Заполнить(Данные);
	РезультатОтчета.Вывести(ОбластьПодвал, 1);
		
	Возврат РезультатОтчета;
	
КонецФункции

Функция СформироватьОтчетОФинансовомРезультатеДУ(Данные)
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	РезультатОтчета.АвтоМасштаб = Истина;
	
	Макет = ПолучитьМакет("ОтчетОФинансовомРезультатеДУ");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьПодстрока	= Макет.ПолучитьОбласть("Подстрока");
	ОбластьДетали		= Макет.ПолучитьОбласть("Детали");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(Данные);
	
	Если Период.ДатаОкончания <> КонецКвартала(Период.ДатаОкончания) Тогда
		ОбластьШапка.Параметры.ПериодКвартал = "период с " + Формат(НачалоКвартала(Период.ДатаНачала), "ДФ=dd.MM.yy") + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yy");
	Иначе
		ОбластьШапка.Параметры.ПериодКвартал = Формат(Период.ДатаОкончания, "ДФ='к ''квартал'' гггг ''года'''");
	КонецЕсли;
	
	РезультатОтчета.Вывести(ОбластьШапка, 1);
	
	Выборка = Данные.Выборка;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Уровень = 1 Тогда
			Область = ОбластьСтрока;
		ИначеЕсли Выборка.Уровень = 2 И Выборка.ЕстьДетали Тогда
			Область = ОбластьПодстрока;
		Иначе
			Область = ОбластьДетали;
		КонецЕсли;
		
		Область.Параметры.Заполнить(Выборка);
		
		Область.Параметры.Заголовок = СокрЛП(Область.Параметры.Заголовок);
		
		РезультатОтчета.Вывести(Область);
		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьПодвал, 1);
	
	Возврат РезультатОтчета;
	
КонецФункции

Функция СформироватьРегистрУчетаПрочихРасходовОтРазмещенияПенсионныхРезервов(Данные)
	
	РезультатОтчета = Новый ТабличныйДокумент;
	
	РезультатОтчета.АвтоМасштаб = Истина;
	
	Макет = ПолучитьМакет("РегистрУчетаПрочихРасходовОтРазмещенияПенсионныхРезервов");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги		= Макет.ПолучитьОбласть("Итоги");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Заполнить(Данные);
	
	Если Период.ДатаНачала = НачалоКвартала(Период.ДатаНачала)
		И Период.ДатаОкончания = КонецКвартала(Период.ДатаОкончания)
		И НачалоКвартала(Период.ДатаНачала) = НачалоКвартала(Период.ДатаОкончания) Тогда
		ОбластьШапка.Параметры.ПериодОтчета = Формат(Период.ДатаОкончания, "ДФ='к ''квартал'' гггг ''года'''");
	Иначе
		ОбластьШапка.Параметры.ПериодОтчета = "период с " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yy") + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yy");
	КонецЕсли;
	
	РезультатОтчета.Вывести(ОбластьШапка);
	
	ВыборкаИтоги = Данные.Выборка;
	
	Пока ВыборкаИтоги.Следующий() Цикл
		
		ВыборкаГруппы = ВыборкаИтоги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппы.Следующий() Цикл
			
			ОбластьЗаголовок.Параметры.Заполнить(ВыборкаГруппы);
			
			РезультатОтчета.Вывести(ОбластьЗаголовок);
			
			Выборка = ВыборкаГруппы.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				Если ЗначениеЗаполнено(Выборка.Документ) Тогда
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					
					РезультатОтчета.Вывести(ОбластьСтрока);	
				КонецЕсли;
				
			КонецЦикла;
			
			ОбластьИтоги.Параметры.Заполнить(ВыборкаГруппы);
			
			РезультатОтчета.Вывести(ОбластьИтоги);
			
		КонецЦикла;
		
		ОбластьПодвал.Параметры.Заполнить(ВыборкаИтоги);
		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Заполнить(Данные);
	
	РезультатОтчета.Вывести(ОбластьПодвал);
	
	Возврат РезультатОтчета;
	
КонецФункции

