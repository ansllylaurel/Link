			СтрокаДанных.Документ = СтрЗаменить(СтрокаДанных.Документ, "Отчет брокера от", "Отчет брокера от " + Формат(СтрокаДанных.ДатаСделки, "ДФ=dd.MM.yyyy"));	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Данные;
	
