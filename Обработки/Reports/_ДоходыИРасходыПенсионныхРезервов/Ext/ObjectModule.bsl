#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	
	Настройки.Добавить("ОтправлятьОтчетВСоставеПакета");
	Настройки.Добавить("КаталогФайловДляОтправкиПоЭДО");
	Настройки.Добавить("СрокФормирования");
	Настройки.Добавить("ПодписантРуководитель");
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("ФормаОтчета");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("АдресЭлектроннойПочты");
	Настройки.Добавить("АдресОтправителя");
	Настройки.Добавить("ПриобретенныеДо21082014");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ДополнительныеПараметры = Неопределено;
	
	Если НастройкиОтчета.ФормаОтчета = "5РПР" Тогда
		
		Если НастройкиОтчета.ПриобретенныеДо21082014 Тогда
			Значение = 1;
		Иначе
			Значение = 0;
		КонецЕсли;
		
		ДополнительныеПараметры = Новый Структура("Вариант", Значение);
		
	КонецЕсли;
	
	Если ТипЗнч(НастройкиОтчета.Подписант) = Тип("Структура") Тогда
		Подписант = НастройкиОтчета.Подписант.КонтактноеЛицо;
	Иначе
		Подписант = НастройкиОтчета.Подписант;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиОтчета.ПодписантРуководитель) = Тип("Структура") Тогда
