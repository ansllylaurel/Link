		|	ОстаткиКонецПериода.Партия,
		|	ОстаткиКонецПериода.СтрокаПартии,
		|	ДОБАВИТЬКДАТЕ(КупонныйДоходПоОблигациям.Период, ДЕНЬ, 1),
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона,
		|	РАЗНОСТЬДАТ(КупонныйДоходПоОблигациям.Период, &КонецПериода, ДЕНЬ),
		|	КупонныйДоходПоОблигациям.СтавкаКупона,
		|	КупонныйДоходПоОблигациям.СуммаКупона,
		|	ОстаткиКонецПериода.КоличествоОстаток,
		|	КупонныйДоходПоОблигациям.Облигация.Номинал,
		|	ОстаткиКонецПериода.СтоимостьКупонаВВалютеУчетаОстаток,
		|	ОстаткиКонецПериода.ПереоценкаКупонаВВалютеУчетаОстаток / ОстаткиКонецПериода.КоличествоОстаток,
		|	ОстаткиКонецПериода.ПереоценкаКупонаВВалютеУчетаОстаток,
		|	ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период > &НачалоГода
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиНачалоГода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоГода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ,
		|	0,
		|	ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период > &НачалоГода
		|			ТОГДА ОстаткиКонецПериода.ПереоценкаКупонаВВалютеУчетаОстаток
		|		ИНАЧЕ ОстаткиКонецПериода.ПереоценкаКупонаВВалютеУчетаОстаток - ЕСТЬNULL(ОстаткиНачалоГода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоГода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период >= &НачалоПериода
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиНачалоПериода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоПериода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ - ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период > &НачалоГода
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиНачалоГода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоГода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период > &НачалоГода
		|			ТОГДА ОстаткиКонецПериода.ПереоценкаКупонаВВалютеУчетаОстаток
		|		ИНАЧЕ ОстаткиКонецПериода.ПереоценкаКупонаВВалютеУчетаОстаток - ЕСТЬNULL(ОстаткиНачалоГода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоГода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ - ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период >= &НачалоПериода
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиНачалоПериода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоПериода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ + ВЫБОР
		|		КОГДА КупонныйДоходПоОблигациям.Период > &НачалоГода
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(ОстаткиНачалоГода.ПереоценкаКупонаВВалютеУчетаОстаток, 0) / ЕСТЬNULL(ОстаткиНачалоГода.КоличествоОстаток, 1) * ОстаткиКонецПериода.КоличествоОстаток
		|	КОНЕЦ,
		|	""Обращающиеся ценные бумаги"",
		|	ОстаткиКонецПериода.Партия.Дата
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&КонецПериодаГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ЦеннаяБумага.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная))) КАК ОстаткиКонецПериода
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&НачалоГода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная))) КАК ОстаткиНачалоГода
		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = ОстаткиНачалоГода.ЦеннаяБумага
		|			И ОстаткиКонецПериода.Партия = ОстаткиНачалоГода.Партия
		|			И ОстаткиКонецПериода.СтрокаПартии = ОстаткиНачалоГода.СтрокаПартии
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|				&НачалоПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И ЦеннаяБумага.Категория В (ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация), ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная))) КАК ОстаткиНачалоПериода
		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = ОстаткиНачалоПериода.ЦеннаяБумага
		|			И ОстаткиКонецПериода.Партия = ОстаткиНачалоПериода.Партия
		|			И ОстаткиКонецПериода.СтрокаПартии = ОстаткиНачалоПериода.СтрокаПартии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = КупонныйДоходПоОблигациям.Облигация
		|			И (&КонецПериода > КОНЕЦПЕРИОДА(КупонныйДоходПоОблигациям.Период, ДЕНЬ))
		|			И (&КонецПериода < КупонныйДоходПоОблигациям.ДатаОкончанияКупона)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ОстаткиКонецПериода.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(ОстаткиКонецПериода.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ
		|		ПО ОстаткиКонецПериода.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага,
		|	ПартияДата,
		|	СтрокаПартии,
		|	ДатаНачалаКупонногоПериода
		|ИТОГИ
		|	СУММА(ВсегоКупонногоДохода),
		|	СУММА(НачисленоНаНачалоНалоговогоПериода),
		|	СУММА(КупонВыплаченный),
		|	СУММА(НачисленоСНачалаНалоговогоПериода),
		|	СУММА(НачисленоПоПредыдущийПериод),
		|	СУММА(НачисленоЗаТекущийПериод)
		|ПО
		|	ОБЩИЕ,
		|	СтавкаНалогообложения";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Вставить("Выборка", Выборка);
	
	Возврат Данные;
	
КонецФункции

Функция Запрос9ДПР(Ставка, ДатаРеформации)
	
	// в первую секунду 2025 года в ЕПС была реклассификация бумаг
	// так как отчет использует движения по пратиям ЕПС, то первую секунду 2025 года надо выколоть. 
	Если Год(Период.ДатаНачала) = 2025 Тогда
		НачалоГодаОтчета = НачалоГода(Период.ДатаНачала) + 1;
		Если НачалоДня(Период.ДатаНачала) = НачалоГода(Период.ДатаНачала) Тогда
			НачалоПериодаОтчета = НачалоДня(Период.ДатаНачала) + 1;
		Иначе
			НачалоПериодаОтчета = НачалоДня(Период.ДатаНачала);
		КонецЕсли;
	Иначе
		НачалоГодаОтчета = НачалоГода(Период.ДатаНачала);
		НачалоПериодаОтчета = НачалоДня(Период.ДатаНачала);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",					Макс(НачалоПериодаОтчета, ДатаРеформации));
	Запрос.УстановитьПараметр("НачалоГода",						Макс(НачалоГодаОтчета, ДатаРеформации));
	Запрос.УстановитьПараметр("КонецПериода",					КонецДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Ставка", Ставка);
	
	Если Период.ДатаНачала >= Дата(2024, 11, 1) Тогда
		Запрос.УстановитьПараметр("УчитыватьСтрануРегистрации", Истина);
	Иначе
		Запрос.УстановитьПараметр("УчитыватьСтрануРегистрации", Ложь);
	КонецЕсли;
	
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОплатаОснования.Ссылка КАК Ссылка,
		|	ОплатаОснования.Основание КАК Основание,
		|	ПогашениеЦеннойБумаги.СуммаКупона КАК СуммаКупона,
		|	ПогашениеЦеннойБумаги.Количество КАК Количество,
		|	КупонныйДоходПоОблигациям.Период КАК ДатаНачалаКупонногоПериода,
		|	КупонныйДоходПоОблигациям.ДатаОкончанияКупона КАК ДатаОкончанияКупонногоПериода,
		|	КупонныйДоходПоОблигациям.СтавкаКупона КАК СтавкаКупона,
		|	КупонныйДоходПоОблигациям.СуммаКупона КАК КупонНаОднуОблигацию,
		|	КупонныйДоходПоОблигациям.Облигация.Номинал КАК Номинал
		|ПОМЕСТИТЬ _ПогашенияОснования
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям КАК КупонныйДоходПоОблигациям
		|			ПО ПогашениеЦеннойБумаги.ЦеннаяБумага = КупонныйДоходПоОблигациям.Облигация
		|				И (НАЧАЛОПЕРИОДА(ПогашениеЦеннойБумаги.Дата, ДЕНЬ) = КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|					ИЛИ НАЧАЛОПЕРИОДА(ПогашениеЦеннойБумаги.Дата, ДЕНЬ) < КупонныйДоходПоОблигациям.ДатаОкончанияКупона
		|						И ПогашениеЦеннойБумаги.Дата > КОНЕЦПЕРИОДА(КупонныйДоходПоОблигациям.Период, ДЕНЬ))
		|		ПО ОплатаОснования.Основание = ПогашениеЦеннойБумаги.Ссылка
		|ГДЕ
		|	ОплатаОснования.Основание ССЫЛКА Документ.ПогашениеЦеннойБумаги
		|	И ОплатаОснования.Основание.Дата МЕЖДУ &НачалоГода И КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|	И ОплатаОснования.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОплатаОснования.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, ДЕНЬ) КАК Период,
		|	ПогашенияИПродажиЕПС.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПогашенияИПродажиЕПС.Партия КАК Партия,
		|	ПогашенияИПродажиЕПС.СтрокаПартии КАК СтрокаПартии,
		|	ЕСТЬNULL(_ПогашенияЦеннойБумаги.ДатаНачалаКупонногоПериода, КупонныйДоходПоОблигациям.Период) КАК ДатаНачалаКупонногоПериода,
		|	ЕСТЬNULL(_ПогашенияЦеннойБумаги.ДатаОкончанияКупонногоПериода, КупонныйДоходПоОблигациям.ДатаОкончанияКупона) КАК ДатаОкончанияКупонногоПериода,
		|	РАЗНОСТЬДАТ(ЕСТЬNULL(_ПогашенияЦеннойБумаги.ДатаНачалаКупонногоПериода, КупонныйДоходПоОблигациям.Период), ВЫБОР
		|			КОГДА ПогашенияИПродажи.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|					И НЕ НастройкиПоВидуУчетаСрезПоследних.НачислятьПроцентныеДоходыПоВыводимымАктивам
		|				ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ПогашенияИПродажи.Период, ДЕНЬ), ДЕНЬ, -1)
		|			КОГДА НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, ДЕНЬ) > ЕСТЬNULL(_ПогашенияЦеннойБумаги.ДатаОкончанияКупонногоПериода, КупонныйДоходПоОблигациям.ДатаОкончанияКупона)
		|				ТОГДА ЕСТЬNULL(_ПогашенияЦеннойБумаги.ДатаОкончанияКупонногоПериода, КупонныйДоходПоОблигациям.ДатаОкончанияКупона)
		|			ИНАЧЕ НАЧАЛОПЕРИОДА(ПогашенияИПродажиЕПС.Период, ДЕНЬ)
