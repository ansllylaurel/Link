	ДанныеОтчета.Колонки.Добавить("Строка_4_1_Столбец_2", Новый ОписаниеТипов("Число"));
	ДанныеОтчета.Колонки.Добавить("Строка_4_1_Столбец_4", Новый ОписаниеТипов("Число"));
	ДанныеОтчета.Колонки.Добавить("Строка_4_2_Столбец_2", Новый ОписаниеТипов("Число"));
