		Данные.Вставить("ИмяФондаСДоговором",	ВыборкаДетальныеЗаписи.ДоверительныйУправляющий + " ДУ " + ВыборкаДетальныеЗаписи.УчредительУправления + " по договору № " + ВыборкаДетальныеЗаписи.НомерДоговора + " от " + Формат(ВыборкаДетальныеЗаписи.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Выборка = Запрос9ДПР(15, ДатаРеформации);
	Данные.Вставить("Выборка", Выборка);
	
	Возврат Данные;	
		
