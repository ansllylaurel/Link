	|					ИНАЧЕ _Сделки.Цена - _КотировкиНаДатыСделок.МинимальнаяЦена
	|				КОНЕЦ
	|	КОНЕЦ КАК Отклонение,
	|	ВЫБОР
	|		КОГДА _Сделки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	|			ТОГДА ВЫБОР
	|					КОГДА _Сделки.Цена <= _КотировкиНаДатыСделок.МаксимальнаяЦена
	|						ТОГДА 0
	|					ИНАЧЕ (_Сделки.Цена - _КотировкиНаДатыСделок.МаксимальнаяЦена) * _Сделки.Количество
	|				КОНЕЦ
	|		КОГДА _Сделки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	|			ТОГДА ВЫБОР
	|					КОГДА _Сделки.Цена >= _КотировкиНаДатыСделок.МинимальнаяЦена
	|						ТОГДА 0
	|					ИНАЧЕ (_Сделки.Цена - _КотировкиНаДатыСделок.МинимальнаяЦена) * _Сделки.Количество
	|				КОНЕЦ
	|	КОНЕЦ КАК Корректировка
	|ИЗ
	|	_Сделки КАК _Сделки
	|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиНаДатыСделок КАК _КотировкиНаДатыСделок
	|		ПО _Сделки.ДокументСделка = _КотировкиНаДатыСделок.ДокументСделка
	|			И _Сделки.ЦеннаяБумага = _КотировкиНаДатыСделок.ЦеннаяБумага
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Расходы КАК _Расходы
	|		ПО _Сделки.ДокументСделка = _Расходы.Сделка
	|			И _Сделки.ЦеннаяБумага = _Расходы.ЦеннаяБумага
	|ГДЕ
	|	(&ТолькоРазницу
	|				И ВЫБОР
	|					КОГДА _Сделки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	|						ТОГДА ВЫБОР
	|								КОГДА _Сделки.Цена <= _КотировкиНаДатыСделок.МаксимальнаяЦена
	|									ТОГДА 0
	|								ИНАЧЕ _Сделки.Цена - _КотировкиНаДатыСделок.МаксимальнаяЦена
	|							КОНЕЦ
	|					КОГДА _Сделки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	|						ТОГДА ВЫБОР
	|								КОГДА _Сделки.Цена >= _КотировкиНаДатыСделок.МинимальнаяЦена
	|									ТОГДА 0
	|								ИНАЧЕ _Сделки.Цена - _КотировкиНаДатыСделок.МинимальнаяЦена
	|							КОНЕЦ
	|				КОНЕЦ <> 0
	|			ИЛИ НЕ &ТолькоРазницу)";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("BloomberBGN", ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BGN"));
	Запрос.УстановитьПараметр("ВалютаРубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	Запрос.УстановитьПараметр("ТолькоРазницу", ТолькоРазницу);
	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "_РаскрытыйКонтрагент"));
	
#КонецОбласти
		
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);


	ДокументРезультат.Очистить();
	Макет = ПолучитьМакет("Отчет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
