	|		ИНАЧЕ ВЫРАЗИТЬ(_Сделки.Сумма * _Сделки.Курс / _Сделки.Кратность КАК ЧИСЛО(19, 2))
	|	КОНЕЦ + ЕСТЬNULL(_Расходы.СуммаРасход, 0) КАК СуммаСУчетомЗатрат,
	|	ВЫБОР
	|		КОГДА _Сделки.ВалютаНоминала = &ВалютаРубль
	|			ТОГДА _КотировкиНаДатыСделок.МинимальнаяЦена
	|		ИНАЧЕ ВЫРАЗИТЬ(_КотировкиНаДатыСделок.МинимальнаяЦена * _Сделки.Курс / _Сделки.Кратность КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК МинимальнаяЦенаРуб,
	|	ВЫБОР
	|		КОГДА _Сделки.ВалютаНоминала = &ВалютаРубль
	|			ТОГДА _КотировкиНаДатыСделок.МаксимальнаяЦена
	|		ИНАЧЕ ВЫРАЗИТЬ(_КотировкиНаДатыСделок.МаксимальнаяЦена * _Сделки.Курс / _Сделки.Кратность КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК МаксимальнаяЦенаРуб,
	|	ВЫБОР
	|		КОГДА _Сделки.Дата = _КотировкиНаДатыСделок.ДатаМинимальнойЦены
	|				И _Сделки.Дата = _КотировкиНаДатыСделок.ДатаМаксимальнойЦены
	|			ТОГДА ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|		КОГДА _Сделки.Дата <> _КотировкиНаДатыСделок.ДатаМинимальнойЦены
	|			ТОГДА _КотировкиНаДатыСделок.ДатаМинимальнойЦены
	|		КОГДА _Сделки.Дата <> _КотировкиНаДатыСделок.ДатаМаксимальнойЦены
	|			ТОГДА _КотировкиНаДатыСделок.ДатаМаксимальнойЦены
	|	КОНЕЦ КАК ДатаЦены,
	|	_КотировкиНаДатыСделок.ДатаМинимальнойЦены КАК ДатаМинимальнойЦены,
	|	_КотировкиНаДатыСделок.ДатаМаксимальнойЦены КАК ДатаМаксимальнойЦены,
	|	_КотировкиНаДатыСделок.МинимальнаяЦена КАК МинимальнаяЦена,
	|	_КотировкиНаДатыСделок.МаксимальнаяЦена КАК МаксимальнаяЦена,
	|	ВЫБОР
	|		КОГДА _Сделки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	|			ТОГДА ВЫБОР
	|					КОГДА _Сделки.Цена <= _КотировкиНаДатыСделок.МаксимальнаяЦена
	|						ТОГДА 0
	|					ИНАЧЕ _Сделки.Цена - _КотировкиНаДатыСделок.МаксимальнаяЦена
	|				КОНЕЦ
	|		КОГДА _Сделки.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
	|			ТОГДА ВЫБОР
