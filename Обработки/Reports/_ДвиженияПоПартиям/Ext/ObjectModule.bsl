			КонецЦикла;
		КонецЦикла;	
		ОбластьИтог.Параметры.СтоимостьПокупкиКупон = СтоимостьПокупкиКупон;
		ОбластьИтог.Параметры.ПереоценкаНачало = ПереоценкаНачало;
		ОбластьИтог.Параметры.СтоимостьПокупки = СтоимостьПокупки;
		ОбластьИтог.Параметры.СтоимостьПокупкиКупонПериод = СтоимостьПокупкиКупонПериод;
		ОбластьИтог.Параметры.СтоимостьПокупкиПериод = СтоимостьПокупкиПериод;
		ОбластьИтог.Параметры.КупонПродажа = КупонПродажа;
		ОбластьИтог.Параметры.ПереоценкаПродажа = ПереоценкаПродажа;
		ОбластьИтог.Параметры.СтоимостьПродажа = СтоимостьПродажа;
		ОбластьИтог.Параметры.СтоимостьКупонаКонец = СтоимостьКупонаКонец;
		ОбластьИтог.Параметры.ПереоценкаКонец = ПереоценкаКонец;
		ОбластьИтог.Параметры.СтоимостьКонец = СтоимостьКонец;
		
		ДокументРезультат.Вывести(ОбластьИтог);
	КонецЦикла;

	//подписи
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
