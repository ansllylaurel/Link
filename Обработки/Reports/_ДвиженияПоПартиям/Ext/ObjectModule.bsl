
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Движения по партиям",
		"0.07",
		"",
		Истина);
		
	// команды отсутствуют - только интерактивный запуск
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ДокументРезультат = Новый ТабличныйДокумент;	
	Сформировать(ДокументРезультат);
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры


Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	
	Возврат Настройки;

КонецФункции

Процедура Сформировать(ДокументРезультат) Экспорт
	
	ДокументРезультат.Очистить();
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики();
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
		                     
	ТаблицаСтоимостей =	ПолучитьТаблицуСтоимостей();
		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(РегистрацияСтоимостиПереоценки.Дата) КАК Дата
		|ПОМЕСТИТЬ _ДатаРСП
		|ИЗ
		|	Документ.РегистрацияСтоимостиПереоценки КАК РегистрацияСтоимостиПереоценки
		|ГДЕ
		|	РегистрацияСтоимостиПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РегистрацияСтоимостиПереоценки.Проведен
		|	И РегистрацияСтоимостиПереоценки.Дата <= КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И РегистрацияСтоимостиПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РегистрацияСтоимостиПереоценки.Ссылка КАК ДокументРСП
		|ПОМЕСТИТЬ _ДокументРСП
		|ИЗ
		|	Документ.РегистрацияСтоимостиПереоценки КАК РегистрацияСтоимостиПереоценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатаРСП КАК _ДатаРСП
		|		ПО (_ДатаРСП.Дата = РегистрацияСтоимостиПереоценки.Дата)
		|			И (РегистрацияСтоимостиПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (РегистрацияСтоимостиПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
		|			И (РегистрацияСтоимостиПереоценки.Проведен)
		|			И (РегистрацияСтоимостиПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Партия КАК Партия,
		|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.СтрокаПартии КАК СтрокаПартии,
		|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Цена КАК Цена,
		|	РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.ДатаЦены КАК ДатаЦены
		|ПОМЕСТИТЬ _РСП
		|ИЗ
		|	Документ.РегистрацияСтоимостиПереоценки.СтоимостиПереоценки КАК РегистрацияСтоимостиПереоценкиСтоимостиПереоценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДокументРСП КАК _ДокументРСП
		|		ПО (_ДокументРСП.ДокументРСП = РегистрацияСтоимостиПереоценкиСтоимостиПереоценки.Ссылка)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешняяТаблица.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ВнешняяТаблица.ЦенаКотировки КАК ЦенаКотировки,
		|	_ВнешняяТаблица.ДатаЦены КАК ДатаЦены,
		|	_ВнешняяТаблица.ВалютаКотировки КАК ВалютаКотировки
		|ПОМЕСТИТЬ _ПереоценкаЦенныхБумагБезПослабления
		|ИЗ
		|	&ВнешняяТаблица КАК _ВнешняяТаблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РСП.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_РСП.Партия КАК Партия,
		|	_РСП.СтрокаПартии КАК СтрокаПартии,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумагБезПослабления.ЦенаКотировки, _РСП.Цена) КАК ЦенаКотировки,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумагБезПослабления.ДатаЦены, _РСП.ДатаЦены) КАК ДатаЦены
		|ПОМЕСТИТЬ _ЦенныеБумагиЦены
		|ИЗ
		|	_РСП КАК _РСП
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПереоценкаЦенныхБумагБезПослабления КАК _ПереоценкаЦенныхБумагБезПослабления
		|		ПО _РСП.ЦеннаяБумага = _ПереоценкаЦенныхБумагБезПослабления.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияОферт.Облигация КАК Облигация,
		|	МИНИМУМ(УсловияОферт.ДатаВыкупа) КАК ДатаБлижайшейОферты
		|ПОМЕСТИТЬ _УсловияОферт
		|ИЗ
		|	РегистрСведений.УсловияОферт КАК УсловияОферт
		|ГДЕ
		|	УсловияОферт.ДатаВыкупа > &ДатаОкончания
		|	И НЕ УсловияОферт.ТолькоДляФизическихЛиц
		|
		|СГРУППИРОВАТЬ ПО
		|	УсловияОферт.Облигация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Эмитент КАК Эмитент,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупкиОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиКупонаОстаток КАК СтоимостьПокупкиКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиОстаток КАК РасходыПриПокупкеВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВСтоимостиОстаток КАК ПереоценкаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВСтоимостиОстаток КАК ПереоценкаКупонаВСтоимостиОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток КАК ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток КАК ПереоценкаКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток КАК ДисконтПремияОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПОстаток КАК КорректировкаЭСПОстаток,
		|	БухПартииЦенныхБумагОстатки.СуммаЧастичногоПогашенияОстаток КАК СуммаЧастичногоПогашенияОстаток,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценениеОстаток,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеКупонаОстаток КАК СуммаРезервовПодОбесценениеКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.СуммаРезервовПоСомнительнымДолгамОстаток КАК СуммаРезервовПоСомнительнымДолгамОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйОстаток КАК ДисконтПремияНачисленныйОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаОстаток КАК ПереоценкаСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаСНачалаГодаОстаток КАК ПереоценкаКупонаСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйСНачалаГодаОстаток КАК ДисконтПремияНачисленныйСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПСНачалаГодаОстаток КАК КорректировкаЭСПСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.УчетныйАктивЦБРФ КАК ЦеннаяБумагаУчетныйАктивЦБРФ,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Тип КАК ЦеннаяБумагаТип,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ЦеннаяБумагаГосударственныйРегистрационныйНомер,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Наименование КАК ЦеннаяБумагаНаименование,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ДатаПогашения, """") КАК ДатаПогашения,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ВалютаНоминала КАК ЦеннаяБумагаВалютаНоминала,
		|	БухПартииЦенныхБумагОстатки.Партия.Основание КАК Основание,
		|	ЛОЖЬ КАК ПризнакПартииРепо,
		|	ЕСТЬNULL(ВводЦенныхБумагЦенныеБумаги.ДатаПокупки, БухПартииЦенныхБумагОстатки.Партия.Дата) КАК ДатаПокупки,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ _ОстаткиПартийЦБ
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаОкончанияГраница,
		|			Организация = &Организация
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ПО БухПартииЦенныхБумагОстатки.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.НомерСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.Партия,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Эмитент,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	БухПартииЦенныхБумагОстатки.СтоимостьОстаток,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаСНачалаГодаОстаток,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаСНачалаГодаОстаток,
		|	0,
		|	0,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.УчетныйАктивЦБРФ,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Тип,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ГосударственныйРегистрационныйНомер,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Наименование,
		|	ЕСТЬNULL(БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ДатаПогашения, """"),
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.ВалютаНоминала,
		|	БухПартииЦенныхБумагОстатки.Партия.Основание,
		|	ИСТИНА,
		|	БухПартииЦенныхБумагОстатки.Партия.Дата,
