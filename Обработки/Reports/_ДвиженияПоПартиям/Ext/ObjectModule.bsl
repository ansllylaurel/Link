		|		КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА """" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА """" + РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		ИНАЧЕ _ИтоговаяТаблица.Эмитент
		|	КОНЕЦ КАК Эмитент,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК ISIN,
		|	_ИтоговаяТаблица.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК НомерГосРегистрации,
		|	_ИтоговаяТаблица.КоличествоНачало КАК КоличествоНачало,
		|	_ИтоговаяТаблица.ЦенаПокупки КАК ЦенаПокупки,
		|	_ИтоговаяТаблица.НКД_1едНачало КАК НКД_1едНачало,
		|	_ИтоговаяТаблица.СтоимостьПокупкиКупон КАК СтоимостьПокупкиКупон,
		|	_ИтоговаяТаблица.СтоимостьПокупки КАК СтоимостьПокупки,
		|	_ИтоговаяТаблица.НКД_1едКонец КАК НКД_1едКонец,
		|	_ИтоговаяТаблица.ПереоценкаНачало КАК ПереоценкаНачало,
		|	_ИтоговаяТаблица.СтоимостьКупонаКонец КАК СтоимостьКупонаКонец,
		|	_ИтоговаяТаблица.ПереоценкаКонец КАК ПереоценкаКонец,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЕПС = &УчетныйАктивЕПС_РЕПО
		|			ТОГДА _ИтоговаяТаблица.СтоимостьКонец
		|		ИНАЧЕ ЕСТЬNULL(_ПереоценкаЦенныхБумаг.ЦенаКотировки, 0) * _ИтоговаяТаблица.КоличествоКонец
		|	КОНЕЦ КАК СтоимостьКонец,
		|	_ИтоговаяТаблица.КоличествоКонец КАК КоличествоКонец,
		|	_ИтоговаяТаблица.ДатаПогашения КАК ДатаПогашения,
		|	ЕСТЬNULL(_УсловияОферт.ДатаБлижайшейОферты, """") КАК ДатаБлижайшейОферты,
		|	ЕСТЬNULL(КупонныйДоходПоОблигациямСрезПоследних.СтавкаКупона, 0) КАК СтавкаКупона,
		|	ЕСТЬNULL(КупонныйДоходПоОблигациямСрезПоследних.Срок, 0) КАК СрокКупона,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.УчетныйАктивЕПС = &УчетныйАктивЕПС_РЕПО
		|			ТОГДА 0
		|		ИНАЧЕ ЕСТЬNULL(_ПереоценкаЦенныхБумаг.ЦенаКотировки, 0)
		|	КОНЕЦ КАК Котировка,
		|	ЕСТЬNULL(_ПереоценкаЦенныхБумаг.ДатаЦены, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаКотировки,
		|	_ИтоговаяТаблица.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ДатаПокупки > &ДатаНачала
		|			ТОГДА _ИтоговаяТаблица.ДатаПокупки
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	КОНЕЦ КАК ДатаПокупки,
		|	_ИтоговаяТаблица.КоличествоПриход КАК КоличествоПриход,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.КоличествоПриход > 0
		|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.СтоимостьПокупкиПериод / _ИтоговаяТаблица.КоличествоПриход КАК ЧИСЛО(27, 12))
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаПокупкиПериод,
		|	_ИтоговаяТаблица.СтоимостьПокупкиПериод КАК СтоимостьПокупкиПериод,
		|	_ИтоговаяТаблица.НКД_1едПриход КАК НКД_1едПриход,
		|	_ИтоговаяТаблица.СтоимостьПокупкиКупонПериод КАК СтоимостьПокупкиКупонПериод,
		|	_ИтоговаяТаблица.ДатаПродажи КАК ДатаПродажи,
		|	_ИтоговаяТаблица.КоличествоПродажа КАК КоличествоПродажа,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.КоличествоПродажа > 0
		|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.СтоимостьПродажа / _ИтоговаяТаблица.КоличествоПродажа КАК ЧИСЛО(27, 12))
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ЦенаПродажиПериод,
		|	_ИтоговаяТаблица.ПереоценкаПродажа КАК ПереоценкаПродажа,
		|	_ИтоговаяТаблица.СтоимостьПродажа КАК СтоимостьПродажа,
		|	_ИтоговаяТаблица.НКД_1едРасход КАК НКД_1едРасход,
		|	_ИтоговаяТаблица.КупонПродажа КАК КупонПродажа
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончанияГраница, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончанияГраница,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Доли)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Закладные)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Закладные).Банк.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончанияГраница, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _УсловияОферт КАК _УсловияОферт
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = _УсловияОферт.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КупонныйДоходПоОблигациям.СрезПоследних(&ДатаОкончанияГраница, ) КАК КупонныйДоходПоОблигациямСрезПоследних
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = КупонныйДоходПоОблигациямСрезПоследних.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиЦены КАК _ПереоценкаЦенныхБумаг
		|		ПО _ИтоговаяТаблица.ЦеннаяБумага = _ПереоценкаЦенныхБумаг.ЦеннаяБумага
		|			И _ИтоговаяТаблица.Партия = _ПереоценкаЦенныхБумаг.Партия
		|			И _ИтоговаяТаблица.СтрокаПартии = _ПереоценкаЦенныхБумаг.СтрокаПартии
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии
		|ИТОГИ
		|	СУММА(СтоимостьПокупкиКупон),
		|	СУММА(СтоимостьПокупки),
		|	СУММА(ПереоценкаНачало),
		|	СУММА(СтоимостьКупонаКонец),
		|	СУММА(ПереоценкаКонец),
		|	СУММА(СтоимостьКонец),
		|	СУММА(СтоимостьПокупкиПериод),
		|	СУММА(СтоимостьПокупкиКупонПериод),
		|	СУММА(ПереоценкаПродажа),
		|	СУММА(СтоимостьПродажа),
		|	СУММА(КупонПродажа)
		|ПО
		|	ОБЩИЕ,
		|	ЦеннаяБумага,
		|	Партия,
		|	СтрокаПартии";
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ДатаОкончанияГраница", Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("УчетныйАктивЕПС_РЕПО", Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО);
	Запрос.УстановитьПараметр("ВнешняяТаблица", ТаблицаСтоимостей);
	
	Макет = ПолучитьМакет("Отчет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьДанные = Макет.ПолучитьОбласть("СтрокаДанные");
	ОбластьДанныеПродажа = Макет.ПолучитьОбласть("СтрокаДанныеПродажа");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
	
	//шапка 
	ПараметрыШапки = РаботаСОтчетами.ПолучитьПараметрыШапки(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	ОбластьШапка.Параметры.ДатаДоговора			= Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.НомерДоговора = ПараметрыШапки.НомерДоговора;
	ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, "ФП=Истина");	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	//Итоги
	СтоимостьПокупкиКупон = 0;	
	ПереоценкаНачало = 0;	
	СтоимостьПокупки = 0;					
	СтоимостьПокупкиКупонПериод = 0;	
	СтоимостьПокупкиПериод = 0;					
	КупонПродажа = 0;	
	ПереоценкаПродажа = 0;	
	СтоимостьПродажа = 0;				
	СтоимостьКупонаКонец = 0;	
	ПереоценкаКонец = 0;	
	СтоимостьКонец = 0;
	
	//строки
	ВыборкаКорень = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаКорень.Следующий() Цикл 
		ВыборкаЦенныеБумаги = ВыборкаКорень.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);  
		
		Пока ВыборкаЦенныеБумаги.Следующий() Цикл 
			ВыборкаПартии = ВыборкаЦенныеБумаги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПартии.Следующий() Цикл 
				
				ВыборкаСтрокаПартии = ВыборкаПартии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
				Пока ВыборкаСтрокаПартии.Следующий() Цикл 
					
					Выборка = ВыборкаСтрокаПартии.Выбрать();  
					НомерЗаписи = 1;
					Пока Выборка.Следующий() Цикл 
						Если НомерЗаписи = 1 Тогда 
							ЗаполнитьЗначенияСвойств(ОбластьДанные.Параметры, Выборка);
							
							Котировка = Выборка.Котировка;
							ДатаКотировки = Выборка.ДатаКотировки;
							Если Выборка.УчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО 
								И Выборка.Котировка = 0 И Выборка.КоличествоКонец > 0 Тогда 
								Котировка = Выборка.СтоимостьКонец/Выборка.КоличествоКонец;
								ОбластьДанные.Параметры.Котировка = Котировка;
								ДатаКотировки = ЭтотОбъект.Период.ДатаОкончания;
							КонецЕсли;	
							
							ДюрацияИДоходность =  Неопределено;
							Если ТипЗнч(Выборка.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")  	
								И Котировка > 0 
								И Выборка.УчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО Тогда
								Попытка 
									ДюрацияИДоходность = Справочники.Облигации.ПолучитьДоходностьИДюрацию(Выборка.ЦеннаяБумага, Ложь, Выборка.ДатаПартии, Котировка, ЭтотОбъект.СчетДоверительногоУправления, Неопределено, ДатаКотировки); 
								Исключение 
									//  разобраться почему не считает по некоторым бумаг. разница настроек учета ЕПС и оценки 
								КонецПопытки;	
							КонецЕсли;	
							Если НЕ ДюрацияИДоходность = Неопределено Тогда
								//	ОбластьДанные.Параметры.Дюрация = Окр(ДюрацияИДоходность.Дюрация/365, 4);
								ОбластьДанные.Параметры.ДоходностьКПогашению = Окр(ДюрацияИДоходность.Доходность, 2);
							Иначе 	
								//	ОбластьДанные.Параметры.Дюрация = 0;
								ОбластьДанные.Параметры.ДоходностьКПогашению = 0;			
							КонецЕсли; 
							ДокументРезультат.Вывести(ОбластьДанные);
							
							СтоимостьПокупкиКупон = СтоимостьПокупкиКупон + Выборка.СтоимостьПокупкиКупон;	
							ПереоценкаНачало = ПереоценкаНачало  + Выборка.ПереоценкаНачало;	
							СтоимостьПокупки = СтоимостьПокупки  + Выборка.СтоимостьПокупки;					
							СтоимостьПокупкиКупонПериод = СтоимостьПокупкиКупонПериод + Выборка.СтоимостьПокупкиКупонПериод;	
							СтоимостьПокупкиПериод = СтоимостьПокупкиПериод + Выборка.СтоимостьПокупкиПериод;					
							КупонПродажа = КупонПродажа + Выборка.КупонПродажа;	
							ПереоценкаПродажа = ПереоценкаПродажа + Выборка.ПереоценкаПродажа;	
							СтоимостьПродажа = СтоимостьПродажа + Выборка.СтоимостьПродажа;				
							СтоимостьКупонаКонец = СтоимостьКупонаКонец + Выборка.СтоимостьКупонаКонец;	
							ПереоценкаКонец = ПереоценкаКонец + Выборка.ПереоценкаКонец;	
							СтоимостьКонец = СтоимостьКонец + Выборка.СтоимостьКонец;
							
						Иначе
							ЗаполнитьЗначенияСвойств(ОбластьДанныеПродажа.Параметры, Выборка);	
							ДокументРезультат.Вывести(ОбластьДанныеПродажа);
						КонецЕсли;					
						НомерЗаписи = НомерЗаписи + 1;
					КонецЦикла;
