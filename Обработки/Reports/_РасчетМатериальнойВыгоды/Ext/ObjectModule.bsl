Процедура ВыводРаздела(Выборка, Раздел, Отчет, ДокументРезультат)
	
	Отчет = ПолучитьМакет("Отчет");
	
	ОбластьШапка = Отчет.ПолучитьОбласть("ШапкаММВБ");
	ОбластьРаздел = Отчет.ПолучитьОбласть("Раздел");
	ОбластьВидДоговора = Отчет.ПолучитьОбласть("ГрВидДоговора");
	ОбластьСчетДУ = Отчет.ПолучитьОбласть("ГрСчетДУ");
	ОбластьСтрока = Отчет.ПолучитьОбласть("Строка");
	
	Если Раздел = 1 Тогда
		ОбластьРаздел.Параметры.НазваниеРаздела = "Ценные бумаги, обращаемые на ММВБ-РТС";
	ИначеЕсли Раздел = 2 Тогда 
		ОбластьРаздел.Параметры.НазваниеРаздела = "Ценные бумаги, обращаемые на иностранных биржах";
	ИначеЕсли Раздел = 3 Тогда 	
		ОбластьРаздел.Параметры.НазваниеРаздела = "Необращаемые ценные бумаги";
	КонецЕсли;	
	
	ДокументРезультат.Вывести(ОбластьРаздел);
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Пока Выборка.Следующий() Цикл 
		ОбластьВидДоговора.Параметры.ВидДоговора = Выборка.ВидДоговора;
		ДокументРезультат.Вывести(ОбластьВидДоговора);
		
		ДокументРезультат.НачатьГруппуСтрок();
		ВыборкаСчетДУ = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетДУ.Следующий() Цикл 
			
			ОбластьСчетДУ.Параметры.СчетДоверительногоУправления = ВыборкаСчетДУ.СчетДоверительногоУправления;
			ДокументРезультат.Вывести(ОбластьСчетДУ);
			
			
			ДокументРезультат.НачатьГруппуСтрок();
			ВыборкаСделка = ВыборкаСчетДУ.Выбрать();
			Пока ВыборкаСделка.Следующий() Цикл 
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаСделка);
				ДокументРезультат.Вывести(ОбластьСтрока);
				
			КонецЦикла;
			ДокументРезультат.ЗакончитьГруппуСтрок();
		КонецЦикла;
		ДокументРезультат.ЗакончитьГруппуСтрок();
	КонецЦикла;	
		
КонецПроцедуры

Процедура Сформировать(ДокументРезультат, ТолькоРазницу) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДУ");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	ДокументРезультат.Очистить();
	Отчет = ПолучитьМакет("Отчет");
	
	МВР = Новый МенеджерВременныхТаблиц;
	
	// 1) Обращаемые на ММВБ
	// Выбрем все бумаги. для внебиржи, если режим торгов не задан, подставим подходщий
	// Ищем котировки только на ММВБ
	
	Выборка = ВыборкаДанныхММВБ(МВР, ТолькоРазницу);
	Если Выборка.Количество()>0 Тогда 
		ВыводРаздела(Выборка, 1, Отчет, ДокументРезультат);
	КонецЕсли;	
		
	// 2) Для бумаг без котировок ММВБ ищес котировки на иностранных биржах
	Выборка = ВыборкаДанныхБлумберг(МВР, ТолькоРазницу);
	Если Выборка.Количество()>0 Тогда 
		ВыводРаздела(Выборка, 2, Отчет, ДокументРезультат);
	КонецЕсли;	
	
	// Необращаемые ценные бумаги
	Выборка = ВыборкаДанныхНеобращаемые(МВР);
	Если Выборка.Количество()>0 Тогда 
		ВыводРаздела(Выборка, 3, Отчет, ДокументРезультат);	
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры	