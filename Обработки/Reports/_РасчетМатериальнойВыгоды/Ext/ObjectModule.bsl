
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет, 
		"Расчет материальной выгоды для НДФЛ (черновик)", 
		"0.05", 
		"", 
		Истина,);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ВыборкаДанныхММВБ(МВР, ТолькоРазницу)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВР;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(СделкаЦенныеБумаги.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
	|	СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	СделкаЦенныеБумаги.Ссылка КАК ДокументСделка,
	|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СделкаЦенныеБумаги.Цена КАК Цена,
	|	СделкаЦенныеБумаги.Количество КАК Количество,
	|	СделкаЦенныеБумаги.Сумма КАК Сумма,
	|	СделкаЦенныеБумаги.Ссылка.ВалютаСделки КАК ВалютаСделки,
	|	ВЫБОР
	|		КОГДА СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов = ЗНАЧЕНИЕ(Справочник.РежимыБиржевыхТоргов.ПустаяСсылка)
	|				И СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
	|			ТОГДА &Т0Облигации
	|		КОГДА СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов = ЗНАЧЕНИЕ(Справочник.РежимыБиржевыхТоргов.ПустаяСсылка)
	|				И СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
	|			ТОГДА &Паи
	|		ИНАЧЕ СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов
	|	КОНЕЦ КАК РежимБиржевыхТоргов
	|ПОМЕСТИТЬ _Покупки
	|ИЗ
	|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
	|ГДЕ
	|	СделкаЦенныеБумаги.Ссылка.Организация = &Организация
	|	И СделкаЦенныеБумаги.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И СделкаЦенныеБумаги.Ссылка.Проведен = ИСТИНА
	|	И СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
	|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица))
	|	И СделкаЦенныеБумаги.Ссылка.Рынок <> ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы)
	|	И (СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов.ОсновнойРежим = ИСТИНА
	|			ИЛИ СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов.ТПлюс = ИСТИНА
	|			ИЛИ СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов = ЗНАЧЕНИЕ(Справочник.РежимыБиржевыхТоргов.ПустаяСсылка))";
	
	Если ЗначениеЗаполнено(СчетДУ) Тогда 
		Запрос.Текст = 	Запрос.Текст + "
		|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДУ";
		
	КонецЕсли;
	
	Запрос.Текст = 	Запрос.Текст + "		
	|;";
	
	Запрос.Текст = 	Запрос.Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               	               |	_Покупки.ЦеннаяБумага КАК ЦеннаяБумага
	               	               |ПОМЕСТИТЬ _ЦенныеБумаги
	               	               |ИЗ
	               	               |	_Покупки КАК _Покупки
	               	               |;
	               	               |
	               	               |////////////////////////////////////////////////////////////////////////////////
	               	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               	               |	КотировкиТорговыхПлощадокСводные.ЦеннаяБумага КАК ЦеннаяБумага,
	               	               |	КотировкиТорговыхПлощадокСводные.Валюта КАК Валюта,
	               	               |	КотировкиТорговыхПлощадокСводные.WAPRICE КАК WAPRICE,
	               	               |	КотировкиТорговыхПлощадокСводные.WAPRICE_DATE КАК WAPRICE_DATE,
	               	               |	КотировкиТорговыхПлощадокСводные.HIGH КАК HIGH,
	               	               |	КотировкиТорговыхПлощадокСводные.HIGH_DATE КАК HIGH_DATE,
	               	               |	КотировкиТорговыхПлощадокСводные.LOW КАК LOW,
	               	               |	КотировкиТорговыхПлощадокСводные.LOW_DATE КАК LOW_DATE,
	               	               |	КотировкиТорговыхПлощадокСводные.Биржа КАК Биржа,
	               	               |	КотировкиТорговыхПлощадокСводные.РежимТоргов КАК РежимТоргов
	               	               |ПОМЕСТИТЬ _Котировки
	               	               |ИЗ
	               	               |	РегистрСведений.КотировкиТорговыхПлощадокСводные КАК КотировкиТорговыхПлощадокСводные
	               	               |ГДЕ
	               	               |	КотировкиТорговыхПлощадокСводные.Период МЕЖДУ &ДатаНачала И &ДатаКонца
	               	               |	И КотировкиТорговыхПлощадокСводные.WAPRICE <> 0
	               	               |	И (КотировкиТорговыхПлощадокСводные.РежимТоргов.ОсновнойРежим = ИСТИНА
	               	               |			ИЛИ КотировкиТорговыхПлощадокСводные.РежимТоргов.ТПлюс = ИСТИНА)
	               	               |	И КотировкиТорговыхПлощадокСводные.ЦеннаяБумага В
	               	               |			(ВЫБРАТЬ
	               	               |				_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
	               	               |			ИЗ
	               	               |				_ЦенныеБумаги КАК _ЦенныеБумаги)
	               	               |	И КотировкиТорговыхПлощадокСводные.Биржа = &ММВБ
	               	               |
	               	               |ОБЪЕДИНИТЬ
	               	               |
	               	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.WAPRICE_DATE,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.HIGH,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.HIGH_DATE,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.LOW,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.LOW_DATE,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа,
	               	               |	КотировкиТорговыхПлощадокСводныеСрезПоследних.РежимТоргов
	               	               |ИЗ
	               	               |	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	               	               |			&ДатаНачала,
	               	               |			ЦеннаяБумага В
	               	               |					(ВЫБРАТЬ
	               	               |						_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
	               	               |					ИЗ
	               	               |						_ЦенныеБумаги КАК _ЦенныеБумаги)
	               	               |				И WAPRICE > 0
	               	               |				И WAPRICE_DATE > ДОБАВИТЬКДАТЕ(&ДатаНачала, МЕСЯЦ, -3)
	               	               |				И (РежимТоргов.ОсновнойРежим = ИСТИНА
	               	               |					ИЛИ РежимТоргов.ТПлюс = ИСТИНА)) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
	               	               |;
	               	               |
	               	               |////////////////////////////////////////////////////////////////////////////////
	               	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               	               |	_Покупки.ЦеннаяБумага КАК ЦеннаяБумага,
	               	               |	_Покупки.Дата КАК Дата,
	               	               |	_Котировки.Валюта КАК Валюта,
	               	               |	_Котировки.РежимТоргов КАК РежимТоргов,
	               	               |	МАКСИМУМ(_Котировки.WAPRICE_DATE) КАК WAPRICE_DATE
	               	               |ПОМЕСТИТЬ _ДатыКотировок
	               	               |ИЗ
	               	               |	_Покупки КАК _Покупки
	               	               |		ЛЕВОЕ СОЕДИНЕНИЕ _Котировки КАК _Котировки
	               	               |		ПО _Покупки.ЦеннаяБумага = _Котировки.ЦеннаяБумага
	               	               |			И _Покупки.Дата >= _Котировки.WAPRICE_DATE
	               	               |			И (_Котировки.Валюта = _Покупки.ВалютаСделки)
	               	               |			И (_Котировки.РежимТоргов = _Покупки.РежимБиржевыхТоргов)
	               	               |
	               	               |СГРУППИРОВАТЬ ПО
	               	               |	_Покупки.ЦеннаяБумага,
	               	               |	_Покупки.Дата,
	               	               |	_Котировки.Валюта,
	               	               |	_Котировки.РежимТоргов
	               	               |;
	               	               |
	               	               |////////////////////////////////////////////////////////////////////////////////
	               	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               	               |	_Покупки.ЦеннаяБумага КАК ЦеннаяБумага,
	               	               |	_Покупки.Дата КАК Дата,
	               	               |	МАКСИМУМ(НоминалыЦенныхБумаг.Период) КАК ДатаНоминала
	               	               |ПОМЕСТИТЬ _ДатыНоминалов
	               	               |ИЗ
	               	               |	_Покупки КАК _Покупки
	               	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
	               	               |		ПО _Покупки.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
	               	               |
	               	               |СГРУППИРОВАТЬ ПО
	               	               |	_Покупки.ЦеннаяБумага,
	               	               |	_Покупки.Дата
	               	               |;
	               	               |
	               	               |////////////////////////////////////////////////////////////////////////////////
	               	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               	               |	_Покупки.Дата КАК Дата,
	               	               |	_Покупки.ВидДоговора КАК ВидДоговора,
	               	               |	_Покупки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	               	               |	_Покупки.ДокументСделка КАК ДокументСделка,
	               	               |	_Покупки.ЦеннаяБумага КАК ЦеннаяБумага,
	               	               |	_Покупки.Цена КАК Цена,
	               	               |	_Покупки.Количество КАК Количество,
	               	               |	_Покупки.Сумма КАК Сумма,
	               	               |	_Покупки.ВалютаСделки КАК ВалютаСделки,
	               	               |	_Покупки.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
	               	               |	НоминалыЦенныхБумаг.Номинал КАК Номинал,
	               	               |	_Котировки.Валюта КАК ВалютаКотировки,
	               	               |	_Котировки.WAPRICE_DATE КАК WAPRICE_DATE,
	               	               |	_Котировки.РежимТоргов КАК РежимТоргов,
	               	               |	_Котировки.WAPRICE КАК WAPRICE,
	               	               |	_Котировки.HIGH КАК HIGH,
	               	               |	_Котировки.LOW КАК LOW,
	               	               |	ВЫБОР
	               	               |		КОГДА ТИПЗНАЧЕНИЯ(_Покупки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	               	               |			ТОГДА _Котировки.WAPRICE * НоминалыЦенныхБумаг.Номинал / 100
	               	               |		ИНАЧЕ _Котировки.WAPRICE
	               	               |	КОНЕЦ КАК Средневзвешенная,
	               	               |	ВЫБОР
	               	               |		КОГДА ТИПЗНАЧЕНИЯ(_Покупки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	               	               |			ТОГДА _Котировки.HIGH * НоминалыЦенныхБумаг.Номинал / 100
	               	               |		ИНАЧЕ _Котировки.HIGH
	               	               |	КОНЕЦ КАК Максимальная,
	               	               |	ВЫБОР
	               	               |		КОГДА ТИПЗНАЧЕНИЯ(_Покупки.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	               	               |			ТОГДА _Котировки.LOW * НоминалыЦенныхБумаг.Номинал / 100
	               	               |		ИНАЧЕ _Котировки.LOW
	               	               |	КОНЕЦ КАК Минимальная,
	               	               |	ВЫБОР
	               	               |		КОГДА _Котировки.WAPRICE ЕСТЬ NULL
	               	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
	               	               |		КОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(_Котировки.WAPRICE_DATE, ДАТАВРЕМЯ(2000, 1, 1)), _Покупки.Дата, МЕСЯЦ) > 3
	               	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
	               	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
	               	               |	КОНЕЦ КАК ОбращаетсяНаОРЦБ
	               	               |ПОМЕСТИТЬ _Шихта
	               	               |ИЗ
	               	               |	_Покупки КАК _Покупки
	               	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыКотировок КАК _ДатыКотировок
	               	               |			ЛЕВОЕ СОЕДИНЕНИЕ _Котировки КАК _Котировки
	               	               |			ПО _ДатыКотировок.ЦеннаяБумага = _Котировки.ЦеннаяБумага
	               	               |				И _ДатыКотировок.WAPRICE_DATE = _Котировки.WAPRICE_DATE
	               	               |				И _ДатыКотировок.Валюта = _Котировки.Валюта
	               	               |				И _ДатыКотировок.ЦеннаяБумага = _Котировки.ЦеннаяБумага
	               	               |				И _ДатыКотировок.РежимТоргов = _Котировки.РежимТоргов
	               	               |		ПО _Покупки.ЦеннаяБумага = _ДатыКотировок.ЦеннаяБумага
	               	               |			И _Покупки.Дата = _ДатыКотировок.Дата
	               	               |			И (_Покупки.ВалютаСделки = _Котировки.Валюта)
	               	               |			И (_Покупки.РежимБиржевыхТоргов = _Котировки.РежимТоргов)
	               	               |		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыНоминалов КАК _ДатыНоминалов
	               	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг КАК НоминалыЦенныхБумаг
	               	               |			ПО _ДатыНоминалов.ЦеннаяБумага = НоминалыЦенныхБумаг.ЦеннаяБумага
	               	               |				И _ДатыНоминалов.ДатаНоминала = НоминалыЦенныхБумаг.Период
	               	               |		ПО _Покупки.ЦеннаяБумага = _ДатыНоминалов.ЦеннаяБумага
	               	               |			И _Покупки.Дата = _ДатыНоминалов.Дата
	               	               |;
	               	               |
	               	               |////////////////////////////////////////////////////////////////////////////////
	               	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               	               |	_Шихта.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	               	               |	_Шихта.Дата КАК Дата,
	               	               |	_Шихта.ВидДоговора КАК ВидДоговора,
	               	               |	_Шихта.ДокументСделка КАК ДокументСделка,
	               	               |	_Шихта.ЦеннаяБумага КАК ЦеннаяБумага,
	               	               |	_Шихта.Цена КАК Цена,
	               	               |	_Шихта.Количество КАК Количество,
	               	               |	_Шихта.Сумма КАК Сумма,
	               	               |	_Шихта.ВалютаСделки КАК ВалютаСделки,
	               	               |	_Шихта.РежимБиржевыхТоргов КАК РежимБиржевыхТоргов,
	               	               |	_Шихта.WAPRICE КАК WAPRICE,
	               	               |	_Шихта.Номинал КАК Номинал,
	               	               |	_Шихта.ВалютаКотировки КАК ВалютаКотировки,
	               	               |	_Шихта.Средневзвешенная КАК Средневзвешенная,
	               	               |	_Шихта.Минимальная КАК Минимальная,
	               	               |	_Шихта.Максимальная КАК Максимальная,
	               	               |	_Шихта.ОбращаетсяНаОРЦБ КАК ОбращаетсяНаОРЦБ,
	               	               |	ВЫБОР
	               	               |		КОГДА _Шихта.Цена < _Шихта.Минимальная
	               	               |			ТОГДА (_Шихта.Минимальная - _Шихта.Цена) * _Шихта.Количество
	               	               |		ИНАЧЕ 0
	               	               |	КОНЕЦ КАК МатВыгода
	               	               |ИЗ
	               	               |	_Шихта КАК _Шихта
	               	               |ГДЕ
	               	               |	_Шихта.ОбращаетсяНаОРЦБ = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
	               	               |	И (&ТолькоРазницу = ИСТИНА
	               	               |				И _Шихта.Минимальная - _Шихта.Цена > 0
	               	               |			ИЛИ &ТолькоРазницу = ЛОЖЬ)
	               	               |
	               	               |СГРУППИРОВАТЬ ПО
	               	               |	_Шихта.Дата,
	               	               |	_Шихта.ВидДоговора,
	               	               |	_Шихта.СчетДоверительногоУправления,
	               	               |	_Шихта.ДокументСделка,
	               	               |	_Шихта.ЦеннаяБумага,
	               	               |	_Шихта.Цена,
	               	               |	_Шихта.Количество,
	               	               |	_Шихта.Сумма,
	               	               |	_Шихта.ВалютаСделки,
	               	               |	_Шихта.РежимБиржевыхТоргов,
	               	               |	_Шихта.WAPRICE,
	               	               |	_Шихта.Номинал,
	               	               |	_Шихта.ВалютаКотировки,
	               	               |	_Шихта.Средневзвешенная,
	               	               |	_Шихта.Минимальная,
	               	               |	_Шихта.Максимальная,
	               	               |	_Шихта.ОбращаетсяНаОРЦБ
	               	               |
	               	               |УПОРЯДОЧИТЬ ПО
	               	               |	ДокументСделка
	               	               |ИТОГИ
	               	               |	СУММА(МатВыгода)
	               	               |ПО
	               	               |	ВидДоговора,
	               	               |	СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТолькоРазницу", ТолькоРазницу);
	Запрос.УстановитьПараметр("Т0Облигации", Справочники.РежимыБиржевыхТоргов.НайтиПоКоду("EQOB"));
	Запрос.УстановитьПараметр("Паи", Справочники.РежимыБиржевыхТоргов.НайтиПоКоду("TQIF"));
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Если ЗначениеЗаполнено(СчетДУ) Тогда 
		Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	КонецЕсли;	
	
	//Запросы
	// _Покупки    			- все сделки, ИИС, физлица. Для внебиржи режимы торгов заполняются подходящим значение 
	// _ЦенныеБумаги        - все ЦБ из предыдущей таблицы. 
	// _Котировки			- 
	// _ДатыКотировки       - Определяем котировки на даты покупок
	// _ДатыНоминалов       - Для облигаций надо знать номинал
	// _Шихта				- Сводная таблица из всех предыдущих. Пригодится в следующих запросах
	// Результат 			- 
	
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат Выборка;
	
КонецФункции	

Функция ВыборкаДанныхБлумберг(МВР, ТолькоРазницу)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВР;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	_Шихта.ЦеннаяБумага КАК ЦеннаяБумага
	|ПОМЕСТИТЬ _ЦенныеБумаги2
	|ИЗ
	|	_Шихта КАК _Шихта
	|ГДЕ
	|	_Шихта.ОбращаетсяНаОРЦБ = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Шихта.Дата КАК Дата,
	|	_Шихта.ВидДоговора КАК ВидДоговора,
	|	_Шихта.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_Шихта.ДокументСделка КАК ДокументСделка,
	|	_Шихта.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Шихта.Цена КАК Цена,
	|	_Шихта.Количество КАК Количество,
	|	_Шихта.Сумма КАК Сумма,
	|	_Шихта.ВалютаСделки КАК ВалютаСделки,
	|	_Шихта.Номинал КАК Номинал,
	|	_Шихта.ЦеннаяБумага.ВалютаНоминала КАК ВалютаНоминала,
	|	КурсыВалют.Курс КАК Курс,
	|	КурсыВалют.Кратность КАК Кратность,
	|	ВЫБОР
	|		КОГДА _Шихта.ЦеннаяБумага.ВалютаНоминала <> _Шихта.ВалютаСделки
	|			ТОГДА _Шихта.Цена / КурсыВалют.Курс * КурсыВалют.Кратность
	|		ИНАЧЕ _Шихта.Цена
	|	КОНЕЦ КАК ЦенаВал
	|ПОМЕСТИТЬ _Покупки2
	|ИЗ
	|	_Шихта КАК _Шихта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
	|		ПО _Шихта.ЦеннаяБумага.ВалютаНоминала = КурсыВалют.Валюта
	|			И _Шихта.Дата = КурсыВалют.Период
	|ГДЕ
	|	_Шихта.ОбращаетсяНаОРЦБ = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КотировкиТорговыхПлощадокСводные.ЦеннаяБумага КАК ЦеннаяБумага,
	|	КотировкиТорговыхПлощадокСводные.Валюта КАК Валюта,
	|	МИНИМУМ(КотировкиТорговыхПлощадокСводные.CLOSE) КАК CLOSE,
	|	КотировкиТорговыхПлощадокСводные.CLOSE_DATE КАК CLOSE_DATE,
	|	КотировкиТорговыхПлощадокСводные.HIGH КАК HIGH,
	|	КотировкиТорговыхПлощадокСводные.HIGH_DATE КАК HIGH_DATE,
	|	КотировкиТорговыхПлощадокСводные.LOW КАК LOW,
	|	КотировкиТорговыхПлощадокСводные.LOW_DATE КАК LOW_DATE,
	|	КотировкиТорговыхПлощадокСводные.Биржа КАК Биржа
	|ПОМЕСТИТЬ _КотировкиБлумберг
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные КАК КотировкиТорговыхПлощадокСводные
	|ГДЕ
	|	КотировкиТорговыхПлощадокСводные.Период МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И КотировкиТорговыхПлощадокСводные.CLOSE <> 0
	|	И КотировкиТорговыхПлощадокСводные.ЦеннаяБумага В
	|			(ВЫБРАТЬ
	|				_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
	|			ИЗ
	|				_ЦенныеБумаги2 КАК _ЦенныеБумаги)
	|	И КотировкиТорговыхПлощадокСводные.Биржа <> &ММВБ
	|
	|СГРУППИРОВАТЬ ПО
	|	КотировкиТорговыхПлощадокСводные.ЦеннаяБумага,
	|	КотировкиТорговыхПлощадокСводные.Валюта,
	|	КотировкиТорговыхПлощадокСводные.CLOSE_DATE,
	|	КотировкиТорговыхПлощадокСводные.HIGH,
	|	КотировкиТорговыхПлощадокСводные.HIGH_DATE,
	|	КотировкиТорговыхПлощадокСводные.LOW,
	|	КотировкиТорговыхПлощадокСводные.LOW_DATE,
	|	КотировкиТорговыхПлощадокСводные.Биржа
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта,
	|	СУММА(КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE),
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.HIGH,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.HIGH_DATE,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LOW,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LOW_DATE,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
	|ИЗ
	|	РегистрСведений.КотировкиТорговыхПлощадокСводные.СрезПоследних(
	|			&ДатаНачала,
	|			ЦеннаяБумага В
	|					(ВЫБРАТЬ
	|						_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
	|					ИЗ
	|						_ЦенныеБумаги2 КАК _ЦенныеБумаги)
	|				И CLOSE > 0
	|				И CLOSE_DATE > ДОБАВИТЬКДАТЕ(&ДатаНачала, МЕСЯЦ, -3)
	|				И Биржа <> &ММВБ) КАК КотировкиТорговыхПлощадокСводныеСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.ЦеннаяБумага,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Валюта,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.CLOSE_DATE,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.HIGH,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.HIGH_DATE,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LOW,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.LOW_DATE,
	|	КотировкиТорговыхПлощадокСводныеСрезПоследних.Биржа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Покупки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Покупки.Дата КАК Дата,
	|	_Котировки.Валюта КАК Валюта,
	|	_Котировки.Биржа КАК Биржа,
	|	МАКСИМУМ(_Котировки.CLOSE_DATE) КАК CLOSE_DATE
	|ПОМЕСТИТЬ _ДатыКотировокБлумберг
	|ИЗ
	|	_Покупки2 КАК _Покупки
	|		ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиБлумберг КАК _Котировки
	|		ПО _Покупки.ЦеннаяБумага = _Котировки.ЦеннаяБумага
	|			И _Покупки.Дата >= _Котировки.CLOSE_DATE
	|			И (_Котировки.Валюта = _Покупки.ВалютаНоминала)
	|
	|СГРУППИРОВАТЬ ПО
	|	_Покупки.ЦеннаяБумага,
	|	_Покупки.Дата,
	|	_Котировки.Валюта,
	|	_Котировки.Биржа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Покупки2.Дата КАК Дата,
	|	_Покупки2.ВидДоговора КАК ВидДоговора,
	|	_Покупки2.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_Покупки2.ДокументСделка КАК ДокументСделка,
	|	_Покупки2.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Покупки2.ВалютаСделки КАК ВалютаСделки,
	|	_Покупки2.ВалютаНоминала КАК ВалютаНоминала,
	|	_Покупки2.Цена КАК Цена,
	|	_Покупки2.Количество КАК Количество,
	|	_Покупки2.ЦенаВал КАК ЦенаВал,
	|	_КотировкиБлумберг.CLOSE КАК CLOSE,
	|	_КотировкиБлумберг.CLOSE_DATE КАК CLOSE_DATE,
	|	_КотировкиБлумберг.HIGH КАК HIGH,
	|	_КотировкиБлумберг.HIGH_DATE КАК HIGH_DATE,
	|	_КотировкиБлумберг.LOW КАК LOW,
	|	_КотировкиБлумберг.LOW_DATE КАК LOW_DATE,
	|	_КотировкиБлумберг.Биржа КАК Биржа,
	|	_Покупки2.Номинал КАК Номинал,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_Покупки2.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА _КотировкиБлумберг.CLOSE * _Покупки2.Номинал / 100
	|		ИНАЧЕ _КотировкиБлумберг.CLOSE
	|	КОНЕЦ КАК Средневзвешенная,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_Покупки2.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА _КотировкиБлумберг.LOW * _Покупки2.Номинал / 100
	|		ИНАЧЕ _КотировкиБлумберг.LOW
	|	КОНЕЦ КАК Минимальная,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_Покупки2.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА _КотировкиБлумберг.HIGH * _Покупки2.Номинал / 100
	|		ИНАЧЕ _КотировкиБлумберг.HIGH
	|	КОНЕЦ КАК Максимальная,
	|	ВЫБОР
	|		КОГДА _КотировкиБлумберг.CLOSE ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
	|		КОГДА РАЗНОСТЬДАТ(ЕСТЬNULL(_КотировкиБлумберг.CLOSE_DATE, ДАТАВРЕМЯ(2000, 1, 1)), _Покупки2.Дата, МЕСЯЦ) > 3
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.НеОбращается)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
	|	КОНЕЦ КАК ОбращаетсяНаОРЦБ,
	|	_КотировкиБлумберг.Валюта КАК ВалютаКотировки
	|ПОМЕСТИТЬ _Шихта2
	|ИЗ
	|	_Покупки2 КАК _Покупки2
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыКотировокБлумберг КАК _ДатыКотировокБлумберг
	|			ЛЕВОЕ СОЕДИНЕНИЕ _КотировкиБлумберг КАК _КотировкиБлумберг
	|			ПО _ДатыКотировокБлумберг.ЦеннаяБумага = _КотировкиБлумберг.ЦеннаяБумага
	|				И _ДатыКотировокБлумберг.CLOSE_DATE = _КотировкиБлумберг.CLOSE_DATE
	|				И _ДатыКотировокБлумберг.Валюта = _КотировкиБлумберг.Валюта
	|		ПО _Покупки2.ЦеннаяБумага = _ДатыКотировокБлумберг.ЦеннаяБумага
	|			И _Покупки2.Дата = _ДатыКотировокБлумберг.Дата
	|			И _Покупки2.ВалютаНоминала = _ДатыКотировокБлумберг.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Шихта2.Дата КАК Дата,
	|	_Шихта2.ВидДоговора КАК ВидДоговора,
	|	_Шихта2.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_Шихта2.ДокументСделка КАК ДокументСделка,
	|	_Шихта2.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Шихта2.ЦенаВал КАК ЦенаВал,
	|	_Шихта2.ВалютаСделки КАК ВалютаСделки,
	|	_Шихта2.Цена КАК Цена,
	|	_Шихта2.ВалютаНоминала КАК ВалютаНоминала,
	|	_Шихта2.Средневзвешенная КАК Средневзвешенная,
	|	_Шихта2.Минимальная КАК Минимальная,
	|	_Шихта2.Максимальная КАК Максимальная,
	|	ВЫБОР
	|		КОГДА _Шихта2.Средневзвешенная - _Шихта2.ЦенаВал > 0
	|			ТОГДА (_Шихта2.Средневзвешенная - _Шихта2.ЦенаВал) * _Шихта2.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК МатВыгода,
	|	_Шихта2.Количество КАК Количество,
	|	_Шихта2.ВалютаКотировки КАК ВалютаКотировки
	|ИЗ
	|	_Шихта2 КАК _Шихта2
	|ГДЕ
	|	_Шихта2.ОбращаетсяНаОРЦБ = ЗНАЧЕНИЕ(Перечисление.ВидыОбращенияНаОРЦБ.Обращается)
	|	И (&ТолькоРазницу = ИСТИНА
	|				И _Шихта2.Средневзвешенная - _Шихта2.Цена > 0
	|			ИЛИ &ТолькоРазницу = ЛОЖЬ)
	|ИТОГИ
	|	СУММА(МатВыгода)
	|ПО
	|	ВидДоговора,
	|	СчетДоверительногоУправления";
	
	//Запросы
	// _ЦенныеБумаги2       - ЦБ по которым на ММВБ не нашли котировку
	// _Покупки2    		- все сделки по необращаемым из  таблицы Шихта
	// _КотировкиБлумберг	- берем не только лишь все, а минимум по CLOSE, т.к. бирж может быть несколько
	//						(когда будет закачиваться LOW, переделать) 
	// _ДатыКотировокБлумберг - Определяем котировки на даты покупок
	// _Шихта2				- Сводная таблица из всех предыдущих, по аналонии с запросом к ММВБ
	// Результат 			- 
	
//	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКонца", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТолькоРазницу", ТолькоРазницу);
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат Выборка;
	
	
КонецФункции	

Функция ВыборкаДанныхНеобращаемые(МВР)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВР;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Шихта2.Дата КАК Дата,
	|	_Шихта2.ВидДоговора КАК ВидДоговора,
	|	_Шихта2.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	_Шихта2.ДокументСделка КАК ДокументСделка,
	|	_Шихта2.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Шихта2.ВалютаСделки КАК ВалютаСделки,
