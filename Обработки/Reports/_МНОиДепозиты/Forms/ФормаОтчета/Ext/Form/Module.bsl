#Область События_Формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Отчет.Организация			= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Отчет.Период.ДатаНачала 	= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	Отчет.Период.ДатаОкончания 	= КонецДня(Отчет.Период.ДатаНачала);
	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);
		
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
	ТекНастройки = Неопределено;
	Параметры.Свойство("НастройкиОтчета", ТекНастройки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ОбновитьЭлементыПослеИзменения();
	
КонецПроцедуры

#КонецОбласти

#Область События_Элементов_Формы

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ОбновитьЭлементыПослеИзменения(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ОбновитьЭлементыПослеИзменения(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_Процедуры_и_Функции

&НаКлиенте
Процедура ОбновитьЭлементыПослеИзменения(УстановитьНеактуальность = Ложь)
	
	Отчет.КлючТекущегоВарианта = КлючТекущегоВарианта;
	
	Если УстановитьНеактуальность Тогда
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	КонецЕсли;
		
	Элементы.Результат.ИспользуемоеИмяФайла = КлючТекущегоВарианта + " на " + Формат(Отчет.Период.ДатаОкончания, "ДЛФ=D") + "_" + Отчет.СчетДоверительногоУправления + ".xlsx";
	
КонецПроцедуры

&НаКлиенте
Процедура КлючТекущегоВариантаПриИзменении(Элемент)
	
	КлючТекущегоВарианта = Отчет.КлючТекущегоВарианта;
	ОбновитьЭлементыПослеИзменения(Истина);
	
КонецПроцедуры

#КонецОбласти