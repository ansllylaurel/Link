Процедура СформироватьОтчет(ДокументРезультат, ДокументРасшифровка)  Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьОтчет()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДокументРезультат.Очистить();
	ДокументРасшифровка.Очистить();
	
	ТабОтчета = СчитатьТабличныйДокументВТаблицуЗначений("Настройка", "Загл", "Шаблон", "Колонки");			
	// 1 часть отчета. Активы
	// Распределяем ценные бумаги
	
	Выборка = ЗапросАктивы();
	Пока Выборка.Следующий() Цикл 
		Распределить(ТабОтчета, Выборка);
	КонецЦикла;	
	
	
	// дебиторка
	Выборка = ЗапросДебет();
	Пока Выборка.Следующий() Цикл 
		РаспределитьДебет(ТабОтчета, Выборка);
	КонецЦикла;		
	
	//вывод отчета 
	Отчет = ПолучитьМакет("Отчет");
	
	ОбластьЗаголовок = Отчет.ПолучитьОбласть("Заголовок");
	
	ПараметрыШапки = ПолучитьПараметрыШапки();	
	ОбластьЗаголовок.Параметры.Заполнить(ПараметрыШапки);
	ОбластьЗаголовок.Параметры.ДатаПодписиОтчета = ТекущаяДата();
	
	ДокументРезультат.Вывести(ОбластьЗаголовок);
	
	
	ОбластьШапка = Отчет.ПолучитьОбласть("ШапкаДоходы");
	ДокументРезультат.Вывести(ОбластьШапка);
	
	РасчетКолонок6_8(ТабОтчета, 1);
	ОбластьСтрока = Отчет.ПолучитьОбласть("Строка");	
	ВыводОтчета(ТабОтчета, ОбластьСтрока, ДокументРезультат);	
	
	
	// 2 часть отчета
	// доходы-расходы
	ТабОтчета = СчитатьТабличныйДокументВТаблицуЗначений("Настройка", "Загл", "Шаблон2", "Колонки");
	
	ОбластьШапка = Отчет.ПолучитьОбласть("ШапкаРасходы");
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ШаблонРасшифровка = СчитатьТабличныйДокументВТаблицуЗначений("Настройка", "ЗаглДиР", "ШаблонДиР", "КолонкиДР");
	
	ДопНомер = 220;
	Выборка = ЗапросДоходыРасходы();
	Пока Выборка.Следующий() Цикл 
		РаспределитьДоходыРасходы(ТабОтчета, Выборка, ШаблонРасшифровка, ДопНомер);
		ДопНомер = ДопНомер + 1;
	КонецЦикла;		
	
	РасчетКолонок6_8(ТабОтчета, 2);
	ВыводОтчета(ТабОтчета, ОбластьСтрока, ДокументРезультат);	
	
	
	// Подписи		
	//СтруктураКлюча = Новый Структура;
	//СтруктураКлюча.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	//СтруктураКлюча.Вставить("Язык", ПредопределенноеЗначение("Справочник.Языки.Русский"));
	//СтруктураКлюча.Вставить("Объект", ЭтотОбъект.Организация);
	//СтруктураКлюча.Вставить("КонтактноеЛицо", ЭтотОбъект.Подписант);
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	
//	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей);		
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры	