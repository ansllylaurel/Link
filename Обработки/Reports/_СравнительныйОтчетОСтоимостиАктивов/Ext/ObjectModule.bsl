
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Сравнительный отчет о стоимости активов",
		"0.19",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Период		= НастройкиОтчета.Период.ДатаОкончания;
	
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СформироватьОтчет(ДокументРезультат, Новый ТабличныйДокумент);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");

	Возврат Настройки;

КонецФункции

Функция ПолучитьПараметрыШапки()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	&Период КАК ДатаОтчета,
		|	&ПоследнийРабочийДень КАК ПоследнийРабочийДень,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу, РеквизитыФизическихЛицКлиента.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Отчество, 1, 1) + ""."") КАК УчредительУправления
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицКлиента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период)));
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
		
КонецФункции

Функция СчитатьТабличныйДокументВТаблицуЗначений(ИмяМакета, СекцияЗаголовки, СекцияДанные, СекцияКолонки)
	
	Макет = ПолучитьМакет(ИмяМакета);
	
	//будем считать, что у всех макетов с настройками одинаковая структура
	ОбластьЗаголовки = Макет.ПолучитьОбласть(СекцияЗаголовки+"|" + СекцияКолонки);
	ОбластьДанные = Макет.ПолучитьОбласть(СекцияДанные +"|" + СекцияКолонки);
	
	Рез = Новый ТаблицаЗначений;
	
	Если ОбластьЗаголовки.ВысотаТаблицы > 1 Тогда 
		Сообщить("Неправильная структура секции заголовков в Макете " + ИмяМакета);
		Возврат Рез;
	КонецЕсли;	
	
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		Рез.Колонки.Добавить(ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст);
	КонецЦикла;	
	
	Для индСтроки = 1 по КоличествоСтрок Цикл 
		НоваяСтрока = Рез.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл 
			НоваяСтрока[ИндКолонки-1] = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;		
		КонецЦикла;	
	КонецЦикла;	

	Если СекцияКолонки="Колонки" Тогда 
		Рез.ЗаполнитьЗначения(0, "Кол4, Кол5, Кол6, Кол7, Кол8");
	КонецЕсли;	
	
	Возврат Рез;
	
КонецФункции	

Процедура РасчетКолонок6_8(ТабОтчета, Часть)
	
	Для Каждого СтрокаОтчет из ТабОтчета Цикл 
	
		Попытка 
			Ставка = Число(СтрокаОтчет.Ставка);
		Исключение
			Ставка = 0;
		КонецПопытки;	
		
		РазницаЕПС_НУ = Окр((СтрокаОтчет.Кол4 - СтрокаОтчет.Кол5)*Ставка/100, 2);
		
		Если РазницаЕПС_НУ > 0 Тогда 
			СтрокаОтчет.Кол6 = РазницаЕПС_НУ;
			СтрокаОтчет.Кол7 = 0;
		Иначе
			СтрокаОтчет.Кол6 = 0;
			СтрокаОтчет.Кол7 = - РазницаЕПС_НУ;
		КонецЕсли;
		Если РазницаЕПС_НУ <> 0 Тогда 
			СтрокаОтчет.Кол8 = РазницаЕПС_НУ; 
		КонецЕсли;	
		
		Если (СтрокаОтчет.СтрИтог="1") И (Часть=1) Тогда 
			СтрокаОтчет.Кол4 = ТабОтчета.Итог("Кол4");
			СтрокаОтчет.Кол5 = ТабОтчета.Итог("Кол5");
			СтрокаОтчет.Кол6 = ТабОтчета.Итог("Кол6");
			СтрокаОтчет.Кол7 = ТабОтчета.Итог("Кол7");
			СтрокаОтчет.Кол8 = ТабОтчета.Итог("Кол8");
		ИначеЕсли (СтрокаОтчет.СтрИтог="1") И (Часть=2) Тогда 
			//строка 220 - код 22 сейчас не заполнена 			
			СтрокаОтчет.Кол4 = ТабОтчета.Итог("Кол4");
			СтрокаОтчет.Кол5 = ТабОтчета.Итог("Кол5");
			СтрокаОтчет.Кол6 = ТабОтчета.Итог("Кол6");
			СтрокаОтчет.Кол7 = ТабОтчета.Итог("Кол7");
			СтрокаОтчет.Кол8 = ТабОтчета.Итог("Кол8");
			
			
			Строка220 = ТабОтчета.Найти("220", "НомерСтр");
			Строка220.Кол8 = 0;
			
			Отбор = Новый Структура;
			Отбор.Вставить("Группировка", "22");			
			СтрокиРасшифковки = ТабОтчета.НайтиСтроки(Отбор);
			Для Каждого СтрРасшифровка из СтрокиРасшифковки Цикл 
				Строка220.Кол4 = Строка220.Кол4 + СтрРасшифровка.Кол4;
				Строка220.Кол5 = Строка220.Кол5 + СтрРасшифровка.Кол5;
				Строка220.Кол6 = Строка220.Кол6 + СтрРасшифровка.Кол6;
				Строка220.Кол7 = Строка220.Кол7 + СтрРасшифровка.Кол7;
				Строка220.Кол8 = Строка220.Кол8 + СтрРасшифровка.Кол8;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

Процедура Распределить(ТабОтчета, Выборка)
	
	КодСтроки = "";
	КодСтрокиНКД = "";
	
	Если (Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Акции) И (Выборка.Статус = Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) Тогда
		КодСтроки = "1";
	ИначеЕсли (Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Акции) И (Выборка.Статус <> Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) Тогда
		КодСтроки = "2";
	ИначеЕсли (Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Паи) И (Выборка.Статус = Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) Тогда
		КодСтроки = "3";
	ИначеЕсли (Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Паи) И (Выборка.Статус <> Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) Тогда
		КодСтроки = "1";
	ИначеЕсли (Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации) И (Выборка.Статус = Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) Тогда
		Если Выборка.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда     //Ипотечная + Еврооблигаия
			КодСтроки = "5";
		Иначе
			КодСтроки = "8";
		КонецЕсли;	
		КодСтрокиНКД = "9";
	ИначеЕсли (Выборка.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации) И (Выборка.Статус <> Перечисления.ТорговыеСтатусыЦенныхБумаг.ТоргуетсяНаБирже) Тогда		
		Если Выборка.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда 
			КодСтроки = "6";
		Иначе
			КодСтроки = "8";
		КонецЕсли;	
		КодСтрокиНКД = "10";
	КонецЕсли;	
	
	Если КодСтроки <> "" Тогда
		СтрокаОтчета = ТабОтчета.Найти(КодСтроки, "КодСтр");
		СтрокаОтчета.Кол4 = СтрокаОтчета.Кол4+Выборка.СтоимостьЕПС;
		СтрокаОтчета.Кол5 = СтрокаОтчета.Кол5+Выборка.СтоимостьНУ;		
	КонецЕсли;	
	
	Если КодСтрокиНКД <> "" Тогда
		СтрокаОтчета = ТабОтчета.Найти(КодСтрокиНКД, "КодСтр");
		СтрокаОтчета.Кол4 = СтрокаОтчета.Кол4+Выборка.СтоимостьКупонаЕПС;
		СтрокаОтчета.Кол5 = СтрокаОтчета.Кол5+Выборка.СтоимостьКупонаНУ;		
	КонецЕсли;	
		
КонецПроцедуры	

Процедура РаспределитьДебет(ТабОтчета, Выборка)
	
	КодСтроки = ?(ПустаяСтрока(Выборка.КодСтрокиЕПС),Выборка.КодСтрокиНУ, Выборка.КодСтрокиЕПС);
	
	Если КодСтроки <> "" Тогда
		СтрокаОтчета = ТабОтчета.Найти(КодСтроки, "КодСтр");
		СтрокаОтчета.Кол4 = СтрокаОтчета.Кол4+Выборка.СуммаОстатокЕПС;
		СтрокаОтчета.Кол5 = СтрокаОтчета.Кол5+Выборка.СуммаОстатокНУ;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура РаспределитьДоходыРасходы(ТабОтчета, Выборка, ШаблонРасшифровка, ДопНомер);
	
	КодСтроки = "22"; 
	//других пока нет. 
	//цикл оставил для общноости решения. Вдруг появятся строки 20, 21	
	
	// строку 220 здесь не заполняем, заполнение в РасчетКолонок6_8
	
	//СтрокаОтчета = ТабОтчета.Найти(КодСтроки, "КодСтр");
	//СтрокаОтчета.Кол4 = СтрокаОтчета.Кол4+Выборка.ФинРезЕПС;
	//СтрокаОтчета.Кол5 = СтрокаОтчета.Кол5+Выборка.ФинРезНУ;		
	
	КодРасшифровки = Выборка.КодСтроки;
	СтрРасшифровка = ШаблонРасшифровка.Найти(КодРасшифровки, "Стр");
	
	Если СтрРасшифровка <> Неопределено Тогда 
		
		ТекущаяСтрока = ТабОтчета.Найти(Строка(ДопНомер), "НомерСтр");
		Индекс = ТабОтчета.Индекс(ТекущаяСтрока);
		
		СтрокаОтчета = ТабОтчета.Вставить(Индекс+1);
		СтрокаОтчета.Название = СтрРасшифровка.Название;
		СтрокаОтчета.НомерСтр = Строка(ДопНомер+1);
		СтрокаОтчета.Ставка = СтрРасшифровка.Ставка;
		СтрокаОтчета.Кол4 = Выборка.ФинРезЕПС;
		СтрокаОтчета.Кол5 = Выборка.ФинРезНУ;
		СтрокаОтчета.Кол6 = 0;
		СтрокаОтчета.Кол7 = 0;
		СтрокаОтчета.Кол8 = 0;
		СтрокаОтчета.Группировка = КодСтроки;   //Данные расшифровки в итог не будем брать. 
	КонецЕсли;
	
КонецПроцедуры	

Процедура ВыводОтчета(ТабОтчета, ОбластьСтрока, ДокументРезультат)
	
	
	Для Каждого СтрокаОтчет из ТабОтчета Цикл 
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаОтчет);		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;	
	
	
КонецПроцедуры	

Функция ЗапросАктивы()
	
	Запрос = Новый Запрос;
	
	//активы
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток) КАК СтоимостьНУ,
	|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток) КАК СтоимостьКупонаНУ,
	|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок
	|ПОМЕСТИТЬ _НалоговыеПартии
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|			&ДатаОтчетная,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДУ
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)) КАК БухПартииЦенныхБумагОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага,
	|	БухПартииЦенныхБумагОстатки.Рынок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток) КАК СтоимостьЕПС,
