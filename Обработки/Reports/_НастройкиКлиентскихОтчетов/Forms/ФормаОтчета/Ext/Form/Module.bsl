
#Область Внешний_интерфейс

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	// Обновляем организацию, очищаем отбор по счетам ДУ, заполняем таблицу отчетов.
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Договоры.Очистить();
	
	ОтборПриИзменении(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_формы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтборПриИзменении(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);	
	
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Отчет.Организация					= Параметры.Организация;
		ЭтаФорма.УчитываяСрокФормирования	= Параметры.УчитываяСрокФормирования;
		Отчет.Дата							= Параметры.Дата;
		Отчет.ГруппаОтчетов					= Параметры.ГруппаОтчетов;
		ЭтаФорма.Клиенты					= Параметры.Клиенты;
		ЭтаФорма.ВидыДоговоров				= Параметры.ВидыДоговоров;
		ЭтаФорма.Договоры					= Параметры.Договоры;
		ЭтаФорма.СписокОтчетов				= Параметры.СписокОтчетов;
		ЭтаФорма.Периодичность				= Параметры.Периодичность;
	Иначе
		Отчет.Организация	= ПараметрыСеанса.ТекущаяОрганизация;
		Отчет.Дата			= ТекущаяДата();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если ЗначениеЗаполнено(Отчет.ГруппаОтчетов) Тогда
		Настройки.Удалить("Отчет.Дата");
		Настройки.Удалить("Отчет.ГруппаОтчетов");
		Настройки.Удалить("Клиенты");
		Настройки.Удалить("ВидыДоговоров");
		Настройки.Удалить("Договоры");
		Настройки.Удалить("СписокОтчетов");
		Настройки.Удалить("Периодичность");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	Если ЭтаФорма.Клиенты.Количество() > 0
		ИЛИ ЭтаФорма.ВидыДоговоров.Количество() > 0
		ИЛИ ЭтаФорма.Договоры.Количество() > 0
		ИЛИ ЭтаФорма.СписокОтчетов.Количество() > 0
		ИЛИ ЗначениеЗаполнено(ЭтаФорма.Периодичность) Тогда
		ЭтаФорма.ЗаголовокОтборов = "установлен";
	Иначе
		ЭтаФорма.ЗаголовокОтборов = "не задан";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура ВыполнитьФормирование(Команда)
	
	ВыполнитьФормированиеНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаСервере
Функция ПолучитьСтруктуруСДаннымиОтбораНаСервере()
	
	ЭлементыОтбора = Новый Массив;
	
	ЭлементыОтбора.Добавить("Клиенты");
	ЭлементыОтбора.Добавить("ВидыДоговоров");
	ЭлементыОтбора.Добавить("Договоры");
	ЭлементыОтбора.Добавить("СписокОтчетов");
	ЭлементыОтбора.Добавить("Периодичность");
		
	Отбор = Новый Структура;
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ЗначениеЗаполнено(ЭтаФорма[ЭлементОтбора]) Тогда
			Отбор.Вставить(ЭлементОтбора, ЭтаФорма[ЭлементОтбора]);
		КонецЕсли; 		
		
	КонецЦикла;
	
	Возврат Отбор;
	
КонецФункции

&НаСервере
Процедура ВыполнитьФормированиеНаСервере()
	
	Результат.Очистить();
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	Результат.Вывести(ОтчетОбъект.Сформировать(УчитываяСрокФормирования, ПолучитьСтруктуруСДаннымиОтбораНаСервере()));
		
КонецПроцедуры

&НаКлиенте
Процедура КлиентыПриИзменении(Элемент)
	
	ОтборПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыДоговоровДоверительногоУправленияПриИзменении(Элемент)
	
	ОтборПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	
	ОтборПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОтчетовПриИзменении(Элемент)
	
	ОтборПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетаДоверительногоУправленияПриИзменении(Элемент)
	
	ОтборПриИзменении(Элемент);
	
КонецПроцедуры

#КонецОбласти
