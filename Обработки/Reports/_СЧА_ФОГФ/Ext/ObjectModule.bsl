	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ПроцентыИДивиденды_КонецПериода, 0) КАК ПроцентыИДивиденды_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ОстаткиУБрокеров_КонецПериода, 0) КАК ОстаткиУБрокеров_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ПрочаяДебиторскаяЗадолженность_КонецПериода, 0) КАК ПрочаяДебиторскаяЗадолженность_КонецПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_КонецПериода.Сумма, 0) + ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ИтогоАктивов_КонецПериода, 0) КАК ИтогоАктивов_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.КредиторскаяЗадолженность_КонецПериода, 0) КАК КредиторскаяЗадолженность_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ВознаграждениеУК_КонецПериода, 0) КАК ВознаграждениеУК_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ВозвратСредствУчредителю_КонецПериода, 0) КАК ВозвратСредствУчредителю_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.КредиторскаяЗадолженностьПоЦБ_КонецПериода, 0) КАК КредиторскаяЗадолженностьПоЦБ_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ОплатаРасходовДУ_КонецПериода, 0) КАК ОплатаРасходовДУ_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ПрочаяКредиторскаяЗадолженность_КонецПериода, 0) КАК ПрочаяКредиторскаяЗадолженность_КонецПериода,
	|	ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ИтогоПассивов_КонецПериода, 0) КАК ИтогоПассивов_КонецПериода,
	|	ЕСТЬNULL(_БалансоваяСтоимостьЦБ_КонецПериода.БалансоваяСумма, 0) КАК ФинансовыеВложения_Баланс_КонецПериода,
	|	ЕСТЬNULL(_БалансоваяСтоимостьЦБ_НачалоПериода.БалансоваяСумма, 0) КАК ФинансовыеВложения_Баланс_НачалоПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_КонецПериода.Сумма, 0) КАК ФинансовыеВложения_КонецПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_НачалоПериода.Сумма, 0) КАК ФинансовыеВложения_НачалоПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_НачалоПериода.Сумма, 0) - ЕСТЬNULL(_БалансоваяСтоимостьЦБ_НачалоПериода.БалансоваяСумма, 0) КАК ФинансовыеВложения_Отклонение_НачалоПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_КонецПериода.Сумма, 0) - ЕСТЬNULL(_БалансоваяСтоимостьЦБ_КонецПериода.БалансоваяСумма, 0) КАК ФинансовыеВложения_Отклонение_КонецПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_НачалоПериода.Сумма, 0) + ЕСТЬNULL(_РаспределениеНеЦБ_НачалоПериода_Итоги.ИтогоАктивов_НачалоПериода, 0) - ЕСТЬNULL(_РаспределениеНеЦБ_НачалоПериода_Итоги.ИтогоПассивов_НачалоПериода, 0) КАК СЧА_НачалоПериода,
	|	ЕСТЬNULL(_СтоимостьПереоценки_КонецПериода.Сумма, 0) + ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ИтогоАктивов_КонецПериода, 0) - ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ИтогоПассивов_КонецПериода, 0) КАК СЧА_КонецПериода,
	|	ЕСТЬNULL(_ВводыВыводы.ПоступлениеАктивов, 0) КАК ПоступлениеАктивов,
	|	ЕСТЬNULL(_ВводыВыводы.ИзъятиеАктивов, 0) КАК ИзъятиеАктивов,
	|	ЕСТЬNULL(_СтоимостьПереоценки_КонецПериода.Сумма, 0) + ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ИтогоАктивов_КонецПериода, 0) - ЕСТЬNULL(_РаспределениеНеЦБ_КонецПериода_Итоги.ИтогоПассивов_КонецПериода, 0) - ЕСТЬNULL(_ВводыВыводы.ПоступлениеАктивов, 0) + ЕСТЬNULL(_ВводыВыводы.ИзъятиеАктивов, 0) - (ЕСТЬNULL(_СтоимостьПереоценки_НачалоПериода.Сумма, 0) + ЕСТЬNULL(_РаспределениеНеЦБ_НачалоПериода_Итоги.ИтогоАктивов_НачалоПериода, 0) - ЕСТЬNULL(_РаспределениеНеЦБ_НачалоПериода_Итоги.ИтогоПассивов_НачалоПериода, 0)) КАК ПриростИмущества
	|ИЗ
	|	_РаспределениеНеЦБ_НачалоПериода_Итоги КАК _РаспределениеНеЦБ_НачалоПериода_Итоги
	|		ПОЛНОЕ СОЕДИНЕНИЕ _РаспределениеНеЦБ_КонецПериода_Итоги КАК _РаспределениеНеЦБ_КонецПериода_Итоги
	|		ПО (ИСТИНА)
	|		ПОЛНОЕ СОЕДИНЕНИЕ _БалансоваяСтоимостьЦБ_НачалоПериода КАК _БалансоваяСтоимостьЦБ_НачалоПериода
	|		ПО (ИСТИНА)
	|		ПОЛНОЕ СОЕДИНЕНИЕ _БалансоваяСтоимостьЦБ_КонецПериода КАК _БалансоваяСтоимостьЦБ_КонецПериода
	|		ПО (ИСТИНА)
	|		ПОЛНОЕ СОЕДИНЕНИЕ _СтоимостьПереоценки_НачалоПериода КАК _СтоимостьПереоценки_НачалоПериода
	|		ПО (ИСТИНА)
	|		ПОЛНОЕ СОЕДИНЕНИЕ _СтоимостьПереоценки_КонецПериода КАК _СтоимостьПереоценки_КонецПериода
	|		ПО (ИСТИНА)
	|		ПОЛНОЕ СОЕДИНЕНИЕ _ВводыВыводы КАК _ВводыВыводы
	|		ПО (ИСТИНА)";
	
	#КОНЕЦОБЛАСТИ 
	
	Запрос.УстановитьПараметр("ДатаНачала", 					ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 					КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидПоказателя", 					Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("ДатаОкончания_Граница", 			Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая)); 
	Запрос.УстановитьПараметр("ДатаСЧАНаНачалоПериода", 		ДатаСЧАНаНачалоПериода);
	Запрос.УстановитьПараметр("ДатаСЧАНаКонецПериода", 			ДатаСЧАНаКонецПериода);
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Организация, "ВалютаУчета, ЮрФизЛицо");
	
	Запрос.УстановитьПараметр("ВалютаУчета",					РеквизитыОрганизации.ВалютаУчета);
	Запрос.УстановитьПараметр("ЮрФизЛицо",						РеквизитыОрганизации.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ВидУчетаБаланс",					Перечисления.ВидыУчета.БухгалтерскийУчет);
	Запрос.УстановитьПараметр("ФОГФ",						  	ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ФОГФ"));
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ИндексПоследнегозапроса = ПакетЗапросов.ВГраница();
	
	// Секция 1
	Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - 2].Выбрать();

	НаименованиеКлиента = "";
	НаименованиеУК		= "";
	Если Выборка.Следующий() Тогда				
		ОбластьСекция_1.Параметры.Заполнить(Выборка);
		ОбластьСекция_1.Параметры.ПолноеНаименованиеФОГФРП = ПолучитьСклоненияСтроки(Выборка.ПолноеНаименованиеФОГФ, "", "ПД=Родительный")[0];
	КонецЕсли;
	
	ОбластьСекция_1.Параметры.ДатаОтчета 			= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");	
	
	Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса].Выбрать();
	Если Выборка.Следующий() Тогда                   		
		ОбластьСекция_1.Параметры.Заполнить(Выборка);
		ОбластьСекция_2.Параметры.Заполнить(Выборка);
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьСекция_1);
	
	// Секция Брокеры
	ВыборкаБрокеры = ПакетЗапросов[ИндексПоследнегоЗапроса - 1].Выбрать();
	Пока ВыборкаБрокеры.Следующий() Цикл
		ОбластьБрокеры.Параметры.Заполнить(ВыборкаБрокеры);
		ДокументРезультат.Вывести(ОбластьБрокеры);
	КонецЦикла;
	
	// Секция 2
	ДокументРезультат.Вывести(ОбластьСекция_2);
	
	// Подписи	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
	ОбластьПодвал.Параметры.Ответственный 		= СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
	ОбластьПодвал.Параметры.ДолжностьДиректор 	= СтруктураДанныхКонтактногоЛица.Должность + " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий +  ")";

	ОбластьПодвал.Параметры.ГлавныйБухгалтер 	= СтруктураДанныхГлБухгалтера.КонтактноеЛицо;
	ОбластьПодвал.Параметры.ДолжностьГлавбух    = СтруктураДанныхГлБухгалтера.Должность;
	
	ДокументРезультат.Вывести(ОбластьПодвал);
		
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры