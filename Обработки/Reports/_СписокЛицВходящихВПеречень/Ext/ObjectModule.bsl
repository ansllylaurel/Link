		|	ВложенныйЗапрос.ДатаВключения КАК ДатаВключения,
		|	ВложенныйЗапрос.ДатаИсключения КАК ДатаИсключения,
		|	ОснованияВнесенияВПеречень.Основание КАК Основание
		|ПОМЕСТИТЬ _ПоследниеОснования
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СписокОбъектов.Объект КАК Объект,
		|		_СписокОбъектов.ДатаВключения КАК ДатаВключения,
		|		_СписокОбъектов.ДатаИсключения КАК ДатаИсключения,
		|		МАКСИМУМ(ОснованияВнесенияВПеречень.Период) КАК ДатаПоследнегоОснования
		|	ИЗ
		|		_СписокОбъектов КАК _СписокОбъектов
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияВнесенияВПеречень КАК ОснованияВнесенияВПеречень
		|			ПО (ОснованияВнесенияВПеречень.Организация = &Организация)
		|				И _СписокОбъектов.Объект = ОснованияВнесенияВПеречень.Объект
		|				И (ОснованияВнесенияВПеречень.ВидПеречня = &ВидПеречня)
		|				И (ОснованияВнесенияВПеречень.Период <= ЕСТЬNULL(ДОБАВИТЬКДАТЕ(_СписокОбъектов.ДатаИсключения, СЕКУНДА, -1), &ДатаОкончания))
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СписокОбъектов.Объект,
		|		_СписокОбъектов.ДатаВключения,
		|		_СписокОбъектов.ДатаИсключения) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияВнесенияВПеречень КАК ОснованияВнесенияВПеречень
		|		ПО (ОснованияВнесенияВПеречень.Организация = &Организация)
		|			И ВложенныйЗапрос.Объект = ОснованияВнесенияВПеречень.Объект
		|			И (ОснованияВнесенияВПеречень.ВидПеречня = &ВидПеречня)
		|			И (ОснованияВнесенияВПеречень.Период = ВложенныйЗапрос.ДатаПоследнегоОснования)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СписокОбъектов.Объект КАК ЮрФизЛицо,
		|	_СписокОбъектов.ДатаВключения КАК ДатаВключения,
		|	_СписокОбъектов.ДатаИсключения КАК ДатаИсключения,
		|	Основания.Сотрудник КАК Сотрудник,
		|	ЕСТЬNULL(СотрудникиОрганизацииСрезПоследних.Должность, Основания.ДолжностьЧленаСоветаДиректоров) КАК Должность,
		|	ВЫБОР
		|		КОГДА СотрудникиОрганизацииСрезПоследних.Подразделение ЕСТЬ НЕ NULL 
		|			ТОГДА СотрудникиОрганизацииСрезПоследних.Подразделение
		|		КОГДА Основания.ДолжностьЧленаСоветаДиректоров ЕСТЬ НЕ NULL 
		|			ТОГДА ""Совет директоров""
		|	КОНЕЦ КАК Подразделение,
		|	ЕСТЬNULL(СотрудникиОрганизацииСрезПоследних.ВидСобытия, """") = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение) КАК Уволен,
		|	ЕСТЬNULL(РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия, РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия) + "" "" + ЕСТЬNULL(РеквизитыСотрудниковОрганизацииСрезПоследних.Имя, РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя) + "" "" + ЕСТЬNULL(РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество, РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество) КАК ФИО,
		|	СотрудникиПриемНаРаботу.Период КАК ДатаПриемаНаРаботу,
		|	ВЫБОР ЕСТЬNULL(СотрудникиОрганизацииСрезПоследних.ВидСобытия, """")
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|			ТОГДА СотрудникиОрганизацииСрезПоследних.Период
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаУвольнения
		|ПОМЕСТИТЬ _СписокОбъектовДолжностныЛиц
		|ИЗ
		|	_СписокОбъектов КАК _СписокОбъектов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследниеОснования КАК _ПоследниеОснования
		|		ПО _СписокОбъектов.Объект = _ПоследниеОснования.Объект
		|			И _СписокОбъектов.ДатаВключения = _ПоследниеОснования.ДатаВключения
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВнесениеИзмененийВоВнутреннийПеречень.Ссылка КАК Основание,
		|			ВнесениеИзмененийВоВнутреннийПеречень.ДолжностьЧленаСоветаДиректоров КАК ДолжностьЧленаСоветаДиректоров,
		|			NULL КАК Сотрудник
		|		ИЗ
		|			Документ.ВнесениеИзмененийВоВнутреннийПеречень КАК ВнесениеИзмененийВоВнутреннийПеречень
		|		ГДЕ
		|			ВнесениеИзмененийВоВнутреннийПеречень.Организация = &Организация
		|			И ВнесениеИзмененийВоВнутреннийПеречень.ВидПеречня = &ВидПеречня
		|			И ВнесениеИзмененийВоВнутреннийПеречень.ДолжностьЧленаСоветаДиректоров <> ЗНАЧЕНИЕ(Справочник.Должности.)
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка,
		|			NULL,
		|			ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник
		|		ИЗ
		|			Документ.ВнесениеИзмененийВоВнутреннийПеречень.Основания КАК ВнесениеИзмененийВоВнутреннийПереченьОснования
		|		ГДЕ
		|			ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка.Организация = &Организация
		|			И ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка.ВидПеречня = &ВидПеречня
		|			И ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.)) КАК Основания
		|		ПО (_ПоследниеОснования.Основание = Основания.Основание)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ПО (Основания.Сотрудник = СотрудникиОрганизацииСрезПоследних.Сотрудник)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
		|		ПО _СписокОбъектов.Объект = РеквизитыСотрудниковОрганизацииСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _СписокОбъектов.Объект = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПервых(, Организация = &Организация) КАК СотрудникиПриемНаРаботу
		|		ПО (Основания.Сотрудник = СотрудникиПриемНаРаботу.Сотрудник)
		|ГДЕ
		|	(&ПоказатьУволенных
		|			ИЛИ СотрудникиОрганизацииСрезПоследних.ВидСобытия ЕСТЬ NULL
		|			ИЛИ СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))";
#КонецОбласти
	
	Запрос.Выполнить();
	
	Таблица_РеквизитыОрганизации		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыОрганизации").ПолучитьДанные().Выгрузить();
	Таблица_СписокОбъектовДолжностныЛиц	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СписокОбъектовДолжностныЛиц").ПолучитьДанные().Выгрузить();
	
	Если Таблица_РеквизитыОрганизации.Количество() Тогда
		ВывестиОбласть(ДокументРезультат, ИмяМакета, "Шапка", Инсайдеры_ПодготовитьДанные(Таблица_РеквизитыОрганизации[0]));
	КонецЕсли;
	
	Таблица_СписокОбъектовДолжностныЛиц.Сортировать("ФИО");
	Если Таблица_СписокОбъектовДолжностныЛиц.Количество() Тогда
		Для Каждого Строка_СписокОбъектовДолжностныЛиц Из Таблица_СписокОбъектовДолжностныЛиц Цикл
			ВывестиОбласть(ДокументРезультат, ИмяМакета, "Строка", Строка_СписокОбъектовДолжностныЛиц, Новый Структура("Использование, ЦветТекста", Строка_СписокОбъектовДолжностныЛиц.Уволен, Новый Цвет(169, 169, 169)));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоместитьСписокОбъектовВМВТ(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнутренниеПеречниСрезПоследних.Объект КАК Объект,
		|	ВнутренниеПеречниСрезПоследних.Период КАК ДатаВключения
		|ПОМЕСТИТЬ _ВключениеВПеречень
		|ИЗ
		|	РегистрСведений.ВнутренниеПеречни.СрезПоследних(
		|			&ДатаНачала,
		|			Организация = &Организация
		|				И ВидПеречня = &ВидПеречня) КАК ВнутренниеПеречниСрезПоследних
		|ГДЕ
		|	ВнутренниеПеречниСрезПоследних.Действует
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВнутренниеПеречни.Объект,
		|	ВнутренниеПеречни.Период
		|ИЗ
		|	РегистрСведений.ВнутренниеПеречни КАК ВнутренниеПеречни
		|ГДЕ
		|	ВнутренниеПеречни.Период > &ДатаНачала
		|	И ВнутренниеПеречни.Период <= &ДатаОкончания
		|	И ВнутренниеПеречни.Организация = &Организация
		|	И ВнутренниеПеречни.ВидПеречня = &ВидПеречня
		|	И ВнутренниеПеречни.Активность
		|	И ВнутренниеПеречни.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнутренниеПеречни.Объект КАК Объект,
		|	ВнутренниеПеречни.Период КАК ДатаИсключения
		|ПОМЕСТИТЬ _ИсключениеИзПереченя
		|ИЗ
		|	РегистрСведений.ВнутренниеПеречни КАК ВнутренниеПеречни
		|ГДЕ
		|	ВнутренниеПеречни.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВнутренниеПеречни.Организация = &Организация
		|	И ВнутренниеПеречни.ВидПеречня = &ВидПеречня
		|	И ВнутренниеПеречни.Активность
		|	И НЕ ВнутренниеПеречни.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВключениеВПеречень.Объект КАК Объект,
		|	_ВключениеВПеречень.ДатаВключения КАК ДатаВключения,
		|	МИНИМУМ(_ИсключениеИзПереченя.ДатаИсключения) КАК ДатаИсключения
		|ПОМЕСТИТЬ _СписокОбъектов
		|ИЗ
		|	_ВключениеВПеречень КАК _ВключениеВПеречень
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ИсключениеИзПереченя КАК _ИсключениеИзПереченя
		|		ПО _ВключениеВПеречень.Объект = _ИсключениеИзПереченя.Объект
		|			И _ВключениеВПеречень.ДатаВключения <= _ИсключениеИзПереченя.ДатаИсключения
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВключениеВПеречень.Объект,
		|	_ВключениеВПеречень.ДатаВключения";
	
	Запрос.Выполнить();
	
КонецПроцедуры


#КонецОбласти

#Область Инсайдеры_ЗаполнитьПечатнуюФорму

Процедура Инсайдеры_ЗаполнитьПечатнуюФорму(ДокументРезультат, Запрос) 
	
	ДокументРезультат.Очистить();
	
	ИмяМакета = "СписокИнсайдеров";
	
	Таблица_РеквизитыОрганизации	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыОрганизации").ПолучитьДанные().Выгрузить();
	Таблица_ФизическиеЛица			= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ФизическиеЛица").ПолучитьДанные().Выгрузить();
	Таблица_ЮридическиеЛица 		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЮридическиеЛица").ПолучитьДанные().Выгрузить();
	Таблица_Основания				= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Основания").ПолучитьДанные().Выгрузить();
	Таблица_ИсторияИзменений		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ИсторияИзменений").ПолучитьДанные().Выгрузить();
	
	Если Таблица_РеквизитыОрганизации.Количество() Тогда
		ВывестиОбласть(ДокументРезультат, ИмяМакета, "Шапка", Инсайдеры_ПодготовитьДанные(Таблица_РеквизитыОрганизации[0]));
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("Таблица_Основания, Таблица_ИсторияИзменений", Таблица_Основания, Таблица_ИсторияИзменений);
	
	Если Таблица_ФизическиеЛица.Количество() Тогда
		Таблица_ФизическиеЛица.Сортировать("ФИО");
		ВывестиОбласть(ДокументРезультат, ИмяМакета, "ФизическиеЛица");
		Для Каждого Строка_ФизическиеЛица Из Таблица_ФизическиеЛица Цикл
			ВывестиОбласть(ДокументРезультат, ИмяМакета, Строка_ФизическиеЛица.ИмяОбласти, Инсайдеры_ПодготовитьДанные(Строка_ФизическиеЛица, ДополнительныеПараметры));
		КонецЦикла;
	КонецЕсли;
	
	Если Таблица_ЮридическиеЛица.Количество() Тогда
		Таблица_ЮридическиеЛица.Сортировать("ПолноеНаименованиеПоУставу");
		ВывестиОбласть(ДокументРезультат, ИмяМакета, "ЮридическиеЛица");
		Для Каждого Строка_ЮридическиеЛица Из Таблица_ЮридическиеЛица Цикл
			ВывестиОбласть(ДокументРезультат, ИмяМакета, "ЮридическиеЛица_Строка", Инсайдеры_ПодготовитьДанные(Строка_ЮридическиеЛица, ДополнительныеПараметры));
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция Инсайдеры_ПодготовитьДанные(СтрокаДанных, ДополнительныеПараметры = Неопределено)
	
	Колонки = СтрокаДанных.Владелец().Колонки;
	Данные	= Новый Структура;
	
	Для Каждого Колонка Из Колонки Цикл
		Значение = СтрокаДанных[Колонка.Имя];
		
		Если ТипЗнч(Значение) = Тип("Дата") Тогда
			Значение = Формат(Значение, "ДФ=dd.MM.yyyy");
		ИначеЕсли Колонка.Имя = "ОписаниеОснованияВключения"
		 ИЛИ Колонка.Имя = "ОписаниеОснованияИсключения" Тогда
			Значение = Инсайдеры_ПолучитьОписаниеОснования(Значение, ДополнительныеПараметры.Таблица_Основания);
		ИначеЕсли Колонка.Имя = "ОснованиеВключения" Тогда
			Значение = Инсайдеры_ПолучитьИсториюИзменений(Значение, ДополнительныеПараметры.Таблица_ИсторияИзменений);
		КонецЕсли;
		
		Данные.Вставить(Колонка.Имя, Значение);
	КонецЦикла;	
	
	Возврат Данные;
	
КонецФункции

Функция Инсайдеры_ПолучитьОписаниеОснования(Основание, Таблица_Основания)
	
	ОписаниеОснования = Новый Массив;
	
	ПараметрыПоиска = Новый Структура("Ссылка", Основание);	
	НайденныеСтроки = Таблица_Основания.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого Строка_Основания Из НайденныеСтроки Цикл
		ОписаниеОснования.Добавить(Строка(Строка_Основания.Категория));
		ОписаниеОснования.Добавить(Строка(Строка_Основания.Основание));
	КонецЦикла;
	
	Возврат СтрСоединить(ОписаниеОснования, Символы.ПС);
	
КонецФункции

Функция Инсайдеры_ПолучитьИсториюИзменений(Основание, Таблица_ИсторияИзменений)
	
	СписокОснований = Новый СписокЗначений;
	
	ПараметрыПоиска = Новый Структура("ОснованиеВключения", Основание);	
	НайденныеСтроки = Таблица_ИсторияИзменений.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого Строка_ИсторияИзменений Из НайденныеСтроки Цикл
		СписокОснований.Добавить(Строка_ИсторияИзменений.Основание, Строка(Строка_ИсторияИзменений.ВидИзменения) + " " +  Формат(Строка_ИсторияИзменений.Период, "ДФ=dd.MM.yyyy"));
	КонецЦикла;
	
	СписокОснований.СортироватьПоЗначению();
	Возврат СписокОснований;
	
КонецФункции

Процедура ВывестиОбласть(Результат, ИмяМакета, ИмяОбласти, Данные = Неопределено, Оформление = Неопределено)
	
	Макет	= ПолучитьМакет(ИмяМакета);
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	
	Если Данные <> Неопределено Тогда
		Область.Параметры.Заполнить(Данные);
	КонецЕсли;
	
	Результат.Вывести(Область);
	
	Если Оформление <> Неопределено И Оформление.Использование Тогда
		ВыведеннаяОбласть = Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, Результат.ШиринаСтраницы);
		Для Каждого ЭлементОформления Из Оформление Цикл
			Если ЭлементОформления.Ключ <> "Использование" Тогда
				ВыведеннаяОбласть[ЭлементОформления.Ключ] = ЭлементОформления.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область Инсайдеры_СформироватьXML

Процедура Инсайдеры_СформироватьXML(Запрос, ИдентификаторФормы)
	
	МассивОшибок = Новый Массив;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Если ЭтотОбъект.НовыйФормат Тогда
		ПолучитьМакет("СхемаММВБ2025").Записать(ИмяВременногоФайла);
	Иначе
		ПолучитьМакет("СхемаММВБ").Записать(ИмяВременногоФайла);
	КонецЕсли;
	
	МассивXSD = Новый Массив;
	МассивXSD.Добавить(ИмяВременногоФайла);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(МассивXSD);
	
