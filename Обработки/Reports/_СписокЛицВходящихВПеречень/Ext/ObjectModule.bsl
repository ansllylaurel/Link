	insiders_document.insiders.organizations	= НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, "organizations"));
	insiders_document.insiders.persons			= НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, "persons"));
	
	Таблица_РеквизитыОрганизации	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыОрганизации").ПолучитьДанные().Выгрузить();
	Таблица_ФизическиеЛица			= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ФизическиеЛица").ПолучитьДанные().Выгрузить();
	Таблица_ЮридическиеЛица 		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЮридическиеЛица").ПолучитьДанные().Выгрузить();
	Таблица_Основания				= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Основания").ПолучитьДанные().Выгрузить();
	
	insiders_document.created = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyy-MM-dd");
	//Если ЭтотОбъект.НовыйФормат Тогда
	//	insiders_document.date = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyy-MM-dd");
	//КонецЕсли;
	
	Для Каждого Строка_РеквизитыОрганизации Из Таблица_РеквизитыОрганизации Цикл
		organization_info = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, "organization_info"));
		
		organization_info.full_name			= Строка_РеквизитыОрганизации.ПолноеНаименованиеОрганизации;
		organization_info.short_name		= Строка_РеквизитыОрганизации.НаименованиеОрганизации;
		organization_info.category			= Строка_РеквизитыОрганизации.КатегорияИнсайдера;
		organization_info.inn				= Строка_РеквизитыОрганизации.ИНН;
		organization_info.ogrn				= Строка_РеквизитыОрганизации.ОГРН;
		organization_info.address			= Строка_РеквизитыОрганизации.ЮридическийАдрес;
		Если Строка_РеквизитыОрганизации.ПочтовыйАдрес <> Строка_РеквизитыОрганизации.ЮридическийАдрес Тогда
			organization_info.post_address		= Строка_РеквизитыОрганизации.ПочтовыйАдрес;
		КонецЕсли;
		organization_info.website_address	= Строка_РеквизитыОрганизации.ВебСтраница;
		organization_info.contact_person	= Строка(Строка_РеквизитыОрганизации.Ответственный);
		organization_info.phone				= Строка_РеквизитыОрганизации.Телефоны;
		organization_info.fax				= Строка_РеквизитыОрганизации.Факсы;
		organization_info.email				= Строка_РеквизитыОрганизации.EMail;
		
		insiders_document.organization_info = organization_info;
		
		Если ПустаяСтрока(Строка_РеквизитыОрганизации.Ответственный) Тогда
			МассивОшибок.Добавить("Не указан ответственный");
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого Строка_ЮридическиеЛица Из Таблица_ЮридическиеЛица Цикл
		organization = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, "organization"));
		
		organization.name						= Строка_ЮридическиеЛица.ПолноеНаименованиеПоУставу;
		organization.inn						= Строка_ЮридическиеЛица.ИНН;
		organization.ogrn						= Строка_ЮридическиеЛица.ОГРН;
		Если ЭтотОбъект.НовыйФормат Тогда
			organization.kio						= Строка_ЮридическиеЛица.КИО;
			organization.okcm						= Строка_ЮридическиеЛица.ОКСМ;
			organization.registration_number		= ""; //тех.долг
			//Следующие данные не запрашиваются, выгружать не надо
			//organization.address					= ""; //Строка_ЮридическиеЛица.Адрес;
			//organization.post_address				= ""; //Строка_ЮридическиеЛица.ПочтовыйАдрес;
			//organization.phone						= ""; //Строка_ЮридическиеЛица.Телефон;
			//organization.email						= ""; //Строка_ЮридическиеЛица.Email;
		КонецЕсли;
		organization.inc_date					= Формат(Строка_ЮридическиеЛица.ДатаВключения, "ДФ=yyyy-MM-dd");
		organization.inc_reason					= Инсайдеры_ПолучитьОснованиеИнсайдераИзОснования(Строка_ЮридическиеЛица.ОснованиеВключения, Таблица_Основания);
		organization.inc_category				= Инсайдеры_ПолучитьКатегориюИнсайдераИзОснования(Строка_ЮридическиеЛица.ОснованиеВключения, Таблица_Основания);
		organization.inc_financial_instrument	= Строка(Строка_ЮридическиеЛица.ОбъектИнсайдерскойИнформации);
		
		Если ЗначениеЗаполнено(Строка_ЮридическиеЛица.ДатаИсключения) Тогда
			organization.exc_date					= Формат(Строка_ЮридическиеЛица.ДатаИсключения, "ДФ=yyyy-MM-dd");
			organization.exc_reason					= Инсайдеры_ПолучитьОснованиеИнсайдераИзОснования(Строка_ЮридическиеЛица.ОснованиеИсключения, Таблица_Основания);
			organization.exc_category				= Инсайдеры_ПолучитьКатегориюИнсайдераИзОснования(Строка_ЮридическиеЛица.ОснованиеИсключения, Таблица_Основания);
			organization.exc_financial_instrument	= Строка(Строка_ЮридическиеЛица.ОбъектИнсайдерскойИнформации);
		КонецЕсли;
		
		insiders_document.insiders.organizations.organization.Добавить(organization);
		
	КонецЦикла;
	
	Для Каждого Строка_ФизическиеЛица Из Таблица_ФизическиеЛица Цикл
		person_inc = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, "person"));
		
		person_inc.last_name				= Строка(Строка_ФизическиеЛица.Фамилия);
		person_inc.first_name				= Строка(Строка_ФизическиеЛица.Имя);
		person_inc.middle_name				= Строка(Строка_ФизическиеЛица.Отчество);
		person_inc.doc_sn					= Строка(Строка_ФизическиеЛица.СерияУдостоверенияЛичности) + Строка(Строка_ФизическиеЛица.НомерУдостоверенияЛичности);
		
		Если ЭтотОбъект.НовыйФормат Тогда
			person_inc.birth_date				= Дата(Строка_ФизическиеЛица.ДатаРождения);
			//Следующие данные не запрашиваются, выгружать не надо
			//person_inc.birth_place				= ""; //Строка(Строка_ФизическиеЛица.МестоРождения);
			//person_inc.doc_organ				= ""; //Строка(Строка_ФизическиеЛица.ОрганВыдавшийУдостоверениеЛичности);
			//person_inc.address					= ""; //Строка(Строка_ФизическиеЛица.АдресРегистрации);
			//person_inc.post_address				= ""; //Строка(Строка_ФизическиеЛица.ПочтовыйАдрес);
			//person_inc.phone					= ""; //Строка(Строка_ФизическиеЛица.Телефон);
			//person_inc.email					= ""; //Строка(Строка_ФизическиеЛица.EMail);
		КонецЕсли;
		
		person_inc.inc_date					= Формат(Строка_ФизическиеЛица.ДатаВключения, "ДФ=yyyy-MM-dd");
		person_inc.inc_reason				= Инсайдеры_ПолучитьОснованиеИнсайдераИзОснования(Строка_ФизическиеЛица.ОснованиеВключения, Таблица_Основания);
		person_inc.inc_category				= Инсайдеры_ПолучитьКатегориюИнсайдераИзОснования(Строка_ФизическиеЛица.ОснованиеВключения, Таблица_Основания);
		person_inc.inc_financial_instrument	= Строка(Строка_ФизическиеЛица.ОбъектИнсайдерскойИнформации);
		
		person_inc.inc_org_fullname			= Строка_ФизическиеЛица.ПолноеНаименованиеОрганизации;
		Если Не ЭтотОбъект.НовыйФормат Тогда
			person_inc.inc_job					= Строка(Строка_ФизическиеЛица.Должность) + ?(ЗначениеЗаполнено(Строка_ФизическиеЛица.Подразделение), "", " ") + Строка(Строка_ФизическиеЛица.Подразделение);
			person_inc.inc_type					= "";
		КонецЕсли;
		
		insiders_document.insiders.persons.person.Добавить(person_inc);
		
		Если ЗначениеЗаполнено(Строка_ФизическиеЛица.ДатаИсключения) Тогда
			person_exc = НоваяФабрикаXDTO.Создать(НоваяФабрикаXDTO.Тип(URIПространстваИмен, "person"));
			
			Если ЭтотОбъект.НовыйФормат Тогда
				ЗаполнитьЗначенияСвойств(person_exc, person_inc, "last_name, first_name, middle_name, doc_sn, inc_date, inc_reason, inc_category, inc_financial_instrument, inc_org_fullname, birth_date"); //birth_place, doc_organ, address, post_address, phone, email
			Иначе
				ЗаполнитьЗначенияСвойств(person_exc, person_inc, "doc_sn, inc_date, inc_reason, inc_category, inc_financial_instrument, inc_org_fullname, inc_job, inc_type");
			КонецЕсли;
			
			person_exc.exc_date					= Формат(Строка_ФизическиеЛица.ДатаИсключения, "ДФ=yyyy-MM-dd");
			person_exc.exc_reason				= Инсайдеры_ПолучитьОснованиеИнсайдераИзОснования(Строка_ФизическиеЛица.ОснованиеИсключения, Таблица_Основания);
			person_exc.exc_category				= Инсайдеры_ПолучитьКатегориюИнсайдераИзОснования(Строка_ФизическиеЛица.ОснованиеИсключения, Таблица_Основания);
			person_exc.exc_financial_instrument	= Строка(Строка_ФизическиеЛица.ОбъектИнсайдерскойИнформации);
			person_exc.exc_org_fullname			= Строка_ФизическиеЛица.ПолноеНаименованиеОрганизации;
			person_exc.exc_job					= Строка(Строка_ФизическиеЛица.Должность) + ?(ЗначениеЗаполнено(Строка_ФизическиеЛица.Подразделение), "", " ") + Строка(Строка_ФизическиеЛица.Подразделение);
			
			insiders_document.insiders.persons.person.Добавить(person_exc);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка_ФизическиеЛица.ОписаниеОшибки) Тогда
			МассивОшибок.Добавить(Строка_ФизическиеЛица.ОписаниеОшибки + ": " + Строка(Строка_ФизическиеЛица.Объект));
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивОшибок.Количество() Тогда
		ЭтотОбъект.АдресХранилищаXMLММВБ = ПоместитьВоВременноеХранилище(МассивОшибок, ИдентификаторФормы);
		
	Иначе		
	
		ИмяФайлаXML = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "windows-1251");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, insiders_document, "insiders_document");
		
		ЗаписьXML.Закрыть();
		
		//ТекстовыйФайл = Новый ТекстовыйДокумент;
		//ТекстовыйФайл.Прочитать(ИмяФайлаXML,"windows-1251");
		//ТекстовыйФайл.ЗаменитьСтроку(2, СтрЗаменить(ТекстовыйФайл.ПолучитьСтроку(2), "xmlns=""XBRL"" ", ""));
		//ТекстовыйФайл.Записать(ИмяФайлаXML,"windows-1251");
		
		ЭтотОбъект.АдресХранилищаXMLММВБ = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаXML), ИдентификаторФормы);
		
	КонецЕсли;
	
КонецПроцедуры

