#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Список лиц входящих в перечень",
		"0.18",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область ФормированиеОтчета

Процедура СформироватьОтчет(ДокументРезультат, ИдентификаторФормы) Экспорт
	
	// Организуем сбор статистики	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьОтчет()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация,Период,Ответственный,ВидПеречня");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДокументРезультат.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала",			ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",		ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Ответственный",		ЭтотОбъект.Ответственный);
	Запрос.УстановитьПараметр("ВидПеречня",			ЭтотОбъект.ВидПеречня);
	Запрос.УстановитьПараметр("ПоказатьУволенных",	ЭтотОбъект.ПоказатьУволенных);
	
	ПоместитьСписокОбъектовВМВТ(Запрос);
	
	Если ЭтотОбъект.ВидПеречня = Справочники.ВидыПеречнейОбъектов.Инсайдеры Тогда
		Инсайдеры_СформироватьОтчет(ДокументРезультат, ИдентификаторФормы, Запрос);
		
	Иначе
		Сотрудники_СформироватьОтчет(ДокументРезультат, ИдентификаторФормы, Запрос);
		
	КонецЕсли;	
	
	// Завершаем сессию сбора статистики
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	

КонецПроцедуры

Процедура Инсайдеры_СформироватьОтчет(ДокументРезультат, ИдентификаторФормы, Запрос)
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Объект КАК Объект,
		|	ВложенныйЗапрос.ДатаВключения КАК ДатаВключения,
		|	ОснованияВключенияВПеречень.Основание КАК ОснованиеВключения,
		|	ВложенныйЗапрос.ДатаИсключения КАК ДатаИсключения,
		|	ОснованияИсключенияИзПереченя.Основание КАК ОснованиеИсключения
		|ПОМЕСТИТЬ _СписокОбъектовСОснованиями
		|ИЗ
		|	(ВЫБРАТЬ
		|		_СписокОбъектов.Объект КАК Объект,
		|		_СписокОбъектов.ДатаВключения КАК ДатаВключения,
		|		_СписокОбъектов.ДатаИсключения КАК ДатаИсключения,
		|		МАКСИМУМ(ОснованияВключенияВПеречень.Период) КАК ДатаОснованияВключения
		|	ИЗ
		|		_СписокОбъектов КАК _СписокОбъектов
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияВнесенияВПеречень КАК ОснованияВключенияВПеречень
		|			ПО _СписокОбъектов.Объект = ОснованияВключенияВПеречень.Объект
		|				И (ОснованияВключенияВПеречень.Организация = &Организация)
		|				И (ОснованияВключенияВПеречень.ВидПеречня = &ВидПеречня)
		|				И (ОснованияВключенияВПеречень.Активность)
		|				И (ЕСТЬNULL(_СписокОбъектов.ДатаИсключения, &ДатаОкончания) > ОснованияВключенияВПеречень.Период)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_СписокОбъектов.Объект,
		|		_СписокОбъектов.ДатаВключения,
		|		_СписокОбъектов.ДатаИсключения) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияВнесенияВПеречень КАК ОснованияВключенияВПеречень
		|		ПО ВложенныйЗапрос.Объект = ОснованияВключенияВПеречень.Объект
		|			И ВложенныйЗапрос.ДатаОснованияВключения = ОснованияВключенияВПеречень.Период
		|			И (ОснованияВключенияВПеречень.Организация = &Организация)
		|			И (ОснованияВключенияВПеречень.Активность)
		|			И (ОснованияВключенияВПеречень.ВидПеречня = &ВидПеречня)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОснованияВнесенияВПеречень КАК ОснованияИсключенияИзПереченя
		|		ПО ВложенныйЗапрос.Объект = ОснованияИсключенияИзПереченя.Объект
		|			И ВложенныйЗапрос.ДатаИсключения = ОснованияИсключенияИзПереченя.Период
		|			И (ОснованияИсключенияИзПереченя.Организация = &Организация)
		|			И (ОснованияИсключенияИзПереченя.Активность)
		|			И (ОснованияИсключенияИзПереченя.ВидПеречня = &ВидПеречня)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка КАК Основание,
		|	МАКСИМУМ(ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник) КАК Сотрудник
		|ПОМЕСТИТЬ _СотрудникиИзОснований
		|ИЗ
		|	Документ.ВнесениеИзмененийВоВнутреннийПеречень.Основания КАК ВнесениеИзмененийВоВнутреннийПереченьОснования
		|ГДЕ
		|	ВнесениеИзмененийВоВнутреннийПереченьОснования.Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.)
		|	И ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	ВнесениеИзмененийВоВнутреннийПереченьОснования.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	&ДатаНачала КАК ДатаНачала,
		|	&ДатаОкончания КАК ДатаОкончания,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	""1 и 4"" КАК КатегорияИнсайдера,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН,
		|	ЕСТЬNULL(КонтактнаяИнформацияЮрАдрес.Представление, РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес) КАК ЮридическийАдрес,
		|	ЕСТЬNULL(КонтактнаяИнформацияФактАдрес.Представление, РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПочтовыйАдрес) КАК ПочтовыйАдрес,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Факсы КАК Факсы,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.EMail КАК EMail,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ВебСтраница КАК ВебСтраница,
		|	Ответственный.Фамилия + "" "" + Ответственный.Имя + "" "" + Ответственный.Отчество КАК Ответственный,
		|	&ВидПеречня КАК ВидПеречня
		|ПОМЕСТИТЬ _РеквизитыОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК КонтактнаяИнформацияЮрАдрес
		|		ПО (КонтактнаяИнформацияЮрАдрес.Объект = Организации.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдрес)) КАК КонтактнаяИнформацияФактАдрес
		|		ПО (КонтактнаяИнформацияФактАдрес.Объект = Организации.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ ПЕРВЫЕ 1
		|							Сотрудники.ЮрФизЛицо
		|						ИЗ
		|							Справочник.Сотрудники КАК Сотрудники
		|						ГДЕ
		|							Сотрудники.Ссылка = &Ответственный)) КАК Ответственный
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СписокОбъектовСОснованиями.Объект КАК Объект,
		|	ЕСТЬNULL(РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия + "" "" + РеквизитыСотрудниковОрганизацииСрезПоследних.Имя + "" "" + РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество, ЮрФизЛица.Наименование) КАК ФИО,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК Отчество,
		|	НАЧАЛОПЕРИОДА(ЕСТЬNULL(РеквизитыСотрудниковОрганизацииСрезПоследних.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) КАК ДатаРождения,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.МестоРождения КАК МестоРождения,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности,
		|	"""" КАК Телефон,
		|	"""" КАК EMail,
		|	"""" КАК АдресРегистрации,
		|	"""" КАК ПочтовыйАдрес,
		|	_СписокОбъектовСОснованиями.ДатаВключения КАК ДатаВключения,
		|	_СписокОбъектовСОснованиями.ОснованиеВключения КАК ОснованиеВключения,
		|	_СписокОбъектовСОснованиями.ОснованиеВключения КАК ОписаниеОснованияВключения,
		|	_СписокОбъектовСОснованиями.ДатаИсключения КАК ДатаИсключения,
		|	_СписокОбъектовСОснованиями.ОснованиеИсключения КАК ОснованиеИсключения,
		|	_СписокОбъектовСОснованиями.ОснованиеИсключения КАК ОписаниеОснованияИсключения,
		|	_СписокОбъектовСОснованиями.ОснованиеВключения.ОбъектИнсайдерскойИнформации.ПолноеНаименование КАК ОбъектИнсайдерскойИнформации,
		|	ВЫБОР
		|		КОГДА РеквизитыСотрудниковОрганизацииСрезПоследних.ЮрФизЛицо ЕСТЬ НЕ NULL 
		|			ТОГДА ""ФизическиеЛица_Строка""
		|		ИНАЧЕ ""ФизическиеЛица_Ошибка""
		|	КОНЕЦ КАК ИмяОбласти,
		|	ВЫБОР
		|		КОГДА РеквизитыСотрудниковОрганизацииСрезПоследних.ЮрФизЛицо ЕСТЬ NULL
		|			ТОГДА ""Отсутсвуют реквизиты сотрудника""
		|	КОНЕЦ КАК ОписаниеОшибки,
		|	_РеквизитыОрганизации.ПолноеНаименованиеОрганизации КАК ПолноеНаименованиеОрганизации,
		|	СотрудникиОрганизацииСрезПоследних.Должность КАК Должность,
		|	СотрудникиОрганизацииСрезПоследних.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ _ФизическиеЛица
		|ИЗ
		|	_СписокОбъектовСОснованиями КАК _СписокОбъектовСОснованиями
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
