// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Расчет минимальной достаточности",
		"0.33", 
		"", 
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#Область ЗаполнитьТабличныеДокументы

Процедура ЗаполнитьТабличныеДокументы(РезультатРасчетМинимальнойСуммыСС, РезультатСЧА, РезультатБалансоваяСтоимостьЮрЛиц, РезультатСтоимостьФЛ) Экспорт
	
	ВызватьИсключение "Эта версия отчёта не используется!";
	
	Отказ = Ложь;
	
	РезультатРасчетМинимальнойСуммыСС.Очистить();
	РезультатСЧА.Очистить();
	РезультатБалансоваяСтоимостьЮрЛиц.Очистить();
	РезультатСтоимостьФЛ.Очистить();
	
	ЗаполнитьДанныеОтчета(Отказ);
	
	Если Отказ Тогда
		ЭтотОбъект.ДанныеОтчета.Очистить();
		Возврат;
	КонецЕсли;
	
#Область РасчетМинимальнойСуммыСС
	
	ДанныеРасчета = Новый Структура("СуммаИФ,СуммаПН,СуммаПР,СуммаЖОВ,СуммаПФР,СуммаИпотПокр,СуммаФизЛица,СуммаЮрЛица,СуммаИтого,СуммаПревышения3млн,РасчетМинРазмераСС,МинРазмерСС");
	
	ОбластьРасчетМинимальнойСуммыСС = ПолучитьМакет("РасчетМинимальнойСуммыСС");
	
	ДанныеРасчета.СуммаИФ		= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
								+ ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов);
								
	ДанныеРасчета.СуммаПН		= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ДанныеРасчета.СуммаПР		= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	ДанныеРасчета.СуммаЖОВ		= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих);
	ДанныеРасчета.СуммаПФР		= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	ДанныеРасчета.СуммаИпотПокр	= 0; // нет таких
	
	ДанныеРасчета.СуммаФизЛица	= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица)
								+ ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
	
	ДанныеРасчета.СуммаЮрЛица	= ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица)
								+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
								+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ)
								+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний)
								+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний)
								+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов)
								+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов); 
	
	ДанныеРасчета.СуммаИтого			= ДанныеРасчета.СуммаИФ + ДанныеРасчета.СуммаПН + ДанныеРасчета.СуммаПР + ДанныеРасчета.СуммаЖОВ + ДанныеРасчета.СуммаПФР + ДанныеРасчета.СуммаИпотПокр + ДанныеРасчета.СуммаФизЛица + ДанныеРасчета.СуммаЮрЛица;
	ДанныеРасчета.СуммаПревышения3млн	= ДанныеРасчета.СуммаИтого - 3000000000;
	ДанныеРасчета.РасчетМинРазмераСС	= 20000000 + ДанныеРасчета.СуммаПревышения3млн * 0.0002;
	
	ДанныеРасчета.МинРазмерСС	= Мин(80000000, ДанныеРасчета.РасчетМинРазмераСС);
	
	ЗаполнитьЗначенияСвойств(ОбластьРасчетМинимальнойСуммыСС.Параметры, ДанныеРасчета);
	
	ОбластьРасчетМинимальнойСуммыСС.Параметры.ДатаОтчета = ЭтотОбъект.ДатаОтчета;
	РезультатРасчетМинимальнойСуммыСС.Вывести(ОбластьРасчетМинимальнойСуммыСС);
	
