								+ ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
								+ ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
								//+ ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний)
								//+ ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	
	РезультатСЧА.Вывести(ОбластьИтог);

#КонецОбласти

#Область БалансоваяСтоимостьЮрЛиц

	МакетБалансоваяСтоимостьЮрЛиц = ПолучитьМакет("БалансоваяСтоимостьЮрЛиц");
	
	ОбластьШапка	= МакетБалансоваяСтоимостьЮрЛиц.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= МакетБалансоваяСтоимостьЮрЛиц.ПолучитьОбласть("Строка");
	ОбластьИтог		= МакетБалансоваяСтоимостьЮрЛиц.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.ДатаОтчета = Формат(ЭтотОбъект.ДатаОтчета, "ДФ=dd.MM.yy");
	
	РезультатБалансоваяСтоимостьЮрЛиц.Вывести(ОбластьШапка);
	
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица);
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ);
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний);
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний);
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
	ВывестиСтроки(МакетБалансоваяСтоимостьЮрЛиц, РезультатБалансоваяСтоимостьЮрЛиц, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	
	ОбластьИтог.Параметры.Баланс	= ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица)
									+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
									+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ)
									+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний)
									+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний)
									+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов)
									+ ИтогПоВидуДоговораДУ("Баланс", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов);
	
	РезультатБалансоваяСтоимостьЮрЛиц.Вывести(ОбластьИтог);

#КонецОбласти

#Область СтоимостьФЛ

	МакетСтоимостьФЛ = ПолучитьМакет("СтоимостьФЛ");
	
	ОбластьШапка	= МакетСтоимостьФЛ.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= МакетСтоимостьФЛ.ПолучитьОбласть("Строка");
	ОбластьИтог		= МакетСтоимостьФЛ.ПолучитьОбласть("Итог");
	
	РезультатСтоимостьФЛ.Вывести(ОбластьШапка);
	
	ВывестиСтроки(МакетСтоимостьФЛ, РезультатСтоимостьФЛ, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
	ВывестиСтроки(МакетСтоимостьФЛ, РезультатСтоимостьФЛ, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);
	
	ОбластьИтог.Параметры.СЧА = ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
								+ ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица);
								
	РезультатСтоимостьФЛ.Вывести(ОбластьИтог);
	
#КонецОбласти	

#Область ПроверкаЧтоВсеДоговораПопалиВОтчёт

	ПараметрыПоиска = Новый Структура("УчтенВОтчете", Ложь);
	НайденныеСтроки = ЭтотОбъект.ДанныеОтчета.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда

		РезультатРасчетМинимальнойСуммыСС.Очистить();
		РезультатСЧА.Очистить();
		РезультатБалансоваяСтоимостьЮрЛиц.Очистить();
		РезультатСтоимостьФЛ.Очистить();
		
		НеУчтенныеВидыДоговоров = ЭтотОбъект.ДанныеОтчета.Скопировать(НайденныеСтроки, "ВидДоговораДоверительногоУправления");
		НеУчтенныеВидыДоговоров.Свернуть("ВидДоговораДоверительногоУправления");

		ВызватьИсключение "В отчёте не учтены виды договоров: " + СтрСоединить(НеУчтенныеВидыДоговоров.ВыгрузитьКолонку("ВидДоговораДоверительногоУправления"), ", ") + ". Формирование отчёта невозможно.";
		
	КонецЕсли;
	
#КонецОбласти

	РезультатРасчетМинимальнойСуммыСС.АвтоМасштаб = Ложь;
	РезультатСЧА.АвтоМасштаб = Ложь;
	РезультатБалансоваяСтоимостьЮрЛиц.АвтоМасштаб = Ложь;
	РезультатСтоимостьФЛ.АвтоМасштаб = Ложь;

КонецПроцедуры

Процедура ВывестиСтроки(Макет, Результат, Данные, ВидДоговора)
	
	НайденныеСтроки = Данные.НайтиСтроки(Новый Структура("ВидДоговораДоверительногоУправления", ВидДоговора));
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
КонецПроцедуры

Функция ИтогПоВидуДоговораДУ(Колонка, Данные, ВидДоговора)

	НайденныеСтроки = Данные.НайтиСтроки(Новый Структура("ВидДоговораДоверительногоУправления", ВидДоговора));
	
	Значение = 0;
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		Значение = Значение + СтрокаДанных[Колонка];
		СтрокаДанных.УчтенВОтчете = Истина;
	КонецЦикла;
	
	Возврат Значение;

КонецФункции
	
#КонецОбласти

#Область ЗаполнитьДанныеОтчета

Процедура ЗаполнитьДанныеОтчета(Отказ) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ЗаполнитьДанныеОтчета()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаОтчета,Организация");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Данные = РаботаСОтчетами.ДанныеДляРасчетаМинимальнойДостаточности(ЭтотОбъект.Организация, ЭтотОбъект.ДатаОтчета);

	Если Данные <> Неопределено Тогда
		ЭтотОбъект.ДанныеОтчета.Загрузить(Данные);
		ЭтотОбъект.ИтогиПоВидамДоговоров.Загрузить(Данные);
		ЭтотОбъект.ИтогиПоВидамДоговоров.Свернуть("ВидДоговораДоверительногоУправления", "СЧА,РСА,Баланс,КредиторскаяЗадолженность");
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Функция ПолучитьЗафиксированнуюБалансовуюСтоимость() Экспорт
	
	ЗафиксированнаяБалансоваяСтоимость = Новый ТаблицаЗначений;
	ЗафиксированнаяБалансоваяСтоимость.Колонки.Добавить("Период"						, Новый ОписаниеТипов("Дата"));
	ЗафиксированнаяБалансоваяСтоимость.Колонки.Добавить("СчетДоверительногоУправления"	, Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ЗафиксированнаяБалансоваяСтоимость.Колонки.Добавить("Сумма"							, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19,2)));
	
	МакетСДанными = ПолучитьМакет("ЗафиксированнаяБалансоваяСтоимость");
	
	Для НомерСтроки = 2 По МакетСДанными.ВысотаТаблицы Цикл
		НоваяСтрока = ЗафиксированнаяБалансоваяСтоимость.Добавить();
		
		НоваяСтрока.Период							= КонецДня(Дата(МакетСДанными.Область(НомерСтроки, 1, НомерСтроки, 1).Текст));
		НоваяСтрока.СчетДоверительногоУправления	= Справочники.СчетаДоверительногоУправления.ПолучитьСсылку(Новый УникальныйИдентификатор(МакетСДанными.Область(НомерСтроки, 4, НомерСтроки, 4).Текст));
		НоваяСтрока.Сумма							= МакетСДанными.Область(НомерСтроки, 5, НомерСтроки, 5).Текст;
		
	КонецЦикла;
	
	Возврат ЗафиксированнаяБалансоваяСтоимость;
	
КонецФункции
	
#КонецОбласти


