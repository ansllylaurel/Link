	ОбластьШапкаПИФ.Параметры.РСА = ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда) + ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов);
	
	РезультатСЧА.Вывести(ОбластьШапкаПИФ);
	
	ВывестиСтроки(МакетСЧА, РезультатСЧА, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	ВывестиСтроки(МакетСЧА, РезультатСЧА, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов);
	
	//ПФР
	ОбластьШапкаПФР = МакетСЧА.ПолучитьОбласть("ШапкаПФР");
	ОбластьШапкаПФР.Параметры.СЧА = ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	ОбластьШапкаПФР.Параметры.РСА = ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	
	РезультатСЧА.Вывести(ОбластьШапкаПФР);
	
	ВывестиСтроки(МакетСЧА, РезультатСЧА, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	
	//ПН
	ОбластьШапкаПН = МакетСЧА.ПолучитьОбласть("ШапкаПН");
	ОбластьШапкаПН.Параметры.СЧА = ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ОбластьШапкаПН.Параметры.РСА = ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	
	РезультатСЧА.Вывести(ОбластьШапкаПН);
	
	ВывестиСтроки(МакетСЧА, РезультатСЧА, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	
	//ПР
	ОбластьШапкаПР = МакетСЧА.ПолучитьОбласть("ШапкаПР");
	ОбластьШапкаПР.Параметры.СЧА = ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	ОбластьШапкаПР.Параметры.РСА = ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	
	РезультатСЧА.Вывести(ОбластьШапкаПР);
	
	ВывестиСтроки(МакетСЧА, РезультатСЧА, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	
	//Страховые
	//ОбластьШапкаСтраховые = МакетСЧА.ПолучитьОбласть("ШапкаСтраховые");
	//ОбластьШапкаСтраховые.Параметры.СЧА = ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний);
	//ОбластьШапкаСтраховые.Параметры.РСА = ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.УправлениеИмуществомСтраховыхКомпаний);
	
	//РезультатСЧА.Вывести(ОбластьШапкаСтраховые);
	//
	//ВывестиСтроки(МакетСЧА, РезультатСЧА, ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний);
	
	//СРО
	//ОбластьШапкаСРО = МакетСЧА.ПолучитьОбласть("ШапкаСРО");
	//ОбластьШапкаСРО.Параметры.СЧА = ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	//ОбластьШапкаСРО.Параметры.РСА = ИтогПоВидуДоговораДУ("РСА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций);
	
	//РезультатСЧА.Вывести(ОбластьШапкаСРО);
	
