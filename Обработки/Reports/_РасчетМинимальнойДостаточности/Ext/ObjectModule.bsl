	//Итог
	ОбластьИтог					= МакетСЧА.ПолучитьОбласть("Итог");
	ОбластьИтог.Параметры.СЧА	= ИтогПоВидуДоговораДУ("СЧА", ЭтотОбъект.ДанныеОтчета, Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
