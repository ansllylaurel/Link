			ОбластьИтог = Макет.ПолучитьОбласть("Итого");
			ОбластьИтогДень = Макет.ПолучитьОбласть("ИтогДень");
			ОбластьПериод = Макет.ПолучитьОбласть("Период");
			
			ОбластьИтог.Параметры.ВидОблигаций = ВидОблигаций;
			ОбластьИтог.Параметры.ПереоценкаКупона = Выборка.ПереоценкаКупона;
			ДокументРезультат.Вывести(ОбластьИтог);
			
			
			ВыборкаДни = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаДни.Следующий() Цикл
				
				ОбластьПериод.Параметры.Период = ВыборкаДни.Период;
				ДокументРезультат.Вывести(ОбластьПериод);
				ДокументРезультат.НачатьГруппуСтрок();
				
			    ДокументРезультат.Вывести(ОбластьЗаголовок);
				
				
				ВыборкаЦеннаяБумага = ВыборкаДни.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаЦеннаяБумага.Следующий() Цикл
					ЗаполнитьЗначенияСвойств(ОбластьЦБ.Параметры, ВыборкаЦеннаяБумага);
					ДокументРезультат.Вывести(ОбластьЦБ);
			
					ВыборкаПартия = ВыборкаЦеннаяБумага.Выбрать(ОбходРезультатаЗапроса.Прямой);
					Пока ВыборкаПартия.Следующий() Цикл 
						ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаПартия);
						ДокументРезультат.Вывести(ОбластьСтрока);				
					КонецЦикла;
				КонецЦикла;
				
				ЗаполнитьЗначенияСвойств(ОбластьИтогДень.Параметры, ВыборкаДни);
				ДокументРезультат.Вывести(ОбластьИтогДень);
				ДокументРезультат.ЗакончитьГруппуСтрок();
			КонецЦикла;
			
			ЕстьДанные = Истина;
		КонецЕсли;	
			
		//проверим, есть ли в РЕПО наш вид бумаг		
		ВыборкаРЕПО.Сбросить();
		Если ВыборкаРЕПО.НайтиСледующий(Раздел, "ВидОблигаций") Тогда 
			
			Если Не ЕстьДанные Тогда 
				// надо вывести Шапку
				ДокументРезультат = Новый ТабличныйДокумент;
				Макет = ПолучитьМакет("Отчет");
				ОбластьШапка = Макет.ПолучитьОбласть("Шапка");	
		
		
				ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
				ОбластьШапка.Параметры.ДатаДоговора	= Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
				ОбластьШапка.Параметры.НомерДоговора = ПараметрыШапки.НомерДоговора;
				ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(НачалоМесяца(ЭтотОбъект.Период.ДатаНачала), КонецМесяца(ЭтотОбъект.Период.ДатаОкончания), "ФП=Истина");
				ОбластьШапка.Параметры.ВидОблигаций = Выборка.ВидОблигацийКонецПериода;
		
				ДокументРезультат.Вывести(ОбластьШапка);
				
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка"+Добавка);
				ОбластьЦБ = Макет.ПолучитьОбласть("ЦеннаяБумага"+Добавка);
				
				ОбластьИтогДень = Макет.ПолучитьОбласть("ИтогДень");
				ОбластьПериод = Макет.ПолучитьОбласть("Период");
								
			КонецЕсли;	
			
				Добавка = "";
				Если Раздел = "Государственные" Тогда 
					ВидОблигаций = "Государственные и муниципальные облигации, проданные в РЕПО";
				ИначеЕсли Раздел = "Корпоративные пп 1 п. 4 ст. 284 НК РФ" Тогда 
					ВидОблигаций = "Корпоративные облигации, с процентным доходом, облагаемым по ставке в соответствии с пп 1 п. 4 ст. 284 НК РФ, проданные в РЕПО";
				ИначеЕсли Раздел = "Корпоративные п. 1 ст. 284 НК РФ" Тогда 
					ВидОблигаций = "Корпоративные облигации, с процентным доходом, облагаемым по ставке в соответствии с п. 1 ст. 284 НК РФ, проданные в РЕПО";
				ИначеЕсли Раздел = "Еврооблигации" Тогда 
