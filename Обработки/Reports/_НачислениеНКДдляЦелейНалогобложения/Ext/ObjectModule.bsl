	Возврат Настройки;

КонецФункции

Функция ПолучитьПараметрыШапки()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	&Период КАК ДатаОтчета,
		|	&ПоследнийРабочийДень КАК ПоследнийРабочийДень,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу, РеквизитыФизическихЛицКлиента.Фамилия + "" "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Имя, 1, 1) + "". "" + ПОДСТРОКА(РеквизитыФизическихЛицКлиента.Отчество, 1, 1) + ""."") КАК УчредительУправления
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицКлиента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
		
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания)));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
		
КонецФункции

Процедура СформироватьОтчет(ДокументРезультатГос,ДокументРезультатКорп20,ДокументРезультатКорп15,ДокументРезультатЕвро) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,Переоценка,Подписант");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	
    Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
	|	НастройкиПоВидуУчетаСрезПоследних.НачислятьПроцентныеДоходыПоВыводимымАктивам КАК НачислятьПроцентныеДоходыПоВыводимымАктивам
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&ПериодОтчета,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И УчетныйАктив В (&УчетныеАктивы)) КАК НастройкиУчетаАктивовСрезПоследних,
	|	РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
	|			&ПериодОтчета,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)) КАК НастройкиПоВидуУчетаСрезПоследних";
	
	Запрос.Параметры.Вставить("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.Параметры.Вставить("Организация", ЭтотОбъект.Организация);
	Запрос.Параметры.Вставить("ПериодОтчета", Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));	
	
	УчетныеАктивы = Новый Массив;
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	УчетныеАктивы.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
	Запрос.Параметры.Вставить("УчетныеАктивы", УчетныеАктивы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Настройки переодичности переоценки купона для разных видов активов различаются. Выполнение отчета превано");
		
		Если Сессия <> Неопределено Тогда
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		КонецЕсли;

		Возврат;
		
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ПериодичностьПереоценки = Перечисления.ПериодичностьПереоценкиАктивов.Ежедневно 
			ИЛИ Выборка.НачислятьПроцентныеДоходыПоВыводимымАктивам Тогда 
			СформироватьОтчетЕжедневный(ДокументРезультатГос,ДокументРезультатКорп20,ДокументРезультатКорп15,ДокументРезультатЕвро)
		Иначе
			СформироватьОтчетЗаПериод(ДокументРезультатГос,ДокументРезультатКорп20,ДокументРезультатКорп15,ДокументРезультатЕвро)
		КонецЕсли;	
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура СформироватьОтчетЕжедневный(ДокументРезультатГос,ДокументРезультатКорп20,ДокументРезультатКорп15,ДокументРезультатЕвро) 
	
	РазделыОтчета = Новый Массив;
	РазделыОтчета.Добавить("Государственные");
	РазделыОтчета.Добавить("Корпоративные пп 1 п. 4 ст. 284 НК РФ");
	РазделыОтчета.Добавить("Корпоративные п. 1 ст. 284 НК РФ");
	РазделыОтчета.Добавить("Еврооблигации");
	
	ДокументРезультатГос.Очистить();
	ДокументРезультатКорп20.Очистить();
	ДокументРезультатКорп15.Очистить();
	ДокументРезультатЕвро.Очистить();
		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК Аналитика
	|ПОМЕСТИТЬ _АналитикКупон
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон))) КАК НастройкиУчетаАктивовСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон))) КАК НастройкиУчетаАктивовСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
	|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон))) КАК НастройкиУчетаАктивовСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
