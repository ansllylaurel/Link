Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Начисление НКД для целей налогообложения",
		"2.36",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Подписант = НастройкиОтчета.Подписант.КонтактноеЛицо;
	
	//ОпределитьПереоценку();
	
	//Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Переоценка) Тогда    	
	//	ВызватьИсключение СтрШаблон("Нет переоценки на %1!", Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	//КонецЕсли;
	
	РезультатГос	= Новый ТабличныйДокумент;
	РезультатКорп20	= Новый ТабличныйДокумент;
	РезультатКорп15	= Новый ТабличныйДокумент;
	РезультатЕвро	= Новый ТабличныйДокумент;
	
	СформироватьОтчет(РезультатГос, РезультатКорп20, РезультатКорп15, РезультатЕвро);
	
	КнигаЭксель = Новый ПакетОтображаемыхДокументов;
	
	Элемент1 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(РезультатГос, Новый УникальныйИдентификатор));		
	Элемент1.Наименование = "Государственные";
	//с 1.1.2025 изменились налоговые ставки (15->20, 20->25)
	Элемент2 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(РезультатКорп20, Новый УникальныйИдентификатор));
	Элемент2.Наименование = "Корпоративные п. 1 ст. 284 НК РФ%";
		
	Элемент3 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(РезультатКорп15, Новый УникальныйИдентификатор));
	Элемент3.Наименование = "Корпоративные пп 1 п. 4 ст. 284 НК РФ";		
		
	Элемент4 = КнигаЭксель.Состав.Добавить(ПоместитьВоВременноеХранилище(РезультатЕвро, Новый УникальныйИдентификатор));
	Элемент4.Наименование = "Еврооблигации";		
		
	НастройкиОтчета.Вставить("Результат", КнигаЭксель);
		
КонецПроцедуры

Функция ОпределитьПереоценку() Экспорт
	
	ЭтотОбъект.Переоценка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПереоценкаЦенныхБумаг.Ссылка КАК Переоценка
		|ИЗ
		|	Документ.ПереоценкаЦенныхБумаг КАК ПереоценкаЦенныхБумаг
		|ГДЕ
		|	ПереоценкаЦенныхБумаг.Организация = &Организация
		|	И ПереоценкаЦенныхБумаг.СчетДоверительногоУправления = &СчетДУ
		|	И НАЧАЛОПЕРИОДА(ПереоценкаЦенныхБумаг.Дата, ДЕНЬ) = &Дата
		|	И ПереоценкаЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)";
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДУ",			ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата", 			НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЭтотОбъект.Переоценка = Выборка.Переоценка;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Нет переоценки на %1!", Формат(Запрос.Параметры.Дата, "ДФ=dd.MM.yyyy")));	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
