	Запрос.Параметры.Вставить("Рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));	
	
	Если ЭтотОбъект.Период.ДатаНачала >= Дата(2024, 11, 1) Тогда
		Запрос.Параметры.Вставить("УчитыватьСтрануРегистрации", Истина);
	Иначе
