			Если Раздел  = "Еврооблигации" Тогда 
				Добавка = "Е";
			Иначе
				Добавка = "";
			КонецЕсли;	
		
			ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
			ОбластьШапка.Параметры.ДатаДоговора	= Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
			ОбластьШапка.Параметры.НомерДоговора = ПараметрыШапки.НомерДоговора;
			ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(НачалоМесяца(ЭтотОбъект.Период.ДатаНачала), КонецМесяца(ЭтотОбъект.Период.ДатаОкончания), "ФП=Истина");
			ОбластьШапка.Параметры.ВидОблигаций = Выборка.ВидОблигацийКонецПериода;
		
			ДокументРезультат.Вывести(ОбластьШапка);
		
			ОбластьЗаголовок = Макет.ПолучитьОбласть("ЗаголовокТаблицы"+Добавка);
			ДокументРезультат.Вывести(ОбластьЗаголовок);
		
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка"+Добавка);
			ОбластьЦБ = Макет.ПолучитьОбласть("ЦеннаяБумага"+Добавка);
			ОбластьИтогВидОблигаций = Макет.ПолучитьОбласть("ИтогВидОблигаций"+Добавка);
		
			ВыборкаЦеннаяБумага = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЦеннаяБумага.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ОбластьЦБ.Параметры, ВыборкаЦеннаяБумага);
				ДокументРезультат.Вывести(ОбластьЦБ);
			
				ВыборкаПартия = ВыборкаЦеннаяБумага.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока ВыборкаПартия.Следующий() Цикл 
					ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаПартия);
					ДокументРезультат.Вывести(ОбластьСтрока);				
				КонецЦикла;
			КонецЦикла;	
		
			ЗаполнитьЗначенияСвойств(ОбластьИтогВидОблигаций.Параметры, Выборка);
			ДокументРезультат.Вывести(ОбластьИтогВидОблигаций);
			
			ЕстьДанные = Истина;
		КонецЕсли;	
			
		//проверим, есть ли в РЕПО наш вид бумаг		
		ВыборкаРЕПО.Сбросить();
		Если ВыборкаРЕПО.НайтиСледующий(Раздел, "ВидОблигацийКонецПериода") Тогда 
			
			Если Не ЕстьДанные Тогда 
				// надо вывести Шапку
				ДокументРезультат = Новый ТабличныйДокумент;
				Макет = ПолучитьМакет("Отчет");
				ОбластьШапка = Макет.ПолучитьОбласть("Шапка");	
		
				Если Раздел  = "Еврооблигации" Тогда 
					Добавка = "Е";
				Иначе
					Добавка = "";
				КонецЕсли;	
		
				ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
				ОбластьШапка.Параметры.ДатаДоговора	= Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
				ОбластьШапка.Параметры.НомерДоговора = ПараметрыШапки.НомерДоговора;
				ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(НачалоМесяца(ЭтотОбъект.Период.ДатаНачала), КонецМесяца(ЭтотОбъект.Период.ДатаОкончания), "ФП=Истина");
				ОбластьШапка.Параметры.ВидОблигаций = Выборка.ВидОблигацийКонецПериода;
		
				ДокументРезультат.Вывести(ОбластьШапка);
		
				ОбластьЗаголовок = Макет.ПолучитьОбласть("ЗаголовокТаблицы"+Добавка);
				ДокументРезультат.Вывести(ОбластьЗаголовок);
		
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка"+Добавка);
				ОбластьЦБ = Макет.ПолучитьОбласть("ЦеннаяБумага"+Добавка);
				ОбластьИтогВидОблигаций = Макет.ПолучитьОбласть("ИтогВидОблигаций"+Добавка);
				
			КонецЕсли;	
			
			ОбластьРаздел = Макет.ПолучитьОбласть("Раздел");	
			ДокументРезультат.Вывести(ОбластьРаздел);
			
			ВыборкаЦеннаяБумагаРЕПО = ВыборкаРЕПО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЦеннаяБумагаРЕПО.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ОбластьЦБ.Параметры, ВыборкаЦеннаяБумагаРЕПО);
				ДокументРезультат.Вывести(ОбластьЦБ);
				
				ВыборкаПартияРЕПО = ВыборкаЦеннаяБумагаРЕПО.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока ВыборкаПартияРЕПО.Следующий() Цикл 
					ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаПартияРЕПО);
					ДокументРезультат.Вывести(ОбластьСтрока);				
				КонецЦикла;
			КонецЦикла;	
			
			ЗаполнитьЗначенияСвойств(ОбластьИтогВидОблигаций.Параметры, ВыборкаРЕПО);
			ДокументРезультат.Вывести(ОбластьИтогВидОблигаций);	
			
			ЕстьДанные = Истина;
			
		КонецЕсли;	
		
		// Подписи	
		
		Если Не ЕстьДанные Тогда 
			//выведем шапку
			ДокументРезультат = Новый ТабличныйДокумент;
			Макет = ПолучитьМакет("Отчет");
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка");	
			
			Если Раздел  = "Еврооблигации" Тогда 
				Добавка = "Е";
			Иначе
				Добавка = "";
			КонецЕсли;	
			
			ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
			ОбластьШапка.Параметры.ДатаДоговора	= Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
			ОбластьШапка.Параметры.НомерДоговора = ПараметрыШапки.НомерДоговора;
			ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(НачалоМесяца(ЭтотОбъект.Период.ДатаНачала), КонецМесяца(ЭтотОбъект.Период.ДатаОкончания), "ФП=Истина");
			ОбластьШапка.Параметры.ВидОблигаций = Выборка.ВидОблигацийКонецПериода;
			
			ДокументРезультат.Вывести(ОбластьШапка);
			
			ОбластьЗаголовок = Макет.ПолучитьОбласть("ЗаголовокТаблицы"+Добавка);
			ДокументРезультат.Вывести(ОбластьЗаголовок);
						
		КонецЕсли;
		
		СтруктураКлюча = Новый Структура;
		СтруктураКлюча.Вставить("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
		СтруктураКлюча.Вставить("Язык", ПредопределенноеЗначение("Справочник.Языки.Русский"));
		СтруктураКлюча.Вставить("Объект", ЭтотОбъект.Организация);
		СтруктураКлюча.Вставить("КонтактноеЛицо", ЭтотОбъект.Подписант);
		
		СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча);
		
		ПараметрыВыводаПодписей = Новый Структура;
		ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
		ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
		
		Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
			ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
			ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
			ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
		КонецЕсли; 
		
		РаботаСОтчетами.ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей);		
					
		Если Раздел = "Государственные" Тогда 
			ДокументРезультатГос = ДокументРезультат;
		ИначеЕсли Раздел = "Корпоративные пп 1 п. 4 ст. 284 НК РФ" Тогда
			ДокументРезультатКорп15 = ДокументРезультат;
		ИначеЕсли Раздел = "Корпоративные п. 1 ст. 284 НК РФ" Тогда
			ДокументРезультатКорп20 = ДокументРезультат;
		ИначеЕсли Раздел = "Еврооблигации" Тогда
			ДокументРезультатЕвро = ДокументРезультат;
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	
