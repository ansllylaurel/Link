	ВыборкаРЕПО = РезультатЗапроса[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
		
	Для Каждого Раздел из РазделыОтчета Цикл 
		
		//РЕПО редкий зверь. Сделал отдельным запросом. 
		//проверяем наличие данных в обоих запросах. Если Данные есть, создаем таблицу
		
