Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет, "Справка о выплаченных инвестиционных доходах и дивидендах", "0.10", "", Истина);
		                                                                                             
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");

	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Подписант = НастройкиОтчета.Подписант.КонтактноеЛицо;
		
	ДокументРезультат	= Новый ТабличныйДокумент;
	Сформировать(ДокументРезультат);		
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
		
КонецПроцедуры

Функция ПолучитьПараметрыШапки()
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	|ПОМЕСТИТЬ _КлиентДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследнихРус.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставуРус,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследнихРус.ЮридическийАдрес КАК ЮридическийАдресРус,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследнихАнгл.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставуАнгл,
	|	РеквизитыЮридическихЛицАнкетныеСрезПоследнихАнгл.ЮридическийАдрес КАК ЮридическийАдресАнгл,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследнихРус.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследнихРус.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследнихРус.Отчество КАК ФИО_Рус,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследнихАнгл.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследнихАнгл.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследнихАнгл.Отчество КАК ФИО_Англ,
	|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
	|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора
	|ИЗ
	|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ЮрФизЛицо = &ЮрФизЛицо
	|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследнихРус,
	|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ЮрФизЛицо = &ЮрФизЛицо
	|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Английский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследнихАнгл,
	|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Английский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследнихАнгл
	|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицАнкетныеСрезПоследнихАнгл.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследнихРус
	|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыФизическихЛицАнкетныеСрезПоследнихРус.ЮрФизЛицо,
	|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	|ГДЕ
	|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.Организация.ЮрФизЛицо);
	
	РезультатЗапрос = Запрос.Выполнить();
	
	Возврат РезультатЗапрос;
		
КонецФункции	

Процедура Сформировать(ДокументРезультат) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,Подписант");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДокументРезультат.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
		|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК АналитикаДоходов
		|ПОМЕСТИТЬ _Аналитики
		|ИЗ
		|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|			&ДатаКонечная,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|				И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ПаиИностранныхЭмитентов), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов))) КАК НастройкиУчетаАктивовСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Обороты.Регистратор КАК Регистратор,
		|	Обороты.Субконто1 КАК ПрочиеДоходыРасходы,
		|	Обороты.Субконто2 КАК ЦенныеБумаги,
		|	Обороты.СуммаОборотКт КАК СуммаРуб,
		|	Обороты.ВалютнаяСуммаКорОборотКт КАК СуммаВал,
		|	ВЫБОР
		|		КОГДА Обороты.ВалютаКор = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &Рубль
		|		ИНАЧЕ Обороты.ВалютаКор
		|	КОНЕЦ КАК Валюта,
		|	ВЫБОР
		|		КОГДА Обороты.Субконто2 ССЫЛКА Справочник.Акции
		|			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА Обороты.Субконто2 ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(Обороты.Субконто2 КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК ЮрЛицо,
		|	НАЧАЛОПЕРИОДА(Обороты.Период, ДЕНЬ) КАК ДатаОперации
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет.Обороты(
		|			&ДатаНачальная,
		|			&ДатаКонечная,
		|			Регистратор,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеДоходы),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						_Аналитики.АналитикаДоходов КАК АналитикаДоходов
		|					ИЗ
		|						_Аналитики КАК _Аналитики),
		|			,
		|			) КАК Обороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.Сумма
		|			ИНАЧЕ -ЗадолженностиПоДенежнымСредствам.Сумма
		|		КОНЕЦ) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|				ТОГДА ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|			ИНАЧЕ -ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|		КОНЕЦ) КАК СуммаКупона,
		|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта
		|ПОМЕСТИТЬ _Задолженность
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.Регистратор В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_Данные.Регистратор КАК Регистратор
		|			ИЗ
		|				_Данные КАК _Данные)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствам.Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Валюта,
		|	ЗадолженностиПоДенежнымСредствам.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма,
		|	ЗадолженностиПоДенежнымСредствам.СуммаКупона КАК СуммаКупона
		|ПОМЕСТИТЬ _ЗадолженностьПоВозврату
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|	И ЗадолженностиПоДенежнымСредствам.Регистратор В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_Задолженность.Основание КАК Основание
		|			ИЗ
		|				_Задолженность КАК _Задолженность)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствам.Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Валюта,
		|	ЗадолженностиПоДенежнымСредствам.Основание,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.Сумма,
		|	ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Данные.ДатаОперации КАК ДатаОперации,
		|	ВЫБОР
		|		КОГДА _Данные.ЦенныеБумаги ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Interests/Проценты""
		|		ИНАЧЕ ""Dividends/Дивиденды""
		|	КОНЕЦ КАК ВидТранзакции,
		|	ВЫБОР
		|		КОГДА _Данные.ЦенныеБумаги ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Interests/Проценты""
		|		ИНАЧЕ ""Dividends/Дивиденды""
		|	КОНЕЦ КАК КатегорияДохода,
		|	_Данные.ЦенныеБумаги КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(_Данные.ЦенныеБумаги) = ТИП(Справочник.Акции)
		|			ТОГДА """" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Акции).Эмитент.Наименование) + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихISIN.Код, КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Код)
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Акции).ВалютаНоминала.Наименование
		|		КОГДА ТИПЗНАЧЕНИЯ(_Данные.ЦенныеБумаги) = ТИП(Справочник.Векселя)
		|			ТОГДА """" + ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование, ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Векселя).Эмитент.Наименование) + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Векселя).Номер <> """"
		|						ТОГДА ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Векселя).Номер
		|					ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихISIN.Код, КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Код)
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(_Данные.ЦенныеБумаги КАК Справочник.Векселя).ВалютаНоминала.Наименование
		|		КОГДА ТИПЗНАЧЕНИЯ(_Данные.ЦенныеБумаги) = ТИП(Справочник.ДепозитарныеРасписки)
