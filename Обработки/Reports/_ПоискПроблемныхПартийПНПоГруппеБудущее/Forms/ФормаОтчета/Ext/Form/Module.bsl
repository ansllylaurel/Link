
&НаСервере
Процедура СформироватьНаСервере()
	
	Период = ?(ЗначениеЗаполнено(ТекущаяДата()), ТекущаяДата(), Отчет.ДатаОтчета);
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");		
	
	СчетаДоверительногоУправления = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|	И ВЫБОР
		|			КОГДА &СчетДУ = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ СчетаДоверительногоУправления.Ссылка В (&СчетДУ)
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("СчетДУ", СчетДУ);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если БухгалтерскийУчетЕПС.ЭтоКлиентГруппыБудущее(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления, Период) Тогда
			СчетаДоверительногоУправления.Добавить(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);	
        КонецЕсли;
	КонецЦикла;
	
	Макет = ОтчетОбъект.ПолучитьМакет("Макет1");
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.Организация КАК Организация,
		|	ПРЕДСТАВЛЕНИЕ(БухПартииЦенныхБумагОстатки.Организация) КАК ОрганизацияПредставление,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ПРЕДСТАВЛЕНИЕ(БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления) КАК СчетДоверительногоУправленияПредставление,
		|	БухПартииЦенныхБумагОстатки.ВидУчета КАК ВидУчета,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.Партия, БухПартииЦенныхБумагОстатки.Партия) КАК Партия,
		|	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.Партия, БухПартииЦенныхБумагОстатки.Партия)) КАК ПартияПредставление,
		|	ЕСТЬNULL(РеклассификацияАктивовЕПСПартии.СтрокаПартии, БухПартииЦенныхБумагОстатки.СтрокаПартии) КАК СтрокаПартии,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ПРЕДСТАВЛЕНИЕ(БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС) КАК УчетныйАктивЕПСПредставление,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПРЕДСТАВЛЕНИЕ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага) КАК ЦеннаяБумагаПредставление,
		|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток КАК СтоимостьПокупки,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток КАК СтоимостьКупона,
		|	БухПартииЦенныхБумагОстатки.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток КАК РасходыПриПокупкеВСтоимости,
		|	БухПартииЦенныхБумаг.СтоимостьПокупки КАК СтоимостьПокупкиРеклассификация,
		|	БухПартииЦенныхБумаг.РасходыПриПокупкеВСтоимостиВВалютеУчета КАК РасходыПриПокупкеВСтоимостиРеклассификация,
		|	БухПартииЦенныхБумаг.Количество КАК КоличествоРеклассификация,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	БухПартииЦенныхБумаг.Партия.Дата КАК ПартияДатаРекласса
		|ПОМЕСТИТЬ ВТ_ТаблицаСРеклассом
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаОтчета,
		|			СчетДоверительногоУправления В (&СчетаДоверительногоУправления)
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И ВЫБОР
		|					КОГДА &ТолькоПроблемные
		|						ТОГДА НЕ(ТИПЗНАЧЕНИЯ(Партия) = ТИП(Документ.Сделка)
		|									ИЛИ ТИПЗНАЧЕНИЯ(Партия) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|									ИЛИ ТИПЗНАЧЕНИЯ(Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке))
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|			ПО РеклассификацияАктивовЕПСПартии.Партия = БухПартииЦенныхБумаг.Партия
		|				И (БухПартииЦенныхБумаг.СтрокаПартии = РеклассификацияАктивовЕПСПартии.СтрокаПартии)
		|				И (БухПартииЦенныхБумаг.СчетДоверительногоУправления = РеклассификацияАктивовЕПСПартии.Ссылка.СчетДоверительногоУправления)
		|				И (БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
		|				И (БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|				И (БухПартииЦенныхБумаг.Регистратор = РеклассификацияАктивовЕПСПартии.Ссылка)
		|		ПО БухПартииЦенныхБумагОстатки.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
		|			И БухПартииЦенныхБумагОстатки.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&ДатаОтчета, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаСРеклассом.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) = ТИП(Документ.Сделка)
		|			ТОГДА ВТ_ТаблицаСРеклассом.Партия
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|			ТОГДА ВЫРАЗИТЬ(ВТ_ТаблицаСРеклассом.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|			ТОГДА ВЫРАЗИТЬ(ВТ_ТаблицаСРеклассом.Партия КАК Документ.ПоставкаЦенныхБумаг).Основание
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Сделка,
		|	ВТ_ТаблицаСРеклассом.Организация КАК Организация,
		|	ВТ_ТаблицаСРеклассом.Партия КАК Партия
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	ВТ_ТаблицаСРеклассом КАК ВТ_ТаблицаСРеклассом
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) В (ТИП(Документ.Сделка), ТИП(Документ.ИсполнениеОбязательствПоСделке), ТИП(Документ.ПоставкаЦенныхБумаг))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Сделки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Сделки.Организация КАК Организация,
		|	СУММА(РасходыПоСделкеОбороты.СуммаОборот) КАК СуммаОборот,
		|	_Сделки.Партия КАК Партия
		|ПОМЕСТИТЬ _КомиссииПоСделкам
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыПоСделке.Обороты КАК РасходыПоСделкеОбороты
		|		ПО _Сделки.СчетДоверительногоУправления = РасходыПоСделкеОбороты.СчетДоверительногоУправления
		|			И _Сделки.Организация = РасходыПоСделкеОбороты.Организация
		|			И _Сделки.Сделка = РасходыПоСделкеОбороты.Сделка
		|			И (РасходыПоСделкеОбороты.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)))
		|
		|СГРУППИРОВАТЬ ПО
		|	_Сделки.Организация,
		|	_Сделки.СчетДоверительногоУправления,
		|	_Сделки.Партия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ТаблицаСРеклассом.Организация КАК Организация,
		|	ВТ_ТаблицаСРеклассом.ОрганизацияПредставление КАК ОрганизацияПредставление,
		|	ВТ_ТаблицаСРеклассом.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВТ_ТаблицаСРеклассом.СчетДоверительногоУправленияПредставление КАК СчетДоверительногоУправленияПредставление,
		|	ВТ_ТаблицаСРеклассом.ВидУчета КАК ВидУчета,
		|	ВТ_ТаблицаСРеклассом.Рынок КАК Рынок,
		|	ВТ_ТаблицаСРеклассом.Партия КАК Партия,
		|	ВТ_ТаблицаСРеклассом.ПартияПредставление КАК ПартияПредставление,
		|	ВТ_ТаблицаСРеклассом.СтрокаПартии КАК СтрокаПартии,
		|	ВТ_ТаблицаСРеклассом.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ВТ_ТаблицаСРеклассом.УчетныйАктивЕПСПредставление КАК УчетныйАктивЕПСПредставление,
		|	ВТ_ТаблицаСРеклассом.КоличествоОстаток КАК КоличествоОстаток,
		|	ВТ_ТаблицаСРеклассом.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВТ_ТаблицаСРеклассом.ЦеннаяБумагаПредставление КАК ЦеннаяБумагаПредставление,
		|	ВТ_ТаблицаСРеклассом.УчетныйАктивЕПС.Родитель КАК УчетныйАктивЕПСРодитель,
		|	ПРЕДСТАВЛЕНИЕ(ВТ_ТаблицаСРеклассом.УчетныйАктивЕПС.Родитель) КАК УчетныйАктивЕПСРодительПредставление,
		|	ВТ_ТаблицаСРеклассом.СтоимостьПокупки КАК СтоимостьПокупки,
		|	ВТ_ТаблицаСРеклассом.СтоимостьКупона КАК СтоимостьКупона,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_ТаблицаСРеклассом.РасходыПриПокупкеВСтоимости, 0) <> 0
		|			ТОГДА ВТ_ТаблицаСРеклассом.РасходыПриПокупкеВСтоимости
		|		ИНАЧЕ _КомиссииПоСделкам.СуммаОборот
		|	КОНЕЦ КАК РасходыПриПокупкеВСтоимостиДляТестирования,
		|	ЕСТЬNULL(_КомиссииПоСделкам.СуммаОборот, 0) КАК РасходыПриПокупкеВСтоимости,
		|	ВТ_ТаблицаСРеклассом.СтоимостьПокупкиРеклассификация КАК СтоимостьПокупкиРеклассификация,
		|	ВТ_ТаблицаСРеклассом.РасходыПриПокупкеВСтоимостиРеклассификация КАК РасходыПриПокупкеВСтоимостиРеклассификация,
		|	ВТ_ТаблицаСРеклассом.КоличествоРеклассификация КАК КоличествоРеклассификация,
		|	ЕСТЬNULL(ВТ_ТаблицаСРеклассом.Номинал, 0) КАК Номинал,
		|	ЕСТЬNULL(ВТ_ТаблицаСРеклассом.ЦеннаяБумага.Амортизационная, ЛОЖЬ) КАК Амортизационная,
		|	ВТ_ТаблицаСРеклассом.ПартияДатаРекласса КАК ПартияДатаРекласса,
		|	ВТ_ТаблицаСРеклассом.Партия.Дата КАК ПартияДата
		|ИЗ
		|	ВТ_ТаблицаСРеклассом КАК ВТ_ТаблицаСРеклассом
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КомиссииПоСделкам КАК _КомиссииПоСделкам
		|		ПО ВТ_ТаблицаСРеклассом.Организация = _КомиссииПоСделкам.Организация
		|			И ВТ_ТаблицаСРеклассом.СчетДоверительногоУправления = _КомиссииПоСделкам.СчетДоверительногоУправления
		|			И ВТ_ТаблицаСРеклассом.Партия = _КомиссииПоСделкам.Партия
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ТолькоПроблемные
		|				ТОГДА НЕ(ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) = ТИП(Документ.Сделка)
		|								ИЛИ ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) = ТИП(Документ.ПоставкаЦенныхБумаг)
		|								ИЛИ ТИПЗНАЧЕНИЯ(ВТ_ТаблицаСРеклассом.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке))
		|						ИЛИ ВТ_ТаблицаСРеклассом.УчетныйАктивЕПС.ВключатьРасходыПоПокупкеВСтоимость
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СчетаДоверительногоУправления);
	Запрос.УстановитьПараметр("ТолькоПроблемные", ТолькоПроблемные);
	Запрос.УстановитьПараметр("ДатаОтчета", Отчет.ДатаОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьПодвалТаблицы = Макет.ПолучитьОбласть("ПодвалТаблицы");
	ОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("Детали");
	
	Результат.Очистить();
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Организация");
	ТаблицаРезультата.Колонки.Добавить("ОрганизацияПредставление");
	ТаблицаРезультата.Колонки.Добавить("СчетДоверительногоУправления");
	ТаблицаРезультата.Колонки.Добавить("СчетДоверительногоУправленияПредставление");
	ТаблицаРезультата.Колонки.Добавить("Рынок");
	ТаблицаРезультата.Колонки.Добавить("Партия");
	ТаблицаРезультата.Колонки.Добавить("СтрокаПартии");
	ТаблицаРезультата.Колонки.Добавить("ПартияПредставление");
	ТаблицаРезультата.Колонки.Добавить("УчетныйАктивЕПС");
	ТаблицаРезультата.Колонки.Добавить("УчетныйАктивЕПСПредставление");
	ТаблицаРезультата.Колонки.Добавить("КоличествоОстаток");
	ТаблицаРезультата.Колонки.Добавить("ЦеннаяБумага");
	ТаблицаРезультата.Колонки.Добавить("ЦеннаяБумагаПредставление");
	ТаблицаРезультата.Колонки.Добавить("УчетныйАктивЕПСРодитель");
	ТаблицаРезультата.Колонки.Добавить("УчетныйАктивЕПСРодительПредставление");
	ТаблицаРезультата.Колонки.Добавить("СтоимостьПокупки");
	ТаблицаРезультата.Колонки.Добавить("СтоимостьКупона");
	ТаблицаРезультата.Колонки.Добавить("РасходыПриПокупкеВСтоимости");
	ТаблицаРезультата.Колонки.Добавить("Амортизационная");
	ТаблицаРезультата.Колонки.Добавить("Номинал");
