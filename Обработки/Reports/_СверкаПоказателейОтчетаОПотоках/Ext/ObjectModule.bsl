		|	СУММА(Иное)
		|ПО
		|	СтрокаОтчета,
		|	ЦеннаяБумага,
		|	Сделка"; 
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПериодНачало", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ПериодОкончание", ЭтотОбъект.Период.ДатаОкончания);
	
	Макет =  ПолучитьМакет("Отчет");	
	//шапка
	ПараметрыШапки = ПолучитьПараметрыШапки();	
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");	
	ОбластьШапка.Параметры.Заполнить(ПараметрыШапки);
	ОбластьШапка.Параметры.ДатаДоговора	= Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.НомерДоговора = ПараметрыШапки.НомерДоговора;
	ОбластьШапка.Параметры.ПериодОтчета = ПредставлениеПериода(НачалоМесяца(ЭтотОбъект.Период.ДатаНачала), КонецМесяца(ЭтотОбъект.Период.ДатаОкончания), "ФП=Истина");
	
	ДокРезультат.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьЦБ = Макет.ПолучитьОбласть("ЦеннаяБумага");
	ОбластьСделка = Макет.ПолучитьОбласть("Сделка");
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);    //
	//строки
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка,,"СтрокаОтчета");
		ОбластьСтрока.Параметры.СтрокаОтчета = ПолучитьОписаниеСтрокиОтчета(Выборка.СтрокаОтчета);
		ДокРезультат.Вывести(ОбластьСтрока);
		
		ДокРезультат.НачатьГруппуСтрок();
		ВыборкаЦБ = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаЦБ.Следующий() Цикл 
			
			ЗаполнитьЗначенияСвойств(ОбластьЦБ.Параметры, ВыборкаЦБ);
			ДокРезультат.Вывести(ОбластьЦБ);
			
			ВыборкаСделки = ВыборкаЦБ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			
			ДокРезультат.НачатьГруппуСтрок();
			Пока ВыборкаСделки.Следующий() Цикл 
				ЗаполнитьЗначенияСвойств(ОбластьСделка.Параметры, ВыборкаСделки);
				ДокРезультат.Вывести(ОбластьСделка);			
			КонецЦикла;	
			ДокРезультат.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		ДокРезультат.ЗакончитьГруппуСтрок();
	КонецЦикла;	
	
	ДокРезультат.ПоказатьУровеньГруппировокСтрок(0);
	
	Если Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
	
КонецПроцедуры	