				ВхСчетДоверительногоУправления, 
				НачалоДня(ДатаНачала) - 3600*24);
				
	Если ДатаСЧАНачало = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет СЧА на " + Формат(НачалоДня(ДатаНачала) - 3600*24, "ДФ=dd.MM.yyyy") + " у счета ДУ " + ВхСчетДоверительногоУправления );
		Возврат;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ДатаСЧАНачало", ДатаСЧАНачало);
	
	ДатаСЧАКонец = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
				ЭтотОбъект.Организация, 
				ВхСчетДоверительногоУправления, 
				НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
				
	Если ДатаСЧАКонец = Неопределено 
		ИЛИ НачалоДня(ДатаСЧАКонец) <> НачалоДня(ЭтотОбъект.Период.ДатаОкончания) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет СЧА на " + Формат(НачалоДня(ЭтотОбъект.Период.ДатаОкончания), "ДФ=dd.MM.yyyy")  + " у счета ДУ " + ВхСчетДоверительногоУправления );
