 
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о доходности по активам",
		"0.59",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьДатуПервогоВводаПоСчетуДУ(ВхОрганизация, ВхСчетДоверительногоУправления, ВхПериодОтчета) Экспорт
	
	Перем ДатаПервогоВвода;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НАЧАЛОПЕРИОДА(ВводыВыводы.Период, ДЕНЬ) КАК НачалоПериода
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводы
		|ГДЕ
		|	ВводыВыводы.Организация = &Организация
		|	И ВводыВыводы.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВводыВыводы.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВводыВыводы.Период";
	
	Запрос.УстановитьПараметр("Организация", ВхОрганизация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ВхСчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ДатаПервогоВвода = РезультатЗапроса.Выгрузить()[0].НачалоПериода;
	КонецЕсли;
	
	Если ДатаПервогоВвода = Неопределено и ВхСчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица и 
		ВхСчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет тогда
		ДатаПервогоВвода = НачалоГода(ВхПериодОтчета.ДатаНачала);
	КонецЕсли;
	
	Возврат ДатаПервогоВвода;
	
КонецФункции

Функция ПолучитьДатаНачалаОтчетаДляСчетаДУ(вхСчетДоверительногоУправления)
	
	ДатаПервогоВвода = ПолучитьДатуПервогоВводаПоСчетуДУ(ЭтотОбъект.Организация, вхСчетДоверительногоУправления, ЭтотОбъект.Период);
	Если ДатаПервогоВвода = Неопределено Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если ДатаПервогоВвода > ЭтотОбъект.Период.ДатаНачала Тогда
		ДатаНачала = ДатаПервогоВвода;
	Иначе
		ДатаНачала = ЭтотОбъект.Период.ДатаНачала;
	КонецЕсли;

	Возврат ДатаНачала;
	
КонецФункции

