	Запрос.УстановитьПараметр("ДатаСЧАКонец", ДатаСЧАКонец); 
	
	Запрос.Выполнить(); 
	
	Если ЭтотОбъект.КлючТекущегоВарианта = "Основной" Тогда 
		ПечатьВариантОсновной(ВхСчетДоверительногоУправления, ДатаНачала, Запрос, ДокументРезультат, ДнейОтчета);
	ИначеЕсли ЭтотОбъект.КлючТекущегоВарианта = "ДляУправляющих" 
		ИЛИ ЭтотОбъект.КлючТекущегоВарианта = "ДляУправляющих2" Тогда
		ПечатьВариантДляУправляющих(ВхСчетДоверительногоУправления, ДатаНачала, Запрос, ДокументРезультат, ДнейОтчета);
	КонецЕсли;	
	
	Если ЭтотОбъект.КлючТекущегоВарианта <> "ДляУправляющих2" Тогда 
		ПечатьРасшифровка(Запрос, ДокументРасшифровка, ДнейВГоду);
	КонецЕсли;
	
КонецПроцедуры	


Процедура ПечатьВариантОсновной(вхСчетДоверительногоУправления, ДатаНачала, Запрос, ДокументРезультат, ДнейОтчета)

#Область Запросик	
	Запрос.Текст =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВидыАктивов.Наименование КАК ВидАктива,
	|	_ИтоговаяТаблица.Группировка КАК ГруппировкаКод,
	|	_Группировки.Группировка КАК Группировка,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.Аналитика = 415
	|			ТОГДА _Аналитики.Аналитика + "", "" + _ИтоговаяТаблица.Валюта.Наименование
	|		ИНАЧЕ ЕСТЬNULL(_ПараметрыЦБ.ВидЦеннойБумаги, _Аналитики.Аналитика)
	|	КОНЕЦ КАК ВидЦеннойБумаги,
	|	ВЫБОР
	|		КОГДА НЕ _ИтоговаяТаблица.Группировка В (10, 20)
	|			ТОГДА _Аналитики.Аналитика
	|		КОГДА _ИтоговаяТаблица.Аналитика ССЫЛКА Справочник.Паи
	|			ТОГДА ЕСТЬNULL(РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда, """") + "", рег.номер "" + ВЫРАЗИТЬ(_ИтоговаяТаблица.Аналитика КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
	|		КОГДА _ИтоговаяТаблица.Аналитика ССЫЛКА Справочник.Акции
	|				И _ПараметрыЦБ.НомерВыпуска <> """"
	|			ТОГДА РеквизитыЭмитента.КраткоеНаименованиеПоУставу + "", "" + _ПараметрыЦБ.Тип + "", выпуск "" + _ПараметрыЦБ.НомерВыпуска
	|		КОГДА _ИтоговаяТаблица.Аналитика ССЫЛКА Справочник.Акции
	|				И _ПараметрыЦБ.НомерВыпуска <> """"
	|			ТОГДА РеквизитыЭмитента.КраткоеНаименованиеПоУставу + "", "" + _ПараметрыЦБ.Тип + "", ISIN "" + _ПараметрыЦБ.ISIN
	|		КОГДА _ИтоговаяТаблица.Аналитика ССЫЛКА Справочник.Облигации
	|				И _ПараметрыЦБ.Еврооблигация
	|			ТОГДА РеквизитыЭмитента.КраткоеНаименованиеПоУставу + "", ISIN "" + _ПараметрыЦБ.ISIN
	|		КОГДА _ПараметрыЦБ.НомерВыпуска = """"
	|			ТОГДА РеквизитыЭмитента.КраткоеНаименованиеПоУставу
	|		ИНАЧЕ РеквизитыЭмитента.КраткоеНаименованиеПоУставу + "", выпуск "" + _ПараметрыЦБ.НомерВыпуска
	|	КОНЕЦ КАК Аналитика,
	|	ЕСТЬNULL(_ПараметрыЦБ.КодММВБ, """") КАК КодММВБ,
	|	ЕСТЬNULL(_ПараметрыЦБ.РегНомер, """") КАК РегНомер,
	|	ЕСТЬNULL(_ПараметрыЦБ.ISIN, """") КАК ISIN,
	|	_ИтоговаяТаблица.Аналитика КАК АналитикаКод,
	|	_ИтоговаяТаблица.СуммаНачала КАК СуммаНачала,
	|	_ИтоговаяТаблица.СуммаСЧАНачала КАК СуммаСЧАНачала,
	|	_ИтоговаяТаблица.СуммаВводВывод КАК СуммаВводВывод,
	|	_ИтоговаяТаблица.СуммаПокупки КАК СуммаПокупки,
	|	_ИтоговаяТаблица.СуммаПродажи КАК СуммаПродажи,
	|	_ИтоговаяТаблица.СуммаПогашения КАК СуммаПогашения,
	|	_ИтоговаяТаблица.СуммаКонец КАК СуммаКонец,
	|	_ИтоговаяТаблица.СуммаСЧАКонец КАК СуммаСЧАКонец,
	|	_ИтоговаяТаблица.ДоходыРасходы КАК ДоходыРасходы,
	|	ЕСТЬNULL(_ДанныеДляДоходности.ДоходРасход, 0) КАК ДоходРасходРасчет,
	|	ЕСТЬNULL(_ДанныеДляДоходности.Расчет, 0) КАК Расчет,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.Аналитика В (420, 430, 440, 450, 460, 465, 470, 480)
	|			ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.СуммаНачала * &ДнейОтчета / &ДнейВГоду КАК ЧИСЛО(19, 2))
	|		КОГДА _ДанныеДляДоходности.Расчет ЕСТЬ НЕ NULL 
	|			ТОГДА ВЫРАЗИТЬ(_ДанныеДляДоходности.Расчет / &ДнейВГоду КАК ЧИСЛО(19, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СредневзвешеннаяСумма,
	|	ВЫБОР
	|		КОГДА _ДанныеДляДоходности.Расчет <> 0
	|			ТОГДА 100 * _ИтоговаяТаблица.ДоходыРасходы / (_ДанныеДляДоходности.Расчет / &ДнейВГоду)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Доходность
	|ИЗ
	|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеДляДоходности КАК _ДанныеДляДоходности
	|		ПО _ИтоговаяТаблица.Аналитика = _ДанныеДляДоходности.Аналитика
	|			И _ИтоговаяТаблица.ВидАктива = _ДанныеДляДоходности.ВидАктива
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Группировки КАК _Группировки
	|		ПО _ИтоговаяТаблица.Группировка = _Группировки.Порядок
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Аналитики КАК _Аналитики
	|		ПО _ИтоговаяТаблица.Аналитика = _Аналитики.КодАналитии
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ВидыАктивов КАК _ВидыАктивов
	|		ПО _ИтоговаяТаблица.ВидАктива = _ВидыАктивов.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ПараметрыЦБ КАК _ПараметрыЦБ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|					&КонецПериода,
	|					ЮрФизЛицо В
	|							(ВЫБРАТЬ
	|								_ПараметрыЦБ.Эмитент
	|							ИЗ
	|								_ПараметрыЦБ)
	|						И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
	|			ПО (РеквизитыЭмитента.ЮрФизЛицо = _ПараметрыЦБ.Эмитент)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(
	|					&КонецПериода,
	|					ПаевойИнвестиционныйФонд В
	|						(ВЫБРАТЬ
	|							_ПараметрыЦБ.Эмитент
	|						ИЗ
	|							_ПараметрыЦБ)) КАК РеквизитыПИФСрезПоследних
	|			ПО (РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд = _ПараметрыЦБ.Эмитент)
	|		ПО _ИтоговаяТаблица.Аналитика = _ПараметрыЦБ.Аналитика
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидАктива,
	|	ГруппировкаКод,
	|	АналитикаКод
	|ИТОГИ
	|	МАКСИМУМ(Группировка),
	|	СУММА(СуммаНачала),
	|	СУММА(СуммаСЧАНачала),
	|	СУММА(СуммаВводВывод),
	|	СУММА(СуммаПокупки),
	|	СУММА(СуммаПродажи),
	|	СУММА(СуммаПогашения),
	|	СУММА(СуммаКонец),
	|	СУММА(СуммаСЧАКонец),
	|	СУММА(ДоходыРасходы),
	|	СУММА(ДоходРасходРасчет),
	|	СУММА(Расчет),
	|	СУММА(СредневзвешеннаяСумма)
	|ПО
	|	ОБЩИЕ,
	|	ВидАктива,
	|	_Группировки.Порядок,
	|	ВидЦеннойБумаги
	|АВТОУПОРЯДОЧИВАНИЕ";
#КонецОбласти	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	Макет = ПолучитьМакет("Отчет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьГруппа = Макет.ПолучитьОбласть("Группа");
	ОбластьВидЦБ = Макет.ПолучитьОбласть("ГруппировкаВидЦБ");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");  
	ОбластьВидАктива = Макет.ПолучитьОбласть("ВидАктива"); 
	
		
	//шапка
	НаименованияКлиента = РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(вхСчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
		
	ОбластьШапка.Параметры.НомерДоговора	= вхСчетДоверительногоУправления.НомерДоговора;	
	ОбластьШапка.Параметры.ДатаДоговора		= Формат(вхСчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.ПериодОтчета 	= ПредставлениеПериода(ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, "ФП=Истина");
	ОбластьШапка.Параметры.ДнейОтчета 		= ДнейОтчета;
	
	ОбластьШапка.Параметры.УчредительУправления = НаименованияКлиента.КраткоеНаименование; 
	ОбластьШапка.Параметры.ДоверительныйУправляющий = ЭтотОбъект.Организация;

	ДокументРезультат.Вывести(ОбластьШапка); 
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаВидАктива = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВидАктива.Следующий() Цикл 
			
			ЗаполнитьЗначенияСвойств(ОбластьВидАктива.Параметры, ВыборкаВидАктива);
			Если ВыборкаВидАктива.СредневзвешеннаяСумма <> 0 Тогда 
				ОбластьВидАктива.Параметры.Доходность = Окр(ВыборкаВидАктива.ДоходыРасходы / ВыборкаВидАктива.СредневзвешеннаяСумма *100, 2);
			КонецЕсли;	
			ДокументРезультат.Вывести(ОбластьВидАктива);        
			
			
			ВыборкаГруппа = ВыборкаВидАктива.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаГруппа.Следующий() Цикл 
				
				ЗаполнитьЗначенияСвойств(ОбластьГруппа.Параметры, ВыборкаГруппа);
				Если НЕ (ВыборкаГруппа.СредневзвешеннаяСумма = 0 
					ИЛИ ВыборкаГруппа.Группировка = "денежные средства и расходы") Тогда 
					ОбластьГруппа.Параметры.Доходность = Окр(ВыборкаГруппа.ДоходыРасходы / ВыборкаГруппа.СредневзвешеннаяСумма *100, 2);
				КонецЕсли;	
				ДокументРезультат.Вывести(ОбластьГруппа);        
				
				ВыборкаВидЦБ = ВыборкаГруппа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаВидЦБ.Следующий() Цикл 
					ЗаполнитьЗначенияСвойств(ОбластьВидЦБ.Параметры, ВыборкаВидЦБ);      
					
					Если ВыборкаГруппа.Группировка = "по открытым позициям" 
						ИЛИ ВыборкаГруппа.Группировка = "по закрытым позициям" Тогда   
						
						Если ВыборкаВидЦБ.СредневзвешеннаяСумма <> 0 Тогда 
							ОбластьВидЦБ.Параметры.Доходность = Окр(ВыборкаВидЦБ.ДоходыРасходы / ВыборкаВидЦБ.СредневзвешеннаяСумма *100, 2);
						КонецЕсли;	
						ДокументРезультат.Вывести(ОбластьВидЦБ);  
						
					КонецЕсли;	
					
					ВыборкаРаздел = ВыборкаВидЦБ.Выбрать(ОбходРезультатаЗапроса.Прямой);
					//ДокументРезультат.НачатьГруппуСтрок();
					Пока ВыборкаРаздел.Следующий() Цикл 
						ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаРаздел); 
						Если СтрНачинаетсяС(ВыборкаРаздел.ВидЦеннойБумаги, "денежные средства в валюте") 
							ИЛИ СтрНачинаетсяС(ВыборкаРаздел.ВидЦеннойБумаги, "РЕПО")	Тогда 
							ОбластьСтрока.Параметры.Аналитика = ВыборкаРаздел.ВидЦеннойБумаги;
						КонецЕсли;					
						ДокументРезультат.Вывести(ОбластьСтрока);
						
					КонецЦикла;
					//ДокументРезультат.ЗакончитьГруппуСтрок();   
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		//итог
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, Выборка); 
		Если Выборка.СредневзвешеннаяСумма <> 0 Тогда 
			ОбластьИтог.Параметры.Доходность = Окр(Выборка.ДоходыРасходы / Выборка.СредневзвешеннаяСумма *100, 2);
		КонецЕсли;	
		ДокументРезультат.Вывести(ОбластьИтог);
	КонецЦикла;
	
	
	
КонецПроцедуры

Функция ПолучитьТаблицуКатегорий()
	
	ТипСтрока = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(25)); 
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Макет = ПолучитьМакет("ШаблонГруппировок");

	ОбластьЗаголовки = Макет.ПолучитьОбласть("Заголовки|Колонки");
	ОбластьДанные = Макет.ПолучитьОбласть("Строки|Колонки");
	
	
	Рез = Новый ТаблицаЗначений;  
	
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		НаименованиеКолонки = ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст; 
		Если НаименованиеКолонки = "Аналитика" Тогда
			Рез.Колонки.Добавить(НаименованиеКолонки, ТипЧисло);
		Иначе	
			Рез.Колонки.Добавить(НаименованиеКолонки, ТипСтрока);
		КонецЕсли;
	КонецЦикла;	

	Для индСтроки = 1 по КоличествоСтрок Цикл
		НоваяСтрока = Рез.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл
			ТекстЯчейки = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;
			НоваяСтрока[ИндКолонки-1] = ТекстЯчейки;
		КонецЦикла;		
	КонецЦикла;
	
	Возврат Рез;  
	
	//Таблица нужна только для того,чтобы отсортировать результирующий запрос.  
	// У активов ВС и СС своя нумерация. Но возьмем только СС. Для сортировки этого достаточно. 
	// В шаблоне составил полный перечень категорий
	// У группы код категории определяется в момент вывода. 
	
КонецФункции

Процедура ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьОсновная, ОбластьКБ)
	
	Если ЭтотОбъект.КлючТекущегоВарианта = "ДляУправляющих" Тогда 
		ДокументРезультат.Вывести(ОбластьОсновная);
	ИначеЕсли ЭтотОбъект.КлючТекущегоВарианта = "ДляУправляющих2" Тогда
		ДокументРезультат.Вывести(ОбластьКБ);
		ДокументРезультат.Присоединить(ОбластьОсновная);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПечатьВариантДляУправляющих(вхСчетДоверительногоУправления, ДатаНачала, Запрос, ДокументРезультат, ДнейОтчета)
	
	ТаблицаКатегорий = ПолучитьТаблицуКатегорий(); 
	Запрос.УстановитьПараметр("ВнешняяТаблица", ТаблицаКатегорий);
	
	// с дюрацией в отчете происходит следующий сюрреализм  
	// Значение дюрации для ценных бумаг берем с котировок. 
	// 1. У Акций дюрации нет  и слава богу. 
	// 2. Деньги, депозиты - Дюрация  = 0, но сумму по этим активам должны учесть при расчете дюрации по портфелю.
	// 3. Для облигаций с плавающим купоном, 
	//   - если дюрация < года, считаем ее равной 0.25
	//   - если дюрация >=года, тогда 1. 
