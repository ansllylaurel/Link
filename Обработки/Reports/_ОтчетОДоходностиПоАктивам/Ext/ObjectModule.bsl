Функция ПолучитьКодыБрокера(СписокСчетовДУ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.Брокер КАК Брокер,
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.Код КАК Код,
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ОсновнойБрокер КАК ОсновнойБрокер,
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания КАК ДоговорБрокерскогоОбслуживания
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров КАК РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.ОсновнойБрокер
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ТекущаяДата)
		|	И РегистрСведенийКодыСчетовДоверительногоУправленияУБрокеров.СчетДоверительногоУправления В(&СписокСчетовДУ)"; 
	
	Запрос.УстановитьПараметр("СписокСчетовДУ", СписокСчетовДУ);
	Запрос.УстановитьПараметр("ТекущаяДата", ЭтотОбъект.Период.ДатаОкончания);
	
	Результат = Запрос.Выполнить().Выгрузить(); 
	
	Возврат Результат;
	
КонецФункции

Процедура Сформировать(ДокументРезультат, ДокументРасшифровка, СписокСчетовДУ = Неопределено) Экспорт 

	Сессия = Неопределено;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();	
	
	Попытка
    	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
	КонецПопытки;	

	ДокументРезультат.Очистить();
	ДокументРасшифровка.Очистить();
	
	Если ЭтотОбъект.КлючТекущегоВарианта = "ДляУправляющих2" Тогда
		Для Каждого Элемемент из СписокСчетовДУ Цикл
			СчетДУ = Элемемент.Значение;
			ДатаНачала = ПолучитьДатаНачалаОтчетаДляСчетаДУ(СчетДУ);
			Если ДатаНачала = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет СЧА на " + Формат(НачалоДня(ДатаНачала) - 3600*24, "ДФ=dd.MM.yyyy") + " у счета ДУ " + СчетДУ + ". Счет ДУ пропущен");
				Продолжить;
			КонецЕсли;
			СформироватьПоСчетуДУ(СчетДУ, ДатаНачала, ДокументРезультат, ДокументРасшифровка); 
		КонецЦикла
	Иначе 
		ДатаНачала = ЭтотОбъект.Период.ДатаНачала; 
		СформироватьПоСчетуДУ(ЭтотОбъект.СчетДоверительногоУправления, ДатаНачала, ДокументРезультат, ДокументРасшифровка); 
	КонецЕсли;	
	
	Если Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
	
КонецПроцедуры

