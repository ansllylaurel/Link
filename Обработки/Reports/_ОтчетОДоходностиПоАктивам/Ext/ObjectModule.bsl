	|			ТОГДА ВЫРАЗИТЬ(_ДанныеДляДоходности.Расчет / &ДнейВГоду КАК ЧИСЛО(19, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СредневзвешеннаяСумма,
	|	ВЫБОР
	|		КОГДА _ДанныеДляДоходности.Расчет <> 0
	|			ТОГДА 100 * _ИтоговаяТаблица.ДоходыРасходы / (_ДанныеДляДоходности.Расчет / &ДнейВГоду)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Доходность,
	|	ЕСТЬNULL(_ЦеныНачало.ЦенаПроцент, ЕСТЬNULL(_ЦеныНачало.ЦенаРуб, 0)) КАК ЦенаНачало,
	|	ЕСТЬNULL(_ЦеныКонец.ЦенаПроцент, ЕСТЬNULL(_ЦеныКонец.ЦенаРуб, 0)) КАК ЦенаКонец,
	|	ЕСТЬNULL(_ЦеныКонец.ЦенаПроцент, ЕСТЬNULL(_ЦеныКонец.ЦенаРуб, 0)) - ЕСТЬNULL(_ЦеныНачало.ЦенаПроцент, ЕСТЬNULL(_ЦеныНачало.ЦенаРуб, 0)) КАК Переоценка,
	|	ЕСТЬNULL(_ЦеныКонец.Количество, 0) КАК Количество,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.Аналитика В (310, 320, 330, 410, 415)
	|			ТОГДА 0
	|		КОГДА _КатегорииЦБ.Категория В (""4.2"", ""5.2"", ""6.2"")
	|			ТОГДА ВЫБОР
	|					КОГДА (ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.DURATION, 0) / 365 КАК ЧИСЛО(10, 3))) < 1
	|						ТОГДА 0.25
	|					ИНАЧЕ 1
	|				КОНЕЦ
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.DURATION, 0) / 365 КАК ЧИСЛО(10, 3))
	|	КОНЕЦ КАК DURATION,
	|	_Котировки.YIELDCLOSE КАК YIELDCLOSE,
	|	ЕСТЬNULL(_ПараметрыЦБ.ВалютаНоминала, _ИтоговаяТаблица.Валюта) КАК Валюта,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.Аналитика В (310, 320, 330, 410, 415)
	|			ТОГДА 0
	|		КОГДА _КатегорииЦБ.Категория В (""4.2"", ""5.2"", ""6.2"")
	|			ТОГДА ВЫБОР
	|					КОГДА (ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.DURATION, 0) / 365 КАК ЧИСЛО(10, 3))) < 1
	|						ТОГДА 0.25
	|					ИНАЧЕ 1
	|				КОНЕЦ
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.DURATION, 0) / 365 КАК ЧИСЛО(10, 3))
	|	КОНЕЦ * _ИтоговаяТаблица.СуммаСЧАКонец КАК ПроизведениеДюрацииНаСумму,
	|	ВЫБОР
	|		КОГДА _ИтоговаяТаблица.Аналитика В (310, 320, 330, 410, 415)
	|			ТОГДА 0
	|		КОГДА _ИтоговаяТаблица.ВидАктива = ""АС""
	|			ТОГДА 0
	|		КОГДА _КатегорииЦБ.Категория В (""4.2"", ""5.2"", ""6.2"")
	|				И _ИтоговаяТаблица.ВидАктива = ""СС""
	|			ТОГДА ВЫБОР
	|					КОГДА (ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.DURATION, 0) / 365 КАК ЧИСЛО(10, 3))) < 1
	|						ТОГДА 0.25
	|					ИНАЧЕ 1
	|				КОНЕЦ
	|		ИНАЧЕ ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.DURATION, 0) / 365 КАК ЧИСЛО(10, 3))
	|	КОНЕЦ * _ИтоговаяТаблица.СуммаСЧАКонец КАК ПроизведениеДюрацииНаСуммуВсего,
	|	_ИтоговаяТаблица.СуммаСЧАКонец * (ВЫРАЗИТЬ(ЕСТЬNULL(_Котировки.YIELDCLOSE, 0) КАК ЧИСЛО(10, 3))) КАК ПроизведениеYIELDCLOSEНаСумму,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.Аналитика) = ТИП(Справочник.Облигации)
	|				ИЛИ _ИтоговаяТаблица.Аналитика В (310, 320, 330, 410, 415)
	|			ТОГДА _ИтоговаяТаблица.СуммаСЧАКонец
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаДляРасчетаДюрацииПоГруппировкам,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.Аналитика) = ТИП(Справочник.Облигации)
	|					И _ИтоговаяТаблица.ВидАктива = ""СС""
	|				ИЛИ _ИтоговаяТаблица.Аналитика В (310, 320, 330, 410, 415)
	|			ТОГДА _ИтоговаяТаблица.СуммаСЧАКонец
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаДляРасчетаДюрацииВсего,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_ПараметрыЦБ.ВалютаНоминала, _ИтоговаяТаблица.Валюта) = &ВалютаРубль
	|			ТОГДА ""1."" + ЕСТЬNULL(_КатегорииЦБ.Категория, _КатегорииПрочие.Категория)
	|		КОГДА ЕСТЬNULL(_ПараметрыЦБ.ВалютаНоминала, _ИтоговаяТаблица.Валюта) <> &ВалютаРубль
	|			ТОГДА ""2."" + ЕСТЬNULL(_КатегорииЦБ.Категория, _КатегорииПрочие.Категория)
	|		ИНАЧЕ 10
	|	КОНЕЦ КАК Категория
	|ИЗ
	|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеДляДоходности КАК _ДанныеДляДоходности
	|		ПО _ИтоговаяТаблица.Аналитика = _ДанныеДляДоходности.Аналитика
	|			И _ИтоговаяТаблица.ВидАктива = _ДанныеДляДоходности.ВидАктива
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Группировки КАК _Группировки
	|		ПО _ИтоговаяТаблица.Группировка = _Группировки.Порядок
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Аналитики КАК _Аналитики
	|		ПО _ИтоговаяТаблица.Аналитика = _Аналитики.КодАналитии
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ВидыАктивов КАК _ВидыАктивов
	|		ПО _ИтоговаяТаблица.ВидАктива = _ВидыАктивов.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ПараметрыЦБ КАК _ПараметрыЦБ
	|		ПО _ИтоговаяТаблица.Аналитика = _ПараметрыЦБ.Аналитика
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Категории КАК _КатегорииЦБ
	|		ПО (_ПараметрыЦБ.ГруппировкаУправляющего1 = _КатегорииЦБ.ГруппировкаУправляющего1)
	|			И (ЕСТЬNULL(_ПараметрыЦБ.ГруппировкаУправляющего2, """") = _КатегорииЦБ.ГруппировкаУправляющего2)
	|			И (ЕСТЬNULL(_ПараметрыЦБ.ГруппировкаУправляющего3, """") = _КатегорииЦБ.ГруппировкаУправляющего3)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Котировки КАК _Котировки
	|		ПО (_Котировки.ЦеннаяБумага = _ИтоговаяТаблица.Аналитика)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныНачалоИПокупки КАК _ЦеныНачало
	|		ПО (_ЦеныНачало.ЦеннаяБумага = _ИтоговаяТаблица.Аналитика)
	|			И (_ЦеныНачало.ВидАктива = _ИтоговаяТаблица.ВидАктива)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦеныКонец КАК _ЦеныКонец
	|		ПО (_ЦеныКонец.ЦеннаяБумага = _ИтоговаяТаблица.Аналитика)
	|			И (_ЦеныКонец.ВидАктива = _ИтоговаяТаблица.ВидАктива)
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Категории КАК _КатегорииПрочие
	|		ПО _ИтоговаяТаблица.Аналитика = _КатегорииПрочие.Аналитика
	|ГДЕ
	|	_Группировки.Порядок <> 20
	|
	|УПОРЯДОЧИТЬ ПО
	|	Категория,
	|	ВидАктива УБЫВ,
	|	АналитикаКод УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(ГруппировкаКод),
	|	СУММА(СуммаНачала),
	|	СУММА(СуммаСЧАНачала),
	|	СУММА(СуммаКонец),
	|	СУММА(СуммаСЧАКонец),
	|	СУММА(ДоходыРасходы),
	|	СУММА(ДоходРасходРасчет),
	|	СУММА(Расчет),
	|	СУММА(СредневзвешеннаяСумма),
	|	СУММА(ПроизведениеДюрацииНаСумму),
	|	СУММА(ПроизведениеДюрацииНаСуммуВсего),
	|	СУММА(ПроизведениеYIELDCLOSEНаСумму),
	|	СУММА(СуммаДляРасчетаДюрацииПоГруппировкам),
	|	СУММА(СуммаДляРасчетаДюрацииВсего)
	|ПО
	|	ОБЩИЕ,
	|	ВидАктива,
	|	Валюта,
	|	ГруппировкаУправляющего1,
	|	ГруппировкаУправляющего2,
	|	ГруппировкаУправляющего3
	|АВТОУПОРЯДОЧИВАНИЕ";
#КонецОбласти	
	
	Макет = ПолучитьМакет("ОтчетУправляющего");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка|Основная");
	
	ОбластьИтог = Макет.ПолучитьОбласть("Итог|Основная");
	ОбластьВалюта = Макет.ПолучитьОбласть("Валюта|Основная");
	ОбластьВидАктива = Макет.ПолучитьОбласть("ВидАктива|Основная");
	ОбластьГруппировкаУправляющего1 = Макет.ПолучитьОбласть("ГруппировкаУправляющего1|Основная");
	ОбластьГруппировкаУправляющего2 = Макет.ПолучитьОбласть("ГруппировкаУправляющего2|Основная");
	ОбластьГруппировкаУправляющего3 = Макет.ПолучитьОбласть("ГруппировкаУправляющего3|Основная");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка|Основная"); 
	
	//доп области с Номером договора. Не стал переименовывать. Первоначально был код брокера
	ОбластьШапкаКБ = Макет.ПолучитьОбласть("Шапка|Договор");
	ОбластьИтогКБ = Макет.ПолучитьОбласть("Итог|Договор");
	ОбластьВалютаКБ = Макет.ПолучитьОбласть("Валюта|Договор");
	ОбластьВидАктиваКБ = Макет.ПолучитьОбласть("ВидАктива|Договор");
	ОбластьГруппировкаУправляющего1КБ = Макет.ПолучитьОбласть("ГруппировкаУправляющего1|Договор");
	ОбластьГруппировкаУправляющего2КБ = Макет.ПолучитьОбласть("ГруппировкаУправляющего2|Договор");
	ОбластьГруппировкаУправляющего3КБ = Макет.ПолучитьОбласть("ГруппировкаУправляющего3|Договор");
	ОбластьСтрокаКБ = Макет.ПолучитьОбласть("Строка|Договор"); 
	
	//и сразу их заполним
	ОбластьШапкаКБ.Параметры.НомерДоговора = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьИтогКБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьВалютаКБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьВидАктиваКБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьГруппировкаУправляющего1КБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьГруппировкаУправляющего2КБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьГруппировкаУправляющего3КБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора;
	ОбластьСтрокаКБ.Параметры.НомерДоговора  = вхСчетДоверительногоУправления.НомерДоговора; 
		

	//шапка
	НаименованияКлиента = РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(вхСчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
		
	ОбластьШапка.Параметры.НомерДоговора	= вхСчетДоверительногоУправления.НомерДоговора;	
	ОбластьШапка.Параметры.ДатаДоговора		= Формат(вхСчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.ПериодОтчета 	= ПредставлениеПериода(ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, "ФП=Истина");
	ОбластьШапка.Параметры.ДнейОтчета 		= ДнейОтчета;
	
	ОбластьШапка.Параметры.УчредительУправления = НаименованияКлиента.КраткоеНаименование; 
	ОбластьШапка.Параметры.ДоверительныйУправляющий = ЭтотОбъект.Организация;
	
	ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьШапка, ОбластьШапкаКБ);
	
	Запрос.УстановитьПараметр("ММВБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	Пока Выборка.Следующий() Цикл 
		
		СуммаСЧА = Выборка.СуммаСЧАКонец;  
		Если СуммаСЧА = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У счета доверительного управления " + вхСчетДоверительногоУправления + " (" + вхСчетДоверительногоУправления.НомерДоговора +") сумма СЧА на конец отчета равна 0. Отчет по этому клиенту не будет построен" );
			Прервать;
		КонецЕсли;
		
		ВыборкаВидАктива = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВидАктива.Следующий() Цикл  
			
			ЗаполнитьЗначенияСвойств(ОбластьВидАктива.Параметры, ВыборкаВидАктива);
			Если ВыборкаВидАктива.СредневзвешеннаяСумма <> 0 Тогда 
				ОбластьВидАктива.Параметры.Доходность = Окр(ВыборкаВидАктива.ДоходыРасходы / ВыборкаВидАктива.СредневзвешеннаяСумма *100, 2); 
			КонецЕсли; 
			ОбластьВидАктива.Параметры.Доля = ВыборкаВидАктива.СуммаСЧАКонец / СуммаСЧА * 100;
			Если ВыборкаВидАктива.СуммаДляРасчетаДюрацииПоГруппировкам > 0 Тогда
				ОбластьВидАктива.Параметры.DURATION = ВыборкаВидАктива.ПроизведениеДюрацииНаСумму / ВыборкаВидАктива.СуммаДляРасчетаДюрацииПоГруппировкам;
			КонецЕсли;
			
			Если  ВыборкаВидАктива.ВидАктива = "Активы по справедливой стоимости" Тогда 
				Категория = "10";
			ИначеЕсли  ВыборкаВидАктива.ВидАктива = "Активы по амортизированной стоимости" Тогда
				Категория = "30";
			КонецЕсли;
			
			ОбластьВидАктива.Параметры.Категория = Категория; 
			ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьВидАктива, ОбластьВидАктиваКБ);
			
			ВыборкаВалюта = ВыборкаВидАктива.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаВалюта.Следующий() Цикл   
				
				Если ВыборкаВалюта.Валюта = ЭтотОбъект.Организация.ВалютаУчета
					И ВыборкаВалюта.ВидАктива = "Активы по справедливой стоимости" Тогда 
					КатегорияЗнак1 = "1";
					НаименованиеРаздела = "РУБЛЕВЫЕ АКТИВЫ";
				ИначеЕсли ВыборкаВалюта.Валюта = ЭтотОбъект.Организация.ВалютаУчета
					И ВыборкаВалюта.ВидАктива = "Активы по амортизированной стоимости" Тогда
					КатегорияЗнак1 = "3";
					НаименованиеРаздела = "РУБЛЕВЫЕ АКТИВЫ";
				ИначеЕсли ВыборкаВалюта.Валюта <> ЭтотОбъект.Организация.ВалютаУчета
					И ВыборкаВалюта.ВидАктива = "Активы по справедливой стоимости" Тогда 
					КатегорияЗнак1 = "2";
					НаименованиеРаздела = "АКТИВЫ (" + ВыборкаВалюта.Валюта.Наименование + ")";
				ИначеЕсли ВыборкаВалюта.Валюта <> ЭтотОбъект.Организация.ВалютаУчета
					И ВыборкаВалюта.ВидАктива = "Активы по амортизированной стоимости" Тогда 
					КатегорияЗнак1 = "4";
					НаименованиеРаздела = "АКТИВЫ (" + ВыборкаВалюта.Валюта.Наименование + ")";
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ОбластьВалюта.Параметры, ВыборкаВалюта);
				Если ВыборкаВалюта.СредневзвешеннаяСумма <> 0 Тогда 
					ОбластьВалюта.Параметры.Доходность = Окр(ВыборкаВалюта.ДоходыРасходы / ВыборкаВалюта.СредневзвешеннаяСумма *100, 2);
				КонецЕсли;	
				ОбластьВалюта.Параметры.Доля = ВыборкаВалюта.СуммаСЧАКонец / СуммаСЧА * 100;
				Если ВыборкаВалюта.СуммаДляРасчетаДюрацииПоГруппировкам > 0 Тогда
					ОбластьВалюта.Параметры.DURATION = ВыборкаВалюта.ПроизведениеДюрацииНаСумму / ВыборкаВалюта.СуммаДляРасчетаДюрацииПоГруппировкам;
				КонецЕсли;    		
				ОбластьВалюта.Параметры.Категория = КатегорияЗнак1;
				ОбластьВалюта.Параметры.Валюта = НаименованиеРаздела;
				ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьВалюта, ОбластьВалютаКБ);
				
				ВыборкаГруппировкаУправляющего1 =  ВыборкаВалюта.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока  ВыборкаГруппировкаУправляющего1.Следующий() Цикл
					ЗаполнитьЗначенияСвойств(ОбластьГруппировкаУправляющего1.Параметры, ВыборкаГруппировкаУправляющего1); 
					Если ЗначениеЗаполнено(ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1) Тогда
						Если ВыборкаГруппировкаУправляющего1.СредневзвешеннаяСумма <> 0 Тогда 
							ОбластьГруппировкаУправляющего1.Параметры.Доходность = Окр(ВыборкаГруппировкаУправляющего1.ДоходыРасходы / ВыборкаГруппировкаУправляющего1.СредневзвешеннаяСумма *100, 2);
						КонецЕсли;
						ОбластьГруппировкаУправляющего1.Параметры.Доля = ВыборкаГруппировкаУправляющего1.СуммаСЧАКонец / СуммаСЧА * 100;
						Если ВыборкаГруппировкаУправляющего1.СуммаДляРасчетаДюрацииПоГруппировкам > 0 Тогда
							ОбластьГруппировкаУправляющего1.Параметры.DURATION = ВыборкаГруппировкаУправляющего1.ПроизведениеДюрацииНаСумму / ВыборкаГруппировкаУправляющего1.СуммаДляРасчетаДюрацииПоГруппировкам;
						КонецЕсли;
						Если ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Деньги" Тогда
							КатегорияЗнак2 = "3";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Депозиты" Тогда
							КатегорияЗнак2 = "2";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Акции" Тогда
							КатегорияЗнак2 = "1";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "ОФЗ"
							И ВыборкаГруппировкаУправляющего1.ВидАктива = "Активы по справедливой стоимости" Тогда
							КатегорияЗнак2 = "4";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "ОФЗ"
							И ВыборкаГруппировкаУправляющего1.ВидАктива = "Активы по амортизированной стоимости" Тогда
							КатегорияЗнак2 = "1";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Корпоративные" 
							И ВыборкаГруппировкаУправляющего1.ВидАктива = "Активы по справедливой стоимости" Тогда
							КатегорияЗнак2 = "5";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Корпоративные"
							И ВыборкаГруппировкаУправляющего1.ВидАктива = "Активы по амортизированной стоимости" Тогда
							КатегорияЗнак2 = "2";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Муниципальные"
							И ВыборкаГруппировкаУправляющего1.ВидАктива = "Активы по справедливой стоимости"  Тогда
							КатегорияЗнак2 = "6";
						ИначеЕсли ВыборкаГруппировкаУправляющего1.ГруппировкаУправляющего1 = "Муниципальные"
							И ВыборкаГруппировкаУправляющего1.ВидАктива = "Активы по амортизированной стоимости" Тогда
							КатегорияЗнак2 = "3";
						КонецЕсли;
						ОбластьГруппировкаУправляющего1.Параметры.Категория = КатегорияЗнак1 + "." + КатегорияЗнак2;
						ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьГруппировкаУправляющего1, ОбластьГруппировкаУправляющего1КБ);
					КонецЕсли;  
					
					ВыборкаГруппировкаУправляющего2 =  ВыборкаГруппировкаУправляющего1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока  ВыборкаГруппировкаУправляющего2.Следующий() Цикл
						ЗаполнитьЗначенияСвойств(ОбластьГруппировкаУправляющего2.Параметры, ВыборкаГруппировкаУправляющего2); 
						Если ЗначениеЗаполнено(ВыборкаГруппировкаУправляющего2.ГруппировкаУправляющего2) Тогда 
							Если ВыборкаГруппировкаУправляющего2.СредневзвешеннаяСумма <> 0 Тогда 
								ОбластьГруппировкаУправляющего2.Параметры.Доходность = Окр(ВыборкаГруппировкаУправляющего2.ДоходыРасходы / ВыборкаГруппировкаУправляющего2.СредневзвешеннаяСумма *100, 2);
							КонецЕсли;
							ОбластьГруппировкаУправляющего2.Параметры.Доля = ВыборкаГруппировкаУправляющего2.СуммаСЧАКонец / СуммаСЧА * 100;
							Если ВыборкаГруппировкаУправляющего2.ГруппировкаУправляющего2 = "с фиксированным купоном" Тогда
								КатегорияЗнак3 = "1";
							ИначеЕсли ВыборкаГруппировкаУправляющего2.ГруппировкаУправляющего2 = "с плавающим купоном" Тогда
								КатегорияЗнак3 = "2";
							КонецЕсли; 
							Если ВыборкаГруппировкаУправляющего2.СуммаДляРасчетаДюрацииПоГруппировкам > 0 Тогда
								ОбластьГруппировкаУправляющего2.Параметры.DURATION = ВыборкаГруппировкаУправляющего2.ПроизведениеДюрацииНаСумму / ВыборкаГруппировкаУправляющего2.СуммаДляРасчетаДюрацииПоГруппировкам;
							КонецЕсли; 
							Если ВыборкаГруппировкаУправляющего2.СуммаДляРасчетаДюрацииПоГруппировкам > 0 
								И КатегорияЗнак3 = "1" Тогда   // этот показатель считаем только для облигаций с фиксированным купоном
								ОбластьГруппировкаУправляющего2.Параметры.YIELDCLOSE = ВыборкаГруппировкаУправляющего2.ПроизведениеYIELDCLOSEНаСумму / ВыборкаГруппировкаУправляющего2.СуммаДляРасчетаДюрацииПоГруппировкам;
							КонецЕсли; 

							ОбластьГруппировкаУправляющего2.Параметры.Категория = КатегорияЗнак1 + "." + КатегорияЗнак2 + "." + КатегорияЗнак3;
							ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьГруппировкаУправляющего2, ОбластьГруппировкаУправляющего2КБ);
						КонецЕсли;	
						
						ВыборкаГруппировкаУправляющего3 =  ВыборкаГруппировкаУправляющего2.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока  ВыборкаГруппировкаУправляющего3.Следующий() Цикл
							ЗаполнитьЗначенияСвойств(ОбластьГруппировкаУправляющего3.Параметры, ВыборкаГруппировкаУправляющего3);
							Если ЗначениеЗаполнено(ВыборкаГруппировкаУправляющего3.ГруппировкаУправляющего3) Тогда
								Если ВыборкаГруппировкаУправляющего3.СредневзвешеннаяСумма <> 0 Тогда 
									ОбластьГруппировкаУправляющего3.Параметры.Доходность = Окр(ВыборкаГруппировкаУправляющего3.ДоходыРасходы / ВыборкаГруппировкаУправляющего3.СредневзвешеннаяСумма *100, 2);
								КонецЕсли;
								ОбластьГруппировкаУправляющего3.Параметры.Доля = ВыборкаГруппировкаУправляющего3.СуммаСЧАКонец / СуммаСЧА * 100;
								Если ВыборкаГруппировкаУправляющего3.СуммаДляРасчетаДюрацииПоГруппировкам > 0 Тогда
									ОбластьГруппировкаУправляющего3.Параметры.DURATION = ВыборкаГруппировкаУправляющего3.ПроизведениеДюрацииНаСумму / ВыборкаГруппировкаУправляющего3.СуммаДляРасчетаДюрацииПоГруппировкам;
								КонецЕсли;       
								Если ВыборкаГруппировкаУправляющего3.СуммаДляРасчетаДюрацииПоГруппировкам > 0 
									И КатегорияЗнак3 = "1" Тогда   // этот показатель считаем только для облигаций с фиксированным купоном
									ОбластьГруппировкаУправляющего3.Параметры.YIELDCLOSE = ВыборкаГруппировкаУправляющего3.ПроизведениеYIELDCLOSEНаСумму / ВыборкаГруппировкаУправляющего3.СуммаДляРасчетаДюрацииПоГруппировкам;
								КонецЕсли; 
								
								Если ВыборкаГруппировкаУправляющего3.ГруппировкаУправляющего3 = "до 3 лет" Тогда
									КатегорияЗнак4 = "1";
								ИначеЕсли ВыборкаГруппировкаУправляющего3.ГруппировкаУправляющего3 = "свыше 3 лет" Тогда
									КатегорияЗнак4 = "2";
								ИначеЕсли ВыборкаГруппировкаУправляющего3.ГруппировкаУправляющего3 = "от 3 до 5 лет" Тогда
									КатегорияЗнак4 = "2";
								ИначеЕсли ВыборкаГруппировкаУправляющего3.ГруппировкаУправляющего3 = "свыше 5 лет" Тогда
									КатегорияЗнак4 = "3";
								КонецЕсли; 
								ОбластьГруппировкаУправляющего3.Параметры.Категория = КатегорияЗнак1 + "." + КатегорияЗнак2 + "." + КатегорияЗнак3 + "." + КатегорияЗнак4;
								
								ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьГруппировкаУправляющего3, ОбластьГруппировкаУправляющего3КБ);
							КонецЕсли;
							
							ВыборкаАналитика =  ВыборкаГруппировкаУправляющего3.Выбрать(ОбходРезультатаЗапроса.Прямой);
							Пока  ВыборкаАналитика.Следующий() Цикл
								ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаАналитика); 
								ОбластьСтрока.Параметры.Доля = ВыборкаАналитика.СуммаСЧАКонец / СуммаСЧА * 100;  
								ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьСтрока, ОбластьСтрокаКБ);
							КонецЦикла;
						КонецЦикла;
					КонецЦикла;
				КонецЦикла; 
			КонецЦикла;
		КонецЦикла;
		
		//итого 
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, Выборка); 
		Если Выборка.СредневзвешеннаяСумма <> 0 Тогда 
			ОбластьИтог.Параметры.Доходность = Окр(Выборка.ДоходыРасходы / Выборка.СредневзвешеннаяСумма *100, 2);
		КонецЕсли;
		ОбластьИтог.Параметры.Доля = Выборка.СуммаСЧАКонец / СуммаСЧА * 100;
		Если Выборка.СуммаДляРасчетаДюрацииВсего > 0 Тогда
			ОбластьИтог.Параметры.DURATION = Выборка.ПроизведениеДюрацииНаСуммуВсего / Выборка.СуммаДляРасчетаДюрацииВсего;
		КонецЕсли;
		ВывестиОбластьВариантУправляющего(ДокументРезультат, ОбластьИтог, ОбластьИтогКБ);
		
	КонецЦикла;	
	
КонецПроцедуры     

Процедура ПечатьРасшифровка(Запрос, ДокументРасшифровка, ДнейВГоду)

	//расшифровка
	МакетРасшифрока = ПолучитьМакет("Расшифровка");
	
	ОбластьАктив = МакетРасшифрока.ПолучитьОбласть("Актив");
	ОбластьОперации = МакетРасшифрока.ПолучитьОбласть("Операции");
	ОбластьДоходность = МакетРасшифрока.ПолучитьОбласть("Доходность");
	ОбластьВидАктива = МакетРасшифрока.ПолучитьОбласть("ВидАктива");

#Область Запросец
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВидыАктивов.Наименование КАК ВидАктива,
		|	_Потоки.Порядок КАК Порядок,
		|	_Потоки.Период КАК Период,
		|	ЕСТЬNULL(_Аналитики.Аналитика, _Потоки.Аналитика) КАК Аналитика,
		|	_Потоки.Сумма КАК ДоходРасход,
		|	_Потоки.Дней КАК Дней,
		|	_Потоки.Сумма * _Потоки.Дней КАК Расчет,
		|	_Потоки.Операция КАК Операция,
		|	_Потоки.Документ КАК Документ,
		|	ВЫБОР
		|		КОГДА _Потоки.Валюта = &ВалютаРубль
		|			ТОГДА """"
		|		ИНАЧЕ _Потоки.Валюта
		|	КОНЕЦ КАК Валюта,
		|	ВЫБОР
		|		КОГДА _Потоки.Валюта = &ВалютаРубль
		|			ТОГДА """"
		|		ИНАЧЕ _Потоки.СуммаВал
		|	КОНЕЦ КАК СуммаВал,
		|	ВЫБОР
		|		КОГДА _Потоки.Валюта = &ВалютаРубль
		|			ТОГДА """"
		|		ИНАЧЕ _Потоки.Курс
		|	КОНЕЦ КАК Курс
		|ИЗ
		|	_Потоки КАК _Потоки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Аналитики КАК _Аналитики
		|		ПО _Потоки.Аналитика = _Аналитики.КодАналитии
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВидыАктивов КАК _ВидыАктивов
		|		ПО _Потоки.ВидАктива = _ВидыАктивов.Код
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидАктива,
		|	Порядок,
		|	Период,
		|	Аналитика
		|ИТОГИ
		|	СУММА(ДоходРасход),
		|	СУММА(Расчет)
		|ПО
		|	ВидАктива,
		|	Порядок,
		|	Аналитика
		|АВТОУПОРЯДОЧИВАНИЕ";
	
#КонецОбласти	
	ВыборкаАктивы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаАктивы.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОбластьВидАктива.Параметры, ВыборкаАктивы);
		ДокументРасшифровка.Вывести(ОбластьВидАктива); 
		ДокументРасшифровка.НачатьГруппуСтрок(, Ложь);
		
		ВыборкаПорядок = ВыборкаАктивы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
		Пока ВыборкаПорядок.Следующий() Цикл       //порядок. не обрабатываем группировку
			
			ВыборкаРаздел = ВыборкаПорядок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			
			Пока ВыборкаРаздел.Следующий() Цикл
				ЗаполнитьЗначенияСвойств(ОбластьАктив.Параметры, ВыборкаРаздел); 
				ДокументРасшифровка.Вывести(ОбластьАктив);
				ДокументРасшифровка.НачатьГруппуСтрок(, Ложь);
				
				ВыборкаОперации = ВыборкаРаздел.Выбрать(ОбходРезультатаЗапроса.Прямой);
				Пока ВыборкаОперации.Следующий() Цикл 
					ЗаполнитьЗначенияСвойств(ОбластьОперации.Параметры, ВыборкаОперации); 
					ДокументРасшифровка.Вывести(ОбластьОперации);
				КонецЦикла;
				
				// по деньгам доход/расход считается только по оплатам комиссии. 
				//Если ВыборкаРаздел.ДоходРасходДеньги = 0 Тогда  
				СуммаДоходРасход = ВыборкаРаздел.ДоходРасход;
				//Иначе	
				//	СуммаДоходРасход = ВыборкаРаздел.ДоходРасходДеньги;
				//КонецЕсли;	
				
				ОбластьДоходность.Параметры.ДоходРасход = СуммаДоходРасход;
				ОбластьДоходность.Параметры.Расчет = ВыборкаРаздел.Расчет;
				ОбластьДоходность.Параметры.Средневзвес = Окр(ВыборкаРаздел.Расчет/ДнейВГоду, 2);
				Если ВыборкаРаздел.Расчет <> 0 Тогда 
					ОбластьДоходность.Параметры.Доходность = Окр(СуммаДоходРасход / (ВыборкаРаздел.Расчет/ДнейВГоду)*100, 2);
				КонецЕсли;	
				ДокументРасшифровка.Вывести(ОбластьДоходность);
				ДокументРасшифровка.ЗакончитьГруппуСтрок();
			КонецЦикла;
		КонецЦикла; 
