// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Отчет.ПоказательБУ = Истина;
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ЗаполнитьРегистрыБухгалтерии(ЭтаФорма);
	
	РаботаСБухгалтерскимиОтчетами.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
		
	УправлениеФормой(ЭтаФорма);
	
	Параметры.Свойство("НастройкиОтчета", ЭтаФорма.НастройкиОтчета);
	
	РаботаСОтчетами.ЗаполнитьВариантОтчета(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьТекстЗаголовка(ЭтаФорма);

	ПодключитьОбработчикОжидания = ЗначениеЗаполнено(ИдентификаторЗадания);
	Если ПодключитьОбработчикОжидания Тогда
		РаботаСДлительнымиОперациямиКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "ФормированиеОтчета");
	КонецЕсли;
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПриОткрытии(ЭтаФорма, Отказ);

	//КлючеваяОперация = ПредопределенноеЗначение("Справочник.КлючевыеОперации.ФормированиеОтчетаОборотноСальдоваяВедомость");
	
	скИзменитьСтруктуруОтчетаКлиент(Ложь);
	
	Элементы.Подписант.Видимость = ЭтаФорма.ВыводитьПодвал;
	
	Если Не ЗначениеЗаполнено(Подписант)
		ИЛИ Не РаботаСОтчетамиКлиентСервер.ПроверитьНастройкиПодписантаОтчета(Отчет, Подписант, Отчет.Организация)  	
	Тогда
		РаботаСОтчетамиКлиентСервер.ЗаполнитьПодписанта(ЭтаФорма, Отчет.Организация); 		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПередЗакрытием(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	РаботаСДлительнымиОперациямиКлиент.ОтменитьВыполнениеЗаданияПередЗакрытиемФормы(ИдентификаторЗадания, Отказ, ЗавершениеРаботы, ТекстПредупреждения);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)

	РаботаСБухгалтерскимиОтчетами.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	Настройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал", ЭтаФорма.ВыводитьПодвал);

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки, ИспользуютсяСтандартныеНастройки)

	Если ТипЗнч(ЭтаФорма.НастройкиОтчета) = Тип("Структура") 
		И ЭтаФорма.НастройкиОтчета.Свойство("ВариантОтчета") 
		И ТипЗнч(ЭтаФорма.НастройкиОтчета.ВариантОтчета) = Тип("УникальныйИдентификатор") Тогда
	
		ВариантОтчета = Справочники.ВариантыОтчетов.ПолучитьСсылку(ЭтаФорма.НастройкиОтчета.ВариантОтчета);
		Настройки = ВариантОтчета.Настройки.Получить();
		
	КонецЕсли; 
	
	РаботаСБухгалтерскимиОтчетами.ПриЗагрузкеПользовательскихНастроекНаСервере(ЭтаФорма, Настройки);

	ОбновитьТекстЗаголовка(ЭтаФорма);
	
	УправлениеФормой(ЭтаФорма);

	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	КонецЕсли;
	
	скИзменитьСтруктуруОтчета();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетныйРегистрПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеАктуальность");
	КонецЕсли;
	
	скИзменитьСтруктуруОтчетаКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура скИзменитьСтруктуруОтчетаКлиент(ИзменитьСтруктуруОтчетаНаСервере = Истина)
	
	Если ИзменитьСтруктуруОтчетаНаСервере Тогда 
		скИзменитьСтруктуруОтчета();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура скИзменитьСтруктуруОтчета()
	
	СхемаКомпоновкиДанныхОбъект = РеквизитФормыВЗначение("Отчет").СхемаКомпоновкиДанных;
	
	Если СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.Найти("ПоСчетам") <> Неопределено Тогда 
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос = СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос, "БухгалтерскийУчет", Отчет.УчетныйРегистр);
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос, "ОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,", 	"");
		
		СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос = 
		СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос, "(ЛицевойСчет).* КАК ЛицевойСчет,", 	"");	
		
		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда		 		
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос, "	ОстаткиИОбороты.Счет КАК Счет,", 	"ОстаткиИОбороты.Счет КАК Счет, ВЫРАЗИТЬ (ОстаткиИОбороты.ЛицевойСчет КАК Справочник.ЛицевыеСчета) КАК ЛицевойСчет,");		
			
			СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос = 
			СтрЗаменить(СхемаКомпоновкиДанныхОбъект.НаборыДанных.НаборДанныхОбъединение.Элементы.ПоСчетам.Запрос, "(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления,", 	"(СчетДоверительногоУправления).* КАК СчетДоверительногоУправления, (ЛицевойСчет).* КАК ЛицевойСчет,");		
			
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОбъект, УникальныйИдентификатор);
		
		Отчет.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	КонецЕсли;
		
	
	// Удаление нового измерения из отборов и группировок
	Если Отчет.УчетныйРегистр <> "ЕдиныйБухгалтерскийУчет" Тогда
		
		// Отборы
		УдалитьЗначенияОтборов_Рекурс(Отчет.КомпоновщикНастроек.Настройки.Отбор);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура УдалитьЗначенияОтборов_Рекурс(ГруппаЭлементовОтбора)
	
	МассивЭлементовКУдалению = Новый Массив;
		
	Для Каждого ЭлементОтбора Из ГруппаЭлементовОтбора.Элементы Цикл 
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда 
			УдалитьЗначенияОтборов_Рекурс(ЭлементОтбора);
		Иначе 
			Если СтрЧислоВхождений(Строка(ЭлементОтбора.ЛевоеЗначение) ,"ЛицевойСчет") > 0 Тогда 	
				МассивЭлементовКУдалению.Добавить(ЭлементОтбора);	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого УдаляемыйЭлемент Из МассивЭлементовКУдалению Цикл 
		ГруппаЭлементовОтбора.Элементы.Удалить(УдаляемыйЭлемент);
	КонецЦикла;
	
	Если ГруппаЭлементовОтбора.Элементы.Количество() = 0  
		И ТипЗнч(ГруппаЭлементовОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")  
		И ГруппаЭлементовОтбора.Родитель <> Неопределено Тогда 
		ГруппаЭлементовОтбора.Родитель.Элементы.Удалить(ГруппаЭлементовОтбора);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Отчет.Организация, Подписант));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = Неопределено;	
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛица(ВыбранноеЗначение, Отчет.Организация);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("РегистрСведенийКлючЗаписи.КонтактныеЛица") Тогда
		СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	КонецЕсли;	
		
	Если Не РаботаСОтчетамиКлиентСервер.ПроверитьСтруктуруДанныхКонтактногоЛица(СтруктураДанныхКонтактногоЛица) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбрано некорректное значение!");
		ВыбранноеЗначение = Неопределено;
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
	
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(ЭтаФорма.Подписант) Тогда
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура АвтоматическоеФормирование() Экспорт

	ЗаполнитьЗначенияСвойств(Отчет, ЭтаФорма.НастройкиОтчета);
	
	Отчет.НачалоПериода = ЭтаФорма.НастройкиОтчета.Период.ДатаНачала; 
	Отчет.КонецПериода = ЭтаФорма.НастройкиОтчета.Период.ДатаОкончания; 
	
	ЭтаФорма.Подписант = ЭтаФорма.НастройкиОтчета.Подписант.КонтактноеЛицо;
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", ЭтаФорма.НастройкиОтчета.Подписант);
	
	АвтоматическоеФормированиеНаСервере();
	
	РаботаСОтчетамиКлиент.АвтоматическоеФормированиеОтчета(ЭтаФорма, ЭтаФорма.Результат);
	
	Если РаботаСОтчетамиКлиент.ТребуетсяОткрытьФорму(ЭтаФорма.НастройкиОтчета) Тогда	
		УправлениеФормой(ЭтаФорма);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура АвтоматическоеФормированиеНаСервере()

	АдресХранилища = ПоместитьВоВременноеХранилище("", УникальныйИдентификатор);
	ДополнительныеСвойства = Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьЗаголовок", ВыводитьЗаголовок);
	Отчет.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ВыводитьПодвал"   , ВыводитьПодвал);

	ПараметрыОтчета = ПодготовитьПараметрыОтчета();
	//РаботаСБухгалтерскимиОтчетами.СформироватьОтчет(ПараметрыОтчета, АдресХранилища);
	СформироватьОтчетМодуль(ПараметрыОтчета, АдресХранилища);
	ЗагрузитьПодготовленныеДанные();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетаНаСервере(Детализации)
	
	Если Отчет.УчетныйРегистр = "БухгалтерскийУчет" ИЛИ Отчет.УчетныйРегистр = "НалоговыйУчет" Тогда
		ТекстЗапроса = "ВЫБРАТЬ ПланСчетов.Ссылка КАК Счет ИЗ ПланСчетов.Основной КАК ПланСчетов УПОРЯДОЧИТЬ ПО ПланСчетов.Код";
	ИначеЕсли Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ПланСчетов.Ссылка КАК Счет
		               |ИЗ
		               |	ПланСчетов.Единый КАК ПланСчетов
		               |ГДЕ
		               |	ПланСчетов.Родитель <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ПустаяСсылка)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ПланСчетов.Код";
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выберите правильный учетный регистр!");
		Возврат;
	КонецЕсли;
	
	Отчет.Группировка.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеСчета = ПолучитьСвойстваСчета(ВыборкаДетальныеЗаписи.Счет);
		
		Если ДанныеСчета.КоличествоСубконто = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаГруппировка = Отчет.Группировка.Добавить();
		
		СтрокаГруппировка.Использование = Истина;
		СтрокаГруппировка.Счет = ВыборкаДетальныеЗаписи.Счет;
		СтрокаГруппировка.ПоСубсчетам = Истина;
		
		СтрокаПоСубконто    = "";
		СтрокаПредставление = "";
			
		Если ДанныеСчета.КоличествоСубконто > 0 Тогда
			Для Индекс = 1 По ДанныеСчета.КоличествоСубконто Цикл
				СтрокаПоСубконто    = СтрокаПоСубконто + "+" + Индекс;
				СтрокаПредставление = СтрокаПредставление + ДанныеСчета["ВидСубконто" + Индекс + "Наименование"] + ", ";
			КонецЦикла;
			СтрокаПредставление = Лев(СтрокаПредставление, СтрДлина(СтрокаПредставление) - 2);
		КонецЕсли;
		Если Отчет.УчетныйРегистр = "ЕдиныйБухгалтерскийУчет" Тогда
			Если ТипЗнч(Детализации) = Тип("Структура") Тогда
				Если Детализации.ЛицевойСчет Тогда
					СтрокаПоСубконто	= СтрокаПоСубконто		+ "+Л";
					СтрокаПредставление	= СтрокаПредставление	+ ",ЛицевойСчет";
				КонецЕсли;
				Если Лев(ВыборкаДетальныеЗаписи.Счет.Код, 1) = "5" ИЛИ Лев(ВыборкаДетальныеЗаписи.Счет.Код, 1) = "7" ИЛИ Лев(ВыборкаДетальныеЗаписи.Счет.Код, 3) = "106" Тогда
					Если Детализации.Партия Тогда
						СтрокаПоСубконто	= СтрокаПоСубконто		+ "+П";
						СтрокаПредставление	= СтрокаПредставление	+ ",Партия";
					КонецЕсли;
					Если Детализации.СтрокаПартии Тогда
						СтрокаПоСубконто	= СтрокаПоСубконто		+ "+С";
						СтрокаПредставление	= СтрокаПредставление	+ ",СтрокаПартии";
					КонецЕсли;
					Если Детализации.ДополнительнаяАналитика Тогда
						СтрокаПоСубконто	= СтрокаПоСубконто		+ "+Д";
						СтрокаПредставление	= СтрокаПредставление	+ ",ДополнительнаяАналитика";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		СтрокаГруппировка.ПоСубконто    = СтрокаПоСубконто;
		СтрокаГруппировка.Представление = СтрокаПредставление;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСчета(Команда)
	
	Детализации = ОткрытьФормуМодально("ВнешнийОтчет._ОборотноСальдоваяВедомостьПоПартиям.Форма.ФормаДополительныхДетализацийСчетов");
	ЗаполнитьСчетаНаСервере(Детализации);
	
КонецПроцедуры
