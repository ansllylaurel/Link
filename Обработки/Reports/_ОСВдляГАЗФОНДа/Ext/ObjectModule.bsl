// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"ОСВ для ГАЗФОНДа",
		"0.23",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СформироватьОтчет(ДокументРезультат, НастройкиОтчета.Подписант);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

#Область ДанныеБухУчета

Функция ПолучитьТаблицуСчетов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Родитель КАК СчетРодитель,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет КАК Счет,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Родитель.Код КАК СчетРодительКод,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Код КАК СчетКод,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СуммаНачальныйОстатокДт,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДт,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКт,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Наименование КАК СчетНаименование,
		|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Счет.Родитель.Наименование КАК СчетРодительНаименование
		|ПОМЕСТИТЬ ОстаткиСчета
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			,
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИСТИНА КАК Субсчет,
		|	ОстаткиСчета.Счет КАК Счет,
		|	ОстаткиСчета.СчетКод КАК СчетКод,
		|	ОстаткиСчета.СуммаНачальныйОстатокДт КАК СНД,
		|	ОстаткиСчета.СуммаНачальныйОстатокКт КАК СНК,
		|	ОстаткиСчета.СуммаОборотДт КАК ДО,
		|	ОстаткиСчета.СуммаОборотКт КАК КО,
		|	ОстаткиСчета.СуммаКонечныйОстатокДт КАК СКД,
		|	ОстаткиСчета.СуммаКонечныйОстатокКт КАК СКК,
		|	ОстаткиСчета.СчетНаименование КАК СчетНаименование
		|ИЗ
		|	ОстаткиСчета КАК ОстаткиСчета
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	ОстаткиСчета.СчетРодитель,
		|	ОстаткиСчета.СчетРодительКод,
		|	СУММА(ОстаткиСчета.СуммаНачальныйОстатокДт),
		|	СУММА(ОстаткиСчета.СуммаНачальныйОстатокКт),
		|	СУММА(ОстаткиСчета.СуммаОборотДт),
		|	СУММА(ОстаткиСчета.СуммаОборотКт),
		|	СУММА(ОстаткиСчета.СуммаКонечныйОстатокДт),
		|	СУММА(ОстаткиСчета.СуммаКонечныйОстатокКт),
		|	ОстаткиСчета.СчетРодительНаименование
		|ИЗ
		|	ОстаткиСчета КАК ОстаткиСчета
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиСчета.СчетРодитель,
		|	ОстаткиСчета.СчетРодительКод,
		|	ОстаткиСчета.СчетРодительНаименование
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛОЖЬ,
		|	""Итого"",
		|	""Итого"",
		|	СУММА(ОстаткиСчета.СуммаНачальныйОстатокДт),
		|	СУММА(ОстаткиСчета.СуммаНачальныйОстатокКт),
		|	СУММА(ОстаткиСчета.СуммаОборотДт),
		|	СУММА(ОстаткиСчета.СуммаОборотКт),
		|	СУММА(ОстаткиСчета.СуммаКонечныйОстатокДт),
		|	СУММА(ОстаткиСчета.СуммаКонечныйОстатокКт),
		|	""Итого""
		|ИЗ
		|	ОстаткиСчета КАК ОстаткиСчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетКод";
	
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(ЭтотОбъект.Период.ДатаНачала), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ВывестиПоСчету(Результат, Счет, ОбластьАналитика)

	ДанныеСчета = БухгалтерскийУчет.ПолучитьСвойстваСчета(Счет);
	
	Если ЭтотОбъект.ПоСубконто Тогда
	
		Если ДанныеСчета.КоличествоСубконто = 0 Тогда
			Возврат;
		ИначеЕсли ДанныеСчета.КоличествоСубконто = 1 Тогда
			СтрокаИтогов = "Субконто1";
		ИначеЕсли ДанныеСчета.КоличествоСубконто = 2 Тогда
			СтрокаИтогов = "Субконто1,Субконто2";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто1 КАК Субконто1,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто2 КАК Субконто2,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СНД,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СНК,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт КАК ДО,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт КАК КО,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СКД,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СКК
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			Период,
			|			ДвиженияИГраницыПериода,
			|			Счет = &Счет,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
			|
			|УПОРЯДОЧИТЬ ПО
			|	Субконто1,
			|	Субконто2
			|ИТОГИ
			|	СУММА(СНД),
			|	СУММА(СНК),
			|	СУММА(ДО),
			|	СУММА(КО),
			|	СУММА(СКД),
			|	СУММА(СКК)
			|ПО
			|	" + СтрокаИтогов;
		
		
		Если ДанныеСчета.КоличествоСубконто = 1 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕдиныйБухгалтерскийУчетОстаткиИОбороты.Субконто2 КАК Субконто2,", "");
		КонецЕсли;
		
		Если НЕ ЭтотОбъект.ПоЛицевымСчетам Тогда
		    Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,", "");
		КонецЕсли;
		
	Иначе // только лицевики
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СНД,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СНК,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотДт КАК ДО,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаОборотКт КАК КО,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СКД,
			|	ЕдиныйБухгалтерскийУчетОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СКК
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОстаткиИОбороты(
			|			&НачалоПериода,
			|			&ОкончаниеПериода,
			|			Период,
			|			ДвиженияИГраницыПериода,
			|			Счет = &Счет,
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстаткиИОбороты
			|
			|УПОРЯДОЧИТЬ ПО
			|	ЛицевойСчет";
		
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(ЭтотОбъект.Период.ДатаНачала), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОкончаниеПериода", Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Счет", Счет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если ЭтотОбъект.ПоСубконто Тогда
	
		ВыборкаСубконто1 = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаСубконто1.Следующий() Цикл
			
			ВывестиПоАналитике(Результат, ВыборкаСубконто1, ВыборкаСубконто1.Субконто1, ОбластьАналитика, 4);
			
			Если ДанныеСчета.КоличествоСубконто = 2 Тогда
			
				ВыборкаСубконто2 = ВыборкаСубконто1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаСубконто2.Следующий() Цикл
					
					ВывестиПоАналитике(Результат, ВыборкаСубконто2, ВыборкаСубконто2.Субконто2, ОбластьАналитика, 6);
					
					Если ЭтотОбъект.ПоЛицевымСчетам Тогда
						
						ВыборкаДетальныеЗаписи = ВыборкаСубконто2.Выбрать();
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ВыборкаДетальныеЗаписи.ЛицевойСчет, ОбластьАналитика, 8);
						КонецЦикла;
					
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ЭтотОбъект.ПоЛицевымСчетам Тогда
				
				ВыборкаДетальныеЗаписи = ВыборкаСубконто1.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ВыборкаДетальныеЗаписи.ЛицевойСчет, ОбластьАналитика, 6);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе // только лицевики
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ВыборкаДетальныеЗаписи.ЛицевойСчет, ОбластьАналитика, 4);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныйВывод

Функция ВывестиДанныеСчета(Результат, ОбластьСчет, Счет, СчетКод, СчетНаименование, Субсчет)

	Если ЭтотОбъект.ВыводитьНаименованиеСчета И СчетКод <> "Итого" Тогда
		ОбластьСчет.Параметры.Счет = СчетКод + ", " + СчетНаименование;
	Иначе
		ОбластьСчет.Параметры.Счет = СчетКод;
	КонецЕсли;
	
	ОбластьСчет.Области.НаименованиеСчета.Отступ = ?(Субсчет, 2, 0);
	
	Уровень = 1;
	Если СчетКод = "Итого" Тогда
		
		ОбластьСчет.Области.ОбластьСчет.Шрифт = Новый Шрифт(ОбластьСчет.ТекущаяОбласть.Шрифт,,, Истина);
		//Уровень = 0;
		
	ИначеЕсли Счет.Вид = ВидСчета.АктивноПассивный Тогда //Аня настаивает на активном или пассивном, а не на активно-пассивном сальдо
	
		Если ОбластьСчет.Параметры.СНД <> Null И ОбластьСчет.Параметры.СНК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СНД >= ОбластьСчет.Параметры.СНК Тогда
			
				ОбластьСчет.Параметры.СНД = ОбластьСчет.Параметры.СНД - ОбластьСчет.Параметры.СНК;
				ОбластьСчет.Параметры.СНК = 0;
				
			Иначе
				
				ОбластьСчет.Параметры.СНК = ОбластьСчет.Параметры.СНК - ОбластьСчет.Параметры.СНД;
				ОбластьСчет.Параметры.СНД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если ОбластьСчет.Параметры.СКД <> Null И ОбластьСчет.Параметры.СКК <> Null Тогда
			
			Если ОбластьСчет.Параметры.СКД >= ОбластьСчет.Параметры.СКК Тогда
			
				ОбластьСчет.Параметры.СКД = ОбластьСчет.Параметры.СКД - ОбластьСчет.Параметры.СКК;
				ОбластьСчет.Параметры.СКК = 0;
				
			Иначе
			
				ОбластьСчет.Параметры.СКК = ОбластьСчет.Параметры.СКК - ОбластьСчет.Параметры.СКД;
				ОбластьСчет.Параметры.СКД = 0;
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Результат.Вывести(ОбластьСчет, Уровень);
	
	Возврат ОбластьСчет.Параметры;
	
КонецФункции

Процедура ВывестиПоАналитике(Результат, Выборка, Аналитика, ОбластьАналитика, Отступ)

	Если (Выборка.СНД = 0 ИЛИ Выборка.СНД = Null)
		И (Выборка.СНК = 0 ИЛИ Выборка.СНК = Null)
		И (Выборка.ДО = 0 ИЛИ Выборка.ДО = Null)
		И (Выборка.КО = 0 ИЛИ Выборка.КО = Null)
		И (Выборка.СКД = 0 ИЛИ Выборка.СКД = Null)
		И (Выборка.СКК = 0 ИЛИ Выборка.СКК = Null) Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьАналитика.Параметры, Выборка);
	
	Если Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.СодержитТип(ТипЗнч(Аналитика)) Тогда
		ОбластьАналитика.Параметры.Аналитика = РаботаСОтчетами.ПолучитьПредставлениеЦеннойБумаги(Аналитика, ЭтотОбъект.Период.ДатаОкончания);
	Иначе	
		ОбластьАналитика.Параметры.Аналитика = Аналитика;
	КонецЕсли;	
		
	ОбластьАналитика.Области.НаименованиеАналитики.Отступ = Отступ;
	
	Результат.Вывести(ОбластьАналитика, Отступ);

КонецПроцедуры

