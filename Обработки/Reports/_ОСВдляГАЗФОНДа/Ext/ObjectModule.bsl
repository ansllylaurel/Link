Функция ПолучитьЛицевойСчет(ЛицевойСчетЦБ, Партия, СтрокаПартии);

	Если ТипЗнч(Партия) = Тип("ДокументСсылка.ВводЦенныхБумаг") Тогда
		
		// 10символов из номера лицевого + 9 символов из номера документа + 3 символа номер строки + 3 правых символа из номера лицевого
		Возврат Лев(ЛицевойСчетЦБ.Наименование, 10) + Прав(СокрЛП(Партия.Номер), 9) + Формат(СтрокаПартии, "ЧЦ=3; ЧВН=") + Прав(ЛицевойСчетЦБ.Наименование, 3);
		
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ИсполнениеОбязательствПоСделке") Тогда
		
		// 10символов из номера лицевого + 10 символов номер сделки + 5 правых символа из номера лицевого
		Возврат Лев(ЛицевойСчетЦБ.Наименование, 10) + СокрЛП(Партия.Основание.НомерСделки) + Прав(ЛицевойСчетЦБ.Наименование, 5);
		
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.ПоставкаЦенныхБумаг") Тогда
		
		// 10символов из номера лицевого + 9 символов из номера документа + 3 символа номер строки + 3 правых символа из номера лицевого
		Возврат Лев(ЛицевойСчетЦБ.Наименование, 10) + Прав(СокрЛП(Партия.Номер), 9) + Формат(СтрокаПартии, "ЧЦ=3; ЧВН=") + Прав(ЛицевойСчетЦБ.Наименование, 3);
		
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.Сделка") Тогда
		
		// 10символов из номера лицевого + 10 символов номер сделки + 5 правых символа из номера лицевого
		Возврат Лев(ЛицевойСчетЦБ.Наименование, 10) + СокрЛП(Партия.НомерСделки) + Прав(ЛицевойСчетЦБ.Наименование, 5);
		
	ИначеЕсли ТипЗнч(Партия) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
		
		// 10символов из номера лицевого + 10 символов номер сделки + 5 правых символа из номера лицевого
		Возврат Лев(ЛицевойСчетЦБ.Наименование, 10) + СокрЛП(Партия.НомерСделки) + Прав(ЛицевойСчетЦБ.Наименование, 5);
		
	КонецЕсли;

КонецФункции

Процедура ВывестиПоСчетуПереоценкиКорректировкиЦБ(Результат, СтрокаТаблицыСчетов, ОбластьСчет, ОбластьАналитика, ТаблицаПереоценокИКорректировок, Аналитика)

	// ТаблицаПереоценокИКорректировок:
	// 	УчетныйАктивЕПС, ЦеннаяБумага, Партия, СтрокаПартии, 
	//	СчетУчетаПереоценкиА, ПереоценкаА, ПереоценкаАПриход, ПереоценкаАРасход, ПереоценкаАОстаток
	//	СчетУчетаПереоценкиП, ПереоценкаП, ПереоценкаППриход, ПереоценкаПРасход, ПереоценкаПОстаток
	//	СчетУчетаКорректировокА, КорректировкаА, КорректировкаАПриход, КорректировкаАРасход, КорректировкаАОстаток
	//	СчетУчетаКорректировокП, КорректировкаП, КорректировкаППриход, КорректировкаПРасход, КорректировкаПОстаток
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПереоценокИКорректировок.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ТаблицаПереоценокИКорректировок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ТаблицаПереоценокИКорректировок.Партия КАК Партия,
		|	ТаблицаПереоценокИКорректировок.СтрокаПартии КАК СтрокаПартии,
		|	ТаблицаПереоценокИКорректировок.ПереоценкаА КАК НачальныйОстаток,
		|	ТаблицаПереоценокИКорректировок.ПереоценкаАПриход КАК Приход,
		|	ТаблицаПереоценокИКорректировок.ПереоценкаАРасход КАК Расход,
		|	ТаблицаПереоценокИКорректировок.ПереоценкаАОстаток КАК КонечныйОстаток,
		|	ТаблицаПереоценокИКорректировок.СчетУчетаПереоценкаА КАК СчетУчета
		|ПОМЕСТИТЬ ВсеОстатки
		|ИЗ
		|	&ТаблицаПереоценокИКорректировок КАК ТаблицаПереоценокИКорректировок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ВсеОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВсеОстатки.Партия КАК Партия,
		|	ВсеОстатки.СтрокаПартии КАК СтрокаПартии,
		|	ВсеОстатки.НачальныйОстаток КАК НачальныйОстаток,
		|	ВсеОстатки.Приход КАК Приход,
		|	ВсеОстатки.Расход КАК Расход,
		|	ВсеОстатки.КонечныйОстаток КАК КонечныйОстаток,
		|	ВсеОстатки.СчетУчета КАК СчетУчета
		|ПОМЕСТИТЬ ОстаткиПоСчету
		|ИЗ
		|	ВсеОстатки КАК ВсеОстатки
		|ГДЕ
		|	ВсеОстатки.СчетУчета = &СчетУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиПоСчету.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиПоСчету.Партия КАК Партия,
		|	ОстаткиПоСчету.СтрокаПартии КАК СтрокаПартии,
		|	ОстаткиПоСчету.НачальныйОстаток КАК НачальныйОстаток1,
		|	ОстаткиПоСчету.Приход КАК Приход1,
		|	ОстаткиПоСчету.Расход КАК Расход1,
		|	ОстаткиПоСчету.КонечныйОстаток КАК КонечныйОстаток1,
		|	0 КАК ОбратныйНачальныйОстаток1,
		|	0 КАК ОбратныйКонечныйОстаток1
		|ИЗ
		|	ОстаткиПоСчету КАК ОстаткиПоСчету
		|ИТОГИ
		|	СУММА(НачальныйОстаток),
		|	СУММА(Приход),
		|	СУММА(Расход),
		|	СУММА(КонечныйОстаток)
		|ПО
		|	ОБЩИЕ,
		|	ЦеннаяБумага,
		|	Партия";
	
	Если Аналитика = "Переоценка+" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПереоценкаА", "ПереоценкаА");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК НачальныйОстаток1", "КАК СНД");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйНачальныйОстаток1", "КАК СНК");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Приход1", "КАК ДО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Расход1", "КАК КО");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК КонечныйОстаток1", "КАК СКД");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйКонечныйОстаток1", "КАК СКК");
		
	ИначеЕсли Аналитика = "Переоценка-" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПереоценкаА", "ПереоценкаП");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК НачальныйОстаток1", "КАК СНК");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйНачальныйОстаток1", "КАК СНД");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Приход1", "КАК КО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Расход1", "КАК ДО");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК КонечныйОстаток1", "КАК СКК");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйКонечныйОстаток1", "КАК СКД");
		
	ИначеЕсли Аналитика = "Корректировка+" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПереоценкаА", "КорректировкаА");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК НачальныйОстаток1", "КАК СНД");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйНачальныйОстаток1", "КАК СНК");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Приход1", "КАК ДО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Расход1", "КАК КО");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК КонечныйОстаток1", "КАК СКД");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйКонечныйОстаток1", "КАК СКК");
		
	ИначеЕсли Аналитика = "Корректировка-" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПереоценкаА", "КорректировкаП");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК НачальныйОстаток1", "КАК СНК");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйНачальныйОстаток1", "КАК СНД");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Приход1", "КАК КО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК Расход1", "КАК ДО");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК КонечныйОстаток1", "КАК СКК");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КАК ОбратныйКонечныйОстаток1", "КАК СКД");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СчетУчета", СтрокаТаблицыСчетов.Счет);
	Запрос.УстановитьПараметр("ТаблицаПереоценокИКорректировок", ТаблицаПереоценокИКорректировок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщийИтог.Следующий();		// Общий итог
	
	Если (ВыборкаОбщийИтог.СНД = 0 ИЛИ ВыборкаОбщийИтог.СНД = NULL)
		И (ВыборкаОбщийИтог.СКД = 0 ИЛИ ВыборкаОбщийИтог.СКД = NULL)
		И (ВыборкаОбщийИтог.ДО = 0 ИЛИ ВыборкаОбщийИтог.ДО = NULL)
		И (ВыборкаОбщийИтог.КО = 0 ИЛИ ВыборкаОбщийИтог.КО = NULL)
		И (ВыборкаОбщийИтог.СКД = 0 ИЛИ ВыборкаОбщийИтог.СКД = NULL)
		И (ВыборкаОбщийИтог.СКК = 0 ИЛИ ВыборкаОбщийИтог.СКК = NULL) Тогда
	
		Возврат;
	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ВыборкаОбщийИтог);
	
	ВывестиДанныеСчета(Результат, ОбластьСчет, СтрокаТаблицыСчетов.Счет, СтрокаТаблицыСчетов.СчетКод, СтрокаТаблицыСчетов.СчетНаименование, СтрокаТаблицыСчетов.Субсчет);	
	
	ВыборкаЦеннаяБумага = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЦеннаяБумага.Следующий() Цикл
		
		Если ВыборкаЦеннаяБумага.СНД = 0 И ВыборкаЦеннаяБумага.СКД = 0 И 
			ВыборкаЦеннаяБумага.ДО = 0 И ВыборкаЦеннаяБумага.КО = 0 И 
			ВыборкаЦеннаяБумага.СКД = 0 И ВыборкаЦеннаяБумага.СКК = 0 Тогда
		
			Продолжить;
		
		КонецЕсли;
		
		Если ЭтотОбъект.ПоСубконто Тогда
			ВывестиПоАналитике(Результат, ВыборкаЦеннаяБумага, ВыборкаЦеннаяБумага.ЦеннаяБумага, ОбластьАналитика, 4);
		КонецЕсли;
		
		Если ЭтотОбъект.ПоЛицевымСчетам Тогда
		
			ЛицевойСчетЦБ = БухгалтерскийУчетПовтИсп.ПолучитьЛицевойСчет(
										СтрокаТаблицыСчетов.Счет,
										ЭтотОбъект.Организация.ВалютаУчета,
										ЭтотОбъект.Организация,
										ЭтотОбъект.СчетДоверительногоУправления,
										ВыборкаЦеннаяБумага.ЦеннаяБумага);
		
		КонецЕсли;
		
		ВыборкаПартия = ВыборкаЦеннаяБумага.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПартия.Следующий() Цикл
			
			Если ЭтотОбъект.ПоСубконто Тогда
				ВывестиПоАналитике(Результат, ВыборкаПартия, ВыборкаПартия.Партия, ОбластьАналитика, 6);
			КонецЕсли;
			
			ВыборкаДетальныеЗаписи = ВыборкаПартия.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				Если ЭтотОбъект.ПоСубконто Тогда
					ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ВыборкаДетальныеЗаписи.СтрокаПартии, ОбластьАналитика, 8);
				КонецЕсли;
				
				Если ЭтотОбъект.ПоЛицевымСчетам Тогда
					
					ЛицевойСчет = ПолучитьЛицевойСчет(ЛицевойСчетЦБ, ВыборкаПартия.Партия, ВыборкаДетальныеЗаписи.СтрокаПартии);
					Отступ = ?(ЭтотОбъект.ПоСубконто, 10, 4);
					ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ЛицевойСчет, ОбластьАналитика, Отступ);
				
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПоСчетуЦБ(Результат, СтрокаТаблицыСчетов, ОбластьСчет, ОбластьАналитика, ТаблицаПереоценокИКорректировок, ТаблицаПогашений)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеАктивыЕПС.Ссылка КАК УчетныйАктивЕПС,
		|	ВЫБОР
		|		КОГДА УчетныеАктивыЕПС.СчетУчета = &Счет
		|				ИЛИ УчетныеАктивыЕПС.СчетУчетаКупона = &Счет
		|			ТОГДА ""Тело""
		|		КОГДА УчетныеАктивыЕПС.СчетУчетаПереоценкиА = &Счет
		|			ТОГДА ""Переоценка+""
		|		КОГДА УчетныеАктивыЕПС.СчетУчетаПереоценкиП = &Счет
		|			ТОГДА ""Переоценка-""
		|		КОГДА УчетныеАктивыЕПС.СчетУчетаКорректировокА = &Счет
		|			ТОГДА ""Корректировка+""
		|		КОГДА УчетныеАктивыЕПС.СчетУчетаКорректировокП = &Счет
		|			ТОГДА ""Корректировка-""
		|		ИНАЧЕ ""Неизвестно""
		|	КОНЕЦ КАК Аналитика
		|ИЗ
		|	Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|ГДЕ
		|	(УчетныеАктивыЕПС.СчетУчета = &Счет
		|			ИЛИ УчетныеАктивыЕПС.СчетУчетаПереоценкиА = &Счет
		|			ИЛИ УчетныеАктивыЕПС.СчетУчетаПереоценкиП = &Счет
		|			ИЛИ УчетныеАктивыЕПС.СчетУчетаКупона = &Счет
		|			ИЛИ УчетныеАктивыЕПС.СчетУчетаКорректировокА = &Счет
		|			ИЛИ УчетныеАктивыЕПС.СчетУчетаКорректировокП = &Счет)";
	
	Запрос.УстановитьПараметр("Счет", СтрокаТаблицыСчетов.Счет);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		УчетныйАктивЕПС = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС;
		Аналитика = ВыборкаДетальныеЗаписи.Аналитика;
		Если Аналитика <> "Тело" Тогда
			ВывестиПоСчетуПереоценкиКорректировкиЦБ(Результат, СтрокаТаблицыСчетов, ОбластьСчет, ОбластьАналитика, ТаблицаПереоценокИКорректировок, Аналитика);
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	// 4 варианта: 
	//	1. Субконто и Лицевик 	- запрос ПолучитьТекстЗапросаПартииСЛицевымиИСубконто 
	//	2. Лицевик	 			- запрос ПолучитьТекстЗапросаПартииСЛицевымиИСубконто - только субконто не выводим
	//	3. Субконто 			- запрос ПолучитьТекстЗапросаПартииССубконто
	//	4. 			 			- просто выведем по счету данные без запросов
	
	Если ЭтотОбъект.ПоЛицевымСчетам Тогда
		Запрос.Текст = ПолучитьТекстЗапросаПартииСЛицевымиИСубконто(); 
		// Поля - ЦеннаяБумага, Партия, СтрокаПартии, ДополнительнаяАналитика, СНД, СНК, ДО, КО, СКД, СКК
		// Группировки - ЦеннаяБумага, Партия, СтрокаПартии
	ИначеЕсли ЭтотОбъект.ПоСубконто Тогда
		Запрос.Текст = ПолучитьТекстЗапросаПартииССубконто(); 
		// Поля - ЦеннаяБумага, Партия, СтрокаПартии, СНД, СНК, ДО, КО, СКД, СКК
		// Группировки - ЦеннаяБумага, Партия
	Иначе
		
		ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, СтрокаТаблицыСчетов);
		
		ВывестиДанныеСчета(Результат, ОбластьСчет, СтрокаТаблицыСчетов.Счет, СтрокаТаблицыСчетов.СчетКод, СтрокаТаблицыСчетов.СчетНаименование, СтрокаТаблицыСчетов.Субсчет);
		
		Возврат;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("ДатаНачалаДата", НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаНачала", Новый Граница(НачалоДня(ЭтотОбъект.Период.ДатаНачала), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаОкончания", Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("УчетныйАктивЕПС", УчетныйАктивЕПС);
	Запрос.УстановитьПараметр("ТаблицаПогашений", ТаблицаПогашений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщийИтог.Следующий();		// Общий итог
	
	ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ВыборкаОбщийИтог);
	
	ВывестиДанныеСчета(Результат, ОбластьСчет, СтрокаТаблицыСчетов.Счет, СтрокаТаблицыСчетов.СчетКод, СтрокаТаблицыСчетов.СчетНаименование, СтрокаТаблицыСчетов.Субсчет);
	
	
	ВыборкаЦеннаяБумага = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЦеннаяБумага.Следующий() Цикл
		
		Если ЭтотОбъект.ПоСубконто Тогда
			ВывестиПоАналитике(Результат, ВыборкаЦеннаяБумага, ВыборкаЦеннаяБумага.ЦеннаяБумага, ОбластьАналитика, 4);
		КонецЕсли;
		
		ВыборкаПартия = ВыборкаЦеннаяБумага.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПартия.Следующий() Цикл
			
			Если ЭтотОбъект.ПоСубконто Тогда
				ВывестиПоАналитике(Результат, ВыборкаПартия, ВыборкаПартия.Партия, ОбластьАналитика, 6);
			КонецЕсли;
			
			Если ЭтотОбъект.ПоЛицевымСчетам Тогда
				
				ВыборкаСтрокаПартии = ВыборкаПартия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаСтрокаПартии.Следующий() Цикл
					
					Если ЭтотОбъект.ПоСубконто Тогда
						ВывестиПоАналитике(Результат, ВыборкаСтрокаПартии, ВыборкаСтрокаПартии.СтрокаПартии, ОбластьАналитика, 8);
					КонецЕсли;
					
					ВыборкаДетальныеЗаписи = ВыборкаСтрокаПартии.Выбрать();
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						
						ЛицевойСчетЦБ = БухгалтерскийУчетПовтИсп.ПолучитьЛицевойСчет(
													СтрокаТаблицыСчетов.Счет,
													ЭтотОбъект.Организация.ВалютаУчета,
													ЭтотОбъект.Организация,
													ЭтотОбъект.СчетДоверительногоУправления,
													ВыборкаЦеннаяБумага.ЦеннаяБумага,,,
													ВыборкаДетальныеЗаписи.ДополнительнаяАналитика);
						
						ЛицевойСчет = ПолучитьЛицевойСчет(ЛицевойСчетЦБ, ВыборкаПартия.Партия, ВыборкаСтрокаПартии.СтрокаПартии);
						
						Отступ = ?(ЭтотОбъект.ПоСубконто, 10, 4);
						ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ЛицевойСчет, ОбластьАналитика, Отступ);
						
					КонецЦикла;
				
				КонецЦикла;
				
			Иначе
				
				ВыборкаДетальныеЗаписи = ВыборкаПартия.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ВывестиПоАналитике(Результат, ВыборкаДетальныеЗаписи, ВыборкаДетальныеЗаписи.СтрокаПартии, ОбластьАналитика, 8);
				КонецЦикла;
			
			КонецЕсли;
		КонецЦикла;
			
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

Функция РасчитатьПогашения()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаНачальныйОстаток + ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаПриход + ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаПриход КАК СуммаПриход,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаРасход + ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаРасход КАК СуммаРасход,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКонечныйОстаток + ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.СтоимостьВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета + БухПартииЦенныхБумаг.СтоимостьКупонаВВалютеУчета + БухПартииЦенныхБумаг.ПереоценкаКупонаВВалютеУчета КАК Стоимость,
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ ДвиженияПогашений
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности В (&ВидыЗадолженности)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)) КАК ЗадолженностиПоДенежнымСредствамОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|		ПО ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Основание = БухПартииЦенныхБумаг.Регистратор
		|			И (БухПартииЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход))
		|			И (БухПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
		|ГДЕ
		|	НЕ БухПартииЦенныхБумаг.ЦеннаяБумага ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДвиженияПогашений.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ДвиженияПогашений.Партия КАК Партия,
		|	ДвиженияПогашений.СтрокаПартии КАК СтрокаПартии,
		|	ДвиженияПогашений.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	ВЫБОР
		|		КОГДА ДвиженияПогашений.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела)
		|	КОНЕЦ КАК ДополнительнаяАналитика,
		|	ДвиженияПогашений.СуммаНачальныйОстаток * ДвиженияПогашений.Стоимость / (ДвиженияПогашений.СуммаНачальныйОстаток + ДвиженияПогашений.СуммаПриход) КАК СНД,
		|	ДвиженияПогашений.СуммаПриход * ДвиженияПогашений.Стоимость / (ДвиженияПогашений.СуммаНачальныйОстаток + ДвиженияПогашений.СуммаПриход) КАК ДО,
		|	ДвиженияПогашений.СуммаРасход * ДвиженияПогашений.Стоимость / (ДвиженияПогашений.СуммаНачальныйОстаток + ДвиженияПогашений.СуммаПриход) КАК КО,
		|	ДвиженияПогашений.СуммаКонечныйОстаток * ДвиженияПогашений.Стоимость / (ДвиженияПогашений.СуммаНачальныйОстаток + ДвиженияПогашений.СуммаПриход) КАК СКД
		|ИЗ
		|	ДвиженияПогашений КАК ДвиженияПогашений";
	
	ВидыЗадолженности = Новый Массив;
	
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
	
	Запрос.УстановитьПараметр("ВидыЗадолженности", ВидыЗадолженности);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция РасчитатьПереоценкуИКорректировку()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
		|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток < 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток
		|	КОНЕЦ КАК ПереоценкаА,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток > 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток
		|	КОНЕЦ КАК ПереоценкаП,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток < 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток
		|	КОНЕЦ КАК КорректировкаА,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток > 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток
		|	КОНЕЦ КАК КорректировкаП,
		|	0 КАК ПереоценкаАПриход,
		|	0 КАК ПереоценкаАРасход,
		|	0 КАК ПереоценкаППриход,
		|	0 КАК ПереоценкаПРасход,
		|	0 КАК КорректировкаАПриход,
		|	0 КАК КорректировкаАРасход,
		|	0 КАК КорректировкаППриход,
		|	0 КАК КорректировкаПРасход,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток < 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток
		|	КОНЕЦ КАК ПереоценкаАОстаток,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток > 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток
		|	КОНЕЦ КАК ПереоценкаПОстаток,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток < 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток
		|	КОНЕЦ КАК КорректировкаАОстаток,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток > 0
		|			ТОГДА 0
		|		ИНАЧЕ -БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток
		|	КОНЕЦ КАК КорректировкаПОстаток,
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиА КАК СчетУчетаПереоценкаА,
		|	УчетныеАктивыЕПС.СчетУчетаПереоценкиП КАК СчетУчетаПереоценкаП,
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокА КАК СчетУчетаКорректировкаА,
		|	УчетныеАктивыЕПС.СчетУчетаКорректировокП КАК СчетУчетаКорректировкаП
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&Период,
		|			ВидУчета = &ВидУчета
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УчетныеАктивыЕПС КАК УчетныеАктивыЕПС
		|		ПО БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС = УчетныеАктивыЕПС.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага.Наименование";
	
	Запрос.УстановитьПараметр("Период", Новый Граница(НачалоДня(ЭтотОбъект.Период.ДатаНачала), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумаг.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	БухПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумаг.Партия КАК Партия,
		|	БухПартииЦенныхБумаг.СтрокаПартии КАК СтрокаПартии,
		|	БухПартииЦенныхБумаг.ВидДвижения КАК ВидДвижения,
		|	БухПартииЦенныхБумаг.ПереоценкаВВалютеУчета КАК ПереоценкаВВалютеУчета,
		|	БухПартииЦенныхБумаг.КорректировкаЭСПВВалютеУчета КАК КорректировкаЭСПВВалютеУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг КАК БухПартииЦенныхБумаг
		|ГДЕ
		|	БухПартииЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И БухПартииЦенныхБумаг.Организация = &Организация
		|	И БухПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И БухПартииЦенныхБумаг.ВидУчета = &ВидУчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	БухПартииЦенныхБумаг.МоментВремени";
	
	Запрос.УстановитьПараметр("ВидУчета", Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(
							Новый Структура("УчетныйАктивЕПС,ЦеннаяБумага,Партия,СтрокаПартии", 
								ВыборкаДетальныеЗаписи.УчетныйАктивЕПС,
								ВыборкаДетальныеЗаписи.ЦеннаяБумага,
								ВыборкаДетальныеЗаписи.Партия,
								ВыборкаДетальныеЗаписи.СтрокаПартии));
								
		Если СтрокиОстатков.Количество() = 0 Тогда
		    СтрокаОстатков = ТаблицаОстатков.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОстатков, ВыборкаДетальныеЗаписи);
			СтрокаОстатков.ПереоценкаА = 0; СтрокаОстатков.ПереоценкаАПриход = 0; СтрокаОстатков.ПереоценкаАРасход = 0; СтрокаОстатков.ПереоценкаАОстаток = 0;
			СтрокаОстатков.ПереоценкаП = 0; СтрокаОстатков.ПереоценкаППриход = 0; СтрокаОстатков.ПереоценкаПРасход = 0; СтрокаОстатков.ПереоценкаПОстаток = 0;
			СтрокаОстатков.КорректировкаА = 0; СтрокаОстатков.КорректировкаАПриход = 0; СтрокаОстатков.КорректировкаАРасход = 0; СтрокаОстатков.КорректировкаАОстаток = 0;
			СтрокаОстатков.КорректировкаП = 0; СтрокаОстатков.КорректировкаППриход = 0; СтрокаОстатков.КорректировкаПРасход = 0; СтрокаОстатков.КорректировкаПОстаток = 0;
			
			СтрокаОстатков.СчетУчетаПереоценкаА = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаПереоценкиА;
			СтрокаОстатков.СчетУчетаПереоценкаП = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаПереоценкиП;
			СтрокаОстатков.СчетУчетаКорректировкаА = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаКорректировокА;
			СтрокаОстатков.СчетУчетаКорректировкаП = ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаКорректировокП;
			
		Иначе
			СтрокаОстатков = СтрокиОстатков[0];
		КонецЕсли;
		
								
		СуммаПереоценки = ВыборкаДетальныеЗаписи.ПереоценкаВВалютеУчета * ?(ВыборкаДетальныеЗаписи.ВидДвижения = ВидДвиженияНакопления.Приход, 1, -1);
		СуммаКорректировки = ВыборкаДетальныеЗаписи.КорректировкаЭСПВВалютеУчета * ?(ВыборкаДетальныеЗаписи.ВидДвижения = ВидДвиженияНакопления.Приход, 1, -1);
		
		Если СуммаКорректировки <> 0 Тогда
			// обрабатываем как парные: если требуется - меняем счет в проводке,
			// если после этого ушли в минус - добавляем проводку по перебросу минуса на парный счет 
			// например 71005 был кр. остаток 90, документ пришел сюда с проводкой 71006-50156 на сумму 110
			// меняем счет на парный в исходной проводке, получаем 71005-50156 (110), в результате на 71005 оразуется дт. остаток 20
			// добавляем проводку 71006-71005 (20)
			Если СтрокаОстатков.КорректировкаПОстаток > 0 Тогда // пассивное сальдо
				
				Если СуммаКорректировки > 0 Тогда // уменьшаем пассивное сальдо
					
					Если СтрокаОстатков.КорректировкаПОстаток >= СуммаКорректировки Тогда // просто уменьшим
						
						СтрокаОстатков.КорректировкаПРасход = СтрокаОстатков.КорректировкаПРасход + СуммаКорректировки;
						СтрокаОстатков.КорректировкаПОстаток = СтрокаОстатков.КорректировкаПОстаток - СуммаКорректировки;
						
					Иначе // уйдем в минус а затем вернемся в ноль и перейдем в активное сальдо
						
						СуммаПоложительнойКорректировки = СуммаКорректировки - СтрокаОстатков.КорректировкаПОстаток;
						
						СтрокаОстатков.КорректировкаПРасход = СтрокаОстатков.КорректировкаПРасход + СуммаКорректировки;
						СтрокаОстатков.КорректировкаППриход = СтрокаОстатков.КорректировкаППриход + СуммаПоложительнойКорректировки;
						СтрокаОстатков.КорректировкаПОстаток = 0;
						
						СтрокаОстатков.КорректировкаАПриход = СтрокаОстатков.КорректировкаАПриход + СуммаПоложительнойКорректировки;
						СтрокаОстатков.КорректировкаАОстаток = СуммаПоложительнойКорректировки;
						
					КонецЕсли;
					
				Иначе // увеличиваем пассивное сальдо
					
					СтрокаОстатков.КорректировкаППриход = СтрокаОстатков.КорректировкаППриход + (-СуммаКорректировки);
					СтрокаОстатков.КорректировкаПОстаток = СтрокаОстатков.КорректировкаПОстаток + (-СуммаКорректировки);
				
				КонецЕсли;
			
			Иначе // активное или нулевое сальдо
				
				Если СуммаКорректировки > 0 Тогда // увеличиваем активное сальдо
					
					СтрокаОстатков.КорректировкаАПриход = СтрокаОстатков.КорректировкаАПриход + СуммаКорректировки;
					СтрокаОстатков.КорректировкаАОстаток = СтрокаОстатков.КорректировкаАОстаток + СуммаКорректировки;
					
				Иначе // уменьшаем активное сальдо
					
					Если СтрокаОстатков.КорректировкаАОстаток >= (-СуммаКорректировки) Тогда // просто уменьшим
						
						СтрокаОстатков.КорректировкаАРасход = СтрокаОстатков.КорректировкаАРасход - (-СуммаКорректировки);
						СтрокаОстатков.КорректировкаАОстаток = СтрокаОстатков.КорректировкаАОстаток - (-СуммаКорректировки);
						
					Иначе // уйдем в минус а затем вернемся в ноль и пассивное сальдо
						
						СуммаОтрицательнойКорректировки = -СуммаКорректировки - СтрокаОстатков.КорректировкаАОстаток;
						
						СтрокаОстатков.КорректировкаАРасход = СтрокаОстатков.КорректировкаАРасход + (-СуммаКорректировки);
						СтрокаОстатков.КорректировкаАПриход = СтрокаОстатков.КорректировкаАПриход + СуммаОтрицательнойКорректировки;
						СтрокаОстатков.КорректировкаАОстаток = 0;
						
						СтрокаОстатков.КорректировкаППриход = СтрокаОстатков.КорректировкаППриход + СуммаОтрицательнойКорректировки;
						СтрокаОстатков.КорректировкаПОстаток = СуммаОтрицательнойКорректировки;
						
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СуммаПереоценки <> 0 Тогда
			// обрабатываем иначе: если требуется - меняем счет в проводке,
			// если после этого ушли в минус - корректируем сумму в этой проводке и добавляем такую же с парным счетом на разность
			// например 71503 был кр. остаток 90, документ пришел сюда с проводкой 71504-50131 на сумму 110
			// меняем счет на парный в исходной проводке, получаем 71503-50131, чтобы не уйти в минус меняем сумму на 90
			// добавляем проводку 71504-50131 (20)
			Если СтрокаОстатков.ПереоценкаПОстаток > 0 Тогда // пассивное сальдо
				
				Если СуммаПереоценки > 0 Тогда // уменьшаем пассивное сальдо
					
					Если СтрокаОстатков.ПереоценкаПОстаток >= СуммаПереоценки Тогда // просто уменьшим
						
						СтрокаОстатков.ПереоценкаПРасход = СтрокаОстатков.ПереоценкаПРасход + СуммаПереоценки;
						СтрокаОстатков.ПереоценкаПОстаток = СтрокаОстатков.ПереоценкаПОстаток - СуммаПереоценки;
						
					Иначе // уменьшим до нуля и перейдем в активное сальдо
						
						СуммаПоложительнойПереоценки = СуммаПереоценки - СтрокаОстатков.ПереоценкаПОстаток;
						
						СтрокаОстатков.ПереоценкаПРасход = СтрокаОстатков.ПереоценкаПРасход + СтрокаОстатков.ПереоценкаПОстаток;
						СтрокаОстатков.ПереоценкаПОстаток = 0;
						
						СтрокаОстатков.ПереоценкаАПриход = СтрокаОстатков.ПереоценкаАПриход + СуммаПоложительнойПереоценки;
						СтрокаОстатков.ПереоценкаАОстаток = СуммаПоложительнойПереоценки;
						
					КонецЕсли;
					
				Иначе // увеличиваем пассивное сальдо
					
					СтрокаОстатков.ПереоценкаППриход = СтрокаОстатков.ПереоценкаППриход + (-СуммаПереоценки);
					СтрокаОстатков.ПереоценкаПОстаток = СтрокаОстатков.ПереоценкаПОстаток + (-СуммаПереоценки);
				
				КонецЕсли;
			
			Иначе // активное или нулевое сальдо
				
				Если СуммаПереоценки > 0 Тогда // увеличиваем активное сальдо
					
					СтрокаОстатков.ПереоценкаАПриход = СтрокаОстатков.ПереоценкаАПриход + СуммаПереоценки;
					СтрокаОстатков.ПереоценкаАОстаток = СтрокаОстатков.ПереоценкаАОстаток + СуммаПереоценки;
					
				Иначе // уменьшаем активное сальдо
					
					Если СтрокаОстатков.ПереоценкаАОстаток >= (-СуммаПереоценки) Тогда // просто уменьшим
						
						СтрокаОстатков.ПереоценкаАРасход = СтрокаОстатков.ПереоценкаАРасход + (-СуммаПереоценки);
						СтрокаОстатков.ПереоценкаАОстаток = СтрокаОстатков.ПереоценкаАОстаток - (-СуммаПереоценки);
						
					Иначе // уменьшим до нуля и перейдем в пассивное сальдо
						
						СуммаОтрицательнойПереоценки = -СуммаПереоценки - СтрокаОстатков.ПереоценкаАОстаток;
						
						СтрокаОстатков.ПереоценкаАРасход = СтрокаОстатков.ПереоценкаАРасход + СтрокаОстатков.ПереоценкаАОстаток;
						СтрокаОстатков.ПереоценкаАОстаток = 0;
						
						СтрокаОстатков.ПереоценкаППриход = СтрокаОстатков.ПереоценкаППриход + СуммаОтрицательнойПереоценки;
						СтрокаОстатков.ПереоценкаПОстаток = СуммаОтрицательнойПереоценки;
						
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаОстатков;
	
КонецФункции

Функция ЭтоСчетЦБ(КодСчета)

	Код3 = Лев(КодСчета, 3);
	
	Возврат Код3 = "501" ИЛИ Код3 = "502" ИЛИ Код3 = "503" ИЛИ Код3 = "504" ИЛИ Код3 = "506" ИЛИ Код3 = "507";
	
КонецФункции

Процедура ПроверитьНаличиеСчетаОстатков(Счет, ТаблицаСчетов)

	Если НЕ ЗначениеЗаполнено(Счет) Тогда
	
		Возврат;	
	
	КонецЕсли;
	
	Если ТаблицаСчетов.НайтиСтроки(Новый Структура("Счет", Счет)).Количество() = 0 Тогда
	
		НоваяСтрокаТаблицаСчетов = ТаблицаСчетов.Добавить();
		
		НоваяСтрокаТаблицаСчетов.Счет = Счет;
		НоваяСтрокаТаблицаСчетов.СчетКод = Счет.Код;
		НоваяСтрокаТаблицаСчетов.Субсчет = Истина;
		НоваяСтрокаТаблицаСчетов.СчетНаименование = Счет.Наименование;
		
	КонецЕсли;	

КонецПроцедуры

Функция СформироватьОтчет(Результат, Подписант) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,ПоЛицевымСчетам,ПоСубконто,БратьДанныеРегистраПартий", Новый Структура("Подписант", Подписант));
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
    Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Результат.Очистить();
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСчет = Макет.ПолучитьОбласть("ОбластьСчет");
	ОбластьАналитика = Макет.ПолучитьОбласть("ОбластьАналитика");
	
	
	ОбластьЗаголовок.Параметры.Организация   = ЭтотОбъект.Организация;
	ОбластьЗаголовок.Параметры.Заголовок   = "Оборотно-сальдовая ведомость" + РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	ОбластьЗаголовок.Параметры.Параметры   = "Счет д/у: """ + ЭтотОбъект.СчетДоверительногоУправления + """" + Символы.ПС +
			" По договору: №" + ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора + 
			" от " + Формат(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " года";
	
	Результат.Вывести(ОбластьЗаголовок);
	
	Результат.НачатьАвтогруппировкуСтрок();
	
	// Бухгалтерские остатки и обороты по счетам и субсчетам
	ТаблицаСчетов = ПолучитьТаблицуСчетов();
	
	Если ЭтотОбъект.БратьДанныеРегистраПартий Тогда
		// сразу посчитаем их целиком, иначе никак
		ТаблицаПереоценокИКорректировок = РасчитатьПереоценкуИКорректировку();
		ТаблицаПогашений = РасчитатьПогашения();
		
		Для каждого СтрокаТаблицаПереоценокИКорректировок Из ТаблицаПереоценокИКорректировок Цикл
			
			ПроверитьНаличиеСчетаОстатков(СтрокаТаблицаПереоценокИКорректировок.УчетныйАктивЕПС.СчетУчетаПереоценкиА, ТаблицаСчетов);
			ПроверитьНаличиеСчетаОстатков(СтрокаТаблицаПереоценокИКорректировок.УчетныйАктивЕПС.СчетУчетаПереоценкиП, ТаблицаСчетов);
			ПроверитьНаличиеСчетаОстатков(СтрокаТаблицаПереоценокИКорректировок.УчетныйАктивЕПС.СчетУчетаКорректировокА, ТаблицаСчетов);
			ПроверитьНаличиеСчетаОстатков(СтрокаТаблицаПереоценокИКорректировок.УчетныйАктивЕПС.СчетУчетаКорректировокП, ТаблицаСчетов);
		
		КонецЦикла;
		
		ТаблицаСчетов.Сортировать("СчетКод");
		
	КонецЕсли;
	
	ИтоговыеСуммы = Новый Структура("СНД,СНК,ДО,КО,СКД,СКК",0,0,0,0,0,0);
	
	Для Каждого СтрокаТаблицыСчетов Из ТаблицаСчетов Цикл
		
		Если СтрокаТаблицыСчетов.Субсчет И ЭтоСчетЦБ(СтрокаТаблицыСчетов.СчетКод) И ЭтотОбъект.БратьДанныеРегистраПартий Тогда 
			// вывод с регистра партий
			ВывестиПоСчетуЦБ(Результат, СтрокаТаблицыСчетов, ОбластьСчет, ОбластьАналитика, ТаблицаПереоценокИКорректировок, ТаблицаПогашений);
			
		Иначе // обычный вывод
			
			// СНД,СНК,ДО,КО,СКД,СКК
			ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, СтрокаТаблицыСчетов);
			
			Если СтрокаТаблицыСчетов.СчетКод = "Итого" Тогда
			    ЗаполнитьЗначенияСвойств(ОбластьСчет.Параметры, ИтоговыеСуммы);
			КонецЕсли;
			
			// Счет, наименование
			СуммыСчета = ВывестиДанныеСчета(Результат, ОбластьСчет, СтрокаТаблицыСчетов.Счет, СтрокаТаблицыСчетов.СчетКод, СтрокаТаблицыСчетов.СчетНаименование, СтрокаТаблицыСчетов.Субсчет);
			
			Если НЕ СтрокаТаблицыСчетов.Субсчет Тогда
			     ИтоговыеСуммы.СНД	= ИтоговыеСуммы.СНД + СуммыСчета.СНД;
			     ИтоговыеСуммы.СНК	= ИтоговыеСуммы.СНК + СуммыСчета.СНК;
			     ИтоговыеСуммы.ДО	= ИтоговыеСуммы.ДО + СуммыСчета.ДО;
			     ИтоговыеСуммы.КО	= ИтоговыеСуммы.КО + СуммыСчета.КО;
			     ИтоговыеСуммы.СКД	= ИтоговыеСуммы.СКД + СуммыСчета.СКД;
			     ИтоговыеСуммы.СКК	= ИтоговыеСуммы.СКК + СуммыСчета.СКК;
			ИначеЕсли СтрокаТаблицыСчетов.Субсчет И (ЭтотОбъект.ПоСубконто ИЛИ ЭтотОбъект.ПоЛицевымСчетам) Тогда
				// По субконто и лицевикам
				ВывестиПоСчету(Результат, СтрокаТаблицыСчетов.Счет, ОбластьАналитика);	 
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.ЗакончитьАвтогруппировкуСтрок();
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛица(Подписант, ЭтотОбъект.Организация);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
	
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);
	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(Результат, ПараметрыВыводаПодписей);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецФункции