
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Отчет.Период.ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	Отчет.Период.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
		
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеВариантаНаСервере(Настройки)
	
	ЭтаФорма.Элементы.ФормаКомандаВыгрузитьСРазбивкойПоЦеннымБумагам.Видимость = ЭтаФорма.КлючТекущегоВарианта = "Основной";
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаВыгрузитьСРазбивкойПоЦеннымБумагам(Команда)
	
	СтруктураРезультата = ПолучитьСтруктуруРезультатаНаСервере();
	
	Если СтруктураРезультата = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать отчет");
	Иначе
		ЗаполнитьФайлExcel(СтруктураРезультата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьДоступКТестированиюSPPI(Команда)
	// Поиск строки заголовка таблицы отчёта
	МаксимальныйОтступДоНачалаОтчета = 10;
	НомерСтрокиЗаголовкаТаблицы = Неопределено;
	Для Итератор = 1 По МаксимальныйОтступДоНачалаОтчета Цикл
		ЯчейкаЗаголовкаТаблицы = Результат.Область(Итератор, 1);
		Если Не ПустаяСтрока(ЯчейкаЗаголовкаТаблицы.Текст) Тогда
			НомерСтрокиЗаголовкаТаблицы = Итератор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НомерСтрокиЗаголовкаТаблицы = Неопределено Тогда
		ПоказатьПредупреждение(, "Не найдена строка заголовка таблицы сформированного отчёта. Возможно, отчёт не был сформирован.",,
			"Установка доступа к тестированию SPPI");
		Возврат;
	КонецЕсли;
	
	// Поиск колонок в таблице отчёта
	НомерКолонкиЦеннаяБумага = Неопределено;
	НомерКолонкиСчетДоверительногоУправления = Неопределено;
	НомерКолонкиДатаОперации = Неопределено;
	Для Итератор = 1 По Результат.ШиринаТаблицы Цикл
		ЯчейкаКолонкиЦеннаяБумага = Результат.Область(НомерСтрокиЗаголовкаТаблицы, Итератор);
		Если ЯчейкаКолонкиЦеннаяБумага.Текст = "Ценная бумага" Тогда
			НомерКолонкиЦеннаяБумага = Итератор;
		ИначеЕсли ЯчейкаКолонкиЦеннаяБумага.Текст = "Счет доверительного управления" Тогда
			НомерКолонкиСчетДоверительногоУправления = Итератор;
		ИначеЕсли ЯчейкаКолонкиЦеннаяБумага.Текст = "Дата операции" Тогда
			НомерКолонкиДатаОперации = Итератор;
		КонецЕсли;
	КонецЦикла;
	Если НомерКолонкиЦеннаяБумага = Неопределено Тогда
		ПоказатьПредупреждение(, "Не найдена колонка ""Ценная бумага"" таблицы сформированного отчёта.",,
			"Установка доступа к тестированию SPPI");
		Возврат;
	ИначеЕсли НомерКолонкиСчетДоверительногоУправления = Неопределено Тогда
		ПоказатьПредупреждение(, "Не найдена колонка ""Счет доверительного управления"" таблицы сформированного отчёта.",,
			"Установка доступа к тестированию SPPI");
		Возврат;
	ИначеЕсли НомерКолонкиДатаОперации = Неопределено Тогда
		ПоказатьПредупреждение(, "Не найдена колонка ""Счет доверительного управления"" таблицы сформированного отчёта.",,
			"Установка доступа к тестированию SPPI");
		Возврат;
	КонецЕсли;
	
	// Формирования списка облигаций по сформированному отчёту
	НомераКолонок = Новый Массив;
	НомераКолонок.Добавить(НомерКолонкиЦеннаяБумага);
	НомераКолонок.Добавить(НомерКолонкиСчетДоверительногоУправления);
	НомераКолонок.Добавить(НомерКолонкиДатаОперации);
	СпискиОбъектовВКолонкахТаблицыОтчета = ПолучитьСпискиОбъектовВКолонкахТаблицыОтчета(НомерСтрокиЗаголовкаТаблицы + 1, НомераКолонок);
	ДанныеКолонкиЦеннаяБумага = СпискиОбъектовВКолонкахТаблицыОтчета.Получить(НомерКолонкиЦеннаяБумага);
	ДанныеКолонкиСчетДоверительногоУправления = СпискиОбъектовВКолонкахТаблицыОтчета.Получить(НомерКолонкиСчетДоверительногоУправления);
	ДанныеКолонкиДатаОперации = СпискиОбъектовВКолонкахТаблицыОтчета.Получить(НомерКолонкиДатаОперации);
	МассивДанныхОблигаций = Новый Массив; // Массив(Структура("СчетДоверительногоУправления", "ДатаПокупки", "Облигация"))
	Для Итератор = 0 По ДанныеКолонкиЦеннаяБумага.Количество() - 1 Цикл
		ТекущаяОблигация = ДанныеКолонкиЦеннаяБумага[Итератор];
		ТекущийСчетДоверительногоУправления = ДанныеКолонкиСчетДоверительногоУправления[Итератор];
		ТекущаяДатаПокупки = ДанныеКолонкиДатаОперации[Итератор];
		Если Не ЗначениеЗаполнено(ТекущаяОблигация)
			Или ТипЗнч(ТекущаяОблигация) <> Тип("СправочникСсылка.Облигации")
			Или Не ЗначениеЗаполнено(ТекущийСчетДоверительногоУправления)
			Или Не ЗначениеЗаполнено(ТекущаяДатаПокупки)
		Тогда
			Продолжить;
		КонецЕсли;
		МассивДанныхОблигаций.Добавить(Новый Структура("СчетДоверительногоУправления, ДатаПокупки, Облигация",
			ТекущийСчетДоверительногоУправления, ТекущаяДатаПокупки, ТекущаяОблигация));
	КонецЦикла;
	Если МассивДанныхОблигаций.Количество() = 0 Тогда
		Сообщить("Облигаций не найдено или недостаточно данных. Проверьте заполненность колонок ""Дата операции"" и ""Счет доверительного управления"".");
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Отчет.Организация);
	ПараметрыФормы.Вставить("КоллекцияДанных", МассивДанныхОблигаций);
	ОткрытьФорму("ВнешнийОтчет._ОтчетПоОперациям.Форма.ФормаДоступКТестированиюSPPI", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НЕАКТУАЛЬНОСТЬ");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруРезультатаНаСервере()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Объект = РеквизитФормыВЗначение("Отчет");
	Возврат Объект.ПолучитьРезультатДляВыгрузкиВExcel();	
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьФайлExcel(СтруктураРезультата)
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
				
		ОбщийФайл = Excel.Workbooks.Add();
		Если ОбщийФайл.Sheets.Count > 2 Тогда
			ОбщийФайл.Sheets(1).Delete();
			ОбщийФайл.Sheets(1).Delete();
		КонецЕсли;
		
		Если ОбщийФайл.Sheets.Count > 1 Тогда
			ОбщийФайл.Sheets(1).Delete();
		КонецЕсли;
	        	
		КоличествоФайлов = СтруктураРезультата.Количество();		
		Для Каждого СтруктураФайла Из СтруктураРезультата Цикл
						
			ИмяФайлаПоОднойЦБ = КаталогВременныхФайлов() + "\" + СтруктураФайла.Ключ + ".xlsx";
			СтруктураФайла.Значение.Записать(ИмяФайлаПоОднойЦБ, ТипФайлаТабличногоДокумента.XLSX);
			ФайлПоОднойЦБ = Excel.Workbooks.Open(ИмяФайлаПоОднойЦБ);
			ФайлПоОднойЦБ.Sheets(1).Move(ОбщийФайл.Sheets(1));
			ОбщийФайл.Sheets(1).Name = СтруктураФайла.Ключ;
			
			УдалитьФайлы(ИмяФайлаПоОднойЦБ);
						
		КонецЦикла;
		
		// Удаляем последний "типовой" лист
		Если КоличествоФайлов < ОбщийФайл.Sheets.Count Тогда
			ОбщийФайл.Sheets(КоличествоФайлов + 1).Delete();
		КонецЕсли;
		
		Excel.Visible = 1;
				
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл Excel заполнен");
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ); 	
	КонецЕсли;
	
КонецПроцедуры

// Получение списка объектов в колонках таблицы отчёта.
//	Размеры массивов для разных колонок всегда одинаковые.
//
// Параметры:
//	НомерПервойСтроки - Число
//	НомераКолонок - Массив(Число)
//
// Возвращаемое значение:
//	Соответствие(Число (Номер колонки табличного документа),
//		Массив(Произвольный)
&НаСервере
Функция ПолучитьСпискиОбъектовВКолонкахТаблицыОтчета(НомерПервойСтроки, НомераКолонок)
	СпискиОбъектов = Новый Соответствие; // см. Возвращаемое значение
	Для Каждого НомерКолонки Из НомераКолонок Цикл
		СпискиОбъектов.Вставить(НомерКолонки, Новый Массив);
	КонецЦикла;
	
	ДанныеРасшифровкиИзХранилища = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	Для Итератор = НомерПервойСтроки По Результат.ВысотаТаблицы Цикл
		Для Каждого НомерКолонки Из НомераКолонок Цикл
			ТекущийМассив = СпискиОбъектов.Получить(НомерКолонки);
			ЯчейкаОбъекта = Результат.Область(Итератор, НомерКолонки);
			ДанныеРасшифровкиЯчейки = ДанныеРасшифровкиИзХранилища.Элементы[ЯчейкаОбъекта.Расшифровка];
			ПоляЯчейки = ДанныеРасшифровкиЯчейки.ПолучитьПоля();
			ТекущийМассив.Добавить(?(ПоляЯчейки.Количество() > 0, ПоляЯчейки[0].Значение, Неопределено));
		КонецЦикла;
	КонецЦикла;
	
	Возврат СпискиОбъектов;
КонецФункции

#КонецОбласти
