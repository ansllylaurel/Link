			СтрокаДанных.Кол_НомерДоговора = ОКУД0420011_ПолучитьНомерДоговора(СтрокаДанных.Кол_НомерДоговора);

		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.Контрагент) И СтрокаДанных.Контрагент.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			СтрокаДанных.Кол_ИНН = ОКУД0420001_ПолучитьИдентификаторКонтрагента(СтрокаДанных.Контрагент, СтрокаДанных.Кол_ДатаОперации, СтрокаДанных.РезидентРФ); 
		Иначе
			СтрокаДанных.Кол_ИНН =	СтрокаДанных.ИдентификторЮрФизЛица;
		КонецЕсли;
		
	КонецЦикла;	
	
	Данные.Свернуть("Банк_КраткоеНаименованиеПоУставу, Банк_ПолноеНаименованиеПоУставу, Кол_РегНомер, Кол_РасчСчет, Кол_ВидСчета, Кол_ДатаОперации, Кол_КодНаправленияПлатежа, Кол_КодВалютыСчета, Кол_КодВидаОперации, Кол_КоррБанк, Кол_КоррБИК, Кол_SWIFT, Кол_СтатусКлиента, Кол_ТипКлиента, Кол_ЛицевойСчет, Кол_НаименованиеКлиента, Кол_ИНН, Кол_ОКСМ, Кол_НомерДоговора, Кол_ДатаДоговора, Кол_НачальныйОстаток, Кол_КонечныйОстаток, Регистратор, СчетДоверительногоУправления, ПодсветитьКод, ВидОперации, ПлатежныйДокумент, НомерПлатежногоДокумента, ДатаПлатежногоДокумента", "Кол_СуммаОперации");
	//Данные.Сортировать("Кол_Банк, Кол_РасчСчет, СчетДоверительногоУправления, Регистратор");

	Если ЭтотОбъект.Период.ДатаОкончания < Дата(2022,5,1) Тогда
		Макет = ПолучитьМакет("РегистрОперацийСДС_доАпреля2022");
	Иначе
		Макет = ПолучитьМакет("РегистрОперацийСДС");
	КонецЕсли;
	
	Результат.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	ТекущийРасчетныйСчет = Неопределено;
	
	ОбластьГруппа = Макет.ПолучитьОбласть("Группа");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ТекущийРасчетныйСчет <> СтрокаДанных.Кол_РасчСчет Тогда
			ЗаполнитьЗначенияСвойств(ОбластьГруппа.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьГруппа);
			ТекущийРасчетныйСчет = СтрокаДанных.Кол_РасчСчет;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_ДатаОперации) Тогда Продолжить; КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		
		Если ЗначениеЗаполнено(СтрокаДанных.Регистратор) Тогда
			ОбластьСтрока.Параметры.Ссылка = ПолучитьНавигационнуюСсылку(СтрокаДанных.Регистратор);
		Иначе
			ОбластьСтрока.Параметры.Ссылка = Неопределено;
		КонецЕсли;	
		
		Результат.Вывести(ОбластьСтрока);
		
		Если ТипЗнч(СтрокаДанных.Регистратор) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В регистр попала корректировка регистров: %1. Отчёт по счёту %2 заполнен некорректно. Строка (%3) отмечена красным.",  СтрокаДанных.Регистратор, СтрокаДанных.Кол_РасчСчет, Данные.Индекс(СтрокаДанных) + 3), СтрокаДанных.Регистратор);
			Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, Результат.ШиринаТаблицы).ЦветФона = Новый Цвет(255, 0, 0);
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_СтатусКлиента)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_НомерДоговора)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаДанных.ПлатежныйДокумент) Тогда
			Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, Результат.ШиринаТаблицы).ЦветФона = Новый Цвет(255, 255, 0);
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_СтатусКлиента) Тогда
				Результат.Область(Результат.ВысотаТаблицы, 13, Результат.ВысотаТаблицы, 13).ЦветФона = Новый Цвет(255, 0, 0);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_НомерДоговора) Тогда
				Результат.Область(Результат.ВысотаТаблицы, 19, Результат.ВысотаТаблицы, 19).ЦветФона = Новый Цвет(255, 0, 0);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанных.ПлатежныйДокумент) Тогда
				Результат.Область(Результат.ВысотаТаблицы, 25, Результат.ВысотаТаблицы, 25).ЦветФона = Новый Цвет(255, 0, 0);
				Результат.Область(Результат.ВысотаТаблицы, 25, Результат.ВысотаТаблицы, 25).Примечание.Текст = "Не указан платёжный документ (не выбрана строка банковской выписки)";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_СуммаОперации)
				И ЗначениеЗаполнено(СтрокаДанных.Кол_ДатаОперации) Тогда
				Результат.Область(Результат.ВысотаТаблицы, 8, Результат.ВысотаТаблицы, 8).ЦветФона = Новый Цвет(255, 0, 0);
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаДанных.ПодсветитьКод ИЛИ НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_КодВидаОперации) Тогда
			Результат.Область(Результат.ВысотаТаблицы, 9, Результат.ВысотаТаблицы, 9).ЦветФона = Новый Цвет(255, 0, 0);
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

Функция ОКУД0420011_ПолучитьКодВидаОперацииЦБРФ(СчетДоверительногоУправления, Регистратор, ВидДвиженияДенежныхСредств, ВариантДвиженияДенежныхСредств, Валюта, РезидентРФ = "", КлиентИКонтрагентОдноЛицо)
	
	Если ТипЗнч(РезидентРФ) <> Тип("Булево") Тогда
		Возврат "";
	КонецЕсли;	
	
#Область КонверсионныеСделки

	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
		Возврат ОКУД0420011_КодКонверсионнойОперации(Регистратор, Валюта, СчетДоверительногоУправления);
		
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.Оплата") Тогда
		Если Регистратор.Основания.Количество() > 0 Тогда 
			Если ТипЗнч(Регистратор.Основания[0].Основание) = Тип("ДокументСсылка.СделкаСВалютой") Тогда
				Возврат ОКУД0420011_КодКонверсионнойОперации(Регистратор.Основания[0].Основание, Валюта, СчетДоверительногоУправления);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
#КонецОбласти	

#Область ВводВыводПаевНерезидентом
	Если НЕ РезидентРФ 
		И (СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов 
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда) Тогда
		Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств Тогда
			Возврат "51230";
		ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств Тогда
			Возврат "55230";
		КонецЕсли;	
	КонецЕсли;
#КонецОбласти

#Область РасчетыСБроекромВВалюте

	Если Валюта <> ЭтотОбъект.ВалютаУчета Тогда
		Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств Тогда
			Если ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет 
				ИЛИ ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера
				ИЛИ ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.ВПуть Тогда
				Возврат "58030";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

#КонецОбласти	

#Область ПереводыВВалюте

	Если Валюта <> ЭтотОбъект.ВалютаУчета Тогда
		Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств Тогда 
			Если КлиентИКонтрагентОдноЛицо Тогда
				Если Регистратор.РасчетныйСчет.Транзитный  Тогда
					Возврат "61100";
				ИначеЕсли Регистратор.РасчетныйСчет.Банк = Регистратор.РасчетныйСчетПолучатель.Банк Тогда
					Возврат "61130";
				Иначе 
					Возврат "61135";
				КонецЕсли;
			//Иначе 
			//	Возврат "";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
#КонецОбласти

#Область ПрочиеВалютныеОперации
	Если Валюта <> ЭтотОбъект.ВалютаУчета Тогда
		Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона 
			ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата
				И (	ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюКупона
				ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
				ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюОблигации
				ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации) Тогда
			Возврат "55310";
		ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата
			И ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи Тогда
			Возврат "55330";
		Иначе
			Возврат "99090";
		КонецЕсли;
	КонецЕсли;
#КонецОбласти

	Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств Тогда
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов ТОГДА 
			Возврат "01050";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда ТОГДА 
			Возврат "01060";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями 
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов ТОГДА 
			Возврат "01070";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР ТОГДА 
			Возврат "01081";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих ТОГДА 
			Возврат "01082";
		Иначе  
			Возврат "01089";
		КонецЕсли;
		
	ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ЗакрытиеДепозитногоВклада
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.РазмещениеДенежныхСредствНаДепозитномВкладе
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу  ТОГДА 
		
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов ТОГДА 
			Возврат "01120";
		ИначеЕсли  СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда ТОГДА 
			Возврат "01220";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами 
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов ТОГДА 
			Возврат "01320";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих ТОГДА 
			Возврат "01970";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный ТОГДА 
			Возврат "01790";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР ТОГДА 
			Возврат "01696";
		Иначе  
			Возврат "01699";
		КонецЕсли;
		
	ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		И (ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПолучениеЗайма
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыплатаПроцентовПоЗаймуПолученному
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПогашениеЗаймаПолученного) ТОГДА
		Возврат "01970";
		
	ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда
		И (ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыдачаЗайма
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПогашениеЗаймаВыданного
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоЗаймуВыданному)
		ИЛИ (ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата И ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоЗаймуПроценты)
		ИЛИ (ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата И ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоИнвестконтракту)
		ИЛИ (ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата И ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоСделкеСНедвижимостью) ТОГДА
		Возврат "01290";
		
	ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата
		И (ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоСделке
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюКупона
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюОблигации
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюПая
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоПогашениюВекселя
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоТорговойКомиссии
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии)
		ИЛИ ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств
		И (ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет
		ИЛИ ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера) Тогда
		
		Если СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов ТОГДА 
			Возврат "01110";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда ТОГДА 
			Возврат "01210";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами 
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
			ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов ТОГДА 
			Возврат "01310";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР ТОГДА 	
			Возврат "01696";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих ТОГДА 
			Возврат "01970";
		ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный ТОГДА 
			Возврат "01790";
		Иначе 
			Возврат "01699";
		КонецЕсли;
		
	ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаНДФЛ Тогда	
		Возврат "01950";
		
	ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата
	    И (ВариантДвиженияДенежныхСредств.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.НДФЛ)
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНалогуНаПрибыль
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоЗемельномуНалогу
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНалогуНаДобавленнуюСтоимость
		ИЛИ ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНалогуНаИмущество) Тогда
		Возврат "01950";
	ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата
			И ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям Тогда
		Возврат "01060";
	ИначеЕсли ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.ИзКассыНаРасчетныйСчет ТОГДА 
		Возврат "01810";
	ИначеЕсли ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаВКассу Тогда
		Возврат "01820";
	ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств
		И ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.ПоЗаявкеПайщика ТОГДА 
		Если Регистратор.РасчетныйСчет.ТранзитныйПИФ  Тогда
			Возврат "01061";
		Иначе
			Возврат "01700";
		КонецЕсли;
	ИначеЕсли ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего ТОГДА 
		Возврат "01750";
		
	ИначеЕсли (ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств
		И (ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.ВПуть
		ИЛИ ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.ИзПути
		ИЛИ ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.МеждуРасчетнымиСчетами)) Тогда
		Возврат "01700";
	ИначеЕсли СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.Собственный ТОГДА 
		Возврат "01990";
	Иначе
		Возврат "01970";
	
	КонецЕсли;
	
КонецФункции

