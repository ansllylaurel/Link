#КонецОбласти

//Сведения об утверждении уполномоченным органом повестки дня общего собрания акционеров (участников), содержащей вопрос об утверждении аудиторской организации (аудитора) акционерного инвестиционного фонда (управляющей компании инвестиционных фондов, паевых инвестиционных фондов и негосударственных пенсионных фондов)
#Область ОКУД0420515_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420515(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420515";
	ПакетДанных = Новый Структура;
	ПризнакНулевогоОтчета = Истина;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);	
	
	Если ЭтотОбъект.СформироватьНулевойОтчет Тогда
		ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
		Возврат ПакетДанных;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",									ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Руководитель",									ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации",					ИсключаемыеГоловныеОрганизации);
	Запрос.УстановитьПараметр("Аудитор",										ЭтотОбъект.Аудитор);
	Запрос.УстановитьПараметр("ДатаОкончания",									ЭтотОбъект.Период.ДатаОкончания);	
	Запрос.УстановитьПараметр("НаименованиеУполномоченногоОргана",				ЭтотОбъект.НаименованиеУполномоченногоОргана);	
	Запрос.УстановитьПараметр("ВерсияТаксономии", 								ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ВидыОтчетностиПодлежащиеАудиторскойПроверке",	ВыгрузитьЗначения(ЭтотОбъект.ВидыОтчетностиПодлежащиеАудиторскойПроверке, Истина));	
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаСобранияАкционеров) Тогда //если КоличествоАкционеровОбщества <> 1, то реквизит ДатаСобранияАкционеров доступен и обязателен
		Запрос.УстановитьПараметр("ДатаСобранияАкционеров",		ЭтотОбъект.ДатаСобранияАкционеров);	
		Запрос.УстановитьПараметр("ДатаУтвержденияПовесткиДня", ЭтотОбъект.Период.ДатаОкончания);	
		
	Иначе //если КоличествоАкционеровОбщества = 1, то реквизит ДатаСобранияАкционеров недоступен и очищается		
		Запрос.УстановитьПараметр("ДатаСобранияАкционеров",		ЭтотОбъект.Период.ДатаОкончания);	
		Запрос.УстановитьПараметр("ДатаУтвержденияПовесткиДня",	Неопределено);	
		
	КонецЕсли;
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420515();
	Запрос.Выполнить();
	
	ДатыДляПакетаXBRL = Новый Структура;
	ДатыДляПакетаXBRL.Вставить("Date_From"	, ЭтотОбъект.Период.ДатаОкончания);
	ДатыДляПакетаXBRL.Вставить("Date_To"	, ЭтотОбъект.Период.ДатаОкончания);
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;

