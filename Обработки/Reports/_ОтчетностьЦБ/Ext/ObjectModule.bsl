					ИначеЕсли ТипЗнч(Субконто2) = Тип("СправочникСсылка.Паи") Тогда
						СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "паев " + РаботаСОтчетами.ПолучитьПредставлениеЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания, Ложь); 
					ИначеЕсли ТипЗнч(Субконто2) = Тип("СправочникСсылка.Доли") Тогда
						РеквизитыЦБ = РаботаСОтчетами.ПолучитьРеквизитыЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания);
						СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + " в уставном капитале " + РеквизитыЦБ.КраткоеНаименованиеЭмитентаПоУставу;
					Иначе
						СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + РаботаСОтчетами.ПолучитьПредставлениеЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания, Ложь); 
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ СведенияОСущественномИзмененииСЧАВПроцентах Тогда
