Процедура ОКУД0420513_ЗаполнитьПечатнуюФорму(Запрос, Результат, Отказ) Экспорт
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР) Тогда

		Макет = ПолучитьМакет("ОКУД0420513");	
		
		ВывестиОбласть(Результат, Макет, "Раздел1",		Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПечатнаяФорма_Раздел1").ПолучитьДанные().Выгрузить());
		ВывестиОбласть(Результат, Макет, "Раздел2",		Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПечатнаяФорма_Раздел2").ПолучитьДанные().Выгрузить());
		ВывестиОбласть(Результат, Макет, "Раздел3",		Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПечатнаяФорма_Раздел3").ПолучитьДанные().Выгрузить());
		ВывестиОбласть(Результат, Макет, "Подписанты",	Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПечатнаяФорма_Подписанты").ПолучитьДанные().Выгрузить());
		
	КонецЕсли;

