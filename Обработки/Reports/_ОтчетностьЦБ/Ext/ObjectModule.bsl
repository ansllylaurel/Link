Процедура ЗаполнитьПояснительнуюЗаписку_ОКУД0420418(Результат, Запрос, Отказ) Экспорт
	
	Макет = ПолучитьМакет("ПояснительнаяЗаписка");
	ИмяОбласти = "|Общая";
	
	ПояснительнаяЗаписка = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПояснительнаяЗаписка", Отказ);
	
	Если ПояснительнаяЗаписка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПояснительнойЗаписки = ПояснительнаяЗаписка[0];
	
	ПараметрыЗаполнения = Новый Структура;
	
	ПараметрыЗаполнения.Вставить("ПолноеНаименованиеПоУставу",	ДанныеПояснительнойЗаписки.ПолноеНаименованиеПоУставу);
	
	ПараметрыЗаполнения.Вставить("Период", 			НРег(ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания)));
	ПараметрыЗаполнения.Вставить("ДатаНачала", 		Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	ПараметрыЗаполнения.Вставить("ДатаОкончания", 	Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО");	
	
	ПараметрыЗаполнения.Вставить("Ответственный",		РеквизитыОтветственного.ФИО);
	ПараметрыЗаполнения.Вставить("ТелефонИсполнителя ", ДанныеПояснительнойЗаписки.Телефоны);
	ПараметрыЗаполнения.Вставить("ВариантОтчета",		ЭтотОбъект.ВариантОтчета);
	
	Если ДанныеПояснительнойЗаписки.МаксимальныйИнвестиционныйГоризонт - ДанныеПояснительнойЗаписки.МинимальныйИнвестиционныйГоризонт > 1 Тогда
		ВызватьИсключение "Разница между горизонтами стратегий больше 1 дня. Мы к такому не были готовы.";
	КонецЕсли;
	
	ПараметрыЗаполнения.Вставить("ТекстПояснительнойЗаписки", 
								ДанныеПояснительнойЗаписки.ПолноеНаименованиеПоУставу + " сообщает, что в Разделе 2. " + 
								"Сведения об осуществлении деятельности по доверительному управлению Подраздел 2.2. " + 
								"Сведения о стандартных стратегиях управления указан инвестиционный горизонт по стратегии 1096 дней. " + 
								"При этом по договорам, заключенным после " + Формат(ДанныеПояснительнойЗаписки.Последнее29Февраля, "ДФ=dd.MM.yyyy") + " г. инвестиционный горизонт меньше на 1 день в связи с отсутствием високосных лет в горизонте.");
	
	ВывестиОбласть(Результат, Макет, "Шапка" + ИмяОбласти, ПараметрыЗаполнения);
	ВывестиОбласть(Результат, Макет, "ТекстПояснительнойЗаписки" + ИмяОбласти, ПараметрыЗаполнения);
	ВывестиОбласть(Результат, Макет, "Подпись" + ИмяОбласти, ПараметрыЗаполнения);
	
КонецПроцедуры

Процедура ЗаполнитьПечатнуюФорму_ОКУД0420418(Запрос, Результат, Отказ) Экспорт
	
	Результат.Очистить();
	
	РаботаСОтчетностьюЦБ.ОКУД0420418_ВыполнитьЗапросы(ЭтотОбъект, Запрос);
	
#Область Макет
	Макет = ПолучитьМакет("ОКУД0420418");
	
	ОбластьШапка			= Макет.ПолучитьОбласть("Шапка");
