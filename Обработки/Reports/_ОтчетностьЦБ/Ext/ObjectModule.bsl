		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК ЮридическийАдрес
		|		ПО ВложенныйЗапрос.Договор.Контрагент = ЮридическийАдрес.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВхожденияВРеестры.СрезПоследних(&ДатаОкончания, ВидРеестра = ЗНАЧЕНИЕ(Справочник.ВидыРеестров.СРОАудиторов)) КАК РеестрАудиторов
		|		ПО (РеестрАудиторов.ЮрФизЛицо = ВложенныйЗапрос.Договор.Контрагент)
		|			И (НЕ РеестрАудиторов.ИсключенИзРеестра)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВхожденияВРеестры.СрезПоследних(&ДатаОкончания, ВидРеестра = ЗНАЧЕНИЕ(Справочник.ВидыРеестров.ГосударственныйРеестрСаморегулируемыхОрганизацийАудиторов)) КАК ГосударственныйРеестрСРО
		|		ПО (ГосударственныйРеестрСРО.ЮрФизЛицо = РеестрАудиторов.ДержательРеестра)
		|			И (НЕ ГосударственныйРеестрСРО.ИсключенИзРеестра)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСРО
		|		ПО (РеестрАудиторов.ДержательРеестра = РеквизитыСРО.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.Договор.Контрагент = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &ДатаОкончания)";
	
	Возврат ТекстЗапроса;
	
КонецФункции	

#КонецОбласти

// Отчет по банковским счетам
#Область ОКУД0420409_XBRL

Функция ОКУД0420409_XBRL_ПолучитьДанные(Запрос, Отказ) Экспорт 

	ИмяПакета = "ОКУД0420409";
	ПакетДанных = Новый Структура;     
	
	ПередФормированиемОтчетностиXBRL(Истина);

	// #545222 Добавление депозитов с ЦК
	ИсключаемыеКлиенты = Новый Массив;
	ИсключаемыеКлиенты.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_РегионЭсМАО"));

	Запрос.УстановитьПараметр("ДатаНачала"		,                                   ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	,                                   ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ГраницаОкончания",                                   Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"		,                                   ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЭтоРПИ"			,                                   ЭтотОбъект.ЭтоРПИ);
	Запрос.УстановитьПараметр("ПустоеЗначение"	,                                   "Неприменимо");
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	,                   ИсключаемыеГоловныеОрганизации);	
	Запрос.УстановитьПараметр("ВключатьТранзитныеВалютныеСчета"	,                   ЭтотОбъект.Период.ДатаОкончания < Дата(2020,8,1));
	Запрос.УстановитьПараметр("ОтборПоВидуЛицензии"				,                   ЭтотОбъект.Период.ДатаОкончания < Дата(2019,9,1));
	Запрос.УстановитьПараметр("ВерсияТаксономии",                                   ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ВозможностьИспользованияСобственныхДенежныхСредств", ОКУД0420409_ПолучитьВозможностьИспользованияСобственныхДенежныхСредств());	
	Запрос.УстановитьПараметр("ЮрЛицоНКО_НКЦ",                                      ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
	Запрос.УстановитьПараметр("ИсключаемыеКлиенты",                                 ИсключаемыеКлиенты);
	Запрос.УстановитьПараметр("ВключатьСредстваПоЛицензииУКПИФ",                    ЭтотОбъект.Период.ДатаОкончания < Дата(2025, 12, 31));
	Запрос.УстановитьПараметр("УчитыватьСлияниеУК",                                 ЭтотОбъект.ЭтоРЭМ);
	
	//РПИ. Хардкод для добавления оборотов по ошибочно зачисленным д/с, по базе не проведённым.
	Запрос.УстановитьПараметр("РС_40701810000005000026", 							ОбщегоНазначения.ПолучитьИменованныйОбъект("РС_40701810000005000026"));
	
	
	Если ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		Запрос.УстановитьПараметр("ДатаКурсаВалютНаНачало", ЭтотОбъект.Период.ДатаНачала - 86400);
	Иначе	
		Запрос.УстановитьПараметр("ДатаКурсаВалютНаНачало", ЭтотОбъект.Период.ДатаНачала);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);
	
	ОКУД0420409_XBRL_ЗаполнитьВременныеТаблицы(Запрос, Отказ);

	ДополнительныеПакеты = Новый Структура;
	МалоеПредприятие     = (РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьКатегориюПрофУчастника(ЭтотОбъект, Отказ) = Перечисления.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый);
	Если ЭтотОбъект.ВерсияТаксономии >= "6_1" И ЭтотОбъект.Период.ДатаОкончания = КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) Тогда
		
		// В версии таксономии 6.1 отчет 431 переехал в другие точки входа на конец квартала (года), а в одной точке входа с 409-м отчетом осталсяся 459-й, 
		// который ЦБ предлагает оставить пустым с указанием отсутствия показателей в отчете  (#595529)
		
		// 2.7. Особенности отражения информации в отчетности по форме 0420409 по точкам входа "ep_nso_purcb_m_q_10rd_ex_reestr_0420417_mal", "ep_nso_purcb_y_10rd_ex_reestr_0420417_mal"
		
		ДополнительныеПакеты.Вставить("ОКУД0420459", Истина);
		
	КонецЕсли;	

	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, , Отказ, ДополнительныеПакеты);

	Возврат ПакетДанных;
	
КонецФункции

Процедура ОКУД0420409_XBRL_ЗаполнитьВременныеТаблицы(Запрос, Отказ)
	
#Область ТекстЗапроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ _СчетаВСемерке
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""УчетНеВедется"")
		|			И (ЗначенияДополнительныхСведений.Значение = ИСТИНА)
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|	И &ЭтоРПИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления.Код КАК Код,
		|	ДатаПередачиМеждуУК.Значение КАК ДатаПередачи,
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности КАК ЛицензияВидДеятельности,
		|	РеквизитыБрокера.КраткоеНаименованиеПоУставу КАК СокрНаименованиеБрокера,
		|	РеквизитыБрокера.ИНН КАК ИННБрокера,
		|	""BrokerOrInostrannyjBrokerMember"" КАК ВидБрокера,
		|	ВЫБОР
		|		КОГДА РеквизитыБрокера.МеждународнаяКомпания
		|			ТОГДА ВЫБОР
		|					КОГДА РеквизитыБрокера.СпособСозданияМеждународнойКомпании = ЗНАЧЕНИЕ(Перечисление.СпособыСозданияМеждународнойКомпании.Редомициляция)
		|							ИЛИ &ВерсияТаксономии < ""7_1""
		|						ТОГДА ""996""
		|					ИНАЧЕ ""995""
		|				КОНЕЦ
		|		ИНАЧЕ РеквизитыБрокера.СтранаРегистрации.Код
		|	КОНЕЦ КАК КодСтраныБрокера,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ОстаткиДенежныхСредствОстатки.Валюта.Код КАК КодВалюты,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность КАК СуммаВРублях,
		|	УсловияДоговоровБрокерскогоОбслуживанияСрезПоследних.ВозможностьИспользованияДенежныхСредствБрокером КАК ВозможностьИспользованияДенежныхСредствБрокером,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|			ТОГДА ""Sobstv_sredstvaMember""
		|		ИНАЧЕ ""Den_sred_bez_pravaMember""
		|	КОНЕЦ КАК КатегорияДС,
		|	ОстаткиДенежныхСредствОстатки.Брокер.ЮрФизЛицо КАК БрокерЮрФизЛицо,
		|	ОстаткиДенежныхСредствОстатки.Брокер КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания КАК ДоговорБрокерскогоОбслуживания
		|ПОМЕСТИТЬ _ДеньгиУБрокераПредварительная
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&ГраницаОкончания,
		|			Организация = &Организация
		|				И Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.)) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО ОстаткиДенежныхСредствОстатки.Организация = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация
		|			И ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредствОстатки.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровБрокерскогоОбслуживания.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК УсловияДоговоровБрокерскогоОбслуживанияСрезПоследних
		|		ПО (КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровБрокерскогоОбслуживанияСрезПоследних.Договор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО ОстаткиДенежныхСредствОстатки.Валюта = КурсыВалют.Валюта
		|			И (КурсыВалют.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыБрокера
		|		ПО ОстаткиДенежныхСредствОстатки.Брокер.ЮрФизЛицо = РеквизитыБрокера.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			МАКСИМУМ(ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия) КАК Лицензия
		|		ИЗ
		|			РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|		ГДЕ
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Организация,
		|			ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|		ПО ОстаткиДенежныхСредствОстатки.Организация = ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Организация
		|			И ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаПередачиМеждуУК
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = ДатаПередачиМеждуУК.Объект
		|			И (ДатаПередачиМеждуУК.Свойство.Ключ = ""_ОтчетностьЦБ.ДатаПередачиМеждуУК"")
		|ГДЕ
		|	(ЕСТЬNULL(ДатаПередачиМеждуУК.Значение, ДАТАВРЕМЯ(1, 1, 1)) <= &ДатаОкончания
		|			ИЛИ НЕ &УчитыватьСлияниеУК)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления.Код,
		|	ДатаПередачиМеждуУК.Значение,
		|	ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности,
		|	РеквизитыБрокера.КраткоеНаименованиеПоУставу,
		|	РеквизитыБрокера.ИНН,
		|	""Kliring_OrgMember"",
		|	ВЫБОР
		|		КОГДА РеквизитыБрокера.МеждународнаяКомпания
		|			ТОГДА ВЫБОР
		|					КОГДА РеквизитыБрокера.СпособСозданияМеждународнойКомпании = ЗНАЧЕНИЕ(Перечисление.СпособыСозданияМеждународнойКомпании.Редомициляция)
		|							ИЛИ &ВерсияТаксономии < ""7_1""
		|						ТОГДА ""996""
		|					ИНАЧЕ ""995""
		|				КОНЕЦ
		|		ИНАЧЕ РеквизитыБрокера.СтранаРегистрации.Код
		|	КОНЕЦ,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток,
		|	ОстаткиДенежныхСредствОстатки.Валюта.Код,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток * КурсыВалют.Курс / КурсыВалют.Кратность,
		|	"""",
