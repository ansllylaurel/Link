Процедура ЗаполнитьСписокАвтосравненияСПредыдущимПериодом(СписокАвтосравнения) Экспорт
	
	СписокАвтосравнения.Очистить();
	ТаблицаИзМакета = ПолучитьТаблицуИзМакета("АвтосравнениеСПредыдущимПериодом"); 
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПериодичностьОтчета", ЭтотОбъект.ПериодичностьОтчета);
	Если ЭтотОбъект.ЭтоРЭМ Тогда
		Отбор.Вставить("РЭМ", "ДА");
	ИначеЕсли ЭтотОбъект.ЭтоТраст Тогда
		Отбор.Вставить("Траст", "ДА");
	ИначеЕсли ЭтотОбъект.ЭтоРПИ Тогда
		Отбор.Вставить("РПИ", "ДА");
	ИначеЕсли ЭтотОбъект.ЭтоМДТраст Тогда
		Отбор.Вставить("МДТраст", "ДА");
	ИначеЕсли ЭтотОбъект.ЭтоДК Тогда
		Отбор.Вставить("ДК", "ДА");
	КонецЕсли;	
	
	НайденныеСтроки = ТаблицаИзМакета.НайтиСтроки(Отбор);
	
	ОтчетыДляАвтосравнения = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		ОтчетыДляАвтосравнения.Добавить(СтрокаТаблицы.ИмяПакета);
	КонецЦикла;	
	СписокАвтосравнения.ЗагрузитьЗначения(ОтчетыДляАвтосравнения);
	
КонецПроцедуры

#КонецОбласти

#Область ДополнительныеПроцедурыИФункцииXBRL

// При получении значений открытых осей с выгрузкой не массива ссылок, а таблицы значений с уникальными идентификаторами строк, значения осей могут повторяться в разных строках
// исходной таблицы значений. Но это никак не учтено в проверке уникальности значений оси в процедуре ПолучитьМассивЗначенийОсей()
// Реализовано через отдельную функцию, чтобы обойти "ошибку" проверки и пока для конкретного отчета
Функция КонтрольУникальностиЗначенийОсиНеНужен(ИмяТаблицы, ИмяКолонки)
	
	Результат = Ложь;
	
	Если СтрНайти("SR_0420415_R1_PR1_3_1, SR_0420415_R1_PR1_3_2, SR_0420415_R1_PR1_3_3", ИмяТаблицы) > 0 
		И ИмяКолонки = "IDOrgVedUchPravCBTaxis" Тогда
		
		Результат = Истина;		
		
	КонецЕсли;	
	Возврат Результат;
	
КонецФункции	

Функция СформироватьМассивСтрокXBRL(Данные, ФорматныеСтроки = "", ИмяТаблицы = "", ИмяРаздела = "",  ПризнакНулевогоОтчета = Ложь, Отказ = Ложь)
	
	ДобавитьВПакетДаты(Данные);
	
	МассивСтрок		= Новый Массив;
	МассивКолонок	= Новый Массив;
	ПоляСортировки	= Новый Массив;
	МассивКолонокОткрытыхОсей = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ФорматныеСтроки) Тогда
		ФорматныеСтроки = Новый Структура;
	КонецЕсли;
	
	Для Каждого Колонка Из Данные.Колонки Цикл
		Если Прав(Колонка.Имя, 5) = "Taxis" Тогда
			Если СтрНачинаетсяС(ИмяПакета, "ОКУД04205") 
			 ИЛИ СтрНачинаетсяС(ИмяПакета, "ОКУД04208")
			 ИЛИ Колонка.Имя = "ID_strokiTaxis"
			 ИЛИ Колонка.Имя = "Id_Vekselya_UchtennTaxis"
			 ИЛИ Колонка.Имя = "Id_VekseledatelyaTaxis" 
			 ИЛИ ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
				МассивКолонокОткрытыхОсей.Добавить(Колонка);
				
			КонецЕсли;
			
		ИначеЕсли ИмяПакета = "ОКУД0420417" И (Колонка.Имя = "IDCZBPoPervojChastiSdelki" Или Колонка.Имя = "IDCZBPoVtorojChastiSdelki") Тогда 
			МассивКолонокОткрытыхОсей.Добавить(Колонка);
			
		ИначеЕсли ИмяПакета = "ОКУД0420431" И (Колонка.Имя = "Naim_PFI") Тогда 
			МассивКолонокОткрытыхОсей.Добавить(Колонка);

		ИначеЕсли ИмяПакета = "ОКУД0420502" И (Колонка.Имя = "SrokPlatezhaPoVekselyu") Тогда 
			МассивКолонокОткрытыхОсей.Добавить(Колонка);

		КонецЕсли;
		
		МассивКолонок.Добавить(Колонка.Имя);
		
		Если Колонка.Имя = "ID_strokiTaxis" Тогда
			ПоляСортировки.Вставить(0, Колонка.Имя);
		ИначеЕсли Колонка.Имя = "ПолеСортировки" Тогда
			ПоляСортировки.Вставить(0, Колонка.Имя);
		ИначеЕсли ВРЕГ(Прав(Колонка.Имя, 4)) = "AXIS" Тогда
			ПоляСортировки.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если ПоляСортировки.Количество() И ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		Данные.Сортировать(СтрСоединить(ПоляСортировки, ","));
	КонецЕсли;
	
	Для Каждого Колонка Из МассивКолонокОткрытыхОсей Цикл
		ИмяКолонки 			= Колонка.Имя;
		ИндексКолонки		= Данные.Колонки.Индекс(Колонка);
		МассивЗначенийОсей	= ПолучитьМассивЗначенийОсей(Данные, ИмяКолонки, Истина И Не КонтрольУникальностиЗначенийОсиНеНужен(ИмяТаблицы, ИмяКолонки), Отказ);
		
		Данные.Колонки.Удалить(ИмяКолонки);
		Данные.Колонки.Вставить(ИндексКолонки, ИмяКолонки);
		Данные.ЗагрузитьКолонку(МассивЗначенийОсей, ИмяКолонки);
	КонецЦикла;
	
	Если ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
		КонтрольУникальностиНаборовОсей(Данные, ИмяРаздела, Отказ);	
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ДанныеСтроки = Новый Структура;
		
		Для Каждого Колонка Из МассивКолонок Цикл
			СериализованноеЗначение = СериализоватьЗначениеXBRL(СтрокаДанных, Колонка, ИмяТаблицы, ФорматныеСтроки, Отказ);
			
			Если ЗначениеЗаполнено(СериализованноеЗначение) Тогда
				ДанныеСтроки.Вставить(Колонка, СериализованноеЗначение);
			КонецЕсли;
			
		КонецЦикла;
		
		МассивСтрок.Добавить(ДанныеСтроки);
		ПодменаДанныхВОжиданииДоработкиКонфигурации(ИмяТаблицы, ДанныеСтроки, МассивСтрок);
		
	КонецЦикла;
	
	Если МассивСтрок.Количество() > 0 Тогда
		ПризнакНулевогоОтчета = Ложь;
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Процедура КонтрольОбязательныхРеквизитов(ВременнаяТаблица, ИмяТаблицы, ИмяРаздела, КонтрольВсехРазделов, Отказ)
	
	Если ТипЗнч(ТаблицаКонтроля) <> Тип("ТаблицаЗначений") Тогда
		ТаблицаКонтроля = ПолучитьТаблицуИзМакета("КонтрольОбязательныхРеквизитов", ИмяПакета, Отказ, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии));
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ИмяТаблицы", ИмяТаблицы);
	НайденныеСтроки = ТаблицаКонтроля.НайтиСтроки(ПараметрыПоиска);
	
	Если КонтрольВсехРазделов И НайденныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для отчёта включен контроль все разделов, но в таблице контроля не описана таблица" + ИмяТаблицы,,,, Отказ);
	КонецЕсли;
		
	Если НайденныеСтроки.Количество() Тогда
		ОписаниеТаблицы = ПолучитьОписаниеТаблицы(ИмяРаздела, Отказ);
	
		Для Каждого СтрокаКонтроля Из НайденныеСтроки Цикл
			Реквизиты = СтрРазделить(СтрокаКонтроля.Реквизиты, ",");
			Если СтрокаКонтроля.ВсеКроме Тогда
				Для Каждого Поле Из ОписаниеТаблицы.Элементы Цикл
					Если Реквизиты.Найти(Поле.Имя) = Неопределено Тогда
						Для Каждого СтрокаДанных Из ВременнаяТаблица Цикл
							Если ПустаяСтрока(СтрокаКонтроля.ОсновнойРеквизит)
							 ИЛИ (ПустаяСтрока(СтрокаКонтроля.ЗначениеОсновногоРеквизита) И ЗначениеЗаполнено(СтрокаДанных[СтрокаКонтроля.ОсновнойРеквизит]))
							 ИЛИ (НЕ ПустаяСтрока(СтрокаКонтроля.ЗначениеОсновногоРеквизита) И СтрокаДанных[СтрокаКонтроля.ОсновнойРеквизит] = Вычислить(СтрокаКонтроля.ЗначениеОсновногоРеквизита)) Тогда
								Если НЕ ЗначениеЗаполнено(СтрокаДанных[Поле.Имя]) Тогда
									ТекстСообщения = СтрЗаменить(СтрокаКонтроля.ТекстСообщения, "[ИмяТаблицы]",		ОписаниеТаблицы.Представление + " (" + ИмяРаздела + ")");
									ТекстСообщения = СтрЗаменить(ТекстСообщения,				"[ИмяРеквизита]",	Поле.Представление + " (" + Поле.Имя + ")");
									
									Если ЗначениеЗаполнено(СтрокаКонтроля.ПолеСсылки) Тогда
										ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаДанных[СтрокаКонтроля.ПолеСсылки], СтрокаКонтроля.РеквизитСсылки,, ?(СтрокаКонтроля.Отказ, Отказ, Ложь));
									Иначе
										ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ?(СтрокаКонтроля.Отказ, Отказ, Ложь));
									КонецЕсли;
									
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			Иначе
				Для Каждого ИмяРеквизита Из Реквизиты Цикл 
					Для Каждого СтрокаДанных Из ВременнаяТаблица Цикл
						Если ПустаяСтрока(СтрокаКонтроля.ОсновнойРеквизит)
						 ИЛИ (ПустаяСтрока(СтрокаКонтроля.ЗначениеОсновногоРеквизита) И ЗначениеЗаполнено(СтрокаДанных[СтрокаКонтроля.ОсновнойРеквизит]))
						 ИЛИ (НЕ ПустаяСтрока(СтрокаКонтроля.ЗначениеОсновногоРеквизита) И СтрокаДанных[СтрокаКонтроля.ОсновнойРеквизит] = Вычислить(СтрокаКонтроля.ЗначениеОсновногоРеквизита)) Тогда
							Если НЕ ЗначениеЗаполнено(СтрокаДанных[ИмяРеквизита]) Тогда
								ТекстСообщения = СтрЗаменить(СтрокаКонтроля.ТекстСообщения, "[ИмяТаблицы]",		ОписаниеТаблицы.Представление + " (" + ИмяРаздела + ")");
								ТекстСообщения = СтрЗаменить(ТекстСообщения,				"[ИмяРеквизита]",	ИмяРеквизита);
								ТекстСообщения = ПреобразоватьЗначениеПоШаблону(СтрокаДанных, ТекстСообщения,, Отказ);
								
								Если ЗначениеЗаполнено(СтрокаКонтроля.ПолеСсылки) Тогда
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СтрокаДанных[СтрокаКонтроля.ПолеСсылки], СтрокаКонтроля.РеквизитСсылки,, ?(СтрокаКонтроля.Отказ, Отказ, Ложь));
								Иначе
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ?(СтрокаКонтроля.Отказ, Отказ, Ложь));
								КонецЕсли;
								
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура КонтрольУникальностиНаборовОсей(ВременнаяТаблица, ИмяРаздела, Отказ)
	
	Если Ложь Тогда
		ВременнаяТаблица = Новый ТаблицаЗначений;
	КонецЕсли;
	
	МассивИменОсей = Новый Массив;
	Для Каждого Колонка Из ВременнаяТаблица.Колонки Цикл
		Если Врег(Колонка.Имя) = "DATE_FROM"
		 Или Врег(Колонка.Имя) = "DATE_TO"
		 Или СтрЗаканчиваетсяНа(Врег(Колонка.Имя), "AXIS") Тогда
			МассивИменОсей.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Данные = ВременнаяТаблица.Скопировать(, СтрСоединить(МассивИменОсей, ","));
	Данные.Колонки.Добавить("Флаг");
	Данные.ЗаполнитьЗначения(1, "Флаг");
	Данные.Свернуть(СтрСоединить(МассивИменОсей, ","), "Флаг");
	
	МассивНеуникальныхСтрок = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если СтрокаДанных.Флаг > 1 Тогда
			МассивНеуникальныхСтрок.Добавить(СтрокаДанных);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивНеуникальныхСтрок.Количество() > 0 Тогда
		ОписаниеТаблицы = ПолучитьОписаниеТаблицы(ИмяРаздела, Отказ);
		
		Для Каждого СтрокаДанных Из МассивНеуникальныхСтрок Цикл
			МассивСообщений = Новый Массив;
			МассивСообщений.Добавить(СтрШаблон("Обнаружено несколько строк с одинаковым набором значений осей в таблице '%1' (%2)", ИмяРаздела, ОписаниеТаблицы.Представление));
			МассивСообщений.Добавить("_");
			
			Для Каждого ИмяОси Из МассивИменОсей Цикл
				Значение	  = СтрокаДанных[ИмяОси];
				Представление = "";
				
				Для Каждого ОписаниеЭлемента Из ОписаниеТаблицы.Элементы Цикл
					Если ОписаниеЭлемента.Имя = ИмяОси Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				ИмяПеречисления = СтрЗаменить(ОписаниеЭлемента.Тип, "tns:type", "enum");
				
				Если ТипыОбъектов.Свойство(ИмяПеречисления) Тогда
					Для Каждого ЭлементПеречисления Из ТипыОбъектов[ИмяПеречисления].Перечисление Цикл
						Если Значение = ЭлементПеречисления.Имя Тогда
							Представление = ЭлементПеречисления.Представление;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если ПустаяСтрока(Представление) Тогда
					МассивСообщений.Добавить(СтрШаблон("%1 (%2): %3", ОписаниеЭлемента.Представление, ИмяОси, Значение));
				Иначе
					МассивСообщений.Добавить(СтрШаблон("%1 (%2): %3 (%4)", ОписаниеЭлемента.Представление, ИмяОси, Представление, Значение));
				КонецЕсли;
			КонецЦикла;
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(МассивСообщений, Символы.ПС),,,, Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПреобразоватьЗначениеПоШаблону(СтрокаДанных, Шаблон, ДополнениеОписанияОшибки = "", Отказ)
	
	ЭлементыШаблона = СтрРазделить(Шаблон, "[]");
	
	Для Индекс = 0 По ЭлементыШаблона.Количество() - 1 Цикл
		ЭлементШаблона = ЭлементыШаблона[Индекс];
		
		Если Лев(ЭлементШаблона, 2) = "##" Тогда //Функция
			ЧастиПеременной = СтрРазделить(ЭлементШаблона, "#", Ложь);
			
			Значение = ДополнительноеОписаниеЗначенияПоШаблону(СтрокаДанных, "##" + ЧастиПеременной[0], ДополнениеОписанияОшибки, Отказ);
			
			Если ЧастиПеременной.Количество() > 1 Тогда
				ЭлементыШаблона.Установить(Индекс, Формат(Значение, ЧастиПеременной[1]));
			Иначе
				ЭлементыШаблона.Установить(Индекс, Значение);
			КонецЕсли;
			
		ИначеЕсли СтрНачинаетсяС(ЭлементШаблона, "#ПредставлениеПериода") Тогда //Переменная	
			ЧастиПредставленияПериода = СтрРазделить(ЭлементШаблона, "(,)");
			
			Попытка
				ДатаНачалаСтандартногоПериода		= Вычислить("СтрокаДанных." + ЧастиПредставленияПериода[1]);
				ДатаОкончанияСтандартногоПериода	= Вычислить("СтрокаДанных." + ЧастиПредставленияПериода[2]);
				ФорматнаяСтрока	= ?(ЧастиПредставленияПериода.Количество() = 4, ЧастиПредставленияПериода[3], "");
				
				ЭлементыШаблона.Установить(Индекс, ПредставлениеПериода(ДатаНачалаСтандартногоПериода, КонецДня(ДатаОкончанияСтандартногоПериода), ФорматнаяСтрока));
				
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить представление периода по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки,,,, Отказ);
			КонецПопытки;
			
		ИначеЕсли Лев(ЭлементШаблона, 1) = "#" Тогда //Переменная
			
			ЧастиПеременной = СтрРазделить(ЭлементШаблона, "#", Ложь);
			Если ЧастиПеременной.Количество() > 0 Тогда
				ЭлементыПути = СтрРазделить(ЧастиПеременной[0], ".");
				Если ЭлементыПути.Количество() > 0 Тогда
					Попытка
						Значение = СтрокаДанных;
						
						Для Каждого Идентификатор Из ЭлементыПути Цикл
							Значение = Значение[Идентификатор];
						КонецЦикла;
						
						Если ЧастиПеременной.Количество() = 2 Тогда
							Значение = НРег(Формат(Значение, ЧастиПеременной[1]));
						КонецЕсли;
						
						ЭлементыШаблона.Установить(Индекс, Значение);
					Исключение
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить переменную по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки,,,, Отказ);
					КонецПопытки;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(ЭлементыШаблона);
	
КонецФункции

Функция ДополнительноеОписаниеЗначенияПоШаблону(СтрокаДанных, ЭлементШаблона, ДополнениеОписанияОшибки, Отказ)
	
	ДополнительноеОписаниеЗадолженности = "";
	
#Область ОписаниеЦенныхБумагСделкиРЭМ 
	Если ЭлементШаблона = "##ОписаниеЦенныхБумагСделкиРЭМ" Тогда
		
		Если НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.Сделка")
			И НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый тип в основании: " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса_ЦенныеБумаги();
		
		Запрос.Текст = Запрос.Текст + ";" +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.Вид КАК Вид,
			|	ВложенныйЗапрос.НаименованиеЭмитента КАК НаименованиеЭмитента
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ЦенныеБумаги.Вид КАК Вид,
			|		ПОДСТРОКА(ВЫБОР
			|				КОГДА _ЦенныеБумаги.ЭмитентРезидентРФ
			|					ТОГДА _ЦенныеБумаги.КраткоеНаименованиеПоУставуРусский
			|				ИНАЧЕ _ЦенныеБумаги.КраткоеНаименованиеПоУставуАнглийский
			|			КОНЕЦ, 1, 150) КАК НаименованиеЭмитента
			|	ИЗ
			|		Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
			|			ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
			|			ПО СделкаЦенныеБумаги.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага
			|	ГДЕ
			|		СделкаЦенныеБумаги.Ссылка = &Ссылка
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		_ЦенныеБумаги.Вид,
			|		ПОДСТРОКА(ВЫБОР
			|				КОГДА _ЦенныеБумаги.ЭмитентРезидентРФ
			|					ТОГДА _ЦенныеБумаги.КраткоеНаименованиеПоУставуРусский
			|				ИНАЧЕ _ЦенныеБумаги.КраткоеНаименованиеПоУставуАнглийский
			|			КОНЕЦ, 1, 150)
			|	ИЗ
			|		Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
			|			ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
			|			ПО СделкаРЕПОЦенныеБумаги.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага
			|	ГДЕ
			|		СделкаРЕПОЦенныеБумаги.Ссылка = &Ссылка) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Вид,
			|	ВложенныйЗапрос.НаименованиеЭмитента
			|ИТОГИ ПО
			|	Вид";
		
		Запрос.УстановитьПараметр("Ссылка", СтрокаДанных.Основание);
		Запрос.УстановитьПараметр("Период", СтрокаДанных.Основание.Дата);
		
		ДополнительноеОписаниеЗадолженности = "";
		
		ВыборкаВидов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВидов.Следующий() Цикл
			ДополнительноеОписаниеЗадолженности = ДополнительноеОписаниеЗадолженности + ВыборкаВидов.Вид;
			
			МассивОписаний = Новый Массив;
			
			Выборка = ВыборкаВидов.Выбрать();
			Пока Выборка.Следующий() Цикл
				МассивОписаний.Добавить(Выборка.НаименованиеЭмитента);
			КонецЦикла;
			
			ДополнительноеОписаниеЗадолженности = ДополнительноеОписаниеЗадолженности + " " + СтрСоединить(МассивОписаний, " ");
		КонецЦикла;	
#КонецОбласти	

#Область ОписаниеЦенныхБумагСделкиРПИ
	ИначеЕсли ЭлементШаблона = "##ОписаниеЦенныхБумагСделкиРПИ" Тогда
		
		Если НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.Сделка")
			И НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый тип в основании: " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса_ЦенныеБумаги();
		
		Запрос.Текст = Запрос.Текст + ";" +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ЦенныеБумаги.Вид КАК Вид,
			|	_ЦенныеБумаги.РегНомер КАК РегНомер,
			|	ВЫБОР
			|		КОГДА _ЦенныеБумаги.ЭмитентРезидентРФ
			|			ТОГДА _ЦенныеБумаги.КраткоеНаименованиеПоУставуРусский
			|		ИНАЧЕ _ЦенныеБумаги.КраткоеНаименованиеПоУставуАнглийский
			|	КОНЕЦ КАК НаименованиеЭмитента
			|ИЗ
			|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
			|		ПО СделкаЦенныеБумаги.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага
			|ГДЕ
			|	СделкаЦенныеБумаги.Ссылка = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ЦенныеБумаги.Вид,
			|	_ЦенныеБумаги.РегНомер,
			|	ВЫБОР
			|		КОГДА _ЦенныеБумаги.ЭмитентРезидентРФ
			|			ТОГДА _ЦенныеБумаги.КраткоеНаименованиеПоУставуРусский
			|		ИНАЧЕ _ЦенныеБумаги.КраткоеНаименованиеПоУставуАнглийский
			|	КОНЕЦ
			|ИЗ
			|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
			|		ПО СделкаРЕПОЦенныеБумаги.ЦеннаяБумага = _ЦенныеБумаги.ЦеннаяБумага
			|ГДЕ
			|	СделкаРЕПОЦенныеБумаги.Ссылка = &Ссылка
			|ИТОГИ ПО
			|	Вид";
		
		Запрос.УстановитьПараметр("Ссылка", СтрокаДанных.Основание);
		Запрос.УстановитьПараметр("Период", СтрокаДанных.Основание.Дата);
		
		ДополнительноеОписаниеЗадолженности = "";
		
		ВыборкаВидов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВидов.Следующий() Цикл
			ДополнительноеОписаниеЗадолженности = ДополнительноеОписаниеЗадолженности + ВыборкаВидов.Вид;
			
			МассивОписаний = Новый Массив;
			
			Выборка = ВыборкаВидов.Выбрать();
			Пока Выборка.Следующий() Цикл
				МассивОписаний.Добавить(Выборка.НаименованиеЭмитента + ", " + Выборка.РегНомер);
			КонецЦикла;
			
			ДополнительноеОписаниеЗадолженности = ДополнительноеОписаниеЗадолженности + " " + СтрСоединить(МассивОписаний, " ");
		КонецЦикла;	
#КонецОбласти		

#Область ОписаниеСделкиРЕПО
	ИначеЕсли ЭлементШаблона = "##ОписаниеСделкиРЕПО" Тогда

		Если НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.СделкаРЕПО") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый тип в основании: " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
		Если СтрокаДанных.Основание.СделкаСЦентральнымКонтрагентом Тогда
		    ДополнительноеОписаниеЗадолженности = "№" + СтрокаДанных.Основание.НомерСделкиСЦентральнымКонтрагентом + " от " + Формат(СтрокаДанных.Основание.Дата, "ДФ=dd.MM.yyyy");
			
		ИначеЕсли СтрокаДанных.Основание.МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			ДополнительноеОписаниеЗадолженности = "№" + СтрокаДанных.Основание.НомерПорученияУБрокера + " от " + Формат(СтрокаДанных.Основание.ДатаПорученияУБрокера, "ДФ=dd.MM.yyyy");
			
		Иначе
			ДополнительноеОписаниеЗадолженности = "№" + СтрокаДанных.Основание.НомерСделки + " от " + Формат(СтрокаДанных.Основание.Дата, "ДФ=dd.MM.yyyy");
			
  		КонецЕсли;
		
#КонецОбласти

#Область ОписаниеЗадолженностиПоВознаграждениюРПИ
	ИначеЕсли ЭлементШаблона = "##ОписаниеЗадолженностиПоВознаграждениюДоговорРПИ" Тогда

		Если НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("СправочникСсылка.Договоры") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый тип в основании: " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
		Если СтрокаДанных.Основание.ВидДоговора = Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания Тогда
			Возврат "Вознаграждение специализированного депозитария";
		ИначеЕсли СтрокаДанных.Основание.ВидДоговора = Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания Тогда
			Возврат "Вознаграждение специализированного регистратора";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый вид договора: " + СтрокаДанных.Основание.ВидДоговора,,,, Отказ);
			Возврат "";
		КонецЕсли;

	ИначеЕсли ЭлементШаблона = "##ОписаниеЗадолженностиПоВознаграждениюРПИ" Тогда
		
		Если НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.НачислениеЗадолженности") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый тип в основании: " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НачислениеЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
			|	НачислениеЗадолженности.НачалоПериодаНачисления КАК НачалоПериодаНачисления,
			|	НачислениеЗадолженности.ОкончаниеПериодаНачисления КАК ОкончаниеПериодаНачисления
			|ИЗ
			|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
			|ГДЕ
			|	НачислениеЗадолженности.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", СтрокаДанных.Основание);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			
			Если ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария Тогда
				ДополнительноеОписаниеЗадолженности = "Вознаграждение специализированного депозитария";
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора Тогда
				ДополнительноеОписаниеЗадолженности = "Вознаграждение специализированного регистратора";
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый вид задолженности: " + ТипЗнч(ВыборкаДетальныеЗаписи.ВидЗадолженности),,,, Отказ);
				Возврат "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НачалоПериодаНачисления) И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОкончаниеПериодаНачисления) Тогда
				ДополнительноеОписаниеЗадолженности = ДополнительноеОписаниеЗадолженности 
					+ " за " + НРег(ПредставлениеПериода(ВыборкаДетальныеЗаписи.НачалоПериодаНачисления, КонецДня(ВыборкаДетальныеЗаписи.ОкончаниеПериодаНачисления), ""));
					
				ДополнительноеОписаниеЗадолженности = СтрЗаменить(ДополнительноеОписаниеЗадолженности, " 00:00:00", "");
			КонецЕсли;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , не получены реквизиты начисления задолженности " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
	ИначеЕсли ЭлементШаблона = "##ПоПроцентамПоМНО" Тогда
		
		Если НЕ ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.МНО") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки + " , недопустимый тип в основании: " + ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
			Возврат "";
		КонецЕсли;
		
		РеквизитыМНО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДанных.Основание, 
			"Организация, Основание, СчетДоверительногоУправления, РасчетныйСчет, Дата, Номер");
		РеквизитыДоговораМНО  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыМНО.РасчетныйСчет, 
			Новый Структура("Дата, Номер", "ДоговорМНО.ДатаЗаключения", "ДоговорМНО.НомерДоговора"));
			
		ЗарегистрированныеНомера = РегистрыСведений.НомераОбъектов.ПолучитьЗарегистрированныеНомера(
			РеквизитыМНО.Организация,
			Справочники.ВидыНумерацииОбъектов.РаспоряженияНаМНО,
			РаботаСКоллекциями.ЗначениеВМассив(РеквизитыМНО.Основание),
			РеквизитыМНО.СчетДоверительногоУправления,
			Год(РеквизитыМНО.Дата));

		Если ЗарегистрированныеНомера = Неопределено Тогда

			НомерПодтверждения = Неопределено;
			
		Иначе
			
			НомерПодтверждения = РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(ЗарегистрированныеНомера[РеквизитыМНО.Основание]);
			
		КонецЕсли;
			
		Если ЗначениеЗаполнено(НомерПодтверждения) Тогда
			
			Шаблон = "Ген. соглашение о порядке поддержания минимального неснижаемого остатка на счетах клиента № %1 от %2, подтверждение № %3 от %4";
			Возврат СтрШаблон(Шаблон, 
				РеквизитыДоговораМНО.Номер, 
				Формат(РеквизитыДоговораМНО.Дата, "ДФ=dd.MM.yyyy"), 
				РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(НомерПодтверждения), 
				Формат(РеквизитыМНО.Дата, "ДФ=dd.MM.yyyy"));
				
		Иначе

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " 
				+ ЭлементШаблона + ДополнениеОписанияОшибки + " , не удалось получить номер подтверждения для основания: " 
				+ ТипЗнч(СтрокаДанных.Основание),,,, Отказ);
				
			Возврат "";
			
		КонецЕсли; 
		
#КонецОбласти		

#Область РеквизитОтчета
	ИначеЕсли ЭтотОбъект.Метаданные().Реквизиты.Найти(Сред(ЭлементШаблона, 3)) <> Неопределено Тогда
		Возврат ЭтотОбъект[Сред(ЭлементШаблона, 3)];
#КонецОбласти

	ИначеЕсли Сред(ЭлементШаблона, 3) = "ДатаНачала" ИЛИ Сред(ЭлементШаблона, 3) = "ДатаОкончания" Тогда
		Возврат ЭтотОбъект.Период[Сред(ЭлементШаблона, 3)];

	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить функцию по шаблону: " + ЭлементШаблона + ДополнениеОписанияОшибки,,,, Отказ);
	КонецЕсли;
														
	Возврат ДополнительноеОписаниеЗадолженности;													
	
КонецФункции

Функция ПолучитьАдрес(Объект, ВидКонтактнойИнформации, ТолькоАнкетныеДанные, ДатаПереходаНаГАР, Отказ)
	
	Если ТипЗнч(Объект) = Тип("Строка") Тогда
		Возврат Объект;
	КонецЕсли;
	
	ИспользоватьСокращения = Ложь;
	
	АдресОбъекта = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект",					Объект);
	Запрос.УстановитьПараметр("ДатаОкончания",			ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Вид",					ВидКонтактнойИнформации);
	Запрос.УстановитьПараметр("ТолькоАнкетныеДанные",	ТолькоАнкетныеДанные);
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.СудебныеПроцессы") Тогда
		ШаблонСообщения = "Не указан адрес вынесения решения суда по судебному процессу %1 в формате ФИАС %2";
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СудебныеРешенияСрезПоследних.МестоВынесенияРешенияФИАС КАК МестоВынесенияРешенияФИАС
			|ИЗ
			|	РегистрСведений.СудебныеРешения.СрезПоследних(
			|			&ДатаОкончания,
			|			Организация = &Организация
			|				И СудебныйПроцесс = &Объект) КАК СудебныеРешенияСрезПоследних";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
				ЗаполнитьАдресОбъектаИзФИАС(АдресОбъекта, Объект, Выборка.МестоВынесенияРешенияФИАС, Новый Структура("Страна, Индекс, Регион, Округ, Район, Город, ВнутригРайон, НаселенныйПункт, Улица"), Истина, Отказ);
			Иначе
				ЗаполнитьАдресОбъектаИзФИАС(АдресОбъекта, Объект, Выборка.МестоВынесенияРешенияФИАС, Новый Структура("Регион, Город"), Ложь, Отказ);
				ИспользоватьСокращения = Истина;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		
		Если ТолькоАнкетныеДанные Тогда
			ШаблонСообщения = "Для юр. лица: %1 не указан %2 в анкетных данных";
		Иначе
			ШаблонСообщения = "Для юр. лица: %1 не указан %2 в данных группы компаний";
		КонецЕсли;
		
		Если НЕ ТолькоАнкетныеДанные И ЭтотОбъект.Период.ДатаОкончания <= ДатаПереходаНаГАР Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтактнаяИнформацияСрезПоследних.Представление КАК Представление
			|ИЗ
			|	РегистрСведений.КонтактнаяИнформация.СрезПоследних(
			|			&ДатаОкончания,
			|			Объект = &Объект
			|				И Вид = &Вид
			|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК КонтактнаяИнформацияСрезПоследних";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				АдресОбъекта.Добавить(Выборка.Представление);
			КонецЕсли;
			
		Иначе
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.СтранаРегистрации, РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации) КАК СтранаРегистрации,
			|	ВЫБОР
			|		КОГДА &ТолькоАнкетныеДанные = ЛОЖЬ
			|			ТОГДА КонтактнаяИнформацияСрезПоследних.Представление
			|		КОГДА &Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдрес)
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ФактическийАдрес
			|		КОГДА &Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес
			|		КОГДА &Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ПочтовыйАдрес)
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПочтовыйАдрес
			|	КОНЕЦ КАК Адрес,
			|	ВЫБОР
			|		КОГДА &Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактическийАдрес)
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ФактическийАдресФИАС
			|		КОГДА &Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдресФИАС
			|		КОГДА &Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ПочтовыйАдрес)
			|			ТОГДА РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПочтовыйАдресФИАС
			|	КОНЕЦ КАК АдресФИАС
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|			&ДатаОкончания,
			|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|				И ЮрФизЛицо = &Объект
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
			|				&ДатаОкончания,
			|				Объект = &Объект
			|					И Вид = &Вид
			|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК КонтактнаяИнформацияСрезПоследних
			|		ПО (ИСТИНА)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|				&ДатаОкончания,
			|				Организация = &Организация
			|					И ЮрФизЛицо = &Объект
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
			|		ПО (ИСТИНА)";
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Если ЭтотОбъект.Период.ДатаОкончания > ДатаПереходаНаГАР
					И (Выборка.СтранаРегистрации = Справочники.СтраныМира.Россия
					ИЛИ НЕ ЗначениеЗаполнено(Выборка.СтранаРегистрации)) Тогда
					
					Если ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
						СтруктураАдреса = Новый Структура("Страна, Индекс, Регион, Округ, Район, Город, ВнутригРайон, НаселенныйПункт, Улица");
					Иначе
						СтруктураАдреса = Новый Структура("Страна, Регион, Округ, Район, Город, ВнутригРайон, НаселенныйПункт, Улица");
					КонецЕсли;
					
					ЗаполнитьАдресОбъектаИзФИАС(АдресОбъекта, Объект, Выборка.АдресФИАС, СтруктураАдреса, Истина, Отказ);
					
					ШаблонСообщения = "Для юр. лица: %1 не указан %2 в анкетных данных в формате ФИАС";
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.Адрес) Тогда
					АдресОбъекта.Добавить(Выборка.Адрес);
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		ШаблонСообщения = "Для объекта %1 не предусмотрено получение %2";
	КонецЕсли;
	
	Если НЕ АдресОбъекта.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Объект, ВидКонтактнойИнформации),,,, Отказ);
	КонецЕсли;
	
	АдресСтрокой = СтрСоединить(АдресОбъекта, ", ");
	
	Если ИспользоватьСокращения Тогда //занести все сокращения в макет
		АдресСтрокой = СтрЗаменить(АдресСтрокой, "Город", "г.");
	КонецЕсли;
	
	Возврат АдресСтрокой;
	
КонецФункции

Функция ЗаполнитьАдресОбъектаИзФИАС(АдресОбъекта, Объект, АдресФИАС, СтруктураАдреса, ВыводитьДополнительныеАдресныеЭлементы, Отказ)
	
	СтруктураАдресаФИАС = РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(АдресФИАС);
	
	ЗаполнитьЗначенияСвойств(СтруктураАдреса, СтруктураАдресаФИАС);
	
	Для Каждого ЭлементАдреса Из СтруктураАдреса Цикл
		Если ЗначениеЗаполнено(ЭлементАдреса.Значение) Тогда
			Если ЭлементАдреса.Ключ = "Город" Тогда
				АдресОбъекта.Добавить("Город " + ЭлементАдреса.Значение);
			Иначе
				АдресОбъекта.Добавить(ЭлементАдреса.Значение);
			КонецЕсли;
			
		ИначеЕсли ЭлементАдреса.Ключ = "Индекс" Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Для объекта: %1 не указан Индекс в адресе в формате ФИАС", Объект), Объект,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Если ВыводитьДополнительныеАдресныеЭлементы Тогда
		ТипыАдресныхЭлементов = РаботаСКонтактнойИнформациейКлиентСервер.ПолучитьТипыАдресныхЭлементов();
		Для Каждого ДополнительныйАдресныйЭлемент Из СтруктураАдресаФИАС.ДополнительныеАдресныеЭлементы Цикл
			АдресОбъекта.Добавить(НРег(ТипыАдресныхЭлементов.Получить(ДополнительныйАдресныйЭлемент.Тип)) + " " + ДополнительныйАдресныйЭлемент.Значение);
		КонецЦикла;
	КонецЕсли;
		
	Если СтруктураАдреса.Свойство("Страна") И  АдресОбъекта.Количество() Тогда
		АдресОбъекта.Вставить(0, Справочники.СтраныМира.Россия.НаименованиеПолное);
	КонецЕсли;
	
КонецФункции

