		|
		|ВЫБРАТЬ
		|	"""",
		|	""999_0000000000_0000000000000_цбпереданыпопрямомурепо"",
		|	""999"",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	"""",
		|	""000"",
		|	""Идентификатор предназначен для отражения ценных бумаг, переданных по сделкам прямого репо""
		|ИЗ
