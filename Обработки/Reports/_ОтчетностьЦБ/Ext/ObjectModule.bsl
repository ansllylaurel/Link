		//			СтрокаДанных.Kateg_mneniya_o_dostovern_BFOEnumerator[0].Value = "Nemodif_auditorskoe_zaklyucheniePURCBMember";
		//		ИначеЕсли СтрокаДанных.Kateg_mneniya_o_dostovern_BFOEnumerator[0].Value = "Mnenie_S_OgovorkojMember" Тогда
