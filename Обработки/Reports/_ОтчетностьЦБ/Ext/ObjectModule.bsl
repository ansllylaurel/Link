//Сведения о жалобах клиентов
#Область ОКУД0420453_XBRL

Функция ОКУД0420453_XBRL_ПолучитьДанные(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420453";
	ПакетДанных = Новый Структура;
	ПризнакНулевогоОтчета = Истина;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала", 	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ЮрЛицо_ЦБРФ", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрЛицо_ЦБРФ"));

	Запрос.Текст = ОКУД0420453_ПолучитьТекстЗапроса();
	Запрос.Выполнить();
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

Функция ОКУД0420453_ПолучитьТекстЗапроса()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.ВариантОбращения КАК ТипЖалобы,
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Дата КАК Дата,
		|	ВходящийДокумент.ДатаРассмотрения КАК ДатаРассмотрения,
		|	ВходящийДокумент.ДатаВыплаты КАК ДатаВыплаты,
		|	ВходящийДокумент.СуммаВыплаты КАК СуммаВыплаты,
		|	ВЫБОР
		|		КОГДА ВходящийДокумент.Отправитель = &ЮрЛицо_ЦБРФ
		|			ТОГДА ""BankRossiiMember""
		|		КОГДА РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.СаморегулируемаяОрганизация)
		|			ТОГДА ""SROMember""
		|		КОГДА ВходящийДокумент.Отправитель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА ""KlientYULMember""
		|		КОГДА ВходящийДокумент.Отправитель.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрфизЛиц.ФизическоеЛицо)
		|			ТОГДА ""KlientFLMember""
		|	КОНЕЦ КАК ВидЮрФизЛица,
		|	ВходящийДокумент.ВариантОбращения КАК КодЖалобы
		|ПОМЕСТИТЬ _ВсеЖалобы
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВходящийДокумент.Отправитель = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	ВходящийДокумент.Проведен
		|	И ВходящийДокумент.Организация = &Организация
		|	И (ВходящийДокумент.ТипВходящегоДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.Жалоба)
		|			ИЛИ ВходящийДокумент.ТипВходящегоДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ЖалобаИногоЛица))
		|	И ВходящийДокумент.ПоЛицензииДУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Отправитель КАК Отправитель
		|ПОМЕСТИТЬ _НепроведенныеВходящиеДокументы
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	НЕ ВходящийДокумент.ПометкаУдаления
		|	И НЕ ВходящийДокумент.Проведен
		|	И ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Отправитель КАК Отправитель
		|ПОМЕСТИТЬ _НеЗаполненТипВходящегоДокументаВходящиеДокументы
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	НЕ ВходящийДокумент.ПометкаУдаления
		|	И ВходящийДокумент.ТипВходящегоДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ПустаяСсылка)
		|	И ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Отправитель КАК Отправитель
		|ПОМЕСТИТЬ _НеЗаполненВидЛицензииВходящиеДокументы
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	НЕ ВходящийДокумент.ПометкаУдаления
		|	И НЕ ВходящийДокумент.ПоЛицензииДУ
		|	И НЕ ВходящийДокумент.ПоЛицензииУКПИФ
		|	И НЕ ВходящийДокумент.ПоСобственнойДеятельностиУК
		|	И ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _КонтрольКодаЖалобы
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.КодЖалобы ЕСТЬ NULL
		|	И (_ВсеЖалобы.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ИЛИ _ВсеЖалобы.ДатаРассмотрения МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ИЛИ _ВсеЖалобы.ДатаВыплаты МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _НеУказанаДатаВыплаты
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.СуммаВыплаты > 0
		|	И _ВсеЖалобы.ДатаВыплаты = ДАТАВРЕМЯ(1, 1, 1)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _НеУказанаСуммаВыплаты
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.СуммаВыплаты = 0
		|	И _ВсеЖалобы.ДатаВыплаты МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.Ссылка КАК Ссылка,
		|	_ВсеЖалобы.Дата КАК ДатаЖалобы,
		|	_ВсеЖалобы.ДатаРассмотрения КАК ДатаРассмотрения,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_ВсеЖалобы.Дата, ДЕНЬ) <= _ВсеЖалобы.ДатаРассмотрения
		|			ТОГДА РАЗНОСТЬДАТ(_ВсеЖалобы.Дата, _ВсеЖалобы.ДатаРассмотрения, ДЕНЬ)
		|	КОНЕЦ КАК СрокРассмотрения
		|ПОМЕСТИТЬ _НарушениеСрокаЖалобы
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	(_ВсеЖалобы.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -15) И &ДатаОкончания
		|			ИЛИ _ВсеЖалобы.ДатаРассмотрения МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|	И ВЫБОР
		|			КОГДА _ВсеЖалобы.ДатаРассмотрения = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА _ВсеЖалобы.Дата < ДОБАВИТЬКДАТЕ(&ДатаОкончания, ДЕНЬ, -15)
		|			ИНАЧЕ НАЧАЛОПЕРИОДА(_ВсеЖалобы.Дата, ДЕНЬ) > _ВсеЖалобы.ДатаРассмотрения
		|					ИЛИ РАЗНОСТЬДАТ(_ВсеЖалобы.Дата, _ВсеЖалобы.ДатаРассмотрения, ДЕНЬ) > 15
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.ТипЖалобы КАК ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеЖалобы.Ссылка) КАК Количество
		|ПОМЕСТИТЬ _ПоступившиеЖалобы
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеЖалобы.ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.ТипЖалобы КАК ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеЖалобы.Ссылка) КАК Количество
		|ПОМЕСТИТЬ _НаРассмотрении
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.Дата <= &ДатаОкончания
		|	И (_ВсеЖалобы.ДатаРассмотрения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ _ВсеЖалобы.ДатаРассмотрения > &ДатаОкончания)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеЖалобы.ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.ТипЖалобы КАК ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеЖалобы.Ссылка) КАК Количество
		|ПОМЕСТИТЬ _Рассмотренные
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.ДатаРассмотрения МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеЖалобы.ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.ТипЖалобы КАК ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ВсеЖалобы.Ссылка) КАК Количество,
		|	СУММА(_ВсеЖалобы.СуммаВыплаты) КАК СуммаВыплаты
		|ПОМЕСТИТЬ _Выплачено
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|ГДЕ
		|	_ВсеЖалобы.ДатаВыплаты МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеЖалобы.ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеЖалобы.ТипЖалобы КАК ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Нарушение.Ссылка) КАК Количество
		|ПОМЕСТИТЬ _ВыявленыНарушения
		|ИЗ
		|	_ВсеЖалобы КАК _ВсеЖалобы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Нарушение КАК Нарушение
		|		ПО _ВсеЖалобы.Ссылка = Нарушение.Основание
		|ГДЕ
		|	Нарушение.ПоЛицензииДУ
		|	И Нарушение.ДатаВыявления МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеЖалобы.ТипЖалобы,
		|	_ВсеЖалобы.ВидЮрФизЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АВТОНОМЕРЗАПИСИ() КАК ID_strokiTaxis,
		|	ТипыЖалоб.ТипЖалобы КАК ТипЖалобы,
		|	ТипыЖалоб.КодЖалобы КАК КодЖалобы,
		|	ТипыЖалоб.ВидЮрФизЛица КАК ВидЮрФизЛица,
		|	ЕСТЬNULL(_ВыявленыНарушения.Количество, 0) КАК КоличествоВыявленыхНарушений,
		|	ЕСТЬNULL(_Выплачено.Количество, 0) КАК КоличествоВыплат,
		|	ЕСТЬNULL(_Выплачено.СуммаВыплаты, 0) КАК СуммаВыплат,
		|	ЕСТЬNULL(_НаРассмотрении.Количество, 0) КАК КоличествоНеРассмотренных,
		|	ЕСТЬNULL(_ПоступившиеЖалобы.Количество, 0) КАК КоличествоПоступивших,
		|	ЕСТЬNULL(_Рассмотренные.Количество, 0) КАК КоличествоРассмотренных
		|ПОМЕСТИТЬ _Данные
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ВсеЖалобы.ТипЖалобы КАК ТипЖалобы,
		|		_ВсеЖалобы.КодЖалобы КАК КодЖалобы,
		|		_ВсеЖалобы.ВидЮрФизЛица КАК ВидЮрФизЛица
		|	ИЗ
		|		_ВсеЖалобы КАК _ВсеЖалобы) КАК ТипыЖалоб
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВыявленыНарушения КАК _ВыявленыНарушения
		|		ПО ТипыЖалоб.ТипЖалобы = _ВыявленыНарушения.ТипЖалобы
		|			И ТипыЖалоб.ВидЮрФизЛица = _ВыявленыНарушения.ВидЮрФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Выплачено КАК _Выплачено
		|		ПО ТипыЖалоб.ТипЖалобы = _Выплачено.ТипЖалобы
		|			И ТипыЖалоб.ВидЮрФизЛица = _Выплачено.ВидЮрФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НаРассмотрении КАК _НаРассмотрении
		|		ПО ТипыЖалоб.ТипЖалобы = _НаРассмотрении.ТипЖалобы
		|			И ТипыЖалоб.ВидЮрФизЛица = _НаРассмотрении.ВидЮрФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоступившиеЖалобы КАК _ПоступившиеЖалобы
		|		ПО ТипыЖалоб.ТипЖалобы = _ПоступившиеЖалобы.ТипЖалобы
		|			И ТипыЖалоб.ВидЮрФизЛица = _ПоступившиеЖалобы.ВидЮрФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Рассмотренные КАК _Рассмотренные
		|		ПО ТипыЖалоб.ТипЖалобы = _Рассмотренные.ТипЖалобы
		|			И ТипыЖалоб.ВидЮрФизЛица = _Рассмотренные.ВидЮрФизЛица
		|ГДЕ
		|	(ЕСТЬNULL(_ВыявленыНарушения.Количество, 0) > 0
		|			ИЛИ ЕСТЬNULL(_Выплачено.Количество, 0) > 0
		|			ИЛИ ЕСТЬNULL(_Выплачено.СуммаВыплаты, 0) > 0
		|			ИЛИ ЕСТЬNULL(_НаРассмотрении.Количество, 0) > 0
		|			ИЛИ ЕСТЬNULL(_ПоступившиеЖалобы.Количество, 0) > 0
		|			ИЛИ ЕСТЬNULL(_Рассмотренные.Количество, 0) > 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Данные.ID_strokiTaxis КАК ID_ZHalobyTaxis,
		|	_Данные.ВидЮрФизЛица КАК IstochnikPostupleniyaObrashheniyaAxis,
		|	_Данные.КодЖалобы КАК Kod_zhalobyAxis,
		|	_Данные.КоличествоВыявленыхНарушений КАК Kol_vyyavl_narushenij,
