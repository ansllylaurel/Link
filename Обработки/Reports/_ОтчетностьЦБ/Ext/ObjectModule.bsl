Процедура ЗаполнитьПечатнуюФорму_ОКУД0420505(Запрос, Результат, ИмяМакета, Отказ) Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_КодыСтрок") = Неопределено Тогда
		ПолучитьДанные_XBRL_ОКУД0420505_ВыполнитьПредварительныеЗапросы(Запрос, Отказ)
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Очистить();
	
	Макет = ПолучитьМакет(ИмяМакета);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры,  ПолучитьДисклеймер(Запрос, Отказ));
	Результат.Вывести(ОбластьШапка);
	
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел1", Отказ);
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел2", Отказ);
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3Подраздел1", Отказ);
	
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3Подраздел2Шапка", Отказ);
	
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3Подраздел2", Отказ);
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3", Отказ);
	
	МассивОбластейДляВывода = Новый Массив;
	
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "РазделРеквизитыСпецДепозитария", Отказ, МассивОбластейДляВывода);
	ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Подписанты", Отказ, МассивОбластейДляВывода);

	ВывестиМассивОбластей(Результат, МассивОбластейДляВывода);

	Если ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_НеРаспределенные", Отказ).Количество() > 0 Тогда
		ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "НеРаспределенные", Отказ);
	КонецЕсли;
	
	Результат.АвтоМасштаб = Истина;
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
КонецПроцедуры

Процедура ПолучитьДанные_ОКУД0420505_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, ИмяСекции, Отказ, МассивОбластейДляВывода = Неопределено)

	Если МассивОбластейДляВывода = Неопределено Тогда
		МассивОбластейДляВывода = Новый Массив;
		ВывестиМассивОбластей = Истина;
	Иначе
		ВывестиМассивОбластей = Ложь;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Шапка") <> Неопределено Тогда
		МассивОбластейДляВывода.Добавить(Макет.ПолучитьОбласть(Имясекции + "Шапка"));
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "КодыСтрок") <> Неопределено Тогда
		ОбластьКодыСтрок = Макет.ПолучитьОбласть(Имясекции + "КодыСтрок");
		
		Данные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("КодыСтрок_Финал").ПолучитьДанные().Выгрузить();
		
		ОбластьШапка = Макет.ПолучитьОбласть(Имясекции + "Шапка");
		Для НомерКолонки = 1 По ОбластьШапка.ШиринаТаблицы Цикл
			Заголовок = ОбластьШапка.Область(ОбластьШапка.ВысотаТаблицы - 1, НомерКолонки, ОбластьШапка.ВысотаТаблицы - 1, НомерКолонки).Текст;
			Заголовок = СтрЗаменить(Заголовок, Символы.ПС, " ");
			Если Заголовок = "Код строки" Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для НомерСтроки = 1 По ОбластьКодыСтрок.ВысотаТаблицы Цикл
			
			ОбластьСтрока	= ОбластьКодыСтрок.ПолучитьОбласть(НомерСтроки, 1, НомерСтроки, ОбластьКодыСтрок.ШиринаТаблицы);
			КодСтроки		= ОбластьКодыСтрок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст;
			
			ПараметрыОтбора = Новый Структура;
			Если СтрДлина(КодСтроки) = 2 Тогда
				ПараметрыОтбора.Вставить("КодСтроки1", КодСтроки);
			ИначеЕсли СтрДлина(КодСтроки) = 4 Тогда
				ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
				ПараметрыОтбора.Вставить("КодСтроки2", "0" + Прав(КодСтроки, 1));
			ИначеЕсли СтрДлина(КодСтроки) = 5 Тогда
				ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
				ПараметрыОтбора.Вставить("КодСтроки2", Прав(КодСтроки, 2));
			КонецЕсли;

			ПараметрыОбласти = Новый Структура("СуммаНаТекущуюДату,СуммаНаПредыдущуюДату", 0, 0);
			
			НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
				ПараметрыОбласти.СуммаНаТекущуюДату		= ПараметрыОбласти.СуммаНаТекущуюДату  		+ СтрокаДанных.СуммаНаТекущуюДату;
				ПараметрыОбласти.СуммаНаПредыдущуюДату	= ПараметрыОбласти.СуммаНаПредыдущуюДату	+ СтрокаДанных.СуммаНаПредыдущуюДату;
			КонецЦикла;
			
			ПараметрыОбласти.СуммаНаТекущуюДату		= Формат(ПараметрыОбласти.СуммаНаТекущуюДату	, "ЧДЦ=2; ЧГ=3,0");
			ПараметрыОбласти.СуммаНаПредыдущуюДату	= Формат(ПараметрыОбласти.СуммаНаПредыдущуюДату	, "ЧДЦ=2; ЧГ=3,0");
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ПараметрыОбласти); 
			МассивОбластейДляВывода.Добавить(ОбластьСтрока);
			
		КонецЦикла;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Строка") <> Неопределено Тогда
		
		Данные = СформироватьМассивСтрокДляПечатнойФормы(Запрос, "ПечатнаяФорма_" + ИмяСекции, "", Отказ);
		
		Для Каждого СтрокаДанных Из Данные Цикл
			ОбластьСтрока = Макет.ПолучитьОбласть(Имясекции + "Строка");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			МассивОбластейДляВывода.Добавить(ОбластьСтрока);	
		КонецЦикла;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Итог") <> Неопределено Тогда
		
		ОбластьИтог = Макет.ПолучитьОбласть(Имясекции + "Итог");
		
		Данные = СформироватьМассивСтрокДляПечатнойФормы(Запрос, "ПечатнаяФорма_" + ИмяСекции + "Итог", "", Отказ);
		
		Для Каждого СтрокаДанных Из Данные Цикл
			ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, СтрокаДанных);
		КонецЦикла;
		
		МассивОбластейДляВывода.Добавить(ОбластьИтог);	
	
	КонецЕсли;
	
	Если ВывестиМассивОбластей Тогда
		ВывестиМассивОбластей(Результат, МассивОбластейДляВывода);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

// Отчет об инвестировании средств пенсионных накоплений
#Область ОКУД0420506

Функция ПолучитьДанные_ОКУД0420506(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
		
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420506_2_16_3_1");
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420506_2_16_3_1_ОКУД0420506_2_16_3_1");
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить("2_16_3_1", "_", "."));
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	ПакетДанных.Отчет.Вставить("ОтчетнаяДата", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=dd.MM.yyyy"));
	ДанныеПериодаОтчетности = ПолучитьДанныеПериодаОтчетности();
	
	ПакетОтчетныйПериод = Новый Структура("Код, Описание, Активно", ДанныеПериодаОтчетности.Код, ДанныеПериодаОтчетности.Описание, Истина);
	
	ПакетДанных.Отчет.Вставить("ОтчетныйПериод", ПакетОтчетныйПериод);
	ПакетДанных.Отчет.Вставить("Год", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy"));
	
	ДатыСЧА = ПолучитьДатыСЧА_Для_506_507();
	Если ДатыСЧА = Неопределено Тогда	
		Отказ = Истина;
		ПакетДанных.Вставить("Отказ", Отказ);
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПакетОтчетность = Новый Структура;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала",					ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",				КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо",					ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ВидПоказателя",				Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("Руководитель",				"");
	Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа", "");
	
	Запрос.УстановитьПараметр("ДатаСЧА_НачалоПериода"	, ДатыСЧА.ДатаСЧА_НачалоПериода);
	Запрос.УстановитьПараметр("ДатаСЧА_КонецПериода"	, ДатыСЧА.ДатаСЧА_КонецПериода);
	
	Запрос.УстановитьПараметр("НеЗаполнятьРазделСД", ЭтотОбъект.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Атомфонд") И ЭтотОбъект.Период.ДатаОкончания = Дата(2022,03,31,23,59,59));
	
	//Запрос.УстановитьПараметр("ПустоеЗначение"	, ЭтотОбъект.ПустоеЗначение);
	                                             
	ПакетОтчетность.Вставить("Таблица_Раздел1ОтчетОбИнвестирСредств", Новый Структура);
	
	ПакетТаблица = Новый Структура;
	ПакетТаблица.Вставить("Строка_Раздел1НомерГрафы", ПолучитьДинамическуюСтруктуру("Разд1Гр%Индекс%Стр1Заголовок", 1, 11));      //Разд1Гр1Стр1Заголовок
	ПакетТаблица.Вставить("Таб_Раздел1Строки_1", ПолучитьДанные_ОКУД0420506_МассивСтрок(Запрос));
		
	ПакетОтчетность.Вставить("Таблица_Раздел1ОтчетОбИнвестирСредств", ПакетТаблица); 
	
	ПакетДанных.Отчет.Вставить("Раздел1_ОтчетОбИнвестирПенсНак", ПакетОтчетность);
	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо",	 ПолучитьСопроводительноеПисьмо("ОКУД0420506"));
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяУКНПФ",	 Новый Структура("ФИО", ПолучитьИнициалыФамилиюОтветственногоЛица("Руководитель")));
	ПакетДанных.Отчет.Вставить("ПодписьУполномоченногоЛица", Новый Структура("ФИО2", ПолучитьИнициалыФамилиюОтветственногоЛица("УполномоченноеЛицоСпецДепа")));
	
	Возврат ПакетДанных;
	
КонецФункции
	
Функция ПолучитьДанные_ОКУД0420506_МассивСтрок(Запрос)	
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420506();
	
	Пакет	= Запрос.ВыполнитьПакет();
	Данные	= Пакет[1].Выгрузить();
							
	ФорматныеСтроки = Новый Структура;
	ФорматныеСтроки.Вставить("Кол8_СтоимЧистАктивов",					"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол9_ПоступлениеАктивов", 				"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол10_ИзъятиеАктивов", 					"ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол11_СтоимЧистАктивовНаКонецОтчПериода", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	
	Данные.Сортировать("Кол7_ДатЗаключДоговора");
		
	Возврат СформироватьМассивСтрок(Данные, ФорматныеСтроки);
	
КонецФункции

Процедура ЗаполнитьПечатнуюФорму_ОКУД0420506(ПакетДанных, Результат, Отказ) Экспорт
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		
		ПакетОтчет = ПакетДанных.Отчет;
			
		Результат.Очистить();
		Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		Результат.Автомасштаб = Истина;
		
		Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
		
		ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
			
		ОбластьШапка.Параметры.ОтчетнаяДата		= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		
		Результат.Вывести(ОбластьШапка);
		
		ВывестиРаздел(, "", "Раздел1_ОтчетОбИнвестирПенсНак.Таблица_Раздел1ОтчетОбИнвестирСредств.Таб_Раздел1Строки_1", ПакетОтчет, Макет, Результат);

		ОбластьПодвал						   		 = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьПодвал.Параметры.ФИОРуководителя      = ПакетОтчет.ПодписьРуководителяУКНПФ.ФИО; 	
		ОбластьПодвал.Параметры.ФИОУполномоченногоСД = ПакетОтчет.ПодписьУполномоченногоЛица.ФИО2;
		
		Результат.Вывести(ОбластьПодвал);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса_ОКУД0420506()
	
	#Область ТекстЗапроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НЕОПРЕДЕЛЕНО КАК Кол1_НомерСтрокиНПФ,
		|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК Кол2_ПолнНаимУК,
		|	РеквизитыОрганизации.ИНН КАК Кол3_ИНН_НПФ,
		|	РеквизитыКлиента.ПолноеНаименованиеПоУставу КАК Кол4_ПолноеНаименНПФ,
		|	РеквизитыКлиента.ИНН КАК Кол5_ИНН_НПФ,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК Кол6_НомерДоговораУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК Кол7_ДатЗаключДоговора,
		|	СУММА(ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|					И (ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|							И НЕ ВводыВыводыАктивовВВалютеУчетаОбороты.ВидОперацииВводаВыводаДС В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВводы), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОшибочноЗачисленные), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваПроцентЗаПользованиеДенежнымиСредствами))
		|						ИЛИ ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива <> ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства))
		|				ТОГДА ВЫБОР
		|						КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|							ТОГДА -ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот
		|						ИНАЧЕ ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Кол9_ПоступлениеАктивов,
		|	СУММА(ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|					И (ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|							И НЕ ВводыВыводыАктивовВВалютеУчетаОбороты.ВидОперацииВводаВыводаДС В (ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПрочиеВыводы), ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратОшибочноЗачисленных))
		|						ИЛИ ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива <> ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства))
		|				ТОГДА ВЫБОР
		|						КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|							ТОГДА -ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот
		|						ИНАЧЕ ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Кол10_ИзъятиеАктивов,
		|	ЕСТЬNULL(ФинансовыеПоказатели_НачалоГода.Значение, 0) КАК Кол8_СтоимЧистАктивов,
		|	ЕСТЬNULL(ФинансовыеПоказатели_ОтчетнаяДата.Значение, 0) КАК Кол11_СтоимЧистАктивовНаКонецОтчПериода,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	РеквизитыКлиента.ОГРН КАК ОГРН_НПФ,
		|	СтатусыЛицензийСрезПоследних.Лицензия.Серия + СтатусыЛицензийСрезПоследних.Лицензия.Номер КАК НомерЛицензии_НПФ
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&ДатаОкончания,
