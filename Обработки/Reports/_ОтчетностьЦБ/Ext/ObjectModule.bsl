			Если ЗначениеЗаполнено(СтрокаПравил.НовоеПоле) И ЗначениеЗаполнено(СтрокаПравил.СтароеПоле) Тогда 
				//переименовываем поле для поддержания совеместимости со старой таксономией
				УдаляемаяКолонка = ВременнаяТаблица.Колонки.Найти(СтрокаПравил.НовоеПоле);
				ВременнаяТаблица.Колонки.Вставить(ВременнаяТаблица.Колонки.Индекс(УдаляемаяКолонка), СтрокаПравил.СтароеПоле, УдаляемаяКолонка.ТипЗначения);
				ВременнаяТаблица.ЗагрузитьКолонку(ВременнаяТаблица.ВыгрузитьКолонку(УдаляемаяКолонка), СтрокаПравил.СтароеПоле);
				ВременнаяТаблица.Колонки.Удалить(УдаляемаяКолонка);
			ИначеЕсли ЗначениеЗаполнено(СтрокаПравил.НовоеПоле) Тогда 
				//удаляем поле, его не было в прошлых версиях
				ВременнаяТаблица.Колонки.Удалить(СтрокаПравил.НовоеПоле);
			КонецЕсли;
		КонецЕсли;	
