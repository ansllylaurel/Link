	РазделыОтчета.Добавить("sr_0420869_9z_12DZ_prochA");// Прочая дебиторская задолженность (кроме сделок обратного РЕПО
	РазделыОтчета.Добавить("sr_0420869_9z_12DZ_proch_REPOA");// Прочая дебиторская задолженность ( сделки обратного РЕПО). Не заполняется	
