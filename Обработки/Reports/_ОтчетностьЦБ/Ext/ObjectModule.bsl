Функция ПолучитьДанные_ОКУД0420503(Запрос, Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXML Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420503_2_16_3_1");
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420503_2_16_3_1_ОКУД0420503_2_16_3_1");
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить("2_16_3_1", "_", "."));
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	ПакетОтчетныйМесяц = Новый Структура;
	ПакетОтчетныйМесяц.Вставить("Код"		, Формат(Месяц(ЭтотОбъект.Период.ДатаОкончания), "ЧЦ=3; ЧВН="));
	ПакетОтчетныйМесяц.Вставить("Описание"	, НРег(Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=MMMM")));
	ПакетОтчетныйМесяц.Вставить("Активно"	, Истина);
	
	ПакетДанных.Отчет.Вставить("ОтчетныйМесяц", ПакетОтчетныйМесяц);
	ПакетДанных.Отчет.Вставить("Год", Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyy"));
	
	ПакетОтчетность = Новый Структура;
	
	ПолучитьДанные_ОКУД0420503_ВыполнитьПредварительныеЗапросы(Запрос, Отказ);
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;	
	
	ПакетДанных.Отчет.Вставить("Раздел1Реквизиты"			, СформироватьМассивСтрок(ВыгрузитьВременнуюТаблицу(Запрос, "Раздел1Реквизиты"),,"")[0]);
	ПакетДанных.Отчет.Вставить("Раздел2ПараметрыОтчета"		, Новый Структура("Таблица_ПараметрыОтчета", Новый Структура("Row_253", СформироватьМассивСтрок(ВыгрузитьВременнуюТаблицу(Запрос, "Row_253"),,"")[0])));
	ПакетДанных.Отчет.Вставить("Раздел3СведенияОПриросте"	, ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте(Запрос));
	ПакетДанных.Отчет.Вставить("Раздел4ОтчетОФинВлож"		, ПолучитьДанные_ОКУД0420503_Раздел4ОтчетОФинВлож(Запрос));
	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо"		, ПолучитьСопроводительноеПисьмо("ОКУД0420503"));
	
	Возврат ПакетДанных;

КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел2ПараметрыОтчета()
	
	Таблица_ПараметрыОтчета = Новый Структура("Row_253", Новый Структура);
	
	Таблица_ПараметрыОтчета.Row_253.Вставить("Раздел2Стр1Гр1", НРег(Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=MMMM")));
	Таблица_ПараметрыОтчета.Row_253.Вставить("Раздел2Стр1Гр2", Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyy"));
	Таблица_ПараметрыОтчета.Row_253.Вставить("Раздел2Стр1Гр3", "RUB");
	
	Возврат Новый Структура("Таблица_ПараметрыОтчета", Таблица_ПараметрыОтчета);
	
КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте(Запрос)
	
	Данные				= ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_КодыСтрок");
	ДанныеРасшифровки	= ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_РасшифровкаБольшеПятиПроцентов");
	
	Если ДанныеРасшифровки.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отчёте о приросте по " + ЭтотОбъект.СчетДоверительногоУправления + " есть операции с суммой более 5% от СЧА!");
	КонецЕсли;
	
	МакетОКУД0420503_Параметры3Раздела = ПолучитьМакет("ОКУД0420503_Параметры3Раздела");
	
	Таблица_СведенияОПриросте = Новый Структура;
	
	Для НомерСтроки = 2 По МакетОКУД0420503_Параметры3Раздела.ВысотаТаблицы Цикл
		КодСтроки			= МакетОКУД0420503_Параметры3Раздела.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		ТегЗаголовка		= МакетОКУД0420503_Параметры3Раздела.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
		АтрибутыЗаголовка 	= МакетОКУД0420503_Параметры3Раздела.Область(НомерСтроки, 3, НомерСтроки, 3).Текст;
		
		Таблица_СведенияОПриросте.Вставить(ТегЗаголовка, ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте_ДанныеСтроки(Данные, КодСтроки, АтрибутыЗаголовка));
		
		
		ТегРасшифровки		= МакетОКУД0420503_Параметры3Раздела.Область(НомерСтроки, 4, НомерСтроки, 4).Текст;
		АтрибутыРасшифровки	= МакетОКУД0420503_Параметры3Раздела.Область(НомерСтроки, 5, НомерСтроки, 5).Текст;
		
		Если ЗначениеЗаполнено(ТегРасшифровки) Тогда
			Таблица_СведенияОПриросте.Вставить(ТегРасшифровки, ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте_ДанныеРасшифровкиБолееПятиПроцентов(ДанныеРасшифровки, КодСтроки, АтрибутыРасшифровки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("Таблица_СведенияОПриросте", Таблица_СведенияОПриросте);

КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте_ДанныеСтроки(Данные, КодСтроки, ПоляСтроки)

	МассивПолейСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляСтроки);
	Сумма = 0;
	
	Если ЗначениеЗаполнено(КодСтроки) Тогда
		МассивКодовСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодСтроки, ".");
		
		ПараметрыПоиска = Новый Структура;
		
		Для Индекс = 0 По МассивКодовСтроки.Количество() - 1 Цикл
			ПараметрыПоиска.Вставить("КодСтроки" + Индекс, МассивКодовСтроки[Индекс]);
		КонецЦикла;
		
		НайденныеСтроки = Данные.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			Сумма = Сумма + СтрокаДанных.Сумма;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить(МассивПолейСтроки[0], ЭтотОбъект.ПустоеЗначение); 
	ДанныеСтроки.Вставить(МассивПолейСтроки[1], КодСтроки); 
	ДанныеСтроки.Вставить(МассивПолейСтроки[2], Окр(Сумма, 2)); 
	
	Возврат ДанныеСтроки;

КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте_ДанныеРасшифровкиБолееПятиПроцентов(Данные, КодСтроки, ПоляСтроки)

	МассивСтрок = Новый Массив;
	МассивПолейСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляСтроки);
	
	МассивКодовСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодСтроки, ".");
	
	ПараметрыПоиска = Новый Структура;
	
	Для Индекс = 0 По МассивКодовСтроки.Количество() - 1 Цикл
		ПараметрыПоиска.Вставить("КодСтроки" + Индекс, МассивКодовСтроки[Индекс]);
	КонецЦикла;
	
	НайденныеСтроки = Данные.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить(МассивПолейСтроки[0], СтрокаДанных.ОписаниеРасшифровки); 
		ДанныеСтроки.Вставить(МассивПолейСтроки[1], Окр(СтрокаДанных.Сумма, 2)); 
		
		МассивСтрок.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	Возврат МассивСтрок;

КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте_ДанныеРасшифровкиБолееПятиПроцентов_ОписаниеРасшифровки(Операция, ДатаОперации, КодСтроки, Субконто1 = Неопределено, Субконто2 = Неопределено, ЭтоНулеваяСЧА = Ложь)

	Если ТипЗнч(Операция) = Тип("ДокументСсылка.ЗачислениеПаев")
		И (ЭтоНулеваяСЧА ИЛИ (ТипЗнч(Субконто1) = Тип("Строка") И Субконто1 = "ЭтоНулеваяСЧА"))
		И Операция.ПаевойИнвестиционныйФонд.Тип = Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Открытый Тогда
		
		ЗаявкаПайщика 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "Заявка");
		РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаПайщика, "НомерЗаявки, Дата");
		
		Возврат "Включение имущества(денежных средств) в состав Фонда при выдаче инвестиционных паев " + Формат(Операция.Дата, "ДФ=dd.MM.yy") + " по Заявке № " + СокрЛП(РеквизитыЗаявки.НомерЗаявки) + " от " + Формат(РеквизитыЗаявки.Дата, "ДФ=dd.MM.yy") + " г.";
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ЗачислениеПаев")  Тогда
		
		ЗаявкаПайщика 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "Заявка");
		РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаПайщика, "НомерЗаявки, Дата");
		
		Возврат СтрШаблон("%1 г. была осуществлена выдача инвестиционных паев по заявке № %2 от %3 г. Кол-во выданных паев %4",
					Формат(Операция.Дата, "ДФ=dd.MM.yy"),
					СокрЛП(РеквизитыЗаявки.НомерЗаявки),
					Формат(РеквизитыЗаявки.Дата, "ДФ=dd.MM.yy"),
					Операция.Количество);
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПогашениеПаев") И Субконто2 = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК Тогда
		Возврат СтрШаблон("Частичное погашение паев %1 г. Кол-во погашенных паев %2.", 
					Формат(ДатаОперации, "ДФ=dd.MM.yy"), 
					Операция.Количество);
		
	ИначеЕсли Субконто2 = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК Тогда
		Возврат Формат(ДатаОперации, "ДФ=dd.MM.yy") + " г. осуществлено частичное  погашение инвестиционных паев";
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПогашениеПаев") Тогда
		
		Если Субконто2 = Перечисления.ВариантыПогашенияПаев.ПриЗакрытииПИФ Тогда
			Возврат СтрШаблон("%1 г. было осуществлено погашение инвестиционных паев при прекращении фонда, кол-во погашенных паев %3, владелец инвестицонных паёв: %2", 
						Формат(ДатаОперации, "ДФ=dd.MM.yy"), 
						?(Операция.ВидПайщика = Перечисления.ВидыПайщиков.НоминальныйДержатель, ПолучитьНаименованиеЮрФизЛица(Операция.Владелец), ПолучитьНаименованиеЮрФизЛица(Операция.Пайщик)),
						Операция.Количество);
						
		Иначе
			ЗаявкаПайщика 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "Заявка");
			РеквизитыЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаПайщика, "НомерЗаявки, Дата");
			
			Возврат СтрШаблон("%1 г. было осуществлено погашение инвестиционных паев по заявке № %2 от %3 г. Кол-во погашенных паев %4.",
						Формат(Операция.Дата, "ДФ=dd.MM.yy"),
						СокрЛП(РеквизитыЗаявки.НомерЗаявки),
						Формат(РеквизитыЗаявки.Дата, "ДФ=dd.MM.yy"), 
						Операция.Количество);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Акции") Тогда
		РеквизитыЦБ = РаботаСОтчетами.ПолучитьРеквизитыЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания);
		Возврат "Переоценка акций " + РеквизитыЦБ.КраткоеНаименованиеЭмитента + "," + РеквизитыЦБ.РегистрационныйНомер + " от " + Формат(Операция.Дата, "ДФ=dd.MM.yy"); 
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Облигации") Тогда
		РеквизитыЦБ = РаботаСОтчетами.ПолучитьРеквизитыЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания);
		Возврат "Переоценка облигаций " + РеквизитыЦБ.КраткоеНаименованиеЭмитента + "," + РеквизитыЦБ.РегистрационныйНомер + " от " + Формат(Операция.Дата, "ДФ=dd.MM.yy"); 
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Паи") Тогда
		Возврат "Переоценка паев " + РаботаСОтчетами.ПолучитьПредставлениеЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания, Ложь) + " от " + Формат(Операция.Дата, "ДФ=dd.MM.yy"); 
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПереоценкаЦенныхБумаг") И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Доли") Тогда
		РеквизитыЦБ = РаботаСОтчетами.ПолучитьРеквизитыЦеннойБумаги(Субконто2, ЭтотОбъект.Период.ДатаОкончания);
		Если РеквизитыЦБ.КраткоеНаименованиеЭмитентаПоУставу = "ООО ""АлгоритмИнвест""" И НачалоДня(Операция.Дата) = '20251230' Тогда
			Возврат "Переоценка долей в уставном капитале " + РеквизитыЦБ.КраткоеНаименованиеЭмитентаПоУставу + " в соответствии с отчетом оценщика № 135-25/01/270514 от 18.12.2025г.";
		Иначе
			Возврат "Переоценка долей в уставном капитале " + РеквизитыЦБ.КраткоеНаименованиеЭмитентаПоУставу + " от " + Формат(Операция.Дата, "ДФ=dd.MM.yy");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.ПереоценкаКредитныхИнструментов") И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Займы") Тогда
		РеквизитыЗайма = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Субконто2, Операция.Дата); 
		
		Возврат СтрШаблон(
					"Проценты за %1 по договору %2 займа №%3 от %4 с %5", 
		            НРег(Формат(Операция.Дата, "ДФ=MMMM")),
					?(Субконто2.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Полученный, "полученного", "выданного"),
					РеквизитыЗайма.НомерДоговора,
					Формат(Субконто2.ДатаЗаключения, "ДФ='dd.MM.yyyy ''г.'''"),
					РеквизитыЗайма.КраткоеНаименованиеКонтрагента);
		
	ИначеЕсли СтрНачинаетсяС(КодСтроки, "02.05") И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Займы") Тогда
		РеквизитыЗайма = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Субконто2, Операция.Дата); 
		
		Возврат СтрШаблон(
					"Списание накопленной переоценки по погашенному %1 займу %2 от %3", 
					Формат(Операция.Дата, "ДФ=dd.MM.yyyy"),
					РеквизитыЗайма.КраткоеНаименованиеКонтрагента,
					Формат(Субконто2.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
		
	ИначеЕсли СтрНачинаетсяС(КодСтроки, "03.07") 
	   И ТипЗнч(Субконто2) = Тип("СправочникСсылка.Займы")
	   И ТипЗнч(Операция) = Тип("ДокументСсылка.ЗакрытиеКредитногоИнструмента") Тогда
		РеквизитыЗайма = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(Субконто2, Операция.Дата); 
		
		Возврат СтрШаблон(
					"Проценты по займу %1 от %2 за период с %3 по %4 включительно, выплаченные %5", 
					РеквизитыЗайма.КраткоеНаименованиеКонтрагента,
					Формат(Субконто2.ДатаЗаключения, "ДФ=dd.MM.yyyy"),
					Формат(Операция.НачалоПериода, "ДФ=dd.MM.yyyy"),
					Формат(Операция.ОкончаниеПериода, "ДФ=dd.MM.yyyy"),
					Формат(Операция.Дата, "ДФ=dd.MM.yyyy"));
					
	ИначеЕсли ТипЗнч(Операция) = Тип("ДокументСсылка.КорректировкаРегистров") 
		И Операция = ОбщегоНазначения.ПолучитьИменованныйОбъект("КоррРПИ_ДефолтКотенко") Тогда
 
		Возврат "Обесценение дебиторской задолженности по возврату суммы займа и процентов по Договору процентного займа от 21.03.2017г между Фондом и Котенко А.В. в связи с дефолтом заемщика 21.06.2022г";
		
	ИначеЕсли Субконто1 = БухгалтерскийУчет.ОпределитьНастройкуУчетаАктива(Операция.Дата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.УчетныеАктивы.ДоходныеВложенияВМатериальныеЦенности, Перечисления.ВидыУчета.БухгалтерскийУчет, "АналитикаДоходовОтПереоценки")  Тогда
		
		Если Субконто2.ВидОбъектаНедвижимости = Перечисления.ВидыОбъектовНедвижимости.ЗемельныйУчасток Тогда
			Возврат "Изменение стоимости недвижимого имущества (кадастровый номер " + Субконто2.КадастровыйНомер + ")";
		Иначе
			
			РеквизитыОбъекта = РегистрыСведений.РеквизитыОбъектовНедвижимости.ПолучитьПоследнее(Операция.Дата, Новый Структура("Организация,СчетДоверительногоУправления,ОбъектНедвижимости",ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Субконто2));
			Возврат "Изменение стоимости недвижимого имущества " 
				+ ?(ЗначениеЗаполнено(РеквизитыОбъекта.НаименованиеЕГРН), РеквизитыОбъекта.НаименованиеЕГРН + " ", "") 
				+ "(кадастровый номер " + Субконто2.КадастровыйНомер + ")";
			
		КонецЕсли;
		
	Иначе
		// Из-за наличия в разделе SR_0420503_R3_5 двух представлений документов вида "Закрытие РЕПО от 31.01.2025", которые вызывали ошибку неуникальности наборов осей,
		// с таксономии 6.1 расширяем представление документов: если номер операции содержит знак "/", то номер заменяется не на пустую строку, а на часть номера после знака "/"
		Позиция = СтрНайти(Операция.Номер, "/");
		СтрокаЗаменыНомера = ?(Позиция > 0 И ЭтотОбъект.ВерсияТаксономии >= "6_1", Сред(Операция.Номер, Позиция + 1) + " ", "");

		ПредставлениеДокумента = Строка(Операция);
		ПредставлениеДокумента = СтрЗаменить(ПредставлениеДокумента, Строка(Операция.Номер) + " ", СтрокаЗаменыНомера);
		ПредставлениеДокумента = СтрЗаменить(ПредставлениеДокумента, Строка(Операция.Дата), Формат(Операция.Дата, "ДФ=dd.MM.yy"));
		Возврат ПредставлениеДокумента;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел4ОтчетОФинВлож(Запрос)
	
	Данные				= ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_КодыСтрокРаздела4");
	
	МакетОКУД0420503_Параметры4Раздела = ПолучитьМакет("ОКУД0420503_Параметры4Раздела");
	
	Таблица_ОтчетОФинВлож = Новый Структура;
	
	Для НомерСтроки = 2 По МакетОКУД0420503_Параметры4Раздела.ВысотаТаблицы Цикл
		КодСтроки			= МакетОКУД0420503_Параметры4Раздела.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		ТегЗаголовка		= МакетОКУД0420503_Параметры4Раздела.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
		АтрибутыЗаголовка 	= МакетОКУД0420503_Параметры4Раздела.Область(НомерСтроки, 3, НомерСтроки, 3).Текст;
		
		Таблица_ОтчетОФинВлож.Вставить(ТегЗаголовка, ПолучитьДанные_ОКУД0420503_Раздел4ОтчетОФинВлож_ДанныеСтроки(Данные, КодСтроки, АтрибутыЗаголовка));
		
		ТегРасшифровки		= МакетОКУД0420503_Параметры4Раздела.Область(НомерСтроки, 4, НомерСтроки, 4).Текст;
		АтрибутыРасшифровки	= МакетОКУД0420503_Параметры4Раздела.Область(НомерСтроки, 5, НомерСтроки, 5).Текст;
		
		Если ЗначениеЗаполнено(ТегРасшифровки) Тогда
			Таблица_ОтчетОФинВлож.Вставить(ТегРасшифровки, ПолучитьДанные_ОКУД0420503_Раздел4ОтчетОФинВлож_ДанныеРасшифровки(Данные, КодСтроки, АтрибутыРасшифровки));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("Таблица_ОтчетОФинВлож", Таблица_ОтчетОФинВлож);
	
КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел4ОтчетОФинВлож_ДанныеСтроки(Данные, КодСтроки, ПоляСтроки)

	МассивПолейСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляСтроки);
	ОборотПоПокупке = 0;
	ОборотПоПродаже = 0;
	
	Если ЗначениеЗаполнено(КодСтроки) Тогда
		МассивКодовСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодСтроки, ".");
		
		ПараметрыПоиска = Новый Структура;
		
		Для Индекс = 0 По МассивКодовСтроки.Количество() - 1 Цикл
			ПараметрыПоиска.Вставить("КодСтроки" + Индекс, МассивКодовСтроки[Индекс]);
		КонецЦикла;
		
		НайденныеСтроки = Данные.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			ОборотПоПокупке = ОборотПоПокупке + СтрокаДанных.ОборотПоПокупке;
			ОборотПоПродаже = ОборотПоПродаже + СтрокаДанных.ОборотПоПродаже;
		КонецЦикла;
	КонецЕсли;
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить(МассивПолейСтроки[0], ); 
	ДанныеСтроки.Вставить(МассивПолейСтроки[1], КодСтроки); 
	
	Если МассивПолейСтроки.Количество() = 5 Тогда
		ДанныеСтроки.Вставить(МассивПолейСтроки[2],); 
	КонецЕсли;
	
	ДанныеСтроки.Вставить(МассивПолейСтроки[МассивПолейСтроки.Количество() - 2], Окр(ОборотПоПокупке, 2)); 	
	ДанныеСтроки.Вставить(МассивПолейСтроки[МассивПолейСтроки.Количество() - 1], Окр(ОборотПоПродаже, 2)); 
	
	Возврат ДанныеСтроки;

КонецФункции

Функция ПолучитьДанные_ОКУД0420503_Раздел4ОтчетОФинВлож_ДанныеРасшифровки(Данные, КодСтроки, ПоляСтроки)

	МассивСтрок = Новый Массив;
	МассивПолейСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляСтроки);
	
	МассивКодовСтроки	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодСтроки, ".");
	
	ПараметрыПоиска = Новый Структура;
	
	Для Индекс = 0 По МассивКодовСтроки.Количество() - 1 Цикл
		ПараметрыПоиска.Вставить("КодСтроки" + Индекс, МассивКодовСтроки[Индекс]);
	КонецЦикла;
	
	НайденныеСтроки = Данные.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить(МассивПолейСтроки[0], СтрокаДанных.НаименованиеЦБ); 
		ДанныеСтроки.Вставить(МассивПолейСтроки[1], КодСтроки); 
		ДанныеСтроки.Вставить(МассивПолейСтроки[2], СтрокаДанных.РегНомер); 
		ДанныеСтроки.Вставить(МассивПолейСтроки[3], СтрокаДанных.ISIN); 
		ДанныеСтроки.Вставить(МассивПолейСтроки[4], Окр(СтрокаДанных.ОборотПоПокупке, 2)); 
		ДанныеСтроки.Вставить(МассивПолейСтроки[5], Окр(СтрокаДанных.ОборотПоПродаже, 2)); 
		
		МассивСтрок.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	Возврат МассивСтрок;

КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420503_Общий()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Значение КАК Значение,
		|	ФинансовыеПоказатели.Период КАК Период
		|ПОМЕСТИТЬ ВТ_СтоимостьЧистыхАктивов
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Период В(&ДатыРасчетаСЧА)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	0,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент.ДатаПравил
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		|ГДЕ
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, ДАТАВРЕМЯ(1, 1, 1)) > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1), ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВидыРасходовДУ.ПрочиеДоходыИРасходыКод КАК ПрочиеДоходыИРасходыКод,
		|	ВидыРасходовДУ.ПрочиеДоходыИРасходыНаименование КАК ПрочиеДоходыИРасходыНаименование,
		|	ВидыРасходовДУ.КодСтроки КАК КодСтроки,
		|	ВидыРасходовДУ.Наименование КАК Наименование,
		|	ВидыРасходовДУ.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ ВТ_ВидыРасходовДУ
		|ИЗ
		|	&ВидыРасходовДУ КАК ВидыРасходовДУ
		|ГДЕ
		|	ПОДСТРОКА(ВидыРасходовДУ.ПрочиеДоходыИРасходыКод, 1, 1) <> """"
		|	И ПОДСТРОКА(ВидыРасходовДУ.КодСтроки, 1, 3) = ""02.""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ВидыРасходовДУ.КодСтроки КАК КодСтроки,
		|	ВТ_ВидыРасходовДУ.Идентификатор КАК Идентификатор,
		|	ВТ_ВидыРасходовДУ.Наименование КАК Наименование
		|ПОМЕСТИТЬ _НаименованияКодовСтрокРасходовДУ
		|ИЗ
		|	ВТ_ВидыРасходовДУ КАК ВТ_ВидыРасходовДУ
		|ГДЕ
		|	ПОДСТРОКА(ВТ_ВидыРасходовДУ.Наименование, 1, 5) <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.Аналитика КАК Аналитика,
		|	ВложенныйЗапрос.КодДляСтрокиРезидент КАК КодДляСтрокиРезидент,
		|	ВложенныйЗапрос.КодДляСтрокиНеРезидент КАК КодДляСтрокиНеРезидент,
		|	ВложенныйЗапрос.Знак КАК Знак,
		|	ВложенныйЗапрос.Счет КАК Счет
		|ПОМЕСТИТЬ ВТ_КодСтрокДляАналитик
		|ИЗ
		|	(ВЫБРАТЬ
		|		НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации КАК Аналитика,
		|		""01.01"" КАК КодДляСтрокиРезидент,
		|		""01.02"" КАК КодДляСтрокиНеРезидент,
		|		1 КАК Знак,
		|		NULL КАК Счет
		|	ИЗ
		|		РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|				&ДатаОкончания,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет)
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтныеВалютные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентныеВалютные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДепозитарныеРасписки), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ИпотечныеСертификатыУчастия), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ПаиИностранныхЭмитентов))) КАК НастройкиУчетаАктивовСрезПоследних
		|	ГДЕ
		|		НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации <> ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		НастройкиУчетаАктивовСрезПоследних.АналитикаПервоначальногоПризнания,
		|		""01.01"",
		|		""01.02"",
		|		1,
		|		NULL
		|	ИЗ
		|		РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
		|				&ДатаОкончания,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет)
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И УчетныйАктив В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтныеВалютные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентныеВалютные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДепозитарныеРасписки), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ИпотечныеСертификатыУчастия), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи), ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ПаиИностранныхЭмитентов))) КАК НастройкиУчетаАктивовСрезПоследних
		|	ГДЕ
		|		НастройкиУчетаАктивовСрезПоследних.АналитикаПервоначальногоПризнания <> ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов,
