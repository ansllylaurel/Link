Процедура ПолучитьДанные_ОКУД0420502_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, ИмяСекции, ИмяВерикальнойОбласти, Отказ, МассивОбластейДляВывода = Неопределено, ИспользуетсяРазделитель = Ложь)

	Если МассивОбластейДляВывода = Неопределено Тогда
		МассивОбластейДляВывода = Новый Массив;
		ВывестиМассивОбластей = Истина;
	Иначе
		ВывестиМассивОбластей = Ложь;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Шапка") <> Неопределено Тогда
		МассивОбластейДляВывода.Добавить(Макет.ПолучитьОбласть("Разделитель|" + ИмяВерикальнойОбласти));
		МассивОбластейДляВывода.Добавить(Макет.ПолучитьОбласть(Имясекции + "Шапка|" + ИмяВерикальнойОбласти));
		ИспользуетсяРазделитель = Истина;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "КодыСтрок") <> Неопределено Тогда
		ОбластьКодыСтрок = Макет.ПолучитьОбласть(Имясекции + "КодыСтрок|" + ИмяВерикальнойОбласти);
		
		Данные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("КодыСтрок_Финал").ПолучитьДанные().Выгрузить();
		
		Если ИмяСекции = "Раздел4_2" Тогда
			ОбластьШапка = Макет.ПолучитьОбласть("Раздел4Шапка");
		Иначе	
			ОбластьШапка = Макет.ПолучитьОбласть(Имясекции + "Шапка");
		КонецЕсли;
			
		Для НомерКолонки = 1 По ОбластьШапка.ШиринаТаблицы Цикл
			Заголовок = ОбластьШапка.Область(ОбластьШапка.ВысотаТаблицы - 1, НомерКолонки, ОбластьШапка.ВысотаТаблицы - 1, НомерКолонки).Текст;
			Заголовок = СтрЗаменить(Заголовок, Символы.ПС, " ");
			Если Заголовок = "Код строки" Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для НомерСтроки = 1 По ОбластьКодыСтрок.ВысотаТаблицы Цикл
			
			ОбластьСтрока	= ОбластьКодыСтрок.ПолучитьОбласть(НомерСтроки, 1, НомерСтроки, ОбластьКодыСтрок.ШиринаТаблицы);
			КодСтроки		= ОбластьКодыСтрок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст;
			
			Если КодСтроки = "-" ИЛИ ПустаяСтрока(КодСтроки)  Тогда
				Если ИмяСекции = "Раздел3Подраздел10" Тогда
					КодСтроки = "СА";
				КонецЕсли;	
			КонецЕсли;
			
			ПараметрыОтбора = Новый Структура;
			Если СтрДлина(КодСтроки) = 2 Тогда
				ПараметрыОтбора.Вставить("КодСтроки1", КодСтроки);
				ПараметрыОтбора.Вставить("КодСтроки2", "ХХ");
				ПараметрыОтбора.Вставить("КодСтроки3", "ХХ");
			ИначеЕсли СтрДлина(КодСтроки) = 4 Тогда
				ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
				ПараметрыОтбора.Вставить("КодСтроки2", "0" + Прав(КодСтроки, 1));
				ПараметрыОтбора.Вставить("КодСтроки3", "ХХ");
			ИначеЕсли СтрДлина(КодСтроки) = 5 Тогда
				ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
				ПараметрыОтбора.Вставить("КодСтроки2", Прав(КодСтроки, 2));
				ПараметрыОтбора.Вставить("КодСтроки3", "ХХ");
			ИначеЕсли СтрДлина(КодСтроки) = 8 Тогда		
				ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
				ПараметрыОтбора.Вставить("КодСтроки2", Сред(КодСтроки, 4, 2));
				ПараметрыОтбора.Вставить("КодСтроки3", Прав(КодСтроки, 2));
			КонецЕсли;

			ПараметрыОбласти = Новый Структура("СуммаНаКонец,СуммаНаНачало,ДоляОтОбщейСтоимости,ДоляОтСЧА", 0, 0, 0, 0);
			
			НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
				ПараметрыОбласти.СуммаНаКонец			= ПараметрыОбласти.СуммаНаКонец  		+ СтрокаДанных.СуммаНаКонец;
				ПараметрыОбласти.СуммаНаНачало			= ПараметрыОбласти.СуммаНаНачало 		+ СтрокаДанных.СуммаНаНачало;
				ПараметрыОбласти.ДоляОтОбщейСтоимости	= ПараметрыОбласти.ДоляОтОбщейСтоимости + СтрокаДанных.ДоляОтОбщейСтоимости;
				ПараметрыОбласти.ДоляОтСЧА				= ПараметрыОбласти.ДоляОтСЧА 			+ СтрокаДанных.ДоляОтСЧА;
			КонецЦикла;
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ПараметрыОбласти); 
			МассивОбластейДляВывода.Добавить(ОбластьСтрока);
		КонецЦикла;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Строка") <> Неопределено Тогда
		
		Данные = СформироватьМассивСтрокДляПечатнойФормы(Запрос, "ПечатнаяФорма_" + ИмяСекции, "", Отказ);
		
		Для Каждого СтрокаДанных Из Данные Цикл
			ОбластьСтрока = Макет.ПолучитьОбласть(Имясекции + "Строка|" + ИмяВерикальнойОбласти);
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			МассивОбластейДляВывода.Добавить(ОбластьСтрока);
		КонецЦикла;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Итог") <> Неопределено Тогда
		
		ОбластьИтог = Макет.ПолучитьОбласть(Имясекции + "Итог|" + ИмяВерикальнойОбласти);
		
		Данные = СформироватьМассивСтрокДляПечатнойФормы(Запрос, "ПечатнаяФорма_" + ИмяСекции + "Итог", "", Отказ);
		
		Для Каждого СтрокаДанных Из Данные Цикл
			ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, СтрокаДанных);
		КонецЦикла;
		
	    МассивОбластейДляВывода.Добавить(ОбластьИтог);
	КонецЕсли;
	
	Если ВывестиМассивОбластей Тогда
		ВывестиМассивОбластей(Результат, МассивОбластейДляВывода, Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиМассивОбластей(Результат, МассивОбластейДляВывода, ИспользуетсяРазделитель = Ложь)
	
	Если МассивОбластейДляВывода.Количество() Тогда
		
		Если НЕ Результат.ПроверитьВывод(МассивОбластейДляВывода) Тогда
			Результат.ВывестиГоризонтальныйРазделительСтраниц();
			
			Если ИспользуетсяРазделитель Тогда
				МассивОбластейДляВывода.Удалить(0);//удаляем разделитель
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ОбластьДляВывода Из МассивОбластейДляВывода Цикл
			Результат.Вывести(ОбластьДляВывода);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса_ОКУД0420502_ПечатнаяФорма()

	ПустыеТаблицы = Новый Массив;
	
	Если ВерсияТаксономии >= "4_2" Тогда
		
#Область ТекстЗапроса_4_2
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда КАК ПолноеНаименованиеПИФ,
		|	ПОДСТРОКА(КлиентыДоверительногоУправленияСрезПоследнихНаНачало.Клиент.НомерПравил, 1, 4) КАК НомерПравил,
		|	РеквизитыУправляющейКомпании.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеУК,
		|	СтатусыЛицензийСрезПоследних.Лицензия.Серия + СтатусыЛицензийСрезПоследних.Лицензия.Номер КАК НомерЛицензииУК,
		|	КодыПоОКПОПИФ.Значение КАК ОКПОПиф
		|ПОМЕСТИТЬ ПечатнаяФорма_Раздел1
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследнихНаНачало
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФСрезПоследних
