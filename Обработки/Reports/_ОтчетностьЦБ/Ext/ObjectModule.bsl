		|		ПО _СвязанныеЛица.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОРегистрации)) КАК ДокументыЮрЛиц
		|		ПО _СвязанныеЛица.ЮрФизЛицо = ДокументыЮрЛиц.ЮрФизЛицо
		|			И (ДокументыЮрЛиц.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮрЛиц.ДействуетПо > &ДатаОкончания)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОбъемВложений КАК _ОбъемВложений
		|		ПО _СвязанныеЛица.ЮрФизЛицо = _ОбъемВложений.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ВидыДеятельности КАК _ВидыДеятельности
		|		ПО _СвязанныеЛица.ЮрФизЛицо = _ВидыДеятельности.ЮрФизЛицо";
	
	Возврат ТекстЗапроса;
	
КонецФункции	

#КонецОбласти

// Сведения о собственных средствах управляющей компании и активах в управлении
#Область СООУРКИ028

Функция ПолучитьДанные_СООУРКИ028(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ПолучитьДанные_СООУРКИ028_КонтрольНастроекФормированияСЧА(Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПакетДанных.Вставить("ИмяОтчета"			, "ПакетСООУРКИ028");
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ПакетСООУРКИ028_ПакетСООУРКИ028");
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить("2_16_3", "_", "."));
	ПакетДанных.Вставить("Отчет"				, Новый Структура);
	
	ПакетОтчетность = Новый Структура;
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаОкончания"	, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ГраницаОкончания", Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("СтоимостьСобственныхСредствИзБухгалтерии"	, ЭтотОбъект.СтоимостьСобственныхСредствИзБухгалтерии);

	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Коэффициент"		, 1000);
	
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);
	ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос);
	
	Запрос.Текст = РаботаСОтчетностьюЦБ.ПолучитьТекстЗапроса_СООУРКИ028(ЭтотОбъект.Период.ДатаОкончания);
	
	Данные = Запрос.Выполнить().Выгрузить();

	ПакетДанных.Отчет.Вставить("ОтчетностьРКИОтчет052"			, ПолучитьДанные_СООУРКИ028_ОтчетностьРКИОтчет052(Данные));
	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо"			, ПолучитьСопроводительноеПисьмо("СООУРКИ028"));
	ПакетДанных.Отчет.Вставить("ПодписьУполномоченногоЛицаУК"	, ПолучитьДанные_СООУРКИ028_ПодписьУполномоченногоЛицаУК());
	
	Возврат ПакетДанных;
	
КонецФункции

Функция ПолучитьДанные_СООУРКИ028_КонтрольНастроекФормированияСЧА(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиФормированияСЧА.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК НастройкиФормированияСЧАСрезПоследних
		|		ПО (НастройкиФормированияСЧАСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияФормированияПИФ
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ДатаОкончанияФормированияПИФ.Объект)
		|			И (ДатаОкончанияФормированияПИФ.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		|ГДЕ
		|	НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиАкционерныхИнвестиционныхФондов)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ИЛИ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР))
		|	И НастройкиФормированияСЧАСрезПоследних.Период ЕСТЬ NULL
		|	И ВЫБОР
		|			КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
		|				ТОГДА ДатаОкончанияФормированияПИФ.Значение ЕСТЬ НЕ NULL 
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ДатаОкончания"	, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ " + Выборка.СчетДоверительногоУправления + " не задана настройка формирования СЧА на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"),,,, Отказ);
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция ПолучитьДанные_СООУРКИ028_ОтчетностьРКИОтчет052(Данные)

	ОтчетностьРКИОтчет052 = Новый Структура("ДатаПредставления, УправляющаяКомпания, ВеличинаСобственныхСредств");
	
	ДеятельностьПоДоверительномуУправлениюФондами	= Новый Структура("КоличествоПИФАИФ, КоличествоДоговоровДУ1, КоличествоДоговоровДУ2");
	ОбъемАктивовВДоверительномУправлении			= Новый Структура("СтоимостьЧистыхАктивовИФ, СтоимостьПенсионныхРезервовНПФ, СтоимостьЧистыхАктивовПоДоговорамСНПФ, СтоимостьЧистыхАктивовПоДоговорамСПФР");
	
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(ОтчетностьРКИОтчет052, СтрокаДанных);
		
		ЗаполнитьЗначенияСвойств(ДеятельностьПоДоверительномуУправлениюФондами	, СтрокаДанных);
		ЗаполнитьЗначенияСвойств(ОбъемАктивовВДоверительномУправлении			, СтрокаДанных);
	КонецЦикла;
	
	ОтчетностьРКИОтчет052.Вставить("ДеятельностьПоДоверительномуУправлениюФондами"	, ДеятельностьПоДоверительномуУправлениюФондами);
	ОтчетностьРКИОтчет052.Вставить("ОбъемАктивовВДоверительномУправлении"			, ОбъемАктивовВДоверительномУправлении);
	
	Возврат ОтчетностьРКИОтчет052;

КонецФункции

Функция ПолучитьДанные_СООУРКИ028_ПодписьУполномоченногоЛицаУК()

	РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "ФИО, ДолжностьИПодразделение");	
	
	ПодписьУполномоченногоЛицаУК = Новый Структура;
	ПодписьУполномоченногоЛицаУК.Вставить("ФИО"					, РеквизитыРуководителя.ФИО);
	ПодписьУполномоченногоЛицаУК.Вставить("Должность"			, РеквизитыРуководителя.ДолжностьИПодразделение);
	ПодписьУполномоченногоЛицаУК.Вставить("КонтактныйТелефон"	, РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания, "Телефоны").Телефоны);
	
	Возврат ПодписьУполномоченногоЛицаУК;
	
КонецФункции

Процедура ЗаполнитьПечатнуюФорму_СООУРКИ028(ПакетДанных, Результат, Отказ) Экспорт
	
	Результат.Очистить();
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПакетОтчет = ПакетДанных.Отчет;
	
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Результат.ПолеСлева		= 25;
	Результат.ПолеСправа	= 10;
	
	Если ЭтотОбъект.Период.ДатаОкончания < Дата(2021,1,1) Тогда
		Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета + "_1");
	Иначе
		Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета + "_2");
	КонецЕсли;		
	
	Макет.Параметры.ДатаПредставления = Формат(ПакетОтчет.ОтчетностьРКИОтчет052.ДатаПредставления, "ДФ='dd MMMM yyyy ''г.'''");
	
	ЗаполнитьЗначенияСвойств(Макет.Параметры, ПакетОтчет.ОтчетностьРКИОтчет052,, "ДатаПредставления");
	ЗаполнитьЗначенияСвойств(Макет.Параметры, ПакетОтчет.ОтчетностьРКИОтчет052.ДеятельностьПоДоверительномуУправлениюФондами);
	ЗаполнитьЗначенияСвойств(Макет.Параметры, ПакетОтчет.ОтчетностьРКИОтчет052.ОбъемАктивовВДоверительномУправлении);
	ЗаполнитьЗначенияСвойств(Макет.Параметры, ПакетОтчет.ПодписьУполномоченногоЛицаУК);
	
	Результат.Вывести(Макет);
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровку_СООУРКИ028(ПакетДанных, Расшифровка, Отказ) Экспорт
	
	Расшифровка.Очистить();
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаОкончания"		, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ГраницаОкончания"	, Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания));
	
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Коэффициент"		, 1000);
	
	ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос);
	
	Запрос.Текст = ПолучитьТекстЗапроса_Расшифровки_СООУРКИ028();
	
	Запрос.Выполнить();

	ЗаполнитьРасшифровку_СООУРКИ028_ВыводГурппировки("ПИФ, АИФ"				, Расшифровка, ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПИФ_АИФ"));
	ЗаполнитьРасшифровку_СООУРКИ028_ВыводГурппировки("Пенсионные резервы"	, Расшифровка, ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПР"));
	ЗаполнитьРасшифровку_СООУРКИ028_ВыводГурппировки("Пенсионные накопления", Расшифровка, ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПН"));
	ЗаполнитьРасшифровку_СООУРКИ028_ВыводГурппировки("ПФР"					, Расшифровка, ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПФР"));
	
КонецПроцедуры

Процедура ЗаполнитьРасшифровку_СООУРКИ028_ВыводГурппировки(ИмяГрупировки, Расшифровка, Данные)
	
	Макет = ПолучитьМакет("ПакетСООУРКИ028_Расшифровка");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог		= Макет.ПолучитьОбласть("Итог");
	
	ОбластьШапка.Параметры.Группа = ИмяГрупировки;
	
	Расшифровка.Вывести(ОбластьШапка);
	
	Данные.Сортировать("СчетДоверительногоУправления");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ОбластьСтрока.Параметры.НомерСтроки = Данные.Индекс(СтрокаДанных) + 1;
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		Расшифровка.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ОбластьИтог.Параметры.Сумма = Данные.Итог("Сумма");
	ОбластьИтог.Параметры.СуммаТыс = Данные.Итог("СуммаТыс");
	
	Расшифровка.Вывести(ОбластьИтог);
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса_Расшифровки_СООУРКИ028()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ ВТ_СчетаДоверительногоУправления
		|ИЗ
		|	_Клиенты КАК СчетаДоверительногоУправления
		|;";
		
	ТекстЗапросаДатСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьТекстЗапросаПоДатамРегламентныхДействий(
			Новый Структура("ВидДействия, ДополнитьРабочимиДнями, СвойПериодДляКаждогоСчетаДУ, УдалитьВсеВременныеТаблицы, ИмяТаблицыСчетовДУ, ИмяТаблицыДатДействияЗаПериод", 
				"СЧА", Ложь, Ложь, Истина, "ВТ_СчетаДоверительногоУправления", "ВТ_ДатыСЧА"));
			
	ТекстЗапросаДатСЧА = СтрЗаменить(ТекстЗапросаДатСЧА,"&ДатаПо", "КОНЕЦПЕРИОДА(&ДатаОкончания, ДЕНЬ)");
	ТекстЗапросаДатСЧА = СтрЗаменить(ТекстЗапросаДатСЧА,"&ДатаС", "НАЧАЛОПЕРИОДА(&ПоследнийРабочийДень, ДЕНЬ)");
	
	ТекстЗапроса = ТекстЗапроса + ТекстЗапросаДатСЧА + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
