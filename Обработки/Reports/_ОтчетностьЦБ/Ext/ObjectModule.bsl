Процедура СверкаИННиОГРН(Данные, ИмяЮрФизЛицо, ИмяИНН, ИмяОГРН, ИмяКПП, ИмяНаименование, УдаляемыеКолонки = "", ВыводитьРасхождения = Истина, ОчищатьНаименованиеЕслиЕстьВСпрЦБ = Ложь)
	
	Если Данные.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	ДанныеЦБ = ПолучитьДанныеСправочникаИННиОГРН(Данные, ИмяИНН, ИмяОГРН);
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанных[ИмяИНН]) Тогда Продолжить; КонецЕсли;
		Если СтрокаДанных[ИмяИНН] = Лев("000000000000", СтрДлина(СтрокаДанных[ИмяИНН])) Тогда Продолжить; КонецЕсли;
		
		Если ДанныеЦБ = Неопределено Тогда
			СтрокаДанныхЦБ = Неопределено;
		Иначе
			СтрокаДанныхЦБ = ДанныеЦБ.Найти(СтрокаДанных[ИмяИНН], "INN");
		КонецЕсли;
			
		Если СтрокаДанныхЦБ = Неопределено Тогда
			Если ВыводитьРасхождения Тогда
				ДобавитьРасхождение(СтрокаДанных[ИмяЮрФизЛицо], СтрокаДанных[ИмяИНН]);
			КонецЕсли;
			Продолжить;
		ИначеЕсли ОчищатьНаименованиеЕслиЕстьВСпрЦБ = Истина Тогда
			СтрокаДанных[ИмяНаименование] = "";
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанныхЦБ.Name) Тогда
			Если ВыводитьРасхождения Тогда
				ДобавитьРасхождение(СтрокаДанных[ИмяЮрФизЛицо], СтрокаДанных[ИмяИНН], СтрокаДанныхЦБ.INN, СтрокаДанныхЦБ.Name, СтрокаДанныхЦБ.Name_CBR_Official);
			КонецЕсли;
		Иначе
			СтрокаДанных[ИмяНаименование] = СтрокаДанныхЦБ.Name;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяОГРН) Тогда
			Если СтрокаДанных[ИмяОГРН] <> СтрокаДанныхЦБ.OGRN Тогда
				Если ЗначениеЗаполнено(СтрокаДанных[ИмяОГРН]) Тогда
					Если ВыводитьРасхождения Тогда
						ДобавитьРасхождение(СтрокаДанных[ИмяЮрФизЛицо], СтрокаДанных[ИмяИНН], СтрокаДанныхЦБ.INN, СтрокаДанныхЦБ.Name, СтрокаДанныхЦБ.Name_CBR_Official);
					КонецЕсли;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаДанныхЦБ.OGRN) Тогда
					СтрокаДанных[ИмяОГРН] = СтрокаДанныхЦБ.OGRN;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяКПП) Тогда
			Если СтрокаДанных[ИмяКПП] <> СтрокаДанныхЦБ.KPP Тогда
				Если ЗначениеЗаполнено(СтрокаДанных[ИмяКПП]) Тогда
