Процедура ОКУД0420415_XBRL_Подготовить_РеестрКонтрагентов(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо КАК ЮрЛицоДепозитария,
		|	ВЫБОР
		|		КОГДА &ЭтоРПИ
		|			ТОГДА ""OrganizOsushUchetPravNaCZBMember""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.ТипСчета В (ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.Депозитарный), ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета))
		|					ТОГДА ""NominalnyjDerzhatelMember""
		|				КОГДА ОстаткиЦенныхБумагОстатки.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.Лицевой)
		|					ТОГДА ""RegistrOsushVedenReestrVlCZBMember""
		|			КОНЕЦ
		|	КОНЕЦ КАК РольКонтрагента
		|ПОМЕСТИТЬ _РолиДепозитариевПоТипуДепозитарногоСчета
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&ГраницаОкончания,
		|			СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						ДействующиеСчетаДУ.Ссылка
		|					ИЗ
		|						ДействующиеСчетаДУ КАК ДействующиеСчетаДУ)
		|				И (Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|					ИЛИ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					ИЛИ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|					ИЛИ Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки))) КАК ОстаткиЦенныхБумагОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РолиДепозитариевПоТипуДепозитарногоСчета.ЮрЛицоДепозитария КАК ЮрЛицоДепозитария,
		|	МАКСИМУМ(_РолиДепозитариевПоТипуДепозитарногоСчета.РольКонтрагента) КАК РольКонтрагента
		|ПОМЕСТИТЬ _РолиДепозитариев
		|ИЗ
		|	_РолиДепозитариевПоТипуДепозитарногоСчета КАК _РолиДепозитариевПоТипуДепозитарногоСчета
		|
		|СГРУППИРОВАТЬ ПО
		|	_РолиДепозитариевПоТипуДепозитарногоСчета.ЮрЛицоДепозитария
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Таб.Контрагент КАК Контрагент,
		|	Таб.РольКонтрагента КАК РольКонтрагента,
		|	Таб.ИмяРеквизита КАК ИмяРеквизита
		|ПОМЕСТИТЬ _РеестрКонтрагентов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА SR_0420415_R1_PR1_3_1.НеВыгружать_ПрямоеРЕПО
		|				ТОГДА ""ПрямоеРЕПО""
		|			ИНАЧЕ SR_0420415_R1_PR1_3_1.IDOrgVedUchPravCBTaxis
		|		КОНЕЦ КАК Контрагент,
		|		ЕСТЬNULL(_РолиДепозитариев.РольКонтрагента, """") КАК РольКонтрагента,
		|		""SR_0420415_R1_PR1_3_1.IDOrgVedUchPravCBTaxis"" КАК ИмяРеквизита
		|	ИЗ
		|		SR_0420415_R1_PR1_3_1 КАК SR_0420415_R1_PR1_3_1
		|			ЛЕВОЕ СОЕДИНЕНИЕ _РолиДепозитариев КАК _РолиДепозитариев
		|			ПО SR_0420415_R1_PR1_3_1.IDOrgVedUchPravCBTaxis = _РолиДепозитариев.ЮрЛицоДепозитария
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		SR_0420415_R2_PR2_1_1.IDLiczaUKotPriobrVekselTaxis,
		|		""LiczUKotPriobrVekselMember"",
		|		""SR_0420415_R2_PR2_1_1.IDLiczaUKotPriobrVekselTaxis""
		|	ИЗ
		|		SR_0420415_R2_PR2_1_1 КАК SR_0420415_R2_PR2_1_1
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		SR_0420415_R2_PR2_1_1.IDLiczaUKotNaxodVekselTaxis,
		|		""LiczUKotNaxVekselMember"",
		|		""SR_0420415_R2_PR2_1_1.IDLiczaUKotNaxodVekselTaxis""
		|	ИЗ
		|		SR_0420415_R2_PR2_1_1 КАК SR_0420415_R2_PR2_1_1
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		SR_0420415_R2_PR2_1_1.IDLiczaVPolzuKotVybytVekselTaxis,
		|		""LiczVPolzuKotProizVybVekselMember"",
		|		""SR_0420415_R2_PR2_1_1.IDLiczaVPolzuKotVybytVekselTaxis""
		|	ИЗ
		|		SR_0420415_R2_PR2_1_1 КАК SR_0420415_R2_PR2_1_1) КАК Таб
		|ГДЕ
		|	&ЕстьРаздел0420437";
	
	Запрос.Выполнить();
	
КонецПроцедуры

