Функция ОКУД0420011_ПолучитьНомерДоговора(Договор)
	
	Если Ложь Тогда
		Договор = Справочники.Договоры.ПустаяСсылка();
	КонецЕсли;
	
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоров.ДополнительноеСоглашение Тогда
		МассивЧастейНомераДоговора = Новый Массив;
		МассивЧастейНомераДоговора.Добавить("ДС");
		
		Если ЗначениеЗаполнено(Договор.НомерДоговора) Тогда
			МассивЧастейНомераДоговора.Добавить("№" + Договор.НомерДоговора);
		КонецЕсли;
		
		Если ТипЗнч(Договор.Основание) = Тип("СправочникСсылка.Договоры") Тогда
			Если Договор.Основание.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоОбслуживания Тогда
				МассивЧастейНомераДоговора.Добавить("к ДБО");
			ИначеЕсли Договор.Основание.ВидДоговора = Перечисления.ВидыДоговоров.КомплексногоОбслуживания Тогда
				МассивЧастейНомераДоговора.Добавить("к ДКО");
			Иначе
				МассивЧастейНомераДоговора.Добавить("к договору");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Договор.Основание.НомерДоговора) Тогда
				МассивЧастейНомераДоговора.Добавить("№" + Договор.Основание.НомерДоговора);
			КонецЕсли;
		КонецЕсли;
		
		Возврат СтрСоединить(МассивЧастейНомераДоговора, " ");
		
	Иначе
		Возврат Договор.НомерДоговора;
		
	КонецЕсли;
	
КонецФункции

Функция ОКУД0420001_ПолучитьИдентификаторКонтрагента(ЮрФизЛицо, ДатаОперации, РезидентРФ)
	
	ЭлементыИдентификатораКонтрагента = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо",		ЮрФизЛицо);
	Запрос.УстановитьПараметр("Период",			ДатаОперации);
	
	
	Если ЮрФизЛицо.ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности КАК ВидУдостоверенияЛичности,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
			|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресРегистрации КАК АдресРегистрации
			|ИЗ
			|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И ЮрФизЛицо = &ЮрФизЛицо
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЭлементыИдентификатораКонтрагента.Добавить(Выборка.ВидУдостоверенияЛичности);
			
			Если ЗначениеЗаполнено(Выборка.СерияУдостоверенияЛичности) Тогда
				ЭлементыИдентификатораКонтрагента.Добавить("Серия: " + Выборка.СерияУдостоверенияЛичности);
			КонецЕсли;
			
			ЭлементыИдентификатораКонтрагента.Добавить("№ " + Выборка.НомерУдостоверенияЛичности);
			
			Если ЗначениеЗаполнено(Выборка.ДатаВыдачиУдостоверенияЛичности) Тогда
				ЭлементыИдентификатораКонтрагента.Добавить("выдан: " + Формат(Выборка.ДатаВыдачиУдостоверенияЛичности, "ДФ=dd.MM.yyyy"));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.ОрганВыдавшийУдостоверениеЛичности) Тогда
				Если ЗначениеЗаполнено(Выборка.ДатаВыдачиУдостоверенияЛичности) Тогда
					ЭлементыИдентификатораКонтрагента.Добавить(Выборка.ОрганВыдавшийУдостоверениеЛичности);
				Иначе
					ЭлементыИдентификатораКонтрагента.Добавить("выдан: " + Выборка.ОрганВыдавшийУдостоверениеЛичности);
				КонецЕсли;
			КонецЕсли;
				
			Если ЗначениеЗаполнено(Выборка.КодОрганаВыдавшегоУдостоверениеЛичности) Тогда
				ЭлементыИдентификатораКонтрагента.Добавить("Код подр." + Выборка.КодОрганаВыдавшегоУдостоверениеЛичности);
			КонецЕсли;
			
			Если РезидентРФ Тогда
				Если ЗначениеЗаполнено(Выборка.ИНН) Тогда
					ЭлементыИдентификатораКонтрагента.Добавить("ИНН " + Выборка.ИНН);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.АдресРегистрации) Тогда
					ЭлементыИдентификатораКонтрагента.Добавить("Адрес регистрации: " + Выборка.АдресРегистрации);
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат СтрСоединить(ЭлементыИдентификатораКонтрагента, ", ");
	
КонецФункции

