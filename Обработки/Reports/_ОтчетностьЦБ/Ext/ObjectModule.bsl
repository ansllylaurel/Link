#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчетность ЦБ",
		"19.23",
		"",
		Истина
	);
	
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(
		Команды, "АвтоОтправкаОтчета_ОКУД0420511", "Автоотправка отчета ОКУД0420511",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(
		Команды, "КонтрольПоказателейДеятельностиПрофУчастника", "Контроль показателей деятельности проф участника",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
КонецФункции

// Интерфейс для формирования отчета и отправки на почту по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	Перем Ошибки, ПриВыполненииВозниклиОшибки;
	
	Ошибки = Новый Массив();
	ПриВыполненииВозниклиОшибки = Ложь;
	
	// Обрабатываем только известные команды
	Если НЕ СтрНачинаетсяС(ИдентификаторКоманды, "АвтоОтправкаОтчета") 
	   И НЕ СтрНачинаетсяС(ИдентификаторКоманды, "КонтрольПоказателейДеятельностиПрофУчастника") Тогда
		
		ПриВыполненииВозниклиОшибки = Истина;
		Ошибки.Добавить("Неизвестный идентификатор команды """ + ИдентификаторКоманды + """");
	КонецЕсли;
	
	// Заполним параметры команды
	Если Не ПриВыполненииВозниклиОшибки Тогда
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
		Если Не ПараметрыКоманды.Свойство("Организация", ЭтотОбъект.Организация) ИЛИ Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Не указан или не заполнен параметр ""Организация""");
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "АвтоОтправкаОтчета") Тогда
		ЭтотОбъект.Период.ДатаОкончания = НачалоДня(ТекущаяДата()) - 1;
		ЭтотОбъект.Период.ДатаНачала	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания);
		
	ИначеЕсли СтрНачинаетсяС(ИдентификаторКоманды, "КонтрольПоказателейДеятельностиПрофУчастника") Тогда
		ЭтотОбъект.Период.ДатаНачала	= НачалоГода(ТекущаяДата());
		ЭтотОбъект.Период.ДатаОкончания = НачалоГода(ТекущаяДата());
		
	КонецЕсли;
		
	// Организуем сбор статистики
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды);
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание
	);
	
	// Формируем отчет
	Если Не ПриВыполненииВозниклиОшибки Тогда
		Если СтрНачинаетсяС(ИдентификаторКоманды, "АвтоОтправкаОтчета") Тогда
			ПриВыполненииВозниклиОшибки = Не АвтоОтправкаОтчета_ОКУД0420511(Ошибки);
			
		ИначеЕсли СтрНачинаетсяС(ИдентификаторКоманды, "КонтрольПоказателейДеятельностиПрофУчастника") И Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата()) Тогда
			КонтрольКвартальныхПоказателей();
			
		КонецЕсли;
	КонецЕсли;
	
	// Если были ошибки, сохраняем их
	Если ПриВыполненииВозниклиОшибки Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Ошибки, ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	КонецЕсли;
	
	// Завершаем сессию сбора статистики
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
КонецПроцедуры // ВыполнитьКоманду

// Интерфейс для запуска отложенных заданий
Процедура ВыполнитьМетод(Команда, Экземпляры) Экспорт
	
	Перем Ошибки, ПриВыполненииВозниклиОшибки;
	
	Ошибки 		= Новый Массив;
		
	ПриВыполненииВозниклиОшибки = Ложь;
	
	Для Каждого Экземпляр Из Экземпляры Цикл
		
		ПараметрыКоманды = Экземпляр.Параметры;
		
		// Обрабатываем только известные команды
		Если НЕ СтрНачинаетсяС(Команда, "АвтоОтправкаОтчета") Тогда  		
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Неизвестный метод """ + Команда + """");
		КонецЕсли;
		
		// Заполним параметры команды	
		ЭтотОбъект.Период.ДатаОкончания = КонецДня(ПараметрыКоманды.Период);
		ЭтотОбъект.Период.ДатаНачала	= НачалоДня(ПараметрыКоманды.Период);
		
		ЭтотОбъект.Организация			= ПараметрыКоманды.Организация;
		
		// Организуем сбор статистики
		ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики(Команда);
		
		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьМетод()";
		Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание
		);
		
		// Формируем отчет
		Если Не ПриВыполненииВозниклиОшибки Тогда
			ПриВыполненииВозниклиОшибки = Не АвтоОтправкаОтчета_ОКУД0420511(Ошибки);		
		КонецЕсли;
		
		// Если были ошибки, сохраняем их
		Если ПриВыполненииВозниклиОшибки И Ошибки.Количество() > 0 Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Ошибки, ПараметрыКоманды.ДополнительнаяОбработкаСсылка);
		КонецЕсли;
				
		// Завершаем сессию сбора статистики
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
		// Фиксируем успешное выполнение задания.
		РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(Экземпляр.Идентификатор);
		
		Если ПриВыполненииВозниклиОшибки Тогда
			
			// Создаем новое задание на полчаса позже
			Параметры = Новый Структура("Организация, Период", ЭтотОбъект.Организация, НачалоДня(ЭтотОбъект.Период.ДатаОкончания));		
			
			Параметры.Вставить("ИсточникОшибки", 				"Контроль отклонения от рыночных цен");  				
			Параметры.Вставить("ТекстОшибки",					"Не удалось добавить отложенное задание '_ОтчетностьЦБ.АвтоОтправкаОтчета_ОКУД0420511'.");  
			Параметры.Вставить("ДополнительнаяОбработкаСсылка", ПараметрыКоманды.ДополнительнаяОбработкаСсылка);
					
			РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ПараметрыКоманды.ДополнительнаяОбработкаСсылка, "АвтоОтправкаОтчета_ОКУД0420511", Параметры, 15, Истина, ТекущаяДатаСеанса() + 1800);

		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры // ВыполнитьМетод

Функция АвтоОтправкаОтчета_ОКУД0420511(Ошибки = Неопределено)
	ПриВыполненииВозниклиОшибки = Ложь;
	Если Ошибки = Неопределено Тогда
		Ошибки = Новый Массив;	
	КонецЕсли;
	
	Если НЕ Справочники.Календари.КалендарьЗаполненЗаПериод(Справочники.Календари.Общероссийский, Период.ДатаНачала, Период.ДатаОкончания) Тогда
		Ошибки.Добавить("За период с " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " не заполнен календарь '" + Строка(Справочники.Календари.Общероссийский) + "'!");
		ПриВыполненииВозниклиОшибки = Истина;
	КонецЕсли;
	
	КалендарьКотировок = ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок");
	
	Если НЕ Справочники.Календари.КалендарьЗаполненЗаПериод(КалендарьКотировок, Период.ДатаНачала, Период.ДатаОкончания) Тогда
		Ошибки.Добавить("За период с " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " не заполнен календарь '" + Строка(КалендарьКотировок) + "'!");
		ПриВыполненииВозниклиОшибки = Истина;
	КонецЕсли;
	
	Если ПриВыполненииВозниклиОшибки Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса()) Тогда
		Возврат Истина;
	КонецЕсли;
	
	//Проверим, что все ПН закрыты
	СчетаДУ = Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
					Период.ДатаОкончания, 
					Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(
							ЭтотОбъект.Организация,
							Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
							)
				    );
					
	Если Не ПроведеныРегламентныеОперацииПоСчетамДУНаДату(СчетаДУ, НачалоДня(Период.ДатаНачала)) Тогда
		
		РеквизитыОповещения = Новый Структура();								
		РеквизитыОповещения.Вставить("Организация",	ЭтотОбъект.Организация);
		РеквизитыОповещения.Вставить("Дата",		Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		РеквизитыОповещения.Вставить("Текст", 		"Отчет не сформирован: не по всем договорам ПН проведены регламентные операции за " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
									
		Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + "_АвтоОтправкаОтчета_ОКУД0420511", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КалендарьКотировок",	КалендарьКотировок);
	Запрос.УстановитьПараметр("НачалоПериода",		Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",		Период.ДатаОкончания);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь В (ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский), &КалендарьКотировок)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Перебираем все дни, входящие в период проверки (с последнего рабочего дня по вчерашний день), которые явлются рабочими или торговыми.
	// Проверяем каждый день отдельно.
	Пока Выборка.Следующий() Цикл
		
		ЭтотОбъект.Период.ДатаНачала	= Выборка.Дата;
		ЭтотОбъект.Период.ДатаОкончания	= КонецДня(Выборка.Дата);
		
		// Если котировки не загружены, уведомляем адресатов
		СтрокаСообщенийОКотировках	= "";
		СписокПроверкиКотировок		= Новый Структура("КотировкиММВБ", Истина);
		
		КотировкиЗагружены = РаботаСПереоценкой.ПроверитьЗагружаемыеДанные(ЭтотОбъект.Период.ДатаНачала, СписокПроверкиКотировок, СтрокаСообщенийОКотировках);	
		Если Не КотировкиЗагружены Тогда
							
			РеквизитыОповещения = Новый Структура();								
			РеквизитыОповещения.Вставить("Организация",	ЭтотОбъект.Организация);
			РеквизитыОповещения.Вставить("Дата",		Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
			РеквизитыОповещения.Вставить("Текст", 		СтрокаСообщенийОКотировках);
									
			Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + "_АвтоОтправкаОтчета_ОКУД0420511", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
						
		КонецЕсли;
		
		// Получаем данные	
		ОтчетСодержитДанные = Ложь;	
		
		Если КотировкиЗагружены Тогда
			Попытка	
				ПакетДанных			= ПолучитьДанные_ОКУД0420511(Ложь);
				СтрокиОтчета		= ПакетДанных.Отчет.ОтчетОСделках.Таблица_ОтчетОСделках.Таб_СведенияОСделкахСтроки_1;
				ОтчетСодержитДанные	= ЗначениеЗаполнено(СтрокиОтчета) И СтрокиОтчета[0] <> "ЗаполнитьПустымиЗначениями";
			Исключение
				ПриВыполненииВозниклиОшибки = Истина;
				Ошибки.Добавить("Ошибка получения данных: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		// Сохраняем отчет в Excel и отправляем его адресатам
		Если ОтчетСодержитДанные Тогда
			ТабличныйДокумент = Новый ТабличныйДокумент;	
			ЗаполнитьПечатнуюФорму_ОКУД0420511(ПакетДанных, ТабличныйДокумент, Ложь);
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xlsx");
			ТабличныйДокумент.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
			
			Вложения = Новый Соответствие;
			Вложения.Вставить("ОКУД0420511_" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ПрефиксНумерации") + "_" + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ".xlsx", Новый Файл(ИмяВременногоФайла));
			
			РеквизитыОповещения = Новый Структура();								
			РеквизитыОповещения.Вставить("Организация",	ЭтотОбъект.Организация);
			РеквизитыОповещения.Вставить("Дата",		Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
			РеквизитыОповещения.Вставить("Текст", 		"Отчет о сделках, проведенных с отклонением от рыночных цен (ОКУД 0420511) за " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " по " + Строка(ЭтотОбъект.Организация));
			РеквизитыОповещения.Вставить("Вложения",	Вложения);
						
			Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + "_АвтоОтправкаОтчета_ОКУД0420511", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
						
			Попытка
				УдалитьФайлы(ИмяВременногоФайла);
			Исключение
				//Каталог временных файлов, он должен сам чиститься
			КонецПопытки;
			
		КонецЕсли;
			
	КонецЦикла;

	Возврат (Не ПриВыполненииВозниклиОшибки); 
КонецФункции

