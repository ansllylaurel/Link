Процедура ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос, ВидУчета = "ЕдиныйБухгалтерскийУчет", ВключаяЗавершенныеВДатуОкончания = Истина)
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Клиенты") = Неопределено Тогда 
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
			|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Организация.ЮрФизЛицо КАК ЮрФизЛицо
			|ПОМЕСТИТЬ _Клиенты
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|ГДЕ
			|	НЕ СчетаДоверительногоУправления.ПометкаУдаления
			|	И СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
			|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))";
	
		Если Не ВключаяЗавершенныеВДатуОкончания Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаРасторжения >= &ДатаОкончания", "ДатаРасторжения > &ДатаОкончания");
		КонецЕсли;
		
		Запрос.Выполнить();
		
	КонецЕсли;	
		
	РаботаСОтчетами.ДобавитьДанныеПоБазеРасчетаВЗапрос(Запрос, Новый Структура("НачалоПериода, КонецПериода", ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания), "_Клиенты", ?(ВидУчета = "ЕдиныйБухгалтерскийУчет", "_РСАНаКонецБаланс", "_РСАНаКонецБалансРСБУ"), Ложь);
	
КонецПроцедуры

