Функция ПолучитьТаблицуВидовКредиторскойЗадолженности()
	
	ТаблицаВидовКЗ = Новый ТаблицаЗначений;
	ТаблицаВидовКЗ.Колонки.Добавить("ВидЗадолженности",			Метаданные.РегистрыСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Измерения.ВидЗадолженности.Тип);
	ТаблицаВидовКЗ.Колонки.Добавить("TipKZstatAxis",			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТаблицаВидовКЗ.Колонки.Добавить("ТипЗадолженности",			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТаблицаВидовКЗ.Колонки.Добавить("КодСтроки",				Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(8)));
	ТаблицаВидовКЗ.Колонки.Добавить("KatKredZadolzhEnumerator",	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТаблицаВидовКЗ.Колонки.Добавить("КатегорияЗадолженности",	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	
	Макет = ПолучитьМакет("ОКУД0420502_ТаблицаВидовКредиторскойЗадолженности");
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		СтрокаВидовКЗ = ТаблицаВидовКЗ.Добавить();
		
		Если ЗначениеЗаполнено(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст) Тогда
			ЭлементыПути = СтрРазделить(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст, ".");
			СтрокаВидовКЗ.ВидЗадолженности = Справочники[ЭлементыПути[1]][ЭлементыПути[2]];
		Иначе
			СтрокаВидовКЗ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПустаяСсылка();
		КонецЕсли;
		
		СтрокаВидовКЗ.TipKZstatAxis				= Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
		СтрокаВидовКЗ.ТипЗадолженности			= Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст;
		СтрокаВидовКЗ.КодСтроки					= Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст;
		СтрокаВидовКЗ.KatKredZadolzhEnumerator	= Макет.Область(НомерСтроки, 5, НомерСтроки, 5).Текст;
		СтрокаВидовКЗ.КатегорияЗадолженности	= Макет.Область(НомерСтроки, 6, НомерСтроки, 6).Текст;
	КонецЦикла;	
	
	Возврат ТаблицаВидовКЗ;
	
КонецФункции

Функция ПолучитьТаблицуНастроекСверткиЗадолженностей(НомерПравил, ДатаОкончания)
	
	ТаблицаВидовЗадолженности = Новый ТаблицаЗначений;
	ТаблицаВидовЗадолженности.Колонки.Добавить("ВидЗадолженности",	  Метаданные.РегистрыСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Измерения.ВидЗадолженности.Тип);
	ТаблицаВидовЗадолженности.Колонки.Добавить("ШаблонПредставления", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	
	Макет = ПолучитьМакет("ОКУД0420502_НастройкиСверткиЗадолженностей");
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		мДатаНачала	   = ?(ЗначениеЗаполнено(СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст)), Дата(СокрЛП(Макет.Область(НомерСтроки, 1, НомерСтроки, 1).Текст)), Дата(1980, 1, 1));
		мДатаОкончания = ?(ЗначениеЗаполнено(СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст)), КонецДня(Дата(СокрЛП(Макет.Область(НомерСтроки, 2, НомерСтроки, 2).Текст))), Дата(3999, 12, 31));
		
		Если Макет.Область(НомерСтроки, 3, НомерСтроки, 3).Текст = НомерПравил И ДатаОкончания >= мДатаНачала И ДатаОкончания <= мДатаОкончания Тогда
			
			СтрокаВидовКЗ = ТаблицаВидовЗадолженности.Добавить();
			
			Если ЗначениеЗаполнено(Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст) Тогда
				ЭлементыПути = СтрРазделить(Макет.Область(НомерСтроки, 4, НомерСтроки, 4).Текст, ".");
				СтрокаВидовКЗ.ВидЗадолженности = Справочники[ЭлементыПути[1]][ЭлементыПути[2]];
			Иначе
				СтрокаВидовКЗ.ВидЗадолженности = Справочники.ВидыЗадолженности.ПустаяСсылка();
			КонецЕсли;
			
			СтрокаВидовКЗ.ШаблонПредставления = Макет.Область(НомерСтроки, 5, НомерСтроки, 5).Текст;
			
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ТаблицаВидовЗадолженности;
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420502_XBRL()
	
	Если ВерсияТаксономии >= "4_2" Тогда
		
#Область ТекстЗапроса_4_2
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&УполномоченноеЛицоСпецДепа КАК UpolnLiczoSpecDepFIO,
		|	&IdAifPifTaxis КАК IdAifPifTaxis,
