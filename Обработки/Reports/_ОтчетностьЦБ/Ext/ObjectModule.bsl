#Область ОКУД0420501_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420501(Отказ) Экспорт
	
	Отказ		= Ложь;
	ИмяПакета	= "ОКУД0420501";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Истина);
	
	ПризнакНулевогоОтчета = Истина;
	
	Запрос = Новый Запрос;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала"				, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень"	, Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ГраницаОкончания"		, Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"				, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("БалансоваяСтоимость77"	, ЭтотОбъект.БалансоваяСтоимость.Выгрузить());
	Запрос.УстановитьПараметр("ВознагражденияУК"		, ЭтотОбъект.ВознагражденияУК.Выгрузить());
	Запрос.УстановитьПараметр("Руководитель"			, ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("ВерсияТаксономии"		, ЭтотОбъект.ВерсияТаксономии);	
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);	
	
	Запрос.УстановитьПараметр("СудебныйПроцесс_А41_28545_09_2022_03_15"	, ОбщегоНазначения.ПолучитьИменованныйОбъект("СудебныйПроцесс_А41-28545/09_2022-03-15"));	
	
	Если ЭтотОбъект.Период.ДатаОкончания < Дата(2021, 10, 1) И ЭтотОбъект.ЭтоРЭМ Тогда
		Запрос.УстановитьПараметр("ИсключаемыеСудебныеПроцессы", ОбщегоНазначения.ПолучитьИменованныйОбъект("СудебныйПроцесс_А40-257407_19_2019-10-02"));
	Иначе
		Запрос.УстановитьПараметр("ИсключаемыеСудебныеПроцессы", Новый Массив);
	КонецЕсли;
	
	СМАО = ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_СМАО");
	
	Запрос.УстановитьПараметр("СМАО", СМАО);	
	
	ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос, "БухгалтерскийУчет", 		Ложь);
	ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос, "ЕдиныйБухгалтерскийУчет", Ложь);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420501();
	Запрос.Выполнить();
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

