Функция ПолучитьДанные_ОКУД0420427(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420427_2_16_3_3");
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420427_2_16_3_3_ОКУД0420427_2_16_3_3");
	ПакетДанных.Вставить("ВерсияОтчета"			, "2.16.3.3");
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	ПакетДанных.Отчет.Вставить("ПоСостояниюНа", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy-MM-dd"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, , "_ДатыПолученияДокументовОСмерти");
	
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПустоеЗначение"	, ЭтотОбъект.ПустоеЗначение);
	Запрос.УстановитьПараметр("ВалютаУчета"		, ЭтотОбъект.ВалютаУчета);
	Запрос.УстановитьПараметр("ВалютаДоллар"	, Справочники.Валюты.НайтиПоНаименованию("USD", Истина));
	Запрос.УстановитьПараметр("ВалютаЕвро"		, Справочники.Валюты.НайтиПоНаименованию("EUR", Истина));
	Запрос.УстановитьПараметр("Биржа"			, ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420427();
	Запрос.Выполнить();
	
	ПакетДанных.Отчет.Вставить("СведОбИндивидуальнИнвестиционнСчетах", Новый Структура);
	ПакетДанных.Отчет.СведОбИндивидуальнИнвестиционнСчетах.Вставить("Табл_СведенияОбИндивидИнвестСчетах", Новый Структура);
	ПакетДанных.Отчет.СведОбИндивидуальнИнвестиционнСчетах.Табл_СведенияОбИндивидИнвестСчетах.Вставить("Row_104"		, ПолучитьФиксированнуюСтруктуру("Row_104"));
	ПакетДанных.Отчет.СведОбИндивидуальнИнвестиционнСчетах.Табл_СведенияОбИндивидИнвестСчетах.Вставить("Table_46_1"		, ПолучитьДанные_ОКУД0420427_МассивСтрок(Запрос)); 

	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо", ПолучитьСопроводительноеПисьмо("ОКУД0420427"));

	Возврат ПакетДанных;

КонецФункции

