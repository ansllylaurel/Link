Процедура ОКУД0420459_СверитьСоСправочникомИННиОГРН(Запрос, Отказ)

	Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_РасшифровкаОтчета", Отказ);
	Данные.Колонки.Добавить("НаименованиеЦБ", Новый ОписаниеТипов("Строка"));
	
	ДанныеСправочникаИННиОГРН = ПолучитьДанныеСправочникаИННиОГРН(Данные, "ИНН", "ОГРН");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ЗначениеЗаполнено(СтрокаДанных.ИНН) ИЛИ ЗначениеЗаполнено(СтрокаДанных.ОГРН) Тогда
			НайденныеСтроки = ДанныеСправочникаИННиОГРН.НайтиСтроки(Новый Структура("INN", СтрокаДанных.ИНН));
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НайденныеСтроки = ДанныеСправочникаИННиОГРН.НайтиСтроки(Новый Структура("OGRN", СтрокаДанных.ОГРН));
			КонецЕсли;
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				Если ЗначениеЗаполнено(НайденныеСтроки[0].Name) Тогда
					СтрокаДанных.НаименованиеЦБ = НайденныеСтроки[0].Name;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ПолноеНаименованиеФонда) Тогда
			СтрокаДанных.НаименованиеЭмитентаЦеннойБумаги = СтрокаДанных.НаименованиеЭмитентаЦеннойБумаги + " (" + СтрокаДанных.ПолноеНаименованиеФонда + ")";
			СтрокаДанных.НаименованиеЦБ = СтрокаДанных.НаименованиеЦБ + " (" + СтрокаДанных.ПолноеНаименованиеФонда + ")";
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаменитьВременнуюТаблицу(Запрос, "_РасшифровкаОтчета", Данные);
	
КонецПроцедуры
	
