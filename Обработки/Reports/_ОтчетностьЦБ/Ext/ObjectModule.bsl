КонецФункции

#КонецОбласти

//Отчет о соблюдении кодекса профессиональной этики управляющей компании 
#Область ОКУД0420520_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420520(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420520";
	ПакетДанных = Новый Структура;
	ПризнакНулевогоОтчета = Истина;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Если ЕстьДействующиеДоговорыНаОтчетнуюДату(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		Запрос = Новый Запрос;
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ДатаНачала"					, ЭтотОбъект.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания"				, ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Руководитель"				, ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
		Запрос.УстановитьПараметр("Контролер"					, ПолучитьПолноеФИООтветственногоЛица("Контролер"));
		
		СформироватьПояснительнуюЗаписку_XBRL_ОКУД0420520(Запрос);
		
		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420520();
		Запрос.Выполнить();
		
		ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);
	КонецЕсли;

	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции	

Процедура СформироватьПояснительнуюЗаписку_XBRL_ОКУД0420520(Запрос)
	
	Если Ложь Тогда
		Запрос = Новый Запрос;
	КонецЕсли;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СлужебноеРасследованиеУсловияВозниковенияКонфликта.ОписаниеУсловий КАК Konflikt_Interesov_Vyyavl_Otch_PeriodTextBlock
		|ИЗ
		|	Документ.СлужебноеРасследование.УсловияВозниковенияКонфликта КАК СлужебноеРасследованиеУсловияВозниковенияКонфликта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СлужебноеРасследование КАК СлужебноеРасследование
		|		ПО СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка = СлужебноеРасследование.Ссылка
		|			И (СлужебноеРасследование.ОбстоятельствоВозникновенияКонфликтаИнтересов В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.КодексПрофессиональнойЭтики)))
		|ГДЕ
		|	СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка.Проведен
		|	И СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка.Организация = &Организация
		|	И СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСлужебныхРасследований.ВыявленКонфликтИнтересов)
		|	И ПОДСТРОКА(СлужебноеРасследованиеУсловияВозниковенияКонфликта.ОписаниеУсловий, 1, 100) <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка.Дата,
		|	СлужебноеРасследованиеУсловияВозниковенияКонфликта.Ссылка.Ссылка,
		|	СлужебноеРасследованиеУсловияВозниковенияКонфликта.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СлужебноеРасследование.ПринятыеМеры КАК Prinyatye_Mery_Konflikt_InteresovTextBlock
		|ИЗ
		|	Документ.СлужебноеРасследование КАК СлужебноеРасследование
		|ГДЕ
		|	СлужебноеРасследование.Проведен
		|	И СлужебноеРасследование.Организация = &Организация
		|	И СлужебноеРасследование.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СлужебноеРасследование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСлужебныхРасследований.ВыявленКонфликтИнтересов)
		|	И ПОДСТРОКА(СлужебноеРасследование.ПринятыеМеры, 1, 100) <> """"
		|	И СлужебноеРасследование.ОбстоятельствоВозникновенияКонфликтаИнтересов В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.КодексПрофессиональнойЭтики))
		|
		|УПОРЯДОЧИТЬ ПО
		|	СлужебноеРасследование.Дата,
		|	СлужебноеРасследование.Ссылка";
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Если НЕ Пакет[0].Пустой() Тогда
		Запрос.УстановитьПараметр("Konflikt_Interesov_Vyyavl_Otch_PeriodTextBlock", СтрСоединить(Пакет[0].Выгрузить().ВыгрузитьКолонку("Konflikt_Interesov_Vyyavl_Otch_PeriodTextBlock"), Символы.ПС));
	Иначе
		Запрос.УстановитьПараметр("Konflikt_Interesov_Vyyavl_Otch_PeriodTextBlock", "");
	КонецЕсли;
	
	Если НЕ Пакет[1].Пустой() Тогда
		Запрос.УстановитьПараметр("Prinyatye_Mery_Konflikt_InteresovTextBlock", СтрСоединить(Пакет[1].Выгрузить().ВыгрузитьКолонку("Prinyatye_Mery_Konflikt_InteresovTextBlock"), Символы.ПС));
	Иначе
		Запрос.УстановитьПараметр("Prinyatye_Mery_Konflikt_InteresovTextBlock", "");
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Narusheniya_Treb_KPE_KonfidenczInfoTextBlock"	, ЭтотОбъект.НарушениеТребованийКодексаПрофессиональнойЭтики);
	Запрос.УстановитьПараметр("Prinyatye_Mery_KonfidenczInfoTextBlock"			, ЭтотОбъект.МерыПоПредотвращениюРаспространенияИнформации);
	Запрос.УстановитьПараметр("Inye_Sved_KPETextBlock"							, ЭтотОбъект.ИныеМерыКПЭТ);
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса_ОКУД0420520()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СведенияПредоставляемыеЮрФизЛицами.Ссылка) КАК Количество
		|ПОМЕСТИТЬ ВТ_КоличествоСведений
		|ИЗ
		|	Документ.СведенияПредоставляемыеЮрФизЛицами КАК СведенияПредоставляемыеЮрФизЛицами
		|ГДЕ
		|	СведенияПредоставляемыеЮрФизЛицами.Проведен
		|	И СведенияПредоставляемыеЮрФизЛицами.Организация = &Организация
		|	И СведенияПредоставляемыеЮрФизЛицами.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЛицаОзнакомленныеСКодексами.Объект) КАК Количество
		|ПОМЕСТИТЬ ВТ_СотрудникиОзнакомленныеСКодексомЭтики
		|ИЗ
		|	РегистрСведений.ВнутренниеПеречни.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И ВидПеречня В (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЛицаОзнакомленныеСКодексами), ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ДолжностныеЛицаПН))) КАК ЛицаОзнакомленныеСКодексами
		|ГДЕ
		|	ЛицаОзнакомленныеСКодексами.Действует
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Количество
		|ПОМЕСТИТЬ ВТ_УстараненоКонфликтовИнтересов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Количество
		|ПОМЕСТИТЬ ВТ_НарушениеЭтикиДолжностныеЛица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Количество
		|ПОМЕСТИТЬ ВТ_НарушениеЭтикиСотрудники
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Количество
		|ПОМЕСТИТЬ ВТ_ДисциплинарныеВзыскания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Ссылка КАК Ссылка,
		|	ВложенныйЗапрос.ВидСвязи КАК ВидСвязи
		|ПОМЕСТИТЬ ВТ_СлужебноеРасследование
		|ИЗ
		|	(ВЫБРАТЬ
		|		СлужебноеРасследованиеИнформацияОКонфликте.Ссылка КАК Ссылка,
		|		СлужебноеРасследованиеИнформацияОКонфликте.ВидСвязи КАК ВидСвязи
		|	ИЗ
		|		Документ.СлужебноеРасследование.ИнформацияОКонфликте КАК СлужебноеРасследованиеИнформацияОКонфликте
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СлужебноеРасследование КАК СлужебноеРасследование
		|			ПО СлужебноеРасследованиеИнформацияОКонфликте.Ссылка = СлужебноеРасследование.Ссылка
		|				И (СлужебноеРасследование.ОбстоятельствоВозникновенияКонфликтаИнтересов В (ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДепозитныйВклад), ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.Сделка), ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаРЕПО)))
		|	ГДЕ
