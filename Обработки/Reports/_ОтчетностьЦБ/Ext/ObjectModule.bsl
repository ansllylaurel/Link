Процедура ДобавитьРасхождение(ЮрФизЛицо, ИНН, ИННИзСправочника = "", Наименование = "", НаименованиеПолное = "")
	
	Если ЭтотОбъект.РасхожденияИННиОГРН.Найти(ЮрФизЛицо, "ЮрФизЛицо") = Неопределено Тогда
		СтрокаРасхождений = ЭтотОбъект.РасхожденияИННиОГРН.Добавить();
		СтрокаРасхождений.ЮрФизЛицо				= ЮрФизЛицо;
		СтрокаРасхождений.ИНН					= ИНН;
		СтрокаРасхождений.ИННИзСправочника		= ИННИзСправочника;
		СтрокаРасхождений.Наименование			= Наименование;
		СтрокаРасхождений.НаименованиеПолное	= НаименованиеПолное;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗаполнитьПечатнуюФорму_ОКУД0420415(ПакетДанных, Результат, Отказ) Экспорт
	
	ПакетОтчет = ПакетДанных.Отчет;
	СопроводительноеПисьмо = ПакетОтчет.СопроводительноеПисьмо;
	
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
	
	ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, СопроводительноеПисьмо); 
	ОбластьШапка.Параметры.ДатаРегистрации_День		= Формат(СопроводительноеПисьмо.ДатаРегистрации, "ДФ=dd");
	ОбластьШапка.Параметры.ДатаРегистрации_Месяц	= НРег(Формат(СопроводительноеПисьмо.ДатаРегистрации, "ДФ=MMMM"));
	ОбластьШапка.Параметры.ДатаРегистрации_Год		= Формат(СопроводительноеПисьмо.ДатаРегистрации, "ДФ=yyyy");
	ОбластьШапка.Параметры.ПустоеЗначение			= ЭтотОбъект.ПустоеЗначение;
	
	Результат.Вывести(ОбластьШапка);
	
	ВывестиРаздел("Подраздел1_1"	, "", "Отчетность.Раздел1.Подраздел1_1.Таблица1_1ЦенныеБумаги.Строка1_1ЦенБумУчНаЛОРО"				, ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел1_2"	, "", "Отчетность.Раздел1.Подраздел1_2.Таблица1_2ЦБНаИныхУчитРегистратором.Строка1_2ЦенБумУчНаДЕПО"	, ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел1_2_1"	, "", "Отчетность.Раздел1.Подраздел1_2.Подраздел1_2_1.Таблица1_2_1ДепозитОперации.Строка_Таблица1_2_1КолДепОперСЦБ", ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел1_3"	, "", "Отчетность.Раздел1.Подраздел1_3.Таблица1_3ЦБНаДепо.Строка_Таблица1_3ЦБНаДепоИИныхСчетах", ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел1_4"	, "", "Отчетность.Раздел1.Подраздел1_4.Таблица1_4БалансСтоимЦенБумаг.Строка_Таблица1_4БалансСтоимВложений", ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел2_1"	, "", "Отчетность.Раздел2.Подраздел2_1.Таблица2_1УчтенВекселя.Строка_Таблица2_1УчтенныеОрганизВекселя", ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел2_2"	, "", "Отчетность.Раздел2.Подраздел2_2.Таблица2_2ВыпущВекселя.Строка_Таблица2_2ВыпущенныеВекселя", ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Подраздел2_3"	, "", "Отчетность.Раздел2.Подраздел2_3.Таблица2_3ИнформОВекселях.Строка_Таблица2_3ИнфОВекселях", ПакетОтчет, Макет, Результат);
	ВывестиРаздел("Раздел3"			, "", "Отчетность.Раздел3.Таблица3ОперСЦенБум.Строка_Таблица3ОперЦБ", ПакетОтчет, Макет, Результат);
	
	ОбластьПодвал						= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ФИОИсполнителя =	Лев(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ИмяПодписанта, 1) + "." +
												Лев(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ОтчествоПодписанта, 1) + ". " +
												СокрЛП(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ФамилияПодписанта);
	
	ОбластьПодвал.Параметры.ФИОКонтролера	=	Лев(СопроводительноеПисьмо.ПодписьКонтролера.ИмяКонтролера, 1) + "." +
												Лев(СопроводительноеПисьмо.ПодписьКонтролера.ОтчествоКонтролера, 1) + ". " +
												СокрЛП(СопроводительноеПисьмо.ПодписьКонтролера.ФамилияКонтролера);
	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура ЗаполнитьРасхожденияИННиОГРН_ОКУД0420415(Результат, Отказ) Экспорт

	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = ПолучитьМакет("РасхожденияИННиОГРН");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасхожденияИННиОГРН.ЮрФизЛицо,
		|	РасхожденияИННиОГРН.ИНН,
		|	РасхожденияИННиОГРН.ИННИзСправочника,
		|	РасхожденияИННиОГРН.Наименование,
		|	РасхожденияИННиОГРН.НаименованиеПолное
		|ПОМЕСТИТЬ ВТ_РасхожденияИННиОГРН
		|ИЗ
		|	&РасхожденияИННиОГРН КАК РасхожденияИННиОГРН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименование,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК Адрес,
		|	РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации.НаименованиеПолное КАК Страна,
		|	РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма.Наименование КАК ОПФ,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН,
		|	РеквизитыЮридическихЛицСрезПоследних.КПП,
		|	ВТ_РасхожденияИННиОГРН.Наименование КАК КраткоеНаименованиеЦБ,
		|	ВТ_РасхожденияИННиОГРН.НаименованиеПолное КАК ПолноеНаименованиеЦБ,
		|	ВТ_РасхожденияИННиОГРН.ИННИзСправочника КАК ИННЦБ
		|ИЗ
		|	ВТ_РасхожденияИННиОГРН КАК ВТ_РасхожденияИННиОГРН
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВТ_РасхожденияИННиОГРН.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО ВТ_РасхожденияИННиОГРН.ЮрФизЛицо = КонтактнаяИнформацияСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО ВТ_РасхожденияИННиОГРН.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)";
		
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("РасхожденияИННиОГРН", ЭтотОбъект.РасхожденияИННиОГРН.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Результат.Вывести(ОбластьШапка);
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
			Результат.Вывести(ОбластьСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОКУД0420415_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420415(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420415";
	ПакетДанных = Новый Структура;
	ДополнительныеПакеты = Новый Структура;
	
	Если СправочникЦБНеАктуальный() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Справочник ЦБ за " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ='MMMM yyyy'") + " не загружен в Matrix! Ожидаем появление на информационном ресурсе.");
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Если ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
		ОКУД0420415_ЗаполнитьТаблицыОтчета_XBRL(Запрос, Отказ);
		ОКУД0420459_XBRL_ЗаполнитьРеестрЦенныхБумаг(Запрос, Отказ);
		
		ДополнительныеПакеты.Вставить("ОКУД0420459", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "SR_0420459").Количество() = 0);
		
		Если ЭтотОбъект.ВерсияТаксономии >= "7_1" Тогда
			
			ОКУД0420437_XBRL_ЗаполнитьРеестрКонтрагентов(Запрос, Отказ);
			ДополнительныеПакеты.Вставить("ОКУД0420437", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "SR_0420437_1").Количество() = 0);
			
		КонецЕсли;
		
	Иначе
		ОКУД0420415_ЗаполнитьТаблицыОтчета_XBRL_4_2(Запрос, Отказ);
	КонецЕсли;
		

	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных,, Отказ, ДополнительныеПакеты);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ОКУД0420415_ЗаполнитьТаблицыОтчета_XBRL(Запрос, Отказ)
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц,
		ЭтотОбъект.Период.ДатаОкончания,
		Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)); 
	
	Запрос.УстановитьПараметр("ДатаНачала"		,  ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	,  ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Период"			,  ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ГраницаОкончания",  Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"		,  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПустоеЗначение"	,  "Неприменимо");
	Запрос.УстановитьПараметр("ВерсияТаксономии",  ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ЕстьРаздел0420437", ЭтотОбъект.ВерсияТаксономии >= "7_1");
	Запрос.УстановитьПараметр("ЭтоРПИ",            ЭтотОбъект.ЭтоРПИ);
	
	Запрос.Текст = ПолучитьТекстЗапроса_РеквизитыЮрФизЛиц_ОКУД0420415_XBRL() + ";" + Символы.ПС + ПолучитьТекстЗапроса_ОКУД0420415_XBRL();

	ТекстЗамены = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДепозитарныеСчета.ДепозитарныйСчет КАК ДепозитарныйСчет,";
	
	Если ЭтотОбъект.Период.ДатаОкончания < ДАТА(2025, 11, 30, 23, 59, 59) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ТекстЗамены, СтрЗаменить(ТекстЗамены, "РАЗЛИЧНЫЕ", ""));	
		
	КонецЕсли;	
	
	Запрос.Выполнить();
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "SR_0420415_R1_PR1_3");
	Данные.Сортировать("NaimOrganizaczii,ID_CzennojBumagiTaxis", Новый СравнениеЗначений);
	
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.ID_strokiTaxis	= Данные.Индекс(СтрокаДанных) + 1;
	КонецЦикла;
	
	СверкаИННиОГРН(Данные, "ЮрФизЛицоОрганиз", "INN_TIN_LEIorganizaczii", "OGRNorganizaczii", "", "NaimOrganizaczii");
	
	ЗаменитьВременнуюТаблицу(Запрос, "SR_0420415_R1_PR1_3_1",	ОКУД0420415_XBRL_ПолучитьДанныеРаздела(Данные, "SR_0420415_R1_PR1_3_1"));
	ЗаменитьВременнуюТаблицу(Запрос, "SR_0420415_R1_PR1_3_2",	ОКУД0420415_XBRL_ПолучитьДанныеРаздела(Данные, "SR_0420415_R1_PR1_3_2"));
	ЗаменитьВременнуюТаблицу(Запрос, "SR_0420415_R1_PR1_3_3",	ОКУД0420415_XBRL_ПолучитьДанныеРаздела(Данные, "SR_0420415_R1_PR1_3_3"));
	ЗаменитьВременнуюТаблицу(Запрос, "SR_0420415_R3_1", 		ОКУД0420415_XBRL_ПолучитьДанныеРаздела(Данные, "SR_0420415_R3_1"));
	
#Область SR_0420415_R2_PR2_1_1
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "SR_0420415_R2_PR2_1_1");
	
	СверкаИННиОГРН(Данные, "Id_VekseledatelyaTaxis", 	"INN_TIN_Rekvizity_vekselya", 			"OGRN_vekseledatelya_Rekv_Vekselya", 				"КППВекселедателя", "Naim_vekseledatelya_Rekv_Vekselya", 					"КППВекселедателя");
	СверкаИННиОГРН(Данные, "ЮрФизЛицоПродавца", 		"INN_Sved_o_Storonax_Sdelki_s_Veks", 	"OGRN_kontragenta_Sved_o_Storonax_Sdelki_s_Veks", 	"КПППродавца", 		"Naim_kontragenta_Sved_o_Storonax_Sdelki_s_Veks", 		"ЮрФизЛицоПродавца,КПППродавца");
	СверкаИННиОГРН(Данные, "ЮрФизЛицоДепозитария", 		"INN_Rekv_l_u_Kot_Nax_Veks", 			"OGRN_Rekv_l_u_Kot_Nax_Veks", 						"КППДепозитария", 	"Mesto_naxozhdeniya_vekselya_Rekv_l_u_Kot_Nax_Veks", 	"ЮрФизЛицоДепозитария,КППДепозитария");
	СверкаИННиОГРН(Данные, "ЮрФизЛицоПокупателя", 		"INN_TIN_kontragenta_vibitie_veksel", 	"OGRN_kontragenta_vibitie_veksel", 					"КПППокупателя", 	"Naim_kontragenta_vibitie_veksel", 						"ЮрФизЛицоПокупателя,КПППокупателя");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ЗначениеЗаполнено(СтрокаДанных.Data_spisaniya_s_balansa_Inf_o_kontr_real_veks) Тогда //на дату списания
			СтрокаДанных.Proczentnaya_stavka_po_vekselyu_Rekv_Vekselya = Справочники.Векселя.ПолучитьПроцентГодовых(СтрокаДанных.ID_CzennojBumagiTaxis, СтрокаДанных.Data_spisaniya_s_balansa_Inf_o_kontr_real_veks);
		Иначе
			СтрокаДанных.Proczentnaya_stavka_po_vekselyu_Rekv_Vekselya = Справочники.Векселя.ПолучитьПроцентГодовых(СтрокаДанных.ID_CzennojBumagiTaxis, ЭтотОбъект.Период.ДатаОкончания);
		КонецЕсли;
	КонецЦикла;	
	
	ЗаменитьВременнуюТаблицу(Запрос, "SR_0420415_R2_PR2_1_1", Данные);
#КонецОбласти	

	ОКУД0420415_XBRL_Подготовить_РеестрЦенныхБумаг(Запрос);
	ОКУД0420415_XBRL_Подготовить_РеестрКонтрагентов(Запрос);

КонецПроцедуры

Функция ОКУД0420415_XBRL_ПолучитьДанныеРаздела(Данные, ИмяРаздела)
	
	Если ИмяРаздела = "SR_0420415_R1_PR1_3_1" Тогда
		Измерения = "NaimOrganizaczii,
					|INN_TIN_LEIorganizaczii,
					|OGRNorganizaczii,
					|KodStranyOrganizacziiEnumerator,
					|PriznakOrganizacziiEnumerator,
					|ID_CzennojBumagiTaxis,
					|ID_strokiTaxis,
					|IDOrgVedUchPravCBTaxis,
					|NomerBalansovogoSchetaVtorogoPoryadka,
					|Primechanie";
		
		Ресурсы = "CZB_Uchtenn_BB, KolCZBbezPrekrPrizNaVozvratOsnove";
		
		ДанныеРаздела = Данные.Скопировать(, Измерения + "," + Ресурсы);
		ДанныеРаздела.Колонки.Добавить("НеВыгружать_ПрямоеРЕПО", Новый ОписаниеТипов("Булево"));
		
		Для Каждого СтрокаРаздела Из ДанныеРаздела Цикл
			
			Если ЗначениеЗаполнено(СтрокаРаздела.KolCZBbezPrekrPrizNaVozvratOsnove) Тогда
				
				СтрокаРаздела.НеВыгружать_ПрямоеРЕПО = Истина;	
				Если ЭтотОбъект.ВерсияТаксономии >= "7_1" Тогда

					СтрокаРаздела.PriznakOrganizacziiEnumerator = ""; 
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	ИначеЕсли ИмяРаздела = "SR_0420415_R1_PR1_3_2" Тогда
		
		ДанныеРаздела =   Новый ТаблицаЗначений;
		ДанныеРаздела.Колонки.Добавить("CZB_Sobst_kol", 				Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ДанныеРаздела.Колонки.Добавить("Tip_czenBum_naPravSobstvAxis",	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
		ДанныеРаздела.Колонки.Добавить("ID_CzennojBumagiTaxis",			ОКУД0420415_ПолучитьОписаниеТипов_ID_CzennojBumagiTaxis());
		ДанныеРаздела.Колонки.Добавить("ID_strokiTaxis",				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19)));
		ДанныеРаздела.Колонки.Добавить("IDOrgVedUchPravCBTaxis",		Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		ДанныеРаздела.Колонки.Добавить("НеВыгружать_ПрямоеРЕПО",        Новый ОписаниеТипов("Булево"));
		
		Ресурсы = Новый Массив;
		Ресурсы.Добавить("KolCZenBumagPrinadOrgMember");
		Ресурсы.Добавить("KolCPrinBuxUchVkachFinVlozhZaIsklVozvrOsnBezPrekrPriznMember");
		Ресурсы.Добавить("KolCZenBumPriobrbezPervPriznPoREPOMember");
		Ресурсы.Добавить("KolCZenBumagPoluchPoSdelkamZajmaMember");
		Ресурсы.Добавить("KolCZenBumagObyazPoKotOtsutsMember");
		Ресурсы.Добавить("KolCZenBumagVlozhvKotPriznBeznadDolgamiMember");
		Ресурсы.Добавить("KolCZenBumagVlozhVKotOshibZachislnaSchetOrganizMember");
		Ресурсы.Добавить("KolichCVlozhPoKotOtsutpoBalanSchetamPoDrugPrichinamMember");
		
		Для Каждого СтрокаДанных Из Данные Цикл
			Для Каждого Ресурс Из Ресурсы Цикл
				Если ЗначениеЗаполнено(СтрокаДанных[Ресурс]) Тогда
					СтрокаДанныхРаздела = ДанныеРаздела.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДанныхРаздела, СтрокаДанных, "ID_CzennojBumagiTaxis,ID_strokiTaxis,IDOrgVedUchPravCBTaxis");
					СтрокаДанныхРаздела.CZB_Sobst_kol					= СтрокаДанных[Ресурс];
					СтрокаДанныхРаздела.Tip_czenBum_naPravSobstvAxis	= Ресурс;
				КонецЕсли;
			КонецЦикла;
			
			СтрокаДанныхРаздела = ДанныеРаздела.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДанныхРаздела, СтрокаДанных, "ID_CzennojBumagiTaxis,ID_strokiTaxis,IDOrgVedUchPravCBTaxis");
			СтрокаДанныхРаздела.CZB_Sobst_kol					= СтрокаДанных.KolCZenBumagPrinadOrgMember;
			СтрокаДанныхРаздела.Tip_czenBum_naPravSobstvAxis	= "VsegoMember";
			
		КонецЦикла;
		
	ИначеЕсли ИмяРаздела = "SR_0420415_R1_PR1_3_3" Тогда
		
		ДанныеРаздела =   Новый ТаблицаЗначений;
		ДанныеРаздела.Колонки.Добавить("CZB_Sobst_kol", 				Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ДанныеРаздела.Колонки.Добавить("CZenBumUchityvNaInyxSchetAxis",	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(255)));
		ДанныеРаздела.Колонки.Добавить("ID_CzennojBumagiTaxis",			ОКУД0420415_ПолучитьОписаниеТипов_ID_CzennojBumagiTaxis());
		ДанныеРаздела.Колонки.Добавить("ID_strokiTaxis",				Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19)));
		ДанныеРаздела.Колонки.Добавить("IDOrgVedUchPravCBTaxis",		Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		ДанныеРаздела.Колонки.Добавить("НеВыгружать_ПрямоеРЕПО",        Новый ОписаниеТипов("Булево"));
		
		Ресурсы = Новый Массив;
		Ресурсы.Добавить("NaSchetDUMember");
		Ресурсы.Добавить("NaKaznachSchetaxEmitentaMember");
		Ресурсы.Добавить("NaEmissSchetaxMember");
		
		Для Каждого СтрокаДанных Из Данные Цикл
			
			Для Каждого Ресурс Из Ресурсы Цикл
				Если ЗначениеЗаполнено(СтрокаДанных[Ресурс]) Тогда
					СтрокаДанныхРаздела = ДанныеРаздела.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДанныхРаздела, СтрокаДанных, "ID_CzennojBumagiTaxis,ID_strokiTaxis,IDOrgVedUchPravCBTaxis");
					СтрокаДанныхРаздела.CZB_Sobst_kol					= СтрокаДанных[Ресурс];
					СтрокаДанныхРаздела.CZenBumUchityvNaInyxSchetAxis	= Ресурс;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	ИначеЕсли ИмяРаздела = "SR_0420415_R3_1" Тогда
		ДанныеРаздела =   Новый ТаблицаЗначений;
		ДанныеРаздела.Колонки.Добавить("ID_strokiTaxis",						Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19)));
		ДанныеРаздела.Колонки.Добавить("ID_CzennojBumagiTaxis",					ОКУД0420415_ПолучитьОписаниеТипов_ID_CzennojBumagiTaxis());
		ДанныеРаздела.Колонки.Добавить("CZB_kol_vo_obratnoe_repo_poluchen1",	Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		ДанныеРаздела.Колонки.Добавить("CZB_kol_vo_pryamoe_repo_peredan1", 		Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		
		Для Каждого СтрокаДанных Из Данные Цикл
			Если ЗначениеЗаполнено(СтрокаДанных.CZB_kol_vo_obratnoe_repo_poluchen1) ИЛИ ЗначениеЗаполнено(СтрокаДанных.CZB_kol_vo_pryamoe_repo_peredan1) Тогда
				ЗаполнитьЗначенияСвойств(ДанныеРаздела.Добавить(), СтрокаДанных);
			КонецЕсли;	
		КонецЦикла;
	
	КонецЕсли;
		
	Возврат ДанныеРаздела;
	
КонецФункции

