	РазделыОтчета.Добавить("sr_0420869_3MetSchetA");    // Остатки по обезличенным металлическим счетам. Не заполняется
	РазделыОтчета.Добавить("sr_0420869_4CzB1A");    	// Ценные бумаги за исключением ипотечных сертификатов участия, инвестиционных паев паевых инвестиционных фондов - стоимость
