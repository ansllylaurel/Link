#Область ОКУД0420507_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420507(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420507";
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ПризнакНулевогоОтчета = Истина;
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

		ПоместитьСчетаДУИКомиссииПоСделкамВЗапрос(Запрос, Отказ);
		Если Отказ Тогда
			Возврат ПакетДанных;
		КонецЕсли;
		
		ДатыСЧА = ПолучитьДатыСЧА_Для_506_507();
		Если ДатыСЧА = Неопределено Тогда
			Отказ = Истина;
			ПакетДанных.Вставить("Отказ", Отказ);
			Возврат ПакетДанных;
		КонецЕсли;

		Запрос.УстановитьПараметр("ДатаСЧА_НачалоПериода", ДатыСЧА.ДатаСЧА_НачалоПериода);
		Запрос.УстановитьПараметр("ДатаСЧА_КонецПериода" , ДатыСЧА.ДатаСЧА_КонецПериода);
		
		Запрос.УстановитьПараметр("Руководитель", ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
		Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа",	  ПолучитьПолноеФИООтветственногоЛица("УполномоченноеЛицоСпецДепа"));
		
		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420507();
		Запрос.Выполнить();
		
		ОКУД0420507_XBRL_ПреобразоватьТаблицу_SR_0420507_2(Запрос);
		
		ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),ПризнакНулевогоОтчета,, Отказ);
		
	КонецЕсли;
	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ОКУД0420507_XBRL_ПреобразоватьТаблицу_SR_0420507_2(Запрос)
	
	Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "SR_0420507_2");
	
	ДанныеРаздела = Новый ТаблицаЗначений;
	ДанныеРаздела.Колонки.Добавить("RasxodySvyazSInvestirovaniemSredstvPenNakop",	Новый ОписаниеТипов("Число"));
	ДанныеРаздела.Колонки.Добавить("ID_Dogovora_Taxis", 							Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ДанныеРаздела.Колонки.Добавить("ID_fondaTaxis",									Метаданные.РегистрыСведений.КлиентыДоверительногоУправления.Ресурсы.Клиент.Тип);
	ДанныеРаздела.Колонки.Добавить("VidyRasxSvyazSInvestSredstvPNAxis", 			Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
	
	Ресурсы = Новый Массив;
	Для Каждого Колонка Из Данные.Колонки Цикл
		Если ДанныеРаздела.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Ресурсы.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Для Каждого Ресурс Из Ресурсы Цикл
			Если ЗначениеЗаполнено(СтрокаДанных[Ресурс]) Тогда
				СтрокаДанныхРаздела = ДанныеРаздела.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДанныхРаздела, СтрокаДанных);
				
				СтрокаДанныхРаздела.RasxodySvyazSInvestirovaniemSredstvPenNakop = СтрокаДанных[Ресурс];
				СтрокаДанныхРаздела.VidyRasxSvyazSInvestSredstvPNAxis = Ресурс;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ЗаменитьВременнуюТаблицу(Запрос, "SR_0420507_2", ДанныеРаздела); 
	
КонецПроцедуры

