	ТипыПеречисленийВалют.Добавить("enum_Kod_valList_Kod_valList");
	ТипыПеречисленийВалют.Добавить("enum_ValyutaList_ValyutaList");
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_ValyutyAxis") Тогда
		ТипыПеречисленийВалют.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	ТипыПеречисленийКодовОпераций = Новый Массив;
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_Vid_Operaczii_DenSredstvaAxis_") Тогда
		ТипыПеречисленийКодовОпераций.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	ТипыПеречисленийКодовЦенныхБумаг = Новый Массив;
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZenBum_Vid_Fin_InstrList_RT_132");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_VidCZbList_VidCzbList");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZenBum_Vid_Fin_Instr2List_TipCZenBum_Vid_Fin_Instr2List");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZB_VidFI_Sved_o_vlozh_v_vypushhen_nerezList_TipCZB_VidFI_Sved_o_vlozh_v_vypushhen_nerezList");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZenBumVidFIList_TipCZenBumVidFIList");
	
	ТипыПеречисленийКодовЭмитентов = Новый Массив;
	ТипыПеречисленийКодовЭмитентов.Добавить("enum_KodEmitlList_KodEmitList");
	ТипыПеречисленийКодовЭмитентов.Добавить("enum_Prinadl_k_Sektoru_EkonomList_Prinadl_k_Sektoru_EkonomList");
	
	КодыСрокаПогашенияЦеннойБумаги = Новый Массив;
	КодыСрокаПогашенияЦеннойБумаги.Добавить("enum_Srok_pogashen_CZBList_Srok_pogashen_CZBList");
	КодыСрокаПогашенияЦеннойБумаги.Добавить("enum_Srok_pogashen_CZBList_RT_19");
	
	ТипыПеречисленийКодовОКАТО = Новый Массив;
	ТипыПеречисленийКодовОКАТО.Добавить("enum_OKATOList_RT_1");
	ТипыПеречисленийКодовОКАТО.Добавить("enum_OKATOList_OKATOList");
	
	ТипыПеречисленийКодовОКАТОИСтран = Новый Массив;
	ТипыПеречисленийКодовОКАТОИСтран.Добавить("enum_OkatoOksmList_OkatoOksmList");
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_OKATO_KodOKSMAxis") Тогда
		ТипыПеречисленийКодовОКАТОИСтран.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	
	Если СтрНачинаетсяС(ЗначениеПеречисления, "Itogo") Тогда
		//ничего не происходит =)
	ИначеЕсли ТипыПеречисленийСтран.Найти(ТипОбъектаXDTO.Имя) <> Неопределено И ЗначениеПеречисления <> "999" Тогда
		ЗначениеПеречисления = "Strana_" + ЗначениеПеречисления;
	ИначеЕсли ТипыПеречисленийВалют.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
		ЗначениеПеречисления = "Valyuta_" + ЗначениеПеречисления;
	ИначеЕсли ТипыПеречисленийКодовОКАТО.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
		ЗначениеПеречисления = "OKATO" + ЗначениеПеречисления;
	КонецЕсли;
	
	Для Каждого Перечисление Из ТипОбъектаXDTO.Фасеты.Перечисления Цикл
		Если ТипыПеречисленийСтран.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийВалют.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовОКАТО.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовЦенныхБумаг.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовОпераций.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если СтрЧислоВхождений(Перечисление.Значение, ЗначениеПеречисления) = 1 Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовОКАТОИСтран.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если СтрЧислоВхождений(Перечисление.Значение, ЗначениеПеречисления) = 1 Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовЭмитентов.Найти(ТипОбъектаXDTO.Имя) <> Неопределено
		ИЛИ КодыСрокаПогашенияЦеннойБумаги.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если СтрНачинаетсяС(Перечисление.Значение, ЗначениеПеречисления) Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли Перечисление.Значение = ЗначениеПеречисления Тогда
			Возврат Перечисление.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ТекстОшибки = "Не задано перечисление XBRL: " + ТипОбъектаXDTO.Имя + ", значение:" + ЗначениеПеречисления + ", тип значения: " + ТипЗнч(ЗначениеПеречисления);
	
	ИмяПеречисления = ПолучитьИмяПеречисления(ТипОбъектаXDTO.Имя);
	
	Если НЕ ПеречисленияXBRL.Свойство(ИмяПеречисления) Тогда
		Если ТипЗнч(ЗначениеПеречисления) = Тип("Булево") Тогда
			Возврат ?(ЗначениеПеречисления, "DaMember", "NetMember");
		КонецЕсли;
		//не задано перечисление, далее сообщим об этом
		
	ИначеЕсли ПеречисленияXBRL[ИмяПеречисления].Получить("НеПреобразовывать") = "ИСТИНА" Тогда
		Если ТипЗнч(ЗначениеПеречисления) = Тип("Булево") Тогда
			Возврат ?(ЗначениеПеречисления, "DaMember", "NetMember");
		Иначе
			Возврат ЗначениеПеречисления;	
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ПеречисленияXBRL[ИмяПеречисления].Получить(ЗначениеПеречисления)) Тогда
		Возврат ПеречисленияXBRL[ИмяПеречисления].Получить(ЗначениеПеречисления);
		
	ИначеЕсли ЗначениеЗаполнено(ПеречисленияXBRL[ИмяПеречисления].Получить(Строка(ЗначениеПеречисления))) Тогда
		Возврат ПеречисленияXBRL[ИмяПеречисления].Получить(Строка(ЗначениеПеречисления));
		
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	
	Возврат ТипОбъектаXDTO.Фасеты[0].Значение;
	
КонецФункции

//Имена перечислений бывают с привязкой к разделу, хотя значения там одинаковые
//Например enum_Kvalificzirovannost_investoraAxis_SR_0420431_q_r1_p2 И enum_Kvalificzirovannost_investoraAxis_SR_0420431_q_r1_p2_2
//Чтобы все их не описывать, зададим общее начало имени перечисления
Функция ПолучитьИмяПеречисления(ИмяПеречисления)

	ОбщееИмя = Неопределено;
	
	Для Каждого ЭлементПеречисления Из ПеречисленияXBRL Цикл
		Если ИмяПеречисления = ЭлементПеречисления.Ключ Тогда
			Возврат ИмяПеречисления;
			
		ИначеЕсли СтрНачинаетсяС(ИмяПеречисления, ЭлементПеречисления.Ключ) Тогда
			Если ОбщееИмя = Неопределено Тогда
				ОбщееИмя = ЭлементПеречисления.Ключ;
			Иначе
				ВызватьИсключение СтрШаблон("Нарушение уникальности общего имени перечисления %1 и %2", ОбщееИмя, ЭлементПеречисления.Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщееИмя <> Неопределено Тогда
		Возврат ОбщееИмя;
	Иначе
		Возврат ИмяПеречисления;
	КонецЕсли;
	
КонецФункции

Функция ЭтоПримитивныйТип(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Неопределено")
		ИЛИ ТипЗначения = Тип("Null") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьАрхивСВерсиейТаксономии(ВерсияТаксономии) Экспорт
	
	ХранилищеВерсийТаксономииЦБ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_ХранилищеВерсийТаксономии");

	//Распаковка архива со схемами
	Если ХранилищеВерсийТаксономииЦБ.Метаданные().Макеты.Найти("Taxonomy" + ВерсияТаксономии) = Неопределено Тогда
		ВызватьИсключение "Схемы таксономии " + ВерсияТаксономии + " не загружены в хранилище версий таксономии ЦБ!";
	КонецЕсли;
	
	МакетСТаксономией = ХранилищеВерсийТаксономииЦБ.ПолучитьМакет("Taxonomy" + ВерсияТаксономии);
	
	АрхивСхемТаксономии = Новый ЧтениеZipФайла(МакетСТаксономией.ОткрытьПотокДляЧтения());
	
	Возврат АрхивСхемТаксономии;
	
КонецФункции	

#КонецОбласти

#Область СведенияОПроффУчастнике

Функция SR_INFO_ПолучитьДанные(Запрос, Отказ)
	
	ПакетДанных = Новый Структура;
	
	ПередФормированиемОтчетностиXBRL(Ложь);

	SR_INFO_ВыполнитьЗапрос(Запрос, Отказ);
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL("SR_INFO"),,, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

Процедура SR_INFO_ВыполнитьЗапрос(Запрос, Отказ)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКАТО КАК Kod_Okato,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК INN,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК OGRN_OGRNIP,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК PolnFirmNaim,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК SokrNaimNFO,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ФактическийАдрес КАК Pocht_Adres,
		|	&FIOEIO КАК FIOLiczaPodpisOtch,
		|	&Dolzgnostlizapodpotchetnost КАК DolzhDLPodpOtch,
		|	&Osnispobyaz КАК Osnispobyaz,
		|	&FIOEIOkontr КАК FIOEIOkontr,
		|	&Osnispobyazkontr КАК Osnispobyazkontr,
		|	ВЫБОР &ПоказательДеятельностиПУРЦБ
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый)
		|			ТОГДА ""MalMember""
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Средний)
		|			ТОГДА ""SredMember""
		|		КОГДА ЗНАЧЕНИЕ(Перечисление.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Крупный)
		|			ТОГДА ""KrypMember""
		|	КОНЕЦ КАК KategoriyaProfUchastnikaEnumerator
		|ПОМЕСТИТЬ SR_INFO
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|				&НаДату,
		|				ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)
		|					И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|					&НаДату,
		|					Организация = &Организация
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|			ПО ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = ЮрФизЛица.Ссылка)
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	
	
	РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "ФИО, ДолжностьИПодразделение");
	РеквизитыКонтролера   = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Контролер,, "ФИО");
	
	Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);
	Запрос.УстановитьПараметр("НаДату"							, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("FIOEIO"							, РеквизитыРуководителя.ФИО);
	Запрос.УстановитьПараметр("Dolzgnostlizapodpotchetnost"		, РеквизитыРуководителя.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("Osnispobyaz"						, ЭтотОбъект.Руководитель_Основание);
	Запрос.УстановитьПараметр("FIOEIOkontr"						, РеквизитыКонтролера.ФИО);
	Запрос.УстановитьПараметр("Osnispobyazkontr"				, ЭтотОбъект.Контролер_Основание);
	
	Если ЭтотОбъект.ВерсияТаксономии < "3_2" Тогда
		Запрос.УстановитьПараметр("ПоказательДеятельностиПУРЦБ", "");
	ИначеЕсли ЭтотОбъект.ПериодичностьОтчета = "Годовая" Тогда
		//Для годовой формы исключение, используется показатель на следующйи год
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("Организация",	ЭтотОбъект.Организация);
		ПараметрыРасчета.Вставить("Период",			Новый СтандартныйПериод(ЭтотОбъект.Период.ДатаОкончания + 1, ЭтотОбъект.Период.ДатаОкончания + 1));
		
		Запрос.УстановитьПараметр("ПоказательДеятельностиПУРЦБ", РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьКатегориюПрофУчастника(ПараметрыРасчета, Отказ));
	Иначе
		Запрос.УстановитьПараметр("ПоказательДеятельностиПУРЦБ", РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьКатегориюПрофУчастника(ЭтотОбъект, Отказ));
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры	

Функция SR_SVED_OTCH_ORG_ПолучитьДанные(Запрос, Отказ)
	
	ПакетДанных = Новый Структура;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Если НачалоДня(ЭтотОбъект.Период.ДатаНачала) = НачалоДня(ЭтотОбъект.Период.ДатаОкончания) Тогда //нерегулярная
		Запрос.УстановитьПараметр("ДатаНачала"				, ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ДатаОкончания"			, ЭтотОбъект.Период.ДатаОкончания);
		
	ИначеЕсли СопроводительнаяИнформацияВыгружаетсяНаПоследнийРабочийДень(Отказ) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", 	ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
		
	Иначе
		Запрос.УстановитьПараметр("ДатаНачала"				, НачалоМесяца(ЭтотОбъект.Период.ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания"			, КонецМесяца(ЭтотОбъект.Период.ДатаОкончания));
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Руководитель"					, ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);	
	
	МассивТекстовЗапросов = Новый Массив;
	
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, "sr_sved_otch_org_podpisant");
	
	МассивТекстовЗапросов.Добавить(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаНачала КАК Date_From,
		|	&ДатаОкончания КАК Date_To,
		|	&Руководитель КАК FIOLiczaPodpisOtch 
		|ПОМЕСТИТЬ sr_sved_otch_org_podpisant");
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос, "sr_sved_otch_org_uk");
	
	МассивТекстовЗапросов.Добавить(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаНачала КАК Date_From,
		|	&ДатаОкончания КАК Date_To,
		|	Организации.ЮрФизЛицо КАК FaktAdr,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК PolnNaim,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК OGRN,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК INN,
		|	СтатусыЛицензийСрезПоследних.Лицензия.Серия + СтатусыЛицензийСрезПоследних.Лицензия.Номер КАК NomerLiczenzii,
		|	СтатусыЛицензийСрезПоследних.Лицензия.ДатаВыдачи КАК DataPredostavlLiczUpravlKompNaOsushSootvetstvDeyat,
		|	""UpravlKompMember"" КАК VidOrgAxis,
		|   ""Собственная разработка"" КАК PONaKotPodgotovPaketOtch
		|ПОМЕСТИТЬ sr_sved_otch_org_uk
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|				&ДатаОкончания,
		|				ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)
		|					И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛицоГоловнойОрганизации
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = ЮрФизЛицоГоловнойОрганизации.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ЮрФизЛицоГоловнойОрганизации.Ссылка = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&ДатаОкончания, Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)) КАК СтатусыЛицензийСрезПоследних
		|		ПО (ЮрФизЛицоГоловнойОрганизации.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо)
		|			И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|ГДЕ
		|	Организации.Ссылка = &Организация");
	
	Если МассивТекстовЗапросов.Количество() Тогда
		Запрос.Текст = СтрСоединить(МассивТекстовЗапросов, Символы.ПС + ";" + Символы.ПС);
		Запрос.Выполнить();
	КонецЕсли;

	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL("sr_sved_otch_org"),,, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета = Ложь, Отказ, ДополнительныеПакеты = Неопределено)
	
	РеквизитыОрганизации	= РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания, "Телефоны");
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО, ДолжностьИПодразделение");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("LiczoOtvZaPrOblast",        РеквизитыОтветственного.ФИО);
	Запрос.УстановитьПараметр("DolzhLiczaOtvZaPrOblast",   РеквизитыОтветственного.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("KontInfLiczaOtvZaPrOblast", РеквизитыОрганизации.Телефоны);

	Ответственный = ЭтотОбъект.Ответственный;
	Если СтрНайти(ВРег(Ответственный), "СУСЛОВ") И СтрНайти("ОКУД0420432,ОКУД0420523", ИмяПакета) > 0 Тогда

		Запрос.УстановитьПараметр("AdrElPochtLiczSostOtch", "suslov@region.ru");
		
	Иначе	

		Запрос.УстановитьПараметр("AdrElPochtLiczSostOtch", ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Ответственный, 
									Новый Структура("АдресЭлектроннойПочты", "Пользователь.АдресЭлектроннойПочты")).АдресЭлектроннойПочты);
		
	КонецЕсли;
															
#Область ИменаПакетов
	ИменаПакетов = Новый ТаблицаЗначений;
	ИменаПакетов.Колонки.Добавить("PrOblastOtcetnostiTaxis",			Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ИменаПакетов.Колонки.Добавить("OKUDAxis",							Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ИменаПакетов.Колонки.Добавить("ПризнакНулевогоОтчета",				Новый ОписаниеТипов("Булево"));
	
	СтрокаИменаПакетов = ИменаПакетов.Добавить();
	СтрокаИменаПакетов.PrOblastOtcetnostiTaxis			= "Показатели формы " + СтрЗаменить(ИмяПакета, "ОКУД", "");
	СтрокаИменаПакетов.OKUDAxis							= СтрЗаменить(ИмяПакета, "ОКУД", "OKUD") + "Member";
	СтрокаИменаПакетов.ПризнакНулевогоОтчета			= ПризнакНулевогоОтчета;
	
	// Добавлено для отчета "Сведения о количестве владельцев инвестиционных паев паевого инвестиционного фонда и количестве принадлежащих им инвестиционных паев, учитываемых на индивидуальных инвестиционных счетах"
	ЗаменитьДанныеДляОтчетовОтсутствующихВОКУД(СтрокаИменаПакетов, ПризнакНулевогоОтчета); 
	
	Если ДополнительныеПакеты <> Неопределено Тогда
		Для Каждого ДопПакет Из ДополнительныеПакеты Цикл
			СтрокаИменаПакетов = ИменаПакетов.Добавить();
			СтрокаИменаПакетов.PrOblastOtcetnostiTaxis			= "Показатели формы " + СтрЗаменить(ДопПакет.Ключ, "ОКУД", "");
			СтрокаИменаПакетов.OKUDAxis							= СтрЗаменить(ДопПакет.Ключ, "ОКУД", "OKUD") + "Member";
			СтрокаИменаПакетов.ПризнакНулевогоОтчета			= ДопПакет.Значение;
		КонецЦикла;
	КонецЕсли;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ИменаПакетов, "_ИменаПакетов", Запрос);
#КонецОбласти	
	
	Если СтрНачинаетсяС(ИмяПакета, "ОКУД04204") Тогда
	
		Запрос.УстановитьПараметр("NaimITrazrabotchika"			, "Собственная разработка");
		Запрос.УстановитьПараметр("ВерсияТаксономии"			, ВерсияТаксономии);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ИменаПакетов.PrOblastOtcetnostiTaxis КАК PrOblastOtcetnostiTaxis,
			|	_ИменаПакетов.OKUDAxis КАК OKUDAxis,
			|	&LiczoOtvZaPrOblast КАК FIOLiczaOtvZaPrOblast,
			|	&DolzhLiczaOtvZaPrOblast КАК Dolzhnost,
			|	&KontInfLiczaOtvZaPrOblast КАК Telefon,
			|	&NaimITrazrabotchika КАК PONaKotPodgotovPaketOtch,
			|	ВЫБОР
			|		КОГДА _ИменаПакетов.ПризнакНулевогоОтчета
			|				И &ВерсияТаксономии <= ""3_2""
			|			ТОГДА ""DaMember""
			|		КОГДА _ИменаПакетов.ПризнакНулевогоОтчета
			|			ТОГДА ""ZnachPokOtsMember""
			|	КОНЕЦ КАК PriznakNulevogoOtchetaEnumerator,
			|   &AdrElPochtLiczSostOtch КАК AdrElPochtLiczSostOtch
			|ПОМЕСТИТЬ SR_Sved_ObOtchOrg_OtvLicza
			|ИЗ
			|	_ИменаПакетов КАК _ИменаПакетов";
		
		Запрос.Выполнить();
		
		ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL("SR_Sved_ObOtchOrg_OtvLicza"),,, Отказ);
	
	ИначеЕсли СтрНачинаетсяС(ИмяПакета, "ОКУД04205") Или ИмяПакета = "ВладельцыИИСвПИФ" Тогда 	
		
		//Для нерегулярной и ежедневной отчётности Дата сведений конец периода, для остальных конец месяца.
		СведенияНаКонецПериода = (ЭтотОбъект.ПериодичностьОтчета = "Нерегулярная" ИЛИ ЭтотОбъект.ПериодичностьОтчета = "ПоЗапросу");
		
		Запрос.УстановитьПараметр("ДатаНачала"					, ?(СведенияНаКонецПериода,  ЭтотОбъект.Период.ДатаОкончания, КонецМесяца(ЭтотОбъект.Период.ДатаОкончания)));
		Запрос.УстановитьПараметр("ДатаОкончания"				, ?(СведенияНаКонецПериода,  ЭтотОбъект.Период.ДатаОкончания, КонецМесяца(ЭтотОбъект.Период.ДатаОкончания)));
		
		Если СопроводительнаяИнформацияВыгружаетсяНаПоследнийРабочийДень(Отказ) Тогда
			Запрос.УстановитьПараметр("ДатаНачала", 	ЭтотОбъект.Период.ДатаОкончания);
			Запрос.УстановитьПараметр("ДатаОкончания",	ЭтотОбъект.Период.ДатаОкончания);
		КонецЕсли;			
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ДатаНачала КАК Date_From,
			|	&ДатаОкончания КАК Date_To,
			|	_ИменаПакетов.PrOblastOtcetnostiTaxis КАК PrOblastOtcetnostiTaxis,
			|	&LiczoOtvZaPrOblast КАК FIOLiczaOtvZaPrOblast,
			|	&DolzhLiczaOtvZaPrOblast КАК Dolzhnost,
			|	&KontInfLiczaOtvZaPrOblast КАК Telefon,
			|   &AdrElPochtLiczSostOtch КАК AdrElPochtLiczSostOtch
			|ПОМЕСТИТЬ sr_sved_otch_org_otv_predm_obl
			|ИЗ
			|	_ИменаПакетов КАК _ИменаПакетов
			|ГДЕ
			|	(_ИменаПакетов.ПризнакНулевогоОтчета = ЛОЖЬ
			|			ИЛИ _ИменаПакетов.OKUDAxis = ""SvedOKolVldInvPaiPIFuchitIIS"")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ДатаНачала КАК Date_From,
			|	&ДатаОкончания КАК Date_To,
			|	_ИменаПакетов.OKUDAxis КАК ID_strokiTaxis,
			|	_ИменаПакетов.OKUDAxis КАК OKUDEnumerator,
			|	ВЫБОР
			|		КОГДА _ИменаПакетов.ПризнакНулевогоОтчета
			|			ТОГДА ""ZnachPokOtsMember""
			|	КОНЕЦ КАК OtsutstvDannyxEnumerator
			|ПОМЕСТИТЬ sr_sved_otch_org_inf_ob_otch
			|ИЗ
			|	_ИменаПакетов КАК _ИменаПакетов
			|ГДЕ
			|	_ИменаПакетов.ПризнакНулевогоОтчета = ИСТИНА";
		
		Запрос.Выполнить();
		
		ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL("sr_sved_otch_org_otv_predm_obl"),,, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаменитьДанныеДляОтчетовОтсутствующихВОКУД(СтрокаИменаПакетов, ПризнакНулевогоОтчета)
	
	Если ИмяПакета = "ВладельцыИИСвПИФ" Тогда
		СтрокаИменаПакетов.OKUDAxis				   = "SvedOKolVldInvPaiPIFuchitIIS";
		СтрокаИменаПакетов.PrOblastOtcetnostiTaxis = "Показатели формы SvedOKolVldInvPaiPIFuchitIIS";
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область Общие

// Проверяет наличие лицензий в счётах ду и заполняет ресурсы XBRL
// 
// Параметры:
//	ПроверятьЛицензии	- Булево	- Истина, проверяет наличие лицензий, Ложь - не проверяет, Ложь использовать только если отчёт не использует счета ДУ или отчёт сам обращается к Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц
//
Процедура ПередФормированиемОтчетностиXBRL(ПроверятьЛицензии)
	
	Если ПроверятьЛицензии Тогда
		
		ВидыДеятельности = Новый Массив;
		ВидыДеятельности.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ);
		ВидыДеятельности.Добавить(Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами);
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

		Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
			Запрос.МенеджерВременныхТаблиц,
			ЭтотОбъект.Период,
			Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, ВидыДеятельности)); 

	КонецЕсли;
	
	РесурсыXBRL = ПолучитьТаблицуИзМакета("РесурсыXBRL", ИмяПакета,, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии), "ИмяТаблицы Убыв");
	
КонецПроцедуры

#КонецОбласти

// Сведения о количестве владельцев инвестиционных паев паевого инвестиционного фонда и количестве принадлежащих им инвестиционных паев, учитываемых на индивидуальных инвестиционных счетах
#Область ВладельцыИИСвПИФ

Функция ПолучитьДанные_XBRL_ВладельцыИИСвПИФ(Отказ)

	ИмяПакета = "ВладельцыИИСвПИФ";
	ПризнакНулевогоОтчета = Истина;
	
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Истина);
	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции	

#КонецОбласти

//Отчетность об операциях с денежными средствами
#Область ОКУД0420011

Функция ОКУД0420011_XBRL_ПолучитьДанные(Запрос, Отказ) Экспорт

	ИмяПакета = "ОКУД0420011";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Истина);
	
	ОКУД0420011_XBRL_ПолучитьДанные_ВыполнитьЗапрос(Запрос);
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),,, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ОКУД0420011_XBRL_ПолучитьДанные_ВыполнитьЗапрос(Запрос)
	
	РеквизитыРуководителя	= РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "ФИО, ДолжностьИПодразделение");	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО, ДолжностьИПодразделение");	
	
	Запрос.УстановитьПараметр("ВознагражденияУК"				, ЭтотОбъект.ВознагражденияУК.Выгрузить());
	Запрос.УстановитьПараметр("КодВознагражденияУКПоЛицензииДУ"	, ОКУД0420011_КодВознагражденияУКПоЛицензииДУ());
	Запрос.УстановитьПараметр("ТаблицаБанк"						, ОКУД0420011_XBRL_ПолучитьДанные_ТаблицаБанк());
	Запрос.УстановитьПараметр("ТаблицаКасса"					, ОКУД0420011_XBRL_ПолучитьДанные_ТаблицаКасса());
	Запрос.УстановитьПараметр("ДатаНачала"						, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"					, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаОтчетности"					, ЭтотОбъект.ДатаОтчетности);
	Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);	
	Запрос.УстановитьПараметр("ПериодОтчета"					, НРег(Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ='ММММ гггг'"))); 	
	Запрос.УстановитьПараметр("Руководитель"					, РеквизитыРуководителя.ФИО);
	Запрос.УстановитьПараметр("ДолжностьРуководителя"			, РеквизитыРуководителя.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("Ответственный"					, РеквизитыОтветственного.ФИО);
	Запрос.УстановитьПараметр("ДолжностьОтветственный"			, РеквизитыОтветственного.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("ПризнакНулевогоОтчёта"			, "");
	Запрос.УстановитьПараметр("ВерсияТаксономии"				, ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ВыводитьПолноеНаименованиеБанка"	, ЭтотОбъект.Период.ДатаОкончания >= Дата(2022,5,1));
	Запрос.УстановитьПараметр("ЭтоРПИ"				,             ЭтотОбъект.ЭтоРПИ);
	
	Запрос.Текст = ОКУД0420011_XBRL_ПолучитьТекстЗапроса();
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ОКУД0420011_XBRL_ПолучитьДанные_ТаблицаБанк()

	СтрокиОпераций = Новый Структура;
	СтрокиОпераций.Вставить("Строка_РезидентыЮЛ"	, "Operaczii_Rezident_YULMember");
	СтрокиОпераций.Вставить("Строка_РезидентыИП"	, "Operaczii_Rezident_IPMember");
	СтрокиОпераций.Вставить("Строка_РезидентыФЛ"	, "Operaczii_Rezident_FLMember");
	СтрокиОпераций.Вставить("Строка_НерезидентыЮЛ"	, "Operaczii_NeRezident_YULMember");
	СтрокиОпераций.Вставить("Строка_НерезидентыФЛ"	, "Operaczii_NeRezident_FLMember");
	СтрокиОпераций.Вставить("СтрокаНеустановленныеЛ", "Operaczii_NeustLiczaMember");
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("РегистрНомер"		,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("НомерЛицензии"		,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("НаименованиеБанка"	,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("НомерСчета"		,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Данные.Колонки.Добавить("ДатаОперации"		,   Новый ОписаниеТипов("Дата"));
	Данные.Колонки.Добавить("НомерДоговора"		,   Метаданные.Справочники.СчетаДоверительногоУправления.Реквизиты.НомерДоговора.Тип);
	Данные.Колонки.Добавить("ДатаДоговора"		,   Новый ОписаниеТипов("Дата"));
	Данные.Колонки.Добавить("Валюта"			,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));
	Данные.Колонки.Добавить("СтрокаОперации"	,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("КодОперации"		,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
	Данные.Колонки.Добавить("ОКСМ"				,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));
	Данные.Колонки.Добавить("SWIFT"				,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(11)));
	Данные.Колонки.Добавить("БанкКорреспондент"	,   Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("КодСтраныРегистрации", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));
	Данные.Колонки.Добавить("Списание"			,   Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Зачисление"		,   Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("ОстатокНаНачало"	,   Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("ОстатокНаКонец"	,   Новый ОписаниеТипов("Число"));
	
	МассивСтрок = ПолучитьДанныеИзВременногоХранилища("РегистрПоБанкам", Новый Массив);

	Для Каждого СтрокаДанных Из МассивСтрок Цикл
		НоваяСтрокаДанных = Данные.Добавить();
		НоваяСтрокаДанных.СтрокаОперации = СтрокиОпераций[СтрокаДанных.СтрокаОперации];
		НоваяСтрокаДанных.НомерЛицензии  = СтрокаДанных.РегистрНомер;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДанных, СтрокаДанных,, "СтрокаОперации");
		
		Для НомерСимвола = 1 По 4 Цикл
			КодСмв = КодСимвола(НоваяСтрокаДанных.РегистрНомер, НомерСимвола);
			Если КодСмв < 48 или КодСмв > 57 Тогда //это число
				НомерСимвола = НомерСимвола - 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		НоваяСтрокаДанных.РегистрНомер = Прав("0000" + Лев(НоваяСтрокаДанных.РегистрНомер, Мин(НомерСимвола, 4)), 4);
						
		Если Найти(СтрокаДанных.РегистрНомер, "/") > 0 Тогда			
			НомерФилиала = Сред(СтрокаДанных.РегистрНомер, Найти(СтрокаДанных.РегистрНомер, "/") + 1);			
			НомерФилиала = Прав("0000" + НомерФилиала, 4);			
			НоваяСтрокаДанных.РегистрНомер = НоваяСтрокаДанных.РегистрНомер + "/" + НомерФилиала;
		КонецЕсли;		
		
	КонецЦикла;
	
	Данные.Свернуть("РегистрНомер,НомерЛицензии,НаименованиеБанка,НомерСчета,ДатаОперации,НомерДоговора,ДатаДоговора,Валюта,СтрокаОперации,КодОперации,ОКСМ,БанкКорреспондент,SWIFT,КодСтраныРегистрации", "Списание,Зачисление,ОстатокНаНачало,ОстатокНаКонец");
	
	Возврат Данные;
	
КонецФункции

Функция ОКУД0420011_XBRL_ПолучитьДанные_ТаблицаКасса()

	СтрокиОпераций = Новый Структура;
	СтрокиОпераций.Вставить("Строка_ОперСРезЮЛ"			, "Operaczii_Rezident_YULMember");
	СтрокиОпераций.Вставить("Строка_ОперСРезИП2"		, "Operaczii_Rezident_IPMember");
	СтрокиОпераций.Вставить("Строка_ОперСРезФЛРез2"		, "Operaczii_Rezident_FLMember");
	СтрокиОпераций.Вставить("Строка_ОперСРезЮЛНерез2"	, "Operaczii_NeRezident_YULMember");
	СтрокиОпераций.Вставить("Строка_ОперСРезФЛНерез2"	, "Operaczii_NeRezident_FLMember");
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("СтрокаОперации"	, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	Данные.Колонки.Добавить("КодОперации"		, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
	Данные.Колонки.Добавить("ОКСМ"				, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(3)));
	Данные.Колонки.Добавить("Списание"			, Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Зачисление"		, Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("ОстатокНаНачало"	, Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("ОстатокНаКонец"	, Новый ОписаниеТипов("Число"));
	
	МассивСтрок = ПолучитьДанныеИзВременногоХранилища("РегистрПоКассам", Новый Массив);

	Для Каждого СтрокаДанных Из МассивСтрок Цикл
		НоваяСтрокаДанных = Данные.Добавить();
		
		Если ЗначениеЗаполнено(СтрокаДанных.СтрокаОперации) Тогда
			НоваяСтрокаДанных.СтрокаОперации = СтрокиОпераций[СтрокаДанных.СтрокаОперации];
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДанных, СтрокаДанных,, "СтрокаОперации");
	КонецЦикла;
	
	Данные.Свернуть("СтрокаОперации,КодОперации,ОКСМ", "Списание,Зачисление,ОстатокНаНачало,ОстатокНаКонец");
	
	Возврат Данные;
	
КонецФункции

Функция ОКУД0420011_XBRL_ПолучитьТекстЗапроса()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизацииНаРусском.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыОрганизацииНаРусском.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыОрганизацииНаРусском.ИНН КАК ИНН,
		|	РеквизитыОрганизацииНаРусском.ОГРН КАК ОГРН,
		|	РеквизитыОрганизацииНаРусском.ПочтовыйАдрес КАК ПочтовыйАдрес,
		|	РеквизитыОрганизацииНаРусском.EMail КАК EMail,
		|	РеквизитыОрганизацииНаРусском.Телефоны КАК Телефоны
