//Сведения о показателях операционной надежности управляющей компании и применяемых ею информационных технологиях
#Область ОКУД0420523_XBRL

Функция ОКУД0420523_XBRL_ПолучитьДанные(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420523";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ОКУД0420432_XBRL_ВыполнитьЗапросы(Запрос, Отказ);	
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПризнакНулевогоОтчета = Истина;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

#КонецОбласти

//Сведения о доходности инвестирования средств пенсионных накоплений 
#Область ОКУД0420526_XBRL

Функция ОКУД0420526_ПолучитьДанные_XBRL(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420526";
	ПакетДанных = Новый Структура;
	ПризнакНулевогоОтчета = Истина;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ОКУД0420526_ВыполнитьЗапрос(Запрос, Отказ);
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;	
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ОКУД0420526_ВыполнитьЗапрос(Запрос, Отказ)
	
	РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "ФИО, ДолжностьИПодразделение");	
	
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления );
	Запрос.УстановитьПараметр("ДатаОкончания",					ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.УстановитьПараметр("Руководитель",					РеквизитыРуководителя.ФИО);
	Запрос.УстановитьПараметр("ДолжностьРуководителя",			РеквизитыРуководителя.ДолжностьИПодразделение);

	Запрос.УстановитьПараметр("ЭтоРЭМ",					        ЭтотОбъект.ЭтоРЭМ);

	Запрос.Текст = ОКУД0420526_ПолучитьТекстЗапроса();
	Запрос.Выполнить();
	
	ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ);	
	
КонецПроцедуры

Функция ОКУД0420526_ПолучитьТекстЗапроса()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ФинансовыеПоказатели.ВидПоказателя КАК ВидПоказателя,
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ПОМЕСТИТЬ _Показатели
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО ФинансовыеПоказатели.СубъектАналитики = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ФинансовыеПоказатели.Организация = &Организация
