	Счета.Добавить(Бухгалтерия.ПланыСчетов.БНФОБанковский.НайтиПоКоду("30425").Ссылка);
	Счета.Добавить(Бухгалтерия.ПланыСчетов.БНФОБанковский.НайтиПоКоду("30427").Ссылка);
	Счета.Добавить(Бухгалтерия.ПланыСчетов.БНФОБанковский.НайтиПоКоду("30602").Ссылка);
	
	Запрос.УстановитьПараметр("ДатаНачала"			, НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания"		, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"			, РаботаСВнешнимиСистемами.ПолучитьОрганизациюБухгалтерии(Бухгалтерия, ЭтотОбъект.Организация));
	Запрос.УстановитьПараметр("ПустоеЗначение"		, ЭтотОбъект.ПустоеЗначение);
	Запрос.УстановитьПараметр("Субконто"			, Бухгалтерия.ПланыВидовХарактеристик.БНФОВидыСубконтоБанковские.БанковскиеСчета);
	Запрос.УстановитьПараметр("Счета"				, Счета);
	Запрос.УстановитьПараметр("ВключатьТранзитныеВалютныеСчета"	, Дата(2020,8,1) > ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ВозможностьИспользованияСобственныхДенежныхСредств", ОКУД0420409_ПолучитьВозможностьИспользованияСобственныхДенежныхСредств());
	
	Если ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		Запрос.УстановитьПараметр("ДатаКурсаВалютНаНачало", ЭтотОбъект.Период.ДатаНачала - 86400);
	Иначе	
		Запрос.УстановитьПараметр("ДатаКурсаВалютНаНачало", ЭтотОбъект.Период.ДатаНачала);
	КонецЕсли;

	Запрос.Выполнить();

	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции

