Процедура ЗаполнитьРасшифровку_ОКУД0420501(Результат, Отказ) Экспорт
	
	Результат.Очистить();
	Макет = ПолучитьМакет("ОКУД0420501_Расшифровка");
	
	Результат.Вывести(Макет.ПолучитьОбласть("Шапка"));
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала"				, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ГраницаОкончания"		, Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень"	, Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"				, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("БалансоваяСтоимость77"	, ЭтотОбъект.БалансоваяСтоимость.Выгрузить());
	Запрос.УстановитьПараметр("ВознагражденияУК"		, ЭтотОбъект.ВознагражденияУК.Выгрузить());
	Запрос.УстановитьПараметр("ВерсияТаксономии"		, ЭтотОбъект.ВерсияТаксономии);	
	Запрос.УстановитьПараметр("КодВознагражденияУКПоЛицензииДУ"	, ОКУД0420011_КодВознагражденияУКПоЛицензииДУ());

	ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос, "ЕдиныйБухгалтерскийУчет", Ложь);
	ПоместитьБалансовуюСтоимостьВМенеджерВременныхТаблиц(Запрос, "БухгалтерскийУчет", 		Ложь);
	
	Запрос.Текст = ЗаполнитьРасшифровку_ОКУД0420501_ПолучитьТекстЗапроса();
	Данные = Запрос.Выполнить().Выгрузить();  
	
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "1", "Совокупная стоимость чистых активов паевых инвестиционных фондов, указанных в разделе V отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "2", "Совокупный размер ипотечных покрытий, указанных в разделе VI отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "3", "Совокупная стоимость чистых активов акционерных инвестиционных фондов, указанных в разделе VII отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "4", "Совокупная стоимость чистых активов, в которые инвестированы средства пенсионных накоплений, инвестирование которых осуществляет управляющая компания на основании договоров, указанных в разделе VIII отчета  ПФР");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "5", "Совокупная стоимость чистых активов, в которые инвестированы средства пенсионных накоплений, инвестирование которых осуществляет управляющая компания на основании договоров, указанных в разделе IX отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "6", "Совокупная рыночная стоимость пенсионных резервов негосударственных пенсионных фондов, размещение которых осуществляет управляющая компания на основании договоров, указанных в разделе IX отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "7", "Совокупная стоимость чистых активов, в которые инвестированы накопления для жилищного обеспечения военнослужащих, доверительное управление которыми осуществляет управляющая компания на основании договоров, указанных в разделе X отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "8", "Совокупный размер собственных средств (капитала) и страховых резервов страховщиков, инвестирование которых осуществляет управляющая компания на основании договоров, указанных в разделе XI отчета");
	ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "9", "Совокупный размер инвестиционных портфелей, доверительное управление которыми осуществляет управляющая компания на основании договоров, указанных в разделе XII отчета  СРО И ФОГФ");
	
	Если ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		ЗаполнитьРасшифровку_ОКУД0420501_ВывестиПоказатель(Результат, Макет, Данные, "10", "Вознаграждение управляющего по договорам доверительного управления ценными бумагами");
	КонецЕсли;
	
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	ОбластьИтог.Параметры.СтомостьАктивов				= Данные.Итог("СтомостьАктивов");
	ОбластьИтог.Параметры.ВознаграждениеУправляющего	= Данные.Итог("ВознаграждениеУправляющего");
	ОбластьИтог.Параметры.РСА							= Данные.Итог("РСА");
	Результат.Вывести(ОбластьИтог);
	                                  	
КонецПроцедуры

Функция ЗаполнитьРасшифровку_ОКУД0420501_ПолучитьТекстЗапроса()

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	МАКСИМУМ(НАЧАЛОПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ)) КАК ДатаСЧА,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	МАКСИМУМ(ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)) КАК ЛицензияПИФНПФ
		|ПОМЕСТИТЬ ВТ_СчетаДоверительногоУправления
		|ИЗ
		|	_Клиенты КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК ЛицензииДоговоровДоверительногоУправления
		|		ПО СчетаДоверительногоУправления.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
		|			И (ЛицензииДоговоровДоверительногоУправления.Действует)
