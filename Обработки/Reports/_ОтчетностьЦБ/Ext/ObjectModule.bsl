		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
			Запрос.МенеджерВременныхТаблиц,
			ДатаОтчета,
			Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)); 
		
		Запрос.УстановитьПараметр("Период"							, КонецДня(ДатаОтчета));
		Запрос.УстановитьПараметр("ГраницаОкончания"				, Новый Граница(КонецДня(ДатаОтчета), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ДатаОкончания"					, КонецДня(ДатаОтчета));
		Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ДепозитарныеКомпании"			, ДепозитарныеКомпании);
		Запрос.УстановитьПараметр("ДепозитарныеКомпанииКоличество"	, ДепозитарныеКомпании.Количество());
		Запрос.УстановитьПараметр("ЦенныеБумаги"					, ЦенныеБумаги);
		Запрос.УстановитьПараметр("ЦенныеБумагиКоличество"			, ?(ДанныеЦБ.Количество() = 0, ЦенныеБумаги.Количество(), 0));
		
		
		Запрос.Текст = ПолучитьТекстЗапроса_РеквизитыЮрФизЛиц_ОКУД0420415_XBRL() + ";" + Символы.ПС + ПолучитьТекстЗапроса_Расшифровка_ОКУД0420415_XBRL();
		
		ДанныеЗапроса = Запрос.Выполнить().Выгрузить();
		
		ЭтотОбъект.Период.ДатаОкончания = ДатаОтчета;
		
		СверкаИННиОГРН(ДанныеЗапроса, "ЮрФизЛицоЭмитента", "ИННЭмитента", "", "", "НаименованиеЭмитента",, Ложь);
		СверкаИННиОГРН(ДанныеЗапроса, "ЮрФизЛицоДепозитария", "ИННДепозитария", "", "", "НаименованиеДепозитария",, Ложь);
		
		Если Данные = Неопределено Тогда
			Данные = ДанныеЗапроса.Скопировать();
		Иначе
			Для Каждого СтрокаЗапроса Из ДанныеЗапроса Цикл
				ЗаполнитьЗначенияСвойств(Данные.Добавить(), СтрокаЗапроса);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ЗначениеЗаполнено(СтрокаДанных.ПолноеНаименованиеПИФ) Тогда
			СтрокаДанных.НаименованиеЭмитента = СтрокаДанных.НаименованиеЭмитента + " (" + СтрокаДанных.ПолноеНаименованиеПИФ + ")";
		КонецЕсли;
	КонецЦикла;	
	
	ВывестиПредупреждение = Ложь;
	
	НП = 0;
	
	Если ДанныеЦБ.Количество() > 0 Тогда
		Для Каждого СтрокаЦБ Из ДанныеЦБ Цикл
			
			ПараметрыПоиска = Новый Структура;
			Если ЗначениеЗаполнено(СтрокаЦБ.ГосударственныйРегистрационныйНомер) Тогда
				ПараметрыПоиска.Вставить("ГосударственныйРегистрационныйНомер");
			ИначеЕсли ЗначениеЗаполнено(СтрокаЦБ.ISIN) Тогда
				ПараметрыПоиска.Вставить("ISIN");
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтрокаЦБ);
			
			НайденныеСтроки = Данные.НайтиСтроки(ПараметрыПоиска);
			Если НайденныеСтроки.Количество() = 0 Тогда
				ПолучитьДанные_XBRL_ОКУД0420415_Расшифровка_ВывестиСтроку(Результат, ОбластьСтрока, СтрокаЦБ, НП);
				Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, Результат.ШиринаТаблицы).ЦветТекста = Новый Цвет(255, 0, 0);
				ВывестиПредупреждение = Истина;
				
			Иначе
				Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
					ПолучитьДанные_XBRL_ОКУД0420415_Расшифровка_ВывестиСтроку(Результат, ОбластьСтрока, СтрокаДанных, НП);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Данные.Сортировать("ГосударственныйРегистрационныйНомер,ЮрФизЛицоДепозитария");
		
		Для Каждого СтрокаДанных Из Данные Цикл
			ПолучитьДанные_XBRL_ОКУД0420415_Расшифровка_ВывестиСтроку(Результат, ОбластьСтрока, СтрокаДанных, НП);
		КонецЦикла;
	КонецЕсли;
	
	Если ВывестиПредупреждение Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле ЦБ есть ценные бумаги отсутствующие на счетах депо!");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьДанные_XBRL_ОКУД0420415_Расшифровка_ВывестиСтроку(Результат, ОбластьСтрока, СтрокаДанных, НП)
	
	НП = НП + 1;
	ОбластьСтрока.Параметры.НП = НП;
	ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
	
	Результат.Вывести(ОбластьСтрока);
	
КонецПроцедуры

Функция ОКУД0420415_ПолучитьОписаниеТипов_ID_CzennojBumagiTaxis()
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.Типы() Цикл
		МассивТипов.Добавить(Тип);
	КонецЦикла;	
	
	Возврат Новый ОписаниеТипов(МассивТипов, Новый КвалификаторыСтроки(255));
	
КонецФункции

#КонецОбласти

//СВЕДЕНИЯ О ВЛОЖЕНИЯХ В ВЫПУЩЕННЫЕ НЕРЕЗИДЕНТАМИ ЦЕННЫЕ БУМАГИ (ПОРТФЕЛЬНЫЕ ИНВЕСТИЦИИ)
#Область ОКУД0420416

Функция ПолучитьДанные_ОКУД0420416_Удалить(Запрос, Отказ) Экспорт
	
	ПакетДанных = Новый Структура;
	
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420416_" + ВерсияАнкеты);
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420416_" + ВерсияАнкеты + "_ОКУД0420416_" + ВерсияАнкеты);
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить(ВерсияАнкеты, "_", "."));
	
	Если ВерсияАнкеты = "2_16_3_3" Тогда
		ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420416_2_16_3_1");
		ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420416_2_16_3_1_ОКУД0420416");
		ПакетДанных.Вставить("ВерсияОтчета"			, "2.16.3.1");
	КонецЕсли;
	
	ПакетДанных.Вставить("Отчет"				, Новый Структура);
	
	ПакетОтчетность = Новый Структура;
	ПакетОтчетность.Вставить("ПризнакНулПоказат", ЭтотОбъект.ПустоеЗначение);
	ПакетОтчетность.Вставить("ДатаПредставления", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy-MM-dd"));
	
	ЗаполнитьПустымиЗначениями = Новый Массив;
	ЗаполнитьПустымиЗначениями.Добавить("ЗаполнитьПустымиЗначениями");
	
	КалендарьКотировок		= ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок");
	ПоследнийРабочийДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, ЭтотОбъект.Период.ДатаОкончания);
	
	РаботаСОтчетностьюЦБ.ЗаполнитьТаблицуКодыКлиентовПоОКАТО(ЭтотОбъект, Запрос.МенеджерВременныхТаблиц);
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц,
		ЭтотОбъект.Период.ДатаОкончания,
		Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)); 
	
	Запрос.УстановитьПараметр("ДатаОкончания"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"				, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПустоеЗначение"			, ЭтотОбъект.ПустоеЗначение);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень"	, ПоследнийРабочийДень);
	Запрос.УстановитьПараметр("Минус90ТорговыхДней"		, Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, ПоследнийРабочийДень, -90));
	Запрос.УстановитьПараметр("ММВБ"					, ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));		
	Запрос.УстановитьПараметр("Bloomberg"				, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));
	Запрос.УстановитьПараметр("Режим_BVAL"				, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ДатаОтключенияBloomberg" , Дата(2022, 4, 1));		
	Запрос.УстановитьПараметр("ТаблицаISIN"				, ОКУД0420416_ПолучитьТаблицуISIN());
	Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);
	
	Запрос.УстановитьПараметр("ДатаИсправленияКотировокПоМетодике", Дата(2021,1,1));
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420416();
	
	Запрос.Выполнить();
	
	ТаблицаКонтроляСекторовЭкономикиЭмитентов = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_ТаблицаКонтроляСекторовЭкономикиЭмитентов", Отказ);
	Для Каждого СтрокаКонтроляСекторовЭкономикиЭмитентов Из ТаблицаКонтроляСекторовЭкономикиЭмитентов Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У эмитента """ + СтрокаКонтроляСекторовЭкономикиЭмитентов.ПолноеНаименованиеЭмитента + """ не указан код сектора экономики!",,,, Отказ);
	КонецЦикла;
	
	ТаблицаКодыСекторовЭкономикиЦБ = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_КодыСекторовЭкономики", Отказ);
	Если НЕ ТаблицаКодыСекторовЭкономикиЦБ.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Из Матрикс не загружен перечень: %1 на %2",
				Справочники.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора,
				Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy")),,,, Отказ);
	КонецЕсли;
	
	ПакетОтчетность.Вставить("Таблица_СведенияОВложениях", Новый Структура);
	
	Если ВерсияАнкеты = "2_16_3_3" Тогда
		ПакетОтчетность.Таблица_СведенияОВложениях.Вставить("Строка_Таб1НомерГрафы"		, ПолучитьДинамическуюСтруктуру("Таб1Стр1Графа%Индекс%", 1, 15)); 
	КонецЕсли;
	
	СобственныеИнвестиции = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_СобственныеИнвестиции", Отказ);
	
	Если СобственныеИнвестиции.Количество() = 0 Тогда
		ПакетОтчетность.Таблица_СведенияОВложениях.Вставить("Строка_СобстИнвест", ЗаполнитьПустымиЗначениями); 
	Иначе
		ФорматныеСтроки = Новый Структура;
		ФорматныеСтроки.Вставить("Кол10_ТабРазд1КоличЦБ"		, "ЧДЦ=6; ЧДЦ=0; ЧРД=.; ЧН=0; ЧГ=0");
		ФорматныеСтроки.Вставить("Кол12_ТабРазд1НоминСтоимость"	, "ЧДЦ=4; ЧРД=,; ЧН=0; ЧГ=0");
		ФорматныеСтроки.Вставить("Кол13_ТабРазд1РыночСтоимость"	, "ЧДЦ=4; ЧРД=,; ЧН=0; ЧГ=0");
		
		ПакетОтчетность.Таблица_СведенияОВложениях.Вставить("Строка_СобстИнвест", СформироватьМассивСтрок(СобственныеИнвестиции, ФорматныеСтроки,, "Строка_СобстИнвест")); 
	КонецЕсли;
	
	ИнвестицииКлиента = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_ИнвестицииКлиента", Отказ);
	Если ИнвестицииКлиента.Количество() = 0 Тогда
		
		ПакетОтчетность.Таблица_СведенияОВложениях.Вставить("Строка_ИнвестКлиентСтроки"	, ЗаполнитьПустымиЗначениями); 
	Иначе
		ФорматныеСтроки = Новый Структура;
		ФорматныеСтроки.Вставить("Кол11_ТабРазд2КоличЦБ"		, "ЧДЦ=6; ЧДЦ=0; ЧРД=.; ЧН=0; ЧГ=0");
		ФорматныеСтроки.Вставить("Кол13_ТабРазд2НоминСтоимость"	, "ЧДЦ=4; ЧРД=,; ЧН=0; ЧГ=0");
		ФорматныеСтроки.Вставить("Кол14_ТабРазд2РыночСтоимость"	, "ЧДЦ=4; ЧРД=,; ЧН=0; ЧГ=0");
		ПакетОтчетность.Таблица_СведенияОВложениях.Вставить("Строка_ИнвестКлиентСтроки"	, СформироватьМассивСтрок(ИнвестицииКлиента, ФорматныеСтроки,, "Строка_ИнвестКлиентСтроки")); 
	КонецЕсли;
	
	ПакетДанных.Отчет.Вставить("Отчетность", ПакетОтчетность);
	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо", ПолучитьСопроводительноеПисьмо("ОКУД0420416"));
	
	Возврат ПакетДанных;

КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420416()
	ТекстЗапроса =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаISIN.ISIN КАК ISIN
		|ПОМЕСТИТЬ _ТаблицаISIN
		|ИЗ
		|	&ТаблицаISIN КАК ТаблицаISIN
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.ЮрФизЛицо КАК ЮрФизЛицо,
		|	КодыКлиентовПоОКАТО.ОКАТО КАК ОКАТО
		|ПОМЕСТИТЬ ВТ_РеквизитыЮрФизЛиц
		|ИЗ
		|	(ВЫБРАТЬ
		|		РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо
		|	ИЗ
		|		РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.РУсский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|	ГДЕ
		|		РеквизитыЮридическихЛицСрезПоследних.РезидентРФ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо
		|	ИЗ
		|		РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
		|	ГДЕ
		|		РеквизитыФизическихЛицСрезПоследних.РезидентПо173ФЗ) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ КодыКлиентовПоОКАТО КАК КодыКлиентовПоОКАТО
		|		ПО ВложенныйЗапрос.ЮрФизЛицо = КодыКлиентовПоОКАТО.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДействующиеСчетаДУ.Ссылка КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ ВТ_ОтборПоСчетамДУ
		|ИЗ
		|	ДействующиеСчетаДУ КАК ДействующиеСчетаДУ
		|ГДЕ
		|	ДействующиеСчетаДУ.Клиент В
		|			(ВЫБРАТЬ
		|				ВТ_РеквизитыЮрФизЛиц.ЮрФизЛицо
		|			ИЗ
		|				ВТ_РеквизитыЮрФизЛиц КАК ВТ_РеквизитыЮрФизЛиц)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПеречниОбъектов.Объект КАК ЮрЛицо,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодСектораЭкономики
		|ПОМЕСТИТЬ _КодыСекторовЭкономики
		|ИЗ
		|	РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
