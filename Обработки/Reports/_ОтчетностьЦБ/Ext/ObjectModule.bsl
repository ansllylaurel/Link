Функция ОпределитьТочностьЧисла(Значение, Настройки)
	
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат Настройки.Точность;
	КонецЕсли;
	
	Если Настройки.ИспользоватьФактическуюТочность Тогда
		
		ДробнаяЧасть = Формат(Значение - Цел(Значение),"ЧРД=,");
		
		Возврат СтрДлина(Прав(ДробнаяЧасть, СтрДлина(ДробнаяЧасть)-2));
		
	Иначе
		Возврат Настройки.Точность;
	КонецЕсли;
	
	
КонецФункции

Функция СериализоватьЗначениеXBRL(СтрокаДанных, Колонка, ИмяТаблицы, ФорматныеСтроки, Отказ)
	
	Значение = СтрокаДанных[Колонка];
	
	Если Найти("Субконто1,Субконто2,Сумма,Период,КодСтроки,АудиторскоеЗаключение,ПолеСортировки", Колонка) > 0 Тогда //таких колонок не может быть в XBRL
		Возврат "";
	ИначеЕсли СтрНачинаетсяС(Колонка, "НеВыгружать_") Тогда//колонка использует в помежуточных расчётах, не выгружается в XBRL
		Возврат "";
	КонецЕсли;	
	
	НайденныеРесурсыXBRL = РесурсыXBRL.НайтиСтроки(Новый Структура("ИмяТаблицы, Колонка", ИмяТаблицы, Колонка));
	Если НЕ НайденныеРесурсыXBRL.Количество() Тогда
		НайденныеРесурсыXBRL = РесурсыXBRL.НайтиСтроки(Новый Структура("Колонка,ИмяТаблицы", Колонка, ""));
	КонецЕсли;
	
	Если НайденныеРесурсыXBRL.Количество() > 1 Тогда
		ВызватьИсключение "Дублирование описания ресурса XBRL:" + Колонка;
	КонецЕсли;
	
	//сериализация значения
	Если Значение = "Неприменимо" Тогда //надо переделать неприменимо на неопределено
		Возврат "";
		
	ИначеЕсли Значение = Неопределено Тогда 
		Возврат "";
		
	//ИначеЕсли РесурсыXBRL.Свойство(Колонка) Тогда
	ИначеЕсли НайденныеРесурсыXBRL.Количество() Тогда
		
		// Добавлена возможность в макете РесурсыXBRL задавать имя контрольного показателя отчета, чтобы выгрузка значимого нуля зависела от заполненности другого показателя. 
		// Например, нулевая сумма по доп. соглашению выгружается только если заполнено доп. соглашение
		КонтрольныйПоказатель = НайденныеРесурсыXBRL[0].КонтрольныйПоказатель;
		КонтрольныйПоказатель = ЗначениеЗаполнено(КонтрольныйПоказатель) И ЗначениеЗаполнено(СтрокаДанных[КонтрольныйПоказатель]) Или Не ЗначениеЗаполнено(КонтрольныйПоказатель);
		
		Если ЗначениеЗаполнено(НайденныеРесурсыXBRL[0].Параметр) Тогда
			Если ЗначениеЗаполнено(НайденныеРесурсыXBRL[0].Валюта)	//указана основная валюта
				И ЗначениеЗаполнено(НайденныеРесурсыXBRL[0].ТочностьВалюты) //указана точность валюты отличной от основной
				И СтрокаДанных[НайденныеРесурсыXBRL[0].Параметр] <> НайденныеРесурсыXBRL[0].Валюта Тогда //валюта суммы отлична от основной валюты
				Возврат ПолучитьОписаниеРеусурсаXBRL(Значение, НайденныеРесурсыXBRL[0].ТочностьВалюты, СтрокаДанных[НайденныеРесурсыXBRL[0].Параметр], НайденныеРесурсыXBRL[0].ЗначимыйНоль);
			Иначе
				Возврат ПолучитьОписаниеРеусурсаXBRL(Значение, ОпределитьТочностьЧисла(Значение, НайденныеРесурсыXBRL[0]), СтрокаДанных[НайденныеРесурсыXBRL[0].Параметр], НайденныеРесурсыXBRL[0].ЗначимыйНоль);
			КонецЕсли;
		Иначе
			Возврат ПолучитьОписаниеРеусурсаXBRL(Значение, 
												ОпределитьТочностьЧисла(Значение, НайденныеРесурсыXBRL[0]), 
												НайденныеРесурсыXBRL[0].Валюта, 
												НайденныеРесурсыXBRL[0].ЗначимыйНоль И КонтрольныйПоказатель);
		КонецЕсли;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
		
	ИначеЕсли Колонка = "Date_From"
		ИЛИ Колонка = "Date_To" Тогда
		
		Возврат Значение;
		
	ИначеЕсли Колонка = "Dat_zakryt_schet" И НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
		
	ИначеЕсли Колонка = "Doxodnost_Proc_godovyx_Inf_ob_inv_strateg" Тогда
		МассивЗначений = новый Массив;
		МассивЗначений.Добавить(Новый Структура("Value", "0,00% - " + Формат(Значение, "ЧДЦ=2; ЧРД=,; ЧН=0.00; ЧГ=0") + "%"));
		
		Возврат МассивЗначений;
		
	ИначеЕсли Колонка = "SvedOperacziyaImusshTaxis" Тогда
		
		МассивЗначений = новый Массив;
		МассивЗначений.Добавить(Новый Структура("Value, Is_Multi, Is_Dimension", Значение, Истина, Истина));
		Возврат МассивЗначений;
		
	ИначеЕсли Прав(Колонка, 5) = "Taxis" ИЛИ Прав(Колонка, 4) = "Axis"  Тогда
		МассивЗначений = новый Массив;
		МассивЗначений.Добавить(Новый Структура("Value, Is_Multi, Is_Dimension", Значение, Истина, Истина));
		Возврат МассивЗначений;
		
	Иначе
		МассивЗначений = новый Массив;
		МассивЗначений.Добавить(Новый Структура("Value, Is_Multi", Значение, Истина));
		Возврат МассивЗначений;
		
	КонецЕсли;
		
	Возврат Значение;

КонецФункции

Функция ПолучитьОписаниеРеусурсаXBRL(Знач Значение, Знач Точность, Валюта, ЗначимыйНоль)
	
	МассивЗначений = новый Массив;
	ЗаписьЗначения = Новый Структура;
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Если ЗначимыйНоль Тогда //было такое правило
			Значение = 0;
		Иначе	
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	
	Если Найти(Точность, ",") > 0 Тогда //передаём динамическую точность
		МассивТочностей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Точность);
		Если Значение = Окр(Значение, МассивТочностей[0]) Тогда
			Точность = МассивТочностей[0];
		Иначе
			Точность = МассивТочностей[1];
		КонецЕсли;
	КонецЕсли;
	
	ФорматнаяСтрока = "";
		
	Если Число(Точность) < 0 Тогда
		Если Значение = Цел(Значение) Тогда
			Значение		= Окр(Значение, 0);
			ФорматнаяСтрока = "ЧДЦ=0; ЧРД=.; ЧН=0; ЧГ=0";
		Иначе
			Значение		= Окр(Значение, 2);
			ФорматнаяСтрока = "ЧДЦ=2; ЧРД=.; ЧН=0.00; ЧГ=0";	
		КонецЕсли;
	Иначе
		Значение		= Окр(Значение, Точность);
		ФорматнаяСтрока = "ЧДЦ=" + Точность + "; ЧРД=.; ЧН=0" + ?(Число(Точность) = 0, "", Лев(".0000000000000000000000000000000000000000", Число(Точность) + 1)) + "; ЧГ=0";
	КонецЕсли;
	
	Если Значение = 0 И НЕ ЗначимыйНоль Тогда
		Возврат Значение;
	КонецЕсли;
	
	Значение = Формат(Значение, ФорматнаяСтрока);
	
	Если Валюта = "Неприменимо" Тогда
		
		ЗаписьЗначения.Вставить("Value"			, Значение);
		
	Иначе	
	
		ЗаписьЗначения.Вставить("Value"			, Значение);
		ЗаписьЗначения.Вставить("Is_Multi"		, Истина);
		ЗаписьЗначения.Вставить("Precision"		, Точность);
		
		Если ЗначениеЗаполнено(Валюта) Тогда
			ЗаписьЗначения.Вставить("Unit", Валюта);
		Иначе
			ЗаписьЗначения.Вставить("Unit", "pure");
		КонецЕсли;

	КонецЕсли;
	
	МассивЗначений.Добавить(ЗаписьЗначения);
	Возврат МассивЗначений;
	
КонецФункции
 
Функция ПолучитьПеречисленияXBRL(ВерсияТаксономии) Экспорт 
	
	Отказ = Ложь;
	
	ПеречисленияXBRL = Новый Структура;
	ТаблицаПеречисленияXBRL = ПолучитьТаблицуИзМакета("ПеречисленияXBRL", ИмяПакета, Отказ, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии));
	
	Для Каждого СтрокаПеречисленияXBRL Из ТаблицаПеречисленияXBRL Цикл
		Для Каждого ИдентификаторПеречисления Из СтрРазделить(СтрокаПеречисленияXBRL.ИдентификаторПеречисления, ",", Ложь) Цикл
			
			Если НЕ ПеречисленияXBRL.Свойство(ИдентификаторПеречисления) Тогда
				ПеречисленияXBRL.Вставить(ИдентификаторПеречисления, Новый Соответствие);
			КонецЕсли;
			
			Попытка //Предопределённое значение справочника или перечисления может отсутствовать в 1с в ожидании обновления, дальше сборщик xml ругнётся на отсутсвие значения, если оно ему понадобится
				Если СтрНачинаетсяС(СтрокаПеречисленияXBRL.ТипЗначения, "Справочники") Тогда
					Значение = Справочники[СтрРазделить(СтрокаПеречисленияXBRL.ТипЗначения, ".")[1]][СтрокаПеречисленияXBRL.Значение];
				ИначеЕсли СтрНачинаетсяС(СтрокаПеречисленияXBRL.ТипЗначения, "Перечисления") Тогда
					Значение = Перечисления[СтрРазделить(СтрокаПеречисленияXBRL.ТипЗначения, ".")[1]][СтрокаПеречисленияXBRL.Значение];
				Иначе		
					Значение = СтрокаПеречисленияXBRL.Значение;
				КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;
			
			ПеречисленияXBRL[ИдентификаторПеречисления].Вставить(Значение, СтрокаПеречисленияXBRL.ЗначениеПеречисления);
		
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПеречисленияXBRL;
	
КонецФункции

Функция ПолучитьТочкиВхода() Экспорт
	
	ДоступностьОтчетовПоВидамДеятельностиОрганизации = ПолучитьДоступностьОтчетовПоВидамДеятельностиОрганизации();
	
	ТипыБулевоИNull = Новый Массив;
	ТипыБулевоИNull.Добавить(Тип("Null"));
	ТипыБулевоИNull.Добавить(Тип("Булево"));
	
	ТочкиВхода = Новый ТаблицаЗначений;
	ТочкиВхода.Колонки.Добавить("ИмяПакета",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТочкиВхода.Колонки.Добавить("Период",			Новый ОписаниеТипов("Дата"));
	ТочкиВхода.Колонки.Добавить("ВерсияТаксономии",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТочкиВхода.Колонки.Добавить("Спецдеп", 			Новый ОписаниеТипов("Булево"));
	ТочкиВхода.Колонки.Добавить("Малый", 			Новый ОписаниеТипов(ТипыБулевоИNull));
	ТочкиВхода.Колонки.Добавить("ПоЗапросу", 		Новый ОписаниеТипов("Строка"));
	ТочкиВхода.Колонки.Добавить("Нерегулярная", 	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТочкиВхода.Колонки.Добавить("Месячная",			Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТочкиВхода.Колонки.Добавить("Квартальная", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТочкиВхода.Колонки.Добавить("КонецГода", 		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ТочкиВхода.Колонки.Добавить("Годовая", 			Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	МакетТочкиВхода = ПолучитьМакет("ТочкиВхода");
	
	Для НомерСтроки = 2 По МакетТочкиВхода.ВысотаТаблицы Цикл
		ВремИмяПакета = СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		Если ДоступностьОтчетовПоВидамДеятельностиОрганизации.Получить(ВремИмяПакета) = Неопределено Тогда
			ВызватьИсключение "Отчёт " + ВремИмяПакета + " не описан в макете ДоступностьОтчетовПоВидамДеятельности";
		ИначеЕсли ДоступностьОтчетовПоВидамДеятельностиОрганизации.Получить(ВремИмяПакета) Тогда
			НоваяСтрокаТочкиВхода = ТочкиВхода.Добавить();                                   			
			НоваяСтрокаТочкиВхода.ИмяПакета			= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
			
			МассивЧастейДаты = СтрРазделить(МакетТочкиВхода.Область(НомерСтроки, 2, НомерСтроки, 2).Текст, ".");
			НоваяСтрокаТочкиВхода.Период			= Дата(МассивЧастейДаты[2], МассивЧастейДаты[1], МассивЧастейДаты[0]);
			НоваяСтрокаТочкиВхода.ВерсияТаксономии	= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
			НоваяСтрокаТочкиВхода.Спецдеп			=(СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 4, НомерСтроки, 4).Текст) = "ДА");
			
			Если НЕ ПустаяСтрока(МакетТочкиВхода.Область(НомерСтроки, 5, НомерСтроки, 5).Текст) Тогда //если пусто, то одна точка для малых и крупных 
				НоваяСтрокаТочкиВхода.Малый	=(СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 5, НомерСтроки, 5).Текст) = "ДА");
			КонецЕсли;
			
			НоваяСтрокаТочкиВхода.ПоЗапросу			= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 6, НомерСтроки, 6).Текст);
			НоваяСтрокаТочкиВхода.Нерегулярная		= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 7, НомерСтроки, 7).Текст);
			НоваяСтрокаТочкиВхода.Месячная			= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 8, НомерСтроки, 8).Текст);
			НоваяСтрокаТочкиВхода.Квартальная		= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 9, НомерСтроки, 9).Текст);
			НоваяСтрокаТочкиВхода.КонецГода			= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 10, НомерСтроки, 10).Текст);
			НоваяСтрокаТочкиВхода.Годовая			= СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 11, НомерСтроки, 11).Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТочкиВхода;
	
КонецФункции

Процедура ЗаполнитьСписокВерсийТаксономии(СписокВерсий) Экспорт
	
	МакетТочкиВхода = ПолучитьМакет("ТочкиВхода");
	
	Для НомерСтроки = 2 По МакетТочкиВхода.ВысотаТаблицы Цикл
		Версия = СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
		Если СписокВерсий.НайтиПоЗначению(Версия) = Неопределено Тогда
			СписокВерсий.Добавить(Версия, СтрЗаменить(Версия, "_", "."));
		КонецЕсли;
	КонецЦикла;
	СписокВерсий.СортироватьПоПредставлению();
	
КонецПроцедуры

Функция ПодчиненныеТегиПустые(НаборДанных)
	
	МассивЭлементовУдаления = Новый Массив;
	
	Если ТипЗнч(НаборДанных) = Тип("Структура") Тогда
		Для Каждого ЭлементДанных Из НаборДанных Цикл
			Если ЭлементДанных.Ключ = "Precision" Тогда
				Продолжить;
			КонецЕсли;
				
			Если ПодчиненныеТегиПустые(ЭлементДанных.Значение) Тогда
				МассивЭлементовУдаления.Добавить(ЭлементДанных.Ключ);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(НаборДанных) = Тип("Массив") Тогда
		Для Каждого ЭлементДанных Из НаборДанных Цикл
			Если ПодчиненныеТегиПустые(ЭлементДанных) Тогда
				МассивЭлементовУдаления.Добавить(ЭлементДанных);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат НЕ ЗначениеЗаполнено(НаборДанных);
	КонецЕсли;
	
	Для Каждого ЭлементУдаления Из МассивЭлементовУдаления Цикл
		НаборДанных.Удалить(ЭлементУдаления);
	КонецЦикла;
	
	Возврат НаборДанных.Количество() = 0;
		
КонецФункции

Процедура ДобавитьВПакетДаты(Данные)
	
	Если ТипЗнч(ДатыДляПакетаXBRL) <> Тип("Структура") Тогда
		ДатыДляПакетаXBRL = Новый Структура;
		ДатыДляПакетаXBRL.Вставить("Date_From"	, ЭтотОбъект.Период.ДатаНачала);
		ДатыДляПакетаXBRL.Вставить("Date_To"	, ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;
	
	Если Данные.Колонки.Найти("Date_From") = Неопределено Тогда
		Данные.Колонки.Добавить("Date_From");
		Данные.ЗаполнитьЗначения(ДатыДляПакетаXBRL.Date_From, "Date_From");
	КонецЕсли;	
		
	Если Данные.Колонки.Найти("Date_To") = Неопределено Тогда
		Данные.Колонки.Добавить("Date_To");
		Данные.ЗаполнитьЗначения(ДатыДляПакетаXBRL.Date_To, "Date_To");
	КонецЕсли;	
	
КонецПроцедуры

Функция НоваяТаблица(Колонки)
	
	МассивИдентификаторовКолонок =  РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Колонки);
	
	ДанныеРаздела = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из МассивИдентификаторовКолонок Цикл
		ДанныеРаздела.Колонки.Добавить(Колонка);
	КонецЦикла;	
	
	Возврат ДанныеРаздела;
	
КонецФункции

