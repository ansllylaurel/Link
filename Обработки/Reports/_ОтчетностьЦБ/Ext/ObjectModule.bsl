Процедура КонтрольСтоимостиПая(Запрос, Отказ)
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "КодыСтрок_Финал");
	
	ДанныеНаНачало	= Новый Структура("СЧА, КоличествоПаев, СтоимостьПая", 0, 0, 0);
	ДанныеНаКонец	= Новый Структура("СЧА, КоличествоПаев, СтоимостьПая", 0, 0, 0);
	
	ПараметрыОтбора = Новый Структура("КодСтроки2, КодСтроки3", "ХХ", "ХХ");
	
	ПараметрыОтбора.Вставить("КодСтроки1", "14");
	НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаДанных ИЗ НайденныеСтроки Цикл
		ДанныеНаНачало.СЧА	= ДанныеНаНачало.СЧА	+ СтрокаДанных.СуммаНаНачало;
		ДанныеНаКонец.СЧА	= ДанныеНаКонец.СЧА		+ СтрокаДанных.СуммаНаКонец;
	КонецЦикла;
	
	ПараметрыОтбора.Вставить("КодСтроки1", "15");
	НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаДанных ИЗ НайденныеСтроки Цикл
		ДанныеНаНачало.КоличествоПаев	= ДанныеНаНачало.КоличествоПаев	+ СтрокаДанных.СуммаНаНачало;
 		ДанныеНаКонец.КоличествоПаев	= ДанныеНаКонец.КоличествоПаев	+ СтрокаДанных.СуммаНаКонец;
	КонецЦикла;
	
	ПараметрыОтбора.Вставить("КодСтроки1", "16");
	НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаДанных ИЗ НайденныеСтроки Цикл
		ДанныеНаНачало.СтоимостьПая	= ДанныеНаНачало.СтоимостьПая	+ СтрокаДанных.СуммаНаНачало;
		ДанныеНаКонец.СтоимостьПая	= ДанныеНаКонец.СтоимостьПая	+ СтрокаДанных.СуммаНаКонец;
	КонецЦикла;
	
	Если ДанныеНаНачало.КоличествоПаев <> 0 И ОКР(?(ДанныеНаНачало.СЧА < 0, 0, ДанныеНаНачало.СЧА) / ДанныеНаНачало.КоличествоПаев, 2) <> ДанныеНаНачало.СтоимостьПая Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("СЧА на предыдущую дату не соответствует стоимости всех паёв! СЧА:" + ДанныеНаНачало.СЧА + " Стоимость пая:" + ДанныеНаНачало.СтоимостьПая + " Количество паёв:" + ДанныеНаНачало.КоличествоПаев,,,, Отказ);
	КонецЕсли;
	
	Если ЭтотОбъект.ВерсияТаксономии < "4_2" Тогда
		Если ДанныеНаКонец.КоличествоПаев <> 0 И ОКР(ДанныеНаКонец.СЧА / ДанныеНаКонец.КоличествоПаев, 2) <> ДанныеНаКонец.СтоимостьПая Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("СЧА на дату отчёта не соответствует стоимости всех паёв! СЧА:" + ДанныеНаКонец.СЧА + " Стоимость пая:" + ДанныеНаКонец.СтоимостьПая + " Количество паёв:" + ДанныеНаКонец.КоличествоПаев,,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОКУД0420502_ПодменитьКодыСтрокДляСтаройВерсии(Запрос)

	МассивКодовДляПодмены = Новый Массив;
	
	КодыДляПодмены = Новый Соответствие;
	КодыДляПодмены.Вставить("09.ХХ.ХХ", "07.ХХ.ХХ"); //Х - русская буква, ХХ - это макска, любая цифра
	КодыДляПодмены.Вставить("СА.ХХ.ХХ", "09.ХХ.ХХ"); //СА - стоимость активов, в новой версии она без кода
	КодыДляПодмены.Вставить("12.ХХ.ХХ", "ХХ.ХХ.ХХ"); //ПФИ нет в старой версии
	КодыДляПодмены.Вставить("13.ХХ.ХХ", "12.ХХ.ХХ");
	КодыДляПодмены.Вставить("14.ХХ.ХХ", "13.ХХ.ХХ");
	КодыДляПодмены.Вставить("15.ХХ.ХХ", "14.ХХ.ХХ");
	КодыДляПодмены.Вставить("16.ХХ.ХХ", "15.ХХ.ХХ");
	
	МассивКодовДляПодмены.Добавить(КодыДляПодмены);
	
	ЗаменитьВТ = Ложь;
	
	ТаблицаКодыСтрок_Финал = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("КодыСтрок_Финал").ПолучитьДанные().Выгрузить();
	
	//Код 16 это последняя строка, если её нет, то подмена уже была.
	Если ТаблицаКодыСтрок_Финал.Найти("16", "КодСтроки1") <> Неопределено Тогда
		Для Каждого КодыДляПодмены Из МассивКодовДляПодмены Цикл
			Для Каждого СтрокаДанных Из ТаблицаКодыСтрок_Финал Цикл
				Если КодыДляПодмены.Получить(СтрокаДанных.КодСтроки1 + "." + СтрокаДанных.КодСтроки2 + "." + СтрокаДанных.КодСтроки3) <> Неопределено Тогда
					
					НовыеКодыСтроки = СтрРазделить(КодыДляПодмены.Получить(СтрокаДанных.КодСтроки1 + "." + СтрокаДанных.КодСтроки2 + "." + СтрокаДанных.КодСтроки3), ".");
					СтрокаДанных.КодСтроки1 = НовыеКодыСтроки[0];
					СтрокаДанных.КодСтроки2 = НовыеКодыСтроки[1];
					СтрокаДанных.КодСтроки3 = НовыеКодыСтроки[2];
					
					ЗаменитьВТ = Истина;
					
				ИначеЕсли КодыДляПодмены.Получить(СтрокаДанных.КодСтроки1 + "." + СтрокаДанных.КодСтроки2 + ".ХХ") <> Неопределено Тогда
					
					НовыеКодыСтроки = СтрРазделить(КодыДляПодмены.Получить(СтрокаДанных.КодСтроки1 + "." + СтрокаДанных.КодСтроки2 + ".ХХ"), ".");
					СтрокаДанных.КодСтроки1 = НовыеКодыСтроки[0];
					СтрокаДанных.КодСтроки2 = НовыеКодыСтроки[1];
					
					ЗаменитьВТ = Истина;
					
				ИначеЕсли КодыДляПодмены.Получить(СтрокаДанных.КодСтроки1 + ".ХХ.ХХ") <> Неопределено Тогда
					
					НовыеКодыСтроки = СтрРазделить(КодыДляПодмены.Получить(СтрокаДанных.КодСтроки1 + ".ХХ.ХХ"), ".");
					СтрокаДанных.КодСтроки1 = НовыеКодыСтроки[0];
					
					ЗаменитьВТ = Истина;
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗаменитьВТ Тогда
		ЗаменитьВременнуюТаблицу(Запрос, "КодыСтрок_Финал", ТаблицаКодыСтрок_Финал);
	КонецЕсли;

КонецПроцедуры	
	
#КонецОбласти

#Область ОКУД0420502_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420502(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420502";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);

	Если ЭтотОбъект.СформироватьНулевойОтчет Тогда
		ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, Истина, Отказ);
		Возврат ПакетДанных;
	КонецЕсли;

	Если НЕ ПолучитьДанные_ОКУД0420502_ЕстьРегистрацияСтоимостиАктивов(Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПолучитьДанные_XBRL_ОКУД0420502_ВыполнитьПредварительныеЗапросы(Запрос, Отказ);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420502_XBRL();
	Запрос.Выполнить();
	
	ДатыДляПакетаXBRL = Новый Структура;
	ДатыДляПакетаXBRL.Вставить("Date_From"	, ЭтотОбъект.Период.ДатаНачала + 60 * 60 * 24);
	ДатыДляПакетаXBRL.Вставить("Date_To"	, ЭтотОбъект.Период.ДатаОкончания);
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, , Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ПолучитьДанные_XBRL_ОКУД0420502_ВыполнитьПредварительныеЗапросы(Запрос, Отказ, ЭтоПечатнаяФорма = Ложь)
	
	ОКУД0420502_ДобавитьКалендари(Запрос);
	
	ЭтоОтчетнаяДата = (НачалоДня(ЭтотОбъект.Период.ДатаОкончания) = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ЭтотОбъект.Период.ДатаОкончания)));
	
	ПИФ		= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
	ЭтоЗПИФ = ?(ТипЗнч(ПИФ) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"), ПИФ.Тип = Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Закрытый, ЛОЖЬ);
	ЭтоОПИФ = ?(ТипЗнч(ПИФ) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды"), ПИФ.Тип = Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Открытый, ЛОЖЬ);

	ДатаНачалаДляПримечаний = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -1))) + 60 * 60 * 24;
    // Согласно сопроводительной информации к отчетности, пояснительные примечания разделов 1-3 к отчетности для ПИФ, предназначенных только для квалифицированных инвесторов, включают события за 
	// отчетный календарный квартал со дня, следующего за последним рабочим днем квартала, предшествующего отчетному, до последнего рабочего дня отчетного квартала.
	// Однако, технически, в данных разделах дата начала должна быть установлена на день следующий за последним рабочим днем МЕСЯЦА (не квартала!) предшествующего отчетному.
	
	// Ниже приведен текст из сопроводительной информации к отчетности для квартальных точек входа и ПИФ предназначенных исключительно для квалифицированных инвесторов
	
	// Для отчетности по паевым инвестиционным фондам, инвестиционные паи которых предназначены исключительно для квалифицированных инвесторов:
	// отчетный календарный квартал со дня, следующего за последним рабочим днем квартала, предшествующего отчетному, до последнего рабочего дня отчетного квартала
	// (в отчет включается информация о событиях, произошедших в указанный период), 
	// при этом технически значение "$par:refPeriodStart" - последний рабочий день месяца, предшествующего месяцу окончания отчетного квартала, и 
	// "$par:refPeriodEnd" - последний рабочий день отчетного квартала
	// Отчетный период аналогичен периоду отчетности по паевым инвестиционным фондам, инвестиционные паи которых не предназначены исключительно для квалифицированных инвесторов 
	// (даты контекстов отчетного периода аналогичны датам контекстов отчетного периода для отчетности по паевым инвестиционным фондам, 
	// инвестиционные паи которых не предназначены исключительно для квалифицированных инвесторов)	
	// start = "$par:refPeriodStart+xsd:dayTimeDuration('P1D')" (тут видно, что стартовая дата это стартовый период отчета + 1 день)
	// end   = "$par:refPeriodEnd"
	Запрос.УстановитьПараметр("Date_From_Примечания", ДатаНачалаДляПримечаний);
	
	Запрос.УстановитьПараметр("ЭтоОтчетнаяДата"							, ЭтоОтчетнаяДата);
	Запрос.УстановитьПараметр("ДатаНачала"								, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"							, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ГраницаОкончания"						, Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"								, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"			, ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Блумберг"								, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));	
	Запрос.УстановитьПараметр("НКО_НКЦ"									, ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));	
	Запрос.УстановитьПараметр("IdAifPifTaxis"							, ПИФ);	
	Запрос.УстановитьПараметр("ЭтоРПИ"									, ЭтотОбъект.ЭтоРПИ);	
	Запрос.УстановитьПараметр("ЭтоЗПИФ"									, ЭтоЗПИФ);	
	Запрос.УстановитьПараметр("ЭтоОПИФ"									, ЭтоОПИФ);	
	Запрос.УстановитьПараметр("КодВалютаУчета"							, Организация.ВалютаУчета.Код);	
	Запрос.УстановитьПараметр("Неприменимо"								, "НП");	
	Запрос.УстановитьПараметр("ПустаяСтрока"							, ПустаяСтрока);	
	Запрос.УстановитьПараметр("ПустойTIN"								, "000");
	Запрос.УстановитьПараметр("ЗащитаПерсональныхДанных"				, "Персональные данные не подлежат раскрытию в соответствии со ст. 7 Федерального закона от 27.07.2006 № 152-ФЗ «О персональных данных»");
	Запрос.УстановитьПараметр("ИнаяИнформация"							, СокрЛП(ЭтотОбъект.ИнаяИнформация));
	
	Запрос.УстановитьПараметр("Руководитель",				ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа", ПолучитьПолноеФИООтветственногоЛица("УполномоченноеЛицоСпецДепа"));
	
	Запрос.УстановитьПараметр("Date_From"	, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("Date_To"		, ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.УстановитьПараметр("Date_From_Last"	, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("Date_To_Last"	, ЭтотОбъект.Период.ДатаНачала);
	
	Запрос.УстановитьПараметр("ВерсияТаксономии", 		ЭтотОбъект.ВерсияТаксономии);
	
	Запрос.УстановитьПараметр("ОтражатьРЕПОВРазделе", ПолучитьЗначениеНастройкиОтчета("ОтражатьРЕПОВРазделе", Истина, Отказ)); //была СделкиРЕПООтражатьВРазделеСделкокСИмуществом
																																							
	Запрос.УстановитьПараметр("ТаблицаСубъектов", ПолучитьТаблицуСубъектов());
	Запрос.УстановитьПараметр("ТаблицаВидовКЗ", ПолучитьТаблицуВидовКредиторскойЗадолженности());
	
	Запрос.УстановитьПараметр("_КодыСтрокПодменыПоПисьмуЦБ3838630", ПолучитьТаблицуИзМакета("ОКУД0420502_КодыСтрокПодменыПоПисьмуЦБ3838630"));
	Запрос.УстановитьПараметр("ИнаяИнформацияПИФПоПисьмуЦБ3838630", ОКУД0420502_ИнаяИнформацияПИФПоПисьмуЦБ3838630());
	
	Запрос.УстановитьПараметр("ОтветЦБ46222298от15022022", ЭтотОбъект.Период.ДатаОкончания >= Дата(2022, 2, 15)); //Ответ ЦБ 46-2-2/298 от 15.02.22
	
	Запрос.УстановитьПараметр("ДатыРасчетаСЧА", Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала - 86400, ЭтотОбъект.Период.ДатаОкончания)); 
	
	Запрос.УстановитьПараметр("ВидыЗадолженностиСПредварительнымНачислением", Справочники.ВидыЗадолженности.ВидыЗадолженностиСПредварительнымНачислением(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания)); 
	
	Запрос.УстановитьПараметр("Облигация_MTS_XS0921331509", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_MTS_XS0921331509")); 
	
	Запрос.УстановитьПараметр("НачислЗадолж_АктНДС14122023", ОбщегоНазначения.ПолучитьИменованныйОбъект("НачислЗадолж_АктНДС14122023"));
	Запрос.УстановитьПараметр("НачислЗадолж_АктНДС02082023", ОбщегоНазначения.ПолучитьИменованныйОбъект("НачислЗадолж_АктНДС02082023"));
	Запрос.УстановитьПараметр("АктНДС13032026", ОбщегоНазначения.ПолучитьИменованныйОбъект("АктНДС13032026"));
	
	Запрос.УстановитьПараметр("НазначениеНедвижимости_ИноеСооружение",	ОбщегоНазначения.ПолучитьИменованныйОбъект("НазначениеНедвижимости_ИноеСооружение"));
	Запрос.УстановитьПараметр("ЗаймНефтяной", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЗаймНефтяной"));

	Запрос.УстановитьПараметр("НастройкиСверткиЗадолженностей", ПолучитьТаблицуНастроекСверткиЗадолженностей(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПИФ, "НомерПравил"), ЭтотОбъект.Период.ДатаОкончания));
	
	ПодготовитьТаблицыДляЗапроса_XBRL_ОКУД0420502(Запрос);
	
	ПодготовитьТаблицу_СведенияОСобытияхСущественноВлияющиеНаСЧА_ОКУД0420502_XBRL(Запрос, Отказ);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420502_Общий();
	Запрос.Выполнить();
	
	КонтрольСтоимостиПая(Запрос, Отказ);	
	
	Если ЭтотОбъект.ВерсияТаксономии < "4_2" Тогда
		ОКУД0420502_ПодменитьКодыСтрокДляСтаройВерсии(Запрос);
	КонецЕсли;
	
	ОбработатьПредварительныеТаблицы_ОКУД0420502(Запрос, Отказ);
	
	ОКУД0420502_ОбработатьТаблицуЗамов(Запрос);
	
	ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ);
	
	УдалитьИдентификаторВременногоХранилища("ОКУД0420502_PZ");
	
	Если Не Отказ Тогда
	
#Область ПЗ_Аталнт
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ОбнулениеПоказателейПИФПоПисьмуЦБ3838630").ПолучитьДанные().Выгрузить()[0].НаДатуОкончания Тогда
			ИмяФайлаВложения = СтрШаблон(
				"PZ_Атлант_НулеваяСЧА_%1_%2.docx",
				?(ЭтотОбъект.Период.ДатаОкончания < Дата(2022, 9, 30), "20220331", "20220930"),
				?(КонецМесяца(ЭтотОбъект.Период.ДатаОкончания) = КонецКвартала(ЭтотОбъект.Период.ДатаОкончания), "Квартальная", "Месячная"));
				
			ПоместитьДанныеВоВременноеХранилище("ОКУД0420502_PZ", ПолучитьВложениеИзХранилища(ИмяФайлаВложения));
		КонецЕсли;
#КонецОбласти	
	
	КонецЕсли;
	
КонецПроцедуры

