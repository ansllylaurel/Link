Процедура НумерацияСделок_XBRL(ТаблицаСделок, ДатаНачала, ДанныеПредыдущегоПериода = Ложь)
	
	Если ВерсияТаксономии <= "1_3_1" Тогда
		НумерацияСделок_XBRL_1_3_1(ТаблицаСделок, ДатаНачала, ДанныеПредыдущегоПериода);
		Возврат;
	КонецЕсли;
	
	ТекущаяДатаСделки			= НачалоДня(ДатаНачала);
	ТекущийНомерСделки			= 0;
	
	Для Каждого СтрокаСделки Из ТаблицаСделок Цикл
		Если НачалоДня(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki) < ТекущаяДатаСделки Тогда Продолжить; КонецЕсли; //это сделки по которым изменения или вторые части репо, они не участвуют в нумерации
		
		Если НачалоДня(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki) > ТекущаяДатаСделки Тогда //новый день, нумерации сделок начинается заново
			ТекущийНомерСделки = 1;
			ТекущаяДатаСделки = НачалоДня(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki);
		Иначе
			ТекущийНомерСделки = ТекущийНомерСделки + 1;
		КонецЕсли;
		
		Если ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
			СтрокаСделки.VnebirzhSdelka = Формат(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki, "ДФ=dd.MM.yyyy") + 
											"-" + Прав("000000" + Строка(ТекущийНомерСделки), 7) + 
											"-" + Прав("0000" + Строка(СтрокаСделки.НомерСтрокиСделки), 5) + 
											"-" + СтрокаСделки.Kod_naprav_sdelkiEnumerator +  
											"-" + ?(ДанныеПредыдущегоПериода, "", ?(СтрокаСделки.Vid_Inf_SoobshhEnumerator = "NEW", "001", "002"));
		Иначе
			СтрокаСделки.VnebirzhSdelka = Формат(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki, "ДФ=dd.MM.yyyy") + 
											"-" + Прав("000000" + Строка(ТекущийНомерСделки), 7) + 
											"-" + Прав("00" + Строка(СтрокаСделки.НомерСтрокиСделки), 3) + 
											"-" + СтрокаСделки.Kod_naprav_sdelkiEnumerator +  
											"-" + ?(ДанныеПредыдущегоПериода, "", ?(СтрокаСделки.Vid_Inf_SoobshhEnumerator = "NEW", "001", "002"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура НумерацияСделок_XBRL_1_3_1(ТаблицаСделок, ДатаНачала, ДанныеПредыдущегоПериода = Ложь)
	
	ТекущаяДатаСделки			= НачалоДня(ДатаНачала);
	ТекущийНомерСделки			= 0;
	
	Для Каждого СтрокаСделки Из ТаблицаСделок Цикл
		Если НачалоДня(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki) < ТекущаяДатаСделки Тогда Продолжить; КонецЕсли; //это сделки по которым изменения или вторые части репо, они не участвуют в нумерации
		
		Если НачалоДня(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki) > ТекущаяДатаСделки Тогда //новый день, нумерации сделок начинается заново
			ТекущийНомерСделки = 1;
			ТекущаяДатаСделки = НачалоДня(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki);
		Иначе
			ТекущийНомерСделки = ТекущийНомерСделки + 1;
		КонецЕсли;
		
		СтрокаСделки.VnebirzhSdelka = Формат(СтрокаСделки.Data_zaklyucheniya_sdelki_Rekv_Vnebirzh_Sdelki, "ДФ=dd.MM.yyyy") + 
										"-" + Прав("0000" + Строка(ТекущийНомерСделки), 5) + 
										"-" + Прав("0000" + Строка(СтрокаСделки.НомерСтрокиСделки), 5) + 
										"-" + СтрокаСделки.Kod_naprav_sdelkiEnumerator +  
										"-" + ?(ДанныеПредыдущегоПериода, "", СтрокаСделки.Vid_Inf_SoobshhEnumerator);
	КонецЦикла;
	
КонецПроцедуры

Функция ОКУД0420417_ПолучитьТаблицуСделок(Запрос = Неопределено, ПараметрыОтбора = Неопределено) Экспорт
	
	Если Запрос = Неопределено Тогда
		ЭтотОбъект.ВариантОтчета = "ОКУД0420417";
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		ОКУД0420417_ЗаполнитьПараметрыЗапроса(Запрос, Ложь, Ложь);		
		
		Запрос.Выполнить();
	КонецЕсли;

	Колонки = Новый Массив;
	Колонки.Добавить("Сделка");
	Колонки.Добавить("Кол4_ДатаСделки");
	Колонки.Добавить("Кол41_СуммаСделкиПервЧасть");
	Колонки.Добавить("СуммаСделкиВВалютеУчета");
	Колонки.Добавить("ВалютаСделки");
	Колонки.Добавить("КурсВалютыСделки");
	Колонки.Добавить("СчетДоверительногоУправления");
	Колонки.Добавить("МестоХранения");
	Колонки.Добавить("Кол3_ТипСделки");
	Колонки.Добавить("Кол5_КодДоговора");
	Колонки.Добавить("Кол8_ВидИнфСообщ");
	
	ТаблицаОтчета = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ТаблицаОтчета").ПолучитьДанные().Выгрузить().Скопировать(, СтрСоединить(Колонки, ","));
	
	ТаблицаОтчета.Колонки.Найти("Кол4_ДатаСделки").Имя				= "ДатаСделки";
	ТаблицаОтчета.Колонки.Найти("Кол41_СуммаСделкиПервЧасть").Имя	= "СуммаСделки";
	ТаблицаОтчета.Колонки.Найти("Кол3_ТипСделки").Имя				= "ТипСделки";
	ТаблицаОтчета.Колонки.Найти("Кол5_КодДоговора").Имя				= "КодДоговора";
	ТаблицаОтчета.Колонки.Найти("Кол8_ВидИнфСообщ").Имя				= "ВидИнфСообщ";
	
	Если ПараметрыОтбора = Неопределено Тогда
		Возврат ТаблицаОтчета;
	Иначе
		Возврат ТаблицаОтчета.Скопировать(ПараметрыОтбора);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

//Сведения о счетах ДУ
#Область ОКУД0420418_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420418(Запрос, Отказ) Экспорт

	Если ВерсияТаксономии < "3_0" Тогда
		Возврат ПолучитьДанные_XBRL_ОКУД0420418_Таксономия_131(Запрос, Отказ);
	КонецЕсли;
	
	ИмяПакета = "ОКУД0420418";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Истина);
	
	РаботаСОтчетностьюЦБ.ОКУД0420418_ВыполнитьЗапросы(ЭтотОбъект, Запрос);
	
	Если ЭтотОбъект.Период.ДатаОкончания = КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) Тогда
		РаботаСОтчетностьюЦБ.КонтрольКвартальныхПоказателей(ЭтотОбъект, Запрос, Отказ);
	КонецЕсли;
	
#Область КонтрольКоличестваКлиентов_СтоимостьИнвестиционныхПортфелей
	РаботаСОтчетностьюЦБ.ОКУД0420418_ПолучитьКоличествоКлиентов(ЭтотОбъект, Запрос);
	РаботаСОтчетностьюЦБ.ОКУД0420418_ПолучитьСтоимостьПортфелей(ЭтотОбъект, Запрос);
#КонецОбласти

	
	Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ДанныеОтчета", Отказ);
	
	Если Данные.Найти(null, "СЧА") <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не рассчитаны СЧА по счетам ДУ. Подробнее на закладке 'расшифровка'",,,, Отказ);
	КонецЕсли;
	
	ПризнакНулевогоОтчета = Истина;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420418_Раздел2()
                
