		КонецЕсли;
		
	КонецЦикла;
	
	МассивКолонок = СтрРазделить(УдаляемыеКолонки, ",", Ложь);
	Для Каждого Колонка Из МассивКолонок Цикл
		Данные.Колонки.Удалить(Колонка);
	КонецЦикла;
	
КонецПроцедуры

