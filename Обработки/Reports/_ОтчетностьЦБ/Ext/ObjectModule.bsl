			|+ <Вводы активов> (" + Формат(СтрокаПоказателейОтчета.ПоступлениеАктивов, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|– <Выводы активов> (" + Формат(СтрокаПоказателейОтчета.ИзъятиеАктивов, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") 
			|+ <Доход от инвестирования по бух. учету> (" + Формат(СтрокаДоходаОтИнвестирования.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|- <Необходимые расходы УК> (" + Формат(СтрокаПоказателейОтчета.НеобходимыеРасходыУК, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|- <Вознаграждение УК> (" + Формат(СтрокаПоказателейОтчета.ВознаграждениеУК, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")",,,, Отказ);
			
		КонецЕсли; 
		
		Если Отказ Тогда
			Возврат ПакетДанных;
		КонецЕсли;              
		
		Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
			Возврат ПакетДанных; 
		КонецЕсли;
		
		
		ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
		
	КонецЕсли;
	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
