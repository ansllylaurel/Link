#Область ОКУД0420869_2_16_3_1

Функция ПолучитьШапкуОтчетаДК(Период, Организация, ПакетОтчет)
	
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация,
	|	Организации.ЮрФизЛицо КАК ЮрФизЛицо,
	|	Лицензии.ВидДеятельности КАК ВидДеятельности,
	|	Лицензии.Ссылка КАК Лицензия
	|ПОМЕСТИТЬ _ДействующиеЛицензииОрганизации
	|ИЗ
	|	РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК СтатусыЛицензийСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|			ПО (Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо)
	|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолнНаименованиеСпецДеп,
	|	ЛицензияДепозитарнаяДеятельность.Лицензия.Номер КАК НомерЛицензииОсущДепДеят,
	|	ЛицензияСпецдепозитарий.Лицензия.Номер КАК НомерЛицензииПИФ_НПФ,
	|	""-"" КАК РегистрацНомерКредОрг,
	|	""45286590000"" КАК КодПо_ОКАТО,
	|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН1,
	|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН1
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияСпецдепозитарий
	|		ПО Организации.Ссылка = ЛицензияСпецдепозитарий.Организация
	|			И (ЛицензияСпецдепозитарий.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиВКачествеСпециализированногоДепозитарияИнвестиционныхФондовИПИФ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияДепозитарнаяДеятельность
	|		ПО Организации.Ссылка = ЛицензияДепозитарнаяДеятельность.Организация
	|			И (ЛицензияДепозитарнаяДеятельность.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДепозитарнойДеятельности))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
	|		ПО Организации.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("Период", Период);	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ПараметрыДокумента = Запрос.Выполнить();
	ПоляДокумента = ПараметрыДокумента.Колонки;
	ВыборкаПараметрыДокумента = ПараметрыДокумента.Выбрать();
	
	Если ВыборкаПараметрыДокумента.Следующий() Тогда
		
		Для Каждого Колонка из ПоляДокумента Цикл
			ПакетОтчет.Вставить(Колонка.Имя, ВыборкаПараметрыДокумента[Колонка.Имя]);
		КонецЦикла; 		
		
	КонецЕсли;
	
	Возврат ПакетОтчет;

КонецФункции

Функция ПолучитьДанные_ОКУД0420869(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXML Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420869_2_16_3_1");//Наименование макета (+_XSD)
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420869_2_16_3_1_ОКУД0420869_2_16_3_1");
	ПакетДанных.Вставить("ВерсияОтчета"			, "2.16.3.1");
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	ПакетОтчетность = Новый Структура();
	ПакетОтчетность.Вставить("ПоСостояниюНа", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy-MM-dd"));	        	
		
	ПакетДанных.Отчет.Вставить("Лист_Отчетность", ПолучитьШапкуОтчетаДК(ЭтотОбъект.ДатаОтчетности, ЭтотОбъект.Организация, ПакетОтчетность));
	
	Запрос = ПодготовитьЗапросОКУД0420869  (КонецДня(ЭтотОбъект.ДатаОтчетности), ЭтотОбъект.Организация);
	 
	Если 1 = 2 Тогда 
		Запрос = Новый Запрос();                
	КонецЕсли;

	Пакет = Запрос.ВыполнитьПакет();
	
	ДанныеТаблица2_1 = Пакет[Пакет.Количество() - 2].Выгрузить();
	ДанныеТаблица1_3_4_1 = Пакет[Пакет.Количество() - 1].Выгрузить();     
	
	#Область Форматирование
	
	ФорматныеСтроки = Новый Структура;
	ФорматныеСтроки.Вставить("Таб2КоличЦенБум"	, "ЧДЦ=6; ЧРД=.; ЧН=; ЧГ=0");	
	ФорматныеСтроки.Вставить("Таб2КоличЦенБум"	, "ЧДЦ=6; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб2КлассАктива"	, "ЧДЦ=; ЧГ=0");               	
	ФорматныеСтроки.Вставить("Таб2ОбъектСделкиРепо"	, "ЧДЦ=; ЧГ=0");	
	ФорматныеСтроки.Вставить("Таб2БалансСтоим"	, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");            
	ФорматныеСтроки.Вставить("Таб2СтоимАктивовПодСтрахЖизни"	, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб2СтоимАктивовПодИное"	, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб2СтоимАктивовСобстВПункте"	, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб2СтоимАктивовСобствПревышающиеПункт"	, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0"); 	
	ФорматныеСтроки.Вставить("Таб2ДатаЗаключДоверитУправ"	, "ДФ=yyyy-MM-dd");  	
	ФорматныеСтроки.Вставить("Таб2ДатаРазмещения"	, "ДФ=dd.MM.yyyy"); 	
	ФорматныеСтроки.Вставить("Таб2ДатаПогашения"	, "ДФ=dd.MM.yyyy");
	ФорматныеСтроки.Вставить("Таб2СвободОстаток"	, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	// Предоставляемые показатели
	ФорматныеСтроки.Вставить("Таб1_3_4ВсегоСтрахРезерв", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4СтрахРезервПоЖизни", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4СтрахРезервИное", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4СобствСредства", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	//ФорматныеСтроки.Вставить("Таб1_3_4КорректирСтрахРезерв", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	//ФорматныеСтроки.Вставить("Таб1_3_4СобствСредСУчетомКор", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4МинимРазмерУстКап", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4НормативРазмерМаржи", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4АктивыУдовлТребБанка", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4НаибИзДвухПоказат", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Таб1_3_4ПревышРазмерСобствСредств", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	
	#КонецОбласти
	
	НеобязательныеЭлементы = Новый Массив();
	НеобязательныеЭлементы.Добавить("Таб2НомерДогДоверитУправления");
	НеобязательныеЭлементы.Добавить("Таб2ДатаЗаключДоверитУправ");
	НеобязательныеЭлементы.Добавить("Таб2НомерГосРегЦенБум");
	НеобязательныеЭлементы.Добавить("Таб2ИННТИН");
	
	ПакетОтчетность.Вставить("Табл1", Новый Структура());
	ПакетОтчетность.Табл1.Вставить("Таб2_1", СформироватьМассивСтрокСНеобязательнымиЭлементами(ДанныеТаблица2_1, ФорматныеСтроки, НеобязательныеЭлементы));
	
	ПакетОтчетность.Вставить("Табл1_3", Новый Структура());
	ПакетОтчетность.Табл1_3.Вставить("Таб1_3_4_1", СформироватьМассивСтрок(ДанныеТаблица1_3_4_1, ФорматныеСтроки, "", "", Ложь));
	ПакетОтчетность.Вставить("СопроводительноеПисьмо"		, ПолучитьСопроводительноеПисьмо("ОКУД0420869_2_16_3_1"));

	// Лицо, ответственное за составление отчета
	
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО, ДолжностьИПодразделение");		
	
	СведенияОбОтветственномЛице = Новый Структура();
	СведенияОбОтветственномЛице.Вставить("ФИОДолжнЛицоСостОтчет",			РеквизитыОтветственного.ФИО);
	СведенияОбОтветственномЛице.Вставить("ДолжностьДолжнЛицоСостОтчет", 	РеквизитыОтветственного.ДолжностьИПодразделение); 	
	СведенияОбОтветственномЛице.Вставить("КонтактныйТелДолжнЛицоСостОтчет", РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания, "Телефоны").Телефоны);

	ПакетОтчетность.Вставить("СведенияДолжнЛицоСостОтчет", СведенияОбОтветственномЛице);

	
	Возврат ПакетДанных;

