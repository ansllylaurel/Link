	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);

	ПрочиеАктивы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ОбъектНедвижимости из ПрочиеАктивы Цикл
		
		Если ЗначениеЗаполнено( ОбъектНедвижимости.Обозначение4777 ) Тогда
			// Структурированное описание хранится в реквизите Обозначение4777
			// Это текст с ярлыками Адрес:, Площадь:, Наименование:
			// Каждый ярлык на новой строке
			ПозицияАдрес 		= Найти(ОбъектНедвижимости.Обозначение4777, "Адрес:");
			ПозицияПлощадь 		= Найти(ОбъектНедвижимости.Обозначение4777, "Площадь:");;
			ПозицияНаименование = Найти(ОбъектНедвижимости.Обозначение4777, "Наименование:");
			 
			Если ПозицияАдрес > 0 и ПозицияПлощадь > 0 Тогда
				Если ПозицияНаименование - ПозицияПлощадь - СтрДлина("Площадь: ") - 1 > 0 Тогда
			    	ОбъектНедвижимости.Площадь = Сред(ОбъектНедвижимости.Обозначение4777, ПозицияПлощадь + СтрДлина("Площадь: "), 
					ПозицияНаименование - ПозицияПлощадь - СтрДлина("Площадь: ")-1);	
				КонецЕсли;
				Если ПозицияПлощадь - ПозицияАдрес  - СтрДлина("Адрес:") - 1 > 2 Тогда
					ОбъектНедвижимости.Адрес = Сред(ОбъектНедвижимости.Обозначение4777, 
						ПозицияАдрес + СтрДлина("Адрес:"), ПозицияПлощадь - ПозицияАдрес - СтрДлина("Адрес:")-1);
				КонецЕсли;
			КонецЕсли;
 
		КонецЕсли;		
		
	КонецЦикла;
	
#КонецОбласти
	
	Запрос = Новый Запрос(); 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	 	
#Область Текст_Запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
