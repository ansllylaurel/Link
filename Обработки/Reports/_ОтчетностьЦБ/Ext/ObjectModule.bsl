Функция ВыгрузитьВременнуюТаблицу(Запрос, ИдентификаторВременнойТаблицы)

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИдентификаторВременнойТаблицы) = Неопределено Тогда
		Возврат Новый ТаблицаЗначений;
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ " + ИдентификаторВременнойТаблицы;
		Возврат Запрос.Выполнить().Выгрузить();
	КонецЕсли;
		
КонецФункции

Процедура ЗаменитьВременнуюТаблицу(Запрос, ИдентификаторВременнойТаблицы, ВременнаяТаблица)
	
#Область ПроверкаТиповКолонок
	МассивНетипизированныхКолонок = Новый Массив;
	Для Каждого Колонка Из ВременнаяТаблица.Колонки Цикл
		Если НЕ ЗначениеЗаполнено(Колонка.ТипЗначения) Тогда
			МассивНетипизированныхКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивНетипизированныхКолонок.Количество() Тогда
		ВызватьИсключение "Невозможно поместить таблицу " + ИдентификаторВременнойТаблицы + " в запрос. В таблице есть нетипизированные колонки: " + СтрСоединить(МассивНетипизированныхКолонок, ", ");
	КонецЕсли;
#КонецОбласти	
	
	Запрос.Текст = "";
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИдентификаторВременнойТаблицы) <> Неопределено Тогда
		Запрос.Текст =	"УНИЧТОЖИТЬ " + ИдентификаторВременнойТаблицы + ";" + Символы.ПС;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ПОМЕСТИТЬ " + ИдентификаторВременнойТаблицы + " ИЗ &" + ИдентификаторВременнойТаблицы + " КАК " + ИдентификаторВременнойТаблицы;
	 
	Запрос.УстановитьПараметр(ИдентификаторВременнойТаблицы, ВременнаяТаблица);	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ОКУД0420502_ДобавитьКалендари(Запрос)
	
	Справочники.Календари.ПоместитьВЗапросДанныеКалендаря(
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ДатаОтчетности,
		Справочники.Календари.Общероссийский,, ДобавитьМесяц(ЭтотОбъект.ДатаОтчетности, -12), ДобавитьМесяц(ЭтотОбъект.ДатаОтчетности, 12),
		Запрос.МенеджерВременныхТаблиц);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаряВсеДни.Дата КАК Дата,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаряРабочиеДни.Дата) КАК КоличествоРабочихДней
		|ПОМЕСТИТЬ ВТ_КоличествоДнейСДатыНачала
		|ИЗ
		|	_ДанныеКалендаря КАК ДанныеКалендаряВсеДни
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеКалендаря КАК ДанныеКалендаряРабочиеДни
		|		ПО ДанныеКалендаряВсеДни.Дата >= ДанныеКалендаряРабочиеДни.Дата
		|			И (ДанныеКалендаряРабочиеДни.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|			И (ДанныеКалендаряРабочиеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|ГДЕ
		|	ДанныеКалендаряВсеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаряВсеДни.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаряВсеДни.Дата КАК Дата,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДанныеКалендаряРабочиеДни.Дата) КАК КоличествоРабочихДней
		|ПОМЕСТИТЬ ВТ_КоличествоРабочихДнейСДатыНачала
		|ИЗ
		|	_ДанныеКалендаря КАК ДанныеКалендаряВсеДни
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеКалендаря КАК ДанныеКалендаряРабочиеДни
		|		ПО ДанныеКалендаряВсеДни.Дата >= ДанныеКалендаряРабочиеДни.Дата
		|			И (ДанныеКалендаряРабочиеДни.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|			И (ДанныеКалендаряРабочиеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|ГДЕ
		|	ДанныеКалендаряВсеДни.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаряВсеДни.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеКалендаряВсеДни.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_КоличествоДнейСДатыНачала.Дата КАК ДатаОперации,
		|	ВТ_КоличествоРабочихДнейСДатыНачала.КоличествоРабочихДней - ВТ_КоличествоДнейСДатыНачала.КоличествоРабочихДней КАК КоличествоДней,
		|	ВТ_КоличествоРабочихДнейСДатыНачала.Дата КАК ДатаОплаты
		|ПОМЕСТИТЬ ВТ_КоличествоРабочихДней
		|ИЗ
		|	ВТ_КоличествоДнейСДатыНачала КАК ВТ_КоличествоДнейСДатыНачала,
		|	ВТ_КоличествоРабочихДнейСДатыНачала КАК ВТ_КоличествоРабочихДнейСДатыНачала
		|ГДЕ
		|	ВТ_КоличествоРабочихДнейСДатыНачала.КоличествоРабочихДней - ВТ_КоличествоДнейСДатыНачала.КоличествоРабочихДней >= 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&СПоследнегоКалендарногоДняМесяца КАК Дата,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СПоследнегоКалендарногоДняМесяца) КАК Вариант
		|ПОМЕСТИТЬ ВТ_ВариантыНачалаСрока
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СНачалаТекущегоМесяца,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СНачалаТекущегоМесяца)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СНачалаТекущегоКвартала,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СНачалаТекущегоКвартала)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СПоследнегоРабочегоДняМесяца,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СПоследнегоРабочегоДняМесяца)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	&СКонцаТекущегоКвартала,
		|	ЗНАЧЕНИЕ(Перечисление.ВариантыНачалаСрока.СКонцаТекущегоКвартала)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_КоличествоДнейСДатыНачала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВТ_КоличествоРабочихДнейСДатыНачала";
	
	Запрос.УстановитьПараметр("СНачалаТекущегоМесяца",				НачалоМесяца(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("СНачалаТекущегоКвартала",			НачалоКвартала(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("СПоследнегоРабочегоДняМесяца",		Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ЭтотОбъект.Период.ДатаОкончания)));
	Запрос.УстановитьПараметр("СПоследнегоКалендарногоДняМесяца",	КонецМесяца(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("СКонцаТекущегоКвартала",				КонецКвартала(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.Текст = ТекстЗапроса;
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьДанные_ОКУД0420502_ЕстьРегистрацияСтоимостиАктивов(Отказ)
	
	ЕстьРегистрацияСтоимостиАктивов = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	0
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		|ГДЕ
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, ДАТАВРЕМЯ(1, 1, 1)) > НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ФинансовыеПоказатели.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьПая)";
	
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала"					, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"				, ЭтотОбъект.Период.ДатаОкончания);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Если Пакет[0].Выбрать().Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счёта ДУ: " + ЭтотОбъект.СчетДоверительногоУправления + " нет регистрации стоимости активов на " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"),,,,Отказ);
		ЕстьРегистрацияСтоимостиАктивов = Ложь;
	КонецЕсли;
	
	Если Пакет[1].Выбрать().Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счёта ДУ: " + ЭтотОбъект.СчетДоверительногоУправления + " нет регистрации стоимости активов на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"),,,,Отказ);
		ЕстьРегистрацияСтоимостиАктивов = Ложь;
	КонецЕсли;
	
	Возврат ЕстьРегистрацияСтоимостиАктивов;
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420502_Общий()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
