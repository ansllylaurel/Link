Функция ПолучитьДанные_ОКУД0420502(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXML Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420502_2_16_3_1");
