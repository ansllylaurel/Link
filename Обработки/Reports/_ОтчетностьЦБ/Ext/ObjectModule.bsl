						ДанныеДляЗаполнения.Вставить(Колонка.Имя, Формат(Выборка[Колонка.Имя], ФорматнаяСтрока));
					Иначе
						ДанныеДляЗаполнения.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
					КонецЕсли;
				КонецЦикла;
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ДанныеДляЗаполнения);
				Результат.Вывести(ОбластьСтрока);
				
			КонецЦикла;
			
			Результат.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОКУД0420427_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420427(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420427";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, , "_ДатыПолученияДокументовОСмерти");
	
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПустоеЗначение"	, "Неприменимо");
	Запрос.УстановитьПараметр("ВалютаУчета"		, ЭтотОбъект.ВалютаУчета);
	Запрос.УстановитьПараметр("ВалютаДоллар"	, Справочники.Валюты.НайтиПоНаименованию("USD", Истина));
	Запрос.УстановитьПараметр("ВалютаЕвро"		, Справочники.Валюты.НайтиПоНаименованию("EUR", Истина));
	Запрос.УстановитьПараметр("Биржа"			, ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420427();
	Запрос.Выполнить();
	
	НайденныеСтроки = ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_ЦеныЦенныхБумаг").НайтиСтроки(Новый Структура("Цена", 0));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Сч = 1;
		Для Каждого СтрокаЦен Из НайденныеСтроки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не определена цена для ЦБ '" + СтрокаЦен.ЦеннаяБумага + "', по счёту ДУ '" + СтрокаЦен.СчетДоверительногоУправления + "'",,,, Отказ);	
			Сч = Сч + 1;
			Если Сч > 100 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выведены только первые 100 строк!" + Символы.ПС + "Цены для отчёта в регистрации стоимости переоценки по счетам ИИС с видом Рыночная 3 и Приобретения. Отчёт не сформирован!",,,, Отказ);	
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПризнакНулевогоОтчета = Истина;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

#КонецОбласти

//Сведения об осуществлении профессиональным участником рынка ценных бумаг брокерской деятельности и деятельности по управлению ценными бумагами
#Область ОКУД0420431_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420431(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420431";
	ПакетДанных = Новый Структура;
	ДополнительныеПакеты = Новый Структура;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	РазделыОтчетаXBRL = РазделыОтчетаXBRL(ИмяПакета);
	Запрос.УстановитьПараметр("ЕстьРаздел_SR_0420459",	РазделыОтчетаXBRL.Найти("SR_0420459") <> Неопределено);
	Запрос.УстановитьПараметр("РазмерыСчетовКлиентов",	ПолучитьТаблицуИзМакета("ОКУД0420431_РазмерыСчетовКлиентов",, Отказ));
	Запрос.УстановитьПараметр("ВерсияТаксономии",      	ЭтотОбъект.ВерсияТаксономии);
	
	РаботаСОтчетностьюЦБ.ОКУД0420431_ВыполнитьЗапросы(ЭтотОбъект, Запрос, Отказ);
	
	Если ЭтотОбъект.Период.ДатаОкончания = КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) Тогда
		РаботаСОтчетностьюЦБ.КонтрольКвартальныхПоказателей(ЭтотОбъект, Запрос, Отказ);
	КонецЕсли;
	
	ОКУД0420459_XBRL_ЗаполнитьРеестрЦенныхБумаг(Запрос, Отказ);

	Если ЭтотОбъект.ВерсияТаксономии < "6_1" Или РазделыОтчетаXBRL.Найти("SR_0420459") <> Неопределено Тогда
		
		ДополнительныеПакеты.Вставить("ОКУД0420459", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "SR_0420459").Количество() = 0);
		
	КонецЕсли;	
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	ПризнакНулевогоОтчета = Истина;
	
	// Обработка в цикле из-за невозможности сформировать строку из трех числовых показателей в запросе.
	// Возможно, стоит сделать по-другому - сначала сформировать представление для всех регистраций инвест. профиля, а потом передать таблицу в запрос как параметр.
	
	ОКУД0420431_СформироватьПредставлениеИнвестПрофиля(Запрос);	

	ОКУД0420431_СформироватьПояснительнуюЗаписку(Запрос);
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL, ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ, ДополнительныеПакеты);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура ОКУД0420431_СформироватьПредставлениеИнвестПрофиля(Запрос)
	
	Если ЭтотОбъект.ВерсияТаксономии < "7_1" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТаблицыЗапросаДляОбработки = СтрРазделить("SR_0420431_Q_R1_P2,SR_0420431_Q_R1_P2_3,SR_0420431_Q_R2,SR_0420431_Q_R3,SR_0420431_Q_R_4,SR_0420431_Q_R_6,SR_0420431_Q_R_7,SR_0420431_Q_R_7_3,SR_0420431_Q_R_7_5", ",", Ложь);
	
	Для Каждого ИмяВременнойТаблицы Из ТаблицыЗапросаДляОбработки Цикл

		ТаблицаРаздела = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, ИмяВременнойТаблицы).Выгрузить();
		
		Для Каждого СтрокаТаблицы Из ТаблицаРаздела Цикл
			
			ШаблонПредставленияИнвестПрофиля = "%1%2;%3%4;%5%6";
			ИнвестПрофиль = СтрШаблон(ШаблонПредставленияИнвестПрофиля, 
				СтрЗаменить(СтрокаТаблицы.НеВыгружать_ДопустимыйРискВПроцентах, ",", "."), 
				?(СтрокаТаблицы.НеВыгружать_ДопустимыйРискВПроцентах = "не_определен", "", "%"),
				СтрЗаменить(СтрокаТаблицы.НеВыгружать_ОжидаемаяДоходностьВПроцентах, ",", "."), 
				?(СтрокаТаблицы.НеВыгружать_ОжидаемаяДоходностьВПроцентах = "не_определена", "", "%"),
				Формат(СтрокаТаблицы.НеВыгружать_ИнвестиционныйГоризонт, "ЧГ=''; ЧН=0"),
				?(СтрокаТаблицы.НеВыгружать_ИнвестиционныйГоризонт = "не_определен", "", "_дней"));
			
			 СтрокаТаблицы.InvestProfileTaxis = ИнвестПрофиль;
			
		КонецЦикла;

		ЗаменитьВременнуюТаблицу(Запрос, ИмяВременнойТаблицы, ТаблицаРаздела);
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ОКУД0420431_СформироватьПояснительнуюЗаписку(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Телефоны
		|ПОМЕСТИТЬ _ПояснительнаяЗапискаШапка
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА Стратегии.ИдентификаторСтратегии ССЫЛКА Справочник.СтратегииИндивидуальногоИнвестирования
		|			ТОГДА ""С_""
		|		ИНАЧЕ ""И_""
		|	КОНЕЦ + Стратегии.НомерДоговора КАК ИдентификаторСтратегии
		|ПОМЕСТИТЬ _ПояснительнаяЗапискаСтроки
		|ИЗ
		|	_Стратегии КАК Стратегии
		|ГДЕ
		|	Стратегии.ИнвестиционныйГоризонт ЕСТЬ NULL";
	
	Запрос.Выполнить();	
	
КонецПроцедуры	

Процедура ЗаполнитьПояснительнуюЗаписку_ОКУД0420431(Результат, Запрос, Отказ) Экспорт
	
	Макет = ПолучитьМакет("ПоснительнаяЗаписка2026");
	ИмяОбласти = "|Общая";
	
	ПояснительнаяЗапискаШапка  = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПояснительнаяЗапискаШапка", Отказ);
	ПояснительнаяЗапискаСтроки = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ПояснительнаяЗапискаСтроки", Отказ);
	
	Если ПояснительнаяЗапискаСтроки.Количество() = 0 Тогда
		
		Результат.Очистить();
		Возврат;
		
	КонецЕсли;

	ПояснительнаяЗапискаСтроки = ПояснительнаяЗапискаСтроки.ВыгрузитьКолонку("ИдентификаторСтратегии");
	ПояснительнаяЗапискаСтроки.Вставить(0, "");
	
	ЧастиПояснительнойЗаписки = Новый Массив;
	ЧастиПояснительнойЗаписки.Добавить(СтрШаблон("Настоящим %1 поясняет значения следующих показателей:", 
		ПояснительнаяЗапискаШапка[0].КраткоеНаименованиеПоУставу));
    ЧастиПояснительнойЗаписки.Добавить("• Показатель ""Доходность стратегии"" в отношении договоров, по которым отсутствуют активы в доверительном управлении за период определения показателя доходности, отражен со значением ""0"".");
    ЧастиПояснительнойЗаписки.Добавить("• Показатель ""Временной горизонт"" по стратегиям, в отношении которых отсутствуют подписанные инвестиционные профили, не заполняется.");
    ЧастиПояснительнойЗаписки.Добавить("");
	ЧастиПояснительнойЗаписки.Добавить("Перечень идентификаторов стратегий клиентов, инвестиционный профиль которых не определен:");
	ЧастиПояснительнойЗаписки.Добавить(СтрСоединить(ПояснительнаяЗапискаСтроки, Символы.ПС + "• "));
    ЧастиПояснительнойЗаписки.Добавить("");
	ЧастиПояснительнойЗаписки.Добавить("• Показатель «Стоимость базисного актива ПФИ» (для заключаемых не на организованных торгах ПФИ) раздела 6 отчетности - указывается рыночная стоимость ценных бумаг, являющихся базисным активом ПФИ, которая определяется на основании абзацев шестого - девятого пункта 4 статьи 212 Налогового кодекса Российской Федерации - не заполняется, в связи с тем, что базисным активом ПФИ является Ставка RUONIA и для нее не рассчитывается стоимость.");
	
	ТекстПояснительнойЗаписки = СтрСоединить(ЧастиПояснительнойЗаписки, Символы.ПС);
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, 
		ЭтотОбъект.Ответственный, , "ФИО");	
		
	ОписаниеВариантаОтчета = """Сведения об осуществлении профессиональным участником рынка ценных бумаг брокерской деятельности и деятельности по управлению ценными бумагами""";		
		
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Период", 			    
		НРег(ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания)));
	ПараметрыЗаполнения.Вставить("Ответственный",		      РеквизитыОтветственного.ФИО);
	ПараметрыЗаполнения.Вставить("ТелефонИсполнителя ",       ПояснительнаяЗапискаШапка[0].Телефоны);
	ПараметрыЗаполнения.Вставить("ВариантОтчета",		      СтрЗаменить(ЭтотОбъект.ВариантОтчета, "ОКУД", "ОКУД "));
	ПараметрыЗаполнения.Вставить("ТекстПояснительнойЗаписки", ТекстПояснительнойЗаписки);
	ПараметрыЗаполнения.Вставить("ОписаниеВариантаОтчета",    ОписаниеВариантаОтчета);
	ПараметрыЗаполнения.Вставить("Дата",                      Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	ВывестиОбласть(Результат, Макет, "Шапка" + ИмяОбласти, ПараметрыЗаполнения);
	ВывестиОбласть(Результат, Макет, "ТекстПояснительнойЗаписки" + ИмяОбласти, ПараметрыЗаполнения);
	ВывестиОбласть(Результат, Макет, "Подпись" + ИмяОбласти, ПараметрыЗаполнения);
	
КонецПроцедуры

Процедура ОКУД0420431_ЗаполнитьРасшифровку(Запрос, Расшифровка, Расшифровка1, Расшифровка2, Отказ) Экспорт
	
	Если Ложь Тогда
		Расшифровка	 = Новый ТабличныйДокумент;
		Расшифровка1 = Новый ТабличныйДокумент;
		Расшифровка2 = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Расшифровка.АвтоМасштаб = Ложь;
	Расшифровка.МасштабПечати = 100;
	Расшифровка1.АвтоМасштаб = Ложь;
	Расшифровка1.МасштабПечати = 100;
	Расшифровка2.АвтоМасштаб = Ложь;
	Расшифровка2.МасштабПечати = 100;
	
	Макет = ПолучитьМакет("ОКУД0420431_Расшифровка");
	
	ОбластьРазделитель			= Макет.ПолучитьОбласть("Разделитель");
	ОбластьШапка				= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока				= Макет.ПолучитьОбласть("Строка");
	ОбластьИтоги				= Макет.ПолучитьОбласть("Итоги");
	ОбластьШапкаАктивы			= Макет.ПолучитьОбласть("ШапкаАктивы");
	ОбластьСтрокаАктивы			= Макет.ПолучитьОбласть("СтрокаАктивы");
	ОбластьШапкаВводыВыводы		= Макет.ПолучитьОбласть("ШапкаВводыВыводы");
	ОбластьСтрокаВводыВыводы	= Макет.ПолучитьОбласть("СтрокаВводыВыводы");
	ОбластьШапкаКлиенты			= Макет.ПолучитьОбласть("ШапкаКлиенты");
	ОбластьИтогиКлиенты			= Макет.ПолучитьОбласть("ИтогиКлиенты");
	
	ОбластьСтрокаДоговоры		= Макет.ПолучитьОбласть("СтрокаДоговоры");
	
	ОбластьШапкаКлиенты.Параметры.Организация	= ЭтотОбъект.Организация;
	ОбластьШапкаКлиенты.Параметры.Период		= ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	
	Расшифровка.Вывести(ОбластьШапкаКлиенты);
	
	ОбластьШапка.Параметры.Организация	= ЭтотОбъект.Организация;
	ОбластьШапка.Параметры.Период		= ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	
	Расшифровка1.Вывести(ОбластьШапка);
	Расшифровка2.Вывести(ОбластьШапка);
	
	Данные_Клиенты = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_Клиенты", Отказ);
	Данные_Клиенты.Сортировать("ТипКлиента, КлиентУмер Убыв, Клиент");
	
	Данные_Стратегии = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_Стратегии", Отказ);
	Данные_Стратегии.Сортировать("ТипКлиента, КлиентУмер Убыв, Клиент");
	
	ДанныеАктивов = Новый Структура;
	ДанныеАктивов.Вставить("ДенежныеСредства", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ДенежныеСредства", Отказ));
	ДанныеАктивов.ДенежныеСредства.Сортировать("ВидАктиваРасшифровки, СокращенноеНаименование");
	
	ДанныеАктивов.Вставить("Депозиты", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_Депозиты", Отказ));
	ДанныеАктивов.Депозиты.Сортировать("СокращенноеНаименование");
	
	ДанныеАктивов.Вставить("ЦенныеБумаги", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ЦенныеБумаги", Отказ));
	ДанныеАктивов.ЦенныеБумаги.Сортировать("ТипЦеннойБумаги, ЦеннаяБумага");
	
	ДанныеАктивов.Вставить("ЗадолженностьСделкиРЕПО", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ЗадолженностьСделкиРЕПО", Отказ));
	ДанныеАктивов.ЗадолженностьСделкиРЕПО.Сортировать("СделкаРЕПО");
	
	ДанныеАктивов.Вставить("ЗадолженностьСделки", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ЗадолженностьСделки", Отказ));
	ДанныеАктивов.ЗадолженностьСделки.Сортировать("Сделка");
	
	ДанныеАктивов.Вставить("ЗадолженностьПрочая", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ЗадолженностьПрочая", Отказ));
	ДанныеАктивов.ЗадолженностьПрочая.Сортировать("ВидЗадолженности");
	
	ВводыВыводы = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ВводыВыводыПодробно", Отказ);
	ВводыВыводы.Сортировать("Период");
	
	НомерСтроки = 0;
	
	Для Каждого Строка_Клиенты Из Данные_Клиенты Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ОбластьСтрокаКлиенты = Макет.ПолучитьОбласть("СтрокаКлиенты");
		ОбластьСтрокаКлиенты.Параметры.Заполнить(Строка_Клиенты);
		ОбластьСтрокаКлиенты.Параметры.НомерСтроки = НомерСтроки;
		
		НайденныеСтроки = Данные_Стратегии.НайтиСтроки(Новый Структура("Клиент", Строка_Клиенты.Клиент));
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаКлиенты.Параметры, НайденныеСтроки[0], "НомерДоговора, ДатаЗаключения, КодСчета, СчетДоверительногоУправления");
		
		Расшифровка.Вывести(ОбластьСтрокаКлиенты);
		
		Для Индекс = 1 По НайденныеСтроки.Количество() - 1 Цикл
			ОбластьСтрокаКлиенты = Макет.ПолучитьОбласть("СтрокаКлиенты");
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаКлиенты.Параметры, НайденныеСтроки[Индекс], "НомерДоговора, ДатаЗаключения, КодСчета, СчетДоверительногоУправления");
			Расшифровка.Вывести(ОбластьСтрокаКлиенты);
		КонецЦикла;	
		
	КонецЦикла;
	
	ПараметрыИтоговКлиентов = СтрРазделить("КоличествоКлиентов,КоличествоКлиентовИИС,КоличествоКлиентовЗаключили,КоличествоКлиентовРасторгли,ОбъемПортфеля,ОбъемПортфеляИИС", ",", Ложь);
	Для Каждого ИмяПараметра Из ПараметрыИтоговКлиентов Цикл
		ОбластьИтогиКлиенты.Параметры[ИмяПараметра] = Данные_Клиенты.Итог(ИмяПараметра);
	КонецЦикла;
	
	Расшифровка.Вывести(ОбластьИтогиКлиенты);
	
	
	НомерСтроки = 0;
	
	Для Каждого Строка_Стратегии Из Данные_Стратегии Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Строка_Стратегии);
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		
		Расшифровка1.Вывести(ОбластьСтрока);
		
		Расшифровка2.Вывести(ОбластьСтрока);
		
		Расшифровка2.НачатьГруппуСтрок(, Ложь);
		Расшифровка2.Вывести(ОбластьРазделитель);
		Расшифровка2.Вывести(ОбластьШапкаАктивы);
		
		ПараметрыПоиска = Новый Структура("СчетДоверительногоУправления", Строка_Стратегии.СчетДоверительногоУправления);
		
		НомерСтрокиАктивов = 0;
		
		Для Каждого ЭлементДанныхАктивов Из ДанныеАктивов Цикл
			Для Каждого СтрокаАктивов Из ЭлементДанныхАктивов.Значение.НайтиСтроки(ПараметрыПоиска) Цикл
				НомерСтрокиАктивов = НомерСтрокиАктивов + 1;
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрокаАктивы.Параметры, СтрокаАктивов);
				ОбластьСтрокаАктивы.Параметры.НомерСтроки	= НомерСтрокиАктивов;
				ОбластьСтрокаАктивы.Параметры.Наименование	= СформироватьСтрокуПоШаблону(СтрокаАктивов, СтрокаАктивов.ШаблонРасшифровки);
				Расшифровка2.Вывести(ОбластьСтрокаАктивы);
			КонецЦикла;
		КонецЦикла;
		
		ВводыВыводыПоСчету = ВводыВыводы.НайтиСтроки(ПараметрыПоиска);
		Если ВводыВыводыПоСчету.Количество() Тогда
			Расшифровка2.Вывести(ОбластьРазделитель);
			Расшифровка2.Вывести(ОбластьШапкаВводыВыводы);
			
			НомерСтрокиВводыВыводы = 0;
			
			Для Каждого СтрокаВводыВыводы Из ВводыВыводыПоСчету Цикл
				НомерСтрокиВводыВыводы = НомерСтрокиВводыВыводы + 1;
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрокаВводыВыводы.Параметры, СтрокаВводыВыводы);
				ОбластьСтрокаВводыВыводы.Параметры.НомерСтроки = НомерСтрокиВводыВыводы;
				
				Расшифровка2.Вывести(ОбластьСтрокаВводыВыводы);
			КонецЦикла;	
		КонецЕсли;	
		
		Расшифровка2.Вывести(ОбластьРазделитель);
		Расшифровка2.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
	
	ПараметрыИтоговСтратегии = СтрРазделить("КоличествоДоговоров,КоличествоЗаключенныхЗаПериод,КоличествоРасторгнутыхЗаПериод,СЧА,ДенежныеСредства_СуммаВВалютеУчета,Депозиты_СуммаВВалютеУчета,ЦенныеБумаги_СуммаВВалютеУчета,СделкиРЕПО_СуммаВВалютеУчета,Сделки_СуммаВВалютеУчета,Прочее_СуммаВВалютеУчета,Расхождения_СуммаВВалютеУчета,ПоступлениеДС,ПоступлениеЦБ,ПоступлениеПрочие,ИзъятиеДС,ИзъятиеЦБ,ИзъятиеПрочие", ",", Ложь);
	Для Каждого ИмяПараметра Из ПараметрыИтоговСтратегии Цикл
		ОбластьИтоги.Параметры[ИмяПараметра] = Данные_Стратегии.Итог(ИмяПараметра);
	КонецЦикла;
	
	Расшифровка1.Вывести(ОбластьИтоги);
	Расшифровка2.Вывести(ОбластьИтоги);
	
КонецПроцедуры

#КонецОбласти

//Сведения о показателях операционной надежности профессиональных участников рынка ценных бумаг, организаторов торговли, клиринговых организаций и применяемых ими информационных технологиях
#Область ОКУД0420432_XBRL

Функция ОКУД0420432_XBRL_ПолучитьДанные(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420432";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ОКУД0420432_XBRL_ВыполнитьЗапросы(Запрос, Отказ);
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПризнакНулевогоОтчета = Истина;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Функция ОКУД0420432_XBRL_ВыполнитьЗапросы(Запрос, Отказ)
	
	//Отчёт сдаётся полностью на 31 декабря, потом каждый квартал только изменения к предыдущему отчёту.
	//Но 30.06.2023 отчёт сдавался первый раз, поэтому тоже полностью.
	ВывестиВсеРазделы  = (ЭтотОбъект.Период.ДатаОкончания = Дата(2023,6,30,23,59,59) ИЛИ ЭтотОбъект.Период.ДатаОкончания = КонецГода(ЭтотОбъект.Период.ДатаОкончания));
    ВывестиВесьРаздел6 = (ЭтотОбъект.Период.ДатаОкончания = Дата(2025, 3, 31, 23, 59, 59));
	
	//ВыгружатьТолькоИзмененияПоказателей
	//	Истина - При изменении одного показателя выгружается только изменённый показатель в разрезе осей
	//	Ложь	 - При изменении показателя выгружается весь раздел
	//Изначально выгружулся весь раздел.
	//Потом решили, что надо выгружать только изменившиеся показатели #446952
	//Потом позвонили в ЦБ и решили вернуть как было #507102
	//Потом ЦБ прислал разъяснения и опять надо выгружать только изменившиеся показатели #522485
	// А в 2025-м году все требуют выгружать измененный раздел полностью!!!
	ВыгружатьТолькоИзмененияПоказателей = Ложь; 

	КодыИнфСистем = ПолучитьТаблицуИзМакета("ОКУД0420432_523_ИнформационныеСистемы", , Отказ, Новый Структура("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ПрефиксНумерации"))); 
	
	Запрос.УстановитьПараметр("ВывестиВсеРазделы",  ВывестиВсеРазделы);
	Запрос.УстановитьПараметр("ВывестиВесьРаздел6", ВывестиВесьРаздел6);
	
    ЭтоДанныеИзExcel = ЗначениеЗаполнено(ЭтотОбъект.ИмяФайлаExcel);
	
	Если ЭтоДанныеИзExcel Тогда
		
		ПоместитьВЗапросТаблицыИзExcel(Запрос, Отказ);
		
	КонецЕсли;	
	
	ОКУД0420432_XBRL_КонтрольКоличестваРабочихЧасов(Запрос, Отказ);
	
	Для Каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		
		Если СтрНачинаетсяС(Таблица.ПолноеИмя, "Curr") И НЕ СтрНачинаетсяС(Таблица.ПолноеИмя, "Curr_SR_NFO_2_R1_R2_") Тогда
			
			ОбщееИмяТаблицы = Сред(Таблица.ПолноеИмя, 6);
			
			МассивОсей = Новый Массив;
			МассивПоказателей = Новый Массив;
			Для Каждого Колонка Из Таблица.Колонки Цикл
				Если СтрЗаканчиваетсяНа(ВРЕГ(Колонка.Имя), "AXIS") Тогда
					МассивОсей.Добавить(Колонка.Имя);
				Иначе
					МассивПоказателей.Добавить(Колонка.Имя);
				КонецЕсли;
			КонецЦикла;

			Если ЭтотОбъект.ЭтоРПИ И ВРег(ОбщееИмяТаблицы = "SR_NFO_2_R6") Тогда
				
				 МассивОсей.Добавить("КлючСтроки");
				
			КонецЕсли;	
			
			СистемныеФункции.ПоместитьРезультатСравненияТаблицЗначенийВМенеджерВременныхТаблиц(
				Запрос, 
				"Curr_" + ОбщееИмяТаблицы, 
				"Pre_" + ОбщееИмяТаблицы, 
				"Diff_" + ОбщееИмяТаблицы, 
				МассивОсей);
			
			Если ВывестиВсеРазделы Или ВывестиВесьРаздел6 И Таблица.ПолноеИмя = "Curr_SR_NFO_2_R6" Тогда
				Запрос.Текст = СтрЗаменить(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	*
					|ПОМЕСТИТЬ ИмяТаблицы
					|ИЗ
					|	Curr_ИмяТаблицы КАК ИмяТаблицы",
					"ИмяТаблицы", ОбщееИмяТаблицы);
			
			ИначеЕсли ВыгружатьТолькоИзмененияПоказателей Тогда
				
				КолонкиНеограниченнойДлины = СистемныеФункции.КолонкиНеограниченнойДлиныВременнойТаблицы(Запрос, СтрЗаменить("Diff_ИмяТаблицы", "ИмяТаблицы", ОбщееИмяТаблицы)); 
				
				Если КолонкиНеограниченнойДлины.Количество() Тогда
					
					ИсходнаяТаблица     = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, СтрЗаменить("Diff_ИмяТаблицы", "ИмяТаблицы", ОбщееИмяТаблицы)).Выгрузить();
					КопируемыеКолонки   = СтрШаблон("%1,%2", СтрСоединить(МассивОсей, ","), СтрСоединить(МассивПоказателей, ","));
					ТаблицаДляСравнения = ИсходнаяТаблица.СкопироватьКолонки(КопируемыеКолонки);
					
					МассивПолейВыборки = Новый Массив;
					Для Каждого Колонка Из ТаблицаДляСравнения.Колонки Цикл
						МассивПолейВыборки.Добавить(СтрЗаменить("Таб.Поле КАК Поле", "Поле", Колонка.Имя));
					КонецЦикла;	
					
					Для Каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл
						НоваяСтрока = ТаблицаДляСравнения.Добавить();
						
						Для Каждого Ось Из МассивОсей Цикл
							НоваяСтрока[Ось] = СтрокаТаблицы[Ось];
						КонецЦикла;
						
						Для Каждого Показатель Из МассивПоказателей Цикл
							НоваяСтрока[Показатель] = ?(СтрокаТаблицы.Статус = 2 Или СтрокаТаблицы.Статус = 3 И Не СтрокаТаблицы[Показатель] = СтрокаТаблицы["_" + Показатель], СтрокаТаблицы[Показатель], NULL);
						КонецЦикла;
					КонецЦикла;
					
					Запрос.УстановитьПараметр("Данные", ТаблицаДляСравнения);
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	&ПоляВыборки КАК ПоляВыборки
						|ПОМЕСТИТЬ ИмяТаблицы
						|ИЗ
						|	&Данные КАК Таб";
					
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляВыборки КАК ПоляВыборки", СтрСоединить(МассивПолейВыборки, "," + Символы.ПС + Символы.Таб));
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицы", ОбщееИмяТаблицы);
					
				Иначе
					
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	&Оси КАК Оси,
						|	&Показатели КАК Показатели
						|ПОМЕСТИТЬ ИмяТаблицы                                                                                                 
						|ИЗ
						|	Diff_ИмяТаблицы КАК ИмяТаблицы";
					
					ВыборПолейОсей = Новый Массив;
					Для Каждого ПолеОси Из МассивОсей Цикл
						ВыборПолейОсей.Добавить(СтрШаблон("	ИмяТаблицы.%1 КАК %1", ПолеОси));
					КонецЦикла;
					
					Если ВыборПолейОсей.Количество() > 0 Тогда
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Оси КАК Оси", СтрСоединить(ВыборПолейОсей, "," + Символы.ПС));
					Иначе
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Оси КАК Оси,", "");
					КонецЕсли;
					
					ВыборПолейПоказателей = Новый Массив;
					Для Каждого ПолеПоказателя Из МассивПоказателей Цикл
						ВыборПолейПоказателей.Добавить(СтрШаблон(
						"	ВЫБОР 
						|		КОГДА ИмяТаблицы.Статус = 2
						|				ИЛИ ИмяТаблицы.%1 <> ИмяТаблицы._%1 
						|			ТОГДА ИмяТаблицы.%1
						|	КОНЕЦ КАК %1", ПолеПоказателя));
					КонецЦикла;
					
					Если ВыборПолейПоказателей.Количество() > 0 Тогда
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Показатели КАК Показатели", СтрСоединить(ВыборПолейПоказателей, "," + Символы.ПС));
					Иначе
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Показатели КАК Показатели", "");
					КонецЕсли;
					
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяТаблицы", ОбщееИмяТаблицы);
					
				КонецЕсли;
				
			Иначе
				Запрос.Текст = СтрЗаменить(СтрЗаменить(
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ИмяТаблицы.СимволЗвездочка КАК СимволЗвездочка
					|ПОМЕСТИТЬ ИмяТаблицы
					|ИЗ
					|	Curr_ИмяТаблицы КАК ИмяТаблицы
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					|			КОЛИЧЕСТВО(*) КАК КоличествоЗаписей
					|		ИЗ
					|			Diff_ИмяТаблицы КАК Diff_ИмяТаблицы) КАК Diff_ИмяТаблицы
					|		ПО (Diff_ИмяТаблицы.КоличествоЗаписей > 0
					|				ИЛИ &ВывестиВсеРазделы)",
					"ИмяТаблицы", ОбщееИмяТаблицы),
					"СимволЗвездочка КАК СимволЗвездочка", "*");
			КонецЕсли;
			
			Запрос.Выполнить();
			
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтотОбъект.ВерсияТаксономии >= "6_1" Тогда
		
		Если ЭтоДанныеИзExcel Тогда
			
			ТаблицаРаздела_SR_NFO_2_R6 = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "SR_NFO_2_R6").Выгрузить();
			ТаблицаРаздела_SR_NFO_2_R6.Колонки.Добавить("IDAvtomatizSistemIPrilozhTaxis", 
				Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(250, ДопустимаяДлина.Переменная)));
			
			Для Каждого СтрокаИС Из ТаблицаРаздела_SR_NFO_2_R6 Цикл
				
				Если ПустаяСтрока(СтрокаИС.InformacziyaObAvtomatizirovannyxSistemaxIPrilozheniyax) Тогда
					
					// При удалении данных показатель с именами ИС не заполняется
					Продолжить;
					
				КонецЕсли;	
				
				ТЗИС = Новый ТаблицаЗначений;
				ТЗИС.Колонки.Добавить("ИС",              Новый ОписаниеТипов("Строка"));
				ТЗИС.Колонки.Добавить("ПредставлениеИС", Новый ОписаниеТипов("Строка"));
				ТЗИС.Колонки.Добавить("Код",             Новый ОписаниеТипов("Строка"));
				
				ИнфСистемы = СтрРазделить(СтрокаИС.InformacziyaObAvtomatizirovannyxSistemaxIPrilozheniyax, ";");
				
				КодыИС = Новый Массив;
				
				Для Каждого ИС Из ИнфСистемы Цикл
					
					ИнфСистема = СокрЛП(СтрРазделить(ИС, "|")[1]);
					
					НайденнаяСтрока = КодыИнфСистем.Найти(ИнфСистема);
					Если НайденнаяСтрока <> Неопределено Тогда
						
						КодыИС.Добавить(СокрЛП(НайденнаяСтрока.Код));	
						
						НоваяСтрока = ТЗИС.Добавить();
						НоваяСтрока.ИС               = ИнфСистема;
						НоваяСтрока.ПредставлениеИС  = СокрЛП(ИС);
						НоваяСтрока.Код              = НайденнаяСтрока.Код;
						
					Иначе     
						
						ТекстСообщения = СтрШаблон("Не удалось получить код информационной системы ""%1""!", ИнфСистема);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , Отказ);
						
					КонецЕсли;	
					
				КонецЦикла;	
				
				ТЗИС.Сортировать("ИС");
				
				СборныйКодИС = СтрСоединить(ТЗИС.ВыгрузитьКолонку("Код"), ";");
				
				СтрокаИС.IDAvtomatizSistemIPrilozhTaxis                         = СборныйКодИС;  
				СтрокаИС.InformacziyaObAvtomatizirovannyxSistemaxIPrilozheniyax = СтрСоединить(ТЗИС.ВыгрузитьКолонку("ПредставлениеИС"), "; ");	
				
			КонецЦикла;
			
			ЗаменитьВременнуюТаблицу(Запрос, "SR_NFO_2_R6", ТаблицаРаздела_SR_NFO_2_R6);
			
		КонецЕсли;
		
	КонецЕсли;
	
	СистемныеФункции.ПоместитьРезультатСравненияТаблицЗначенийВМенеджерВременныхТаблиц(Запрос, "Curr_SR_NFO_2_R1_R2_2", "Pre_SR_NFO_2_R1_R2_2", "Diff_SR_NFO_2_R1_R2_2", СтрРазделить("KodTexnologicheskogoProczessaAxis", ",", ЛОЖЬ));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	2 КАК Статус,
		|	SR_NFO_2_R1_R2_1.KodTexnologicheskogoProczessaAxis КАК KodTexnologicheskogoProczessaAxis,
		|	SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa КАК ProdolzhitVremRaboty_Funkczionir_TexnProczessa,
		|	SR_NFO_2_R1_R2_1.SumVremyaProstoyaIDegrTexPrObespDeyatNFO КАК SumVremyaProstoyaIDegrTexPrObespDeyatNFO
		|ПОМЕСТИТЬ Diff_SR_NFO_2_R1_R2_1
		|ИЗ
		|	Curr_SR_NFO_2_R1_R2_1 КАК SR_NFO_2_R1_R2_1";
	
	Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС;
	
	Если ВывестиВсеРазделы Тогда

		// 5_2
		Запрос.Текст = Запрос.Текст + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	SR_NFO_2_R1_R2_1.KodTexnologicheskogoProczessaAxis КАК KodTexnologicheskogoProczessaAxis,
			|	SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa КАК ProdolzhitVremRaboty_Funkczionir_TexnProczessa,
			|	SR_NFO_2_R1_R2_1.SumVremyaProstoyaIDegrTexPrObespDeyatNFO КАК SumVremyaProstoyaIDegrTexPrObespDeyatNFO,
			|	SR_NFO_2_R1_R2_2.OpisanieTexnologicheskogoProczessa КАК OpisanieTexnologicheskogoProczessa,
			|	SR_NFO_2_R1_R2_2.DopustimVremyaProstoya_DegradacziiTexnProczessa КАК DopustimVremyaProstoya_DegradacziiTexnProczessa,
			|	SR_NFO_2_R1_R2_2.DopustimDolyaDegradacziiTexnProczessa КАК DopustimDolyaDegradacziiTexnProczessa,
			|	SR_NFO_2_R1_R2_2.DopustSumVremyaProstoyaDegrTexPrObespDeyatNFO КАК DopustSumVremyaProstoyaDegrTexPrObespDeyatNFO
			|ПОМЕСТИТЬ SR_NFO_2_R1_R2
			|ИЗ
			|	Curr_SR_NFO_2_R1_R2_1 КАК SR_NFO_2_R1_R2_1
			|		ЛЕВОЕ СОЕДИНЕНИЕ Curr_SR_NFO_2_R1_R2_2 КАК SR_NFO_2_R1_R2_2
			|		ПО SR_NFO_2_R1_R2_1.KodTexnologicheskogoProczessaAxis = SR_NFO_2_R1_R2_2.KodTexnologicheskogoProczessaAxis";
		
	Иначе
		
		// 5_2
		Запрос.Текст = Запрос.Текст + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	SR_NFO_2_R1_R2_1.KodTexnologicheskogoProczessaAxis КАК KodTexnologicheskogoProczessaAxis,
			|	SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa КАК ProdolzhitVremRaboty_Funkczionir_TexnProczessa,
			|	SR_NFO_2_R1_R2_1.SumVremyaProstoyaIDegrTexPrObespDeyatNFO КАК SumVremyaProstoyaIDegrTexPrObespDeyatNFO,
			|	ВЫБОР
			|		КОГДА Diff_SR_NFO_2_R1_R2_2.Статус = 2
			|				ИЛИ Diff_SR_NFO_2_R1_R2_2.OpisanieTexnologicheskogoProczessa <> Diff_SR_NFO_2_R1_R2_2._OpisanieTexnologicheskogoProczessa
			|			ТОГДА Diff_SR_NFO_2_R1_R2_2.OpisanieTexnologicheskogoProczessa
			|	КОНЕЦ КАК OpisanieTexnologicheskogoProczessa,
			|	ВЫБОР
			|		КОГДА Diff_SR_NFO_2_R1_R2_2.Статус = 2
			|				ИЛИ Diff_SR_NFO_2_R1_R2_2.DopustimVremyaProstoya_DegradacziiTexnProczessa <> Diff_SR_NFO_2_R1_R2_2._DopustimVremyaProstoya_DegradacziiTexnProczessa
			|			ТОГДА Diff_SR_NFO_2_R1_R2_2.DopustimVremyaProstoya_DegradacziiTexnProczessa
			|	КОНЕЦ КАК DopustimVremyaProstoya_DegradacziiTexnProczessa,
			|	ВЫБОР
			|		КОГДА Diff_SR_NFO_2_R1_R2_2.Статус = 2
