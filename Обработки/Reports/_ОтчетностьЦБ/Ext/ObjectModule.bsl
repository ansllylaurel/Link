Процедура ОКУД0420432_ЗаполнитьРасшифровку(Запрос, Расшифровка, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420432";
	
	Если Ложь Тогда
		Запрос = Новый Запрос;
		Расшифровка = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Количество() = 0 Тогда
		ОКУД0420432_XBRL_ВыполнитьЗапросы(Запрос, Отказ);
	КонецЕсли;
	
	Расшифровка.Очистить();
	
	Макет = ПолучитьМакет("ОКУД0420432_Расхождения");
	
	ВывестиОбласть(Расшифровка, Макет, "ШапкаОтчета", ЭтотОбъект);
	
	ОписаниеТаблиц	 = ПолучитьТаблицуИзМакета("ОписаниеЗагружаемыхExcelФайлов", ИмяПакета, Отказ, Новый Структура("ИмяРеквизитаИмениФайла", "ИмяФайлаExcel"));
	МассивИменТаблиц = Новый Массив;
	
	Для Каждого СтрокаОписанияТаблиц Из ОписаниеТаблиц Цикл
		Если МассивИменТаблиц.Найти(СтрокаОписанияТаблиц.ИмяТаблицы) = Неопределено Тогда
			МассивИменТаблиц.Добавить(СтрокаОписанияТаблиц.ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяТаблицы Из МассивИменТаблиц Цикл

		НомерРазделаДляОбласти = ?(Прав(ИмяТаблицы, 2) = "R6", "6", "");
						
		Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "Diff_" + Сред(ИмяТаблицы, 6), Отказ);
		НайденныеСтроки = ОписаниеТаблиц.НайтиСтроки(Новый Структура("ИмяТаблицы", ИмяТаблицы));
		
		Измерения	= Новый Массив;
		Ресурсы 	= Новый Массив;
		
		Для Каждого СтрокаОписанияТаблиц Из НайденныеСтроки Цикл
			
			// Колонка добавлены в макет ради вывода в расшифровку. В файлах Excel её еще не было
			Если СтрокаОписанияТаблиц.ИмяКолонки = "IDAvtomatizSistemIPrilozhTaxis" Тогда
				
				Продолжить;
				
			КонецЕсли;	
			
			Если СтрЗаканчиваетсяНа(ВРЕГ(СтрокаОписанияТаблиц.ИмяКолонки), "AXIS") Тогда
				Измерения.Добавить(Новый Структура("ИмяКолонки, Заголовок, СоответствиеЗначение", СтрокаОписанияТаблиц.ИмяКолонки, СтрокаОписанияТаблиц.Заголовок, СтрокаОписанияТаблиц.СоответствиеЗначение));
			Иначе
				Ресурсы.Добавить(Новый Структура("ИмяКолонки, Заголовок, СоответствиеЗначение", СтрокаОписанияТаблиц.ИмяКолонки, СтрокаОписанияТаблиц.Заголовок, СтрокаОписанияТаблиц.СоответствиеЗначение));
			КонецЕсли;
		КонецЦикла;
		
		ВывестиОбласть(Расшифровка, Макет, "Заголовок", НайденныеСтроки[0]);
		
		Вывести = Истина;
		ВывестиОбласть(Расшифровка, Макет, "Шапка|Измерение", Измерения, Ложь, Вывести);
		ВывестиОбласть(Расшифровка, Макет, "Шапка|Ресурс", Ресурсы, Ложь, Вывести);

		Для Каждого СтрокаДанных Из Данные Цикл
			Вывести = Истина;
			
			Для Каждого Измерение Из Измерения Цикл
				Измерение.Вставить("Значение", СтрокаДанных[Измерение.ИмяКолонки]);
				
				Для Каждого ЭлементСоответствиеЗначение Из Измерение.СоответствиеЗначение Цикл
					Если Измерение.Значение = ЭлементСоответствиеЗначение.Значение Тогда
						Измерение.Вставить("Значение", ЭлементСоответствиеЗначение.Ключ);
					КонецЕсли;
				КонецЦикла;
			
				ВывестиОбласть(Расшифровка, Макет, СтрШаблон("Строка_%1|Измерение", СтрокаДанных.Статус), Измерение, Ложь, Вывести);
				
			КонецЦикла;
			
			Для Каждого Ресурс Из Ресурсы Цикл
				Ресурс.Вставить("Значение", СтрокаДанных[Ресурс.ИмяКолонки]);
				
				Для Каждого ЭлементСоответствиеЗначение Из Ресурс.СоответствиеЗначение Цикл
					Если Ресурс.Значение = ЭлементСоответствиеЗначение.Значение Тогда
						Ресурс.Вставить("Значение", ЭлементСоответствиеЗначение.Ключ);
					КонецЕсли;
				КонецЦикла;
				
				
				Если СтрокаДанных.Статус = 3 Тогда
					Ресурс.Вставить("_Значение", СтрокаДанных["_" + Ресурс.ИмяКолонки]);
					
					Для Каждого ЭлементСоответствиеЗначение Из Ресурс.СоответствиеЗначение Цикл
						Если Ресурс._Значение = ЭлементСоответствиеЗначение.Значение Тогда
							Ресурс.Вставить("_Значение", ЭлементСоответствиеЗначение.Ключ);
						КонецЕсли;
					КонецЦикла;
					
					Если Ресурс.Значение <> Ресурс._Значение Тогда
						ВывестиОбласть(Расшифровка, Макет, СтрШаблон("Строка_%1%2_Различные|Ресурс", НомерРазделаДляОбласти, СтрокаДанных.Статус), Ресурс, Ложь, Вывести);
					Иначе
						ВывестиОбласть(Расшифровка, Макет, СтрШаблон("Строка_%1%2|Ресурс", НомерРазделаДляОбласти, СтрокаДанных.Статус), Ресурс, Ложь, Вывести);
					КонецЕсли;
					
				Иначе

					Если СтрокаДанных.Статус = 1 Тогда
						
						Ресурс.Вставить("_Значение", СтрокаДанных["_" + Ресурс.ИмяКолонки]);
						
						Для Каждого ЭлементСоответствиеЗначение Из Ресурс.СоответствиеЗначение Цикл
							Если Ресурс._Значение = ЭлементСоответствиеЗначение.Значение Тогда
								Ресурс.Вставить("_Значение", ЭлементСоответствиеЗначение.Ключ);
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					ВывестиОбласть(Расшифровка, Макет, СтрШаблон("Строка_%1%2|Ресурс", НомерРазделаДляОбласти, СтрокаДанных.Статус), Ресурс, Ложь, Вывести);	
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;

		ВывестиОбласть(Расшифровка, Макет, "Разделитель");
		
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

//Сведения о самостоятельно выявленных профессиональным участником рынка ценных бумаг нарушениях
#Область ОКУД0420449_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420449(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420449";
	ПризнакНулевогоОтчета = Истина;
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос.УстановитьПараметр("ПоЛицензииУКПИФ"	, Ложь);

	ОКУД0420449_ВыполнитьЗапросы(Запрос);
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

Процедура ОКУД0420449_ВыполнитьЗапросы(Запрос)
	
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	
	ОКУД0420449_ПодготовитьТаблицу_ПринятыеМеры(Запрос);
	
	Запрос.Текст  = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Нарушение.ДатаВыявления КАК DataVyyavleniyaNarusheniya,
		|	Нарушение.Классификация КАК Tip_narusheniyaEnumerator,
		|	_ПринятыеМеры.ОписаниеПринятыхМер КАК Kratkoe_opisanie_prinyatyx_mer_Vyyav_prof_uch_narush,
		|	Нарушение.Ссылка КАК Vyyav_prof_uch_narushTaxis,
		|	Нарушение.Содержание КАК Opis_vyyav_narush,
		|	_ПринятыеМеры.ОписаниеПринятыхМерПоНарушениямВПрошломКвартале КАК Prinmervczelyaxustrinedopnarushzapredydkvartal
		|ПОМЕСТИТЬ SR_0420449
		|ИЗ
		|	Документ.Нарушение КАК Нарушение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстранениеНарушения КАК Устранение
		|		ПО Нарушение.Ссылка = Устранение.Основание
		|			И (НЕ Устранение.ПометкаУдаления)
		|			И (Устранение.НарушениеУстранено)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПринятыеМеры КАК _ПринятыеМеры
		|		ПО Нарушение.Ссылка = _ПринятыеМеры.Основание
		|ГДЕ
		|	Нарушение.Организация = &Организация
		|	И НЕ Нарушение.ПометкаУдаления
		|	И Нарушение.Классификация.Родитель = ЗНАЧЕНИЕ(Справочник.КлассификаторНарушений.НарушенияПУРЦБ)
		|	И ВЫБОР
		|			КОГДА &ПоЛицензииУКПИФ
		|				ТОГДА Нарушение.ПоЛицензииУКПИФ
		|			ИНАЧЕ Нарушение.ПоЛицензииДУ
		|		КОНЕЦ
		|	И (Нарушение.Основание = ЗНАЧЕНИЕ(Документ.ВходящийДокумент.)
		|			ИЛИ НЕ Нарушение.Основание ССЫЛКА Документ.ВходящийДокумент)
		|	И ВЫБОР
		|			КОГДА Нарушение.ДатаВыявления МЕЖДУ &ДатаНачала И &ДатаОкончания
		|				ТОГДА ИСТИНА
		|			КОГДА &ВерсияТаксономии >= ""4_2""
		|					И (Нарушение.ДатаВыявления МЕЖДУ ДОБАВИТЬКДАТЕ(&ДатаНачала, КВАРТАЛ, -1) И &ДатаНачала)
		|				ТОГДА Устранение.Дата ЕСТЬ NULL
		|						ИЛИ Устранение.Дата > &ДатаНачала
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	SR_0420449.Vyyav_prof_uch_narushTaxis КАК Vyyav_prof_uch_narushTaxis,
		|	ВЫБОР
		|		КОГДА Устранение.Дата ЕСТЬ NULL
		|			ТОГДА ""Для нарушения [Vyyav_prof_uch_narushTaxis] не указаны 'Принятые меры в целях устранения и недопущения нарушений за предыдущий квартал' и 'дата устранения нарушения'""
		|		ИНАЧЕ ""Для нарушения [Vyyav_prof_uch_narushTaxis] не указаны 'Принятые меры в целях устранения и недопущения нарушений за предыдущий квартал'""
		|	КОНЕЦ КАК ШаблонСообщения,
		|	Устранение.Дата ЕСТЬ НЕ NULL  КАК Отказ
		|ПОМЕСТИТЬ _КонтрольНарушений
		|ИЗ
		|	SR_0420449 КАК SR_0420449
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстранениеНарушения КАК Устранение
		|		ПО SR_0420449.Vyyav_prof_uch_narushTaxis = Устранение.Основание
		|			И (НЕ Устранение.ПометкаУдаления)
		|			И (Устранение.НарушениеУстранено)
		|ГДЕ
		|	SR_0420449.DataVyyavleniyaNarusheniya < &ДатаНачала
		|	И ЕСТЬNULL(ПОДСТРОКА(SR_0420449.Prinmervczelyaxustrinedopnarushzapredydkvartal, 1, 10), """") = """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	SR_0420449.Vyyav_prof_uch_narushTaxis,
		|	ВЫБОР
		|		КОГДА Устранение.Дата ЕСТЬ NULL
		|			ТОГДА ""Для нарушения [Vyyav_prof_uch_narushTaxis] не указано 'Краткое описание принятых мер' и 'дата устранения нарушения'""
		|		ИНАЧЕ ""Для нарушения [Vyyav_prof_uch_narushTaxis] не указано 'Краткое описание принятых мер'""
		|	КОНЕЦ,
		|	Устранение.Дата ЕСТЬ НЕ NULL 
		|		И (Устранение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|ИЗ
		|	SR_0420449 КАК SR_0420449
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстранениеНарушения КАК Устранение
		|		ПО SR_0420449.Vyyav_prof_uch_narushTaxis = Устранение.Основание
		|			И (НЕ Устранение.ПометкаУдаления)
		|			И (Устранение.НарушениеУстранено)
		|ГДЕ
		|	SR_0420449.DataVyyavleniyaNarusheniya МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ЕСТЬNULL(ПОДСТРОКА(SR_0420449.Kratkoe_opisanie_prinyatyx_mer_Vyyav_prof_uch_narush, 1, 10), """") = """"";

	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ОКУД0420449_ПодготовитьТаблицу_ПринятыеМеры(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Устранение.Основание КАК Основание,
		|	Устранение.ОписаниеПринятыхМер КАК ОписаниеПринятыхМер,
		|	ВЫБОР
		|		КОГДА Нарушение.Дата НЕ МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ТОГДА Устранение.ОписаниеПринятыхМер
		|		ИНАЧЕ
		|			""""
		|	КОНЕЦ КАК ОписаниеПринятыхМерПоНарушениямВПрошломКвартале
		|ПОМЕСТИТЬ _ПринятыеМеры
		|ИЗ
		|	Документ.УстранениеНарушения КАК Устранение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Нарушение КАК Нарушение
		|		ПО Устранение.Основание = Нарушение.Ссылка
		|ГДЕ
		|	Устранение.Организация = &Организация
		|	И НЕ Устранение.ПометкаУдаления
		|	И НЕ Нарушение.ПометкаУдаления
		|	И Устранение.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Нарушение.Классификация.Родитель = ЗНАЧЕНИЕ(Справочник.КлассификаторНарушений.НарушенияПУРЦБ)
		|	И ВЫБОР
		|			КОГДА &ПоЛицензииУКПИФ
		|				ТОГДА Нарушение.ПоЛицензииУКПИФ
		|			ИНАЧЕ Нарушение.ПоЛицензииДУ
		|		КОНЕЦ
		|	И (Нарушение.Основание = ЗНАЧЕНИЕ(Документ.ВходящийДокумент.)
		|			ИЛИ НЕ Нарушение.Основание ССЫЛКА Документ.ВходящийДокумент)";
	
	Запрос.Выполнить();
	
	ОписанияПринятыхМер = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПринятыеМеры").ПолучитьДанные().Выгрузить();
	
	ПринятыеМеры = ОписанияПринятыхМер.Скопировать(, "Основание");
	ПринятыеМеры.Свернуть("Основание");
	ПринятыеМеры.Колонки.Добавить("ОписаниеПринятыхМер", Новый ОписаниеТипов("Строка"));
	ПринятыеМеры.Колонки.Добавить("ОписаниеПринятыхМерПоНарушениямВПрошломКвартале", Новый ОписаниеТипов("Строка"));
	
	Для Каждого СтрокаПринятыеМеры Из ПринятыеМеры Цикл
		ПараметрыПоиска = Новый Структура("Основание", СтрокаПринятыеМеры.Основание);
		СтрокаПринятыеМеры.ОписаниеПринятыхМер								= СтрСоединить(ОписанияПринятыхМер.Скопировать(ПараметрыПоиска, "ОписаниеПринятыхМер").ВыгрузитьКолонку("ОписаниеПринятыхМер"), Символы.ПС); 
		СтрокаПринятыеМеры.ОписаниеПринятыхМерПоНарушениямВПрошломКвартале	= СтрСоединить(ОписанияПринятыхМер.Скопировать(ПараметрыПоиска, "ОписаниеПринятыхМерПоНарушениямВПрошломКвартале").ВыгрузитьКолонку("ОписаниеПринятыхМерПоНарушениямВПрошломКвартале"), Символы.ПС); 
	КонецЦикла;	
	
	ЗаменитьВременнуюТаблицу(Запрос, "_ПринятыеМеры", ПринятыеМеры);
	
КонецПроцедуры

Процедура ОКУД0420449_ЗаполнитьПечатнуюФорму(Запрос, Расшифровка, Отказ) Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("SR_0420449") = Неопределено Тогда
		Запрос.УстановитьПараметр("ПоЛицензииУКПИФ"	, Ложь);
		ОКУД0420449_ВыполнитьЗапросы(Запрос);
	КонецЕсли;
	
	Расшифровка.Очистить();
	
	ВывестиРасшифровку(Запрос, ПолучитьМакет("ОКУД0420449_Расшифровка"), Расшифровка, "SR_0420449", Отказ);
	
КонецПроцедуры


#КонецОбласти

