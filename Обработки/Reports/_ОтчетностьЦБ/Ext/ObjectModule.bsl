		|	&ДатаОкончания КАК НаДату,
		|	_Данные.ДоходностьПФРТекущегоГода КАК Стр010,
		|	_Данные.ДоходностьПФРПредыдущегоГода КАК Стр020,
		|	_Данные.ДоходностьПФРПредыдущихТрехЛет КАК Стр030,
		|	_Данные.ДоходностьПФРВесьПериод КАК Стр040,
		|	_Данные.ПолноеНаименованиеОрганизации КАК ПолноеНаименованиеОрганизации,
		|	&Руководитель КАК Руководитель,
		|	&ДолжностьРуководителя КАК ДолжностьРуководителя,
		|	_Данные.НомерДоговора КАК НомерДоговора,
		|	_Данные.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ПечатнаяФорма
		|ИЗ
		|	_Данные КАК _Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ДатаОкончания КАК НаДату,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ВидыФинансовыхПоказателей.Наименование КАК НаименованиеПоказателя
		|ПОМЕСТИТЬ _КонтрольПоказателей
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыФинансовыхПоказателей КАК ВидыФинансовыхПоказателей
		|		ПО (ВидыФинансовыхПоказателей.Ссылка В (ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.ДоходностьПФРПредыдущихТрехЛет), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.ДоходностьПФРТекущегоГода), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.ДоходностьПФРПредыдущегоГода), ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.ДоходностьПФРВесьПериод)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Показатели КАК _Показатели
		|		ПО (ВидыФинансовыхПоказателей.Ссылка = _Показатели.ВидПоказателя)
		|			И СчетаДоверительногоУправления.Ссылка = _Показатели.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания)
		|	И _Показатели.Значение ЕСТЬ NULL";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ОКУД0420526_ЗаполнитьПечатнуюФорму(Запрос, Результат, Расшифровка, ИмяМакета, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420526";
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПечатнаяФорма") = Неопределено Тогда
		ОКУД0420526_ВыполнитьЗапрос(Запрос, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Очистить();
	Расшифровка.Очистить();
	
	Макет = ПолучитьМакет(ИмяМакета);
	
	Если ЭтотОбъект.Период.ДатаОкончания < Дата(2021,1,1) Тогда
		Область = Макет.ПолучитьОбласть("Версия1");
	Иначе
		Область = Макет.ПолучитьОбласть("Версия2");
	КонецЕсли;
	
	ОбластьРекомендованнаяФорма = Макет.ПолучитьОбласть("РекомендованнаяФорма");
	
	Данные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПечатнаяФорма").ПолучитьДанные().Выгрузить();
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(Область.Параметры, СтрокаДанных);
		ЗаполнитьЗначенияСвойств(ОбластьРекомендованнаяФорма.Параметры, СтрокаДанных);
		
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("НаДату",	Формат(СтрокаДанных.НаДату, "ДФ=dd.MM.yyyy"));
		ПараметрыЗаполнения.Вставить("Договор", СтрокаДанных.НомерДоговора + " от " + Формат(СтрокаДанных.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
		ПараметрыЗаполнения.Вставить("Подпись", СтрокаДанных.ДолжностьРуководителя + " _________________ " + СтрокаДанных.Руководитель);
		
		ЗаполнитьЗначенияСвойств(Область.Параметры, ПараметрыЗаполнения);
		ЗаполнитьЗначенияСвойств(ОбластьРекомендованнаяФорма.Параметры, ПараметрыЗаполнения);
		
		Результат.Вывести(Область);	
		Расшифровка.Вывести(ОбластьРекомендованнаяФорма);	
	
	КонецЦикла;
	
	Результат.АвтоМасштаб = Истина;
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	Расшифровка.АвтоМасштаб = Истина;
	Расшифровка.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
КонецПроцедуры

#КонецОбласти

//ГКФО. Сопроводительное письмо 
#Область ГКФО_СопроводительноеПисьмо_XBRL

Функция ПолучитьДанные_XBRL_ГКФО_СопроводительноеПисьмо(Отказ) Экспорт
	
	ИмяПакета = "ГКФО_СопроводительноеПисьмо";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос = Новый Запрос;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "ФИО, ДолжностьИПодразделение");
	
	Запрос.УстановитьПараметр("ДатаНачала",								ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",							ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ФИОРуководителя",						РеквизитыРуководителя.ФИО);
	Запрос.УстановитьПараметр("ДолжностьРуководителя",					РеквизитыРуководителя.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации",			ИсключаемыеГоловныеОрганизации);
	Запрос.УстановитьПараметр("ДатаОтчетности",							ЭтотОбъект.ДатаОтчетности);
	Запрос.УстановитьПараметр("ДатаПредставленияОтчетностиУчастникам",	ЭтотОбъект.ДатаПредставленияОтчетностиУчастникам);
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО, ДолжностьИПодразделение");		
	
	Запрос.УстановитьПараметр("ФИООтветственного",		 РеквизитыОтветственного.ФИО);
	Запрос.УстановитьПараметр("ДолжностьОтветственного", РеквизитыОтветственного.ДолжностьИПодразделение);

	ДобавитьВЗапросСопоставимыеВидыОтчетностиПодлежащиеАудиторскойПроверке(Запрос);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ГКФО_СопроводительноеПисьмо();
	Запрос.Выполнить();
	
	КонтрольАудиторскогоЗаключения_XBRL_ГКФО_СопроводительноеПисьмо(Запрос, Отказ);
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	РазделыОтчёта = Новый Массив;
	
	РазделыОтчёта.Добавить("sr_GKFO_Soprovod_r_1");
	РазделыОтчёта.Добавить("sr_GKFO_Soprovod_r_1_SvedAudZakl");
	РазделыОтчёта.Добавить("sr_GKFO_Soprovod_r_2");
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчёта,,, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

Процедура КонтрольАудиторскогоЗаключения_XBRL_ГКФО_СопроводительноеПисьмо(Запрос, Отказ)
	
	Таблица_АудиторскоеЗаключение = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_АудиторскоеЗаключение", Отказ);
	Если Таблица_АудиторскоеЗаключение.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Не обнаружено Аудиторское заключение за период %1 по виду отчётности: %2",
				ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания),
				Перечисления.ВидыОтчетностиПодлежащиеАудиторскойПроверке.ГодоваяКонсолидированнаяОтчетность),,,, Отказ);
	ИначеЕсли Таблица_АудиторскоеЗаключение.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Найдено несколько документов Аудиторское заключение за период %1 по виду отчётности: %2",
				ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания),
				Перечисления.ВидыОтчетностиПодлежащиеАудиторскойПроверке.ГодоваяКонсолидированнаяОтчетность),,,, Отказ);
	КонецЕсли;			
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса_ГКФО_СопроводительноеПисьмо()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АудиторскоеЗаключение.Ссылка КАК Ссылка,
		|	АудиторскоеЗаключение.Организация.ЮрФизЛицо КАК ЮрФизЛицоОрганизации,
		|	АудиторскоеЗаключение.Аудитор КАК Аудитор,
		|	АудиторскоеЗаключение.Дата КАК Дата,
		|	АудиторскоеЗаключение.КатегорияМненияОДостоверностиОтчетности КАК КатегорияМненияОДостоверностиОтчетности,
		|	АудиторскоеЗаключение.СоставОтчетности КАК СоставОтчетности,
		|	АудиторскоеЗаключение.ДатаПодписанияОтчетности КАК ДатаПодписанияОтчетности,
		|	АудиторскоеЗаключение.РаскрытиеОтчетностиВИномМесте КАК РаскрытиеОтчетностиВИномМесте,
		|	АудиторскоеЗаключение.ФактическоеРаскрытиеИнформации КАК ФактическоеРаскрытиеИнформации,
		|	АудиторскоеЗаключение.Подписанты КАК Подписанты,
		|	АудиторскоеЗаключение.НомерКвалификационногоАттестатаАудитора КАК НомерКвалификационногоАттестатаАудитора,
		|	АудиторскоеЗаключение.СтраницаРаскрытияАудиторскогоЗаключения КАК СтраницаРаскрытияАудиторскогоЗаключения
		|ПОМЕСТИТЬ _АудиторскоеЗаключение
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(АудиторскоеЗаключение.Дата) КАК Дата
		|	ИЗ
		|		Документ.АудиторскоеЗаключение КАК АудиторскоеЗаключение
		|	ГДЕ
		|		АудиторскоеЗаключение.НачалоПериодаОтчетности = &ДатаНачала
		|		И АудиторскоеЗаключение.КонецПериодаОтчетности = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|		И АудиторскоеЗаключение.Проведен
		|		И АудиторскоеЗаключение.Организация = &Организация
		|		И АудиторскоеЗаключение.ВидОтчетности В(&ГодовыеФинансовыеОтчетности)) КАК ПоследнееАудиторскоеЗаключение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АудиторскоеЗаключение КАК АудиторскоеЗаключение
		|		ПО ПоследнееАудиторскоеЗаключение.Дата = АудиторскоеЗаключение.Дата
		|			И (АудиторскоеЗаключение.НачалоПериодаОтчетности = &ДатаНачала)
		|			И (АудиторскоеЗаключение.КонецПериодаОтчетности = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|			И (АудиторскоеЗаключение.Проведен)
		|			И (АудиторскоеЗаключение.Организация = &Организация)
		|			И (АудиторскоеЗаключение.ВидОтчетности В (&ГодовыеФинансовыеОтчетности))
		|ГДЕ
		|	АудиторскоеЗаключение.Ссылка ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЛицаСрезПоследних.СвязанноеЮрФизЛицо КАК ЮрФизЛицо,
		|	СвязанныеЛицаСрезПоследних.ТипСвязи КАК ТипСвязи
		|ПОМЕСТИТЬ _СвязанныеЛица
		|ИЗ
		|	РегистрСведений.СвязанныеЛица.СрезПоследних(
		|			&ДатаОкончания,
		|			(Организация, ЮрФизЛицо, ТипСвязи) В
		|				(ВЫБРАТЬ
		|					Организации.Ссылка,
		|					Организации.ЮрФизЛицо,
		|					ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ДочерняяКомпания)
		|				ИЗ
		|					Справочник.Организации КАК Организации
		|				ГДЕ
		|					Организации.Ссылка = &Организация)) КАК СвязанныеЛицаСрезПоследних
		|ГДЕ
		|	СвязанныеЛицаСрезПоследних.Действует
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СвязанныеЛица.СвязанноеЮрФизЛицо,
		|	СвязанныеЛица.ТипСвязи
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица КАК СвязанныеЛица
		|		ПО (СвязанныеЛица.Организация = Организации.Ссылка)
		|			И (СвязанныеЛица.ЮрФизЛицо = Организации.ЮрФизЛицо)
		|			И (СвязанныеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ДочерняяКомпания))
		|			И (СвязанныеЛица.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СвязанныеЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|	Акции.Ссылка КАК Акция,
		|	Акции.РазмерЭмиссииШт КАК РазмерЭмиссииШт
		|ПОМЕСТИТЬ _Акции
		|ИЗ
		|	_СвязанныеЛица КАК _СвязанныеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|		ПО _СвязанныеЛица.ЮрФизЛицо = Эмитенты.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО (Эмитенты.Ссылка = Акции.Эмитент
		|					И Акции.ДатаАннулирования = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Акции.ДатаАннулирования > &ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Эмиссии.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Эмиссии.РазмерЭмиссииШт, 0) <> 0
		|			ТОГДА ОстаткиЦБ.Количество * 100 / Эмиссии.РазмерЭмиссииШт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Доля
		|ПОМЕСТИТЬ _ОбъемВложений
		|ИЗ
		|	(ВЫБРАТЬ
		|		_Акции.ЮрФизЛицо КАК ЮрФизЛицо,
		|		СУММА(_Акции.РазмерЭмиссииШт) КАК РазмерЭмиссииШт
		|	ИЗ
		|		_Акции КАК _Акции
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_Акции.ЮрФизЛицо) КАК Эмиссии
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Акции.ЮрФизЛицо КАК ЮрФизЛицо,
		|			СУММА(ОстаткиЦенныхБумагОстатки.КоличествоОстаток) КАК Количество
		|		ИЗ
		|			РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
