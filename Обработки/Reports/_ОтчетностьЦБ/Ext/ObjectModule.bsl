Функция ПолучитьДанные_XBRL(ИмяПакета, Запрос, АдресФайлаСОтчетомВХранилище = Неопределено, Отказ) Экспорт
	
	Если АдресФайлаСОтчетомВХранилище = Неопределено Тогда
		ПакетДанныхXBRL = ПолучитьПакетДанныхXBRL(ИмяПакета, Запрос, Новый Структура, Отказ);
		
		Если Отказ Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПеречисленияXBRL	= ПолучитьПеречисленияXBRL(ЭтотОбъект.ВерсияТаксономии);
		
		НоваяФабрикаXDTO = ПолучитьФабрикуXDTO(Отказ);
		
		ИмяФайлаXML = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "windows-1251");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ТипОбъектаXDTO	= НоваяФабрикаXDTO.Тип("XBRL", "type_XBRL_Entry_Point");
		ОбъектXDTO		= ПреобразоватьЗначениеВXML_XBRL(ПакетДанныхXBRL, "", НоваяФабрикаXDTO, ТипОбъектаXDTO);
		
		ОбъектXDTO.ID		= ОбъектXDTO.ID;
		ОбъектXDTO.Taxonomy = ОбъектXDTO.Taxonomy;
		ОбъектXDTO.Entity	= РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания, "ОГРН").ОГРН;
		
		НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, "XBRL_Entry_Point");
		
		ЗаписьXML.Закрыть();
		
		ТекстовыйФайл = Новый ТекстовыйДокумент;
		ТекстовыйФайл.Прочитать(ИмяФайлаXML,"windows-1251");
		ТекстовыйФайл.ЗаменитьСтроку(2, СтрЗаменить(ТекстовыйФайл.ПолучитьСтроку(2), "xmlns=""XBRL"" ", ""));
		ТекстовыйФайл.Записать(ИмяФайлаXML,"windows-1251");
		ДвоичныеДанныеОтчета = Новый ДвоичныеДанные(ИмяФайлаXML);
	Иначе
		ДвоичныеДанныеОтчета = ПолучитьИзВременногоХранилища(АдресФайлаСОтчетомВХранилище);
	КонецЕсли;
	
	Возврат ДвоичныеДанныеОтчета;
	
КонецФункции

Функция ПолучитьПакетДанныхXBRL(ИмяПакета, Запрос, ДополнительныеСвойства, Отказ) Экспорт
	
