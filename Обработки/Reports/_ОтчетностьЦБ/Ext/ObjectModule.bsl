Процедура ОКУД0420432_XBRL_КонтрольКоличестваРабочихЧасов(Запрос, Отказ)
	
	Запрос.УстановитьПараметр("ДатаНачала",		                НачалоКвартала(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", 	                КонецКвартала(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ДатаНачалаСледующегоПериода", 	НачалоКвартала(ЭтотОбъект.Период.ДатаОкончания + 1));
	Запрос.УстановитьПараметр("ДатаОкончанияСледующегоПериода", КонецКвартала(ЭтотОбъект.Период.ДатаОкончания + 1));
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|				ТОГДА ВЫБОР ДанныеКалендаря.ВидДня
		|						КОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)
		|							ТОГДА 7
		|						ИНАЧЕ 8
		|					КОНЕЦ
		|		КОНЕЦ) КАК КоличествоЧасов,
		|	СУММА(ВЫБОР
		|			КОГДА ДанныеКалендаря.Дата МЕЖДУ &ДатаНачалаСледующегоПериода И &ДатаОкончанияСледующегоПериода
		|				ТОГДА ВЫБОР ДанныеКалендаря.ВидДня
		|						КОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)
		|							ТОГДА 7
		|						ИНАЧЕ 8
		|					КОНЕЦ
		|		КОНЕЦ) КАК КоличествоЧасовСледующегоПериода
		|ПОМЕСТИТЬ КоличествоРабочихЧасов
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончанияСледующегоПериода
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Продолжительность времени работы (функционирования) технологического процесса '[KodTexnologicheskogoProczessaAxis]' в текущем файле ([ProdolzhitVremRaboty_Funkczionir_TexnProczessa]) не соотвествует количество рабочих часов ([КоличествоЧасов]) в квартале следующим за отчётным кварталом"" КАК ШаблонСообщения,
		|	Curr_SR_NFO_2_R1_R2_1.KodTexnologicheskogoProczessaAxis КАК KodTexnologicheskogoProczessaAxis,
		|	Curr_SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa КАК ProdolzhitVremRaboty_Funkczionir_TexnProczessa,
		|	КоличествоРабочихЧасов.КоличествоЧасовСледующегоПериода КАК КоличествоЧасов
		|ПОМЕСТИТЬ _КонтрольПродолжительностьВремениРаботы
		|ИЗ
		|	Curr_SR_NFO_2_R1_R2_1 КАК Curr_SR_NFO_2_R1_R2_1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КоличествоРабочихЧасов КАК КоличествоРабочихЧасов
		|		ПО Curr_SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa <> КоличествоРабочихЧасов.КоличествоЧасовСледующегоПериода
		|			И (Curr_SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa <> КоличествоРабочихЧасов.КоличествоЧасовСледующегоПериода * 60)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	""Продолжительность времени работы (функционирования) технологического процесса '[KodTexnologicheskogoProczessaAxis]' в предыдущем файле ([ProdolzhitVremRaboty_Funkczionir_TexnProczessa]) не соотвествует количество рабочих часов ([КоличествоЧасов]) в отчётном квартале"",
		|	Pre_SR_NFO_2_R1_R2_1.KodTexnologicheskogoProczessaAxis,
		|	Pre_SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa,
		|	КоличествоРабочихЧасов.КоличествоЧасов
		|ИЗ
		|	Pre_SR_NFO_2_R1_R2_1 КАК Pre_SR_NFO_2_R1_R2_1
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КоличествоРабочихЧасов КАК КоличествоРабочихЧасов
		|		ПО Pre_SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa <> КоличествоРабочихЧасов.КоличествоЧасов
		|			И Pre_SR_NFO_2_R1_R2_1.ProdolzhitVremRaboty_Funkczionir_TexnProczessa <> КоличествоРабочихЧасов.КоличествоЧасов * 60";
	
	Запрос.Выполнить();
	
