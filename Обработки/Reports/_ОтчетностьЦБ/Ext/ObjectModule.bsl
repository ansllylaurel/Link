Процедура ОКУД0420459_ЗаполнитьРасшифровку(Запрос, Результат, Отказ) Экспорт
	
	Если ЭтотОбъект.ВерсияТаксономии < "5_2" Тогда
		Возврат;
	КонецЕсли;
	
	Результат.АвтоМасштаб = Ложь;
	Результат.МасштабПечати = 100;
	
	Макет = ПолучитьМакет("ОКУД0420459_Расшифровка");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Организация		= ЭтотОбъект.Организация;
	ОбластьШапка.Параметры.ДатаОкончания	= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_РасшифровкаОтчета", Отказ);
	
	Если НЕ Отказ Тогда
		Данные.Сортировать("ЦеннаяБумага");
		Для Каждого СтрокаДанных Из Данные Цикл
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьСтрока );
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеСправочникаИННиОГРН(Данные, ИмяИНН, ИмяОГРН)
	
	СписокИНН = Новый Массив;
	СписокОГРН = Новый Массив;
	
	Для Каждого СтрокаДанных ИЗ Данные Цикл
		Если ЗначениеЗаполнено(СтрокаДанных[ИмяИНН]) И СписокИНН.Найти(СтрокаДанных[ИмяИНН]) = Неопределено Тогда
			СписокИНН.Добавить(СтрокаДанных[ИмяИНН])
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДанных[ИмяОГРН]) И СписокОГРН.Найти(СтрокаДанных[ИмяОГРН]) = Неопределено Тогда
			СписокОГРН.Добавить(СтрокаДанных[ИмяОГРН])
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапросаSQL = 
		"Select
		|	CBR_Guide.Name,
		|	CBR_Guide.Name_CBR_Official,
		|	CBR_Guide.INN,
		|	CBR_Guide.OGRN,
		|	CBR_Guide.KPP
		|From
		|	(Select 
		|		INN,
		|		Max([Date]) as [Date]
		|	FROM 
		|		[MatriX].[dbo].[Firms_CBR_Guide]
		|	Where
		|		&КоличествоИНН > 0 and INN IN (&СписокИНН)  and [Date] <= '&ДатаОкончания'
		|	Group by
		|		INN) as CBR_Guide_Period
		|Left join
		|	[MatriX].[dbo].[Firms_CBR_Guide] as CBR_Guide ON CBR_Guide.INN = CBR_Guide_Period.INN and
		|													CBR_Guide.[Date] = CBR_Guide_Period.[Date]
		|
		|UNION
		|
		|Select
		|	CBR_Guide.Name,
		|	CBR_Guide.Name_CBR_Official,
		|	CBR_Guide.INN,
		|	CBR_Guide.OGRN,
		|	CBR_Guide.KPP
		|From
		|	(Select 
		|		OGRN,
		|		Max([Date]) as [Date]
		|	FROM 
		|		[MatriX].[dbo].[Firms_CBR_Guide]
		|	Where
		|		&КоличествоОГРН > 0 and OGRN IN (&СписокОГРН) and [Date] <= '&ДатаОкончания'
		|	Group by
		|		OGRN) as CBR_Guide_Period
		|Left join
		|	[MatriX].[dbo].[Firms_CBR_Guide] as CBR_Guide ON CBR_Guide.OGRN = CBR_Guide_Period.OGRN and
		|													CBR_Guide.[Date] = CBR_Guide_Period.[Date]";
		
	ТекстЗапросаSQL = СтрЗаменить(ТекстЗапросаSQL, "&ДатаОкончания"	, Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyyMMdd"));		
	ТекстЗапросаSQL = СтрЗаменить(ТекстЗапросаSQL, "&СписокИНН"		, "'" + СтрСоединить(СписокИНН, "','") + "'");		
