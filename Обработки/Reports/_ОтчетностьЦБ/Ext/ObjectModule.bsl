Процедура ОКУД0420409_XBRL_ЗаполнитьРасшифровкуДенегУБрокера(Запрос, Расшифровка, Отказ, ПоЛицензииУКПИФ = Ложь) Экспорт
	
	Если ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		
		ИмяТаблицы            = ?(ПоЛицензииУКПИФ, "_ДеньгиУБрокераЛицензияУКПИФ", "_ДеньгиУБрокера");
		ИмяТаблицыРасшифровки = ?(ПоЛицензииУКПИФ, "РасшифровкаБрокерУКПИФ",       "РасшифровкаБрокер");
		
		Расшифровка.АвтоМасштаб = Ложь;
		Расшифровка.МасштабПечати = 100;
		
		Запрос.Текст = ОКУД0420409_XBRL_ТекстЗапроса_РасшифровкаСредствУБрокера(ИмяТаблицы, ИмяТаблицыРасшифровки);
		Запрос.Выполнить();
		
		Макет = ПолучитьМакет("ОКУД0420409");
		
		ОбластьШапка = Макет.ПолучитьОбласть(?(ПоЛицензииУКПИФ, "РасшифровкаБрокерШапкаУКПИФ", "РасшифровкаБрокерШапка"));
		
		Расшифровка.Вывести(ОбластьШапка);
		
		Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, ИмяТаблицыРасшифровки, Отказ);
		Данные.Сортировать("СчетДоверительногоУправления");
		
		Для Каждого СтрокаДанных Из Данные Цикл
			СтрокаДанных.НомерСтроки = Данные.Индекс(СтрокаДанных) + 1;
			
			ОбластьРаздел1Строка = Макет.ПолучитьОбласть("РасшифровкаБрокерСтрока");
			ЗаполнитьЗначенияСвойств(ОбластьРаздел1Строка.Параметры, СтрокаДанных);
			Расшифровка.Вывести(ОбластьРаздел1Строка);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОКУД0420409_XBRL_ЗаполнитьРасшифровкуПоСчетам(Запрос, Расшифровка, Отказ, ПоЛицензииУКПИФ = Ложь) Экспорт
	
		Расшифровка.АвтоМасштаб = Ложь;
		Расшифровка.МасштабПечати = 100;
		
		Запрос.Текст = ОКУД0420409_XBRL_ТекстЗапроса_РасшифровкаПоСчетам();
		Запрос.Выполнить();
		
		Макет = ПолучитьМакет("ОКУД0420409");
		
		ОбластьШапка = Макет.ПолучитьОбласть("РасшифровкаШапкаРаздел1УКПИФ");
		
		Расшифровка.Вывести(ОбластьШапка);
		
		Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_РасшифровкаРаздел1НеВошедшие", Отказ);
		Данные.Сортировать("ИсточникСредств Убыв, СокрНаименование, НомерСчета");
		
		Для Каждого СтрокаДанных Из Данные Цикл
			СтрокаДанных.НомерСтроки = Данные.Индекс(СтрокаДанных) + 1;
			
			ОбластьРаздел1Строка = Макет.ПолучитьОбласть("РасшифровкаРаздел1УКПИФСтрока");
			ЗаполнитьЗначенияСвойств(ОбластьРаздел1Строка.Параметры, СтрокаДанных);
			Расшифровка.Вывести(ОбластьРаздел1Строка);
		КонецЦикла;
	
