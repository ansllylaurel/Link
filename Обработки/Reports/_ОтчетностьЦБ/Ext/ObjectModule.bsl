Процедура ЗаполнитьРасшифровку_ОКУД0420418(Запрос, Результат, Отказ) Экспорт
	
	Результат.Очистить();
	
	РаботаСОтчетностьюЦБ.ОКУД0420418_ВыполнитьЗапросы(ЭтотОбъект, Запрос);
	
	ТаблицаРасшифровки = ВыгрузитьВременнуюТаблицу(Запрос, "_Расшифровка");
	ТаблицаРасшифровки.Сортировать("КоличествоКлиентов, Клиент");
	
	ТаблицаДоговоров = ВыгрузитьВременнуюТаблицу(Запрос, "_ДанныеОтчета");
	
	Макет = ПолучитьМакет("ОКУД0420418_Расшифровка");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьВидЮрФизЛица	= Макет.ПолучитьОбласть("ВидЮрФизЛица");
	
	ОбластьРезиденты		= Макет.ПолучитьОбласть("Резиденты");
	ОбластьНерезиденты		= Макет.ПолучитьОбласть("Нерезиденты");
	
	ОбластьСтрокаРезидент		= Макет.ПолучитьОбласть("СтрокаРезидент");
	ОбластьСтрокаНерезидент		= Макет.ПолучитьОбласть("СтрокаНерезидент");
	
	Результат.Вывести(ОбластьШапка);
	
	НомерСтроки = 0;
	ВывестиОбластьГруппировки_ОКУД0420418(Результат, ОбластьВидЮрФизЛица, "Физ.лица", ТаблицаРасшифровки, Новый Структура("ЮрЛицо", Ложь));
	
	ВывестиОбластьГруппировки_ОКУД0420418(Результат, ОбластьНерезиденты, "Нерезиденты", ТаблицаРасшифровки, Новый Структура("ЮрЛицо,РезидентРФ", Ложь, Ложь));
	ВывестиОбластьСтроки_ОКУД0420418(Результат, ОбластьСтрокаНерезидент, ТаблицаРасшифровки, ТаблицаДоговоров, Новый Структура("ЮрЛицо,РезидентРФ", Ложь, Ложь), НомерСтроки);
	
	ВывестиОбластьГруппировки_ОКУД0420418(Результат, ОбластьРезиденты, "Резиденты", ТаблицаРасшифровки, Новый Структура("ЮрЛицо,РезидентРФ", Ложь, Истина));
	ВывестиОбластьСтроки_ОКУД0420418(Результат, ОбластьСтрокаРезидент, ТаблицаРасшифровки, ТаблицаДоговоров, Новый Структура("ЮрЛицо,РезидентРФ", Ложь, Истина), НомерСтроки);
	
	НомерСтроки = 0;
	ВывестиОбластьГруппировки_ОКУД0420418(Результат, ОбластьВидЮрФизЛица, "Юр.лица", ТаблицаРасшифровки, Новый Структура("ЮрЛицо", Истина));
	
	ВывестиОбластьГруппировки_ОКУД0420418(Результат, ОбластьРезиденты, "Резиденты", ТаблицаРасшифровки, Новый Структура("ЮрЛицо,РезидентРФ", Истина, Истина));
	ВывестиОбластьСтроки_ОКУД0420418(Результат, ОбластьСтрокаРезидент, ТаблицаРасшифровки, ТаблицаДоговоров, Новый Структура("ЮрЛицо,РезидентРФ", Истина, Истина), НомерСтроки);
	
	ВывестиОбластьГруппировки_ОКУД0420418(Результат, ОбластьНерезиденты, "Нерезиденты", ТаблицаРасшифровки, Новый Структура("ЮрЛицо,РезидентРФ", Истина, Ложь));
	ВывестиОбластьСтроки_ОКУД0420418(Результат, ОбластьСтрокаНерезидент, ТаблицаРасшифровки, ТаблицаДоговоров, Новый Структура("ЮрЛицо,РезидентРФ", Истина, Ложь), НомерСтроки);
	
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "РасшифровкаСтратегии");
	
	Данные.Сортировать("НаименованиеСтратегии,СчетДоверительногоУправления");
	
	ОбластьШапкаСтратегии	= Макет.ПолучитьОбласть("ШапкаСтратегии");
	ОбластьСтратегия		= Макет.ПолучитьОбласть("Стратегия");
	ОбластьСчетДУ			= Макет.ПолучитьОбласть("СчетДУ");
	
	Результат.Вывести(ОбластьШапкаСтратегии);
	
	НаименованиеСтратегии = "";
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если НаименованиеСтратегии <> СтрокаДанных.НаименованиеСтратегии Тогда
			ЗаполнитьЗначенияСвойств(ОбластьСтратегия.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьСтратегия);
			
			НаименованиеСтратегии = СтрокаДанных.НаименованиеСтратегии;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ОбластьСчетДУ.Параметры, СтрокаДанных);
		Результат.Вывести(ОбластьСчетДУ);
		
		Если НЕ СтрокаДанных.УчитыватьВКоличестеКлиентов Тогда
			ТекущаяОбласть	= Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, 3);
			ТекущийШрифт	= ТекущаяОбласть.Шрифт;
			ТекущаяОбласть.Шрифт = Новый Шрифт(ТекущийШрифт,,,,,, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиОбластьГруппировки_ОКУД0420418(Результат, Область, Расшифровка, Данные, ПараметрыОтбора)
	
	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("Расшифровка", Расшифровка);
	ПараметрыРасшифровки.Вставить("Всего", ИтогПоНайденнымСтрокам(Данные.НайтиСтроки(ПараметрыОтбора), "КоличествоКлиентов")); 
	
	ПараметрыРасшифровки.Вставить("СЧА", 0);
	Для Каждого СтрокаДанных Из Данные.НайтиСтроки(ПараметрыОтбора) Цикл
		Если ТипЗнч(СтрокаДанных.СЧА) = Тип("Число") Тогда
			ПараметрыРасшифровки.СЧА = ПараметрыРасшифровки.СЧА + СтрокаДанных.СЧА;
		КонецЕсли;
	КонецЦикла;
	
	Если ПараметрыРасшифровки.Всего = 0 Тогда Возврат; КонецЕсли;
	
	ПараметрыРасшифровки.Вставить("КоличествоКлиентов", ИтогПоНайденнымСтрокам(Данные.НайтиСтроки(ПараметрыОтбора), "КоличествоКлиентов")); 
	
	ПараметрыОтбора.Вставить("Активный", Истина);
	ПараметрыРасшифровки.Вставить("Активные", ИтогПоНайденнымСтрокам(Данные.НайтиСтроки(ПараметрыОтбора), "КоличествоКлиентов")); 
	ПараметрыОтбора.Удалить("Активный");
	
	ПараметрыОтбора.Вставить("КвалИнвестор", Истина);
	ПараметрыРасшифровки.Вставить("Квал", ИтогПоНайденнымСтрокам(Данные.НайтиСтроки(ПараметрыОтбора), "КоличествоКлиентов")); 
	
	ЗаполнитьЗначенияСвойств(Область.Параметры, ПараметрыРасшифровки);
	
	Результат.Вывести(Область);
	
КонецПроцедуры

Процедура ВывестиОбластьСтроки_ОКУД0420418(Результат, Область, ТаблицаРасшифровки, ТаблицаДоговоров, ПараметрыОтбора, НомерСтроки)
	
	НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(ПараметрыОтбора);
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		НомерСтроки = НомерСтроки + 1;
		Область.Параметры.НомерСтроки = НомерСтроки;
		
		ЗаполнитьЗначенияСвойств(Область.Параметры, СтрокаДанных,,"СЧА");
		
		НайденныеСтрокиДоговоров = ТаблицаДоговоров.НайтиСтроки(Новый Структура("Клиент", СтрокаДанных.Клиент));
		Для Каждого СтрокаДоговора Из НайденныеСтрокиДоговоров Цикл
			
			Если СтрокаДоговора.СЧА = null Тогда
				Область.Параметры.СЧА = "Отсутствует!";
			Иначе
				Область.Параметры.СЧА = СтрокаДоговора.СЧА;
			КонецЕсли;	
			
			ЗаполнитьЗначенияСвойств(Область.Параметры, СтрокаДоговора, "СчетДоверительногоУправления,НомерДоговора,ДатаЗаключения");
			
			Результат.Вывести(Область);
			
			Если СтрокаДанных.КоличествоКлиентов = 0 Тогда
				Для НомерКолонки = 1 По 10 Цикл
					ТекущаяОбласть = Результат.Область(Результат.ВысотаТаблицы, НомерКолонки, Результат.ВысотаТаблицы, НомерКолонки);
					ТекущаяОбласть.ЦветФона = Новый Цвет(255,255,255);
				КонецЦикла;
			КонецЕсли;
		
			Область.Параметры.НомерСтроки = "";
			Область.Параметры.Клиент = "";
			Область.Параметры.КоличествоКлиентов = "";
			
		КонецЦикла;
		

	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

//Информация о лицах, которым профессиональным участником поручено проведение идентификации
#Область ОКУД0420419_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420419(Отказ) Экспорт

	ИмяПакета = "ОКУД0420419";
	ПакетДанных = Новый Структура;
	ПризнакНулевогоОтчета = Ложь;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала",			ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",		ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",		ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВерсияТаксономии",	ЭтотОбъект.ВерсияТаксономии);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420419();
	Запрос.Выполнить();
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420419()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА &ВерсияТаксономии >= ""5_2""
		|			ТОГДА Договоры.Контрагент
