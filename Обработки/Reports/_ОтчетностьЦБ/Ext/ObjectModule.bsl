Процедура ОКУД0420409_ОпределитьКурсВалютыПоОперации(СтрокаДанных, СделкаСВалютой)
	
	Если СделкаСВалютой.Валюта = СтрокаДанных.Валюта И СделкаСВалютой.Контрвалюта = ЭтотОбъект.ВалютаУчета Тогда
		СтрокаДанных.Курс		= СделкаСВалютой.Курс;
		СтрокаДанных.Кратность	= 1;
	ИначеЕсли СделкаСВалютой.Контрвалюта = СтрокаДанных.Валюта И СделкаСВалютой.Валюта = ЭтотОбъект.ВалютаУчета Тогда
		СтрокаДанных.Курс		= 1;
		СтрокаДанных.Кратность	= СделкаСВалютой.Курс;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОКУД0420409_XBRL_ЗаполнитьПечатнуюФорму(Запрос, Результат, Отказ) Экспорт
	
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Результат.АвтоМасштаб = Ложь;
	Результат.МасштабПечати = 100;
	
	SR_INFO_ВыполнитьЗапрос(Запрос, Отказ);
	
	Запрос.Текст = ОКУД0420409_XBRL_ТекстЗапроса_ПечатнаяФорма();
	Запрос.Выполнить();
	
	Макет = ПолучитьМакет("ОКУД0420409");
	
	ДанныеШапки = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_Шапка", Отказ)[0];
	
#Область Шапка
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДанныеШапки);
	ОбластьШапка.Параметры.ДатаОкончания = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	Результат.Вывести(ОбластьШапка);
#КонецОбласти		
	
#Область Раздел1
	Результат.Вывести(Макет.ПолучитьОбласть("Раздел1Шапка"));
	Для Каждого СтрокаДанных Из ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_Раздел1", Отказ) Цикл
		ОбластьРаздел1Строка = Макет.ПолучитьОбласть("Раздел1Строка");
		ЗаполнитьЗначенияСвойств(ОбластьРаздел1Строка.Параметры, СтрокаДанных);
		Результат.Вывести(ОбластьРаздел1Строка);
	КонецЦикла;
#КонецОбласти

#Область Раздел2
	Если ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		Результат.Вывести(Макет.ПолучитьОбласть("Раздел2Шапка"));
		Для Каждого СтрокаДанных Из ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_Раздел2", Отказ) Цикл
			ОбластьРаздел2Строка = Макет.ПолучитьОбласть("Раздел2Строка");
			ЗаполнитьЗначенияСвойств(ОбластьРаздел2Строка.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьРаздел2Строка);
		КонецЦикла;
	КонецЕсли;
#КонецОбласти

#Область Подвал
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры, ДанныеШапки);
	Результат.Вывести(ОбластьПодвал);
#КонецОбласти		

	
КонецПроцедуры

