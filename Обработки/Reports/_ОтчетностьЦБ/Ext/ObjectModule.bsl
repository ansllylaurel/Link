#Область ОКУД0420503_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420503(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420503";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);

	Если ЭтотОбъект.СформироватьНулевойОтчет Тогда
		ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, Истина, Отказ);
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПолучитьДанные_ОКУД0420503_ВыполнитьПредварительныеЗапросы(Запрос, Отказ);
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных,, Отказ);

	Возврат ПакетДанных;

КонецФункции

Функция ПолучитьДанные_ОКУД0420503_ПриростСовпадаетСРазницойСЧА(Запрос)
	
	Отказ = Ложь;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Значение КАК Сумма
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1), ДЕНЬ)
		|	И ФинансовыеПоказатели.Активность
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	0
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		|ГДЕ
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, ДАТАВРЕМЯ(1, 1, 1)) > НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1), ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Значение КАК Сумма
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	И ФинансовыеПоказатели.Активность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма
		|ИЗ
		|	(ВЫБРАТЬ
		|		ФинансовыеПоказатели.Значение * ВЫБОР
		|			КОГДА ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|				ТОГДА 1
		|			ИНАЧЕ -1
		|		КОНЕЦ КАК Сумма
		|	ИЗ
		|		РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|	ГДЕ
		|		ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|		И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|		И ФинансовыеПоказатели.Организация = &Организация
		|		И (ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, -1), ДЕНЬ)
		|				ИЛИ ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ))
		|		И ФинансовыеПоказатели.Активность
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-ВТ_КодыСтрок.Сумма
		|	ИЗ
		|		ВТ_КодыСтрок КАК ВТ_КодыСтрок
		|	ГДЕ
		|		ВТ_КодыСтрок.КодСтроки0 = ""14"") КАК ВложенныйЗапрос
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВложенныйЗапрос.Сумма) <> 0";
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Если Пакет[0].Выбрать().Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счёта ДУ: " + ЭтотОбъект.СчетДоверительногоУправления + " не зарегистрирована СЧА на " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"),,,,Отказ);
	КонецЕсли;
	
	Если Пакет[1].Выбрать().Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счёта ДУ: " + ЭтотОбъект.СчетДоверительногоУправления + " не зарегистрирована СЧА на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"),,,,Отказ);
	КонецЕсли;
	
	Выборка = Пакет[2].Выбрать();
	Если Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для Счёта ДУ: " + ЭтотОбъект.СчетДоверительногоУправления + " сумма прироста не равна разнице СЧА на начало и конец отчётного периода. Разница между приростом и изменением СЧА: " + Выборка.Сумма,,,,Отказ);
	КонецЕсли;
		
	Возврат Не Отказ;
	
КонецФункции

Функция ПолучитьДанные_ОКУД0420503_НачисленияПоКупонуРавноОплате(Запрос)
	
	Отказ = Ложь;
	
	ОплатаКупона = Запрос.МенеджерВременныхТаблиц.Таблицы["ВТ_ОплатаКупона"].ПолучитьДанные().Выгрузить();
	
	ПараметрыПоиска = Новый Структура("ОплатаРавнаНачислению", ЛОЖЬ);
	НайденныеСтроки = ОплатаКупона.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Оплата купона по документу " + СтрокаДанных.Регистратор + ", нет возможности рассчитать возвратный купон!",,,, Отказ);
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

Процедура ЗаполнитьПечатнуюФорму_ОКУД0420503(Запрос, Результат, ИмяМакета, Отказ) Экспорт

	ПолучитьДанные_ОКУД0420503_ВыполнитьПредварительныеЗапросы(Запрос, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Результат.Очистить();
	
	Макет = ПолучитьМакет(ИмяМакета);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры,  ПолучитьДисклеймер(Запрос, Отказ));
	Результат.Вывести(ОбластьШапка);
	
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел1", Отказ);
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел2", Отказ);
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3", Отказ);
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3События", Отказ);
	Если ВерсияТаксономии >= "5_2" Тогда
		ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел3РасходыДУ", Отказ,, "КодРасходаДУ503");
	КонецЕсли;
	
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел4", Отказ);
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Раздел4Эмитенты", Отказ);
	
	МассивОбластейДляВывода = Новый Массив;
	
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "РазделРеквизитыСпецДепозитария", Отказ, МассивОбластейДляВывода);
	ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, "Подписанты", Отказ, МассивОбластейДляВывода);
	
	ВывестиМассивОбластей(Результат, МассивОбластейДляВывода);
	
	Результат.АвтоМасштаб = Истина;
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
КонецПроцедуры

Процедура ПолучитьДанные_ОКУД0420503_ПечатнаяФорма_ВывестиРаздел(Результат, Макет, Запрос, ИмяСекции, Отказ, МассивОбластейДляВывода = Неопределено, ПоляСортировки = "")

	Если МассивОбластейДляВывода = Неопределено Тогда
		МассивОбластейДляВывода = Новый Массив;
		ВывестиМассивОбластей = Истина;
	Иначе
		ВывестиМассивОбластей = Ложь;
	КонецЕсли;

	Если Макет.Области.Найти(Имясекции + "Шапка") <> Неопределено Тогда
		МассивОбластейДляВывода.Добавить(Макет.ПолучитьОбласть(Имясекции + "Шапка"));
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "КодыСтрок") <> Неопределено Тогда
		ОбластьКодыСтрок = Макет.ПолучитьОбласть(Имясекции + "КодыСтрок");
		
		Данные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ПечатнаяФорма_" + ИмяСекции + "_КодыСтрок").ПолучитьДанные().Выгрузить();
		
		Если Макет.Области.Найти(Имясекции + "Расшифровка") <> Неопределено Тогда
			ДанныеРасшифровки = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ПечатнаяФорма_" + ИмяСекции + "_Расшифровка").ПолучитьДанные().Выгрузить();
		КонецЕсли;
		
		ОбластьШапка = Макет.ПолучитьОбласть(Имясекции + "Шапка");
		Для НомерКолонки = 1 По ОбластьШапка.ШиринаТаблицы Цикл
			Заголовок = ОбластьШапка.Область(4, НомерКолонки, 4, НомерКолонки).Текст;
			Заголовок = СтрЗаменить(Заголовок, Символы.ПС, " ");
			Если Заголовок = "Код строки" Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для НомерСтроки = 1 По ОбластьКодыСтрок.ВысотаТаблицы Цикл
			
			ОбластьСтрока	= ОбластьКодыСтрок.ПолучитьОбласть(НомерСтроки, 1, НомерСтроки, ОбластьКодыСтрок.ШиринаТаблицы);
			КодСтроки		= ОбластьКодыСтрок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст;
			
			КодыСтроки		= СтрРазделить(КодСтроки, ".");
			ПараметрыОтбора = Новый Структура;
			
			Для Индекс = 0 По КодыСтроки.ВГраница() Цикл
				ПараметрыОтбора.Вставить("КодСтроки" + Индекс, КодыСтроки[Индекс]);
			КонецЦикла;

			НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
			Показатели = Новый Структура("ОборотПоПокупке, ОборотПоПродаже, Сумма, ОписаниеРасшифровки");
			
			Для Каждого Показатель Из Показатели Цикл
				Если Данные.Колонки.Найти(Показатель.Ключ) <> Неопределено Тогда
					Показатели.Вставить(Показатель.Ключ, ИтогПоНайденнымСтрокам(НайденныеСтроки, Показатель.Ключ));
				КонецЕсли;
			КонецЦикла;
			
			ОбластьСтрока.Параметры.Заполнить(Показатели);	
			МассивОбластейДляВывода.Добавить(ОбластьСтрока);
			
			Если Макет.Области.Найти(Имясекции + "Расшифровка") <> Неопределено Тогда
				
				Для Индекс = 0 По 2 Цикл
					Если НЕ ПараметрыОтбора.Свойство("КодСтроки" + Индекс) И ДанныеРасшифровки.Колонки.Найти("КодСтроки" + Индекс) <> Неопределено Тогда
						ПараметрыОтбора.Вставить("КодСтроки" + Индекс, "00");
					КонецЕсли;
				КонецЦикла;
				
				НайденныеСтроки = ДанныеРасшифровки.НайтиСтроки(ПараметрыОтбора);
				Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
					ОбластьРасшифровка = Макет.ПолучитьОбласть(Имясекции + "Расшифровка");
					ОбластьРасшифровка.Параметры.Заполнить(СтрокаДанных);
					МассивОбластейДляВывода.Добавить(ОбластьРасшифровка);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Макет.Области.Найти(Имясекции + "Строка") <> Неопределено Тогда
		
		Данные = СформироватьМассивСтрокДляПечатнойФормы(Запрос, "ПечатнаяФорма_" + ИмяСекции, ПоляСортировки, Отказ);
		
		Для Каждого СтрокаДанных Из Данные Цикл
			ОбластьСтрока = Макет.ПолучитьОбласть(Имясекции + "Строка");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			МассивОбластейДляВывода.Добавить(ОбластьСтрока);	
		КонецЦикла;
	КонецЕсли;
	
	Если ВывестиМассивОбластей Тогда
		ВывестиМассивОбластей(Результат, МассивОбластейДляВывода);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьРеквизитыПИФСчетаДУ()
	
	РеквизитыПИФ = Новый Структура("ПИФ, ДатаПравил, ДатаОкончанияФормирования");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ПИФ,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент.ДатаПравил КАК ДатаПравил,
		|	ЕСТЬNULL(ЗначенияДополнительныхСведений.Значение, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияФормирования
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаОкончания"				, ЭтотОбъект.Период.ДатаОкончания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыПИФ, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыПИФ;
	
КонецФункции

#КонецОбласти

//Отчет о вознаграждениях и расходах, связанных с доверительным управлением имуществом, составляющим паевой инвестиционный фонд
#Область ОКУД0420505

Функция ПолучитьДанные_XBRL_ОКУД0420505(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420505";
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ПолучитьДанные_XBRL_ОКУД0420505_ВыполнитьПредварительныеЗапросы(Запрос, Отказ);
	
	Если ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_НеРаспределенные", Отказ).Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Есть нераспределённые расходы - см. отчёт. Укажи группу отчёта в дополнительных свойствах Прочего расхода. XBRL файл не сформирован.",,,, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета),,, Отказ);
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных,, Отказ);

	Возврат ПакетДанных;

КонецФункции

Процедура ПолучитьДанные_XBRL_ОКУД0420505_ВыполнитьПредварительныеЗапросы(Запрос, Отказ)
	
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);

	Если ЭтотОбъект.ВерсияТаксономии >= "4_2" Тогда
		Запрос.УстановитьПараметр("ГраницаНачала", Новый Граница(ЭтотОбъект.Период.ДатаНачала, ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("ГраницаНачала", Новый Граница(ДобавитьМесяц(ЭтотОбъект.Период.ДатаНачала, -12), ВидГраницы.Включая));
	КонецЕсли;
	
