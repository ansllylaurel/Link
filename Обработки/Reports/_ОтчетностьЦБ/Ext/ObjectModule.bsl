Процедура КонтрольКвартальныхПоказателей()
	
	МассивОшибок = Новый Массив;
	
	ПараметрыРасчета = Новый Структура("ДатаРасчета, Организация, Период", ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Организация, ЭтотОбъект.Период);
	
	КатегорияПрофУчастника	= РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьКатегориюПрофУчастника(ПараметрыРасчета, Ложь);
	РасшифровкаРасчета		= РаботаСОтчетностьюЦБ.ОКУД0420401_РассчитатьКатегориюПрофУчастникаНаОснованииКвартальныхПоказателей(ПараметрыРасчета, Ложь);
	
	ДатаРасчета = Неопределено;
	
	Если РасшифровкаРасчета <> Неопределено Тогда
		Если ЗначениеЗаполнено(КатегорияПрофУчастника) И РасшифровкаРасчета.Значение <> КатегорияПрофУчастника Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Расчётное значение показателя %1 (%2) не соответствует зарегистрированному (%3) на %4 год.",
					РасшифровкаРасчета.ВидПоказателя,
					РасшифровкаРасчета.Значение,
					КатегорияПрофУчастника,
					Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=yyyy")));
		КонецЕсли;
		
		Для Каждого СтрокаРасшифровки Из РасшифровкаРасчета.Расшифровка Цикл
			Если ДатаРасчета <> СтрокаРасшифровки.Дата Тогда
				Запрос = Новый Запрос;
				Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
				Запрос.УстановитьПараметр("ВерсияТаксономии", ВерсияТаксономииПоГоду()); 
				ДатаРасчета = СтрокаРасшифровки.Дата;
			КонецЕсли;
				
			СтрокаПоказателя = РасшифровкаРасчета.ВидыПоказателей.НайтиСтроки(Новый Структура("ВидПоказателя,ДатаНачала,ДатаОкончания", СтрокаРасшифровки.ВидПоказателя, СтрокаРасшифровки.ВидПоказателяДатаНачала, СтрокаРасшифровки.ВидПоказателяДатаОкончания))[0];
			ПараметрыРасчета.Вставить("Период", Новый СтандартныйПериод(НачалоКвартала(ДатаРасчета), КонецКвартала(ДатаРасчета)));
			РасчетноеЗначение = Вычислить("РаботаСОтчетностьюЦБ."  + СтрокаПоказателя.Функция);
			
			Если РасчетноеЗначение <> СтрокаРасшифровки.ЗначениеПоказателя Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон("Расчётное значение показателя %1 (%2)  не соответствует зарегистрированному (%3) на %4.",
						СтрокаРасшифровки.ВидПоказателя,
						РасчетноеЗначение,
						СтрокаРасшифровки.ЗначениеПоказателя,
						Формат(ДатаРасчета, "ДФ=dd.MM.yyyy")));
			КонецЕсли;	
			
		КонецЦикла;	
	КонецЕсли;	
	
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		МассивОшибок.Добавить(Сообщение.Текст);
	КонецЦикла;	
	
	Если МассивОшибок.Количество() Тогда
		РеквизитыОповещения = Новый Структура();								
		РеквизитыОповещения.Вставить("Организация",	ЭтотОбъект.Организация);
		РеквизитыОповещения.Вставить("Текст", 		СтрСоединить(МассивОшибок, "<br>"));
						
		Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя() + "_КонтрольКвартальныхПоказателей", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
	КонецЕсли;	
	
КонецПроцедуры

// Возвращает параметры выполняемой по регламентному заданию команды для подключения к механизму регистрации работы
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды  
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды)
	ПараметрыОтчета = Новый Соответствие();
	ПараметрыОтчета.Вставить("Организация", ЭтотОбъект.Организация);
	ПараметрыОтчета.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Период) Тогда
		ПараметрыОтчета.Вставить("Период", ЭтотОбъект.Период);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭтотОбъект.ДатаОтчетности) Тогда
		ПараметрыОтчета.Вставить("ДатаОтчетности", ЭтотОбъект.ДатаОтчетности);
	КонецЕсли;	
	
	Описание = "";
	Для Каждого ПараметрОтчета Из ПараметрыОтчета Цикл
		Описание = Описание + ПараметрОтчета.Ключ + ": " + ПараметрОтчета.Значение + Символы.ПС;		
	КонецЦикла;
	Описание = Лев(Описание, СтрДлина(Описание) - СтрДлина(Символы.ПС));	
		
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание",
		Новый ХранилищеЗначения(ПараметрыОтчета),
		Описание
	);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

