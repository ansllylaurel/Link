	ПараметрыПоиска.Вставить("ДатаОкончания",	НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	
	СведенияОСобытияхКоторыеОказалиСущественноеВлияниеНаСЧА = ПолучитьТаблицуИзМакета("ОКУД0420502СведенияОСобытияхКоторыеОказалиСущественноеВлияниеНаСЧА",,, ПараметрыПоиска);
	
	Если НЕ СведенияОСобытияхКоторыеОказалиСущественноеВлияниеНаСЧА.Количество() Тогда
	
	#Область ТекстЗапроса
		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420503_Общий() + ";" + 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(ВЫБОР
			|			КОГДА ФинансовыеПоказатели.Период = &ДатаНачала
			|				ТОГДА ФинансовыеПоказатели.Значение
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК СЧА_НаНачало,
			|	СУММА(ВЫБОР
			|			КОГДА ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
			|				ТОГДА ФинансовыеПоказатели.Значение
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК СЧА_НаКонец
			|ПОМЕСТИТЬ _ФинансовыеПоказатели
			|ИЗ
			|	ВТ_СтоимостьЧистыхАктивов КАК ФинансовыеПоказатели
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВТ_РасшифровкаОтчета.КодСтроки КАК КодСтроки,
			|	ВТ_РасшифровкаОтчета.Субконто1 КАК Субконто1,
			|	ВТ_РасшифровкаОтчета.Субконто2 КАК Субконто2,
			|	СУММА(ВТ_РасшифровкаОтчета.Сумма) КАК Сумма
			|ПОМЕСТИТЬ ВТ_РасшифровкаОтчета_Итоги
			|ИЗ
			|	ВТ_РасшифровкаОтчета КАК ВТ_РасшифровкаОтчета
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_РасшифровкаОтчета.Субконто1,
			|	ВТ_РасшифровкаОтчета.Субконто2,
			|	ВТ_РасшифровкаОтчета.КодСтроки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_РасшифровкаОтчета_Итоги.КодСтроки КАК КодСтроки,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(_ФинансовыеПоказатели.СЧА_НаНачало, 0) = 0
			|			ТОГДА 100
			|		ИНАЧЕ 100 * (_ФинансовыеПоказатели.СЧА_НаКонец - _ФинансовыеПоказатели.СЧА_НаНачало) / _ФинансовыеПоказатели.СЧА_НаНачало
			|	КОНЕЦ КАК ИзменениеСЧА,
			|	ВТ_РасшифровкаОтчета_Итоги.Субконто1 КАК Субконто1,
			|	ВТ_РасшифровкаОтчета_Итоги.Субконто2 КАК Субконто2,
			|	СУММА(ВТ_РасшифровкаОтчета_Итоги.Сумма) КАК Сумма
			|ПОМЕСТИТЬ _НаиболееЗначимыеСобытия
			|ИЗ
			|	ВТ_РасшифровкаОтчета_Итоги КАК ВТ_РасшифровкаОтчета_Итоги,
			|	_ФинансовыеПоказатели КАК _ФинансовыеПоказатели
			|ГДЕ
			|	ЕСТЬNULL(_ФинансовыеПоказатели.СЧА_НаНачало, 0) <> 0
			|	И ВЫБОР
			|			КОГДА ЕСТЬNULL(_ФинансовыеПоказатели.СЧА_НаНачало, 0) = 0
			|				ТОГДА 100
			|			ИНАЧЕ 100 * (_ФинансовыеПоказатели.СЧА_НаКонец - _ФинансовыеПоказатели.СЧА_НаНачало) / _ФинансовыеПоказатели.СЧА_НаНачало * ВЫБОР
			|					КОГДА _ФинансовыеПоказатели.СЧА_НаКонец - _ФинансовыеПоказатели.СЧА_НаНачало < 0
			|						ТОГДА -1
			|					ИНАЧЕ 1
			|				КОНЕЦ
			|		КОНЕЦ > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_РасшифровкаОтчета_Итоги.КодСтроки,
			|	_ФинансовыеПоказатели.СЧА_НаНачало,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(_ФинансовыеПоказатели.СЧА_НаНачало, 0) = 0
			|			ТОГДА 100
			|		ИНАЧЕ 100 * (_ФинансовыеПоказатели.СЧА_НаКонец - _ФинансовыеПоказатели.СЧА_НаНачало) / _ФинансовыеПоказатели.СЧА_НаНачало
			|	КОНЕЦ,
			|	ВТ_РасшифровкаОтчета_Итоги.Субконто1,
			|	ВТ_РасшифровкаОтчета_Итоги.Субконто2
			|
			|ИМЕЮЩИЕ
			|	(100 * СУММА(ВТ_РасшифровкаОтчета_Итоги.Сумма) / _ФинансовыеПоказатели.СЧА_НаНачало >= ВЫБОР
			|			КОГДА &ВерсияТаксономии <= ""4_2""
			|				ТОГДА 5
			|			ИНАЧЕ 10
			|		КОНЕЦ
			|		ИЛИ 100 * СУММА(ВТ_РасшифровкаОтчета_Итоги.Сумма) / _ФинансовыеПоказатели.СЧА_НаНачало <= ВЫБОР
			|			КОГДА &ВерсияТаксономии <= ""4_2""
			|				ТОГДА -5
			|			ИНАЧЕ -10
			|		КОНЕЦ)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_НаиболееЗначимыеСобытия.Субконто1 КАК Субконто1,
			|	_НаиболееЗначимыеСобытия.Субконто2 КАК Субконто2,
			|	ПОДСТРОКА(_НаиболееЗначимыеСобытия.КодСтроки, 1, 2) КАК КодСтроки,
			|	ВЫРАЗИТЬ(_НаиболееЗначимыеСобытия.ИзменениеСЧА КАК ЧИСЛО(19, 2)) КАК ИзменениеСЧА,
			|	ВЫБОР
			|		КОГДА _НаиболееЗначимыеСобытия.Сумма < 0
			|			ТОГДА -_НаиболееЗначимыеСобытия.Сумма
			|		ИНАЧЕ _НаиболееЗначимыеСобытия.Сумма
			|	КОНЕЦ КАК Сумма,
			|	&IdAifPifTaxis КАК IdAifPifTaxis,
			|	1 КАК ID_strokiTaxis
			|ПОМЕСТИТЬ _РезультатЗапроса
			|ИЗ
			|	_НаиболееЗначимыеСобытия КАК _НаиболееЗначимыеСобытия
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ВТ_РасшифровкаОтчета.Субконто1,
			|	ВТ_РасшифровкаОтчета.Субконто2,
			|	ПОДСТРОКА(ВТ_РасшифровкаОтчета.КодСтроки, 1, 2),
			|	ВложенныйЗапрос.ИзменениеСЧА,
			|	ВЫБОР
			|		КОГДА СУММА(ВТ_РасшифровкаОтчета.Сумма) < 0
			|			ТОГДА -СУММА(ВТ_РасшифровкаОтчета.Сумма)
			|		ИНАЧЕ СУММА(ВТ_РасшифровкаОтчета.Сумма)
			|	КОНЕЦ,
			|	&IdAifPifTaxis,
			|	1
			|ИЗ
			|	(ВЫБРАТЬ
			|		ВТ_РасшифровкаОтчета.КодСтроки КАК КодСтроки,
			|		100 КАК ИзменениеСЧА
			|	ИЗ
			|		ВТ_РасшифровкаОтчета КАК ВТ_РасшифровкаОтчета,
			|		_ФинансовыеПоказатели КАК _ФинансовыеПоказатели
			|	ГДЕ
			|		ЕСТЬNULL(_ФинансовыеПоказатели.СЧА_НаНачало, 0) = 0
			|		И ТИПЗНАЧЕНИЯ(ВТ_РасшифровкаОтчета.Субконто1) = ТИП(Документ.ЗачислениеПаев)
			|		И ВЫБОР
			|				КОГДА &ЭтоРПИ
			|						И &ДатаОкончанияФормированияПИФ <> ДАТАВРЕМЯ(1, 1, 1)
			|					ТОГДА ВЫРАЗИТЬ(ВТ_РасшифровкаОтчета.Субконто1 КАК Документ.ЗачислениеПаев).Дата <= &ДатаОкончанияФормированияПИФ
			|				ИНАЧЕ ИСТИНА
			|			КОНЕЦ
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ВТ_РасшифровкаОтчета.КодСтроки) КАК ВложенныйЗапрос
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасшифровкаОтчета КАК ВТ_РасшифровкаОтчета
			|		ПО ВложенныйЗапрос.КодСтроки = ВТ_РасшифровкаОтчета.КодСтроки
			|ГДЕ
			|	ВЫБОР
			|			КОГДА &ЭтоРПИ
			|					И &ДатаОкончанияФормированияПИФ <> ДАТАВРЕМЯ(1, 1, 1)
			|				ТОГДА ВЫРАЗИТЬ(ВТ_РасшифровкаОтчета.Субконто1 КАК Документ.ЗачислениеПаев).Дата <= &ДатаОкончанияФормированияПИФ
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_РасшифровкаОтчета.Субконто1,
			|	ВТ_РасшифровкаОтчета.Субконто2,
			|	ПОДСТРОКА(ВТ_РасшифровкаОтчета.КодСтроки, 1, 2),
			|	ВложенныйЗапрос.ИзменениеСЧА";
		
	#КонецОбласти

		Запрос.УстановитьПараметр("ГраницаНачалаПрироста"				, Новый Граница(ЭтотОбъект.Период.ДатаНачала + 60 * 60 * 24, ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ГраницаОкончанияПрироста"			, Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
		
		Запрос.УстановитьПараметр("ВидыРасходовДУ", ПолучитьТаблицуИзМакета("ОКУД0420505_ОКУД0420503_ВидыПоказателей",,, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии)));
		
		//Для новых ПИФ нужно включить зачисление и погашение паёв до даты окончания формирования ПИФ
		РеквизитыПИФ = ПолучитьРеквизитыПИФСчетаДУ();
		Если РеквизитыПИФ.ДатаОкончанияФормирования > ЭтотОбъект.Период.ДатаНачала Тогда
			Запрос.УстановитьПараметр("ГраницаНачалаВыдачиПогашенияПаев"	, Новый Граница(РеквизитыПИФ.ДатаПравил, ВидГраницы.Включая));	
		Иначе
			Запрос.УстановитьПараметр("ГраницаНачалаВыдачиПогашенияПаев"	, Новый Граница(ЭтотОбъект.Период.ДатаНачала + 60 * 60 * 24, ВидГраницы.Включая));
		КонецЕсли;
		// Пока только для РПИ, чтобы отсечь зачисления паев после даты окончания формирования ПИФ
		Запрос.УстановитьПараметр("ДатаОкончанияФормированияПИФ", КонецДня(РеквизитыПИФ.ДатаОкончанияФормирования));    
	
		НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("АналитикаУчетаРезервовДебиторскойЗадолженности", НастройкиУчета.АналитикаУчетаРезервовДебиторскойЗадолженности);
		Запрос.УстановитьПараметр("АналитикаПереоценкиДебиторскойЗадолженности", НастройкиУчета.АналитикаПереоценкиДебиторскойЗадолженности);
		Запрос.УстановитьПараметр("АналитикаИзмененияСтоимостиДебиторскойЗадолженностиВРезультатеСделок", НастройкиУчета.АналитикаИзмененияСтоимостиДебиторскойЗадолженностиВРезультатеСделок);

		Запрос.УстановитьПараметр("АналитикаОплатыПоДоговорамВТомЧислеПоДоговорамАренды", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПРД_ОплатаПоДоговорам"));
		Запрос.УстановитьПараметр("ПДР_ДоходОтРеализацииНедвижимости", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДоходОтРеализацииНедвижимости"));
		Запрос.УстановитьПараметр("ПДР_РасходыПоПолучениюВАренду", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_РасходыПоПолучениюВАренду"));
		
		ОписаниеСобытия = "";
		КодСтроки = Неопределено;
		Субконто2 = Неопределено;
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Справочники.ВидыЗадолженности.ПолучитьТаблицуАналитикиДляПредварительныхНачислений(), "_АналитикаДляПредварительныхНачислений", Запрос);
	
		Запрос.Выполнить();
		
		Если НЕ ПолучитьДанные_ОКУД0420503_НачисленияПоКупонуРавноОплате(Запрос) Тогда
			Отказ = Истина;
		КонецЕсли;

		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_РезультатЗапроса"].ПолучитьДанные().Выбрать();
		
		СведенияОСущественномИзмененииСЧАВПроцентах = ПолучитьЗначениеНастройкиОтчета("СведенияОСущественномИзмененииСЧАВПроцентах", Ложь, Отказ); 
		
		Пока Выборка.Следующий() Цикл 		
			СтрокаСобятия = СведенияОСобытияхКоторыеОказалиСущественноеВлияниеНаСЧА.Добавить();
			
			Если Выборка.ИзменениеСЧА <> 100 Тогда
				Если СведенияОСущественномИзмененииСЧАВПроцентах Тогда
					СтрокаСобятия.ОписаниеСобытия = "Изменение СЧА на " + Выборка.ИзменениеСЧА + "%";			
				Иначе
					СтрокаСобятия.ОписаниеСобытия = "Изменение СЧА";			
				КонецЕсли;
			КонецЕсли;
						
			Если КодСтроки <> Выборка.КодСтроки Тогда
				СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + ?(КодСтроки = Неопределено, " ", ", ");
				КодСтроки = Выборка.КодСтроки;
				
				Если КодСтроки = "01" Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате сделок с имуществом:";
				ИначеЕсли КодСтроки = "02" Тогда
					Если ТипЗнч(Выборка.Субконто2) = Тип("СправочникСсылка.Паи") Тогда
						СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате изменения справедливой стоимости ";
					ИначеЕсли ТипЗнч(Выборка.Субконто2) = Тип("СправочникСсылка.Доли") Тогда
						СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате переоценки долей";
					Иначе
						СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате переоценки ценных бумаг";
					КонецЕсли;
				ИначеЕсли КодСтроки = "03" Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате получения дохода по имуществу";
					
				ИначеЕсли КодСтроки = "09" И ТипЗнч(Выборка.Субконто2) = Тип("СправочникСсылка.Займы")  Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате переоценки полученных займов";
					
				ИначеЕсли КодСтроки = "10" И Выборка.ИзменениеСЧА = 100 Тогда
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "В отчетном периоде завершено формирование Фонда";
				ИначеЕсли КодСтроки = "10" Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате выдачи инвестиционных паев";

				ИначеЕсли КодСтроки = "11" И Выборка.Субконто2 = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате частичного погашения инвестиционных паев паевого инвестиционного фонда";
					
				ИначеЕсли КодСтроки = "11" И Выборка.Субконто2 = Перечисления.ВариантыПогашенияПаев.ПриЗакрытииПИФ Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате погашения инвестиционных паев паевого инвестиционного фонда при прекращении фонда";
					
				ИначеЕсли КодСтроки = "11" Тогда 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "в результате погашения инвестиционных паев паевого инвестиционного фонда";
						
				Иначе 
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + "код строки " + КодСтроки + " ";
				КонецЕсли;
				
			КонецЕсли;	
			
			ДетализацияДоБумаги = Истина;
			
			Если (КодСтроки = "02" И ЭтотОбъект.Период.ДатаОкончания > Дата(2020,3,1))
				ИЛИ (КодСтроки = "09" И ТипЗнч(Выборка.Субконто2) = Тип("СправочникСсылка.Займы"))
				ИЛИ Выборка.Субконто2 = Перечисления.ВариантыПогашенияПаев.ЧастичноеПоРешениюУК
				ИЛИ Выборка.Субконто2 = Перечисления.ВариантыПогашенияПаев.ПриЗакрытииПИФ Тогда
				ДетализацияДоБумаги = Ложь;
			КонецЕсли;
			
			Если ДетализацияДоБумаги И Субконто2 <> Выборка.Субконто2 Тогда
				СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + ?(Субконто2 = Неопределено, " ", ", ");
				Субконто2 = Выборка.Субконто2;
				
				Если Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.Типы().Найти(ТипЗнч(Субконто2)) = Неопределено Тогда
					СтрокаСобятия.ОписаниеСобытия = СтрокаСобятия.ОписаниеСобытия + Строка(Субконто2); 
				Иначе
									
					Если ТипЗнч(Субконто2) = Тип("СправочникСсылка.Акции") Тогда
