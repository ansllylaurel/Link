Функция ПолучитьДанные_ОКУД0420502_ТаблицыРасшифровки(Запрос,  ИмяТаблицы, ИмяСтроки, ИмяСтрокиИтогов, Отказ = Ложь)

	ТаблицыРасшифровки = Новый Структура;
	
	ФорматныеСтроки = Новый Структура;
	
	ТаблицаРасшифровки = ВыгрузитьВременнуюТаблицу(Запрос, ИмяСтроки);
	ОкруглениеРесурсовТаблицы(ТаблицаРасшифровки, 2, ФорматныеСтроки);
	
	ТаблицаИтогов = ВыгрузитьВременнуюТаблицу(Запрос, ИмяСтрокиИтогов);
	ОкруглениеРесурсовТаблицы(ТаблицаИтогов, 2, ФорматныеСтроки);
	
	ТаблицыРасшифровки.Вставить(ИмяСтроки		, СформироватьМассивСтрок(ТаблицаРасшифровки,ФорматныеСтроки,"",, Ложь, Отказ));
	ТаблицыРасшифровки.Вставить(ИмяСтрокиИтогов	, СформироватьМассивСтрок(ТаблицаИтогов,ФорматныеСтроки,"",,, Отказ)[0]);
	
	Возврат Новый Структура(ИмяТаблицы, ТаблицыРасшифровки);

КонецФункции

Функция ПолучитьДанные_ОКУД0420502_ПустыеТаблицыРасшифровки(ИмяТаблицы, ИмяСтрокиИтогов, Измерения, Ресурсы)
	
	МассивИзмерений = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Измерения);
	МассивРесурсов	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Ресурсы);
	
	СтрокаИтогов = Новый Структура;
	СтрокаИтогов.Вставить(МассивИзмерений[0], "Итого");
	
	Для Индекс = 1 По МассивИзмерений.Количество() - 1 Цикл
		СтрокаИтогов.Вставить(МассивИзмерений[Индекс], "х");
	КонецЦикла;
	
	Для Индекс = 0 По МассивРесурсов.Количество() - 1 Цикл
		СтрокаИтогов.Вставить(МассивРесурсов[Индекс], 0);
	КонецЦикла;
	
	Возврат Новый Структура(ИмяТаблицы, Новый Структура(ИмяСтрокиИтогов, СтрокаИтогов));
	
КонецФункции

