		|			ИЛИ _СтоимостьАктивовСтраховыхКомпаний.Актив ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|				И ВЫРАЗИТЬ(_СтоимостьАктивовСтраховыхКомпаний.Актив КАК Справочник.ИпотечныеСертификатыУчастия).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.КСУ))";
	
	#КонецОбласти
	
	Запрос.Выполнить();
	 	 	
	Возврат Запрос; 
	
	
КонецФункции
	
#КонецОбласти

#КонецОбласти

// Отчетность о результатах осуществления специальным депозитарием контроля страховщиков. Версия 2.16.3 (ДК).
#Область ОКУД420870

Функция ПолучитьДанные_ОКУД0420870(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXML Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	ПакетДанных.Вставить( "ИмяОтчета"			, "ОКУД0420870_2_16_3_1" );
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420870_2_16_3_1_ОКУД0420870_2_16_3_1" );
	ПакетДанных.Вставить("ВерсияОтчета"			, "2.16.3.1" );
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	Отчет = Новый Структура();
		
	ПакетДанных.Отчет.Вставить("Лист_Отчетность", Отчет);

	#Область Заголовок 
	
	Отчет.Вставить("ПоСостояниюМесяц"			, Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=MMMM"));	
	Отчет.Вставить("ПоСостояниюГод"				, Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=гггг") + " г.");	 	        	
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Организация,
	|	Организации.ЮрФизЛицо КАК ЮрФизЛицо,
	|	Лицензии.ВидДеятельности КАК ВидДеятельности,
	|	Лицензии.Ссылка КАК Лицензия
	|ПОМЕСТИТЬ _ДействующиеЛицензииОрганизации
	|ИЗ
	|	РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК СтатусыЛицензийСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|			ПО (Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо)
	|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаимен,
	|	ЛицензияДепозитарнаяДеятельность.Лицензия.Номер КАК НомерЛицензииОсущДепДеят,
	|	ЛицензияСпецдепозитарий.Лицензия.Номер КАК НомерЛицензииПИФ_НПФ,
	|	""-"" КАК РегистрацНомерКредОрг,
	|	""45286590000"" КАК КодПо_ОКАТО,
	|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН1,
	|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН1
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияСпецдепозитарий
	|		ПО Организации.Ссылка = ЛицензияСпецдепозитарий.Организация
	|			И (ЛицензияСпецдепозитарий.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиВКачествеСпециализированногоДепозитарияИнвестиционныхФондовИПИФ))
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияДепозитарнаяДеятельность
	|		ПО Организации.Ссылка = ЛицензияДепозитарнаяДеятельность.Организация
	|			И (ЛицензияДепозитарнаяДеятельность.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДепозитарнойДеятельности))
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО Организации.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
	|				&Период,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
	|		ПО (Организации.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|				И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период))
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ПараметрыДокумента = Запрос.Выполнить();
	ПоляДокумента = ПараметрыДокумента.Колонки;
	ВыборкаПараметрыДокумента = ПараметрыДокумента.Выбрать();
	
	Если ВыборкаПараметрыДокумента.Следующий() Тогда
		
		Для Каждого Колонка из ПоляДокумента Цикл
			Отчет.Вставить(Колонка.Имя, ВыборкаПараметрыДокумента[Колонка.Имя]);
		КонецЦикла; 		
		
	КонецЕсли;

	#КонецОбласти
	
	Раздел1 = Новый Структура();
	Отчет.Вставить("Раздел1_СведОрезульт"		, Раздел1);
	Раздел1.Вставить("Таблица1_Раздел1", Новый Структура());
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетаДоверительногоУправления.Ссылка КАК СчетУчета
	|ПОМЕСТИТЬ _ДействующиеСчетаУчета
	|ИЗ
	|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	|ГДЕ
	|	СчетаДоверительногоУправления.Организация = &Организация
	|	И СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовДоверительногоУправления.Договор)
	|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.КонтрольСтраховыхКомпаний)
	|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ &Период МЕЖДУ СчетаДоверительногоУправления.ДатаЗаключения И СчетаДоверительногоУправления.ДатаРасторжения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	"""" КАК Таб1_1НомерСтроки,
	|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК Таб1_1ПолноеНаименование,
	|	ДокументыЮридическихЛицСрезПоследних.Номер КАК Таб1_1РегНомерЗаписи,
	|	ДанныеКалендаря.Дата КАК Таб1_1Дата,
	|	""соответствует"" КАК Таб1_1СоответствиеТребованиямКСоставуАктивов,
	|	""соответствует"" КАК Таб1_1СоответствиеКачественнымТребованиям,
	|	""соответствует"" КАК Таб1_1СоответствиеТребованиямКСтруктуре,
	|	""соответствует"" КАК Таб1_1СоответствиеТребКОбщейСтоимостиАктивовСтраховщика,
	|	""соответствует"" КАК Таб1_1СоответствиеТребКОбщейСтоимостиАктивовИнвестированы,
	|	""-"" КАК Таб1_1Примечание
	|ИЗ
	|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря,
	|	_ДействующиеСчетаУчета КАК _ДействующиеСчетаУчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
	|					&Период,
	|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
	|						И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
	|			ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|					И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
	|						ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период))
	|		ПО _ДействующиеСчетаУчета.СчетУчета = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
	|ГДЕ
	|	ДанныеКалендаря.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий)
	|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
	|	И ГОД(ДанныеКалендаря.Дата) = ГОД(&Период)
	|	И МЕСЯЦ(ДанныеКалендаря.Дата) = МЕСЯЦ(&Период)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Таб1_1ПолноеНаименование,
	|	Таб1_1Дата";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);

	ДанныеТаблица1 = Запрос.Выполнить().Выгрузить();
	
	ФорматныеСтроки = Новый Структура;	
	ФорматныеСтроки.Вставить("Таб1_1Дата"	, "ДФ=yyyy-MM-dd"); 
	
	Раздел1.Таблица1_Раздел1.Вставить("Таб1_1_1", СформироватьМассивСтрок(ДанныеТаблица1, ФорматныеСтроки, "", "", Ложь));
	
	Отчет.Вставить("СопроводительноеПисьмо"		, ПолучитьСопроводительноеПисьмо("ОКУД0420870"));

	// Лицо, ответственное за составление отчета
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО, ДолжностьИПодразделение");			
	
	СведенияОбОтветственномЛице = Новый Структура();
	СведенияОбОтветственномЛице.Вставить("ФИОДолжнЛицоСостОтчет", 		РеквизитыОтветственного.ФИО);
	СведенияОбОтветственномЛице.Вставить("ДолжностьДолжнЛицоСостОтчет", РеквизитыОтветственного.ДолжностьИПодразделение); 	
	СведенияОбОтветственномЛице.Вставить("КонтактныйТелДолжнЛицоСостОтчет", РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания, "Телефоны").Телефоны);

	Отчет.Вставить("СведенияДолжнЛицоСостОтчет", СведенияОбОтветственномЛице);

	
	Возврат ПакетДанных;
	
	
	
КонецФункции

#КонецОбласти

// Уведомление о выявлении нарушения (несоответствия) при осуществлении контроля в отношении страховщика
#Область УведомлениеОВыявленииНарушений_СтраховыеКомпании_ДК

Функция ПолучитьДанные_УРКИ_УведомлениеОВыявленииНарушений(Отказ) Экспорт
	 		
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXML Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	ПакетДанных.Вставить("ИмяОтчета"			, "УведомлениеОВыявленииНарушений" );
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "УведомлениеОВыявленииНарушений_УведомлениеОВыявленииНарушений" );
	ПакетДанных.Вставить("ВерсияОтчета"			, "2.16.3" ); 	
	ПакетДанных.Вставить("Отчет"				, Новый Структура() );

	ПакетДанных.Отчет.Вставить("СпецДепозитарий", Новый Структура());
	
	#Область Сведения_о_спецдепозитарии_и_аффилированности_страховщика 
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	Организации.ЮрФизЛицо КАК ЮрФизЛицо,
		|	Лицензии.ВидДеятельности КАК ВидДеятельности,
		|	Лицензии.Ссылка КАК Лицензия
		|ПОМЕСТИТЬ _ДействующиеЛицензииОрганизации
		|ИЗ
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК СтатусыЛицензийСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|			ПО (Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо)
		|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизацииСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеСпецДеп,
		|	РеквизитыОрганизацииСрезПоследних.КраткоеНаименованиеПоУставу КАК СокращенноеНаименованиеСпецДеп,
		|	РеквизитыОрганизацииСрезПоследних.ИНН КАК ИНН1,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН1,
		|	ЛицензияДепозитарнаяДеятельность.Лицензия.ДатаВыдачи КАК ДатаЛицензии,
		|	ЛицензияДепозитарнаяДеятельность.Лицензия.Номер КАК НомерЛицензии,
		|	ЛицензияСпецдепозитарий.Лицензия.ДатаВыдачи КАК ДатаЛицензииСпецДепИнвФонд,
		|	ЛицензияСпецдепозитарий.Лицензия.Номер КАК НомерЛицензииСпецДепИнвФонд,
		|	ВЫБОР
		|		КОГДА АффилированныеЛицаСрезПоследних.ЯвляетсяАффилированным
		|			ТОГДА ""является""
		|		ИНАЧЕ ""не является""
		|	КОНЕЦ КАК АффЛицоСтраховщика,
		|	ВЫБОР
		|		КОГДА АффилированныеЛицаСрезПоследних.Основание = ""А2""
		|			ТОГДА ""1 - специализированный депозитарий принадлежит к той группе лиц, к которой принадлежит данная страховая организация""
