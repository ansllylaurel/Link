		//		ИначеЕсли СтрокаДанных.Kateg_mneniya_o_dostovern_BFOEnumerator[0].Value = "Otricz_MnenieMember" Тогда
		//			СтрокаДанных.Kateg_mneniya_o_dostovern_BFOEnumerator[0].Value = "Modif_aud_zaklyuchenie_c_vyrazheniem_otricz_mneniyaPURCBMember";
		//		КонецЕсли;
		//	КонецЦикла;
