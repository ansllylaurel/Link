				КонецЕсли;
			КонецЕсли;
 
		КонецЕсли;		
		
	КонецЦикла;

	#КонецОбласти
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Период", ДатаОтчета);
	Запрос.УстановитьПараметр("Организация", Организация); 
