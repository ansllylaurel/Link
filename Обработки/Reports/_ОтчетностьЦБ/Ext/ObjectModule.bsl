КонецФункции

Функция ПолучитьЗапрос_СопроводительнаяИнформация(ДатаОтчета) 
	
	Запрос = Новый Запрос(); 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизации.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыОрганизации.ИНН КАК ИНН,
		|	РеквизитыОрганизации.ОГРН КАК ОГРН,
		|	РеквизитыОрганизации.ФактическийАдрес КАК ФактическийАдрес,
		|	РеквизитыОрганизации.Телефоны КАК Телефоны,
		|	СтатусЛицензииСД.Лицензия.Номер КАК НомерЛицензииСД,
		|	СтатусЛицензииСД.Лицензия.ДатаВыдачи КАК ДатаВыдачиЛицензииСД,
		|	СтатусЛицензииДепозитария.Лицензия.Номер КАК НомерЛицензииДепозитария
		|ПОМЕСТИТЬ _РеквизитыОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							Организации.ЮрФизЛицо
		|						ИЗ
		|							Справочник.Организации КАК Организации)) КАК РеквизитыОрганизации
		|		ПО Организации.ЮрФизЛицо = РеквизитыОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиВКачествеСпециализированногоДепозитарияИнвестиционныхФондовИПИФ)) КАК СтатусЛицензииСД
		|		ПО Организации.ЮрФизЛицо = СтатусЛицензииСД.Лицензия.ЮрФизЛицо
		|			И (СтатусЛицензииСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДепозитарнойДеятельности)) КАК СтатусЛицензииДепозитария
		|		ПО Организации.ЮрФизЛицо = СтатусЛицензииДепозитария.Лицензия.ЮрФизЛицо
		|			И (СтатусЛицензииДепозитария.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РеквизитыОрганизации.СокращенноеНаименование КАК SokrNaim,
		|	_РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК PolnNaim,
		|	_РеквизитыОрганизации.ИНН КАК INN,
		|	_РеквизитыОрганизации.ОГРН КАК OGRN,
		|	_РеквизитыОрганизации.ФактическийАдрес КАК FaktAdr,
		|	_РеквизитыОрганизации.НомерЛицензииСД КАК LIczSD,
		|	_РеквизитыОрганизации.ДатаВыдачиЛицензииСД КАК DataLicz,
		|	_РеквизитыОрганизации.НомерЛицензииДепозитария КАК LiczDD,
		|	NULL КАК RegKO,
		|   ""Собственная разработка"" КАК PONaKotPodgotovPaketOtch
		|ПОМЕСТИТЬ sr_soprovod_inf_1
		|ИЗ
		|	_РеквизитыОрганизации КАК _РеквизитыОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&PrOblastOtcetnostiTaxis КАК PrOblastOtcetnostiTaxis,
		|	&NaimDolzh КАК NaimDolzh,
		|	&Familiya КАК Familiya,
		|	&Imya КАК Imya,
		|	&Otch КАК Otch,
		|	_РеквизитыОрганизации.Телефоны КАК Telefon,
		|   &AdrElPochtLiczSostOtch КАК AdrElPochtLiczSostOtch
		|ПОМЕСТИТЬ sr_soprovod_inf_3
		|ИЗ
		|	_РеквизитыОрганизации КАК _РеквизитыОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&NaimDolzhExec КАК NaimDolzh,
		|	&FamiliyaExec КАК Familiya,
		|	&ImyaExec КАК Imya,
		|	&OtchExec КАК Otch,
		|	&Osnispobyaz КАК Osnispobyaz
		|ПОМЕСТИТЬ sr_soprovod_inf_2";
	
	Запрос.УстановитьПараметр("Период", ДатаОтчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("PrOblastOtcetnostiTaxis"		, "Показатель формы " + СтрЗаменить(ИмяПакета, "ОКУД", ""));
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "Фамилия, Имя, Отчество, ДолжностьИПодразделение");		
	
	Запрос.УстановитьПараметр("NaimDolzh"					, РеквизитыОтветственного.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("Familiya"					, РеквизитыОтветственного.Фамилия);
	Запрос.УстановитьПараметр("Imya"						, РеквизитыОтветственного.Имя);
	Запрос.УстановитьПараметр("Otch"						, РеквизитыОтветственного.Отчество);
	Запрос.УстановитьПараметр("AdrElPochtLiczSostOtch"      , ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Ответственный, 
																Новый Структура("АдресЭлектроннойПочты", "Пользователь.АдресЭлектроннойПочты")).АдресЭлектроннойПочты);
	
	РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "Фамилия, Имя, Отчество, ДолжностьИПодразделение");	
	
	Запрос.УстановитьПараметр("NaimDolzhExec"				, РеквизитыРуководителя.ДолжностьИПодразделение);
	Запрос.УстановитьПараметр("FamiliyaExec"				, РеквизитыРуководителя.Фамилия);
	Запрос.УстановитьПараметр("ImyaExec"					, РеквизитыРуководителя.Имя);
	Запрос.УстановитьПараметр("OtchExec"					, РеквизитыРуководителя.Отчество);
	Запрос.УстановитьПараметр("Osnispobyaz"					, ЭтотОбъект.Руководитель_Основание);
	
	Запрос.Выполнить();
		
	Возврат Запрос;
	
КонецФункции

Функция ПолучитьЗапрос_XBRL_0420874(ДатаОтчета, Организация)
	
#Область ОбъектыНедвижимости_Адрес_площадь
	
	// Колонки Площадь объекта недвижимости, адрес, можно заполнить только программно
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетУчетаРодитель,
		|	СчетаДоверительногоУправленияПортфели.Ссылка КАК СчетУчета,
		|	ЮрФизЛица.Ссылка КАК УправляющаяКомпания,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент.Ссылка КАК СтраховаяКомпания,
		|	Договоры.Ссылка КАК ДоговорДоверительногоУправления
		|ПОМЕСТИТЬ _ДействующиеСчетаУчета
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправленияПортфели
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Прочее)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|					ПО Договоры.Контрагент = ЮрФизЛица.Ссылка
		|				ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор = Договоры.Ссылка
		|			ПО (ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправленияПортфели.Ссылка)
		|		ПО СчетаДоверительногоУправления.Ссылка = СчетаДоверительногоУправленияПортфели.Родитель
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО (СчетаДоверительногоУправленияПортфели.Ссылка = ЗначенияДополнительныхСведений.Объект)
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	(&ОтбиратьПоСчетуДУ = ЛОЖЬ
		|			ИЛИ СчетаДоверительногоУправленияПортфели.Ссылка = &СчетДоверительногоУправления)
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовДоверительногоУправления.Договор)
