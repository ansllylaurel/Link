		|			ИЛИ _НаименованияБанков.ПолноеНаименованиеПоУставу ЕСТЬ NULL
		|			ИЛИ _НаименованияБанков.РегистрНомер = """"
		|			ИЛИ _НаименованияБанков.НаименованиеБанкаРегистр <> _НаименованияБанков.КраткоеНаименованиеПоУставу
		|				И _НаименованияБанков.НаименованиеБанкаРегистр <> _НаименованияБанков.КраткоеНаименованиеГоловнойОрганизацииПоУставу
		|				И _НаименованияБанков.НаименованиеБанкаРегистр <> _НаименованияБанков.ПолноеНаименованиеПоУставу
		|				И _НаименованияБанков.НаименованиеБанкаРегистр <> _НаименованияБанков.ПолноеНаименованиеГоловнойОрганизацииПоУставу)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ОКУД0420011_ЗаполнитьПечатнуюФорму(Результат, Запрос, Отказ) Экспорт
	
	Результат.Очистить();
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ТаблицаБанк") = Неопределено Тогда
		ОКУД0420011_XBRL_ПолучитьДанные_ВыполнитьЗапрос(Запрос);
	КонецЕсли;
	
	СтрокиОпераций = Новый Структура;
	СтрокиОпераций.Вставить("Раздел111"	, "Operaczii_Rezident_YULMember");
	СтрокиОпераций.Вставить("Раздел112"	, "Operaczii_Rezident_IPMember");
	СтрокиОпераций.Вставить("Раздел113"	, "Operaczii_Rezident_FLMember");
	СтрокиОпераций.Вставить("Раздел114"	, "Operaczii_NeRezident_YULMember");
	СтрокиОпераций.Вставить("Раздел115"	, "Operaczii_NeRezident_FLMember");
	СтрокиОпераций.Вставить("Раздел116"	, "Operaczii_NeustLiczaMember");
	
	
	Макет = ПолучитьМакет("ОКУД0420011_ПечатнаяФорма");
	
	ВывестиОбласть(Результат, Макет, "Шапка", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Шапка"));
	
	ТаблицаБанки		= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Банки");
	ТаблицаПрочиеВалюты = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_ПрочиеВалюты");
	ТаблицаРаздел11		= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Раздел11");
	ТаблицаРаздел12		= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Раздел12");
	ТаблицаРаздел13		= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Раздел13");
	ТаблицаРаздел21		= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Раздел21");
	ТаблицаРаздел22		= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПечатнаяФорма_Раздел22");
	
	ТаблицаРаздел11.Сортировать("КодОперации");
	ТаблицаРаздел12.Сортировать("КодОперации");
	ТаблицаРаздел13.Сортировать("КодОперации");
	ТаблицаРаздел21.Сортировать("КодОперации");
	ТаблицаРаздел22.Сортировать("КодОперации");
	
	Для Каждого СтрокаБанки Из ТаблицаБанки Цикл
		//Раздел 1.1
		
		ВывестиОбласть(Результат, Макет, "ШапкаБанк", СтрокаБанки);
		ВывестиОбласть(Результат, Макет, "ШапкаВалюты|ОсновныеВалюты");
		
		ПараметрыПоиска = Новый Структура("КредитнаяОрганизация", СтрокаБанки.КредитнаяОрганизация);
		
		НайденныеСтрокиПрочиеВалюты = ТаблицаПрочиеВалюты.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтрокиПрочиеВалюты.Количество() > 1 Тогда
			//#ТехническийДолг
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка: нет возможности вывести больше двух валют по одному банку!");
			Возврат;
		КонецЕсли;
		
		Для Каждого СтрокаПрочиеВалюты Из НайденныеСтрокиПрочиеВалюты Цикл
			ОбластьДопВалюта = Макет.ПолучитьОбласть("ШапкаВалюты|ДопВалюта");
			ЗаполнитьЗначенияСвойств(ОбластьДопВалюта.Параметры, СтрокаПрочиеВалюты);
			Результат.Присоединить(ОбластьДопВалюта);
		КонецЦикла;
		
		Для Каждого СтрокаОперации Из СтрокиОпераций Цикл
			ПараметрыПоиска.Вставить("СтрокаОперации", СтрокаОперации.Значение);
			ВывестиОбласть(Результат, Макет, "Шапка" + СтрокаОперации.Ключ);
			ВывестиОбласть(Результат, Макет, "СтрокаРаздел11" + ?(НайденныеСтрокиПрочиеВалюты.Количество() = 0, "|ОсновныеВалюты", ""), ТаблицаРаздел11.НайтиСтроки(ПараметрыПоиска));
		КонецЦикла;
		
		ВывестиОбласть(Результат, Макет, "ИтогРаздел11" + ?(НайденныеСтрокиПрочиеВалюты.Количество() = 0, "|ОсновныеВалюты", ""), СтрокаБанки);
		
		// Раздел 1.2
		
		ПараметрыПоиска.Вставить("СтрокаОперации", "Operaczii_NeRezident_YULMember");
		ВывестиОбласть(Результат, Макет, "ШапкаРаздел121");
		ВывестиОбласть(Результат, Макет, "СтрокаРаздел121", ТаблицаРаздел12.НайтиСтроки(ПараметрыПоиска));
		
		ПараметрыПоиска.Вставить("СтрокаОперации", "Operaczii_NeRezident_FLMember");
		ВывестиОбласть(Результат, Макет, "ШапкаРаздел122");
		ВывестиОбласть(Результат, Макет, "СтрокаРаздел122", ТаблицаРаздел12.НайтиСтроки(ПараметрыПоиска));
		
		// Раздел 1.3
		ПараметрыПоиска.Удалить("СтрокаОперации");
		ВывестиОбласть(Результат, Макет, "ШапкаРаздел13");
		ВывестиОбласть(Результат, Макет, "СтрокаРаздел13", ТаблицаРаздел13.НайтиСтроки(ПараметрыПоиска));
		
	КонецЦикла;
	
	//Раздел 2
	ВывестиОбласть(Результат, Макет, "ШапкаРаздел21");
	
	СтрокиОпераций = Новый Структура;
	СтрокиОпераций.Вставить("Раздел211"	, "Operaczii_Rezident_YULMember");
	СтрокиОпераций.Вставить("Раздел212"	, "Operaczii_Rezident_IPMember");
	СтрокиОпераций.Вставить("Раздел213"	, "Operaczii_Rezident_FLMember");
	СтрокиОпераций.Вставить("Раздел214"	, "Operaczii_NeRezident_YULMember");
	СтрокиОпераций.Вставить("Раздел215"	, "Operaczii_NeRezident_FLMember");
	
	Для Каждого СтрокаОперации Из СтрокиОпераций Цикл
		ВывестиОбласть(Результат, Макет, "Шапка" + СтрокаОперации.Ключ);
		ВывестиОбласть(Результат, Макет, "СтрокаРаздел21", ТаблицаРаздел21.НайтиСтроки(Новый Структура("СтрокаОперации", СтрокаОперации.Значение)));
	КонецЦикла;
	
	ИтогиПоКассе = Новый Структура;
	ИтогиПоКассе.Вставить("Списание"		, ТаблицаРаздел21.Итог("Списание"));
	ИтогиПоКассе.Вставить("Зачисление"		, ТаблицаРаздел21.Итог("Зачисление"));
	ИтогиПоКассе.Вставить("ОстатокНаНачало"	, ТаблицаРаздел21.Итог("ОстатокНаНачало"));
	ИтогиПоКассе.Вставить("ОстатокНаКонец"	, ТаблицаРаздел21.Итог("ОстатокНаКонец"));
	
	ВывестиОбласть(Результат, Макет, "ИтогРаздел21", ИтогиПоКассе);
	
	ВывестиОбласть(Результат, Макет, "ШапкаРаздел22");
	ВывестиОбласть(Результат, Макет, "СтрокаРаздел22", ТаблицаРаздел22);
	ВывестиОбласть(Результат, Макет, "ИтогРаздел22");
	
КонецПроцедуры

Процедура ОКУД0420011_ЗаполнитьПояснительнуюЗаписку(Результат, Запрос, Отказ) Экспорт
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ТаблицаБанк") = Неопределено Тогда
		ОКУД0420011_XBRL_ПолучитьДанные_ВыполнитьЗапрос(Запрос);
	КонецЕсли;
	
	Макет = ПолучитьМакет("ПояснительнаяЗаписка");
	
	Если ЭтотОбъект.ЭтоРПИ Тогда
		ИмяОбласти = "|РПИ";
	Иначе
		ИмяОбласти = "|Общая";
	КонецЕсли;
	
	РеквизитыОрганизации = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_РеквизитыОрганизации")[0];
	
	ПараметрыЗаполнения = Новый Структура;
	
	ПараметрыЗаполнения.Вставить("ПолноеНаименованиеПоУставу",	РеквизитыОрганизации.ПолноеНаименованиеПоУставу);
	ПараметрыЗаполнения.Вставить("ИНН", 						РеквизитыОрганизации.ИНН);
	
	ПараметрыЗаполнения.Вставить("Период", 			НРег(ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания)));
	ПараметрыЗаполнения.Вставить("ДатаНачала", 		Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	ПараметрыЗаполнения.Вставить("ДатаОкончания", 	Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	РеквизитыОтветственного = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Ответственный,, "ФИО");	
	
	ПараметрыЗаполнения.Вставить("Ответственный",		РеквизитыОтветственного.ФИО);
	ПараметрыЗаполнения.Вставить("ТелефонИсполнителя ", РеквизитыОрганизации.Телефоны);
	
	ВывестиОбласть(Результат, Макет, "ОКУД0420011_Шапка" + ИмяОбласти, ПараметрыЗаполнения);
	
	ПараметрыЗаполненияСтроки = Новый Структура("НомерСтроки,Банк,Валюта", 0);
	
	ТаблицаКасса = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПояснительнаяЗаписка_Касса");
	Если ТаблицаКасса.Количество() = 0  Тогда
		ПараметрыЗаполненияСтроки.Вставить("НомерСтроки", ПараметрыЗаполненияСтроки.НомерСтроки + 1);
		ВывестиОбласть(Результат, Макет, "ОКУД0420011_Касса" + ИмяОбласти, ПараметрыЗаполненияСтроки);
	КонецЕсли;
	
	ТаблицаБанки = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ПояснительнаяЗаписка_Банки");
	Для Каждого СтрокаБанки Из ТаблицаБанки Цикл
		ПараметрыЗаполненияСтроки.Вставить("НомерСтроки", ПараметрыЗаполненияСтроки.НомерСтроки + 1);
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполненияСтроки, СтрокаБанки);
		ВывестиОбласть(Результат, Макет, "ОКУД0420011_Банк" + ИмяОбласти, ПараметрыЗаполненияСтроки);
	КонецЦикла;
	
	ВывестиОбласть(Результат, Макет, "Подпись" + ИмяОбласти, ПараметрыЗаполнения);
	
	Если ПараметрыЗаполненияСтроки.НомерСтроки = 0 Тогда
		Результат.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОКУД0420011_ПолучитьРегистр(Результат, Отказ) Экспорт
	
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	Запрос = Новый Запрос;
	
#Область ТекстЗапроса	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияДополнительныхСведений.Объект КАК Объект,
		|	СделкаСНедвижимостью.Договор КАК Договор,
		|	СделкаСНедвижимостью.Договор.НомерДоговора КАК НомерДоговора,
		|	СделкаСНедвижимостью.Договор.ДатаЗаключения КАК ДатаДоговора,
		|	&ЮрЛицоОрганизации КАК Контрагент,
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Документ.ПереводДенежныхСредств).РасчетныйСчетПолучатель КАК БанковскийСчет,
		|	ВЫРАЗИТЬ(ЗначенияДополнительныхСведений.Объект КАК Документ.ПереводДенежныхСредств).СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ДоговорыДДУ
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаСНедвижимостью КАК СделкаСНедвижимостью
		|		ПО ЗначенияДополнительныхСведений.Значение = СделкаСНедвижимостью.Договор.НомерДоговора
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""НомерДоговораДДУ""
		|	И НЕ ЗначенияДополнительныхСведений.Объект ССЫЛКА Документ.КорректировкаРегистров
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗначенияДополнительныхСведений.Объект,
		|	СправочникДоговоры.Ссылка,
		|	СправочникДоговоры.НомерДоговора,
		|	СправочникДоговоры.ДатаЗаключения,
		|	&ЮрЛицоОрганизации,
		|	NULL,
		|	NULL
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК СправочникДоговоры
		|		ПО ЗначенияДополнительныхСведений.Значение = СправочникДоговоры.НомерДоговора
		|ГДЕ
		|	ЗначенияДополнительныхСведений.Свойство.Ключ = ""НомерДоговораДДУ""
		|	И ЗначенияДополнительныхСведений.Объект ССЫЛКА Документ.КорректировкаРегистров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БанковскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеСчета.ВидБанковскогоСчета КАК ВидБанковскогоСчета,
		|	БанковскиеСчета.Банк КАК Банк,
		|	БанковскиеСчета.Банк.ЮрФизЛицо КАК ЮрФизЛицоБанка,
		|	ЕСТЬNULL(ГоловныеОрганизации.РодительскоеЮридическоеЛицо, БанковскиеСчета.Банк.ЮрФизЛицо) КАК ЮрФизЛицоГоловногоБанка,
		|	БанковскиеСчета.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА БанковскиеСчета.ВидБанковскогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.СчетЭскроу)
		|			ТОГДА ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ИНАЧЕ ЕСТЬNULL(_ДоговорыДДУ.СчетДоверительногоУправления, ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления)
		|	КОНЕЦ КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА БанковскиеСчета.ДатаЗакрытия МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ТОГДА БанковскиеСчета.ДатаЗакрытия
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
		|	КОНЕЦ КАК ДатаРеквизитовБанка,
		|	БанковскиеСчета.РегистрационныйНомерФилиалаКредитнойОрганизации КАК НомерФилиалаКредитнойОрганизации,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЕСТЬNULL(ДатаПередачиМеждуУК.Значение, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДАТА), ДЕНЬ) МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ТОГДА НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(ЕСТЬNULL(ДатаПередачиМеждуУК.Значение, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДАТА), ДЕНЬ)
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|	КОНЕЦ КАК ДатаПередачи
		|ПОМЕСТИТЬ _БанковскиеСчета
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО БанковскиеСчета.Организация = ИсполнителиПоДенежнымСредствамСобственные.Организация
		|			И БанковскиеСчета.Ссылка = ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОкончания, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК ГоловныеОрганизации
		|		ПО БанковскиеСчета.Банк.ЮрФизЛицо = ГоловныеОрганизации.ЮридическоеЛицо
		|			И (ГоловныеОрганизации.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДоговорыДДУ КАК _ДоговорыДДУ
