		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК ИностранныеБанки
		|		ПО Договоры.Контрагент = ИностранныеБанки.ЮрФизЛицо
		|			И (РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия))
		|			И (РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ДатаОкончания,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.LEI)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыLEI
		|		ПО Договоры.Контрагент = КодыLEI.Объект
		|			И (РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия))
		|			И (РеквизитыЮридическихЛицСрезПоследних.СтранаРегистрации <> ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|		ПО (РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|			И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &ДатаОкончания)
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ПоручениеНаПроведениеИдентификации)
		|	И (Договоры.ДатаЗаключения >= &ДатаНачала
		|				И Договоры.ДатаЗаключения <= &ДатаОкончания
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|				И УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ДатаНачала
		|				И УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения <= &ДатаОкончания)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

// Отчет о сделках, проведенных с отклонением от рыночных цен
#Область ОКУД0420511

Функция ПолучитьДанные_ОКУД0420511(Отказ = Ложь) Экспорт
	
	ПакетДанных = Новый Структура;     
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420511_2_16_3_1");
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420511_2_16_3_1_ОКУД0420511_2_16_3_1");
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить("2_16_3_1", "_", "."));
	ПакетДанных.Вставить("Отчет"				, Новый Структура);
	
	// Вроде, в этом отчете не требуется
	//ДанныеПериодаОтчетности = ПолучитьДанныеПериодаОтчетности();
	//ПакетОтчетныйПериод = Новый Структура("Код, Описание, Активно", ДанныеПериодаОтчетности.Код, ДанныеПериодаОтчетности.Описание, Истина);	
	//ПакетДанных.Отчет.Вставить("ОтчетныйПериод", ПакетОтчетныйПериод);
	//ПакетДанных.Отчет.Вставить("Год", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy"));
	
	ПакетОтчетность = Новый Структура;
		
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;;
	
	Запрос.УстановитьПараметр("ДатаНачала",						ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ОтбиратьПоСчетуДУ",				ЭтотОбъект.ВариантФормированияПоСчетамДУ = "ПоВсемСчетамДУ" ИЛИ ЭтотОбъект.ВариантФормированияПоСчетамДУ = "ПоСчетуДУ");
	Запрос.УстановитьПараметр("ВидПоказателя",					Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("БиржаММВБ",						ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));	
	Запрос.УстановитьПараметр("Руководитель",					"");
	Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа",		"");
	Запрос.УстановитьПараметр("РасчетныеЦены",					ПолучитьРасчетныеЦены_ОКУД0420511(Запрос));
	Запрос.УстановитьПараметр("РынкиЦенныхБумаг",				ПолучитьРынкиЦенныхБумаг());
	Запрос.УстановитьПараметр("НеУчитыватьОценкуПоАмортизированнойСтоимости", ЭтотОбъект.Период.ДатаОкончания >= '20221102');
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420511_РезультатЗапроса();
	Запрос.Выполнить();
	
	РасчетныеЦены = ПолучитьРасчетныеЦены_ОКУД0420511(Запрос);
	Если РасчетныеЦены.Количество() > 0 Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("РасчетныеЦены", РасчетныеЦены);
		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420511_РезультатЗапроса();
		Запрос.Выполнить();
		
	КонецЕсли;
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420511();
	Запрос.Выполнить();
	                                             
	ПакетОтчетность.Вставить("Таблица_ОтчетОСделках", Новый Структура);
	
	ПакетТаблица = Новый Структура;
	ПакетТаблица.Вставить("Стр1_СведенияОСделкахЗаг", ПолучитьДинамическуюСтруктуру("СведенияОСделкахЗагСтр1Гр%Индекс%", 1, 20));
	ПакетТаблица.Вставить("Таб_СведенияОСделкахСтроки_1", ПолучитьДанные_ОКУД0420511_МассивСтрок(Запрос));
		
	ПакетОтчетность.Вставить("Таблица_ОтчетОСделках", ПакетТаблица); 
	ПакетОтчетность.Вставить("ПоСостояниюНа", Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	ПакетДанных.Отчет.Вставить("ОтчетОСделках", ПакетОтчетность);
	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо", ПолучитьСопроводительноеПисьмо("ОКУД0420506"));
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяУК",   Новый Структура("ФИО3", ПолучитьИнициалыФамилиюОтветственногоЛица("Руководитель")));
	ПакетДанных.Отчет.Вставить("ПодписьУполномочСпецДеп", Новый Структура("ФИО", ПолучитьИнициалыФамилиюОтветственногоЛица("УполномоченноеЛицоСпецДепа")));
	
	Возврат ПакетДанных;
	
КонецФункции
	
Функция ПолучитьДанные_ОКУД0420511_МассивСтрок(Запрос)	
	
	Отказ =  Ложь;

	Данные	= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "Таб_СведенияОСделкахСтроки_1", Отказ);
	
	ФорматныеСтроки = Новый Структура;
	ФорматныеСтроки.Вставить("Кол_ФактЦенаСделки",	   "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол_РыночнаяЦена", 	   "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол_ОтклонениеЦены", 	   "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол_ОбъемСделки",        "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол_ОбъемСделокСЦенБум", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
		
	Данные.Сортировать("Кол_ДатаЗаключДоговора");
		
	Возврат СформироватьМассивСтрок(Данные, ФорматныеСтроки);
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420511_РезультатЗапроса()
	
#Область ТекстЗапроса

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОперацииСЦеннымиБумагами.Операция КАК Операция,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НАЧАЛОПЕРИОДА(ДокументСделка.Дата, ДЕНЬ) КАК ДеньСделки
		|ПОМЕСТИТЬ ВТ_Операции
		|ИЗ
		|	Документ.Сделка КАК ДокументСделка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ПО (ОперацииСЦеннымиБумагами.Операция = ДокументСделка.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаНачалаРасчетаПоПисьмуЦБ0185316
		|		ПО (ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = ДатаНачалаРасчетаПоПисьмуЦБ0185316.Объект)
		|			И (ДатаНачалаРасчетаПоПисьмуЦБ0185316.Свойство.Ключ = ""ДатаНачалаРасчетаПоПисьмуЦБ0185316"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияРасчетаПоПисьмуЦБ0185316
		|		ПО (ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = ДатаОкончанияРасчетаПоПисьмуЦБ0185316.Объект)
		|			И (ДатаОкончанияРасчетаПоПисьмуЦБ0185316.Свойство.Ключ = ""ДатаОкончанияРасчетаПоПисьмуЦБ0185316"")
		|ГДЕ
		|	ДокументСделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НЕ ДокументСделка.ВыкупЭмитентом
		|	И ОперацииСЦеннымиБумагами.Активность
		|	И ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|	И (&ОтбиратьПоСчетуДУ = ЛОЖЬ
		|			ИЛИ ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|	И ОперацииСЦеннымиБумагами.Рынок В(&РынкиЦенныхБумаг)
		|	И ВЫБОР
		|			КОГДА ДатаНачалаРасчетаПоПисьмуЦБ0185316.Значение ЕСТЬ НЕ NULL 
		|					И ДатаНачалаРасчетаПоПисьмуЦБ0185316.Значение <> ДАТАВРЕМЯ(1, 1, 1)
		|					И ДатаНачалаРасчетаПоПисьмуЦБ0185316.Значение <= ДокументСделка.Дата
		|					И (ДатаОкончанияРасчетаПоПисьмуЦБ0185316.Значение ЕСТЬ NULL
		|						ИЛИ ДатаОкончанияРасчетаПоПисьмуЦБ0185316.Значение = ДАТАВРЕМЯ(1, 1, 1)
		|						ИЛИ ДатаОкончанияРасчетаПоПисьмуЦБ0185316.Значение >= ДокументСделка.Дата)
		|				ТОГДА ДокументСделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Операции.ДеньСделки КАК ДеньСделки
		|ПОМЕСТИТЬ ВТ_ДниСделок
		|ИЗ
		|	ВТ_Операции КАК ВТ_Операции
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ВЫБОР
		|			КОГДА ОперацииСЦеннымиБумагами.Организация.ВалютаУчета = ОперацииСЦеннымиБумагами.Валюта
		|				ТОГДА ОперацииСЦеннымиБумагами.Сумма
		|			ИНАЧЕ ОперацииСЦеннымиБумагами.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность
		|		КОНЕЦ) КАК ОбъемСделок
		|ПОМЕСТИТЬ ВТ_ОперацииЗаДень
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК ДокументСделка
		|		ПО ОперацииСЦеннымиБумагами.Операция = ДокументСделка.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО ОперацииСЦеннымиБумагами.Валюта = КурсыВалют.Валюта
		|			И (НАЧАЛОПЕРИОДА(ДокументСделка.Дата, ДЕНЬ) = КурсыВалют.Период)
		|ГДЕ
		|	ДокументСделка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НЕ ДокументСделка.ВыкупЭмитентом
		|	И ОперацииСЦеннымиБумагами.Активность
		|	И ОперацииСЦеннымиБумагами.Организация = &Организация
		|	И ОперацииСЦеннымиБумагами.Рынок В(&РынкиЦенныхБумаг)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетныеЦены.Период КАК Период,
		|	РасчетныеЦены.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РасчетныеЦены.ЦеннаяБумага КАК ЦеннаяБумага,
		|	РасчетныеЦены.Цена КАК Цена,
		|	РасчетныеЦены.Валюта КАК Валюта
		|ПОМЕСТИТЬ ВТ_РасчетныеЦены
		|ИЗ
		|	&РасчетныеЦены КАК РасчетныеЦены
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.Период КАК Период,
		|	СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	МАКСИМУМ(СтоимостьПереоценки.ВалютаКотировки) КАК Валюта,
		|	МАКСИМУМ(СтоимостьПереоценки.Цена) КАК Цена
		|ПОМЕСТИТЬ ВТ_СтоимостьПереоценки
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И (&ОтбиратьПоСчетуДУ = ЛОЖЬ
		|			ИЛИ СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|	И СтоимостьПереоценки.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СтоимостьПереоценки.Активность
		|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|	И СтоимостьПереоценки.ЦельРасчета В (ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении), ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.КонтрольИнвестиционнойДекларации))
		|	И ВЫБОР
		|			КОГДА &НеУчитыватьОценкуПоАмортизированнойСтоимости
		|				ТОГДА СтоимостьПереоценки.ВидЦены <> ЗНАЧЕНИЕ(Перечисление.ИсточникиЦеныДляПереоценки.АмортизированнаяСтоимость)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.Период,
