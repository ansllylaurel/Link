#Область ОКУД0420516_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420516(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420516";
	ПакетДанных = Новый Структура;
	ПризнакНулевогоОтчета = Истина;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОКУД0420516_XBRL_ВыполнитьЗапрос(Запрос);
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;

КонецФункции

Процедура ОКУД0420516_XBRL_ВыполнитьЗапрос(Запрос)
	
	Запрос.УстановитьПараметр("ДатаНачала",						ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Руководитель",					ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации",	ИсключаемыеГоловныеОрганизации);
	Запрос.УстановитьПараметр("ВерсияТаксономии",				ЭтотОбъект.ВерсияТаксономии);
	
	ДобавитьВЗапросСопоставимыеВидыОтчетностиПодлежащиеАудиторскойПроверке(Запрос);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420516();
	Запрос.Выполнить();
	
