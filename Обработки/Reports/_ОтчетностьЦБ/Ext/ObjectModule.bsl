Процедура ОКУД0420437_ЗаполнитьРасшифровку(Запрос, Результат, Отказ) Экспорт

	Если ЭтотОбъект.ВерсияТаксономии < "7_1" Тогда

		Возврат;

	КонецЕсли;
	
	Результат.АвтоМасштаб = Ложь;
	Результат.МасштабПечати = 100;
	
	Макет = ПолучитьМакет("ОКУД0420437_Расшифровка");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка|Общие");
	ОбластьШапка.Параметры.Организация		= ЭтотОбъект.Организация;
	ОбластьШапка.Параметры.ДатаОкончания	= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	Результат.Присоединить(Макет.ПолучитьОбласть("Шапка|ЮрЛица"));
	Результат.Присоединить(Макет.ПолучитьОбласть("Шапка|Служебные"));
	
	Данные = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_РасшифровкаОтчетаРеестрКонтрагентов", Отказ);
	
	Если НЕ Отказ Тогда
		Данные.Сортировать("Контрагент");
		Для Каждого СтрокаДанных Из Данные Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка|Общие");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьСтрока );
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка|ЮрЛица");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			Результат.Присоединить(ОбластьСтрока );
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка|Служебные");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
			Результат.Присоединить(ОбластьСтрока );
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


