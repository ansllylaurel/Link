	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвязанныеЮридическиеЛицаСрезПоследнихФилиалы.ЮридическоеЛицо КАК Филиал
