#КонецОбласти

	Запрос.Текст = ТекстЗапроса;
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	СведенияОБухгалтерскихСчетах = ПолучитьДанныеИзВременногоХранилища("СведенияОБухгалтерскихСчетах", Новый Массив);
	
	МассивБИКов = Новый Массив;
	
	// #537643
	// Собственные счета-депозиты выгруженные из бухгалтерии не нужны, т.к. они попадают в выборку запроса в 1С УФО
	ДепозитыБухгалтерии = Новый Массив;
	Для Каждого СтрокаДанных Из СведенияОБухгалтерскихСчетах Цикл

		Если СтрокаДанных.Кол6_ВидСчета = "Депозитный счёт в бухгалтерии!!!" Тогда
			
			ДепозитыБухгалтерии.Добавить(СтрШаблон("""%1""", СтрокаДанных.Кол5_НомерСчета));
			
		КонецЕсли;	
		
	КонецЦикла;
	УсловиеСчетаДепозиты = СтрСоединить(ДепозитыБухгалтерии, ",");
	СобственныеДепозиты = Новый Массив;
	
	Если ЗначениеЗаполнено(УсловиеСчетаДепозиты) И (ЭтотОбъект.ЭтоРЭМ Или ЭтотОбъект.ЭтоТраст) Тогда
		
		ЗапросСобственныеДепозиты = Новый Запрос;
		ЗапросСобственныеДепозиты.УстановитьПараметр("Организация",  ЭтотОбъект.Организация);
		ЗапросСобственныеДепозиты.УстановитьПараметр("НомераСчетов", УсловиеСчетаДепозиты);
		ЗапросСобственныеДепозиты.Текст = СтрЗаменить(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад
		|ПОМЕСТИТЬ _ДепозитныеВклады
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|ГДЕ
		|	ДепозитныеВклады.Организация = &Организация
		|	И ДепозитныеВклады.БанковскийСчет.НомерСчета В(&НомераСчетов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДепозитныеВклады.ДепозитныйВклад.БанковскийСчет.НомерСчета КАК НомерСчета
		|ИЗ
		|	_ДепозитныеВклады КАК ДепозитныеВклады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах КАК ДСВКредитныхИнструментах
		|		ПО (ДСВКредитныхИнструментах.КредитныйИнструмент = ДепозитныеВклады.ДепозитныйВклад)
		|			И (ДСВКредитныхИнструментах.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))",
		"&НомераСчетов", УсловиеСчетаДепозиты);
		
		СобственныеДепозиты = ЗапросСобственныеДепозиты.Выполнить().Выгрузить().ВыгрузитьКолонку("НомерСчета");
		
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из СведенияОБухгалтерскихСчетах Цикл
		
		// Счета-депозиты, которые есть в УФО и не должны заменяться данными из БУХ
		Если СтрокаДанных.Кол6_ВидСчета = "Депозитный счёт в бухгалтерии!!!" 
			И СобственныеДепозиты.Найти(СтрокаДанных.Кол5_НомерСчета) <> Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		ПараметрыПоиска = Новый Структура("Nom_schet", СтрокаДанных.Кол5_НомерСчета);
		НайденныеСтроки = Данные.НайтиСтроки(ПараметрыПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Данные.Удалить(НайденнаяСтрока);
		КонецЦикла;	
		
		Если МассивБИКов.Найти(СтрокаДанных.Кол3_БИК) = Неопределено Тогда
			МассивБИКов.Добавить(СтрокаДанных.Кол3_БИК);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Банки.Код КАК Кол3_БИК,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Кол2_СокрНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК Кол3_ИдентНомер
		|ИЗ
		|	Справочник.Банки КАК Банки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&ДатаОкончания, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация) И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Банки.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
