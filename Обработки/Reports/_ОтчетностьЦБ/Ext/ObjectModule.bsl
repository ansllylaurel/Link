		|	И Нарушение.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Нарушение.Организация = &Организация";

	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Нарушение = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	
	Если Нарушение.Следующий() Тогда
	
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаСовершенияНарушения1", Нарушение.ДатаСовершенияНарушения1);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаВыявления1", Нарушение.ДатаВыявления1);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаУведомленияВыявления", Нарушение.ДатаУведомленияВыявления);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "НомерУведомленияВыявления", Нарушение.НомерУведомленияВыявления);    
		
		МассивСтрок = Новый Массив();
		
		ОписаниеНарушения = Новый Структура();
		ОписаниеНарушения.Вставить("Нарушения1", Новый Структура("Код, Активно",  Нарушение.Нарушения1, Истина));//Новый Структура("Код, Описание, Активно",  Нарушение.Нарушения1, "", Истина));
		МассивСтрок.Добавить( ОписаниеНарушения );
		
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "КодНарушения1", Новый Структура());
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.КодНарушения1.Вставить("Строка_КодНарушения1", МассивСтрок );
		
		МассивСтрок = Новый Массив();
		ОписаниеНормы = Новый Структура();
		ОписаниеНормы.Вставить("Норма", Нарушение.Норма);
		МассивСтрок.Добавить( ОписаниеНормы );
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "УказанияНаНормы", Новый Структура());
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.УказанияНаНормы.Вставить( "Строка_УказанияНаНормы",МассивСтрок);
		
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "СодержаниеНарушения", Нарушение.СодержаниеНарушения ); 
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На выбранную дату у клиента не обнаружено нарушений. Проверьте дату исходящего документа",,,, Отказ);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	
#КонецОбласти

	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо", ПолучитьСопроводительноеПисьмо("УведомлениеОВыявленииНарушений"));
	
	Возврат ПакетДанных;

КонецФункции

#КонецОбласти

#Область УведомлениеОбУстраненииНарушений_Страховые_Компании_ДК

Функция ПолучитьДанные_УРКИ_УведомлениеОбУстраненииНарушений(Отказ) Экспорт
	 		
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXML Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	ПакетДанных.Вставить("ИмяОтчета"			, "УведомлениеОбУстраненииНарушений" );
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "УведомлениеОбУстраненииНарушений_УведомлениеОбУстраненииНарушений" );
	ПакетДанных.Вставить("ВерсияОтчета"			, "2.16.3" ); 	
	ПакетДанных.Вставить("Отчет"				, Новый Структура() );

	ПакетДанных.Отчет.Вставить("СпецДепозитарий", Новый Структура());
	
	#Область Сведения_о_спецдепозитарии_и_аффилированности_страховщика 
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	Организации.ЮрФизЛицо КАК ЮрФизЛицо,
		|	Лицензии.ВидДеятельности КАК ВидДеятельности,
		|	Лицензии.Ссылка КАК Лицензия
		|ПОМЕСТИТЬ _ДействующиеЛицензииОрганизации
		|ИЗ
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних(&Период, Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК СтатусыЛицензийСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|			ПО (Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо)
		|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизацииСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеСпецДеп,
		|	РеквизитыОрганизацииСрезПоследних.КраткоеНаименованиеПоУставу КАК СокращенноеНаименованиеСпецДеп,
		|	РеквизитыОрганизацииСрезПоследних.ИНН КАК ИНН1,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН1,
		|	ЛицензияДепозитарнаяДеятельность.Лицензия.ДатаВыдачи КАК ДатаЛицензии,
		|	ЛицензияДепозитарнаяДеятельность.Лицензия.Номер КАК НомерЛицензии,
		|	ЛицензияСпецдепозитарий.Лицензия.ДатаВыдачи КАК ДатаЛицензииСпецДепИнвФонд,
		|	ЛицензияСпецдепозитарий.Лицензия.Номер КАК НомерЛицензииСпецДепИнвФонд,
		|	ВЫБОР
		|		КОГДА АффилированныеЛицаСрезПоследних.ЯвляетсяАффилированным
		|			ТОГДА ""является""
		|		ИНАЧЕ ""не является""
		|	КОНЕЦ КАК АффЛицоСтраховщика,
		|	ВЫБОР
		|		КОГДА АффилированныеЛицаСрезПоследних.Основание = ""А2""
		|			ТОГДА ""1 - специализированный депозитарий принадлежит к той группе лиц, к которой принадлежит данная страховая организация""
		|		КОГДА АффилированныеЛицаСрезПоследних.Основание = ""А4""
		|			ТОГДА ""2 - страховщик имеет право распоряжаться более чем 20 процентами общего количества голосов, проходящихся на голосующие акции (доли), составляющие уставный капитал специализированного депозитария""
		|		КОГДА АффилированныеЛицаСрезПоследних.Основание = ""А3""
		|			ТОГДА ""3 - специализированный депозитарий имеет право распоряжаться более чем 20 процентами общего количества голосов, приходящихся на голосующие акции либо составляющие уставный (складочный) капитал вклады, доли страховщика""
		|	КОНЕЦ КАК ОснованиеАффилир
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияСпецдепозитарий
		|			ПО Организации.Ссылка = ЛицензияСпецдепозитарий.Организация
		|				И (ЛицензияСпецдепозитарий.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиВКачествеСпециализированногоДепозитарияИнвестиционныхФондовИПИФ))
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеЛицензииОрганизации КАК ЛицензияДепозитарнаяДеятельность
		|			ПО Организации.Ссылка = ЛицензияДепозитарнаяДеятельность.Организация
		|				И (ЛицензияДепозитарнаяДеятельность.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДепозитарнойДеятельности))
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизацииСрезПоследних
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АффилированныеЛица.СрезПоследних(
		|						&Период,
		|						АффилированноеЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо
		|							И ЯвляетсяАффилированным = ИСТИНА) КАК АффилированныеЛицаСрезПоследних
		|				ПО РеквизитыОрганизацииСрезПоследних.ЮрФизЛицо = АффилированныеЛицаСрезПоследних.ЮридическоеЛицо
		|			ПО Организации.ЮрФизЛицо = РеквизитыОрганизацииСрезПоследних.ЮрФизЛицо
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|					&Период,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|						И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|			ПО Организации.ЮрФизЛицо = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|				И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период)
		|		ПО СчетаДоверительногоУправления.Организация = Организации.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСтраховщикаСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент.Ссылка = РеквизитыСтраховщикаСрезПоследних.ЮрФизЛицо
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	ПараметрыДокумента = Запрос.Выполнить();
	ПоляДокумента = ПараметрыДокумента.Колонки;
	ВыборкаПараметрыДокумента = ПараметрыДокумента.Выбрать();
	
	Если ВыборкаПараметрыДокумента.Следующий() Тогда
		
		Для Каждого Колонка из ПоляДокумента Цикл
			Если ЗначениеЗаполнено(  ВыборкаПараметрыДокумента[Колонка.Имя] ) Тогда
			ПакетДанных.Отчет.СпецДепозитарий.Вставить(Колонка.Имя, ВыборкаПараметрыДокумента[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла; 		
		
	КонецЕсли;

	#КонецОбласти
	
	ПакетДанных.Отчет.Вставить("Страховщик", Новый Структура());
	
	#Область Сведения_о_страховщике
	
	Запрос = Новый Запрос();
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеСтраховщика,
		|	РНС.Номер КАК НомерРегистрЗаписи,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН2,
		|	ОГРН1.Номер КАК ОГРН2
		|ИЗ
		|	Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент.Ссылка = ЮрФизЛица.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.РегистрационныйНомерСтраховщика)) КАК РНС
		|		ПО ЮрФизЛица.Ссылка = РНС.ЮрФизЛицо
		|			И (РНС.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ РНС.ДействуетПо > &Период)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ОГРН1
		|		ПО ЮрФизЛица.Ссылка = ОГРН1.ЮрФизЛицо
		|			И (ОГРН1.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ ОГРН1.ДействуетПо > &Период)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|	И СчетаДоверительногоУправления.Организация = &Организация";
	
	 	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	 	
	ПараметрыДокумента = Запрос.Выполнить();
	ПоляДокумента = ПараметрыДокумента.Колонки;
	ВыборкаПараметрыДокумента = ПараметрыДокумента.Выбрать();
	
	Если ВыборкаПараметрыДокумента.Следующий() Тогда
		
		Для Каждого Колонка из ПоляДокумента Цикл
			ПакетДанных.Отчет.Страховщик.Вставить(Колонка.Имя, ВыборкаПараметрыДокумента[Колонка.Имя]);
		КонецЦикла; 		
		
	КонецЕсли;


	#КонецОбласти
	
	ПакетДанных.Отчет.Вставить("УправляющаяКомпания", Новый Структура());

	#Область Управляющие_компании_страховщика
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеУК,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН3,
		|	ДокументыЮридическихЛицСрезПоследних.Номер КАК ОГРН3,
		|	СтатусыЛицензийСрезПоследних.Лицензия.ДатаВыдачи КАК ДатаЛицензииУК,
		|	СтатусыЛицензийСрезПоследних.Лицензия.Номер КАК ИнойИдентификаторКолОрг
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаУчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|					&Период,
		|					Организация = &Организация
		|						И Договор.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.Прочее)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|					ПО ЮрФизЛица.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(
		|							&Период,
		|							Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|								И Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)) КАК СтатусыЛицензийСрезПоследних
		|					ПО ЮрФизЛица.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо
		|					ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыЮридическихЛиц.СрезПоследних(
		|							&Период,
		|							Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|								И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|								И Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)) КАК ДокументыЮридическихЛицСрезПоследних
		|					ПО (ЮрФизЛица.Ссылка = ДокументыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|							И (ДокументыЮридическихЛицСрезПоследних.ДействуетПо = ДАТАВРЕМЯ(1, 1, 1)
		|								ИЛИ ДокументыЮридическихЛицСрезПоследних.ДействуетПо > &Период))
		|				ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор.Контрагент = ЮрФизЛица.Ссылка
		|			ПО СчетаДоверительногоУправления.Ссылка = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ПО СчетаУчета.Ссылка = СчетаДоверительногоУправления.Родитель
		|ГДЕ
		|	СчетаУчета.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);

	
	ЗапросУправляющиеКомпании = Запрос.Выполнить(); 	
	ДанныеУправляющиеКомпании = ЗапросУправляющиеКомпании.Выгрузить();
	
	ФорматныеСтроки = Новый Структура;
	ФорматныеСтроки.Вставить("ДатаЛицензииУК", "ДФ=yyyy-MM-dd"); 
	
	НеобязательныеЭлементы = Новый Массив();
	НеобязательныеЭлементы.Добавить("Таб2НомерДогДоверитУправления");
	НеобязательныеЭлементы.Добавить("Таб2ДатаЗаключДоверитУправ");
	НеобязательныеЭлементы.Добавить("Таб2НомерГосРегЦенБум");
	НеобязательныеЭлементы.Добавить("Таб2ИННТИН");
	
	ПакетДанных.Отчет.УправляющаяКомпания.Вставить("УправляющияКомпанияСтраховщика", 
		СформироватьМассивСтрокСНеобязательнымиЭлементами( ДанныеУправляющиеКомпании, ФорматныеСтроки, НеобязательныеЭлементы));
	
#КонецОбласти

	ПакетДанных.Отчет.Вставить("ВыявлениеУстранениеНарушения", Новый Структура());
	
#Область Нарушение_Зарегистрированное_в_Исходящем_документе

	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Нарушение.ДатаСовершения КАК ДатаСовершения,
		|	Нарушение.ДатаВыявления КАК ДатаВыявления1,
		|	ИсходящийДокументНарушение.Дата КАК ДатаВыявления2,
		|	НАЧАЛОПЕРИОДА(УстранениеНарушения.Дата, ДЕНЬ) КАК ДатаУстранения,
		|	ИсходящийДокументУстранение.Дата КАК ДатаУведомленияУстранения,
		|	ИсходящийДокументУстранение.Номер КАК НомерУведомленияУстранения,
		|	ИсходящийДокументНарушение.Номер КАК НомерВыявления2,
		|	ЕСТЬNULL(КодыВоВнешнихСистемахСрезПоследних.Код, Нарушение.Классификация.Код) КАК КодНарушения2,
		|	УстранениеНарушения.ОписаниеПринятыхМер КАК ОписаниеМер
		|ИЗ
		|	Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументНарушениеОснования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент КАК ИсходящийДокументНарушение
		|		ПО ИсходящийДокументНарушениеОснования.Ссылка = ИсходящийДокументНарушение.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Нарушение КАК Нарушение
		|		ПО ИсходящийДокументНарушениеОснования.Основание = Нарушение.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УстранениеНарушения КАК УстранениеНарушения
		|		ПО (Нарушение.Ссылка = УстранениеНарушения.Основание)
		|			И (УстранениеНарушения.НарушениеУстранено)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументУстранениеОснования
		|		ПО (УстранениеНарушения.Ссылка = ИсходящийДокументУстранениеОснования.Основание)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент КАК ИсходящийДокументУстранение
		|		ПО (ИсходящийДокументУстранениеОснования.Ссылка = ИсходящийДокументУстранение.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Договоры КАК ИсходящийДокументУстранениеДоговоры
		|		ПО (ИсходящийДокументУстранениеДоговоры.Ссылка = ИсходящийДокументУстранение.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.КлассификаторНарушений)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО (Нарушение.Ссылка = КодыВоВнешнихСистемахСрезПоследних.Объект)
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ИсходящийДокументУстранение.Дата, ДЕНЬ) = &Период
		|	И ИсходящийДокументУстранение.Организация = &Организация
		|	И ИсходящийДокументУстранениеДоговоры.Договор = &СчетДоверительногоУправления";

	Запрос.УстановитьПараметр("Период", ЭтотОбъект.ДатаОтчетности);	
	Запрос.УстановитьПараметр("Организация", Организация);	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Нарушение = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	
	Если Нарушение.Следующий() Тогда
	
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаСовершения", Нарушение.ДатаСовершения);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаВыявления1", Нарушение.ДатаВыявления1);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаВыявления2", Нарушение.ДатаВыявления2);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаУстранения", Нарушение.ДатаУстранения);    
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ДатаУведомленияУстранения", Нарушение.ДатаУведомленияУстранения);   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "НомерУведомленияУстранения", Нарушение.НомерУведомленияУстранения);  
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "НомерВыявления2", Нарушение.НомерВыявления2);  
		
		МассивСтрок = Новый Массив();
		
		ОписаниеНарушения = Новый Структура();
		ОписаниеНарушения.Вставить("Нарушения2", Новый Структура("Код, Активно",  Нарушение.КодНарушения2, Истина));
		МассивСтрок.Добавить( ОписаниеНарушения );
		
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "КодНарушения2", Новый Структура());
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.КодНарушения2.Вставить("Строка_КодНарушения2", МассивСтрок );   
		ПакетДанных.Отчет.ВыявлениеУстранениеНарушения.Вставить( "ОписаниеМер", Нарушение.ОписаниеМер); 
		  
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На выбранную дату у клиента не обнаружено уведомлений об устранении нарушения. Проверьте дату исходящего документа",,,, Отказ);
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;

	
#КонецОбласти

	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо", ПолучитьСопроводительноеПисьмо("УведомлениеОбУстраненииНарушений"));
	
	Возврат ПакетДанных;

КонецФункции

#КонецОбласти

#Область ДополнительныеПроцедурыИФункции

Функция СериализоватьЗначение(СтрокаДанных, Колонка, ФорматныеСтроки, Отказ)
	
	ФорматнаяСтрока = "";
	Значение = СтрокаДанных[Колонка];
	
	Если Колонка = "Кол5_Таб1_1НомерФилиала" ИЛИ Колонка = "Кол5_Таб1_2НомерФилиала" Тогда
		Значение = СтрРазделить(Строка(Значение) + "/", "/")[1];
		
	ИначеЕсли Колонка = "Кол4_Таб1_1РегНомер" ИЛИ Колонка = "Кол4_Таб1_2РегНомер" Тогда
		Значение = СтрРазделить(Строка(Значение) + "/", "/")[0];
	КонецЕсли;
	
	Если Значение = ЭтотОбъект.ПустоеЗначение Тогда
		Возврат Значение;
		
	ИначеЕсли Колонка = "Кол6_Таб34_1СведенияОДок" Тогда
		Если ТипЗнч(СтрокаДанных.Кол3_Таб34_1ОснованиеЗадолж) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
			Возврат ПредставлениеДокументаУдостоверенияЛицности(Значение, СтрокаДанных.Кол3_Таб34_1ОснованиеЗадолж.Дата);
		КонецЕсли;
		
	ИначеЕсли Колонка = "Кол65_Таб1_3НаименЭмитента" ИЛИ Колонка = "Кол95_Таб1_4НаименЭмитента" Тогда
		Если ТипЗнч(СтрокаДанных.ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
			РеквизитыПая = РаботаСОтчетами.ПолучитьРеквизитыЦеннойБумаги(СтрокаДанных.ЦеннаяБумага, ЭтотОбъект.Период.ДатаОкончания);
			Возврат Значение + "(" + РеквизитыПая.ПолноеНаименованиеЭмитента + ")";
		Иначе
			Возврат Значение;
		КонецЕсли;
		
	ИначеЕсли Колонка = "Кол114_Таб2_1СрокПлатежа" 
	   ИЛИ Колонка = "Кол161_Таб2_3СрокПлатежа" Тогда
		Если СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.НаДату Тогда
			Возврат Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy");
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ПоПредъявлении Тогда
			Возврат "По предъявлении";
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ПоПредъявленииНоНеРанее Тогда
			Возврат "По предъявлении, но не ранее " + Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy");
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ПоПредъявленииНоНеПозднее Тогда
			Возврат "По предъявлении, но не ранее " + Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy") + ?(ЗначениеЗаполнено(СтрокаДанных.ПогаситьНеПозднее), " и не позднее " + Формат(СтрокаДанных.ПогаситьНеПозднее, "ДФ=dd.MM.yyyy"), "");
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ЧерезNДнейОтДатыСоставления Тогда
			Если ЗначениеЗаполнено(СтрокаДанных.ПогаситьНеПозднее) Тогда
				Возврат "По предъявлении, но не ранее " + Формат(СтрокаДанных.ДнейДоПогашения, "ЧГ=0") + " дня и не позднее " + Формат(СтрокаДанных.ПогаситьНеПозднее, "ДФ=dd.MM.yyyy");
			Иначе
				Возврат "Через " + Формат(СтрокаДанных.ДнейДоПогашения, "ЧГ=0") + " дней от даты составления (" + Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy") + ")";
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли Колонка = "Кол165_Таб2_3Основания" Тогда
		Возврат "Договор ДУ " + СтрокаДанных.НомерДоговораДУ;//  + " от " + Формат(СтрокаДанных.ДатаДоговораДУ, "ДФ=dd.MM.yyyy");
		
	ИначеЕсли Колонка = "Кол130_Таб2_1ОсновНахожВекселя"
		И ТипЗнч(Значение) = Тип("СправочникСсылка.Договоры") Тогда
		Возврат "Договор " + НРег(Значение.ВидДоговора) + " № " + Значение.НомерДоговора + " от " + Формат(Значение.ДатаЗаключения, "ДФ=dd.MM.yyyy") + "г.";
		
	ИначеЕсли Колонка = "Кол4_Таб27ВидыДеятельности" Тогда
		Возврат ПолучитьОписаниеОКВЭД(Значение, Отказ);
		
	ИначеЕсли Колонка = "Кол6_Таб34_2МестоНахождДолжника" ИЛИ Колонка = "Кол6_Таб34_2МестоНахождКредитора" Тогда
		Возврат ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес, ИмяПакета = "ОКУД0420501", Дата(2021,4,1), Отказ);		
		
	ИначеЕсли Колонка = "Кол24_ИдентифКонтрагента" Тогда
		Возврат СтрСоединить(СтрРазделить(Значение, " " + Символы.НПП));
		
	ИначеЕсли ФорматныеСтроки.Свойство(Колонка, ФорматнаяСтрока) Тогда
		
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Если Найти(ФорматнаяСтрока, "ЧДЦ=0; ") > 0 Тогда
				Если Значение <> Цел(Значение) Тогда
					ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "ЧДЦ=0; ", "");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Формат(Значение, ФорматнаяСтрока);
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") И (Колонка = "Кол_ДатаЗаключДоговора") Тогда	
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") И (Колонка = "Кол_ДтаВремяСделки") Тогда	
		Результат = Формат(Значение, "ДЛФ=DT");
		Возврат СтрЗаменить(Результат, ":", "-");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=5; ЧРД=,; ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy; ДП='" + ЭтотОбъект.ПустоеЗначение + "'");	
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ЭтотОбъект.ПустоеЗначение;
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.СтраныМира") Тогда
		Возврат Значение.КодАльфа3;
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция СформироватьМассивСтрок(Данные, ФорматныеСтроки = "", ПрефиксКолонки = "Кол", ИмяТаблицы = "", ЗаполнятьПустымиЗначениями = Истина, Отказ = Ложь)
	
	МассивСтрок		= Новый Массив;
	МассивКолонок	= Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ФорматныеСтроки) Тогда
		ФорматныеСтроки = Новый Структура;
	КонецЕсли;
	
	Для Каждого Колонка Из Данные.Колонки Цикл
		Если Лев(Колонка.Имя, СтрДлина(ПрефиксКолонки)) = ПрефиксКолонки ИЛИ НЕ ЗначениеЗаполнено(ПрефиксКолонки) Тогда
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ДанныеСтроки = Новый Структура;
		
		Для Каждого Колонка Из МассивКолонок Цикл
			ДанныеСтроки.Вставить(Колонка, СериализоватьЗначение(СтрокаДанных, Колонка, ФорматныеСтроки, Отказ));

			Если Найти(Колонка, "НомерСтроки") > 0
				ИЛИ Найти(Колонка, "НомСтроки") > 0
				ИЛИ Найти(Колонка, "НомерСтр") > 0
				ИЛИ Колонка = "Кол1_Таб3НомерГрафы"
				ИЛИ Колонка = "Кол1_Таб34_1НомерГрафы"
				ИЛИ Колонка = "Кол1_Таб1_2НомерГрафы" Тогда
				ДанныеСтроки.Вставить(Колонка, МассивСтрок.Количество() + 1);
			КонецЕсли;	
		КонецЦикла;
		
		МассивСтрок.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 И ЗаполнятьПустымиЗначениями Тогда
		МассивСтрок.Добавить("ЗаполнитьПустымиЗначениями");
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьФиксированнуюСтруктуру(ИмяСтруктуры)
	
	ФиксированнаяСтруктура = Новый Структура;
	
	Если ИмяСтруктуры = "Таблица_ОтчетОВнебиржСделках_Заголовки" Тогда
		Для Индекс = 1 По 60 Цикл
			ФиксированнаяСтруктура.Вставить("Cell_" + Строка(130 + 2 * Индекс), Индекс);	
		КонецЦикла;	
		ФиксированнаяСтруктура.Вставить("Cell_7033",61);
		
	ИначеЕсли ИмяСтруктуры = "Row_104" Тогда
		Для Индекс = 1 По 10 Цикл
			ФиксированнаяСтруктура.Вставить("Cell_" + Строка(104 + Индекс), Индекс);	
		КонецЦикла;
		Для Индекс = 11 По 18 Цикл
			ФиксированнаяСтруктура.Вставить("Cell_" + Строка(30 + (Индекс - 10) * 2), Индекс);	
		КонецЦикла;
		Для Индекс = 19 По 25 Цикл
			ФиксированнаяСтруктура.Вставить("Cell_" + Строка(30 + (Индекс - 10) * 2) + "_", Индекс);	
		КонецЦикла;
		Для Индекс = 26 По 29 Цикл
			ФиксированнаяСтруктура.Вставить("Cell_" + Строка(30 + (Индекс - 10) * 2), Индекс);	
		КонецЦикла;
	ИначеЕсли ИмяСтруктуры = "Row_34" Тогда
		ФиксированнаяСтруктура.Вставить("Таб1_1_Заг1Гр1", " ");
		ФиксированнаяСтруктура.Вставить("Cell_36", " ");
		ФиксированнаяСтруктура.Вставить("Cell_37", " ");
		
		Для Индекс = 4 По 20 Цикл
			ФиксированнаяСтруктура.Вставить("Таб1_1_Заг1Гр" + Строка(Индекс), " ");	
		КонецЦикла;
		
		ФиксированнаяСтруктура.Вставить("Таб1_1_Заг1Гр21", "Всего");
		ФиксированнаяСтруктура.Вставить("Таб1_1_Заг1Гр22", "из них:");
		
		Для Индекс = 23 По 30 Цикл
			ФиксированнаяСтруктура.Вставить("Таб1_1_Заг1Гр" + Строка(Индекс), " ");	
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ФиксированнаяСтруктура;
	
КонецФункции

Функция ПолучитьДинамическуюСтруктуру(Шаблон, Начало, Конец, Смещение = 0, ПустоеЗначение = Ложь)
	
	ДинамическаяСтруктура = Новый Структура;
	
	Для Индекс = Начало По Конец Цикл 
		Если ПустоеЗначение Тогда
			ДинамическаяСтруктура.Вставить(СтрЗаменить(Шаблон, "%Индекс%", Индекс), " ");
		Иначе
			ДинамическаяСтруктура.Вставить(СтрЗаменить(Шаблон, "%Индекс%", Индекс), Индекс + Смещение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДинамическаяСтруктура;
	
КонецФункции

Функция ПолучитьСопроводительноеПисьмо(ИмяПакета = "")
	
	Если ИмяПакета = "ОКУД0420416" Тогда
		СопроводительноеПисьмо = Новый Структура("ОКАТО, ИНН, ОГРН, ПолноеНаименование, КраткоеНаименование, ОтчетныйГод, ДатаРегистрации, ОтчетныйКвартал, ДатаРегистрации, НомерРегистрации");
	ИначеЕсли ИмяПакета = "ОКУД0420001" Тогда
		СопроводительноеПисьмо = Новый Структура("ОКАТО, ИНН, ОГРН, КППСП, ПолноеНаименование, КраткоеНаименование, ЭлектроннаяПочтаСП, ДатаРегистрации, НомерРегистрации");
		СопроводительноеПисьмо.Вставить("ПримечаниеСП", "-");
	ИначеЕсли ИмяПакета = "ОКУД0420427" Тогда
		СопроводительноеПисьмо = Новый Структура("ОКАТО, ИНН, ОГРН, ПолноеНаименование, КраткоеНаименование, ОтчетныйГод, ДатаРегистрации, ОтчетныйКвартал, НомерРегистрации");
	ИначеЕсли ИмяПакета = "ОКУД0420506"
		ИЛИ ИмяПакета = "ОКУД0420502"
		ИЛИ ИмяПакета = "ОКУД0420503"
		ИЛИ ИмяПакета = "СООУРКИ028" 
		ИЛИ ИмяПакета = "УведомлениеОВыявленииНарушений" 		
		ИЛИ ИмяПакета = "УведомлениеОбУстраненииНарушений" Тогда
		СопроводительноеПисьмо = Новый Структура("ВидУчастника, ПолноеНаименование, КраткоеНаименование, ФИОРуководителя, ИНН, ОГРН, АдресМестаНахождения, АдресЭП, КонтактныйТелефон, НомерРегистрации, ДатаРегистрации, КраткоеСодержаниеПисьма, ДолжностьПодписавшегоЛица, ФамилияПодписавшегоЛица, ИмяПодписавшегоЛица, ОтчествоПодписавшегоЛица");
	ИначеЕсли ИмяПакета = "ОКУД0420869_2_16_3_1" Или ИмяПакета = "ОКУД0420870" Тогда	
		СопроводительноеПисьмо = Новый Структура("ПолноеНаименование, КраткоеНаименование, ФИОРуководителя, ИНН, ОГРН, АдресМестаНахождения, АдресЭП, КонтактныйТелефон, НомерРегистрации, ДатаРегистрации, КраткоеСодержаниеПисьма, ДолжностьПодписавшегоЛица, ФамилияПодписавшегоЛица, ИмяПодписавшегоЛица, ОтчествоПодписавшегоЛица");
	Иначе
		СопроводительноеПисьмо = Новый Структура("ОКАТО, ИНН, ОГРН, ПолноеНаименование, КраткоеНаименование, ОтчетныйГод, ДатаРегистрации, ОтчетныйМесяц, НомерРегистрации");
	КонецЕсли;
	
	Если СопроводительноеПисьмо.Свойство("ВидУчастника") Тогда
		Если ИмяПакета = "УведомлениеОВыявленииНарушений" ИЛИ ИмяПакета = "УведомлениеОбУстраненииНарушений" Тогда
			СопроводительноеПисьмо.ВидУчастника = Новый Структура("Код, Описание, Активно", "СД", "Спецдепозитарии", Истина);	
		Иначе
			СопроводительноеПисьмо.ВидУчастника = Новый Структура("Код, Описание, Активно", "УК", "Управляющие компании", Истина);	
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КодПоОКАТО КАК ОКАТО,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименование,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименование,
		|	ГОД(&Период) КАК ОтчетныйГод,
		|	&ДатаОтчетности КАК ДатаРегистрации,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КППСП,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮридическийАдрес КАК АдресМестаНахождения,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК КонтактныйТелефон,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.EMail КАК АдресЭП,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.EMail КАК ЭлектроннаяПочтаСП,
		|	&ФИОРуководителя КАК ФИОРуководителя
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&Период, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|ГДЕ
		|	Организации.Ссылка = &Организация";
		
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"	, ИсключаемыеГоловныеОрганизации);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаОтчетности"	, ЭтотОбъект.ДатаОтчетности);
	Запрос.УстановитьПараметр("ФИОРуководителя" , ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	
	ДанныеДляЗаполнения = Новый Структура;
	ДанныеДляЗаполнения.Вставить("ОтчетныйМесяц"	, НРег(Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=ММММ"))); 
	ДанныеДляЗаполнения.Вставить("ОтчетныйКвартал"	, НРег(Формат(КонецКвартала(ЭтотОбъект.Период.ДатаОкончания), "ДФ='dd MMMM'"))); 
	ДанныеДляЗаполнения.Вставить("НомерРегистрации"	, "БК.03." + Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=ddMMyy") + "/"); 
	ЗаполнитьЗначенияСвойств(СопроводительноеПисьмо, ДанныеДляЗаполнения);
	
	КонтактныйТелефон = "";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СопроводительноеПисьмо, Выборка);
		КонтактныйТелефон = Выборка.КонтактныйТелефон;
	КонецЕсли;
	
	РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "Фамилия, Имя, Отчество, ДолжностьИПодразделение");	
	
	Если ИмяПакета <> "ОКУД0420506"
		И ИмяПакета <> "ОКУД0420502"
		И ИмяПакета <> "ОКУД0420503"
		И ИмяПакета <> "ОКУД0420869_2_16_3_1" 
		И ИмяПакета <> "ОКУД0420870"
		И ИмяПакета <> "СООУРКИ028" 
		И ИмяПакета <> "УведомлениеОВыявленииНарушений" 		
		И ИмяПакета <> "УведомлениеОбУстраненииНарушений" Тогда
		
		ПодписьЕдиноличногоИсполнительногоОргана = Новый Структура;
		ПодписьЕдиноличногоИсполнительногоОргана.Вставить("ФамилияПодписанта"	, РеквизитыРуководителя.Фамилия);
		ПодписьЕдиноличногоИсполнительногоОргана.Вставить("ИмяПодписанта"		, РеквизитыРуководителя.Имя);
		ПодписьЕдиноличногоИсполнительногоОргана.Вставить("ОтчествоПодписанта"	, РеквизитыРуководителя.Отчество);
		ПодписьЕдиноличногоИсполнительногоОргана.Вставить("ДолжностьПодписанта"	, РеквизитыРуководителя.ДолжностьИПодразделение);
		ПодписьЕдиноличногоИсполнительногоОргана.Вставить("ТелефонПодписанта"	, КонтактныйТелефон);

		Если ИмяПакета <> "ОКУД0420001" Тогда
			ПодписьЕдиноличногоИсполнительногоОргана.Вставить("ИсполнениеОбязанностейЕИО"	, "Нет");
		КонецЕсли;

		СопроводительноеПисьмо.Вставить("ПодписьЕдиноличногоИсполнительногоОргана", ПодписьЕдиноличногоИсполнительногоОргана);   	
		
		РеквизитыКонтролера   = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Контролер,, "Фамилия, Имя, Отчество, ДолжностьИПодразделение");
		
		ПодписьКонтролера = Новый Структура;
		ПодписьКонтролера.Вставить("ФамилияКонтролера"	, РеквизитыКонтролера.Фамилия);
		ПодписьКонтролера.Вставить("ИмяКонтролера"		, РеквизитыКонтролера.Имя);
		ПодписьКонтролера.Вставить("ОтчествоКонтролера"	, РеквизитыКонтролера.Отчество);
		ПодписьКонтролера.Вставить("ДолжностьКонтролера", РеквизитыКонтролера.ДолжностьИПодразделение);
		ПодписьКонтролера.Вставить("ТелефонКонтролера"	, КонтактныйТелефон);    	
			
		Если ИмяПакета <> "ОКУД0420001" Тогда
			ПодписьКонтролера.Вставить("ИсполнениеОбязанностейКонтролера", "Нет");
		КонецЕсли;
	
		СопроводительноеПисьмо.Вставить("ПодписьКонтролера", ПодписьКонтролера);
		
	КонецЕсли;	
	
	Если ИмяПакета = "ОКУД0420506"
		ИЛИ ИмяПакета = "ОКУД0420869_2_16_3_1" 
		ИЛИ ИмяПакета = "ОКУД0420870"
		ИЛИ ИмяПакета = "СООУРКИ028" 
		ИЛИ ИмяПакета = "УведомлениеОВыявленииНарушений" 		
		ИЛИ ИмяПакета = "УведомлениеОбУстраненииНарушений" Тогда
		СопроводительноеПисьмо.Вставить("КраткоеСодержаниеПисьма"  , СокрЛП(ЭтотОбъект.СодержаниеСопроводительногоПисьма));
		СопроводительноеПисьмо.Вставить("ФамилияПодписавшегоЛица"  , РеквизитыРуководителя.Фамилия);
		СопроводительноеПисьмо.Вставить("ИмяПодписавшегоЛица"	   , РеквизитыРуководителя.Имя);
		СопроводительноеПисьмо.Вставить("ОтчествоПодписавшегоЛица" , РеквизитыРуководителя.Отчество);
		СопроводительноеПисьмо.Вставить("ДолжностьПодписавшегоЛица", РеквизитыРуководителя.ДолжностьИПодразделение);  
		СопроводительноеПисьмо.Вставить("КонтактныйТелефон"        , КонтактныйТелефон);
		СопроводительноеПисьмо.Вставить("ДатаРегистрации"          , ТекущаяДата());
	КонецЕсли;	
	
	Если ИмяПакета = "ОКУД0420502"
		ИЛИ ИмяПакета = "ОКУД0420503" Тогда
		
		СопроводительноеПисьмо.Вставить("КраткоеСодержаниеПисьма"  , СокрЛП(ЭтотОбъект.СодержаниеСопроводительногоПисьма));
		СопроводительноеПисьмо.Вставить("ФамилияПодписавшегоЛица"  , РеквизитыРуководителя.Фамилия);
		СопроводительноеПисьмо.Вставить("ИмяПодписавшегоЛица"	   , РеквизитыРуководителя.Имя);
		СопроводительноеПисьмо.Вставить("ОтчествоПодписавшегоЛица" , РеквизитыРуководителя.Отчество);
		СопроводительноеПисьмо.Вставить("ДолжностьПодписавшегоЛица", РеквизитыРуководителя.ДолжностьИПодразделение);  
		СопроводительноеПисьмо.Вставить("КонтактныйТелефон"        , КонтактныйТелефон);
		СопроводительноеПисьмо.Вставить("ДатаРегистрации"          , ТекущаяДата());
		
	КонецЕсли;	
	
	Если ИмяПакета = "ОКУД0420506" Тогда
		СопроводительноеПисьмо.Вставить("НомерРегистрации"	       , "ЭМ.03." + Формат(ТекущаяДата(), "ДФ=ddMMyy") + "/");
	ИначеЕсли ИмяПакета = "ОКУД0420502"
		ИЛИ ИмяПакета = "ОКУД0420503"
		ИЛИ ИмяПакета = "СООУРКИ028" 
		ИЛИ ИмяПакета = "ОКУД0420869_2_16_3_1" 
		ИЛИ ИмяПакета = "ОКУД0420870" 
		ИЛИ ИмяПакета = "УведомлениеОВыявленииНарушений" 		
		ИЛИ ИмяПакета = "УведомлениеОбУстраненииНарушений" Тогда
		СопроводительноеПисьмо.Вставить("НомерРегистрации"	       , "-");
	КонецЕсли;
	
	Если ИмяПакета = "ОКУД0420503" Тогда
		СопроводительноеПисьмо.Вставить("ПодписьРуководителяФонда"	, Новый Структура("ФИО"	, ПолучитьИнициалыФамилиюОтветственногоЛица("Руководитель")));
		СопроводительноеПисьмо.Вставить("ПодписьУполномоченногоЛица", Новый Структура("ФИО2", ПолучитьИнициалыФамилиюОтветственногоЛица("УполномоченноеЛицоСпецДепа")));
	КонецЕсли;
	
	Возврат СопроводительноеПисьмо;
	
КонецФункции

Процедура ВывестиРаздел(ИмяРаздела = "", ПутьКШапке = "", ПутьКСтроке, Пакет, Макет, Результат)
	
	МассивПутьКШапке	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКШапке	, ".");
	МассивПутьКСтроке	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКСтроке	, ".");
	
	ДанныеШапки = Пакет;
	ДанныеТЧ	= Пакет;
	
	Для Каждого ИмяДанныхШапки Из МассивПутьКШапке Цикл
		ДанныеШапки = ДанныеШапки[ИмяДанныхШапки];
	КонецЦикла;
	
	Для Каждого ИмяСтроки Из МассивПутьКСтроке Цикл
		ДанныеТЧ = ДанныеТЧ[ИмяСтроки];
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ИмяРаздела) Тогда
		ОбластьШапка	= Макет.ПолучитьОбласть(ИмяРаздела);
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДанныеШапки);
		Результат.Вывести(ОбластьШапка);	
	КонецЕсли;	
	
	ОбластьСтрока	= Макет.ПолучитьОбласть(ИмяСтроки);
	Для Каждого СтрокаДанных Из ДанныеТЧ Цикл
		Если СтрокаДанных = "ЗаполнитьПустымиЗначениями" Тогда
			Для Индекс = 0 По ОбластьСтрока.Параметры.Количество() - 1 Цикл
				ОбластьСтрока.Параметры.Установить(Индекс, ЭтотОбъект.ПустоеЗначение);
			КонецЦикла;
		Иначе
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных); 
		КонецЕсли;
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
КонецПроцедуры

//По дате окончания отчета определяет код периода отчетности:
// 1 - первый квартал
// 2 - первое полугодие
// 3 - девять месяцев
// 4 - год
Функция ПолучитьДанныеПериодаОтчетности()
	
	ДатаОкончания = ЭтотОбъект.Период.ДатаОкончания;
	ТекущийМесяц = Месяц(ДатаОкончания);
	
	Результат = Новый Структура;
	
	Если ТекущийМесяц = 3 Тогда 
		Результат.Вставить("Код", 1);
		Результат.Вставить("Описание", "первый квартал");		
	ИначеЕсли ТекущийМесяц = 6 Тогда 	
		Результат.Вставить("Код", 2);
		Результат.Вставить("Описание", "первое полугодие");
	ИначеЕсли ТекущийМесяц = 9 Тогда 	
		Результат.Вставить("Код", 3);
		Результат.Вставить("Описание", "девять месяцев");				
	Иначе 
		Результат.Вставить("Код", 4);
		Результат.Вставить("Описание", "год");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьДанныеПериодаОтчетности()

Процедура ДобавитьСтрокуВТаблицу(Таблица, Значения)
	
	НоваяСтрока = Таблица.Добавить();
	
	МассивЗначений = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Значения);
	Для Каждого Колонка Из Таблица.Колонки Цикл
		НоваяСтрока[Колонка.Имя] = МассивЗначений[Таблица.Колонки.Индекс(Колонка)];
	КонецЦикла;
	
КонецПроцедуры

Процедура ОкруглениеРесурсовТаблицы(Таблица, Точность, ФорматныеСтроки)
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если ТипЗнч(СтрокаТаблицы[Колонка.Имя]) = Тип("Число") Тогда
				Если СтрокаТаблицы[Колонка.Имя] <> Цел(СтрокаТаблицы[Колонка.Имя]) Тогда
					СтрокаТаблицы[Колонка.Имя] = Окр(СтрокаТаблицы[Колонка.Имя], Точность);
					ФорматныеСтроки.Вставить(Колонка.Имя, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;	
	
КонецПроцедуры	

Функция ПолучитьФорматныеСтроки(ИмяПакета)
	
	ФорматныеСтроки = Новый Структура;
	
	МакетФорматныхСтрок = ПолучитьМакет("РесурсыXTDD").ПолучитьОбласть(ИмяПакета);
	
	Для НомерСтроки = 1 По МакетФорматныхСтрок.ВысотаТаблицы Цикл
		Идентификатор			= СокрЛП(МакетФорматныхСтрок.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		Точность				= СокрЛП(МакетФорматныхСтрок.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		ПредставлениеНуля		= СокрЛП(МакетФорматныхСтрок.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
		РазделительДробнойЧасти	= СокрЛП(МакетФорматныхСтрок.Область(НомерСтроки, 4, НомерСтроки, 4).Текст);
		Группировка				= СокрЛП(МакетФорматныхСтрок.Область(НомерСтроки, 5, НомерСтроки, 5).Текст);
		
		ФорматнаяСтрока = "";
		
		МассивТочностей = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Точность);
		Для Каждого ЭлементТочности Из МассивТочностей Цикл
			ФорматнаяСтрока = ФорматнаяСтрока + "ЧДЦ=" + ЭлементТочности + "; "
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ПредставлениеНуля) Тогда
			Если ПредставлениеНуля = "ПустоеЗначение" Тогда
				ФорматнаяСтрока = ФорматнаяСтрока + "ЧН=" + ЭтотОбъект.ПустоеЗначение + "; ";
			Иначе
				ФорматнаяСтрока = ФорматнаяСтрока + "ЧН=" + ПредставлениеНуля + "; ";
			КонецЕсли;
		КонецЕсли;
		
		Если РазделительДробнойЧасти = "Точка" Тогда
			ФорматнаяСтрока = ФорматнаяСтрока + "ЧРД=.; ";
		ИначеЕсли РазделительДробнойЧасти = "Запятая" Тогда
			ФорматнаяСтрока = ФорматнаяСтрока + "ЧРД=,; ";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Группировка) Тогда 
			ФорматнаяСтрока = ФорматнаяСтрока + "ЧГ=" + Группировка + "; ";
		КонецЕсли;
		
		ФорматныеСтроки.Вставить(Идентификатор, ФорматнаяСтрока);
	КонецЦикла;
	
	Возврат ФорматныеСтроки;
	
КонецФункции

Функция ПолучитьНастройкиВидимостиРеквизитов() Экспорт
	
	ДоступностьОтчетовПоВидамДеятельностиОрганизации = ПолучитьДоступностьОтчетовПоВидамДеятельностиОрганизации();
	
	НастройкиВидимостиРеквизитов = Новый Структура;
	
	МакетВидимостьРеквизитов = ПолучитьМакет("ВидимостьРеквизитов");
	
	Для НомерСтроки = 2 По МакетВидимостьРеквизитов.ВысотаТаблицы Цикл
		ТекИмяПакета = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		
		Если ДоступностьОтчетовПоВидамДеятельностиОрганизации.Получить(ТекИмяПакета) Тогда
			НастройкиВидимостиРеквизитов.Вставить(ТекИмяПакета, Новый Структура);
			
			НастройкиВидимостиРеквизитов[ТекИмяПакета].Вставить("Представление", СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, 2, НомерСтроки, 2).Текст));
			
			Для НомерКолонки = 3 По МакетВидимостьРеквизитов.ШиринаТаблицы Цикл
				ИмяРеквизита	= СокрЛП(МакетВидимостьРеквизитов.Область(1, НомерКолонки, 1, НомерКолонки).Текст);
				
				Видимость = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
				Заголовок = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Примечание.Текст);
				
				Если ВРЕГ(Видимость) = "ДА" Тогда
					Видимость = Истина;
				ИначеЕсли ВРЕГ(Видимость) = "НЕТ" ИЛИ ПустаяСтрока(Видимость) Тогда
					Видимость = Ложь;
				Иначе
					//Если ни нет, ни да, тогда параметр формы 
				КонецЕсли;
				
				НастройкиВидимостиРеквизитов[ТекИмяПакета].Вставить(ИмяРеквизита, Новый Структура("Видимость, Заголовок", Видимость, Заголовок));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НастройкиВидимостиРеквизитов;
	
КонецФункции

Функция ПолучитьТаблицуСубъектов()
	
	ТаблицаСубъектов = Новый ТаблицаЗначений;
	ТаблицаСубъектов.Колонки.Добавить("НомерСубъекта"		, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	ТаблицаСубъектов.Колонки.Добавить("НаименованиеСубъекта", Новый ОписаниеТипов("Строка"));
	
	МакетСубъектов = ПолучитьОбщийМакет("СоответствиеКодовСубъектовИКодовОКАТО");
	
	Для НомерСтроки = 2 По МакетСубъектов.ВысотаТаблицы Цикл
		СтрокаСубъектов = ТаблицаСубъектов.Добавить();
		СтрокаСубъектов.НомерСубъекта			= СокрЛП(МакетСубъектов.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		СтрокаСубъектов.НаименованиеСубъекта	= СокрЛП(МакетСубъектов.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
	КонецЦикла;
	
	ПроверочнаяТаблица = ТаблицаСубъектов.Скопировать(, "НомерСубъекта");
	ПроверочнаяТаблица.Свернуть("НомерСубъекта");
	
	Если ПроверочнаяТаблица.Количество() <> ТаблицаСубъектов.Количество() Тогда
		ВызватьИсключение "Записи в таблице 'СоответствиеКодовСубъектовИКодоОКАТО' не уникальны по Номеру субъекта согласно конституции";
	КонецЕсли;
	
	Возврат ТаблицаСубъектов;
	
КонецФункции

Функция ПредставлениеДокументаУдостоверенияЛицности(ЮрФизЛицо, НаДату)
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности.Наименование КАК ВидУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицо) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних";
	
	Запрос.УстановитьПараметр("Период"		, НаДату);
	Запрос.УстановитьПараметр("Организация"	, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо"	, ЮрФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат	Выборка.ВидУдостоверенияЛичности + ", " + 
				Выборка.СерияУдостоверенияЛичности + ", " +
				Выборка.НомерУдостоверенияЛичности + ", " +
				Выборка.ОрганВыдавшийУдостоверениеЛичности + ", " +
				Формат(Выборка.ДатаВыдачиУдостоверенияЛичности, "ДФ=dd.MM.yyyy");
	КонецЕсли;
			
	Возврат "";		
	
КонецФункции

Функция ПолучитьНаименованиеЮрФизЛица(ЮрФизЛицо, ВидНаименования = "НаименованиеПолное")
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ЮрФизЛицо"		, ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК НаименованиеПолное
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И Организация = &Организация) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И Организация = &Организация) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка[ВидНаименования];
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ТекстЗапроса_ЦенныеБумаги()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЦенныеБумаги.Вид КАК Вид,
		|	ЦенныеБумаги.РегНомер КАК РегНомер,
		|	РеквизитыЮрЛицНаРусском.РезидентРФ КАК ЭмитентРезидентРФ,
		|	РеквизитыЮрЛицНаРусском.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеЭмитентаРусский,
		|	РеквизитыЮрЛицНаАнглийском.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеЭмитентаАнглийский,
		|	ЦенныеБумаги.Тип КАК Тип,
		|	РеквизитыЮрЛицНаРусском.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставуРусский,
		|	РеквизитыЮрЛицНаАнглийском.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставуАнглийский
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	(ВЫБРАТЬ
		|		Акции.Ссылка КАК ЦеннаяБумага,
		|		""Акции"" КАК Вид,
		|		Акции.Эмитент.ЮрФизЛицо КАК ЭмитентЮрФизЛицо,
		|		Акции.ГосударственныйРегистрационныйНомер КАК РегНомер,
		|		Акции.Тип КАК Тип
		|	ИЗ
		|		Справочник.Акции КАК Акции
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Облигации.Ссылка,
		|		""Облигации"",
		|		Облигации.Эмитент.ЮрФизЛицо,
		|		Облигации.ГосударственныйРегистрационныйНомер,
		|		Облигации.Тип
		|	ИЗ
		|		Справочник.Облигации КАК Облигации
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Векселя.Ссылка,
		|		""Векселя"",
		|		Векселя.Эмитент.ЮрФизЛицо,
		|		Векселя.Серия + Векселя.Номер,
		|		Векселя.ТипВекселя
		|	ИЗ
		|		Справочник.Векселя КАК Векселя
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ДепозитарныеРасписки.Ссылка,
		|		""Депозитарные расписки"",
		|		ДепозитарныеРасписки.Эмитент.ЮрФизЛицо,
		|		ДепозитарныеРасписки.РегистрационныйНомер,
		|		NULL
		|	ИЗ
		|		Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Доли.Ссылка,
		|		""Доли"",
		|		Доли.ЮрЛицо,
		|		"""",
		|		NULL
		|	ИЗ
		|		Справочник.Доли КАК Доли
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Закладные.Ссылка,
		|		""Закладные"",
		|		Закладные.Банк.ЮрФизЛицо,
		|		Закладные.НомерКредитногоДоговора,
		|		NULL
		|	ИЗ
		|		Справочник.Закладные КАК Закладные
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ИпотечныеСертификатыУчастия.Ссылка,
		|		""Ипотечные сертификаты участия"",
		|		ИпотечныеСертификатыУчастия.Эмитент.ЮрФизЛицо,
		|		ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер,
		|		NULL
		|	ИЗ
		|		Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия) КАК ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮрЛицНаРусском
		|		ПО ЦенныеБумаги.ЭмитентЮрФизЛицо = РеквизитыЮрЛицНаРусском.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Английский)) КАК РеквизитыЮрЛицНаАнглийском
		|		ПО ЦенныеБумаги.ЭмитентЮрФизЛицо = РеквизитыЮрЛицНаАнглийском.ЮрФизЛицо
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Паи.Ссылка,
		|	""Паи"",
		|	Паи.ГосударственныйРегистрационныйНомер,
		|	ИСТИНА,
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда,
		|	NULL,
		|	NULL,
		|	РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда,
		|	NULL
		|ИЗ
		|	Справочник.Паи КАК Паи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ) КАК РеквизитыПИФСрезПоследних
		|		ПО Паи.ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьЗначениеНастройкиОтчета(КлючНастройки, ВернутьКлючЗначения = Ложь, Отказ) Экспорт
	
	Если ПолучитьНастройкиВидимостиРеквизитов()[ЭтотОбъект.ВариантОтчета].СчетДоверительногоУправления.Видимость Тогда
		ЗначениеНастройки = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройки(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.СчетДоверительногоУправления, "_ОтчетностьЦБ", КлючНастройки);
	Иначе
		ЗначениеНастройки = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьЗначениеНастройкиОтчета("_ОтчетностьЦБ", КлючНастройки, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;

	Если ЗначениеНастройки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для отчёта не задано значение настройки: " + КлючНастройки,,,, Отказ);
		Возврат "";
	КонецЕсли;
	
	Если ВернутьКлючЗначения Тогда
		Возврат ЗначениеНастройки.Ключ;
	Иначе
		Возврат ЗначениеНастройки;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьМассивРеквизитовБулево() Экспорт
	
	МассивРеквизитовБулево = Новый Массив;
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("ТребуетсяПодтверждениеСпецДепа");
	МассивИсключений.Добавить("ЭтоРЭМ");
	МассивИсключений.Добавить("ЭтоРПИ");
	МассивИсключений.Добавить("ЭтоТраст");
	МассивИсключений.Добавить("ЭтоМДТраст");	
	МассивИсключений.Добавить("ЭтоДК");
	МассивИсключений.Добавить("ТестовыйРежим");
	
	Для Каждого Реквизит Из Метаданные().Реквизиты Цикл
		Если МассивИсключений.Найти(Реквизит.Имя) = Неопределено
		   И Реквизит.Тип = Новый ОписаниеТипов("Булево") Тогда
			МассивРеквизитовБулево.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(МассивРеквизитовБулево);
	
КонецФункции

Функция ИтогПоНайденнымСтрокам(Данные, Ключ)
	
	Значение = 0;
	МассивСтроковыхЗначений = Новый Массив;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ТипЗнч(СтрокаДанных[Ключ]) = Тип("Число") Тогда
			Значение = Значение + СтрокаДанных[Ключ];
		ИначеЕсли ТипЗнч(СтрокаДанных[Ключ]) = Тип("Строка") Тогда
			МассивСтроковыхЗначений.Добавить(СтрокаДанных[Ключ]);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСтроковыхЗначений.Количество() Тогда
		Возврат СтрСоединить(МассивСтроковыхЗначений, Символы.ПС);
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ)
	
	НастройкиКонтрольныхПроцедур = ПолучитьТаблицуИзМакета("НастройкиКонтрольныхПроцедур", ИмяПакета, Отказ, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии));
	
	Для Каждого СтрокаНастройки Из НастройкиКонтрольныхПроцедур Цикл
		
		Если ЗначениеЗаполнено(СтрокаНастройки.ИмяТаблицы) И ЗначениеЗаполнено(СтрокаНастройки.ТекстЗапроса) Тогда
			ВызватьИсключение "В таблице НастройкиКонтрольныхПроцедур указаны и имя таблицы и текст запроса. Недопустимая ситуация.";
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаНастройки.ИмяТаблицы) И НЕ ЗначениеЗаполнено(СтрокаНастройки.ТекстЗапроса) Тогда
			ВызватьИсключение "В таблице НастройкиКонтрольныхПроцедур не указаны ни имя таблицы ни текст запроса. Недопустимая ситуация.";
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаНастройки.ИмяТаблицы) Тогда
			Данные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(СтрокаНастройки.ИмяТаблицы).ПолучитьДанные().Выгрузить();
			
		Иначе
			Запрос.Текст = СтрокаНастройки.ТекстЗапроса;
			Попытка
				Данные = Запрос.Выполнить().Выгрузить();
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка в тексте запроса контрольных процедур: " + ОписаниеОшибки(),,,, Отказ);
				Продолжить;
			КонецПопытки;
		КонецЕсли;
		
		Для Каждого СтрокаДанных Из Данные Цикл
			
			ШаблонСообщения = СтрокаНастройки.ШаблонСообщения;
			ВызватьОтказ	= СтрокаНастройки.Отказ;
			
			ПараметрыСообщения = Новый Структура;
			Для Каждого Колонка Из Данные.Колонки Цикл
				Если Колонка.Имя = "ШаблонСообщения" Тогда
					ШаблонСообщения = СтрокаДанных[Колонка.Имя];
				ИначеЕсли Колонка.Имя = "Отказ" Тогда
					ВызватьОтказ = СтрокаДанных[Колонка.Имя];
				ИначеЕсли ТипЗнч(СтрокаДанных[Колонка.Имя]) = Тип("Дата") Тогда
					ПараметрыСообщения.Вставить(Колонка.Имя, Формат(СтрокаДанных[Колонка.Имя], "ДФ=dd.MM.yyyy; ДП=отсутствует"));	
				Иначе
					ПараметрыСообщения.Вставить(Колонка.Имя, СтрокаДанных[Колонка.Имя]);
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(СтрокаНастройки.ПолеСсылки) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(ШаблонСообщения, ПараметрыСообщения), СтрокаДанных[СтрокаНастройки.ПолеСсылки],,, ?(ВызватьОтказ, Отказ, Ложь));
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(ШаблонСообщения, ПараметрыСообщения),,,, ?(ВызватьОтказ, Отказ, Ложь));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ПолучитьТаблицуИзМакета(ИмяМакета, ВхИмяПакета = Неопределено, Отказ = Ложь, ПараметрыОтбора = Неопределено, Сортировка = Неопределено, ФильтроватьПоРазмеруПредприятия = Истина) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Макет	= ПолучитьМакет(ИмяМакета);
	МалоеПредприятие = Неопределено;
	ЕстьЛицензияДУ	 = Неопределено;
	ТекущийПериод	= Неопределено;
	
	КолонкиИменованыйОбъект = Новый Массив;

	ПрефиксНумерации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ПрефиксНумерации");	
	
	КолонкиМакета = Новый Соответствие;
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ПараметрыКолонки = СтрРазделить(СокрЛП(Макет.Область(1, НомерКолонки, 1, НомерКолонки).Текст), "(),", Ложь);
		
		КолонкиМакета.Вставить(ПараметрыКолонки[0], НомерКолонки);
		Если ПараметрыКолонки.Количество() = 1 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов("Строка"));
		ИначеЕсли ПараметрыКолонки.Количество() = 2 И ПараметрыКолонки[1] = "ИменованныйОбъект" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Метаданные.РегистрыСведений.ИменованныеОбъекты.Ресурсы.Объект.Тип);
			КолонкиИменованыйОбъект.Добавить(ПараметрыКолонки[0]);
		ИначеЕсли ПараметрыКолонки.Количество() = 2 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1]));
		ИначеЕсли ПараметрыКолонки.Количество() = 3 И ПараметрыКолонки[1] = "Строка" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1], Новый КвалификаторыСтроки(ПараметрыКолонки[2])));	
		ИначеЕсли ПараметрыКолонки.Количество() = 4 И ПараметрыКолонки[1] = "Число" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1], Новый КвалификаторыЧисла(ПараметрыКолонки[2], ПараметрыКолонки[3])));	
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		Если ВхИмяПакета <> Неопределено Тогда
			НомерКолонки = КолонкиМакета.Получить("ИмяПакета");
			Если НомерКолонки <> Неопределено Тогда
				Если СтрРазделить(СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст), ",", Ложь).Найти(ВхИмяПакета) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НомерКолонки = КолонкиМакета.Получить("МалоеПредприятие");
		Если НомерКолонки <> Неопределено Тогда
			Если ЗначениеЗаполнено(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст) Тогда
				Если ЕстьЛицензияДУ = Неопределено Тогда
					ЕстьЛицензияДУ = ПолучитьЕстьЛицензияДУ();
				КонецЕсли;
			
				Если ЕстьЛицензияДУ = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
				Если МалоеПредприятие = Неопределено Тогда
					МалоеПредприятие = (РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьКатегориюПрофУчастника(ЭтотОбъект, Отказ) = Перечисления.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый);
				КонецЕсли;
				
				Если (ВРег(СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст)) = "ДА") <> МалоеПредприятие И ФильтроватьПоРазмеруПредприятия Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПараметрыОтбора <> Неопределено И ПараметрыОтбора.Свойство("Организация") Тогда
			НомерКолонки = КолонкиМакета.Получить("Организация");
			Если НомерКолонки <> Неопределено Тогда
				ПрефиксНумерации = СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
				Если ЗначениеЗаполнено(ПрефиксНумерации) И ПрефиксНумерации <> ПараметрыОтбора.Организация Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОтбора <> Неопределено И ПараметрыОтбора.Свойство("ВерсияТаксономии") Тогда
			НомерКолонки = КолонкиМакета.Получить("ТаксономияС");
			Если НомерКолонки <> Неопределено Тогда
				ВерсияТаксономииС	= СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
				Если ЗначениеЗаполнено(ВерсияТаксономииС) И ВерсияТаксономииС > ПараметрыОтбора.ВерсияТаксономии Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			НомерКолонки = КолонкиМакета.Получить("ТаксономияПо");
			Если НомерКолонки <> Неопределено Тогда
				ВерсияТаксономииПо	= СокрЛП(Макет.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
				Если ЗначениеЗаполнено(ВерсияТаксономииПо) И ВерсияТаксономииПо < ПараметрыОтбора.ВерсияТаксономии Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОтбора <> Неопределено И ПараметрыОтбора.Свойство("КонецПериода") Тогда
			КонцыПериодов = СтрРазделить(Макет.Область(НомерСтроки, КолонкиМакета.Получить("КонецПериода"), НомерСтроки, КолонкиМакета.Получить("КонецПериода")).Текст, ",", Ложь);
			Если КонцыПериодов.Количество() > 0 И КонцыПериодов.Найти(ПараметрыОтбора.КонецПериода) = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
		
		Если ПараметрыОтбора <> Неопределено И ПараметрыОтбора.Свойство("ПериодичностьОтчета") Тогда
			ПериодичностиОтчета = СтрРазделить(Макет.Область(НомерСтроки, КолонкиМакета.Получить("ПериодичностьОтчета"), НомерСтроки, КолонкиМакета.Получить("ПериодичностьОтчета")).Текст, ",", Ложь);
			Если ПериодичностиОтчета.Количество() > 0 И ПериодичностиОтчета.Найти(ПараметрыОтбора.ПериодичностьОтчета) = Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;
	
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КолонкаМакета Из КолонкиМакета Цикл
			Значение = СокрЛП(Макет.Область(НомерСтроки, КолонкаМакета.Значение, НомерСтроки, КолонкаМакета.Значение).Текст);
			
			Если КолонкиИменованыйОбъект.Найти(КолонкаМакета.Ключ) <> Неопределено Тогда
				НоваяСтрока[КолонкаМакета.Ключ] = ОбщегоНазначения.ПолучитьИменованныйОбъект(Значение);
			ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ])) Тогда
				Если ЗначениеЗаполнено(Значение) Тогда
					ЗначенияПредопределенныхЭлементов = РаботаСМетаданнымиПовтИсп.ЗначенияПредопределенныхЭлементовСправочникаВСтруктуру(НоваяСтрока[КолонкаМакета.Ключ].Метаданные().Имя);
					Если НЕ ЗначенияПредопределенныхЭлементов.Свойство(Значение, НоваяСтрока[КолонкаМакета.Ключ]) Тогда
						НоваяСтрока[КолонкаМакета.Ключ] = ОбщегоНазначения.ПолучитьИменованныйОбъект(Значение);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ])) Тогда
				Если ЗначениеЗаполнено(Значение) Тогда
					НоваяСтрока[КолонкаМакета.Ключ] = РаботаСМетаданнымиПовтИсп.ЗначенияПеречисленияВСтруктуру(НоваяСтрока[КолонкаМакета.Ключ].Метаданные().Имя)[Значение];
				КонецЕсли;
			ИначеЕсли ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Тип") Тогда
				Если ЗначениеЗаполнено(Значение) Тогда // на 23 платформе возникает ошибка если передается пустая строка
					НоваяСтрока[КолонкаМакета.Ключ]	= Тип(Значение);
				КонецЕсли;
			
			ИначеЕсли ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Соответствие") Тогда
				Для Каждого СтрокаЗначения Из СтрРазделить(Значение, Символы.ПС, Ложь) Цикл
					ЭлементыСтроки = СтрРазделить(СтрокаЗначения, "|", Ложь);
					НоваяСтрока[КолонкаМакета.Ключ].Вставить(ЭлементыСтроки[0],ЭлементыСтроки[1]);
				КонецЦикла;
			Иначе
				НоваяСтрока[КолонкаМакета.Ключ]	= Значение;
			КонецЕсли;
				
			Если ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Строка") И НоваяСтрока[КолонкаМакета.Ключ] <> Значение Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неверно указана ширина колонки %1 в макете %2, не поместилось значение %3, обратитесь к программисту.", КолонкаМакета.Ключ, ИмяМакета, Значение),,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Если ПараметрыОтбора <> Неопределено Тогда
		
		Если ПараметрыОтбора.Свойство("ВерсияТаксономии") И Таблица.Колонки.Найти("ВерсияТаксономии") = Неопределено Тогда
			ПараметрыОтбора.Удалить("ВерсияТаксономии")
		КонецЕсли;
		
		Если ПараметрыОтбора.Свойство("КонецПериода") Тогда
			ПараметрыОтбора.Удалить("КонецПериода")
		КонецЕсли;
		
		Если ПараметрыОтбора.Свойство("ПериодичностьОтчета") Тогда
			ПараметрыОтбора.Удалить("ПериодичностьОтчета")
		КонецЕсли;
		
		Если ПараметрыОтбора.Количество() > 0 Тогда
			Результат = Таблица.Скопировать(ПараметрыОтбора);
		Иначе
			Результат = Таблица;	
		КонецЕсли;
	Иначе
		Результат = Таблица;
	КонецЕсли;
	
	Если Сортировка <> Неопределено Тогда
		Результат.Сортировать(Сортировка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуИзМакетаДляКлиента(ИмяМакета, ВхИмяПакета = Неопределено, Отказ = Ложь, ПараметрыПоиска = Неопределено, Сортировка = Неопределено) Экспорт
	
	МассивСтрок  = Новый Массив;
	ИменаКолонок = Новый Массив;
	
	ТаблицаИзМакета = ПолучитьТаблицуИзМакета(ИмяМакета, ВхИмяПакета, Отказ, ПараметрыПоиска, Сортировка);
	
	Для Каждого Колонка Из ТаблицаИзМакета.Колонки Цикл
		ИменаКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	
	ИменаКолонокСтрокой = СтрСоединить(ИменаКолонок, ",");
	
	Для Каждого СтрокаТаблицыИзМакета Из ТаблицаИзМакета Цикл
		ДанныеСтроки = Новый Структура(ИменаКолонокСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаТаблицыИзМакета);
		МассивСтрок.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ВыгрузитьЗначения(СписокЗначений, Пометка = Неопределено)
	
	МассивЗначений = Новый Массив;
	
	Если Пометка = Неопределено Тогда
		МассивЗначений = СписокЗначений.ВыгрузитьЗначения();
	Иначе
		Для Каждого ЭлементСписка Из СписокЗначений Цикл
			Если ЭлементСписка.Пометка = Пометка Тогда
				МассивЗначений.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат МассивЗначений;
	
КонецФункции

Процедура ПоместитьДанныеВоВременноеХранилище(Идентификатор, Данные)
	
	УдалитьИдентификаторВременногоХранилища(Идентификатор);	
	АдресаВременныхХранилищ.Добавить(Идентификатор, ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификаторФормы));
	
КонецПроцедуры

Функция ПолучитьДанныеИзВременногоХранилища(Идентификатор, ПустыеДанные)

	НайденноеЗначение = АдресаВременныхХранилищ.НайтиПоЗначению(Идентификатор);
	Если НайденноеЗначение = Неопределено Тогда
		Возврат ПустыеДанные;
	Иначе
		АдресВременногоХранилища = НайденноеЗначение.Представление;
	КонецЕсли;
	
	Данные = ПолучитьИзВременногоХранилища(НайденноеЗначение.Представление);
	
	Если Данные = Неопределено Тогда
		Возврат ПустыеДанные;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Процедура УдалитьИдентификаторВременногоХранилища(Идентификатор)
	
	НайденноеЗначение = АдресаВременныхХранилищ.НайтиПоЗначению(Идентификатор);
	Если НайденноеЗначение <> Неопределено Тогда
		АдресаВременныхХранилищ.Удалить(НайденноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВложениеИзХранилища(ИмяВложения)
	
	МакетХранилищеВложений = ПолучитьМакет("ХранилищеВложений");
	
	АрхивВложений = Новый ЧтениеZipФайла(МакетХранилищеВложений.ОткрытьПотокДляЧтения());
	ЭлементАрхива = АрхивВложений.Элементы.Найти(ИмяВложения);
	
	Если ЭлементАрхива = Неопределено Тогда
		ВызватьИсключение "В хранилище вложений не обнаружен файл:" + ИмяВложения;
	КонецЕсли;
	
	ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор);
	
	АрхивВложений.Извлечь(ЭлементАрхива, ВременныйКаталог + "\");
	АрхивВложений.Закрыть();

	ДанныеВложения = Новый ДвоичныеДанные(ВременныйКаталог + "\" + ИмяВложения);
	
	УдалитьФайлы(ВременныйКаталог);
	
	Возврат ДанныеВложения;
	
КонецФункции

Функция ПроведеныРегламентныеОперацииПоСчетамДУНаДату(СчетаДУ, ДатаРасчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",			ДатаРасчета);
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетаДУ",		СчетаДУ);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления В (&СчетаДУ)
		|	И ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис)
		|	И ДатыЗапретаРедактирования.ДатаЗапретаРедактирования < &Дата";
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПоместитьВЗапросТаблицыИзExcel(Запрос, Отказ)
	
	ОписаниеТаблиц	 = ПолучитьТаблицуИзМакета("ОписаниеЗагружаемыхExcelФайлов", ИмяПакета, Отказ);
	МассивИменТаблиц = Новый Массив;
	
	Для Каждого СтрокаОписанияТаблиц Из ОписаниеТаблиц Цикл
		Если МассивИменТаблиц.Найти(СтрокаОписанияТаблиц.ИмяТаблицы) = Неопределено Тогда
			МассивИменТаблиц.Добавить(СтрокаОписанияТаблиц.ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяТаблицы Из МассивИменТаблиц Цикл
		
		Данные = Новый ТаблицаЗначений;
		
		НайденныеСтроки = ОписаниеТаблиц.НайтиСтроки(Новый Структура("ИмяТаблицы", ИмяТаблицы));
		
		Для Каждого СтрокаОписанияТаблиц Из НайденныеСтроки Цикл
			
			// Колонка добавлены в макет ради вывода в расшифровку. В файлах Excel её еще не было
			Если СтрокаОписанияТаблиц.ИмяКолонки = "IDAvtomatizSistemIPrilozhTaxis" Тогда
				
				Продолжить;
				
			КонецЕсли;	

			ОписаниеТипа = СтрРазделить(СтрокаОписанияТаблиц.ТипЗначения, "(),");
			Если ОписаниеТипа.Количество() = 1 Тогда
				Данные.Колонки.Добавить(СтрокаОписанияТаблиц.ИмяКолонки, Новый ОписаниеТипов(ОписаниеТипа[0]));
			ИначеЕсли ОписаниеТипа[0] = "Строка" Тогда
				Данные.Колонки.Добавить(СтрокаОписанияТаблиц.ИмяКолонки, Новый ОписаниеТипов(ОписаниеТипа[0], Новый КвалификаторыСтроки(ОписаниеТипа[1])));
			ИначеЕсли ОписаниеТипа[0] = "Число" Тогда
				Данные.Колонки.Добавить(СтрокаОписанияТаблиц.ИмяКолонки, Новый ОписаниеТипов(ОписаниеТипа[0], Новый КвалификаторыЧисла(ОписаниеТипа[1], ОписаниеТипа[2])));
			Иначе
				Данные.Колонки.Добавить(СтрокаОписанияТаблиц.ИмяКолонки, Новый ОписаниеТипов(ОписаниеТипа[0]));
			КонецЕсли;				
		КонецЦикла;
		
		// У РПИ уникальное заполнение 6-го раздела. Значения измрений в строках могуть повторяться, т.к. делают отдельную строку для каждой ИС
		// Из-за этого сравнить таблицу, соединясь по измерениям, не получится и введено еще одно измерения КлючСтроки (число), чтобы просто сравнить таблицы построчно
		ФлагРПИ = Ложь;
		Если ЭтотОбъект.ЭтоРПИ И СтрНайти(ВРег("Curr_SR_NFO_2_R6,Pre_SR_NFO_2_R6"), ВРег(ИмяТаблицы)) > 0 Тогда
			
			Данные.Колонки.Добавить("КлючСтроки", Новый ОписаниеТипов("Число"));	
			ФлагРПИ = Истина;
			
		КонецЕсли;	
		
		МассивСтрок = ПолучитьДанныеИзВременногоХранилища(ИмяТаблицы, Новый Массив);
		
		Для Каждого СтрокаДанных Из МассивСтрок Цикл
			НоваяСтрокаДанных = Данные.Добавить();

			Если ФлагРПИ Тогда
				
				НоваяСтрокаДанных.КлючСтроки = Данные.Количество();	
				
			КонецЕсли;	
			
			Для Каждого СтрокаОписанияТаблиц Из НайденныеСтроки Цикл 

				// Колонка добавлены в макет ради вывода в расшифровку. В файлах Excel её еще не было
				Если СтрокаОписанияТаблиц.ИмяКолонки = "IDAvtomatizSistemIPrilozhTaxis" Тогда
					
					Продолжить;
					
				КонецЕсли;	
				
				НоваяСтрокаДанных[СтрокаОписанияТаблиц.ИмяКолонки] = СтрокаДанных[СтрокаОписанияТаблиц.ИмяКолонки];
				
				Если СтрНачинаетсяС(СтрокаОписанияТаблиц.ТипЗначения, "Строка") ИЛИ СтрНачинаетсяС(СтрокаОписанияТаблиц.ТипЗначения, "Число") Тогда
					Если НоваяСтрокаДанных[СтрокаОписанияТаблиц.ИмяКолонки] <> СтрокаДанных[СтрокаОписанияТаблиц.ИмяКолонки] Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
							"Неверно указана ширина или точность колонки %1 для страницы %2, не поместилось значение '%3', обратитесь к программисту.", 
							СтрокаОписанияТаблиц.Заголовок, 
							СтрокаОписанияТаблиц.ИмяСтраницы, 
							СтрокаДанных[СтрокаОписанияТаблиц.ИмяКолонки]),,,, Отказ);
					КонецЕсли;
				КонецЕсли;
					
			КонецЦикла;
		КонецЦикла;
		
		ЗаменитьВременнуюТаблицу(Запрос, ИмяТаблицы, Данные);
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьДействующиеДоговорыВОтчетномПериоде(ВидДоговораДоверительногоУправления) Экспорт
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		МВТ, 
		ЭтотОбъект.Период, 
		Новый Структура("Организация, ВидДоговораДоверительногоУправления", ЭтотОбъект.Организация, ВидДоговораДоверительногоУправления), 
		"_СчетаДоверительногоУправления");

	Возврат НЕ МВТ.Таблицы.Найти("_СчетаДоверительногоУправления").ПолучитьДанные().Пустой();
	
КонецФункции

Функция ЕстьДействующиеДоговорыНаОтчетнуюДату(ВидДоговораДоверительногоУправления) Экспорт
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		МВТ, 
		ЭтотОбъект.Период.ДатаОкончания, 
		Новый Структура("Организация, ВидДоговораДоверительногоУправления", ЭтотОбъект.Организация, ВидДоговораДоверительногоУправления), 
		"_СчетаДоверительногоУправления");

	Возврат НЕ МВТ.Таблицы.Найти("_СчетаДоверительногоУправления").ПолучитьДанные().Пустой();
	
КонецФункции

Функция ПолучитьДоступностьОтчетовПоВидамДеятельностиОрганизации()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ПолучитьТаблицуИзМакета("ДоступностьОтчетовПоВидамДеятельности"), "_ДоступностьОтчетовПоВидамДеятельности", Запрос);
	
	Запрос.Текст = СтрЗаменить(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Лицензии.ВидДеятельности КАК ВидДеятельности
		|ПОМЕСТИТЬ _Лицензии
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|		ПО Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(ДАТАВРЕМЯ(2017, 1, 1), ) КАК СтатусыЛицензийСрезПоследних
		|		ПО (Лицензии.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий КАК СтатусыЛицензий
		|		ПО (Лицензии.Ссылка = СтатусыЛицензий.Лицензия)
		|			И (СтатусыЛицензий.Период МЕЖДУ ДАТАВРЕМЯ(2017, 1, 1) И &ТекущаяДата)
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И НЕ Лицензии.ПометкаУдаления
		|	И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|			ИЛИ СтатусыЛицензий.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДоступностьОтчетовПоВидамДеятельности.СимволЗвездочка
		|ИЗ
		|	_ДоступностьОтчетовПоВидамДеятельности КАК _ДоступностьОтчетовПоВидамДеятельности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Лицензии КАК _Лицензии
		|		ПО _ДоступностьОтчетовПоВидамДеятельности.ВидДеятельности = _Лицензии.ВидДеятельности", "СимволЗвездочка", "*");
	//до 17 года не было отчётности.
	
	ДоступностьОтчетовПоВидамДеятельностиОрганизации = Новый Соответствие;
	
	ТаблицаДоступности = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаДоступности Из ТаблицаДоступности Цикл
		Для Каждого Колонка Из ТаблицаДоступности.Колонки Цикл
			Если ТипЗнч(СтрокаДоступности[Колонка.Имя]) = Тип("Булево") Тогда
				Если ДоступностьОтчетовПоВидамДеятельностиОрганизации.Получить(Колонка.Имя) = Неопределено 
				 ИЛИ ДоступностьОтчетовПоВидамДеятельностиОрганизации.Получить(Колонка.Имя) < СтрокаДоступности[Колонка.Имя] Тогда
					ДоступностьОтчетовПоВидамДеятельностиОрганизации.Вставить(Колонка.Имя, СтрокаДоступности[Колонка.Имя]);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДоступностьОтчетовПоВидамДеятельностиОрганизации;
	
КонецФункции

Функция ПолучитьЕстьЛицензияДУ()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",		 ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Лицензии.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _ЛицензииОрганизации
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|		ПО Организации.ЮрФизЛицо = Лицензии.ЮрФизЛицо
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И НЕ Лицензии.ПометкаУдаления
		|	И Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СтатусыЛицензийСрезПоследних.Лицензия КАК Лицензия
		|ИЗ
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних(
		|			&Период,
		|			Лицензия В
		|				(ВЫБРАТЬ
		|					_ЛицензииОрганизации.Ссылка
		|				ИЗ
		|					_ЛицензииОрганизации)) КАК СтатусыЛицензийСрезПоследних
		|ГДЕ
		|	СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
