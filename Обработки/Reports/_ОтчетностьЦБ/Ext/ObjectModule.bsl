Функция ПолучитьРасчетныеЦены_ОКУД0420511(Запрос)

	Отказ = Ложь;
	
	РасчетныеЦены  = Новый ТаблицаЗначений;
	РасчетныеЦены.Колонки.Добавить("СчетДоверительногоУправления"	, Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	РасчетныеЦены.Колонки.Добавить("ЦеннаяБумага"					, Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	РасчетныеЦены.Колонки.Добавить("Цена"							, Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
	РасчетныеЦены.Колонки.Добавить("Период"							, Новый ОписаниеТипов("Дата"));
	РасчетныеЦены.Колонки.Добавить("Валюта"							, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_РезультатЗапроса") = Неопределено Тогда
		Возврат РасчетныеЦены;
	КонецЕсли;
	
	ВТ_РезультатЗапроса	= ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_РезультатЗапроса", Отказ);
	
	ПараметрыПоиска = Новый Структура("Кол_РыночнаяЦена", 0);
	НайденныеСтроки = ВТ_РезультатЗапроса.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат РасчетныеЦены;
	КонецЕсли;
	
	МассивСчетовДУ = Новый Массив;
	
	СчетаИПериоды = Новый ТаблицаЗначений;
	СчетаИПериоды.Колонки.Добавить("СчетДоверительногоУправления"	, Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	СчетаИПериоды.Колонки.Добавить("Период"							, Новый ОписаниеТипов("Дата"));
	
	ТаблицаЦенныхБумаг = Новый ТаблицаЗначений;
	ТаблицаЦенныхБумаг.Колонки.Добавить("Рынок",						Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
	ТаблицаЦенныхБумаг.Колонки.Добавить("ЦеннаяБумага",					Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	ТаблицаЦенныхБумаг.Колонки.Добавить("Количество",					Новый ОписаниеТипов("Число"));
	ТаблицаЦенныхБумаг.Колонки.Добавить("Партия",						Новый ОписаниеТипов("ДокументСсылка.Сделка"));
	ТаблицаЦенныхБумаг.Колонки.Добавить("СтрокаПартии",					Новый ОписаниеТипов("Число"));
	ТаблицаЦенныхБумаг.Колонки.Добавить("УчетныйАктивЕПС",				Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
	ТаблицаЦенныхБумаг.Колонки.Добавить("СуммаРезервовПодОбесценение",	Новый ОписаниеТипов("Число"));
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация"	, ЭтотОбъект.Организация);
	ПараметрыРасчета.Вставить("ВидУчета"	, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	ПараметрыРасчета.Вставить("ЦельРасчета"	, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		ЗаполнитьЗначенияСвойств(СчетаИПериоды.Добавить(), СтрокаДанных);
	КонецЦикла;
	
	СчетаИПериоды.Свернуть("СчетДоверительногоУправления, Период", "");
	
	Для Каждого СчетИПериод Из СчетаИПериоды Цикл
		ТаблицаЦенныхБумаг.Очистить();
		
		ПараметрыПоиска.Вставить("СчетДоверительногоУправления", СчетИПериод.СчетДоверительногоУправления);
		НайденныеСтроки = ВТ_РезультатЗапроса.НайтиСтроки(ПараметрыПоиска);
		
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			СтрокаТаблицы = ТаблицаЦенныхБумаг.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДанных);
			
			СтрокаТаблицы.УчетныйАктивЕПС = БухгалтерскийУчет.ОпределитьУчетныйАктивЕПС(СчетИПериод.Период, СтрокаТаблицы.Рынок, СтрокаТаблицы.ЦеннаяБумага);
		КонецЦикла;
		
		ПараметрыРасчета.Вставить("СчетДоверительногоУправления"	, СчетИПериод.СчетДоверительногоУправления);
		ПараметрыРасчета.Вставить("ВариантРасчетаОценочнойСтоимости", СтрокаДанных.ВариантРасчетаОценочнойСтоимости);
		
		РасчетныеСтоимостиЦБ = ПолучитьРасчетнуюСтоимостьЦБ_ОКУД0420511(ПараметрыРасчета, КонецДня(СчетИПериод.Период), Отказ, ТаблицаЦенныхБумаг);
		
		Если РасчетныеСтоимостиЦБ <> Неопределено Тогда
			Для Каждого СтрокаЦены Из РасчетныеСтоимостиЦБ Цикл
				СтрокаРасчетныхЦен = РасчетныеЦены.Добавить();
				СтрокаРасчетныхЦен.СчетДоверительногоУправления = СчетИПериод.СчетДоверительногоУправления;
				СтрокаРасчетныхЦен.ЦеннаяБумага					= СтрокаЦены.ЦеннаяБумага;
				СтрокаРасчетныхЦен.Цена							= СтрокаЦены.Цена;
				СтрокаРасчетныхЦен.Период						= СчетИПериод.Период;
				СтрокаРасчетныхЦен.Валюта						= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаЦены.ЦеннаяБумага, "ВалютаНоминала");
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РасчетныеЦены;
	
КонецФункции

Функция ПолучитьРасчетнуюСтоимостьЦБ_ОКУД0420511(Параметры, Период, Отказ, ТаблицаЦенныхБумаг = Неопределено)
	
	АдресФайлаXML = Неопределено;
	Если Параметры.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.ПредоставленаКлиентом Тогда
		
		ПутьКФайлу = РаботаСПереоценкой.ПолучитьПутьКФайлуОценочнойСтоимостиПредоставленнойКлиентом(Параметры.СчетДоверительногоУправления, Период);
		АдресФайлаXML = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу));
		
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация",						Параметры.Организация);
	ПараметрыРасчета.Вставить("СчетДоверительногоУправления",		Параметры.СчетДоверительногоУправления);
	ПараметрыРасчета.Вставить("ВидУчета", 							Параметры.ВидУчета);
	ПараметрыРасчета.Вставить("ЦельРасчета",						Параметры.ЦельРасчета);
	ПараметрыРасчета.Вставить("Дата",								КонецДня(Период));
	
	УстановитьПривилегированныйРежим(Истина);	
	
	// Получаем стоимость ЦБ
	ПереоценкаЦБ = Документы.РегистрацияСтоимостиПереоценки.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(ПереоценкаЦБ, ПараметрыРасчета);
	ПереоценкаЦБ.ЗаполнитьСтоимостьПереоценки(Истина, Ложь, Отказ, АдресФайлаXML, Ложь, , ТаблицаЦенныхБумаг);
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	Возврат ПереоценкаЦБ.СтоимостиПереоценки.Выгрузить();
	
КонецФункции

Процедура ЗаполнитьПечатнуюФорму_ОКУД0420511(ПакетДанных, Результат, Отказ) Экспорт
	
	ПакетОтчет = ПакетДанных.Отчет;
		
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.Автомасштаб = Истина;
	
	Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Таб_СведенияОСделкахСтроки_1");
		
	ОбластьШапка.Параметры.ОтчетнаяДата		= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	//Данные в отчете о сделках указываются следующим образом: цена – в рублях с двумя десятичными
	//знаками после запятой, объем сделки и объем сделок с ценной бумагой – в тысячах рублей, отклонение
	//цены сделки от рыночной цены ценной бумаги – в процентах от рыночной цены ценной бумаги с двумя
	//десятичными знаками после запятой
	
	Для Каждого СтрокаДанных Из ПакетОтчет.ОтчетОСделках.Таблица_ОтчетОСделках.Таб_СведенияОСделкахСтроки_1 Цикл
		Если СтрокаДанных = "ЗаполнитьПустымиЗначениями" Тогда
			Для Индекс = 0 По ОбластьСтрока.Параметры.Количество() - 1 Цикл
				ОбластьСтрока.Параметры.Установить(Индекс, ЭтотОбъект.ПустоеЗначение);
			КонецЦикла;
			Результат.Вывести(ОбластьСтрока);
		Иначе
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных); 
			Результат.Вывести(ОбластьСтрока);
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанных.Кол_РыночнаяЦена)
			 ИЛИ СтрокаДанных.Кол_РыночнаяЦена = "0.00" Тогда
				Результат.Область(Результат.ВысотаТаблицы, 18, Результат.ВысотаТаблицы, 18).ЦветФона = Новый Цвет(255, 0, 0);	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отсутствует цена в строке %1", СтрокаДанных.Кол_НомерСтроки));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ОбластьПодвал						   		 = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ФИОРуководителя      = ПакетОтчет.ПодписьРуководителяУК.ФИО3; 	
	ОбластьПодвал.Параметры.ФИОУполномоченногоСД = ПакетОтчет.ПодписьУполномочСпецДеп.ФИО;
	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Функция ПолучитьРынкиЦенныхБумаг()
	
	Результат = Новый Массив;
		
	Для Каждого Рынок Из Перечисления.РынкиЦенныхБумаг Цикл
		Если Рынок = Перечисления.РынкиЦенныхБумаг.Опционы 
			Или Рынок = Перечисления.РынкиЦенныхБумаг.Доли
			Или Рынок = Перечисления.РынкиЦенныхБумаг.ВалютныеПары
			Или Рынок = Перечисления.РынкиЦенныхБумаг.Фьючерсы Тогда
				Продолжить;
		КонецЕсли;
			
		Результат.Добавить(Рынок);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОКУД0420511_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420511(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420511";
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	Если НЕ ЭтотОбъект.ВариантФормированияПоСчетамДУ = "ПоСчетуДУ" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Отчёт %1 в формате XBRL может формироваться только по одному счёту ДУ", ИмяПакета),,,, Отказ);
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос = Новый Запрос;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ДатаНачала", 									ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 									КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", 									ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 					ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ОтбиратьПоСчетуДУ", 								ЭтотОбъект.ВариантФормированияПоСчетамДУ = "ПоВсемСчетамДУ" ИЛИ ЭтотОбъект.ВариантФормированияПоСчетамДУ = "ПоСчетуДУ");
	Запрос.УстановитьПараметр("ВидПоказателя", 									Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("БиржаММВБ", 										ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));		
	Запрос.УстановитьПараметр("Руководитель", 									ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа",						ПолучитьПолноеФИООтветственногоЛица("УполномоченноеЛицоСпецДепа"));
	Запрос.УстановитьПараметр("РасчетныеЦены", 									ПолучитьРасчетныеЦены_ОКУД0420511(Запрос));
	Запрос.УстановитьПараметр("РынкиЦенныхБумаг", 								ПолучитьРынкиЦенныхБумаг());
	Запрос.УстановитьПараметр("НеУчитыватьОценкуПоАмортизированнойСтоимости", 	ЭтотОбъект.Период.ДатаОкончания >= '20221102');
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420511_РезультатЗапроса();
	Запрос.Выполнить();
	
	РасчетныеЦены = ПолучитьРасчетныеЦены_ОКУД0420511(Запрос);
	Если РасчетныеЦены.Количество() > 0 Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("РасчетныеЦены", РасчетныеЦены);
		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420511_РезультатЗапроса();
		Запрос.Выполнить();
		
	КонецЕсли;
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420511();
	Запрос.Выполнить();
	
	ПризнакНулевогоОтчета = Истина;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

#КонецОбласти

//Отчет об инвестировании средств пенсионных накоплений Пенсионного фонда Российской Федерации
#Область ОКУД0420512_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420512(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420512";
	ПакетДанных = Новый Структура;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ПризнакНулевогоОтчета = Истина;
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР) Тогда
	
		ИспользоватьДанныеБэкОфиса = ЭтотОбъект.Период.ДатаНачала >= '20190101';
		
		// Постепенно перерабатываем на получение всех данных из бэк-офиса
		Проценты 				= 0;
		Проценты_СНачалаГода 	= 0;
		Если ИспользоватьДанныеБэкОфиса И ЭтотОбъект.Период.ДатаОкончания < '20250101' Тогда	
			Проценты 				= ПолучитьПроцентыПоДепозитуИзСЧА(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
			Проценты_СНачалаГода 	= ПолучитьПроцентыПоДепозитуИзСЧА(НачалоГода(ЭтотОбъект.Период.ДатаНачала), ЭтотОбъект.Период.ДатаОкончания);
		КонецЕсли;
		
		ГруппыДоходовИРасходов = ПолучитьСоставГруппДоходовИРасходов(ИспользоватьДанныеБэкОфиса);
		
		Запрос.УстановитьПараметр("ДатаНачала",		  ЭтотОбъект.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",	  ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);	
		
		// Точки входа - отдельные даты. Данные для отчета при этом собираются ровно с начала квартала (или года) по конец квартала
		
		// Даты для точек входа:
		// 1. День за последним рабочим днем предыдущего квартала
		Запрос.УстановитьПараметр("ДеньЗаПоследнимРабочимДнемПредыдущегоКвартала", Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -3))) + 60 * 60 * 24);
		
		// 3. Последний рабочий день предыдущего квартала 
		Запрос.УстановитьПараметр("ПоследнийРабочийДеньПредыдущегоКвартала", Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -3))));
		
		// 4. Начало года
		Запрос.УстановитьПараметр("НачалоГода"						, НачалоГода(ЭтотОбъект.Период.ДатаОкончания));
		
		// 5. Конец предыдущего года
		Запрос.УстановитьПараметр("КонецПредыдущегоГода"			, КонецГода(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -12)));
			
		Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Руководитель",				ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
		Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа",	ПолучитьПолноеФИООтветственногоЛица("УполномоченноеЛицоСпецДепа"));
		
		Запрос.УстановитьПараметр("ФинансовыйРезультатОтРеализации"			, ГруппыДоходовИРасходов.ФинансовыйРезультатОтРеализации);
		Запрос.УстановитьПараметр("ДивидендыИПроцентыПоЦБ"					, ГруппыДоходовИРасходов.ДивидендыИПроцентыПоЦБ);
		Запрос.УстановитьПараметр("ПроцентыПоДепозитам"						, ГруппыДоходовИРасходов.ПроцентыПоДепозитам);
		Запрос.УстановитьПараметр("ФинансовыйРезультатОтПереоценкиАктивов"	, ГруппыДоходовИРасходов.ФинансовыйРезультатОтПереоценкиАктивов);
		Запрос.УстановитьПараметр("ДругиеВидыДоходов"						, ГруппыДоходовИРасходов.ДругиеВидыДоходов);
		Запрос.УстановитьПараметр("ОплатаУслугСпецДепозитария"				, ГруппыДоходовИРасходов.ОплатаУслугСпецДепозитария);
		Запрос.УстановитьПараметр("ОплатаУслугПрофУчастниковРынкаЦБ"		, ГруппыДоходовИРасходов.ОплатаУслугПрофУчастниковРынкаЦБ);
		Запрос.УстановитьПараметр("ОплатаУслугАудитора"						, ГруппыДоходовИРасходов.ОплатаУслугАудитора);
		Запрос.УстановитьПараметр("ВознаграждениеУправляющейКомпании"		, ГруппыДоходовИРасходов.ВознаграждениеУправляющейКомпании);
		Запрос.УстановитьПараметр("РасходыНаОбязательноеСтрахование"		, ГруппыДоходовИРасходов.РасходыНаОбязательноеСтрахование);
		Запрос.УстановитьПараметр("ОплатаПрочихУслуг"						, ГруппыДоходовИРасходов.ОплатаПрочихУслуг);
		Запрос.УстановитьПараметр("ИсключенныеДоходыИРасходы"				, ГруппыДоходовИРасходов.ИсключенныеДоходыИРасходы);

		Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации"			, ИсключаемыеГоловныеОрганизации);
		Запрос.УстановитьПараметр("ПроцентыПоДепозитамИзСЧА"				, Проценты);
		Запрос.УстановитьПараметр("ПроцентыПоДепозитамИзСЧА_СНачалаГода"	, Проценты_СНачалаГода);
		Запрос.УстановитьПараметр("КонецПредыдущегоГода"				    , КонецГода(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -12)));
		Запрос.УстановитьПараметр("ИспользоватьДанныеБэкОфиса"				, ИспользоватьДанныеБэкОфиса);
			
		МассивВидовОперацийВводаАктивов = Новый Массив;
		МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР);
		МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление);
		
		Запрос.УстановитьПараметр("ВидыОперацийВводаАктивов", МассивВидовОперацийВводаАктивов); 
		
		МассивВидовОперацийВыводаАктивов = Новый Массив;
		МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению);
		МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР);
		
		Запрос.УстановитьПараметр("ВидыОперацийВыводаАктивов", МассивВидовОперацийВыводаАктивов); 

		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420512();
		Запрос.Выполнить();
			
		// Проверяем соответствие зарегистрированной и расчетной СЧА
		СуммыПоБухУчету = ВыгрузитьВременнуюТаблицу(Запрос, "_РасходыБУ");
		Если СуммыПоБухУчету.Количество() = 0 Тогда 
			Отказ = Истина;
			Возврат ПакетДанных;
		КонецЕсли;
		
		ПоказателиОтчета = ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_Данные");
		Если ПоказателиОтчета.Количество() = 0 Тогда 
			Отказ = Истина;
			Возврат ПакетДанных;
		КонецЕсли;
		
		СтрокаДоходаОтИнвестирования = СуммыПоБухУчету.Найти("ДоходОтИнвестирования", "Показатель");
		
		Если СтрокаДоходаОтИнвестирования = Неопределено Тогда 
			Отказ = Истина;
			Возврат ПакетДанных;
		КонецЕсли;
		
		СтрокаДоходаОтИнвестирования_СНачалаГода = СуммыПоБухУчету.Найти("ДоходОтИнвестирования_СНачалаГода", "Показатель");
		
		Если СтрокаДоходаОтИнвестирования_СНачалаГода = Неопределено Тогда 
			Отказ = Истина;
			Возврат ПакетДанных;
		КонецЕсли;
		
		
		СтрокаПоказателейОтчета = ПоказателиОтчета[0];
		
		РасчетнаяСЧА = СтрокаПоказателейОтчета.СтоимЧистАктивов_НачалоГода 
									+ СтрокаПоказателейОтчета.ПоступлениеАктивов_СНачалаГода 
									+ СтрокаДоходаОтИнвестирования_СНачалаГода.Сумма 
									- СтрокаПоказателейОтчета.ИзъятиеАктивов_СНачалаГода 
									- СтрокаПоказателейОтчета.НеобходимыеРасходыУК_СНачалаГода
									- СтрокаПоказателейОтчета.ВознаграждениеУК_СНачалаГода;
									
		СтоимЧистАктивовНаКонецОтчПериода = СтрокаПоказателейОтчета.СтоимЧистАктивовНаКонецОтчПериода;
		ПроверкаСЧАВыполнена = РасчетнаяСЧА = СтоимЧистАктивовНаКонецОтчПериода;
		
		ЕстьОшибки = Ложь;
		Если Не ПроверкаСЧАВыполнена Тогда			
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Зарегистрированная СЧА на конец периода (" + Формат(СтрокаПоказателейОтчета.СтоимЧистАктивовНаКонецОтчПериода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") отличается от СЧА (" + Формат(РасчетнаяСЧА, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + "), рассчитанной по формуле 
			|<СЧА на начало года> (" + Формат(СтрокаПоказателейОтчета.СтоимЧистАктивов_НачалоГода,"ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|+ <Вводы активов с начала года> (" + Формат(СтрокаПоказателейОтчета.ПоступлениеАктивов_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|– <Выводы активов с начала года> (" + Формат(СтрокаПоказателейОтчета.ИзъятиеАктивов_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") 
			|+ <Доход от инвестирования по бух. учету с начала года> (" + Формат(СтрокаДоходаОтИнвестирования_СНачалаГода.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|- <Необходимые расходы УК с начала года> (" + Формат(СтрокаПоказателейОтчета.НеобходимыеРасходыУК_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|- <Вознаграждение УК с начала года> (" + Формат(СтрокаПоказателейОтчета.ВознаграждениеУК_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")");
			
			ЕстьОшибки = Истина;
			
		КонецЕсли; 
		
		РасчетнаяСЧА = СтрокаПоказателейОтчета.СтоимЧистАктивов
									+ СтрокаПоказателейОтчета.ПоступлениеАктивов
									+ СтрокаДоходаОтИнвестирования.Сумма 
									- СтрокаПоказателейОтчета.ИзъятиеАктивов
									- СтрокаПоказателейОтчета.НеобходимыеРасходыУК
									- СтрокаПоказателейОтчета.ВознаграждениеУК;
									
