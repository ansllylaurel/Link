Функция ПолучитьПолноеФИООтветственногоЛица(ОтветственноеЛицо)
	
	МассивРеквизитов = Новый Массив;
	
	Если ОтветственноеЛицо = "Руководитель" Тогда
		РеквизитыРуководителя = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Руководитель,, "Фамилия, Имя, Отчество");
		
		МассивРеквизитов.Добавить(РеквизитыРуководителя.Фамилия);
		МассивРеквизитов.Добавить(РеквизитыРуководителя.Имя);
		МассивРеквизитов.Добавить(РеквизитыРуководителя.Отчество);
		
	ИначеЕсли ОтветственноеЛицо = "Контролер" Тогда
		РеквизитыКонтролера = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(ЭтотОбъект.Организация, ЭтотОбъект.Контролер,, "Фамилия, Имя, Отчество");
		
		МассивРеквизитов.Добавить(РеквизитыКонтролера.Фамилия);
		МассивРеквизитов.Добавить(РеквизитыКонтролера.Имя);
		МассивРеквизитов.Добавить(РеквизитыКонтролера.Отчество);
		
	ИначеЕсли ОтветственноеЛицо = "УполномоченноеЛицоСпецДепа" Тогда
		
		МассивРеквизитов.Добавить(ЭтотОбъект.УполномоченноеЛицоСпецДепа_Фамилия);
		МассивРеквизитов.Добавить(ЭтотОбъект.УполномоченноеЛицоСпецДепа_Имя);
		МассивРеквизитов.Добавить(ЭтотОбъект.УполномоченноеЛицоСпецДепа_Отчество);
		
	КонецЕсли;
	
	Возврат СтрСоединить(МассивРеквизитов, " ");
 
КонецФункции

