Функция ПолучитьОписаниеОКВЭД(КодОКВЭД, Отказ)
	
	Если ПолучитьЗначениеНастройкиОтчета("РаскрыватьНаименованияОКВЭД",, Отказ) = ЛОЖЬ Тогда
		Возврат КодОКВЭД;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаКодовОКВЭД) <> Тип("ТаблицаЗначений") Тогда
		ТаблицаКодовОКВЭД = Новый ТаблицаЗначений;
		ТаблицаКодовОКВЭД.Колонки.Добавить("Код");
		ТаблицаКодовОКВЭД.Колонки.Добавить("Наименование");
		
		МакетОКВЭД = ПолучитьОбщийМакет("ОКВЭД").ПолучитьОбласть("Классификатор");
		
		Для НомерСтроки = 1 По МакетОКВЭД.ВысотаТаблицы Цикл
			НовыйКодОКВЭД = ТаблицаКодовОКВЭД.Добавить();
			НовыйКодОКВЭД.Код			= СокрЛП(МакетОКВЭД.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
			НовыйКодОКВЭД.Наименование	= СокрЛП(МакетОКВЭД.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		КонецЦикла;
		
		МакетОКВЭД = ПолучитьОбщийМакет("ОКВЭД2").ПолучитьОбласть("Классификатор");
		
		Для НомерСтроки = 1 По МакетОКВЭД.ВысотаТаблицы Цикл
			НовыйКодОКВЭД = ТаблицаКодовОКВЭД.Добавить();
			НовыйКодОКВЭД.Код			= СокрЛП(МакетОКВЭД.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
			НовыйКодОКВЭД.Наименование	= СокрЛП(МакетОКВЭД.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		КонецЦикла;
		
	КонецЕсли;
	
	МассивКодов = СтрРазделить(КодОКВЭД, ",");
	
	Для Индекс = 0 По МассивКодов.Количество() - 1 Цикл
		Код = МассивКодов[Индекс];
		
		ПараметрыПоиска = Новый Структура("Код", СокрЛП(Код));
		НайденныеСтроки = ТаблицаКодовОКВЭД.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить код ОКВЭД: " + Код);
		ИначеЕсли НайденныеСтроки.Количество() > 1 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обнаружены дубли для кода ОКВЭД: " + Код);
		Иначе
			МассивКодов.Установить(Индекс, НайденныеСтроки[0].Код + " " + НайденныеСтроки[0].Наименование); 
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(МассивКодов, ",");
	
КонецФункции

Функция РазделыОтчетаXBRL(ВхИмяПакета) Экспорт
	
	Отказ = Ложь;
	
	КонецПериода = ?(КонецГода(ЭтотОбъект.Период.ДатаОкончания) =  КонецМесяца(ЭтотОбъект.Период.ДатаОкончания),		"Год",
					?(КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) = КонецМесяца(ЭтотОбъект.Период.ДатаОкончания),	"Квартал", "Месяц"));
	
	РазделыОтчета = ПолучитьТаблицуИзМакета("РазделыXBRL", ВхИмяПакета, Отказ, Новый Структура("ВерсияТаксономии, КонецПериода, ПериодичностьОтчета, ИсточникДанных", ЭтотОбъект.ВерсияТаксономии, КонецПериода, ЭтотОбъект.ПериодичностьОтчета, "")); 

	Если НЕ РазделыОтчета.Количество() ИЛИ Отказ Тогда
		ВызватьИсключение "Не удалось заполнить разделы отчёта " + ВхИмяПакета + " для таксономии " + ВерсияТаксономии;
	КонецЕсли;
	
	Возврат РазделыОтчета;
	
КонецФункции

Процедура ЗаполнитьТипыОбъектов(Отказ)

	ИмяСхемы = ПолучитьИмяСхемыXBRL(Отказ);
	
	АрхивСхемТаксономии = ПолучитьАрхивСВерсиейТаксономии(ЭтотОбъект.ВерсияТаксономии);
	
	ЭлементАрхива = АрхивСхемТаксономии.Элементы.Найти(ИмяСхемы + ".xsd");
	
	Если ЭлементАрхива = Неопределено Тогда
		ВызватьИсключение "В архиве версии таксономии " + ЭтотОбъект.ВерсияТаксономии + " нет схемы " + ИмяСхемы;
	КонецЕсли;
	
	КаталогСхемы = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор);
	
	АрхивСхемТаксономии.Извлечь(ЭлементАрхива, КаталогСхемы + "\");
	АрхивСхемТаксономии.Закрыть();
	
	ТипыОбъектов = Новый Структура;
	ТипыЗначений = Новый Структура;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(КаталогСхемы + "\" + ИмяСхемы + ".xsd");
	
	Пока ЧтениеXML.Прочитать() Цикл
		
#Область ТипыЗначений
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "xs:simpleType" Тогда
			ОписаниеПростогоТипа = Новый Структура;
			ОписаниеПростогоТипа.Вставить("Имя",			ЧтениеXML.ПолучитьАтрибут("name"));
			ОписаниеПростогоТипа.Вставить("Перечисление",	Новый Массив);
			
			Пока ЧтениеXML.Прочитать() Цикл 
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "xs:enumeration" Тогда
					ОписаниеЭлемента = Новый Структура;
					ОписаниеЭлемента.Вставить("Имя", ЧтениеXML.ПолучитьАтрибут("value"));
					
					Пока ЧтениеXML.Прочитать() Цикл 
						Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "xs:documentation" Тогда
							Если ЧтениеXML.Прочитать() Тогда
								ОписаниеЭлемента.Вставить("Представление", ЧтениеXML.Значение);
							КонецЕсли;
						КонецЕсли;
						
						Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "xs:enumeration" Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					ОписаниеПростогоТипа.Перечисление.Добавить(ОписаниеЭлемента);
					
				КонецЕсли;
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "xs:simpleType" Тогда
					ТипыОбъектов.Вставить(СтрСоединить(СтрРазделить(ОписаниеПростогоТипа.Имя, ".-"), "_"), ОписаниеПростогоТипа);
					Прервать;
				КонецЕсли;
			КонецЦикла;	
			
		КонецЕсли;
#КонецОбласти
		
#Область ТипыОбъектов
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "xs:complexType" Тогда
			ОписаниеКомплексногоТипа = Новый Структура;
			ОписаниеКомплексногоТипа.Вставить("Имя",		ЧтениеXML.ПолучитьАтрибут("name"));
			ОписаниеКомплексногоТипа.Вставить("Атрибуты",	Новый Массив);
			ОписаниеКомплексногоТипа.Вставить("Элементы",	Новый Массив);
			ОписаниеКомплексногоТипа.Вставить("Представление", СокрЛП(ОписаниеКомплексногоТипа.Имя));

			Пока ЧтениеXML.Прочитать() Цикл 
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
				   И ЧтениеXML.Имя = "xs:attribute"
				   И ОписаниеКомплексногоТипа <> Неопределено Тогда
					ОписаниеАтрибута = Новый Структура;
					ОписаниеАтрибута.Вставить("Имя"			, ЧтениеXML.ПолучитьАтрибут("name")); 
					ОписаниеАтрибута.Вставить("Тип"			, ЧтениеXML.ПолучитьАтрибут("type")); 
					ОписаниеАтрибута.Вставить("Обязательный", ЧтениеXML.ПолучитьАтрибут("use") = "required"); 
					
					ОписаниеКомплексногоТипа.Атрибуты.Добавить(ОписаниеАтрибута);
				КонецЕсли;
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента 
				   И ЧтениеXML.Имя = "xs:element"
				   И ОписаниеКомплексногоТипа <> Неопределено Тогда
					ОписаниеЭлемента = Новый Структура;
					ОписаниеЭлемента.Вставить("Имя"			, ЧтениеXML.ПолучитьАтрибут("name")); 
					ОписаниеЭлемента.Вставить("Тип"			, ЧтениеXML.ПолучитьАтрибут("type")); 
					ОписаниеЭлемента.Вставить("Обязательный", ЧтениеXML.ПолучитьАтрибут("use") = "required"); 
					ОписаниеЭлемента.Вставить("Представление", СокрЛП(ОписаниеЭлемента.Имя));
					
					Пока ЧтениеXML.Прочитать() Цикл 
						Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "xs:documentation" Тогда
							Если ЧтениеXML.Прочитать() Тогда
								ОписаниеЭлемента.Вставить("Представление", ЧтениеXML.Значение);
							КонецЕсли;
						КонецЕсли;
						
						Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "xs:element" Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					ОписаниеКомплексногоТипа.Элементы.Добавить(ОписаниеЭлемента);
				КонецЕсли;
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "xs:documentation" Тогда
					Если ЧтениеXML.Прочитать() Тогда
						ОписаниеКомплексногоТипа.Вставить("Представление", ЧтениеXML.Значение);
					КонецЕсли;
				КонецЕсли;
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = "xs:complexType" Тогда
					ТипыОбъектов.Вставить(СтрСоединить(СтрРазделить(ОписаниеКомплексногоТипа.Имя, ".-"), "_"), ОписаниеКомплексногоТипа);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
#КонецОбласти

	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьОписаниеТаблицы(ИмяТаблицы, Отказ)
	
	Если ТипыОбъектов = Неопределено Тогда
		ЗаполнитьТипыОбъектов(Отказ);
	КонецЕсли;
	
	ОписаниеТаблицы = Новый Структура;
	ОписаниеТаблицы.Вставить("Представление",	ТипыОбъектов["type_" + ИмяТаблицы].Представление);
	ОписаниеТаблицы.Вставить("Элементы",		ТипыОбъектов["type_" + ИмяТаблицы + "_Item"].Элементы);
	
	Возврат ОписаниеТаблицы;
	
КонецФункции

Функция СопроводительнаяИнформацияВыгружаетсяНаПоследнийРабочийДень(Отказ)
	
	Результат = Ложь;
	
	Если ЭтотОбъект.ВерсияТаксономии = "5_2" Или ЭтотОбъект.ВерсияТаксономии = "5_2_0_7" Или ЭтотОбъект.ВерсияТаксономии >= "6_1" Тогда
		ИмяСхемыXBRL = ПолучитьИмяСхемыXBRL(Отказ);
		// Точка входа ep_nso_uk_oper_nr добавлена, чтобы для неё даты периода сопроводительной информации приравнивались к дате окончания периода
		Если ИмяСхемыXBRL = "ep_nso_aif_uk_m_10rd_specdep" ИЛИ ИмяСхемыXBRL = "ep_nso_aif_uk_q_y_10rd_specdep" Или ИмяСхемыXBRL = "ep_nso_uk_oper_q_y_10rd" Или ИмяСхемыXBRL = "ep_nso_uk_oper_nr" Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ДополнительныеПроцедурыИФункцииПечатныхФорм

Функция СформироватьМассивСтрокДляПечатнойФормы(Запрос, ИмяВременнойТаблицы, ПоляСортировки, Отказ)

	Данные = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, ИмяВременнойТаблицы,,,, ?(ЗначениеЗаполнено(ПоляСортировки),ПоляСортировки,Неопределено)).Выгрузить();
	
	МассивСтрок		= Новый Массив;
	МассивКолонок	= Новый Массив;
	
	Для Каждого Колонка Из Данные.Колонки Цикл
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ДанныеСтроки = Новый Структура("НомерСтроки", МассивСтрок.Количество() + 1);
		
		Для Каждого Колонка Из МассивКолонок Цикл
			Если Колонка = "КодВидаПоказателя505" Тогда
				СтрокаДанных[Колонка] = Лев(СтрокаДанных[Колонка], 3) + Прав("0" + Строка(МассивСтрок.Количество() + 1), 2);
			ИначеЕсли Колонка = "КодРасходаДУ503" Тогда
				СтрокаДанных[Колонка] = "06." + Прав("0" + Строка(МассивСтрок.Количество() + 1), 2);
			КонецЕсли;
			
			ДанныеСтроки.Вставить(Колонка, СериализоватьЗначениеПечатнойФормы(СтрокаДанных, Колонка, ИмяВременнойТаблицы, Отказ));
		КонецЦикла;
		
		МассивСтрок.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция СериализоватьЗначениеПечатнойФормы(СтрокаДанных, Колонка, ИмяВременнойТаблицы, Отказ)
	
	Значение = СтрокаДанных[Колонка];
	
	Если Колонка = "НомерФилиалаКредитнойОрганизации" Тогда		
		Значение = СтрРазделить(Строка(Значение) + "/", "/")[1];
		
	ИначеЕсли Колонка = "ЛицензияКредитнойОрганизации" Тогда
		Значение = СтрРазделить(Строка(Значение) + "/", "/")[0];

	ИначеЕсли Колонка = "ДокументКредитора" Тогда
		Если ТипЗнч(СтрокаДанных.Основание) = Тип("ДокументСсылка.ЗаявкаПайщика") Тогда
			Значение = ПредставлениеДокументаУдостоверенияЛицности(Значение, СтрокаДанных.Основание.Дата);
		КонецЕсли;
		
	ИначеЕсли Колонка = "КодПоОКВЭД" Тогда
		Возврат ПолучитьОписаниеОКВЭД(Значение, Отказ);
		
	ИначеЕсли Колонка = "МестонахождениеДолжника" ИЛИ Колонка = "МестонахождениеКредитора" ИЛИ Колонка = "МестонахождениеАрендодателя" Тогда
		Возврат ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес, ИмяПакета = "ОКУД0420501", Дата(2021,4,1), Отказ);		
		
	ИначеЕсли Колонка = "МестоНахожденияВекселя" Тогда
		Возврат ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ФактическийАдрес, ИмяПакета = "ОКУД0420501", Дата(2021,4,1), Отказ);
		
	ИначеЕсли Колонка = "УровеньОценки" Тогда
		
		Если Значение = 1 Тогда
			Возврат "Рыночные котировки (уровень 1)";
		ИначеЕсли Значение = 2 Тогда
			Возврат "Модель оценки, использующая данные наблюдаемых рынков (уровень 2)";
		ИначеЕсли Значение = 3 Тогда
			Возврат "Модель оценки, использующая значительный объем ненаблюдаемых данных (уровень 3)";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В таблице " + ИмяВременнойТаблицы + " не указан уровень оценки",,,, Отказ);
			Возврат "";
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
		
    ИначеЕсли Колонка = "СуммаАктивов"
        ИЛИ Колонка = "СуммаЗадолженности" 
        ИЛИ Колонка = "СуммаФактЗадолженности"
        ИЛИ Колонка = "СтоимостьАктива"
		ИЛИ Колонка = "СуммаАктивовФакт"
        ИЛИ Колонка = "СуммаДенежныхСредств" Тогда //проверить, может ещё какие-то есть
        
        Если Значение = 0 Тогда
            Возврат "0.00";
        КонецЕсли;
		
	КонецЕсли;
	
	//сериализация значения
	Если Значение = "Неприменимо" Тогда //надо переделать неприменимо на неопределено
		Возврат "";
		
	ИначеЕсли Значение = Неопределено Тогда 
		Возврат "";
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
		
	КонецЕсли;
		
	Возврат Значение;

КонецФункции

Функция ПолучитьДисклеймер(Запрос, Отказ)
	
#Область ТекстЗапроса
Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыУправляющейКомпании.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеУК,
		|	ВЫБОР
		|		КОГДА СтатусыЛицензийСрезПоследних.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)
		|			ТОГДА ""На осуществление деятельности по управлению инвестиционными фондами, паевыми инвестиционными фондами и негосударственными пенсионными фондами""
		|		ИНАЧЕ СтатусыЛицензийСрезПоследних.Лицензия.ВидДеятельности.Наименование
		|	КОНЕЦ КАК ВидЛицензии,
		|	СтатусыЛицензийСрезПоследних.Лицензия.Серия + СтатусыЛицензийСрезПоследних.Лицензия.Номер КАК НомерЛицензии,
		|	СтатусыЛицензийСрезПоследних.Лицензия.ОрганВыдавшийЛицензию КАК ОрганВыдавшийЛицензию,
		|	СтатусыЛицензийСрезПоследних.Лицензия.ДатаВыдачи КАК ДатаВыдачиЛицензии,
		|	СтатусыЛицензийСрезПоследних.Лицензия.ДатаОкончания КАК ДатаОкончанияЛицензии,
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда КАК ПолноеНаименованиеПИФ,
		|	ПаевыеИнвестиционныеФонды.ДатаПравил КАК ДатаПравил,
		|	ПаевыеИнвестиционныеФонды.НомерПравил КАК НомерПравил,
		|	РеквизитыУправляющейКомпании.ЮридическийАдрес КАК ЮридическийАдресУК,
		|	РеквизитыУправляющейКомпании.Телефоны КАК ТелефоныУК,
		|	РеквизитыУправляющейКомпании.ВебСтраница КАК ВебСтраницаУК,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПредназначенДляКвалИнвесторов КАК ПредназначенДляКвалИнвесторов,
		|	ПаевыеИнвестиционныеФонды.ОрганУтвердившийПравила КАК ОрганУтвердившийПравила,
		|	ПаевыеИнвестиционныеФонды.Тип КАК Тип
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследнихНаНачало
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследнихНаНачало.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
		|		ПО (КлиентыДоверительногоУправленияСрезПоследнихНаНачало.Клиент = ПаевыеИнвестиционныеФонды.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ПаевыеИнвестиционныеФонды.Ссылка = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаОтчетности,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыУправляющейКомпании
		|		ПО (РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо = РеквизитыУправляющейКомпании.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&ДатаОкончания, Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)) КАК СтатусыЛицензийСрезПоследних
		|		ПО (РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо = СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо)
		|			И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ДатаОкончания, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|		ПО (ПаевыеИнвестиционныеФонды.Ссылка = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
#КонецОбласти

	Запрос.УстановитьПараметр("ДатаОтчетности", ЭтотОбъект.ДатаОтчетности);

	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные для дисклеймера. Обратитесь к программистам.",,,, Отказ);
		Возврат "";
	КонецЕсли;
	
	Если Выборка.ПредназначенДляКвалИнвесторов = Истина Тогда
		ШаблонРеквизиты = 
			"Управляющая компания: [ПолноеНаименованиеУК] (лицензия [ОрганВыдавшийЛицензию] №[НомерЛицензии] от [ДатаВыдачиЛицензии] года [ВидЛицензии]).
			|
			|Правила доверительного управления [ПолноеНаименованиеПИФ] зарегистрированы [ОрганУтвердившийПравила] [ДатаПравил] года за № [НомерПравил].
			|
			|Необходимую информацию о Фонде можно получить по адресу: 
			|[ЮридическийАдресУК], телефон: [ТелефоныУК].
			|
			|Инвестиционные паи Фонда ограничены в обороте. Информация предназначена для квалифицированных инвесторов. Не допускается распространение информации о паевом инвестиционном фонде, инвестиционные паи которых ограничены в обороте, за исключением случаев ее раскрытия в соответствии с федеральными законами.";
		
		ШаблонДисклеймер = "
			|Стоимость инвестиционных паев может увеличиваться и уменьшаться, результаты инвестирования в прошлом не определяют доходы в будущем, государство не гарантирует доходность инвестиций в Фонд, прежде чем приобрести инвестиционный пай, следует внимательно ознакомиться с Правилами Фонда.";
		
	Иначе
		ШаблонРеквизиты = 
			"Управляющая компания: [ПолноеНаименованиеУК] (лицензия [ОрганВыдавшийЛицензию] №[НомерЛицензии] от [ДатаВыдачиЛицензии] года [ВидЛицензии]).
			|
			|Правила доверительного управления [ПолноеНаименованиеПИФ] зарегистрированы [ОрганУтвердившийПравила] [ДатаПравил] года за № [НомерПравил].
			|
			|Необходимую информацию о Фонде можно получить по адресу: 
			|[ЮридическийАдресУК], телефон: [ТелефоныУК].
			|
			|Адрес сайта в сети Интернет: [ВебСтраницаУК]";
		
		Если Выборка.Тип = Перечисления.ТипыПифовВЗависимостиОтЛиквидности.Открытый ИЛИ ЭтотОбъект.ДатаОтчетности < Дата(2022,5,1) Тогда
			ШаблонРеквизиты = ШаблонРеквизиты + "
			|Информация, подлежащая в соответствии с Правилами доверительного управления Фондом опубликованию в печатном издании, публикуется в ""Приложении к Вестнику Федеральной службы по финансовым рынкам"".";
		КонецЕсли;
			
		ШаблонДисклеймер = "
			|Стоимость инвестиционных паев может увеличиваться и уменьшаться. Результаты инвестирования в прошлом не определяют доходы в будущем. Государство не гарантирует доходность инвестиций в паевой инвестиционный фонд. Прежде чем приобрести инвестиционный пай, следует внимательно ознакомиться с правилами доверительного управления паевым инвестиционным фондом.";		
	КонецЕсли;
	
	ПараметрыШаблона = Новый Структура("ПолноеНаименованиеУК,НомерЛицензии,ОрганВыдавшийЛицензию,ПолноеНаименованиеПИФ,НомерПравил,ЮридическийАдресУК,ТелефоныУК,ВебСтраницаУК");
	
	ЗаполнитьЗначенияСвойств(ПараметрыШаблона, Выборка);
	
	ПараметрыШаблона.Вставить("ОрганУтвердившийПравила",	?(ЗначениеЗаполнено(Выборка.ОрганУтвердившийПравила), Выборка.ОрганУтвердившийПравила, "Банком России"));
	ПараметрыШаблона.Вставить("ВидЛицензии",				НРег(Лев(Выборка.ВидЛицензии, 1)) + Сред(Выборка.ВидЛицензии, 2));
	ПараметрыШаблона.Вставить("ДатаВыдачиЛицензии", 		Формат(Выборка.ДатаВыдачиЛицензии, "ДФ='dd MMMM yyyy'"));
	ПараметрыШаблона.Вставить("ДатаПравил", 				Формат(Выборка.ДатаПравил, "ДФ='dd MMMM yyyy'"));
	
	Дисклеймер = Новый Структура;
	Дисклеймер.Вставить("РеквизитыПИФ",	РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(ШаблонРеквизиты, ПараметрыШаблона));
	Дисклеймер.Вставить("Дисклеймер",	ШаблонДисклеймер);
	
	Возврат Дисклеймер;
	
КонецФункции

Процедура ВывестиОбласть(Результат, Макет, ИмяОбласти, Данные = Неопределено, ВыводитьПустуюСтроку = Истина, Вывести = Неопределено);
	
	ТипыВыводимыхКоллекций = Новый Массив;
	ТипыВыводимыхКоллекций.Добавить(Тип("ТаблицаЗначений"));
	ТипыВыводимыхКоллекций.Добавить(Тип("Массив"));
	
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	
	Если ТипыВыводимыхКоллекций.Найти(ТипЗнч(Данные)) <> Неопределено Тогда
		Если Данные.Количество() = 0 И ВыводитьПустуюСтроку Тогда
			ВывестиПрисоединитьОбласть(Результат, Область, Вывести);
		Иначе
			Для Каждого СтрокаДанных Из Данные Цикл
				ЗаполнитьЗначенияСвойств(Область.Параметры, СтрокаДанных);
				ВывестиПрисоединитьОбласть(Результат, Область, Вывести);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли Данные = ЭтотОбъект ИЛИ ЗначениеЗаполнено(Данные) Тогда
		ЗаполнитьЗначенияСвойств(Область.Параметры, Данные);
		ВывестиПрисоединитьОбласть(Результат, Область, Вывести);
		
	Иначе
		ВывестиПрисоединитьОбласть(Результат, Область, Вывести);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиПрисоединитьОбласть(Результат, Область, Вывести)
	
	Если Вывести = Неопределено Тогда
		Результат.Вывести(Область);
		
	ИначеЕсли Вывести = Истина Тогда
		Результат.Вывести(Область);
		Вывести = Ложь;
		
	Иначе
		Результат.Присоединить(Область);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиРасшифровку(Запрос, Макет, Результат, ИмяРасшифровки, Отказ)
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка" + ИмяРасшифровки);
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка" + ИмяРасшифровки);
	
	Результат.Вывести(ОбластьШапка);
	Для Каждого СтрокаДанных Из ПолучитьВременнуюТаблицуИзЗапроса(Запрос, ИмяРасшифровки, Отказ) Цикл
		ОбластьСтрока.Параметры.Заполнить(СтрокаДанных);
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;

КонецПроцедуры

Функция СформироватьСтрокуПоШаблону(СтрокаДанных, Шаблон)
	
	ПараметрыСообщения = Новый Структура;
	Для Каждого Колонка Из СтрокаДанных.Владелец().Колонки Цикл
		Если Колонка.Имя = "ШаблонСообщения" Тогда
			ШаблонСообщения = СтрокаДанных[Колонка.Имя];
		ИначеЕсли Колонка.Имя = "Отказ" Тогда
			ВызватьОтказ = СтрокаДанных[Колонка.Имя];
		ИначеЕсли ТипЗнч(СтрокаДанных[Колонка.Имя]) = Тип("Дата") Тогда
			ПараметрыСообщения.Вставить(Колонка.Имя, Формат(СтрокаДанных[Колонка.Имя], "ДФ=dd.MM.yyyy; ДП=отсутствует"));	
		Иначе
			ПараметрыСообщения.Вставить(Колонка.Имя, СтрокаДанных[Колонка.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РаботаСоСтрокамиКлиентСервер.ВставитьПараметрыВСтроку(Шаблон, ПараметрыСообщения);
	
КонецФункции

#КонецОбласти

#Область РаботаСВременнымиТаблицами

Процедура ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчёта, ПризнакНулевогоОтчета = Ложь, КонтрольВсехРазделов = Ложь,  Отказ)
	
	Для Каждого РазделОтчета Из РазделыОтчёта Цикл
		
		Если ТипЗнч(РазделОтчета) = Тип("Строка") Тогда
			ИмяТаблицы = РазделОтчета;
			ИмяРаздела = РазделОтчета;
		ИначеЕсли ТипЗнч(РазделОтчета) = Тип("СтрокаТаблицыЗначений") Тогда
			ИмяТаблицы = РазделОтчета.ИмяТаблицы;
			ИмяРаздела = РазделОтчета.ИмяРаздела;
		Иначе
			ВызватьИсключение "Неизвестный тип раздела отчёта: " + ТипЗнч(РазделОтчета);
		КонецЕсли;
		
		Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы) = Неопределено Тогда
			ВызватьИсключение "Во временных таблицах не найдена таблица: " + ИмяТаблицы;
		КонецЕсли;
		
		ВременнаяТаблица = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы).ПолучитьДанные().Выгрузить();
		
		ОбработатьЗначенияВременнойТаблицы(ВременнаяТаблица, ИмяТаблицы, Отказ);
		
		// Здесь удаляются и переименовываются поля
		АдаптироватьКВерсииТаксономии(ВременнаяТаблица, ИмяТаблицы, Отказ);
		КонтрольОбязательныхРеквизитов(ВременнаяТаблица, ИмяТаблицы, ИмяРаздела, КонтрольВсехРазделов, Отказ);
		
		МассивСтрокXBRL = СформироватьМассивСтрокXBRL(ВременнаяТаблица,, ИмяТаблицы, ИмяРаздела, ПризнакНулевогоОтчета, Отказ);

		
		
		
		Если НЕ Отказ Тогда
			ПакетДанных.Вставить(ИмяРаздела, Новый Структура(ИмяРаздела + "_Item", МассивСтрокXBRL));
		КонецЕсли;
		
	КонецЦикла;
	
	ПодчиненныеТегиПустые(ПакетДанных);
	
КонецПроцедуры

Функция ПолучитьТекстЗапросаПоВременнымТаблицам(МассивВременныхТаблиц)
	
	ТекстЗапроса = "";
	
	Для Каждого ВременнаяТаблица Из МассивВременныхТаблиц Цикл
		ТекстЗапроса = ТекстЗапроса + "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ " + ВременнаяТаблица + ";"
	КонецЦикла;
		
	ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 1);
		
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьВременнуюТаблицуИзЗапроса(Запрос, ИмяВременнойТаблицы, Отказ = Ложь)

	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы) <> Неопределено Тогда
		Возврат Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяВременнойТаблицы).ПолучитьДанные().Выгрузить();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В запросе не обнаружена временная таблица: " + ИмяВременнойТаблицы,,,,Отказ);
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;

КонецФункции

Процедура ОбработатьЗначенияВременнойТаблицы(ВременнаяТаблица, ИмяТаблицы, Отказ)
	
	Колонки = Новый Массив;
	
	Для Каждого Колонка Из ВременнаяТаблица.Колонки Цикл
		Колонки.Добавить(Колонка);
	КонецЦикла;
	
	ПустаяКолонка = Неопределено;
	Если ВременнаяТаблица.Колонки.Количество() = 1 Тогда 
		ПустаяКолонка = ВременнаяТаблица.Колонки.Добавить("ПустаяКолонка");//Если в таюлице всего одна колонка, при её удалении таблица очистится
	КонецЕсли;
	
	Для Каждого Колонка Из Колонки Цикл
		МассивОбработанныхЗначений = Новый Массив;
		ЗагрузитьКолонку = Ложь;
		
		Для Каждого СтрокаДанных Из ВременнаяТаблица Цикл
			НовоеЗначение = ОбработатьЗначениеВременнойТаблицы(Колонка.Имя, СтрокаДанных, Отказ);
			МассивОбработанныхЗначений.Добавить(НовоеЗначение);
			ЗагрузитьКолонку = Макс(ЗагрузитьКолонку, НовоеЗначение <> СтрокаДанных[Колонка.Имя]);
		КонецЦикла;
		
		Если ЗагрузитьКолонку Тогда
			ИмяКолонки 			= Колонка.Имя;
			ИндексКолонки		= ВременнаяТаблица.Колонки.Индекс(Колонка);
			
			ТипыЗначений = Колонка.ТипЗначения.Типы();
			ТипыЗначений.Добавить(Тип("Строка"));
			
			ВременнаяТаблица.Колонки.Удалить(ИмяКолонки);
			ВременнаяТаблица.Колонки.Вставить(ИндексКолонки, ИмяКолонки, Новый ОписаниеТипов(ТипыЗначений));
			ВременнаяТаблица.ЗагрузитьКолонку(МассивОбработанныхЗначений, ИмяКолонки);
		КонецЕсли;
		
	КонецЦикла;	
	
	Если ПустаяКолонка <> Неопределено Тогда 
		ВременнаяТаблица.Колонки.Удалить(ПустаяКолонка);
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьЗначениеВременнойТаблицы(Колонка, СтрокаДанных, Отказ)
	
	Значение = СтрокаДанных[Колонка];
	
	Если Колонка = "PorNomFilKredOrg" Тогда
		Значение = СтрРазделить(Строка(Значение) + "/", "/")[1];
		
	ИначеЕсли Колонка = "RegNomKredOrg" Тогда
		Значение = СтрРазделить(Строка(Значение) + "/", "/")[0];
		
	ИначеЕсли Колонка = "SvedODokUdostoveryayushhemLichnostKreditora"
		И ТипЗнч(Значение) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Значение = ПредставлениеДокументаУдостоверенияЛицности(Значение, ЭтотОбъект.Период.ДатаОкончания);
		
	ИначеЕсли СтрНачинаетсяС(Колонка, "SvedODokUdostoveryayushhemLichnostDolzhnika")
		И ТипЗнч(Значение) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		Значение = ПредставлениеДокументаУдостоверенияЛицности(Значение, ЭтотОбъект.Период.ДатаОкончания);
		
	ИначеЕсли Колонка = "Risk_Proc_godovyx_Inf_ob_inv_strateg" Тогда
		Значение = "до " + Формат(Значение, "ЧДЦ=2") + "%";
		
	ИначеЕсли Колонка = "VidyDeyatOsushObshSOgranichennojOtvetstvennostyu" Тогда
		Значение = ПолучитьОписаниеОКВЭД(Значение, Отказ);
		
	ИначеЕсли Колонка = "Kod_regEnumerator" И Значение = "00" Тогда
		Значение = "";
		
	ИначеЕсли Колонка = "Osnovaniya_naxozhdeniya_vekselya_Rekv_l_u_Kot_Nax_Veks"
		И ТипЗнч(Значение) = Тип("СправочникСсылка.Договоры") Тогда
		Значение = "Договор " + НРег(Значение.ВидДоговора) + " № " + Значение.НомерДоговора + " от " + Формат(Значение.ДатаЗаключения, "ДФ=dd.MM.yyyy") + "г.";
		
	ИначеЕсли Колонка = "NaimInvestPortf" Тогда
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
			Значение = "Договор № " + Значение.НомерДоговора + " от " + Формат(Значение.ДатаЗаключения, "ДФ=dd.MM.yyyy") + "г.";
		КонецЕсли;
		
	ИначеЕсли Колонка = "AdrReg" И ИмяПакета = "ОКУД0420401" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес, ИмяПакета = "ОКУД0420401", Дата(2021,10,1), Отказ);
		
	ИначеЕсли Колонка = "Mesto_naxozhdeniya"
		ИЛИ Колонка = "AdrReg" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес, ИмяПакета = "ОКУД0420501", Дата(2021,4,1), Отказ);
		
	ИначеЕсли Колонка = "FaktAdr" И ИмяПакета = "ОКУД0420401" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ФактическийАдрес, ИмяПакета = "ОКУД0420401", Дата(2021,10,1), Отказ);
		
	ИначеЕсли (Колонка = "FaktAdr" ИЛИ Колонка = "AdresFakticheskogoNaxozhdeniyaUpravlKomp") И ИмяПакета <> "ОКУД0420432" И ИмяПакета <> "ОКУД0420523" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ФактическийАдрес, ИмяПакета = "ОКУД0420501", Дата(2021,4,1), Отказ);
		
	ИначеЕсли Колонка = "PochtovyjAdres" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ПочтовыйАдрес, ИмяПакета = "ОКУД0420501", Дата(2021,4,1), Отказ);
		
	ИначеЕсли Колонка = "Mesto_Aud_Org" 
		  ИЛИ Колонка = "MestoNaxozhd_AudOrg_MestoZHit_IndAud"
		  ИЛИ Колонка = "MestoNaxozhd_AudOrg" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ЮридическийАдрес, Ложь, Дата(2021,10,1), Отказ);
		
	ИначеЕсли Колонка = "Adres_dlya_napravleniya_pocht_korr_Sved_o_klir_org" Тогда
		Значение = ПолучитьАдрес(Значение, Справочники.ВидыКонтактнойИнформации.ПочтовыйАдрес, ИмяПакета = "ОКУД0420401", Дата(2021,10,1), Отказ);
		
	ИначеЕсли Колонка = "MestoVynReshSud" Тогда
		Значение = ПолучитьАдрес(Значение, Неопределено, Неопределено, Неопределено, Отказ);
		
	ИначеЕсли Колонка = "Kod_FIAS" Тогда
		Значение = РаботаСКонтактнойИнформациейКлиентСервер.АдресФИАСВСтруктуру(Значение).КодАдресаФИАС;
		
	ИначеЕсли Колонка = "UrIerarxSpravStoimEnumerator" Тогда
		Значение = Формат(Значение, "ЧДЦ=0; ЧН=0; ЧГ=0");

	ИначеЕсли Колонка = "Identr_kontr_po_vneb_sdelke_Rek_kontr_po_vneb_sd" Тогда
		Значение = СтрСоединить(СтрРазделить(Значение, " " + Символы.НПП));

	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

