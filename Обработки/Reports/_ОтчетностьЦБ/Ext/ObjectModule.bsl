Процедура ЗаполнитьРазделыОтчетаПоВременнымТаблицамОпционально(ПакетДанных, Запрос, РазделыОтчёта, ПризнакНулевогоОтчета = Ложь, Отказ = Ложь)
	
	Для Каждого РазделОтчета Из РазделыОтчёта Цикл
		ВременнаяТаблица = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(РазделОтчета);
		
		Если НЕ ВременнаяТаблица = Неопределено Тогда
			
			Данные = ВременнаяТаблица.ПолучитьДанные().Выгрузить();
			
			АдаптироватьКВерсииТаксономии(Данные, РазделОтчета, Отказ);
			
			Если НЕ Отказ Тогда
				ПакетДанных.Вставить(РазделОтчета, Новый Структура(РазделОтчета + "_Item", СформироватьМассивСтрокXBRL(Данные,,РазделОтчета,, ПризнакНулевогоОтчета, Отказ)));
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
