#Область ПолучитьМассивЗначенийОсей

Функция ПолучитьМассивЗначенийОсей(ВходящиеДанные, ИмяРеквизита, КонтрольУникальностиОсей, Отказ) Экспорт
	
	ЗаполнитьНеуникальныеЗначенияОсей();
	
	Данные = ВходящиеДанные.Скопировать();
	
	Если Ложь Тогда
		Данные = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если Данные.Колонки.Найти("ИдентификаторСтроки") = Неопределено Тогда
		Данные.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("УникальныйИдентификатор"));
		
		Для Каждого СтрокаДанных Из Данные Цикл
			СтрокаДанных.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЦикла;
	КонецЕсли;
	
	МассивЗначенийОсей	= Новый Массив;
	КэшЗначений			= Новый Соответствие;
	
#Область МассивНедопустимыхСимволовОсей
	НедопустимыеСимволыОсей = Новый Массив;
	Если НЕ ЭтоДК И ВерсияТаксономии >= "4_2" Тогда
		НедопустимыеСимволыОсей.Добавить(" ");	
		НедопустимыеСимволыОсей.Добавить(Символы.ПС);	
		НедопустимыеСимволыОсей.Добавить(Символы.НПП);	
		НедопустимыеСимволыОсей.Добавить(Символы.Таб);	
	КонецЕсли;
#КонецОбласти
	
#Область ПодготовкаЗапросаДляОсей
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	
	Если ВерсияТаксономии > "1_3_1" Тогда
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Иначе	
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаНачала);
	КонецЕсли;
#КонецОбласти
	
	Для Каждого СтрокаДанных Из Данные Цикл
		
		ИндексСтроки = Данные.Индекс(СтрокаДанных);
		
		Значение		= СтрокаДанных[ИмяРеквизита];
		ТипЗначения		= ТипЗнч(Значение);
		
		//Номер строки, если значение не заполнено, то простая нумерация
		Если ИмяРеквизита = "ID_strokiTaxis" Тогда 
			Если ЗначениеЗаполнено(Значение) Тогда
				МассивЗначенийОсей.Добавить(Значение);
			Иначе
				МассивЗначенийОсей.Добавить(ИндексСтроки + 1);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ПолучитьЗначениеОсиИзКэша(КэшЗначений, МассивЗначенийОсей, ТипЗначения, Значение, СтрокаДанных.ИдентификаторСтроки) Тогда
			Продолжить;
	    КонецЕсли;
		
#Область ВсеЗначенияЭтогоТипа
		МассивВсехЗначенийКолонки = Новый Массив;
		МассивСтрокТипаЗначений = Новый Массив;
		Для Каждого СтрокаДанныхДляМассиваЗначений Из Данные Цикл
			Если ТипЗначения = ТипЗнч(СтрокаДанныхДляМассиваЗначений[ИмяРеквизита]) Тогда
				МассивВсехЗначенийКолонки.Добавить(СтрокаДанныхДляМассиваЗначений[ИмяРеквизита]);
				МассивСтрокТипаЗначений.Добавить(СтрокаДанныхДляМассиваЗначений);
			КонецЕсли;
		КонецЦикла;
#КонецОбласти		

		ЗначенияОсей			= Новый Соответствие;
		ПравилоФормированияОси	= ПолучитьПравилоФормированияОси(ТипЗначения, ИмяРеквизита, Отказ); 
		
		//Формирование оси не требуется
		Если НЕ ПравилоФормированияОси.Конвертировать Тогда
			Для Индекс = 0 По МассивВсехЗначенийКолонки.ВГраница() Цикл
				ЗначенияОсей.Вставить(МассивВсехЗначенийКолонки[Индекс], МассивВсехЗначенийКолонки[Индекс]);
			КонецЦикла;	
			
		//Требуется простое пробразование, например даты к виду 01.01.2000
		ИначеЕсли ЗначениеЗаполнено(ПравилоФормированияОси.ФорматнаяСтрока) Тогда
			Для Индекс = 0 По МассивВсехЗначенийКолонки.ВГраница() Цикл
				ЗначенияОсей.Вставить(МассивВсехЗначенийКолонки[Индекс], Формат(МассивВсехЗначенийКолонки[Индекс], ПравилоФормированияОси.ФорматнаяСтрока));
			КонецЦикла;	

		//Правила формирования описаны запросом
		Иначе
			Запрос.Текст = ПравилоФормированияОси.ТекстЗапроса;
			
			Если ПравилоФормированияОси.ИспользоватьТаблицуЗначений Тогда
				Запрос.УстановитьПараметр("Данные", Данные.Скопировать(МассивСтрокТипаЗначений)); 
			Иначе
				Запрос.УстановитьПараметр("МассивЗначений",	МассивВсехЗначенийКолонки);
			КонецЕсли;
				
			ДанныеОсей	= Запрос.Выполнить().Выгрузить();
			ДанныеОсей.Колонки.Добавить("ЗначениеОси");
			
#Область КонтрольНаличияПолейИЗначенииДляОсиВЗапросе
			Для Каждого СтрокаДанныхОсей Из ДанныеОсей Цикл
				ЭлементыШаблона = СтрРазделить(СтрокаДанныхОсей.Шаблон, "_");
				Для Каждого ЭлементШаблона Из ЭлементыШаблона Цикл
					МассивПустыхРеквизитов = Новый Массив;
					
					Если ДанныеОсей.Колонки.Найти(ЭлементШаблона) = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							СтрШаблон(
								"Не удалось вычислить значение оси для типа %1, ошибка в шаблоне: в запросе отсутствует поле %2
								|Организация: %3,
								|ИмяРеквизита: %4,
								|ТекстЗапроса: %5", 
								ТипЗначения,
								ЭлементШаблона,
								ЭтотОбъект.Организация,
								ИмяРеквизита,
								Запрос.Текст),,,, 
							Отказ);
						Продолжить;
					ИначеЕсли ЭлементШаблона = "ДополнительныйИдентификаторОси" И СтрокаДанныхОсей[ЭлементШаблона] = 0 Тогда
					ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДанныхОсей[ЭлементШаблона]) Тогда
						МассивПустыхРеквизитов.Добавить(ЭлементШаблона);
					КонецЕсли;
					
					Если МассивПустыхРеквизитов.Количество() Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось вычислить значение оси для %1, не заполнены реквизиты %2", СтрокаДанныхОсей.Ссылка, СтрСоединить(МассивПустыхРеквизитов, ",")),,, СтрокаДанныхОсей.Ссылка, Отказ);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
	
#КонецОбласти			
			
#Область ВычислениеЭлементовШаблона
			Для Каждого Колонка Из ДанныеОсей.Колонки Цикл
				Если НЕ Колонка.Имя = "Ссылка" И НЕ Колонка.Имя = "ИндексСтроки" 
					И НЕ Колонка.Имя = "Шаблон" И НЕ Колонка.Имя = "ЗначениеОси" 
					И НЕ СтрНачинаетсяС(Колонка.Имя, "Ось") И НЕ СтрНачинаетсяС(Колонка.Имя, "ИдентификаторСтроки") Тогда
					ДанныеОсей.Колонки.Добавить("Ось" + Колонка.Имя);
					ДанныеОсей.ЗагрузитьКолонку(ПолучитьМассивЗначенийОсей(ДанныеОсей, Колонка.Имя, КонтрольУникальностиОсей, Отказ), "Ось" + Колонка.Имя);
				КонецЕсли;
			КонецЦикла;
#КонецОбласти
			
#Область СоединениеЭлементовШаблона
			Для Каждого СтрокаДанныхОсей Из ДанныеОсей Цикл
				ЭлементыОси = Новый Массив;
				ЭлементыШаблона = СтрРазделить(СтрокаДанныхОсей.Шаблон, "_");
				
				Для Каждого ЭлементШаблона Из ЭлементыШаблона Цикл
					Если ДанныеОсей.Колонки.Найти("Ось" + ЭлементШаблона) <> Неопределено Тогда
						ЭлементыОси.Добавить(СтрокаДанныхОсей["Ось" + ЭлементШаблона]);
					КонецЕсли;
				КонецЦикла;	
				
				СтрокаДанныхОсей.ЗначениеОси = СтрСоединить(ЭлементыОси, "_");
				СтрокаДанныхОсей.ЗначениеОси = СокрЛП(СтрокаДанныхОсей.ЗначениеОси);
				
				Для каждого НедопустимыйСимвол из НедопустимыеСимволыОсей Цикл
					СтрокаДанныхОсей.ЗначениеОси = СтрЗаменить(СтрокаДанныхОсей.ЗначениеОси, НедопустимыйСимвол, "");
				КонецЦикла;
			КонецЦикла;
#КонецОбласти			

#Область Контроль_уникальности
			Если КонтрольУникальностиОсей Тогда
				НеуникальныеОси = ДанныеОсей.Скопировать(, "ЗначениеОси");
				НеуникальныеОси.Колонки.Добавить("Флаг");
				НеуникальныеОси.ЗаполнитьЗначения(1, "Флаг");
				НеуникальныеОси.Свернуть("ЗначениеОси", "Флаг");
				
				Для Каждого СтрокаНеуникальныеОси Из НеуникальныеОси Цикл
					Если СтрокаНеуникальныеОси.Флаг > 1 Тогда
						//Для Каждого СтрокаДанныхОсей Из ДанныеОсей.НайтиСтроки(Новый Структура("ЗначениеОси", СтрокаНеуникальныеОси.ЗначениеОси)) Цикл
						//	Если НеуникальныеЗначенияОсей.НайтиСтроки(Новый Структура("ЗначениеОси, Ссылка", СтрокаНеуникальныеОси.ЗначениеОси, СтрокаДанныхОсей.Ссылка)).Количество() = 0 Тогда
						//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Нарушение уникальности оси %1 для %2. Обратитесь к программисту.", СтрокаНеуникальныеОси.ЗначениеОси, СтрокаДанныхОсей.Ссылка),,,, Отказ);
						//	КонецЕсли;
						//КонецЦикла;
						Если ДанныеОсей.Колонки.Найти("Ссылка") = Неопределено Тогда
							ТекстОшибки = СтрШаблон("Нарушение уникальности %1 оси %2. Обратитесь к программисту.", СтрокаНеуникальныеОси.ЗначениеОси, ИмяРеквизита);
						Иначе
							// #ТехДолг: не понятно, зачем нужно выводить ссылки, которых иногда может и не быть
							ТекстОшибки = "";
							Для Каждого СтрокаДанныхОсей Из ДанныеОсей.НайтиСтроки(Новый Структура("ЗначениеОси", СтрокаНеуникальныеОси.ЗначениеОси)) Цикл
								Если НеуникальныеЗначенияОсей.НайтиСтроки(Новый Структура("ЗначениеОси, Ссылка", СтрокаНеуникальныеОси.ЗначениеОси, СтрокаДанныхОсей.Ссылка)).Количество() = 0 Тогда
									ТекстОшибки = ТекстОшибки + ?(ПустаяСтрока(ТекстОшибки), "", Символы.ПС) +
									СтрШаблон("Нарушение уникальности оси %1 для %2. Обратитесь к программисту.", СтрокаДанныхОсей.ЗначениеОси, СтрокаДанныхОсей.Ссылка);
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
						Если ЗначениеЗаполнено(ТекстОшибки) Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,, Отказ);
						КонецЕсли;	
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
#КонецОбласти				

			Для Каждого СтрокаДанныхОсей Из ДанныеОсей Цикл
				Если ПравилоФормированияОси.ИспользоватьТаблицуЗначений Тогда
					ЗначенияОсей.Вставить(СтрокаДанныхОсей.ИдентификаторСтроки, СтрокаДанныхОсей.ЗначениеОси);
				Иначе
					ЗначенияОсей.Вставить(СтрокаДанныхОсей.Ссылка, СтрокаДанныхОсей.ЗначениеОси);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		КэшЗначений.Вставить(ТипЗначения, ЗначенияОсей);
		
		Если НЕ ПолучитьЗначениеОсиИзКэша(КэшЗначений, МассивЗначенийОсей, ТипЗначения, Значение, СтрокаДанных.ИдентификаторСтроки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось вычислить значение оси для %1, для элемента не описано правило. Обратитесь к программистам.", Значение),,, Значение, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивЗначенийОсей;
	
КонецФункции

Функция ПолучитьЗначениеОсиИзКэша(КэшЗначений, МассивЗначенийОсей, ТипЗначения, Значение, ИдентификаторСтроки)
	
	Если ТипЗначения = Тип("Null") Тогда
		МассивЗначенийОсей.Добавить(Значение);
		Возврат Истина;
	КонецЕсли;
		
	ЗначенияОсей = КэшЗначений.Получить(ТипЗначения);
	Если ЗначенияОсей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Ось формируется по значениям нескольких колонок
	Если ЗначенияОсей.Получить(ИдентификаторСтроки) <> Неопределено Тогда
		МассивЗначенийОсей.Добавить(ЗначенияОсей.Получить(ИдентификаторСтроки));
		Возврат Истина;
		
	//Ось формируется по значению одной колонки
	ИначеЕсли ЗначенияОсей.Получить(Значение) <> Неопределено Тогда 
		МассивЗначенийОсей.Добавить(ЗначенияОсей.Получить(Значение));
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПравилоФормированияОси(ТипЗначения, ИмяРеквизита, Отказ)
	
	КлючПравила = СериализаторXDTO.XMLСтрока(ТипЗначения) + ИмяРеквизита;
	
#Область Заполнить_правила_при_первом_запуске
	
	Если ТипЗнч(ПравилаФормированияОткрытыхОсей) <> Тип("ТаблицаЗначений") Тогда
		ПравилаФормированияОткрытыхОсей = ПолучитьТаблицуИзМакета("ПравилаФормированияОткрытыхОсей",, Отказ, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии), "ИмяРеквизита, Организация");
	КонецЕсли;
#КонецОбласти

#Область Кеширование_Правила
	ПравилоФормированияОси = БиблиотекаПравилОткрытыхОсей.Получить(КлючПравила);
	Если ПравилоФормированияОси <> Неопределено Тогда
		Возврат ПравилоФормированияОси;
	КонецЕсли;
#КонецОбласти

	ПравилоФормированияОси = Новый Структура("Конвертировать, ТекстЗапроса, ИспользоватьТаблицуЗначений, ФорматнаяСтрока", Ложь);
	
	МассивПараметровПоиска = Новый Массив;
	
	Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
		МассивПараметровПоиска.Добавить(Новый Структура("ИмяРеквизита,Конвертировать", ИмяРеквизита, Ложь)); //исключения
	КонецЕсли;
	
	МассивПараметровПоиска.Добавить(Новый Структура("ТипЗначения,ИмяРеквизита,Организация", ТипЗначения, ИмяРеквизита, ЭтотОбъект.Организация));
	МассивПараметровПоиска.Добавить(Новый Структура("ТипЗначения,ИмяРеквизита,Организация", ТипЗначения, ИмяРеквизита, Справочники.Организации.ПустаяСсылка()));
	МассивПараметровПоиска.Добавить(Новый Структура("ТипЗначения,ИмяРеквизита,Организация",	ТипЗначения, "", ЭтотОбъект.Организация));
	МассивПараметровПоиска.Добавить(Новый Структура("ТипЗначения,ИмяРеквизита,Организация", ТипЗначения, "", Справочники.Организации.ПустаяСсылка()));
	
	НайденныеСтроки = Новый Массив;
	
	Для Каждого ПараметрыПоиска Из МассивПараметровПоиска Цикл
		НайденныеСтроки = ПравилаФормированияОткрытыхОсей.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() > 1 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нарушение уникальности Правил формирования открытых осей для типа значения " + ТипЗначения + " таксономия: " + ЭтотОбъект.ВерсияТаксономии + ". Обратитесь к программисту",,,, Отказ); 
			Возврат ПравилоФормированияОси;
		ИначеЕсли НайденныеСтроки.Количество() = 1 Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдены правила формирования оси для типа значения " + ТипЗначения + " таксономия: " + ЭтотОбъект.ВерсияТаксономии + ". Обратитесь к программисту",,,, Отказ); 
		Возврат ПравилоФормированияОси;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПравилоФормированияОси, НайденныеСтроки[0]);
	
	Если ТипЗначения = Тип("Дата") 
	 ИЛИ ТипЗначения = Тип("Строка")
	 ИЛИ ТипЗначения = Тип("Число") Тогда
		ПравилоФормированияОси.ФорматнаяСтрока	= НайденныеСтроки[0].ТекстЗапроса;
		
	ИначеЕсли ПравилоФормированияОси.Конвертировать И ПустаяСтрока(ПравилоФормированияОси.ТекстЗапроса) Тогда  
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не задано правило формирование оси для типа значения: " + ПравилоФормированияОси.ТипЗначения + ", идентификатор:" + ИмяРеквизита,,,, Отказ);
		ПравилоФормированияОси.Конвертировать = Ложь;
		
	ИначеЕсли ПравилоФормированияОси.Конвертировать  Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", 		ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("МассивЗначений",	Новый Массив);
		
		Если НЕ ПравилоФормированияОси.ИспользоватьТаблицуЗначений Тогда
			Запрос.Текст = ПравилоФормированияОси.ТекстЗапроса;
			
			Попытка
				Запрос.Выполнить();
			Исключение
				Данные = Новый ТаблицаЗначений;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон(
						"Не удалось вычислить значение оси для типа %1, ошибка в тексте запроса:
						|Организация: %2,
						|ИмяРеквизита: %3,
						|ТекстЗапроса: %4,
						|ОписаниеОшибки: %5", 
						ТипЗначения, 
						ЭтотОбъект.Организация,
						ИмяРеквизита,
						Запрос.Текст,
						ОписаниеОшибки()),,,, 
					Отказ);
				ПравилоФормированияОси.Конвертировать = Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	БиблиотекаПравилОткрытыхОсей.Вставить(КлючПравила, ПравилоФормированияОси);
	
	Возврат ПравилоФормированияОси;
		
КонецФункции

Процедура ЗаполнитьНеуникальныеЗначенияОсей()
	
	Если ТипЗнч(НеуникальныеЗначенияОсей) <> Тип("ТаблицаЗначений") Тогда
		НеуникальныеЗначенияОсей = ПолучитьТаблицуИзМакета("НеуникальныеЗначенияОсей");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ТолькоСведенияОбОтветственныхЛицах_XBRL

Функция XBRL_ПолучитьДанные_ТолькоСведенияОбОтветственныхЛицах(ВхИмяПакета, ПризнакНулевогоОтчета, Отказ) Экспорт
	
	ИмяПакета = ВхИмяПакета;
	ПакетДанных = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;

	ДополнительныеПакеты = Новый Структура;
	Если ИмяПакета = "ОКУД0420402" Тогда
		
		ДополнительныеПакеты.Вставить("ОКУД0420437", Ложь);
		
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ, ДополнительныеПакеты);
	
	Возврат ПакетДанных;

КонецФункции

#КонецОбласти

#Область СравнениеДвухОтчётов

Функция ПолучитьРезультатСравненияССохраненнымОтчетом(Запрос = Неопределено, ИмяПакета, РеквизитыФайла, Отборы = Неопределено, ДопПараметры = Неопределено, АдресФайлаСОтчетомВХранилище = Неопределено, Отказ) Экспорт
	
	Если Запрос = Неопределено Тогда

		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	КонецЕсли;

	ТекущийОтчет = ПолучитьДанные_XBRL(ИмяПакета, Запрос, АдресФайлаСОтчетомВХранилище, Отказ);
	
	Возврат ПолучитьРезультатСравненияДвухОтчетов(РеквизитыФайла, Новый Структура("ДанныеФайла, ИмяФайла", ТекущийОтчет, "текущий отчёт"), Отборы, ДопПараметры, Отказ);
	
КонецФункции

Функция ПолучитьРезультатСравненияДвухОтчетов(РеквизитыФайла1, РеквизитыФайла2, Отборы = Неопределено, ДопПараметры = Неопределено, Отказ) Экспорт
	
	Если РеквизитыФайла2.ДанныеФайла = Неопределено Тогда // Иначе платформа падает
		
		Возврат Неопределено;
		
	КонецЕсли;

	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;	
	
	// обработка дополнительных параметров
	СравниватьРазныеТочкиВхода = ?(ДопПараметры.Свойство("СравниватьРазныеТочкиВхода"), ДопПараметры.СравниватьРазныеТочкиВхода, Ложь);
	КолонкиИсключения          = ?(ДопПараметры.Свойство("КолонкиИсключенияПриСравненииОтчетов"), ДопПараметры.КолонкиИсключенияПриСравненииОтчетов, Новый Массив);
	ВыводитьПериодОтчета       = ?(ДопПараметры.Свойство("ВыводитьПериодОтчета"), ДопПараметры.ВыводитьПериодОтчета, Ложь);
	ПериодОтчета               = ?(ДопПараметры.Свойство("Период"), ДопПараметры.Период, "");
	ПредыдущийПериодОтчета     = ?(ДопПараметры.Свойство("ПредыдущийПериод"), ДопПараметры.ПредыдущийПериод, "");
	
	Если Отборы = Неопределено Тогда
		Отборы = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РезультатСравнения = Новый Структура;
	РезультатСравнения.Вставить("ЕстьРасхождения", Ложь);
	
	ДанныеXDTOОтчета1 = ПолучитьДанныеXDTO(РеквизитыФайла1, Отказ);
	ДанныеXDTOОтчета2 = ПолучитьДанныеXDTO(РеквизитыФайла2, Отказ);
	
	Если Отказ Тогда 
		Возврат Неопределено; 
	КонецЕсли;
	
	Если ДанныеXDTOОтчета1.Taxonomy <> ДанныеXDTOОтчета2.Taxonomy Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сравнение отчётов в разных таксономиях невозможно",,,, Отказ);
		
	ИначеЕсли ДанныеXDTOОтчета1.ID <> ДанныеXDTOОтчета2.ID И Не СравниватьРазныеТочкиВхода Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёты принадлежат разными точкам входа",,,, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда 
		Возврат Неопределено; 
	КонецЕсли;
	
#Область ШапкаТД
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("РезультатСравненияТаблицЗначений");
	ВывестиОбласть(ДокументРезультат, Макет, "Заголовок",	Новый Структура("Заголовок", СтрШаблон("Сравнение сохранённого отчёта %1 с текущим", ИмяПакета)));	
	ВывестиОбласть(ДокументРезультат, Макет, "Отбор",   	Новый Структура("ИмяОтбора, ЗначениеОтбора", "Организация", ЭтотОбъект.Организация));	
	ВывестиОбласть(ДокументРезультат, Макет, "Отбор",   	Новый Структура("ИмяОтбора, ЗначениеОтбора", "Период", ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания)));	
	
	Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
		ВывестиОбласть(ДокументРезультат, Макет, "Отбор", Новый Структура("ИмяОтбора, ЗначениеОтбора", "Счет ДУ", ЭтотОбъект.СчетДоверительногоУправления));	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Клиент) Тогда
		ВывестиОбласть(ДокументРезультат, Макет, "Отбор", Новый Структура("ИмяОтбора, ЗначениеОтбора", "Клиент", ЭтотОбъект.Клиент));	
	КонецЕсли;
	
	ВывестиОбласть(ДокументРезультат, Макет, "Легенда");	
	
#КонецОбласти

	ОписаниеТаблицОтчетов = Новый Массив;
	
	ЗаполнитьОписаниеПолейТаблицы(ОписаниеТаблицОтчетов, ДанныеXDTOОтчета1, Отборы, КолонкиИсключения);
	ЗаполнитьОписаниеПолейТаблицы(ОписаниеТаблицОтчетов, ДанныеXDTOОтчета2, Отборы, КолонкиИсключения);
	
	Для Каждого ОписаниеТаблицы Из ОписаниеТаблицОтчетов Цикл
		
		ТаблицаОтчета1 = ПолучитьТаблицуОтчетаДляСравнения(ОписаниеТаблицы, ДанныеXDTOОтчета1 );
		ТаблицаОтчета2 = ПолучитьТаблицуОтчетаДляСравнения(ОписаниеТаблицы, ДанныеXDTOОтчета2);
		
		СистемныеФункции.ПоместитьРезультатСравненияТаблицЗначенийВМенеджерВременныхТаблиц(Запрос, ТаблицаОтчета2, ТаблицаОтчета1, "Diff_" + ОписаниеТаблицы.Имя, СтрСоединить(ОписаниеТаблицы.Оси, ","));
		ТаблицаРасхождений = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "Diff_" + ОписаниеТаблицы.Имя).Выгрузить();
		
		Если ТаблицаРасхождений.Количество() > 0 Тогда
			РезультатСравнения.Вставить("ЕстьРасхождения", Истина);
			ЗаполнитьОтчетСравненияТаблиц(ДокументРезультат, ОписаниеТаблицы, ТаблицаРасхождений, ВыводитьПериодОтчета, ПериодОтчета, ПредыдущийПериодОтчета);
		КонецЕсли;
		
	КонецЦикла;
	
	ДокументРезультат.ОтображатьСетку = Ложь;
	
	РезультатСравнения.Вставить("ДокументРезультат", ДокументРезультат);
	
	Возврат РезультатСравнения;
	
КонецФункции

Процедура ЗаполнитьОтчетСравненияТаблиц(ДокументРезультат, ОписаниеТаблицы, Данные, ВыводитьПериодОтчета = Ложь, ПериодОтчета = "", ПредыдущийПериодОтчета = "")
	
	СтруктураПериод = Новый Структура("Период, _Период, Представление", ПериодОтчета, ПредыдущийПериодОтчета, "Дата отчета");
	
	Если Не Данные.Колонки.Найти("Статус") = Неопределено Тогда
		Данные.Сортировать("Статус");
	КонецЕсли;	
	
	Макет = ПолучитьМакет("РезультатСравненияТаблицЗначений");
	
	ВывестиОбласть(ДокументРезультат, Макет, "ИмяТаблицы", ОписаниеТаблицы);
	
	Измерения	= Новый Массив;
	Ресурсы 	= Новый Массив;
	
	Для Каждого ОписаниеПоля Из ОписаниеТаблицы.Поля Цикл
		Если ОписаниеПоля.ЭтоОсь Тогда
			Измерения.Добавить(Новый Структура("Имя, Представление, СоответствиеЗначение", ОписаниеПоля.Имя, ОписаниеПоля.Представление, ОписаниеПоля.СоответствиеЗначение));
		Иначе
			Ресурсы.Добавить(Новый Структура("Имя, Представление, СоответствиеЗначение", ОписаниеПоля.Имя, ОписаниеПоля.Представление, ОписаниеПоля.СоответствиеЗначение));
		КонецЕсли;
	КонецЦикла;
	
	Вывести = Истина;
	ВывестиОбласть(ДокументРезультат, Макет, "Шапка|Измерение", 	Измерения, Ложь, Вывести);
	Если ВыводитьПериодОтчета Тогда
		ВывестиОбласть(ДокументРезультат, Макет, "Шапка|Период", 	СтруктураПериод, Ложь, Вывести);
	КонецЕсли;	
	ВывестиОбласть(ДокументРезультат, Макет, "Шапка|Ресурс", 		Ресурсы, Ложь, Вывести);
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Вывести = Истина;
		
		Для Каждого Измерение Из Измерения Цикл
			Измерение.Вставить("Значение", СтрокаДанных[Измерение.Имя]);
			
			Для Каждого ЭлементСоответствиеЗначение Из Измерение.СоответствиеЗначение Цикл
				Если Измерение.Значение = ЭлементСоответствиеЗначение.Значение Тогда
					Измерение.Вставить("Значение", ЭлементСоответствиеЗначение.Ключ);
				КонецЕсли;
			КонецЦикла;
		
			ВывестиОбласть(ДокументРезультат, Макет, СтрШаблон("Строка_%1|Измерение", СтрокаДанных.Статус), Измерение, Ложь, Вывести);
			
		КонецЦикла;
		
		// вывод периода отчетов попросили сделать при сравнении с отчетом предыдущего периода
		Если ВыводитьПериодОтчета Тогда
			ВывестиОбласть(ДокументРезультат, Макет, СтрШаблон("Строка_%1|Период", СтрокаДанных.Статус), СтруктураПериод, Ложь, Вывести);
		КонецЕсли;	
		
		Для Каждого Ресурс Из Ресурсы Цикл
			Ресурс.Вставить("Значение", СтрокаДанных[Ресурс.Имя]);
			Ресурс.Вставить("_Значение", СтрокаДанных["_" + Ресурс.Имя]);
			
			Для Каждого ЭлементСоответствиеЗначение Из Ресурс.СоответствиеЗначение Цикл
				Если Ресурс.Значение = ЭлементСоответствиеЗначение.Значение Тогда
					Ресурс.Вставить("Значение", ЭлементСоответствиеЗначение.Ключ);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ЭлементСоответствиеЗначение Из Ресурс.СоответствиеЗначение Цикл
				Если Ресурс._Значение = ЭлементСоответствиеЗначение.Значение Тогда
					Ресурс.Вставить("_Значение", ЭлементСоответствиеЗначение.Ключ);
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаДанных.Статус = 3 Тогда
				
				Если Ресурс.Значение <> Ресурс._Значение Тогда
					ВывестиОбласть(ДокументРезультат, Макет, СтрШаблон("Строка_%1_Различные|Ресурс", СтрокаДанных.Статус), Ресурс, Ложь, Вывести);
				Иначе
					ВывестиОбласть(ДокументРезультат, Макет, СтрШаблон("Строка_%1|Ресурс", СтрокаДанных.Статус), Ресурс, Ложь, Вывести);
				КонецЕсли;
				
			Иначе
				ВывестиОбласть(ДокументРезультат, Макет, СтрШаблон("Строка_%1|Ресурс", СтрокаДанных.Статус), Ресурс, Ложь, Вывести);	
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ВывестиОбласть(ДокументРезультат, Макет, "Разделитель");
	
КонецПроцедуры

Функция ПолучитьТаблицуОтчетаДляСравнения(ОписаниеТаблицы, ОбъектXDTO)
	
	ТаблицаОтчета = Новый ТаблицаЗначений;
	
	Для Каждого ОписаниеПоля Из ОписаниеТаблицы.Поля Цикл
		ТаблицаОтчета.Колонки.Добавить(ОписаниеПоля.Имя, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(ОписаниеПоля.ДлинаСтроки)));
	КонецЦикла;
	
	Для Каждого СтрокаXDTO Из ПолучитьМассивСтрокXDTO(ОбъектXDTO, ОписаниеТаблицы.Имя) Цикл
		СтрокаТаблицы = ТаблицаОтчета.Добавить();
		
		Для Каждого ОписаниеПоля Из ОписаниеТаблицы.Поля Цикл
			Если СтрокаXDTO.Свойства().Получить(ОписаниеПоля.Поле) <> Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(ОписаниеПоля.Свойство) Тогда
				    СтрокаТаблицы[ОписаниеПоля.Имя] = СтрокаXDTO[ОписаниеПоля.Поле];
				ИначеЕсли СтрокаXDTO[ОписаниеПоля.Поле].Свойства().Получить(ОписаниеПоля.Свойство) <> Неопределено Тогда
					СтрокаТаблицы[ОписаниеПоля.Имя] = СтрокаXDTO[ОписаниеПоля.Поле][ОписаниеПоля.Свойство];
				КонецЕсли;
				
				Если СтрНайти(СтрокаТаблицы[ОписаниеПоля.Имя], Символы.ПС) > 0 Тогда
					СтрокаТаблицы[ОписаниеПоля.Имя] = СтрЗаменить(СтрокаТаблицы[ОписаниеПоля.Имя], Символы.ПС, "");
				КонецЕсли;
				
				СтрокаТаблицы[ОписаниеПоля.Имя] = СтрЗаменить(СтрокаТаблицы[ОписаниеПоля.Имя], "  ", " ");
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	Возврат ТаблицаОтчета;
	
КонецФункции	

Процедура ЗаполнитьОписаниеПолейТаблицы(ОписаниеТаблицОтчетов, ОбъектXDTO, Отборы, КолонкиИсключения)
	
	Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
		Если Свойство.Форма = ФормаXML.Элемент Тогда
			
			Если Отборы.Свойство("Разделы") Тогда
				Если Отборы.Разделы.Количество() И Отборы.Разделы.Найти(Свойство.Имя) = Неопределено Тогда
					Продолжить;
			    КонецЕсли;
			КонецЕсли;
			
			ОписаниеПолейТаблицы = Новый Структура("Имя, Представление, Поля, Оси", Свойство.Имя, Свойство.Имя, Новый Массив, Новый Массив);
			Для Индекс = 0 По ОписаниеТаблицОтчетов.ВГраница() Цикл
				Если ОписаниеТаблицОтчетов[Индекс].Имя = Свойство.Имя Тогда
					ОписаниеПолейТаблицы = ОписаниеТаблицОтчетов[Индекс];
					ОписаниеТаблицОтчетов.Удалить(Индекс);
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
			Для Каждого СтрокаXDTO Из ПолучитьМассивСтрокXDTO(ОбъектXDTO, Свойство.Имя) Цикл
				Для Каждого СвойствоПоля Из СтрокаXDTO.Свойства() Цикл
					Если СвойствоПоля.Форма = ФормаXML.Атрибут Тогда
					    ЗаполнитьОписаниеПоляТаблицы(ОписаниеПолейТаблицы, СвойствоПоля.Имя, СвойствоПоля.Имя, "", Истина, СтрДлина(СтрокаXDTO[СвойствоПоля.Имя]), КолонкиИсключения);
						
						Если ОписаниеПолейТаблицы.Оси.Найти(СвойствоПоля.Имя) = Неопределено Тогда
							ОписаниеПолейТаблицы.Оси.Добавить(СвойствоПоля.Имя);
						КонецЕсли;
					
					ИначеЕсли СвойствоПоля.Форма = ФормаXML.Элемент Тогда
						
						ЭтоОсь = (СтрокаXDTO[СвойствоПоля.Имя].Свойства().Получить("Is_Dimension") <> Неопределено);
						
						ЗаполнитьОписаниеПоляТаблицы(ОписаниеПолейТаблицы, СвойствоПоля.Имя, СвойствоПоля.Имя, "Value", ЭтоОсь, СтрДлина(СтрокаXDTO[СвойствоПоля.Имя].Value), КолонкиИсключения);
						
						Если СтрокаXDTO[СвойствоПоля.Имя].Свойства().Получить("Unit") <> Неопределено Тогда
							ЗаполнитьОписаниеПоляТаблицы(ОписаниеПолейТаблицы, СвойствоПоля.Имя + "_Unit", СвойствоПоля.Имя, "Unit", ЭтоОсь, СтрДлина(СтрокаXDTO[СвойствоПоля.Имя].Unit), КолонкиИсключения);
						КонецЕсли;
						
						Если СтрокаXDTO[СвойствоПоля.Имя].Свойства().Получить("Precision") <> Неопределено Тогда
							ЗаполнитьОписаниеПоляТаблицы(ОписаниеПолейТаблицы, СвойствоПоля.Имя + "_Precision", СвойствоПоля.Имя, "Precision", ЭтоОсь, СтрДлина(СтрокаXDTO[СвойствоПоля.Имя].Precision), КолонкиИсключения);
						КонецЕсли;
						
						Если ЭтоОсь Тогда
							Если ОписаниеПолейТаблицы.Оси.Найти(СвойствоПоля.Имя) = Неопределено Тогда
								ОписаниеПолейТаблицы.Оси.Добавить(СвойствоПоля.Имя);
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			ОписаниеТаблицОтчетов.Вставить(0, ОписаниеПолейТаблицы);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьОписаниеПоляТаблицы(ОписаниеПолейТаблицы, Имя, Поле, Свойство, ЭтоОсь, ДлинаСтроки, КолонкиИсключения)
	
	// поля Date_From и Date_To не должны участвовать в сравнении, т.к. у отчета предыдущего периода всегда будут отличаться
	Если Не КолонкиИсключения.Найти(Имя) = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ОписаниеПоля = Новый Структура("Имя,Представление,Поле,Свойство,ЭтоОсь, ДлинаСтроки,СоответствиеЗначение", Имя, Имя, Поле, Свойство, ЭтоОсь, ДлинаСтроки, Новый Соответствие);
	
	Для Индекс = 0 По ОписаниеПолейТаблицы.Поля.ВГраница() Цикл
		Если ОписаниеПолейТаблицы.Поля[Индекс].Имя = Имя Тогда
			ОписаниеПоля = ОписаниеПолейТаблицы.Поля[Индекс];
			ОписаниеПолейТаблицы.Поля.Удалить(Индекс);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ОписаниеПоля.ДлинаСтроки < ДлинаСтроки Тогда
		ОписаниеПоля.Вставить("ДлинаСтроки", ДлинаСтроки);
	КонецЕсли;
	
	ОписаниеПолейТаблицы.Поля.Добавить(ОписаниеПоля);
	
КонецПроцедуры

Функция ПолучитьМассивСтрокXDTO(Знач ОбъектXDTO, Знач ИмяСвойства)
	
	МассивСтрок = Новый Массив;
	
	Если ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда //нет раздела
		Возврат МассивСтрок;
	КонецЕсли;
	
	ОбъектXDTO	= ОбъектXDTO[ИмяСвойства];
	ИмяСвойства = ИмяСвойства + "_Item";
	
	Если ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда //Раздел пуст
	
	ИначеЕсли ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("ОбъектXDTO") Тогда
		МассивСтрок.Добавить(ОбъектXDTO[ИмяСвойства]);
	ИначеЕсли ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("СписокXDTO") Тогда
		Для Каждого СтрокаXDTO Из ОбъектXDTO[ИмяСвойства] Цикл
			МассивСтрок.Добавить(СтрокаXDTO);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьДанныеXDTO(РеквизитыФайла, Отказ)
	
	ЧтениеXML = Новый ЧтениеXML;
	
	Если ТипЗнч(РеквизитыФайла.ДанныеФайла) = Тип("Строка") Тогда
		ЧтениеXML.УстановитьСтроку(РеквизитыФайла.ДанныеФайла);
		
	ИначеЕсли ТипЗнч(РеквизитыФайла.ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
		
		ПутьКФайлу	= ПолучитьИмяВременногоФайла("xml");
	
		Файл = РеквизитыФайла.ДанныеФайла;
		Файл.Записать(ПутьКФайлу);
		
		ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
		
	КонецЕсли;
	
	ДанныеXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	Если ДанныеXDTO.Свойства().Получить("Entity") = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл " + РеквизитыФайла.ИмяФайла + " не является отчётом XBRL.",,,, Отказ);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДанныеXDTO;
	
КонецФункции

Функция ПолучитьСписокРазделовОтчета(Отказ) Экспорт
	
	КонецПериода	 = ?(КонецГода(ЭтотОбъект.Период.ДатаОкончания) =  КонецМесяца(ЭтотОбъект.Период.ДатаОкончания),		"Год",
						?(КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) = КонецМесяца(ЭтотОбъект.Период.ДатаОкончания),	"Квартал", "Месяц"));
	
	РазделыОтчета = ПолучитьТаблицуИзМакета("РазделыXBRL", ЭтотОбъект.ВариантОтчета, Отказ, Новый Структура("ВерсияТаксономии, КонецПериода, ПериодичностьОтчета, ИсточникДанных", ЭтотОбъект.ВерсияТаксономии, КонецПериода, ЭтотОбъект.ПериодичностьОтчета, "")); 
	
	Возврат СтрСоединить(РазделыОтчета.ВыгрузитьКолонку("ИмяРаздела"), ",");
	
КонецФункции

Функция ПолучитьУсловиеОтбора(ИмяПакета, Отказ) Экспорт

	ЗначениеОтбора = "";
	УсловиеОтбора = "";
	
	Если ИмяПакета = "ОКУД0420502"
	 ИЛИ ИмяПакета = "ОКУД0420503"
	 ИЛИ ИмяПакета = "ОКУД0420504" Тогда
		ЗначениеОтбора = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
		
	ИначеЕсли ИмяПакета = "ОКУД0420506" ИЛИ ИмяПакета = "ОКУД0420507" Тогда
		ЗначениеОтбора = ЭтотОбъект.Клиент;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда
		
		ТаблицаЗначенийОсей = Новый ТаблицаЗначений;
		ТаблицаЗначенийОсей.Колонки.Добавить("ЗначениеОтбора");
		
		СтрокаЗначенийОсей = ТаблицаЗначенийОсей.Добавить();
		СтрокаЗначенийОсей.ЗначениеОтбора = ЗначениеОтбора;
		
		МассивЗначенийОсей = ПолучитьМассивЗначенийОсей(ТаблицаЗначенийОсей, "ЗначениеОтбора", Ложь, Отказ);
		ТаблицаЗначенийОсей.ЗагрузитьКолонку(МассивЗначенийОсей, "ЗначениеОтбора");
		
		СтрокаЗначенийОсей = ТаблицаЗначенийОсей[0];
		
		Если ИмяПакета = "ОКУД0420502" Тогда
			УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420502_R1/sr_0420502_R1_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаЗначенийОсей.ЗначениеОтбора);
		ИначеЕсли ИмяПакета = "ОКУД0420503" Тогда
			УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420503_R1/sr_0420503_R1_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаЗначенийОсей.ЗначениеОтбора);
		ИначеЕсли ИмяПакета = "ОКУД0420504" Тогда
			УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420504_r4_2/sr_0420504_r4_2_Item/IdAifPifTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаЗначенийОсей.ЗначениеОтбора);
		ИначеЕсли ИмяПакета = "ОКУД0420506" Тогда
			УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420506/sr_0420506_Item/ID_fondaTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаЗначенийОсей.ЗначениеОтбора);
		ИначеЕсли ИмяПакета = "ОКУД0420507" Тогда
			УсловиеОтбора = СтрШаблон("Convert(XML, [File_Data]).value('(XBRL_Entry_Point/sr_0420507/sr_0420507_Item/ID_fondaTaxis/@Value)[1]', 'nvarchar(100)') = '%1'", СтрокаЗначенийОсей.ЗначениеОтбора);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат УсловиеОтбора;
		
КонецФункции

