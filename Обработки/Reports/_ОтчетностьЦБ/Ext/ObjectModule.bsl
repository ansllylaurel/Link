Процедура ЗаполнитьПечатнуюФорму_ОКУД0420507(ПакетДанных, Результат, Отказ) Экспорт
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		
		ПакетОтчет = ПакетДанных.Отчет;
			
		Результат.Очистить();
		Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		Результат.Автомасштаб = Истина;
		
		Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
		
		ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
			
		ОбластьШапка.Параметры.ОтчетнаяДата		= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		
		Результат.Вывести(ОбластьШапка);
		
		ВывестиРаздел(, "", "Раздел1ОтчетОДоходах.Таблица_Раздел1_ОтчетОДоходах.Таб_Раздел1Строки_1", ПакетОтчет, Макет, Результат);

		ОбластьПодвал						   		 = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьПодвал.Параметры.ФИОРуководителя      = ПакетОтчет.ПодписьРуководителяУКНПФ.ФИО; 	
		ОбластьПодвал.Параметры.ФИОУполномоченногоСД = ПакетОтчет.ПодписьУполномоченногоЛица.ФИО2;
		
		Результат.Вывести(ОбластьПодвал);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВыборкуРасшифровкиЯчейки(НомерСчетаДУ, НомерКолонки, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	
	ПоместитьСчетаДУИКомиссииПоСделкамВЗапрос(Запрос, Отказ);
	
	ТекстЗапроса = ПолучитьТекстЗапроса_ОКУД0420507();
	МассивТекстов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстЗапроса, ";");
	
	// За основу берем все временные таблицы, кроме результирующих
	КолвоЭлементов = МассивТекстов.Количество() - 8;
	ТекстЗапроса = "";
	Для Сч = 0 По КолвоЭлементов Цикл		
		ТекстЗапроса = ТекстЗапроса + МассивТекстов[Сч] + "
		|;";		
	КонецЦикла;

	ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, НомерКолонки, Отказ);
		
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует расшифровка для выбранной ячейки");
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НомерДоговора", НомерСчетаДУ);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, НомерКолонки, Отказ) 
	
	СоответствиеКолонок = Новый Соответствие;
	СоответствиеКолонок.Вставить(11, "Кол10_ОборотыПоСделкам");
	СоответствиеКолонок.Вставить(12, "Кол11_ОплатаУслугБрокера");
	СоответствиеКолонок.Вставить(13, "Кол12_КомиссияБиржи");
	СоответствиеКолонок.Вставить(14, "Кол13_НеобходимыеРасходы");
	СоответствиеКолонок.Вставить(17, "Кол16_УслугиБанка");
		
	НайдКолонка = СоответствиеКолонок.Получить(НомерКолонки);
	Если НайдКолонка = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НомерКолонки = 11 Тогда 
		
		// Обороты по сделкам обрабатываем отдельно, т. к. нужна колонка с ценными бумагами				
		ТекстЗапроса = ТекстЗапроса + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОборотыПоСделкам.Сделка КАК Регистратор,
		|	СУММА(_ОборотыПоСделкам.СуммаОборотДт) КАК Сумма,
		|	_ОборотыПоСделкам.Сделка.Дата КАК Дата,
		|	_ОборотыПоСделкам.ДатаОперации КАК ДатаОперации,
		|	_ЦенныеБумагиСделок.ЦеннаяБумага КАК ЦеннаяБумага
		|ИЗ
		|	_ОборотыПоСделкамРазвернутые КАК _ОборотыПоСделкам
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиСделок КАК _ЦенныеБумагиСделок
		|		ПО _ОборотыПоСделкам.Сделка = _ЦенныеБумагиСделок.Сделка
		|ГДЕ
		|	_ОборотыПоСделкам.СчетДоверительногоУправления.НомерДоговора = &НомерДоговора
		|
		|СГРУППИРОВАТЬ ПО
