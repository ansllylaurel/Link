Функция ПолучитьДанные_ОКУД0420502_ЗаполнитьСтрокуПодраздела(СтрокаПодраздела, Данные)
	
	Колонки = Новый Массив;
	
	Для Каждого Колонка Из СтрокаПодраздела Цикл
		Колонки.Добавить(Колонка.Ключ);
		Если Колонки.Количество() > 2 Тогда
			СтрокаПодраздела[Колонка.Ключ] = 0;
		КонецЕсли;
	КонецЦикла;
	
	КодСтроки = СтрокаПодраздела[Колонки[1]];
	
	ПараметрыОтбора = Новый Структура;
	Если СтрДлина(КодСтроки) = 2 Тогда
		ПараметрыОтбора.Вставить("КодСтроки1", КодСтроки);
		ПараметрыОтбора.Вставить("КодСтроки2", "ХХ");
		ПараметрыОтбора.Вставить("КодСтроки3", "ХХ");
	ИначеЕсли СтрДлина(КодСтроки) = 5 Тогда
		ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
		ПараметрыОтбора.Вставить("КодСтроки2", Прав(КодСтроки, 2));
		ПараметрыОтбора.Вставить("КодСтроки3", "ХХ");
	ИначеЕсли СтрДлина(КодСтроки) = 8 Тогда		
		ПараметрыОтбора.Вставить("КодСтроки1", Лев(КодСтроки, 2));
		ПараметрыОтбора.Вставить("КодСтроки2", Сред(КодСтроки, 4, 2));
		ПараметрыОтбора.Вставить("КодСтроки3", Прав(КодСтроки, 2));
	КонецЕсли;
	
	НайденныеСтроки = Данные.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		СтрокаПодраздела[Колонки[2]] = СтрокаПодраздела[Колонки[2]] + СтрокаДанных.СуммаНаКонец;
		СтрокаПодраздела[Колонки[3]] = СтрокаПодраздела[Колонки[3]] + СтрокаДанных.СуммаНаНачало;
		СтрокаПодраздела[Колонки[4]] = СтрокаПодраздела[Колонки[4]] + СтрокаДанных.ДоляОтОбщейСтоимости;
		СтрокаПодраздела[Колонки[5]] = СтрокаПодраздела[Колонки[5]] + СтрокаДанных.ДоляОтСЧА;
	КонецЦикла;
	
	Если КодСтроки = "14" Тогда
		СтрокаПодраздела[Колонки[2]] = Окр(СтрокаПодраздела[Колонки[2]], 5);
		СтрокаПодраздела[Колонки[3]] = Окр(СтрокаПодраздела[Колонки[3]], 5);
		СтрокаПодраздела[Колонки[4]] = Окр(СтрокаПодраздела[Колонки[4]], 5);
		СтрокаПодраздела[Колонки[5]] = Окр(СтрокаПодраздела[Колонки[5]], 5);
	Иначе
		СтрокаПодраздела[Колонки[2]] = Окр(СтрокаПодраздела[Колонки[2]], 2);
		СтрокаПодраздела[Колонки[3]] = Окр(СтрокаПодраздела[Колонки[3]], 2);
		СтрокаПодраздела[Колонки[4]] = Окр(СтрокаПодраздела[Колонки[4]], 2);
		СтрокаПодраздела[Колонки[5]] = Окр(СтрокаПодраздела[Колонки[5]], 2);
	КонецЕсли;
	
	Возврат СтрокаПодраздела;
	
КонецФункции

