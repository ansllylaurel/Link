	Возврат ТекстЗапроса;
	
КонецФункции	

Функция ПолучитьДатыСЧА_Для_506_507()
	
	// Найдем по одному из действующих договоров ПН клиента на дату начала и окончания периода.
	// Затем определим по ним даты СЧА из настроек регламентных действий
	
	Результат = Новый Структура("ДатаСЧА_НачалоПериода, ДатаСЧА_КонецПериода", ЭтотОбъект.Период.ДатаНачала, НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос = Новый Запрос(
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	КлиентыДоверительногоУправленияСрезПоследних_Конец.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	    |ПОМЕСТИТЬ _СчетаДУ
	    |ИЗ
	    |	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	    |			&ДатаОкончания,
	    |			СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
	    |				И (СчетДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
	    |					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	    |				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних_Конец
	    |ГДЕ
	    |	КлиентыДоверительногоУправленияСрезПоследних_Конец.Клиент = &ЮрФизЛицо
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	    |	ЕСТЬNULL(КлиентыДоверительногоУправленияСрезПоследних_Начало.СчетДоверительногоУправления, НЕОПРЕДЕЛЕНО) КАК СчетДУ_Начало,
	    |	ВЫБОР
	    |		КОГДА ЕСТЬNULL(КлиентыДоверительногоУправленияСрезПоследних_Начало.СчетДоверительногоУправления.ДатаЗаключения, &ДатаНачала) > &ДатаНачала
	    |			ТОГДА КлиентыДоверительногоУправленияСрезПоследних_Начало.СчетДоверительногоУправления.ДатаЗаключения
	    |		ИНАЧЕ &ДатаНачала
	    |	КОНЕЦ КАК ДатаНачалаДляПроверки
	    |ИЗ
	    |	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	    |			&ДатаНачала,
	    |			СчетДоверительногоУправления В
	    |					(ВЫБРАТЬ
	    |						_СчетаДУ.СчетДоверительногоУправления
	    |					ИЗ
	    |						_СчетаДУ)
	    |				И (СчетДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ)
	    |					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	    |				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних_Начало
	    |
	    |УПОРЯДОЧИТЬ ПО
	    |	КлиентыДоверительногоУправленияСрезПоследних_Начало.СчетДоверительногоУправления.ДатаЗаключения
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	    |	_СчетаДУ.СчетДоверительногоУправления КАК СчетДУ_Конец
	    |ИЗ
	    |	_СчетаДУ КАК _СчетаДУ");
	
	Запрос.УстановитьПараметр("ЮрФизЛицо"		, ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	Выборка = ПакетЗапросов[1].Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.СчетДУ_Начало) Тогда
			
			Если Выборка.ДатаНачалаДляПроверки > ЭтотОбъект.Период.ДатаНачала Тогда
				// На начало периода договоров нет, дату СЧА не ищем
			Иначе
				ДатаПоследнейСЧАДоНачалаПериода = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(Выборка.СчетДУ_Начало, Выборка.ДатаНачалаДляПроверки);
				Если Не ЗначениеЗаполнено(ДатаПоследнейСЧАДоНачалаПериода) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить настройки формирования СЧА на дату начала периода для счета ДУ " + СокрЛП(Выборка.СчетДУ_Начало), Выборка.СчетДУ_Начало);
					Возврат Неопределено;
				Иначе
					Результат.Вставить("ДатаСЧА_НачалоПериода", ДатаПоследнейСЧАДоНачалаПериода);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Выборка = ПакетЗапросов[2].Выбрать();	
	Если Выборка.Следующий() Тогда	
		Если ЗначениеЗаполнено(Выборка.СчетДУ_Конец) Тогда
			
			ДатаПоследнейСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(Выборка.СчетДУ_Конец, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
			Если Не ЗначениеЗаполнено(ДатаПоследнейСЧА) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить настройки формирования СЧА за выбранный период для счета ДУ " + СокрЛП(Выборка.СчетДУ_Конец), Выборка.СчетДУ_Конец);
				Возврат Неопределено;	
			Иначе
				Результат.Вставить("ДатаСЧА_КонецПериода", ДатаПоследнейСЧА);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОКУД0420506_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420506(Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420506";
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ПризнакНулевогоОтчета = Истина;
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		
		ДатыСЧА = ПолучитьДатыСЧА_Для_506_507();
		Если ДатыСЧА = Неопределено Тогда
			Отказ = Истина;
			Возврат ПакетДанных;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ДатаНачала",					ЭтотОбъект.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",				КонецДня(ЭтотОбъект.Период.ДатаОкончания));
		Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ЮрФизЛицо",					ЭтотОбъект.Клиент);
		Запрос.УстановитьПараметр("ВидПоказателя",				Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
		Запрос.УстановитьПараметр("Руководитель",				ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
		Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа", ПолучитьПолноеФИООтветственногоЛица("УполномоченноеЛицоСпецДепа"));
		
		Запрос.УстановитьПараметр("ДатаСЧА_НачалоПериода"	, ДатыСЧА.ДатаСЧА_НачалоПериода);
		Запрос.УстановитьПараметр("ДатаСЧА_КонецПериода"	, ДатыСЧА.ДатаСЧА_КонецПериода);
		
		Запрос.УстановитьПараметр("НеЗаполнятьРазделСД", ЭтотОбъект.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Атомфонд") И ЭтотОбъект.Период.ДатаОкончания = Дата(2022,03,31,23,59,59));
		
		Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420506();
		Запрос.Выполнить();
		
		
		ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);
		
	КонецЕсли;

	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ);
	
	Возврат ПакетДанных;
	
КонецФункции

#КонецОбласти

// Отчет о доходах от инвестирования средств пенсионных накоплений
#Область ОКУД0420507

Процедура ПоместитьСчетаДУИКомиссииПоСделкамВЗапрос(Запрос, Отказ)
	
	Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо",		ЭтотОбъект.Клиент);
	Запрос.УстановитьПараметр("ДатаНачала",		ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	
	Запрос.УстановитьПараметр("НеЗаполнятьРазделСД", ЭтотОбъект.Клиент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Атомфонд") И ЭтотОбъект.Период.ДатаОкончания = Дата(2022,03,31,23,59,59));
	
	Запрос.УстановитьПараметр("ВидПоказателя", Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("Руководитель",				"");
	Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа", "");
	
	Запрос.УстановитьПараметр("ВалютаУчета", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("НачалоОтдельногоРасчетаВалютныхСделок", '20210101');
	
	//#ТехДолг Начало
	// Порция хардкода	
	// В итоге, требуется применить только для одной даты - 30.06.2020
	КлиентСафмар = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сафмар");
	ЭтоСафмар = ЭтотОбъект.Клиент = КлиентСафмар;
	Запрос.УстановитьПараметр("ЭтоСафмар"	, ЭтоСафмар);
	Запрос.УстановитьПараметр("ДатаСЧА_20200630"	, '20200630');
	//#ТехДолг Конец

	
	Запрос.Текст =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	|ПОМЕСТИТЬ _СчетаДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	|			&ДатаОкончания,
	|			СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
	|				И (СчетДоверительногоУправления.ДатаРасторжения >= НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
	|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
	|				И Клиент = &ЮрФизЛицо
	|				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	Запрос.Выполнить();
	
	ТаблицаСчетовДУ = Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выгрузить();
	
	Если ТаблицаСчетовДУ.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет счетов доверительного управления по выбранным параметрам",,,, Отказ);		
		Возврат;
	КонецЕсли;
	
	ТаблицаСчетовДУ.Сортировать("ДатаЗаключения");
	ДатаПоследнейСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПоследнегоРасчетаСЧАЗаПериод(ТаблицаСчетовДУ[0].СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	Если Не ЗначениеЗаполнено(ДатаПоследнейСЧА) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить настройки формирования СЧА за выбранный период для счета ДУ " + СокрЛП(ТаблицаСчетовДУ[0].СчетДоверительногоУправления), ТаблицаСчетовДУ[0].СчетДоверительногоУправления,,, Отказ);
		Возврат;
	КонецЕсли;
	
	// Договора еще могло не быть на начало периода, тогда используем последний рабочий день до даты начала периода
	Если ТаблицаСчетовДУ[0].ДатаЗаключения < НачалоДня(ЭтотОбъект.Период.ДатаНачала) Тогда	
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.НастройкиРегламентныхДействий.ПолучитьДатуПредыдущегоРасчетаСЧА(ТаблицаСчетовДУ[0].СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала);
	Иначе
		ДатаПоследнейСЧАДоНачалаПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Период.ДатаНачала) - 1 , -1);
	КонецЕсли;

	РаботаСотчетами.ПоместитьКомиссииПоСделкамЗаПериодВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаНачала, КонецДня(ЭтотОбъект.Период.ДатаОкончания), Новый Структура("ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода", ДатаПоследнейСЧА, ДатаПоследнейСЧАДоНачалаПериода),,, Отказ); 
	
КонецПроцедуры

Функция ПолучитьДанные_ОКУД0420507(Отказ) Экспорт
	
	ПакетДанных = Новый Структура;     
	
	Если НЕ ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420507_2_16_3_1");
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420507_2_16_3_1_ОКУД0420507_2_16_3_1");
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить("2_16_3_1", "_", "."));
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	ПакетДанных.Отчет.Вставить("ОтчетнаяДата", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=dd.MM.yyyy"));
	ДанныеПериодаОтчетности = ПолучитьДанныеПериодаОтчетности();
	
	ПакетОтчетныйПериод = Новый Структура("Код, Описание, Активно", ДанныеПериодаОтчетности.Код, ДанныеПериодаОтчетности.Описание, Истина);
	
	ПакетДанных.Отчет.Вставить("ОтчетныйПериод", ПакетОтчетныйПериод);
	ПакетДанных.Отчет.Вставить("Год", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy"));
	
	ПакетОтчетность = Новый Структура;
	
	Запрос = Новый Запрос;
	
	ПоместитьСчетаДУИКомиссииПоСделкамВЗапрос(Запрос, Отказ);
	
	Если Отказ Тогда
		ПакетДанных.Вставить("Отказ", Отказ);
		Возврат ПакетДанных;
	КонецЕсли;
	
	ДатыСЧА = ПолучитьДатыСЧА_Для_506_507();
	Если ДатыСЧА = Неопределено Тогда		
		Отказ = Истина;
		ПакетДанных.Вставить("Отказ", Отказ);
		Возврат ПакетДанных;
	КонецЕсли;

	Запрос.УстановитьПараметр("ДатаСЧА_НачалоПериода"	, ДатыСЧА.ДатаСЧА_НачалоПериода);
	Запрос.УстановитьПараметр("ДатаСЧА_КонецПериода"	, ДатыСЧА.ДатаСЧА_КонецПериода);
			
	ПакетОтчетность.Вставить("Таблица_Раздел1_ОтчетОДоходах", Новый Структура);
	
	ПакетТаблица = Новый Структура;
	ПакетТаблица.Вставить("Строка_Раздел1НомерГрафы", ПолучитьДинамическуюСтруктуру("Разд1Гр%Индекс%Стр1Заголовок", 1, 7));      //Разд1Гр1Стр1Заголовок
	ПакетТаблица.Вставить("Таб_Раздел1Заг1_стр2", ПолучитьДинамическуюСтруктуру("Таб_Раздел1Заг1_Стр2Гр%Индекс%", 1, 17));
	ПакетТаблица.Вставить("Таб_Раздел1Строки_1", ПолучитьДанные_ОКУД0420507_МассивСтрок(Запрос));
		
	ПакетОтчетность.Вставить("Таблица_Раздел1_ОтчетОДоходах", ПакетТаблица); 
	
	ПакетДанных.Отчет.Вставить("Раздел1ОтчетОДоходах", ПакетОтчетность);
	
	ПакетДанных.Отчет.Вставить("СопроводительноеПисьмо",     ПолучитьСопроводительноеПисьмо("ОКУД0420506"));
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяУКНПФ",   Новый Структура("ФИО", ПолучитьИнициалыФамилиюОтветственногоЛица("Руководитель")));
	ПакетДанных.Отчет.Вставить("ПодписьУполномоченногоЛица", Новый Структура("ФИО2", ПолучитьИнициалыФамилиюОтветственногоЛица("УполномоченноеЛицоСпецДепа")));
	
	Возврат ПакетДанных;
	
КонецФункции
	
Функция ПолучитьДанные_ОКУД0420507_МассивСтрок(Запрос)	
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420507();
	
	Пакет	= Запрос.ВыполнитьПакет();
	КоличествоВПакете = Пакет.Количество();
	Данные	= Пакет[КоличествоВПакете-5].Выгрузить();
							
	ФорматныеСтроки = Новый Структура;
	ФорматныеСтроки.Вставить("Кол8_ФинРезультат",		     "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол9_ОплатаУслугУК", 		     "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол10_ОборотыПоСделкам", 	     "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол11_ОплатаУслугБрокера",     "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол12_ОплатаУслугБиржи",       "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол13_ОплатаУслугСпецДеп",     "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол14_ОплатаНеобязРасходыУК",  "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол15_ОплатаРасходыСтраховУК", "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол16_ОплатаУслугБанков",      "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	ФорматныеСтроки.Вставить("Кол17_ПрочиеРасходы",          "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0");
	
	Данные.Сортировать("Кол7_ДатаЗаключДоговора");
		
	Возврат СформироватьМассивСтрок(Данные, ФорматныеСтроки);
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420507()
	
#Область ТекстЗапроса

	ТекстЗапроса = 
	   "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	   |	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	   |	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности
	   |ПОМЕСТИТЬ _СчетаДУДляДобавленияКЗпоКомиссии
	   |ИЗ
	   |	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
	   |ГДЕ
	   |	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &ДатаСЧА_20200630
	   |	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
	   |	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления В
	   |			(ВЫБРАТЬ
	   |				СчетаДоверительногоУправления.СчетДоверительногоУправления
	   |			ИЗ
	   |				_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления)
	   |	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
	   |	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета <> 0
	   |	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))
	   |	И &ДатаСЧА_20200630 = НАЧАЛОПЕРИОДА(&ДатаОкончания, ДЕНЬ)
	   |;
	   |
