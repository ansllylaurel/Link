	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки,
		|	_ДеньгиУБрокера.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДеньгиУБрокера.Брокер КАК Брокер,
		|	_ДеньгиУБрокера.КодВалюты КАК КодВалюты,
		|	ВЫБОР _ДеньгиУБрокера.КатегорияДС
		|		КОГДА ""Sobstv_sredstvaMember""
		|			ТОГДА ""собственные денежные средства отчитывающейся организации""
		|		КОГДА ""Den_sred_s_pravomMember""
		|			ТОГДА ""денежные средства клиентов отчитывающейся организации, полученные с правом их использования""
		|		КОГДА ""Den_sred_bez_pravaMember""
		|			ТОГДА ""денежные средства клиентов отчитывающейся организации, полученные без права их использования""
		|	КОНЕЦ КАК КатегорияДС,
		|	_ДеньгиУБрокера.СуммаОстаток КАК ОстатокНаКонец,
		|	_ДеньгиУБрокера.ВозможностьИспользованияДенежныхСредствБрокером КАК ВозможностьИспользования,
		|	_ДеньгиУБрокера.СуммаВРублях КАК ОстатокНаКонецВРублях
		|ПОМЕСТИТЬ РасшифровкаБрокер
		|ИЗ
		|	_ДеньгиУБрокера КАК _ДеньгиУБрокера";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_ДеньгиУБрокера", ИмяТаблицы); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ РасшифровкаБрокер", "ПОМЕСТИТЬ " + ИмяТаблицыРасшифровки); 
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ОКУД0420409_СверитьСДаннымиБанка(АдресФайла, Результат, Отказ) Экспорт

	ПутьКФайлу	= ПолучитьИмяВременногоФайла("xml");
	
	Файл		= ПолучитьИзВременногоХранилища(АдресФайла);
	Файл.Записать(ПутьКФайлу);
	
	ДатаНачала		= Неопределено;
	ДатаОкончания	= Неопределено;

	// Чтение данных файла

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлу);

	ПостроительDOM = Новый ПостроительDOM();
	XML = ПостроительDOM.Прочитать(ЧтениеXML);

	ДанныеФайла = Новый ТаблицаЗначений;
	ДанныеФайла.Колонки.Добавить("БанковскийСчет",	Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(20, ДопустимаяДлина.Переменная)));
	ДанныеФайла.Колонки.Добавить("ИННБанка",		Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(12, ДопустимаяДлина.Переменная)));
	ДанныеФайла.Колонки.Добавить("ДатаНачала",		Новый ОписаниеТипов("Дата"));
	ДанныеФайла.Колонки.Добавить("ДатаОкончания",	Новый ОписаниеТипов("Дата"));
	ДанныеФайла.Колонки.Добавить("КонечныйОстаток",	Новый ОписаниеТипов("Число"));
	ДанныеФайла.Колонки.Добавить("Приход",			Новый ОписаниеТипов("Число"));
	ДанныеФайла.Колонки.Добавить("Расход",			Новый ОписаниеТипов("Число"));

	Для Каждого ЭлементыДокумента Из XML.ЭлементДокумента.ДочерниеУзлы Цикл

		Если ВРег(ЭлементыДокумента.ИмяУзла) = "SR_0420409"
			ИЛИ ВРег(ЭлементыДокумента.ИмяУзла) = "SR_0420409_M"
			ИЛИ ВРег(ЭлементыДокумента.ИмяУзла) = "SR_0420409_Q" Тогда

			Для Каждого SR_0420409_Item Из ЭлементыДокумента.ДочерниеУзлы Цикл
			
				Date_From	= SR_0420409_Item.Атрибуты.ПолучитьИменованныйЭлемент("Date_From").ЗначениеУзла;
				Date_To		= SR_0420409_Item.Атрибуты.ПолучитьИменованныйЭлемент("Date_To").ЗначениеУзла;
				
				Rek_kred_org_i_schetaTaxis	= SR_0420409_Item.ПолучитьЭлементыПоИмени("Rek_kred_org_i_schetaTaxis")[0].Атрибуты.ПолучитьИменованныйЭлемент("Value").ЗначениеУзла;
				DSKO_BB						= SR_0420409_Item.ПолучитьЭлементыПоИмени("DSKO_BB")[0].Атрибуты.ПолучитьИменованныйЭлемент("Value").ЗначениеУзла;
				
				DSKO_ObDt					= SR_0420409_Item.ПолучитьЭлементыПоИмени("DSKO_ObDt");
				DSKO_ObDt					= ?(DSKO_ObDt.Количество() = 0, 0, DSKO_ObDt[0].Атрибуты.ПолучитьИменованныйЭлемент("Value").ЗначениеУзла);
				
				DSKO_ObKt					= SR_0420409_Item.ПолучитьЭлементыПоИмени("DSKO_ObKt");
				DSKO_ObKt					= ?(DSKO_ObKt.Количество() = 0, 0, DSKO_ObKt[0].Атрибуты.ПолучитьИменованныйЭлемент("Value").ЗначениеУзла);
				
				ИНН_БанковскийСчет			= СтрРазделить(Rek_kred_org_i_schetaTaxis, "_", Ложь);
				
				СтрокаДанных = ДанныеФайла.Добавить();
				СтрокаДанных.БанковскийСчет		= ИНН_БанковскийСчет[1];
				СтрокаДанных.ИННБанка			= ИНН_БанковскийСчет[0];
				СтрокаДанных.ДатаНачала			= XMLЗначение(Тип("Дата"), Date_From);
				СтрокаДанных.ДатаОкончания		= XMLЗначение(Тип("Дата"), Date_To);
				СтрокаДанных.КонечныйОстаток	= DSKO_BB;
				СтрокаДанных.Приход				= DSKO_ObDt;
				СтрокаДанных.Расход				= DSKO_ObKt;
				
			КонецЦикла;
		
		ИначеЕсли ЭлементыДокумента.ИмяУзла = "SR_Sved_ObOtchOrg_OtvLicza2"
			ИЛИ ЭлементыДокумента.ИмяУзла = "SR_Sved_ObOtchOrg_OtvLicza" Тогда
		
			Для Каждого SR_Sved_ObOtchOrg_OtvLicza_Item Из ЭлементыДокумента.ДочерниеУзлы Цикл
				Date_From	= SR_Sved_ObOtchOrg_OtvLicza_Item.Атрибуты.ПолучитьИменованныйЭлемент("Date_From").ЗначениеУзла;
				Date_To		= SR_Sved_ObOtchOrg_OtvLicza_Item.Атрибуты.ПолучитьИменованныйЭлемент("Date_To").ЗначениеУзла;
				
				ДатаНачала			= XMLЗначение(Тип("Дата"), Date_From);
				ДатаОкончания		= XMLЗначение(Тип("Дата"), Date_To);
			КонецЦикла;
			
		КонецЕсли;

	КонецЦикла;

	Если ДатаНачала = Неопределено ИЛИ ДатаОкончания = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет не содержит данных о периоде. Сверка данных с банком не выполнена", , , , Отказ);
		Возврат Ложь;
	КонецЕсли;
	
	// Заполним остатки на начало и оставим только данные соответствующие периоду

	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеФайла.БанковскийСчет КАК БанковскийСчет,
		|	ДанныеФайла.ИННБанка КАК ИННБанка,
		|	ДанныеФайла.ДатаНачала КАК ДатаНачала,
		|	ДанныеФайла.ДатаОкончания КАК ДатаОкончания,
		|	ДанныеФайла.КонечныйОстаток КАК КонечныйОстаток,
		|	ДанныеФайла.Приход КАК Приход,
		|	ДанныеФайла.Расход КАК Расход,
		|	ДОБАВИТЬКДАТЕ(ДанныеФайла.ДатаОкончания, ДЕНЬ, 1) КАК СледующийДеньПослеДатыОкончания
		|ПОМЕСТИТЬ _ДанныеФайлаИсходные
		|ИЗ
		|	&ДанныеФайла КАК ДанныеФайла
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	БанковскийСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Банки.Ссылка КАК Банк,
		|	_ДанныеФайлаИсходные.ИННБанка КАК ИНН
		|ПОМЕСТИТЬ _ИННБанков
		|ИЗ
		|	Справочник.Банки КАК Банки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛиц
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеФайлаИсходные КАК _ДанныеФайлаИсходные
		|			ПО РеквизитыЮридическихЛиц.ИНН = _ДанныеФайлаИсходные.ИННБанка
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(
		|					&ДатаОкончания,
		|					ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)
		|						И НЕ РодительскоеЮридическоеЛицо В (&ИсключаемыеГоловныеОрганизации)) КАК ГоловныеОрганизации
		|			ПО (ГоловныеОрганизации.ЮридическоеЛицо = РеквизитыЮридическихЛиц.ЮрФизЛицо)
		|				И (ГоловныеОрганизации.Действует)
		|		ПО (Банки.ЮрФизЛицо В (РеквизитыЮридическихЛиц.ЮрФизЛицо, ГоловныеОрганизации.РодительскоеЮридическоеЛицо))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеФайлаИсходные.БанковскийСчет КАК БанковскийСчет,
		|	_ДанныеФайлаИсходные.ИННБанка КАК Банк,
		|	_ДанныеФайлаИсходные.ИННБанка КАК ИННБанка,
		|	_ДанныеФайлаИсходные.ДатаНачала КАК ДатаНачала,
		|	_ДанныеФайлаИсходные.ДатаОкончания КАК ДатаОкончания,
		|	_ДанныеФайлаНачальныйОстаток.КонечныйОстаток КАК НачальныйОстаток,
		|	_ДанныеФайлаИсходные.Приход КАК Приход,
		|	_ДанныеФайлаИсходные.Расход КАК Расход,
		|	_ДанныеФайлаИсходные.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _ДанныеФайла
		|ИЗ
		|	_ДанныеФайлаИсходные КАК _ДанныеФайлаИсходные
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеФайлаИсходные КАК _ДанныеФайлаНачальныйОстаток
		|		ПО (_ДанныеФайлаНачальныйОстаток.БанковскийСчет = _ДанныеФайлаИсходные.БанковскийСчет)
		|			И (_ДанныеФайлаНачальныйОстаток.СледующийДеньПослеДатыОкончания = _ДанныеФайлаИсходные.ДатаНачала)
		|ГДЕ
		|	_ДанныеФайлаИсходные.ДатаНачала = &ДатаНачала
		|	И _ДанныеФайлаИсходные.ДатаОкончания = &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(БанковскиеСчета.Ссылка, _ДанныеФайла.БанковскийСчет) КАК БанковскийСчет,
		|	ЕСТЬNULL(БанковскиеСчета.Банк, ""Банк не найден (ИНН "" + _ДанныеФайла.ИННБанка + "")"") КАК Банк,
		|	_ДанныеФайла.ИННБанка КАК ИННБанка,
		|	_ДанныеФайла.ДатаНачала КАК ДатаНачала,
		|	_ДанныеФайла.ДатаОкончания КАК ДатаОкончания,
		|	_ДанныеФайла.НачальныйОстаток КАК НачальныйОстаток,
		|	_ДанныеФайла.Приход КАК Приход,
		|	_ДанныеФайла.Расход КАК Расход,
		|	_ДанныеФайла.КонечныйОстаток КАК КонечныйОстаток
		|ПОМЕСТИТЬ _СопоставленныеДанные
		|ИЗ
		|	_ДанныеФайла КАК _ДанныеФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИННБанков КАК _ИННБанков
		|			ПО (_ИННБанков.Банк = БанковскиеСчета.Банк)
		|		ПО (БанковскиеСчета.Организация = &Организация)
		|			И (БанковскиеСчета.НомерСчета = _ДанныеФайла.БанковскийСчет)
		|			И (_ИННБанков.ИНН = _ДанныеФайла.ИННБанка)
		|			И (НЕ БанковскиеСчета.ПометкаУдаления)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_СопоставленныеДанные.БанковскийСчет КАК БанковскийСчет,
		|	ЕСТЬNULL(_СопоставленныеБанки.Банк, _СопоставленныеДанные.Банк) КАК Банк,
		|	_СопоставленныеДанные.ИННБанка КАК ИННБанка,
		|	_СопоставленныеДанные.ДатаНачала КАК ДатаНачала,
		|	_СопоставленныеДанные.ДатаОкончания КАК ДатаОкончания,
		|	_СопоставленныеДанные.НачальныйОстаток КАК НачальныйОстаток,
		|	_СопоставленныеДанные.Приход КАК Приход,
		|	_СопоставленныеДанные.Расход КАК Расход,
		|	_СопоставленныеДанные.КонечныйОстаток КАК КонечныйОстаток
		|ИЗ
		|	_СопоставленныеДанные КАК _СопоставленныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(_СопоставленныеДанные.Банк) КАК Банк,
		|			_СопоставленныеДанные.ИННБанка КАК ИННБанка
		|		ИЗ
		|			_СопоставленныеДанные КАК _СопоставленныеДанные
		|		ГДЕ
		|			ТИПЗНАЧЕНИЯ(_СопоставленныеДанные.Банк) = ТИП(Справочник.Банки)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_СопоставленныеДанные.ИННБанка) КАК _СопоставленныеБанки
		|		ПО _СопоставленныеДанные.ИННБанка = _СопоставленныеБанки.ИННБанка
		|			И (ТИПЗНАЧЕНИЯ(_СопоставленныеДанные.Банк) <> ТИП(Справочник.Банки))";

	Запрос.УстановитьПараметр("ДанныеФайла",					ДанныеФайла);
	Запрос.УстановитьПараметр("ДатаНачала",						ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации",	ИсключаемыеГоловныеОрганизации);

	ДанныеФайлаОбъединенные = Запрос.Выполнить().Выгрузить();

	Если ДанныеФайлаОбъединенные.Количество() <> СистемныеФункции.КоличествоЗаписейВременнойТаблицы(Запрос, "_ДанныеФайла") Тогда
		ТекстИсключения = СтрШаблон("Не удалось однозначно определить банк по ИНН и номеру банковского счета! %1 <> %2", 
			ДанныеФайлаОбъединенные.Количество(), СистемныеФункции.КоличествоЗаписейВременнойТаблицы(Запрос, "_ДанныеФайла"));
		ВызватьИсключение ТекстИсключения;		
	КонецЕсли;
	
	// Сверим с данными выписок

	ОбработкаСверки = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки(ОбщегоНазначения.ПолучитьИменованныйОбъект("ВнешОбр_СверкаСБанком"));

	ОбработкаСверки.Организация				= ЭтотОбъект.Организация;
	ОбработкаСверки.Период.ДатаНачала		= ДатаНачала;
	ОбработкаСверки.Период.ДатаОкончания	= ДатаОкончания;

	ПараметрыСверки = Новый Структура;
	ПараметрыСверки.Вставить("СверятьСуммыВВалютеУчета",							Истина);
	ПараметрыСверки.Вставить("НачальныйОстатокПоКурсуПредыдущегоДня",				Истина);
	ПараметрыСверки.Вставить("ПриОтсутствииВ1СНулевыеДанныеБанкаСчитатьСверенными",	Истина);
	ПараметрыСверки.Вставить("ПриОтсутствииВБанкеНулевыеДанные1ССчитатьСверенными",	Истина);
	ПараметрыСверки.Вставить("ИсключитьИзДанныхБанкаТранзитныеВалютныеСчета",		Истина);
	
	РезультатСверки = ОбработкаСверки.ВыполнитьСверку(ДанныеФайлаОбъединенные, ПараметрыСверки);

	Отчет = ОбработкаСверки.СформироватьОтчетОРезультатахСверки();
	
	Отчет.Область().СоздатьФорматСтрок(); // Каждый отчет со своей шириной столбцов
	
	Результат.Вывести(Отчет);
		
	Возврат РезультатСверки;
	
КонецФункции

Функция ОКУД0420409_ПолучитьДанныеБухгалтерии(Бухгалтерия) Экспорт
	
	Запрос = Бухгалтерия.NewObject("Запрос");
	Запрос.МенеджерВременныхТаблиц = Бухгалтерия.NewObject("МенеджерВременныхТаблиц");
	
	Запрос.Текст = 
		"
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|                ВЫРАЗИТЬ(БНФОБанковскийОстаткиИОбороты.Субконто1 КАК Справочник.БанковскиеСчета) КАК БанковскийСчет,
		|                ВЫРАЗИТЬ(БНФОБанковскийОстаткиИОбороты.Субконто2 КАК Справочник.ДоговорыКонтрагентов) КАК ДепозитныйДоговор,
		|                СУММА(БНФОБанковскийОстаткиИОбороты.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
		|                СУММА(БНФОБанковскийОстаткиИОбороты.СуммаОборотДт) КАК СуммаОборотДт,
		|                СУММА(БНФОБанковскийОстаткиИОбороты.СуммаОборотКт) КАК СуммаОборотКт,
		|                СУММА(БНФОБанковскийОстаткиИОбороты.СуммаКонечныйОстаток) КАК СуммаКонечныйОстаток
		|ПОМЕСТИТЬ ВТ_БНФОБанковский
		|ИЗ
		|                РегистрБухгалтерии.БНФОБанковский.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, ПЕРИОД, , Счет.Код В (""20601""), , Организация = &Организация) КАК БНФОБанковскийОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|                БНФОБанковскийОстаткиИОбороты.Субконто1,
		|                БНФОБанковскийОстаткиИОбороты.Субконто2
		|;
		|
