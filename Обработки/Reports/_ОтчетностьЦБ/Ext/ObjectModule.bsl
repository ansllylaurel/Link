	Результат.Вывести(ОбластьШапка);
	
	ВывестиРаздел("Табл_СведенияОбИндивидИнвестСчетах", "", "СведОбИндивидуальнИнвестиционнСчетах.Табл_СведенияОбИндивидИнвестСчетах.Table_46_1", ПакетОтчет, Макет, Результат);
	
	ОбластьПодвал						= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ФИОИсполнителя =	Лев(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ИмяПодписанта, 1) + "." +
												Лев(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ОтчествоПодписанта, 1) + ". " +
												СокрЛП(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ФамилияПодписанта);
	
	ОбластьПодвал.Параметры.ФИОКонтролера	=	Лев(СопроводительноеПисьмо.ПодписьКонтролера.ИмяКонтролера, 1) + "." +
												Лев(СопроводительноеПисьмо.ПодписьКонтролера.ОтчествоКонтролера, 1) + ". " +
												СокрЛП(СопроводительноеПисьмо.ПодписьКонтролера.ФамилияКонтролера);
	
	Результат.Вывести(ОбластьПодвал);
	
