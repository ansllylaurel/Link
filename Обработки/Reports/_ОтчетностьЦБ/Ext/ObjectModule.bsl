	СтрокаСоединенияССерверомSQL = "Driver={SQL Server};Server=AP21.G1.LAN;UID=svc_API_AM;PWD=p8z4gr39VAxXAfhn;Database=MatriX";	
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("INN"					, Новый ОписаниеТипов("Строка"));
	
