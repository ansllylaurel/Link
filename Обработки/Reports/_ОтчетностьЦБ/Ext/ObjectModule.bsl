Функция ПолучитьСоставГруппДоходовИРасходов(ИспользоватьДанныеБэкОфиса)
	
	СоставГруппДоходовИРасходов = Новый Структура("ФинансовыйРезультатОтРеализации, 
			|ДивидендыИПроцентыПоЦБ, 
			|ПроцентыПоДепозитам, 
			|ФинансовыйРезультатОтПереоценкиАктивов, 
			|ДругиеВидыДоходов, 
			|ОплатаУслугСпецДепозитария, 
			|ОплатаУслугПрофУчастниковРынкаЦБ, 
			|ОплатаУслугАудитора, 
			|РасходыНаОбязательноеСтрахование, 
			|ВознаграждениеУправляющейКомпании,
			|ИсключенныеДоходыИРасходы,
			|ОплатаПрочихУслуг", Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив);
	
	МакетСписокДоходовРасходов = ПолучитьМакет("ГруппыДоходовИРасходов");
	
	ТаблицаДоходовРасходов = Новый	ТаблицаЗначений;
	
	КС = Новый КвалификаторыСтроки(150);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТиповСтрока = Новый ОписаниеТипов(МассивТипов, , , , КС);
	
	ТаблицаДоходовРасходов.Колонки.Добавить("Код", ОписаниеТиповСтрока);
	ТаблицаДоходовРасходов.Колонки.Добавить("ИмяПредопределенныхДанных", ОписаниеТиповСтрока);
	ТаблицаДоходовРасходов.Колонки.Добавить("ГруппаДоходовИРасходов", ОписаниеТиповСтрока);
	
	Для НомерСтроки = 2 По МакетСписокДоходовРасходов.ВысотаТаблицы Цикл
		
		ИмяПредопределенныхДанных 	= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
		Код 						= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);		
		ГруппаДоходовИРасходов 		= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 4, НомерСтроки, 4).Текст);
		Исключить 					= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 5, НомерСтроки, 5).Текст);
		ДатаОкончания 				= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 6, НомерСтроки, 6).Текст);
		
		Если ГруппаДоходовИРасходов = "" Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаОкончания = ?(ПустаяСтрока(ДатаОкончания), '39990101', Дата(ДатаОкончания)); 
		Если Исключить = "Да" И ИспользоватьДанныеБэкОфиса И ЭтотОбъект.Период.ДатаОкончания < ДатаОкончания Тогда
			ГруппаДоходовИРасходов = "ИсключенныеДоходыИРасходы";
		КонецЕсли;
		
		Если ИмяПредопределенныхДанных <> "" Тогда
			СоставГруппДоходовИРасходов[ГруппаДоходовИРасходов].Добавить(Справочники.ПрочиеДоходыИРасходы[ИмяПредопределенныхДанных]);
		Иначе	
			НоваяСтрока = ТаблицаДоходовРасходов.Добавить();		
			НоваяСтрока.Код 					= Код;
			НоваяСтрока.ГруппаДоходовИРасходов	= ГруппаДоходовИРасходов;
		КонецЕсли;
		
	КонецЦикла;
	
	// Определим ссылки на элементы справочника
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаДоходовРасходов.Код КАК Код,
	|	_ТаблицаДоходовРасходов.ГруппаДоходовИРасходов КАК ГруппаДоходовИРасходов
	|ПОМЕСТИТЬ _ТаблицаСтатей
	|ИЗ
	|	&ТаблицаДоходовРасходов КАК _ТаблицаДоходовРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПрочиеДоходыИРасходы.Ссылка КАК Ссылка,
	|	_ТаблицаСтатей.ГруппаДоходовИРасходов КАК ГруппаДоходовИРасходов
	|ИЗ
	|	Справочник.ПрочиеДоходыИРасходы КАК ПрочиеДоходыИРасходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаСтатей КАК _ТаблицаСтатей
	|		ПО ПрочиеДоходыИРасходы.Код = _ТаблицаСтатей.Код
	|ГДЕ
	|	НЕ ПрочиеДоходыИРасходы.Предопределенный
	|	И НЕ ПрочиеДоходыИРасходы.ЭтоГруппа
	|	И НЕ ПрочиеДоходыИРасходы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТаблицаДоходовРасходов", ТаблицаДоходовРасходов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоставГруппДоходовИРасходов[Выборка.ГруппаДоходовИРасходов].Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	ВозвратРасходовПрошлогоПериода = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ВозвратРасхода"); 
	СоставГруппДоходовИРасходов["РасходыНаОбязательноеСтрахование"].Добавить(ВозвратРасходовПрошлогоПериода);
	
	Возврат СоставГруппДоходовИРасходов;
	
КонецФункции

Функция ПолучитьПроцентыПоДепозитуИзСЧА(НачалоПериода, КонецПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
	|			&ДатаОкончания,
	|			СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
	|				И НЕ СчетДоверительногоУправления.ПометкаУдаления
	|				И (СчетДоверительногоУправления.ДатаРасторжения > &ДатаОкончания
	|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
	|				И Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаОкончания", 	КонецПериода);
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	
	ВыборкаСчетаДУ = Запрос.Выполнить().Выбрать();
	Если ВыборкаСчетаДУ.Следующий() Тогда
	
		СтоимостиДепозитныхВкладов_НачалоПериода = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
			ВыборкаСчетаДУ.СчетДоверительногоУправления,
			НачалоПериода-1,
			Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
			Ложь);
			
		СтоимостиДепозитныхВкладов_КонецПериода = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
			ВыборкаСчетаДУ.СчетДоверительногоУправления,
			КонецДня(КонецПериода),
			Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
			Ложь);

		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(СтоимостиДепозитныхВкладов_НачалоПериода.Проценты КАК ЧИСЛО(19, 2)) КАК Проценты,
		|	СтоимостиДепозитныхВкладов_НачалоПериода.КредитныйИнструмент КАК ДепозитныйВклад
		|ПОМЕСТИТЬ _ДепозитыНаНачалоПериода
		|ИЗ
		|	&СтоимостиДепозитныхВкладов_НачалоПериода КАК СтоимостиДепозитныхВкладов_НачалоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(СтоимостиДепозитныхВкладов_КонецПериода.Проценты КАК ЧИСЛО(19, 2)) КАК Проценты,
		|	СтоимостиДепозитныхВкладов_КонецПериода.КредитныйИнструмент КАК ДепозитныйВклад
		|ПОМЕСТИТЬ _ДепозитыНаКонецПериода
		|ИЗ
		|	&СтоимостиДепозитныхВкладов_КонецПериода КАК СтоимостиДепозитныхВкладов_КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕСТЬNULL(_ДепозитыНаКонецПериода.Проценты, 0) - ЕСТЬNULL(_ДепозитыНаНачалоПериода.Проценты, 0)) КАК Проценты
		|ИЗ
		|	_ДепозитыНаКонецПериода КАК _ДепозитыНаКонецПериода
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ДепозитыНаНачалоПериода КАК _ДепозитыНаНачалоПериода
		|		ПО _ДепозитыНаКонецПериода.ДепозитныйВклад = _ДепозитыНаНачалоПериода.ДепозитныйВклад";
		
		Запрос.УстановитьПараметр("СтоимостиДепозитныхВкладов_НачалоПериода",	СтоимостиДепозитныхВкладов_НачалоПериода);
		Запрос.УстановитьПараметр("СтоимостиДепозитныхВкладов_КонецПериода",	СтоимостиДепозитныхВкладов_КонецПериода);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Проценты;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Процедура ОКУД0420512_ЗаполнитьПечатнуюФорму(Запрос, Результат, Отказ) Экспорт
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР) Тогда

		Макет = ПолучитьМакет("ОКУД0420512");	
		
		ВывестиОбласть(Результат, Макет, "Шапка",		Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ПечатнаяФорма_Шапка").ПолучитьДанные().Выгрузить());
		ВывестиОбласть(Результат, Макет, "Показатели",	Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ПечатнаяФорма_Показатели").ПолучитьДанные().Выгрузить());
		ВывестиОбласть(Результат, Макет, "Подписанты",	Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ПечатнаяФорма_Подписанты").ПолучитьДанные().Выгрузить());
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

//Отчет о доходах от инвестирования средств пенсионных накоплений Пенсионного фонда Российской Федерации
#Область ОКУД0420513_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420513(Запрос, Отказ) Экспорт

	ИмяПакета = "ОКУД0420513";
	ПакетДанных = Новый Структура;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ПризнакНулевогоОтчета = Истина;
	
	Если ЕстьДействующиеДоговорыВОтчетномПериоде(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР) Тогда
		ИспользоватьДанныеБэкОфиса = ЭтотОбъект.Период.ДатаНачала >= '20190101';
		
		// Постепенно перерабатываем на получение всех данных из бэк-офиса
		Проценты 				= 0;
		Проценты_СНачалаГода 	= 0;
		Если ИспользоватьДанныеБэкОфиса И ЭтотОбъект.Период.ДатаОкончания < '20250101' Тогда
			Проценты = ПолучитьПроцентыПоДепозитуИзСЧА(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
			Проценты_СНачалаГода = ПолучитьПроцентыПоДепозитуИзСЧА(НачалоГода(ЭтотОбъект.Период.ДатаНачала), ЭтотОбъект.Период.ДатаОкончания);
		КонецЕсли;
		
		ГруппыДоходовИРасходов = ПолучитьСоставГруппДоходовИРасходов(ИспользоватьДанныеБэкОфиса);
		
		// Точки входа - отдельные даты. Данные для отчета при этом собираются ровно с начала квартала (или года) по конец квартала
		
		// Даты для точек входа:
		// 1. День за последним рабочим днем предыдущего квартала
		Запрос.УстановитьПараметр("ДеньЗаПоследнимРабочимДнемПредыдущегоКвартала", Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -3))) + 60 * 60 * 24);
		
		// 3. Начало года
		Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ЭтотОбъект.Период.ДатаОкончания));
			
		Запрос.УстановитьПараметр("ДатаНачала",		  ЭтотОбъект.Период.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",	  ЭтотОбъект.Период.ДатаОкончания);
		Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);	
			
		Запрос.УстановитьПараметр("Организация"								, ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления"			, ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ВидПоказателя"   						, Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
		Запрос.УстановитьПараметр("ФинансовыйРезультатОтРеализации"			, ГруппыДоходовИРасходов.ФинансовыйРезультатОтРеализации);
		Запрос.УстановитьПараметр("ДивидендыИПроцентыПоЦБ"					, ГруппыДоходовИРасходов.ДивидендыИПроцентыПоЦБ);
		Запрос.УстановитьПараметр("ПроцентыПоДепозитам"						, ГруппыДоходовИРасходов.ПроцентыПоДепозитам);
		Запрос.УстановитьПараметр("ФинансовыйРезультатОтПереоценкиАктивов"	, ГруппыДоходовИРасходов.ФинансовыйРезультатОтПереоценкиАктивов);
		Запрос.УстановитьПараметр("ДругиеВидыДоходов"						, ГруппыДоходовИРасходов.ДругиеВидыДоходов);
		Запрос.УстановитьПараметр("ОплатаУслугСпецДепозитария"				, ГруппыДоходовИРасходов.ОплатаУслугСпецДепозитария);
		Запрос.УстановитьПараметр("ОплатаУслугПрофУчастниковРынкаЦБ"		, ГруппыДоходовИРасходов.ОплатаУслугПрофУчастниковРынкаЦБ);
		Запрос.УстановитьПараметр("ОплатаУслугАудитора"						, ГруппыДоходовИРасходов.ОплатаУслугАудитора);
