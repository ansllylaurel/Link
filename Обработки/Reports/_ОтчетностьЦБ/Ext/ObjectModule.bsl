Процедура ЗаполнитьРасшифровку_ОКУД0420503(Результат, Запрос, Отказ) Экспорт
	
	Результат.Очистить();
	
	ПолучитьДанные_ОКУД0420503_ВыполнитьПредварительныеЗапросы(Запрос, Отказ);
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_РасшифровкаОтчета");
	Данные.Сортировать("КодСтроки");
	
	Макет = ПолучитьМакет("ОКУД0420503_Расшифровка");
	
#Область РашифровкаПодробно

	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка");
	
	Результат.Вывести(ОбластьШапка);
	Результат.НачатьГруппуСтрок(, Ложь);
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если СтрокаДанных.Счет = ПланыСчетов.Основной.ПрочиеДоходы
			ИЛИ СтрокаДанных.Счет = ПланыСчетов.Основной.ПрочиеРасходы Тогда
			СтрокаДанных.Счет = ПланыСчетов.Основной.ПрочиеДоходыИРасходы;
		КонецЕсли;
	КонецЦикла;
	
	Результат.ЗакончитьГруппуСтрок();
	
#КонецОбласти	
	
#Область Рашифровка
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_РасшифровкаОтчетаСвернутыеПрочие");
	Данные.Свернуть("Счет,Субконто1,Субконто2,ISIN,КодСтроки", "Сумма");
	Данные.Сортировать("КодСтроки");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка2");
	ОбластьСтрока		= Макет.ПолучитьОбласть("Строка2");
	
	Результат.Вывести(ОбластьШапка);
	Результат.НачатьГруппуСтрок(, Ложь);
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	Результат.ЗакончитьГруппуСтрок();
	
#КонецОбласти	
	
#Область РашифровкаРаздела4

	ОбластьШапка		= Макет.ПолучитьОбласть("ШапкаРаздел4");
	ОбластьСтрока		= Макет.ПолучитьОбласть("СтрокаРаздел4");
	
	Результат.Вывести(ОбластьШапка);
	Результат.НачатьГруппуСтрок(, Ложь);
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "ВТ_РасшифровкаРаздела4");
	Данные.Сортировать("ЦеннаяБумага,Сделка");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	Результат.ЗакончитьГруппуСтрок();
	
#КонецОбласти	
	
КонецПроцедуры

Процедура ПолучитьДанные_ОКУД0420503_ВыполнитьПредварительныеЗапросы(Запрос, Отказ)
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_КодыСтрок") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидыРасходовДУ", ПолучитьТаблицуИзМакета("ОКУД0420505_ОКУД0420503_ВидыПоказателей",,, Новый Структура("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии)));
	
	УстановитьПараметрыЗапроса_ОКУД0420503(Запрос, Отказ);

	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420503();
	Запрос.Выполнить();
	
	ОКУД0420503_ЗаполнитьОписаниеРасшифровки(Запрос);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420503_ДляВыгрузкиИПечати();
	Запрос.Выполнить();
	
	Если Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ОбнулениеПоказателейПИФПоПисьмуЦБ3838630").ПолучитьДанные().Выгрузить()[0].ДляВсегоПериода = ЛОЖЬ Тогда
		Если НЕ ПолучитьДанные_ОКУД0420503_ПриростСовпадаетСРазницойСЧА(Запрос) Тогда
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ПолучитьДанные_ОКУД0420503_НачисленияПоКупонуРавноОплате(Запрос) Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОКУД0420503_ЗаполнитьОписаниеРасшифровки(Запрос)
	
	ВТ_РасшифровкаБольшеПятиПроцентов = Запрос.МенеджерВременныхТаблиц.Таблицы.Получить("ВТ_РасшифровкаБольшеПятиПроцентов").ПолучитьДанные().Выгрузить();
	
	Для Каждого СтрокаДанных Из ВТ_РасшифровкаБольшеПятиПроцентов Цикл
		Если СтрокаДанных.ОписаниеРасшифровки = "" Тогда
			СтрокаДанных.ОписаниеРасшифровки = ПолучитьДанные_ОКУД0420503_Раздел3СведенияОПриросте_ДанныеРасшифровкиБолееПятиПроцентов_ОписаниеРасшифровки(СтрокаДанных.Регистратор, СтрокаДанных.Период, СтрокаДанных.КодСтроки, СтрокаДанных.Субконто1, СтрокаДанных.Субконто2, СтрокаДанных.СЧА = 0);
		КонецЕсли;
	КонецЦикла;
	
	ЗаменитьВременнуюТаблицу(Запрос, "ВТ_РасшифровкаБольшеПятиПроцентов", ВТ_РасшифровкаБольшеПятиПроцентов);
	ЗаменитьВременнуюТаблицу(Запрос, "ПечатнаяФорма_Раздел3События_Расшифровка", ВТ_РасшифровкаБольшеПятиПроцентов);
	ЗаменитьВременнуюТаблицу(Запрос, "ПечатнаяФорма_Раздел3_Расшифровка", ВТ_РасшифровкаБольшеПятиПроцентов);
	
КонецПроцедуры

Процедура УстановитьПараметрыЗапроса_ОКУД0420503(Запрос, Отказ)

	РеквизитыПИФ = ПолучитьРеквизитыПИФСчетаДУ();
	
	ЭтоНовыйПИФ = РеквизитыПИФ.ДатаОкончанияФормирования > ЭтотОбъект.Период.ДатаНачала;
	
	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("АналитикаУчетаРезервовДебиторскойЗадолженности", НастройкиУчета.АналитикаУчетаРезервовДебиторскойЗадолженности);
	Запрос.УстановитьПараметр("АналитикаПереоценкиДебиторскойЗадолженности", НастройкиУчета.АналитикаПереоценкиДебиторскойЗадолженности);
	Запрос.УстановитьПараметр("АналитикаИзмененияСтоимостиДебиторскойЗадолженностиВРезультатеСделок", НастройкиУчета.АналитикаИзмененияСтоимостиДебиторскойЗадолженностиВРезультатеСделок);

	Запрос.УстановитьПараметр("АналитикаОплатыПоДоговорамВТомЧислеПоДоговорамАренды", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПРД_ОплатаПоДоговорам"));

	Запрос.УстановитьПараметр("ДатаНачала"					, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"				, ЭтотОбъект.Период.ДатаОкончания);

	Запрос.УстановитьПараметр("ГраницаНачалаПрироста"		, Новый Граница(ЭтотОбъект.Период.ДатаНачала, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ГраницаОкончанияПрироста"	, Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("ЭтоНовыйПИФ", ЭтоНовыйПИФ);
	
	//Для новых ПИФ нужно включить зачисление и погашение паёв до даты окончания формирования ПИФ
	Если ЭтоНовыйПИФ Тогда
		Запрос.УстановитьПараметр("ГраницаНачалаВыдачиПогашенияПаев"	, Новый Граница(РеквизитыПИФ.ДатаПравил, ВидГраницы.Включая));	
	Иначе
		Запрос.УстановитьПараметр("ГраницаНачалаВыдачиПогашенияПаев"	, Новый Граница(ЭтотОбъект.Период.ДатаНачала, ВидГраницы.Включая));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("ОтчетныйМесяц"	, НРег(Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=MMMM")));
	Запрос.УстановитьПараметр("ОтчетныйПериод"	, Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=yyyy"));
	
	Запрос.УстановитьПараметр("КодВалютыXTDD"		, "RUB");
	Запрос.УстановитьПараметр("КодВалютыXBRL"		, "643");
	Запрос.УстановитьПараметр("ВерсияТаксономии"	, ЭтотОбъект.ВерсияТаксономии);
	
	ПИФ		= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.УстановитьПараметр("IdAifPifTaxis"				, ПИФ);	
	
	Запрос.УстановитьПараметр("Руководитель",				ПолучитьПолноеФИООтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("УполномоченноеЛицоСпецДепа", ПолучитьПолноеФИООтветственногоЛица("УполномоченноеЛицоСпецДепа"));
	
	Запрос.УстановитьПараметр("ИницыалыФамилияРуководитель",				ПолучитьИнициалыФамилиюОтветственногоЛица("Руководитель"));
	Запрос.УстановитьПараметр("ИницыалыФамилияУполномоченноеЛицоСпецДепа",	ПолучитьИнициалыФамилиюОтветственногоЛица("УполномоченноеЛицоСпецДепа"));
	
	Запрос.УстановитьПараметр("ОтражатьРЕПОВРазделе", ПолучитьЗначениеНастройкиОтчета("ОтражатьРЕПОВРазделе", Истина, Отказ)); //была СделкиРЕПООтражатьВРазделеСделкокСИмуществом
	
	Запрос.УстановитьПараметр("ДатыРасчетаСЧА", Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала - 86400, ЭтотОбъект.Период.ДатаОкончания)); 
	
	Запрос.УстановитьПараметр("ОКУД0420503СведенияОбОперацияхКоторыеОказалиСущественноеВлияниеНаСЧА", ПолучитьДанные_ОКУД0420503_СведенияОбОперацияхКоторыеОказалиСущественноеВлияниеНаСЧА(Запрос));
	
	Запрос.УстановитьПараметр("ПДР_ДоходОтРеализацииНедвижимости", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ДоходОтРеализацииНедвижимости"));
	Запрос.УстановитьПараметр("ПДР_РасходыПоПолучениюВАренду", ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_РасходыПоПолучениюВАренду"));

	Запрос.УстановитьПараметр("ЭтоРПИ", ЭтотОбъект.ЭтоРПИ);
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(Справочники.ВидыЗадолженности.ПолучитьТаблицуАналитикиДляПредварительныхНачислений(), "_АналитикаДляПредварительныхНачислений", Запрос);
	
КонецПроцедуры

Функция ПолучитьДанные_ОКУД0420503_СведенияОбОперацияхКоторыеОказалиСущественноеВлияниеНаСЧА(Запрос)
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерПравил",		Запрос.Параметры.IdAifPifTaxis.НомерПравил);
	
	ТаблицаОпераций = ПолучитьТаблицуИзМакета("ОКУД0420503СведенияОбОперацияхКоторыеОказалиСущественноеВлияниеНаСЧА",,, ПараметрыПоиска);
	
	Возврат ТаблицаОпераций;
	
КонецФункции

Функция ПолучитьТекстЗапроса_ОКУД0420503_ДляВыгрузкиИПечати()
