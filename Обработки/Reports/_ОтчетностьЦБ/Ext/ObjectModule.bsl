Процедура ЗаполнитьПечатнуюФорму_ОКУД0420416(Запрос, Результат, Расшифровка, Отказ) Экспорт
	
	СопроводительноеПисьмо = ПолучитьСопроводительноеПисьмо("ОКУД0420416");
	
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Расшифровка.Очистить();
	
	Макет = ПолучитьМакет("ОКУД0420416_2_16_3_1");
	
	ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, СопроводительноеПисьмо); 
	ОбластьШапка.Параметры.ДатаРегистрации_День		= Формат(СопроводительноеПисьмо.ДатаРегистрации, "ДФ=dd");
	ОбластьШапка.Параметры.ДатаРегистрации_Месяц	= НРег(Формат(СопроводительноеПисьмо.ДатаРегистрации, "ДФ=MMMM"));
	ОбластьШапка.Параметры.ДатаРегистрации_Год		= Формат(СопроводительноеПисьмо.ДатаРегистрации, "ДФ=yyyy");
	ОбластьШапка.Параметры.ПустоеЗначение			= ЭтотОбъект.ПустоеЗначение;
	
	Результат.Вывести(ОбластьШапка);
	
	Результат.Вывести(Макет.ПолучитьОбласть("Шапка_СобстИнвест"));
	
	ОбластьСтрока_СобстИнвест = Макет.ПолучитьОбласть("Строка_СобстИнвест");
	
	СобственныеИнвестиции = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_СобственныеИнвестиции", Отказ);
	Если СобственныеИнвестиции.Количество() = 0 Тогда
		Результат.Вывести(ОбластьСтрока_СобстИнвест);
	Иначе
		Для Каждого СтрокаДанных Из СобственныеИнвестиции Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрока_СобстИнвест.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьСтрока_СобстИнвест);
		КонецЦикла;
	КонецЕсли;
	
	Результат.Вывести(Макет.ПолучитьОбласть("Шапка_ИнвестКлиентСтроки"));
	
	ОбластьСтрока_ИнвестКлиентСтроки = Макет.ПолучитьОбласть("Строка_ИнвестКлиентСтроки");
	
	ИнвестицииКлиента = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_ИнвестицииКлиента", Отказ);
	Если ИнвестицииКлиента.Количество() = 0 Тогда
		Результат.Вывести(ОбластьСтрока_ИнвестКлиентСтроки);
	Иначе
		Для Каждого СтрокаДанных Из ИнвестицииКлиента Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрока_ИнвестКлиентСтроки.Параметры, СтрокаДанных);
			Результат.Вывести(ОбластьСтрока_ИнвестКлиентСтроки);
		КонецЦикла;
	КонецЕсли;
	
	ОбластьПодвал						= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ФИОИсполнителя =	Лев(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ИмяПодписанта, 1) + "." +
												Лев(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ОтчествоПодписанта, 1) + ". " +
												СокрЛП(СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ФамилияПодписанта);
	
	ОбластьПодвал.Параметры.ФИОКонтролера	=	Лев(СопроводительноеПисьмо.ПодписьКонтролера.ИмяКонтролера, 1) + "." +
												Лев(СопроводительноеПисьмо.ПодписьКонтролера.ОтчествоКонтролера, 1) + ". " +
												СокрЛП(СопроводительноеПисьмо.ПодписьКонтролера.ФамилияКонтролера);
	
	Результат.Вывести(ОбластьПодвал);
	
	
	//Расшифровка отчёта
	Макет = ПолучитьМакет("ОКУД0420416_Расшифровка");
	
	ОбластьШапка = Макет.ПолучитьОбласть("ШапкаРасшифровки");
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаРасшифровки");
	
	ИтоговаяТаблица = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_ИтоговаяТаблица", Отказ);
	ИтоговаяТаблица.Сортировать("СчетДоверительногоУправления");
	
	НомерСтроки = 0;
	
	Расшифровка.Вывести(ОбластьШапка);
	Для Каждого СтрокаДанных ИЗ ИтоговаяТаблица Цикл
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных);
		Расшифровка.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	// расщифровка котировок
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Bloomberg = ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg");
	
	Котировки = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_Котировки", Отказ);
	
	Расшифровка.Вывести(ОбластьШапка);
	Для Каждого СтрокаКотировок ИЗ Котировки Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаКотировок);
		Расшифровка.Вывести(ОбластьСтрока);
			
		Если СтрокаКотировок.Биржа = Bloomberg Тогда
			Расшифровка.Область(Расшифровка.ВысотаТаблицы, 1, Расшифровка.ВысотаТаблицы, Расшифровка.ШиринаТаблицы).ЦветТекста = Новый Цвет(255, 0, 0);
		КонецЕсли;
		
	КонецЦикла;
	
	ВывестиРасшифровку(Запрос, Макет, Расшифровка, "_ЦенныеБумагиРассчитаныПоНоминалу", Отказ);
	ВывестиРасшифровку(Запрос, Макет, Расшифровка, "_ЦенныеБумагиОцененныеПоСтоимостиПокупки", Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ОКУД0420416_XBRL

Функция ПолучитьДанные_XBRL_ОКУД0420416(Запрос, Отказ) Экспорт
	
	ИмяПакета = "ОКУД0420416";
	ПакетДанных = Новый Структура;
	ДополнительныеПакеты = Новый Структура;
	
	Если НЕ ЭтотОбъект.ВыгружатьВXBRL И Не ЭтотОбъект.ВывестиПечатнуюФорму Тогда
		Возврат ПакетДанных; 
	КонецЕсли;
	
	ПередФормированиемОтчетностиXBRL(Ложь);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РаботаСОтчетностьюЦБ.ЗаполнитьТаблицуКодыКлиентовПоОКАТО(ЭтотОбъект, Запрос.МенеджерВременныхТаблиц);
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц,
		ЭтотОбъект.Период.ДатаОкончания,
		Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)); 
	
	КалендарьКотировок		= ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок");
	ПоследнийРабочийДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.УстановитьПараметр("ДатаОкончания"			, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация"				, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПустоеЗначение"			, "");
	Запрос.УстановитьПараметр("ПоследнийРабочийДень"	, ПоследнийРабочийДень);
	Запрос.УстановитьПараметр("Минус90ТорговыхДней"		, Справочники.Календари.ДобавитьКДатеРабочиеДни(КалендарьКотировок, ПоследнийРабочийДень, -90));
	Запрос.УстановитьПараметр("ММВБ"					, ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));		
	Запрос.УстановитьПараметр("Bloomberg"				, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg"));		
	Запрос.УстановитьПараметр("Режим_BVAL"				, ОбщегоНазначения.ПолучитьИменованныйОбъект("Bloomberg_BVAL"));
	Запрос.УстановитьПараметр("ДатаОтключенияBloomberg" , Дата(2022, 4, 1));		
	Запрос.УстановитьПараметр("ТаблицаISIN"				, ОКУД0420416_ПолучитьТаблицуISIN());
	Запрос.УстановитьПараметр("ВерсияТаксономии",		  ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ЕстьРаздел_SR_0420459",	  ЭтотОбъект.ВерсияТаксономии >= "7_1");
	
	Запрос.УстановитьПараметр("ДатаИсправленияКотировокПоМетодике", Дата(2021,1,1));
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420416();

	Запрос.Выполнить();

	ОКУД0420459_XBRL_ЗаполнитьРеестрЦенныхБумаг(Запрос, Отказ);
	Если ЭтотОбъект.ВерсияТаксономии >= "7_1" Тогда
		
		ДополнительныеПакеты.Вставить("ОКУД0420459", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "SR_0420459").Количество() = 0);
		
	КонецЕсли;
	
	Если НЕ ВыполнитьКонтрольныеПроцедуры(Запрос, Отказ) Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ТаблицаКонтроляСекторовЭкономикиЭмитентов = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_ТаблицаКонтроляСекторовЭкономикиЭмитентов", Отказ);
	Для Каждого СтрокаКонтроляСекторовЭкономикиЭмитентов Из ТаблицаКонтроляСекторовЭкономикиЭмитентов Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У эмитента """ + СтрокаКонтроляСекторовЭкономикиЭмитентов.ПолноеНаименованиеЭмитента + """ не указан код сектора экономики!",,,, Отказ);
	КонецЦикла;
	
	ТаблицаКодыСекторовЭкономикиЦБ = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_КодыСекторовЭкономики", Отказ);
	Если НЕ ТаблицаКодыСекторовЭкономикиЦБ.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("Из Матрикс не загружен перечень: %1 на %2",
				Справочники.ВидыПеречнейОбъектов.ЦБРФ_ПереченьОрганизацийФинансовогоСектора,
				Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy")),,,, Отказ);
	КонецЕсли;
	
	ТаблицаКонтроляКодовКлиента = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "ВТ_ИтоговаяТаблица", Отказ);
	Для Каждого СтрокаКонтроляКодовКлиента Из ТаблицаКонтроляКодовКлиента Цикл
		Если ПустаяСтрока(СтрокаКонтроляКодовКлиента.КодРегионаКлиента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента """ + СтрокаКонтроляКодовКлиента.СчетДоверительногоУправления + """ не указан код региона! См. закладку 'Расшифровка'",,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат ПакетДанных;
	КонецЕсли;
	
	ПризнакНулевогоОтчета = Истина;
	
	ЗаполнитьРазделыОтчетаПоВременнымТаблицам(ПакетДанных, Запрос, РазделыОтчетаXBRL(ИмяПакета), ПризнакНулевогоОтчета,, Отказ);	
	ДобавитьВПакетСведенияОбОтветственныхЛицах(ПакетДанных, ПризнакНулевогоОтчета, Отказ, ДополнительныеПакеты);
	
	Возврат ПакетДанных;

КонецФункции

Функция ОКУД0420416_ПолучитьТаблицуISIN()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	dbo_OKUD0420416_Isin_List.Isin КАК ISIN
		|ИЗ
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(dbo_OKUD0420416_Isin_List.Period) КАК Period
		|	ИЗ
		|		ВнешнийИсточникДанных.Externals.Таблица.dbo_OKUD0420416_Isin_List КАК dbo_OKUD0420416_Isin_List
		|	ГДЕ
		|		dbo_OKUD0420416_Isin_List.Period <= &ДатаОкончания) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.Externals.Таблица.dbo_OKUD0420416_Isin_List КАК dbo_OKUD0420416_Isin_List
		|		ПО ВложенныйЗапрос.Period = dbo_OKUD0420416_Isin_List.Period";
	
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
	
#КонецОбласти

// Отчет по внебиржевым сделкам
#Область ОКУД0420417

Функция ПолучитьДанные_ОКУД0420417(Запрос, Отказ) Экспорт
	
	ПакетДанных = Новый Структура;
	ПакетДанных.Вставить("ИмяОтчета"			, "ОКУД0420417_" + ВерсияАнкеты);
	ПакетДанных.Вставить("ИмяКорневогоЭлемента"	, "ОКУД0420417_" + ВерсияАнкеты + "_ОКУД0420417_" + ВерсияАнкеты);
	ПакетДанных.Вставить("ВерсияОтчета"			, СтрЗаменить(ВерсияАнкеты, "_", "."));
	ПакетДанных.Вставить("Отчет"				, Новый Структура);

	ПередФормированиемОтчетностиXBRL(Ложь);
	
	ПакетОтчетность = Новый Структура;
	ПакетОтчетность.Вставить("ДатаПредставления", Формат(ЭтотОбъект.ДатаОтчетности, "ДФ=yyyy-MM-dd"));

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОКУД0420417_ЗаполнитьПараметрыЗапроса(Запрос, Отказ, Истина);	
	
	Пакет = Запрос.ВыполнитьПакет();
	Данные = Пакет[Пакет.Количество() - 2].Выгрузить();
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Если Найти(СтрокаДанных.Кол9_ПлатежныеУсловия, "DVP") > 0 Тогда
			СтрокаДанных.Кол9_ПлатежныеУсловия = "DVP";
		ИначеЕсли СтрокаДанных.Кол9_ПлатежныеУсловия = "P" Тогда
			СтрокаДанных.Кол9_ПлатежныеУсловия = "P";
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.Кол9_ПлатежныеУсловия) Тогда
			СтрокаДанных.Кол9_ПлатежныеУсловия = "FREE";
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В сделке " + СтрокаДанных.Сделка + " не указаны платёжные условия!",,,, Отказ);
		КонецЕсли;	
	КонецЦикла;
		
	НумерацияСделок(Данные, ЭтотОбъект.Период.ДатаНачала);
	
	ДанныеБезНомераСделки = Данные.НайтиСтроки(Новый Структура("Кол2_НомерСделки", ПустаяСтрока));
	Если ДанныеБезНомераСделки.Количество() > 0 Тогда
		ДатаНачалаПредыдущегоПериода = ЭтотОбъект.Период.ДатаНачала;
		Для Каждого СтрокаДанных Из ДанныеБезНомераСделки Цикл
			ДатаНачалаПредыдущегоПериода = Мин(ДатаНачалаПредыдущегоПериода, НачалоМесяца(СтрокаДанных.Кол4_ДатаСделки));
		КонецЦикла;
		Если ВерсияТаксономии <= "1_3_1" Тогда
#Область СтарыйВариантНумерации
			Запрос.УстановитьПараметр("ДатаНачала"		, ДатаНачалаПредыдущегоПериода);
			Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаНачала);
			
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			
			Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
				Запрос.МенеджерВременныхТаблиц,
				Новый СтандартныйПериод(ДатаНачалаПредыдущегоПериода, ЭтотОбъект.Период.ДатаНачала),
				Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами),
				"СчетаДУДействующиеВПериоде"); 
			
			Пакет = Запрос.ВыполнитьПакет();
			ДанныеПредыдущегоПериода = Пакет[Пакет.Количество() - 2].Выгрузить();

			НумерацияСделок(ДанныеПредыдущегоПериода, ДатаНачалаПредыдущегоПериода, Истина);
			
			Для Каждого СтрокаДанных Из ДанныеБезНомераСделки Цикл
				ПараметрыПоиска = Новый Структура("Сделка,ЦеннаяБумага", СтрокаДанных.Сделка, СтрокаДанных.ЦеннаяБумага);
				НайденныеСтроки = ДанныеПредыдущегоПериода.НайтиСтроки(ПараметрыПоиска);
				
				Если НайденныеСтроки.Количество() = 1 Тогда 
					СтрокаДанных.Кол2_НомерСделки = НайденныеСтроки[0].Кол2_НомерСделки; 
					СтрокаДанных.Кол2_НомерСделки = СтрокаДанных.Кол2_НомерСделки + ?(СтрокаДанных.Кол8_ВидИнфСообщ = "NEW", "CHANGE", СтрокаДанных.Кол8_ВидИнфСообщ); 
				КонецЕсли;
			КонецЦикла;
#КонецОбласти
		Иначе
			// за каждый период выполним запрос. Номер будет в первом периоде, номер сообщения - количество упоминаний + 1
			Пока ДатаНачалаПредыдущегоПериода < ЭтотОбъект.Период.ДатаНачала Цикл
				Запрос.УстановитьПараметр("ДатаНачала"		, ДатаНачалаПредыдущегоПериода);
				Запрос.УстановитьПараметр("ДатаОкончания"	, КонецМесяца(ДатаНачалаПредыдущегоПериода));
				
				Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
				
				Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
					Запрос.МенеджерВременныхТаблиц,
					Новый СтандартныйПериод(ДатаНачалаПредыдущегоПериода, КонецМесяца(ДатаНачалаПредыдущегоПериода)),
					Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами),
					"СчетаДУДействующиеВПериоде"); 
				
				Пакет = Запрос.ВыполнитьПакет();
				ДанныеПредыдущегоПериода = Пакет[Пакет.Количество() - 2].Выгрузить();
				
				НумерацияСделок(ДанныеПредыдущегоПериода, ДатаНачалаПредыдущегоПериода, Истина);
				
				Для Каждого СтрокаДанных Из ДанныеБезНомераСделки Цикл
					ПараметрыПоиска = Новый Структура("Сделка,ЦеннаяБумага", СтрокаДанных.Сделка, СтрокаДанных.ЦеннаяБумага);
					НайденныеСтроки = ДанныеПредыдущегоПериода.НайтиСтроки(ПараметрыПоиска);
					
					Если НайденныеСтроки.Количество() > 0 Тогда 
						Если СтрокаДанных.Кол2_НомерСделки = ПустаяСтрока Тогда
							СтрокаДанных.Кол2_НомерСделки = НайденныеСтроки[НайденныеСтроки.ВГраница()].Кол2_НомерСделки + "002";
						Иначе
							НомерСообщения = Число(СтрЗаменить(Прав(СтрокаДанных.Кол2_НомерСделки, 3), "0", ""));
							СтрокаДанных.Кол2_НомерСделки = Сред(СтрокаДанных.Кол2_НомерСделки, 1, СтрДлина(СтрокаДанных.Кол2_НомерСделки) - 3) + Лев("00" + Строка(НомерСообщения + 1), 3);
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				ДатаНачалаПредыдущегоПериода = ДобавитьМесяц(ДатаНачалаПредыдущегоПериода, 1);
			
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеБезНомераСделки = Данные.НайтиСтроки(Новый Структура("Кол2_НомерСделки", ПустаяСтрока));
	Для Каждого СтрокаДанных Из ДанныеБезНомераСделки Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось установить номер сделки для " + СтрокаДанных.Сделка,,,, Отказ);
	КонецЦикла;
	
	ФорматныеСтроки = Новый Структура;
	ФорматныеСтроки.Вставить("Кол34_КоличествоПервЧасть"	, "ЧДЦ=5; ЧДЦ=0; ЧРД=.; ЧГ=0; ЧН=0");
	ФорматныеСтроки.Вставить("Кол40_ЦенаФинИнстрПервЧасть"	, "ЧДЦ=5; ЧРД=,; ЧГ=0; ЧН=0,00000");
	ФорматныеСтроки.Вставить("Кол41_СуммаСделкиПервЧасть"	, "ЧДЦ=5; ЧРД=,; ЧГ=0; ЧН=0,00000");
	ФорматныеСтроки.Вставить("Кол42_СуммаДоходаПервЧасть"	, "ЧДЦ=2; ЧРД=,; ЧГ=0; ЧН=0,00");
	ФорматныеСтроки.Вставить("Кол45_СтавкаПервЧасть"		, "ЧДЦ=2; ЧРД=,; ЧГ=0; ЧН=0,00");
	ФорматныеСтроки.Вставить("Кол50_КоличествоВторЧасть"	, "ЧДЦ=5; ЧДЦ=0; ЧРД=.; ЧГ=0; ЧН=0");
	ФорматныеСтроки.Вставить("Кол56_ЦенаФинИнстрВторЧасть"	, "ЧДЦ=5; ЧРД=,; ЧГ=0; ЧН=0,00000");
	ФорматныеСтроки.Вставить("Кол57_СуммаСделкиВторЧасть"	, "ЧДЦ=5; ЧРД=,; ЧГ=0; ЧН=0,00000");
	ФорматныеСтроки.Вставить("Кол58_СуммаДоходаВторЧасть"	, "ЧДЦ=2; ЧРД=,; ЧГ=0; ЧН=0,00");
	
	ПакетТаблица_ОтчетОВнебиржСделках = Новый Структура;
	
	ПакетТаблица_ОтчетОВнебиржСделках.Вставить("Row_131", ПолучитьФиксированнуюСтруктуру("Таблица_ОтчетОВнебиржСделках_Заголовки"));
	ПакетТаблица_ОтчетОВнебиржСделках.Вставить("Строка"	, СформироватьМассивСтрок(Данные, ФорматныеСтроки));
	
	ПакетОтчетность.Вставить("Таблица_ОтчетОВнебиржСделках", ПакетТаблица_ОтчетОВнебиржСделках);
	ПакетОтчетность.Вставить("СопроводительноеПисьмо", ПолучитьСопроводительноеПисьмо());
	
	ПакетДанных.Отчет.Вставить("Отчетность", ПакетОтчетность);
	
	Возврат ПакетДанных;
	
КонецФункции

Процедура НумерацияСделок(ТаблицаСделок, ДатаНачала, ДанныеПредыдущегоПериода = Ложь)
	
	Если ВерсияТаксономии <= "1_3_1" Тогда
		НумерацияСделок_1_3_1(ТаблицаСделок, ДатаНачала, ДанныеПредыдущегоПериода);
		Возврат;
	КонецЕсли;
	
	ТекущаяДатаСделки			= НачалоДня(ДатаНачала);
	ТекущийНомерСделки			= 0;
	
	Для Каждого СтрокаСделки Из ТаблицаСделок Цикл
		Если НачалоДня(СтрокаСделки.Кол4_ДатаСделки) < ТекущаяДатаСделки Тогда Продолжить; КонецЕсли; //это сделки по которым изменения или вторые части репо, они не участвуют в нумерации
		
		Если НачалоДня(СтрокаСделки.Кол4_ДатаСделки) > ТекущаяДатаСделки Тогда //новый день, нумерации сделок начинается заново
			ТекущийНомерСделки = 1;
			ТекущаяДатаСделки = НачалоДня(СтрокаСделки.Кол4_ДатаСделки);
		Иначе
			ТекущийНомерСделки = ТекущийНомерСделки + 1;
		КонецЕсли;
		
		Если ЭтотОбъект.ВерсияТаксономии >= "5_2" Тогда
			СтрокаСделки.Кол2_НомерСделки = Формат(СтрокаСделки.Кол4_ДатаСделки, "ДФ=dd.MM.yyyy") + 
											"-" + Прав("000000" + Строка(ТекущийНомерСделки), 7) + 
											"-" + Прав("0000" + Строка(СтрокаСделки.НомерСтрокиСделки), 5) + 
											"-" + СтрокаСделки.Кол7_КодНаправлСделки +  
											"-" + ?(ДанныеПредыдущегоПериода, "", ?(СтрокаСделки.Кол8_ВидИнфСообщ = "NEW", "001", "002"));
		Иначе
			СтрокаСделки.Кол2_НомерСделки = Формат(СтрокаСделки.Кол4_ДатаСделки, "ДФ=dd.MM.yyyy") + 
											"-" + Прав("000000" + Строка(ТекущийНомерСделки), 7) + 
											"-" + Прав("00" + Строка(СтрокаСделки.НомерСтрокиСделки), 3) + 
											"-" + СтрокаСделки.Кол7_КодНаправлСделки +  
											"-" + ?(ДанныеПредыдущегоПериода, "", ?(СтрокаСделки.Кол8_ВидИнфСообщ = "NEW", "001", "002"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура НумерацияСделок_1_3_1(ТаблицаСделок, ДатаНачала, ДанныеПредыдущегоПериода = Ложь)
	
	ТекущаяДатаСделки			= НачалоДня(ДатаНачала);
	ТекущийНомерСделки			= 0;
	
	Для Каждого СтрокаСделки Из ТаблицаСделок Цикл
		Если НачалоДня(СтрокаСделки.Кол4_ДатаСделки) < ТекущаяДатаСделки Тогда Продолжить; КонецЕсли; //это сделки по которым изменения или вторые части репо, они не участвуют в нумерации
		
		Если НачалоДня(СтрокаСделки.Кол4_ДатаСделки) > ТекущаяДатаСделки Тогда //новый день, нумерации сделок начинается заново
			ТекущийНомерСделки = 1;
			ТекущаяДатаСделки = НачалоДня(СтрокаСделки.Кол4_ДатаСделки);
		Иначе
			ТекущийНомерСделки = ТекущийНомерСделки + 1;
		КонецЕсли;
		
		СтрокаСделки.Кол2_НомерСделки = Формат(СтрокаСделки.Кол4_ДатаСделки, "ДФ=dd.MM.yyyy") + 
										"-" + Прав("0000" + Строка(ТекущийНомерСделки), 5) + 
										"-" + Прав("0000" + Строка(СтрокаСделки.НомерСтрокиСделки), 5) + 
										"-" + СтрокаСделки.Кол7_КодНаправлСделки +  
										"-" + ?(ДанныеПредыдущегоПериода, "", СтрокаСделки.Кол8_ВидИнфСообщ);
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПечатнуюФорму_ОКУД0420417(ПакетДанных, Результат, Отказ) Экспорт
	
	ПакетОтчет = ПакетДанных.Отчет;
	
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
	
	ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
	ОбластьПодвал						= Макет.ПолучитьОбласть("Подвал");
	
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ПакетОтчет.Отчетность.СопроводительноеПисьмо); 
	ОбластьШапка.Параметры.ДатаРегистрации_День		= Формат(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ДатаРегистрации, "ДФ=dd");
	ОбластьШапка.Параметры.ДатаРегистрации_Месяц	= НРег(Формат(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ДатаРегистрации, "ДФ=MMMM"));
	ОбластьШапка.Параметры.ДатаРегистрации_Год		= Формат(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ДатаРегистрации, "ДФ=yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	ВывестиРаздел("Таблица_ОтчетОВнебиржСделках", "", "Отчетность.Таблица_ОтчетОВнебиржСделках.Строка", ПакетОтчет, Макет, Результат);
	
	ОбластьПодвал.Параметры.ФИОИсполнителя =	Лев(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ИмяПодписанта, 1) + "." +
												Лев(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ОтчествоПодписанта, 1) + ". " +
												СокрЛП(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ПодписьЕдиноличногоИсполнительногоОргана.ФамилияПодписанта);
	
	ОбластьПодвал.Параметры.ФИОКонтролера	=	Лев(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ПодписьКонтролера.ИмяКонтролера, 1) + "." +
												Лев(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ПодписьКонтролера.ОтчествоКонтролера, 1) + ". " +
												СокрЛП(ПакетОтчет.Отчетность.СопроводительноеПисьмо.ПодписьКонтролера.ФамилияКонтролера);
	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура ОКУД0420417_ЗаполнитьПараметрыЗапроса(Запрос, Отказ, ТолькоВнебиржевойРынок = Истина)
	
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		Запрос.МенеджерВременныхТаблиц,
		ЭтотОбъект.Период,
		Новый Структура("Организация, ВидДеятельности", ЭтотОбъект.Организация, Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами),
		"СчетаДУДействующиеВПериоде"); 
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420417();
	
	Запрос.УстановитьПараметр("ДатаНачала"		, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяДата"		, ТекущаяДата());
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПустоеЗначение"	, "Неприменимо");
	Запрос.УстановитьПараметр("ПустаяСтрока"	, ПустаяСтрока);
	Запрос.УстановитьПараметр("ВерсияТаксономии", ЭтотОбъект.ВерсияТаксономии);
	Запрос.УстановитьПараметр("ВыгружатьСделкиПередаваемыеВРепозитарий"	, ПолучитьЗначениеНастройкиОтчета("ВыгружатьСделкиПередаваемыеВРепозитарий", Ложь, Отказ));	
	Запрос.УстановитьПараметр("СделкиСДатамиЗакрытияИсключения", ОКУД0420417_СделкиСДатамиЗакрытияИсключения());
	Запрос.УстановитьПараметр("ТолькоВнебиржевойРынок", ТолькоВнебиржевойРынок);
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса_ОКУД0420417()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиСДатамиЗакрытияИсключения.ДатаНачала КАК ДатаНачала,
		|	_СделкиСДатамиЗакрытияИсключения.Сделка КАК Сделка,
		|	_СделкиСДатамиЗакрытияИсключения.ЧастьСделки КАК ЧастьСделки,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЧастьСделки КАК ЗаменитьЧастьСделки,
		|	_СделкиСДатамиЗакрытияИсключения.ВидИнформационногоСообщения КАК ВидИнформационногоСообщения,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьВидИнформационногоСообщения КАК ЗаменитьВидИнформационногоСообщения,
		|	_СделкиСДатамиЗакрытияИсключения.КодСтроныНеИсполнившейОбязательства КАК КодСтроныНеИсполнившейОбязательства,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьКодСтроныНеИсполнившейОбязательства КАК ЗаменитьКодСтроныНеИсполнившейОбязательства,
		|	_СделкиСДатамиЗакрытияИсключения.ЗадолженностьПоДС КАК ЗадолженностьПоДС,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЗадолженностьПоДС КАК ЗаменитьЗадолженностьПоДС,
		|	_СделкиСДатамиЗакрытияИсключения.ДатаПоследнейОплаты КАК ДатаПоследнейОплаты,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьДатаПоследнейОплаты КАК ЗаменитьДатаПоследнейОплаты,
		|	_СделкиСДатамиЗакрытияИсключения.ЗадолженностьПоЦБ КАК ЗадолженностьПоЦБ,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЗадолженностьПоЦБ КАК ЗаменитьЗадолженностьПоЦБ,
		|	_СделкиСДатамиЗакрытияИсключения.ДатаПоследнейПоставки КАК ДатаПоследнейПоставки,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьДатаПоследнейПоставки КАК ЗаменитьДатаПоследнейПоставки,
		|	_СделкиСДатамиЗакрытияИсключения.ЦенаФинИнстрПервЧасть КАК ЦенаФинИнстрПервЧасть,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьЦенаФинИнстрПервЧасть КАК ЗаменитьЦенаФинИнстрПервЧасть,
		|	_СделкиСДатамиЗакрытияИсключения.СуммаСделкиПервЧасть КАК СуммаСделкиПервЧасть,
		|	_СделкиСДатамиЗакрытияИсключения.ЗаменитьСуммаСделкиПервЧасть КАК ЗаменитьСуммаСделкиПервЧасть
		|ПОМЕСТИТЬ _СделкиСДатамиЗакрытияИсключения
		|ИЗ
		|	&СделкиСДатамиЗакрытияИсключения КАК _СделкиСДатамиЗакрытияИсключения
		|ГДЕ
		|	_СделкиСДатамиЗакрытияИсключения.ДатаНачала = &ДатаНачала
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокСрезПоследних.Сделка КАК Сделка,
		|	УсловияСделокСрезПоследних.Период КАК ДатаУсловий,
		|	УсловияСделокСрезПоследних.Сделка.Дата КАК ДатаСделки,
		|	УсловияСделокСрезПоследних.ДатаПоставки КАК ПлановаяДатаПоставки,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ПлановаяДатаОплаты,
		|	УсловияСделокСрезПоследних.Отменено КАК Отменено,
		|	1 КАК ЧастьСделки
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	РегистрСведений.УсловияСделок.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И (&ТолькоВнебиржевойРынок = ЛОЖЬ
		|					ИЛИ Сделка.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))) КАК УсловияСделокСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаДУДействующиеВПериоде КАК СчетаДУДействующиеВПериоде
		|		ПО УсловияСделокСрезПоследних.СчетДоверительногоУправления = СчетаДУДействующиеВПериоде.Ссылка
		|			И (ВЫБОР
		|				КОГДА УсловияСделокСрезПоследних.Сделка.Дата >= &ДатаНачала
		|					ТОГДА НАЧАЛОПЕРИОДА(УсловияСделокСрезПоследних.Сделка.Дата, ДЕНЬ)
		|				КОГДА УсловияСделокСрезПоследних.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|					ТОГДА НАЧАЛОПЕРИОДА(УсловияСделокСрезПоследних.Период, ДЕНЬ)
		|				ИНАЧЕ &ДатаНачала
		|			КОНЕЦ = СчетаДУДействующиеВПериоде.Дата)
		|ГДЕ
		|	((УсловияСделокСрезПоследних.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|				ИЛИ УсловияСделокСрезПоследних.ДатаПоставки >= &ДатаНачала
		|				ИЛИ УсловияСделокСрезПоследних.ДатаОплаты >= &ДатаНачала)
		|				И (НЕ УсловияСделокСрезПоследних.Отменено
		|					ИЛИ УсловияСделокСрезПоследних.Сделка.Дата < &ДатаНачала
		|						И УсловияСделокСрезПоследних.Период >= &ДатаНачала
		|					ИЛИ &ВерсияТаксономии >= ""4_2"")
		|				И НЕ УсловияСделокСрезПоследних.Сделка.ВыкупЭмитентом
		|				И (&ВыгружатьСделкиПередаваемыеВРепозитарий = ИСТИНА
		|					ИЛИ НЕ УсловияСделокСрезПоследних.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Фьючерсы), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Опционы)))
		|			ИЛИ УсловияСделокСрезПоследних.Сделка В
		|				(ВЫБРАТЬ
		|					_СделкиСДатамиЗакрытияИсключения.Сделка
		|				ИЗ
		|					_СделкиСДатамиЗакрытияИсключения КАК _СделкиСДатамиЗакрытияИсключения))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УсловияСделокРЕПОПервойЧасти.СделкаРЕПО,
		|	УсловияСделокРЕПОПервойЧасти.Период,
		|	УсловияСделокРЕПОПервойЧасти.СделкаРЕПО.Дата,
		|	УсловияСделокРЕПОПервойЧасти.ДатаПоставки,
		|	УсловияСделокРЕПОПервойЧасти.ДатаОплаты,
		|	УсловияСделокРЕПОПервойЧасти.Отменено,
		|	1
		|ИЗ
		|	РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И ЧастьСделкиРЕПО = 2
		|				И (&ТолькоВнебиржевойРынок = ЛОЖЬ
		|					ИЛИ СделкаРЕПО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))) КАК УсловияСделокРЕПОВторойЧасти
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&ДатаОкончания,
		|				Организация = &Организация
		|					И ЧастьСделкиРЕПО = 1
		|					И (&ТолькоВнебиржевойРынок = ЛОЖЬ
		|						ИЛИ СделкаРЕПО.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))) КАК УсловияСделокРЕПОПервойЧасти
		|		ПО УсловияСделокРЕПОВторойЧасти.СделкаРЕПО = УсловияСделокРЕПОПервойЧасти.СделкаРЕПО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаДУДействующиеВПериоде КАК СчетаДУДействующиеВПериоде
		|		ПО (УсловияСделокРЕПОПервойЧасти.СчетДоверительногоУправления = СчетаДУДействующиеВПериоде.Ссылка)
		|			И (ВЫБОР
		|				КОГДА УсловияСделокРЕПОПервойЧасти.СделкаРЕПО.Дата >= &ДатаНачала
		|					ТОГДА НАЧАЛОПЕРИОДА(УсловияСделокРЕПОПервойЧасти.СделкаРЕПО.Дата, ДЕНЬ)
		|				КОГДА УсловияСделокРЕПОПервойЧасти.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|					ТОГДА НАЧАЛОПЕРИОДА(УсловияСделокРЕПОПервойЧасти.Период, ДЕНЬ)
		|				ИНАЧЕ &ДатаНачала
		|			КОНЕЦ = СчетаДУДействующиеВПериоде.Дата)
		|ГДЕ
		|	((НЕ УсловияСделокРЕПОПервойЧасти.Отменено
		|				ИЛИ УсловияСделокРЕПОПервойЧасти.СделкаРЕПО.Дата < &ДатаНачала
		|					И УсловияСделокРЕПОПервойЧасти.Период >= &ДатаНачала
