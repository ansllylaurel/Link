	КонтрольСтоимостиПая(Запрос, Отказ);
	
	ОКУД0420502_ПодменитьКодыСтрокДляСтаройВерсии(Запрос);
	
	Запрос.Текст = ПолучитьТекстЗапроса_ОКУД0420502();
	Запрос.Выполнить();
	
	ПакетДанных.Отчет.Вставить("Раздел1Реквизиты"			, ПолучитьДанные_ОКУД0420502_Раздел1Реквизиты(Запрос));
	ПакетДанных.Отчет.Вставить("Раздел2ПараметрыСправки"	, ПолучитьДанные_ОКУД0420502_Раздел2ПараметрыСправки(Запрос));
	
	Данные = ВыгрузитьВременнуюТаблицу(Запрос, "КодыСтрок_Финал");
	
	ПакетДанных.Отчет.Вставить("Раздел3Активы"				, ПолучитьДанные_ОКУД0420502_Раздел3Активы(Данные));
	ПакетДанных.Отчет.Вставить("Раздел4Обязательства"		, ПолучитьДанные_ОКУД0420502_Раздел4Обязательства(Данные));
	ПакетДанных.Отчет.Вставить("Раздел5СтоимЧистАктивов"	, ПолучитьДанные_ОКУД0420502_Раздел5СтоимЧистАктивов(Данные));
	
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяФонда1"	, ПолучитьДанные_ОКУД0420502_ПодписьРуководителяФонда1(Запрос));
