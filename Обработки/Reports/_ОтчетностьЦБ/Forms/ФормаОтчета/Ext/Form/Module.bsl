&НаКлиенте
Процедура ПроверитьСотрудника(ИмяРеквизита, Отказ)
	
	Если Элементы["Группа" + ИмяРеквизита].Видимость Тогда
		Если ЗначениеЗаполнено(Отчет[ИмяРеквизита]) Тогда
			РеквизитыСотрудника = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(Отчет.Организация, Отчет[ИмяРеквизита],, "Работает, НаходитсяНаРабочемМесте, Состояние");			
			Если РеквизитыСотрудника.Работает <> Истина Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Сотрудник %1 по состоянию на %2 не работает в компании", Отчет[ИмяРеквизита], Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy")),, ИмяРеквизита + "_Фамилия",, Отказ);
			ИначеЕсли РеквизитыСотрудника.НаходитсяНаРабочемМесте <> Истина И НЕ Отчет.ЭтоДК Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Сотрудник %1 по состоянию на %2 отсутствует на рабочем месте по причине: %3", Отчет[ИмяРеквизита], Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"), РеквизитыСотрудника.Состояние),, ИмяРеквизита + "_Фамилия",, Отказ);
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Поле ""%1"" не заполнено", ИмяРеквизита),, ИмяРеквизита + "_Фамилия",, Отказ);
			Если ИмяРеквизита = "Ответственный" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ответственных за операции могут назначать контролеры. Обратитесь к контролеру.");
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьВедетсяУчетДолжностыхЛиц(Организация)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",		 ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДолжностныеЛицаОрганизаций.Период КАК Период
		|ИЗ
		|	РегистрСведений.ДолжностныеЛицаОрганизаций КАК ДолжностныеЛицаОрганизаций
		|ГДЕ
		|	ДолжностныеЛицаОрганизаций.Организация = &Организация
		|	И ДолжностныеЛицаОрганизаций.Период <= &Период";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДолжностныеЛица(Организация, ВидДолжностногоЛица = Неопределено)
	
	ДолжностныеЛица = Новый Структура;
	
	Если ВидДолжностногоЛица = Неопределено ИЛИ ВидДолжностногоЛица = "Руководитель" Тогда
		РуководительДолжностноеЛицоИОснование = РегистрыСведений.ДолжностныеЛицаОрганизаций.ПолучитьДолжностноеЛицоИОснование(НачалоДня(ТекущаяДата()), Организация, Перечисления.ВидыДолжностныхЛиц.Руководитель);
		                                                        
		ДолжностныеЛица.Вставить("Руководитель",			     РуководительДолжностноеЛицоИОснование.ДолжностноеЛицо);
		ДолжностныеЛица.Вставить("Руководитель_Основание",	     РуководительДолжностноеЛицоИОснование.Основание);
		ДолжностныеЛица.Вставить("Руководитель_ОснованиеСсылка", РуководительДолжностноеЛицоИОснование.ОснованиеСсылка);
		ДолжностныеЛица.Вставить("Руководитель_НазначениеИО",    РуководительДолжностноеЛицоИОснование.НазначениеИО);
		
		// в случае, если должностное лицо является ИО руководителя, тогда дополнительно получим доверенность на подписание отчетности
		Если РуководительДолжностноеЛицоИОснование.НазначениеИО Тогда
			// Отключаем получение доверенности по задаче #557248
			// ДоверенностьНаПодписаниеОтчетности = ДействующаяДоверенностьНаПодписаниеОтчетности(ДолжностныеЛица.Руководитель, Организация);
			// ДолжностныеЛица.Вставить("Руководитель_Доверенность",       ДоверенностьНаПодписаниеОтчетности.Доверенность);
			// ДолжностныеЛица.Вставить("Руководитель_ДоверенностьСсылка", ДоверенностьНаПодписаниеОтчетности.ДоверенностьСсылка);
		КонецЕсли;	
		
	КонецЕсли;

	Если ВидДолжностногоЛица = Неопределено ИЛИ ВидДолжностногоЛица = "Контролер" Тогда
		КонтролерДолжностноеЛицоИОснование = РегистрыСведений.ДолжностныеЛицаОрганизаций.ПолучитьДолжностноеЛицоИОснование(НачалоДня(ТекущаяДата()), Организация, Перечисления.ВидыДолжностныхЛиц.Контролер);
		
		ДолжностныеЛица.Вставить("Контролер",			КонтролерДолжностноеЛицоИОснование.ДолжностноеЛицо);
		ДолжностныеЛица.Вставить("Контролер_Основание",	КонтролерДолжностноеЛицоИОснование.Основание);
	КонецЕсли;
	
	Возврат ДолжностныеЛица;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПоместитьДанныеФайловПриказаИДоверенностиВоВременноеХранилище(Форма, ДаннныеДолжностногоЛица)
	
	// получаем данные присоединенных файлов приказа о назначении ИО руководителя и доверенности на подписание отчетности
	Если ДаннныеДолжностногоЛица.Свойство("Руководитель_НазначениеИО") И ДаннныеДолжностногоЛица.Руководитель_НазначениеИО Тогда
		
		ПоместитьДанныеФайлаВоВременноеХранилище(Форма, "ФайлПриказа", ДаннныеДолжностногоЛица.Руководитель_ОснованиеСсылка, "pdf", "приказа о назначении ИО руководителя");
		
		Если ДаннныеДолжностногоЛица.Свойство("Руководитель_ДоверенностьСсылка") И ЗначениеЗаполнено(ДаннныеДолжностногоЛица.Руководитель_ДоверенностьСсылка) Тогда
			ПоместитьДанныеФайлаВоВременноеХранилище(Форма, "ФайлДоверенности", ДаннныеДолжностногоЛица.Руководитель_ДоверенностьСсылка, "pdf", "доверенности на подписание отчности");
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ПоместитьДанныеФайлаВоВременноеХранилище(Форма, ИдентификаторДанных, ВладелецФайлов, РасширениеФайла, ПредставлениеВладельца)
	
	ДвоичныеДанные = Неопределено;
	
	ДанныеФайлов = РаботаСФайловымХранилищем.ПолучитьСписокФайлов(ВладелецФайлов);
	
	Для Каждого ДанныеФайла Из ДанныеФайлов Цикл	
		
		Если НРег(ДанныеФайла.Расширение) = НРег(РасширениеФайла) И Не ДанныеФайла.ПометкаУдаления Тогда
			ДанныеПрисоединенногоФайла = РаботаСФайловымХранилищем.ПолучитьФайл(ДанныеФайла.ИдентификаторФайла);
			
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеПрисоединенногоФайла.Адрес);
			УдалитьИзВременногоХранилища(ДанныеПрисоединенногоФайла.Адрес);
		    Прервать;
		КонецЕсли; 
			
	КонецЦикла;
	
	Если Не ДвоичныеДанные = Неопределено Тогда
		ПоместитьДанныеВоВременноеХранилище(ИдентификаторДанных, ДвоичныеДанные, Форма)
	Иначе
		// чтобы при смене владельца файла не происходило выгрузки файла другого владельца (приказа, доверенности)
		УдалитьИдентификаторВременногоХранилища(ИдентификаторДанных, Форма);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ДействующаяДоверенностьНаПодписаниеОтчетности(ДолжностноеЛицо, Организация)
	
	ДанныеДоверенности = Новый Структура("Доверенность, ДоверенностьСсылка");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Поверенный",  ДолжностноеЛицо);
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	               |	ДоверенностиПоверенные.Ссылка КАК ДоверенностьСсылка,
	               |	ДоверенностиПоверенные.Ссылка.Номер КАК Номер,
	               |	ДоверенностиПоверенные.Ссылка.Дата КАК Дата
	               |ИЗ
	               |	Справочник.Доверенности.Поверенные КАК ДоверенностиПоверенные
	               |ГДЕ
	               |	ДоверенностиПоверенные.Ссылка.Организация = &Организация
	               |	И ДоверенностиПоверенные.Ссылка.ВидДоверенности = ЗНАЧЕНИЕ(Перечисление.ВидыДоверенностей.Исходящая)
	               |	И ДоверенностиПоверенные.Ссылка.ПодписаниеОтчетности
	               |	И ДоверенностиПоверенные.Поверенный = ВЫРАЗИТЬ(&Поверенный КАК Справочник.Сотрудники).ЮрФизЛицо
	               |	И ДоверенностиПоверенные.Ссылка.ДатаНачалаДействия <= &ТекущаяДата
	               |	И ДоверенностиПоверенные.Ссылка.ДатаОкончанияДействия >= &ТекущаяДата
	               |	И (ДоверенностиПоверенные.Ссылка.ДатаОтзыва > &ТекущаяДата
	               |			ИЛИ ДоверенностиПоверенные.Ссылка.ДатаОтзыва = ДАТАВРЕМЯ(1, 1, 1))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДоверенностиПоверенные.Ссылка.Дата УБЫВ,
	               |	ДоверенностиПоверенные.Ссылка.Номер УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеДоверенности, Выборка);		
		ДанныеДоверенности.Доверенность = СтрШаблон("№ %1 от %2", Выборка.Номер, Формат(Выборка.Дата, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Возврат ДанныеДоверенности;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВедетсяУчетОтветственных(Организация, ВариантОтчета)
	
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК") Тогда
		Возврат РегистрыСведений.ОтветственныеЗаОперации.Используется(Организация, ВариантОтчета, Неопределено, ТекущаяДата());
	Иначе
		Возврат Истина; //для всех остальных организаций ведение ответственных обязательно
	КонецЕсли;
	
КонецФункции

