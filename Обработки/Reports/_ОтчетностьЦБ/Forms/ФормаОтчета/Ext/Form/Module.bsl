	ОчиститьНеиспользуемыеРеквизиты();
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаРегистраИзExcel

&НаКлиенте
Функция ЗагрузитьРегистрыИзЭксель()
	
	Отказ = Ложь;
	
#Область Регистр

	Если ЗначениеЗаполнено(Отчет.ИмяФайлаРегистра) Тогда
		Попытка
			Excel = Новый COMОбъект("Excel.Application");
			Excel.WorkBooks.Open(Отчет.ИмяФайлаРегистра);
			Excel.Sheets(1).Select();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,, Отказ);
			Возврат НЕ Отказ;
		КонецПопытки;
		
		Если Отчет.Период.ДатаОкончания < Дата(2022,5,1) Тогда
			МассивЗаголовковФайла = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("1.1,1.2,1.3,1.4,2.1,2.2,2.3,2.4,2.5,3.1,3.2,3.3,4.1,4.2,4.3,4.4,4.5,4.6,5.1,5.2");
		Иначе
			МассивЗаголовковФайла = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("1.1,1.2,1.3,1.4,2.1,2.2,2.3,2.4,2.5,3.1,3.2,3.3,3.4,4.1,4.2,4.3,4.4,4.5,4.6,5.1,5.2,6.1,6.2,6.3,6.4,6.5,6.6");
		КонецЕсли;
			
		Для Индекс = 0 По МассивЗаголовковФайла.Количество() - 1 Цикл
			Если Строка(Excel.Cells(2, Индекс + 1).Value) <> МассивЗаголовковФайла[Индекс] Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Структура файла регистра не соответствует шаблону! В колонке " + Индекс + " должен быть индекс колонки " + МассивЗаголовковФайла[Индекс],,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
		Если Отказ Тогда 
			Excel.ActiveWorkbook.Close();
			Возврат НЕ Отказ;
		КонецЕсли;
		
		
		СписокБанков	= Новый Соответствие;
		РегистрПоБанкам = Новый Массив;  
		
		ВсегоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count;
		ВсегоКолонок = Excel.ActiveSheet.UsedRange.Columns.Count;
		
		МассивДанныхExcel = Excel.ActiveSheet.Range(Excel.Cells(3,1), Excel.ActiveSheet.Cells(ВсегоСтрок,ВсегоКолонок)).Value.Выгрузить(); 
		
		Для НомСтр = 0 По ВсегоСтрок - 3 Цикл
			
			Если ПустаяСтрока(Строка(МассивДанныхExcel[2][НомСтр])) Тогда Прервать;	КонецЕсли;
			
			КонтрольСтрокиРегистра(МассивДанныхExcel, НомСтр, Отказ);
			
			ДатаОперации = МассивДанныхExcel[4][НомСтр];
			Если ЗначениеЗаполнено(ДатаОперации) Тогда
				Если ТипЗнч(ДатаОперации) <> Тип("Дата") Тогда
					МассивЧастиДаты	= СтрРазделить(ДатаОперации, ".");
					ДатаОперации	= Дата(Прав("20" + МассивЧастиДаты[2], 4), МассивЧастиДаты[1], МассивЧастиДаты[0]);
				КонецЕсли;
					
				Если ДатаОперации < Отчет.Период.ДатаНачала ИЛИ ДатаОперации > Отчет.Период.ДатаОкончания Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле банка присутствует операция не попадающая в период отчёта! Строка: " + Строка(НомСтр + 3),,,, Отказ);
				КонецЕсли;

			КонецЕсли;
			
			ДанныеСтроки = Новый Структура;
			ДанныеСтроки.Вставить("РегистрНомер", ПробразоватьКФормату(МассивДанныхExcel[1][НомСтр], "Идентификатор"));
			
			Если СписокБанков.Получить(ДанныеСтроки.РегистрНомер) = Неопределено Тогда
				СписокБанков.Вставить(ДанныеСтроки.РегистрНомер, Строка(МассивДанныхExcel[0][НомСтр]));
			КонецЕсли;
			
			ДанныеСтроки.Вставить("НаименованиеБанка", СписокБанков.Получить(ДанныеСтроки.РегистрНомер));
			ДанныеСтроки.Вставить("НомерСчета"	, Строка(МассивДанныхExcel[2][НомСтр]));
			ДанныеСтроки.Вставить("ДатаОперации", ДатаОперации);
			
			ДанныеСтроки.Вставить("НомерДоговора"	, Строка(МассивДанныхExcel[19][НомСтр]));
			ДанныеСтроки.Вставить("ДатаДоговора"	, ПробразоватьКФормату(МассивДанныхExcel[20][НомСтр], "Дата"));
			
			ДанныеСтроки.Вставить("Валюта"			, Строка(МассивДанныхExcel[6][НомСтр]));
			ДанныеСтроки.Вставить("ОстатокНаНачало"	, ПробразоватьКФормату(МассивДанныхExcel[21][НомСтр], "Число"));
			ДанныеСтроки.Вставить("ОстатокНаКонец"	, ПробразоватьКФормату(МассивДанныхExcel[22][НомСтр], "Число"));
			
			ДанныеСтроки.Вставить(?(Строка(МассивДанныхExcel[5][НомСтр]) = "1", "Зачисление", "Списание"), ПробразоватьКФормату(МассивДанныхExcel[7][НомСтр], "Число"));
			
			ДанныеСтроки.Вставить("КодОперации"		, ПробразоватьКФормату(МассивДанныхExcel[8][НомСтр], "Идентификатор", 5));
			ДанныеСтроки.Вставить("СтрокаОперации"	, ОпределитьРазделБанк(Строка(МассивДанныхExcel[14][НомСтр]), (Строка(МассивДанныхExcel[13][НомСтр]) = "1")));
			ДанныеСтроки.Вставить("ОКСМ"			, Строка(МассивДанныхExcel[18][НомСтр]));
			
			ДанныеСтроки.Вставить("БанкКорреспондент"	, Строка(МассивДанныхExcel[9][НомСтр]));
			ДанныеСтроки.Вставить("SWIFT"				, Строка(МассивДанныхExcel[11][НомСтр]));
			ДанныеСтроки.Вставить("КодСтраныРегистрации", Строка(МассивДанныхExcel[12][НомСтр]));
			
			РегистрПоБанкам.Добавить(ДанныеСтроки);		
			
		КонецЦикла;
		
		Excel.ActiveWorkbook.Close();
		
		Если Отказ Тогда 
			Возврат НЕ Отказ;
		КонецЕсли;
		
		ПоместитьДанныеВоВременноеХранилище("РегистрПоБанкам", РегистрПоБанкам, ЭтаФорма);
		
	КонецЕсли;
#КонецОбласти
	
#Область Касса	
	Если ЗначениеЗаполнено(Отчет.ИмяФайлаКасса) Тогда
		Попытка
			Excel = Новый COMОбъект("Excel.Application");
			Excel.WorkBooks.Open(Отчет.ИмяФайлаКасса);
			Excel.Sheets(1).Select();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,, Отказ);
			Возврат НЕ Отказ;
		КонецПопытки;

		Если Отчет.Период.ДатаОкончания < Дата(2022,5,1) Тогда
			МассивЗаголовковФайла = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("1.1,1.2,1.3,1.4,2.1,2.2,2.3,2.4,2.5,2.6,3.1,3.2");
		Иначе
			МассивЗаголовковФайла = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок("1.1,1.2,1.3,1.4,2.1,2.2,2.3,2.4,2.5,2.6,3.1,3.2,3.3,3.4,3.5");
		КонецЕсли;	
			
		Для Индекс = 0 По МассивЗаголовковФайла.Количество() - 1 Цикл
			Если Строка(Excel.Cells(2, Индекс + 1).Value) <> МассивЗаголовковФайла[Индекс] Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Структура файла кассы не соответствует шаблону! В колонке " + Индекс + " должен быть индекс колонки " + МассивЗаголовковФайла[Индекс],,,, Отказ);
			КонецЕсли;
		КонецЦикла;
			
		Если Отказ Тогда 
			Excel.ActiveWorkbook.Close();
			Возврат НЕ Отказ;
		КонецЕсли;
		
		РегистрПоКассам = Новый Массив;
		
		ВсегоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count;
		ВсегоКолонок = Excel.ActiveSheet.UsedRange.Columns.Count;
		
		МассивДанныхExcel = Excel.ActiveSheet.Range(Excel.Cells(3,1), Excel.ActiveSheet.Cells(ВсегоСтрок,ВсегоКолонок)).Value.Выгрузить(); 
		
		Для НомСтр = 0 По ВсегоСтрок - 3 Цикл
			
			Если ПустаяСтрока(Строка(МассивДанныхExcel[2][НомСтр]))
				И ПустаяСтрока(Строка(МассивДанныхExcel[12][НомСтр])) Тогда Прервать;	КонецЕсли;
				
			ДатаОперации = МассивДанныхExcel[0][НомСтр];
			Если ЗначениеЗаполнено(ДатаОперации) Тогда
				Если ТипЗнч(ДатаОперации) <> Тип("Дата") Тогда
					МассивЧастиДаты	= СтрРазделить(ДатаОперации, ".");
					ДатаОперации	= Дата(Прав("20" + МассивЧастиДаты[2], 4), МассивЧастиДаты[1], МассивЧастиДаты[0]);
				КонецЕсли;
				
				Если ДатаОперации < Отчет.Период.ДатаНачала ИЛИ ДатаОперации > Отчет.Период.ДатаОкончания Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле касса присутствует операция не попадающая в период отчёта! Строка: " + Строка(НомСтр + 3),,,, Отказ);
				КонецЕсли;
			КонецЕсли;
				
			ДанныеСтроки = Новый Структура;
			ДанныеСтроки.Вставить("Валюта"			, "643");
			ДанныеСтроки.Вставить("ОстатокНаНачало"	, ПробразоватьКФормату(МассивДанныхExcel[12][НомСтр], "Число"));
			ДанныеСтроки.Вставить("ОстатокНаКонец"	, ПробразоватьКФормату(МассивДанныхExcel[13][НомСтр], "Число"));
			
			ДанныеСтроки.Вставить(?(Строка(МассивДанныхExcel[1][НомСтр]) = "1", "Зачисление", "Списание"), ПробразоватьКФормату(МассивДанныхExcel[2][НомСтр], "Число"));
			
			ДанныеСтроки.Вставить("КодОперации"			, ПробразоватьКФормату(МассивДанныхExcel[3][НомСтр], "Идентификатор", 5));
			ДанныеСтроки.Вставить("СтрокаОперации"		, ОпределитьРазделКасса(Строка(МассивДанныхExcel[5][НомСтр]), (Строка(МассивДанныхExcel[4][НомСтр]) = "1"), НомСтр));
			ДанныеСтроки.Вставить("ОКСМ"				, Строка(МассивДанныхExcel[9][НомСтр]));
			
			РегистрПоКассам.Добавить(ДанныеСтроки);		
			
		КонецЦикла;

		Excel.ActiveWorkbook.Close();
		
		Если Отказ Тогда 
			Возврат НЕ Отказ;
		КонецЕсли;
		
		ПоместитьДанныеВоВременноеХранилище("РегистрПоКассам", РегистрПоКассам, ЭтаФорма);		
		
	КонецЕсли;	
#КонецОбласти

	Возврат НЕ Отказ;
	
КонецФункции

&НаКлиенте
Процедура КонтрольСтрокиРегистра(МассивДанныхExcel, НомСтр, Отказ)
	
	Колонки = Новый Соответствие;
	Колонки.Вставить(0, "Наименование кредитной организации");
	Колонки.Вставить(1, "Рег.номер кредитной организации");
	Колонки.Вставить(6, "Код валюты счета");
	
	Если ЗначениеЗаполнено(МассивДанныхExcel[7][НомСтр]) И МассивДанныхExcel[25][НомСтр] <> "Ввод начальных остатков (объединение УК)" Тогда //сумма операции
		
		Колонки.Вставить(4, "Код направления платежа");
		Колонки.Вставить(5, "Дата операции");
		Колонки.Вставить(8, "Код вида операции");
		Колонки.Вставить(9, "Наименование банка-корреспондента");
		Колонки.Вставить(13, "Статус клиента");
		Колонки.Вставить(14, "Тип клиента");
		Колонки.Вставить(18, "Место государственной регистрации клиента");
		
	КонецЕсли;	
	
	Для Каждого Колонка Из Колонки Цикл
		Если НЕ ЗначениеЗаполнено(МассивДанныхExcel[Колонка.Ключ][НомСтр]) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(
					"В строке %1 файла регистра не заполнена колонка '%2', столбец Excel '%3'",
					Формат(НомСтр + 3, "ЧГ=0"),
					Колонка.Значение, Колонка.Ключ + 1),,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
#Область КонтрольКодаВалютнойОперации
	Если ЗначениеЗаполнено(МассивДанныхExcel[7][НомСтр]) Тогда //сумма операции
		КодОперации = Строка(МассивДанныхExcel[8][НомСтр]);
		
		Если ЗначениеЗаполнено(КодОперации) Тогда
			КодВалюты		 = Строка(МассивДанныхExcel[6][НомСтр]);
			ВалютнаяОперация = (СтрНайти(",01010,01030,01040,02010,02020,", "," + КодОперации + ",") > 0 ИЛИ (КодОперации >= "10000" И КодОперации <= "99999"));
			
			Если ВалютнаяОперация = Ложь И КодВалюты <> "643" Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтрШаблон(
						"В строке %1 файла регистра операции в валюте (%2) присвоен код невалютной операции (%3)",
						Формат(НомСтр + 3, "ЧГ=0"),
						КодВалюты,
						КодОперации),,,, Отказ);
			
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
#КонецОбласти
	
КонецПроцедуры	

&НаКлиенте
Функция ПробразоватьКФормату(Значение, Тип, ДлинаИдентификатора = 0)
	
	//Если ЗначениеЗаполнено(Ячейка.Value) Тогда
	//	Значение = Ячейка.Value;
	//ИначеЕсли ЗначениеЗаполнено(Ячейка.Text) Тогда
	//	Значение = Ячейка.Text;
	//Иначе	
	//	Значение = "";
	//КонецЕсли;
	
	Если Тип = "Число" Тогда
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Значение = 0;
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Иначе
			Значение = Строка(Значение);
			Значение = СтрЗаменить(Значение, " ", "");
			Значение = СтрЗаменить(Значение, Символ(160), "");
			Значение = Число(Значение);
		КонецЕсли;
	ИначеЕсли Тип = "Дата" Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Значение = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Лев(Значение, 10));
		Иначе
			Значение = Дата(1,1,1);
		КонецЕсли;
	ИначеЕсли Тип = "Идентификатор" Тогда
		Если НЕ ЗначениеЗаполнено(Значение) Тогда 
			Возврат Значение; 
		КонецЕсли;
		
		Значение = Строка(Значение);
		Значение = СтрЗаменить(Значение, " ", "");
		Значение = СтрЗаменить(Значение, Символ(160), "");
		
		Если ЗначениеЗаполнено(ДлинаИдентификатора) Тогда
			Значение = Прав("00000" + Значение, ДлинаИдентификатора);
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Функция ОпределитьРазделБанк(ТипЛица, Резидент)
	
	Раздел = "СтрокаНеустановленныеЛ";
	
	Если ТипЛица = "ЮЛ" И Резидент Тогда
		Раздел = "Строка_РезидентыЮЛ";
	ИначеЕсли ТипЛица = "ИП" И Резидент Тогда
		Раздел = "Строка_РезидентыИП";
	ИначеЕсли (ТипЛица = "ФЛ" ИЛИ ТипЛица = "ПФЛ") И Резидент Тогда
		Раздел = "Строка_РезидентыФЛ";
	ИначеЕсли ТипЛица = "ЮЛ" И НЕ Резидент Тогда
		Раздел = "Строка_НерезидентыЮЛ";
	ИначеЕсли ТипЛица = "ФЛ" И НЕ Резидент Тогда
		Раздел = "Строка_НерезидентыФЛ";
	КонецЕсли;
	
	Возврат Раздел;
	
КонецФункции

&НаКлиенте
Функция ОпределитьРазделКасса(ТипЛица, Резидент, НомСтр)
	
	Раздел = "";
	
	Если ТипЛица = "ЮЛ" И Резидент Тогда
		Раздел = "Строка_ОперСРезЮЛ";
	ИначеЕсли ТипЛица = "ИП" И Резидент Тогда
		Раздел = "Строка_ОперСРезИП2";
	ИначеЕсли (ТипЛица = "ФЛ" ИЛИ ТипЛица = "ПФЛ") И Резидент Тогда
		Раздел = "Строка_ОперСРезФЛРез2";
	ИначеЕсли ТипЛица = "ЮЛ" И НЕ Резидент Тогда
		Раздел = "Строка_ОперСРезЮЛНерез2";
	ИначеЕсли ТипЛица = "ФЛ" И НЕ Резидент Тогда
		Раздел = "Строка_ОперСРезФЛНерез2";
	ИначеЕсли ЗначениеЗаполнено(ТипЛица) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В отчете по кассе не допустимая комбинация статуса и типа клиента в строке " + НомСтр);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("	Статус клиента: " + Резидент);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("	Тип клиента: " + ТипЛица);
	КонецЕсли;
	
	Возврат Раздел;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаДанныхИзExcel

&НаКлиенте
Функция ЗагрузитьДанныеИзExcel(ИмяРеквизитаИмениФайла)
	
	Отказ = Ложь;

	Если ПустаяСтрока(Отчет[ИмяРеквизитаИмениФайла]) Тогда
		Возврат Отказ;
	КонецЕсли;	
	
	ОписаниеТаблиц = ПолучитьТаблицуИзМакета("ОписаниеЗагружаемыхExcelФайлов", Отчет.ВариантОтчета, Отказ, Новый Структура("ИмяРеквизитаИмениФайла", ИмяРеквизитаИмениФайла), "ИмяСтраницы,НомерКолонки", ЭтаФорма.ВнешняяОбработка);
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(Отчет[ИмяРеквизитаИмениФайла]);
		Excel.DisplayAlerts = 0;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),,,, Отказ);
		Возврат НЕ Отказ;
	КонецПопытки;
	
	СтраницыИТаблицы = Новый Соответствие;
	Для Каждого СтрокаОписанияТаблиц Из ОписаниеТаблиц Цикл
		Если СтраницыИТаблицы.Получить(СтрокаОписанияТаблиц.ИмяСтраницы) = Неопределено Тогда
			СтраницыИТаблицы.Вставить(СтрокаОписанияТаблиц.ИмяСтраницы, СтрокаОписанияТаблиц.ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;
	
#Область ПроверкаСтраниц
	ДанныеФайла = Новый Соответствие;
	
	Для Каждого СтраницаИТаблица Из СтраницыИТаблицы Цикл
		ИмяСтраницы = СтраницаИТаблица.Ключ;
		
		Попытка
			Лист = Excel.Sheets(ИмяСтраницы);
			ВсегоСтрок = Лист.UsedRange.Rows.Count;
			ВсегоКолонок = Лист.UsedRange.Columns.Count;
			ДанныеФайла.Вставить(ИмяСтраницы, Лист.Range(Лист.Cells(1,1), Лист.Cells(ВсегоСтрок, ВсегоКолонок)).Value.Выгрузить());
			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В файле (%1) не обнаружена страница '%2'", Отчет[ИмяРеквизитаИмениФайла], ИмяСтраницы),,,, Отказ);
		КонецПопытки;
	КонецЦикла;
	
	Excel.ActiveWorkbook.Close();
	
	Если Отказ Тогда
		Возврат НЕ Отказ;
	КонецЕсли;
#КонецОбласти

#Область ПроверкаЗаголовков

	ТаблицыИСтраницы = Новый Соответствие;
	Для Каждого СтрокаОписанияТаблиц Из ОписаниеТаблиц Цикл
		Если ТаблицыИСтраницы.Получить(СтрокаОписанияТаблиц.ИмяТаблицы) = Неопределено Тогда
			ТаблицыИСтраницы.Вставить(СтрокаОписанияТаблиц.ИмяТаблицы, СтрокаОписанияТаблиц.ИмяСтраницы);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТаблицаИСтраница Из ТаблицыИСтраницы Цикл
		ИмяСтраницы = ТаблицаИСтраница.Значение;
		ИмяТаблицы	=  ТаблицаИСтраница.Ключ;
		
		ДанныеСтраницы		 = ДанныеФайла.Получить(ИмяСтраницы);
		НомерСтрокиЗаголовка = 0;
		ОписаниеТаблицы		 = Новый Массив;
			
		Для Каждого СтрокаОписанияТаблиц Из ОписаниеТаблиц Цикл
			// Колонка добавлены в макет ради вывода в расшифровку. В файлах Excel её еще не было
			Если СтрокаОписанияТаблиц.ИмяКолонки = "IDAvtomatizSistemIPrilozhTaxis" Тогда
				
				Продолжить;
				
			КонецЕсли;	
			
			Если ИмяТаблицы = СтрокаОписанияТаблиц.ИмяТаблицы Тогда
				ОписаниеТаблицы.Добавить(СтрокаОписанияТаблиц);
				
				Если ДанныеСтраницы.Количество() < СтрокаОписанияТаблиц.НомерКолонки Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В файле (%1) на странице странице '%2' в колонке номер %3 не найден заголовок %4", Отчет[ИмяРеквизитаИмениФайла], ИмяСтраницы, СтрокаОписанияТаблиц.НомерКолонки, СтрокаОписанияТаблиц.Заголовок),,,, Отказ);
					
				Иначе
					ТекНомерСтрокиЗаголовка = 0;
					
					Для Индекс = 0 По ДанныеСтраницы[СтрокаОписанияТаблиц.НомерКолонки - 1].ВГраница() Цикл
						Если СокрЛП(ДанныеСтраницы[СтрокаОписанияТаблиц.НомерКолонки - 1][Индекс]) = СтрокаОписанияТаблиц.Заголовок Тогда
							ТекНомерСтрокиЗаголовка = Индекс + 1;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					НомерСтрокиЗаголовка = Макс(НомерСтрокиЗаголовка, ТекНомерСтрокиЗаголовка);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		МассивСтрок = Новый Массив;
		
		Если НомерСтрокиЗаголовка > 0 Тогда
			ВсегоСтрок = ДанныеСтраницы[0].Количество();
			
			Для Индекс = НомерСтрокиЗаголовка По ВсегоСтрок - 1 Цикл
				ЕстьЗначение = Ложь;
				ДанныеСтроки = Новый Структура;
				
				Для Каждого СтрокаОписанияТаблицы Из ОписаниеТаблицы Цикл
					Если СтрНачинаетсяС(СтрокаОписанияТаблицы.ТипЗначения, "Строка") Тогда
						Значение = СокрЛП(ДанныеСтраницы[СтрокаОписанияТаблицы.НомерКолонки - 1][Индекс]);
					ИначеЕсли СтрНачинаетсяС(СтрокаОписанияТаблицы.ТипЗначения, "Число") И ЗначениеЗаполнено(ДанныеСтраницы[СтрокаОписанияТаблицы.НомерКолонки - 1][Индекс]) Тогда
						Попытка
							Значение = Число(ДанныеСтраницы[СтрокаОписанияТаблицы.НомерКолонки - 1][Индекс]);
						Исключение
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
								СтрШаблон("В файле (%1) на странице странице '%2' в колонке номер %3 указано значение %4 отличное от числа.",
									Отчет[ИмяРеквизитаИмениФайла], 
									ИмяСтраницы,
									СтрокаОписанияТаблицы.НомерКолонки,
									ДанныеСтраницы[СтрокаОписанияТаблицы.НомерКолонки - 1][Индекс]),,,, Отказ);
						КонецПопытки;
					Иначе
						Значение = ДанныеСтраницы[СтрокаОписанияТаблицы.НомерКолонки - 1][Индекс];
					КонецЕсли;
					
					Если ПустаяСтрока(Значение) Тогда
						Если СтрНачинаетсяС(СтрокаОписанияТаблицы.ТипЗначения, "Строка") Тогда
							ДанныеСтроки.Вставить(СтрокаОписанияТаблицы.ИмяКолонки, "");
						ИначеЕсли СтрНачинаетсяС(СтрокаОписанияТаблицы.ТипЗначения, "Число") Тогда
							ДанныеСтроки.Вставить(СтрокаОписанияТаблицы.ИмяКолонки, 0);
						Иначе
							ДанныеСтроки.Вставить(СтрокаОписанияТаблицы.ИмяКолонки, Значение);
						КонецЕсли;
						
					ИначеЕсли СтрокаОписанияТаблицы.СоответствиеЗначение.Получить(Значение) <> Неопределено Тогда
						ДанныеСтроки.Вставить(СтрокаОписанияТаблицы.ИмяКолонки, СтрокаОписанияТаблицы.СоответствиеЗначение.Получить(Значение));
						
					ИначеЕсли СтрокаОписанияТаблицы.СоответствиеЗначение.Количество() = 0 Тогда
						Если СтрНачинаетсяС(СтрокаОписанияТаблицы.ТипЗначения, "Строка") Тогда
							ДанныеСтроки.Вставить(СтрокаОписанияТаблицы.ИмяКолонки, СтрЗаменить(Значение, Символы.НПП, ""));
						Иначе
							ДанныеСтроки.Вставить(СтрокаОписанияТаблицы.ИмяКолонки, Значение);
						КонецЕсли;
					Иначе
						ДопустимыеЗначения = Новый Массив;
						Для Каждого ДопустимоеЗначение Из СтрокаОписанияТаблицы.СоответствиеЗначение Цикл
							ДопустимыеЗначения.Добавить(ДопустимоеЗначение.Ключ);
						КонецЦикла;
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							СтрШаблон("В файле (%1) на странице странице '%2' в колонке номер %3 указано неизвестное значение %4.
								|Допустимые значения:
								|%5",
								Отчет[ИмяРеквизитаИмениФайла], 
								ИмяСтраницы,
								СтрокаОписанияТаблицы.НомерКолонки,
								Значение,
								СтрСоединить(ДопустимыеЗначения, Символы.ПС)),,,, Отказ);
					КонецЕсли;
					
					ЕстьЗначение = Макс(ЕстьЗначение, ЗначениеЗаполнено(ДанныеСтраницы[СтрокаОписанияТаблицы.НомерКолонки - 1][Индекс]));
				КонецЦикла;
				
				Если ЕстьЗначение Тогда
					МассивСтрок.Добавить(ДанныеСтроки);
				Иначе
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		ДанныеФайла.Вставить(ИмяТаблицы, МассивСтрок);
	
	КонецЦикла;

	Если Отказ Тогда
		Возврат НЕ Отказ;
	КонецЕсли;

#КонецОбласти

	Для Каждого ТаблицаИСтраница Из ТаблицыИСтраницы Цикл
		ПоместитьДанныеВоВременноеХранилище(ТаблицаИСтраница.Ключ, ДанныеФайла.Получить(ТаблицаИСтраница.Ключ), ЭтаФорма);		
	КонецЦикла;
	
	Возврат НЕ Отказ;

КонецФункции

#КонецОбласти

#Область ПолучениеДанныхИзВнешнихСистем

&НаКлиенте
Процедура ПолучитьДанныеИзВнешнихИсточников()
	
	Если Отчет.ВариантОтчета = "ОКУД0420409" Тогда
		ПолучитьДанныеДля409ФормыИз7РПИ();
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420011" Тогда
		Если НЕ ЗагрузитьРегистрыИзЭксель() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.ГруппаФайлExcel.Видимость Тогда
		Если НЕ ЗагрузитьДанныеИзExcel("ИмяФайлаExcel") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидимостьРеквизита("ИмяФайлаExcelПредыдущегоПериода", Элементы) Тогда
		Если НЕ ЗагрузитьДанныеИзExcel("ИмяФайлаExcelПредыдущегоПериода") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеИзВнешнихИсточниковНаСервере(Отказ)

	Если Отчет.ВариантОтчета = "ОКУД0420409" Тогда
		Если НЕ ПолучитьДанныеДля409ФормыИзБухгалтерии(Отказ) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
		
	Если (Отчет.ВариантОтчета = "ОКУД0420501" И Отчет.ПериодичностьОтчета = "Месячная")
	 ИЛИ Отчет.ВариантОтчета = "ОКУД0420011" Тогда
		ПолучитьВознагражденияУКИзБухгалтерии();
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "СООУРКИ028" Тогда
		ПолучитьСтоимостьСобственныхСредствИзБухгалтерии();
	КонецЕсли;
	
	
	Если Отчет.ВариантОтчета = "ОКУД0420414" Тогда
		Если ПроверитьНаличиеЗаймаВБухгалтерии(КонецДня(Отчет.Период.ДатаОкончания), Отчет.Организация) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДля409ФормыИзБухгалтерии(Отказ)
	
	СведенияОБухгалтерскихСчетах = Новый Массив;
	ШаблонСтруктуры = "Кол1_НомерСтроки, Кол2_СокрНаименование, Кол3_БИК, Кол3_ИдентНомер, Кол4_КодСтраны, Кол5_НомерСчета, Кол6_ВидСчета, Кол7_ВалютаСчета, Кол8_ЦельОткрытияСчета, Кол9_ДатаОткрытияСчета, Кол10_ОстатокНачало, Кол11_ОперацииЗачисление, Кол12_ОперацииСписание, Кол13_ОстатокНаКонец, Кол14_ДатаЗакрытияСчета, Кол15_ВозможностьИспользования, СрокДепозита, ВидСчета";
	
	Бухгалтерия = РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией(Отчет.Организация);
	Если Бухгалтерия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	МенеджерВременныхТаблиц = ОтчетОбъект.ОКУД0420409_ПолучитьДанныеБухгалтерии(Бухгалтерия);
	
	Если ОтчетОбъект.ПолучитьЗначениеНастройкиОтчета("КонтрольУтвержденногоОтчетаОКУД0420409ВБухгалтерии",, Отказ) = ИСТИНА Тогда
		Выборка = МенеджерВременныхТаблиц.Таблицы.Найти("_ПоследнийОтчетБухии").ПолучитьДанные().Выбрать();
		Если НЕ Выборка.Следующий() ИЛИ НЕ Выборка.Утвержден Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон(
					"В базе бухгалтерии отсутствует отчёт ОКУД0420409 со статусом 'утверждён' за %1. Формирование отчёта невозможно. Обратитесь в бухгалтерию.", 
					ПредставлениеПериода(Отчет.Период.ДатаНачала, Отчет.Период.ДатаОкончания)),,,, Отказ);
		Иначе
			
			ПараметрыКомандыКонтроля = Новый Структура;
			ПараметрыКомандыКонтроля.Вставить("ВариантОтчета",	"ОКУД0420409_СравнитьУчетИОтчетБухгалтерии");
			ПараметрыКомандыКонтроля.Вставить("Период", 		Отчет.Период);
			ПараметрыКомандыКонтроля.Вставить("Организация", 	Отчет.Организация);
			ПараметрыКомандыКонтроля.Вставить("Результат",		ЭтаФорма.Расхождения);
			ПараметрыКомандыКонтроля.Вставить("Отказ", 			Ложь);
			ПараметрыКомандыКонтроля.Вставить("МенеджерВременныхТаблиц", МенеджерВременныхТаблиц);
			ПараметрыКомандыКонтроля.Вставить("Бухгалтерия", 	Бухгалтерия);

			КонтрольОтчетностиЦБ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_КонтрольОтчетностиЦБ");
			КонтрольОтчетностиЦБ.ВыполнитьКонтроль(ПараметрыКомандыКонтроля);
			
			Если ПараметрыКомандыКонтроля.Отказ Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контроль 'Сравнение данных отчёта ОКУД0420409 в бухгалтерии с данным учёта бухгалтерии' не пройден. Подробности на закладке 'Расхождения'",,,, Отказ);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	

	// Оставлено для отладки
	//ДанныеДепозитов = Новый Массив;
	// КолонкиДепозитов = "Ссылка,ДатаРазмещения,ДатаПогашения,ДоВостребования,Дней,СуммаДепозита,ТипПроцентнойСтавки,ПроцентнаяСтавка,СпособНачисленияПроцентов,ТипСрочности,БанковскийСчет,СуммаНачальныйОстаток,СуммаОборотДт,СуммаОборотКт,СуммаКонечныйОстаток,ПолеСрок";
	//Выборка = МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ДанныеДепозитов").ПолучитьДанные().Выбрать();
	//Пока Выборка.Следующий() Цикл
	//	ДанныеСтроки = Новый Структура(КолонкиДепозитов);
	//	ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
	//	ДанныеДепозитов.Добавить(ДанныеСтроки);
	//КонецЦикла;
	
	Выборка = МенеджерВременныхТаблиц.Таблицы.Найти("_СведенияОБухгалтерскихСчетах").ПолучитьДанные().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСтроки = Новый Структура(ШаблонСтруктуры);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, Выборка);
		СведенияОБухгалтерскихСчетах.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	Бухгалтерия = "";

	ПоместитьДанныеВоВременноеХранилище("СведенияОБухгалтерскихСчетах", СведенияОБухгалтерскихСчетах, ЭтаФорма);
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьДанныеДля409ФормыИз7РПИ()

	Если НЕ Отчет.ЭтоРПИ ИЛИ Отчет.Период.ДатаОкончания > Дата(2023,1,1) Тогда	
		Возврат;
	КонецЕсли;
	
	База = Новый COMОбъект("v77s.Application");
	Открыта = База.Initialize(База.RMTrade, "/d\\g1\shares\1Cv7\PIFs\RPI\ /nРоботОЛЯ /p35498143", "NO_SPLASH_SHOW");;

	Если НЕ Открыта Тогда
		Сообщить("Ошибка открытия информационной базы 7.7");
		Возврат;
	КонецЕсли;
	
	Данные = Новый Массив;
	
	Ит = База.CreateObject("БухгалтерскиеИтоги");
	
	Ит.ИспользоватьПланСчетов(База.EvalExpr("ПланыСчетов.Основной"));
	Ит.ИспользоватьСубконто(База.EvalExpr("ВидыСубконто.БанковскиеСчета"));
	
	Ит.ВыполнитьЗапрос(Отчет.Период.ДатаНачала, Отчет.Период.ДатаОкончания, "51", Неопределено, Неопределено, 3);//
	
	Ит.ВыбратьСубконто(1);
	Пока Ит.ПолучитьСубконто(1) = 1 Цикл
		РС = Ит.Субконто(1);
		
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("НомерСчета"			, СокрЛП(РС.Номер));
		СтрокаДанных.Вставить("ОстатокНачало"		, Ит.СНД());
		СтрокаДанных.Вставить("ОперацииЗачисление"	, Ит.ДО());
		СтрокаДанных.Вставить("ОперацииСписание"	, Ит.КО());
		СтрокаДанных.Вставить("ОстатокНаКонец"		, Ит.СКД());
		
		Данные.Добавить(СтрокаДанных);

	КонецЦикла;
	
	База = "";

	ПоместитьДанныеВоВременноеХранилище("ДанныеОбОборотахИОстаткахВСемерке", Данные, ЭтаФорма);
	
КонецПроцедуры
	
&НаСервере
Процедура ПолучитьВознагражденияУКИзБухгалтерии()
	
	Отчет.ВознагражденияУК.Загрузить(РаботаСВнешнимиСистемами.ПолучитьДанныеБухгалтерииОВознагражденииУК("Удержанное", Отчет.Период.ДатаНачала, Отчет.Период.ДатаОкончания, Отчет.Организация));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаличиеЗаймаВБухгалтерии(Период, Организация)
	
	Бухгалтерия = РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией(Организация);
	Если Бухгалтерия = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Бухгалтерия.NewObject("Запрос");
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БНФОБанковскийОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.БНФОБанковский.Остатки(&ДатаОкончания, Счет.Код В (""48501"", "" 48503"", "" 48504"", "" 48505"", "" 48506"", "" 48507"", "" 48508"", ""48511"", ""48512"", 
		|																		""48601"", ""48603"", ""48604"", ""48605"", ""48606"", ""48607"", ""48608"", ""48611"", ""48612"", 
		|																		""48901"", ""48903"", ""48904"", ""48905"", ""48906"", ""48907"", ""48908"", ""48911"", ""48912"", 
		|																		""49001"", ""49003"", ""49004"", ""49005"", ""49006"", ""49007"", ""49008"", ""49011"", ""49012"", 
		|																		""49301"", ""49303"", ""49304"", ""49305"", ""49306"", ""49307"", ""49308"", ""49311"", ""49312""), 
		|																		, Организация = &Организация) КАК БНФОБанковскийОстатки
		|ГДЕ
		|	БНФОБанковскийОстатки.СуммаОстаток <> 0";
	
	
	Запрос.УстановитьПараметр("ДатаОкончания"		, Период); 
	Запрос.УстановитьПараметр("Организация"			, РаботаСВнешнимиСистемами.ПолучитьОрганизациюБухгалтерии(Бухгалтерия, Организация));
	
	ЕстьЗайм = НЕ Запрос.Выполнить().Пустой();
	
	Бухгалтерия = "";
	
	Если ЕстьЗайм Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В базе бухгалтерии есть займ. Формирование признака нулевого отчёта невозможно.");
	КонецЕсли;
	
	Возврат ЕстьЗайм;
	
КонецФункции

&НаСервере
Процедура ПолучитьСтоимостьСобственныхСредствИзБухгалтерии()
	
	Отчет.СтоимостьСобственныхСредствИзБухгалтерии = РаботаСВнешнимиСистемами.ПолучитьСтоимостьСобственныхСредствИзБухгалтерии(Отчет.Организация, Отчет.Период.ДатаОкончания);
	
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаВАнкету

&НаСервере
Процедура СформироватьПакетДанных(ИмяПакета, Запрос, Отказ)
	
	ПакетДанных = Новый Структура;
	ОтчетОбъект	= РеквизитФормыВЗначение("Отчет");
	
	Если ИмяПакета = "ОКУД0420417" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420417(Запрос, Отказ);
		Если Отчет.ВывестиПечатнуюФорму И НЕ Отказ Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420417(ПакетДанных, Результат, Отказ);
		КонецЕсли;
	ИначеЕсли ИмяПакета = "ОКУД0420415" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420415(Отказ);
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420415(ПакетДанных, Результат, Отказ);
		КонецЕсли;
		ОтчетОбъект.ЗаполнитьРасхожденияИННиОГРН_ОКУД0420415(Расхождения, Отказ);

	ИначеЕсли ИмяПакета = "ОКУД0420427" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420427(Отказ);
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420427(ПакетДанных, Результат, Отказ);
		КонецЕсли;
		ОтчетОбъект.ЗаполнитьРасшифровку_ОКУД0420427(Расшифровка, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420502" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420502(Отказ);
		
		
	ИначеЕсли ИмяПакета = "ОКУД0420501" Тогда
		Если ВидимостьРеквизита("ГруппаРасшифровка", Элементы) Тогда
			ОтчетОбъект.ЗаполнитьРасшифровку_ОКУД0420501(Расшифровка, Отказ);		
		КонецЕсли;
		
	ИначеЕсли ИмяПакета = "ОКУД0420503" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420503(Запрос, Отказ);
		
		Если Не Отчет.СформироватьНулевойОтчет Тогда
			ОтчетОбъект.ЗаполнитьРасшифровку_ОКУД0420503(Расшифровка, Запрос, Отказ);		
		КонецЕсли;
		
	ИначеЕсли ИмяПакета = "ОКУД0420506" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420506(Отказ);
		
		Если Отчет.ВывестиПечатнуюФорму И Не Отказ Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420506(ПакетДанных, Результат, Отказ);
		КонецЕсли;	
	ИначеЕсли ИмяПакета = "ОКУД0420507" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420507(Отказ);
		
		Если Отчет.ВывестиПечатнуюФорму И Не Отказ Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420507(ПакетДанных, Результат, Отказ);
		КонецЕсли;	
	ИначеЕсли ИмяПакета = "ОКУД0420511" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420511(Отказ);
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420511(ПакетДанных, Результат, Отказ);
		КонецЕсли;	
		// В таблице в одной из колонок должна быть структура, вставим ее здесь (чтобы печать корректно сработала)
		МассивСтрок = ПакетДанных.Отчет.ОтчетОСделках.Таблица_ОтчетОСделках.Таб_СведенияОСделкахСтроки_1;
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			Если ТекСтрока = "ЗаполнитьПустымиЗначениями" Тогда
				Продолжить;
			КонецЕсли;
			
			ВидСделки = НРег(ТекСтрока.Кол_ВидСделки);
			ТекСтрока.Кол_ВидСделки = Новый Структура("Код, Описание, Активно", ?(ВидСделки = "продажа", 1, 2), ВидСделки, Истина);	
		КонецЦикла;
	ИначеЕсли ИмяПакета = "СООУРКИ028" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_СООУРКИ028(Отказ);
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_СООУРКИ028(ПакетДанных, Результат, Отказ);
		КонецЕсли;
		ОтчетОбъект.ЗаполнитьРасшифровку_СООУРКИ028(ПакетДанных, Расшифровка, Отказ);	
	ИначеЕсли ИмяПакета = "ОКУД0420869" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420869(Отказ);	
	ИначеЕсли ИмяПакета = "ОКУД0420870" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_ОКУД0420870(Отказ);
	ИначеЕсли ИмяПакета = "УведомлениеОВыявленииНарушений" Тогда
		ПакетДанных 	= ОтчетОбъект.ПолучитьДанные_УРКИ_УведомлениеОВыявленииНарушений(Отказ);
	ИначеЕсли ИмяПакета = "УведомлениеОбУстраненииНарушений" Тогда
		ПакетДанных		= ОтчетОбъект.ПолучитьДанные_УРКИ_УведомлениеОбУстраненииНарушений(Отказ);
	КонецЕсли;
	
	Если ПакетДанных.Свойство("ИмяОтчета") Тогда
		МакетXSDСхемы	= ОтчетОбъект.ПолучитьМакет(ПакетДанных.ИмяОтчета + "_XSD");
	КонецЕсли;

	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьXML(Отказ)
	
	Если НЕ Отчет.ВыгружатьВXML ИЛИ Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
	МакетXSDСхемы.Записать(ИмяФайлаXSDСхемы);
	
	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаXSDСхемы);
	Исключение
		//Каталог временных файлов, он должен сам чиститься
	КонецПопытки;
	
	ИмяФайлаXML = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "xtdd");
	
	Если ПустаяСтрока(ИмяФайлаXML) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "UTF-8");
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("av:" + ПакетДанных.ИмяОтчета);

	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xserializer", "http://www.it.ru/Schemas/Avior/XSerializer"); 
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance"); 
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance"); 
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xs", "http://www.w3.org/2001/XMLSchema"); 

	URLПространстваИмен = "";
	
	Для Каждого ПакетовXDTO Из НоваяФабрикаXDTO.Пакеты Цикл
		Если ПакетовXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
			Продолжить;
		КонецЕсли;
		URLПространстваИмен = ПакетовXDTO.URIПространстваИмен;
	КонецЦикла;	
	
	ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("av", URLПространстваИмен);
	ЗаписьXML.ЗаписатьАтрибут("appVersion", ПакетДанных.ВерсияОтчета); 
	
	Для Каждого ЭлементыОтчета Из ПакетДанных.Отчет Цикл
		
		ТипОбъектаXDTO = НоваяФабрикаXDTO.Тип(URLПространстваИмен, ПакетДанных.ИмяКорневогоЭлемента).Свойства.Получить(ЭлементыОтчета.Ключ).Тип;
		
		НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, 
									ПреобразоватьЗначениеВXML(ЭлементыОтчета.Значение, ЭлементыОтчета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO), 
									ЭлементыОтчета.Ключ,, 
									ФормаXML.Элемент, НазначениеТипаXML.Неявное);
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайлаXML);
	
КонецПроцедуры

&НаКлиенте
Функция ПреобразоватьЗначениеВXML(ПакетДанных, ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO = "")
	
	ТипЗначения = ТипЗнч(ПакетДанных);
	
	Если ТипЗначения = Тип("Структура")  Тогда
		ОбъектXDTO		= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

		Для Каждого ЭлементПакета Из ПакетДанных Цикл
			Если ТипЗнч(ЭлементПакета.Значение) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из ЭлементПакета.Значение Цикл					
					ОбъектXDTO[ЭлементПакета.Ключ].Добавить(ПреобразоватьЗначениеВXML(ЭлементМассива, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип));
				КонецЦикла;
			Иначе
				ОбъектXDTO[ЭлементПакета.Ключ] = ПреобразоватьЗначениеВXML(ЭлементПакета.Значение, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ПакетДанных = "ЗаполнитьПустымиЗначениями" Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);
		Для Каждого Свойство Из ТипОбъектаXDTO.Свойства Цикл
			ОбъектXDTO[Свойство.Имя] = ПреобразоватьЗначениеВXML(Отчет.ПустоеЗначение, Свойство.Имя, НоваяФабрикаXDTO, Свойство.Тип);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТипОбъектаXDTO) = тип("ТипОбъектаXDTO") Тогда
		ОбъектXDTO = ПолучитьЗначениеПеречисления(ТипОбъектаXDTO, НоваяФабрикаXDTO, ИмяЭлемента, ПакетДанных);
	ИначеЕсли НЕ ЗначениеЗаполнено(ПакетДанных) И НЕ ПакетДанных = " " Тогда
		ОбъектXDTO = ПреобразоватьЗначениеВXML(Отчет.ПустоеЗначение, ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO);
	ИначеЕсли ТипОбъектаXDTO.Имя = "decimal" ИЛИ ТипОбъектаXDTO.Имя = "Double" Тогда
		Если ПакетДанных = Отчет.ПустоеЗначение Тогда
			ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, 0);	
		Иначе
			ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
		КонецЕсли;
	Иначе
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
	КонецЕсли;
	
	Возврат ОбъектXDTO;
	
КонецФункции	

&НаКлиенте
Функция ПолучитьЗначениеПеречисления(ТипОбъектаXDTO, НоваяФабрикаXDTO, ИмяЭлемента, Знач ЗначениеПеречисления)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПеречисления) Тогда 
		Возврат НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);
	КонецЕсли;
	
	НомСтр = 0;
	
	ЗначениеКлюча = ИмяЭлемента + "_" + СтрЗаменить(ЗначениеПеречисления, Отчет.ПустоеЗначение, "");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, " ", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, "(", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, ")", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, ".", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, ",", "_");
	ЗначениеКлюча = СтрЗаменить(ЗначениеКлюча, "-", "dash");
	
	Если ЗначениеКлюча = "Кол3_Таб4НаименСубъекта_Правительство_Москвы_в_лице_Департамента_финансов_г__Москвы" Тогда
		ЗначениеПеречисления = "Москва";
	КонецЕсли;
	
	Код = "0";
	
	Если НЕ мКэшЗначенийХМЛ.Свойство(ЗначениеКлюча, Код) Тогда
		
		мТекущаяСхема = Новый COMОбъект("Msxml2.DOMDocument");
		мТекущаяСхема.Load(ИмяФайлаXSDСхемы);
		
		Код = "0";

		Стр = "//xs:element[@name=""" + ИмяЭлемента + """]";
		Попытка
			УзелСхемы = мТекущаяСхема.SelectSingleNode(Стр);
		Исключение
			Сообщить(Стр);
			УзелСхемы = мТекущаяСхема.SelectSingleNode(Стр);
		КонецПопытки;
		Тип = УзелСхемы.GetAttribute("type");
		Если Найти(Тип, ":") > 0 Тогда
			Тип = Сред(Тип, Найти(Тип, ":") + 1);
		КонецЕсли;
		УзелТипа = мТекущаяСхема.SelectSingleNode("//xs:complexType[@name=""" + Тип + """]/xs:sequence/xs:element[@name=""Код""]");
		Тип = УзелТипа.GetAttribute("type");
		Если Найти(Тип, ":") > 0 Тогда
			Тип = Сред(Тип, Найти(Тип, ":") + 1);
		КонецЕсли;
		Стр = "//xs:simpleType[@name=""" + Тип + """]//xs:enumeration[xs:annotation/xs:documentation = """ + СокрЛП(ЗначениеПеречисления) + """]";
		Попытка
			УзелЗначения = мТекущаяСхема.SelectSingleNode(Стр);
		Исключение
			Сообщить(Стр);
			УзелЗначения = мТекущаяСхема.SelectSingleNode(Стр);
		КонецПопытки;
		
		Попытка
			Код = УзелЗначения.GetAttribute("value");
		Исключение
			ВызватьИсключение ОписаниеОшибки() + Символы.ПС + ИмяЭлемента + ": " + ЗначениеПеречисления;
		КонецПопытки;
		
		мКэшЗначенийХМЛ.Вставить(ЗначениеКлюча, Код);
		
	КонецЕсли;
	
	Если СокрЛП(Код) <> "0" ИЛИ СтрНачинаетсяС(ЗначениеКлюча, "Таб2Суборд") Тогда
		Возврат ПреобразоватьЗначениеВXML(Новый Структура("Код, Описание, Активно", Код, ЗначениеПеречисления, "true"), ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO);
	КонецЕсли;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерПравил(СчетДоверительногоУправления, Период)
	
	ПИФ = Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, Период);
	
	Если ТипЗнч(ПИФ) = Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
		Возврат СокрЛП(ПИФ.НомерПравил);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции	

&НаКлиенте
Процедура СформироватьТекстПисьма()
	
	ТекстПисьма = "";
	Если (Отчет.ВариантОтчета = "ОКУД0420506" 
		ИЛИ Отчет.ВариантОтчета = "ОКУД0420507" 
		ИЛИ Отчет.ВариантОтчета = "ОКУД0420511") И ЗначениеЗаполнено(Отчет.Клиент)
		ИЛИ Отчет.ВариантОтчета = "СООУРКИ028" Тогда
		НаименованиеОтчета = СокрЛП(СтрЗаменить(Элементы.ВариантОтчета.ТекстРедактирования, СокрЛП(Отчет.ВариантОтчета), ""));
		ТекстПисьма = "Направляем " + НаименованиеОтчета + " по состоянию на " + Формат(Отчет.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " " + ПолучитьПолноеНаименованиеКлиента(Отчет.Период.ДатаОкончания, Отчет.Клиент);	
		
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420502" Тогда
		ТекстПисьма = "Справка о стоимости чистых активов " + Отчет.СчетДоверительногоУправления + " (код формы по ОКУД 0420502) на " + Формат(Отчет.Период.ДатаОкончания, "ДФ='dd.MM.yy ''г.'''");
		
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420503" Тогда
		ТекстПисьма = "Отчет о приросте (об уменьшении) стоимости имущества  " + Отчет.СчетДоверительногоУправления + " (код формы по ОКУД 0420503) " + Формат(Отчет.Период.ДатаОкончания, "ДФ='MMMM.yy ''г.'''");
		
	КонецЕсли;
	
	Отчет.СодержаниеСопроводительногоПисьма = ТекстПисьма;
	
КонецПроцедуры // СформироватьТекстПисьма()

&НаКлиенте
Процедура ОбновитьНадписьНастройки()
	
	ТекстНадписи = "";
	// Показываем доп. сведения для тех отчетов, где используются доп. сведения о клиенте
	// в формах 401, 501 используются доп. сведения об организации (филиале), пока их не выводим
	Если Отчет.ВариантОтчета = "ОКУД0420507" Тогда
		ТекстНадписи = ПолучитьТекстНастроекКлиента(Отчет.Клиент);
	КонецЕсли;
	
	Элементы.ДекорацияНастройкиКлиента.Заголовок = ТекстНадписи;
	Элементы.ДекорацияНастройкиКлиента.Видимость = ЗначениеЗаполнено(ТекстНадписи);
	
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаXBRL

&НаКлиенте
Функция СформироватьXBRL(Отказ)
	
	Если НЕ Отчет.ВыгружатьВXBRL ИЛИ Отказ Тогда 
		Возврат Неопределено; 
	КонецЕсли;
	
	ЗагрузитьМакетXSDСхемыXBRL(Отчет.ВариантОтчета);
	
	ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
	МакетXSDСхемыXBRL.Записать(ИмяФайлаXSDСхемы);
	
	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	Попытка
		УдалитьФайлы(КаталогВременныхФайлов(), ИмяФайлаXSDСхемы);
	Исключение
		//Каталог временных файлов, он должен сам чиститься
	КонецПопытки;
	
	ИмяФайлаXML = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "xbrl");
	
	Если ПустаяСтрока(ИмяФайлаXML) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайлаXML, "windows-1251");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ТипОбъектаXDTO	= НоваяФабрикаXDTO.Тип("XBRL", "type_XBRL_Entry_Point");
	ОбъектXDTO		= ПреобразоватьЗначениеВXML_XBRL(ПакетДанныхXBRL, "", НоваяФабрикаXDTO, ТипОбъектаXDTO);
	
	ОбъектXDTO.ID		= ОбъектXDTO.ID;
	ОбъектXDTO.Taxonomy = ОбъектXDTO.Taxonomy;
	ОбъектXDTO.Entity	= РаботаСНормативноСправочнойИнформациейКлиент.ПолучитьРеквизитыГоловнойОрганизации(Отчет.Организация, Отчет.Период.ДатаОкончания, "ОГРН").ОГРН;
	
	НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO, "XBRL_Entry_Point");
	
	ЗаписьXML.Закрыть();
	
	ТекстовыйФайл = Новый ТекстовыйДокумент;
	ТекстовыйФайл.Прочитать(ИмяФайлаXML,"windows-1251");
	ТекстовыйФайл.ЗаменитьСтроку(2, СтрЗаменить(ТекстовыйФайл.ПолучитьСтроку(2), "xmlns=""XBRL"" ", ""));
	ТекстовыйФайл.Записать(ИмяФайлаXML,"windows-1251");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайлаXML);
	
	Возврат ИмяФайлаXML;
	
КонецФункции

&НаСервере
Процедура ПоместитьДанныеВМенеджерЗапросаНаСервере(Запрос)
	
	Если Отчет.ВариантОтчета = "ОКУД0420432" Или Отчет.ВариантОтчета = "ОКУД0420523" Тогда

		ПоместитьДанные432ФормыВМенеджерЗапросаНаСервере("ПоказателиОперационнойНадежностиТекущий", Запрос);
		ПоместитьДанные432ФормыВМенеджерЗапросаНаСервере("ПоказателиОперационнойНадежностиПредыдущий", Запрос);
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ПоместитьДанные432ФормыВМенеджерЗапросаНаСервере(ИмяРеквизитаДокумента, Запрос)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма[ИмяРеквизитаДокумента]) Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	ДатаОкончания  = ?(ИмяРеквизитаДокумента = "ПоказателиОперационнойНадежностиТекущий", 
		Отчет.Период.ДатаОкончания, КонецКвартала(ДобавитьМесяц(Отчет.Период.ДатаОкончания, -3)));
	ПрефиксТаблицы = ?(ИмяРеквизитаДокумента = "ПоказателиОперационнойНадежностиТекущий", "Curr", "Pre");
	
	Запрос2 = Новый Запрос;
	Запрос2.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос2.УстановитьПараметр("ПоказателиОперационнойНадежности", ЭтаФорма[ИмяРеквизитаДокумента]);
	Запрос2.УстановитьПараметр("ДатаОкончания",                    ДатаОкончания); 

	Запрос2.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоказателиИнформационныеСистемы.ИнформационнаяСистема КАК ИнформационнаяСистема
		|ПОМЕСТИТЬ _ИнформационныеСистемы
		|ИЗ
		|	Документ.ПоказателиОперационнойНадежности.ИнформационныеСистемы КАК ДокПоказателиИнформационныеСистемы
		|ГДЕ
		|	ДокПоказателиИнформационныеСистемы.Ссылка = &ПоказателиОперационнойНадежности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ДокПоказателиТехнологическиеУчастки.Значение КАК Значение
		|ПОМЕСТИТЬ _ТехнологическиеУчастки
		|ИЗ
		|	Документ.ПоказателиОперационнойНадежности.ИнформационныеСистемы КАК ДокПоказателиИнформационныеСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоказателиОперационнойНадежности.ТехнологическиеУчастки КАК ДокПоказателиТехнологическиеУчастки
		|		ПО ДокПоказателиИнформационныеСистемы.Ссылка = ДокПоказателиТехнологическиеУчастки.Ссылка
		|			И ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки = ДокПоказателиТехнологическиеУчастки.ИдентификаторСтроки
		|ГДЕ
		|	ДокПоказателиИнформационныеСистемы.Ссылка = &ПоказателиОперационнойНадежности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ДокПоказателиИсточникиДанных.Значение КАК Значение
		|ПОМЕСТИТЬ _ИсточникиДанных
		|ИЗ
		|	Документ.ПоказателиОперационнойНадежности.ИнформационныеСистемы КАК ДокПоказателиИнформационныеСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоказателиОперационнойНадежности.ИсточникиДанных КАК ДокПоказателиИсточникиДанных
		|		ПО ДокПоказателиИнформационныеСистемы.Ссылка = ДокПоказателиИсточникиДанных.Ссылка
		|			И ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки = ДокПоказателиИсточникиДанных.ИдентификаторСтроки
		|ГДЕ
		|	ДокПоказателиИнформационныеСистемы.Ссылка = &ПоказателиОперационнойНадежности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ДокПоказателиПолучателиДанных.Значение КАК Значение
		|ПОМЕСТИТЬ _ПолучателиДанных
		|ИЗ
		|	Документ.ПоказателиОперационнойНадежности.ИнформационныеСистемы КАК ДокПоказателиИнформационныеСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоказателиОперационнойНадежности.ПолучателиДанных КАК ДокПоказателиПолучателиДанных
		|		ПО ДокПоказателиИнформационныеСистемы.Ссылка = ДокПоказателиПолучателиДанных.Ссылка
		|			И ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки = ДокПоказателиПолучателиДанных.ИдентификаторСтроки
		|ГДЕ
		|	ДокПоказателиИнформационныеСистемы.Ссылка = &ПоказателиОперационнойНадежности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦентрыОбработкиДанных.ЦентрОбработкиДанных КАК ЦентрОбработкиДанных,
		|	ЦентрыОбработкиДанных.ЦентрОбработкиДанных.КодФункциональности КАК КодФункциональности,
		|	ЦентрыОбработкиДанных.ЦентрОбработкиДанных.КодКатегорииОблачныхРешений КАК КодКатегорииОблачныхРешений,
		|	ВЫРАЗИТЬ(ЦентрыОбработкиДанных.ЦентрОбработкиДанных.Адрес КАК СТРОКА(300)) КАК Адрес,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, """") КАК Наименование,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ИНН, """") КАК ИНН,
		|	"""" КАК TIN,
		|	ЦентрыОбработкиДанных.ЦентрОбработкиДанных.Сертификация КАК Сертификация,
		|	ЦентрыОбработкиДанных.ЦентрОбработкиДанных.НаличиеSLA КАК НаличиеSLA,
		|	ЦентрыОбработкиДанных.ЦентрОбработкиДанных.Надежность КАК Надежность
		|ПОМЕСТИТЬ _ЦентрыОбработкиДанных
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ИнформационныеСистемы.ИнформационнаяСистема.ЦентрОбработкиДанных КАК ЦентрОбработкиДанных
		|	ИЗ
		|		_ИнформационныеСистемы КАК _ИнформационныеСистемы) КАК ЦентрыОбработкиДанных
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ЦентрыОбработкиДанных.ЦентрОбработкиДанных.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоказателиИнформационныеСистемы.ТехнологическийПроцесс КАК ТехнологическийПроцесс,
		|	ДокПоказателиТехнологическиеУчастки.Значение КАК ТехнологическийУчасток,
		|	ДокПоказателиИнформационныеСистемы.ИнформационнаяСистема.ЦентрОбработкиДанных КАК ЦентрОбработкиДанных,
		|	""0000"" + ПОДСТРОКА(ДокПоказателиИнформационныеСистемы.ИнформационнаяСистема.Код, 5, 5) КАК Код,
		|	ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	ДокПоказателиИнформационныеСистемы.ПредставлениеИС КАК ПредставлениеИС
		|ИЗ
		|	Документ.ПоказателиОперационнойНадежности.ИнформационныеСистемы КАК ДокПоказателиИнформационныеСистемы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоказателиОперационнойНадежности.ТехнологическиеУчастки КАК ДокПоказателиТехнологическиеУчастки
		|		ПО ДокПоказателиИнформационныеСистемы.Ссылка = ДокПоказателиТехнологическиеУчастки.Ссылка
		|			И ДокПоказателиИнформационныеСистемы.ИдентификаторСтроки = ДокПоказателиТехнологическиеУчастки.ИдентификаторСтроки
		|ГДЕ
		|	ДокПоказателиИнформационныеСистемы.Ссылка = &ПоказателиОперационнойНадежности
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТехнологическийПроцесс,
		|	ТехнологическийУчасток,
		|	ЦентрОбработкиДанных,
		|	ДокПоказателиИнформационныеСистемы.ИнформационнаяСистема.Наименование";
	
	ИсходныеДанныеДляРаздела6 = Запрос2.Выполнить().Выгрузить();;
	
	ЦентрыОбработкиДанных = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос2, "_ЦентрыОбработкиДанных").Выгрузить();	

	ДанныеОсей = ИсходныеДанныеДляРаздела6.Скопировать(, "ТехнологическийПроцесс, ТехнологическийУчасток, ЦентрОбработкиДанных, ИдентификаторСтроки");
	Если Не Отчет.ЭтоРПИ Тогда
		ДанныеОсей.Свернуть("ТехнологическийПроцесс, ТехнологическийУчасток, ЦентрОбработкиДанных");
	КонецЕсли;	
	
	ДанныеДляРаздела6 = ДанныеОсей.СкопироватьКолонки("ТехнологическийПроцесс, ТехнологическийУчасток");  
	ДанныеДляРаздела6.Колонки.Добавить("ИдентификаторыАС", 
		Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(250, ДопустимаяДлина.Переменная)));

	Для Каждого КолонкаЦОД Из ЦентрыОбработкиДанных.Колонки Цикл
		
		ДанныеДляРаздела6.Колонки.Добавить(КолонкаЦОД.Имя, Новый ОписаниеТипов(КолонкаЦОД.ТипЗначения));	
		
	КонецЦикла;	
	
	ДанныеДляРаздела6.Колонки.Добавить("ИнформацияОбАС",   
		Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	Для Каждого СтрокаОсей Из ДанныеОсей Цикл
		
		ДанныеЦОД = ЦентрыОбработкиДанных.НайтиСтроки(Новый Структура("ЦентрОбработкиДанных", СтрокаОсей.ЦентрОбработкиДанных))[0];
		
		ИдентификаторыАС = Новый Массив;
		ИнформацияОбАС   = Новый Массив;
		
		Если Не Отчет.ЭтоРПИ Тогда
			Отбор = Новый Структура("ТехнологическийПроцесс, ТехнологическийУчасток, ЦентрОбработкиДанных");
		Иначе
			Отбор = Новый Структура("ТехнологическийПроцесс, ТехнологическийУчасток, ЦентрОбработкиДанных, ИдентификаторСтроки");
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаОсей);
		
		НайденныеСтрокиИС = ИсходныеДанныеДляРаздела6.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтрокиИС Цикл
			
			ИдентификаторыАС.Добавить(НайденнаяСтрока.Код);
           	ИнформацияОбАС.Добавить(НайденнаяСтрока.ПредставлениеИС);
			
		КонецЦикла;	
		
		НоваяСтрока = ДанныеДляРаздела6.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОсей, "ТехнологическийПроцесс, ТехнологическийУчасток"); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЦОД);
		НоваяСтрока.ИдентификаторыАС = СтрСоединить(ИдентификаторыАС, ";");
		НоваяСтрока.ИнформацияОбАС   = СтрСоединить(ИнформацияОбАС, "; ");
		
	КонецЦикла;	
	
	ДанныеДляРаздела5 = Новый ТаблицаЗначений;
	ДанныеДляРаздела5.Колонки.Добавить("KodTexnologicheskogoProczessaAxis", 
		Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(1000, ДопустимаяДлина.Переменная)));
	ДанныеДляРаздела5.Колонки.Добавить("KodTexnologicheskogoUchastkaAxis", 
		Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(1000, ДопустимаяДлина.Переменная)));
	ДанныеДляРаздела5.Колонки.Добавить("InformacziyaObAvtomatizirovannyxSistemaxIPrilozheniyax", 
		Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	
	
	Запрос.Текст = СтрЗаменить(ТекстЗапросаПоказателиОперационнойНадежностиОбщий(), "#Префикс", ПрефиксТаблицы);
	Запрос.УстановитьПараметр("ПоказателиОперационнойНадежности", ЭтаФорма[ИмяРеквизитаДокумента]);
	Запрос.УстановитьПараметр("ДатаОкончания",                    ДатаОкончания); 
	Запрос.УстановитьПараметр("ДанныеДляРаздела5", ДанныеДляРаздела5);
	Запрос.УстановитьПараметр("ДанныеДляРаздела6", ДанныеДляРаздела6);
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервере
Функция ПредставленияИС(Знач ИнформационныеСистемы, СвязанныеДанныеИС)
	
	ИнформационныеСистемы.Колонки.Добавить("ПредставлениеИС", Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	СвязанныеДанные = Новый Структура("ТехнологическиеУчастки, ИсточникиДанных, ПолучателиДанных"); 
	Для Каждого СтрокаИС Из ИнформационныеСистемы Цикл
		
		Для Каждого КлючИЗначение Из СвязанныеДанныеИС Цикл
			
			ДанныеДляПредставления = Новый Массив;
			Отбор = Новый Структура("ИдентификаторСтроки", СтрокаИС.ИдентификаторСтроки);
			Для Каждого СтрокаДанных Из СвязанныеДанныеИС[КлючИЗначение.Ключ].НайтиСтроки(Отбор) Цикл
			
				ДанныеДляПредставления.Добавить(СтрокаДанных.Значение);	
				
			КонецЦикла;
			Представление = СтрСоединить(ДанныеДляПредставления, "-");
			Если КлючИЗначение.Ключ <> "ТехнологическиеУчастки" Тогда
				
				СвязанныеДанные[КлючИЗначение.Ключ]	= ?(ПустаяСтрока(Представление), "Не применимо", Представление);
				
			Иначе
				
				СвязанныеДанные[КлючИЗначение.Ключ]	= Представление;
				
			КонецЕсли;	

		КонецЦикла;	
		СтрокаИС.ПредставлениеИС = ПредставлениеСтрокиИС(СтрокаИС, СвязанныеДанные);
		
	КонецЦикла;	
	Возврат ИнформационныеСистемы.Скопировать(, "ИдентификаторСтроки, ПредставлениеИС");
	
КонецФункции	

&НаСервере
Функция ПредставлениеСтрокиИС(СтрокаИС, СвязанныеДанные)

	ДанныеДляСвертки = Новый Массив;
	ДанныеДляСвертки.Добавить(СтрокаИС.ТехнологическийПроцесс);
	ДанныеДляСвертки.Добавить(СтрокаИС.Наименование);
	ДанныеДляСвертки.Добавить(СвязанныеДанные.ТехнологическиеУчастки);
	ДанныеДляСвертки.Добавить(СтрокаИС.БизнесФункция);
	ДанныеДляСвертки.Добавить(СтрокаИС.ФункциональноеЗначение);
	ДанныеДляСвертки.Добавить(СтрокаИС.РазработчикАС);
	ДанныеДляСвертки.Добавить(СтрокаИС.УровеньКритичности);
	ДанныеДляСвертки.Добавить(СвязанныеДанные.ИсточникиДанных);
	ДанныеДляСвертки.Добавить(СвязанныеДанные.ПолучателиДанных);
	ДанныеДляСвертки.Добавить(СтрокаИС.НаименованиеИТПродукта);
	ДанныеДляСвертки.Добавить(СтрокаИС.Принадлежность);
	ДанныеДляСвертки.Добавить(СтрокаИС.РазработчикИТПродукта);
	ДанныеДляСвертки.Добавить(СтрокаИС.КлассОборудования);
	ДанныеДляСвертки.Добавить(СтрокаИС.КлассПрограммногоОбеспечения);
	Возврат СтрСоединить(ДанныеДляСвертки, "|");
	
КонецФункции	

&НаСервере
Функция ТекстЗапросаПоказателиОперационнойНадежностиОбщий()

	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоказателиТехПроцессы.ТехнологическийПроцесс.ПредставлениеXBRL КАК KodTexnologicheskogoProczessaAxis,
		|	ДокПоказателиТехПроцессы.ПродолжительностьВремениРаботы КАК ProdolzhitVremRaboty_Funkczionir_TexnProczessa,
		|	ДокПоказателиТехПроцессы.СуммарноеВремяПростояДеградации КАК SumVremyaProstoyaIDegrTexPrObespDeyatNFO
		|ПОМЕСТИТЬ #Префикс_SR_NFO_2_R1_R2_1
		|ИЗ
		|	Документ.ПоказателиОперационнойНадежности.ТехнологическиеПроцессы КАК ДокПоказателиТехПроцессы
		|ГДЕ
		|	ДокПоказателиТехПроцессы.Ссылка = &ПоказателиОперационнойНадежности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
