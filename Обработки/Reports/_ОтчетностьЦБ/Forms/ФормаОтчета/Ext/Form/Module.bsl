КонецФункции

&НаКлиенте
Процедура ВидимостьРеквизитов()
	
	//видимость задаётся в макете ВидимостьРеквизитов
	КэшФункцийВидимости = Новый Соответствие;
	
	Если ЗначениеЗаполнено(Отчет.ВариантОтчета) Тогда
		Если НастройкиВидимостиРеквизитов.Свойство(Отчет.ВариантОтчета) Тогда
			Для Каждого НастройкаВидимости Из НастройкиВидимостиРеквизитов[Отчет.ВариантОтчета] Цикл
				Если ТипЗнч(НастройкаВидимости.Значение.Видимость) = Тип("Булево") Тогда
					Элементы[НастройкаВидимости.Ключ].Видимость = НастройкаВидимости.Значение.Видимость;
				ИначеЕсли СтрНачинаетсяС(НастройкаВидимости.Значение.Видимость, "#") Тогда
					Если КэшФункцийВидимости.Получить(НастройкаВидимости.Значение.Видимость) = Неопределено Тогда
						Элементы[НастройкаВидимости.Ключ].Видимость = ВычислитьВидимостьРеквизита(НастройкаВидимости.Значение.Видимость);
						КэшФункцийВидимости.Вставить(НастройкаВидимости.Значение.Видимость, Элементы[НастройкаВидимости.Ключ].Видимость); 
					Иначе
						Элементы[НастройкаВидимости.Ключ].Видимость = КэшФункцийВидимости.Получить(НастройкаВидимости.Значение.Видимость);
					КонецЕсли;
				Иначе
					Элементы[НастройкаВидимости.Ключ].Видимость = ЭтаФорма[НастройкаВидимости.Значение.Видимость];
				КонецЕсли;
				
				Если ЗначениеЗаполнено(НастройкаВидимости.Значение.Заголовок) Тогда
					Элементы[НастройкаВидимости.Ключ].Заголовок = НастройкаВидимости.Значение.Заголовок;
				Иначе
					Элементы[НастройкаВидимости.Ключ].Заголовок = ЗаголовкиПоУмолчанию[НастройкаВидимости.Ключ];
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого РеквизитБулево Из МассивРеквизитовБулево Цикл
		//Если реквизит булево и для варианта отчёта не используется установим значение ЛОЖЬ
		//реквизиты невыведенные на форму описаны в массиве исключений функции ПолучитьМассивРеквизитовБулево
		Если НЕ ВидимостьРеквизита(РеквизитБулево, Элементы) Тогда
			Отчет[РеквизитБулево] = Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Если НЕ ВидимостьРеквизита("ПолучательВыгрузкиXBRL", Элементы) Тогда
		Отчет.ТребуетсяПодтверждениеСпецДепа = Ложь;
	КонецЕсли;
	
	Для Каждого Страница Из Элементы.ГруппаПечатныеФормы.ПодчиненныеЭлементы Цикл
		Если Страница.Видимость Тогда
			Элементы.ГруппаПечатныеФормы.ТекущаяСтраница = Страница;	
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
#Область ОграничениеСвободПользователя
	ВсеВариантыФормирования		  = СтрРазделить("ВывестиПечатнуюФорму,ВыгружатьВXML,ВыгружатьВXBRL,ВыгружатьPDF", ",");
	ДоступныеВариантыФормирования = Новый Массив;
	
	Для Каждого ВариантФормирования Из ВсеВариантыФормирования Цикл
		Элементы[ВариантФормирования].Доступность = Истина; //Вернём то, что сделали недоступным
		Если ВидимостьРеквизита(ВариантФормирования, Элементы) Тогда
			ДоступныеВариантыФормирования.Добавить(ВариантФормирования);
		КонецЕсли;
	КонецЦикла;	
	
	Элементы.КаталогXBRL.Видимость   = Отчет.ВыгружатьВXBRL;
	Элементы.КаталогДанных.Видимость = Отчет.ВыгружатьВXML;
	Элементы.КаталогPDF.Видимость    = Отчет.ВыгружатьPDF;
	
#КонецОбласти	

	Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Очистить();
	Если Отчет.ВариантОтчета = "ОКУД0420869" Тогда
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ПоВсемСчетамДУ",			"По всем счетам ДУ");
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ОбщийОтчетПоВсемСчетамДУ","Общий отчет по всем счетам ДУ");
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ПоСчетуДУ",				"По одному счёту ДУ");
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420511" Тогда
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ОбщийОтчетПоВсемСчетамДУ","Общий отчет по всем счетам ДУ");
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ПоСчетуДУ",				"По одному счёту ДУ");
	Иначе
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ПоВсемСчетамДУ",			"По всем счетам ДУ");
		Элементы.ВариантФормированияПоСчетамДУ.СписокВыбора.Добавить("ПоСчетуДУ",				"По одному счёту ДУ");
	КонецЕсли;
	
	Элементы.СчетДоверительногоУправления.Доступность = (НЕ Элементы.ВариантФормированияПоСчетамДУ.Видимость ИЛИ Отчет.ВариантФормированияПоСчетамДУ = "ПоСчетуДУ");
	
#Область УчётДолжностыхЛиц
	Элементы.Руководитель.ТолькоПросмотр			= ЭтаФорма.ВедетсяУчетДолжностыхЛиц;
	Элементы.Руководитель_Основание.ТолькоПросмотр	= ЭтаФорма.ВедетсяУчетДолжностыхЛиц;
	Элементы.ОбновитьПолеРуководитель.Видимость		= ЭтаФорма.ВедетсяУчетДолжностыхЛиц;
	Элементы.Контролер.ТолькоПросмотр				= ЭтаФорма.ВедетсяУчетДолжностыхЛиц;
	Элементы.Контролер_Основание.ТолькоПросмотр		= ЭтаФорма.ВедетсяУчетДолжностыхЛиц;
	Элементы.ОбновитьПолеКонтролер.Видимость		= ЭтаФорма.ВедетсяУчетДолжностыхЛиц;
#КонецОбласти	

#Область УчётОтветственных
	Элементы.Ответственный.ТолькоПросмотр			= ЭтаФорма.ВедетсяУчетОтветственных;
	Элементы.ОбновитьПолеОтветственный.Видимость	= ЭтаФорма.ВедетсяУчетОтветственных;
#КонецОбласти

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНеиспользуемыеРеквизиты()
	
	НеиспользуемыеРеквизиты = Новый Структура;
	ИсключаемыеРеквизиты	= РеквизитыДолжностныхЛиц();
	
	Для Каждого ИмяРеквизита Из ПолучитьВсеСохраняемыеРеквизиты() Цикл
		Если НЕ СтрНачинаетсяС(ИмяРеквизита, "Каталог")
		   И ИсключаемыеРеквизиты.Найти(ИмяРеквизита) = Неопределено
		   И НЕ ВидимостьРеквизита(ИмяРеквизита, Элементы) Тогда
			НеиспользуемыеРеквизиты.Вставить(ИмяРеквизита, Неопределено);
		КонецЕсли;
	КонецЦикла;	
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма,	НеиспользуемыеРеквизиты);
	ЗаполнитьЗначенияСвойств(Отчет,		НеиспользуемыеРеквизиты);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьРеквизита(ИмяРеквизита, Элементы)
	
	Элемент = Элементы[ИмяРеквизита];
	Пока ТипЗнч(Элемент) = Тип("ГруппаФормы") 
	 ИЛИ ТипЗнч(Элемент) = Тип("ПолеФормы")
	 ИЛИ ТипЗнч(Элемент) = Тип("ТаблицаФормы")
	 ИЛИ ТипЗнч(Элемент) = Тип("ДекорацияФормы") Цикл
		Если НЕ Элемент.Видимость Тогда
			Возврат Ложь;
		КонецЕсли;
		Элемент = Элемент.Родитель;
	КонецЦикла;	
		
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Отчет[Элемент.Имя]; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Отчет[Элемент.Имя] = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлExcelНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Таблицы EXCEL (*.xls; *.xlsx)|*.xls;*.xlsx";
	
	ВыбранныйФайл = Новый Файл(Отчет[Элемент.Имя]);
	Если ВыбранныйФайл.Существует() Тогда
		Диалог.Каталог = ВыбранныйФайл.Путь;
	КонецЕсли;
	
	Диалог.ПолноеИмяФайла		= Отчет[Элемент.Имя];
	Диалог.МножественныйВыбор	= Ложь; 
	Диалог.Заголовок			= "Файл с регистром:"; 
	
	Если Диалог.Выбрать() Тогда 
		Отчет[Элемент.Имя] = Диалог.ПолноеИмяФайла;
		ИмяФайлаExcelПриИзменении(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлОткрытие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Отчет[Элемент.Имя]) Тогда
		СтандартнаяОбработка = Ложь;
		ЗапуститьПриложение(Отчет[Элемент.Имя]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФИОУполномоченногоСпецДепа()
	
	СписокДляВыбора = СписокКонтактныхЛицСпецДепозитария(Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация, 	
		?(Элементы.СчетДоверительногоУправления.Видимость, Отчет.СчетДоверительногоУправления,
			?(Элементы.Клиент.Видимость, Отчет.Клиент, Неопределено)));
																																
	Если СписокДляВыбора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УполномоченныйСпецДепаУжеЗаполнен = Ложь;
	
	Для Каждого ЭлементСписка Из СписокДляВыбора Цикл
		Если (ЭлементСписка.Значение.Фамилия = Отчет.УполномоченноеЛицоСпецДепа_Фамилия
			И ЭлементСписка.Значение.Имя = Отчет.УполномоченноеЛицоСпецДепа_Имя
			И ЭлементСписка.Значение.Отчество = Отчет.УполномоченноеЛицоСпецДепа_Отчество)
			ИЛИ (СтрНайти(ЭлементСписка.Значение.Фамилия, Отчет.УполномоченноеЛицоСпецДепа_Фамилия) > 0
					И СтрНайти(ЭлементСписка.Значение.Фамилия, Отчет.УполномоченноеЛицоСпецДепа_Имя) > 0
					И СтрНайти(ЭлементСписка.Значение.Фамилия, Отчет.УполномоченноеЛицоСпецДепа_Отчество) > 0) Тогда
			УполномоченныйСпецДепаУжеЗаполнен = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ УполномоченныйСпецДепаУжеЗаполнен Тогда
		ЗаполнитьФИО("УполномоченноеЛицоСпецДепа_Фамилия", СписокДляВыбора[0].Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РазложитьФИО(ЗначенияСвойств, ИмяЭлемента, Знач Фамилия, Знач Имя, Знач Отчество)

	ИмяЭлемента	= СтрЗаменить(ИмяЭлемента, "_Фамилия", "");
	
	Если ПустаяСтрока(Имя) И СтрНайти(Фамилия, " ") Тогда
		Если СтрЧислоВхождений(Фамилия, " ") < 2 Тогда
			Фамилия = СтрЗаменить(Фамилия, ".", " ");
		КонецЕсли;
		ФИО = СтрРазделить(Фамилия, " ");
		Фамилия = ФИО[0];
		Если ФИО.Количество() >= 2 Тогда
			Имя = ФИО[1];
			Если СтрДлина(Имя) = 1 Тогда
				Имя = Имя + ".";
			КонецЕсли;
		КонецЕсли;
		Если ФИО.Количество() >= 3 Тогда
			Отчество = ФИО[2];
			Если СтрДлина(Отчество) = 1 Тогда
				Отчество = Отчество + ".";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗначенияСвойств.Вставить(ИмяЭлемента + "_Фамилия"	, Фамилия);
	ЗначенияСвойств.Вставить(ИмяЭлемента + "_Имя"		, Имя);
	ЗначенияСвойств.Вставить(ИмяЭлемента + "_Отчество"	, Отчество);
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьФИО(ИмяЭлемента, КонтактноеЛицо)
	
	ЗначенияСвойств = Новый Структура;
	
	Если ТипЗнч(КонтактноеЛицо) = Тип("Структура") Тогда
		РазложитьФИО(ЗначенияСвойств, ИмяЭлемента, КонтактноеЛицо.Фамилия, КонтактноеЛицо.Имя, КонтактноеЛицо.Отчество);		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Отчет, ЗначенияСвойств);
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРеквизитыСотрудников(Форма, ТекущийЭлемент = Неопределено)
	
	Отчет		= Форма.Отчет;
	Элементы	= Форма.Элементы;
	
	Для Каждого ИмяЭлементаСотрудника Из ПолучитьИменаЭлементовСотрудников() Цикл
		Если (ТекущийЭлемент = Элементы[ИмяЭлементаСотрудника] ИЛИ ТекущийЭлемент = Неопределено)
		   И ВидимостьРеквизита(ИмяЭлементаСотрудника, Элементы) Тогда
		   
			РеквизитыСотрудника = РаботаССотрудниками.ПолучитьРеквизитыСотрудника(Отчет.Организация, Отчет[ИмяЭлементаСотрудника],, "Фамилия, Имя, Отчество, ДолжностьИПодразделение");
			
			Форма[ИмяЭлементаСотрудника + "_Фамилия"] 	= РеквизитыСотрудника.Фамилия;
			Форма[ИмяЭлементаСотрудника + "_Имя"]	  	= РеквизитыСотрудника.Имя;
			Форма[ИмяЭлементаСотрудника + "_Отчество"]  = РеквизитыСотрудника.Отчество;
			Форма[ИмяЭлементаСотрудника + "_Должность"] = РеквизитыСотрудника.ДолжностьИПодразделение;

		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИменаЭлементовСотрудников()
	
	ИменаЭлементовСотрудников = Новый Массив;
	ИменаЭлементовСотрудников.Добавить("Ответственный");
	ИменаЭлементовСотрудников.Добавить("Руководитель");
	ИменаЭлементовСотрудников.Добавить("Контролер");
	
	Возврат ИменаЭлементовСотрудников;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокКонтактныхЛицСпецДепозитария(ИмяПакета, ДатаОкончания, Организация, Объект = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ИмяПакета = "ОКУД0420512" 
		ИЛИ ИмяПакета = "ОКУД0420513" Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПРЕДСТАВЛЕНИЕССЫЛКИ(КонтактныеЛица.КонтактноеЛицо) КАК Представление,
			|	ЕСТЬNULL(РеквизитыФизическихЛицСрезПоследних.Фамилия, КонтактныеЛица.КонтактноеЛицо) КАК Фамилия,
			|	РеквизитыФизическихЛицСрезПоследних.Имя КАК Имя,
			|	РеквизитыФизическихЛицСрезПоследних.Отчество КАК Отчество,
			|	КонтактныеЛица.Должность КАК Должность,
			|	ПОДСТРОКА(КонтактныеЛица.ОснованиеПолномочий, 1, 50) КАК Основание
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
			|		ПО СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо = КонтактныеЛица.Объект
			|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
			|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|				&ДатаОкончания,
			|				Организация = &Организация
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
			|		ПО (КонтактныеЛица.КонтактноеЛицо = РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо)
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания)";
		
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПРЕДСТАВЛЕНИЕССЫЛКИ(КонтактныеЛица.КонтактноеЛицо) КАК Представление,
			|	ЕСТЬNULL(РеквизитыФизическихЛицСрезПоследних.Фамилия, КонтактныеЛица.КонтактноеЛицо) КАК Фамилия,
			|	РеквизитыФизическихЛицСрезПоследних.Имя КАК Имя,
			|	РеквизитыФизическихЛицСрезПоследних.Отчество КАК Отчество,
			|	КонтактныеЛица.Должность КАК Должность,
			|	ПОДСТРОКА(КонтактныеЛица.ОснованиеПолномочий, 1, 50) КАК Основание
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
			|		ПО СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо = КонтактныеЛица.Объект
			|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
			|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|				&ДатаОкончания,
			|				Организация = &Организация
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
			|		ПО (КонтактныеЛица.КонтактноеЛицо = РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо)
			|ГДЕ
			|	СчетаДоверительногоУправления.Ссылка = &СчетаДоверительногоУправления";
		
		Запрос.УстановитьПараметр("ДатаОкончания"					, ДатаОкончания);
		Запрос.УстановитьПараметр("СчетаДоверительногоУправления"	, Объект);
		
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ПРЕДСТАВЛЕНИЕССЫЛКИ(КонтактныеЛица.КонтактноеЛицо) КАК Представление,
			|	ЕСТЬNULL(РеквизитыФизическихЛицСрезПоследних.Фамилия, КонтактныеЛица.КонтактноеЛицо) КАК Фамилия,
			|	РеквизитыФизическихЛицСрезПоследних.Имя КАК Имя,
			|	РеквизитыФизическихЛицСрезПоследних.Отчество КАК Отчество,
			|	КонтактныеЛица.Должность КАК Должность,
			|	ПОДСТРОКА(КонтактныеЛица.ОснованиеПолномочий, 1, 50) КАК Основание
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
			|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо = КонтактныеЛица.Объект
			|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
			|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|				&ДатаОкончания,
			|				Организация = &Организация
			|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицСрезПоследних
			|		ПО (КонтактныеЛица.КонтактноеЛицо = РеквизитыФизическихЛицСрезПоследних.ЮрФизЛицо)
			|ГДЕ
			|	КлиентыДоверительногоУправленияСрезПоследних.Организация = &Организация
			|	И КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
			|	И КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
			|	И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания)";
		
		Запрос.УстановитьПараметр("ДатаОкончания"	, ДатаОкончания);
		Запрос.УстановитьПараметр("Клиент"			, Объект);
		
	КонецЕсли;

	СписокКонтактныхЛиц = Новый СписокЗначений;
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			РеквизитыКонтактногоЛица = Новый Структура("Фамилия,Имя,Отчество,Должность,Основание");
			ЗаполнитьЗначенияСвойств(РеквизитыКонтактногоЛица, Выборка);
			СписокКонтактныхЛиц.Добавить(РеквизитыКонтактногоЛица, Выборка.Представление);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокКонтактныхЛиц;
	
КонецФункции

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	
	СформироватьТекстПисьма();
	ОбновитьНадписьНастройки();
	
	Если ВидимостьРеквизита("УполномоченноеЛицоСпецДепа_Фамилия", Элементы) Тогда
		ЗаполнитьФИОУполномоченногоСпецДепа();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПолноеНаименованиеКлиента(НаДату, ЮрФизЛицо)
		
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСрезПоследних";
	
	Запрос.УстановитьПараметр("Период",       НаДату);
	Запрос.УстановитьПараметр("ЮрФизЛицо",    ЮрФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.ПолноеНаименованиеПоУставу);	
	КонецЕсли;

	Возврат "";
	
КонецФункции // ПолучитьПолноеНаименованиеКлиента()

&НаСервереБезКонтекста
Функция ПолучитьТекстНастроекКлиента(ЮрФизЛицо)
	
	Если Не ЗначениеЗаполнено(ЮрФизЛицо) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗначенияДополнительныхСведений.Свойство.Наименование КАК Наименование,
	|	ЗначенияДополнительныхСведений.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
	|ГДЕ
	|	ЗначенияДополнительныхСведений.Объект = &Объект";
	
	Запрос.УстановитьПараметр("Объект", ЮрФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = "";	
	Пока Выборка.Следующий() Цикл                                                            		
		Если Не ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + Выборка.Наименование + ": " + СокрЛП(Выборка.Значение) + ";";		
	КонецЦикла;
	
	Если Результат <> "" Тогда
		Результат = "Настройки клиента:" + Символы.ПС + Результат;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции	

&НаКлиенте
Процедура ДатаОтчетностиПриИзменении(Элемент)
	
	Если НЕ КонтрольКорректностиДат() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Элементы.Период.РежимВыбораИзСписка Тогда
		Если Элементы.ГруппаВыгружатьXBRL.Видимость Тогда
			УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
			Отчет.ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация);
			УстановитьДоступностьВыгружатьXBRL();
			ЗаполинтьСписокПериодичности(Отчет.ПериодичностьОтчета, Элементы.ПериодичностьОтчета.СписокВыбора, Отчет.ВариантОтчета, ТочкиВхода, Отчет.ДатаОтчетности, Отчет.СчетДоверительногоУправления, Отчет.Организация, Отчет.ВерсияТаксономии);
		КонецЕсли;
		
		УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВерсияТаксономииПриИзменении(Элемент)
	
	УстановитьДоступностьВыгружатьXBRL();
	ЗаполинтьСписокПериодичности(Отчет.ПериодичностьОтчета, Элементы.ПериодичностьОтчета.СписокВыбора, Отчет.ВариантОтчета, ТочкиВхода, Отчет.ДатаОтчетности, Отчет.СчетДоверительногоУправления, Отчет.Организация, Отчет.ВерсияТаксономии);
	//УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
	ВидимостьРеквизитов();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьВыгружатьXBRL()
	
	Элементы.ВыгружатьВXBRL.Доступность = ЗначениеЗаполнено(Отчет.ВерсияТаксономии);
	
	Если НЕ Элементы.ВыгружатьВXBRL.Доступность Тогда
		Отчет.ВыгружатьВXBRL = Ложь;
		Элементы.ВыгружатьВXBRL.Подсказка = "Не задана версия таксономии";

		ВыгружатьВXBRLПриИзменении(Неопределено);
	Иначе
		Элементы.ВыгружатьВXBRL.Подсказка = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолеРуководитель(Команда)
	
	ДолжностныеЛица = ПолучитьДолжностныеЛица(Отчет.Организация, "Руководитель");
	ЗаполнитьЗначенияСвойств(Отчет, ДолжностныеЛица);
	ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элементы.Руководитель);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ДолжностныеЛица);
	ОбновитьВидимостьДоверенностиИОРуководителя(ЭтаФорма);
	ПоместитьДанныеФайловПриказаИДоверенностиВоВременноеХранилище(ЭтаФорма, ДолжностныеЛица);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьДоверенностиИОРуководителя(Форма)
	
	// Отключаем видимость доверенности по задаче #557248
	Форма.Элементы.Руководитель_Доверенность.Видимость = Форма.Руководитель_НазначениеИО И Форма.ВедетсяУчетДолжностыхЛиц И Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолеКонтролер(Команда)
	
	ДолжностныеЛица = ПолучитьДолжностныеЛица(Отчет.Организация, "Контролер");
	ЗаполнитьЗначенияСвойств(Отчет, ДолжностныеЛица);
	ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элементы.Контролер);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолеОтветственный(Команда)
	
	Отчет.Ответственный = ПолучитьОтветственноеЛицо(Отчет.Организация, Отчет.ВариантОтчета);
	ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элементы.Ответственный);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНулевойОтчетПриИзменении(Элемент)
	
	ВидимостьРеквизитов();	
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	Отказ = Ложь;
	
	Если Не ПроверкаЗаполнения() Тогда
		ПоказатьПредупреждение(, "Отчёт не сформирован!");
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(Отчет.ВариантОтчета, "ОКУД04205") ИЛИ Отчет.ВариантОтчета = "ОКУД0420869" ИЛИ Отчет.ВариантОтчета = "ОКУД0420870" 
		ИЛИ Отчет.ВариантОтчета = "УведомлениеОбУстраненииНарушений" ИЛИ Отчет.ВариантОтчета = "УведомлениеОВыявленииНарушений" Тогда
		Отчет.ПустоеЗначение = "-";
	Иначе
		Отчет.ПустоеЗначение = "#";
	КонецЕсли;
	
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессию("ОбщееВремяВыполнения");
	
	ПолучитьДанныеИзВнешнихИсточников();
	
	Если Элементы.ВариантФормированияПоСчетамДУ.Видимость И Отчет.ВариантФормированияПоСчетамДУ= "ПоВсемСчетамДУ" Тогда
		
		СохрСчетДоверительногоУправления = Отчет.СчетДоверительногоУправления;
		
		МассивСчетовДУ = ПолучитьМассивСчетовДУДляОтчета(Отчет.ВариантОтчета, Отчет.Организация, Отчет.Период.ДатаНачала, Отчет.Период.ДатаОкончания, Отчет.ВерсияТаксономии);
		
		Для Каждого СчетДоверительногоУправления Из МассивСчетовДУ Цикл
			
			Отказ = Ложь;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формирование выгрузки по счету " + СчетДоверительногоУправления + "...");
			
			Отчет.СчетДоверительногоУправления = СчетДоверительногоУправления;
			
			СформироватьТекстПисьма();	
			
			СформироватьПакетыДанных(Отказ);
			СохранитьПечатныеФормыВPDF(Отказ);
			СохранитьДополнительныеВложения(Отказ);
			
			СформироватьXML(Отказ);
			
			Если Отчет.ВыгружатьВXBRL Тогда
				Если НЕ Элементы.ПолучательВыгрузкиXBRL.Видимость ИЛИ Отчет.ПолучательВыгрузкиXBRL = 0 ИЛИ Отчет.ПолучательВыгрузкиXBRL = 2 Тогда
					Отчет.ТребуетсяПодтверждениеСпецДепа = Ложь;
					СформироватьXBRL(Отказ);
				КонецЕсли;
				
				Если Элементы.ПолучательВыгрузкиXBRL.Видимость И (Отчет.ПолучательВыгрузкиXBRL = 1 ИЛИ Отчет.ПолучательВыгрузкиXBRL = 2) Тогда
					Отчет.ТребуетсяПодтверждениеСпецДепа = Истина;
					СформироватьXBRL(Отказ);
				КонецЕсли;
			КонецЕсли;
			
			СформироватьОтчеты(Отказ);
		
		КонецЦикла;
		
		Отчет.СчетДоверительногоУправления = СохрСчетДоверительногоУправления;
		СформироватьТекстПисьма();
		
	Иначе
		
		Если НЕ Элементы.ПолучательВыгрузкиXBRL.Видимость ИЛИ Отчет.ПолучательВыгрузкиXBRL = 0 ИЛИ Отчет.ПолучательВыгрузкиXBRL = 2 Тогда
			Отчет.ТребуетсяПодтверждениеСпецДепа = Ложь;
			СформироватьПакетыДанных(Отказ);
			ИмяФайлаXBRL = СформироватьXBRL(Отказ);
			ПроверитьДанныеФайла(ИмяФайлаXBRL, Отказ);
		КонецЕсли;
		
		СохранитьПечатныеФормыВPDF(Отказ);
		СохранитьДополнительныеВложения(Отказ);
		
		СформироватьXML(Отказ);
		
		Если Элементы.ПолучательВыгрузкиXBRL.Видимость И (Отчет.ПолучательВыгрузкиXBRL = 1 ИЛИ Отчет.ПолучательВыгрузкиXBRL = 2) Тогда
			Отчет.ТребуетсяПодтверждениеСпецДепа = Истина;
			СформироватьПакетыДанных(Отказ);
			СформироватьXBRL(Отказ);
		КонецЕсли;
	
		СформироватьОтчеты(Отказ);
		
		Если Отчет.ВыгружатьВXBRL И Не АвтосравнениеСПредыдущимПериодом.НайтиПоЗначению(Отчет.ВариантОтчета) = Неопределено Тогда
			// нельзя выполнять сравнение, если файл с отчетом не создан
			Если ЗначениеЗаполнено(ИмяФайлаXBRL) Тогда
				СравнитьТекущееФормированиеСОтчетомПредыдущегоПериода(ИмяФайлаXBRL);
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЕсли;
	
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Расшифровка);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Расшифровка1);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Расшифровка2);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Расшифровка3);
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Расхождения);
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДанныеФайла(ИмяФайла, Отказ)
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420409" Тогда
		
		ДвоичныеДанные	= Новый ДвоичныеДанные(ИмяФайла);
		АдресФайла		= ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
	
		ОКУД0420409_СверитьСДаннымиБанка(АдресФайла, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОКУД0420409_СверитьСДаннымиБанка(АдресФайла, Отказ)
	
	СверкаУспешна = РеквизитФормыВЗначение("Отчет").ОКУД0420409_СверитьСДаннымиБанка(АдресФайла, Расхождения, Отказ);
		
	Если Не СверкаУспешна Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не все данные отчета ОКУД0420409 удалось сверить с данными банка. Подробности на закладке 'Расхождения'");
		
		Элементы.ГруппаПечатныеФормы.ТекущаяСтраница = Элементы.ГруппаПечатныеФормы.ПодчиненныеЭлементы.ГруппаРасхождения;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивСчетовДУДляОтчета(ВариантОтчета, Организация, ДатаНачала, ДатаОкончания, ВерсияТаксономии)
	
	Если ВариантОтчета = "ОКУД0420502"
		ИЛИ ВариантОтчета = "ОКУД0420503"
			ИЛИ ВариантОтчета = "ОКУД0420505" Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
			|			И (КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ДатаОкончанияФормированияПИФ
			|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ДатаОкончанияФормированияПИФ.Объект)
			|			И (ДатаОкончанияФормированияПИФ.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ДатаОкончания, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
			|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд)
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И ЕСТЬNULL(ДатаОкончанияФормированияПИФ.Значение, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
			|	И ДатаОкончанияФормированияПИФ.Значение <= &ДатаОкончания
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала)
			|	И (&ТолькоПИФНеДляКвалов = ЛОЖЬ
			|			ИЛИ НЕ УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПредназначенДляКвалИнвесторов)";
		
		Запрос.УстановитьПараметр("Организация"		, Организация);
		Запрос.УстановитьПараметр("ДатаНачала"		, ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания"	, ДатаОкончания);
		
		Если ВариантОтчета = "ОКУД0420502"
			И ВерсияТаксономии >= "3_2"
			И КонецМесяца(ДатаОкончания) <> КонецКвартала(ДатаОкончания) Тогда
			Запрос.УстановитьПараметр("ТолькоПИФНеДляКвалов", Истина);
		Иначе
			Запрос.УстановитьПараметр("ТолькоПИФНеДляКвалов", Ложь);
		КонецЕсли;
		
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	ИначеЕсли  ВариантОтчета = "ОКУД0420869" тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправленияПортфели.Ссылка КАК СчетДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправленияПортфели
			|		ПО СчетаДоверительногоУправления.Ссылка = СчетаДоверительногоУправленияПортфели.Родитель
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
			|		ПО (СчетаДоверительногоУправленияПортфели.Ссылка = ЗначенияДополнительныхСведений.Объект)
			|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""СчетаДоверительногоУправления.КонтрольСтраховыхКомпаний.ВидПортфеляСтраховойКомпании"")
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыСчетовДоверительногоУправления.Договор)
			|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.КонтрольСтраховыхКомпаний)
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			|			ИЛИ &Период МЕЖДУ СчетаДоверительногоУправления.ДатаЗаключения И СчетаДоверительногоУправления.ДатаРасторжения)
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
			|	И (ЗначенияДополнительныхСведений.Значение ЕСТЬ NULL
			|			ИЛИ ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Перечисление.ВидыПортфелейСтраховыхКомпаний.ПортфельВДоверительномУправлении))";
		
		Запрос.УстановитьПараметр("Организация"		, Организация);
		Запрос.УстановитьПараметр("Период"		, ДатаОкончания);  		
	
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	КонецЕсли;	
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервере
Процедура КомандаПечатьРегистраНаСервере()
	
	Отказ = Ложь;
	
	ОтчетОбъект	= РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ОКУД0420011_ПолучитьРегистр(Результат, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПечатьРегистра(Команда)
	КомандаПечатьРегистраНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьПакетыДанных(Отказ)
	
	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессию("СерверноеВремяВыполнения");
	
	Результат.Очистить();
	Расшифровка.Очистить();
	Расшифровка1.Очистить();
	Расшифровка2.Очистить();
	Расшифровка3.Очистить();
	Расхождения.Очистить();
	РезультатPDF.Очистить();
	РасшифровкаPDF.Очистить();
	ПояснительнаяЗаписка.Очистить();
	
	ПолучитьДанныеИзВнешнихИсточниковНаСервере(Отказ);
	
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	//там формируется расшифровка
	СформироватьПакетДанных(Отчет.ВариантОтчета, Запрос, Отказ);
	СформироватьПакетДанных_XBRL(Отчет.ВариантОтчета, Запрос, Отказ);
	
	Если Не Отчет.СформироватьНулевойОтчет Тогда
		ЗаполнитьПечатнуюФорму(Отчет.ВариантОтчета, Запрос, Отказ);
	КонецЕсли;	
	ЗаполнитьПояснительнуюЗаписку(Отчет.ВариантОтчета, Запрос, Отказ);
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПечатнуюФорму(ИмяПакета, Запрос, Отказ)
	
	Если НЕ Отчет.ВывестиПечатнуюФорму И НЕ Отчет.ВыгружатьPDF Тогда
		Возврат;
	КонецЕсли;
		
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	Если ИмяПакета = "ОКУД0420502" Тогда
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			Если Отчет.ВерсияТаксономии < "4_2" Тогда
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Результат, 	ИмяПакета, Новый Структура("Основной"), Отказ);
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Расшифровка, ИмяПакета, Новый Структура("Расшифровка"), Отказ);
			ИначеЕсли Отчет.ВерсияТаксономии = "4_2" Тогда
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Результат, 	ИмяПакета + "_42", Новый Структура("Основной"), Отказ);
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Расшифровка, ИмяПакета + "_42", Новый Структура("Расшифровка"), Отказ);
			ИначеЕсли Отчет.Период.ДатаОкончания < Дата(2023, 5, 23) Тогда
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Результат, 	ИмяПакета + "_52_До23мая2023", Новый Структура("Основной"), Отказ);
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Расшифровка, ИмяПакета + "_52_До23мая2023", Новый Структура("Расшифровка"), Отказ);
			ИначеЕсли Отчет.Период.ДатаОкончания < Дата(2025, 1, 1) Тогда
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Результат, 	ИмяПакета + "_52", Новый Структура("Основной"), Отказ);
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Расшифровка, ИмяПакета + "_52", Новый Структура("Расшифровка"), Отказ);
			Иначе	
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Результат, 	ИмяПакета + "_61", Новый Структура("Основной"), Отказ);
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, Расшифровка, ИмяПакета + "_61", Новый Структура("Расшифровка"), Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если Отчет.ВыгружатьPDF ИЛИ Отчет.ВывестиПечатнуюФорму Тогда
			Если Отчет.ВерсияТаксономии < "3_2" Тогда
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, РезультатPDF, 	ИмяПакета + "PDF", Новый Структура("Основной"), Отказ);
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420502(Запрос, РасшифровкаPDF,	ИмяПакета + "PDF", Новый Структура("Расшифровка"), Отказ);
			ИначеЕсли Отчет.ВерсияТаксономии = "3_2" Тогда
