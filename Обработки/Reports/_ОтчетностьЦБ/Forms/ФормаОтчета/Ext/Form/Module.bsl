				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420503(Запрос, РезультатPDF, ИмяПакета + "PDF", Отказ);
			ИначеЕсли Отчет.ВерсияТаксономии = "4_2" Тогда
				ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420503(Запрос, РезультатPDF, ИмяПакета + "PDF_42", Отказ);
