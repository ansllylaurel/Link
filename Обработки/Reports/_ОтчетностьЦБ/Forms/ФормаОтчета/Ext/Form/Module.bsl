&НаСервере
Процедура СформироватьПакетДанных_XBRL(ИмяПакета, Запрос, Отказ)
	
	ПакетДанныхXBRL = Новый Структура;
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ДополнительныеСвойства = Новый Структура;
	ДополнительныеСвойства.Вставить("ТолькоПредметнаяОбласть", ВидимостьРеквизита("ТолькоПредметнаяОбласть", ЭтаФорма.Элементы));
	ДополнительныеСвойства.Вставить("ТолькоПредметнаяОбластьИПризнакНулевогоОтчета", ВидимостьРеквизита("ТолькоПредметнаяОбластьИПризнакНулевогоОтчета", ЭтаФорма.Элементы));
	
	// Для 432/523 формы данные берутся из документов ПоказателиОперационнойНадежности. Сразу приготовим запрос с нужными временными таблицами, вместо помещения массивов строк во временное хранилище
	ПоместитьДанныеВМенеджерЗапросаНаСервере(Запрос);	
	
	ПакетДанныхXBRL	= ОтчетОбъект.ПолучитьПакетДанныхXBRL(ИмяПакета, Запрос, ДополнительныеСвойства, Отказ);
	
	Если ИмяПакета = "ОКУД0420409" Тогда
		ОтчетОбъект.ОКУД0420409_XBRL_ЗаполнитьРасшифровкуДенегУБрокера(Запрос, Расшифровка, Отказ);
		Если Запрос.Параметры.ВключатьСредстваПоЛицензииУКПИФ = Ложь Тогда
			// С декабря 2025 исключаем средства у брокера и клиринговой организации по лицензии УК ПИФ
			// Расшифруем эти не вошедшие в отчет средства

			ОтчетОбъект.ОКУД0420409_XBRL_ЗаполнитьРасшифровкуПоСчетам(Запрос, Расшифровка1, Отказ, Истина);
			ОтчетОбъект.ОКУД0420409_XBRL_ЗаполнитьРасшифровкуДенегУБрокера(Запрос, Расшифровка2, Отказ, Истина);
			
		КонецЕсли;
		
	ИначеЕсли ИмяПакета = "ОКУД0420415" Тогда
		
		ОтчетОбъект.ОКУД0420459_ЗаполнитьРасшифровку(Запрос, Расшифровка3, Отказ);
		ОтчетОбъект.ОКУД0420437_ЗаполнитьРасшифровку(Запрос, Расшифровка2, Отказ);
		
		
	ИначеЕсли ИмяПакета = "ОКУД0420416" Тогда
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420416(Запрос, Результат, Расшифровка, Отказ);
		КонецЕсли;
		ОтчетОбъект.ОКУД0420459_ЗаполнитьРасшифровку(Запрос, Расшифровка3, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420417" Тогда
		ОтчетОбъект.ОКУД0420459_ЗаполнитьРасшифровку(Запрос, Расшифровка3, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420418" Тогда
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ОКУД0420418(Запрос, Результат, Отказ);
		КонецЕсли;
		
		ОтчетОбъект.ЗаполнитьРасшифровку_ОКУД0420418(Запрос, Расшифровка, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420431" Тогда
		ОтчетОбъект.ОКУД0420431_ЗаполнитьРасшифровку(Запрос, Расшифровка, Расшифровка1, Расшифровка2, Отказ);
		ОтчетОбъект.ОКУД0420459_ЗаполнитьРасшифровку(Запрос, Расшифровка3, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420512" Тогда
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ОКУД0420512_ЗаполнитьПечатнуюФорму(Запрос, ЭтаФорма.Результат, Отказ);
		КонецЕсли;
		
	ИначеЕсли ИмяПакета = "ОКУД0420513" Тогда
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ОКУД0420513_ЗаполнитьПечатнуюФорму(Запрос, ЭтаФорма.Результат, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	ПеречисленияXBRL	= ОтчетОбъект.ПолучитьПеречисленияXBRL(Отчет.ВерсияТаксономии);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМакетXSDСхемыXBRL(ИмяПакета)
	
	ИмяСхемы = ПолучитьИмяСхемыXBRL(ТочкиВхода, ИмяПакета, Отчет.Период.ДатаОкончания, Отчет.ПериодичностьОтчета, Отчет.Организация, Отчет.ТребуетсяПодтверждениеСпецДепа, Отчет.ВерсияТаксономии);
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	АрхивСхемТаксономии = ОтчетОбъект.ПолучитьАрхивСВерсиейТаксономии(Отчет.ВерсияТаксономии);	
	
	ЭлементАрхива = АрхивСхемТаксономии.Элементы.Найти(ИмяСхемы + ".xsd");
	
	Если ЭлементАрхива = Неопределено Тогда
		ВызватьИсключение "В архиве версии таксономии " + Отчет.ВерсияТаксономии + " нет схемы " + ИмяСхемы;
	КонецЕсли;
	
	КаталогСхемы = КаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор);
	
	АрхивСхемТаксономии.Извлечь(ЭлементАрхива, КаталогСхемы + "\");
	АрхивСхемТаксономии.Закрыть();

	МакетXSDСхемыXBRL	= Новый ДвоичныеДанные(КаталогСхемы + "\" + ИмяСхемы + ".xsd");
	
	Попытка
		УдалитьФайлы(КаталогСхемы);
	Исключение
		//Каталог временных файлов, он должен сам чиститься
	КонецПопытки;
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяСхемыXBRL(ТочкиВхода, ИмяПакета, ДатаОкончания, ПериодичностьОтчета, Организация, Спецдеп, ВерсияТаксономии)
	
	ИмяСхемыXBRL = "";
	
	ПараметрыПоиска = Новый Структура("ИмяПакета, Спецдеп, ВерсияТаксономии", ИмяПакета, Спецдеп, ВерсияТаксономии);
	НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 1 Тогда
		Для Каждого СтрокаТочкиВхода Из НайденныеСтроки Цикл
			Если ТипЗнч(СтрокаТочкиВхода.Малый) = Тип("Булево") Тогда
				ПараметрыПоиска.Вставить("Малый", ЭтоМалоеПредприятие(Организация, ДатаОкончания)); 
				НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПериодичностьТочкиВхода = "";
	Если  ПериодичностьОтчета = "Квартальная" И КонецКвартала(ДатаОкончания) = КонецГода(ДатаОкончания)
	 ИЛИ  ПериодичностьОтчета = "Месячная" И КонецМесяца(ДатаОкончания) = КонецГода(ДатаОкончания) Тогда
		ПериодичностьТочкиВхода = "КонецГода";
	ИначеЕсли ПериодичностьОтчета = "Месячная" И КонецМесяца(ДатаОкончания) = КонецКвартала(ДатаОкончания) Тогда
		ПериодичностьТочкиВхода = "Квартальная";
	Иначе	
		ПериодичностьТочкиВхода = ПериодичностьОтчета;
	КонецЕсли;
	
	Если НайденныеСтроки.Количество() = 1 Тогда
		ИмяСхемыXBRL = НайденныеСтроки[0][ПериодичностьТочкиВхода];
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ИмяСхемыXBRL) Тогда
		Возврат ИмяСхемыXBRL;
	Иначе
		ВызватьИсключение СтрШаблон("Не найдена точка входа '%1' для формы %2 на %3", ПериодичностьТочкиВхода, ИмяПакета, ДатаОкончания); 
	КонецЕсли;	
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьВерсиюТаксономии(ТочкиВхода, ИмяПакета, Знач ДатаОкончания, Организация, Спецдеп = Ложь)
	
	Если НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
		Возврат "";
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ИмяПакета, Спецдеп", ИмяПакета, Спецдеп);
	НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
	
	ВерсияТаксономии = "";
	
	Для Каждого СтрокаТочкиВхода Из НайденныеСтроки Цикл
		Если СтрокаТочкиВхода.Период <= ДатаОкончания Тогда
			Если ЗначениеЗаполнено(СтрокаТочкиВхода.ВерсияТаксономии) Тогда
				ВерсияТаксономии = СтрокаТочкиВхода.ВерсияТаксономии;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВерсияТаксономии;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоМалоеПредприятие(Организация, ДатаОкончания)
	
	Отказ = Ложь;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("Организация",Организация);
	ПараметрыРасчета.Вставить("Период",		Новый СтандартныйПериод(ДатаОкончания, ДатаОкончания));
	
	КатегорияПрофУчастника = РаботаСОтчетностьюЦБ.ОКУД0420401_ПолучитьКатегориюПрофУчастника(ПараметрыРасчета, Отказ);
	
	Если Не Отказ Тогда
		Возврат (КатегорияПрофУчастника = Перечисления.КатегорииПрофессиональныхУчастниковРынкаЦенныхБумаг.Малый);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПреобразоватьЗначениеВXML_XBRL(ПакетДанных, ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO = "")
	
	ТипЗначения = ТипЗнч(ПакетДанных);
	
	Если ТипЗначения = Тип("Структура")  Тогда
		ОбъектXDTO		= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

		Для Каждого ЭлементПакета Из ПакетДанных Цикл

			Если ТипЗнч(ЭлементПакета.Значение) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из ЭлементПакета.Значение Цикл					
					ОбъектXDTO[ЭлементПакета.Ключ].Добавить(ПреобразоватьЗначениеВXML_XBRL(ЭлементМассива, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип));
				КонецЦикла;
			ИначеЕсли НеобязательныеСекцииXBRL.НайтиПоЗначению(ЭлементПакета.Ключ) = Неопределено ИЛИ ОбъектXDTO.Свойства().Получить(ЭлементПакета.Ключ) <> Неопределено Тогда
				ОбъектXDTO[ЭлементПакета.Ключ] = ПреобразоватьЗначениеВXML_XBRL(ЭлементПакета.Значение, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли Лев(ТипОбъектаXDTO.Имя, 5) = "enum_" Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПолучитьПеречислениеXBRL(ТипОбъектаXDTO, ПакетДанных));
		
	ИначеЕсли ЭтоПримитивныйТип(ПакетДанных) Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
		
	Иначе
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, СериализаторXDTO.XMLСтрока(ПакетДанных));
		
	КонецЕсли;                                                 
	
	Возврат ОбъектXDTO;
	
КонецФункции	

&НаКлиенте
Функция ЭтоПримитивныйТип(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Неопределено")
		ИЛИ ТипЗначения = Тип("Null") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПеречислениеXBRL(ТипОбъектаXDTO, ЗНАЧ ЗначениеПеречисления)
	
	ТипыПеречисленийСтран = Новый Массив;
	ТипыПеречисленийСтран.Добавить("enum_KodGosstvaRegistracziiList_KodGosstvaRegistracziiList");
	ТипыПеречисленийСтран.Добавить("enum_OKSMList_RT_2");
	ТипыПеречисленийСтран.Добавить("enum_Kod_stranList_Kod_stranList");
	ТипыПеречисленийСтран.Добавить("enum_KodStranyList_KodStanyList");
	ТипыПеречисленийСтран.Добавить("enum_OKSMList_OKSMList");
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_StranyAxis") Тогда
		ТипыПеречисленийСтран.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	ТипыПеречисленийВалют = Новый Массив;
	ТипыПеречисленийВалют.Добавить("enum_KodValyutyList_KodValyutyList");
	ТипыПеречисленийВалют.Добавить("enum_ValyutaList_RT_3");
	ТипыПеречисленийВалют.Добавить("enum_Kod_valList_Kod_valList");
	ТипыПеречисленийВалют.Добавить("enum_ValyutaList_ValyutaList");
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_ValyutyAxis") Тогда
		ТипыПеречисленийВалют.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	ТипыПеречисленийКодовОпераций = Новый Массив;
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_Vid_Operaczii_DenSredstvaAxis_") Тогда
		ТипыПеречисленийКодовОпераций.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	ТипыПеречисленийКодовЦенныхБумаг = Новый Массив;
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZenBum_Vid_Fin_InstrList_RT_132");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_VidCZbList_VidCzbList");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZenBum_Vid_Fin_Instr2List_TipCZenBum_Vid_Fin_Instr2List");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZB_VidFI_Sved_o_vlozh_v_vypushhen_nerezList_TipCZB_VidFI_Sved_o_vlozh_v_vypushhen_nerezList");
	ТипыПеречисленийКодовЦенныхБумаг.Добавить("enum_TipCZenBumVidFIList_TipCZenBumVidFIList");
	
	ТипыПеречисленийКодовЭмитентов = Новый Массив;
	ТипыПеречисленийКодовЭмитентов.Добавить("enum_KodEmitlList_KodEmitList");
	ТипыПеречисленийКодовЭмитентов.Добавить("enum_Prinadl_k_Sektoru_EkonomList_Prinadl_k_Sektoru_EkonomList");
	
	КодыСрокаПогашенияЦеннойБумаги = Новый Массив;
	КодыСрокаПогашенияЦеннойБумаги.Добавить("enum_Srok_pogashen_CZBList_Srok_pogashen_CZBList");
	КодыСрокаПогашенияЦеннойБумаги.Добавить("enum_Srok_pogashen_CZBList_RT_19");
	
	ТипыПеречисленийКодовОКАТО = Новый Массив;
	ТипыПеречисленийКодовОКАТО.Добавить("enum_OKATOList_RT_1");
	ТипыПеречисленийКодовОКАТО.Добавить("enum_OKATOList_OKATOList");
	
	ТипыПеречисленийКодовОКАТОИСтран = Новый Массив;
	ТипыПеречисленийКодовОКАТОИСтран.Добавить("enum_OkatoOksmList_OkatoOksmList");
	
	Если СтрНачинаетсяС(ТипОбъектаXDTO.Имя, "enum_Kod_OKATO_KodOKSMAxis") Тогда
		ТипыПеречисленийКодовОКАТОИСтран.Добавить(ТипОбъектаXDTO.Имя);
	КонецЕсли;	
	
	
	Если СтрНачинаетсяС(ЗначениеПеречисления, "Itogo") Тогда
		//ничего не происходит =)
	ИначеЕсли ТипыПеречисленийСтран.Найти(ТипОбъектаXDTO.Имя) <> Неопределено И ЗначениеПеречисления <> "999" Тогда
		ЗначениеПеречисления = "Strana_" + ЗначениеПеречисления;
	ИначеЕсли ТипыПеречисленийВалют.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
		ЗначениеПеречисления = "Valyuta_" + ЗначениеПеречисления;
	ИначеЕсли ТипыПеречисленийКодовОКАТО.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
		ЗначениеПеречисления = "OKATO" + ЗначениеПеречисления;
	КонецЕсли;
	
	Для Каждого Перечисление Из ТипОбъектаXDTO.Фасеты.Перечисления Цикл
		Если ТипыПеречисленийСтран.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийВалют.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовОКАТО.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовЦенныхБумаг.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если Лев(Перечисление.Значение, СтрДлина(ЗначениеПеречисления)) = ЗначениеПеречисления Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовОпераций.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если СтрЧислоВхождений(Перечисление.Значение, ЗначениеПеречисления) = 1 Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовОКАТОИСтран.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если СтрЧислоВхождений(Перечисление.Значение, ЗначениеПеречисления) = 1 Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли ТипыПеречисленийКодовЭмитентов.Найти(ТипОбъектаXDTO.Имя) <> Неопределено
		ИЛИ КодыСрокаПогашенияЦеннойБумаги.Найти(ТипОбъектаXDTO.Имя) <> Неопределено Тогда
			Если СтрНачинаетсяС(Перечисление.Значение, ЗначениеПеречисления) Тогда
				Возврат Перечисление.Значение;
			КонецЕсли;
		ИначеЕсли Перечисление.Значение = ЗначениеПеречисления Тогда
			Возврат Перечисление.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ТекстОшибки = "Не задано перечисление XBRL: " + ТипОбъектаXDTO.Имя + ", значение:" + ЗначениеПеречисления + ", тип значения: " + ТипЗнч(ЗначениеПеречисления);
	
	ИмяПеречисления = ПолучитьИмяПеречисления(ТипОбъектаXDTO.Имя);
	
	Если НЕ ПеречисленияXBRL.Свойство(ИмяПеречисления) Тогда
		Если ТипЗнч(ЗначениеПеречисления) = Тип("Булево") Тогда
			Возврат ?(ЗначениеПеречисления, "DaMember", "NetMember");
		КонецЕсли;
		//не задано перечисление, далее сообщим об этом
		
	ИначеЕсли ПеречисленияXBRL[ИмяПеречисления].Получить("НеПреобразовывать") = "ИСТИНА" Тогда
		Если ТипЗнч(ЗначениеПеречисления) = Тип("Булево") Тогда
			Возврат ?(ЗначениеПеречисления, "DaMember", "NetMember");
		Иначе
			Возврат ЗначениеПеречисления;	
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ПеречисленияXBRL[ИмяПеречисления].Получить(ЗначениеПеречисления)) Тогда
		Возврат ПеречисленияXBRL[ИмяПеречисления].Получить(ЗначениеПеречисления);
		
	ИначеЕсли ЗначениеЗаполнено(ПеречисленияXBRL[ИмяПеречисления].Получить(Строка(ЗначениеПеречисления))) Тогда
		Возврат ПеречисленияXBRL[ИмяПеречисления].Получить(Строка(ЗначениеПеречисления));
		
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	
	Возврат ТипОбъектаXDTO.Фасеты[0].Значение;
	
КонецФункции

//Имена перечислений бывают с привязкой к разделу, хотя значения там одинаковые
//Например enum_Kvalificzirovannost_investoraAxis_SR_0420431_q_r1_p2 И enum_Kvalificzirovannost_investoraAxis_SR_0420431_q_r1_p2_2
//Чтобы все их не описывать, зададим общее начало имени перечисления
&НаКлиенте
Функция ПолучитьИмяПеречисления(ИмяПеречисления)

	ОбщееИмя = Неопределено;
	
	Для Каждого ЭлементПеречисления Из ПеречисленияXBRL Цикл
		Если ВРЕГ(ИмяПеречисления) = ВРЕГ(ЭлементПеречисления.Ключ) Тогда
			Возврат ИмяПеречисления;
			
		ИначеЕсли СтрНачинаетсяС(ИмяПеречисления, ЭлементПеречисления.Ключ) Тогда
			Если ОбщееИмя = Неопределено Тогда
				ОбщееИмя = ЭлементПеречисления.Ключ;
			Иначе
				ВызватьИсключение СтрШаблон("Нарушение уникальности общего имени перечисления %1 и %2", ОбщееИмя, ЭлементПеречисления.Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщееИмя <> Неопределено Тогда
		Возврат ОбщееИмя;
	Иначе
		Возврат ИмяПеречисления;
	КонецЕсли;
	
КонецФункции
	
&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	СформироватьТекстПисьма();	
	ОбновитьНадписьНастройки();
	
	Если ВидимостьРеквизита("УполномоченноеЛицоСпецДепа_Фамилия", Элементы) Тогда
		ЗаполнитьФИОУполномоченногоСпецДепа();
	КонецЕсли;
	
	Если Элементы.ГруппаВыгружатьXBRL.Видимость Тогда
		Если НЕ Элементы.Период.РежимВыбораИзСписка Тогда
			ЗаполинтьСписокПериодичности(Отчет.ПериодичностьОтчета, Элементы.ПериодичностьОтчета.СписокВыбора, Отчет.ВариантОтчета, ТочкиВхода, Отчет.ДатаОтчетности, Отчет.СчетДоверительногоУправления, Отчет.Организация, Отчет.ВерсияТаксономии);
		КонецЕсли;
	КонецЕсли;
	
	Если КонтрольКорректностиДат() Тогда
		УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНастройкиКлиентаНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(Отчет.Клиент) Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Объект", Отчет.Клиент);
	
	ТекФорма = ОткрытьФорму("РегистрСведений.ЗначенияДополнительныхСведений.Форма.ФормаСпискаОбъекта", ПараметрыФормы);
	ТекФорма.Заголовок = СокрЛП(Отчет.Клиент);
	
КонецПроцедуры

