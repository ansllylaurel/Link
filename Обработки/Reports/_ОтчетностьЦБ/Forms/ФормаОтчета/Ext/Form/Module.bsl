
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЗаполнениеНастроекПриПервомЗапуске();
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ЭтаФорма.ВнешняяОбработка = НЕ СтрНачинаетсяС(ОтчетОбъект.ИспользуемоеИмяФайла, "e1cib\tempstorage\");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Элементы.ФормаПереключитьПоддержкуФорматаXTDD.Пометка = ЭтаФорма.ПоддержкаФорматаXTTD;

	Отчет.Период = Новый СтандартныйПериод(ВариантСтандартногоПериода.ПрошлыйМесяц);
	
	Если Элементы.ВариантОтчета.СписокВыбора.НайтиПоЗначению(Отчет.ВариантОтчета) = Неопределено Тогда
		Отчет.ВариантОтчета = Элементы.ВариантОтчета.СписокВыбора[0].Значение;
	КонецЕсли;	
	
	ВариантОтчетаПриИзменении("");
	
	ЭтаФорма.СохраняемыеВНастройкахДанныеМодифицированы = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполнения()
	
	Отказ = Ложь;
	
	Если НЕ КонтрольКорректностиДат() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЭтаФорма.ВнешняяОбработка И ЭтаФорма.ВерсияДополнительногоОтчетаИлиОбработки <> АктуальнаяВерсияОбработки() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Версия Отчётности ЦБ обновилась. Перезапустите Отчётность ЦБ!",,,, Отказ);
		Возврат Не Отказ;
	КонецЕсли;
	
	ОбязательныеРеквизиты	= Новый Соответствие;
	ИспользуемыеКаталоги	= Новый Структура;
	
	Если Отчет.ВыгружатьВXML Тогда
		ОбязательныеРеквизиты.Вставить("КаталогДанных", "Каталог данных");
		ИспользуемыеКаталоги.Вставить("КаталогДанных", "Каталог данных");
	КонецЕсли;
	
	Если Отчет.ВыгружатьВXBRL Тогда
		ОбязательныеРеквизиты.Вставить("КаталогXBRL", "Каталог XBRL");
		ИспользуемыеКаталоги.Вставить("КаталогXBRL", "Каталог XBRL");
	КонецЕсли;
	
	Если Отчет.ВыгружатьPDF Тогда
		ОбязательныеРеквизиты.Вставить("КаталогPDF", "Каталог PDF");
		ИспользуемыеКаталоги.Вставить("КаталогPDF", "Каталог PDF");
	КонецЕсли;
	
	Для Каждого ИмяЭлементаСотрудника Из ПолучитьИменаЭлементовСотрудников() Цикл		
		ПроверитьСотрудника(ИмяЭлементаСотрудника, Отказ);		
	КонецЦикла;
	
	Если ВидимостьРеквизита("Руководитель_Основание", Элементы) Тогда
		ОбязательныеРеквизиты.Вставить("Руководитель_Основание"	, "Основание руководителя");
	КонецЕсли;
	
	Если ВидимостьРеквизита("Контролер_Основание", Элементы) Тогда
		ОбязательныеРеквизиты.Вставить("Контролер_Основание"	, "Основание контролера");
	КонецЕсли;
	
	Если Отчет.ВыгружатьВXBRL И ВидимостьРеквизита("УполномоченноеЛицоСпецДепа_Фамилия", Элементы) Тогда
		ОбязательныеРеквизиты.Вставить("УполномоченноеЛицоСпецДепа_Фамилия",	"Фамилия уполномоченного лица спец. депа.");
		ОбязательныеРеквизиты.Вставить("УполномоченноеЛицоСпецДепа_Имя",		"Имя уполномоченного лица спец. депа.");
		ОбязательныеРеквизиты.Вставить("УполномоченноеЛицоСпецДепа_Отчество",	"Отчество уполномоченного лица спец. депа.");
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420011" Тогда
		ОбязательныеРеквизиты.Вставить("ИмяФайлаРегистра", "Файл консолидированного регистра по банкам");
	КонецЕсли;
	
	Если ВидимостьРеквизита("ГруппаФайлExcel", Элементы) Тогда
		
		Если (Не ЗначениеЗаполнено(Отчет.ИмяФайлаExcel) Или Не ЗначениеЗаполнено(Отчет.ИмяФайлаExcelПредыдущегоПериода)) 
			И Не ЗначениеЗаполнено(ЭтаФорма.ПоказателиОперационнойНадежностиТекущий) Тогда

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить файл Excel и файл Excel предыдущего периода!", , , , Отказ);
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если Элементы.СчетДоверительногоУправления.Видимость 
		И (НЕ Элементы.ВариантФормированияПоСчетамДУ.Видимость ИЛИ Отчет.ВариантФормированияПоСчетамДУ = "ПоСчетуДУ") Тогда
		ОбязательныеРеквизиты.Вставить("СчетДоверительногоУправления", "Счет доверительного управления");
	КонецЕсли;
	
	Если Элементы.ДатаПредставленияОтчетностиУчастникам.Видимость Тогда
		ОбязательныеРеквизиты.Вставить("ДатаПредставленияОтчетностиУчастникам"	, "Дата представления отчетности участникам");
	КонецЕсли;	
	
	Если ВидимостьРеквизита("ГруппаПовесткаДня", Элементы) Тогда
		ОбязательныеРеквизиты.Вставить("ДатаСобранияАкционеров"	, 				"Дата собрания акционеров");
		ОбязательныеРеквизиты.Вставить("НаименованиеУполномоченногоОргана"	,	"Наименование уполномоченного органа");
		ОбязательныеРеквизиты.Вставить("Период.ДатаОкончания",					"Дата утверждения повестки дня");
	КонецЕсли;	
	
	Если Элементы.ГруппаПринятияРешения.Видимость Тогда
		ОбязательныеРеквизиты.Вставить("Период.ДатаОкончания", "Дата принятия решения");
	КонецЕсли;	
	
	Для Каждого Реквизит Из ОбязательныеРеквизиты Цикл
		ЗначениеРеквизита = Отчет;
		
		Для Каждого ИмяРеквизита Из СтрРазделить(Реквизит.Ключ, ".", Ложь) Цикл
			ЗначениеРеквизита = ЗначениеРеквизита[ИмяРеквизита];
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле """ + Реквизит.Значение + """ не заполнено",,, "Отчет." + Реквизит.Ключ, Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из ИспользуемыеКаталоги Цикл
		Каталог = Новый Файл(Отчет[Реквизит.Ключ]);
		Если НЕ Каталог.Существует() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог указанный в поле """ + Реквизит.Значение + """ не обнаружен",,, "Отчет." + Реквизит.Ключ, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Если Отчет.ТестовыйРежим Тогда
		Если Вопрос("Включен тестовый режим, данные будут сформированы некорректные! Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидимостьРеквизита("ВидыОтчетностиПодлежащиеАудиторскойПроверке", Элементы) Тогда
		ВыбранВидОтчетности = Ложь;
		Для Каждого ВидОтчетности Из Отчет.ВидыОтчетностиПодлежащиеАудиторскойПроверке Цикл
			Если ВидОтчетности.Пометка Тогда
				ВыбранВидОтчетности = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ВыбранВидОтчетности Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран вид отчётности подлежащий аудиторской проверке",,, "Отчет.ВидыОтчетностиПодлежащиеАудиторскойПроверке", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отчет.ВыгружатьВXBRL И ЭтаФорма.ВедетсяУчетДолжностыхЛиц И ЭтаФорма.Руководитель_НазначениеИО Тогда
		
		// Отключаем проверку доверенности по задаче #557248
		//Если Не ЗначениеЗаполнено(ЭтаФорма.Руководитель_Доверенность) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена доверенность. Необходимо выписать доверенность ИО руководителя на подписание отчетности.", , , , Отказ);
		//КонецЕсли;
		Если Не ЕстьДанныеВоВременномХранилище("ФайлПриказа", ЭтаФорма) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить PDF файл приказа о назначении исполняющего обязанности руководителя!", , , , Отказ);
		КонецЕсли;	
		// Отключаем проверку скана доверенности по задаче #557248
		//Если Не ЕстьДанныеВоВременномХранилище("ФайлДоверенности", ЭтаФорма) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить файл скана доверенности на подписание отчетности!", , , , Отказ);
		//КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИмяФайлаОпераций(Организация, ИмяПакета, ДатаОкончания, ТекущийКаталог)
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._ОтчетностьЦБ." + ИмяПакета, Организация, ДатаОкончания, ТекущийКаталог);
	
КонецФункции // ПолучитьИмяФайлаОстатков

&НаСервере
Функция ПолучитьНаименованиеГоловнойОрганизации()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&Период, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо И СвязанныеЮридическиеЛицаСрезПоследних.Действует
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|ГДЕ
		|	Организации.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СокращенноеНаименование;
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СобытияРеквизитовФормы

&НаКлиенте
Процедура ВыгружатьВXMLПриИзменении(Элемент)
	
	Элементы.КаталогДанных.Видимость = Отчет.ВыгружатьВXML;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьВXBRLПриИзменении(Элемент)
	
	Элементы.КаталогXBRL.Видимость = Отчет.ВыгружатьВXBRL;
	
	Элементы.Период.РежимВыбораИзСписка = ДляПериодаИспользуетсяСписокВыбора(Отчет.ВариантОтчета) И Отчет.ВыгружатьВXBRL И Отчет.ПериодичностьОтчета <> "Нерегулярная" И Отчет.ПериодичностьОтчета <> "ПоЗапросу";																
	
	Если Элементы.Период.РежимВыбораИзСписка Тогда
		Если Элементы.Период.СписокВыбора.Количество() Тогда
			НайденныйПериод = Элементы.Период.СписокВыбора.НайтиПоЗначению(Отчет.Период);
			Если НайденныйПериод = Неопределено Тогда
				Отчет.Период = Элементы.Период.СписокВыбора[0].Значение;
			Иначе
				Отчет.Период = НайденныйПериод.Значение;
			КонецЕсли;
			Отчет.ПериодичностьОтчета = ПолучитьПериодичностьОтчетностиПоПериоду(Отчет.Период);
			Элементы.Период.ОбновитьТекстРедактирования();
		КонецЕсли;
	КонецЕсли;
	
	ВидимостьРеквизитов();	
	
	Если ЭтаФорма.ВедетсяУчетОтветственных И ВидимостьРеквизита("Ответственный", Элементы) Тогда
		Отчет.Ответственный = ПолучитьОтветственноеЛицо(Отчет.Организация, Отчет.ВариантОтчета);
		ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элементы.Ответственный);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгружатьPDFПриИзменении(Элемент)
	
	Элементы.КаталогPDF.Видимость = Отчет.ВыгружатьPDF;
	
КонецПроцедуры

&НаКлиенте
Процедура ФамилияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокДляВыбора = СписокКонтактныхЛицСпецДепозитария(Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация, 	?(Элементы.СчетДоверительногоУправления.Видимость, Отчет.СчетДоверительногоУправления,
																																?(Элементы.Клиент.Видимость, Отчет.Клиент, Неопределено)));
	РезультатВыбора = СписокДляВыбора.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		Если Элемент = Элементы.УполномоченноеЛицоСпецДепа_Фамилия Тогда
			ИмяЭлемента = "УполномоченноеЛицоСпецДепа";
		Иначе
			Возврат;
		КонецЕсли;
		
		ЗаполнитьФИО(ИмяЭлемента, РезультатВыбора.Значение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФамилияСотрудникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДанныеВыбора  = ОткрытьФормуМодально("Справочник.Сотрудники.ФормаВыбора", Новый Структура("Организация, Период, ТекущаяСтрока", Отчет.Организация, НачалоДня(ТекущаяДата()), Отчет[Элемент.Имя]), ЭтаФорма);
	
	Если ДанныеВыбора <> Неопределено Тогда
		Отчет[Элемент.Имя] = ДанныеВыбора;
		СтандартнаяОбработка = Ложь;
		ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если НЕ КонтрольКорректностиДат() Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ГруппаВыгружатьXBRL.Видимость Тогда
		Отчет.ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация);
		УстановитьДоступностьВыгружатьXBRL();
	КонецЕсли;
	
	Если ДляПериодаИспользуетсяСписокВыбора(Отчет.ВариантОтчета) И Элементы.Период.РежимВыбораИзСписка Тогда
		Отчет.ПериодичностьОтчета = ПолучитьПериодичностьОтчетностиПоПериоду(Отчет.Период);
	КонецЕсли;
	
	Отчет.КаталогДанных = ПолучитьИмяФайлаОпераций(Отчет.Организация, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.КаталогДанных);
	
	СформироватьТекстПисьма();
	ОбновитьНадписьНастройки();
	
	ВидимостьРеквизитов();
	ЗаполнитьДокументыДля432Формы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаУтвержденияПовесткиДняПриИзменении(Элемент)
	
	Отчет.Период.ДатаНачала = Отчет.Период.ДатаОкончания;
	ПериодПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетнаяДатаПриИзменении(Элемент)
	
	Отчет.Период.ДатаНачала = Отчет.Период.ДатаОкончания;
	ПериодПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПринятияРешенияПриИзменении(Элемент)
	
	Отчет.Период.ДатаНачала = Отчет.Период.ДатаОкончания;
	ПериодПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтчетаПриИзменении(Элемент)
	
	ВосстановитьДанныеИзНастроек(Отчет.ВариантОтчета, Элемент <> "");
	
	Отчет.ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация);
	ЭтаФорма.ВедетсяУчетОтветственных = ПолучитьВедетсяУчетОтветственных(Отчет.Организация, Отчет.ВариантОтчета);
	
	ВидимостьРеквизитов();
	ОчиститьНеиспользуемыеРеквизиты();
	
	Если ЭтаФорма.ВедетсяУчетОтветственных И ВидимостьРеквизита("Ответственный", Элементы) Тогда
		Отчет.Ответственный = ПолучитьОтветственноеЛицо(Отчет.Организация, Отчет.ВариантОтчета);
		ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элементы.Ответственный);
	КонецЕсли;
	
	Если ВидимостьРеквизита("УполномоченноеЛицоСпецДепа_Фамилия", Элементы) Тогда
		ЗаполнитьФИОУполномоченногоСпецДепа();
	КонецЕсли;
		
	Если Элементы.ГруппаВыгружатьXBRL.Видимость Тогда
		УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
		Отчет.ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация);
		УстановитьДоступностьВыгружатьXBRL();
	КонецЕсли;
	
	Если ДляПериодаИспользуетсяСписокВыбора(Отчет.ВариантОтчета) Тогда
		УстановитьСписокПериодов();
		Элементы.Период.РежимВыбораИзСписка = Отчет.ВыгружатьВXBRL И Отчет.ПериодичностьОтчета <> "Нерегулярная" И Отчет.ПериодичностьОтчета <> "ПоЗапросу";																
	Иначе
		Элементы.Период.РежимВыбораИзСписка = Ложь;
	КонецЕсли;
	
		
	Если Элементы.Период.РежимВыбораИзСписка Тогда
		Если Элементы.Период.СписокВыбора.Количество() Тогда
			Отчет.Период = Элементы.Период.СписокВыбора[0].Значение;
			Отчет.ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация);
		Иначе
			Отчет.Период = Неопределено;
		КонецЕсли;
		ЗаполинтьСписокПериодичностиПоСпискуПериодов(Отчет.ПериодичностьОтчета, Элементы.ПериодичностьОтчета.СписокВыбора, Отчет.Период, Элементы.Период.СписокВыбора, ЕстьТочкаВходаПоЗапросу, ЕстьНерегулярнаяТочкаВхода);
	Иначе
		ЗаполинтьСписокПериодичности(Отчет.ПериодичностьОтчета, Элементы.ПериодичностьОтчета.СписокВыбора, Отчет.ВариантОтчета, ТочкиВхода, Отчет.ДатаОтчетности, Отчет.СчетДоверительногоУправления, Отчет.Организация, Отчет.ВерсияТаксономии);
		УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
	КонецЕсли;
	
	Отчет.КаталогДанных = ПолучитьИмяФайлаОпераций(Отчет.Организация, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.КаталогДанных);
	
	СформироватьТекстПисьма();
	ОбновитьНадписьНастройки();
	ЗаполнитьСписокАвтосравненияОтчетовНаСервере();
	ЗаполнитьДокументыДля432Формы();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументыДля432Формы()
	
	Если Не (Отчет.ВариантОтчета = "ОКУД0420432" Или Отчет.ВариантОтчета = "ОКУД0420523") Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",          Отчет.Организация);
	Запрос.УстановитьПараметр("ДатаОтчета",           Отчет.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ДатаОтчетаПредыдущий", КонецКвартала(ДобавитьМесяц(Отчет.Период.ДатаОкончания, -3)));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ДокиТекущегоПериода.Документ, ЗНАЧЕНИЕ(Документ.ПоказателиОперационнойНадежности.ПустаяСсылка)) КАК ПоказателиОперационнойНадежностиТекущий,
		|	ЕСТЬNULL(ДокиПредыдущегоПериода.Документ, ЗНАЧЕНИЕ(Документ.ПоказателиОперационнойНадежности.ПустаяСсылка)) КАК ПоказателиОперационнойНадежностиПредыдущий
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		ПоказателиОперационнойНадежности.Ссылка КАК Документ
		|	ИЗ
		|		Документ.ПоказателиОперационнойНадежности КАК ПоказателиОперационнойНадежности
		|	ГДЕ
		|		ПоказателиОперационнойНадежности.Организация = &Организация
		|		И НЕ ПоказателиОперационнойНадежности.ПометкаУдаления
		|		И КОНЕЦПЕРИОДА(ПоказателиОперационнойНадежности.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&ДатаОтчета, ДЕНЬ)
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		ПоказателиОперационнойНадежности.МоментВремени УБЫВ) КАК ДокиТекущегоПериода
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
		|			ПоказателиОперационнойНадежности.Ссылка КАК Документ
		|		ИЗ
		|			Документ.ПоказателиОперационнойНадежности КАК ПоказателиОперационнойНадежности
		|		ГДЕ
		|			ПоказателиОперационнойНадежности.Организация = &Организация
		|			И НЕ ПоказателиОперационнойНадежности.ПометкаУдаления
		|			И КОНЕЦПЕРИОДА(ПоказателиОперационнойНадежности.Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&ДатаОтчетаПредыдущий, ДЕНЬ)
		|		
		|		УПОРЯДОЧИТЬ ПО
		|			ПоказателиОперационнойНадежности.МоментВремени УБЫВ) КАК ДокиПредыдущегоПериода
		|		ПО (ИСТИНА)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);	
		
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(ЭтаФорма.ПоказателиОперационнойНадежностиТекущий) Или Не ЗначениеЗаполнено(ЭтаФорма.ПоказателиОперационнойНадежностиПредыдущий) Тогда   
		
		ЭтаФорма.ПоказателиОперационнойНадежностиТекущий    = Неопределено;
		ЭтаФорма.ПоказателиОперационнойНадежностиПредыдущий = Неопределено;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЭтаФорма.ПоказателиОперационнойНадежностиТекущий) Тогда   
		
		Отчет.ИмяФайлаExcel                   = "";
		Отчет.ИмяФайлаExcelПредыдущегоПериода = "";
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ПериодичностьОтчетаПриИзменении(Элемент)
	
	Элементы.Период.РежимВыбораИзСписка = ДляПериодаИспользуетсяСписокВыбора(Отчет.ВариантОтчета) И Отчет.ВыгружатьВXBRL И Отчет.ПериодичностьОтчета <> "Нерегулярная" И Отчет.ПериодичностьОтчета <> "ПоЗапросу";																
	
	Если Элементы.Период.РежимВыбораИзСписка Тогда
		Для Каждого ЭлементВыбораПериода Из Элементы.Период.СписокВыбора Цикл
			Если Отчет.ПериодичностьОтчета = ПолучитьПериодичностьОтчетностиПоПериоду(ЭлементВыбораПериода.Значение) Тогда
				Отчет.Период = ЭлементВыбораПериода.Значение;
				Элементы.Период.ОбновитьТекстРедактирования();
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		УстановитьПериодОтчетаПоУмолчанию(Отчет.ВариантОтчета, Отчет.Период, Отчет.ДатаОтчетности, Отчет.ПериодичностьОтчета, Элементы.Период.Видимость);
	КонецЕсли;
	
	СформироватьТекстПисьма();
	
	Если Элементы.ГруппаВыгружатьXBRL.Видимость Тогда
		Отчет.ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.Организация);
		УстановитьДоступностьВыгружатьXBRL();
	КонецЕсли;
	
	ВидимостьРеквизитов();
	ЗаполнитьСписокАвтосравненияОтчетовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЭтаФорма.ВнешняяОбработка И ЭтаФорма.ВерсияДополнительногоОтчетаИлиОбработки <> АктуальнаяВерсияОбработки() Тогда
		ПоказатьПредупреждение(, "Версия Отчётности ЦБ обновилась. Перезапустите Отчётность ЦБ!");
		Возврат;
	КонецЕсли;
	
	СохранитьДанныеВНастройки();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеВНастройки()
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
	Если СохраненныеНастройки <> Неопределено И СохраненныеНастройки.Получить("Отчет.НастройкиОтчета") <> Неопределено Тогда
		Отчет.НастройкиОтчета.Загрузить(СохраненныеНастройки.Получить("Отчет.НастройкиОтчета"));
	КонецЕсли;
	
	СохранитьНастройкиВТаблицу(Отчет.НастройкиОтчета);
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
		
	Если СохраненныеНастройки = Неопределено Тогда
		СохраненныеНастройки = Новый Соответствие;
	КонецЕсли;
	
	СохраненныеНастройки.Вставить("Отчет.НастройкиОтчета", Отчет.НастройкиОтчета.Выгрузить());
	ХранилищеСистемныхНастроек.Сохранить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные", "", СохраненныеНастройки);
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьДанныеИзНастроек(ВариантОтчета, ЧитатьНастройки = Истина)
	
	Если ЧитатьНастройки Тогда
		СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
		Если СохраненныеНастройки <> Неопределено И СохраненныеНастройки.Получить("Отчет.НастройкиОтчета") <> Неопределено Тогда
			Отчет.НастройкиОтчета.Загрузить(СохраненныеНастройки.Получить("Отчет.НастройкиОтчета"));
		КонецЕсли;
	КонецЕсли;
	
	СохраняемыеРеквизиты = Новый Структура;
	ИсключаемыеРеквизиты = Новый Массив;
	
	Если ЭтаФорма.ВедетсяУчетДолжностыхЛиц Тогда
		ИсключаемыеРеквизиты = РеквизитыДолжностныхЛиц();
	КонецЕсли;
	
	Если ЭтаФорма.ВедетсяУчетОтветственных Тогда
		ИсключаемыеРеквизиты.Добавить("Ответственный");
	КонецЕсли;
	
	Для Каждого СтрокаНастройки Из Отчет.НастройкиОтчета Цикл
		Если СтрокаНастройки.Организация = Отчет.Организация И СтрокаНастройки.ВариантОтчета = ВариантОтчета Тогда
			Если ЗначениеЗаполнено(СтрокаНастройки.Значение) И ИсключаемыеРеквизиты.Найти(СтрокаНастройки.Ключ) = Неопределено Тогда
				СохраняемыеРеквизиты.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Отчет		, СохраняемыеРеквизиты);
	ЗаполнитьЗначенияСвойств(ЭтаФорма	, СохраняемыеРеквизиты);
	
	ЗаполнитьРеквизитыСотрудников(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	СохраненныеНастройки = ХранилищеСистемныхНастроек.Загрузить(ЭтаФорма.ИмяФормы + "/ТекущиеДанные");
	Если СохраненныеНастройки <> Неопределено И СохраненныеНастройки.Получить("Отчет.НастройкиОтчета") <> Неопределено Тогда
		НастройкиОтчета = СохраненныеНастройки.Получить("Отчет.НастройкиОтчета");
	Иначе
		НастройкиОтчета = Настройки.Получить("Отчет.НастройкиОтчета");
	КонецЕсли;
	
	СохранитьНастройкиВТаблицу(НастройкиОтчета);
	
	Настройки.Вставить("Отчет.НастройкиОтчета", НастройкиОтчета);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиВТаблицу(НастройкиОтчета)
	
	СохраняемыеРеквизиты = ПолучитьСохраняемыеРеквизиты();
	
	ЗаполнитьЗначенияСвойств(СохраняемыеРеквизиты, Отчет);
	ЗаполнитьЗначенияСвойств(СохраняемыеРеквизиты, ЭтаФорма);
	
	ПараметрыПоиска = Новый Структура("Организация,ВариантОтчета", Отчет.Организация, Отчет.ВариантОтчета);
	НайденныеСтроки = НастройкиОтчета.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаНастройки Из НайденныеСтроки Цикл
		НастройкиОтчета.Удалить(СтрокаНастройки);
	КонецЦикла;
	
	Для Каждого Реквизит Из СохраняемыеРеквизиты Цикл
		СтрокаНастройки = НастройкиОтчета.Добавить();
		СтрокаНастройки.Организация		= Отчет.Организация;
		СтрокаНастройки.ВариантОтчета	= Отчет.ВариантОтчета;
		СтрокаНастройки.Ключ			= Реквизит.Ключ;
		СтрокаНастройки.Значение		= Реквизит.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСохраняемыеРеквизиты()

	ИсключаемыеРеквизиты = Новый Массив;
	
	Если ЭтаФорма.ВедетсяУчетДолжностыхЛиц Тогда
		ИсключаемыеРеквизиты = РеквизитыДолжностныхЛиц();
	КонецЕсли;
	
	Если ЭтаФорма.ВедетсяУчетОтветственных Тогда
		ИсключаемыеРеквизиты.Добавить("Ответственный");
	КонецЕсли;
	
	СохраняемыеРеквизиты = Новый Структура;
	Для Каждого ИмяРеквизита Из ПолучитьВсеСохраняемыеРеквизиты() Цикл
		Если ИсключаемыеРеквизиты.Найти(ИмяРеквизита) = Неопределено
		   И (СтрНачинаетсяС(ИмяРеквизита, "Каталог") ИЛИ ВидимостьРеквизита(ИмяРеквизита, Элементы)) Тогда
			СохраняемыеРеквизиты.Вставить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СохраняемыеРеквизиты;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьВсеСохраняемыеРеквизиты()
	
	ВсеСохраняемыеРеквизиты = Новый Массив;
	ВсеСохраняемыеРеквизиты.Добавить("ВывестиПечатнуюФорму");
	ВсеСохраняемыеРеквизиты.Добавить("ВыгружатьВXML");
	ВсеСохраняемыеРеквизиты.Добавить("КаталогДанных");
	ВсеСохраняемыеРеквизиты.Добавить("ИмяФайлаРегистра");
	ВсеСохраняемыеРеквизиты.Добавить("ИмяФайлаКасса");
	ВсеСохраняемыеРеквизиты.Добавить("Клиент");
	ВсеСохраняемыеРеквизиты.Добавить("Руководитель");
	ВсеСохраняемыеРеквизиты.Добавить("Руководитель_Основание");
	ВсеСохраняемыеРеквизиты.Добавить("Контролер");
	ВсеСохраняемыеРеквизиты.Добавить("Контролер_Основание");
	ВсеСохраняемыеРеквизиты.Добавить("УполномоченноеЛицоСпецДепа_Фамилия");
