&НаСервере
Процедура ЗаполнитьПояснительнуюЗаписку(ИмяПакета, Запрос, Отказ)

	ДанныеПояснительнойЗаписки = Новый Структура;
	
	Если НЕ Отчет.ВыгружатьВXBRL Тогда
		Возврат;
	КонецЕсли;
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	Если ИмяПакета = "ОКУД0420011" Тогда
		ОтчетОбъект.ОКУД0420011_ЗаполнитьПояснительнуюЗаписку(ПояснительнаяЗаписка, Запрос, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420418" Тогда
		ОтчетОбъект.ЗаполнитьПояснительнуюЗаписку_ОКУД0420418(ПояснительнаяЗаписка, Запрос, Отказ);
		
	ИначеЕсли ИмяПакета = "ОКУД0420431" И Не Отказ Тогда
		ОтчетОбъект.ЗаполнитьПояснительнуюЗаписку_ОКУД0420431(ПояснительнаяЗаписка, Запрос, Отказ);

	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПечатныеФормыВPDF(Отказ)
	
	Если НЕ Отчет.ВыгружатьPDF ИЛИ Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420502" 
	 ИЛИ Отчет.ВариантОтчета = "ОКУД0420503"
	 ИЛИ Отчет.ВариантОтчета = "ОКУД0420505" Тогда
		
		СохранитьРезультатВPDF();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДополнительныеВложения(Отказ)
	
	//пока вложения только для XBRL
	Если НЕ Отчет.ВыгружатьВXBRL ИЛИ Отказ Тогда 
		Возврат; 
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420011"
	 ИЛИ Отчет.ВариантОтчета = "ОКУД0420418"
	 ИЛИ Отчет.ВариантОтчета = "ОКУД0420431" Тогда
		Если ПояснительнаяЗаписка.ВысотаТаблицы > 0 Тогда
			СохранитьПояснительнуюЗапискуВDOCX();
		КонецЕсли;
		
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420501" Тогда
		
		СписокПоказателейПересечения501И418();
		
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420502" Тогда
		
		Вложение = ПолучитьДанныеИзВременногоХранилища("ОКУД0420502_PZ", ЭтаФорма);
		Если Вложение <> Неопределено Тогда
			ИмяФайлаПояснительнойЗаписки = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "Вложение", "PZ", "docx", Отчет.КаталогXBRL, Ложь);
			Вложение.Записать(ИмяФайлаПояснительнойЗаписки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Пояснительная записка сохранена в файл: " + Отчет.КаталогXBRL + "\PZ.docx");
		КонецЕсли;
		
	КонецЕсли;
	
	// сохранение файлов приказа и доверенности в случае, если на момент формирования отчета действует ИО руководителя
	Если ЭтаФорма.ВедетсяУчетДолжностыхЛиц И ЭтаФорма.Руководитель_НазначениеИО Тогда
		
		СтрТекущаяДата = Формат(ТекущаяДата(), "ДФ=ddMMyyyy");
		
		Вложение = ПолучитьДанныеИзВременногоХранилища("ФайлПриказа", ЭтаФорма);
		Если Не Вложение = Неопределено Тогда
			ИмяФайлаПриказа = ПолучитьИмяФайла(ЭтаФорма, "", "Вложение", СтрШаблон("%1_%2", "ORDER", СтрТекущаяДата), "pdf", , Ложь);
			Вложение.Записать(ИмяФайлаПриказа);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Приказ о назначении исполняющего обязанности руководителя сохранен в файл: " + ИмяФайлаПриказа);
		КонецЕсли;	
		
		Вложение = ПолучитьДанныеИзВременногоХранилища("ФайлДоверенности", ЭтаФорма);
		Если Не Вложение = Неопределено Тогда
			ИмяФайлаДоверенности = ПолучитьИмяФайла(ЭтаФорма, "", "Вложение", СтрШаблон("%1_%2", "ORDER_dov", СтрТекущаяДата), "pdf", , Ложь);
			Вложение.Записать(ИмяФайлаДоверенности);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Доверенность на подписание отчетности сохранена в файл: " + ИмяФайлаДоверенности);
		КонецЕсли;	
			
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПояснительнуюЗапискуВDOCX()
	
	Если Отчет.ВариантОтчета = "ОКУД0420431" Тогда

		ИмяФайлаПояснительнойЗаписки = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "docx", "", "docx", Отчет.КаталогXBRL, Не Отчет.ЭтоРПИ);
		ИмяФайлаДляСообщения = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаПояснительнойЗаписки).Имя;
		
	Иначе
		
		ИмяФайлаПояснительнойЗаписки = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "Вложение", "PZ", "docx", Отчет.КаталогXBRL, Не Отчет.ЭтоРПИ);
		ИмяФайлаДляСообщения = "PZ.docx";
		
	КонецЕсли;	
	
	Если ПустаяСтрока(ИмяФайлаПояснительнойЗаписки) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПояснительнаяЗаписка.Записать(ИмяФайлаПояснительнойЗаписки, ТипФайлаТабличногоДокумента.DOCX);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Пояснительная записка сохранена в файл: " + Отчет.КаталогXBRL + "\" + ИмяФайлаДляСообщения);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сохранить пояснительную записку: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
