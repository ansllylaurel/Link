		Если КаталогСуществует(ИмяФайлаПоказателей) Тогда
			Макет.Записать(ИмяФайлаПоказателей, ТипФайлаТабличногоДокумента.XLSX);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Пересечения показателей с формой 418 сохранены в файл: " + ИмяФайлаПоказателей);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРезультатИРасшифровкуВPDF()
	
	Если Результат.ВысотаТаблицы = 0 Тогда Возврат; КонецЕсли;
	
	Результат.Записать(КаталогВременныхФайлов() + "\doc1.docx", ТипФайлаТабличногоДокумента.DOCX);
	Расшифровка.Записать(КаталогВременныхФайлов() + "\doc2.docx", ТипФайлаТабличногоДокумента.DOCX);
	
	MSWord = Новый COMОбъект("Word.Application");
	Документ = MSWord.Application.Documents.Add();

    MSWord.Application.Selection.InsertFile(КаталогВременныхФайлов() + "\doc1.docx",,, Ложь);
    MSWord.Application.Selection.InsertBreak(2);
    MSWord.Application.Selection.InsertFile(КаталогВременныхФайлов() + "\doc2.docx",,, Ложь);	
	MSWord.Application.Selection.PageSetup.Orientation = 1;
	
	MSWord.Application.Visible = Ложь;
	
	ИмяФайлаPDF = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "pdf");
	
	Если ПустаяСтрока(ИмяФайлаPDF) Тогда
		Возврат;
	КонецЕсли;
	
	Если КаталогСуществует(ИмяФайлаPDF) Тогда
		MSWord.Application.ActiveDocument.ExportAsFixedFormat(ИмяФайлаPDF, 17, Ложь);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайлаPDF);
	КонецЕсли;
	
	Документ.Close(Ложь);
	
	MSWord.Application.Quit();
	
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРезультатВPDF()
	
	Если РезультатPDF.ВысотаТаблицы = 0
	 ИЛИ (Отчет.ВариантОтчета = "ОКУД0420502" И РасшифровкаPDF.ВысотаТаблицы = 0) Тогда 
		Возврат; 
	КонецЕсли;
	
	ИмяФайлаPDF = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "pdf");
	
	Если ПустаяСтрока(ИмяФайлаPDF) Тогда
		Возврат;
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420502" Тогда
		
		СписокПечатныхФорм = Новый СписокЗначений;
		СписокПечатныхФорм.Добавить(РезультатPDF,, Истина);
		СписокПечатныхФорм.Добавить(РасшифровкаPDF,, Истина);
		
		ДанныеДляФайла = ОбъединитьТабличныеДокументы(СписокПечатныхФорм);
		
	Иначе
		ДанныеДляФайла = РезультатPDF;
		
	КонецЕсли;
	
	Если КаталогСуществует(ИмяФайлаPDF) Тогда
		ДанныеДляФайла.Записать(ИмяФайлаPDF, ТипФайлаТабличногоДокумента.PDF);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайлаPDF);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьWord(Команда)

	Если Вопрос("Word будет сформирован по правилам PDF. Продолжить?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог для сохранения файла"; 
	
	Если НЕ Диалог.Выбрать() Тогда 
		Возврат;
	КонецЕсли;
	
	КаталогФайла = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "docx",,, Диалог.Каталог);
	
	Если ПустаяСтрока(Каталогфайла) Тогда
		Возврат;
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "ОКУД0420502" Тогда
		
		СписокПечатныхФорм = Новый СписокЗначений;
		СписокПечатныхФорм.Добавить(РезультатPDF,, Истина);
		СписокПечатныхФорм.Добавить(РасшифровкаPDF,, Истина);
		
		ДанныеДляФайла = ОбъединитьТабличныеДокументы(СписокПечатныхФорм);
		
	Иначе
		ДанныеДляФайла = РезультатPDF;
		
	КонецЕсли;
	
	Если КаталогСуществует(КаталогФайла) Тогда
		ДанныеДляФайла.Записать(КаталогФайла, ТипФайлаТабличногоДокумента.DOCX);
		ЗапуститьПриложение(КаталогФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьExcel(Команда)

	СписокПечатныхФорм = Новый СписокЗначений;
	ТипФайла = ТипФайлаТабличногоДокумента.XLSX;
	
	Если Отчет.ВариантОтчета = "ОКУД0420502" Тогда
		
		СписокПечатныхФорм.Добавить(Результат,, Истина);
		СписокПечатныхФорм.Добавить(Расшифровка,, Истина);
		
		ДанныеДляФайла = ОбъединитьТабличныеДокументы(СписокПечатныхФорм);
		
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420431" Тогда
		
		ДанныеДляФайла = Новый ПакетОтображаемыхДокументов;
		
		Для Номер = 0 По 3 Цикл
			СтраницаРасшифровка = ДанныеДляФайла.Состав.Добавить();
			СтраницаРасшифровка.Данные			= ПоместитьВоВременноеХранилище(ЭтаФорма["Расшифровка" + Формат(Номер, "Л=")]);
			СтраницаРасшифровка.Наименование	= Элементы["ГруппаРасшифровка" + Формат(Номер, "Л=")].Заголовок;
		КонецЦикла;	
		
		ТипФайла = ТипФайлаПакетаОтображаемыхДокументов.XLSX;
		
	Иначе
		
		Если Элементы.ГруппаОтчет.Видимость Тогда
			СписокПечатныхФорм.Добавить(Результат, "Отчет", Элементы.ГруппаОтчет.Родитель.ТекущаяСтраница = Элементы.ГруппаОтчет);
		КонецЕсли;
		
		Для Номер = 0 По 3 Цикл
			Если Элементы["ГруппаРасшифровка" + Формат(Номер, "Л=")].Видимость Тогда
				СписокПечатныхФорм.Добавить(Расшифровка, Элементы["ГруппаРасшифровка" + Формат(Номер, "Л=")].Заголовок, Элементы["ГруппаРасшифровка" + Формат(Номер, "Л=")].Родитель.ТекущаяСтраница = Элементы["ГруппаРасшифровка" + Формат(Номер, "Л=")]);	
			КонецЕсли;
		КонецЦикла;	
		
		Если Элементы.ГруппаРасхождения.Видимость Тогда
			СписокПечатныхФорм.Добавить(Расхождения, "Расхождения", Элементы.ГруппаРасхождения.Родитель.ТекущаяСтраница = Элементы.ГруппаРасхождения);
		КонецЕсли;

		Если НЕ СписокПечатныхФорм.ОтметитьЭлементы("Что сохранить в Excel?") Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеДляФайла = ОбъединитьТабличныеДокументы(СписокПечатныхФорм);
	КонецЕсли;
	
	Если ДанныеДляФайла = Неопределено Тогда
		Предупреждение("Не выбрано ни одной печатной формы");
		Возврат;
	КонецЕсли;
		
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Куда сохранить?"; 
	
	Если НЕ Диалог.Выбрать() Тогда 
		Возврат;
	КонецЕсли;
	
	КаталогФайла = ПолучитьИмяФайла(ЭтаФорма, Отчет.ВариантОтчета, "xlsx",,, Диалог.Каталог, , СписокПечатныхФорм);
	
	Если ПустаяСтрока(Каталогфайла) Тогда
		Возврат;
	КонецЕсли;
	
		
	Если КаталогСуществует(КаталогФайла) Тогда	
		ДанныеДляФайла.Записать(КаталогФайла, ТипФайла);
	Иначе
		Предупреждение("Не удалось сохранить файл: " + КаталогФайла);
		Возврат;
	КонецЕсли;
	
	Если Вопрос("Открыть сохранённый файл?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ЗапуститьПриложение(КаталогФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СравнениеВерсийТаксономии(Команда)
	
	ОткрытьФорму("ВнешнийОтчет._ОтчетностьЦБ.Форма.СравнениеВерсийТаксономии");
	
