	РеквизитФормыОтчет.ЗаполнитьСписокАвтосравненияСПредыдущимПериодом(АвтосравнениеСПредыдущимПериодом);

КонецПроцедуры	

&НаСервереБезКонтекста
Функция АктуальнаяВерсияОбработки()
	
	Возврат РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ОтчетностьЦБ").Версия;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяФайла(Форма, ВариантОтчета, ВидФайла, ШаблонФайла = "", Расширение = "", ВыбранныйКаталог = "", Версионирование = Истина, СписокПечатныхФорм = Неопределено)

	Отчет = Форма.Отчет;
	
	РеквизитыКаталога = Новый Структура("Путь, Идентификатор, Синоним");
	
	Если ВидФайла = "xtdd" Тогда
		РеквизитыКаталога = Новый Структура("Путь, Идентификатор, Синоним", Отчет.КаталогДанных, "КаталогДанных", "Каталог данных");
		Расширение = "xtdd";
		
	ИначеЕсли ВидФайла = "xbrl" ИЛИ ВидФайла = "Вложение" Тогда
		РеквизитыКаталога = Новый Структура("Путь, Идентификатор, Синоним", Отчет.КаталогXBRL, "КаталогXBRL", "Каталог XBRL");
		Расширение = ?(ПустаяСтрока(Расширение), "xml", Расширение);
		
	ИначеЕсли ВидФайла = "pdf" Тогда
		РеквизитыКаталога = Новый Структура("Путь, Идентификатор, Синоним", Отчет.КаталогPDF, "КаталогPDF", "Каталог PDF");
		Расширение = "pdf";
		
	ИначеЕсли ВидФайла = "xlsx" ИЛИ ВидФайла = "docx" Тогда
		
		РеквизитыКаталога = Новый Структура("Путь, Идентификатор, Синоним", ВыбранныйКаталог, "", "Выбранный каталог ");
		Расширение = ВидФайла;
	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида файла " + ВидФайла + " настройки получения не определены");
		Возврат "";
	КонецЕсли;
	
	//проверка каталога
	
	ПроверяемыйКаталог = Новый Файл(РеквизитыКаталога.Путь);
	Если НЕ ПроверяемыйКаталог.Существует() Тогда
		Если ЗначениеЗаполнено(РеквизитыКаталога.Идентификатор) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог указанный в поле """ + РеквизитыКаталога.Синоним + """ не обнаружен",,, "Отчет." + РеквизитыКаталога.Идентификатор);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог """ + РеквизитыКаталога.Путь + """ не обнаружен");
		КонецЕсли;
			
		Возврат "";
	КонецЕсли;	
	
	Версия = 1;
	
	Если ВидФайла = "xtdd" 
	 ИЛИ ВидФайла = "pdf"
	 ИЛИ ВидФайла = "xlsx" 
	 ИЛИ ВидФайла = "docx" Тогда
		Если (ВариантОтчета = "ОКУД0420506" ИЛИ ВариантОтчета = "ОКУД0420507") Тогда
			ШаблонФайла		= ВариантОтчета + " за " + Формат(Отчет.Период.ДатаОкончания, "ДФ='MMMM yyyy'") + " " + Форма.НаименованиеГоловнойОрганизации + " " + Строка(Отчет.Клиент);
			Версионирование = Ложь;
		ИначеЕсли (ВариантОтчета = "ОКУД0420502" ИЛИ ВариантОтчета = "ОКУД0420503" ИЛИ ВариантОтчета = "ОКУД0420505" ИЛИ ВариантОтчета = "ОКУД0420511") Тогда
			ШаблонФайла		= ВариантОтчета + " на " + Формат(Отчет.Период.ДатаОкончания, "ДФ='dd MMMM yyyy'") + " " + Форма.НаименованиеГоловнойОрганизации + " " + Строка(Отчет.СчетДоверительногоУправления);
			
			НомерПравил = ПолучитьНомерПравил(Отчет.СчетДоверительногоУправления, Отчет.Период.ДатаОкончания);
			Если ЗначениеЗаполнено(НомерПравил) Тогда
				ШаблонФайла = ШаблонФайла + " (" + НомерПравил + ")";
			КонецЕсли;
		ИначеЕсли    (ВариантОтчета = "ОКУД0420869" ) Тогда
			ШаблонФайла		= ВариантОтчета + " на " + Формат(Отчет.ДатаОтчетности, "ДФ='dd MMMM yyyy'") + " " + Форма.НаименованиеГоловнойОрганизации;
		ИначеЕсли    (ВариантОтчета = "УведомлениеОВыявленииНарушений" ) ИЛИ  (ВариантОтчета = "УведомлениеОбУстраненииНарушений" ) Тогда
			ШаблонФайла		= ВариантОтчета +	" " + РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла( Строка(Отчет.СчетДоверительногоУправления ) +  " " + Формат(Отчет.ДатаОтчетности, "ДФ='dd.MM.yyyy'"));
		ИначеЕсли ВариантОтчета = "СООУРКИ028" Тогда
			ШаблонФайла		= "SOOURKI028_" + Формат(Отчет.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
			Версионирование = Ложь;
			
			Если СписокПечатныхФорм <> Неопределено Тогда
				
				ФлагОтчет       = Ложь;
				ФлагРасшифровка = Ложь;
				Для Каждого ВыбраннаяФорма Из СписокПечатныхФорм Цикл
					
					Если ВыбраннаяФорма.Представление = "Отчет" И ВыбраннаяФорма.Пометка Тогда

						ФлагОтчет = Истина;
						
					ИначеЕсли ВыбраннаяФорма.Представление = "Расшифровка" И ВыбраннаяФорма.Пометка Тогда	
						
						ФлагРасшифровка = Истина;
						
					КонецЕсли;	
						
				КонецЦикла;	
				Если ФлагРасшифровка И Не ФлагОтчет Тогда
					
					ШаблонФайла	= "SOOURKI028_Расшифровка_" + Формат(Отчет.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
				
				КонецЕсли;
				
			КонецЕсли;  
			
		ИначеЕсли ВариантОтчета = "ОКУД0420431" И ВидФайла = "docx" Тогда
	
			ШаблонФайла		= "PZ_" + ИННУК(Отчет.Организация) + "_" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
			Версионирование = Ложь;
			
		Иначе
			ШаблонФайла		= ВариантОтчета + " за " + Формат(Отчет.Период.ДатаОкончания, "ДФ='MMMM yyyy'") + " " + Форма.НаименованиеГоловнойОрганизации;
		КонецЕсли;
		
	ИначеЕсли ВидФайла = "xbrl" Тогда
		
		ИмяСхемы = ПолучитьИмяСхемыXBRL(Форма.ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.ПериодичностьОтчета, Отчет.Организация, Отчет.ТребуетсяПодтверждениеСпецДепа, Отчет.ВерсияТаксономии);
		
		ЧастиИмениФайла = Новый Массив;
		ЧастиИмениФайла.Добавить(ВариантОтчета);
		ЧастиИмениФайла.Добавить(Формат(Отчет.Период.ДатаОкончания, "ДФ='MMMM yyyy'"));
		ЧастиИмениФайла.Добавить(Строка(Отчет.Организация));
		
		Если Форма.Элементы.Клиент.Видимость Тогда
			ЧастиИмениФайла.Добавить(Строка(Отчет.Клиент));
		ИначеЕсли Форма.Элементы.СчетДоверительногоУправления.Видимость Тогда
			ЧастиИмениФайла.Добавить(РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(РаботаСОтчетами.КраткоеНаименованиеСубъектаДляИмениФайла(Отчет.СчетДоверительногоУправления)));
		КонецЕсли;
			
		ЧастиИмениФайла.Добавить("(" + ИмяСхемы + " Tax " + Отчет.ВерсияТаксономии + ")");

		ШаблонФайла = СтрСоединить(ЧастиИмениФайла, " ");
		ШаблонФайла = СтрЗаменить(ШаблонФайла, """", "");
		
	КонецЕсли;
	
	Если ВидФайла = "xtdd" 
	 ИЛИ ВидФайла = "pdf" 
	 ИЛИ ВидФайла = "xlsx" 
	 ИЛИ ВидФайла = "docx" Тогда
		
		ШаблонФайла = СтрЗаменить(ШаблонФайла, """", "");
		ШаблонФайла = СтрЗаменить(ШаблонФайла, "рыночных финансовых инструментов", "");
		ШаблонФайла = СтрЗаменить(ШаблонФайла, "долгосрочных прямых инвестиций", "");
		ШаблонФайла = СтрЗаменить(ШаблонФайла, "комбинированный", "");
		ШаблонФайла = СтрЗаменить(ШаблонФайла, "смешанных инвестиций", "");

	КонецЕсли;	
	
	ШаблонФайла	= РеквизитыКаталога.Путь + "\" + ШаблонФайла;
	
	Если Версионирование Тогда
		ИмяФайла =  ШаблонФайла + " ver." + Строка(Версия) + "." + Расширение;
		
		Если СтрДлина(ИмяФайла) > 255 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Длина файла " + ВидФайла + " превышает 255 символов. Формирование отчёта невозможно. " + ИмяФайла,,, "Отчет." + РеквизитыКаталога.Идентификатор);
			Возврат "";
		КонецЕсли;	
		
		ПроверяемыйФайл = Новый Файл(ИмяФайла);
		Пока ПроверяемыйФайл.Существует() Цикл
			Версия = Версия + 1;
			ИмяФайла =  ШаблонФайла + " ver." + Строка(Версия) + "." + Расширение;
			ПроверяемыйФайл = Новый Файл(ИмяФайла);
		КонецЦикла;
	Иначе
		ИмяФайла = ШаблонФайла + "." + Расширение;		
	КонецЕсли;
	
	Если СтрДлина(ИмяФайла) > 255 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Длина файла " + ВидФайла + " превышает 255 символов. Формирование отчёта невозможно. " + ИмяФайла,,, "Отчет." + РеквизитыКаталога.Идентификатор);
		Возврат "";
	КонецЕсли;	
		
	Возврат ИмяФайла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИННУК(Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ЮрФизЛицо) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ИНН = Выборка.ИНН;
		
	Иначе
		
		ТекстСообщения = СтрШаблон("Не удалось получить ИНН для организации %1", Организация);
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;	
	Возврат ИНН;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция КаталогСуществует(ИмяФайла)
	
	Отказ = Ложь;
	
	СохраняемыйФайл		= Новый Файл(ИмяФайла);
