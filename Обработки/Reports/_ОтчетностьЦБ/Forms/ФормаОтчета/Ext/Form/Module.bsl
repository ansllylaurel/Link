	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполинтьСписокПериодичности(ПериодичностьОтчета, СписокПериодичности, ВариантОтчета, ТочкиВхода, ДатаОтчетности, СчетДоверительногоУправления, Организация, ВерсияТаксономии)
	
	Если НЕ ЗначениеЗаполнено(ВерсияТаксономии) Тогда
		Возврат;
	КонецЕсли;
	
	МассивПериодичностей = Новый Массив;
	МассивПериодичностей.Добавить(Новый Структура("Значение, Представление, Пометка, Период", "ПоЗапросу",		"По запросу",	Ложь, ДатаОтчетности - 60 * 60 * 24));
	МассивПериодичностей.Добавить(Новый Структура("Значение, Представление, Пометка, Период", "Нерегулярная",	"Нерегулярная", Ложь, ДатаОтчетности - 60 * 60 * 24));
	МассивПериодичностей.Добавить(Новый Структура("Значение, Представление, Пометка, Период", "Месячная", 		"Месячная",		Ложь, КонецМесяца(ДобавитьМесяц(ДатаОтчетности, -1))));
	МассивПериодичностей.Добавить(Новый Структура("Значение, Представление, Пометка, Период", "Квартальная",	"Квартальная",	Ложь, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -3))));
	МассивПериодичностей.Добавить(Новый Структура("Значение, Представление, Пометка, Период", "Годовая", 		"Годовая",		Ложь, КонецГода(ДобавитьМесяц(ДатаОтчетности, -12))));
	
	ПериодичностьМесяц		= МассивПериодичностей[2];
	ПериодичностьКвартал	= МассивПериодичностей[3];

	ПараметрыПоиска = Новый Структура("ИмяПакета, Спецдеп, ВерсияТаксономии", ВариантОтчета, Ложь, ВерсияТаксономии);
	НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
	
	Если НЕ НайденныеСтроки.Количество() Тогда
		Возврат;
	КонецЕсли;	
	
	Если НайденныеСтроки.Количество() > 1 Тогда
		Для Каждого СтрокаТочкиВхода Из НайденныеСтроки Цикл
			Если ТипЗнч(СтрокаТочкиВхода.Малый) = Тип("Булево") Тогда
				ПараметрыПоиска.Вставить("Малый", ЭтоМалоеПредприятие(Организация, ДобавитьМесяц(ДатаОтчетности, -1))); 
				НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаТочкиВхода Из НайденныеСтроки Цикл
		Для Каждого Периодичность Из МассивПериодичностей Цикл
			Периодичность.Пометка = ЗначениеЗаполнено(СтрокаТочкиВхода[Периодичность.Значение]);
		КонецЦикла;
	КонецЦикла;
	
	Если ВариантОтчета = "ОКУД0420502" 
	   И ВерсияТаксономии >= "3_2"
	   И ПифПредназначенДляКвалИнвесторов(СчетДоверительногоУправления, ПериодичностьКвартал.Период) Тогда
		ПериодичностьМесяц.Пометка = Ложь;
	КонецЕсли;
	
	Если ПериодичностьМесяц.Пометка = Истина И ПериодичностьКвартал.Пометка = Истина Тогда
		ПериодичностьКвартал.Пометка = Ложь;
	КонецЕсли;
	
	СписокПериодичности.Очистить();
	
	Для Каждого Периодичность Из МассивПериодичностей Цикл
		Если Периодичность.Пометка Тогда
			СписокПериодичности.Добавить(Периодичность.Значение, Периодичность.Представление);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокПериодичности.Количество() И СписокПериодичности.НайтиПоЗначению(ПериодичностьОтчета) = Неопределено Тогда
		ПериодичностьОтчета = СписокПериодичности.Получить(СписокПериодичности.Количество() - 1).Значение;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполинтьСписокПериодичностиПоСпискуПериодов(ПериодичностьОтчета, СписокПериодичности, Период, СписокПериодов, ЕстьТочкаВходаПоЗапросу, ЕстьНерегулярнаяТочкаВхода)
	
	СписокПериодичности.Очистить();
	
	Периодичности = Новый Структура;
	Периодичности.Вставить("ПоЗапросу",		ЕстьТочкаВходаПоЗапросу);
	Периодичности.Вставить("Нерегулярная",	ЕстьНерегулярнаяТочкаВхода);
	Периодичности.Вставить("Месячная", 		Ложь);
	Периодичности.Вставить("Квартальная",	Ложь);
	Периодичности.Вставить("Годовая", 		Ложь);
	
	Для Каждого ЭлементСпискаПериодов Из СписокПериодов Цикл
		Периодичность = ПолучитьПериодичностьОтчетностиПоПериоду(ЭлементСпискаПериодов.Значение);
		Периодичности.Вставить(Периодичность, Истина);
	КонецЦикла;	
	
	Для Каждого ЭлементПериодичности Из Периодичности Цикл
		Если ЭлементПериодичности.Значение = Истина Тогда
			Если ЭлементПериодичности.Ключ = "ПоЗапросу" Тогда
				СписокПериодичности.Добавить(ЭлементПериодичности.Ключ, "По запросу");
			Иначе
				СписокПериодичности.Добавить(ЭлементПериодичности.Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ПериодичностьОтчета = ПолучитьПериодичностьОтчетностиПоПериоду(Период);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПифПредназначенДляКвалИнвесторов(СчетДоверительногоУправления, Период)
	
	Если НЕ ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",							Период);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПредназначенДляКвалИнвесторов, ЛОЖЬ) КАК ПредназначенДляКвалИнвесторов
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&Период, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.ПредназначенДляКвалИнвесторов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
