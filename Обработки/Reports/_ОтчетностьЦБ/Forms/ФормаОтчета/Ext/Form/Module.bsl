&НаСервереБезКонтекста
Функция ПолучитьОтчетностьЦБ(ВнешняяОбработка)
	
	Если ВнешняяОбработка Тогда
		ОтчетностьЦБ = ВнешниеОтчеты.Создать("_ОтчетностьЦБ");
	Иначе
		ОтчетностьЦБ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_ОтчетностьЦБ");
	КонецЕсли;
	
	Возврат ОтчетностьЦБ;
	
КонецФункции

#КонецОбласти


#Область ФункцииВидимостиРеквизитов

&НаКлиенте
Функция ВычислитьВидимостьРеквизита(Знач ИмяФункции)
	
	Инверсия  = Ложь;
	
	Если СтрНачинаетсяС(ИмяФункции, "#НЕ_") Тогда
		Инверсия = Истина;
		ИмяФункции = "#" + Сред(ИмяФункции, 5);
	КонецЕсли;
	
	Если ИмяФункции = "#ОбществоСостоитИзОдногоАкционера" Тогда
		РезультатФункции = ОбществоСостоитИзОдногоАкционера(Отчет.Организация);
		Элементы.НаименованиеУполномоченногоОргана.Заголовок = ?(РезультатФункции, "Полное наименование или ФИО единственного акционера", "Наименование органа, утвердившего повестку дня");
		
	ИначеЕсли ИмяФункции = "#ЕстьДействующиеДоговорыПНВОтчетномПериоде" Тогда
		РезультатФункции = ЕстьДействующиеДоговорыВОтчетномПериоде(Отчет.Организация, Отчет.Период, ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями"), ЭтаФорма.ВнешняяОбработка);
		
	ИначеЕсли ИмяФункции = "#ЕстьДействующиеДоговорыНаОтчетнуюДату" Тогда
		РезультатФункции = ЕстьДействующиеДоговорыНаОтчетнуюДату(Отчет.Организация, Отчет.Период, ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями"), ЭтаФорма.ВнешняяОбработка);
		
	ИначеЕсли ИмяФункции = "#ЕстьДействующиеДоговорыПФРВОтчетномПериоде" Тогда
		РезультатФункции = ЕстьДействующиеДоговорыВОтчетномПериоде(Отчет.Организация, Отчет.Период, ПредопределенноеЗначение("Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР"), ЭтаФорма.ВнешняяОбработка);
		
	ИначеЕсли СтрНачинаетсяС(ИмяФункции, "#НачинаяСТаксономии") Тогда
		РезультатФункции = Отчет.ВерсияТаксономии >= СтрЗаменить(ИмяФункции, "#НачинаяСТаксономии", "");
		
	ИначеЕсли СтрНачинаетсяС(ИмяФункции, "#НачинаяСДаты") Тогда
		РезультатФункции = Отчет.Период.ДатаОкончания >= Дата(СтрЗаменить(ИмяФункции, "#НачинаяСДаты", ""));
		
	ИначеЕсли СтрНачинаетсяС(ИмяФункции, "#ПериодичностьОтчетаВ") Тогда
		ПериодичностиОтчета = СтрРазделить(СтрЗаменить(ИмяФункции, "#ПериодичностьОтчетаВ", ""), "(),");
		РезультатФункции = (ПериодичностиОтчета.Найти(Отчет.ПериодичностьОтчета) <> Неопределено); 
		
	ИначеЕсли СтрНачинаетсяС(ИмяФункции, "#Отчет.") Тогда
		РезультатФункции = Отчет[СтрЗаменить(ИмяФункции, "#Отчет.", "")];
		
	Иначе
		ВызватьИсключение "Обнаружена неизвестная функция видимости: " + ИмяФункции;
		
	КонецЕсли;
	
	Если Инверсия = Истина Тогда
		Возврат НЕ РезультатФункции;
	Иначе
		Возврат РезультатФункции;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ОбществоСостоитИзОдногоАкционера(Организация)

	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ОбществоСостоитИзОдногоАкционера", Организация) = Истина; 
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьДействующиеДоговорыВОтчетномПериоде(Организация, Период, ВидДоговораДоверительногоУправления, ВнешняяОбработка)
	
	ОтчетностьЦБ = ПолучитьОтчетностьЦБ(ВнешняяОбработка);
	ОтчетностьЦБ.Организация = Организация;
	ОтчетностьЦБ.Период		 = Период;
	
	Возврат ОтчетностьЦБ.ЕстьДействующиеДоговорыВОтчетномПериоде(ВидДоговораДоверительногоУправления);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьДействующиеДоговорыНаОтчетнуюДату(Организация, Период, ВидДоговораДоверительногоУправления, ВнешняяОбработка)
	
	ОтчетностьЦБ = ПолучитьОтчетностьЦБ(ВнешняяОбработка);	
	ОтчетностьЦБ.Организация = Организация;
	ОтчетностьЦБ.Период		 = Период;
	
	Возврат ОтчетностьЦБ.ЕстьДействующиеДоговорыНаОтчетнуюДату(ВидДоговораДоверительногоУправления);
	
КонецФункции


#КонецОбласти


#Область НоваяМетодикаФормированияОтчётов

&НаКлиенте
Процедура СформироватьОтчеты(Отказ)
	
	МассивФайловОтчетов = Новый Массив;
	
	СформироватьОтчетыНаСервере(МассивФайловОтчетов, Отказ);
	
	Если НЕ Отказ Тогда
		Для Каждого ДанныеФайлаОтчета Из МассивФайловОтчетов Цикл
			Отчет.ТребуетсяПодтверждениеСпецДепа = ДанныеФайлаОтчета.ТребуетсяПодтверждениеСпецДепа;
			
			ДанныеОтчета	= ПолучитьИзВременногоХранилища(ДанныеФайлаОтчета.Адрес);
			ИмяФайла		= ПолучитьИмяФайла(ЭтаФорма, ДанныеФайлаОтчета.ИмяПакета, "xbrl");
			Если ЗначениеЗаполнено(ИмяФайла) И ЗначениеЗаполнено(ДанныеОтчета) Тогда
				ДанныеОтчета.Записать(ИмяФайла);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайла);
				УдалитьИзВременногоХранилища(ДанныеФайлаОтчета.Адрес);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетыНаСервере(МассивФайловОтчетов, Отказ)

	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессию("СерверноеВремяВыполнения.НоваяСхемаФормирования");	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если СтрНачинаетсяС(Отчет.ВариантОтчета, "ОКУД04204")
		И Отчет.ВыгружатьВXBRL Тогда
		
		СформироватьОтчетНаСервере(МассивФайловОтчетов, "SR_INFO", Запрос, Отказ);

	ИначеЕсли (СтрНачинаетсяС(Отчет.ВариантОтчета, "ОКУД04205") Или Отчет.ВариантОтчета = "ВладельцыИИСвПИФ")
		И Отчет.ВыгружатьВXBRL
		И Отчет.ВерсияТаксономии >= "4_2" Тогда
		
		Если НЕ Элементы.ПолучательВыгрузкиXBRL.Видимость ИЛИ Отчет.ПолучательВыгрузкиXBRL = 0 ИЛИ Отчет.ПолучательВыгрузкиXBRL = 2 Тогда
			Отчет.ТребуетсяПодтверждениеСпецДепа = Ложь;
			СформироватьОтчетНаСервере(МассивФайловОтчетов, "SR_SVED", Запрос, Отказ);
			
		КонецЕсли;
		
		Если Элементы.ПолучательВыгрузкиXBRL.Видимость И (Отчет.ПолучательВыгрузкиXBRL = 1 ИЛИ Отчет.ПолучательВыгрузкиXBRL = 2) Тогда
			Отчет.ТребуетсяПодтверждениеСпецДепа = Истина;
			СформироватьОтчетНаСервере(МассивФайловОтчетов, "SR_SVED", Запрос, Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчетНаСервере(МассивФайловОтчетов, ИмяПакета, Запрос, Отказ)
	
	ОтчетОбъект	= РеквизитФормыВЗначение("Отчет");
	ДанныеОтчета = ОтчетОбъект.ПолучитьДанные_XBRL(ИмяПакета, Запрос, , Отказ);
	
	Если НЕ Отказ Тогда
		ДанныеФайлаОтчета = Новый Структура;
		ДанныеФайлаОтчета.Вставить("ИмяПакета"	, ИмяПакета);
		ДанныеФайлаОтчета.Вставить("Адрес"		, ПоместитьВоВременноеХранилище(ДанныеОтчета, Новый УникальныйИдентификатор()));
		ДанныеФайлаОтчета.Вставить("ТребуетсяПодтверждениеСпецДепа"	, Отчет.ТребуетсяПодтверждениеСпецДепа);
		
		МассивФайловОтчетов.Добавить(ДанныеФайлаОтчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетыЗаПериод(Команда)
	
	ВыбПериод = ОткрытьФормуМодально("ОбщаяФорма.ВыборПериода", Новый Структура("Период"), ЭтаФорма);
	
	Если ВыбПериод <> КодВозвратаДиалога.Отмена И ВыбПериод <> Неопределено Тогда
		
		ИспользоватьВыбраннуюВерсиюТаксономии = Вопрос("Использовать выбранную версию таксономии " + Отчет.ВерсияТаксономии + " для всего выбранного периода?", РежимДиалогаВопрос.ДаНетОтмена);
		
		Если ИспользоватьВыбраннуюВерсиюТаксономии = КодВозвратаДиалога.Отмена Тогда
			Возврат;
		КонецЕсли;
		
		ВыбраннаяВерсияТаксономии = Отчет.ВерсияТаксономии;
		
		Если Элементы.Период.РежимВыбораИзСписка Тогда
			КоличествоЭлементов = Элементы.Период.СписокВыбора.Количество();
			Для Сч = 1 По КоличествоЭлементов Цикл
				Отчет.Период = Элементы.Период.СписокВыбора[КоличествоЭлементов - Сч].Значение;
				Если Отчет.Период.ДатаОкончания >= ВыбПериод.ДатаНачала И Отчет.Период.ДатаОкончания <= ВыбПериод.ДатаОкончания Тогда 
					ПериодПриИзменении(Элементы.Период);
					Отчет.ДатаОтчетности = Отчет.Период.ДатаОкончания;
					
					Если ИспользоватьВыбраннуюВерсиюТаксономии = КодВозвратаДиалога.Да Тогда
						Отчет.ВерсияТаксономии = ВыбраннаяВерсияТаксономии;
					КонецЕсли;
					
					КомандаСформировать(Команда);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Отчет.ДатаОтчетности = ВыбПериод.ДатаНачала;
			Пока Отчет.ДатаОтчетности < ВыбПериод.ДатаОкончания Цикл
				Отчет.ДатаОтчетности = ДобавитьМесяц(Отчет.ДатаОтчетности, 1);
				
				ДатаОтчетностиПриИзменении(Элементы.ДатаОтчетности);
				
				Если ИспользоватьВыбраннуюВерсиюТаксономии = КодВозвратаДиалога.Да Тогда
					Отчет.ВерсияТаксономии = ВыбраннаяВерсияТаксономии;
				КонецЕсли;
				
				КомандаСформировать(Команда);
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СборСтатистики

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ВариантРегистрации)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация",			Отчет.Организация);
	ПараметрыОтчета.Вставить("ВариантОтчета",		Отчет.ВариантОтчета);
	ПараметрыОтчета.Вставить("Период", 				Отчет.Период);
	ПараметрыОтчета.Вставить("ДатаОтчетности",		Отчет.ДатаОтчетности);
	ПараметрыОтчета.Вставить("ВерсияТаксономии", 	Отчет.ВерсияТаксономии);
	
	Для Каждого Реквизит Из ПолучитьСохраняемыеРеквизиты() Цикл
		ПараметрыОтчета.Вставить(Реквизит.Ключ, Отчет[Реквизит.Ключ]);
	КонецЦикла;
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыОтчета, Новый ФиксированнаяСтруктура(ПараметрыОтчета));
	
	Механизм = РеквизитФормыВЗначение("Отчет").Метаданные().ПолноеИмя() + "." + Отчет.ВариантОтчета + "." + ВариантРегистрации;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессииСбораСтатистики = Новый Структура;
	ПараметрыСессииСбораСтатистики.Вставить("Механизм", Механизм);
	ПараметрыСессииСбораСтатистики.Вставить("Сессия", 	Сессия);
		
	Возврат ПараметрыСессииСбораСтатистики;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики)

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики.Механизм, ПараметрыСессииСбораСтатистики.Сессия);	
	
КонецПроцедуры

#КонецОбласти

#Область СравнитьТекущееФормированиеССохраненнымОтчетом 
	
&НаКлиенте
Процедура СравнитьТекущееФормированиеССохраненнымОтчетом(Команда)
	
	Отказ = Ложь;
	
	ТочкаВхода = ПолучитьИмяСхемыXBRL(ЭтаФорма.ТочкиВхода, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.ПериодичностьОтчета, Отчет.Организация, Отчет.ТребуетсяПодтверждениеСпецДепа, Отчет.ВерсияТаксономии);
	СписокОтчетовXE = ПолучитьСписокОтчетовИзXE(Отчет.Организация, Отчет.СчетДоверительногоУправления, Отчет.Клиент, ВнешняяОбработка, Отчет.ВерсияТаксономии, Отчет.ПериодичностьОтчета, Отчет.ВариантОтчета, ТочкаВхода, Отчет.Период.ДатаОкончания, Ложь, Отказ);
	
	Если СписокОтчетовXE.Количество() = 0 Тогда
		ВыбранныйЭлемент = Неопределено;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В XE нет отчёта на отчётную дату");
		
	ИначеЕсли СписокОтчетовXE.Количество() = 1 Тогда
		ВыбранныйЭлемент = СписокОтчетовXE[0];
		
	Иначе
		ВыбранныйЭлемент = СписокОтчетовXE.ВыбратьЭлемент();
		
	КонецЕсли;
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПолучитьДанныеИзВнешнихИсточников();
		РезультатСравнения = ПолучитьРезультатСравненияССохраненнымОтчетом(Новый Структура("ДанныеФайла, ИмяФайла", ВыбранныйЭлемент.Значение, ВыбранныйЭлемент.Представление), , , , Отказ);
		Если РезультатСравнения <> Неопределено Тогда
			РезультатСравнения.ДокументРезультат.Показать();
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРезультатСравненияССохраненнымОтчетом(СохраненныйОтчет, Отборы = Неопределено, ДопПараметры = Неопределено, АдресФайлаСОтчетомВХранилище = Неопределено, Отказ)
	
	Если АдресФайлаСОтчетомВХранилище = Неопределено Тогда
		ПолучитьДанныеИзВнешнихИсточниковНаСервере(Отказ);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	// Для 432/523 формы данные берутся из документов ПоказателиОперационнойНадежности. Сразу приготовим запрос с нужными временными таблицами, вместо помещения массивов строк во временное хранилище
	ПоместитьДанныеВМенеджерЗапросаНаСервере(Запрос);
	
	
	Возврат РеквизитФормыВЗначение("Отчет").ПолучитьРезультатСравненияССохраненнымОтчетом(Запрос, Отчет.ВариантОтчета, СохраненныйОтчет, Отборы, ДопПараметры, АдресФайлаСОтчетомВХранилище, Отказ);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокОтчетовИзXE(Организация, СчетДоверительногоУправления, Клиент, ВнешняяОбработка, ВерсияТаксономии, ПериодичностьОтчета, ВариантОтчета, ТочкаВхода, ДатаОкончания, АвтоудалениеТестовых = Ложь, Отказ)
	
	ОтчетностьЦБ = ПолучитьОтчетностьЦБ(ВнешняяОбработка);	
	ОтчетностьЦБ.Период				 = Новый СтандартныйПериод(ДатаОкончания, ДатаОкончания);
	ОтчетностьЦБ.Организация		 = Организация;
	ОтчетностьЦБ.ВерсияТаксономии	 = ВерсияТаксономии;
	ОтчетностьЦБ.ВариантОтчета		 = ВариантОтчета;
	ОтчетностьЦБ.ПериодичностьОтчета = ПериодичностьОтчета;
	ОтчетностьЦБ.Клиент				 = Клиент;
	ОтчетностьЦБ.СчетДоверительногоУправления = СчетДоверительногоУправления;
	
	РазделыXBRL		= ОтчетностьЦБ.ПолучитьСписокРазделовОтчета(Отказ);
	УсловиеОтбора	= ОтчетностьЦБ.ПолучитьУсловиеОтбора(ВариантОтчета, Отказ);
	
	ОГРН = РаботаСНормативноСправочнойИнформацией.ПолучитьРеквизитыГоловнойОрганизации(Организация, ДатаОкончания, "ОГРН").ОГРН;
	
	Соединение		= РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(РаботаСВнешнимиСистемами.СтрокаСоединенияСXE());
	ТаблицаФайловXE = РаботаСВнешнимиСистемами.ПолучитьТаблицуФайловИзXE(Соединение, ВерсияТаксономии, ТочкаВхода, ОГРН, ДатаОкончания, РазделыXBRL, УсловиеОтбора, Истина);
	
	ТаблицаФайловXE.Сортировать("ДатаЗагрузки Убыв");
	
	СписокОтчетов = Новый СписокЗначений;
	
	Для Каждого СтрокаФайловXE Из ТаблицаФайловXE Цикл
		ФлагУдаления = ?(АвтоудалениеТестовых, СтрНайти(ВРег(СтрокаФайловXE.Примечание), "ТЕСТ") > 0, Ложь);
		Если Не ФлагУдаления Тогда
			СписокОтчетов.Добавить(СтрокаФайловXE.ДанныеXML, СтрШаблон("[%1] Примечание: %2 Дата загрузки: %3", Формат(СтрокаФайловXE.ИндентификаторОтчета, "ЧГ="), СтрокаФайловXE.Примечание, СтрокаФайловXE.ДатаЗагрузки));
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СписокОтчетов;
	
КонецФункции

&НаКлиенте
Процедура СравнитьОтчетСОтчетомПредыдущегоПериода(Команда)
	
	СравнитьТекущееФормированиеСОтчетомПредыдущегоПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура СравнитьТекущееФормированиеСОтчетомПредыдущегоПериода(ИмяФайлаСТекущимОтчетомXBRL = Неопределено)
	
	// 1. Получение точки входа отчета предыдущего периода
	// 2. Получение списка отчетов из XE. Если отчетов несколько, то взять отчет с максимальной датой загрузки. При этом фильтровать отчеты со словом "Тест" в названии.
	// 3. Сравнение отчетов и отправка результата
	
	Если АвтосравнениеСПредыдущимПериодом.НайтиПоЗначению(Отчет.ВариантОтчета) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Сверка с отчетом предыдущего периода для отчета %1 с периодичностью ""%2"" не используется!", Отчет.ВариантОтчета, Отчет.ПериодичностьОтчета));
		Возврат;
	КонецЕсли;	
	
	Отказ = Ложь;
	
	ПредыдущийПериод = ПредыдущийПериодОтчета(Отчет.Период, Отчет.ПериодичностьОтчета);
	
	ТочкаВходаПредыдущегоПериода = ПолучитьИмяСхемыXBRL(ЭтаФорма.ТочкиВхода, 
														Отчет.ВариантОтчета, 
														ПредыдущийПериод.ДатаОкончания, 
														Отчет.ПериодичностьОтчета, 
														Отчет.Организация, 
														Отчет.ТребуетсяПодтверждениеСпецДепа, 
														Отчет.ВерсияТаксономии);
														
	ФильтроватьТестовыеОтчеты = Истина;														
	СписокОтчетовXE = ПолучитьСписокОтчетовИзXE(Отчет.Организация, 
												Отчет.СчетДоверительногоУправления, 
												Отчет.Клиент, 
												ВнешняяОбработка, 
												Отчет.ВерсияТаксономии, 
												Отчет.ПериодичностьОтчета, 
												Отчет.ВариантОтчета, 
												ТочкаВходаПредыдущегоПериода, 
												ПредыдущийПериод.ДатаОкончания, 
												ФильтроватьТестовыеОтчеты, 
												Отказ);
	
	Если СписокОтчетовXE.Количество() = 0 Тогда
		ВыбранныйЭлемент = Неопределено;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В XE нет отчёта на отчётную дату");
		
	ИначеЕсли СписокОтчетовXE.Количество() = 1 Тогда
		ВыбранныйЭлемент = СписокОтчетовXE[0];
		
	Иначе
		ВыбранныйЭлемент = СписокОтчетовXE.ВыбратьЭлемент("Выберите с каким экземпляром отчета в XE произвести сравнение");
		
	КонецЕсли;
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПолучитьДанныеИзВнешнихИсточников();
		
		Отборы       = ОтборыДляСравненияОтчетов(Отчет);
		ДопПараметры = ДополнительныеПараметрыСравненияОтчетов(Отчет.Период, ПредыдущийПериод);
		
		АдресВХранилище = ?(Не ИмяФайлаСТекущимОтчетомXBRL = Неопределено, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаСТекущимОтчетомXBRL), ЭтаФорма.УникальныйИдентификатор), Неопределено);
		
		РезультатСравнения = ПолучитьРезультатСравненияССохраненнымОтчетом(Новый Структура("ДанныеФайла, ИмяФайла", ВыбранныйЭлемент.Значение, ВыбранныйЭлемент.Представление), 
																			Отборы, ДопПараметры, 
																			АдресВХранилище, 
																			Отказ);
		Если РезультатСравнения <> Неопределено Тогда
			СохранитьИОтправитьРезультатСравнения(РезультатСравнения.ДокументРезультат, ДопПараметры);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ДополнительныеПараметрыСравненияОтчетов(ПериодОтчета, ПредыдущийПериодОтчета)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("СравниватьРазныеТочкиВхода",           Истина);
	ДопПараметры.Вставить("КолонкиИсключенияПриСравненииОтчетов", КолонкиИсключенияПриСравненииОтчетов());
	ДопПараметры.Вставить("ВыводитьПериодОтчета",                 Истина);
	ДопПараметры.Вставить("Период",                               ПредставлениеПериода(ПериодОтчета.ДатаНачала, ПериодОтчета.ДатаОкончания));
	ДопПараметры.Вставить("ПредыдущийПериод",                     ПредставлениеПериода(ПредыдущийПериодОтчета.ДатаНачала, ПредыдущийПериодОтчета.ДатаОкончания));
	
	Возврат ДопПараметры;
	
КонецФункции	

&НаКлиенте
Процедура СохранитьИОтправитьРезультатСравнения(ОтчетОСравнении, ДопПараметры)
	
	РезультатПолученияИмениФайла = ИмяИПредставлениеФайлаСравненияОтчетаСОтчетомПредыдущегоПериода(ЭтаФорма, "xlsx");
	
	ИмяФайлаСравнения      = РезультатПолученияИмениФайла.ИмяФайла;
	ПредставленияСравнения = РезультатПолученияИмениФайла.Представление;
	
	// легенда для сравнения отчета с ним же предыдущего периода в XE отличается от легенды сравнения отчета с ним же в XE (возможно, пока)
	ОтчетОСравнении.Область(1, 1, 1, 1).Текст = ПредставленияСравнения;
	ОтчетОСравнении.Область(5, 1, 5, 1).Текст = "Текущий период";
	ОтчетОСравнении.Область(6, 1, 6, 1).Текст = "Предыдущий период";
	ОтчетОСравнении.Область(7, 1, 7, 1).Текст = "";
	
	Попытка
		ОтчетОСравнении.Записать(ИмяФайлаСравнения, ТипФайлаТабличногоДокумента.XLSX);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет о сравнении с отчетом предыдущего периода сохранён в файл: " + ИмяФайлаСравнения);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание: не удалось сохранить файл со сравнением отчета с отчетом за предыдущий период! Попробуйте еще раз.");
	КонецПопытки;	
	
	Попытка
		АдресВХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаСравнения), ЭтаФорма.УникальныйИдентификатор);
		СоздатьОповещенияНаСервере(АдресВХранилище, ПредставленияСравнения, ИмяФайлаСравнения, ДопПараметры);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание: не удалось создать оповещение о сравнении данных отчета!");
	КонецПопытки;	
	
КонецПроцедуры	

&НаСервере
Процедура СоздатьОповещенияНаСервере(АдресВХранилище, ПредставленияСравнения, ИмяФайлаСравнения, ДопПараметры)

	Вложения = Новый Соответствие;
	Вложения.Вставить(СтрШаблон("%1.xlsx", ПредставленияСравнения), ПолучитьИзВременногоХранилища(АдресВХранилище));
	
	РеквизитыОповещения = Новый Структура();								
	РеквизитыОповещения.Вставить("Вложения",	     Вложения);
	РеквизитыОповещения.Вставить("Организация",	     Отчет.Организация);
	РеквизитыОповещения.Вставить("ВариантОтчета",    Отчет.ВариантОтчета);
	РеквизитыОповещения.Вставить("Период",	         ДопПараметры.Период);
	РеквизитыОповещения.Вставить("ПредыдущийПериод", ДопПараметры.ПредыдущийПериод);
	РеквизитыОповещения.Вставить("Пользователь",	 ПараметрыСеанса.ТекущийПользователь);
	РеквизитыОповещения.Вставить("Тема",	         ПредставленияСравнения);
	
	ПолноеИмяИсточника = СтрШаблон("ВнешнийОтчет._ОтчетностьЦБ_Автоcравнение_%1_С_Предыдущим_Периодом", Отчет.ВариантОтчета);
	
	Попытка
		Справочники.Оповещения.СформироватьОповещения(ПолноеИмяИсточника, 
														Перечисления.ТипыСобытий.ВнешнийВызов, 
														РеквизитыОповещения);
	Исключение
		ОбщегоНазначения.ОбработатьИсключение(СтрШаблон("Ошибка выполнения оповещения '%1'.", ПолноеИмяИсточника), ИнформацияОбОшибке(), , Ложь);
	КонецПопытки;	

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяИПредставлениеФайлаСравненияОтчетаСОтчетомПредыдущегоПериода(Форма, ВидФайла, Расширение = "", ВыбранныйКаталог = "", Версионирование = Истина)

	Результат = Новый Структура("ИмяФайла, Представление", "", "");
	
	Отчет = Форма.Отчет;
	
	Если ВидФайла = "xlsx" Тогда
		
		РеквизитыКаталога = Новый Структура("Путь, Идентификатор, Синоним", Отчет.КаталогXBRL, "КаталогXBRL", "Каталог XBRL");
		Расширение = ВидФайла;
	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для вида файла " + ВидФайла + " настройки получения имени не определены!");
		Возврат Результат;
	КонецЕсли;
	
	//проверка каталога
	ПроверяемыйКаталог = Новый Файл(РеквизитыКаталога.Путь);
	Если НЕ ПроверяемыйКаталог.Существует() Тогда
		Если ЗначениеЗаполнено(РеквизитыКаталога.Идентификатор) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог указанный в поле """ + РеквизитыКаталога.Синоним + """ не обнаружен",,, "Отчет." + РеквизитыКаталога.Идентификатор);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Каталог """ + РеквизитыКаталога.Путь + """ не обнаружен");
		КонецЕсли;
			
		Возврат Результат;
	КонецЕсли;	
	
	ЧастиИмениФайла = ЧастиИмениФайлаСравнения(Отчет);
	
	ШаблонФайла = СтрСоединить(ЧастиИмениФайла, " ");
	
	Результат.Представление = ШаблонФайла;
	
	ШаблонФайла = СтрЗаменить(ШаблонФайла, """", "");
	ШаблонФайла = СтрЗаменить(ШаблонФайла, ":", "");
	
	ШаблонФайла	= РеквизитыКаталога.Путь + "\" + ШаблонФайла;
	
	Версия = 1;
	
	Если Версионирование Тогда
		ИмяФайла =  ШаблонФайла + " ver." + Строка(Версия) + "." + Расширение;
		
		Если СтрДлина(ИмяФайла) > 255 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Длина файла " + ВидФайла + " превышает 255 символов. Формирование отчёта невозможно. " + ИмяФайла,,, "Отчет." + РеквизитыКаталога.Идентификатор);
			Возврат "";
		КонецЕсли;	
		
		ПроверяемыйФайл = Новый Файл(ИмяФайла);
		Пока ПроверяемыйФайл.Существует() Цикл
			Версия = Версия + 1;
			ИмяФайла =  ШаблонФайла + " ver." + Строка(Версия) + "." + Расширение;
			ПроверяемыйФайл = Новый Файл(ИмяФайла);
		КонецЦикла;
	Иначе
		ИмяФайла = ШаблонФайла + "." + Расширение;		
	КонецЕсли;
	
	Если СтрДлина(ИмяФайла) > 255 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Длина файла " + ВидФайла + " превышает 255 символов. Формирование отчёта о сравнении невозможно. " + ИмяФайла,,, "Отчет." + РеквизитыКаталога.Идентификатор);
		Возврат Результат;
	КонецЕсли;	
	
	Результат.ИмяФайла = ИмяФайла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧастиИмениФайлаСравнения(Отчет)
	
	ЧастиИмениФайла = Новый Массив;
	
	Если Отчет.ВариантОтчета = "ОКУД0420501" Тогда
		
		ЧастиИмениФайла.Добавить("Сравнение раздела ""Суды"" формы 501 за периоды:");
		ЧастиИмениФайла.Добавить(Формат(Отчет.Период.ДатаОкончания, "ДФ=MM.yyyy"));
		ЧастиИмениФайла.Добавить("и");
		ЧастиИмениФайла.Добавить(Формат(ПредыдущийПериодОтчета(Отчет.Период, Отчет.ПериодичностьОтчета).ДатаОкончания, "ДФ=MM.yyyy"));
		ЧастиИмениФайла.Добавить(Строка(Отчет.Организация));
		
	Иначе
		
		ЧастиИмениФайла.Добавить("Сравнение отчета");
		ЧастиИмениФайла.Добавить(Отчет.ВариантОтчета);
		ЧастиИмениФайла.Добавить("за");
		ЧастиИмениФайла.Добавить(Формат(Отчет.Период.ДатаОкончания, "ДФ='MMMM yyyy'"));
		ЧастиИмениФайла.Добавить("с сохраненным в XE отчетом за");
		ЧастиИмениФайла.Добавить(Формат(ПредыдущийПериодОтчета(Отчет.Период, Отчет.ПериодичностьОтчета).ДатаОкончания, "ДФ='MMMM yyyy'"));
		ЧастиИмениФайла.Добавить(Строка(Отчет.Организация));
		
	КонецЕсли;
	Возврат ЧастиИмениФайла;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ОтборыДляСравненияОтчетов(Отчет)
	
	Отборы  = Новый Структура;
	Разделы = Новый Массив;
	Если Отчет.ВариантОтчета = "ОКУД0420501" Тогда
		
		Разделы.Добавить("sr_0420501_r14");
		
	КонецЕсли;
	Если Разделы.Количество() Тогда
		Отборы.Вставить("Разделы", Разделы);
	КонецЕсли;	
	Возврат Отборы;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция КолонкиИсключенияПриСравненииОтчетов()
	
	КолонкиИсключения = Новый Массив;
	КолонкиИсключения.Добавить("Date_From");
	КолонкиИсключения.Добавить("Date_To");
	
	Возврат КолонкиИсключения;

КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ПредыдущийПериодОтчета(Период, Периодичность)
	
	НовыйПериод = Новый СтандартныйПериод;
	
	Если Периодичность = "Месячная" Тогда
		НовыйПериод.ДатаНачала    = НачалоМесяца(ДобавитьМесяц(Период.ДатаНачала, -1));	
		НовыйПериод.ДатаОкончания = КонецМесяца(ДобавитьМесяц(Период.ДатаНачала, -1));	
	ИначеЕсли Периодичность = "Квартальная" Тогда	
		НовыйПериод.ДатаНачала    = НачалоКвартала(ДобавитьМесяц(Период.ДатаНачала, -3));	
		НовыйПериод.ДатаОкончания = КонецКвартала(ДобавитьМесяц(Период.ДатаНачала, -3));	
	ИначеЕсли Периодичность = "Годовая" Тогда	
		НовыйПериод.ДатаНачала    = НачалоГода(ДобавитьМесяц(Период.ДатаНачала, -12));	
		НовыйПериод.ДатаОкончания = КонецГода(ДобавитьМесяц(Период.ДатаНачала, -12));	
	Иначе
		НовыйПериод = Период;
	КонецЕсли;	
	Возврат НовыйПериод;
	
КонецФункции	

&НаКлиенте
Процедура ОткрытьВизуализаторТочкиВхода(Команда)
	
	Визуализатор  = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ВизуализацияСтруктурыТочкиВхода");
	ИмяОбработки  = РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(Визуализатор);
	             
	ПараметрыФормы = ПараметрыФормыВизуализатора();
	
	ЗагрузитьМакетXSDСхемыXBRL(Отчет.ВариантОтчета);
	
	ИмяФайлаXSDСхемы = ПолучитьИмяВременногоФайла("xsd");
	МакетXSDСхемыXBRL.Записать(ИмяФайлаXSDСхемы);
	
	ПараметрыФормы.Вставить("ИмяФайла", ИмяФайлаXSDСхемы);
	
	ОткрытьФорму(СтрШаблон("ВнешняяОбработка.%1.Форма", ИмяОбработки), ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыФормыВизуализатора()
	
	ПараметрыФормы = Новый Структура;
	
	РазделыОтчета = РеквизитФормыВЗначение("Отчет").РазделыОтчетаXBRL(Отчет.ВариантОтчета);
	
	ВнешнийФильтр = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из РазделыОтчета Цикл
		ВнешнийФильтр.Добавить(ВРег(СтрокаТаблицы.ИмяРаздела));	
	КонецЦикла;	
	
	// Добавление "общих" имен разделов
	ВнешнийФильтр.Добавить(ВРег("sr_sved_otch_org_inf_ob_otch"));	
	ВнешнийФильтр.Добавить(ВРег("sr_sved_otch_org_otv_predm_obl"));	
	ВнешнийФильтр.Добавить(ВРег("sr_sved_otch_org_podpisant"));	
	ВнешнийФильтр.Добавить(ВРег("sr_sved_otch_org_uk"));	
	ВнешнийФильтр.Добавить(ВРег("SR_INFO"));	
	ВнешнийФильтр.Добавить(ВРег("SR_Sved_ObOtchOrg_OtvLicza"));	
	
	ПараметрыФормы.Вставить("ВнешнийФильтр", ВнешнийФильтр);
	
	Возврат ПараметрыФормы;
	
КонецФункции	

