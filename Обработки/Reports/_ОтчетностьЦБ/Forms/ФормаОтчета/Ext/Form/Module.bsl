Процедура ВариантФормированияПоСчетамДУПриИзменении(Элемент)
	
	ВидимостьРеквизитов();
	
КонецПроцедуры

#КонецОбласти

#Область РасшифровкаЯчейкиОтчета_ОКУД0420507

&НаКлиенте
Процедура РезультатВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если Не Отчет.ВариантОтчета = "ОКУД0420507" Тогда
		Возврат;
	КонецЕсли;
	
	ТекОбласть = Элемент.ТекущаяОбласть.Имя;
	
	НайдНомерКолонки = СтрНайти(ТекОбласть, "C");
	Если НайдНомерКолонки = 0 Тогда
		Сообщить("Неверное имя ячейки");
		Возврат;
	КонецЕсли;
	
	// Если выбран диапазон ячеек, тоже исключаем
	Если СтрНайти(ТекОбласть, ":") > 0 Тогда
		Сообщить("Для данной ячейки расшифровка отсутствует!");
		Возврат;
	КонецЕсли;
	
	НомерСтроки		= Число(Сред(ТекОбласть, 2, НайдНомерКолонки - 2));
	НомерКолонки	= Число(Сред(ТекОбласть, НайдНомерКолонки + 1));
	
	Если Не(НомерСтроки >= 11 И НомерКолонки >= 11) Тогда
		Сообщить("Для данной ячейки расшифровка отсутствует!");
		Возврат;	
	КонецЕсли;
	
	Если НомерКолонки >= 19 Тогда
		Сообщить("Для данной ячейки расшифровка отсутствует!");
		Возврат;	
	КонецЕсли;
	
	НомерСчетаДУ = "";
	ЯчейкаНомераСчетаДУ = ЭтаФорма.Результат.Область(НомерСтроки, 7, НомерСтроки, 7);
	НомерСчетаДУ 		= СокрЛП(ЯчейкаНомераСчетаДУ.Текст);
	
	ИмяФормыРасшифровки = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".", НаправлениеПоиска.СКонца)) + "ФормаРасшифровки";
	ФормаРасшифровки = ПолучитьФорму(ИмяФормыРасшифровки, , ЭтаФорма);  
		
	ТабДокумент = СформироватьРасшифровкуНаСервере(НомерСчетаДУ, НомерКолонки);
	
	ФормаРасшифровки.Расшифровка = ТабДокумент;
	
	Если Не ФормаРасшифровки.Открыта() Тогда
		ФормаРасшифровки.Открыть();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьРасшифровкуНаСервере(НомерСчетаДУ, НомерКолонки)
	
	Отказ = Ложь;
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ВыборкаРасшифровки = ОтчетОбъект.ПолучитьВыборкуРасшифровкиЯчейки(НомерСчетаДУ, НомерКолонки, Отказ);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = ОтчетОбъект.ПолучитьМакет("РасшифровкаЯчейки");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапкаНачало 			= Макет.ПолучитьОбласть("Шапка|Начало");
	ОбластьШапкаСумма 			= Макет.ПолучитьОбласть("Шапка|Сумма");
	
	ОбластьСтрокаНачало 		= Макет.ПолучитьОбласть("Строка|Начало");
	ОбластьСтрокаСумма 			= Макет.ПолучитьОбласть("Строка|Сумма");
	
	ОбластьПодвалНачало 		= Макет.ПолучитьОбласть("Подвал|Начало");
	ОбластьПодвалСумма 			= Макет.ПолучитьОбласть("Подвал|Сумма");
		
	ЕстьЦБ = Ложь;
	Если НомерКолонки = 11 Тогда	
		ЕстьЦБ = Истина;
	КонецЕсли;	
	
	Если ЕстьЦБ Тогда
		ТабДокумент.Вывести(ОбластьШапка);
	Иначе	
		ТабДокумент.Вывести(ОбластьШапкаНачало);
		ТабДокумент.Присоединить(ОбластьШапкаСумма);
	КонецЕсли;
	
	Если ВыборкаРасшифровки.Следующий() Тогда // Строка итогов
		СуммаИтого = ВыборкаРасшифровки.Сумма; 		
	КонецЕсли;
	
	Пока ВыборкаРасшифровки.Следующий() Цикл
		Если ЕстьЦБ Тогда
			ОбластьСтрока.Параметры.Заполнить(ВыборкаРасшифровки);
			ТабДокумент.Вывести(ОбластьСтрока);
		Иначе
			ОбластьСтрокаНачало.Параметры.Заполнить(ВыборкаРасшифровки);
			ТабДокумент.Вывести(ОбластьСтрокаНачало);
			ОбластьСтрокаСумма.Параметры.Заполнить(ВыборкаРасшифровки);
			ТабДокумент.Присоединить(ОбластьСтрокаСумма);
		КонецЕсли;	
	КонецЦикла;
	
	Если ЕстьЦБ Тогда
		ОбластьПодвал.Параметры.Сумма = СуммаИтого;	
		ТабДокумент.Вывести(ОбластьПодвал);
	Иначе
		ТабДокумент.Вывести(ОбластьПодвалНачало);
		ОбластьПодвалСумма.Параметры.Сумма = СуммаИтого;	
		ТабДокумент.Присоединить(ОбластьПодвалСумма);	
	КонецЕсли;
	
	ТабДокумент.ТолькоПросмотр = Истина;
	                  
	Возврат ТабДокумент;
	
КонецФункции 

#КонецОбласти

#Область ЗаполнениеНастроек

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	
	Если НЕ ЭтаФорма.ВнешняяОбработка И ЭтаФорма.ВерсияДополнительногоОтчетаИлиОбработки <> АктуальнаяВерсияОбработки() Тогда
		ПоказатьПредупреждение(, "Версия Отчётности ЦБ обновилась. Перезапустите Отчётность ЦБ!");
		Возврат;
	КонецЕсли;
	
	СохранитьДанныеВНастройки();
	
	ЗаполнениеНастроек();
	
	Отчет.СчетДоверительногоУправления = "";
	
	ВосстановитьДанныеИзНастроек(Отчет.ВариантОтчета);
	
	ВидимостьРеквизитов();
	
	ЭтаФорма.ВедетсяУчетОтветственных = ПолучитьВедетсяУчетОтветственных(Отчет.Организация, Отчет.ВариантОтчета);
	Если ЭтаФорма.ВедетсяУчетОтветственных И ВидимостьРеквизита("Ответственный", Элементы) Тогда 
		Отчет.Ответственный = ПолучитьОтветственноеЛицо(Отчет.Организация, Отчет.ВариантОтчета);
		ЗаполнитьРеквизитыСотрудников(ЭтаФорма, Элементы.Ответственный);
	КонецЕсли;
	
	ОчиститьНеиспользуемыеРеквизиты();
	ВариантОтчетаПриИзменении("");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеНастроекПриПервомЗапуске()
	
	Отчет.УникальныйИдентификаторФормы = ЭтаФорма.УникальныйИдентификатор;
	
	ЗаполнениеНастроек();
	
	Если ПустаяСтрока(Отчет.ВариантФормированияПоСчетамДУ) Тогда
		Отчет.ВариантФормированияПоСчетамДУ = "ПоСчетуДУ";
	КонецЕсли;
	
	ПолныеПрава = РаботаСПользователями.РолиДоступны("ПолныеПрава");
	
	Отчет.ТестовыйРежим = Мин(Ложь, ПолныеПрава);
	Элементы.ФормаСравнениеВерсийТаксономии.Видимость                      = ПолныеПрава;
	Элементы.ФормаСравнитьОтчетСОтчетомПредыдущегоПериода.Видимость        = ПолныеПрава;
	
	Элементы.ВерсияТаксономии.ТолькоПросмотр = НЕ ПолныеПрава;
	
	Для Каждого ЗначениеПеречисления Из Перечисления.ВидыОтчетностиПодлежащиеАудиторскойПроверке Цикл
		Отчет.ВидыОтчетностиПодлежащиеАудиторскойПроверке.Добавить(ЗначениеПеречисления);
	КонецЦикла;
	
	ЗаголовкиПоУмолчанию = Новый Структура;
	Для Каждого Элемент Из Элементы Цикл
		ЗаголовкиПоУмолчанию.Вставить(Элемент.Имя, Элемент.Заголовок);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВариантаОтчета()
	
	Элементы.ВариантОтчета.СписокВыбора.Очистить();
	
	Для Каждого НастройкаВидимости Из НастройкиВидимостиРеквизитов Цикл
		Элементы.ВариантОтчета.СписокВыбора.Добавить(НастройкаВидимости.Ключ, НастройкаВидимости.Значение.Представление);
		НастройкаВидимости.Значение.Удалить("Представление");
	КонецЦикла;
	
	Если Элементы.ВариантОтчета.СписокВыбора.НайтиПоЗначению(Отчет.ВариантОтчета) = Неопределено Тогда
		Отчет.ВариантОтчета = Элементы.ВариантОтчета.СписокВыбора[0].Значение;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеНастроек()
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	
	РеквизитФормыОтчет = РеквизитФормыВЗначение("Отчет");
	ЭтаФорма.ТочкиВхода.Загрузить(РеквизитФормыОтчет.ПолучитьТочкиВхода());
	НастройкиВидимостиРеквизитов = РеквизитФормыОтчет.ПолучитьНастройкиВидимостиРеквизитов();
	МассивРеквизитовБулево = РеквизитФормыОтчет.ПолучитьМассивРеквизитовБулево();
	ЗаполнитьСписокВыбораВариантаОтчета();
	РеквизитФормыОтчет.ЗаполнитьСписокВерсийТаксономии(Элементы.ВерсияТаксономии.СписокВыбора);
	
	Отчет.ЭтоРЭМ		= (Отчет.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Отчет.ЭтоРПИ		= (Отчет.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ"));
	Отчет.ЭтоТраст		= (Отчет.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	Отчет.ЭтоМДТраст	= (Отчет.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст"));
	Отчет.ЭтоДК			= (Отчет.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));
	
	Отчет.ВалютаУчета = Отчет.Организация.ВалютаУчета;
	
	НаименованиеГоловнойОрганизации = ПолучитьНаименованиеГоловнойОрганизации();
	
	Отчет.ДатаОтчетности = ТекущаяДата();
	
	Для Каждого ИмяЭлементаСотрудника Из ПолучитьИменаЭлементовСотрудников() Цикл	
		Отчет[ИмяЭлементаСотрудника] = Неопределено;
	КонецЦикла;
	
	ЭтаФорма.ВедетсяУчетДолжностыхЛиц = ПолучитьВедетсяУчетДолжностыхЛиц(Отчет.Организация);
	Если ЭтаФорма.ВедетсяУчетДолжностыхЛиц Тогда
		ДолжностныеЛица = ПолучитьДолжностныеЛица(Отчет.Организация);
		ЗаполнитьЗначенияСвойств(Отчет, ДолжностныеЛица);
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ДолжностныеЛица);
		ПоместитьДанныеФайловПриказаИДоверенностиВоВременноеХранилище(ЭтаФорма, ДолжностныеЛица);
	КонецЕсли;
	ОбновитьВидимостьДоверенностиИОРуководителя(ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМакетОтчета(ВнешняяОбработка, ИмяМакета)
	
	ОтчетностьЦБ = ПолучитьОтчетностьЦБ(ВнешняяОбработка);	
	
	Возврат ОтчетностьЦБ.ПолучитьМакет(ИмяМакета);
	
КонецФункции

#КонецОбласти

#Область РаботаСДатамиОтчёта

&НаСервереБезКонтекста
Процедура УстановитьПериодОтчетаПоУмолчанию(ВариантОтчета, Период, ДатаОтчетности, ПериодичностьОтчета, ПериодИспользуется)
	
	Если НЕ ЗначениеЗаполнено(ДатаОтчетности) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПериодИспользуется Тогда 
		Период.ДатаНачала	   	= ДатаОтчетности;
		Период.ДатаОкончания	= ДатаОтчетности;
		
	ИначеЕсли ВариантОтчета = "ВладельцыИИСвПИФ" Тогда
		Если ПериодичностьОтчета = "Нерегулярная" Тогда
			Период.ДатаНачала		= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаОтчетности, -3);
			Период.ДатаОкончания	= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаОтчетности, -2);
			
		ИначеЕсли ПериодичностьОтчета = "Квартальная" Тогда	
			Период.ДатаНачала		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -4)));
			Период.ДатаОкончания	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -1)));
			
		КонецЕсли;
		
	ИначеЕсли ВариантОтчета = "ОКУД0420502" Тогда
		Если ПериодичностьОтчета = "Нерегулярная" ИЛИ ПериодичностьОтчета = "ПоЗапросу" Тогда
			Период.ДатаНачала		= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаОтчетности, -3);
			Период.ДатаОкончания	= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаОтчетности, -2);
			
		ИначеЕсли ПериодичностьОтчета = "Квартальная" Тогда	
			Период.ДатаНачала		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -4)));
			Период.ДатаОкончания	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -1)));
			
		ИначеЕсли ПериодичностьОтчета = "Месячная" Тогда	
			Период.ДатаНачала		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(ДатаОтчетности, -2)));
			Период.ДатаОкончания	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(ДатаОтчетности, -1)));
			
		КонецЕсли;
		
	ИначеЕсли ВариантОтчета = "ОКУД0420503" Тогда
		Если ПериодичностьОтчета = "Нерегулярная" ИЛИ ПериодичностьОтчета = "ПоЗапросу" Тогда
			Период.ДатаНачала		= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаОтчетности, -2);
			Период.ДатаОкончания	= Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ДатаОтчетности, -2);
			
		ИначеЕсли ПериодичностьОтчета = "Месячная" Тогда	
			Период.ДатаНачала		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(ДатаОтчетности, -2))) + 60 * 60 * 24;
			Период.ДатаОкончания	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(ДобавитьМесяц(ДатаОтчетности, -1)));
			
		КонецЕсли;
		
	ИначеЕсли ВариантОтчета = "ОКУД0420506" ИЛИ ВариантОтчета = "ОКУД0420507" Тогда		
		Период.ДатаОкончания = КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -3));                                    
		Период.ДатаНачала    = НачалоГода(ДобавитьМесяц(ДатаОтчетности, -3));
		
	ИначеЕсли ВариантОтчета = "ОКУД0420512" ИЛИ ВариантОтчета = "ОКУД0420513" Тогда
		Период.ДатаНачала		= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -6))) + 60 * 60 * 24;
		Период.ДатаОкончания	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -3)));
		
		Если Период.ДатаОкончания >= Дата(2018,12,29) Тогда			
			Период.ДатаОкончания = КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -3));
		КонецЕсли;
		
		Если Период.ДатаОкончания >= Дата(2019,1,1) Тогда
			Период.ДатаНачала = НачалоКвартала(ДобавитьМесяц(ДатаОтчетности, -3));
		КонецЕсли;
		
	ИначеЕсли ПериодичностьОтчета = "Нерегулярная" ИЛИ ПериодичностьОтчета = "ПоЗапросу" Тогда
		Период.ДатаНачала	   	= ДатаОтчетности;
		Период.ДатаОкончания	= ДатаОтчетности;
		
	ИначеЕсли ПериодичностьОтчета = "Квартальная" Тогда	
		Период.ДатаНачала		= НачалоКвартала(ДобавитьМесяц(ДатаОтчетности, -1));
		Период.ДатаОкончания	= КонецКвартала(ДобавитьМесяц(ДатаОтчетности, -1));
		
	ИначеЕсли ПериодичностьОтчета = "Годовая" Тогда	
		Период.ДатаНачала		= НачалоГода(ДобавитьМесяц(ДатаОтчетности, -3));
		Период.ДатаОкончания	= КонецГода(ДобавитьМесяц(ДатаОтчетности, -3));
		
	Иначе	
		Период.ДатаНачала		= НачалоМесяца(ДобавитьМесяц(ДатаОтчетности, -1));
		Период.ДатаОкончания	= КонецМесяца(ДобавитьМесяц(ДатаОтчетности, -1));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция КонтрольКорректностиДат()
	
	Отказ = Ложь;
	ДатаНачалаСдачиОтчетности = Дата(2017, 1, 1);
	
	Если Отчет.ДатаОтчетности < ДатаНачалаСдачиОтчетности Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неврно указана дата отчётности. Дата не может быть меньше " + Формат(ДатаНачалаСдачиОтчетности, "ДФ=dd.MM.yyyy"),,, "Отчет.ДатаОтчетности", Отказ);
	КонецЕсли;
	
	Если Элементы.Период.Видимость Тогда
		Если Отчет.Период.ДатаНачала < ДатаНачалаСдачиОтчетности 
		 ИЛИ Отчет.Период.ДатаОкончания < ДатаНачалаСдачиОтчетности Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неврно указан период отчётности. Дата не может быть меньше " + Формат(ДатаНачалаСдачиОтчетности, "ДФ=dd.MM.yyyy"),,, "Отчет.Период", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.Период.Видимость И Отчет.Период.ДатаОкончания < Отчет.Период.ДатаНачала Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания периода не должна быть меньше даты начала периода!", , , "Отчет.Период", Отказ);
	КонецЕсли;	
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура УстановитьСписокПериодов()
	
	Элементы.Период.СписокВыбора.Очистить();

	ДатаОкончания		= КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));

	ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, ДатаОкончания, Отчет.Организация);
	
	ЕстьНерегулярнаяТочкаВхода = Ложь;
	ЕстьТочкаВходаПоЗапросу = Ложь;
	
	Пока ЗначениеЗаполнено(ВерсияТаксономии) Цикл
		
		ПараметрыПоиска = Новый Структура("ИмяПакета, ВерсияТаксономии", Отчет.ВариантОтчета, ВерсияТаксономии);
		НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			Для Каждого СтрокаТочкиВхода Из НайденныеСтроки Цикл
				Если ТипЗнч(СтрокаТочкиВхода.Малый) = Тип("Булево") Тогда
					ПараметрыПоиска.Вставить("Малый", ЭтоМалоеПредприятие(Отчет.Организация, ДатаОкончания)); 
					НайденныеСтроки = ТочкиВхода.НайтиСтроки(ПараметрыПоиска);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НайденныеСтроки.Количество() Тогда
			ЕстьНерегулярнаяТочкаВхода			= Макс(ЕстьНерегулярнаяТочкаВхода, ЗначениеЗаполнено(НайденныеСтроки[0].Нерегулярная));
			ЕстьТочкаВходаПоЗапросу				= Макс(ЕстьТочкаВходаПоЗапросу, ЗначениеЗаполнено(НайденныеСтроки[0].ПоЗапросу));
			НаКонецКварталаПериодичностьКвартал = (Отчет.ВариантОтчета = "ОКУД0420431" И ПараметрыПоиска.Малый И ДатаОкончания < Дата(2025, 1, 1));
			
			Если ЗначениеЗаполнено(НайденныеСтроки[0].Годовая) И ДатаОкончания = КонецГода(ДатаОкончания) Тогда
				Элементы.Период.СписокВыбора.Добавить(Новый СтандартныйПериод(НачалоГода(ДатаОкончания), ДатаОкончания), ПредставлениеПериода(НачалоГода(ДатаОкончания), ДатаОкончания));
			КонецЕсли;
			
			Если НаКонецКварталаПериодичностьКвартал И ЗначениеЗаполнено(НайденныеСтроки[0].Квартальная) И ДатаОкончания = КонецКвартала(ДатаОкончания) Тогда
			    Элементы.Период.СписокВыбора.Добавить(Новый СтандартныйПериод(НачалоКвартала(ДатаОкончания), ДатаОкончания), ПредставлениеПериода(НачалоКвартала(ДатаОкончания), ДатаОкончания));
			ИначеЕсли ЗначениеЗаполнено(НайденныеСтроки[0].Месячная)  Тогда
				Элементы.Период.СписокВыбора.Добавить(Новый СтандартныйПериод(НачалоМесяца(ДатаОкончания), ДатаОкончания), ПредставлениеПериода(НачалоМесяца(ДатаОкончания), ДатаОкончания));
			ИначеЕсли ЗначениеЗаполнено(НайденныеСтроки[0].Квартальная) И ДатаОкончания = КонецКвартала(ДатаОкончания)  Тогда
				Элементы.Период.СписокВыбора.Добавить(Новый СтандартныйПериод(НачалоКвартала(ДатаОкончания), ДатаОкончания), ПредставлениеПериода(НачалоКвартала(ДатаОкончания), ДатаОкончания));
			КонецЕсли;
		КонецЕсли;
			
		ДатаОкончания		= КонецМесяца(ДобавитьМесяц(ДатаОкончания, -1));
		ВерсияТаксономии	= ПолучитьВерсиюТаксономии(ТочкиВхода, Отчет.ВариантОтчета, ДатаОкончания, Отчет.Организация);
	КонецЦикла;
	
	МассивОшибок = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Если МассивОшибок.Найти(Сообщение.Текст) = Неопределено Тогда
			МассивОшибок.Добавить(Сообщение.Текст);
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого ТекстОшибки Из МассивОшибок Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДляПериодаИспользуетсяСписокВыбора(ВариантОтчета)
	
	Если ВариантОтчета = "ОКУД0420011" Или ВариантОтчета = "ОКУД0420523"
		ИЛИ (СтрНачинаетсяС(ВариантОтчета, "ОКУД04204")
			И НЕ ВариантОтчета = "ОКУД0420406"
			И НЕ ВариантОтчета = "ОКУД0420419")	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПериодичностьОтчетностиПоПериоду(Период)
	
	Периодичность = "";
	
	Если Период.ДатаНачала = НачалоМесяца(Период.ДатаОкончания)
		И Период.ДатаОкончания = КонецМесяца(Период.ДатаОкончания) Тогда
		Периодичность = "Месячная";
		
	ИначеЕсли Период.ДатаНачала = НачалоКвартала(Период.ДатаОкончания)
		И Период.ДатаОкончания = КонецКвартала(Период.ДатаОкончания) Тогда
		Периодичность = "Квартальная";

	ИначеЕсли Период.ДатаНачала = НачалоГода(Период.ДатаОкончания)
		И Период.ДатаОкончания = КонецГода(Период.ДатаОкончания) Тогда
		Периодичность = "Годовая";
	Иначе
		Периодичность = "Нерегулярная";
	КонецЕсли;
	
	Возврат Периодичность;
	
КонецФункции

#КонецОбласти

#Область ДополнительныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокАвтосравненияОтчетовНаСервере()
	
