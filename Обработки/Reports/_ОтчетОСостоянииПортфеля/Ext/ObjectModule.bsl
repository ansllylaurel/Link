	Запрос.УстановитьПараметр("СписокСчетовРезервов",			СписокСчетовРезервов);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();	
КонецФункции

Функция ПолучитьТаблицуРезервовПодОбесценение()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
		|			ТОГДА ""Депозит""
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|				И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = НЕОПРЕДЕЛЕНО
		|			ТОГДА ""ДС на РС""
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|				И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 <> НЕОПРЕДЕЛЕНО
		|			ТОГДА ВЫБОР
		|					КОГДА КОНЕЦПЕРИОДА(ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.МНО).Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&ПериодДата, ДЕНЬ)
		|						ТОГДА ""ДС на РС""
		|					ИНАЧЕ ""МНО""
		|				КОНЕЦ
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07)
		|			ТОГДА ""ДС на БС""
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10)
		|			ТОГДА ""ДС на КС""
		|	КОНЕЦ КАК ВидРезерва,
		|	СУММА(-1 * ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт) КАК СуммаРезерва
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07), ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты15)
		|			ТОГДА ""Депозит""
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|				И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = НЕОПРЕДЕЛЕНО
		|			ТОГДА ""ДС на РС""
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетныеСчета05)
		|				И ЕдиныйБухгалтерскийУчетОстатки.Субконто2 <> НЕОПРЕДЕЛЕНО
		|			ТОГДА ВЫБОР
		|					КОГДА КОНЕЦПЕРИОДА(ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.МНО).Дата, ДЕНЬ) = КОНЕЦПЕРИОДА(&ПериодДата, ДЕНЬ)
		|						ТОГДА ""ДС на РС""
		|					ИНАЧЕ ""МНО""
		|				КОНЕЦ
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСБрокерами07)
		|			ТОГДА ""ДС на БС""
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.СчетаДляКлиринга10)
		|			ТОГДА ""ДС на КС""
		|	КОНЕЦ";
	
	//если МНО эткрыто в день отчета, то по нему уже есть резерв, а начислений % нет. Резерв по таким МНО относим на р/счет
	
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период",							Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодДата",						КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

