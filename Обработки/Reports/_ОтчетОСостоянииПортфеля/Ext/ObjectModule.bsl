							ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = -ВыборкаРаздел._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
						//КонецЕсли;	
						//Если НЕ ЭтоБлагосостояние2019 Тогда
							//ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = -ВыборкаРаздел._22_РыночнаяСтоимостьСУчетомНКД;
						//КонецЕсли;	
					ИначеЕсли ВыборкаРаздел._1_Вид = "МНО"
						ИЛИ ВыборкаРаздел._1_Вид = "Денежные средства на расчетных счетах"
						ИЛИ ВыборкаРаздел._1_Вид = "Денежные средства на брокерских счетах" Тогда
						//Если Не ЭтоПечатнаяФорма Тогда
							ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезерва;
						//КонецЕсли;
					КонецЕсли; 
					
					ДокументРезультат.Вывести(ОбластьИтогиДенежныеСредства);
				Иначе
					
					СуммаРезерва = 0;
					
					Если ВыборкаРаздел._1_Вид = "МНО" Тогда
						ВидРезерва = "МНО"; 
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на расчетных счетах" Тогда
						ВидРезерва = "ДС на РС";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на брокерских счетах" Тогда
						ВидРезерва = "ДС на БС";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Депозит" Тогда
						ВидРезерва = "Депозит";
					Иначе
						ВидРезерва = Неопределено;
					КонецЕсли;
					
					Резерв = ТаблицаРезервовПодОбесценение.НайтиСтроки(Новый Структура("ВидРезерва", ВидРезерва));
					
					Если Резерв.Количество() > 0 Тогда //И Не ЭтоПечатнаяФорма Тогда
						//Если НЕ ЭтоБлагосостояние2019 Тогда
							ОбластьСтрокаДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = 0;
						//КонецЕсли;	
						
						СуммаРезерва = Резерв[0].СуммаРезерва;
						
						ОбластьСтрокаДенежныеСредства.Параметры.ВидПрочих												= "Резерв под обесценение:";
						ОбластьСтрокаДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП	= СуммаРезерва;
						
						СуммаРезервовВсего = СуммаРезервовВсего + СуммаРезерва;
						
						ДокументРезультат.Вывести(ОбластьСтрокаДенежныеСредства);
					КонецЕсли;
					
					ОбластьИтогиЦенныеБумаги.Параметры.Заполнить(ВыборкаРаздел);
					
					//Если Не ЭтоПечатнаяФорма Тогда
						ОбластьИтогиЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = ВыборкаРаздел._13_БалансоваяСтоимостьБезНКД - Уменьшить_13_БалансоваяСтоимостьБезНКД;
						ОбластьИтогиЦенныеБумаги.Параметры._15_НКДУплаченныйНачисленный = ВыборкаРаздел._15_НКДУплаченныйНачисленный - Уменьшить_15_НКДУплаченныйНачисленный;
						ОбластьИтогиЦенныеБумаги.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ВыборкаРаздел._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезерва;
						
						//Если НЕ ЭтоБлагосостояние Тогда
							//ОбластьИтогиЦенныеБумаги.Параметры._14_Переоценка = ВыборкаРаздел._14_Переоценка - Уменьшить_14_Переоценка;
							//ОбластьИтогиЦенныеБумаги.Параметры._16_Дисконт = ВыборкаРаздел._16_Дисконт - Уменьшить_16_Дисконт;
							//ОбластьИтогиЦенныеБумаги.Параметры._17_Премия = ВыборкаРаздел._17_Премия - Уменьшить_17_Премия;
							//ОбластьИтогиЦенныеБумаги.Параметры._18_Корректировка = ВыборкаРаздел._18_Корректировка - Уменьшить_18_Корректировка;
						//Иначе
						//	ОбластьИтогиЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = 
						//		ВыборкаРаздел._13_БалансоваяСтоимостьБезНКД + 
						//		ВыборкаРаздел._14_Переоценка + 
						//		ВыборкаРаздел._16_Дисконт + 
						//		ВыборкаРаздел._17_Премия + 
						//		ВыборкаРаздел._18_Корректировка;
							
						//КонецЕсли;
					//КонецЕсли;
					
					//Если НЕ ЭтоБлагосостояние2019 Тогда 
						//ОбластьИтогиЦенныеБумаги.Параметры._20_РыночнаяСтоимостьБезНКД 		= РыночнаяБезНКДРаздел;
						//ОбластьИтогиЦенныеБумаги.Параметры._21_НКД 							= НКДРаздел;
						//ОбластьИтогиЦенныеБумаги.Параметры._22_РыночнаяСтоимостьСУчетомНКД 	= РыночнаяСНКДРаздел;
					//КонецЕсли;	
					ДокументРезультат.Вывести(ОбластьИтогиЦенныеБумаги);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если Не ВыборкаМакетПрочее.МакетПрочее Тогда
			ОбластьИтогиДенежныеСредства.Параметры.Заполнить(ВыборкаМакетПрочее);
			ОбластьИтогиДенежныеСредства.Параметры.ВидИтога = "ИТОГО финансовые вложения:";
			//Если Не ЭтоПечатнаяФорма Тогда
				ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ВыборкаМакетПрочее._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - Уменьшить_Итог_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезерва;
			//КонецЕсли;	
			//Если НЕ ЭтоБлагосостояние2019 Тогда
				//ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = РыночнаяСНКДМакетПрочее;
			//КонецЕсли;	
			ДокументРезультат.Вывести(ОбластьИтогиДенежныеСредства);
		КонецЕсли;
	КонецЦикла;
	
	ОбластьИтогиДенежныеСредства.Параметры.Заполнить(ВыборкаОбщийИтог);
	ОбластьИтогиДенежныеСредства.Параметры.ВидИтога = "ИТОГО стоимость Портфеля:";
	//Если НЕ ЭтоБлагосостояние2019 Тогда
		//ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = РыночнаяСНКДВсего;
	//КонецЕсли;	
	
	//Если Не ЭтоПечатнаяФорма Тогда
		Если СуммаРезервовВсего <> 0 Тогда
			ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - СуммаРезервовВсего;
			БалансоваяСтоимость = ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - СуммаРезервовВсего
		Иначе
			БалансоваяСтоимость = ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
		КонецЕсли;
	//Иначе
	//	БалансоваяСтоимость = ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
	//КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьИтогиДенежныеСредства);	
	
	Возврат Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость", БалансоваяСтоимость, РыночнаяСНКДВсего);
	
КонецФункции

Функция ВывестиТелоОтчета_СбербанкПриложение8(ДокументРезультат, Макет)
	
	// Области
	ОбластьЦенныеБумагиКлассификатор = Макет.ПолучитьОбласть("ЦенныеБумагиКлассификатор");
	ОбластьЦенныеБумагиСтрока 		 = Макет.ПолучитьОбласть("ЦенныеБумагиСтрока");
	ОбластьЦенныеБумагиИтого 		 = Макет.ПолучитьОбласть("ЦенныеБумагиИтого");
	
	ОбластьДенежныеАктивыШапка	= Макет.ПолучитьОбласть("ДенежныеАктивыШапка");
	ОбластьДенежныеАктивыСтрока	= Макет.ПолучитьОбласть("ДенежныеАктивыСтрока");
	
	ОбластьИтоги = Макет.ПолучитьОбласть("Итоги");
	
	ЦенныеБумагиИтого = Новый Структура("БалансоваяСтоимостьТелоРуб, ОценочнаяСтоимостьТелоРуб, БалансоваяСтоимостьКупонРуб, ОценочнаяСтоимостьКупонРуб", 0, 0, 0, 0);
	ЦенныеБумагиФиниш = Ложь;
	
	ОбщиеИтоги = Новый Структура("БалансоваяСтоимостьРуб, ОценочнаяСтоимостьРуб", 0, 0);
	
	ВременныйТабДок = Новый ТабличныйДокумент;
	
	// Получаем данные для отчета	
	
	РезультатЗапроса = ПолучитьВыборкуДанных_СбербанкПриложение8(); 
	
	ВыборкаВидИтога	= РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	МНО = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();
	
	Депозиты = Новый ТаблицаЗначений;
	Депозиты.Колонки.Добавить("Актив");
	Депозиты.Колонки.Добавить("БалансоваяСтоимостьРуб");
	Депозиты.Колонки.Добавить("ОценочнаяСтоимостьРуб");
	
	Пока ВыборкаВидИтога.Следующий() Цикл
		
		// группа активов
		Если      ВыборкаВидИтога.Порядок < 6 Тогда
			
			ОбластьЦенныеБумагиКлассификатор.Параметры.ГруппаЦенныхБумаг = ВыборкаВидИтога.ВидИтога;
			ДокументРезультат.Вывести(ОбластьЦенныеБумагиКлассификатор);
			
		ИначеЕсли ВыборкаВидИтога.Порядок >= 6 Тогда
			
			Если Не ЦенныеБумагиФиниш Тогда
				
				ЦенныеБумагиФиниш = Истина;
				
				ОбластьЦенныеБумагиИтого.Параметры.Заполнить(ЦенныеБумагиИтого);
				ДокументРезультат.Вывести(ОбластьЦенныеБумагиИтого);
				
				ОбщиеИтоги.БалансоваяСтоимостьРуб = ЦенныеБумагиИтого.БалансоваяСтоимостьТелоРуб + ЦенныеБумагиИтого.БалансоваяСтоимостьКупонРуб;
				ОбщиеИтоги.ОценочнаяСтоимостьРуб  = ЦенныеБумагиИтого.ОценочнаяСтоимостьТелоРуб + ЦенныеБумагиИтого.ОценочнаяСтоимостьКупонРуб;
				
			КонецЕсли;
			
			ОбластьДенежныеАктивыШапка.Параметры.ГруппаАктивов = ВыборкаВидИтога.ВидИтога;
			
			Если ВыборкаВидИтога.ВидИтога = "Денежные средства на расчетных счетах"
				ИЛИ ВыборкаВидИтога.ВидИтога = "Депозиты"
				ИЛИ ВыборкаВидИтога.ВидИтога = "Расчеты по операциям с приобретенными ценными бумагами:" Тогда
				ДокументРезультат.Вывести(ОбластьДенежныеАктивыШапка);
			Иначе
				ВременныйТабДок.Вывести(ОбластьДенежныеАктивыШапка);
			КонецЕсли;
			
		КонецЕсли;
		
		// детальные записи
		ВыборкаДетальныеЗаписи = ВыборкаВидИтога.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если      ВыборкаВидИтога.Порядок < 6 Тогда
				
				ОбластьЦенныеБумагиСтрока.Параметры.Тип                                        = ВыборкаДетальныеЗаписи._1_Вид;
				ОбластьЦенныеБумагиСтрока.Параметры.Тикер                                      = "";
				ОбластьЦенныеБумагиСтрока.Параметры.НаименованиеАктива                         = ВыборкаДетальныеЗаписи.РасшифровкаАктива;
				ОбластьЦенныеБумагиСтрока.Параметры.Количество                                 = ВыборкаДетальныеЗаписи._6_Количество;
				ОбластьЦенныеБумагиСтрока.Параметры.БалансоваяСтоимостьТелоРуб                 = ВыборкаДетальныеЗаписи._13_БалансоваяСтоимостьБезНКД;
				ОбластьЦенныеБумагиСтрока.Параметры.ОценочнаяСтоимостьТелоРуб                  = ВыборкаДетальныеЗаписи._20_РыночнаяСтоимостьБезНКД;
				ОбластьЦенныеБумагиСтрока.Параметры.БалансоваяСтоимостьКупонРуб                = ВыборкаДетальныеЗаписи._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - ВыборкаДетальныеЗаписи._13_БалансоваяСтоимостьБезНКД;
				ОбластьЦенныеБумагиСтрока.Параметры.ОценочнаяСтоимостьКупонРуб                 = ВыборкаДетальныеЗаписи._21_НКД;
				ОбластьЦенныеБумагиСтрока.Параметры.РыночнаяКотировка                          = ВыборкаДетальныеЗаписи._7_СправедливаяЦена;
				ОбластьЦенныеБумагиСтрока.Параметры.РазницаМеждуОценочнойИБалансовойСтоимостью = ВыборкаДетальныеЗаписи._20_РыночнаяСтоимостьБезНКД + ВыборкаДетальныеЗаписи._21_НКД - ВыборкаДетальныеЗаписи._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
				ОбластьЦенныеБумагиСтрока.Параметры.ГосРегНомер                                = ВыборкаДетальныеЗаписи._4_НомерГосРегистрации;
				ОбластьЦенныеБумагиСтрока.Параметры.НаименованиеЭмитента                       = ВыборкаДетальныеЗаписи._3_Эмитент;
				ОбластьЦенныеБумагиСтрока.Параметры.ИННЭмитента                                = ВыборкаДетальныеЗаписи._3_Эмитент_ИНН;
				ОбластьЦенныеБумагиСтрока.Параметры.Биржа                                      = ВыборкаДетальныеЗаписи._9_ИсточникЦены;
				ОбластьЦенныеБумагиСтрока.Параметры.ISIN                                       = ВыборкаДетальныеЗаписи._1_ISIN;
				
				ОбластьЦенныеБумагиСтрока.Параметры.СрокДоПогашенияТело                        = 0;
				ОбластьЦенныеБумагиСтрока.Параметры.СрокДоПогашенияКупон                       = 0;
				
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Актив) = Тип("СправочникСсылка.Облигации") Тогда
					
					ОбластьЦенныеБумагиСтрока.Параметры.СрокДоПогашенияТело = ПолучитьПредставлениеИнтервала(ЭтотОбъект.Период, ВыборкаДетальныеЗаписи._24_ДатаПогашения);
					
					ПогашенияКупонов = Справочники.Облигации.ПолучитьПогашенияКупонов(ВыборкаДетальныеЗаписи.Актив, Истина, ЭтотОбъект.Период);
					
					Если ПогашенияКупонов.Количество() > 0 Тогда
						ОбластьЦенныеБумагиСтрока.Параметры.СрокДоПогашенияКупон = ПолучитьПредставлениеИнтервала(ЭтотОбъект.Период, ПогашенияКупонов[0].Дата);
					КонецЕсли;
					
				КонецЕсли;
				
				ЦенныеБумагиИтого.БалансоваяСтоимостьТелоРуб  = ЦенныеБумагиИтого.БалансоваяСтоимостьТелоРуб + ОбластьЦенныеБумагиСтрока.Параметры.БалансоваяСтоимостьТелоРуб;
				ЦенныеБумагиИтого.ОценочнаяСтоимостьТелоРуб   = ЦенныеБумагиИтого.ОценочнаяСтоимостьТелоРуб + ОбластьЦенныеБумагиСтрока.Параметры.ОценочнаяСтоимостьТелоРуб;
				ЦенныеБумагиИтого.БалансоваяСтоимостьКупонРуб = ЦенныеБумагиИтого.БалансоваяСтоимостьКупонРуб + ОбластьЦенныеБумагиСтрока.Параметры.БалансоваяСтоимостьКупонРуб;
				ЦенныеБумагиИтого.ОценочнаяСтоимостьКупонРуб  = ЦенныеБумагиИтого.ОценочнаяСтоимостьКупонРуб + ОбластьЦенныеБумагиСтрока.Параметры.ОценочнаяСтоимостьКупонРуб;
				
				ДокументРезультат.Вывести(ОбластьЦенныеБумагиСтрока);
				
			ИначеЕсли ВыборкаВидИтога.Порядок >= 6 Тогда // т.е. не ценные бумаги
				
				Если ВыборкаДетальныеЗаписи.ВидИтога = "Кредиторская задолженность"
						Или ВыборкаДетальныеЗаписи.ВидИтога = "Дебиторская задолженность"
				Тогда
					ОбластьДенежныеАктивыСтрока.Параметры.Актив = Строка(ВыборкаДетальныеЗаписи._3_Эмитент)
						+ ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.РасшифровкаАктива), ", ", "")
						+ ВыборкаДетальныеЗаписи.РасшифровкаАктива;
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидИтога = "Расчеты по операциям с приобретенными ценными бумагами:" Тогда
					ОбластьДенежныеАктивыСтрока.Параметры.Актив = ВыборкаДетальныеЗаписи._1_Вид;
				Иначе
					ОбластьДенежныеАктивыСтрока.Параметры.Актив = ВыборкаДетальныеЗаписи.РасшифровкаАктива;
				КонецЕсли;				
				
				Если      ВыборкаДетальныеЗаписи.ВидИтога = "Денежные средства на расчетных счетах" Тогда
					// % хранятся в отдельной таблице, поэтому "БезНКД"
					ОбластьДенежныеАктивыСтрока.Параметры.БалансоваяСтоимостьРуб = ВыборкаДетальныеЗаписи._13_БалансоваяСтоимостьБезНКД;
					ОбластьДенежныеАктивыСтрока.Параметры.ОценочнаяСтоимостьРуб  = ВыборкаДетальныеЗаписи._22_РыночнаяСтоимостьСУчетомНКД - ВыборкаДетальныеЗаписи._21_НКД;
				ИначеЕсли ВыборкаДетальныеЗаписи.ВидИтога = "Кредиторская задолженность" Тогда
					// кредиторка в выборке с "-"
					ОбластьДенежныеАктивыСтрока.Параметры.БалансоваяСтоимостьРуб = -ВыборкаДетальныеЗаписи._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
					ОбластьДенежныеАктивыСтрока.Параметры.ОценочнаяСтоимостьРуб  = -ВыборкаДетальныеЗаписи._22_РыночнаяСтоимостьСУчетомНКД;
				Иначе
					ОбластьДенежныеАктивыСтрока.Параметры.БалансоваяСтоимостьРуб = ВыборкаДетальныеЗаписи._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
					ОбластьДенежныеАктивыСтрока.Параметры.ОценочнаяСтоимостьРуб  = ВыборкаДетальныеЗаписи._22_РыночнаяСтоимостьСУчетомНКД;
				КонецЕсли;
				
				
				ОбщиеИтоги.БалансоваяСтоимостьРуб = ОбщиеИтоги.БалансоваяСтоимостьРуб + ВыборкаДетальныеЗаписи._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
				ОбщиеИтоги.ОценочнаяСтоимостьРуб  = ОбщиеИтоги.ОценочнаяСтоимостьРуб + ВыборкаДетальныеЗаписи._22_РыночнаяСтоимостьСУчетомНКД;
				
				Если ВыборкаДетальныеЗаписи.ВидИтога = "Денежные средства на расчетных счетах"
					ИЛИ ВыборкаДетальныеЗаписи.ВидИтога = "Депозиты"
					ИЛИ ВыборкаВидИтога.ВидИтога = "Расчеты по операциям с приобретенными ценными бумагами:" Тогда
					ДокументРезультат.Вывести(ОбластьДенежныеАктивыСтрока);
				Иначе
					ВременныйТабДок.Вывести(ОбластьДенежныеАктивыСтрока);
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.ВидИтога = "Депозиты" Тогда
					СтрокаДепозиты = Депозиты.Добавить();
					СтрокаДепозиты.Актив                  = ВыборкаДетальныеЗаписи.РасшифровкаАктива;
					СтрокаДепозиты.БалансоваяСтоимостьРуб = ВыборкаДетальныеЗаписи._15_НКДУплаченныйНачисленный;
					СтрокаДепозиты.ОценочнаяСтоимостьРуб  = ВыборкаДетальныеЗаписи._21_НКД;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если Депозиты.Количество() > 0 Или МНО.Количество() > 0 Тогда
		
		ОбластьДенежныеАктивыШапка.Параметры.ГруппаАктивов = "Начисленные % по депозитам и НСО, сроком до 90 дней включительно";
		ДокументРезультат.Вывести(ОбластьДенежныеАктивыШапка);
		
		Для каждого СтрокаДепозиты Из Депозиты Цикл
			ОбластьДенежныеАктивыСтрока.Параметры.Заполнить(СтрокаДепозиты);
			ДокументРезультат.Вывести(ОбластьДенежныеАктивыСтрока);
		КонецЦикла;
		
		Для каждого СтрокаМНО Из МНО Цикл
			ОбластьДенежныеАктивыСтрока.Параметры.Актив                  = Строка(СтрокаМНО.БанковскийСчет);
			ОбластьДенежныеАктивыСтрока.Параметры.БалансоваяСтоимостьРуб = СтрокаМНО._8_СуммаПроцентов;
			ОбластьДенежныеАктивыСтрока.Параметры.ОценочнаяСтоимостьРуб  = СтрокаМНО._15_СуммаПроцентовРынок;
			
			ДокументРезультат.Вывести(ОбластьДенежныеАктивыСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	ДокументРезультат.Вывести(ВременныйТабДок);
	
	// итоги
	ОбластьИтоги.Параметры.ВидИтога               = "НКД всего";
	ОбластьИтоги.Параметры.БалансоваяСтоимостьРуб = ЦенныеБумагиИтого.БалансоваяСтоимостьКупонРуб;
	ОбластьИтоги.Параметры.ОценочнаяСтоимостьРуб  = ЦенныеБумагиИтого.ОценочнаяСтоимостьКупонРуб;
	
	ДокументРезультат.Вывести(ОбластьИтоги);
	
	ОбластьИтоги.Параметры.ВидИтога               = "Итого стоимость активов";
	ОбластьИтоги.Параметры.БалансоваяСтоимостьРуб = ОбщиеИтоги.БалансоваяСтоимостьРуб;
	ОбластьИтоги.Параметры.ОценочнаяСтоимостьРуб  = ОбщиеИтоги.ОценочнаяСтоимостьРуб;
	
	ДокументРезультат.Вывести(ОбластьИтоги);
	
	Возврат Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость", 0, 0);
	
КонецФункции

Функция ПолучитьВыборкуДанных_СбербанкПриложение8()
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(Запрос.МенеджерВременныхТаблиц,, ЭтотОбъект.Период);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО) КАК ПризнатьВыпускДефолтным,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ДефолтныеЦБ
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПризнатьДефолтной)) КАК ЗначенияНастроекУчетаЦенныхБумагСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И (&БезОтбораПоСчетамДУ
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						ИЛИ СчетДоверительногоУправления В (&ОтборСчетаДУ))) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Клиент)
		|ГДЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки = ИСТИНА
		|	И НЕ ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Отключить
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА 1
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА 2
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА 3
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА 4
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА 5
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА 6
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА 7
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Порядок,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_КлассификацииЦенныхБумаг.КлассификацияЦенныхБумагЦифровая, ""Прочие ценные бумаги"") КАК КлассификацияЦенныхБумаг,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НомерГосРегистрации,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).Номинал
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Номинал
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Номинал,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.КоличествоОстаток = 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток / БухПартииЦенныхБумагОстатки.КоличествоОстаток
		|	КОНЕЦ КАК БалансоваяЦена,
		|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК БалансоваяСтоимостьБезНКД,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК НКДУплаченныйНачисленный,
		|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток КАК НКДУплаченный,
		|	БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК НКДНачисленный,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток < 0
		|			ТОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Дисконт,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток > 0
		|			ТОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Премия,
		|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток + (БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток - БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток) КАК Корректировка,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ""Пай""
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ""Ипотечный сертификат участия""
		|		ИНАЧЕ """"
