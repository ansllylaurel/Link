		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	_3_Эмитент,
		|	_4_НомерГосРегистрации
		|ИТОГИ
		|	СУММА(_12_ПрибыльУбыток),
		|	СУММА(_13_БалансоваяСтоимостьБезНКД),
		|	СУММА(_14_Переоценка),
		|	СУММА(_15_НКДУплаченныйНачисленный),
		|	СУММА(_16_Дисконт),
		|	СУММА(_17_Премия),
		|	СУММА(_18_Корректировка),
		|	СУММА(_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП),
		|	СУММА(_20_РыночнаяСтоимостьБезНКД),
		|	СУММА(_21_НКД),
		|	СУММА(_22_РыночнаяСтоимостьСУчетомНКД),
		|	МАКСИМУМ(ВидИтога)
		|ПО
		|	ОБЩИЕ,
		|	МакетПрочее,
		|	Порядок,
		|	_1_Вид
		|АВТОУПОРЯДОЧИВАНИЕ";
	#КонецОбласти
	Запрос.УстановитьПараметр("Биржа", 							ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Период", 						Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Дата", 							НачалоДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень",			?(ЭтоПечатнаяФорма, НачалоДня(ЭтотОбъект.Период), ПоследнийРабочийДень));
	Запрос.УстановитьПараметр("ЦельРасчета", 					ЦельРасчета);
	Запрос.УстановитьПараметр("ЦельРасчетаБаланс", 				ЦельРасчетаБаланс);
	Запрос.УстановитьПараметр("ВидУчетаБаланс", 				ВидУчетаБаланс);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДефолтнаяМОИА2", 				ОбщегоНазначения.ПолучитьИменованныйОбъект("ДефолтнаяМОИА2"));
	Запрос.УстановитьПараметр("ДефолтнаяМОИА2Эмитент", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("ДефолтнаяМОИА2").Эмитент);
	Запрос.УстановитьПараметр("НачалоГода",						НачалоГода(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ВыводитьПрибылиУбытки",			Ложь);
	Запрос.УстановитьПараметр("ПроцентныеДоходыНаСчетахАктивов",ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов);
	Запрос.УстановитьПараметр("Облигация_ОВКФинанс",			ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОВКФинанс"));
	Запрос.УстановитьПараметр("Облигация_Автодор_002", 			ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002"));
	
	МассивСчетовЮгория = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ГСКЮгория"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
		ЭтотОбъект.Период);
	
	ЭтоКлиентЮгория = (МассивСчетовЮгория.Найти(ЭтотОбъект.СчетДоверительногоУправления) <> Неопределено);
	
	Если ЭтоКлиентЮгория Тогда
		Запрос.УстановитьПараметр("УчетныйАктивЕПСРодительПоУмолчанию", Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД);
		Запрос.УстановитьПараметр("КлассификацияЦенныхБумагЦифроваяПоУмолчанию",
			Справочники.УчетныеАктивыЕПС.ПолучитьЧисловуюКлассификациюЦенныхБумаг(
				Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД, ЭтотОбъект.Период));
	Иначе
		Запрос.УстановитьПараметр("УчетныйАктивЕПСРодительПоУмолчанию", Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
		Запрос.УстановитьПараметр("КлассификацияЦенныхБумагЦифроваяПоУмолчанию",
			Справочники.УчетныеАктивыЕПС.ПолучитьЧисловуюКлассификациюЦенныхБумаг(
				Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой, ЭтотОбъект.Период));
	КонецЕсли;
	
	// сделано для Сафмара т.к. они учитывают их невзирая на дефолт
	Запрос.УстановитьПараметр("ДефолтнаяОткрытие4", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрХолдинг_004"));
	Запрос.УстановитьПараметр("ДефолтнаяОткрытие3", ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_ОткрытиеХолдинг"));
	
	МассивСубконтоКонтрагентыОснованиеРасчетов = Новый Массив;
	МассивСубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	МассивСубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	СубконтоКонтрагентыДоговоры = Новый Массив;
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	Запрос.УстановитьПараметр("СубконтоКонтрагентыОснованиеРасчетов", МассивСубконтоКонтрагентыОснованиеРасчетов);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры", СубконтоКонтрагентыДоговоры);
	
	НастройкиОценки = РаботаСПереоценкой.ОпределитьНастройкиОценки(
		ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
	
	Запрос.УстановитьПараметр("ВыполнятьРасчетПоПисьмуЦБ0185316", НастройкиОценки.ВыполнятьРасчетПоПисьмуЦБ0185316);
	
	ДатаВзятияЦенПриВыполненииРасчетаПоПисьмуЦБ0185316 = '20220218';
	Если Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период)
		= ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_НПФВолгаКапитал")
	Тогда
		ДатаВзятияЦенПриВыполненииРасчетаПоПисьмуЦБ0185316 = '20220217';
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДатаВзятияЦенПриВыполненииРасчетаПоПисьмуЦБ0185316", ДатаВзятияЦенПриВыполненииРасчетаПоПисьмуЦБ0185316);
	
	УстановитьОтборПоЦБ(Запрос);
	
	Результат = Запрос.Выполнить(); 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВыборкуДанных_НоваяМетодикаБлагосостояние()
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	ВидУчетаБаланс = ОпределитьВидУчета(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЦельРасчета, ЭтотОбъект.Период);
	ВидДоговораДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов
	Тогда
		ВидУчетаБаланс = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	КонецЕсли;
	
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период);

	Если Не РаботаСОтчетами.ПроверитьРегистрациюСЧА(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ПоследнийРабочийДень) Тогда
		Сообщить("Стоимость ценных бумаг или активов, не относящимся к ценным бумагам, на " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy")
			+ " не зарегистрирована. Сведения о рыночной стоимости активов, рассчитанной по новой методике, выведены не будут.");
	КонецЕсли;
	
	ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
	
	// Для того чтобы в отчет попадали выбывшие бумаги (отражается доход) в первом запросе берется не остатки партий, а остатки и обороты
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(Запрос.МенеджерВременныхТаблиц,, ЭтотОбъект.Период);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА 1
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА 2
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА 3
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА 4
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА 5
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА 7
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Порядок,
		|	БухПартииЦенныхБумагОстаткиИОбороты.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_КлассификацииЦенныхБумаг.КлассификацияЦенныхБумагЦифровая, 4.1) КАК КлассификацияЦенныхБумаг,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НомерГосРегистрации,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Акции).Номинал
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК Справочник.Облигации).Номинал
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Номинал,
		|	БухПартииЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток = 0
		|			ТОГДА 0
		|		ИНАЧЕ БухПартииЦенныхБумагОстаткиИОбороты.СтоимостьВВалютеУчетаКонечныйОстаток / БухПартииЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток
		|	КОНЕЦ КАК БалансоваяЦена,
		|	БухПартииЦенныхБумагОстаткиИОбороты.СтоимостьВВалютеУчетаКонечныйОстаток КАК БалансоваяСтоимостьБезНКД,
		|	БухПартииЦенныхБумагОстаткиИОбороты.ПереоценкаВВалютеУчетаКонечныйОстаток + БухПартииЦенныхБумагОстаткиИОбороты.ИндексацияНоминалаКонечныйОстаток КАК Переоценка,
		|	БухПартииЦенныхБумагОстаткиИОбороты.СтоимостьКупонаВВалютеУчетаКонечныйОстаток + БухПартииЦенныхБумагОстаткиИОбороты.ПереоценкаКупонаВВалютеУчетаКонечныйОстаток КАК НКДУплаченныйНачисленный,
