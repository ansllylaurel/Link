#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//         |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//         |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о состоянии портфеля",
		"4.39",
		"",
		Истина
	);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
КонецФункции

#КонецОбласти

Функция ПолучитьВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиУчетаОбщиеСрезПоследних.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов КАК ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
		|			&ДатаПроверки,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК НастройкиУчетаОбщиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаПроверки", ЭтотОбъект.Период); 
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда  
		Возврат Выборка.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов;  
	Иначе
		Возврат Неопределено;
	КонецЕсли;  
	
КонецФункции


Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.КлючТекущегоВарианта) Тогда	
		ЭтотОбъект.КлючТекущегоВарианта = "Основной";	
	КонецЕсли;
	
	ЭтоБлагосостояние	= (ЭтотОбъект.КлючТекущегоВарианта = "Благосостояние") ИЛИ (ЭтотОбъект.КлючТекущегоВарианта = "Благосостояние2019");
	ЭтоБлагосостояние2019 = (ЭтотОбъект.КлючТекущегоВарианта = "Благосостояние2019");
	ЭтоНефтегарант		= (ЭтотОбъект.КлючТекущегоВарианта = "Нефтегарант");
	ЭтоПечатнаяФорма	= (ЭтотОбъект.КлючТекущегоВарианта = "ПечатнаяФормаРСА");
	ЭтоОбразование		= (ЭтотОбъект.КлючТекущегоВарианта = "Образование");
	ЭтоБудущее			= (ЭтотОбъект.КлючТекущегоВарианта = "Будущее");
	ЭтоБольшой			= (ЭтотОбъект.КлючТекущегоВарианта = "Большой");
	ЭтоСбербанкСтрахованиеПриложение14	= (ЭтотОбъект.КлючТекущегоВарианта = "СбербанкПрил14");
	ЭтоСбербанкСтрахованиеПриложение8	= (ЭтотОбъект.КлючТекущегоВарианта = "СбербанкПрил8");
	ЭтоЭволюция			= (ЭтотОбъект.КлючТекущегоВарианта = "Эволюция");
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,КлючТекущегоВарианта");	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	Если ЭтоСбербанкСтрахованиеПриложение8 Тогда
		
		// Макет	
		Макет = ПолучитьМакет("СбербанкПрил8");
		
		// Шапка отчета
		ОбластьШапкаОтчета = Макет.ПолучитьОбласть("ШапкаОтчета");
		
		ПараметрыШапки = ПолучитьПараметрыШапки();
		ОбластьШапкаОтчета.Параметры.Заполнить(ПараметрыШапки);
		
		ОбластьШапкаОтчета.Параметры.ДатаДоговора = Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy");
		ОбластьШапкаОтчета.Параметры.ДатаОтчета   = Формат(ПараметрыШапки.ДатаОтчета, "ДФ=dd.MM.yyyy");
		
		ДокументРезультат.Вывести(ОбластьШапкаОтчета);
		
		// Тело отчета
		ДанныеРасчета = ВывестиТелоОтчета_СбербанкПриложение8(ДокументРезультат, Макет);

		ЭтотОбъект.БалансоваяСтоимость = ДанныеРасчета.БалансоваяСтоимость;
		ЭтотОбъект.РыночнаяСтоимость = ДанныеРасчета.РыночнаяСтоимость;
		
	Иначе
		
		// Определяем методику расчета рыночной стоимости активов
		
		НомерПриказа = Неопределено;
		
		Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Тогда
		
		    // ПН и ПР
		
			НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
			
			Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений
				ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхРезервов
			Тогда
			
				НомерПриказа = ?(ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями, "06-155/пз-н", "10-37/пз-н");
			
			ИначеЕсли ТипЗнч(НастройкиОценки.ВариантРасчетаОценочнойСтоимости) = Тип("СправочникСсылка.ВариантыРасчетаОценочнойСтоимости") 
				И НастройкиОценки.ВариантРасчетаОценочнойСтоимости.ПринадлежитЭлементу(Справочники.ВариантыРасчетаОценочнойСтоимости.ЕПС)
			Тогда
				
				НомерПриказа = "4579-У";
				
			КонецЕсли;	
			
		Иначе
			
			// Прочие виды договоров
			
			НомерПриказа = "";
			
		КонецЕсли;
		
		Если НомерПриказа = Неопределено Тогда
			НомерПриказа = "4579-У";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для клиента '" + Строка(ЭтотОбъект.СчетДоверительногоУправления) + "' не определен алгоритм расчета рыночной стоимости. Расчет будет выполнен по указанию " + НомерПриказа,,,,);
		КонецЕсли;
		
		// Макет	
		Макет = ПолучитьМакет(ЭтотОбъект.КлючТекущегоВарианта);
		
		Области = Новый Структура;
		Области.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));
		Если ПолучитьВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов() = Перечисления.СтандартыФинансовойОтчетности.МСФО39 Тогда 
			Области.Вставить("Подвал", Макет.ПолучитьОбласть("Подвал"));
		Иначе	                                                        
			Области.Вставить("Подвал", Макет.ПолучитьОбласть("Подвал2"));
		КонецЕсли;
		
		// Шапка отчета
		
		ПараметрыШапки = ПолучитьПараметрыШапки();
		Области.Шапка.Параметры.Заполнить(ПараметрыШапки);
		
		ДополнительныеПараметрыШапки = Новый Структура;
		ДополнительныеПараметрыШапки.Вставить("ДатаДоговора", Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		ДополнительныеПараметрыШапки.Вставить("ДатаОтчета", Формат(ПараметрыШапки.ДатаОтчета, "ДФ=dd.MM.yyyy"));
		ДополнительныеПараметрыШапки.Вставить("ПоследнийРабочийДень", Формат(ПараметрыШапки.ПоследнийРабочийДень, "ДФ=dd.MM.yyyy"));
		ДополнительныеПараметрыШапки.Вставить("НачалоГода", Формат(НачалоГода(ЭтотОбъект.Период), "ДФ=dd.MM.yyyy"));
		//ДополнительныеПараметрыШапки.Вставить("НомерПриказа", НомерПриказа);
		
		Если НомерПриказа = "06-155/пз-н" ИЛИ НомерПриказа = "10-37/пз-н" Тогда
			ДополнительныеПараметрыШапки.Вставить("Котировка", "Котировка");
		ИначеЕсли НомерПриказа = "4579-У" ИЛИ НомерПриказа = "" Тогда
			ДополнительныеПараметрыШапки.Вставить("Котировка", "Справедливая цена");
		КонецЕсли;
				
		Области.Шапка.Параметры.Заполнить(ДополнительныеПараметрыШапки);
		
		ДокументРезультат.Вывести(Области.Шапка);
		
		ДокументРезультат.ФиксацияСлева = 5;
		ДокументРезультат.ФиксацияСверху = 8;
		
		// Тело отчета
		Если ЭтотОбъект.КлючТекущегоВарианта = "ПоРСБУ" Тогда
			ДанныеРасчета = ВывестиТелоОтчета_НоваяМетодика_ПоРСБУ(ДокументРезультат, Макет);
			
		ИначеЕсли ЭтотОбъект.КлючТекущегоВарианта = "СбербанкПрил14" Тогда 	
			ДанныеРасчета = ВывестиТелоОтчета_СбербанкСтрахованиеПриложение14(ДокументРезультат, Макет);
			
		ИначеЕсли НомерПриказа = "06-155/пз-н" ИЛИ НомерПриказа = "10-37/пз-н" Тогда
			
			Если ЭтоОбразование ИЛИ ЭтоБудущее ИЛИ ЭтоЭволюция ИЛИ ЭтоБольшой Тогда
				ДанныеРасчета = Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выбранный вариант отчета не реализован для приказа " + НомерПриказа);
			Иначе
				ДанныеРасчета = ВывестиТелоОтчета(ДокументРезультат, Макет, ЭтоБлагосостояние, ЭтоНефтегарант);
			КонецЕсли;
			
		ИначеЕсли НомерПриказа = "4579-У" ИЛИ НомерПриказа = "" Тогда
			
			Если ЭтоОбразование ИЛИ ЭтоЭволюция ИЛИ ЭтоБольшой Тогда
				ДанныеРасчета = ВывестиТелоОтчета_НоваяМетодика_Образование(ДокументРезультат, Макет);
			ИначеЕсли ЭтоБудущее Тогда
				ДанныеРасчета = ВывестиТелоОтчета_НоваяМетодика_Будущее(ДокументРезультат, Макет);
			Иначе
				ДанныеРасчета = ВывестиТелоОтчета_НоваяМетодика(ДокументРезультат, Макет, ЭтоБлагосостояние, ЭтоНефтегарант, ЭтоПечатнаяФорма, ЭтоБлагосостояние2019);
			КонецЕсли;

		КонецЕсли;

		ЭтотОбъект.БалансоваяСтоимость = ДанныеРасчета.БалансоваяСтоимость;
		ЭтотОбъект.РыночнаяСтоимость = ДанныеРасчета.РыночнаяСтоимость;
		
		// Подвал отчета	
		
		Если ЭтоОбразование ИЛИ ЭтоЭволюция ИЛИ ЭтоБольшой Тогда
			ЗаполнитьДанныеПодвала(Области.Подвал);	
		КонецЕсли;
		
		ДокументРезультат.Вывести(Области.Подвал);
				
	КонецЕсли;
	
	// Подписи	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей);		
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	ЭтотОбъект.Период = НастройкиОтчета.Период.ДатаОкончания;
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ПриКомпоновкеРезультата(ДокументРезультат, Неопределено, Ложь);
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

#Область Старая_методика

Функция ВывестиТелоОтчета(ДокументРезультат, Макет, ЭтоБлагосостояние, ЭтоНефтегарант)
	
	Если ЭтоНефтегарант Тогда
		СписокЦБРФ = ПолучитьСписокЦБРФ();
	КонецЕсли;
	
	// Области
	ОбластьСтрокаЦенныеБумаги 		= Макет.ПолучитьОбласть("СтрокаЦенныеБумаги");
	ОбластьИтогиЦенныеБумаги 		= Макет.ПолучитьОбласть("ИтогиЦенныеБумаги");
