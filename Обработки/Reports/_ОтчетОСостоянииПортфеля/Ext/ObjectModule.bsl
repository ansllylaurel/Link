Функция ПолучитьРейтинги(Объект, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.ЗначениеРейтинга КАК ЗначениеРейтинга
		|ИЗ
		|	РегистрСведений.Рейтинги.СрезПоследних(
		|			&Период,
		|			Субъект = &Объект
		|				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ Шкала.ДатаПереходаВАрхив > &Период)) КАК РейтингиСрезПоследних
		|ГДЕ
		|	(РейтингиСрезПоследних.ДатаПереходаВАрхив > &Период
		|			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
		|	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &Период
		|			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Период", Дата);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Рейтинги = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если СокрЛП(ВыборкаДетальныеЗаписи.ЗначениеРейтинга) = "" Тогда
			Продолжить;
		КонецЕсли;
		Рейтинги = Рейтинги + СокрЛП(ВыборкаДетальныеЗаписи.ЗначениеРейтинга) + ",";
	КонецЦикла;
	
	Возврат Лев(Рейтинги, СтрДлина(Рейтинги) - 1);

КонецФункции

Функция ПолучитьРейтингиОтАгенства(Субъект, РейтинговоеАгентство, Дата, ТаблицаРейтингов)
	
	Запрос = Новый Запрос("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РейтингиСрезПоследних.Рейтинг КАК Рейтинг
		|ИЗ
		|	_Рейтинги КАК РейтингиСрезПоследних
		|ГДЕ
		|	РейтингиСрезПоследних.Субъект = &Субъект
		|	И РейтингиСрезПоследних.РейтинговоеАгентство = &РейтинговоеАгентство
		|СГРУППИРОВАТЬ ПО
		|	РейтингиСрезПоследних.Рейтинг
		|УПОРЯДОЧИТЬ ПО
		|	МАКСИМУМ(РейтингиСрезПоследних.УровеньРейтинга),
		|	РейтингиСрезПоследних.Рейтинг
		|");
	Запрос.УстановитьПараметр("Субъект", Субъект);
	Запрос.УстановитьПараметр("РейтинговоеАгентство", РейтинговоеАгентство);
	Запрос.МенеджерВременныхТаблиц = ТаблицаРейтингов;
	
	Рейтинг = СтрСоединить(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Рейтинг"), ", ");
	Если Не ПустаяСтрока(Рейтинг) Тогда
		Возврат Рейтинг;
	КонецЕсли;

	// Для ЦБ при отсутствии рейтинга берем рейтинг эмитента
	Если ТипЗнч(Субъект) = Тип("СправочникСсылка.Акции") Или ТипЗнч(Субъект) = Тип("СправочникСсылка.Облигации") Тогда
		
		Субъект_Эмитент_ЮрФизЛицо = Справочники.ЮрФизЛица.ПустаяСсылка();
		
		ЗапросЮрФизЛицо = Новый Запрос;
		ЗапросЮрФизЛицо.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Акции.Эмитент.ЮрФизЛицо КАК ЮрФизЛицо
			|ИЗ
			|	Справочник.Акции КАК Акции
			|ГДЕ
			|	Акции.Ссылка = &Ссылка";
		
		Если ТипЗнч(Субъект) = Тип("СправочникСсылка.Облигации") Тогда
			ЗапросЮрФизЛицо.Текст = СтрЗаменить(ЗапросЮрФизЛицо.Текст, "Акции" , "Облигации");
		КонецЕсли;
		
		ЗапросЮрФизЛицо.УстановитьПараметр("Ссылка", Субъект);
		
		РезультатЗапросаЮрФизЛицо = ЗапросЮрФизЛицо.Выполнить();
		
		ВыборкаДетальныеЗаписиЮрФизЛицо = РезультатЗапросаЮрФизЛицо.Выбрать();
		
		Пока ВыборкаДетальныеЗаписиЮрФизЛицо.Следующий() Цикл
			Субъект_Эмитент_ЮрФизЛицо = ВыборкаДетальныеЗаписиЮрФизЛицо.ЮрФизЛицо;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("Субъект", Субъект_Эмитент_ЮрФизЛицо);
		
		Рейтинг = СтрСоединить(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Рейтинг"), ", ");
	ИначеЕсли ТипЗнч(Субъект) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
		ГоловнаяОрганизацияЮрЛица = РаботаСНормативноСправочнойИнформацией.ПолучитьГоловнуюОрганизацию(Субъект);
		
		Если ЗначениеЗаполнено(ГоловнаяОрганизацияЮрЛица) Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			                      |	ЕСТЬNULL(РейтингиСрезПоследних.ЗначениеРейтинга.Наименование, РейтингиСрезПоследних.Рейтинг) КАК Рейтинг
			                      |ИЗ
			                      |	РегистрСведений.Рейтинги.СрезПоследних(
			                      |			&Дата,
			                      |			Субъект = &Субъект
			                      |				И РейтинговоеАгентство = &РейтинговоеАгентство
			                      |				И (Шкала.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1)
			                      |					ИЛИ Шкала.ДатаПереходаВАрхив > &Дата)) КАК РейтингиСрезПоследних
			                      |ГДЕ
			                      |	ВЫБОР
			                      |			КОГДА РейтингиСрезПоследних.ЗначениеРейтинга = ЗНАЧЕНИЕ(Справочник.ЗначенияРейтингов.ПустаяСсылка)
			                      |				ТОГДА РейтингиСрезПоследних.Рейтинг <> """"
			                      |			ИНАЧЕ РейтингиСрезПоследних.ЗначениеРейтинга.Наименование <> ""СНЯТ""
			                      |		КОНЕЦ
			                      |	И (РейтингиСрезПоследних.ДатаПереходаВАрхив > &Дата
			                      |			ИЛИ РейтингиСрезПоследних.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
			                      |	И (РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив > &Дата
			                      |			ИЛИ РейтингиСрезПоследних.ЗначениеРейтинга.ДатаПереходаВАрхив = ДАТАВРЕМЯ(1, 1, 1))
			                      |
			                      |СГРУППИРОВАТЬ ПО
			                      |	ЕСТЬNULL(РейтингиСрезПоследних.ЗначениеРейтинга.Наименование, РейтингиСрезПоследних.Рейтинг)
			                      |
			                      |УПОРЯДОЧИТЬ ПО
			                      |	МАКСИМУМ(РейтингиСрезПоследних.УровеньРейтинга),
			                      |	ЕСТЬNULL(РейтингиСрезПоследних.ЗначениеРейтинга.Наименование, РейтингиСрезПоследних.Рейтинг)");
			Запрос.УстановитьПараметр("Субъект", ГоловнаяОрганизацияЮрЛица);
			Запрос.УстановитьПараметр("РейтинговоеАгентство", РейтинговоеАгентство);
			Запрос.УстановитьПараметр("Дата", Дата);
			
			Рейтинг = СтрСоединить(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Рейтинг"), ", ");
			Если Не ПустаяСтрока(Рейтинг) Тогда
				Возврат Рейтинг;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Рейтинг;

КонецФункции

Процедура ОчиститьПараметрыОбласти(Область)
	Для Параметр = 0 По Область.Параметры.Количество() - 1 Цикл
		Область.Параметры[Параметр] = Неопределено;
	КонецЦикла; 
КонецПроцедуры

Процедура УстановитьПараметрОбласти(Область, Параметр, Значение)
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Область.Параметры, Параметр) Тогда
		Область.Параметры[Параметр] = Значение;	 	
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьПараметрОбласти(Область, Параметр)	
	Если ОбщегоНазначенияКлиентСервер.ПолеСуществует(Область.Параметры, Параметр) Тогда
		Возврат Область.Параметры[Параметр];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Процедура ЗаполнитьДополнительныеСведенияОДепозите(ДополнительныеСведения, ВыборкаДетали, ТаблицаРейтингов)
	
	ДепозитныйВклад = ВыборкаДетали.РасшифровкаАктива;	
	
	// Представление актива
	ДополнительныеСведения.Вставить("Актив", Строка(ВыборкаДетали._3_Эмитент) + ", " + Строка(ВыборкаДетали.Актив));
	
	// Основные сведения о депозите
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ДепозитныеВклады.ДатаРегистрации КАК _9_ДатаРазмещения,
	                      |	УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК _10_ДатаПогашения,
	                      |	УсловияКредитныхИнструментовСрезПоследних.Процент КАК _11_Ставка
	                      |ИЗ
	                      |	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
	                      |			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения,
	                      |			УсловияКредитныхИнструментовСрезПоследних.Процент КАК Процент
	                      |		ИЗ
	                      |			(ВЫБРАТЬ
	                      |				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
	                      |				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
	                      |			ИЗ
	                      |				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
	                      |						&Дата,
	                      |						ДатаНачалаДействияУсловий <= &Дата
	                      |							И КредитныйИнструмент = &ДепозитныйВклад) КАК УсловияКредитныхИнструментовСрезПоследних
	                      |			ГДЕ
	                      |				УсловияКредитныхИнструментовСрезПоследних.Действует
	                      |			
	                      |			СГРУППИРОВАТЬ ПО
	                      |				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
	                      |						&Дата,
	                      |						ДатаНачалаДействияУсловий <= &Дата
	                      |							И КредитныйИнструмент = &ДепозитныйВклад) КАК УсловияКредитныхИнструментовСрезПоследних
	                      |				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
	                      |					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
	                      |		ПО (УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент = ДепозитныеВклады.Ссылка)
	                      |ГДЕ
	                      |	ДепозитныеВклады.Ссылка = &ДепозитныйВклад");
	Запрос.УстановитьПараметр("ДепозитныйВклад", ДепозитныйВклад);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ЭтотОбъект.Период));
	
	ДополнительныеСведения.Вставить("_9_ДатаРазмещения");
	ДополнительныеСведения.Вставить("_10_ДатаПогашения");
	ДополнительныеСведения.Вставить("_11_Ставка");
	ЗаполнитьЗначенияСвойств(ДополнительныеСведения, Запрос.Выполнить().Выгрузить()[0]);	
	
	// Рейтинги
	//ЮрЛицоБанка = ДепозитныйВклад.БанковскийСчет.Банк.ЮрФизЛицо;
	
	ЮрЛицоБанка = Справочники.ЮрФизЛица.ПустаяСсылка();
	
	ЗапросДепозитныйВклад = Новый Запрос;
	ЗапросДепозитныйВклад.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|ГДЕ
		|	ДепозитныеВклады.Ссылка = &Ссылка";
	
	ЗапросДепозитныйВклад.УстановитьПараметр("Ссылка", ДепозитныйВклад);
	
	РезультатЗапросаЗапросДепозитныйВклад = ЗапросДепозитныйВклад.Выполнить();
	
	ВыборкаДетальныеЗаписиЗапросДепозитныйВклад = РезультатЗапросаЗапросДепозитныйВклад.Выбрать();
	
	Пока ВыборкаДетальныеЗаписиЗапросДепозитныйВклад.Следующий() Цикл
		ЮрЛицоБанка = ВыборкаДетальныеЗаписиЗапросДепозитныйВклад.ЮрФизЛицо;
	КонецЦикла;

	ДополнительныеСведения.Вставить("_16_РейтингЭкспертРА", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.RAEX, ЭтотОбъект.Период, ТаблицаРейтингов));
	ДополнительныеСведения.Вставить("_17_РейтингАКРА", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.АКРА, ЭтотОбъект.Период, ТаблицаРейтингов));

	ДополнительныеСведения.Вставить("_26_РейтингФ", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.FitchRatings, ЭтотОбъект.Период, ТаблицаРейтингов));
	ДополнительныеСведения.Вставить("_27_РейтингМ", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.Moodys, ЭтотОбъект.Период, ТаблицаРейтингов));
	ДополнительныеСведения.Вставить("_28_РейтингС", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.StandardAndPoors, ЭтотОбъект.Период, ТаблицаРейтингов));
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеСведенияОБанковскомСчете(ДополнительныеСведения, ВыборкаДетали, ТаблицаМНО, ТекущаяОбласть, КлючТекущегоВарианта, ТаблицаРейтингов)
	
	БанковскийСчет = ВыборкаДетали.Актив;
	
	// Рейтинги
	//ЮрЛицоБанка = БанковскийСчет.Банк.ЮрФизЛицо;
	
	ЮрЛицоБанка = Справочники.ЮрФизЛица.ПустаяСсылка();
	
	ЗапросБанковскиеСчета = Новый Запрос;
	ЗапросБанковскиеСчета.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	БанковскиеСчета.Банк.ЮрФизЛицо КАК ЮрФизЛицо
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Ссылка = &Ссылка";
	
	ЗапросБанковскиеСчета.УстановитьПараметр("Ссылка", БанковскийСчет);
	
	РезультатЗапросаБанковскиеСчета = ЗапросБанковскиеСчета.Выполнить();
	
	ВыборкаДетальныеЗаписиБанковскиеСчета = РезультатЗапросаБанковскиеСчета.Выбрать();
	
	Пока ВыборкаДетальныеЗаписиБанковскиеСчета.Следующий() Цикл
		ЮрЛицоБанка = ВыборкаДетальныеЗаписиБанковскиеСчета.ЮрФизЛицо;
	КонецЦикла;
	
	ДополнительныеСведения.Вставить("_16_РейтингЭкспертРА", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.RAEX, ЭтотОбъект.Период, ТаблицаРейтингов));
	ДополнительныеСведения.Вставить("_17_РейтингАКРА", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.АКРА, ЭтотОбъект.Период, ТаблицаРейтингов));
	
	ДополнительныеСведения.Вставить("_26_РейтингФ", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.FitchRatings, ЭтотОбъект.Период, ТаблицаРейтингов));
	ДополнительныеСведения.Вставить("_27_РейтингМ", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.Moodys, ЭтотОбъект.Период, ТаблицаРейтингов));
	ДополнительныеСведения.Вставить("_28_РейтингС", ПолучитьРейтингиОтАгенства(ЮрЛицоБанка, Справочники.РейтинговыеАгентства.StandardAndPoors, ЭтотОбъект.Период, ТаблицаРейтингов));
	
	// Заполняем дополнительные сведения перед расшифровкой по МНО,
	// т.к. после объединения ячеек теряются параметры	
	ТекущаяОбласть.Параметры.Заполнить(ДополнительныеСведения);
	
	// НСО
	СписокМНО = ТаблицаМНО.НайтиСтроки(Новый Структура("БанковскийСчет", БанковскийСчет));	
	Если СписокМНО.Количество() > 0 Тогда
		ТекущаяОбласть.Параметры.Заполнить(СписокМНО[СписокМНО.ВГраница()]);
		
		Если КлючТекущегоВарианта = "Образование" Тогда
			КопияИсходнойОбласти	= ТекущаяОбласть.ПолучитьОбласть();
			ИсходнаяОбласть			= КопияИсходнойОбласти.Область();
			ОбластьПриемник			= ТекущаяОбласть.Область(); 
			
			Для н = 1 - СписокМНО.ВГраница() По 0 Цикл // т.к. вставка идет сверху области, делаем в обратном порядке
				КопияИсходнойОбласти.Параметры.Заполнить(СписокМНО[-н]);
				ТекущаяОбласть.ВставитьОбласть(ИсходнаяОбласть, ОбластьПриемник, ТипСмещенияТабличногоДокумента.ПоВертикали, Истина);
			КонецЦикла;		
			
			ОбъединяемыеОбласти = СтрРазделить("2:3, 4:4, 5:5, 6:7, 13:13, 14:14, 15:15, 18:18, 19:19, 20:" + ТекущаяОбласть.ШиринаТаблицы, ", ", Ложь);
			Для Каждого ОбъединяемаяОбласть Из ОбъединяемыеОбласти Цикл  
				ОбъединяемыеКолонки = СтрРазделить(ОбъединяемаяОбласть, ":");
				ТекущаяОбласть.Область(1, ОбъединяемыеКолонки[0], ТекущаяОбласть.ВысотаТаблицы, ОбъединяемыеКолонки[1]).Объединить();	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьДанныеПодвала(ОбластьПодвала)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ЕСТЬNULL(ОстаткиВДУ.Сумма, 0) + ЕСТЬNULL(ОборотыВДУ.Сумма, 0) КАК _ПереданоВДУ,
	                      |	ЕСТЬNULL(ФинансовыйРезультатТекущегоГода.Сумма, 0) КАК _ФинансовыйРезультатТекущегоГода
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		-СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток) КАК Сумма
	                      |	ИЗ
	                      |		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
	                      |				&НачалоГода,
	                      |				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03),
	                      |				,
	                      |				Организация = &Организация
	                      |					И СчетДоверительногоУправления = &СчетДоверительногоУправления
	                      |					И ЛицевойСчет.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего)) КАК ЕдиныйБухгалтерскийУчетОстатки) КАК ОстаткиВДУ,
	                      |	(ВЫБРАТЬ
	                      |		-СУММА(ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот) КАК Сумма
	                      |	ИЗ
	                      |		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
	                      |				&НачалоГода,
	                      |				&КонецПериода,
	                      |				Период,
	                      |				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03),
	                      |				,
	                      |				Организация = &Организация
	                      |					И СчетДоверительногоУправления = &СчетДоверительногоУправления
	                      |					И ЛицевойСчет.ДополнительнаяАналитика <> ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего),
	                      |				НЕ КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрибыльУбытокПрошлогоГода), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеДоходы), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеРасходы), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоРезервам), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеДоходыРасходы), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности)),
	                      |				) КАК ЕдиныйБухгалтерскийУчетОбороты) КАК ОборотыВДУ,
	                      |	(ВЫБРАТЬ
	                      |		-СУММА(ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот) КАК Сумма
	                      |	ИЗ
	                      |		РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
	                      |				&НачалоГода,
	                      |				&КонецПериода,
	                      |				Период,
	                      |				Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрибыльУбытокПрошлогоГода), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеДоходы), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПроцентныеРасходы), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоРезервам), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций), ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеДоходыРасходы), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности)),
	                      |				,
	                      |				Организация = &Организация
	                      |					И СчетДоверительногоУправления = &СчетДоверительногоУправления,
	                      |				,
	                      |				) КАК ЕдиныйБухгалтерскийУчетОбороты
	                      |	ГДЕ
	                      |		(НЕ ЕдиныйБухгалтерскийУчетОбороты.КорСчет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.АктивыВДУ03))
	                      |				ИЛИ ЕдиныйБухгалтерскийУчетОбороты.ЛицевойСчетКор.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ВознаграждениеУправляющего))) КАК ФинансовыйРезультатТекущегоГода");
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ОбластьПодвала.Параметры.Заполнить(РезультатЗапроса.Выгрузить()[0]);				
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
