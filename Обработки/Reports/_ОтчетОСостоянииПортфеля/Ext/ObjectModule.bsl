	Возврат СтруктураВозврата;
КонецФункции

Функция ВывестиТелоОтчета_НоваяМетодика_Будущее(ДокументРезультат, Макет)
	// Области
	ОбластьШапкаЦенныеБумаги 	= Макет.ПолучитьОбласть("ШапкаЦенныеБумаги");
	ОбластьСтрокаЦенныеБумаги 	= Макет.ПолучитьОбласть("СтрокаЦенныеБумаги");
	ОбластьИтогиЦенныеБумаги 	= Макет.ПолучитьОбласть("ИтогиЦенныеБумаги");
		
	ОбластьШапкаПрочее			= Макет.ПолучитьОбласть("ШапкаПрочее");
	ОбластьСтрокаПрочее			= Макет.ПолучитьОбласть("СтрокаПрочее");
	ОбластьИтогиПрочее			= Макет.ПолучитьОбласть("ИтогиПрочее");
	
	ОбщийИтог					= Макет.ПолучитьОбласть("ИтогиПрочее");
	
	// Получаем данные для отчета
	РезультатЗапроса = ПолучитьВыборкуДанных_НоваяМетодика_Будущее();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Если Не ВыборкаОбщийИтог.Следующий() Тогда
		Возврат Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость");
	КонецЕсли;
	
	ВыборкаМакетПрочее = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаМакетПрочее.Следующий() Цикл
		ВыборкаРаздел = ВыборкаМакетПрочее.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРаздел.Следующий() Цикл
			Если ВыборкаМакетПрочее.МакетПрочее Тогда
				ОбластьШапка	= ОбластьШапкаПрочее;
				ОбластьСтрока	= ОбластьСтрокаПрочее;
				ОбластьИтоги	= ОбластьИтогиПрочее;
			Иначе
				ОбластьШапка	= ОбластьШапкаЦенныеБумаги;
				ОбластьСтрока	= ОбластьСтрокаЦенныеБумаги;
				ОбластьИтоги	= ОбластьИтогиЦенныеБумаги;
			КонецЕсли;
			
			ОбластьШапка.Параметры.Заполнить(ВыборкаРаздел);
			ДокументРезультат.Вывести(ОбластьШапка);
			
			ВыборкаДетали = ВыборкаРаздел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДетали.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаДетали.ЕстьРезервНеПокрывающийБалансовуюСтоимость)
					И ВыборкаДетали.ЕстьРезервНеПокрывающийБалансовуюСтоимость
				Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
							"По ЦБ " + ВыборкаДетали.Актив + " сумма резерва превышает балансовую стоимость бумаги ("
							+ Формат(ВыборкаДетали.БалансоваяСтоимостьМинусРезервПодОбесценение, "ЧДЦ=2") + ")!");
				КонецЕсли;
				
				ОчиститьПараметрыОбласти(ОбластьСтрока);
				ОбластьСтрока.Параметры.Заполнить(ВыборкаДетали);
				
				// Дополнительные сведения об активе
				ДополнительныеСведения = Новый Структура;
				
				Если ВыборкаДетали.МакетПрочее Тогда
					ДополнительныеСведения.Вставить("ВидПрочих",
						?(ЗначениеЗаполнено(ВыборкаДетали._1_Вид),
							Строка(ВыборкаДетали._1_Вид) + ": ", "") + Строка(ВыборкаДетали._3_Эмитент) + ?(ЗначениеЗаполнено(ВыборкаДетали.Актив),
							", " + Строка(ВыборкаДетали.Актив), ""));
				КонецЕсли;
				
				ОбластьСтрока.Параметры.Заполнить(ДополнительныеСведения); 
				
				ДокументРезультат.Вывести(ОбластьСтрока);
			КонецЦикла;
			
			ОбластьИтоги.Параметры.Заполнить(ВыборкаРаздел);
			УстановитьПараметрОбласти(ОбластьИтоги, "ВидИтога", "Итого по виду:");
			
			ДокументРезультат.Вывести(ОбластьИтоги);
		КонецЦикла;
	КонецЦикла;
	
	ОбщийИтог.Параметры.Заполнить(ВыборкаОбщийИтог);
	УстановитьПараметрОбласти(ОбщийИтог, "ВидИтога", "Общий итог:");
	
	ДокументРезультат.Вывести(ОбщийИтог);
	
	Возврат Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость",
		Неопределено,
		ВыборкаОбщийИтог._20_РыночнаяСтоимостьБезНКД + ВыборкаОбщийИтог._21_НКД + ВыборкаОбщийИтог._8_СуммаДЗПоДивидендамИПроцентам
			+ ВыборкаОбщийИтог._9_СуммаДЗ - ВыборкаОбщийИтог._10_СуммаКЗ);
КонецФункции

Функция ПолучитьВыборкуДанных_НоваяМетодика_Будущее()
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	
	ВидУчетаБаланс = ОпределитьВидУчета(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЦельРасчета, ЭтотОбъект.Период);
	ВидДоговораДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов
	Тогда
		ВидУчетаБаланс = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	КонецЕсли;
	
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период);

	Если Не РаботаСОтчетами.ПроверитьРегистрациюСЧА(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ПоследнийРабочийДень) Тогда
		Сообщить("Стоимость ценных бумаг или активов, не относящимся к ценным бумагам, на " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy")
			+ " не зарегистрирована. Сведения о рыночной стоимости активов, рассчитанной по новой методике, выведены не будут.");
	КонецЕсли;
	
	ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
	
	// Основной запрос
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(Запрос.МенеджерВременныхТаблиц,, ЭтотОбъект.Период);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА 1
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА 2
