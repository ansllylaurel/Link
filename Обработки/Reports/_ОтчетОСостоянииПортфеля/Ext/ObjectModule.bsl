Функция ВывестиТелоОтчета_НоваяМетодика_Образование(ДокументРезультат, Макет)
	
	// Области
	
	ОбластьШапкаКлассификацияЦенныхБумаг	= Макет.ПолучитьОбласть("ШапкаКлассификацияЦенныхБумаг");
	ОбластьШапкаЦенныеБумаги 				= Макет.ПолучитьОбласть("ШапкаЦенныеБумаги");
	ОбластьСтрокаЦенныеБумаги 				= Макет.ПолучитьОбласть("СтрокаЦенныеБумаги");
	ОбластьИтогиЦенныеБумаги 				= Макет.ПолучитьОбласть("ИтогиЦенныеБумаги");
	ОбластьИтогиКлассификацияЦенныхБумаг	= Макет.ПолучитьОбласть("ИтогиКлассификацияЦенныхБумаг");
	
	ОбластьШапкаДепозиты					= Макет.ПолучитьОбласть("ШапкаДепозиты");
	ОбластьСтрокаДепозиты					= Макет.ПолучитьОбласть("СтрокаДепозиты");
	ОбластьИтогиДепозиты					= Макет.ПолучитьОбласть("ИтогиДепозиты");
	
	ОбластьШапкаБанковскиеСчета				= Макет.ПолучитьОбласть("ШапкаБанковскиеСчета");
	ОбластьСтрокаБанковскиеСчета			= Макет.ПолучитьОбласть("СтрокаБанковскиеСчета");
	ОбластьИтогиБанковскиеСчета				= Макет.ПолучитьОбласть("ИтогиБанковскиеСчета");
	
	ОбластьШапкаБрокерскиеСчета				= Макет.ПолучитьОбласть("ШапкаБрокерскиеСчета");
	ОбластьСтрокаБрокерскиеСчета			= Макет.ПолучитьОбласть("СтрокаБрокерскиеСчета");
	ОбластьИтогиБрокерскиеСчета				= Макет.ПолучитьОбласть("ИтогиБрокерскиеСчета");
	
	ОбластьШапкаПрочее						= Макет.ПолучитьОбласть("ШапкаПрочее");
	ОбластьСтрокаПрочее						= Макет.ПолучитьОбласть("СтрокаПрочее");
	ОбластьИтогиПрочее						= Макет.ПолучитьОбласть("ИтогиПрочее");
	
	ОбщийИтог								= Макет.ПолучитьОбласть("ОбщийИтог");
	
	// Получаем данные для отчета	
	
	СтруктураВозврата			= ПолучитьВыборкуДанных_НоваяМетодика_Образование(); 
	РезультатЗапроса			= СтруктураВозврата.РезультатЗапроса; 
		
	ТаблицаРейтингов            = СтруктураВозврата.МенеджерВременныхТаблиц;	
	ВыборкаОбщийИтог			= РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	ТаблицаМНО					= РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить();	
	
	Если ВыборкаОбщийИтог.Следующий() Тогда 
		
		ВыборкаМакетПрочее = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаМакетПрочее.Следующий() Цикл
			
			ВыборкаКлассификацияЦБ = ВыборкаМакетПрочее.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКлассификацияЦБ.Следующий() Цикл
				
				Если Не ВыборкаМакетПрочее.МакетПрочее Тогда
					ОбластьШапкаКлассификацияЦенныхБумаг.Параметры.Заполнить(ВыборкаКлассификацияЦБ);
					ДокументРезультат.Вывести(ОбластьШапкаКлассификацияЦенныхБумаг);
				КонецЕсли;
				
				ВыборкаПорядок = ВыборкаКлассификацияЦБ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаПорядок.Следующий() Цикл
					
					ВыборкаРаздел = ВыборкаПорядок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаРаздел.Следующий() Цикл
						
						Если ВыборкаМакетПрочее.МакетПрочее Тогда
							Если ВыборкаРаздел.ВидИтога = "Депозиты" Тогда
								ОбластьШапка	= ОбластьШапкаДепозиты;
								ОбластьСтрока	= ОбластьСтрокаДепозиты;
								ОбластьИтоги	= ОбластьИтогиДепозиты;
							ИначеЕсли ВыборкаРаздел.ВидИтога = "Денежные средства на расчетных счетах" Тогда 
								ОбластьШапка	= ОбластьШапкаБанковскиеСчета;
								ОбластьИтоги	= ОбластьИтогиБанковскиеСчета;
							ИначеЕсли ВыборкаРаздел.ВидИтога = "Денежные средства на брокерских счетах" Тогда 
								ОбластьШапка	= ОбластьШапкаБрокерскиеСчета;
								ОбластьСтрока	= ОбластьСтрокаБрокерскиеСчета;
								ОбластьИтоги	= ОбластьИтогиБрокерскиеСчета;
							Иначе
								ОбластьШапка	= ОбластьШапкаПрочее;
								ОбластьСтрока	= ОбластьСтрокаПрочее;
								ОбластьИтоги	= ОбластьИтогиПрочее;
							КонецЕсли;
						Иначе
							ОбластьШапка	= ОбластьШапкаЦенныеБумаги;
							ОбластьСтрока	= ОбластьСтрокаЦенныеБумаги;
							ОбластьИтоги	= ОбластьИтогиЦенныеБумаги;
						КонецЕсли;
						
						ОбластьШапка.Параметры.Заполнить(ВыборкаРаздел);
						ДокументРезультат.Вывести(ОбластьШапка);
						
						ВыборкаДетали = ВыборкаРаздел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

						Пока ВыборкаДетали.Следующий() Цикл
							
							Если ЗначениеЗаполнено(ВыборкаДетали.ЕстьРезервНеПокрывающийБалансовуюСтоимость)
								И ВыборкаДетали.ЕстьРезервНеПокрывающийБалансовуюСтоимость
							Тогда
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
									СтрШаблон("По ЦБ %1 сумма резерва превышает балансовую стоимость бумаги (%2)!",
										ВыборкаДетали.Актив, Формат(ВыборкаДетали.БалансоваяСтоимостьМинусРезервПодОбесценение, "ЧДЦ=2")));
							КонецЕсли;
							
							// Т.к. из-за МНО может меняться кол-во строк и теряются параметры
							Если ВыборкаМакетПрочее.МакетПрочее И ВыборкаРаздел.ВидИтога = "Денежные средства на расчетных счетах" Тогда 
								ОбластьСтрока = ОбластьСтрокаБанковскиеСчета.ПолучитьОбласть();
							Иначе
								ОчиститьПараметрыОбласти(ОбластьСтрока);							
							КонецЕсли;						
							
							ОбластьСтрока.Параметры.Заполнить(ВыборкаДетали);
							
							// Дополнительные сведения об активе
							
							ДополнительныеСведения = Новый Структура;
							
							Если ВыборкаДетали.МакетПрочее Тогда
								
								Если ВыборкаДетали.ВидИтога = "Депозиты" Тогда
									
									ЗаполнитьДополнительныеСведенияОДепозите(ДополнительныеСведения, ВыборкаДетали, ТаблицаРейтингов);		
																	
								ИначеЕсли ВыборкаДетали.ВидИтога = "Денежные средства на расчетных счетах" Тогда
									
									ЗаполнитьДополнительныеСведенияОБанковскомСчете(ДополнительныеСведения, ВыборкаДетали, ТаблицаМНО, ОбластьСтрока, ЭтотОбъект.КлючТекущегоВарианта, ТаблицаРейтингов);
																	
								ИначеЕсли ВыборкаДетали.ВидИтога = "Кредиторская задолженность" Тогда	
									
									ДополнительныеСведения.Вставить("_4_ВалютнаяБалансоваяСтоимостьБезНКД",					-ОбластьСтрока.Параметры._4_ВалютнаяБалансоваяСтоимостьБезНКД);
									ДополнительныеСведения.Вставить("_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП",	-ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП);
									ДополнительныеСведения.Вставить("_22_РыночнаяСтоимостьСУчетомНКД",						-ОбластьСтрока.Параметры._22_РыночнаяСтоимостьСУчетомНКД);
									
								КонецЕсли;
								
								ДополнительныеСведения.Вставить("ВидПрочих", ?(ЗначениеЗаполнено(ВыборкаДетали._1_Вид), Строка(ВыборкаДетали._1_Вид) + ": ", "")
																				+ Строка(ВыборкаДетали._3_Эмитент)
																				+ ?(ЗначениеЗаполнено(ВыборкаДетали.Актив) И ЗначениеЗаполнено(ВыборкаДетали._3_Эмитент), ", ", "")
																				+ ?(ЗначениеЗаполнено(ВыборкаДетали.Актив), Строка(ВыборкаДетали.Актив), ""));
								
							Иначе
								
								Если ТипЗнч(ВыборкаДетали._1_Вид) = Тип("ПеречислениеСсылка.КатегорииОблигаций") Тогда
									ДополнительныеСведения.Вставить("_1_Вид", Строка(ВыборкаДетали._1_Вид) + " облигация");
								КонецЕсли;
								
								ДополнительныеСведения.Вставить("_16_РейтингЭкспертРА", ПолучитьРейтингиОтАгенства(ВыборкаДетали.Актив, Справочники.РейтинговыеАгентства.RAEX, ЭтотОбъект.Период, ТаблицаРейтингов));
								ДополнительныеСведения.Вставить("_17_РейтингАКРА", ПолучитьРейтингиОтАгенства(ВыборкаДетали.Актив, Справочники.РейтинговыеАгентства.АКРА, ЭтотОбъект.Период, ТаблицаРейтингов));
								
								
								ДополнительныеСведения.Вставить("_26_РейтингФ", ПолучитьРейтингиОтАгенства(ВыборкаДетали.Актив, Справочники.РейтинговыеАгентства.FitchRatings, ЭтотОбъект.Период, ТаблицаРейтингов));
								ДополнительныеСведения.Вставить("_27_РейтингМ", ПолучитьРейтингиОтАгенства(ВыборкаДетали.Актив, Справочники.РейтинговыеАгентства.Moodys, ЭтотОбъект.Период, ТаблицаРейтингов));
								ДополнительныеСведения.Вставить("_28_РейтингС", ПолучитьРейтингиОтАгенства(ВыборкаДетали.Актив, Справочники.РейтинговыеАгентства.StandardAndPoors, ЭтотОбъект.Период, ТаблицаРейтингов));
								
								Если ВыборкаДетали.КоличествоБэкОфис = 0 Тогда
									ДополнительныеСведения.Вставить("_29_СправедливаяБЭКОФИС", 0);
								ИначеЕсли ЭтотОбъект.КлючТекущегоВарианта = "Эволюция" Тогда
									ДополнительныеСведения.Вставить("_29_СправедливаяБЭКОФИС", ВыборкаДетали._20_РыночнаяСтоимостьБезНКД / ВыборкаДетали.КоличествоБэкОфис);
									Если НЕ ЗначениеЗаполнено(ВыборкаДетали._9_ИсточникЦены) И ВыборкаДетали._20_ВидКотировки = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена Тогда
										ДополнительныеСведения.Вставить("_9_ИсточникЦены", "Расчетная цена");
									КонецЕсли;
									Если НЕ ЗначениеЗаполнено(ВыборкаДетали._21_Источник) И ВыборкаДетали._20_ВидКотировки = Перечисления.ИсточникиЦеныДляПереоценки.РасчетнаяЦена Тогда
										ДополнительныеСведения.Вставить("_21_Источник", "Расчетная цена");
									КонецЕсли;
								Иначе
									ДополнительныеСведения.Вставить("_29_СправедливаяБЭКОФИС", ВыборкаДетали._22_РыночнаяСтоимостьСУчетомНКД / ВыборкаДетали.КоличествоБэкОфис);
								КонецЕсли;
								
								Если ТипЗнч(ВыборкаДетали.Актив) = Тип("СправочникСсылка.Облигации") Тогда
									ПогашенияКупонов = Справочники.Облигации.ПолучитьПогашенияКупонов(ВыборкаДетали.Актив, Истина, ЭтотОбъект.Период);
									Если ПогашенияКупонов.Количество() > 0 Тогда 
										ДополнительныеСведения.Вставить("_25_ДнейДоПогашенияКупона", (ПогашенияКупонов[0].Дата - ЭтотОбъект.Период) / 86400);
										ДополнительныеСведения.Вставить("_25_СтавкаКупона", ПогашенияКупонов[0].Ставка);
									КонецЕсли;
								КонецЕсли;
								
							КонецЕсли;
							
							ОбластьСтрока.Параметры.Заполнить(ДополнительныеСведения); 
							ДокументРезультат.Вывести(ОбластьСтрока);
							
						КонецЦикла;
						
						// Итого по разделу
						
						ОбластьИтоги.Параметры.Заполнить(ВыборкаРаздел);
						
						Если ВыборкаРаздел.МакетПрочее Тогда
							Если ВыборкаРаздел.ВидИтога = "Кредиторская задолженность" Тогда
								ОбластьИтоги.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП	= -ВыборкаРаздел._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
								ОбластьИтоги.Параметры._22_РыночнаяСтоимостьСУчетомНКД						= -ВыборкаРаздел._22_РыночнаяСтоимостьСУчетомНКД;
							КонецЕсли; 
						КонецЕсли;
						
						ДокументРезультат.Вывести(ОбластьИтоги);
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЦикла;
			
			// Итого по ценным бумагам			
			
			Если Не ВыборкаМакетПрочее.МакетПрочее Тогда
				ОбластьИтогиКлассификацияЦенныхБумаг.Параметры.Заполнить(ВыборкаМакетПрочее);
				ДокументРезультат.Вывести(ОбластьИтогиКлассификацияЦенныхБумаг);
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;
	
	ОбщийИтог.Параметры.Заполнить(ВыборкаОбщийИтог);
	ДокументРезультат.Вывести(ОбщийИтог);	
	
	Возврат Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость",
		ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП,
		ВыборкаОбщийИтог._22_РыночнаяСтоимостьСУчетомНКД);	
	
КонецФункции

Функция ПолучитьВыборкуДанных_НоваяМетодика_Образование()
	// Основной запрос
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(Запрос.МенеджерВременныхТаблиц,, ЭтотОбъект.Период);
	
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки КАК БУЛЕВО) КАК ПризнатьВыпускДефолтным,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ДефолтныеЦБ
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекУчетаЦенныхБумаг.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиУчетаЦенныхБумаг.ПризнатьДефолтной)) КАК ЗначенияНастроекУчетаЦенныхБумагСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И (&БезОтбораПоСчетамДУ
		|							И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						ИЛИ СчетДоверительногоУправления В (&ОтборСчетаДУ))) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Клиент)
		|ГДЕ
		|	ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.ЗначениеНастройки = ИСТИНА
		|	И НЕ ЗначенияНастроекУчетаЦенныхБумагСрезПоследних.Отключить
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА 1
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА 2
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Муниципальная)
		|						ТОГДА 3
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
		|						ТОГДА 4
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА 5
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Ипотечная)
		|						ТОГДА 6
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА 7
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Порядок,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_КлассификацииЦенныхБумаг.КлассификацияЦенныхБумагТекстовая, ""Прочие ценные бумаги"") КАК КлассификацияЦенныхБумаг,
		|	ЕСТЬNULL(_КлассификацииЦенныхБумаг.КлассификацияЦенныхБумагЦифровая, 4.1) КАК КлассификацияЦенныхБумагЦифровая,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).Эмитент
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК НомерГосРегистрации,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).Номинал
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Номинал
		|		ИНАЧЕ 0
