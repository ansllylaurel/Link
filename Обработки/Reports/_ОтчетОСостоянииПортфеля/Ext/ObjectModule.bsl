	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	Запрос.УстановитьПараметр("СубконтоКонтрагентыОснованиеРасчетов", МассивСубконтоКонтрагентыОснованиеРасчетов);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры", СубконтоКонтрагентыДоговоры);
	
	Возврат Запрос.ВыполнитьПакет();
КонецФункции

#КонецОбласти

#Область Новая_методика

Функция ВывестиТелоОтчета_НоваяМетодика(ДокументРезультат, Макет, ЭтоБлагосостояние, ЭтоНефтегарант, ЭтоПечатнаяФорма, ЭтоБлагосостояние2019)	
	
	Если ЭтоНефтегарант Тогда
		СписокЦБРФ = ПолучитьСписокЦБРФ();
	КонецЕсли;
	
	// Области
	ОбластьСтрокаЦенныеБумаги 		= Макет.ПолучитьОбласть("СтрокаЦенныеБумаги");
	ОбластьИтогиЦенныеБумаги 		= Макет.ПолучитьОбласть("ИтогиЦенныеБумаги");
	ОбластьСтрокаДенежныеСредства 	= Макет.ПолучитьОбласть("СтрокаДенежныеСредства");
	ОбластьИтогиДенежныеСредства	= Макет.ПолучитьОбласть("ИтогиДенежныеСредства");
	
	// Получаем данные для отчета	
	ТаблицаРезервов					= ПолучитьТаблицуРезервов();
	ТаблицаРезервовПодОбесценение	= ПолучитьТаблицуРезервовПодОбесценение();
	Если ЭтоБлагосостояние Тогда
		РезультатЗапроса				= ПолучитьВыборкуДанных_НоваяМетодикаБлагосостояние(); 
	Иначе	
		РезультатЗапроса				= ПолучитьВыборкуДанных_НоваяМетодика(ЭтоПечатнаяФорма); 
	Конецесли;	
	                                                                 		
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаОбщийИтог.Следующий();
	
	ВыборкаМакетПрочее = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НКДВсего = 0;
	РыночнаяБезНКДВсего = 0;
	РыночнаяСНКДВсего = 0;
	
	Уменьшить_Итог_13_БалансоваяСтоимостьБезНКД	= 0;
	Уменьшить_Итог_15_НКДУплаченныйНачисленный	= 0;
	Уменьшить_Итог_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = 0;
	
	СуммаРезервовВсего = 0;
	
	Пока ВыборкаМакетПрочее.Следующий() Цикл
		РыночнаяСНКДМакетПрочее = 0;
		
		ВыборкаПорядок = ВыборкаМакетПрочее.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПорядок.Следующий() Цикл
			ВыборкаРаздел = ВыборкаПорядок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаРаздел.Следующий() Цикл
				ВыборкаДетали = ВыборкаРаздел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				РыночнаяСНКДРаздел 		= 0;
				РыночнаяБезНКДРаздел 	= 0;
				НКДРаздел 				= 0;
				
				Уменьшить_13_БалансоваяСтоимостьБезНКД	= 0;
				Уменьшить_15_НКДУплаченныйНачисленный	= 0;
				Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = 0;
				
				Если НЕ ЭтоБлагосостояние Тогда
					Уменьшить_14_Переоценка					= 0;
					Уменьшить_16_Дисконт					= 0;
					Уменьшить_17_Премия						= 0;
					Уменьшить_18_Корректировка				= 0;
				КонецЕсли;
				
				Пока ВыборкаДетали.Следующий() Цикл
					Если ЗначениеЗаполнено(ВыборкаДетали.ЕстьРезервНеПокрывающийБалансовуюСтоимость)
						И ВыборкаДетали.ЕстьРезервНеПокрывающийБалансовуюСтоимость Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По ЦБ " + ВыборкаДетали.Актив
																		+ " сумма резерва превышает балансовую стоимость бумаги ("
																		+ Формат(ВыборкаДетали.БалансоваяСтоимостьМинусРезервПодОбесценение, "ЧДЦ=2")
																		+ ")!");
					КонецЕсли;
					
					РыночнаяБезНКД 	= ВыборкаДетали._20_РыночнаяСтоимостьБезНКД;
					НКД 			= ВыборкаДетали._21_НКД;
					РыночнаяСНКД 	= ВыборкаДетали._22_РыночнаяСтоимостьСУчетомНКД; 
					
					Если ВыборкаДетали.МакетПрочее Тогда
						ОбластьСтрокаДенежныеСредства.Параметры.Заполнить(ВыборкаДетали);
						ОбластьСтрокаДенежныеСредства.Параметры.ВидПрочих =
							?(ЗначениеЗаполнено(ВыборкаДетали._1_Вид), Строка(ВыборкаДетали._1_Вид) + ": ", "")
							+ Строка(ВыборкаДетали._3_Эмитент)
							+ ?(ЗначениеЗаполнено(ВыборкаДетали.Актив), ", " + Строка(ВыборкаДетали.Актив), "");
							
						Если ВыборкаДетали._1_Вид = "Кредиторская задолженность" Тогда	
							Если Не ЭтоПечатнаяФорма Тогда	
								ОбластьСтрокаДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = -ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
							КонецЕсли;
							Если Не ЭтоБлагосостояние2019 Тогда
								ОбластьСтрокаДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = -ОбластьСтрокаДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД;
							КонецЕсли;
						КонецЕсли; 
						
						ДокументРезультат.Вывести(ОбластьСтрокаДенежныеСредства);
					Иначе
						ОбластьСтрокаЦенныеБумаги.Параметры.Заполнить(ВыборкаДетали);
						Если ТипЗнч(ВыборкаДетали._1_Вид) = Тип("ПеречислениеСсылка.КатегорииОблигаций") Тогда
							ОбластьСтрокаЦенныеБумаги.Параметры._1_Вид = Строка(ВыборкаДетали._1_Вид) + " облигация";
						КонецЕсли;
						
						Если ВыборкаДетали._1_Вид = "Депозит" Тогда					
							ОбластьСтрокаЦенныеБумаги.Параметры._3_Эмитент = Строка(ВыборкаДетали._3_Эмитент) + ", " + Строка(ВыборкаДетали.Актив);					
						КонецЕсли; 
						
						Если ЭтоБлагосостояние Тогда
							Если Не ЭтоПечатнаяФорма Тогда
								ОбластьСтрокаЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = 
									ВыборкаДетали._13_БалансоваяСтоимостьБезНКД + 
									ВыборкаДетали._14_Переоценка + 
									ВыборкаДетали._16_Дисконт + 
									ВыборкаДетали._17_Премия + 
									ВыборкаДетали._18_Корректировка;
							КонецЕсли;	
						КонецЕсли; 
						
						//НайденныеРезервы = ТаблицаРезервов.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаДетали.Актив));
						//Если НайденныеРезервы.Количество() > 0 Тогда
						//	СтрокаРезерва = НайденныеРезервы[0];
						//	
						//	Если СтрокаРезерва.СуммаРезерва >= ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП Тогда
						//		СтрокаРезерва.СуммаРезерва  = СтрокаРезерва.СуммаРезерва - ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
						//		
						//		Уменьшить_13_БалансоваяСтоимостьБезНКД	= Уменьшить_13_БалансоваяСтоимостьБезНКД	+ ВыборкаДетали._13_БалансоваяСтоимостьБезНКД;
						//		Уменьшить_15_НКДУплаченныйНачисленный	= Уменьшить_15_НКДУплаченныйНачисленный		+ ВыборкаДетали._15_НКДУплаченныйНачисленный;
						//		Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
						//		
						//		Уменьшить_Итог_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = Уменьшить_Итог_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
						//		
						//		Если Не ЭтоПечатнаяФорма Тогда
						//			ОбластьСтрокаЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = 0;
						//			ОбластьСтрокаЦенныеБумаги.Параметры._15_НКДУплаченныйНачисленный = 0;
						//			ОбластьСтрокаЦенныеБумаги.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = 0;
						//			
						//			Если НЕ ЭтоБлагосостояние Тогда
						//				Уменьшить_14_Переоценка					= Уменьшить_14_Переоценка					+ ВыборкаДетали._14_Переоценка;
						//				Уменьшить_16_Дисконт					= Уменьшить_16_Дисконт						+ ВыборкаДетали._16_Дисконт;
						//				Уменьшить_17_Премия						= Уменьшить_17_Премия						+ ВыборкаДетали._17_Премия;
						//				Уменьшить_18_Корректировка				= Уменьшить_18_Корректировка				+ ВыборкаДетали._18_Корректировка;
						//				
						//				ОбластьСтрокаЦенныеБумаги.Параметры._14_Переоценка = 0;
						//				ОбластьСтрокаЦенныеБумаги.Параметры._16_Дисконт = 0;
						//				ОбластьСтрокаЦенныеБумаги.Параметры._17_Премия = 0;
						//				ОбластьСтрокаЦенныеБумаги.Параметры._18_Корректировка = 0;
						//			КонецЕсли;
						//		КонецЕсли;	
						//	КонецЕсли;
						//КонецЕсли;
						
						Если ВыборкаДетали.ДефолтнаяБумага И (НЕ ЭтоПечатнаяФорма)  Тогда
							
							ОбластьСтрокаЦенныеБумаги.Параметры._8_ДатаЦены = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._9_ИсточникЦены = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._10_УровеньОпределенияЦены = 0;
							ОбластьСтрокаЦенныеБумаги.Параметры._12_БалансоваяЦена = 0;
							ОбластьСтрокаЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = 0;
							ОбластьСтрокаЦенныеБумаги.Параметры._15_НКДУплаченныйНачисленный = 0;
							ОбластьСтрокаЦенныеБумаги.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = 0;
							
							Если НЕ ЭтоБлагосостояние2019 Тогда
								ОбластьСтрокаЦенныеБумаги.Параметры._11_СтавкаЭСП = 0;
							КонецЕсли;
							
							Если ЭтоБлагосостояние ИЛИ ЭтоБлагосостояние2019 Тогда
								ОбластьСтрокаЦенныеБумаги.Параметры._12_ПрибыльУбыток = 0;
							Иначе
								ОбластьСтрокаЦенныеБумаги.Параметры._14_Переоценка = 0;
								ОбластьСтрокаЦенныеБумаги.Параметры._16_Дисконт = 0;
								ОбластьСтрокаЦенныеБумаги.Параметры._17_Премия = 0;
								ОбластьСтрокаЦенныеБумаги.Параметры._18_Корректировка = 0;
							КонецЕсли; 
							
							Уменьшить_13_БалансоваяСтоимостьБезНКД	= Уменьшить_13_БалансоваяСтоимостьБезНКД + ВыборкаДетали._13_БалансоваяСтоимостьБезНКД;
							Уменьшить_15_НКДУплаченныйНачисленный	= Уменьшить_15_НКДУплаченныйНачисленный + ВыборкаДетали._15_НКДУплаченныйНачисленный;
							Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + ВыборкаДетали._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
							
							Если НЕ ЭтоБлагосостояние Тогда
								Уменьшить_14_Переоценка					= Уменьшить_14_Переоценка + ВыборкаДетали._14_Переоценка;
								Уменьшить_16_Дисконт					= Уменьшить_16_Дисконт + ВыборкаДетали._16_Дисконт;
								Уменьшить_17_Премия						= Уменьшить_17_Премия + ВыборкаДетали._17_Премия;
								Уменьшить_18_Корректировка				= Уменьшить_18_Корректировка + ВыборкаДетали._18_Корректировка;
							КонецЕсли;
							
						КонецЕсли; 
						
						Если ЭтоНефтегарант Тогда
						
							ОбластьСтрокаЦенныеБумаги.Параметры._25_ДатаВыпуска = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._26_ДатаПогашения = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._27_ДатаАмортизации = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._28_ДатаОферты = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._29_ДатаНКД = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._30_ПроцентНКД = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._31_ФиксСтавкаНКД = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._32_ПлавСтавкаНКД = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._33_ДатаДивиденды = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._34_Рейтинг = "";
							ОбластьСтрокаЦенныеБумаги.Параметры._35_СписокЦБРФ = "";
							
							Если ТипЗнч(ВыборкаДетали.Актив) = Тип("СправочникСсылка.Акции") Тогда
								
								ОбластьСтрокаЦенныеБумаги.Параметры._25_ДатаВыпуска = Формат(ВыборкаДетали.Актив.ДатаРегистрации, "ДФ=dd.MM.yyyy");
								ОбластьСтрокаЦенныеБумаги.Параметры._33_ДатаДивиденды = Формат(Справочники.Акции.ПолучитьДатуДивидендов(ВыборкаДетали.Актив, ЭтотОбъект.Период), "ДФ=dd.MM.yyyy");
								
								ОбластьСтрокаЦенныеБумаги.Параметры._34_Рейтинг = ПолучитьРейтинги(ВыборкаДетали.Актив.Эмитент.ЮрФизЛицо, ЭтотОбъект.Период);
								
								Строки = СписокЦБРФ.НайтиСтроки(Новый Структура("Объект", ВыборкаДетали.Актив.Эмитент.ЮрФизЛицо));
								Если Строки.Количество() > 0 Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._35_СписокЦБРФ = Строки[0].ВидПеречня;
								КонецЕсли;
								
							ИначеЕсли ТипЗнч(ВыборкаДетали.Актив) = Тип("СправочникСсылка.Облигации") Тогда
								
								ОбластьСтрокаЦенныеБумаги.Параметры._25_ДатаВыпуска = Формат(ВыборкаДетали.Актив.ДатаРегистрации, "ДФ=dd.MM.yyyy");
								ОбластьСтрокаЦенныеБумаги.Параметры._26_ДатаПогашения = Формат(ВыборкаДетали.Актив.ДатаПогашения, "ДФ=dd.MM.yyyy");
								
								Если ВыборкаДетали.Актив.Амортизационная Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._27_ДатаАмортизации = Формат(Справочники.Облигации.ПолучитьДатуИСуммуАмортизации(ВыборкаДетали.Актив, ЭтотОбъект.Период).ДатаАмортизации, "ДФ=dd.MM.yyyy");
								КонецЕсли;
									
								ОбластьСтрокаЦенныеБумаги.Параметры._28_ДатаОферты = Формат(Справочники.Облигации.ПолучитьДатуИЦенуВыкупа(ВыборкаДетали.Актив, ЭтотОбъект.Период).ДатаВыкупа, "ДФ=dd.MM.yyyy");
								Если ОбластьСтрокаЦенныеБумаги.Параметры._26_ДатаПогашения = ОбластьСтрокаЦенныеБумаги.Параметры._28_ДатаОферты Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._28_ДатаОферты = "";
								КонецЕсли;
								
								ПогашенияКупонов = Справочники.Облигации.ПолучитьПогашенияКупонов(ВыборкаДетали.Актив, Истина, ЭтотОбъект.Период);
								
								Если ПогашенияКупонов.Количество() > 0 Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._29_ДатаНКД = Формат(ПогашенияКупонов[0].Дата, "ДФ=dd.MM.yyyy");
									ОбластьСтрокаЦенныеБумаги.Параметры._30_ПроцентНКД = ПогашенияКупонов[0].Ставка;
								КонецЕсли;
								
								Если ВыборкаДетали.Актив.Тип = Перечисления.ТипыОблигаций.КупоннаяПК Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._31_ФиксСтавкаНКД = "Нет";
									ОбластьСтрокаЦенныеБумаги.Параметры._32_ПлавСтавкаНКД = "Да";
								ИначеЕсли ВыборкаДетали.Актив.Тип = Перечисления.ТипыОблигаций.КупоннаяПД Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._31_ФиксСтавкаНКД = "Да";
									ОбластьСтрокаЦенныеБумаги.Параметры._32_ПлавСтавкаНКД = "Нет";
								Иначе
									ОбластьСтрокаЦенныеБумаги.Параметры._31_ФиксСтавкаНКД = "-";
									ОбластьСтрокаЦенныеБумаги.Параметры._32_ПлавСтавкаНКД = "-";
								КонецЕсли;
								
								ОбластьСтрокаЦенныеБумаги.Параметры._34_Рейтинг = ПолучитьРейтинги(ВыборкаДетали.Актив.Эмитент.ЮрФизЛицо, ЭтотОбъект.Период);
								
								Строки = СписокЦБРФ.НайтиСтроки(Новый Структура("Объект", ВыборкаДетали.Актив.Эмитент.ЮрФизЛицо));
								Если Строки.Количество() > 0 Тогда
									ОбластьСтрокаЦенныеБумаги.Параметры._35_СписокЦБРФ = Строки[0].ВидПеречня;
								КонецЕсли;
								
							КонецЕсли;
						
						КонецЕсли;
						
						ДокументРезультат.Вывести(ОбластьСтрокаЦенныеБумаги);
					КонецЕсли; 
					
					Если ВыборкаРаздел.МакетПрочее Тогда
						РыночнаяСНКДРаздел 		= РыночнаяСНКДРаздел + РыночнаяСНКД;
						РыночнаяСНКДМакетПрочее = РыночнаяСНКДМакетПрочее + РыночнаяСНКД;
						РыночнаяСНКДВсего 		= РыночнаяСНКДВсего + РыночнаяСНКД;
					Иначе
						РыночнаяБезНКДРаздел 	= РыночнаяБезНКДРаздел + РыночнаяБезНКД;
						НКДРаздел 				= НКДРаздел + НКД;
						РыночнаяСНКДРаздел 		= РыночнаяСНКДРаздел + НКД + РыночнаяБезНКД;
						РыночнаяСНКДМакетПрочее = РыночнаяСНКДМакетПрочее + НКД + РыночнаяБезНКД;
						РыночнаяСНКДВсего 		= РыночнаяСНКДВсего + НКД + РыночнаяБезНКД;
					КонецЕсли;
				КонецЦикла;
				
				Если ВыборкаРаздел.МакетПрочее Тогда
					
					СуммаРезерва = 0;
					
					Если ВыборкаРаздел._1_Вид = "МНО" Тогда
						ВидРезерва = "МНО"; 
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на расчетных счетах" Тогда
						ВидРезерва = "ДС на РС";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на брокерских счетах" Тогда
						ВидРезерва = "ДС на БС";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Депозит" Тогда
						ВидРезерва = "Депозит";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на клиринговых счетах" Тогда	
						ВидРезерва = "ДС на КС";
					Иначе
						ВидРезерва = Неопределено;
					КонецЕсли;
					
					Резерв = ТаблицаРезервовПодОбесценение.НайтиСтроки(Новый Структура("ВидРезерва", ВидРезерва));
					
					Если Резерв.Количество() > 0 И Не ЭтоПечатнаяФорма Тогда
						Если НЕ ЭтоБлагосостояние2019 Тогда
							ОбластьСтрокаДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = 0;
						КонецЕсли;	
						
						СуммаРезерва = Резерв[0].СуммаРезерва;
						
						ОбластьСтрокаДенежныеСредства.Параметры.ВидПрочих												= "Резерв под обесценение:";
						ОбластьСтрокаДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП	= СуммаРезерва;
						
						СуммаРезервовВсего = СуммаРезервовВсего + СуммаРезерва;
						
						ДокументРезультат.Вывести(ОбластьСтрокаДенежныеСредства);
					КонецЕсли;
					
					ОбластьИтогиДенежныеСредства.Параметры.Заполнить(ВыборкаРаздел);
					Если НЕ ЭтоБлагосостояние2019 Тогда
						ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД 	= РыночнаяСНКДРаздел;
					КонецЕсли;	
					
					Если ВыборкаРаздел._1_Вид = "Кредиторская задолженность" Тогда
						Если Не ЭтоПечатнаяФорма Тогда
							ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = -ВыборкаРаздел._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
						КонецЕсли;	
						Если НЕ ЭтоБлагосостояние2019 Тогда
							ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = -ВыборкаРаздел._22_РыночнаяСтоимостьСУчетомНКД;
						КонецЕсли;	
					ИначеЕсли ВыборкаРаздел._1_Вид = "МНО"
						ИЛИ ВыборкаРаздел._1_Вид = "Денежные средства на расчетных счетах"
						ИЛИ ВыборкаРаздел._1_Вид = "Денежные средства на брокерских счетах" Тогда
						Если Не ЭтоПечатнаяФорма Тогда
							ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезерва;
						КонецЕсли;
					КонецЕсли; 
					
					ДокументРезультат.Вывести(ОбластьИтогиДенежныеСредства);
				Иначе
					
					СуммаРезерва = 0;
					
					Если ВыборкаРаздел._1_Вид = "МНО" Тогда
						ВидРезерва = "МНО"; 
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на расчетных счетах" Тогда
						ВидРезерва = "ДС на РС";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Денежные средства на брокерских счетах" Тогда
						ВидРезерва = "ДС на БС";
					ИначеЕсли ВыборкаРаздел._1_Вид = "Депозит" Тогда
						ВидРезерва = "Депозит";
					Иначе
						ВидРезерва = Неопределено;
					КонецЕсли;
					
					Резерв = ТаблицаРезервовПодОбесценение.НайтиСтроки(Новый Структура("ВидРезерва", ВидРезерва));
					
					Если Резерв.Количество() > 0 И Не ЭтоПечатнаяФорма Тогда
						Если НЕ ЭтоБлагосостояние2019 Тогда
							ОбластьСтрокаДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = 0;
						КонецЕсли;	
						
						СуммаРезерва = Резерв[0].СуммаРезерва;
						
						ОбластьСтрокаДенежныеСредства.Параметры.ВидПрочих												= "Резерв под обесценение:";
						ОбластьСтрокаДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП	= СуммаРезерва;
						
						СуммаРезервовВсего = СуммаРезервовВсего + СуммаРезерва;
						
						ДокументРезультат.Вывести(ОбластьСтрокаДенежныеСредства);
					КонецЕсли;
					
					ОбластьИтогиЦенныеБумаги.Параметры.Заполнить(ВыборкаРаздел);
					
					Если Не ЭтоПечатнаяФорма Тогда
						ОбластьИтогиЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = ВыборкаРаздел._13_БалансоваяСтоимостьБезНКД - Уменьшить_13_БалансоваяСтоимостьБезНКД;
						ОбластьИтогиЦенныеБумаги.Параметры._15_НКДУплаченныйНачисленный = ВыборкаРаздел._15_НКДУплаченныйНачисленный - Уменьшить_15_НКДУплаченныйНачисленный;
						ОбластьИтогиЦенныеБумаги.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ВыборкаРаздел._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - Уменьшить_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезерва;
						
						Если НЕ ЭтоБлагосостояние Тогда
							ОбластьИтогиЦенныеБумаги.Параметры._14_Переоценка = ВыборкаРаздел._14_Переоценка - Уменьшить_14_Переоценка;
							ОбластьИтогиЦенныеБумаги.Параметры._16_Дисконт = ВыборкаРаздел._16_Дисконт - Уменьшить_16_Дисконт;
							ОбластьИтогиЦенныеБумаги.Параметры._17_Премия = ВыборкаРаздел._17_Премия - Уменьшить_17_Премия;
							ОбластьИтогиЦенныеБумаги.Параметры._18_Корректировка = ВыборкаРаздел._18_Корректировка - Уменьшить_18_Корректировка;
						Иначе
							ОбластьИтогиЦенныеБумаги.Параметры._13_БалансоваяСтоимостьБезНКД = 
								ВыборкаРаздел._13_БалансоваяСтоимостьБезНКД + 
								ВыборкаРаздел._14_Переоценка + 
								ВыборкаРаздел._16_Дисконт + 
								ВыборкаРаздел._17_Премия + 
								ВыборкаРаздел._18_Корректировка;
							
						КонецЕсли;
					КонецЕсли;
					
					Если НЕ ЭтоБлагосостояние2019 Тогда 
						ОбластьИтогиЦенныеБумаги.Параметры._20_РыночнаяСтоимостьБезНКД 		= РыночнаяБезНКДРаздел;
						ОбластьИтогиЦенныеБумаги.Параметры._21_НКД 							= НКДРаздел;
						ОбластьИтогиЦенныеБумаги.Параметры._22_РыночнаяСтоимостьСУчетомНКД 	= РыночнаяСНКДРаздел;
					КонецЕсли;	
					ДокументРезультат.Вывести(ОбластьИтогиЦенныеБумаги);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если Не ВыборкаМакетПрочее.МакетПрочее Тогда
			ОбластьИтогиДенежныеСредства.Параметры.Заполнить(ВыборкаМакетПрочее);
			ОбластьИтогиДенежныеСредства.Параметры.ВидИтога = "ИТОГО финансовые вложения:";
			Если Не ЭтоПечатнаяФорма Тогда
				ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ВыборкаМакетПрочее._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП - Уменьшить_Итог_19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезервовВсего;
			КонецЕсли;	
			Если НЕ ЭтоБлагосостояние2019 Тогда
				ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = РыночнаяСНКДМакетПрочее;
			КонецЕсли;	
			ДокументРезультат.Вывести(ОбластьИтогиДенежныеСредства);
		КонецЕсли;
	КонецЦикла;
	
	ОбластьИтогиДенежныеСредства.Параметры.Заполнить(ВыборкаОбщийИтог);
	ОбластьИтогиДенежныеСредства.Параметры.ВидИтога = "ИТОГО стоимость Портфеля:";
	Если НЕ ЭтоБлагосостояние2019 Тогда
		ОбластьИтогиДенежныеСредства.Параметры._22_РыночнаяСтоимостьСУчетомНКД = РыночнаяСНКДВсего;
	КонецЕсли;	
	
	Если Не ЭтоПечатнаяФорма Тогда
		Если СуммаРезервовВсего <> 0 Тогда
			ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП = ОбластьИтогиДенежныеСредства.Параметры._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезервовВсего;
			БалансоваяСтоимость = ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП + СуммаРезервовВсего
		Иначе
			БалансоваяСтоимость = ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
		КонецЕсли;
	Иначе
		БалансоваяСтоимость = ВыборкаОбщийИтог._19_БаланосваяСтоимостьСУчетомПроцентногоДоходаПоЭСП;
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьИтогиДенежныеСредства);	
	
	Возврат Новый Структура("БалансоваяСтоимость, РыночнаяСтоимость", БалансоваяСтоимость, РыночнаяСНКДВсего);
	
КонецФункции

Процедура УстановитьОтборПоЦБ(Запрос)

	БезОтбораПоЦБ = Истина;
	ПараметрОтборЦБ = Неопределено;
	Если ЭтотОбъект.ОтборАктив.Количество() > 0 Тогда
		ПараметрОтборЦБ = Новый Массив;
		БезОтбораПоЦБ = Ложь;
		ПараметрОтборЦБ = ЭтотОбъект.ОтборАктив.ВыгрузитьЗначения();
	КонецЕсли;
	Запрос.УстановитьПараметр("ОтборЦБ", ПараметрОтборЦБ);
	Запрос.УстановитьПараметр("БезОтбораПоЦБ", БезОтбораПоЦБ);

	БезОтбораПоСчетамДУ = Истина;
	ПараметрОтборСчетаДУ = Неопределено;
	Если ЭтотОбъект.ОтборСчетаДУ.Количество() > 0 Тогда
		ПараметрОтборСчетаДУ = Новый Массив;
		БезОтбораПоСчетамДУ = Ложь;
		ПараметрОтборСчетаДУ = ЭтотОбъект.ОтборСчетаДУ.ВыгрузитьЗначения();
	КонецЕсли;
	Запрос.УстановитьПараметр("ОтборСчетаДУ", ПараметрОтборСчетаДУ);
	Запрос.УстановитьПараметр("БезОтбораПоСчетамДУ", БезОтбораПоСчетамДУ);
	
КонецПроцедуры

Функция ПолучитьВыборкуДанных_НоваяМетодика(ЭтоПечатнаяФорма)
	ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
	ЦельРасчетаБаланс = Справочники.ЦелиРасчета.ЕдиныйПланСчетов;
	
	ВидУчетаБаланс = ОпределитьВидУчета(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЦельРасчета, ЭтотОбъект.Период);
	ВидДоговораДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями 
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Или ВидДоговораДУ = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов
	Тогда
		ВидУчетаБаланс = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет;
	КонецЕсли;
	
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период);

	Если Не РаботаСОтчетами.ПроверитьРегистрациюСЧА(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ПоследнийРабочийДень) Тогда
		Сообщить("Стоимость ценных бумаг или активов, не относящимся к ценным бумагам, на "
			+ Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy") + " не зарегистрирована. Сведения о рыночной стоимости активов, рассчитанной по новой методике, выведены не будут.");
	КонецЕсли;
	
	ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов = БухгалтерскийУчет.ОпределитьНастройкуУчета(
		ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПроцентныеДоходыНаСчетахУчетаАктивов");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.УчетныеАктивыЕПС.ДобавитьВременнуюТаблицуКлассификацииЦенныхБумаг(Запрос.МенеджерВременныхТаблиц,, ЭтотОбъект.Период);
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА 1
		|		КОГДА БухПартииЦенныхБумагОстатки.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
		|						ТОГДА 2
