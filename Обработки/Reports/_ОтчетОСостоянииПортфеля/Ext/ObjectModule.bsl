Функция ПолучитьПредставлениеИнтервала(Дата, ДатаОферты)
	
	Если ДатаОферты < ДобавитьМесяц(Дата, 3) Тогда
		Представление = "До 3 месяцев";
	ИначеЕсли ДатаОферты < ДобавитьМесяц(Дата, 12) Тогда
		Представление = "От 3 месяцев до 1 года";
	ИначеЕсли ДатаОферты < ДобавитьМесяц(Дата, 36) Тогда
		Представление = "От 1 года до 3 лет";
	ИначеЕсли ДатаОферты < ДобавитьМесяц(Дата, 60) Тогда
		Представление = "От 3 до 5 лет";
	ИначеЕсли ДатаОферты < ДобавитьМесяц(Дата, 180) Тогда
		Представление = "От 5 до 15 лет";
	Иначе
		Представление = "Более 15 лет";
	КонецЕсли;
	
	Представление = Представление + " (" + Формат(ДатаОферты, "ДФ=dd.MM.yyyy") + ")";
	
	Возврат Представление;
	
КонецФункции

Функция ОпределитьВидУчета(ТекОрганизация, ТекСчетДоверительногоУправления, ТекЦельРасчета, НаДату, ИмяНастройки = "ВидУчетаДляОстатковПартий")
	
	// Вынести в общий модуль, заменить вызов здесь и в документе "РегистрацияСтоимостиПереоценки"
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиЦелейРасчетаСрезПоследних.ВидУчетаДляОстатковПартий КАК ВидУчетаДляОстатковПартий,
		|	НастройкиЦелейРасчетаСрезПоследних.ВариантРасчетаОценочнойСтоимости КАК ВариантРасчетаОценочнойСтоимости
		|ИЗ
		|	РегистрСведений.НастройкиЦелейРасчета.СрезПоследних(
		|			&НаДату,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЦельРасчета = &ЦельРасчета) КАК НастройкиЦелейРасчетаСрезПоследних";
	
	Запрос.УстановитьПараметр("НаДату", 					  НаДату);
	Запрос.УстановитьПараметр("Организация", 				  ТекОрганизация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ТекСчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЦельРасчета", 				  ТекЦельРасчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ИмяНастройки = "ВидУчетаДляОстатковПартий" Тогда
			Возврат ВыборкаДетальныеЗаписи.ВидУчетаДляОстатковПартий;
		Иначе
			Возврат ВыборкаДетальныеЗаписи.ВариантРасчетаОценочнойСтоимости;
		КонецЕсли; 	
	КонецЦикла;                                                    
	
	Возврат Перечисления.ВидыУчета.ПустаяСсылка();  		
	
КонецФункции //	ОпределитьВидУчета()

Функция ПолучитьПараметрыШапки()

	НаименованияКлиента = РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(НАЧАЛОПЕРИОДА(РегистрацияСтоимостиАктивов.Дата, ДЕНЬ)) КАК Период,
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ПоследняяСЧА
		|ИЗ
		|	Документ.РегистрацияСтоимостиАктивов КАК РегистрацияСтоимостиАктивов
		|ГДЕ
		|	РегистрацияСтоимостиАктивов.Организация = &Организация
		|	И РегистрацияСтоимостиАктивов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РегистрацияСтоимостиАктивов.ЦельРасчетаСтоимостиОценки = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И РегистрацияСтоимостиАктивов.Дата <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И РегистрацияСтоимостиАктивов.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	РегистрацияСтоимостиАктивов.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	&Период КАК ДатаОтчета,
		|	_ПоследняяСЧА.Период КАК ПоследнийРабочийДень,
		|	&КраткоеНаименованиеКлиента КАК УчредительУправления
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизации,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПоследняяСЧА КАК _ПоследняяСЧА
		|		ПО СчетаДоверительногоУправления.Ссылка = _ПоследняяСЧА.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", 						ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень",			НачалоДня(Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период)));
	Запрос.УстановитьПараметр("ЮрФизЛицо", 						ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("КраткоеНаименованиеКлиента", 	НаименованияКлиента.КраткоеНаименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
		
