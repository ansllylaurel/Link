// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Проверка настроек учета",
		"0.40",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьОбщиеНастройкиДляКонтроля(ВидУчета) 
	
	НастройкиДляКонтроля = Новый Массив;
	 
	МакетГруппировки = РегистрыСведений.НастройкиУчетаОбщие.ПолучитьМакет("ГруппировкаНастроек");
	
	ПроверочноеЗначение = ?(ВидУчета = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "ЕПС", "БУНУ");
	
	НомСтр = 2;
	Пока СокрЛП(МакетГруппировки.Область(НомСтр, 1).Текст) <> "" Цикл
		
		Если СокрЛП(МакетГруппировки.Область(НомСтр, 3).Текст) = ПроверочноеЗначение Тогда
			НастройкиДляКонтроля.Добавить(СокрЛП(МакетГруппировки.Область(НомСтр, 1).Текст));
		КонецЕсли;
		
		НомСтр = НомСтр + 1;
	
	КонецЦикла;
	
	Возврат НастройкиДляКонтроля;

КонецФункции 

Функция ОтфильтроватьМассивСчетовДУПоВидуУчета(МассивСчетовДУ, Период, ВидУчета)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|ГДЕ
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет";
	
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("Период", Период);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ВидУчета));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");

КонецФункции

Процедура ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок)
	
	// Организация, СчетДоверительногоУправления, ГруппаНастроек, ПодгруппаНастроек, Настройка
	
	Если КонтрольПройден Тогда
		
		ДанныеВыводаОшибок.ОбластьШапка.Параметры.ВидУчета = ДанныеВыводаОшибок.ВидУчета;
		ДанныеВыводаОшибок.ОбластьШапка.Параметры.Период = ДанныеВыводаОшибок.Период;
		Ошибки.Вывести(ДанныеВыводаОшибок.ОбластьШапка);
		КонтрольПройден = Ложь;
	
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеВыводаОшибок.ОбластьСтрока.Параметры, ДанныеВыводаОшибок, "Организация, СчетДоверительногоУправления, ГруппаНастроек, ПодгруппаНастроек, Настройка");
	
	Ошибки.Вывести(ДанныеВыводаОшибок.ОбластьСтрока);

КонецПроцедуры

Функция ВыполнитьКонтроль(ПараметрыКонтроля) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКонтроль()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыКонтроля, "Период, КонтрольЕПС, КонтрольБУ, КонтрольНУ");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	РезультатКонтроля = Новый Структура();
	
	Если ПараметрыКонтроля.КонтрольЕПС Тогда
		
		МассивСчетовДУ = ОтфильтроватьМассивСчетовДУПоВидуУчета(ПараметрыКонтроля.МассивСчетов, ПараметрыКонтроля.Период.ДатаОкончания, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
		
		РезультатКонтроля.Вставить("ЕПС", ПроверитьНастройкиУчетаЕПС(ПараметрыКонтроля.Период.ДатаНачала, ПараметрыКонтроля.Период.ДатаОкончания, МассивСчетовДУ, ПараметрыКонтроля.Ошибки));
		
	КонецЕсли;
	
	Если ПараметрыКонтроля.КонтрольБУ Тогда
		
		МассивСчетовДУ = ОтфильтроватьМассивСчетовДУПоВидуУчета(ПараметрыКонтроля.МассивСчетов, ПараметрыКонтроля.Период.ДатаОкончания, Перечисления.ВидыУчета.БухгалтерскийУчет);

		РезультатКонтроля.Вставить("БУ", ПроверитьНастройкиУчетаБУНУ(ПараметрыКонтроля.Период.ДатаНачала, ПараметрыКонтроля.Период.ДатаОкончания, МассивСчетовДУ, Перечисления.ВидыУчета.БухгалтерскийУчет, ПараметрыКонтроля.Ошибки));
		
	КонецЕсли;
	
	Если ПараметрыКонтроля.КонтрольНУ Тогда
		
		МассивСчетовДУ = ОтфильтроватьМассивСчетовДУПоВидуУчета(ПараметрыКонтроля.МассивСчетов, ПараметрыКонтроля.Период.ДатаОкончания, Перечисления.ВидыУчета.НалоговыйУчет);

		РезультатКонтроля.Вставить("НУ", ПроверитьНастройкиУчетаБУНУ(ПараметрыКонтроля.Период.ДатаНачала, ПараметрыКонтроля.Период.ДатаОкончания, МассивСчетовДУ, Перечисления.ВидыУчета.НалоговыйУчет, ПараметрыКонтроля.Ошибки));
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

	Возврат РезультатКонтроля;
	
КонецФункции

Функция ПроверитьНастройкиУчетаЕПС(ДатаНачала, ДатаОкончания, МассивСчетовДУ, Ошибки) Экспорт

	ДанныеВыводаОшибок = Новый Структура;
	ДанныеВыводаОшибок.Вставить("ВидУчета", "ЕПС");
	ДанныеВыводаОшибок.Вставить("Период", ПредставлениеПериода(ДатаНачала, ДатаОкончания));
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ДанныеВыводаОшибок.Вставить("ОбластьШапка", ОбластьШапка);
	ДанныеВыводаОшибок.Вставить("ОбластьСтрока", ОбластьСтрока);
	
	КонтрольПройден = Истина;
	
	// контроль общих настроек по макету
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "Общие");
	ДанныеВыводаОшибок.Вставить("ПодгруппаНастроек", "");
	
	НастройкиДляКонтроля = ПолучитьОбщиеНастройкиДляКонтроля(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	
	ТекстВставкиВЗапрос = "";
	Для каждого НастройкаДляКонтроля Из НастройкиДляКонтроля Цикл
		ТекстВставкиВЗапрос = ТекстВставкиВЗапрос + ",НастройкиУчетаОбщиеСрезПоследних." + НастройкаДляКонтроля + " КАК " + НастройкаДляКонтроля;
	КонецЦикла;
	ТекстВставкиВЗапрос = ТекстВставкиВЗапрос + " ИЗ ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&МассивСчетовДУ)";
	
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("Период", ДатаНачала);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЗ", ТекстВставкиВЗапрос);
	
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеВыводаОшибок.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
		
		Для каждого НастройкаДляКонтроля Из НастройкиДляКонтроля Цикл
		
			ДанныеВыводаОшибок.Вставить("Настройка", НастройкаДляКонтроля);
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи[НастройкаДляКонтроля]) Тогда
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	// контроль настроек по виду учета
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "По виду учета");
	ДанныеВыводаОшибок.Вставить("ПодгруппаНастроек", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_ИндексныеОблигации
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ИндексируемыйНоминал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_РЕПО
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаРЕПО.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_ТПлюс
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И Сделка.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И Сделка.ОтложенноеИсполнение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_Депозиты
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			СчетДоверительногоУправления В (&МассивСчетовДУ)
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	НастройкиПоВидуУчетаСрезПоследних.ТочностьРасчетаСтоимостиПартий КАК ТочностьРасчетаСтоимостиПартий,
		|	НастройкиПоВидуУчетаСрезПоследних.ПериодичностьИндексацииНоминала КАК ПериодичностьИндексацииНоминала,
		|	НастройкиПоВидуУчетаСрезПоследних.ВариантУчетаИндексацииНоминала КАК ВариантУчетаИндексацииНоминала,
		|	НастройкиПоВидуУчетаСрезПоследних.МетодПризнанияРасходовПоСделкамРЕПО КАК МетодПризнанияРасходовПоСделкамРЕПО,
		|	НастройкиПоВидуУчетаСрезПоследних.ВариантРасчетаПроцентовПоСделкамРЕПО КАК ВариантРасчетаПроцентовПоСделкамРЕПО,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_ИндексныеОблигации.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьОблигацииСИндексируемымНоминалом,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_ТПлюс.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьТПлюс,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_РЕПО.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьРЕПО,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_Депозиты.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьДепозиты,
		|	НастройкиПоВидуУчетаСрезПоследних.УчитыватьПартииРЕПООтдельно КАК УчитыватьПартииРЕПООтдельно
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|				&НачалоПериода,
		|				ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|					И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиПоВидуУчетаСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиПоВидуУчетаСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ИндексныеОблигации КАК _СчетаДУ_ИндексныеОблигации
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ИндексныеОблигации.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ТПлюс КАК _СчетаДУ_ТПлюс
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ТПлюс.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_Депозиты КАК _СчетаДУ_Депозиты
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_Депозиты.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_РЕПО КАК _СчетаДУ_РЕПО
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_РЕПО.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&МассивСчетовДУ)";
	
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ДатаОкончания));
	
	ДанныеПоВидуУчета = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаДанныеПоВидуУчета Из ДанныеПоВидуУчета Цикл
	
		ДанныеВыводаОшибок.Вставить("Организация", СтрокаДанныеПоВидуУчета.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", СтрокаДанныеПоВидуУчета.СчетДоверительногоУправления);
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ТочностьРасчетаСтоимостиПартий) 
			ИЛИ Число(СтрокаДанныеПоВидуУчета.ТочностьРасчетаСтоимостиПартий) < 2 Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "ТочностьРасчетаСтоимостиПартий");	
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если СтрокаДанныеПоВидуУчета.ЕстьОблигацииСИндексируемымНоминалом Тогда
		
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ПериодичностьИндексацииНоминала) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "ПериодичностьИндексацииНоминала");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ВариантУчетаИндексацииНоминала) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "ВариантУчетаИндексацииНоминала");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если СтрокаДанныеПоВидуУчета.ЕстьРЕПО Тогда
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.УчитыватьПартииРЕПООтдельно) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "УчитыватьПартииРЕПООтдельно");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			ИначеЕсли НЕ СтрокаДанныеПоВидуУчета.УчитыватьПартииРЕПООтдельно Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "УчитыватьПартииРЕПООтдельно");	
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "МетодПризнанияРасходовПоСделкамРЕПО");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ВариантРасчетаПроцентовПоСделкамРЕПО) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "ВариантРасчетаПроцентовПоСделкамРЕПО");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
	
	КонецЦикла;
	
	// контроль настроек учета активов
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "Активы ЕПС");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПоВидуУчета.Организация КАК Организация,
		|	ДанныеПоВидуУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДанныеПоВидуУчета.ТочностьРасчетаСтоимостиПартий КАК ТочностьРасчетаСтоимостиПартий,
		|	ДанныеПоВидуУчета.ПериодичностьИндексацииНоминала КАК ПериодичностьИндексацииНоминала,
		|	ДанныеПоВидуУчета.ВариантУчетаИндексацииНоминала КАК ВариантУчетаИндексацииНоминала,
		|	ДанныеПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО КАК МетодПризнанияРасходовПоСделкамРЕПО,
		|	ДанныеПоВидуУчета.ВариантРасчетаПроцентовПоСделкамРЕПО КАК ВариантРасчетаПроцентовПоСделкамРЕПО,
		|	ДанныеПоВидуУчета.ЕстьОблигацииСИндексируемымНоминалом КАК ЕстьОблигацииСИндексируемымНоминалом,
		|	ДанныеПоВидуУчета.ЕстьТПлюс КАК ЕстьТПлюс,
		|	ДанныеПоВидуУчета.ЕстьДепозиты КАК ЕстьДепозиты,
		|	ДанныеПоВидуУчета.ЕстьРЕПО КАК ЕстьРЕПО
		|ПОМЕСТИТЬ _ДанныеПоВидуУчета
		|ИЗ
		|	&ДанныеПоВидуУчета КАК ДанныеПоВидуУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ _АктивыЕПС_Начало
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&НачалоПериода,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК БухПартииЦенныхБумагОстатки
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(РаспределенияАктивовЕПС.Сделка КАК Документ.Сделка).СчетДоверительногоУправления,
		|	РаспределенияАктивовЕПС.УчетныйАктивЕПС
		|ИЗ
		|	РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|ГДЕ
		|	ВЫРАЗИТЬ(РаспределенияАктивовЕПС.Сделка КАК Документ.Сделка).СчетДоверительногоУправления В (&МассивСчетовДУ)
		|	И ВЫРАЗИТЬ(РаспределенияАктивовЕПС.Сделка КАК Документ.Сделка).Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления,
		|	ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС <> ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СделкаЦенныеБумаги.Ссылка.Рынок КАК Рынок,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _ПришедшиеЦБ
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределенияАктивовЕПС КАК РаспределенияАктивовЕПС
		|		ПО СделкаЦенныеБумаги.Ссылка = РаспределенияАктивовЕПС.Сделка
		|			И СделкаЦенныеБумаги.ЦеннаяБумага = РаспределенияАктивовЕПС.ЦеннаяБумага
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка.Проведен
		|	И СделкаЦенныеБумаги.Ссылка.Дата >= &НачалоПериода
		|	И СделкаЦенныеБумаги.Ссылка.Дата <= &ОкончаниеПериода
		|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И СделкаЦенныеБумаги.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|	И СделкаЦенныеБумаги.Ссылка.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|	И РаспределенияАктивовЕПС.УчетныйАктивЕПС ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления,
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок,
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|ГДЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата >= &НачалоПериода
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата <= &ОкончаниеПериода
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|	И ВводЦенныхБумагЦенныеБумаги.УчетныйАктивЕПС = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеПоВидуУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПроцентыПоРЕПО) КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ _АктивыЕПС_Дополнительные
		|ИЗ
		|	_ДанныеПоВидуУчета КАК _ДанныеПоВидуУчета
		|ГДЕ
		|	_ДанныеПоВидуУчета.ЕстьРЕПО
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеПоВидуУчета.СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО)
		|ИЗ
		|	_ДанныеПоВидуУчета КАК _ДанныеПоВидуУчета
		|ГДЕ
		|	_ДанныеПоВидуУчета.ЕстьРЕПО
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеПоВидуУчета.СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ЦенныеБумагиОжидаемыеКПолучениюПоСделкамТПлюс)
		|ИЗ
		|	_ДанныеПоВидуУчета КАК _ДанныеПоВидуУчета
		|ГДЕ
		|	_ДанныеПоВидуУчета.ЕстьТПлюс
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДанныеПоВидуУчета.СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС)
		|ИЗ
		|	_ДанныеПоВидуУчета КАК _ДанныеПоВидуУчета
		|ГДЕ
		|	_ДанныеПоВидуУчета.ЕстьДепозиты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПришедшиеЦБ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ПришедшиеЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АОИБанков)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АПИБанков)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливойКредитныхОрганизаций)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АОИ)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Акции).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.АПИ)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов)
		|				КОНЕЦ
		|		КОГДА _ПришедшиеЦБ.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииГосударства)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокРФ)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииСубфедеральные)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокСубъектовРФ)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковРезидентов)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокКредитныхОрганизаций)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихРезидентов)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихРезидентов)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииБанковНерезидентов)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокБанковНерезидентов)
		|					КОГДА ВЫРАЗИТЬ(_ПришедшиеЦБ.ЦеннаяБумага КАК Справочник.Облигации).УчетныйАктивЦБРФ = ЗНАЧЕНИЕ(Справочник.КлассификаторУчетныхАктивовЦБРФ.ОблигацииПрочихНерезидентов)
		|						ТОГДА ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихНерезидентов)
		|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбытокПрочихРезидентов)
		|				КОНЕЦ
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолевыеПоСправедливойПрочихРезидентов)
		|	КОНЕЦ КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ _АктивыЕПС_Приход
		|ИЗ
		|	_ПришедшиеЦБ КАК _ПришедшиеЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АктивыЕПС_Начало.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_АктивыЕПС_Начало.УчетныйАктивЕПС КАК УчетныйАктивЕПС
		|ПОМЕСТИТЬ _СчетаДУ_Активы
		|ИЗ
		|	_АктивыЕПС_Начало КАК _АктивыЕПС_Начало
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_АктивыЕПС_Приход.СчетДоверительногоУправления,
		|	_АктивыЕПС_Приход.УчетныйАктивЕПС
		|ИЗ
		|	_АктивыЕПС_Приход КАК _АктивыЕПС_Приход
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_АктивыЕПС_Дополнительные.СчетДоверительногоУправления,
		|	_АктивыЕПС_Дополнительные.УчетныйАктивЕПС
		|ИЗ
		|	_АктивыЕПС_Дополнительные КАК _АктивыЕПС_Дополнительные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДУ_Активы.СчетДоверительногоУправления.Организация КАК Организация,
		|	_СчетаДУ_Активы.СчетДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	_СчетаДУ_Активы.УчетныйАктивЕПС КАК УчетныйАктивЕПС,
		|	НастройкиУчетаАктивовЕПССрезПоследних.ПериодичностьПереоценки КАК ПериодичностьПереоценки,
		|	НастройкиУчетаАктивовЕПССрезПоследних.ПериодичностьНачисленияПроцентныхДоходов КАК ПериодичностьНачисленияПроцентныхДоходов,
		|	НастройкиУчетаАктивовЕПССрезПоследних.ПериодичностьНачисленияКорректировкиЭСП КАК ПериодичностьНачисленияКорректировкиЭСП
		|ИЗ
		|	_СчетаДУ_Активы КАК _СчетаДУ_Активы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаАктивовЕПС.СрезПоследних(&НачалоПериода, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаАктивовЕПССрезПоследних
		|		ПО _СчетаДУ_Активы.СчетДоверительногоУправления = НастройкиУчетаАктивовЕПССрезПоследних.СчетДоверительногоУправления
		|			И _СчетаДУ_Активы.УчетныйАктивЕПС = НастройкиУчетаАктивовЕПССрезПоследних.УчетныйАктив";
	
	Запрос.УстановитьПараметр("ДанныеПоВидуУчета", ДанныеПоВидуУчета);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ДатаОкончания));
	
	МассивАктивыБумагиРодители = Новый Массив;
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения);
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи);
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток);
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД);
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи);
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой);
	МассивАктивыБумагиРодители.Добавить(Справочники.УчетныеАктивыЕПС.УчастиеВДочернихИАссоциированныхАкционерныхОбществах);
	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеВыводаОшибок.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
		ДанныеВыводаОшибок.Вставить("ПодгруппаНастроек", ВыборкаДетальныеЗаписи.УчетныйАктивЕПС);
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьПереоценки) Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "ПериодичностьПереоценки");
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьНачисленияПроцентныхДоходов) Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "ПериодичностьНачисленияПроцентныхДоходов");
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьНачисленияКорректировкиЭСП)
			И ВыборкаДетальныеЗаписи.УчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ПроцентыПоРЕПО
			И ВыборкаДетальныеЗаписи.УчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ЦенныеБумагиКупленныеПоРЕПО
			И ВыборкаДетальныеЗаписи.УчетныйАктивЕПС <> Справочники.УчетныеАктивыЕПС.ЦенныеБумагиОжидаемыеКПолучениюПоСделкамТПлюс Тогда
			
			ДанныеВыводаОшибок.Вставить("Настройка", "ПериодичностьНачисленияКорректировкиЭСП");
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если МассивАктивыБумагиРодители.Найти(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.Родитель) <> Неопределено Тогда // актив ценных бумаг
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаДоходовОтОпераций)
				ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.СчетУчетаРасходовОтОпераций)
				ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.АналитикаДоходовОтОпераций)
				ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УчетныйАктивЕПС.АналитикаРасходовОтОпераций) Тогда
			
				ДанныеВыводаОшибок.Вставить("Настройка", "Доходы/расходы от операций");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КонтрольПройден;
	
КонецФункции

Функция ПроверитьНастройкиУчетаБУНУ(ДатаНачала, ДатаОкончания, МассивСчетовДУ, ВидУчета, Ошибки) Экспорт

	ДанныеВыводаОшибок = Новый Структура;
	ДанныеВыводаОшибок.Вставить("ВидУчета", Строка(ВидУчета));
	ДанныеВыводаОшибок.Вставить("Период", ПредставлениеПериода(ДатаНачала, ДатаОкончания));
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ДанныеВыводаОшибок.Вставить("ОбластьШапка", ОбластьШапка);
	ДанныеВыводаОшибок.Вставить("ОбластьСтрока", ОбластьСтрока);
	
	КонтрольПройден = Истина;
	
	// контроль общих настроек по макету
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "Общие");
	ДанныеВыводаОшибок.Вставить("ПодгруппаНастроек", "");
	
	НастройкиДляКонтроля = ПолучитьОбщиеНастройкиДляКонтроля(ВидУчета);
	
	ТекстВставкиВЗапрос = "";
	Для каждого НастройкаДляКонтроля Из НастройкиДляКонтроля Цикл
		ТекстВставкиВЗапрос = ТекстВставкиВЗапрос + ",НастройкиУчетаОбщиеСрезПоследних." + НастройкаДляКонтроля + " КАК " + НастройкаДляКонтроля;
	КонецЦикла;
	ТекстВставкиВЗапрос = ТекстВставкиВЗапрос + " ИЗ ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет, ЛОЖЬ) КАК ВестиБухгалтерскийУчет,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет, ЛОЖЬ) КАК ВестиНалоговыйУчет,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&МассивСчетовДУ)";
	
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("Период", ДатаНачала);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИЗ", ТекстВставкиВЗапрос);
	
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет И НЕ ВыборкаДетальныеЗаписи.ВестиБухгалтерскийУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет И НЕ ВыборкаДетальныеЗаписи.ВестиНалоговыйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыводаОшибок.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
		
		Для каждого НастройкаДляКонтроля Из НастройкиДляКонтроля Цикл
		
			ДанныеВыводаОшибок.Вставить("Настройка", НастройкаДляКонтроля);
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи[НастройкаДляКонтроля]) Тогда
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	// контроль общих настроек по хардкоду
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиДенежныхСредствОстаткиИОбороты.Организация КАК Организация,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.Брокер КАК Брокер,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.РасчетныйСчет КАК РасчетныйСчет,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
		|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаРасход КАК СуммаРасход
		|ПОМЕСТИТЬ _ОстаткиДС
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			СчетДоверительногоУправления В (&МассивСчетовДУ)
		|				И Валюта <> Организация.ВалютаУчета) КАК ОстаткиДенежныхСредствОстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_Валюта
		|ИЗ
		|	_ОстаткиДС КАК _ОстаткиДС
		|ГДЕ
		|	_ОстаткиДС.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_ВалютаБрокер
		|ИЗ
		|	_ОстаткиДС КАК _ОстаткиДС
		|ГДЕ
		|	_ОстаткиДС.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
