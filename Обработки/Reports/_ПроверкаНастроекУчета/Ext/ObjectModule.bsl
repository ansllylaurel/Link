		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьВалютаСделки
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&НачалоПериода, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_Валюта КАК _СчетаДУ_Валюта
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_Валюта.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ВалютаБрокер КАК _СчетаДУ_ВалютаБрокер
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ВалютаБрокер.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ВалютаВПути КАК _СчетаДУ_ВалютаВПути
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ВалютаВПути.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ВалютаЗадолженность КАК _СчетаДУ_ВалютаЗадолженность
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ВалютаЗадолженность.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_СделкиСВалютой КАК _СчетаДУ_СделкиСВалютой
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_СделкиСВалютой.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_РасчетыСАгентом КАК _СчетаДУ_РасчетыСАгентом
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_РасчетыСАгентом.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ОбратныеРЕПОВалюта КАК _СчетаДУ_ОбратныеРЕПОВалюта
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ОбратныеРЕПОВалюта.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&МассивСчетовДУ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ДатаОкончания));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет И НЕ ВыборкаДетальныеЗаписи.ВестиБухгалтерскийУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет И НЕ ВыборкаДетальныеЗаписи.ВестиНалоговыйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыводаОшибок.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
		
		Если ВыборкаДетальныеЗаписи.ЕстьВалюта Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчетаВалютныхСредств) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "СчетУчетаВалютныхСредств");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиВалютныхСредств) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиВалютныхСредств");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЕстьВалютаБрокер Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчетаВалютныхСредствУБрокера) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "СчетУчетаВалютныхСредствУБрокера");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиВалютныхСредствУБрокера) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиВалютныхСредствУБрокера");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЕстьВалютаВПути Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиВалютныхСредствВПути) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиВалютныхСредствВПути");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЕстьВалютаЗадолженность Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиДебеторскойЗадолженности) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиДебеторскойЗадолженности");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиКредиторскойЗадолженности) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиКредиторскойЗадолженности");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЕстьВалютаСделки Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиСделокСВалютой) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиСделокСВалютой");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиСделокСВалютойЧерезБрокера) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиСделокСВалютойЧерезБрокера");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЕстьРасчетыСАгентом Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетРасчетовСАгентом) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "СчетРасчетовСАгентом");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЕстьВалютаРЕПО Тогда
		
			Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АналитикаПерекурсовкиЗаймов) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "АналитикаПерекурсовкиЗаймов");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	// контроль настроек по виду учета
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "По виду учета");
	ДанныеВыводаОшибок.Вставить("ПодгруппаНастроек", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_ИндексныеОблигации
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|ГДЕ
		|	СделкаЦенныеБумаги.Ссылка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ИндексируемыйНоминал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_РЕПО
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаРЕПО.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _СчетаДУ_РЕПОПрямыеВалюта
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И СделкаРЕПО.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И СделкаРЕПО.Проведен
		|	И СделкаРЕПО.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|	И СделкаРЕПО.ЧастьСделкиРЕПО = 1
		|	И СделкаРЕПО.ВалютаСделки <> СделкаРЕПО.Организация.ВалютаУчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	НастройкиПоВидуУчетаСрезПоследних.ТочностьРасчетаСтоимостиПартий КАК ТочностьРасчетаСтоимостиПартий,
		|	НастройкиПоВидуУчетаСрезПоследних.ПериодичностьИндексацииНоминала КАК ПериодичностьИндексацииНоминала,
		|	НастройкиПоВидуУчетаСрезПоследних.ПериодичностьПерекурсовкиБумагВЗалоге КАК ПериодичностьПерекурсовкиБумагВЗалоге,
		|	НастройкиПоВидуУчетаСрезПоследних.ВариантУчетаИндексацииНоминала КАК ВариантУчетаИндексацииНоминала,
		|	НастройкиПоВидуУчетаСрезПоследних.МетодПризнанияРасходовПоСделкамРЕПО КАК МетодПризнанияРасходовПоСделкамРЕПО,
		|	НастройкиПоВидуУчетаСрезПоследних.МетодОпределенияДоходовИРасходов КАК МетодОпределенияДоходовИРасходов,
		|	НастройкиПоВидуУчетаСрезПоследних.ВариантРасчетаПроцентовПоСделкамРЕПО КАК ВариантРасчетаПроцентовПоСделкамРЕПО,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_ИндексныеОблигации.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьОблигацииСИндексируемымНоминалом,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_РЕПО.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьРЕПО,
		|	ВЫБОР
		|		КОГДА _СчетаДУ_РЕПОПрямыеВалюта.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьРЕПОПрямоеВалюта,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет, ЛОЖЬ) КАК ВестиБухгалтерскийУчет,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет, ЛОЖЬ) КАК ВестиНалоговыйУчет
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПоВидуУчета.СрезПоследних(
		|				&НачалоПериода,
		|				ВидУчета = &ВидУчета
		|					И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиПоВидуУчетаСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиПоВидуУчетаСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_ИндексныеОблигации КАК _СчетаДУ_ИндексныеОблигации
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_ИндексныеОблигации.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_РЕПОПрямыеВалюта КАК _СчетаДУ_РЕПОПрямыеВалюта
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_РЕПОПрямыеВалюта.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДУ_РЕПО КАК _СчетаДУ_РЕПО
		|		ПО СчетаДоверительногоУправления.Ссылка = _СчетаДУ_РЕПО.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&НачалоПериода, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&МассивСчетовДУ)";
	
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	
	ДанныеПоВидуУчета = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаДанныеПоВидуУчета Из ДанныеПоВидуУчета Цикл
		
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет И НЕ ВыборкаДетальныеЗаписи.ВестиБухгалтерскийУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет И НЕ ВыборкаДетальныеЗаписи.ВестиНалоговыйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыводаОшибок.Вставить("Организация", СтрокаДанныеПоВидуУчета.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", СтрокаДанныеПоВидуУчета.СчетДоверительногоУправления);
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ТочностьРасчетаСтоимостиПартий) 
			ИЛИ Число(СтрокаДанныеПоВидуУчета.ТочностьРасчетаСтоимостиПартий) < 2 Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "ТочностьРасчетаСтоимостиПартий");	
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.МетодОпределенияДоходовИРасходов) Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "МетодОпределенияДоходовИРасходов");	
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если СтрокаДанныеПоВидуУчета.ЕстьОблигацииСИндексируемымНоминалом Тогда
		
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ПериодичностьИндексацииНоминала) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "ПериодичностьИндексацииНоминала");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			//Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ВариантУчетаИндексацииНоминала) Тогда
			//	ДанныеВыводаОшибок.Вставить("Настройка", "ВариантУчетаИндексацииНоминала");
			//	ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			//КонецЕсли;	
			
		КонецЕсли;
		
		Если СтрокаДанныеПоВидуУчета.ЕстьРЕПО Тогда
		
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.МетодПризнанияРасходовПоСделкамРЕПО) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "МетодПризнанияРасходовПоСделкамРЕПО");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ВариантРасчетаПроцентовПоСделкамРЕПО) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "ВариантРасчетаПроцентовПоСделкамРЕПО");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
		Если СтрокаДанныеПоВидуУчета.ЕстьРЕПОПрямоеВалюта Тогда
		
			Если НЕ ЗначениеЗаполнено(СтрокаДанныеПоВидуУчета.ПериодичностьПерекурсовкиБумагВЗалоге) Тогда
				ДанныеВыводаОшибок.Вставить("Настройка", "ПериодичностьПерекурсовкиБумагВЗалоге");
				ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	// контроль настроек комиссии
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "Комиссии");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаОборот КАК СуммаОборот,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаРасход КАК СуммаРасход,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаНачальныйОстаток КАК СуммаКупонаНачальныйОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаКонечныйОстаток КАК СуммаКупонаКонечныйОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаОборот КАК СуммаКупонаОборот,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаПриход КАК СуммаКупонаПриход,
		|	ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СуммаКупонаРасход КАК СуммаКупонаРасход,
		|	НастройкиУчетаКомиссииСрезПоследних.СчетУчета КАК СчетУчета,
		|	НастройкиУчетаКомиссииСрезПоследних.Аналитика КАК Аналитика,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет, ЛОЖЬ) КАК ВестиБухгалтерскийУчет,
		|	ЕСТЬNULL(НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет, ЛОЖЬ) КАК ВестиНалоговыйУчет
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			СчетДоверительногоУправления В (&МассивСчетовДУ)
		|				И (ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Комиссия))
		|						И НЕ ВидЗадолженности.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Устаревшие)
		|					ИЛИ ВидЗадолженности.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.УслугиДоверительногоУправления)
		|					ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий))) КАК ЗадолженностиПоДенежнымСредствамОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
		|				&НачалоПериода,
		|				СчетДоверительногоУправления В (&МассивСчетовДУ)
		|					И ВидУчета = &ВидУчета
		|					И (ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Комиссия))
		|							И НЕ ВидЗадолженности.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.Устаревшие)
		|						ИЛИ ВидЗадолженности.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.УслугиДоверительногоУправления)
		|						ИЛИ ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий))) КАК НастройкиУчетаКомиссииСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.Организация = НастройкиУчетаКомиссииСрезПоследних.Организация
		|			И ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СчетДоверительногоУправления = НастройкиУчетаКомиссииСрезПоследних.СчетДоверительногоУправления
		|			И ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.ВидЗадолженности = НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&НачалоПериода, СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствамОстаткиИОбороты.СчетДоверительногоУправления = НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("ВидУчета", ВидУчета);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ДатаОкончания));
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВидУчета = Перечисления.ВидыУчета.БухгалтерскийУчет И НЕ ВыборкаДетальныеЗаписи.ВестиБухгалтерскийУчет Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет И НЕ ВыборкаДетальныеЗаписи.ВестиНалоговыйУчет Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеВыводаОшибок.Вставить("Организация", ВыборкаДетальныеЗаписи.Организация);
		ДанныеВыводаОшибок.Вставить("СчетДоверительногоУправления", ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
		ДанныеВыводаОшибок.Вставить("ПодгруппаНастроек", ВыборкаДетальныеЗаписи.ВидЗадолженности);
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетУчета) Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "СчетУчета");
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Аналитика) Тогда
			ДанныеВыводаОшибок.Вставить("Настройка", "Аналитика");
			ВывестиОшибку(Ошибки, КонтрольПройден, ДанныеВыводаОшибок);
		КонецЕсли;
		
	КонецЦикла;
	
	// контроль настроек активов
	ДанныеВыводаОшибок.Вставить("ГруппаНастроек", "Активы");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоОборот КАК КоличествоОборот,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.КоличествоРасход КАК КоличествоРасход,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаОборот КАК СуммаОборот,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаПриход КАК СуммаПриход,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаРасход КАК СуммаРасход,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаКупонаНачальныйОстаток КАК СуммаКупонаНачальныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаКупонаКонечныйОстаток КАК СуммаКупонаКонечныйОстаток,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаКупонаОборот КАК СуммаКупонаОборот,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаКупонаПриход КАК СуммаКупонаПриход,
		|	ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты.СуммаКупонаРасход КАК СуммаКупонаРасход
		|ПОМЕСТИТЬ _БумагиВРЕПО
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&ОкончаниеПериода,
		|			Период,
		|			ДвиженияИГраницыПериода,
		|			СчетДоверительногоУправления В (&МассивСчетовДУ)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)) КАК ЗадолженностиПоВторойЧастиРЕПООстаткиИОбороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НачислениеДивидендов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
