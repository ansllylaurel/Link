
&НаСервере
Функция КонтрольНаСервере()
	
	ОтобразитьФорму = Ложь;
		
	ЭтаФорма.Ошибки.Очистить();	
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	МассивСчетовДУ = ЭтаФорма.СчетаДУ.ВыгрузитьЗначения();
	
	ПараметрыКонтроля = Новый Структура("Период, КонтрольЕПС, КонтрольБУ, КонтрольНУ, МассивСчетов, Ошибки", ЭтаФорма.Период, ЭтаФорма.КонтрольЕПС, ЭтаФорма.КонтрольБУ, ЭтаФорма.КонтрольНУ, МассивСчетовДУ, ЭтаФорма.Ошибки);
	
	РезультатКонтроля = ОтчетОбъект.ВыполнитьКонтроль(ПараметрыКонтроля);
	
	Для Каждого ЗаписьРезультатаКонтроля Из РезультатКонтроля Цикл
		
		Если Не ЗаписьРезультатаКонтроля.Значение Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контроль " + ЗаписьРезультатаКонтроля.Ключ + " не прошел!");
			ОтобразитьФорму = Истина;
			
		КонецЕсли;
			
	КонецЦикла;
		
	Возврат ОтобразитьФорму;
	
КонецФункции

&НаКлиенте
Процедура Контроль(Команда)
	
	Если ЭтаФорма.ПроверитьЗаполнение() Тогда
	
		КонтрольНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция КонтрольИзФормированияУчета() Экспорт
	
	ОтобразитьФорму = КонтрольНаСервере();
	
	Если ОтобразитьФорму Тогда
		ЭтаФорма.ОткрытьМодально();
	КонецЕсли;
	
	Возврат НЕ ОтобразитьФорму;
	
КонецФункции 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";

	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтаФОрма.Период,,, ТекстСообщения) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Период", Отказ);
	КонецЕсли;
	
КонецПроцедуры

