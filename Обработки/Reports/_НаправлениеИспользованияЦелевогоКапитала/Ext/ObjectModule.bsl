Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Направление использования целевого капитала",
		"0.10",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Параметры = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	
	ВидыЗадолженности = Новый Массив;
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.БанковскаяКомиссия);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПрочимУслугам);
	ВидыЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий);
	
	ВидыЗадолженностиКомиссии = Новый Массив;
	ВидыЗадолженностиКомиссии.Добавить(Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии);
	ВидыЗадолженностиКомиссии.Добавить(Справочники.ВидыЗадолженности.ПоТорговойКомиссии);	
	
	СчетаАС = Новый Массив;
	СчетаАС.Добавить(ПланыСчетов.Единый.ДолговыеЧерезПСД);
	СчетаАС.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажиИДоПогашения);    
	
	СчетаСС = Новый Массив;
	СчетаСС.Добавить(ПланыСчетов.Единый.ДолговыеПрибыльУбыток);
	
	Параметры.УстановитьЗначениеПараметра("ВидыЗадолженности", 		 ВидыЗадолженности);
	Параметры.УстановитьЗначениеПараметра("ВидыЗадолженностиКомиссии", 			 ВидыЗадолженностиКомиссии);
	Параметры.УстановитьЗначениеПараметра("СчетАС", 		 СчетаАС);
	Параметры.УстановитьЗначениеПараметра("СчетСС", 			 СчетаСС);
	Параметры.УстановитьЗначениеПараметра("Организация", 			 ПараметрыСеанса.ТекущаяОрганизация);
	
	_ТаблицаЭффективнойДоходности = Новый ТаблицаЗначений;
	_ТаблицаЭффективнойДоходности.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	_ТаблицаЭффективнойДоходности.Колонки.Добавить("ЭффективнаяДоходностьВВалютеУчетаЗаПрошлыйГод", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	_ТаблицаЭффективнойДоходности.Колонки.Добавить("ЭффективнаяДоходностьВВалютеУчетаСНачалаИнвестирования", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	_ТаблицаЭффективнойДоходности.Колонки.Добавить("ЭффективнаяДоходностьВВалютеУчетаЗаТриГода", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов)
		|	И НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОтчета
		|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОтчета
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|	И СчетаДоверительногоУправления.Организация = &Организация";
	
	
	ЗначениеПериод = Неопределено;
	ЗначениеОрганизация = Неопределено;
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Период");
	Если Параметр <> Неопределено  Тогда
		Элемент = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Параметр.ИдентификаторПользовательскойНастройки);
		Если Элемент <> Неопределено И Элемент.Использование Тогда
			ЗначениеПериод = Элемент.Значение.Дата;
		КонецЕсли;
	КонецЕсли;	
	
	Параметр = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Организация");
	Если Параметр <> Неопределено  Тогда
		Элемент = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Параметр.ИдентификаторПользовательскойНастройки);
		Если Элемент <> Неопределено И Элемент.Использование Тогда
			ЗначениеОрганизация = Элемент.Значение;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеПериод <> Неопределено И ЗначениеОрганизация <> Неопределено Тогда
		
		МассивОшибок = Новый Массив;
		Отказ = Ложь;
		
		Запрос.УстановитьПараметр("ДатаОтчета", ЗначениеПериод);
		Запрос.УстановитьПараметр("Организация", ЗначениеОрганизация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ПараметрыРасчетаДоходности = Новый Структура;
			ПараметрыРасчетаДоходности.Вставить("Организация",					ЗначениеОрганизация);
			ПараметрыРасчетаДоходности.Вставить("СчетДоверительногоУправления",	ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
			ПараметрыРасчетаДоходности.Вставить("ДатаНачала",					Дата(1,1,1));
			ПараметрыРасчетаДоходности.Вставить("ДатаОкончания",				КонецДня(ЗначениеПериод));
			ПараметрыРасчетаДоходности.Вставить("УчитыватьНДФЛПоНачислению",	Истина);
			ПараметрыРасчетаДоходности.Вставить("РасшифровкаРасчета",			Истина);
			ПараметрыРасчетаДоходности.Вставить("МассивОшибок",					МассивОшибок);
			ПараметрыРасчетаДоходности.Вставить("ВалютаРасчета",				Справочники.Валюты.ПустаяСсылка());
			
			СНачалаУправленияВВалютеУчета = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьУправления(ПараметрыРасчетаДоходности, Отказ);
			
			ПараметрыРасчетаДоходности.Вставить("ДатаНачала",					НачалоГода(НачалоГода(ЗначениеПериод) - 1));
			ПараметрыРасчетаДоходности.Вставить("ДатаОкончания",				НачалоГода(ЗначениеПериод) - 1);
			
			ЗаПериодВВалютеУчета = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьУправления(ПараметрыРасчетаДоходности, Отказ);
			
			ДатаНачалаДоходностиЗа3Года = НачалоГода(НачалоГода(НачалоГода(НачалоГода(ЗначениеПериод) - 1) - 1) - 1);
			
			ПараметрыРасчетаДоходности.Вставить("ДатаНачала",					ДатаНачалаДоходностиЗа3Года);
			ПараметрыРасчетаДоходности.Вставить("ДатаОкончания",				НачалоГода(ЗначениеПериод) - 1);
			
			За3ГодаВВалютеУчета = Документы.РегистрацияСтоимостиАктивов.РассчитатьДоходностьУправления(ПараметрыРасчетаДоходности, Отказ);
			
			Попытка
				НоваяСтрока_ТаблицаЭффективнойДоходности = _ТаблицаЭффективнойДоходности.Добавить();
				НоваяСтрока_ТаблицаЭффективнойДоходности.СчетДоверительногоУправления = ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
				НоваяСтрока_ТаблицаЭффективнойДоходности.ЭффективнаяДоходностьВВалютеУчетаЗаПрошлыйГод = ЗаПериодВВалютеУчета.ЭффективнаяДоходность;
				НоваяСтрока_ТаблицаЭффективнойДоходности.ЭффективнаяДоходностьВВалютеУчетаСНачалаИнвестирования = СНачалаУправленияВВалютеУчета.ЭффективнаяДоходность;
				Если ВыборкаДетальныеЗаписи.ДатаЗаключения <= ДатаНачалаДоходностиЗа3Года Тогда 
					НоваяСтрока_ТаблицаЭффективнойДоходности.ЭффективнаяДоходностьВВалютеУчетаЗаТриГода = За3ГодаВВалютеУчета.ЭффективнаяДоходность;
				КонецЕсли;	
			Исключение
				
			КонецПопытки;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("_ТаблицаЭффективнойДоходности", _ТаблицаЭффективнойДоходности);
	
	// Выполняем программную компоновку
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка, , , , ВнешниеНаборыДанных);		
	
КонецПроцедуры
