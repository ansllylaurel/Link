		|					И (СтоимостьПереоценки.ВидУчета = _ВидыУчета.ВидУчета)
		|					И (СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки))
		|					И (СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
		|					И (СтоимостьПереоценки.Период = _ПериодыОтчета.ДатаСЧА)
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|				ПО (СтоимостьПереоценки.ЦеннаяБумага = Облигации.Ссылка)
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|				ПО (СтоимостьПереоценки.ЦеннаяБумага = Акции.Ссылка)
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|				ПО (ЕСТЬNULL(Облигации.Эмитент, Акции.Эмитент) = Эмитенты.Ссылка)
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|						&ДатаОкончания,
		|						Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|							И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮрЛицДляОпределенияРезидентства
		|				ПО (Эмитенты.ЮрФизЛицо = РеквизитыЮрЛицДляОпределенияРезидентства.ЮрФизЛицо)
		|				ЛЕВОЕ СОЕДИНЕНИЕ _РезультатыПроверкиРейтинговОблигаций КАК _РезультатыПроверкиРейтинговОблигаций
		|				ПО (_РезультатыПроверкиРейтинговОблигаций.Облигация = СтоимостьПереоценки.ЦеннаяБумага)
		|					И (_РезультатыПроверкиРейтинговОблигаций.ДатаОтчета = _ПериодыОтчета.ДатаОтчета)
		|				ЛЕВОЕ СОЕДИНЕНИЕ _РезультатыПроверкиЛиквидностиАкций КАК _РезультатыПроверкиЛиквидностиАкций
		|				ПО (_РезультатыПроверкиЛиквидностиАкций.Акция = СтоимостьПереоценки.ЦеннаяБумага)
		|					И (_РезультатыПроверкиЛиквидностиАкций.ДатаОтчета = _ПериодыОтчета.ДатаОтчета)) КАК СтоимостьАктивов
		|		ПО _ПериодыОтчета.СчетДоверительногоУправления = СтоимостьАктивов.СчетДоверительногоУправления
		|			И _ПериодыОтчета.ДатаОтчета = СтоимостьАктивов.ДатаОтчета
		|			И (СтоимостьАктивов.ДатаСЧА ЕСТЬ НЕ NULL )
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПериодыОтчета.СчетДоверительногоУправления,
		|	_ПериодыОтчета.ДатаОтчета,
		|	СтоимостьАктивов.РазделОтчета,
		|	СтоимостьАктивов.Актив,
		|	_ПериодыОтчета.ВидДоговораДоверительногоУправления,
		|	_ПериодыОтчета.ДатаСЧА";
	
	#КонецОбласти
	
	Запрос.Выполнить();
	
	ДанныеОтчета	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДанныеОтчета").ПолучитьДанные().Выгрузить();
	СчетаДУ			= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СчетаДУ").ПолучитьДанные().Выгрузить();
	РеквизитыУК		= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_РеквизитыУК").ПолучитьДанные().Выгрузить();
	
	Если ВариантОтчета = "КонкурсПФР" Тогда
		ДанныеОтчета.Индексы.Добавить("ДатаОтчета");
		ДанныеОтчета.Индексы.Добавить("СчетДоверительногоУправления, ДатаОтчета");
		ДанныеОтчета.Индексы.Добавить("СчетДоверительногоУправления, ВидАктива, ДатаОтчета");
		
		Если ЭтотОбъект.ДетализацияПоАктиву Тогда
			ДанныеОтчета.Индексы.Добавить("СчетДоверительногоУправления, ВидАктива, Актив, ДатаОтчета");
			ДанныеОтчета.Сортировать("СчетДоверительногоУправления, АктивПредставление");
		КонецЕсли;
		
		СчетаДУ.Сортировать("СчетДоверительногоУправления");		
	Иначе
		ДанныеОтчета.Индексы.Добавить("ВидДоговораДоверительногоУправления, ДатаОтчета");
		ДанныеОтчета.Индексы.Добавить("ВидДоговораДоверительногоУправления, СчетДоверительногоУправления, ДатаОтчета");
		
		СчетаДУ.Сортировать("ВидДоговораДоверительногоУправления, СчетДоверительногоУправления");
	КонецЕсли;	
		
	КонтрольНаличияСЧА(ДанныеОтчета);
	
	// Формируем отчет
	
	ИмяМакета	= ?(ВариантОтчета = "КонкурсПФР", "МакетКонкурсПФР", "Макет");
	Макет		= ПолучитьМакет(ИмяМакета);
	
	ОбластьШапкаО	= Макет.ПолучитьОбласть("Шапка|Основная");
	ОбластьШапкаС	= Макет.ПолучитьОбласть("Шапка|Сумма");
	
	Если РеквизитыУК.Количество() > 0 Тогда
		ОбластьШапкаО.Параметры.НаименованиеУК = РеквизитыУК[0].ПолноеНаименованиеПоУставу;
	КонецЕсли;
	
	Результат.Вывести(ОбластьШапкаО);
	
	Для Каждого ДатаОтчета Из МассивОтчетныхДат Цикл
		ОбластьШапкаС.Параметры.ДатаОтчета = ДатаОтчета;
		Результат.Присоединить(ОбластьШапкаС);
	КонецЦикла;
	
	Если ВариантОтчета = "КонкурсПФР" Тогда
		
		Результат.Область(1, 1, 1, Результат.ШиринаТаблицы).Объединить();
		Результат.Область(2, 1, 2, Результат.ШиринаТаблицы).Объединить();
		
		ВывестиДоговоры(Результат, ДанныеОтчета, СчетаДУ, Новый Структура); 
		
	Иначе
		
		Результат.Область(1, 1, 1, Результат.ШиринаТаблицы).Объединить();
		Результат.Область(3, 2, 3, Результат.ШиринаТаблицы).Объединить();
			
		Если ЭтотОбъект.ОтборПоДоговорам Тогда
			МассивВидыДоговоровДоверительногоУправления = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ВидыДоговоров").ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("ВидДоговораДоверительногоУправления");
		КонецЕсли;
		
		Для Каждого ВидДоговораДоверительногоУправления Из МассивВидыДоговоровДоверительногоУправления Цикл
			
			ПараметрыПоиска = Новый Структура("ВидДоговораДоверительногоУправления", ВидДоговораДоверительногоУправления);
			
			ВывестиСтроку(Результат, ДанныеОтчета, ВидДоговораДоверительногоУправления, , ПараметрыПоиска);
				
			ВывестиВидыАктивов(Результат, ДанныеОтчета, ПараметрыПоиска, , Ложь);
			
			Если ЭтотОбъект.ДетализацияПоДоговору Тогда
				
				НайденныеСтроки = СчетаДУ.НайтиСтроки(Новый Структура("ВидДоговораДоверительногоУправления", ВидДоговораДоверительногоУправления));
				
				ВывестиДоговоры(Результат, ДанныеОтчета, НайденныеСтроки, ПараметрыПоиска);
				
			КонецЕсли;
		
			Результат.ЗакончитьГруппуСтрок();
		
		КонецЦикла;
		
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("Итог", 0);
	ВывестиСтроку(Результат, ДанныеОтчета, "ИТОГ", , ПараметрыПоиска);
	ВывестиВидыАктивов(Результат, ДанныеОтчета, ПараметрыПоиска, Ложь, Ложь);
	
	#Область Заполнение_настроек_печати_и_фиксация_сессии_статистики
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Результат, Механизм, Истина, ОриентацияСтраницы.Портрет);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	#КонецОбласти	
	
КонецПроцедуры

Процедура ВывестиДоговоры(Результат, ДанныеОтчета, Договоры, Знач ПараметрыПоиска)

	Для Каждого СтрокаСчетовДУ Из Договоры Цикл
		
		ПараметрыПоиска.Вставить("СчетДоверительногоУправления", СтрокаСчетовДУ.СчетДоверительногоУправления);
		
		ВывестиСтроку(Результат, ДанныеОтчета, СтрокаСчетовДУ.НаименованиеКлиента + " договор № " + СтрокаСчетовДУ.НомерДоговора + " от " + Формат(СтрокаСчетовДУ.ДатаЗаключения, "ДФ='dd.MM.yyyy ''г.'''"), , ПараметрыПоиска);
		
		ВывестиВидыАктивов(Результат, ДанныеОтчета, ПараметрыПоиска);
		
		ПараметрыПоиска.Удалить("СчетДоверительногоУправления");
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ВывестиВидыАктивов(Результат, ДанныеОтчета, Знач ПараметрыПоиска, НачатьГруппуСтрок = Истина, ЗакончитьГруппуСтрок = Истина)
	
	Если НачатьГруппуСтрок Тогда
		Результат.НачатьГруппуСтрок();
	КонецЕсли;
	
	Для НомерВидаАктива = 1 По ВидыАктивов.Количество() Цикл
		
		ПараметрыПоиска.Вставить("ВидАктива", НомерВидаАктива);
		
		ВывестиСтроку(Результат, ДанныеОтчета, ВидыАктивов[НомерВидаАктива], , ПараметрыПоиска, Ложь);
		
		Если ЭтотОбъект.ДетализацияПоАктиву И Не ПараметрыПоиска.Свойство("Итог") Тогда
		
			Активы = ДанныеОтчета.Скопировать(ПараметрыПоиска, "Актив, АктивПредставление");
			Активы.Свернуть("Актив, АктивПредставление");
		
			ВывестиАктивы(Результат, ДанныеОтчета, Активы, ПараметрыПоиска);
			
		КонецЕсли;
		
		ПараметрыПоиска.Удалить("ВидАктива"); 
		
	КонецЦикла;
	
	Если ЗакончитьГруппуСтрок Тогда
		Результат.ЗакончитьГруппуСтрок();
	КонецЕсли;	
		
КонецПроцедуры

Процедура ВывестиАктивы(Результат, ДанныеОтчета, Активы, Знач ПараметрыПоиска)
	
	Результат.НачатьГруппуСтрок();
	
	Для Каждого СтрокаАктива Из Активы Цикл
		
		ПараметрыПоиска.Вставить("Актив", СтрокаАктива.Актив);
		
		ВывестиСтроку(Результат, ДанныеОтчета, СтрокаАктива.АктивПредставление, СтрокаАктива.Актив, ПараметрыПоиска, Ложь);
		
		ПараметрыПоиска.Удалить("Актив"); 
		
	КонецЦикла;
	
	Результат.ЗакончитьГруппуСтрок();
		
КонецПроцедуры

Процедура ВывестиСтроку(Результат, ДанныеОтчета, Показатель, РасшифровкаПоказателя, Знач ПараметрыПоиска, ЖирныйШрифт = Истина)
	
	Отступ = Макс(ПараметрыПоиска.Количество() - 1, 0);
	
	ВывестиОсновнуюСекцию(Результат, Показатель, РасшифровкаПоказателя, Отступ);
	
	Для Индекс = 0 По МассивОтчетныхДат.Количество() - 1 Цикл
		ДатаОтчета = МассивОтчетныхДат[Индекс];	
		ПараметрыПоиска.Вставить("ДатаОтчета", ДатаОтчета); 
		ВывестиСекциюСуммы(Результат, ДанныеОтчета, ПараметрыПоиска, Индекс);
		ПараметрыПоиска.Удалить("ДатаОтчета"); 
	КонецЦикла;
	
	ТекущаяОбласть = Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, Результат.ШиринаТаблицы);
	
	ТекущийШрифт = ТекущаяОбласть.Шрифт;
	
	ТекущаяОбласть.Шрифт = Новый Шрифт(ТекущийШрифт,, ТекущийШрифт.Размер - Отступ, ЖирныйШрифт);;
	
КонецПроцедуры

Процедура ВывестиОсновнуюСекцию(Результат, Показатель, РасшифровкаПоказателя, Отступ)
	
	Если ОбластьПоказатель = Неопределено Тогда
		ОбластьПоказатель = Макет.ПолучитьОбласть("Показатель|Основная");
	КонецЕсли;
	
	ОбластьПоказатель.Параметры.Заполнить(Новый Структура("Показатель, РасшифровкаПоказателя", Показатель, РасшифровкаПоказателя));
	
	Результат.Вывести(ОбластьПоказатель);
	Результат.Область(Результат.ВысотаТаблицы, 1, Результат.ВысотаТаблицы, 1).Отступ = Отступ;
	
КонецПроцедуры

Процедура ВывестиСекциюСуммы(Результат, ДанныеОтчета, ПараметрыПоиска, ИндексСуммы)
	
	Если ОбластьСумма = Неопределено Тогда
		ОбластьСумма = Макет.ПолучитьОбласть("Показатель|Сумма");
	Иначе
		ОбластьСумма.Параметры.Заполнить(Новый Структура("Регистратор, Сумма"));
	КонецЕсли;
	
	Сумма = 0;
	МассивСчетовБезСЧА = Новый Массив;
	
	НайденныеСтроки = ДанныеОтчета.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		Если СтрокаДанных.ДатаСЧА = Null И СтрокаДанных.ПроверятьНаличиеСЧА Тогда
			МассивСчетовБезСЧА.Добавить(СтрокаДанных.СчетДоверительногоУправления);
		ИначеЕсли СтрокаДанных.Сумма <> Null Тогда
			Сумма = Сумма + СтрокаДанных.Сумма;
			ОбластьСумма.Параметры.Регистратор = СтрокаДанных.Регистратор;
		КонецЕсли;
	КонецЦикла;
	
	ОбластьСумма.Параметры.Сумма = Сумма;
	
	Результат.Присоединить(ОбластьСумма);
	
	Если МассивСчетовБезСЧА.Количество() > 0 Тогда
		ТекущаяОбласть = Результат.Область(Результат.ВысотаТаблицы, 2 + ИндексСуммы, Результат.ВысотаТаблицы, 2 + ИндексСуммы);
		ТекущаяОбласть.ЦветТекста = Новый Цвет(255, 0, 0);
		
		Если ПараметрыПоиска.Свойство("СчетДоверительногоУправления") Тогда
			ТекущаяОбласть.Примечание.Текст = "По договору не зарегистрирована СЧА";
		Иначе
			ТекущаяОбласть.Примечание.Текст = "По договорам не зарегистрирована СЧА: " + Символы.ПС + СтрСоединить(МассивСчетовБезСЧА, Символы.ПС);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура КонтрольНаличияСЧА(ДанныеОтчета)
	
	СчетаДоверительногоУправленияСАктивами = Новый Соответствие;
	
	НайденныеСтроки = ДанныеОтчета.НайтиСтроки(Новый Структура("ДатаСЧА", Null));
	
	Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
		
		СчетаДоверительногоУправленияСАктивамиНаДатуОтчета = СчетаДоверительногоУправленияСАктивами.Получить(СтрокаДанных.ДатаОтчета); 	
		
		Если СчетаДоверительногоУправленияСАктивамиНаДатуОтчета = Неопределено Тогда
			
			СчетаДоверительногоУправленияСАктивамиНаДатуОтчета =
				Справочники.СчетаДоверительногоУправления.СчетаДоверительногоУправленияНаДатуСАктивами(
					СтрокаДанных.ДатаОтчета, Справочники.СчетаДоверительногоУправления.СтруктураДляОтбораСчетовДоверительногоУправления(ЭтотОбъект.Организация));
			
			СчетаДоверительногоУправленияСАктивами.Вставить(СтрокаДанных.ДатаОтчета, СчетаДоверительногоУправленияСАктивамиНаДатуОтчета);
					
		КонецЕсли;
		
		Если СчетаДоверительногоУправленияСАктивамиНаДатуОтчета.Найти(СтрокаДанных.СчетДоверительногоУправления, "СчетДоверительногоУправления") = Неопределено Тогда
			СтрокаДанных.ПроверятьНаличиеСЧА = Ложь; // Еще не было активов, СЧА не требуется
			Продолжить;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон("По договору '%1' не зарегистрировано СЧА на %2", СтрокаДанных.СчетДоверительногоУправления, Формат(СтрокаДанных.ДатаОтчета, "ДФ=dd.MM.yyyy")),
			СтрокаДанных.СчетДоверительногоУправления);
			
	КонецЦикла;

КонецПроцедуры
