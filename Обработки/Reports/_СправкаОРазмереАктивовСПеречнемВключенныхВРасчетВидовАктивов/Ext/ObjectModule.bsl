Перем МассивОтчетныхДат;
Перем ВидыАктивов;
Перем Макет, ОбластьСумма, ОбластьПоказатель;

Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет, 
		"Справка о размере активов с перечнем включенных в расчет видов активов", 
		"0.08", 
		"", 
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(Результат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	#Область Предварительная_обработка_параметров_и_регистрация_сессии_статистики	
	
	Если Ложь Тогда
		Результат = Новый ТабличныйДокумент;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ВариантОтчета = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
	
	МассивВидыДоговоровДоверительногоУправления = Новый Массив;
	Для Каждого Элемент Из ЭтотОбъект.ВидыДоговоровДоверительногоУправления Цикл
		Если Элемент.Пометка Тогда
			МассивВидыДоговоровДоверительногоУправления.Добавить(Элемент.Значение);
		КонецЕсли;	
	КонецЦикла;
	
	ЭлементСписковДоговоров = ЭтотОбъект.СпискиДоговоров.НайтиПоИдентификатору(ЭтотОбъект.ИдентификаторСпискаДоговоров);
	Если ЭлементСписковДоговоров = Неопределено Тогда
		СписокДоговоров = Новый СписокЗначений;
	Иначе	
		СписокДоговоров = ЭлементСписковДоговоров.Значение;
	КонецЕсли;
	
	// Начало сессии статистики
	
	УточненныеПараметры	= Новый Структура;
	
	Если ЭтотОбъект.ОтборПоДоговорам Тогда
		УточненныеПараметры.Вставить("СписокДоговоров", ?(ЭлементСписковДоговоров = Неопределено, "", СтрШаблон("%1 [%2]", ЭлементСписковДоговоров.Представление, СтрСоединить(СписокДоговоров.ВыгрузитьЗначения(), ", "))));
	Иначе	
		УточненныеПараметры.Вставить("ВидыДоговоров", СтрСоединить(МассивВидыДоговоровДоверительногоУправления, ", "));
	КонецЕсли;
	
	УточненныеПараметры.Вставить("ВариантОтчета", ВариантОтчета);
	
	Если ВариантОтчета = "КонкурсПФР" Тогда
		УточненныеПараметры.Вставить("ДетализацияПоАктиву",							 ЭтотОбъект.ДетализацияПоАктиву);
		УточненныеПараметры.Вставить("ОтображатьНеУдовлетворяющиеТребованиямАктивы", ЭтотОбъект.ОтображатьНеУдовлетворяющиеТребованиямАктивы);
	Иначе
		УточненныеПараметры.Вставить("ДетализацияПоДоговору",						 ЭтотОбъект.ДетализацияПоДоговору);
	КонецЕсли;
	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя();
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация, СписокОтчетныхДат, ОтборПоДоговорам", УточненныеПараметры);
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	// Определяем период, за который будут формироваться данные, для оборотов и пр.
	
	ДатаНачала		= Дата(1,1,1);
	ДатаОкончания	= Дата(1,1,1);

	МассивОтчетныхДат = ЭтотОбъект.СписокОтчетныхДат.ВыгрузитьЗначения();
	Для Каждого ДатаОтчета Из МассивОтчетныхДат Цикл
		ДатаОкончания = Макс(ДатаОкончания, ДатаОтчета);
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = Мин(ДатаНачала, ДатаОтчета);
		Иначе
			ДатаНачала = ДатаОтчета;
		КонецЕсли;
	КонецЦикла;
	
	#КонецОбласти
	
	ВидыАктивов = Новый Соответствие;
	
	Если ВариантОтчета = "КонкурсПФР" Тогда
		ВидыАктивов.Вставить(1, "1. Акции российских эмитентов");
		ВидыАктивов.Вставить(2, "2. Государственные ценные бумаги РФ");
		ВидыАктивов.Вставить(3, "3. Денежные средства на счетах в кредитных организациях");
		ВидыАктивов.Вставить(4, "4. Ценные бумаги субъектов РФ");
		ВидыАктивов.Вставить(5, "5. Облигации российских эмитентов помимо государственных ценных бумаг РФ и ценных бумаг субъектов РФ");
		ВидыАктивов.Вставить(6, "6. Депозиты в кредитных организациях");
		ВидыАктивов.Вставить(7, "7. Дебиторская задолженность");
		ВидыАктивов.Вставить(8, "8. Ценные бумаги международных финансовых организаций");
		Если ЭтотОбъект.ОтображатьНеУдовлетворяющиеТребованиямАктивы Тогда
			ВидыАктивов.Вставить(9, "9. Не удовлетворяющие требованиям активы");
		КонецЕсли;
	Иначе
		ВидыАктивов.Вставить(1, "1. Денежные средства в рублях на счетах в кредитных организациях");
		ВидыАктивов.Вставить(2, "2. Депозиты в рублях в кредитных организациях");
		ВидыАктивов.Вставить(3, "3. МНО");
		ВидыАктивов.Вставить(4, "4. Государственные ценные бумаги Российской Федерации");
		ВидыАктивов.Вставить(5, "5. Государственные ценные бумаги субъектов Российской Федерации");
		ВидыАктивов.Вставить(6, "6. Облигации российских эмитентов помимо государственных ценных бумаг Российской Федерации и государственных ценных бумаг субъектов Российской Федерации");
		ВидыАктивов.Вставить(7, "7. Акции российских эмитентов");
		ВидыАктивов.Вставить(8, "8. РЕПО");
		ВидыАктивов.Вставить(9, "9. Дебиторская задолженность");
		ВидыАктивов.Вставить(10, "10. Кредиторская задолженность");
		ВидыАктивов.Вставить(11, "11. Прочие активы");
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидыДоговоровДоверительногоУправления",	МассивВидыДоговоровДоверительногоУправления);
	Запрос.УстановитьПараметр("ОтборПоДоговорам",						ЭтотОбъект.ОтборПоДоговорам);
	Запрос.УстановитьПараметр("СписокДоговоров",						СписокДоговоров);
	Запрос.УстановитьПараметр("МассивОтчетныхДат",						МассивОтчетныхДат);
	Запрос.УстановитьПараметр("ДатаОкончания",							КонецДня(ДатаОкончания));
	
	Запрос.УстановитьПараметр("ГраницаНачала",							Новый Граница(ДатаНачала, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ГраницаОкончания",						Новый Граница(КонецДня(ДатаОкончания), ВидГраницы.Включая));
	
	Запрос.УстановитьПараметр("ВариантОтчета",							ВариантОтчета);
	Запрос.УстановитьПараметр("МинфинРоссии",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии"));
	Запрос.УстановитьПараметр("ДомРФ",									ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_ДомРФ"));	
	
	#Область Текст_запроса
			
	#Область Определение_облигаций_акций_и_банков_удовлетворяющих_требованиях
	
	Если ВариантОтчета = "КонкурсПФР" Тогда
		
		РейтинговыеАгентства = Новый Массив;
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.АКРА);
		РейтинговыеАгентства.Добавить(Справочники.РейтинговыеАгентства.RAEX);
		
		ДопустимыеБанкиДляРазмещенияДенежныхСредств = Новый Массив;
		ДопустимыеБанкиДляРазмещенияДенежныхСредств.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_БанкГПБ"));
		ДопустимыеБанкиДляРазмещенияДенежныхСредств.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_БанкВТБ"));
		
		ДопустимыеБанкиДляОткрытияДепозитныхВкладов = Новый Массив;
		ДопустимыеБанкиДляОткрытияДепозитныхВкладов.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_БанкРСХБ"));
		ДопустимыеБанкиДляОткрытияДепозитныхВкладов.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_БанкВТБ"));
		
		Запрос.УстановитьПараметр("РейтинговыеАгентства",											 РейтинговыеАгентства);
		Запрос.УстановитьПараметр("ТаблицаСопоставленияРейтингов_АКРА_RAEX_НеМеньше_BBBМинус",		 ОбщегоНазначения.ПолучитьИменованныйОбъект("СопоставлениеРейтингов_АКРА+RAEX >= ВВВ-"));
		Запрос.УстановитьПараметр("ТаблицаСопоставленияРейтингов_АКРА_RAEX_НеМеньше_BBBМинус_AAAsf", ОбщегоНазначения.ПолучитьИменованныйОбъект("СопоставлениеРейтингов_АКРА+RAEX >= ВВВ-/AAA.sf"));
		Запрос.УстановитьПараметр("ТаблицаСопоставленияРейтингов_АКРА_RAEX_НеМеньше_AAA",			 ОбщегоНазначения.ПолучитьИменованныйОбъект("СопоставлениеРейтингов_АКРА+RAEX >= AAA"));
		
		Запрос.УстановитьПараметр("КалендарьТоргов",												 Константы.ОсновнойКалендарьКотировок.Получить());
		Запрос.УстановитьПараметр("ММВБ",															 ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ"));
		
		Запрос.УстановитьПараметр("ДопустимыеБанкиДляРазмещенияДенежныхСредств",					 ДопустимыеБанкиДляРазмещенияДенежныхСредств);
		Запрос.УстановитьПараметр("ДопустимыеБанкиДляОткрытияДепозитныхВкладов",					 ДопустимыеБанкиДляОткрытияДепозитныхВкладов);
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДатыОтчета.Дата КАК ДатаОтчета,
			|	Облигации.Ссылка КАК Облигация,
			|	Облигации.Эмитент.ЮрФизЛицо КАК Эмитент
			|ПОМЕСТИТЬ _ПроверяемыеОблигации
			|ИЗ
			|	РегистрСведений.ДанныеКалендаря КАК ДатыОтчета
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО (ДатыОтчета.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
			|			И (ДатыОтчета.Дата В (&МассивОтчетныхДат))
			|			И (ДатыОтчета.Дата < Облигации.ДатаПогашения
			|				ИЛИ Облигации.ДатаПогашения = ДАТАВРЕМЯ(1, 1, 1))
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Облигация,
			|	ДатаОтчета
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПроверяемыеОблигации.ДатаОтчета КАК ДатаОтчета,
			|	_ПроверяемыеОблигации.Облигация КАК Субъект
			|ПОМЕСТИТЬ _СубьектыПроверяемыхОблигаций
			|ИЗ
			|	_ПроверяемыеОблигации КАК _ПроверяемыеОблигации
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ПроверяемыеОблигации.ДатаОтчета,
			|	_ПроверяемыеОблигации.Эмитент
			|ИЗ
			|	_ПроверяемыеОблигации КАК _ПроверяемыеОблигации
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Субъект,
			|	ДатаОтчета
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДатыИзмененияРейтингов.ДатаОтчета КАК ДатаОтчета,
			|	Рейтинги.Период КАК Период,
			|	Рейтинги.Агрегатор КАК Агрегатор,
			|	Рейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
			|	Рейтинги.Шкала КАК Шкала,
			|	Рейтинги.Шкала.ТипШкалы КАК ТипШкалы,
			|	Рейтинги.Шкала.Срок КАК Срок,
			|	Рейтинги.Шкала.ВидРейтинга КАК ВидРейтинга,
			|	Рейтинги.Субъект КАК Субъект,
			|	Рейтинги.ЗначениеРейтинга КАК ЗначениеРейтинга,
			|	Рейтинги.ЗначениеРейтинга.Оценка КАК Оценка
			|ПОМЕСТИТЬ _РейтингиСубъектовПроверяемыхОблигаций
			|ИЗ
			|	РегистрСведений.Рейтинги КАК Рейтинги
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			_СубьектыПроверяемыхОблигаций.ДатаОтчета КАК ДатаОтчета,
			|			Рейтинги.Агрегатор КАК Агрегатор,
			|			Рейтинги.РейтинговоеАгентство КАК РейтинговоеАгентство,
			|			Рейтинги.Шкала КАК Шкала,
			|			Рейтинги.Субъект КАК Субъект,
			|			МАКСИМУМ(Рейтинги.Период) КАК Период
			|		ИЗ
			|			_СубьектыПроверяемыхОблигаций КАК _СубьектыПроверяемыхОблигаций
			|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Рейтинги КАК Рейтинги
			|				ПО ((Рейтинги.Агрегатор, Рейтинги.РейтинговоеАгентство, Рейтинги.Шкала) В
			|						(ВЫБРАТЬ
			|							Шкалы.Агрегатор,
			|							Шкалы.Владелец,
			|							Шкалы.Ссылка
			|						ИЗ
			|							Справочник.ШкалыРейтинговыхАгентств КАК Шкалы
			|						ГДЕ
			|							Шкалы.Владелец В (&РейтинговыеАгентства)
			|							И Шкалы.ТипШкалы = ЗНАЧЕНИЕ(Перечисление.ТипыШкалРейтинговыхАгенств.Национальная)))
			|					И (Рейтинги.Субъект = _СубьектыПроверяемыхОблигаций.Субъект)
			|					И (Рейтинги.Период <= _СубьектыПроверяемыхОблигаций.ДатаОтчета)
			|		
			|		СГРУППИРОВАТЬ ПО
			|			_СубьектыПроверяемыхОблигаций.ДатаОтчета,
			|			Рейтинги.Агрегатор,
			|			Рейтинги.РейтинговоеАгентство,
			|			Рейтинги.Шкала,
			|			Рейтинги.Субъект) КАК ДатыИзмененияРейтингов
			|		ПО Рейтинги.Агрегатор = ДатыИзмененияРейтингов.Агрегатор
			|			И Рейтинги.РейтинговоеАгентство = ДатыИзмененияРейтингов.РейтинговоеАгентство
			|			И Рейтинги.Шкала = ДатыИзмененияРейтингов.Шкала
			|			И Рейтинги.Субъект = ДатыИзмененияРейтингов.Субъект
			|			И Рейтинги.Период = ДатыИзмененияРейтингов.Период
			|			И (Рейтинги.ЗначениеРейтинга.РейтингСнят = ЛОЖЬ)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Субъект,
			|	ДатаОтчета
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ПроверяемыеОблигации.ДатаОтчета КАК ДатаОтчета,
			|	_ПроверяемыеОблигации.Облигация КАК Облигация,
			|	РейтингиЭмиссии_АКРА_RAEX.Субъект ЕСТЬ NULL КАК РейтингиЭмиссииОтсутствуют,
			|	РейтингиЭмиссии_АКРА_RAEX_НеМеньше_BBBМинус.Субъект ЕСТЬ НЕ NULL  КАК РейтингиЭмиссии_АКРА_RAEX_НеМеньше_BBBМинус,
			|	РейтингиЭмиссии_АКРА_RAEX_НеМеньше_BBBМинус_AAAsf.Субъект ЕСТЬ НЕ NULL  КАК РейтингиЭмиссии_АКРА_RAEX_НеМеньше_BBBМинус_AAAsf,
			|	РейтингиЭмитента_АКРА_RAEX_НеМеньше_AAA.Субъект ЕСТЬ НЕ NULL  КАК РейтингиЭмитента_АКРА_RAEX_НеМеньше_AAA
			|ПОМЕСТИТЬ _РезультатыПроверкиРейтинговОблигаций
			|ИЗ
			|	_ПроверяемыеОблигации КАК _ПроверяемыеОблигации
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
