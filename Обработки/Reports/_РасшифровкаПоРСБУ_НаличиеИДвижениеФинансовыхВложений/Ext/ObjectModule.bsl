Процедура ДобавитьСтрокуРасшифровки(СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений, ВидФинансовогоВложения, ДолгосрочноеВложение, УчитыватьКорректировку, Период, ВыборкаИтог)
	
	СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ВидФинансовогоВложения = ВидФинансовогоВложения;
	СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ДолгосрочноеВложение = ДолгосрочноеВложение;
	СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ЦеннаяБумага = ВыборкаИтог.ЦеннаяБумага;
	СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Период = Период;
	
	Если ДолгосрочноеВложение Тогда
		СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Стоимость = ВыборкаИтог.СуммаДолгосрочная;
		Если УчитыватьКорректировку Тогда
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимость = (ВыборкаИтог.СуммаДолгосрочная - (ВыборкаИтог.СуммаДолгосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная));
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировка = (ВыборкаИтог.СуммаДолгосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная);
		Иначе
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимость = ВыборкаИтог.СуммаДолгосрочная;
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировка = 0;
		КонецЕсли;	
	Иначе
		СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Стоимость = ВыборкаИтог.СуммаКраткосрочная;
		Если УчитыватьКорректировку Тогда
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимость = (ВыборкаИтог.СуммаКраткосрочная - (ВыборкаИтог.СуммаКраткосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная));
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировка = (ВыборкаИтог.СуммаКраткосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная);
		Иначе
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимость = ВыборкаИтог.СуммаКраткосрочная;
			СтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировка = 0;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

Процедура Сформировать(ДокументРезультат, Расшифровка) Экспорт
		
	Если Не (ЗначениеЗаполнено(ЭтотОбъект.ЮрФизЛицо) 
			ИЛИ ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан клиент или счет ДУ!");
		Возврат;
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)) И (Не ЗначениеЗаполнено(ЭтотОбъект.ЮрФизЛицо)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать юр. лицо клиента или счет ДУ!");
		Возврат;
	КонецЕсли;

	// Фиксируем старт операции
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,КлючТекущегоВарианта");
	
	Попытка
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
	КонецПопытки;
	
	ДокументРезультат.Очистить();
	Расшифровка.Очистить();
	
	КолЗнак = ТочностьЕдиницыИзмерения;
	
	Коэффициент = 1;				
	Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1 Тогда 
		КодЕИ = "383";
		НазвЕИ = "руб";
		Коэффициент = 1;				
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда 
		КодЕИ = "384";
		НазвЕИ = "тыс. руб";
		Коэффициент = 1000;		
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда 
		КодЕИ = "385";
		НазвЕИ = "млн. руб";
		Коэффициент = 1000000;	
	КонецЕсли;	
	СтрокаФормат = "ЧДЦ="+КолЗнак+"; ЧРГ=' '; ЧН=-; ЧГ=3,0";//"ЧДЦ="+КолЗнак+"; ЧРД=.; ЧРГ=' '; ЧН=-; ЧГ=3,0; ЧО=0";
	
	ДатаНачальная = Период.ДатаНачала;
	ДатаКонечная = КонецДня(Период.ДатаОкончания);	
	
	//даты прошлого года
	ДатаКонечнаяПрошлыйГод = ДобавитьМесяц(ДатаКонечная, -12);
	ДатаНачальнаяПрошлыйГод = НачалоГода(ДатаКонечнаяПрошлыйГод); 
	
	КС = Новый КвалификаторыСтроки(150);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТиповСтрока = Новый ОписаниеТипов(МассивТипов, , , , КС);
	
	КЧ = Новый КвалификаторыЧисла(17,ТочностьЕдиницыИзмерения);;
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ОписаниеТиповЧисло = Новый ОписаниеТипов(МассивТипов, , , КЧ);
	
	
	ТЗОтчетаНаличие_и_движение_финансовых_вложений = Новый ТаблицаЗначений;
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ВидФинансовогоВложения", ОписаниеТиповСтрока);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ДолгосрочноеВложение", Новый ОписаниеТипов("Булево"));
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПервоначальнаяСтоимостьНаНачалоПериодаТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("НакопленнаяКорректировкаНаНачалоПериодаТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПоступилоСтоимостьТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПоступилоКорректировкаТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("СписаноСтоимостьТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("СписаноКорректировкаТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("НакопленнаяКорректировкаНаКонецПериодаТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПереклассифицированноТекущийГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПроцентыТекущийГод", ОписаниеТиповЧисло);
	
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПервоначальнаяСтоимостьНаНачалоПериодаПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("НакопленнаяКорректировкаНаНачалоПериодаПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПоступилоСтоимостьПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПоступилоКорректировкаПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("СписаноСтоимостьПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("СписаноКорректировкаПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПервоначальнаяСтоимостьНаКонецПериодаПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("НакопленнаяКорректировкаНаКонецПериодаПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПереклассифицированноПрошлыйГод", ОписаниеТиповЧисло);
	ТЗОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПроцентыПрошлыйГод", ОписаниеТиповЧисло);
	
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений = Новый ТаблицаЗначений;
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ВидФинансовогоВложения", ОписаниеТиповСтрока);
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ДолгосрочноеВложение", Новый ОписаниеТипов("Булево"));
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("Стоимость", ОписаниеТиповЧисло);
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ПервоначальнаяСтоимость", ОписаниеТиповЧисло);
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("НакопленнаяКорректировка", ОписаниеТиповЧисло);
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Колонки.Добавить("ЦеннаяБумага", Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	
	
	Запрос_Активы_Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ВнешняяТаблица.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ВнешняяТаблица.ВидАктиваЦБ КАК ВидАктиваЦБ,
	|	_ВнешняяТаблица.поРЕПО КАК поРЕПО,
	|	_ВнешняяТаблица.вРЕПО КАК вРЕПО,
	|	_ВнешняяТаблица.СуммаКраткосрочная КАК СуммаКраткосрочная,
	|	_ВнешняяТаблица.СуммаДолгосрочная КАК СуммаДолгосрочная,
	|	_ВнешняяТаблица.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная КАК СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная,
	|	_ВнешняяТаблица.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная КАК СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная
	|ПОМЕСТИТЬ _Активы
	|ИЗ
	|	&ВнешняяТаблица КАК _ВнешняяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Активы.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_Активы.ВидАктиваЦБ КАК ВидАктиваЦБ,
	|	_Активы.вРЕПО КАК вРЕПО,
	|	_Активы.поРЕПО КАК поРЕПО,
	|	СУММА(_Активы.СуммаКраткосрочная) КАК СуммаКраткосрочная,
	|	СУММА(_Активы.СуммаДолгосрочная) КАК СуммаДолгосрочная,
	|	СУММА(_Активы.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная) КАК СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная,
	|	СУММА(_Активы.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная) КАК СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная
	|ИЗ
	|	_Активы КАК _Активы
	|
	|СГРУППИРОВАТЬ ПО
	|	_Активы.ЦеннаяБумага,
	|	_Активы.ВидАктиваЦБ,
	|	_Активы.вРЕПО,
	|	_Активы.поРЕПО";
	
	
	ДанныеСрочностьЦБ = РаботаСОтчетами.ПолучитьДолгосрочныеИКраткосрочныеАктивы(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ДатаКонечная);
	Активы = ДанныеСрочностьЦБ.Активы;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Запрос_Активы_Текст;
	
	Запрос.Параметры.Вставить("ВнешняяТаблица", Активы);
	
	ВыборкаИтог = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаИтог.Следующий() Цикл 
		ВидФинансовогоВложения = ПолучитьНаименованиеФинансовогоВложения(ВыборкаИтог.ВидАктиваЦБ, ВыборкаИтог.поРЕПО, ВыборкаИтог.вРЕПО);
		УчитыватьКорректировку = УчитыватьНачальнуюКорректировку(ВыборкаИтог.ВидАктиваЦБ, ВыборкаИтог.поРЕПО, ВыборкаИтог.вРЕПО);
		Если ЗначениеЗаполнено(ВыборкаИтог.СуммаКраткосрочная) ИЛИ (ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная) Тогда
			НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений = ТЗОтчетаНаличие_и_движение_финансовых_вложений.Добавить();	
			НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ВидФинансовогоВложения = ВидФинансовогоВложения;
			НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ДолгосрочноеВложение = Ложь;
			
			Если УчитыватьКорректировку Тогда
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод = (ВыборкаИтог.СуммаКраткосрочная - (ВыборкаИтог.СуммаКраткосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная))/Коэффициент;
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировкаНаКонецПериодаТекущийГод = (ВыборкаИтог.СуммаКраткосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеКраткосрочная)/Коэффициент;
			Иначе
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод = ВыборкаИтог.СуммаКраткосрочная/Коэффициент;
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировкаНаКонецПериодаТекущийГод = 0;
			КонецЕсли;	
			
			НоваяСтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений = ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Добавить();
			ДобавитьСтрокуРасшифровки(НоваяСтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений, ВидФинансовогоВложения, НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ДолгосрочноеВложение, УчитыватьКорректировку, ДатаКонечная, ВыборкаИтог);
			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаИтог.СуммаДолгосрочная) ИЛИ (ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная) Тогда
			НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений = ТЗОтчетаНаличие_и_движение_финансовых_вложений.Добавить();	
			НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ВидФинансовогоВложения = ВидФинансовогоВложения;
			НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ДолгосрочноеВложение = Истина;
			
			Если УчитыватьКорректировку Тогда
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод = (ВыборкаИтог.СуммаДолгосрочная - (ВыборкаИтог.СуммаДолгосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная))/Коэффициент;
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировкаНаКонецПериодаТекущийГод = (ВыборкаИтог.СуммаДолгосрочная - ВыборкаИтог.СтоимостьПокупкиСРасходамиПриПокупкеДолгосрочная)/Коэффициент;
			Иначе
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод = ВыборкаИтог.СуммаДолгосрочная/Коэффициент;
				НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.НакопленнаяКорректировкаНаКонецПериодаТекущийГод = 0;
			КонецЕсли;	
			
			НоваяСтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений = ТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений.Добавить();
			ДобавитьСтрокуРасшифровки(НоваяСтрокаТЗРасшифровкаОтчетаНаличие_и_движение_финансовых_вложений, ВидФинансовогоВложения, НоваяСтрока_ТЗОтчетаНаличие_и_движение_финансовых_вложений.ДолгосрочноеВложение, УчитыватьКорректировку, ДатаКонечная, ВыборкаИтог);
			
		КонецЕсли;
	КонецЦикла;	
	
	ДанныеСрочностьЦБ = РаботаСОтчетами.ПолучитьДолгосрочныеИКраткосрочныеАктивы(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ДатаНачальная);
	Активы = ДанныеСрочностьЦБ.Активы;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Запрос_Активы_Текст;
	
