	|	_ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияПриход - ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|			ТОГДА _ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияПриход
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ИндексацияНоминалаЗаВремяВладенияДолгосрочнаяПриход,
	|	_ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияРасход - ВЫБОР
	|		КОГДА _ИтоговаяТаблица.ЦБКраткосрочная
	|			ТОГДА _ИтоговаяТаблица.ИндексацияНоминалаЗаВремяВладенияРасход
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ИндексацияНоминалаЗаВремяВладенияДолгосрочнаяРасход
	|ПОМЕСТИТЬ _Активы
	|ИЗ
	|	_ИтоговаяТаблица КАК _ИтоговаяТаблица";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ПериодЗапроса", Новый Граница(КонецДня(ОкончаниеПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ОкончаниеПериода));
	
	Запрос.УстановитьПараметр("Рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Запрос.Выполнить();
	
	Настройка = МВТ.Таблицы.Найти("_Настройка").ПолучитьДанные().Выгрузить();
	Активы = МВТ.Таблицы.Найти("_Активы").ПолучитьДанные().Выгрузить();
	
	Результат = Новый Структура;
	Результат.Вставить("Настройка", Настройка);
	Результат.Вставить("Активы", Активы);
	
	Возврат Результат;
		
КонецФункции	

Функция ПолучитьНаименованиеФинансовогоВложения(ВидАктиваЦБ, поРЕПО, вРЕПО)
	
	Если поРЕПО ИЛИ вРЕПО Тогда
		Возврат "Депозиты и прочие размещенные средства в кредитных организациях и банках-нерезидентах (обратное РЕПО)";	
		// В будущем может пригодится чтобы различать виды РЕПО. Пока не понятно как если что их делить.
		//Если ВыборкаПартия.вРЕПО И ВыборкаПартия.ПоРЕПО  Тогда
		//	Возврат = "Куплена по РЕПО и продана в РЕПО";
		//ИначеЕсли ВыборкаПартия.вРЕПО И НЕ ВыборкаПартия.ПоРЕПО  Тогда
		//	Возврат = "Продана в РЕПО";
		//ИначеЕсли НЕ ВыборкаПартия.вРЕПО И ВыборкаПартия.ПоРЕПО  Тогда	
		//	Возврат = "Куплена по РЕПО";
		//КонецЕсли;	
	Иначе
		Если ВидАктиваЦБ = Справочники.УчетныеАктивы.Акции ИЛИ ВидАктиваЦБ = Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов Тогда
			Возврат "Долевые ценные бумаги (акции)";
		ИначеЕсли ВидАктиваЦБ = Справочники.УчетныеАктивы.ОблигацииКорпоративные ИЛИ ВидАктиваЦБ = Справочники.УчетныеАктивы.Еврооблигации Тогда
			Возврат "Долговые ценные бумаги (корпоративные облигации)";
		ИначеЕсли ВидАктиваЦБ = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные ИЛИ ВидАктиваЦБ = Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте Тогда
			Возврат "Долговые ценные бумаги (гос. облигации)";
		ИначеЕсли ВидАктиваЦБ = Справочники.УчетныеАктивы.ДепозитныеВклады Тогда
			Возврат "Депозиты и прочие размещенные средства в кредитных организациях и банках-нерезидентах (депозиты)";
		Иначе
			Возврат "Долговые ценные бумаги";			
		КонецЕсли;	
	КонецЕсли;	
	
КонецФункции	

Функция УчитыватьНачальнуюКорректировку(ВидАктиваЦБ, поРЕПО, вРЕПО)
	
	Если поРЕПО ИЛИ вРЕПО Тогда
		Возврат Ложь;	
	Иначе
		Если ВидАктиваЦБ = Справочники.УчетныеАктивы.Акции ИЛИ ВидАктиваЦБ = Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов Тогда
			Возврат Истина; // Татьяна Капашилова 16.04.24 по телефону сказала что по акциям ей тоже необходимо выделять накопленную корректировку
		ИначеЕсли ВидАктиваЦБ = Справочники.УчетныеАктивы.ОблигацииКорпоративные ИЛИ ВидАктиваЦБ = Справочники.УчетныеАктивы.Еврооблигации ИЛИ
			ВидАктиваЦБ = Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные ИЛИ ВидАктиваЦБ = Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;			
		КонецЕсли;	
	КонецЕсли;	
	
