
#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Пояснения к балансу. Наличие и движение финансовых вложений, ДЗ, КЗ.",
		"0.21",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Период = НастройкиОтчета.Период;
	
	Если НастройкиОтчета.Свойство("ЕдиницаИзмерения")
		И ЗначениеЗаполнено(НастройкиОтчета.ЕдиницаИзмерения) Тогда 
		ЕдиницаИзмерения = НастройкиОтчета.ЕдиницаИзмерения;
	Иначе
		ЕдиницаИзмерения = ПредопределенноеЗначение("Перечисление.ПорядкиОкругленияОтчетности.Окр1");
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("ТочностьЕдиницыИзмерения") Тогда
		ТочностьЕдиницыИзмерения = НастройкиОтчета.ТочностьЕдиницыИзмерения;
	Иначе
		ТочностьЕдиницыИзмерения = 2;
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("УчитыватьПереводыДолгосрочных") Тогда
		УчитыватьПереводыДолгосрочных = НастройкиОтчета.УчитыватьПереводыДолгосрочных;
	Иначе
		УчитыватьПереводыДолгосрочных = Истина;
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("ЗадолженностьПоМетодикеФОГФ") Тогда
		ЗадолженностьПоМетодикеФОГФ = НастройкиОтчета.ЗадолженностьПоМетодикеФОГФ;
	Иначе
		ЗадолженностьПоМетодикеФОГФ = Ложь;
	КонецЕсли;
	
	СтруктураКлюча = Новый Структура;
	СтруктураКлюча.Вставить("Подразделение",	ПредопределенноеЗначение("Справочник.Подразделения.ГруппаКомпаний"));
	СтруктураКлюча.Вставить("Язык",				ПредопределенноеЗначение("Справочник.Языки.Русский"));
	СтруктураКлюча.Вставить("Объект",			ЭтотОбъект.Организация);
	
	Если НастройкиОтчета.Свойство("Подписант") Тогда
		Если ТипЗнч(НастройкиОтчета.Подписант) = Тип("Структура") Тогда
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
		Иначе	
			СтруктураКлюча.Вставить("КонтактноеЛицо", НастройкиОтчета.Подписант);
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча));
		КонецЕсли;
	КонецЕсли;	
	
	Если НастройкиОтчета.Свойство("ПодписантРуководитель") Тогда
		Если ТипЗнч(НастройкиОтчета.ПодписантРуководитель) = Тип("Структура") Тогда
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", НастройкиОтчета.ПодписантРуководитель);
		Иначе	
			СтруктураКлюча.Вставить("КонтактноеЛицо", НастройкиОтчета.ПодписантРуководитель);
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхРуководитель", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча));
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("ПодписантГлавбух") Тогда
		Если ТипЗнч(НастройкиОтчета.ПодписантГлавбух) = Тип("Структура") Тогда
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлавбух", НастройкиОтчета.ПодписантГлавбух);
		Иначе	
			СтруктураКлюча.Вставить("КонтактноеЛицо", НастройкиОтчета.ПодписантГлавбух);
			ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлавбух", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(СтруктураКлюча));
		КонецЕсли;
	КонецЕсли;
	
	ДокументРезультат = Новый ТабличныйДокумент;
	Расшифровка = Новый ТабличныйДокумент;
	
	Сформировать(ДокументРезультат, Расшифровка);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьДолгосрочныеИКраткосрочныеДвиженияАктивов(Организация, СчетДоверительногоУправления, НачалоПериода, ОкончаниеПериода) Экспорт
	
	// описание запросов
	// См. РаботаСОтчетами.ПолучитьДолгосрочныеИКраткосрочныеАктивы Методы сбора и классификации данных аналогичны, только там Остатки, а тут Обороты. 
	
	Запрос = Новый Запрос;
	МВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.КлассификацияАктиваПоСрочности КАК КлассификацияАктиваПоСрочности,
	|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДепозитныеВклады)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ДепозитныеСчета)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Акции)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.АкцииИностранныхЭмитентов)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Паи)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Векселя)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.Векселя)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.КорпоративныеОблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ГосударственныеОблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.КорпоративныеОблигацииКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ГосударственныеОблигацииКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ЕврооблигацииКупон)
	|				КОНЕЦ
	|		ИНАЧЕ НастройкиУчетаАктивовСрезПоследних.СчетУчета
	|	КОНЕЦ КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ДепозитныеВклады)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоДепозитнымВкладам)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Акции)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаАкций)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.АкцииИностранныхЭмитентов)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаАкцийИностранныхЭмитентов)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Паи)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаПаев)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяДисконтные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаВекселей)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ВекселяПроцентные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаВекселей)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаКорпоративныхОблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаГосударственныхОблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииКорпоративныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаКорпоративныхОблигацийКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаГосударственныхОблигацийКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.Еврооблигации)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ЕврооблигацииКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийКупон)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийТело)
	|					КОГДА НастройкиУчетаАктивовСрезПоследних.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон)
	|						ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.ПереоценкаЕврооблигацийКупон)
	|				КОНЕЦ
	|		ИНАЧЕ НастройкиУчетаАктивовСрезПоследних.СчетУчетаПереоценки
	|	КОНЕЦ КАК СчетУчетаПереоценки,
