Процедура ЗаполнитьЗначениеСвойствСтроки(Приемник, Источник, СтрокаФормат, ИтоговаяСтрока = Ложь)
	
	Если Не ИтоговаяСтрока Тогда
		Приемник.ВидФинансовогоВложения = Источник.ВидФинансовогоВложения;	
	КонецЕсли;	
	Приемник.ПервоначальнаяСтоимостьНаНачалоПериодаТекущийГод = Формат(Источник.ПервоначальнаяСтоимостьНаНачалоПериодаТекущийГод, СтрокаФормат);
	Приемник.НакопленнаяКорректировкаНаНачалоПериодаТекущийГод = Формат(Источник.НакопленнаяКорректировкаНаНачалоПериодаТекущийГод, СтрокаФормат);
	Приемник.ПоступилоСтоимостьТекущийГод = Формат(Источник.ПоступилоСтоимостьТекущийГод, СтрокаФормат);
	Приемник.ПоступилоКорректировкаТекущийГод = Формат(Источник.ПоступилоКорректировкаТекущийГод, СтрокаФормат);
	Приемник.СписаноСтоимостьТекущийГод = Формат(Источник.СписаноСтоимостьТекущийГод, СтрокаФормат);
	Приемник.СписаноКорректировкаТекущийГод = Формат(Источник.СписаноКорректировкаТекущийГод, СтрокаФормат);
	Приемник.ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод = Формат(Источник.ПервоначальнаяСтоимостьНаКонецПериодаТекущийГод, СтрокаФормат);
	Приемник.НакопленнаяКорректировкаНаКонецПериодаТекущийГод = Формат(Источник.НакопленнаяКорректировкаНаКонецПериодаТекущийГод, СтрокаФормат);
	Приемник.ПервоначальнаяСтоимостьНаНачалоПериодаПрошлыйГод = Формат(Источник.ПервоначальнаяСтоимостьНаНачалоПериодаПрошлыйГод, СтрокаФормат);
	Приемник.НакопленнаяКорректировкаНаНачалоПериодаПрошлыйГод = Формат(Источник.НакопленнаяКорректировкаНаНачалоПериодаПрошлыйГод, СтрокаФормат);
	Приемник.ПоступилоСтоимостьПрошлыйГод = Формат(Источник.ПоступилоСтоимостьПрошлыйГод, СтрокаФормат);
	Приемник.ПоступилоКорректировкаПрошлыйГод = Формат(Источник.ПоступилоКорректировкаПрошлыйГод, СтрокаФормат);
	Приемник.СписаноСтоимостьПрошлыйГод = Формат(Источник.СписаноСтоимостьПрошлыйГод, СтрокаФормат);
	Приемник.СписаноКорректировкаПрошлыйГод = Формат(Источник.СписаноКорректировкаПрошлыйГод, СтрокаФормат);
	Приемник.ПервоначальнаяСтоимостьНаКонецПериодаПрошлыйГод = Формат(Источник.ПервоначальнаяСтоимостьНаКонецПериодаПрошлыйГод, СтрокаФормат);
	Приемник.НакопленнаяКорректировкаНаКонецПериодаПрошлыйГод = Формат(Источник.НакопленнаяКорректировкаНаКонецПериодаПрошлыйГод, СтрокаФормат);
	Приемник.ПроцентыТекущийГод = Формат(Источник.ПроцентыТекущийГод, СтрокаФормат);
	Приемник.ПроцентыПрошлыйГод = Формат(Источник.ПроцентыПрошлыйГод, СтрокаФормат);
	Приемник.ПереклассифицированноТекущийГод = Формат(Источник.ПереклассифицированноТекущийГод, СтрокаФормат);
	Приемник.ПереклассифицированноПрошлыйГод = Формат(Источник.ПереклассифицированноПрошлыйГод, СтрокаФормат);
	
КонецПроцедуры	

Процедура ЗаполнитьЗначениеСвойствСтрокиДЗ(Приемник, Источник, СтрокаФормат, ИтоговаяСтрока = Ложь, ОбщийИтог = Ложь)
	
	Если Не ИтоговаяСтрока Тогда
		Приемник.ВидЗадолженности = Источник.ВидЗадолженности;	
	КонецЕсли;	
	Приемник.ДЗНаНачалоПериодаТекущийГод = Формат(Источник.ДЗНаНачалоПериодаТекущийГод, СтрокаФормат);
	Приемник.ДЗРезервНаНачалоПериодаТекущийГод = Формат(0, СтрокаФормат);
	Приемник.ДЗПоступилоТекущийГод = Формат(Источник.ДЗПоступилоТекущийГод, СтрокаФормат);
	Приемник.ДЗИныеПоступилоТекущийГод = Формат(0, СтрокаФормат);
	Приемник.ДЗСписаноПогашеноТекущийГод = Формат(Источник.ДЗСписаноПогашеноТекущийГод, СтрокаФормат);
	Приемник.ДЗСписаноРасходыТекущийГод = Формат(0, СтрокаФормат);
	Приемник.ДЗСписаноРезервТекущийГод = Формат(0, СтрокаФормат);
	Если Не ОбщийИтог Тогда
		Приемник.ДЗПереклассифицированноТекущийГод = Формат(0, СтрокаФормат);
	КонецЕсли;	
	Приемник.ДЗНаКонецПериодаТекущийГод = Формат(Источник.ДЗНаКонецПериодаТекущийГод, СтрокаФормат);
	Приемник.ДЗРезервНаКонецПериодаТекущийГод = Формат(0, СтрокаФормат);
	
	
	Приемник.ДЗНаНачалоПериодаПрошлыйГод = Формат(Источник.ДЗНаНачалоПериодаПрошлыйГод, СтрокаФормат);
	Приемник.ДЗРезервНаНачалоПериодаПрошлыйГод = Формат(0, СтрокаФормат);
	Приемник.ДЗПоступилоПрошлыйГод = Формат(Источник.ДЗПоступилоПрошлыйГод, СтрокаФормат);
	Приемник.ДЗИныеПоступилоПрошлыйГод = Формат(0, СтрокаФормат);
	Приемник.ДЗСписаноПогашеноПрошлыйГод = Формат(Источник.ДЗСписаноПогашеноПрошлыйГод, СтрокаФормат);
	Приемник.ДЗСписаноРасходыПрошлыйГод = Формат(0, СтрокаФормат);
	Приемник.ДЗСписаноРезервПрошлыйГод = Формат(0, СтрокаФормат);
	Если Не ОбщийИтог Тогда
		Приемник.ДЗПереклассифицированноПрошлыйГод = Формат(0, СтрокаФормат);
	КонецЕсли;	
	Приемник.ДЗНаКонецПериодаПрошлыйГод = Формат(Источник.ДЗНаКонецПериодаПрошлыйГод, СтрокаФормат);
	Приемник.ДЗРезервНаКонецПериодаПрошлыйГод = Формат(0, СтрокаФормат);
	
КонецПроцедуры

