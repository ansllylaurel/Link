Перем МассивОшибок;
Перем ОтчетФормируетсяАвтоматически;

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о результатах доверительного управления",
		"2.02",
		"",
		Истина
	);
		
	// команды отсутствуют - только интерактивный запуск
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ОтчетФормируетсяАвтоматически = Истина;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ДатаПервогоВвода = ПолучитьДатуПервогоВводаПоСчетуДУ(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период);
	
	Если ДатаПервогоВвода = Неопределено ИЛИ ДатаПервогоВвода > ЭтотОбъект.Период.ДатаОкончания Тогда
		ВызватьИсключение  СтрШаблон("По счету доверительного управления %1 на %2 не зарегистрировано ни одного ввода.", ЭтотОбъект.СчетДоверительногоУправления, Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Если ДатаПервогоВвода > ЭтотОбъект.Период.ДатаНачала Тогда
		ЭтотОбъект.Период.ДатаНачала = ДатаПервогоВвода;
	КонецЕсли;		
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ПриКомпоновкеРезультата(ДокументРезультат, Неопределено, Ложь);
	
	Если МассивОшибок.Количество() Тогда
		ВызватьИсключение СтрСоединить(МассивОшибок, Символы.ПС);
	КонецЕсли;
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ВариантОтчета");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("АвтоматическаяОтправка");
	Настройки.Добавить("АдресЭлектроннойПочты");
	Настройки.Добавить("АдресОтправителя");
	Настройки.Добавить("СНачалаУправления");
	Возврат Настройки;

КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.Период.ДатаОкончания < ЭтотОбъект.Период.ДатаНачала Тогда
		ЗарегистрироватьОшибку("Некорректно задан период расчета", МассивОшибок, Отказ);
		
	ИначеЕсли Год(ЭтотОбъект.Период.ДатаНачала) <> Год(ЭтотОбъект.Период.ДатаОкончания) Тогда
		ЗарегистрироватьОшибку("Даты начала и окончания периода расчета должны быть в одном году", МассивОшибок, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)	
	
	Отказ = Ложь;
	СтандартнаяОбработка = Ложь;
	
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,КлючТекущегоВарианта,ВалютаОтчета");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Организация_РЭМ	= ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");
	
	Если Организация = Организация_РЭМ Тогда
		Логотип = ПолучитьОбщийМакет("ЛоготипРЭМ");
	Иначе
		Логотип = Неопределено;
	КонецЕсли;
	
	ВалютаУчета		= ЭтотОбъект.Организация.ВалютаУчета;
	ОтчетВВалюте	= ЗначениеЗаполнено(ЭтотОбъект.ВалютаОтчета) И (ЭтотОбъект.ВалютаОтчета <> ВалютаУчета);
	ПостфиксОбласти	= ?(ОтчетВВалюте, "Валюта", "");
	
	ПараметрыРасчетаДоходности = Новый Структура;
	ПараметрыРасчетаДоходности.Вставить("Организация",					ЭтотОбъект.Организация);
	ПараметрыРасчетаДоходности.Вставить("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	ПараметрыРасчетаДоходности.Вставить("ДатаНачала",					ЭтотОбъект.Период.ДатаНачала);
	ПараметрыРасчетаДоходности.Вставить("ДатаОкончания",				ЭтотОбъект.Период.ДатаОкончания);
	ПараметрыРасчетаДоходности.Вставить("УчитыватьНДФЛПоНачислению",	Истина);
	ПараметрыРасчетаДоходности.Вставить("РасшифровкаРасчета",			Истина);
	ПараметрыРасчетаДоходности.Вставить("МассивОшибок",					МассивОшибок);
	ПараметрыРасчетаДоходности.Вставить("ВалютаРасчета",				Справочники.Валюты.ПустаяСсылка());
	
	Если ЭтотОбъект.ИсключитьАктивыИзРасчетаДоходности Тогда
		ПараметрыРасчетаДоходности.Вставить("СписокАктивовДляИсключенияИзРасчетаДоходности", ЭтотОбъект.СписокАктивовДляИсключенияИзРасчетаДоходности);
    КонецЕсли;

	НаименованияКлиента = РаботаСОтчетами.ПолноеИКраткоеНаименованиеКлиентаДляДокументов(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания);
	
	#Область Текст_запроса
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДУ,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДУ,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправления.Клиент КАК Клиент,
		|	СтратегииИндивидуальногоИнвестирования.Стратегия КАК Стратегия
		|ПОМЕСТИТЬ КлиентыДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправления
		|		ПО (КлиентыДоверительногоУправления.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК СтратегииИндивидуальногоИнвестирования
		|		ПО (СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ПОМЕСТИТЬ РеквизитыОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&КонецПериода,
		|			ЮрФизЛицо = &ЮрФизЛицоОрганизации
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ПолноеНаименованиеКлиента КАК ПолноеНаименованиеКлиента
		|ПОМЕСТИТЬ РеквизитыКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Значение
		|ПОМЕСТИТЬ КурсВалютыОтчета
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Валюта = &ВалютаОтчета
		|	И КурсыВалют.Период = &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|				И ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			ТОГДА ""Еврооблигации""
		|		ИНАЧЕ СтоимостьПереоценки.Рынок
		|	КОНЕЦ КАК Рынок,
		|	СУММА(СтоимостьПереоценки.Количество) - ЕСТЬNULL(КоличествоЦБКупленныхПоРЕПО.Количество, 0) КАК Количество,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета + СтоимостьПереоценки.СуммаКупонаВВалютеУчета) - ЕСТЬNULL(СтоимостьЦБКупленныхПоРЕПО.Стоимость, 0) КАК Стоимость
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗадолженностиПоВторойЧастиРЕПО.ЦеннаяБумага КАК ЦеннаяБумага,
		|			СУММА(ЗадолженностиПоВторойЧастиРЕПО.КоличествоОстаток) КАК Количество
		|		ИЗ
		|			РегистрНакопления.ЗадолженностиПоВторойЧастиРЕПО.Остатки(
		|					&КонецПериодаКонецДняГраница,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И &НеУчитыватьЦБКупленныеПоРЕПО
		|						И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)) КАК ЗадолженностиПоВторойЧастиРЕПО
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЗадолженностиПоВторойЧастиРЕПО.ЦеннаяБумага) КАК КоличествоЦБКупленныхПоРЕПО
		|		ПО (КоличествоЦБКупленныхПоРЕПО.ЦеннаяБумага = СтоимостьПереоценки.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			АктивыНеЦБ.СубъектАналитики КАК ЦеннаяБумага,
		|			-СУММА(АктивыНеЦБ.СуммаРынокВВалютеУчета) КАК Стоимость
		|		ИЗ
		|			РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК АктивыНеЦБ
		|		ГДЕ
		|			АктивыНеЦБ.Организация = &Организация
		|			И АктивыНеЦБ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|			И АктивыНеЦБ.Период = &КонецПериода
		|			И АктивыНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			И АктивыНеЦБ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			И АктивыНеЦБ.СубъектАналитики <> НЕОПРЕДЕЛЕНО
		|		
		|		СГРУППИРОВАТЬ ПО
		|			АктивыНеЦБ.СубъектАналитики) КАК СтоимостьЦБКупленныхПоРЕПО
		|		ПО (СтоимостьЦБКупленныхПоРЕПО.ЦеннаяБумага = СтоимостьПереоценки.ЦеннаяБумага)
		|ГДЕ
		|	СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И СтоимостьПереоценки.Период = &КонецПериода
		|	И НЕ СтоимостьПереоценки.ЦеннаяБумага В (&СписокАктивовДляИсключенияИзРасчетаДоходности)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|				И ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
		|			ТОГДА ""Еврооблигации""
		|		ИНАЧЕ СтоимостьПереоценки.Рынок
		|	КОНЕЦ,
		|	КоличествоЦБКупленныхПоРЕПО.Количество,
		|	СтоимостьЦБКупленныхПоРЕПО.Стоимость
		|
		|ИМЕЮЩИЕ
		|	(СУММА(СтоимостьПереоценки.Количество) <> ЕСТЬNULL(КоличествоЦБКупленныхПоРЕПО.Количество, 0)
		|		ИЛИ СУММА(СтоимостьПереоценки.СуммаВВалютеУчета + СтоимостьПереоценки.СуммаКупонаВВалютеУчета) <> ЕСТЬNULL(СтоимостьЦБКупленныхПоРЕПО.Стоимость, 0))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АктивыНеЦБ.СубъектАналитики,
