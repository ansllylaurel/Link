		</valueType>
		<value xsi:type="dcscor:DesignTimeValue">Перечисление.ТипыДепозитарныхСчетов.Депозитарный</value>
		<value xsi:type="dcscor:DesignTimeValue">Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета</value>
		<useRestriction>true</useRestriction>
