		|			_ДанныеОтчетаПоПериодам.ЯвляетсяКвалифицированнымИнвестором КАК ЯвляетсяКвалифицированнымИнвестором,
		|			_ДанныеОтчетаПоПериодам.СтрокаОтчетаСЧА КАК СтрокаОтчетаСЧА,
		|			_ДанныеОтчетаПоПериодам.СтрокаОтчетаКоличество КАК СтрокаОтчетаКоличество
		|		ИЗ
		|			_ДанныеОтчетаПоПериодам КАК _ДанныеОтчетаПоПериодам
		|		ГДЕ
		|			_ДанныеОтчетаПоПериодам.КолонкаОтчета = ""ОкончаниеПериода"") КАК _ДанныеОтчетаОкончание
		|		ПО _ДанныеОтчетаНачало.СчетДоверительногоУправления = _ДанныеОтчетаОкончание.СчетДоверительногоУправления";
	
	Запрос.Выполнить();
	
	#КонецОбласти 
	
	#Область Данные_отчета
	
	ТаблицаРазделов = ПолучитьТаблицуРазделов(Макет);
	Запрос.УстановитьПараметр("ТаблицаРазделов", ТаблицаРазделов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаРазделов.Наименование КАК Наименование,
		|	ТаблицаРазделов.Раздел КАК Раздел,
		|	ТаблицаРазделов.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ _ТаблицаРазделов
		|ИЗ
		|	&ТаблицаРазделов КАК ТаблицаРазделов";
	Запрос.Выполнить();	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаРазделов.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаРазделов.Наименование КАК Наименование,
		|	_ДанныеОтчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЕСТЬNULL(_ДанныеОтчета.СЧАНачалоПериода, 0) КАК СЧА_НачалоПериода,
		|	ЕСТЬNULL(_ДанныеОтчета.СЧАОкончаниеПериода, 0) КАК СЧА_ОкончаниеПериода,
		|	ВЫБОР
		|		КОГДА _ДанныеОтчета.ЯвляетсяКвалифицированнымИнвесторомНачалоПериода
		|			ТОГДА _ДанныеОтчета.СЧАНачалоПериода
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СЧАКвал_НачалоПериода,
		|	ВЫБОР
		|		КОГДА _ДанныеОтчета.ЯвляетсяКвалифицированнымИнвесторомОкончаниеПериода
		|			ТОГДА _ДанныеОтчета.СЧАОкончаниеПериода
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК СЧАКвал_ОкончаниеПериода
		|ИЗ
		|	_ТаблицаРазделов КАК _ТаблицаРазделов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеОтчета КАК _ДанныеОтчета
		|		ПО _ТаблицаРазделов.НомерСтроки = _ДанныеОтчета.СтрокаОтчетаСЧА
		|ГДЕ
		|	_ТаблицаРазделов.Раздел = ""Активы""
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки,
		|	СчетДоверительногоУправления
		|ИТОГИ
		|	МАКСИМУМ(Наименование),
		|	СУММА(СЧА_НачалоПериода),
		|	СУММА(СЧА_ОкончаниеПериода),
		|	СУММА(СЧАКвал_НачалоПериода),
		|	СУММА(СЧАКвал_ОкончаниеПериода)
		|ПО
		|	ОБЩИЕ,
		|	НомерСтроки,
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаРазделов.НомерСтроки КАК НомерСтроки,
		|	_ТаблицаРазделов.Наименование КАК Наименование,
		|	ЕСТЬNULL(_ДанныеОтчета.КлиентНачалоПериода, _ДанныеОтчета.КлиентОкончаниеПериода) КАК СчетДоверительногоУправления,
		|	_ДанныеОтчета.КлиентНачалоПериода КАК КлиентНачалоПериода,
		|	_ДанныеОтчета.КлиентОкончаниеПериода КАК КлиентОкончаниеПериода
		|ИЗ
		|	_ТаблицаРазделов КАК _ТаблицаРазделов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеОтчета КАК _ДанныеОтчета
		|		ПО _ТаблицаРазделов.НомерСтроки = _ДанныеОтчета.СтрокаОтчетаКоличество
		|ГДЕ
		|	_ТаблицаРазделов.Раздел = ""КоличествоФондов""
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки,
		|	СчетДоверительногоУправления
		|ИТОГИ
		|	МАКСИМУМ(Наименование),
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КлиентНачалоПериода),
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КлиентОкончаниеПериода)
		|ПО
		|	НомерСтроки,
		|	СчетДоверительногоУправления
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	#КонецОбласти 
	
	ДанныеОтчета = Новый Структура("СуммыАктивов, КоличествоКлиентов", 
		ПакетРезультатов[0],
		ПакетРезультатов[1]);
		
	СобственныеСредства = РаботаСВнешнимиСистемами.ПолучитьСтоимостьСобственныхСредствИзБухгалтерии(ЭтотОбъект.Организация, ЭтотОбъект.Период.ДатаОкончания);
	ДанныеОтчета.Вставить("СобственныеСредства", СобственныеСредства);
	
	#Область Данные_о_компании
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименование,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ВебСтраница КАК Сайт,
		|	ЕСТЬNULL(ВложенныйЗапрос.Значение, """") КАК ДатаОснования
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ТекущаяДата,
		|			ЮрФизЛицо = &ЮрЛицоОрганизации
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И Организация = &Организация) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЗначенияДополнительныхСведений.Значение КАК Значение
		|		ИЗ
		|			РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ГДЕ
		|			ЗначенияДополнительныхСведений.Объект = &Организация
		|			И ЗначенияДополнительныхСведений.Свойство.Ключ = ""ДатаОснованияКомпании"") КАК ВложенныйЗапрос
		|		ПО (ИСТИНА)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ДанныеОКомпании = Новый Структура;
	ДанныеОКомпании.Вставить("ДатаЗаполнения", 		Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));
	ДанныеОКомпании.Вставить("ОтветственноеЛицо", 	РаботаСПользователями.ТекущийПользователь().Наименование);
	ДанныеОКомпании.Вставить("ПолноеНаименование", 	Выборка.ПолноеНаименование);
	ДанныеОКомпании.Вставить("ИНН", 				Выборка.ИНН);
	ДанныеОКомпании.Вставить("ДатаОснования", 		Выборка.ДатаОснования);
	ДанныеОКомпании.Вставить("Сайт", 				Выборка.Сайт);
	
	ДанныеОтчета.Вставить("ДанныеОКомпании", ДанныеОКомпании);		
	#КонецОбласти 
	
	Возврат ДанныеОтчета;

КонецФункции

Процедура ПоместитьТаблицуДатРасчетаСЧАВМенеджерВременныхТаблиц(Запрос, ДатаРасчетаСЧА)

	Если ДатаРасчетаСЧА = НачалоДня(ЭтотОбъект.Период.ДатаНачала) Тогда
		ПодстрокаПериод = "НачалоПериода";
	Иначе
		ПодстрокаПериод = "ОкончаниеПериода";
	КонецЕсли; 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.Организация КАК Организация,
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	&ДатаС КАК ДатаНачала,
		|	&ДатаПо КАК ДатаОкончания
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	_АктуальныеСчетаДоверительногоУправления КАК _СчетаДоверительногоУправления";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаС", 	"&ПоследнийРабочийДень" + ПодстрокаПериод);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаПо", "&" + ПодстрокаПериод);
	
	Запрос.Выполнить();
	
	ПараметрыДатСЧА = Новый Структура("ВидДействия, ДополнитьРабочимиДнями, ИмяТаблицыДатДействияЗаПериод, УдалитьВсеВременныеТаблицы", 
									"СЧА", Истина, "_ВсеДатыРасчетаСЧА", Истина);
	
	Запрос.Текст = Справочники.НастройкиРегламентныхДействий.ПолучитьТекстЗапросаПоДатамРегламентныхДействий(ПараметрыДатСЧА);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаС", 	"&ПоследнийРабочийДень" + ПодстрокаПериод);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаПо", "&" + ПодстрокаПериод);
	
	Запрос.Выполнить();
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеДатыРасчетаСЧА.Организация КАК Организация,
		|	_ВсеДатыРасчетаСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МАКСИМУМ(_ВсеДатыРасчетаСЧА.Дата) КАК Дата
		|ПОМЕСТИТЬ _ДатыРасчетаСЧА
		|ИЗ
		|	_ВсеДатыРасчетаСЧА КАК _ВсеДатыРасчетаСЧА
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеДатыРасчетаСЧА.СчетДоверительногоУправления,
		|	_ВсеДатыРасчетаСЧА.Организация";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ДатыРасчетаСЧА", "_ДатыРасчетаСЧА" + ПодстрокаПериод);
	
	Запрос.Выполнить();
	
	Запрос.Текст = 	
		"УНИЧТОЖИТЬ _ДатыДействияРазвернуто
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СчетаДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ВсеДатыРасчетаСЧА";
		
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьПараметрыВыполненияДляСбораСтатистики() Экспорт
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация", 	ЭтотОбъект.Организация);
	ПараметрыОтчета.Вставить("ДатаНачала", 		ЭтотОбъект.Период.ДатаНачала);
	ПараметрыОтчета.Вставить("ДатаОкончания", 	ЭтотОбъект.Период.ДатаОкончания);
	ПараметрыОтчета.Вставить("Версия", 			СведенияОВнешнейОбработке().Версия);
	
	Описание = "";
	
	Для каждого Параметр Из ПараметрыОтчета Цикл
	
		Описание = Описание + Символы.ПС + Параметр.Ключ + ": " + Параметр.Значение;
	
	КонецЦикла; 
	
	Описание = Сред(Описание, 2);
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции

Функция ПолучитьТаблицуРазделов(Макет = Неопределено)

	Если Макет = Неопределено Тогда
		Макет = ПолучитьМакет("Макет");
	КонецЕсли; 
	
	ТаблицаРазделов = Новый ТаблицаЗначений;
	ТаблицаРазделов.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250, ДопустимаяДлина.Переменная)));
	ТаблицаРазделов.Колонки.Добавить("Раздел", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20, ДопустимаяДлина.Переменная)));
	ТаблицаРазделов.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	
	ОбластьРазделыАктивы = Макет.ПолучитьОбласть("РазделыАктивы");
	ОбластьРазделыКоличествоФондов = Макет.ПолучитьОбласть("РазделыКоличествоФондов");
	
	ДобавитьСтрокиВТаблицуРазделов(ТаблицаРазделов, ОбластьРазделыАктивы, "Активы");
	ДобавитьСтрокиВТаблицуРазделов(ТаблицаРазделов, ОбластьРазделыКоличествоФондов, "КоличествоФондов");
	
	Возврат ТаблицаРазделов;

КонецФункции
 
Процедура ДобавитьСтрокиВТаблицуРазделов(ТаблицаРазделов, Область, Раздел)

	Для НомерСтроки = 1 По Область.ВысотаТаблицы Цикл
	
		НоваяСтрока = ТаблицаРазделов.Добавить();
		НоваяСтрока.Наименование = Область.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
		НоваяСтрока.Раздел = Раздел;
		НоваяСтрока.НомерСтроки = НомерСтроки;
	
	КонецЦикла; 

КонецПроцедуры
 
