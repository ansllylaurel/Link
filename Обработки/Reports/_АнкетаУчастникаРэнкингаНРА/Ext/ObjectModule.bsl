
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Анкета участника рэнкинга ""НРА""",
		"1.02",
		"",
		Истина
	);
		
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура СформироватьОтчет(ДокументРезультат) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики();
	Механизм = "ВнешнийОтчет._АнкетаУчастникаРэнкингаНРА.СформироватьОтчет()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ДокументРезультат.Очистить();
		
	Макет = ПолучитьМакет("Макет");
	ОбластьШапкаАктивы 				= Макет.ПолучитьОбласть("ШапкаАктивы");
	ОбластьСтрокаРаздел 			= Макет.ПолучитьОбласть("СтрокаРаздел");
	ОбластьСтрокаСчетДУ 			= Макет.ПолучитьОбласть("СтрокаСчетДУ");
	ОбластьШапкаКоличествоФондов 	= Макет.ПолучитьОбласть("ШапкаКоличествоФондов");
	ОбластьСобственныеСредства 		= Макет.ПолучитьОбласть("СобственныеСредства");
	
	ОбластьШапкаАктивы.Параметры.НачалоПериода = Формат(НачалоДня(ЭтотОбъект.Период.ДатаНачала), "ДФ=dd.MM.yyyy");
	ОбластьШапкаАктивы.Параметры.ОкончаниеПериода = Формат(НачалоДня(ЭтотОбъект.Период.ДатаОкончания), "ДФ=dd.MM.yyyy");
	
	ДокументРезультат.Вывести(ОбластьШапкаАктивы);
	
	ДанныеОтчета = ПолучитьДанныеОтчета();
	
	#Область Суммы_активов
	
	ВыборкаИтог = ДанныеОтчета.СуммыАктивов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаКвалифицированныхИнвесторов = Новый ТаблицаЗначений;
	ТаблицаКвалифицированныхИнвесторов.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаКвалифицированныхИнвесторов.Колонки.Добавить("СЧАКвал_НачалоПериода", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
	ТаблицаКвалифицированныхИнвесторов.Колонки.Добавить("СЧАКвал_ОкончаниеПериода", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
	
	Пока ВыборкаИтог.Следующий() Цикл
	
		ВыборкаСтрока = ВыборкаИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаСтрока.Следующий() Цикл
			
			Префикс = ?(ВыборкаСтрока.НомерСтроки = 16, "СЧАКвал", "СЧА");
			
			Коллекция = ?(ВыборкаСтрока.НомерСтроки >= 15, ВыборкаИтог, ВыборкаСтрока);
			
			ОбластьСтрокаРаздел.Параметры.Значение_НачалоПериода = Формат(Коллекция[Префикс + "_НачалоПериода"], "ЧДЦ=2; ЧН=0; ЧГ=3,0");
			ОбластьСтрокаРаздел.Параметры.Значение_ОкончаниеПериода = Формат(Коллекция[Префикс + "_ОкончаниеПериода"], "ЧДЦ=2; ЧН=0; ЧГ=3,0");
			ОбластьСтрокаРаздел.Параметры.Наименование = ВыборкаСтрока.Наименование;
			
			ДокументРезультат.Вывести(ОбластьСтрокаРаздел);
			
			ДокументРезультат.НачатьГруппуСтрок();

			Если ВыборкаСтрока.НомерСтроки < 15 И ЭтотОбъект.ВыводитьРасшифровку Тогда // 15 - раздел ИТОГО, для него детали не нужны, 16 обрабатывается ниже
			
				ВыборкаСчетДУ = ВыборкаСтрока.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаСчетДУ.Следующий() Цикл
					
					Если ЗначениеЗаполнено(ВыборкаСчетДУ.СчетДоверительногоУправления) Тогда
					
						ОбластьСтрокаСчетДУ.Параметры.Значение_НачалоПериода = Формат(ВыборкаСчетДУ[Префикс + "_НачалоПериода"], "ЧДЦ=2; ЧН=0; ЧГ=3,0");
						ОбластьСтрокаСчетДУ.Параметры.Значение_ОкончаниеПериода = Формат(ВыборкаСчетДУ[Префикс + "_ОкончаниеПериода"], "ЧДЦ=2; ЧН=0; ЧГ=3,0");
						ОбластьСтрокаСчетДУ.Параметры.СчетДоверительногоУправления = ВыборкаСчетДУ.СчетДоверительногоУправления;
						ДокументРезультат.Вывести(ОбластьСтрокаСчетДУ);
						
						Если ВыборкаСчетДУ.СЧАКвал_НачалоПериода + ВыборкаСчетДУ.СЧАКвал_ОкончаниеПериода > 0 Тогда
							ЗаполнитьЗначенияСвойств(ТаблицаКвалифицированныхИнвесторов.Добавить(), ВыборкаСчетДУ);
						КонецЕсли; 
					
					КонецЕсли; 
					
				КонецЦикла;		
				
			ИначеЕсли ВыборкаСтрока.НомерСтроки = 16 И ЭтотОбъект.ВыводитьРасшифровку Тогда 
				
				Для каждого Строка Из ТаблицаКвалифицированныхИнвесторов Цикл
				
					ОбластьСтрокаСчетДУ.Параметры.Значение_НачалоПериода = Формат(Строка[Префикс + "_НачалоПериода"], "ЧДЦ=2; ЧН=0; ЧГ=3,0");
					ОбластьСтрокаСчетДУ.Параметры.Значение_ОкончаниеПериода = Формат(Строка[Префикс + "_ОкончаниеПериода"], "ЧДЦ=2; ЧН=0; ЧГ=3,0");
					ОбластьСтрокаСчетДУ.Параметры.СчетДоверительногоУправления = Строка.СчетДоверительногоУправления;
					ДокументРезультат.Вывести(ОбластьСтрокаСчетДУ);
				
				КонецЦикла; 
				
			КонецЕсли;
			
			ДокументРезультат.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
	КонецЦикла;
	
	#КонецОбласти 
	
	#Область Количество_клиентов
	
	ОбластьШапкаКоличествоФондов.Параметры.НачалоПериода = Формат(НачалоДня(ЭтотОбъект.Период.ДатаНачала), "ДФ=dd.MM.yyyy");
	ОбластьШапкаКоличествоФондов.Параметры.ОкончаниеПериода = Формат(НачалоДня(ЭтотОбъект.Период.ДатаОкончания), "ДФ=dd.MM.yyyy");
	
	ДокументРезультат.Вывести(ОбластьШапкаКоличествоФондов);
	
	ВыборкаСтрока = ДанныеОтчета.КоличествоКлиентов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСтрока.Следующий() Цикл
		
		ОбластьСтрокаРаздел.Параметры.Значение_НачалоПериода = Формат(ВыборкаСтрока.КлиентНачалоПериода, "ЧДЦ=0; ЧН=0; ЧГ=3,0");
		ОбластьСтрокаРаздел.Параметры.Значение_ОкончаниеПериода = Формат(ВыборкаСтрока.КлиентОкончаниеПериода, "ЧДЦ=0; ЧН=0; ЧГ=3,0");
		ОбластьСтрокаРаздел.Параметры.Наименование = ВыборкаСтрока.Наименование;
		
		ДокументРезультат.Вывести(ОбластьСтрокаРаздел);
		
		ДокументРезультат.НачатьГруппуСтрок();
		
		ВыборкаСчетДУ = ВыборкаСтрока.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ЭтотОбъект.ВыводитьРасшифровку Тогда
		
			Пока ВыборкаСчетДУ.Следующий() Цикл
				
				Если ЗначениеЗаполнено(ВыборкаСчетДУ.СчетДоверительногоУправления) Тогда
				
					ОбластьСтрокаСчетДУ.Параметры.Значение_НачалоПериода = "";
					ОбластьСтрокаСчетДУ.Параметры.Значение_ОкончаниеПериода = "";
					ОбластьСтрокаСчетДУ.Параметры.СчетДоверительногоУправления = ВыборкаСчетДУ.СчетДоверительногоУправления;
							
					ДокументРезультат.Вывести(ОбластьСтрокаСчетДУ);				
				
				КонецЕсли; 
				
			КонецЦикла;
		
		КонецЕсли; 
		
		ДокументРезультат.ЗакончитьГруппуСтрок();

	КонецЦикла;
		
	#КонецОбласти 
	
	#Область Собственные_средства
	ОбластьСобственныеСредства.Параметры.ОкончаниеПериода = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	ОбластьСобственныеСредства.Параметры.СобственныеСредства = ДанныеОтчета.СобственныеСредства;
	ДокументРезультат.Вывести(ОбластьСобственныеСредства);		
	#КонецОбласти 
	
	ДокументРезультат.ПоказатьУровеньГруппировокСтрок(0);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Функция ПолучитьДанныеОтчета(Макет = Неопределено) Экспорт

	Запрос = Новый Запрос;
	
	ПоследнийРабочийДеньНачалоПериода = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаНачала);
	ПоследнийРабочийДеньОкончаниеПериода = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, ЭтотОбъект.Период.ДатаОкончания);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", 							ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", 							НачалоДня(ЭтотОбъект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", 						НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ПоследнийРабочийДеньНачалоПериода", 		ПоследнийРабочийДеньНачалоПериода);
	Запрос.УстановитьПараметр("ПоследнийРабочийДеньОкончаниеПериода", 	ПоследнийРабочийДеньОкончаниеПериода);
	
	#Область Текст_запроса_актуальные_счета_ДУ
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|	И (СчетаДоверительногоУправления.ДатаЗаключения <= &ОкончаниеПериода
		|				И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &НачалоПериода)
		|			ИЛИ СчетаДоверительногоУправления.ДатаЗаключения <= &ОкончаниеПериода
		|				И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|					ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &ОкончаниеПериода))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК Период
		|ПОМЕСТИТЬ _ДатаПервойОперации
		|ИЗ
		|	_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.СчетДоверительногоУправления,
		|	МИНИМУМ(ВложенныйЗапрос.Период)
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ОстаткиДенежныхСредств.Период КАК Период
		|	ИЗ
		|		РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО ОстаткиДенежныхСредств.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|				И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|	ГДЕ
		|		ОстаткиДенежныхСредств.Активность
		|		И ОстаткиДенежныхСредств.Период <= КОНЕЦПЕРИОДА(&ОкончаниеПериода, ДЕНЬ)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ОстаткиЦенныхБумаг.СчетДоверительногоУправления,
		|		ОстаткиЦенныхБумаг.Период
		|	ИЗ
		|		РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО ОстаткиЦенныхБумаг.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|				И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|	ГДЕ
		|		ОстаткиЦенныхБумаг.Активность
