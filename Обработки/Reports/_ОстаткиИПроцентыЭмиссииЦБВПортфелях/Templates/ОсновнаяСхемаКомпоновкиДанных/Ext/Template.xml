				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.Эмитент КАК Эмитент,
	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦБ,
	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага.РазмерЭмиссииШт КАК Эмиссия,
	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК Клиент,
	ОстаткиЦенныхБумагОстатки.КоличествоОстаток КАК Остаток
ПОМЕСТИТЬ _ОстаткиЦБ
ИЗ
	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
			{(&amp;ПериодГраница)},
			Организация = &amp;Организация
				И ЦеннаяБумага ССЫЛКА Справочник.Акции
				И (ЦеннаяБумага.ДатаАннулирования = ДАТАВРЕМЯ(1, 1, 1)
					ИЛИ ЦеннаяБумага.ДатаАннулирования &gt; &amp;Период)) КАК ОстаткиЦенныхБумагОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Акции.Эмитент КАК Эмитент,
	Акции.Ссылка КАК ЦБ,
	Акции.РазмерЭмиссииШт КАК Эмиссия
ПОМЕСТИТЬ _РазмерыЭмиссийПоЦБ
ИЗ
	Справочник.Акции КАК Акции
ГДЕ
	Акции.Эмитент В
			(ВЫБРАТЬ
				Акции.Эмитент
			ИЗ
				_ОстаткиЦБ)
	И (Акции.ДатаАннулирования = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Акции.ДатаАннулирования &gt; &amp;Период)
	И НЕ Акции.Ссылка В (&amp;НеактуальныеАкции)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	_РазмерыЭмиссийПоЦБ.Эмитент КАК Эмитент,
	СУММА(_РазмерыЭмиссийПоЦБ.Эмиссия) КАК РазмерЭмиссии
ПОМЕСТИТЬ _РазмерыЭмиссийПоЭмитентам
ИЗ
	_РазмерыЭмиссийПоЦБ КАК _РазмерыЭмиссийПоЦБ

СГРУППИРОВАТЬ ПО
	_РазмерыЭмиссийПоЦБ.Эмитент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	_ОстаткиЦБ.Эмитент КАК Эмитент,
	_ОстаткиЦБ.Клиент КАК Клиент,
	СУММА(_ОстаткиЦБ.Остаток) КАК КоличествоВПортфеле
ПОМЕСТИТЬ _ОстаткиЦБПоКлиентам
ИЗ
	_ОстаткиЦБ КАК _ОстаткиЦБ

СГРУППИРОВАТЬ ПО
	_ОстаткиЦБ.Эмитент,
	_ОстаткиЦБ.Клиент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	_ОстаткиЦБПоКлиентам.Эмитент КАК Эмитент,
	_ОстаткиЦБПоКлиентам.Клиент КАК Клиент,
	_ОстаткиЦБПоКлиентам.КоличествоВПортфеле КАК КоличествоВПортфеле,
	ВЫБОР
		КОГДА _РазмерыЭмиссийПоЭмитентам.РазмерЭмиссии = 0
			ТОГДА 0
		ИНАЧЕ (ВЫРАЗИТЬ(_ОстаткиЦБПоКлиентам.КоличествоВПортфеле * 100 КАК ЧИСЛО(26, 6))) / (ВЫРАЗИТЬ(_РазмерыЭмиссийПоЭмитентам.РазмерЭмиссии КАК ЧИСЛО(26, 6)))
	КОНЕЦ КАК ПроцентВПортфеле
ИЗ
	_ОстаткиЦБПоКлиентам КАК _ОстаткиЦБПоКлиентам
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РазмерыЭмиссийПоЭмитентам КАК _РазмерыЭмиссийПоЭмитентам
		ПО _ОстаткиЦБПоКлиентам.Эмитент = _РазмерыЭмиссийПоЭмитентам.Эмитент
ГДЕ
	ВЫБОР
			КОГДА &amp;ПороговыйПроцент &gt; 0
				ТОГДА ВЫБОР
						КОГДА _РазмерыЭмиссийПоЭмитентам.РазмерЭмиссии = 0
							ТОГДА 0
						ИНАЧЕ (ВЫРАЗИТЬ(_ОстаткиЦБПоКлиентам.КоличествоВПортфеле * 100 КАК ЧИСЛО(26, 6))) / (ВЫРАЗИТЬ(_РазмерыЭмиссийПоЭмитентам.РазмерЭмиссии КАК ЧИСЛО(26, 6)))
					КОНЕЦ &gt;= &amp;ПороговыйПроцент
			ИНАЧЕ ИСТИНА
		КОНЕЦ

УПОРЯДОЧИТЬ ПО
	_ОстаткиЦБПоКлиентам.Эмитент.Наименование,
	_ОстаткиЦБПоКлиентам.Клиент.Наименование</query>
