Перем КратностьЕдиницыИзмерения;
Перем ФорматСуммы;

#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчетность в ПФР",
		"1.80",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
		
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

// Отчет об инвестировании средств пенсионных накоплений
#Область Инвестирование_средств_пенсионных_накоплений

Функция ПолучитьДанные_ИнвестированиеСредствПенсионныхНакоплений(ЕдиницаИзмерения = "Тысячи") Экспорт
	
	ПакетДанных = Новый Структура;     
	ПакетДанных.Вставить("ИмяОтчета"			, "ИнвестированиеСредствПенсионныхНакоплений");
	ПакетДанных.Вставить("Отчет"				, Новый Структура);
	
	ПакетОтчетность = Новый Структура;
	
	ИспользоватьДанныеБэкОфиса = ЭтотОбъект.Период.ДатаНачала >= '20190101';
	
	// Сумму начисленных процентов по депозитам получим как разницу между данными СЧА на конец и начало периода
	Проценты 				= 0;
	Проценты_СНачалаГода 	= 0;
	Если ИспользоватьДанныеБэкОфиса И ЭтотОбъект.Период.ДатаОкончания < '20250101' Тогда	
		Проценты 				= ПолучитьПроцентыПоДепозитуИзСЧА(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
		Проценты_СНачалаГода 	= ПолучитьПроцентыПоДепозитуИзСЧА(ЭтотОбъект.СчетДоверительногоУправления, НачалоГода(ЭтотОбъект.Период.ДатаНачала), ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;
	
	ГруппыДоходовИРасходов = ПолучитьСоставГруппДоходовИРасходов(ИспользоватьДанныеБэкОфиса);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаНачала"						, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаНачалаГода"					, ?(Год(ЭтотОбъект.Период.ДатаНачала) <> Год(ЭтотОбъект.Период.ДатаОкончания), ЭтотОбъект.Период.ДатаНачала, НачалоГода(ЭтотОбъект.Период.ДатаНачала)));
	Запрос.УстановитьПараметр("ДатаОкончания"					, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"						, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"	, ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидПоказателя"   				, Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("Руководитель"					, "");
	Запрос.УстановитьПараметр("Контролер"						, "");
	Запрос.УстановитьПараметр("Тыс"								, ?(ЕдиницаИзмерения = "Тысячи", "Тыс. ", ""));
	Запрос.УстановитьПараметр("ФинансовыйРезультатОтРеализации"			, ГруппыДоходовИРасходов.ФинансовыйРезультатОтРеализации);
	Запрос.УстановитьПараметр("ДивидендыИПроцентыПоЦБ"					, ГруппыДоходовИРасходов.ДивидендыИПроцентыПоЦБ);
	Запрос.УстановитьПараметр("ПроцентыПоДепозитам"						, ГруппыДоходовИРасходов.ПроцентыПоДепозитам);
	Запрос.УстановитьПараметр("ФинансовыйРезультатОтПереоценкиАктивов"	, ГруппыДоходовИРасходов.ФинансовыйРезультатОтПереоценкиАктивов);
	Запрос.УстановитьПараметр("ДругиеВидыДоходов"						, ГруппыДоходовИРасходов.ДругиеВидыДоходов);
	Запрос.УстановитьПараметр("ОплатаУслугСпецДепозитария"				, ГруппыДоходовИРасходов.ОплатаУслугСпецДепозитария);
	Запрос.УстановитьПараметр("ОплатаУслугПрофУчастниковРынкаЦБ"		, ГруппыДоходовИРасходов.ОплатаУслугПрофУчастниковРынкаЦБ);
	Запрос.УстановитьПараметр("ОплатаУслугАудитора"						, ГруппыДоходовИРасходов.ОплатаУслугАудитора);
	Запрос.УстановитьПараметр("ВознаграждениеУправляющейКомпании"		, ГруппыДоходовИРасходов.ВознаграждениеУправляющейКомпании);
	Запрос.УстановитьПараметр("РасходыНаОбязательноеСтрахование"		, ГруппыДоходовИРасходов.РасходыНаОбязательноеСтрахование);
	Запрос.УстановитьПараметр("ОплатаПрочихУслуг"						, ГруппыДоходовИРасходов.ОплатаПрочихУслуг);
	Запрос.УстановитьПараметр("ИсключенныеДоходыИРасходы"				, ГруппыДоходовИРасходов.ИсключенныеДоходыИРасходы);
	Запрос.УстановитьПараметр("ИспользоватьДанныеБэкОфиса"				, ИспользоватьДанныеБэкОфиса);
	Запрос.УстановитьПараметр("ПроцентыПоДепозитамИзСЧА"				, Проценты);
	Запрос.УстановитьПараметр("ПроцентыПоДепозитамИзСЧА_СНачалаГода"	, Проценты_СНачалаГода);
	Запрос.УстановитьПараметр("КонецПредыдущегоГода"				    , КонецГода(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -12)));
	
	МассивВидовОперацийВводаАктивов = Новый Массив;
	МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР);
	МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление);
	
	Запрос.УстановитьПараметр("ВидыОперацийВводаАктивов", МассивВидовОперацийВводаАктивов); 
	
	МассивВидовОперацийВыводаАктивов = Новый Массив;
	МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению);
	МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР);
	
	Запрос.УстановитьПараметр("ВидыОперацийВыводаАктивов", МассивВидовОперацийВыводаАктивов); 
		
	ПакетОтчетаДоходностьОтИнвестирования = ПолучитьДанные_ДоходыОтИнвестированияСредствПенсионныхНакоплений(ЕдиницаИзмерения, Проценты, Проценты_СНачалаГода);
	ДоходОтИнвестирования = 0;
	ДоходОтИнвестирования_СНачалаГода = 0;
	ВознаграждениеУК = 0;
	ВознаграждениеУК_СНачалаГода = 0;
	Если ПакетОтчетаДоходностьОтИнвестирования.Отчет.Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений.Таб_Отчет.Количество() > 0 Тогда
		СтрокаДанных = ПакетОтчетаДоходностьОтИнвестирования.Отчет.Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений.Таб_Отчет[0];
		ДоходОтИнвестирования = СтрокаДанных.ДоходОтИнвестирования;
		ДоходОтИнвестирования_СНачалаГода = СтрокаДанных.ДоходОтИнвестирования_СНачалаГода;
		ВознаграждениеУК = СтрокаДанных.ВознаграждениеУправляющейКомпании;
		ВознаграждениеУК_СНачалаГода = СтрокаДанных.ВознаграждениеУправляющейКомпании_СНачалаГода;
	КонецЕсли;
	
	ПакетТаблица = Новый Структура;
	ДанныеОтчетаОбИнвестировании = ПолучитьДанные_ИнвестированиеСредствПенсионныхНакоплений_МассивСтрок(Запрос);
	ПроверкаСЧАВыполнена = Истина;
	Если ДанныеОтчетаОбИнвестировании.Количество() > 0 Тогда
		СтрокаДанныхОтчетаОбИнвестировании = ДанныеОтчетаОбИнвестировании[0];
		СтрокаДанныхОтчетаОбИнвестировании.Вставить("ФинРезультат", ДоходОтИнвестирования);
		СтрокаДанныхОтчетаОбИнвестировании.Вставить("ФинРезультат_СНачалаГода", ДоходОтИнвестирования_СНачалаГода);
		
		// Проверим регистрацию СЧА на начало и конец периода
		ДатыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ДатаЗаключения,ДатаРасторжения");
		
		Если ДатыДоговора.ДатаЗаключения <= ЭтотОбъект.Период.ДатаНачала 
				И СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивов = Null Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не зарегистрирована СЧА на начало периода отчета");
			ПакетДанных.Вставить("Отказ", Истина);
			Возврат ПакетДанных;
		ИначеЕсли СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивов = Null Тогда 
			СтрокаДанныхОтчетаОбИнвестировании.Вставить("СтоимЧистАктивов", 0);
		КонецЕсли;
		
		Если (ДатыДоговора.ДатаРасторжения = '00010101' Или КонецДня(ДатыДоговора.ДатаРасторжения) >= КонецДня(ЭтотОбъект.Период.ДатаОкончания)) 
				И СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивовНаКонецОтчПериода = Null Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не зарегистрирована СЧА на конец периода отчета");
			ПакетДанных.Вставить("Отказ", Истина);
			Возврат ПакетДанных;
		ИначеЕсли СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивовНаКонецОтчПериода = Null Тогда 
			СтрокаДанныхОтчетаОбИнвестировании.Вставить("СтоимЧистАктивовНаКонецОтчПериода", 0);
		КонецЕсли;
		
		// Проверяем итоги с начала года
		РасчетнаяСЧА = СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивов_НачалоГода 
								+ СтрокаДанныхОтчетаОбИнвестировании.ПоступлениеАктивов_СНачалаГода 
								+ СтрокаДанныхОтчетаОбИнвестировании.ФинРезультат_СНачалаГода 
								- СтрокаДанныхОтчетаОбИнвестировании.ИзъятиеАктивов_СНачалаГода 
								- СтрокаДанныхОтчетаОбИнвестировании.НеобходимыеРасходыУК_СНачалаГода
								- ВознаграждениеУК_СНачалаГода;
								
		СтоимЧистАктивовНаКонецОтчПериода = СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивовНаКонецОтчПериода;
		ПроверкаСЧАВыполнена = РасчетнаяСЧА = СтоимЧистАктивовНаКонецОтчПериода;
		
		СтрокаДанныхОтчетаОбИнвестировании.Вставить("ВознаграждениеУК", ВознаграждениеУК);
		СтрокаДанныхОтчетаОбИнвестировании.Вставить("ВознаграждениеУК_СНачалаГода", ВознаграждениеУК_СНачалаГода);
				
		Если Не ПроверкаСЧАВыполнена Тогда			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Зарегистрированная СЧА на конец периода (" + Формат(СтоимЧистАктивовНаКонецОтчПериода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") отличается от СЧА (" + Формат(РасчетнаяСЧА, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + "), рассчитанной по формуле 
			|<СЧА на начало года> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивов_НачалоГода,"ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|+ <Вводы активов с начала года> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.ПоступлениеАктивов_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|– <Выводы активов с начала года> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.ИзъятиеАктивов_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") 
			|+ <Доход от инвестирования по бух. учету с начала года> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.ФинРезультат_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|- <Необходимые расходы УК с начала года> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.НеобходимыеРасходыУК_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
			|- <Вознаграждение УК с начала года> (" + Формат(ВознаграждениеУК_СНачалаГода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")");
			СтрокаДанныхОтчетаОбИнвестировании.Вставить("СтоимЧистАктивовНаКонецОтчПериода", СтоимЧистАктивовНаКонецОтчПериода);
		КонецЕсли;  		
		
		// Проверяем итоги за отчетный квартал; если это первый квартал, не проверяем (итоги совпадают с итогами с начала года)		
		Если ЭтотОбъект.Период.ДатаНачала <> НачалоГода(ЭтотОбъект.Период.ДатаНачала) Тогда
			ПроверкаСЧАВыполнена = Истина;
			
			РасчетнаяСЧА = СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивов 
									+ СтрокаДанныхОтчетаОбИнвестировании.ПоступлениеАктивов 
									+ СтрокаДанныхОтчетаОбИнвестировании.ФинРезультат 
									- СтрокаДанныхОтчетаОбИнвестировании.ИзъятиеАктивов 
									- СтрокаДанныхОтчетаОбИнвестировании.НеобходимыеРасходыУК
									- ВознаграждениеУК;
			ПроверкаСЧАВыполнена = РасчетнаяСЧА = СтоимЧистАктивовНаКонецОтчПериода;
							
			Если Не ПроверкаСЧАВыполнена Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Зарегистрированная СЧА на конец периода (" + Формат(СтоимЧистАктивовНаКонецОтчПериода, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") отличается от СЧА (" + Формат(РасчетнаяСЧА, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + "), рассчитанной по формуле 
				|<СЧА на начало периода> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.СтоимЧистАктивов,"ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
				|+ <Вводы активов> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.ПоступлениеАктивов, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
				|– <Выводы активов> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.ИзъятиеАктивов, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ") 
				|+ <Доход от инвестирования по бух. учету> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.ФинРезультат, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
				|- <Необходимые расходы УК> (" + Формат(СтрокаДанныхОтчетаОбИнвестировании.НеобходимыеРасходыУК, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")
				|- <Вознаграждение УК> (" + Формат(ВознаграждениеУК, "ЧДЦ=2; ЧН=0; ЧГ=3,0") + ")");
				СтрокаДанныхОтчетаОбИнвестировании.Вставить("СтоимЧистАктивовНаКонецОтчПериода", СтоимЧистАктивовНаКонецОтчПериода);
			КонецЕсли; 		
		КонецЕсли;	
			
	КонецЕсли;
							
	ПакетТаблица.Вставить("Таб_Отчет", ДанныеОтчетаОбИнвестировании);
		
	ПакетДанных.Отчет.Вставить("Раздел1_ИнвестированиеСредствПенсионныхНакоплений", ПакетТаблица);
	
	ПодписьРуководителяУКНПФ = Новый Структура;
	ПодписьРуководителяУКНПФ.Вставить("ФИО"	, ?(ЭтотОбъект.УказатьРуководителя, Лев(СокрЛП(ЭтотОбъект.Руководитель_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Руководитель_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Руководитель_Фамилия), Лев(СокрЛП(ЭтотОбъект.Исполнитель_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Исполнитель_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Исполнитель_Фамилия)));
	
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяУКНПФ", ПодписьРуководителяУКНПФ);
	
	ПодписьУполномоченногоЛица = Новый Структура;
	ПодписьУполномоченногоЛица.Вставить("ФИО2"	, Лев(СокрЛП(ЭтотОбъект.Контролер_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Контролер_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Контролер_Фамилия));
	
	ПакетДанных.Отчет.Вставить("ПодписьУполномоченногоЛица", ПодписьУполномоченногоЛица);
	
	Возврат ПакетДанных;
	
КонецФункции
	
Функция ПолучитьДанные_ИнвестированиеСредствПенсионныхНакоплений_МассивСтрок(Запрос)
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц,, "_ДанныеКалендаря");
	Запрос.Текст = ПолучитьТекстЗапроса_ИнвестированиеСредствПенсионныхНакоплений();
	
	Пакет	= Запрос.ВыполнитьПакет();
	
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат").ПолучитьДанные().Выгрузить();
	
	ФорматныеСтроки = Новый Структура;
			
	Возврат СформироватьМассивСтрок(Данные, ФорматныеСтроки, "", , , Ложь);
	
КонецФункции

Процедура ЗаполнитьПечатнуюФорму_ИнвестированиеСредствПенсионныхНакоплений(Знач ПакетДанных, Результат, ЕдиницаИзмерения = "Тысячи") Экспорт
	
	ПакетОтчет = Новый Структура;
	
	Для Каждого ЭлементСтруктуры Из ПакетДанных.Отчет Цикл
		Если ЭлементСтруктуры.Ключ = "Раздел1_ИнвестированиеСредствПенсионныхНакоплений" Тогда
			ПакетОтчет.Вставить(ЭлементСтруктуры.Ключ, Новый Структура);
		Иначе	
			ПакетОтчет.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;	                                                              		
	КонецЦикла;
	
	Для Каждого ЭлементСтруктуры Из ПакетДанных.Отчет.Раздел1_ИнвестированиеСредствПенсионныхНакоплений Цикл
		ТекЗначение = ?(ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Массив"), ПереопределитьМассив(ЭлементСтруктуры.Значение), ЭлементСтруктуры.Значение);
		ПакетОтчет.Раздел1_ИнвестированиеСредствПенсионныхНакоплений.Вставить(ЭлементСтруктуры.Ключ, ТекЗначение);
	КонецЦикла;
			
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Результат.Автомасштаб = Истина;
	
	Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
	
	ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
		
	ОбластьШапка.Параметры.Период		= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	ФорматныеСтроки = ПолучитьСтруктуруФорматныхСтрок("ИнвестированиеСредствПенсионныхНакоплений", ЕдиницаИзмерения);
	
 	ВывестиРаздел(,, "Раздел1_ИнвестированиеСредствПенсионныхНакоплений.Таб_Отчет", ПакетОтчет, Макет, Результат, ФорматныеСтроки);

	ОбластьПодвал						   		 = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ФИОРуководителя      = ПакетОтчет.ПодписьРуководителяУКНПФ.ФИО; 	
	ОбластьПодвал.Параметры.ФИОУполномоченногоСД = ПакетОтчет.ПодписьУполномоченногоЛица.ФИО2;
	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

