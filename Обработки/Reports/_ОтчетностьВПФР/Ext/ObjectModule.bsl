		|	ВТ_Данные.ПолноеНаименНПФ КАК ID_NPFTaxis
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные";
	    				
#КонецОбласти

	Возврат ТекстЗапроса;
	
КонецФункции	

Процедура ЗаполнитьПечатнуюФорму_РасчетДопустимогоРазмераНеобходимыхРасходов(ПакетДанных, Результат, ЕдиницаИзмерения = "Тысячи") Экспорт
	
	ПакетОтчет = ПакетДанных.Отчет;
		
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Результат.Автомасштаб = Истина;
	
	Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
	
	ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
	
	ОбластьШапка.Параметры.Заполнить(ПакетОтчет.Раздел1_РасчетДопустимогоРазмераНеобходимыхРасходов.СтруктураШапкиИПодвала);
	ОбластьШапка.Параметры.Период		= Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	ВывестиРаздел(,, "Раздел1_РасчетДопустимогоРазмераНеобходимыхРасходов.Таб_Отчет", ПакетОтчет, Макет, Результат);

	ОбластьПодвал						   		 = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.Заполнить(ПакетОтчет.Раздел1_РасчетДопустимогоРазмераНеобходимыхРасходов.СтруктураШапкиИПодвала);
	//ОбластьПодвал.Параметры.ФИОРуководителя      = ПакетОтчет.ПодписьРуководителяУКНПФ.ФИО; 	
	//ОбластьПодвал.Параметры.ФИОУполномоченногоСД = ПакетОтчет.ПодписьУполномоченногоЛица.ФИО2;
	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

#КонецОбласти


#Область Дополнительные_процедуры_и_функции

Процедура ПолучитьФорматированныеДанныеДляПечати(ВариантОтчета, СтруктураДанных, ЕдиницаИзмерения) Экспорт
	
	ФорматныеСтроки = ПолучитьСтруктуруФорматныхСтрок(ВариантОтчета, ЕдиницаИзмерения, Истина);
	Для Каждого КлючИЗначение Из СтруктураДанных Цикл                                                                               		
		СтруктураДанных.Вставить(КлючИЗначение.Ключ, СериализоватьЗначение(СтруктураДанных, КлючИЗначение.Ключ, ФорматныеСтроки));
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтруктуруФорматныхСтрок(ВариантОтчета, ЕдиницаИзмерения, ДляВыгрузки = Ложь)
	
	Если ЕдиницаИзмерения = "Тысячи" Тогда
		ФорматЧисла = ?(ДляВыгрузки, "ЧДЦ=5; ЧС=3; ЧРД=.; ЧН=; ЧГ=0", "ЧДЦ=5; ЧС=3; ЧРД=,; ЧН=; ЧГ=3,0");
	Иначе
		ФорматЧисла = ?(ДляВыгрузки, "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ=0", "ЧДЦ=2; ЧРД=,; ЧН=; ЧГ=3,0");
	КонецЕсли;
	
	ФорматДаты = ?(ДляВыгрузки, "ДФ=yyyy-MM-dd", "ДФ=dd.MM.yyyy");
	
	ФорматныеСтроки = Новый Структура;
	
	Если ВариантОтчета = "ИнвестированиеСредствПенсионныхНакоплений" Тогда
			
		ФорматныеСтроки.Вставить("ПоступлениеАктивов",					ФорматЧисла);
		ФорматныеСтроки.Вставить("ПоступлениеАктивов_СНачалаГода",		ФорматЧисла);
		ФорматныеСтроки.Вставить("ИзъятиеАктивов", 						ФорматЧисла);
		ФорматныеСтроки.Вставить("ИзъятиеАктивов_СНачалаГода", 			ФорматЧисла);
		ФорматныеСтроки.Вставить("СтоимЧистАктивов", 					ФорматЧисла);
		ФорматныеСтроки.Вставить("СтоимЧистАктивов_НачалоГода", 		ФорматЧисла);
		ФорматныеСтроки.Вставить("СтоимЧистАктивовНаКонецОтчПериода", 	ФорматЧисла);
		ФорматныеСтроки.Вставить("НеобходимыеРасходыУК", 				ФорматЧисла);
		ФорматныеСтроки.Вставить("НеобходимыеРасходыУК_СНачалаГода", 	ФорматЧисла);
		ФорматныеСтроки.Вставить("ВознаграждениеУК", 					ФорматЧисла);
		ФорматныеСтроки.Вставить("ВознаграждениеУК_СНачалаГода", 		ФорматЧисла);
		ФорматныеСтроки.Вставить("ФинРезультат", 						ФорматЧисла);
		ФорматныеСтроки.Вставить("ФинРезультат_СНачалаГода", 			ФорматЧисла);
		ФорматныеСтроки.Вставить("Квартал",					 			"ЧГ=0");
		ФорматныеСтроки.Вставить("Год",						 			"ЧГ=0");   
		ФорматныеСтроки.Вставить("ДатаЗаключДоговора",					ФорматДаты);
		
	ИначеЕсли ВариантОтчета = "ДоходыОтИнвестированияСредствПенсионныхНакоплений" Тогда
		
		ФорматЧислаПроцент = ?(ДляВыгрузки, "ЧДЦ=5; ЧРД=.; ЧН=; ЧГ=0", "ЧДЦ=5; ЧРД=,; ЧН=; ЧГ=0");
		
		ФорматныеСтроки.Вставить("Январь",												ФорматЧисла);
		ФорматныеСтроки.Вставить("Февраль",												ФорматЧисла);
		ФорматныеСтроки.Вставить("Март", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Апрель", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Май", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Июнь", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Июль", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Август", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Сентябрь", 											ФорматЧисла);
		ФорматныеСтроки.Вставить("Октябрь", 											ФорматЧисла);
		ФорматныеСтроки.Вставить("Ноябрь", 												ФорматЧисла);
		ФорматныеСтроки.Вставить("Декабрь", 											ФорматЧисла);
		
		ФорматныеСтроки.Вставить("Квартал",					 							"ЧДЦ=; ЧГ=0");
		ФорматныеСтроки.Вставить("Год",						 							"ЧДЦ=; ЧГ=0"); 
		ФорматныеСтроки.Вставить("ДатаЗаключДоговора",									ФорматДаты);

		ФорматныеСтроки.Вставить("ДоходОтИнвестирования",								ФорматЧисла);
		ФорматныеСтроки.Вставить("ДоходОтИнвестирования_СНачалаГода", 					ФорматЧисла);
		ФорматныеСтроки.Вставить("ФинансовыйРезультатОтРеализации", 					ФорматЧисла);
		ФорматныеСтроки.Вставить("ФинансовыйРезультатОтРеализации_СНачалаГода", 		ФорматЧисла);
		ФорматныеСтроки.Вставить("ДивидендыИПроцентыПоЦБ", 								ФорматЧисла);
		ФорматныеСтроки.Вставить("ДивидендыИПроцентыПоЦБ_СНачалаГода", 					ФорматЧисла);
		ФорматныеСтроки.Вставить("ПроцентыПоДепозитам", 								ФорматЧисла);
		ФорматныеСтроки.Вставить("ПроцентыПоДепозитам_СНачалаГода", 					ФорматЧисла);
		ФорматныеСтроки.Вставить("ФинансовыйРезультатОтПереоценкиАктивов", 				ФорматЧисла);
		ФорматныеСтроки.Вставить("ФинансовыйРезультатОтПереоценкиАктивов_СНачалаГода",	ФорматЧисла);
		ФорматныеСтроки.Вставить("ДругиеВидыДоходов", 									ФорматЧисла);
		ФорматныеСтроки.Вставить("ДругиеВидыДоходов_СНачалаГода", 						ФорматЧисла);
