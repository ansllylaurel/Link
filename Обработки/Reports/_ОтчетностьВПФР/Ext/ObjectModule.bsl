		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	&Контролер КАК UpolnLiczoSpecDepFIO,
		|	ВТ_Данные.ПолноеНаименНПФ КАК ID_NPFTaxis
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные";
	    				
#КонецОбласти

	Возврат ТекстЗапроса;
	
КонецФункции	

#КонецОбласти

// Отчет о доходах от инвестирования средств пенсионных накоплений
#Область Доходы_от_инвестирования_средств_пенсионных_накоплений

Процедура ПодготовитьДанныеДляЗапроса(Запрос, ЕдиницаИзмерения, ПроцентыПоДепозитамИзСЧА = Неопределено, ПроцентыПоДепозитамИзСЧА_СНачалаГода = Неопределено)
	
	ИспользоватьДанныеБэкОфиса = ЭтотОбъект.Период.ДатаНачала >= '20190101';
	
	// Сумму начисленных процентов по депозитам получим как разницу между данными СЧА на конец и начало периода
	Если ПроцентыПоДепозитамИзСЧА = Неопределено И ИспользоватьДанныеБэкОфиса И ЭтотОбъект.Период.ДатаОкончания < '20250101' Тогда
		ПроцентыПоДепозитамИзСЧА = ПолучитьПроцентыПоДепозитуИзСЧА(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
		ПроцентыПоДепозитамИзСЧА_СНачалаГода = ПолучитьПроцентыПоДепозитуИзСЧА(ЭтотОбъект.СчетДоверительногоУправления, НачалоГода(ЭтотОбъект.Период.ДатаНачала), ЭтотОбъект.Период.ДатаОкончания);
	КонецЕсли;
	
	ПакетОтчетность = Новый Структура;
		
	ГруппыДоходовИРасходов = ПолучитьСоставГруппДоходовИРасходов(ИспользоватьДанныеБэкОфиса);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаНачала"								, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаНачалаГода"							, ?(Год(ЭтотОбъект.Период.ДатаНачала) <> Год(ЭтотОбъект.Период.ДатаОкончания), ЭтотОбъект.Период.ДатаНачала, НачалоГода(ЭтотОбъект.Период.ДатаНачала)));
	Запрос.УстановитьПараметр("ДатаОкончания"							, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"								, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"			, ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидПоказателя"   						, Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	
	Запрос.УстановитьПараметр("ФинансовыйРезультатОтРеализации"			, ГруппыДоходовИРасходов.ФинансовыйРезультатОтРеализации);
	Запрос.УстановитьПараметр("ДивидендыИПроцентыПоЦБ"					, ГруппыДоходовИРасходов.ДивидендыИПроцентыПоЦБ);
	Запрос.УстановитьПараметр("ПроцентыПоДепозитам"						, ГруппыДоходовИРасходов.ПроцентыПоДепозитам);
	Запрос.УстановитьПараметр("ФинансовыйРезультатОтПереоценкиАктивов"	, ГруппыДоходовИРасходов.ФинансовыйРезультатОтПереоценкиАктивов);
	Запрос.УстановитьПараметр("ДругиеВидыДоходов"						, ГруппыДоходовИРасходов.ДругиеВидыДоходов);
	Запрос.УстановитьПараметр("ОплатаУслугСпецДепозитария"				, ГруппыДоходовИРасходов.ОплатаУслугСпецДепозитария);
	Запрос.УстановитьПараметр("ОплатаУслугПрофУчастниковРынкаЦБ"		, ГруппыДоходовИРасходов.ОплатаУслугПрофУчастниковРынкаЦБ);
	Запрос.УстановитьПараметр("ОплатаУслугАудитора"						, ГруппыДоходовИРасходов.ОплатаУслугАудитора);
	Запрос.УстановитьПараметр("ВознаграждениеУправляющейКомпании"		, ГруппыДоходовИРасходов.ВознаграждениеУправляющейКомпании);
	Запрос.УстановитьПараметр("РасходыНаОбязательноеСтрахование"		, ГруппыДоходовИРасходов.РасходыНаОбязательноеСтрахование);
	Запрос.УстановитьПараметр("ОплатаПрочихУслуг"						, ГруппыДоходовИРасходов.ОплатаПрочихУслуг);
	Запрос.УстановитьПараметр("ИсключенныеДоходыИРасходы"				, ГруппыДоходовИРасходов.ИсключенныеДоходыИРасходы);
	
	Запрос.УстановитьПараметр("СтавкаВознаграждения"					, ЭтотОбъект.СтавкаВознагражденияУК);
	Запрос.УстановитьПараметр("СтавкаСпецдепозитария"					, ЭтотОбъект.СтавкаУслугСпецдепозитария);		
	Запрос.УстановитьПараметр("Руководитель"							, "");
	Запрос.УстановитьПараметр("Контролер"								, "");
	Запрос.УстановитьПараметр("Тыс"										, ?(ЕдиницаИзмерения = "Тысячи", "Тыс. ", ""));
	Запрос.УстановитьПараметр("ИспользоватьДанныеБэкОфиса"				, ИспользоватьДанныеБэкОфиса);
	Запрос.УстановитьПараметр("ПроцентыПоДепозитамИзСЧА"				, ?(ПроцентыПоДепозитамИзСЧА = Неопределено, 0, ПроцентыПоДепозитамИзСЧА));
	Запрос.УстановитьПараметр("ПроцентыПоДепозитамИзСЧА_СНачалаГода"	, ?(ПроцентыПоДепозитамИзСЧА_СНачалаГода = Неопределено, 0, ПроцентыПоДепозитамИзСЧА_СНачалаГода));
	Запрос.УстановитьПараметр("КонецПредыдущегоКвартала"				, КонецКвартала(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -3)));
	Запрос.УстановитьПараметр("КонецПредыдущегоГода"				    , КонецГода(ДобавитьМесяц(ЭтотОбъект.Период.ДатаОкончания, -12)));
	
	МассивВидовОперацийВводаАктивов = Новый Массив;
	МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР);
	МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление);
	
	Запрос.УстановитьПараметр("ВидыОперацийВводаАктивов", МассивВидовОперацийВводаАктивов); 
	
	МассивВидовОперацийВыводаАктивов = Новый Массив;
	МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению);
	МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР);
	
	Запрос.УстановитьПараметр("ВидыОперацийВыводаАктивов", МассивВидовОперацийВыводаАктивов); 
	
	Справочники.Календари.ПоместитьВЗапросДанныеКалендаря(
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ДатаОтчетности,
		Справочники.Календари.Общероссийский,
		Неопределено,
		НачалоГода(ЭтотОбъект.Период.ДатаНачала),
		ЭтотОбъект.Период.ДатаОкончания,
		Запрос.МенеджерВременныхТаблиц,
		"_ДанныеКалендаря",
		Истина);

КонецПроцедуры

Функция ПолучитьДанные_ДоходыОтИнвестированияСредствПенсионныхНакоплений(ЕдиницаИзмерения = "Тысячи", ПроцентыПоДепозитамИзСЧА = Неопределено, ПроцентыПоДепозитамИзСЧА_СНачалаГода = Неопределено) Экспорт
	
	ПакетДанных = Новый Структура;     
	ПакетДанных.Вставить("ИмяОтчета"			, "ДоходыОтИнвестированияСредствПенсионныхНакоплений");
	ПакетДанных.Вставить("Отчет"				, Новый Структура);
	
	Запрос = Новый Запрос;
	ПодготовитьДанныеДляЗапроса(Запрос, ЕдиницаИзмерения, ПроцентыПоДепозитамИзСЧА, ПроцентыПоДепозитамИзСЧА_СНачалаГода);
	
	ПакетТаблица = Новый Структура;

	ПакетТаблица.Вставить("Таб_Отчет", ПолучитьДанные_ДоходыОтИнвестированияСредствПенсионныхНакоплений_МассивСтрок(Запрос));
		
	ПакетДанных.Отчет.Вставить("Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений", ПакетТаблица);
	
	ПодписьРуководителяУКНПФ = Новый Структура;
	ПодписьРуководителяУКНПФ.Вставить("ФИО"	, ?(ЭтотОбъект.УказатьРуководителя, Лев(СокрЛП(ЭтотОбъект.Руководитель_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Руководитель_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Руководитель_Фамилия), Лев(СокрЛП(ЭтотОбъект.Исполнитель_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Исполнитель_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Исполнитель_Фамилия)));
	
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяУКНПФ", ПодписьРуководителяУКНПФ);
	
	ПодписьУполномоченногоЛица = Новый Структура;
	ПодписьУполномоченногоЛица.Вставить("ФИО2"	, Лев(СокрЛП(ЭтотОбъект.Контролер_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Контролер_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Контролер_Фамилия));
	
	ПакетДанных.Отчет.Вставить("ПодписьУполномоченногоЛица", ПодписьУполномоченногоЛица);
	
	Возврат ПакетДанных;
	
КонецФункции
	
Функция ПолучитьДанные_ДоходыОтИнвестированияСредствПенсионныхНакоплений_МассивСтрок(Запрос)	
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц,, "_ДанныеКалендаря");
	Запрос.Текст = ПолучитьТекстЗапроса_ДоходыОтИнвестированияСредствПенсионныхНакоплений();
	
	МассивДанных = Новый Массив;
	
	ФорматныеСтроки = Новый Структура;
			
	Пакет	= Запрос.ВыполнитьПакет();
	//Данные	= Пакет[16].Выгрузить(); 
	
	// данные по месяцам
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_ДанныеПоМесяцам").ПолучитьДанные().Выгрузить();
	
	МассивДанных = СформироватьМассивСтрок(Данные, ФорматныеСтроки, "", , , Ложь);
		
	//Данные = Пакет[18].Выгрузить();
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_ДоходыРасходы").ПолучитьДанные().Выгрузить();
	
	Для Каждого СтрокаДанных Из Данные Цикл  		
		МассивДанных[0].Вставить(СтрокаДанных.Показатель, СтрокаДанных.Сумма);
	КонецЦикла;

	//Данные = Пакет[19].Выгрузить();
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_Реквизиты").ПолучитьДанные().Выгрузить();
	
	ФорматныеСтроки = Новый Структура;
	МассивСтрок = СформироватьМассивСтрок(Данные, ФорматныеСтроки, "", , , Ложь);
	Для Каждого СтрокаДанных Из МассивСтрок[0] Цикл  		
		МассивДанных[0].Вставить(СтрокаДанных.Ключ, СтрокаДанных.Значение);
	КонецЦикла;
	
	//Данные = Пакет[20].Выгрузить();
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_ВводАктивов").ПолучитьДанные().Выгрузить();
	Если Данные.Количество() > 0 Тогда
	    СтрокаДанных = Данные[0];
		МассивДанных[0].Вставить("СуммаВводаАктивов", Данные[0].СуммаВводаАктивов);	
	КонецЕсли;
	
	//Данные = Пакет[17].Выгрузить();
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_СЧА").ПолучитьДанные().Выгрузить();
	
	ДополнитьСтруктуруОтсутствующимиСвойствами(МассивДанных[0]);
	
	СредняяСЧА 							= 0;
	СредняяСЧАЗаВычетомВводовВыводов 	= 0;
	Если Данные.Количество() > 0 Тогда
		СтрокаДанных = Данные[0];		
		СредняяСЧА = Окр(СтрокаДанных.СЧА / СтрокаДанных.Количество, 2, 1); 	
		СредняяСЧАЗаВычетомВводовВыводов = Окр(СтрокаДанных.СЧАБезУчетаВновьПоступившихСредств / СтрокаДанных.Количество, 2, 1); 	
	КонецЕсли;	
	
	// Учтем среднюю СЧА в предельных суммах вознаграждения УК и расходов на спецдеп
	МассивДанных[0].Вставить("СуммаВознаграждения", 	МассивДанных[0].СуммаВознаграждения + Окр(СредняяСЧАЗаВычетомВводовВыводов * ЭтотОбъект.СтавкаВознагражденияУК / 100, 2, 1));
	МассивДанных[0].Вставить("СуммаРасходовНаСпецдеп",	МассивДанных[0].СуммаРасходовНаСпецдеп + Окр(СредняяСЧАЗаВычетомВводовВыводов * ЭтотОбъект.СтавкаУслугСпецдепозитария / 100, 2, 1));
	
	МассивДанных[0].Вставить("СредняяСЧАЗаВычетомВводовВыводов", СредняяСЧАЗаВычетомВводовВыводов);
	
	РазницаПоРасходамУК						= 0;
	РазницаПоРасходамСпецдепа				= 0;
	ДоходОтИнвестированияВПроцентахОтСЧА    = 0;
	ВознаграждениеУКВПроцентахОтДохода		= 0;
	ВознаграждениеУКВПроцентахКОтСЧА        = 0;
	
	РазницаПоРасходамУК = МассивДанных[0].СуммаВознаграждения - МассивДанных[0].РасходыВсего_СНачалаГода;
	РазницаПоРасходамСпецдепа = МассивДанных[0].СуммаРасходовНаСпецдеп - МассивДанных[0].ОплатаУслугСпецДепозитария_СНачалаГода;
	ДоходОтИнвестированияВПроцентахОтСЧА = ?(СредняяСЧА = 0, 0, Окр(МассивДанных[0].ДоходОтИнвестирования_СНачалаГода / СредняяСЧА * 100, 2, 1));
	
	Если МассивДанных[0].Свойство("ВознаграждениеУправляющейКомпании_СНачалаГода") Тогда
		ВознаграждениеУКВПроцентахОтДохода = Окр(МассивДанных[0].ВознаграждениеУправляющейКомпании_СНачалаГода / МассивДанных[0].ДоходОтИнвестирования_СНачалаГода * 100, 2, 1);
		ВознаграждениеУКВПроцентахКОтСЧА = ?(СредняяСЧА = 0, 0, Окр(МассивДанных[0].ВознаграждениеУправляющейКомпании_СНачалаГода  / СредняяСЧА * 100, 2, 1));
	КонецЕсли;	
		
	МассивДанных[0].Вставить("РазницаПоРасходамУК", 					РазницаПоРасходамУК);
	МассивДанных[0].Вставить("РазницаПоРасходамСпецдепа", 				РазницаПоРасходамСпецдепа);
	МассивДанных[0].Вставить("ДоходОтИнвестированияВПроцентахОтСЧА",	ДоходОтИнвестированияВПроцентахОтСЧА);
	МассивДанных[0].Вставить("ВознаграждениеУКВПроцентахОтДохода", 		ВознаграждениеУКВПроцентахОтДохода);
	МассивДанных[0].Вставить("ВознаграждениеУКВПроцентахКОтСЧА", 		ВознаграждениеУКВПроцентахКОтСЧА);
				
	Возврат МассивДанных; 
	
