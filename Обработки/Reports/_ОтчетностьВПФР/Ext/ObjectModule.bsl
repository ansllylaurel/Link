		|		ПО _ВознаграждениеОтВводовПоДатам.Дата = _РасходыНаСпецдепОтВводовПоДатам.Дата
		|ГДЕ
		|	ЕСТЬNULL(_РасходыНаСпецдепОтВводовПоДатам.СуммаРасходовНаСпецдеп, 0) + ЕСТЬNULL(_РасходыНаСпецдепОтВводовПоДатам.СуммаРасходовНаСпецдеп, 0) <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(_ВознаграждениеОтВводовПоДатам.Дата, _РасходыНаСпецдепОтВводовПоДатам.Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(1) КАК Количество,
		|	СУММА(_СЧАПоДням.СЧА) КАК СЧА
		|ПОМЕСТИТЬ _КоличествоСтрок
		|ИЗ
		|	_СЧАПоДням КАК _СЧАПоДням
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СЧАПоДням.Дата КАК Дата,
		|	СУММА(ЕСТЬNULL(_ВводыПоДатамИтоговые.СуммаВводаАктивов, 0)) КАК СуммаВводаАктивов
		|ПОМЕСТИТЬ _ИтогиВводовПоДатам
		|ИЗ
		|	_ВводыПоДатам КАК _ВводыПоДатамИтоговые
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СЧАПоДням КАК _СЧАПоДням
		|		ПО _ВводыПоДатамИтоговые.Дата <= _СЧАПоДням.Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	_СЧАПоДням.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_СЧАПоДням.Дата, _ВводыПоДатам.Дата) КАК Дата,
		|	ЕСТЬNULL(_СЧАПоДням.СЧА, 0) КАК СЧА,
		|	ЕСТЬNULL(_ИтогиВводовПоДатам.СуммаВводаАктивов, 0) КАК СуммаВновьПоступившихСредств,
		|	ЕСТЬNULL(_СЧАПоДням.СЧА, 0) - ЕСТЬNULL(_ИтогиВводовПоДатам.СуммаВводаАктивов, 0) КАК СЧАБезУчетаВновьПоступившихСредств,
		|	ЕСТЬNULL(_ВводыПоДатам.СуммаВводаАктивов, 0) КАК ПоступлениеСредствВТечениеОтчетногоГода,
		|	РАЗНОСТЬДАТ(ЕСТЬNULL(_СЧАПоДням.Дата, _ВводыПоДатам.Дата), КОНЕЦПЕРИОДА(&ДатаОкончания, ГОД), ДЕНЬ) + 1 КАК КоличествоПолныхДнейВДУ,
		|	ЕСТЬNULL(_РасходыУК.СуммаВознаграждения, 0) КАК РазмерНеобходимыхРасходовУКПоНовымСредствам,
		|	ЕСТЬNULL(_РасходыУК.СуммаРасходовНаСпецдеп, 0) КАК ПредельныйРазмерВознагражденияСДПоНовымСредствам
		|ПОМЕСТИТЬ _ТаблицаСЧА
		|ИЗ
		|	_СЧАПоДням КАК _СЧАПоДням
		|		ПОЛНОЕ СОЕДИНЕНИЕ _РасходыУК КАК _РасходыУК
		|		ПО _СЧАПоДням.Дата = _РасходыУК.Дата
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ВводыПоДатам КАК _ВводыПоДатам
		|		ПО _СЧАПоДням.Дата = _ВводыПоДатам.Дата
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ИтогиВводовПоДатам КАК _ИтогиВводовПоДатам
		|		ПО _СЧАПоДням.Дата = _ИтогиВводовПоДатам.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(_ТаблицаСЧА.СЧА) КАК ИТОГО_СЧА,
		|	СУММА(_ТаблицаСЧА.СЧАБезУчетаВновьПоступившихСредств) КАК ИТОГО_СЧАБезУчетаВновьПоступившихСредств,
		|	СУММА(_ТаблицаСЧА.РазмерНеобходимыхРасходовУКПоНовымСредствам) КАК ИТОГО_РазмерНеобходимыхРасходовУКПоНовымСредствам,
		|	СУММА(_ТаблицаСЧА.ПредельныйРазмерВознагражденияСДПоНовымСредствам) КАК ИТОГО_ПредельныйРазмерВознагражденияСДПоНовымСредствам
		|ПОМЕСТИТЬ _Итоги
		|ИЗ
		|	_ТаблицаСЧА КАК _ТаблицаСЧА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаСЧА.Дата КАК Дата,
		|	_ТаблицаСЧА.СЧА КАК СЧА,
		|	_ТаблицаСЧА.СуммаВновьПоступившихСредств КАК СуммаВновьПоступившихСредств,
		|	_ТаблицаСЧА.СЧАБезУчетаВновьПоступившихСредств КАК СЧАБезУчетаВновьПоступившихСредств,
		|	_ТаблицаСЧА.ПоступлениеСредствВТечениеОтчетногоГода КАК ПоступлениеСредствВТечениеОтчетногоГода,
		|	_ТаблицаСЧА.КоличествоПолныхДнейВДУ КАК КоличествоПолныхДнейВДУ,
		|	_ТаблицаСЧА.РазмерНеобходимыхРасходовУКПоНовымСредствам КАК РазмерНеобходимыхРасходовУКПоНовымСредствам,
		|	_ТаблицаСЧА.ПредельныйРазмерВознагражденияСДПоНовымСредствам КАК ПредельныйРазмерВознагражденияСДПоНовымСредствам
		|ПОМЕСТИТЬ _Результат_ДанныеПоДням
		|ИЗ
		|	_ТаблицаСЧА КАК _ТаблицаСЧА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Данные.ПолнНаимУК КАК ПолнНаимУК,
		|	ВТ_Данные.ИНН_УК КАК ИНН_УК,
		|	ВТ_Данные.ИНН_УК + ""/"" + ВТ_Данные.КПП_УК КАК ПечИННКПП,
		|	ВТ_Данные.ПолноеНаименНПФ КАК ПолноеНаименНПФ,
		|	ВТ_Данные.ИНН_НПФ КАК ИНН_НПФ,
		|	&Тыс КАК Тыс,
		|	ВТ_Данные.НомерДоговораУправления КАК НомерДоговораУправления,
		|	ВТ_Данные.ДатаЗаключДоговора КАК ДатаЗаключДоговора,
		|	_Итоги.ИТОГО_СЧА КАК ИТОГО_СЧА,
		|	_Итоги.ИТОГО_СЧАБезУчетаВновьПоступившихСредств КАК ИТОГО_СЧАБезУчетаВновьПоступившихСредств,
		|	_Итоги.ИТОГО_РазмерНеобходимыхРасходовУКПоНовымСредствам КАК ИТОГО_РазмерНеобходимыхРасходовУКПоНовымСредствам,
		|	_Итоги.ИТОГО_ПредельныйРазмерВознагражденияСДПоНовымСредствам КАК ИТОГО_ПредельныйРазмерВознагражденияСДПоНовымСредствам,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_КоличествоСтрок.Количество, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(_Итоги.ИТОГО_СЧАБезУчетаВновьПоступившихСредств / _КоличествоСтрок.Количество КАК ЧИСЛО(19, 2))
		|	КОНЕЦ КАК СредняяСЧАБезУчетаВновьПоступившихСредств,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_КоличествоСтрок.Количество, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(_Итоги.ИТОГО_СЧА / _КоличествоСтрок.Количество КАК ЧИСЛО(19, 2))
		|	КОНЕЦ КАК СредняяСЧА,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_КоличествоСтрок.Количество, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(_Итоги.ИТОГО_СЧАБезУчетаВновьПоступившихСредств / _КоличествоСтрок.Количество * &СтавкаВознаграждения / 100 КАК ЧИСЛО(19, 2))
		|	КОНЕЦ КАК НеобходимыеРасходыВПроцентахОтСЧА,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(_КоличествоСтрок.Количество, 0) = 0
		|			ТОГДА 0
		|		ИНАЧЕ ВЫРАЗИТЬ(_Итоги.ИТОГО_СЧАБезУчетаВновьПоступившихСредств / _КоличествоСтрок.Количество * &СтавкаВознаграждения / 100 КАК ЧИСЛО(19, 2))
		|	КОНЕЦ + _Итоги.ИТОГО_РазмерНеобходимыхРасходовУКПоНовымСредствам КАК НеобходимыеРасходы
		|ПОМЕСТИТЬ _Результат_ШапкаИПодвал
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные,
		|	_Итоги КАК _Итоги,
		|	_КоличествоСтрок КАК _КоличествоСтрок
		|;
