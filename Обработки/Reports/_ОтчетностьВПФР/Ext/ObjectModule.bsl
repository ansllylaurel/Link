Функция СериализоватьЗначение(СтрокаДанных, Колонка, ФорматныеСтроки)
	
	ФорматнаяСтрока = "";
	Значение = СтрокаДанных[Колонка];
	
	Если Колонка = "Кол5_Таб1_1НомерФилиала" ИЛИ Колонка = "Кол5_Таб1_2НомерФилиала" Тогда
		Значение = ?(Найти(Значение, "/") > 0, Сред(Значение, Найти(Значение, "/") + 1), "0");
		
	ИначеЕсли Колонка = "Кол4_Таб1_1РегНомер" ИЛИ Колонка = "Кол4_Таб1_2РегНомер" Тогда
		Значение = ?(Найти(Значение, "/") > 0, Лев(Значение, Найти(Значение, "/") - 1), Значение);
	КонецЕсли;
	
	Если Значение = ЭтотОбъект.ПустоеЗначение Тогда
		Возврат Значение;
		
	ИначеЕсли Колонка = "Кол3_Таб34_2ОснованиеЗадолж" Тогда
		Если ТипЗнч(Значение) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания") Тогда
			Возврат "Соглашение о брокерском обслуживании №" + Значение.НомерДоговора + " от " + Формат(Значение.ДатаЗаключения, "ДФ=dd.MM.yy");
		ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Договоры") Тогда
			Если Значение.ВидДоговора = Перечисления.ВидыДоговоров.БрокерскогоОбслуживания Тогда
				Возврат "Соглашение о брокерском обслуживании №" + Значение.НомерДоговора + " от " + Формат(Значение.ДатаЗаключения, "ДФ=dd.MM.yy");
			Иначе
				Возврат "Договор " + Значение.НомерДоговора + " от " + Формат(Значение.ДатаЗаключения, "ДФ=dd.MM.yy");	
			КонецЕсли;
		Иначе
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли Колонка = "Кол65_Таб1_3НаименЭмитента" ИЛИ Колонка = "Кол95_Таб1_4НаименЭмитента" Тогда
		Если ТипЗнч(СтрокаДанных.ЦеннаяБумага) = Тип("СправочникСсылка.Паи") Тогда
			РеквизитыПая = РаботаСОтчетами.ПолучитьРеквизитыЦеннойБумаги(СтрокаДанных.ЦеннаяБумага, ЭтотОбъект.Период.ДатаОкончания);
			Возврат Значение + "(" + РеквизитыПая.ПолноеНаименованиеЭмитента + ")";
		Иначе
			Возврат Значение;
		КонецЕсли;
		
	ИначеЕсли Колонка = "Кол114_Таб2_1СрокПлатежа" ИЛИ Колонка = "Кол161_Таб2_3СрокПлатежа" Тогда
		Если СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.НаДату Тогда
			Возврат Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy");
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ПоПредъявлении Тогда
			Возврат "По предъявлении";
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ПоПредъявленииНоНеРанее Тогда
			Возврат "По предъявлении, но не ранее " + Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy");
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ПоПредъявленииНоНеПозднее Тогда
			Возврат "По предъявлении, но не ранее " + Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy") + ?(ЗначениеЗаполнено(СтрокаДанных.ПогаситьНеПозднее), " и не позднее " + Формат(СтрокаДанных.ПогаситьНеПозднее, "ДФ=dd.MM.yyyy"), "");
		ИначеЕсли СтрокаДанных.ВариантПогашения = Перечисления.ВариантыПогашенияВекселей.ЧерезNДнейОтДатыСоставления Тогда
			Если ЗначениеЗаполнено(СтрокаДанных.ПогаситьНеПозднее) Тогда
				Возврат "По предъявлении, но не ранее " + Формат(СтрокаДанных.ДнейДоПогашения, "ЧГ=0") + " дня и не позднее " + Формат(СтрокаДанных.ПогаситьНеПозднее, "ДФ=dd.MM.yyyy");
			Иначе
				Возврат "Через " + Формат(СтрокаДанных.ДнейДоПогашения, "ЧГ=0") + " дней от даты составления (" + Формат(СтрокаДанных.ДатаПогашения, "ДФ=dd.MM.yyyy") + ")";
			КонецЕсли;
		КонецЕсли;	
		
	ИначеЕсли Колонка = "Кол165_Таб2_3Основания" Тогда
		Возврат "Договор ДУ " + СтрокаДанных.НомерДоговораДУ;//  + " от " + Формат(СтрокаДанных.ДатаДоговораДУ, "ДФ=dd.MM.yyyy");
		
	ИначеЕсли Колонка = "Кол130_Таб2_1ОсновНахожВекселя" Тогда
		Если ЗначениеЗаполнено(СтрокаДанных.НомерДоговораДепозитарногоОбслуживания) Тогда
			Возврат "Депозитарный договор " + СтрокаДанных.НомерДоговораДепозитарногоОбслуживания + " от " + Формат(СтрокаДанных.ДатаДоговораДепозитарногоОбслуживания, "ДФ=dd.MM.yyyy");
		Иначе	
			Возврат ЭтотОбъект.ПустоеЗначение;
		КонецЕсли;
		
	ИначеЕсли ФорматныеСтроки.Свойство(Колонка, ФорматнаяСтрока) Тогда
		
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Если Найти(ФорматнаяСтрока, "ЧДЦ=0; ") > 0 Тогда
				Если Значение <> Цел(Значение) Тогда
					ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "ЧДЦ=0; ", "");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Формат(Значение, ФорматнаяСтрока);
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") И (Колонка = "Кол_ДатаЗаключДоговора") Тогда	
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") И (Колонка = "Кол_ДтаВремяСделки") Тогда	
		Результат = Формат(Значение, "ДЛФ=DT");
		Возврат СтрЗаменить(Результат, ":", "-");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧДЦ=5; ЧРД=,; ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy; ДП='" + ЭтотОбъект.ПустоеЗначение + "'");	
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ЭтотОбъект.ПустоеЗначение;
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.СтраныМира") Тогда
		Возврат Значение.КодАльфа3;
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция СформироватьМассивСтрок(Данные, ФорматныеСтроки = "", ПрефиксКолонки = "Кол", ИмяТаблицы = "", ЗаполнятьПустымиЗначениями = Истина, Сериализовать = Истина)
	
	МассивСтрок		= Новый Массив;
	МассивКолонок	= Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ФорматныеСтроки) Тогда
		ФорматныеСтроки = Новый Структура;
	КонецЕсли;
	
	Для Каждого Колонка Из Данные.Колонки Цикл
		Если Лев(Колонка.Имя, СтрДлина(ПрефиксКолонки)) = ПрефиксКолонки ИЛИ НЕ ЗначениеЗаполнено(ПрефиксКолонки) Тогда
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		ДанныеСтроки = Новый Структура;
		
		Для Каждого Колонка Из МассивКолонок Цикл
			ДанныеСтроки.Вставить(Колонка, ?(Сериализовать, СериализоватьЗначение(СтрокаДанных, Колонка, ФорматныеСтроки), СтрокаДанных[Колонка]));

			Если Найти(Колонка, "НомерСтроки") > 0
				ИЛИ Найти(Колонка, "НомСтроки") > 0
				ИЛИ Найти(Колонка, "НомерСтр") > 0
				ИЛИ Колонка = "Кол1_Таб3НомерГрафы"
				ИЛИ Колонка = "Кол1_Таб34_1НомерГрафы"
				ИЛИ Колонка = "Кол1_Таб1_2НомерГрафы" Тогда
				ДанныеСтроки.Вставить(Колонка, МассивСтрок.Количество() + 1);
			КонецЕсли;	
		КонецЦикла;
		
		МассивСтрок.Добавить(ДанныеСтроки);
		
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 И ЗаполнятьПустымиЗначениями Тогда
		МассивСтрок.Добавить("ЗаполнитьПустымиЗначениями");
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Процедура ВывестиРаздел(ИмяРаздела = "", ПутьКШапке = "", ПутьКСтроке, Пакет, Макет, Результат, ФорматныеСтроки = Неопределено, ПризнакОтформатированныхКолонок = "")
	
	Если ФорматныеСтроки = Неопределено Тогда
		ФорматныеСтроки = Новый Структура;
	КонецЕсли;
	
	МассивПутьКШапке	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКШапке	, ".");
	МассивПутьКСтроке	= РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКСтроке	, ".");
	
	ДанныеШапки = Пакет;
	ДанныеТЧ	= Пакет;
	
	Для Каждого ИмяДанныхШапки Из МассивПутьКШапке Цикл
		ДанныеШапки = ДанныеШапки[ИмяДанныхШапки];
	КонецЦикла;
	
	Для Каждого ИмяСтроки Из МассивПутьКСтроке Цикл
		ДанныеТЧ = ДанныеТЧ[ИмяСтроки]; 		
	КонецЦикла;
	
	Если ФорматныеСтроки.Количество() > 0 Тогда
		Для Каждого ЭлементМассива Из ДанныеТЧ Цикл
			Для Каждого ЭлементСтруктуры Из ЭлементМассива Цикл
				ЭлементМассива.Вставить(ЭлементСтруктуры.Ключ + ПризнакОтформатированныхКолонок, СериализоватьЗначение(ЭлементМассива, ЭлементСтруктуры.Ключ, ФорматныеСтроки)); 
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРаздела) Тогда
		ОбластьШапка	= Макет.ПолучитьОбласть(ИмяРаздела);
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДанныеШапки);
		Результат.Вывести(ОбластьШапка);	
	КонецЕсли;	
	
	ОбластьСтрока	= Макет.ПолучитьОбласть(ИмяСтроки);
	НомерСтроки = 1;
	Для Каждого СтрокаДанных Из ДанныеТЧ Цикл
		Если СтрокаДанных = "ЗаполнитьПустымиЗначениями" Тогда
			Для Индекс = 0 По ОбластьСтрока.Параметры.Количество() - 1 Цикл
				ОбластьСтрока.Параметры.Установить(Индекс, ЭтотОбъект.ПустоеЗначение);
			КонецЦикла;
		Иначе
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаДанных); 
			ОбластьСтрока.Параметры.Заполнить(Новый Структура("НомерСтроки", НомерСтроки));
			НомерСтроки = НомерСтроки + 1;
		КонецЕсли;
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНастройкиВидимостиРеквизитов() Экспорт
	
	НастройкиВидимостиРеквизитов = Новый Структура;
	
	МакетВидимостьРеквизитов = ПолучитьМакет("ВидимостьРеквизитов");
	
	Для НомерСтроки = 2 По МакетВидимостьРеквизитов.ВысотаТаблицы Цикл
		ИмяПакета = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		НастройкиВидимостиРеквизитов.Вставить(ИмяПакета, Новый Структура);
		
		Для НомерКолонки = 2 По МакетВидимостьРеквизитов.ШиринаТаблицы Цикл
			ИмяРеквизита	= СокрЛП(МакетВидимостьРеквизитов.Область(1, НомерКолонки, 1, НомерКолонки).Текст);
			Видимость		= (СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст) = "ДА");
			НастройкиВидимостиРеквизитов[ИмяПакета].Вставить(ИмяРеквизита, Видимость);
		КонецЦикла;
	КонецЦикла;
	
	Возврат НастройкиВидимостиРеквизитов;
	
КонецФункции

Функция ПолучитьСоставГруппДоходовИРасходов(ИспользоватьДанныеБэкОфиса)
	
	// Техдолг: сделать хранение в отдельном регистре или реквизите справочника и вынести в общий модуль, использовать в форме 512/513 Отчетности ЦБ
	СоставГруппДоходовИРасходов = Новый Структура("ФинансовыйРезультатОтРеализации, 
			|ДивидендыИПроцентыПоЦБ, 
			|ПроцентыПоДепозитам, 
			|ФинансовыйРезультатОтПереоценкиАктивов, 
			|ДругиеВидыДоходов, 
			|ОплатаУслугСпецДепозитария, 
			|ОплатаУслугПрофУчастниковРынкаЦБ, 
			|ОплатаУслугАудитора, 
			|РасходыНаОбязательноеСтрахование, 
			|ВознаграждениеУправляющейКомпании,
			|ИсключенныеДоходыИРасходы,
			|ОплатаПрочихУслуг", Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив,
			Новый Массив);
	
	МакетСписокДоходовРасходов = ПолучитьМакет("ГруппыДоходовИРасходов");
	
	ТаблицаДоходовРасходов = Новый	ТаблицаЗначений;
	
	КС = Новый КвалификаторыСтроки(150);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ОписаниеТиповСтрока = Новый ОписаниеТипов(МассивТипов, , , , КС);
	
	ТаблицаДоходовРасходов.Колонки.Добавить("Код", ОписаниеТиповСтрока);
	ТаблицаДоходовРасходов.Колонки.Добавить("ИмяПредопределенныхДанных", ОписаниеТиповСтрока);
	ТаблицаДоходовРасходов.Колонки.Добавить("ГруппаДоходовИРасходов", ОписаниеТиповСтрока);
	
	Для НомерСтроки = 2 По МакетСписокДоходовРасходов.ВысотаТаблицы Цикл
		
		ИмяПредопределенныхДанных 	= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 3, НомерСтроки, 3).Текст);
		Код 						= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);		
		ГруппаДоходовИРасходов 		= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 4, НомерСтроки, 4).Текст);
		Исключить 					= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 5, НомерСтроки, 5).Текст);
		ДатаОкончания 				= СокрЛП(МакетСписокДоходовРасходов.Область(НомерСтроки, 6, НомерСтроки, 6).Текст);
				
		Если ГруппаДоходовИРасходов = "" Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаОкончания = ?(ПустаяСтрока(ДатаОкончания), '39990101', Дата(ДатаОкончания)); 
		Если Исключить = "Да" И ИспользоватьДанныеБэкОфиса И ЭтотОбъект.Период.ДатаОкончания < ДатаОкончания Тогда
			ГруппаДоходовИРасходов = "ИсключенныеДоходыИРасходы";
		КонецЕсли;
		
		Если ИмяПредопределенныхДанных <> "" Тогда
			СоставГруппДоходовИРасходов[ГруппаДоходовИРасходов].Добавить(Справочники.ПрочиеДоходыИРасходы[ИмяПредопределенныхДанных]);
		Иначе	
			НоваяСтрока = ТаблицаДоходовРасходов.Добавить();		
			НоваяСтрока.Код 					= Код;
			НоваяСтрока.ГруппаДоходовИРасходов	= ГруппаДоходовИРасходов;
		КонецЕсли;
		
	КонецЦикла;
	
	// Определим ссылки на элементы справочника
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаДоходовРасходов.Код КАК Код,
	|	_ТаблицаДоходовРасходов.ГруппаДоходовИРасходов КАК ГруппаДоходовИРасходов
	|ПОМЕСТИТЬ _ТаблицаСтатей
	|ИЗ
	|	&ТаблицаДоходовРасходов КАК _ТаблицаДоходовРасходов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПрочиеДоходыИРасходы.Ссылка КАК Ссылка,
	|	_ТаблицаСтатей.ГруппаДоходовИРасходов КАК ГруппаДоходовИРасходов
	|ИЗ
	|	Справочник.ПрочиеДоходыИРасходы КАК ПрочиеДоходыИРасходы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаСтатей КАК _ТаблицаСтатей
	|		ПО ПрочиеДоходыИРасходы.Код = _ТаблицаСтатей.Код
	|ГДЕ
	|	НЕ ПрочиеДоходыИРасходы.Предопределенный
	|	И НЕ ПрочиеДоходыИРасходы.ЭтоГруппа
	|	И НЕ ПрочиеДоходыИРасходы.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ТаблицаДоходовРасходов", ТаблицаДоходовРасходов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоставГруппДоходовИРасходов[Выборка.ГруппаДоходовИРасходов].Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	ВозвратРасходовПрошлогоПериода = ОбщегоНазначения.ПолучитьИменованныйОбъект("ПДР_ВозвратРасхода"); 
	СоставГруппДоходовИРасходов["РасходыНаОбязательноеСтрахование"].Добавить(ВозвратРасходовПрошлогоПериода);

	Возврат СоставГруппДоходовИРасходов;
	
КонецФункции

Функция ПолучитьПроцентыПоДепозитуИзСЧА(СчетДоверительногоУправления, НачалоПериода, КонецПериода)
	
	СтоимостиДепозитныхВкладов_НачалоПериода = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
		СчетДоверительногоУправления,
		НачалоПериода-1,
		Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
		Ложь);
		
	СтоимостиДепозитныхВкладов_КонецПериода = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияДляРСА(
		СчетДоверительногоУправления,
		КонецДня(КонецПериода),
		Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,
		Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(СтоимостиДепозитныхВкладов_НачалоПериода.Проценты КАК ЧИСЛО(19, 2)) КАК Проценты,
	|	СтоимостиДепозитныхВкладов_НачалоПериода.КредитныйИнструмент КАК ДепозитныйВклад
	|ПОМЕСТИТЬ _ДепозитыНаНачалоПериода
	|ИЗ
	|	&СтоимостиДепозитныхВкладов_НачалоПериода КАК СтоимостиДепозитныхВкладов_НачалоПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(СтоимостиДепозитныхВкладов_КонецПериода.Проценты КАК ЧИСЛО(19, 2)) КАК Проценты,
	|	СтоимостиДепозитныхВкладов_КонецПериода.КредитныйИнструмент КАК ДепозитныйВклад
	|ПОМЕСТИТЬ _ДепозитыНаКонецПериода
	|ИЗ
	|	&СтоимостиДепозитныхВкладов_КонецПериода КАК СтоимостиДепозитныхВкладов_КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СУММА(ЕСТЬNULL(_ДепозитыНаКонецПериода.Проценты, 0) - ЕСТЬNULL(_ДепозитыНаНачалоПериода.Проценты, 0)), 0) КАК Проценты
	|ИЗ
	|	_ДепозитыНаКонецПериода КАК _ДепозитыНаКонецПериода
	|		ПОЛНОЕ СОЕДИНЕНИЕ _ДепозитыНаНачалоПериода КАК _ДепозитыНаНачалоПериода
	|		ПО _ДепозитыНаКонецПериода.ДепозитныйВклад = _ДепозитыНаНачалоПериода.ДепозитныйВклад";
	
	Запрос.УстановитьПараметр("СтоимостиДепозитныхВкладов_НачалоПериода",	СтоимостиДепозитныхВкладов_НачалоПериода);
	Запрос.УстановитьПараметр("СтоимостиДепозитныхВкладов_КонецПериода",	СтоимостиДепозитныхВкладов_КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Проценты;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПереопределитьМассив(ТекМассив)
	
	Результат = Новый Массив;
	Для Каждого ЭлементМассива Из ТекМассив Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда           			
			Результат.Добавить(ПереопределитьСтруктуру(ЭлементМассива));				
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

Функция ПереопределитьСтруктуру(Знач ТекСтруктура)
	
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из ТекСтруктура Цикл                 		
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Формирование_расшифровки

Функция ПолучитьВыборкуРасшифровкиЯчейки(ПолеРасшифровки, СНачалаГода = Ложь, ЕдиницаИзмерения) Экспорт
		
	Запрос = Новый Запрос;
	ПодготовитьДанныеДляЗапроса(Запрос, ЕдиницаИзмерения);
	ТекстЗапроса = ПолучитьТекстЗапроса_ДоходыОтИнвестированияСредствПенсионныхНакоплений();
		
	ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, ПолеРасшифровки, СНачалаГода);
			
	Запрос.Текст = ТекстЗапроса;
		
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ДополнитьТекстЗапросаТаблицейРасшифровки(ТекстЗапроса, ПолеРасшифровки, СНачалаГода) 
			
	Если ПолеРасшифровки = "011" Тогда 
		// Финансовый результат от реализации 				
		ТекстЗапроса = ТекстЗапроса + "; 
			|";
		
		#Область Текст_запроса
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_РасходыОбщие.Сумма КАК Сумма,
			|	_РасходыОбщие.ЭтоДоход КАК ЭтоДоход,
			|	_РасходыОбщие.КорСубконто1 КАК КорСубконто1,
			|	_РасходыОбщие.КорСубконто2 КАК КорСубконто2,
			|	_РасходыОбщие.Субконто2 КАК ЦеннаяБумага,
			|	_РасходыОбщие.Регистратор КАК Регистратор,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(_РасходыОбщие.Регистратор) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
			|			ТОГДА ВЫРАЗИТЬ(_РасходыОбщие.Регистратор КАК Документ.ИсполнениеОбязательствПоСделке).Основание
			|		КОГДА ТИПЗНАЧЕНИЯ(_РасходыОбщие.Регистратор) = ТИП(Документ.СписаниеЦеннойБумаги)
			|			ТОГДА ВЫРАЗИТЬ(_РасходыОбщие.Регистратор КАК Документ.СписаниеЦеннойБумаги).ПогашениеЦеннойБумаги
			|		ИНАЧЕ _РасходыОбщие.Регистратор
			|	КОНЕЦ КАК Сделка
			|ПОМЕСТИТЬ _Расшифровка_Развернуто
			|ИЗ
			|	_РасходыОбщие КАК _РасходыОбщие
			|ГДЕ
			|	_РасходыОбщие.Показатель = &СтрокаПоказателя
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СУММА(ВЫБОР
			|			КОГДА _Расшифровка_Развернуто.ЭтоДоход
			|				ТОГДА _Расшифровка_Развернуто.Сумма
			|			ИНАЧЕ -_Расшифровка_Развернуто.Сумма
			|		КОНЕЦ) КАК Сумма,
			|	_Расшифровка_Развернуто.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_Расшифровка_Развернуто.Сделка КАК Сделка
			|ПОМЕСТИТЬ _Расшифровка
			|ИЗ
			|	_Расшифровка_Развернуто КАК _Расшифровка_Развернуто
			|ГДЕ
			|	_Расшифровка_Развернуто.Сумма <> 0
			|
			|СГРУППИРОВАТЬ ПО
			|	_Расшифровка_Развернуто.ЦеннаяБумага,
			|	_Расшифровка_Развернуто.Сделка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Расшифровка.Сумма КАК ФинансовыйРезультат,
			|	_Расшифровка.Сделка КАК Сделка,
			|	_Расшифровка.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Акции)
			|			ТОГДА ""Акция ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Векселя)
			|			ТОГДА ""Вексель ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
			|			ТОГДА ""ДепозитарнаяРасписка ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Доли)
			|			ТОГДА ""Доля ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|			ТОГДА ""Ипотечный сертификат участия ""
