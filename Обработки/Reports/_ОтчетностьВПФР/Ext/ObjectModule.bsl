			|	_Расшифровка_Развернуто.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_Расшифровка_Развернуто.Переоценка КАК Переоценка
			|ПОМЕСТИТЬ _Расшифровка
			|ИЗ
			|	_Расшифровка_Развернуто КАК _Расшифровка_Развернуто
			|ГДЕ
			|	_Расшифровка_Развернуто.Сумма <> 0
			|
			|СГРУППИРОВАТЬ ПО
			|	_Расшифровка_Развернуто.ЦеннаяБумага,
			|	_Расшифровка_Развернуто.Переоценка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПартииЦенныхБумаг.Регистратор КАК Регистратор,
			|	ПартииЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(ПартииЦенныхБумаг.ПереоценкаВВалютеУчета) КАК ФинансовыйРезультат
			|ПОМЕСТИТЬ _ПартииЦБ
			|ИЗ
			|	РегистрНакопления.БухПартииЦенныхБумаг КАК ПартииЦенныхБумаг
			|ГДЕ
			|	ПартииЦенныхБумаг.Организация = &Организация
			|	И ПартииЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ПартииЦенныхБумаг.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет)
			|	И ПартииЦенныхБумаг.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД) И &ДатаОкончания
			|	И ТИПЗНАЧЕНИЯ(ПартииЦенныхБумаг.Регистратор) = ТИП(Документ.ПереоценкаЦенныхБумаг)
			|
			|СГРУППИРОВАТЬ ПО
			|	ПартииЦенныхБумаг.ЦеннаяБумага,
			|	ПартииЦенныхБумаг.Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(СтоимостьПереоценки.Количество) КАК Количество,
			|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК СправедливаяСтоимость,
			|	СтоимостьПереоценки.Регистратор КАК Ссылка,
			|	СтоимостьПереоценки.Регистратор.Дата КАК ДатаПереоценки,
			|	СУММА(_ПартииЦБ.ФинансовыйРезультат) КАК ФинансовыйРезультат
			|ПОМЕСТИТЬ _ПереоценкаЦБ
			|ИЗ
			|	_ПартииЦБ КАК _ПартииЦБ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
			|		ПО (СтоимостьПереоценки.Регистратор = _ПартииЦБ.Регистратор)
			|			И (СтоимостьПереоценки.ЦеннаяБумага = _ПартииЦБ.ЦеннаяБумага)
			|ГДЕ
			|	СтоимостьПереоценки.Организация = &Организация
			|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.БухгалтерскийУчет)
			|	И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаПереоценки)
			|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет)
			|	И СтоимостьПереоценки.Период МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, ГОД) И &ДатаОкончания
			|	И СтоимостьПереоценки.СуммаВВалютеУчета + СтоимостьПереоценки.СуммаКупонаВВалютеУчета <> 0
			|
			|СГРУППИРОВАТЬ ПО
			|	СтоимостьПереоценки.ЦеннаяБумага,
			|	СтоимостьПереоценки.Регистратор,
			|	СтоимостьПереоценки.Регистратор.Дата
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Расшифровка.Сумма КАК ФинансовыйРезультат,
			|	ЕСТЬNULL(_ПереоценкаЦБ.ФинансовыйРезультат, 0) КАК Переоценка,
			|	ЕСТЬNULL(_ПереоценкаЦБ.СправедливаяСтоимость, 0) КАК СправедливаяСтоимость,
			|	_Расшифровка.ЦеннаяБумага КАК ЦеннаяБумага,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Акции)
			|			ТОГДА ""Акция ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Векселя)
			|			ТОГДА ""Вексель ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
			|			ТОГДА ""ДепозитарнаяРасписка ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Доли)
			|			ТОГДА ""Доля ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|			ТОГДА ""Ипотечный сертификат участия ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Облигации)
			|			ТОГДА ""Облигация ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Паи)
			|			ТОГДА ""Пай ""
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ПроизводныеФинансовыеИнструменты)
			|			ТОГДА ВЫБОР
			|					КОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
			|						ТОГДА ""Фьючерс""
			|					КОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Опцион)
			|						ТОГДА ""Опцион""
			|					ИНАЧЕ """"
			|				КОНЕЦ
			|		ИНАЧЕ """"
			|	КОНЕЦ + РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Наименование,
			|	_ПереоценкаЦБ.ДатаПереоценки КАК ДатаПереоценки,
			|	КодыВТорговыхСистемахСрезПоследнихISIN.Код КАК ISIN,
			|	ВЫБОР
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Акции)
			|			ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Паи)
			|			ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|			ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
			|		КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Облигации)
			|			ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
			|		ИНАЧЕ """"
			|	КОНЕЦ КАК ГосударственныйРегистрационныйНомер,
			|	_ПереоценкаЦБ.Количество КАК Количество,
			|	ЕСТЬNULL(_ПереоценкаЦБ.СправедливаяСтоимость, 0) - _Расшифровка.Сумма КАК БалансоваяСтоимость
			|ИЗ
			|	_Расшифровка КАК _Расшифровка
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПереоценкаЦБ КАК _ПереоценкаЦБ
			|		ПО _Расшифровка.Переоценка = _ПереоценкаЦБ.Ссылка
			|			И _Расшифровка.ЦеннаяБумага = _ПереоценкаЦБ.ЦеннаяБумага
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФСрезПоследних
			|		ПО (ВЫБОР
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Паи)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
			|				ИНАЧЕ ЛОЖЬ
			|			КОНЕЦ)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|				&ДатаОкончания,
			|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
			|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
			|		ПО (ВЫБОР
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Акции)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Векселя)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Доли)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Паи)
			|					ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
			|				КОГДА ТИПЗНАЧЕНИЯ(_Расшифровка.ЦеннаяБумага) = ТИП(Справочник.Облигации)
			|					ТОГДА ВЫРАЗИТЬ(_Расшифровка.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
			|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
			|		ПО _Расшифровка.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_Расшифровка_НеЦБ.Сумма,
			|	NULL,
			|	NULL,
			|	NULL,
			|	_Расшифровка_НеЦБ.Регистратор,
			|	NULL,
			|	NULL,
			|	NULL,
			|	NULL,
			|	NULL
			|ИЗ
			|	_Расшифровка_НеЦБ КАК _Расшифровка_НеЦБ
			|
			|УПОРЯДОЧИТЬ ПО
			|	ДатаПереоценки
			|ИТОГИ
			|	СУММА(ФинансовыйРезультат),
			|	СУММА(СправедливаяСтоимость),
			|	СУММА(БалансоваяСтоимость)
			|ПО
			|	ОБЩИЕ";    
		
		#КонецОбласти
		
		Если СНачалаГода Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_РасходыОбщие КАК", "_РасходыОбщие_СНачалаГода КАК");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаПоказателя", """ФинансовыйРезультатОтПереоценкиАктивов_СНачалаГода""");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаПоказателя", """ФинансовыйРезультатОтПереоценкиАктивов""");
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

























