Процедура ЗаполнитьПечатнуюФорму_ДоходыОтИнвестированияСредствПенсионныхНакоплений(ПакетДанных, Результат, ЕдиницаИзмерения = "Тысячи") Экспорт
	
	ПакетОтчет = Новый Структура;
	
	Для Каждого ЭлементСтруктуры Из ПакетДанных.Отчет Цикл
		Если ЭлементСтруктуры.Ключ = "Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений" Тогда
			ПакетОтчет.Вставить(ЭлементСтруктуры.Ключ, Новый Структура);
		Иначе	
			ПакетОтчет.Вставить(ЭлементСтруктуры.Ключ, ЭлементСтруктуры.Значение);	
		КонецЕсли;	                                                              		
	КонецЦикла;
	
	Для Каждого ЭлементСтруктуры Из ПакетДанных.Отчет.Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений Цикл
		ТекЗначение = ?(ТипЗнч(ЭлементСтруктуры.Значение) = Тип("Массив"), ПереопределитьМассив(ЭлементСтруктуры.Значение), ЭлементСтруктуры.Значение);
		ПакетОтчет.Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений.Вставить(ЭлементСтруктуры.Ключ, ТекЗначение);
	КонецЦикла;
		
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	Результат.Автомасштаб = Истина;
	
	Макет = ПолучитьМакет(ПакетДанных.ИмяОтчета);
	
	ОбластьШапка						= Макет.ПолучитьОбласть("Шапка");
		
	ОбластьШапка.Параметры.Период		= Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	ФорматныеСтроки = ПолучитьСтруктуруФорматныхСтрок("ДоходыОтИнвестированияСредствПенсионныхНакоплений", ЕдиницаИзмерения);
	
	ВывестиРаздел(,, "Раздел1_ДоходыОтИнвестированияСредствПенсионныхНакоплений.Таб_Отчет", ПакетОтчет, Макет, Результат, ФорматныеСтроки);

	ОбластьПодвал						   		 = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.ФИОРуководителя      = ПакетОтчет.ПодписьРуководителяУКНПФ.ФИО; 	
	ОбластьПодвал.Параметры.ФИОУполномоченногоСД = ПакетОтчет.ПодписьУполномоченногоЛица.ФИО2;
	
	Результат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

#КонецОбласти

// Расчет допустимого размера необходимых расходов (средняя СЧА)
#Область Расчет_допустимого_размера_необходимых_расходов

Функция ПолучитьДанные_РасчетДопустимогоРазмераНеобходимыхРасходов(ЕдиницаИзмерения = "Тысячи") Экспорт
	
	ПакетДанных = Новый Структура;     
	ПакетДанных.Вставить("ИмяОтчета"			, "РасчетДопустимогоРазмераНеобходимыхРасходов");
	ПакетДанных.Вставить("Отчет"				, Новый Структура);
	
	ПакетОтчетность = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ДатаНачала"								, ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаНачалаГода"							, ?(Год(ЭтотОбъект.Период.ДатаНачала) <> Год(ЭтотОбъект.Период.ДатаОкончания), ЭтотОбъект.Период.ДатаНачала, НачалоГода(ЭтотОбъект.Период.ДатаНачала)));
	Запрос.УстановитьПараметр("ДатаОкончания"							, КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("Организация"								, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления"			, ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидПоказателя"   						, Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок);
	Запрос.УстановитьПараметр("СтавкаВознаграждения"					, ЭтотОбъект.СтавкаВознагражденияУК);
	Запрос.УстановитьПараметр("СтавкаСпецдепозитария"					, ЭтотОбъект.СтавкаУслугСпецдепозитария);		
	Запрос.УстановитьПараметр("Руководитель"							, "");
	Запрос.УстановитьПараметр("Контролер"								, "");
	Запрос.УстановитьПараметр("Тыс"										, ?(ЕдиницаИзмерения = "Тысячи", "Тыс. ", ""));
	
	МассивВидовОперацийВводаАктивов = Новый Массив;
	МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР);
	МассивВидовОперацийВводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление);
	
	Запрос.УстановитьПараметр("ВидыОперацийВводаАктивов", МассивВидовОперацийВводаАктивов); 
	
	МассивВидовОперацийВыводаАктивов = Новый Массив;
	МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению);
	МассивВидовОперацийВыводаАктивов.Добавить(Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР);
	
	Запрос.УстановитьПараметр("ВидыОперацийВыводаАктивов", МассивВидовОперацийВыводаАктивов); 
	
	Справочники.Календари.ПоместитьВЗапросДанныеКалендаря(
		ЭтотОбъект.СчетДоверительногоУправления, 
		ЭтотОбъект.ДатаОтчетности,
		Справочники.Календари.Общероссийский,
		Неопределено,
		НачалоГода(ЭтотОбъект.Период.ДатаНачала),
		ЭтотОбъект.Период.ДатаОкончания,
		Запрос.МенеджерВременныхТаблиц,
		"_ДанныеКалендаря",
		Истина);
	
	ПакетТаблица = Новый Структура;

	СтруктураРезультата = ПолучитьДанные_РасчетДопустимогоРазмераНеобходимыхРасходов_СтруктураРезультата(Запрос, ЕдиницаИзмерения);
	ПакетТаблица.Вставить("Таб_Отчет", СтруктураРезультата.МассивСтрок);
	ПакетТаблица.Вставить("СтруктураШапкиИПодвала", СтруктураРезультата.СтруктураШапкиИПодвала);
		
	ПакетДанных.Отчет.Вставить("Раздел1_РасчетДопустимогоРазмераНеобходимыхРасходов", ПакетТаблица);
	
	ПодписьРуководителяУКНПФ = Новый Структура;
	ПодписьРуководителяУКНПФ.Вставить("ФИО"	, ?(ЭтотОбъект.УказатьРуководителя, Лев(СокрЛП(ЭтотОбъект.Руководитель_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Руководитель_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Руководитель_Фамилия), Лев(СокрЛП(ЭтотОбъект.Исполнитель_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Исполнитель_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Исполнитель_Фамилия)));
	
	ПакетДанных.Отчет.Вставить("ПодписьРуководителяУКНПФ", ПодписьРуководителяУКНПФ);
	
	ПодписьУполномоченногоЛица = Новый Структура;
	ПодписьУполномоченногоЛица.Вставить("ФИО2"	, Лев(СокрЛП(ЭтотОбъект.Контролер_Имя), 1) + " " + Лев(СокрЛП(ЭтотОбъект.Контролер_Отчество), 1) + " " + СокрЛП(ЭтотОбъект.Контролер_Фамилия));
	
	ПакетДанных.Отчет.Вставить("ПодписьУполномоченногоЛица", ПодписьУполномоченногоЛица);
	
	Возврат ПакетДанных;
	
КонецФункции
	
Функция ПолучитьДанные_РасчетДопустимогоРазмераНеобходимыхРасходов_СтруктураРезультата(Запрос, ЕдиницаИзмерения = "Тысячи")	
	
	СтруктураРезультата = Новый Структура;
	
	СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц,, "_ДанныеКалендаря");
	Запрос.Текст = ПолучитьТекстЗапроса_РасчетДопустимогоРазмераНеобходимыхРасходов();
	
	МассивДанных = Новый Массив;
	
	ФорматныеСтроки = ПолучитьСтруктуруФорматныхСтрок("РасчетДопустимогоРазмераНеобходимыхРасходов", ЕдиницаИзмерения);
				
	Пакет	= Запрос.ВыполнитьПакет();
	//Данные	= Пакет[13].Выгрузить(); 
	
	// данные по дням
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_ДанныеПоДням").ПолучитьДанные().Выгрузить();
	
	Данные.Сортировать("Дата");
	
	МассивДанных = СформироватьМассивСтрок(Данные, ФорматныеСтроки, "", , , Истина);
	
	СтруктураРезультата.Вставить("МассивСтрок", МассивДанных);
	
	//Данные = Пакет[14].Выгрузить();
	Данные	= Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Результат_ШапкаИПодвал").ПолучитьДанные().Выгрузить();
	
	МассивДанных = СформироватьМассивСтрок(Данные, ФорматныеСтроки, "", , , Истина);
	
	Если МассивДанных.Количество() = 0 Тогда
		СтруктураРезультата.Вставить("СтруктураШапкиИПодвала", Новый Структура);
	Иначе
		СтруктураРезультата.Вставить("СтруктураШапкиИПодвала", МассивДанных[0]);
	КонецЕсли;
			
	Возврат СтруктураРезультата; 
	
КонецФункции

Функция ПолучитьТекстЗапроса_РасчетДопустимогоРазмераНеобходимыхРасходов()
	
#Область ТекстЗапроса

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВЫБОР
		|			КОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|					И (ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|							И ВводыВыводыАктивовВВалютеУчетаОбороты.ВидОперацииВводаВыводаДС В (&ВидыОперацийВводаАктивов)
		|						ИЛИ ВводыВыводыАктивовВВалютеУчетаОбороты.ВидАктива <> ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства))
		|				ТОГДА ВводыВыводыАктивовВВалютеУчетаОбороты.РыночнаяСтоимостьОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаВводаАктивов,
		|	ВводыВыводыАктивовВВалютеУчетаОбороты.Период КАК Дата
		|ПОМЕСТИТЬ _ВводыПоДатам
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета.Обороты(
