		|	ЕСТЬNULL(ФинансовыеПоказатели_ОтчетнаяДата.Значение, 0) - ЕСТЬNULL(ФинансовыеПоказатели.Значение, 0) - ЕСТЬNULL(_ВводыВыводы.ПоступлениеАктивов, 0) + ЕСТЬNULL(_ВводыВыводы.ИзъятиеАктивов, 0) + ЕСТЬNULL(_РасходыИВознаграждениеУК.НеобходимыеРасходыУК, 0),
		|	ЕСТЬNULL(ФинансовыеПоказатели_ОтчетнаяДата.Значение, 0) - ЕСТЬNULL(ФинансовыеПоказатели_НачалоГода.Значение, 0) - ЕСТЬNULL(_ВводыВыводы.ПоступлениеАктивов_СНачалаГода, 0) + ЕСТЬNULL(_ВводыВыводы.ИзъятиеАктивов_СНачалаГода, 0) + ЕСТЬNULL(_РасходыИВознаграждениеУК.НеобходимыеРасходыУК_СНачалаГода, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_Данные.ПолнНаимУК КАК ПолнНаимУК,
		|	ВТ_Данные.ИНН_УК КАК ИНН_УК,
		|	ВТ_Данные.КПП_УК КАК КПП_УК,
		|	ВТ_Данные.ИНН_УК + ""/"" + ВТ_Данные.КПП_УК КАК ПечИННКПП,
		|	ВТ_Данные.ПолноеНаименНПФ КАК ПолноеНаименНПФ,
		|	ВТ_Данные.ИНН_НПФ КАК ИНН_НПФ,
		|	ВТ_Данные.НомерДоговораУправления КАК НомерДоговораУправления,
		|	ВТ_Данные.ДатаЗаключДоговора КАК ДатаЗаключДоговора,
		|	&Тыс КАК Тыс,
		|	ЕСТЬNULL(ВТ_Данные.ПоступлениеАктивов, 0) КАК ПоступлениеАктивов,
		|	ЕСТЬNULL(ВТ_Данные.ПоступлениеАктивов_СНачалаГода, 0) КАК ПоступлениеАктивов_СНачалаГода,
		|	ЕСТЬNULL(ВТ_Данные.ИзъятиеАктивов, 0) КАК ИзъятиеАктивов,
		|	ЕСТЬNULL(ВТ_Данные.СтоимЧистАктивов, 0) КАК СтоимЧистАктивов,
		|	ЕСТЬNULL(ВТ_Данные.ИзъятиеАктивов_СНачалаГода, 0) КАК ИзъятиеАктивов_СНачалаГода,
		|	ВТ_Данные.СтоимЧистАктивов_НачалоГода КАК СтоимЧистАктивов_НачалоГода,
		|	ВТ_Данные.СтоимЧистАктивовНаКонецОтчПериода КАК СтоимЧистАктивовНаКонецОтчПериода,
		|	ЕСТЬNULL(ВТ_Данные.НеобходимыеРасходыУК, 0) КАК НеобходимыеРасходыУК,
		|	ЕСТЬNULL(ВТ_Данные.НеобходимыеРасходыУК_СНачалаГода, 0) КАК НеобходимыеРасходыУК_СНачалаГода,
		|	ЕСТЬNULL(ВТ_Данные.ФинРезультат, 0) КАК ФинРезультат,
		|	ЕСТЬNULL(ВТ_Данные.ФинРезультат_СНачалаГода, 0) КАК ФинРезультат_СНачалаГода,
		|	КВАРТАЛ(&ДатаОкончания) КАК Квартал,
		|	ГОД(&ДатаОкончания) КАК Год
		|ПОМЕСТИТЬ _Результат
		|ИЗ
		|	ВТ_Данные КАК ВТ_Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Руководитель КАК RukovodUKFIO
		|;
