&НаКлиенте
Процедура УстановитьПериодОтчетаПоУмолчанию()
	
	Элементы.Период.Видимость = Истина;
	
	Если (Отчет.ВариантОтчета = "ИнвестированиеСредствПенсионныхНакоплений"
		ИЛИ Отчет.ВариантОтчета = "ДоходыОтИнвестированияСредствПенсионныхНакоплений") Тогда	
		
		Отчет.Период.ДатаОкончания = ПоследняяРабочаяДатаВМесяцеДатыОтчетности;                                    
		Отчет.Период.ДатаНачала	  = ПредпоследняяРабочаяПредПредыдущегоКвартала + 60 * 60 * 24;
		Если Отчет.Период.ДатаОкончания >= Дата(2018,12,29) Тогда
			Отчет.Период.ДатаОкончания = КонецКвартала(ПоследняяРабочаяДатаВМесяцеДатыОтчетности);
		КонецЕсли;   	
		
		Если Отчет.Период.ДатаОкончания >= Дата(2019,1,1) Тогда
			Отчет.Период.ДатаНачала = НачалоКвартала(ПоследняяРабочаяДатаВМесяцеДатыОтчетности);
		КонецЕсли;
		
	ИначеЕсли Отчет.ВариантОтчета = "РасчетДопустимогоРазмераНеобходимыхРасходов" Тогда	
		
		Отчет.Период.ДатаОкончания = ПоследняяРабочаяДатаВМесяцеДатыОтчетности;                                    
		Отчет.Период.ДатаНачала = НачалоГода(ПоследняяРабочаяДатаВМесяцеДатыОтчетности);                                    
		Если Отчет.Период.ДатаОкончания >= Дата(2018,12,29) Тогда
			Отчет.Период.ДатаОкончания = КонецКвартала(ПоследняяРабочаяДатаВМесяцеДатыОтчетности);
		КонецЕсли;   	
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура СформироватьПакетДанных(ИмяПакета)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");

	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОтчетОбъект, "Организация,Период,ДатаОтчетности", Новый Структура("ИмяПакета", ИмяПакета));
	Механизм = ОтчетОбъект.Метаданные().ПолноеИмя() + ".СформироватьПакетДанных()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПакетДанных = Новый Структура;
	
	Если ИмяПакета = "ИнвестированиеСредствПенсионныхНакоплений" Тогда
		
		ПакетДанных	= ОтчетОбъект.ПолучитьДанные_ИнвестированиеСредствПенсионныхНакоплений(ЭтаФорма.ЕдиницаИзмерения);
		
		Если ПакетДанных.Свойство("Отказ") Тогда
			
			Если Сессия <> Неопределено Тогда
				РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
				
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ИнвестированиеСредствПенсионныхНакоплений(ПакетДанных, Результат, ЭтаФорма.ЕдиницаИзмерения);
		КонецЕсли;
		
	ИначеЕсли ИмяПакета = "ДоходыОтИнвестированияСредствПенсионныхНакоплений" Тогда
	
		ПакетДанных	= ОтчетОбъект.ПолучитьДанные_ДоходыОтИнвестированияСредствПенсионныхНакоплений(ЭтаФорма.ЕдиницаИзмерения);
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_ДоходыОтИнвестированияСредствПенсионныхНакоплений(ПакетДанных, Результат, ЭтаФорма.ЕдиницаИзмерения);
		КонецЕсли;
		
	ИначеЕсли ИмяПакета = "РасчетДопустимогоРазмераНеобходимыхРасходов" Тогда
		
		ПакетДанных	= ОтчетОбъект.ПолучитьДанные_РасчетДопустимогоРазмераНеобходимыхРасходов(ЭтаФорма.ЕдиницаИзмерения);
		
		Если Отчет.ВывестиПечатнуюФорму Тогда
			ОтчетОбъект.ЗаполнитьПечатнуюФорму_РасчетДопустимогоРазмераНеобходимыхРасходов(ПакетДанных, Результат, ЭтаФорма.ЕдиницаИзмерения);
		КонецЕсли;
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИмяФайла(Расширение)

	//проверка каталога	
	ПроверяемыйКаталог = Новый Файл(Отчет.КаталогДанных);
	Если НЕ ПроверяемыйКаталог.Существует() Тогда
		СоздатьКаталог(Отчет.КаталогДанных);
	КонецЕсли;	
	
	Версия = 1;
	
	Версионирование = Истина;
	
	Если (Отчет.ВариантОтчета = "ИнвестированиеСредствПенсионныхНакоплений" 
		ИЛИ Отчет.ВариантОтчета = "ДоходыОтИнвестированияСредствПенсионныхНакоплений"
		ИЛИ Отчет.ВариантОтчета = "РасчетДопустимогоРазмераНеобходимыхРасходов") Тогда
		ШаблонФайла		= Отчет.КаталогДанных + "\" + Отчет.ВариантОтчета + " за " + Формат(Отчет.Период.ДатаНачала, "ДФ=MMMM") + "-" + Формат(Отчет.Период.ДатаОкончания, "ДФ=MMMM") + " " + Формат(Отчет.Период.ДатаОкончания, "ДФ=yyyy") + " г. " + НаименованиеГоловнойОрганизации + " " + Строка(Отчет.СчетДоверительногоУправления);
		Версионирование = Ложь;
	Иначе
		ШаблонФайла		= Отчет.КаталогДанных + "\" + Отчет.ВариантОтчета + " за " + Формат(Отчет.Период.ДатаОкончания, "ДФ='MMMM yyyy'") + " " + НаименованиеГоловнойОрганизации;
	КонецЕсли;
	
	ШаблонФайла = СтрЗаменить(ШаблонФайла, """", "");
	
	Если Версионирование Тогда
		ИмяФайлаСРасширением = ШаблонФайла + " ver." + Строка(Версия) + Расширение;
		
		ПроверяемыйФайл = Новый Файл(ИмяФайлаСРасширением);
		Пока ПроверяемыйФайл.Существует() Цикл
			Версия = Версия + 1;
			ИмяФайлаСРасширением =  ШаблонФайла + " ver." + Строка(Версия) + Расширение;
			ПроверяемыйФайл = Новый Файл(ИмяФайлаСРасширением);
		КонецЦикла;
	Иначе
		ИмяФайлаСРасширением	=  ШаблонФайла + Расширение;		
	КонецЕсли;
	    	
	Возврат ИмяФайлаСРасширением;
	
КонецФункции
	
&НаСервере
Функция СформироватьРасшифровкуНаСервере(НомерСтроки, НомерКолонки)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");		
	
	ПолеРасшифровки = ?(НомерСтроки = 21, "011", "014");
	СНачалаГода = НомерКолонки = 4;
	
	ВыборкаРасшифровки = ОтчетОбъект.ПолучитьВыборкуРасшифровкиЯчейки(ПолеРасшифровки, СНачалаГода, ЭтаФорма.ЕдиницаИзмерения);
	Если ВыборкаРасшифровки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = ОтчетОбъект.ПолучитьМакет("Расшифровка" + ПолеРасшифровки);
		
	ОбластьШапка  	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОбластьИтог		= Макет.ПолучитьОбласть("Итог");
		
	ТабДокумент.Вывести(ОбластьШапка);
		
	Если ВыборкаРасшифровки.Следующий() Тогда // Строка итогов
		ОбластьИтог.Параметры.Заполнить(ВыборкаРасшифровки);		
	КонецЕсли;
	
	Сч = 1;
	Пока ВыборкаРасшифровки.Следующий() Цикл
	
		ОбластьСтрока.Параметры.Заполнить(ВыборкаРасшифровки);
		ОбластьСтрока.Параметры.НомерСтроки = Сч;
		ТабДокумент.Вывести(ОбластьСтрока);
		Сч = Сч + 1;
	
	КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьИтог);
	
	ТабДокумент.ТолькоПросмотр = Истина;	
	                  
	Возврат ТабДокумент;
	
КонецФункции

&НаКлиенте
Процедура СформироватьXML_НеОКУД()
	
	Если ПакетДанных.Свойство("Отказ") Тогда 
		Возврат; 
	КонецЕсли;
	
	ИмяФайлаXML = ПолучитьИмяФайла(".xml");
	
	ТекстФайла = ПолучитьМакет_НеОКУД();
	
	МассивДанных = ПакетДанных.Отчет["Раздел1_" + Отчет.ВариантОтчета].Таб_Отчет;
		
	Если МассивДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьМассивДанных(МассивДанных[0], Отчет.ВариантОтчета, ЭтотОбъект.ЕдиницаИзмерения);
	
	Для Каждого ЭлементСтруктуры Из МассивДанных[0] Цикл
		ТекстФайла = СтрЗаменить(ТекстФайла, ЭлементСтруктуры.Ключ + "_Тэг", ЭлементСтруктуры.Значение);		
	КонецЦикла;
	
	ФайлXML = Новый ТекстовыйДокумент;
	ФайлXML.УстановитьТекст(ТекстФайла);	
	ФайлXML.Записать(ИмяФайлаXML, "windows-1251");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сохранён в файл: " + ИмяФайлаXML);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьМассивДанных(МассивДанных, ВариантОтчета, ЕдиницаИзмерения)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ПолучитьФорматированныеДанныеДляПечати(ВариантОтчета, МассивДанных, ЕдиницаИзмерения);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМакет_НеОКУД()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	МакетСоответствия = ОтчетОбъект.ПолучитьМакет("СоответствиеВариантовОтчетаИВыгрузок");
	
	СоответствиеНазваний = Новый Структура;
		
	Для НомерСтроки = 2 По МакетСоответствия.ВысотаТаблицы Цикл
		
		ВариантОтчета		= СокрЛП(МакетСоответствия.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		ИмяМакетаВыгрузки	= СокрЛП(МакетСоответствия.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);		
				
		Если ВариантОтчета = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СоответствиеНазваний.Вставить(ВариантОтчета, ИмяМакетаВыгрузки);
		
	КонецЦикла;
	
	Возврат ОтчетОбъект.ПолучитьМакет(СоответствиеНазваний[ОтчетОбъект.ВариантОтчета]).ПолучитьТекст();
	
КонецФункции

