
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	НаименованиеГоловнойОрганизации = ПолучитьНаименованиеГоловнойОрганизации();
	
	Отчет.ДатаОтчетности		= КонецМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	Отчет.ВалютаУчета			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Отчет.Организация, "ВалютаУчета");
	
	ДатаОтчетностиПриИзмененииНаСервере();
		
	ЗаполнитьСписокКонтактныхЛиц();
			
	НастройкиВидимостиРеквизитов = РеквизитФормыВЗначение("Отчет").ПолучитьНастройкиВидимостиРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ВариантОтчетаПриИзменении("");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	СохранитьДанныеВНастройки(Отчет.ВариантОтчета);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(Отчет.Период,,, ТекстСообщения) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,, "Отчет.Период", Отказ);	
	КонецЕсли;
	
	Если ТекущаяДата() <= Отчет.Период.ДатаОкончания Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата окончания периода не должна превышать текущую дату " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"),,, "Отчет.Период", Отказ);
	КонецЕсли;
	
	Если Отчет.ВыгружатьВXML Тогда
		Если НЕ ЗначениеЗаполнено(Отчет.КаталогДанных) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите каталог данных",,, "Отчет.КаталогДанных", Отказ);
		КонецЕсли;
	КонецЕсли;
			
	Если Не ЗначениеЗаполнено(Отчет.СчетДоверительногоУправления) Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите счет доверительного управления",,, "Отчет.СчетДоверительногоУправления", Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Отчет.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Отчет.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Отчет.КаталогДанных + "\");

КонецПроцедуры

&НаКлиенте
Процедура ФамилияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РезультатВыбора = СписокКонтактныхЛиц.ВыбратьЭлемент();
	
	Если РезультатВыбора <> Неопределено Тогда
		Если Элемент = Элементы.Контролер_Фамилия Тогда
			ИмяЭлемента = "Контролер";		
		ИначеЕсли Элемент = Элементы.Руководитель_Фамилия Тогда
			ИмяЭлемента = "Руководитель";			
		Иначе
			Возврат;
		КонецЕсли;
		
		ЗаполнитьФИО(ИмяЭлемента, РезультатВыбора.Значение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Отчет.ДатаОтчетности = Отчет.Период.ДатаОкончания;
	
	Отчет.КаталогДанных = ПолучитьИмяФайлаОпераций(Отчет.Организация, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.КаталогДанных);
		
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтчетаПриИзменении(Элемент)
	
	ВосстановитьДанныеИзНастроек(Отчет.ВариантОтчета);
	
	Элементы.СчетДоверительногоУправления	.Видимость = ВидимостьРеквизита("СчетДоверительногоУправления");
	Элементы.ГруппаСтавки					.Видимость = ВидимостьРеквизита("ГруппаСтавки");
	
	Элементы.ГруппаВыгружатьВXML	.Видимость = ВидимостьРеквизита("ГруппаВыгружатьВXML");
	Элементы.ВывестиПечатнуюФорму	.Видимость = ВидимостьРеквизита("ВывестиПечатнуюФорму");
	
	Отчет.ВывестиПечатнуюФорму = Элементы.ВывестиПечатнуюФорму.Видимость;
		
	ЭтоНеОКУД = (Отчет.ВариантОтчета = "ИнвестированиеСредствПенсионныхНакоплений" ИЛИ Отчет.ВариантОтчета = "ДоходыОтИнвестированияСредствПенсионныхНакоплений");
	Элементы.ВыгружатьВXML.Заголовок = ?(ЭтоНеОКУД, "Выгружать в XML", "Выгружать в Анкету");
	
	УстановитьПериодОтчетаПоУмолчанию();
	
	Отчет.КаталогДанных = ПолучитьИмяФайлаОпераций(Отчет.Организация, Отчет.ВариантОтчета, Отчет.Период.ДатаОкончания, Отчет.КаталогДанных);
			
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СохранитьДанныеВНастройки(Отчет.ВариантОтчета);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьДанныеВНастройки(ВариантОтчета)
	
	СохраняемыеРеквизиты = ПолучитьСохраняемыеРеквизиты();
	
	ЗаполнитьЗначенияСвойств(СохраняемыеРеквизиты, Отчет);
	ЗаполнитьЗначенияСвойств(СохраняемыеРеквизиты, ЭтаФорма);
	
	ПараметрыПоиска = Новый Структура("Организация,ВариантОтчета", Отчет.Организация, ВариантОтчета);
	НайденныеСтроки = Отчет.НастройкиОтчета.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаНастройки Из НайденныеСтроки Цикл
		Отчет.НастройкиОтчета.Удалить(СтрокаНастройки);
	КонецЦикла;
	
	Для Каждого Реквизит Из СохраняемыеРеквизиты Цикл
		СтрокаНастройки = Отчет.НастройкиОтчета.Добавить();
		СтрокаНастройки.Организация		= Отчет.Организация;
		СтрокаНастройки.ВариантОтчета	= Отчет.ВариантОтчета;
		СтрокаНастройки.Ключ			= Реквизит.Ключ;
		СтрокаНастройки.Значение		= Реквизит.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОтчетностиПриИзменении(Элемент)
	
	ДатаОтчетностиПриИзмененииНаСервере();	
	УстановитьПериодОтчетаПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура ДатаОтчетностиПриИзмененииНаСервере()
		
	ПредпоследняяРабочаяПредПредыдущегоКвартала	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецКвартала(ДобавитьМесяц(Отчет.ДатаОтчетности, -6)));	
	ПоследняяРабочаяДатаВМесяцеДатыОтчетности = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, КонецМесяца(Отчет.ДатаОтчетности));
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбор(Элемент, Область, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
		
	ТекОбласть = Элемент.ТекущаяОбласть.Имя;
	
	НайдНомерКолонки = СтрНайти(ТекОбласть, "C");
	Если НайдНомерКолонки = 0 Тогда
		Сообщить("Неверное имя ячейки");
		Возврат;
	КонецЕсли;
	
	// Если выбран диапазон ячеек, тоже исключаем
	Если СтрНайти(ТекОбласть, ":") > 0 Тогда
		Сообщить("Для данной ячейки расшифровка отсутствует!");
		Возврат;
	КонецЕсли;
	
	НомерСтроки		= Число(Сред(ТекОбласть, 2, НайдНомерКолонки - 2));
	НомерКолонки	= Число(Сред(ТекОбласть, НайдНомерКолонки + 1));
	
	// строки 21 и 24, столбцы 3 и 4
	Если Не((НомерСтроки = 21 Или НомерСтроки = 24) И (НомерКолонки = 3 Или НомерКолонки = 4)) Тогда
		Сообщить("Для данной ячейки расшифровка отсутствует!");
		Возврат;	
	КонецЕсли;
		
	Расшифровка = СформироватьРасшифровкуНаСервере(НомерСтроки, НомерКолонки);
	Если Расшифровка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФормыРасшифровки = Лев(ЭтотОбъект.ИмяФормы, СтрНайти(ЭтотОбъект.ИмяФормы, ".", НаправлениеПоиска.СКонца)) + "ФормаРасшифровки";
	
	ФормаРасшифровки = ПолучитьФорму(ИмяФормыРасшифровки, , ЭтаФорма);  
	ФормаРасшифровки.Расшифровка = Расшифровка;
	
	Если ФормаРасшифровки.Открыта() Тогда
		ФормаРасшифровки.Активизировать();		
	Иначе
		ФормаРасшифровки.Открыть();
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНеОКУД = (Отчет.ВариантОтчета = "ИнвестированиеСредствПенсионныхНакоплений" ИЛИ Отчет.ВариантОтчета = "ДоходыОтИнвестированияСредствПенсионныхНакоплений");
				
	Отчет.ВыгружатьВXML		= Мин(Элементы.ГруппаВыгружатьВXML.Видимость, Отчет.ВыгружатьВXML);
	
	СформироватьПакетыДанных();    	
	
	Если Отчет.ВыгружатьВXML И ЭтоНеОКУД Тогда
		СформироватьXML_НеОКУД();
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаСервере
Процедура ЗаполнитьФИО(ИмяЭлемента, КонтактноеЛицо)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Имя КАК Имя,
		|	РеквизитыСотрудниковОрганизацииСрезПоследних.Отчество КАК Отчество,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК Телефон,
		|	КонтактныеЛица.Должность КАК Должность
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&Период, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО Организации.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.Телефон)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО (ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, Организации.ЮрФизЛицо) = КонтактнаяИнформацияСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО Организации.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И (КонтактныеЛица.КонтактноеЛицо = &КонтактноеЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|				&Период,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Организация = &Организация
		|					И ЮрФизЛицо = &КонтактноеЛицо) КАК РеквизитыСотрудниковОрганизацииСрезПоследних
		|		ПО (ИСТИНА)
		|ГДЕ
		|	Организации.Ссылка = &Организация";
		
	Запрос.УстановитьПараметр("Организация"		, Отчет.Организация);
	Запрос.УстановитьПараметр("КонтактноеЛицо"	, КонтактноеЛицо);
	Запрос.УстановитьПараметр("Период"			, Отчет.ДатаОтчетности);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Отчет[ИмяЭлемента + "_Фамилия"]	= Выборка.Фамилия;
		Отчет[ИмяЭлемента + "_Имя"]		= Выборка.Имя;
		Отчет[ИмяЭлемента + "_Отчество"]	= Выборка.Отчество;
		Отчет[ИмяЭлемента + "_Должность"]	= Выборка.Должность;
		Отчет[ИмяЭлемента + "_Телефон"]	= Лев(Выборка.Телефон, Найти(Выборка.Телефон, ",") - 1);
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокКонтактныхЛиц()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КонтактныеЛица.КонтактноеЛицо
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|		ПО Организации.ЮрФизЛицо = КонтактныеЛица.Объект
		|			И (КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	Организации.Ссылка = &Организация
		|	И КонтактныеЛица.КонтактноеЛицо ССЫЛКА Справочник.ЮрФизЛица";
		
	Запрос.УстановитьПараметр("Организация", Отчет.Организация);
	СписокКонтактныхЛиц.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтактноеЛицо"));
	
КонецПроцедуры	

&НаКлиенте
Процедура ВосстановитьДанныеИзНастроек(ВариантОтчета)
	
	СохраняемыеРеквизиты = Новый Структура;
	
	ПараметрыПоиска = Новый Структура("Организация,ВариантОтчета", Отчет.Организация, ВариантОтчета);
	НайденныеСтроки = Отчет.НастройкиОтчета.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаНастройки Из НайденныеСтроки Цикл
		Если ЗначениеЗаполнено(СтрокаНастройки.Значение) Тогда
			СохраняемыеРеквизиты.Вставить(СтрокаНастройки.Ключ, СтрокаНастройки.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Отчет		, СохраняемыеРеквизиты);
