		|			ТОГДА _РейтингиСрезПоследнихАктивов.ПрогнозРейтинга
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА _РейтингиСрезПоследнихАктивов.ПрогнозРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.PD < _РейтингиСрезПоследнихАктивов.PD
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.ПрогнозРейтинга
		|		ИНАЧЕ _РейтингиСрезПоследнихАктивов.ПрогнозРейтинга
		|	КОНЕЦ КАК ПрогнозРейтинга,
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|				И _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА 100
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.УровеньРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихАктивов.УровеньРейтинга
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА _РейтингиСрезПоследнихАктивов.УровеньРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.PD < _РейтингиСрезПоследнихАктивов.PD
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.УровеньРейтинга
		|		ИНАЧЕ _РейтингиСрезПоследнихАктивов.УровеньРейтинга
		|	КОНЕЦ КАК УровеньРейтинга,
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|				И _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА ""Не определен""
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.СтрокаРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихАктивов.СтрокаРейтинга
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА _РейтингиСрезПоследнихАктивов.СтрокаРейтинга
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.PD < _РейтингиСрезПоследнихАктивов.PD
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.СтрокаРейтинга
		|		ИНАЧЕ _РейтингиСрезПоследнихАктивов.СтрокаРейтинга
		|	КОНЕЦ КАК ЗначениеРейтинга,
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|				И _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА """"
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|			ТОГДА ""Рейтинг эмитента""
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА ""Рейтинг эмиссии""
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА ""Рейтинг эмиссии""
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.PD < _РейтингиСрезПоследнихАктивов.PD
		|			ТОГДА  ""Рейтинг эмитента""
		|		ИНАЧЕ ""Рейтинг эмиссии""
		|	КОНЕЦ КАК ПринадлежностьРейтинга,
		|	ВЫБОР
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|				И _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА 99.5
		|		КОГДА _РейтингиСрезПоследнихАктивов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.СтрокаСопоставления
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.Субъект ЕСТЬ NULL
		|			ТОГДА _РейтингиСрезПоследнихАктивов.СтрокаСопоставления
		|		КОГДА &ПриоритетРейтингаВыпуска
		|			ТОГДА _РейтингиСрезПоследнихАктивов.СтрокаСопоставления
		|		КОГДА _РейтингиСрезПоследнихЭмитентов.СтрокаСопоставления < _РейтингиСрезПоследнихАктивов.СтрокаСопоставления
		|			ТОГДА _РейтингиСрезПоследнихЭмитентов.СтрокаСопоставления
		|		ИНАЧЕ _РейтингиСрезПоследнихАктивов.СтрокаСопоставления
		|	КОНЕЦ КАК СтрокаСопоставления
		|ИЗ
		|	_ЦенныеБумаги КАК _ЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихАктивов
		|		ПО (_ЦенныеБумаги.ЦеннаяБумага = _РейтингиСрезПоследнихАктивов.Субъект
		|				ИЛИ &ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии
		|					И ВЫБОР
		|						КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Документ.ПогашениеКупона)
		|							ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Документ.ПогашениеКупона).Облигация = _РейтингиСрезПоследнихАктивов.Субъект
		|						КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|							ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Документ.ПогашениеЦеннойБумаги).ЦеннаяБумага = _РейтингиСрезПоследнихАктивов.Субъект
		|						КОГДА ТИПЗНАЧЕНИЯ(_ЦенныеБумаги.ЦеннаяБумага) = ТИП(Документ.НачислениеДивидендов)
		|							ТОГДА ВЫРАЗИТЬ(_ЦенныеБумаги.ЦеннаяБумага КАК Документ.НачислениеДивидендов).ЦеннаяБумага = _РейтингиСрезПоследнихАктивов.Субъект
		|					КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛучшиеРейтингиИПрогнозы КАК _РейтингиСрезПоследнихЭмитентов
		|		ПО _ЦенныеБумаги.Эмитент = _РейтингиСрезПоследнихЭмитентов.Субъект";
		
		#КонецОбласти
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ТаблицаPD", ТаблицаPD);
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("День", НачалоДня(ЭтотОбъект.Период));
		Запрос.УстановитьПараметр("ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии", ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии);
		
		Если ЭтотОбъект.Период < '20230531' Тогда
			Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Ложь);
		Иначе
			Запрос.УстановитьПараметр("ПриоритетРейтингаВыпуска", Истина);
		КонецЕсли;
		
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		//для  ОФЗ  - PD и LGD соответствуют значениям  для рейтинга "ААА" (первой группы кредитного качества)
		РейтингГосударственныхОблигаций = ТаблицаPD.НайтиСтроки(Новый Структура("РейтинговоеАгентство, СтрокаРейтинга", Справочники.РейтинговыеАгентства.АКРА, "AAA(RU)"));
		
		ПрофсужденияПоPDLGD = ДокументНачисленияРезерва.ПолучитьПрофсужденияПоPDLGD();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СтрокаАктивы = ТаблицаОтчета.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаАктивы, ВыборкаДетальныеЗаписи);
			
			СтрокаАктивы.V = ВыборкаДетальныеЗаписи.Стоимость;
						
			ЭтоГосБумага = Ложь;
			Если (ТипЗнч(ВыборкаДетальныеЗаписи.ЦеннаяБумага) = Тип("СправочникСсылка.Облигации")
				Или ТипЗнч(ВыборкаДетальныеЗаписи.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеКупона")
				Или ТипЗнч(ВыборкаДетальныеЗаписи.ЦеннаяБумага) = Тип("ДокументСсылка.ПогашениеЦеннойБумаги"))
				И ВыборкаДетальныеЗаписи.Эмитент = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_МинфинРоссии") Тогда
				Для Каждого СтрокаРейтингГосударственныхОблигаций Из РейтингГосударственныхОблигаций Цикл
					СтрокаАктивы.PD = СтрокаРейтингГосударственныхОблигаций.PD;
					СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
					СтрокаАктивы.УровеньРейтинга = 1;
					СтрокаАктивы.СтрокаСопоставления = 1;
					СтрокаАктивы.ЗначениеРейтинга = СтрокаРейтингГосударственныхОблигаций.СтрокаРейтинга;
					СтрокаАктивы.ПринадлежностьРейтинга = "Рейтинг эмитента";
					СтрокаАктивы.LGD = СтрокаРейтингГосударственныхОблигаций.LGD / 100;
					ЭтоГосБумага = Истина;
				КонецЦикла;	
			ИначеЕсли ВыборкаДетальныеЗаписи.УровеньРейтинга = 100 И ВыборкаДетальныеЗаписи.СтрокаСопоставления Тогда 
				
				//При отсутствии рейтинга финансового актива/ контрагента вероятность дефолта определяется как средняя вероятность дефолта на горизонте 1 год для Speculative Grade от агентства Moody’s.
				//Приложение А строка 23
				СтрокаАктивы.PD	= 4.08;
			ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.ЦеннаяБумага) = Тип("ДокументСсылка.СделкаРЕПО")
				И ВыборкаДетальныеЗаписи.ЦеннаяБумага.СделкаСЦентральнымКонтрагентом Тогда
				//Для дебиторской задолженности по операциям обратного репо с центральным контрагентом учитывается рейтинг центрального контрагента в лице НКЦ.
				ПараметрыНастройкиДляPDАктиваНаДату = ДокументНачисленияРезерва.ПолучитьНастройкиДляPDАктиваНаДату();
				СтрокаАктивы.PD = ДокументНачисленияРезерва.ПолучитьPDАктиваНаДату(КонецДня(ЭтотОбъект.Период), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"), ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату);
				СтрокаАктивы.ПрогнозРейтинга = Перечисления.ПрогнозыРейтингов.Стабильный;
				СтрокаАктивы.УровеньРейтинга = 1;
				СтрокаАктивы.СтрокаСопоставления = 1;
				СтрокаАктивы.ЗначениеРейтинга = "AAA(RU)";
				СтрокаАктивы.ПринадлежностьРейтинга = "Рейтинг эмитента";
				
			КонецЕсли;		
			
			Если Не ЭтоГосБумага Тогда
				ПараметрыНастройкиДляPDАктиваНаДату = ДокументНачисленияРезерва.ПолучитьНастройкиДляPDАктиваНаДату();
				ПараметрыНастройкиДляPDАктиваНаДату.ЕстьLGD = Истина;
				
				СтрокаАктивы.LGD = ДокументНачисленияРезерва.ПолучитьPDАктиваНаДату(НачалоДня(ЭтотОбъект.Период), СтрокаАктивы.ЦеннаяБумага, СтрокаАктивы.Эмитент, ТаблицаPD, ПараметрыНастройкиДляPDАктиваНаДату)/100;
				
				Если СтрокаАктивы.УровеньРейтинга = 100 И СтрокаАктивы.СтрокаСопоставления Тогда 
					//При отсутствии рейтинга эмитента/контрагента для контрагентов из группы КБ ожидаемый процент возврата (RR) определяется для категории
					// Speculative Grade от агентства Moody’s			
					СтрокаАктивы.LGD = 0.618;
				КонецЕсли;	
			КонецЕсли;
			
			СтрокаПрофсужденияПоPDLGD = ПрофсужденияПоPDLGD.Найти(СтрокаАктивы.ЦеннаяБумага); // проверим профсуждения
			Если СтрокаПрофсужденияПоPDLGD <> Неопределено Тогда
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаPD Тогда
					СтрокаАктивы.PD = СтрокаПрофсужденияПоPDLGD.PD;
				КонецЕсли;	
				Если СтрокаПрофсужденияПоPDLGD.ОценкаКредитногоРискаLGD Тогда
					СтрокаАктивы.LGD = СтрокаПрофсужденияПоPDLGD.LGD;
				КонецЕсли;	
				//СтрокаРасчетРезервов.Профсуждение = Истина;
			КонецЕсли;	
			
			СтрокаАктивы.EL = СтрокаАктивы.V * СтрокаАктивы.LGD * Окр(СтрокаАктивы.PD / 100, 15);
			
			// Переведем для кратосы LGD в %%
			СтрокаАктивы.LGD = СтрокаАктивы.LGD * 100;
			
		КонецЦикла;
	
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету ДУ '" + ЭтотОбъект.СчетДоверительногоУправления + "' формирование данного отчета не предусмотрено!");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаОтчета;

КонецФункции

Процедура СформироватьОповещение(ИдентификаторКоманды, ПараметрыКоманды)

	// Формируем на Т+2 от последнего дня предыдущей рабочей недели и на Т+2 от предыдущего месяца
	ДатаФормирования = НачалоДня(ТекущаяДата());
	
	КонецПредыдущейНедели = НачалоНедели(ДатаФормирования)-1;
	КонецПредыдущегоМесяца = НачалоМесяца(ДатаФормирования)-1;

	Календари = Справочники.Календари;
    Если ДатаФормирования = Календари.ДобавитьКДатеРабочиеДни(Календари.Общероссийский, КонецПредыдущейНедели, 2) Тогда
		ОтчетнаяДата = КонецПредыдущейНедели;
	ИначеЕсли ДатаФормирования = Календари.ДобавитьКДатеРабочиеДни(Календари.Общероссийский, КонецПредыдущегоМесяца, 2) Тогда
		ОтчетнаяДата = КонецПредыдущегоМесяца;
	Иначе
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", ЭтотОбъект.Организация);
	Отбор.Вставить("Клиент", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"));
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
		МенеджерВременныхТаблиц, ОтчетнаяДата, Отбор, "_СчетаДУ");
		
	Выборка = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(МенеджерВременныхТаблиц, "_СчетаДУ").Выбрать();
		
	ИтоговаяТаблица = Новый ТаблицаЗначений;
	ИтоговаяТаблица.Колонки.Добавить("НомерДоговора", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(70)));
	ИтоговаяТаблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ИтоговаяТаблица.Колонки.Добавить("ЗначениеEL", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,4)));
	ИтоговаяТаблица.Колонки.Добавить("Ограничение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,4)));
	ИтоговаяТаблица.Колонки.Добавить("НаличиеНарушений", Новый ОписаниеТипов("Булево"));
	
	НаличиеНарушений = Ложь;
	
	Пока Выборка.Следующий() Цикл
	
		ЭтотОбъект.СчетДоверительногоУправления = Выборка.Ссылка;
		ЭтотОбъект.Период = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
			ЭтотОбъект.Организация, 
			Выборка.Ссылка, 
			ОтчетнаяДата);
		
		ТаблицаОтчета = ПолучитьДанныеОтчета();
		
		Если ТаблицаОтчета <> Неопределено Тогда
		
			ДанныеПоСчетуДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.Ссылка, "НомерДоговора, ДатаЗаключения, Наименование");
			
			V = ТаблицаОтчета.Итог("V");
			EL = ТаблицаОтчета.Итог("EL");
			
			НоваяСтрока = ИтоговаяТаблица.Добавить();
			НоваяСтрока.НомерДоговора = ДанныеПоСчетуДУ.НомерДоговора;
			НоваяСтрока.Дата = ОтчетнаяДата;
			НоваяСтрока.ЗначениеEL = ?(V = 0, 0, EL/V*100);
			НоваяСтрока.Ограничение = 1;
			НоваяСтрока.НаличиеНарушений = НоваяСтрока.ЗначениеEL > НоваяСтрока.Ограничение;
			
			Если НоваяСтрока.НаличиеНарушений Тогда
				НаличиеНарушений = Истина;
			КонецЕсли;
		
		КонецЕсли;
		
	КонецЦикла;
	
	ИтоговаяТаблица.Сортировать("НаличиеНарушений Убыв, НомерДоговора");
	
	// Формируем оповещения
	Колонки = Новый Массив;
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "НомерДоговора", "Номер договора"));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "Дата", "Дата", "ДФ=dd.MM.yyyy"));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "ЗначениеEL", "Значение EL", "ЧЦ=10; ЧДЦ=4"));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "Ограничение", "Ограничение max (%)", "ЧЦ=10; ЧДЦ=4"));
	Колонки.Добавить(Новый Структура("Имя, Заголовок, Формат", "НаличиеНарушений", "Наличие нарушений", "БЛ=Нет; БИ=Да"));
	
	ЭлементыОтчета = Новый Массив;
	ЭлементыОтчета.Добавить(Новый Структура("Тип, Заголовок, Значение, Колонки", 
		"ТаблицаЗначений", 
		"Результат проверки по клиенту НПФ Национальный: " + Формат(НаличиеНарушений, "БЛ='НАРУШЕНИЙ НЕТ'; БИ='НАРУШЕНИЯ ВЫЯВЛЕНЫ'"), 
		ИтоговаяТаблица, 
		Колонки));

	РеквизитыОповещения = Новый Структура;
	РеквизитыОповещения.Вставить("Организация", ПараметрыКоманды.Организация);
	РеквизитыОповещения.Вставить("Текст", РаботаСОтчетами.СформироватьОтчетВHTML(ЭлементыОтчета));
	
	Справочники.Оповещения.СформироватьОповещения(
		"Обработка._ОтчетПоВероятнымПотерямНациональный." + ИдентификаторКоманды, 
		Перечисления.ТипыСобытий.ВнешнийВызов, 
		РеквизитыОповещения);

КонецПроцедуры
	
	
	