// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет по вероятным потерям (Национальный)",
		"0.07",
		,
		Истина);
	
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СформироватьОповещение", "Сформировать оповещение", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции 

// Интерфейс для запуска формирования отчетов по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(
		ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Если ИдентификаторКоманды = "СформироватьОповещение" Тогда
		СформироватьОповещение(ИдентификаторКоманды, ПараметрыКоманды);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный идентификатор команды '%1'", ИдентификаторКоманды);
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	УстановитьПривилегированныйРежим(Истина);	
	
	СтандартнаяОбработка = Ложь;
	
	ТаблицаОтчета = ПолучитьДанныеОтчета();
	
	Если ТаблицаОтчета <> Неопределено Тогда
	
		ВнешниеНаборыДанных = Новый Структура;
		ВнешниеНаборыДанных.Вставить("_ТаблицаОтчета", ТаблицаОтчета);
		
		ДополнительныеПараметры = Новый Структура("РегистрацияСтатистики", Ложь);
		
		// Выполняем программную компоновку
		РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка, , , , ВнешниеНаборыДанных, ДополнительныеПараметры);		
		
		ДокументРезультат.ПоказатьУровеньГруппировокСтрок(0);
	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СкомпоноватьРезультат(ДокументРезультат);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);

КонецПроцедуры

Функция ПолучитьДанныеОтчета()

	НастройкиУчета = БухгалтерскийУчет.ОпределитьНастройкиУчета(ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);
	
	ТаблицаОтчета = Новый ТаблицаЗначений;
	ТаблицаОтчета.Колонки.Добавить("ЦеннаяБумага");
	ТаблицаОтчета.Колонки.Добавить("Эмитент", Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	ТаблицаОтчета.Колонки.Добавить("LGD", Новый ОписаниеТипов("Число"));
	ТаблицаОтчета.Колонки.Добавить("PD", Новый ОписаниеТипов("Число"));
	ТаблицаОтчета.Колонки.Добавить("V", Новый ОписаниеТипов("Число"));
	ТаблицаОтчета.Колонки.Добавить("EL", Новый ОписаниеТипов("Число"));
	ТаблицаОтчета.Колонки.Добавить("ПрогнозРейтинга");
	ТаблицаОтчета.Колонки.Добавить("УровеньРейтинга", Новый ОписаниеТипов("Число"));
	ТаблицаОтчета.Колонки.Добавить("ЗначениеРейтинга", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25, ДопустимаяДлина.Переменная)));
	ТаблицаОтчета.Колонки.Добавить("ПринадлежностьРейтинга", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(25, ДопустимаяДлина.Переменная)));
	ТаблицаОтчета.Колонки.Добавить("СтрокаСопоставления");
	
	Если НастройкиУчета.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 Тогда
		
		ДокументНачисленияРезерва = Документы.НачислениеСписаниеРезервов.СоздатьДокумент();
		
		ДокументНачисленияРезерва.Дата = ЭтотОбъект.Период;
		ДокументНачисленияРезерва.Организация = ЭтотОбъект.Организация;
		ДокументНачисленияРезерва.СчетДоверительногоУправления = ЭтотОбъект.СчетДоверительногоУправления;
		ДокументНачисленияРезерва.ЦельРасчета = Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении;
		
		Если НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный Тогда
			
			Если НачалоДня(ЭтотОбъект.Период) >= Дата(2025, 03, 31) Тогда
				ТаблицаPD = ДокументНачисленияРезерва.ПолучитьТаблицуPD("НациональныйШкалаPD20250331");
			Иначе
				ТаблицаPD = ДокументНачисленияРезерва.ПолучитьТаблицуPD("НациональныйШкалаPD");
			КонецЕсли;
			
			НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
			Если НачалоДня(ЭтотОбъект.Период) >= '20250506' Тогда
				// Письмо №05-02-03/5@/01590-Исх от 6 мая 2025 г..
				ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = Истина;
			Иначе 	
				ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = Ложь;
			КонецЕсли;			
			
		ИначеЕсли НастройкиУчета.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.Национальный2025 Тогда
			
			НачислятьРезервНаДЗПоПогашениюКупонаТелаДивидендов	 = Истина;
			
			ДляДЗПоПогашениюКупонаТелаДивидендовИспользоватьРейтингЭмиссии = Истина;
			
			
			ТаблицаPD = ДокументНачисленияРезерва.ПолучитьТаблицуPD("НациональныйШкалаPD2025", , , Истина);
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету ДУ '" + ЭтотОбъект.СчетДоверительногоУправления + "' формирование данного отчета не предусмотрено!");
			Возврат Неопределено;
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		#Область Запрос
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаPD.РейтинговоеАгентство КАК РейтинговоеАгентство,
		|	ТаблицаPD.СтрокаРейтинга КАК СтрокаРейтинга,
		|	ТаблицаPD.PD КАК PD,
		|	ТаблицаPD.УровеньРейтинга КАК УровеньРейтинга
		|ПОМЕСТИТЬ _ТаблицаPD
		|ИЗ
		|	&ТаблицаPD КАК ТаблицаPD
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СтоимостьПереоценки.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета + СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК Стоимость
		|ПОМЕСТИТЬ _ЦенныеБумаги
		|ИЗ
		|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|ГДЕ
		|	СтоимостьПереоценки.Активность
		|	И СтоимостьПереоценки.Период = &День
		|	И СтоимостьПереоценки.Организация = &Организация
		|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
		|	И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|
		|СГРУППИРОВАТЬ ПО
		|	СтоимостьПереоценки.ЦеннаяБумага,
		|	СтоимостьПереоценки.ЦеннаяБумага.Эмитент.ЮрФизЛицо
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Документ.МНО)
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И (ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|					ИЛИ ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Справочник.Биржи))
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|					ИЛИ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|					ИЛИ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|					ИЛИ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации)
		|					ИЛИ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции))
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание
		|		ИНАЧЕ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики.Банк.ЮрФизЛицо
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДепозитныеВклады)
		|			ТОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики.БанковскийСчет.Банк.ЮрФизЛицо
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				И ТИПЗНАЧЕНИЯ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Документ.МНО)
