	|			ИЛИ _ЗадолженностьДляНарастающегоИтогаСНомеромКвартала.НомерКвартала = 3
	|			ИЛИ _ЗадолженностьДляНарастающегоИтогаСНомеромКвартала.НомерКвартала = 4)
	|
	|СГРУППИРОВАТЬ ПО
	|	_ЗадолженностьДляНарастающегоИтогаСНомеромКвартала.ДатаНарастающегоИтога
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ЗадолженностьСвернуто.ОтчетныйКвартал КАК ОтчетныйКвартал,
	|	_ЗадолженностьСвернуто.РасходыНаОценщиков КАК РасходыНаОценщиков,
	|	_ЗадолженностьСвернуто.РасходыБрокера КАК РасходыБрокера,
	|	_ЗадолженностьСвернуто.РасходыБиржи КАК РасходыБиржи,
	|	_ЗадолженностьСвернуто.РасходыНРД КАК РасходыНРД,
	|	_ЗадолженностьСвернуто.РасходыНаОплатуУслугСпецдепа КАК РасходыНаОплатуУслугСпецдепа,
	|	_ЗадолженностьСвернуто.РасходыБанка КАК РасходыБанка,
	|	_ЗадолженностьСвернуто.СуммаИтого КАК СуммаИтого,
	|	_ЗадолженностьНарастающимИтогом.РасходыНаОценщиков КАК РасходыНаОценщиков_Итоги,
	|	_ЗадолженностьНарастающимИтогом.РасходыБрокера КАК РасходыБрокера_Итоги,
	|	_ЗадолженностьНарастающимИтогом.РасходыБиржи КАК РасходыБиржи_Итоги,
	|	_ЗадолженностьНарастающимИтогом.РасходыНРД КАК РасходыНРД_Итоги,
	|	_ЗадолженностьНарастающимИтогом.РасходыНаОплатуУслугСпецдепа КАК РасходыНаОплатуУслугСпецдепа_Итоги,
	|	_ЗадолженностьНарастающимИтогом.РасходыБанка КАК РасходыБанка_Итоги,
	|	_ЗадолженностьНарастающимИтогом.РасходыНаОценщиков + _ЗадолженностьНарастающимИтогом.РасходыБрокера + _ЗадолженностьНарастающимИтогом.РасходыБиржи + _ЗадолженностьНарастающимИтогом.РасходыНРД + _ЗадолженностьНарастающимИтогом.РасходыНаОплатуУслугСпецдепа + _ЗадолженностьНарастающимИтогом.РасходыБанка КАК РасходыИтого_Итоги,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(_ЗадолженностьНарастающимИтогом.РасходыНаОценщиков / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыНаОценщиков,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(_ЗадолженностьНарастающимИтогом.РасходыБрокера / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыБрокера,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(_ЗадолженностьНарастающимИтогом.РасходыБиржи / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыБиржи,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(_ЗадолженностьНарастающимИтогом.РасходыНРД / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыНРД,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(_ЗадолженностьНарастающимИтогом.РасходыНаОплатуУслугСпецдепа / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыНаОплатуУслугСпецдепа,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(_ЗадолженностьНарастающимИтогом.РасходыБанка / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыБанка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(_СЧА.СЧА, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ((_ЗадолженностьНарастающимИтогом.РасходыНаОценщиков + _ЗадолженностьНарастающимИтогом.РасходыБрокера + _ЗадолженностьНарастающимИтогом.РасходыБиржи + _ЗадолженностьНарастающимИтогом.РасходыНРД + _ЗадолженностьНарастающимИтогом.РасходыНаОплатуУслугСпецдепа + _ЗадолженностьНарастающимИтогом.РасходыБанка) / _СЧА.СЧА * 100 КАК ЧИСЛО(19, 2))
	|	КОНЕЦ КАК Доля_РасходыИтого,
	|	_СЧА.ДатаСЧА КАК ДатаСЧА,
	|	_СЧА.СЧА КАК СЧА
	|ИЗ
	|	_ЗадолженностьСвернуто КАК _ЗадолженностьСвернуто
	|		ЛЕВОЕ СОЕДИНЕНИЕ _СЧА КАК _СЧА
	|		ПО _ЗадолженностьСвернуто.ОтчетныйКвартал = _СЧА.КонецКвартала
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностьНарастающимИтогом КАК _ЗадолженностьНарастающимИтогом
	|		ПО (КОНЕЦПЕРИОДА(_ЗадолженностьСвернуто.ОтчетныйКвартал, ГОД) = _ЗадолженностьНарастающимИтогом.ДатаНарастающегоИтога)
	|			И (КВАРТАЛ(_ЗадолженностьСвернуто.ОтчетныйКвартал) = _ЗадолженностьНарастающимИтогом.НомерКвартала)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОтчетныйКвартал";
	
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
						
		// Выводим в зависимости от флажка	
		Если Не ((Месяц(Выборка.ОтчетныйКвартал) = 12 И День(Выборка.ОтчетныйКвартал) = 31) Или (Выборка.ОтчетныйКвартал = КонецКвартала(Период.ДатаОкончания))) И Не ЭтотОбъект.ВыводитьПоКварталам Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ДатаСЧА) Или Выборка.ДатаСЧА = Дата(1, 1, 1) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует СЧА, соответствующая " + Формат(Выборка.ОтчетныйКвартал, "ДФ=dd.MM.yyyy"));
		КонецЕсли;	

		ОбластьСтрока.Параметры.Заполнить(Выборка);		
		ОбластьСтрока.Параметры.ДатаСЧА = Формат(Выборка.ДатаСЧА, "ДФ=dd.MM.yyyy");
		
		//Параметр ОтчетныйКвартал заполняем либо датой окончания отчета, либо берем из выборки
		Если Выборка.ОтчетныйКвартал = КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) И КонецДня(ЭтотОбъект.Период.ДатаОкончания) <> КонецКвартала(ЭтотОбъект.Период.ДатаОкончания) Тогда
			ОбластьСтрока.Параметры.ОтчетныйКвартал = Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		Иначе	
			ОбластьСтрока.Параметры.ОтчетныйКвартал = Формат(Выборка.ОтчетныйКвартал, "ДФ=dd.MM.yyyy");
		КонецЕсли;		
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Дополнительные_функции

Функция ПолучитьПараметрыШапки()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК ДоверительныйУправляющий,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторженияДоговора,
		|	РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу КАК УчредительУправления
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|			И (РеквизитыЮридическихЛицКлиента.Организация = &Организация)
		|			И (РеквизитыЮридическихЛицКлиента.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
		
КонецФункции
 
