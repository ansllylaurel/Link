#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет по расходам для стресс-теста",
		"0.13",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции
#КонецОбласти

#Область Формирование_отчета

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
		
	Если Не ПроверитьЗаполнение() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для формирования должны быть указаны счет ДУ и период отчета. Отчет не сформирован");
		Возврат;
	КонецЕсли;
		
	// Макет	
	Макет = ПолучитьМакет("Макет");
			
	СтандартнаяОбработка = Ложь;
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект,  "Период,Организация,СчетДоверительногоУправления");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Области = Новый Структура;
	Области.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));	
	Области.Вставить("Подвал", Макет.ПолучитьОбласть("Подвал"));
	
	// Шапка отчета
	
	ПараметрыШапки = ПолучитьПараметрыШапки();
	Области.Шапка.Параметры.Заполнить(ПараметрыШапки);
	
	ДополнительныеПараметрыШапки = Новый Структура;
	ДополнительныеПараметрыШапки.Вставить("ДатаДоговора",	Формат(ПараметрыШапки.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	ДополнительныеПараметрыШапки.Вставить("ДатаНачала", 	Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	ДополнительныеПараметрыШапки.Вставить("ДатаОкончания", 	Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
				
	Области.Шапка.Параметры.Заполнить(ДополнительныеПараметрыШапки);
	
	ДокументРезультат.Вывести(Области.Шапка);
		
	// Тело отчета
	ВывестиТелоОтчета(ДокументРезультат, Макет, ПараметрыШапки.ДатаДоговора, ПараметрыШапки.ДатаРасторженияДоговора);
	
	// Подвал отчета		
	ДокументРезультат.Вывести(Области.Подвал);
	
	// Подписи	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	//ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли; 
	
	РаботаСОтчетами.ВывестиПодписи(ДокументРезультат, ПараметрыВыводаПодписей);		
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение операции	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	ЭтотОбъект.Период = НастройкиОтчета.Период.ДатаОкончания;
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ПриКомпоновкеРезультата(ДокументРезультат, Неопределено, Ложь);
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

Процедура ВывестиТелоОтчета(ДокументРезультат, Макет, ДатаЗаключения, ДатаРасторжения)	
	
	ПериодСбораДанныхНачало = ?(ДатаЗаключения >= Период.ДатаНачала, ДатаЗаключения, Период.ДатаНачала);
	
	Если Не ДатаРасторжения = Дата(1, 1, 1) Тогда
		ПериодСбораДанныхОкончание = ?(ДатаРасторжения >= Период.ДатаОкончания, Период.ДатаОкончания, ДатаРасторжения);
	Иначе
		ПериодСбораДанныхОкончание = Период.ДатаОкончания;
	КонецЕсли;
	
	ОтсутствуютНастройкиСЧА = Ложь;
	МассивДатСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(СчетДоверительногоУправления, ПериодСбораДанныхНачало, КонецДня(ПериодСбораДанныхОкончание),,ОтсутствуютНастройкиСЧА);
	
	Если ОтсутствуютНастройкиСЧА Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного счета ДУ отсутствуют настройки формирования СЧА на период отчета. Отчет не сформирован");	
		Возврат;
	КонецЕсли;
	
	//// Проверим существование настроек формирования СЧА на ближайший рабочий день от ПериодСбораДанныхНачало
	//НайдЗначение = МассивДатСЧА.Найти(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ПериодСбораДанныхНачало, 1));
	//Если НайдЗначение = Неопределено Тогда
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранного счета ДУ отсутствуют настройки формирования СЧА на начало периода отчета. Отчет не сформирован");	
	//	Возврат;
	//КонецЕсли;
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатыСЧА",						МассивДатСЧА);
	Запрос.УстановитьПараметр("Организация",    				Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода", 					ПериодСбораДанныхНачало);
	Запрос.УстановитьПараметр("КонецПериода", 					КонецДня(ПериодСбораДанныхОкончание));
	
	СписокВидовЗадолженности = Новый Массив;
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаЗаПереводДС);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоБанковскойКомиссии); // Устаревший
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.РасходыПоУслугамДепозитария);
	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии); // Устаревший

	СписокВидовЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПрочимУслугам);
		
	Запрос.УстановитьПараметр("СписокВидовЗадолженности", 	СписокВидовЗадолженности);
	
	// Убрать хардкод. Сделать именованный объект?
	Запрос.УстановитьПараметр("РасходыНаОценщиков",			Справочники.ПрочиеДоходыИРасходы.НайтиПоКоду("000189"));
		
	#Область Текст_Запроса
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ДатаСЧА,
	|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, КВАРТАЛ) КАК КонецКвартала
	|ПОМЕСТИТЬ _ДатыСЧАНаКонецКвартала
	|ИЗ
	|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
	|ГДЕ
	|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
	|	И ДанныеКалендаря.Дата В (&ДатыСЧА)
	|
	|СГРУППИРОВАТЬ ПО
	|	КОНЕЦПЕРИОДА(ДанныеКалендаря.Дата, КВАРТАЛ)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДатаСЧА,
	|	КонецКвартала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Валюта КАК Валюта,
	|	КурсыВалют.Курс / КурсыВалют.Кратность КАК Курс
	|ПОМЕСТИТЬ _КурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК ВидЗадолженности,
	|	ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	КОНЕЦПЕРИОДА(ЗадолженностиПоДенежнымСредствамОбороты.Период, КВАРТАЛ) КАК ОтчетныйКвартал,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОбороты.Основание) = ТИП(Документ.НачислениеЗадолженности)
	|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Документ.НачислениеЗадолженности).ПрочиеДоходыИРасходы
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.)
	|	КОНЕЦ КАК ПрочийРасход,
	|	ЗадолженностиПоДенежнымСредствамОбороты.Контрагент КАК Контрагент,
	|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход * _КурсыВалют.Курс) КАК Сумма
	|ПОМЕСТИТЬ _Задолженность
	|ИЗ
	|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			КВАРТАЛ,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
	|				И ВидЗадолженности В (&СписокВидовЗадолженности)) КАК ЗадолженностиПоДенежнымСредствамОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ _КурсыВалют КАК _КурсыВалют
	|		ПО (НАЧАЛОПЕРИОДА(ЗадолженностиПоДенежнымСредствамОбороты.Основание.Дата, ДЕНЬ) = _КурсыВалют.Период)
	|			И ЗадолженностиПоДенежнымСредствамОбороты.Валюта = _КурсыВалют.Валюта
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности,
	|	ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления,
	|	ЗадолженностиПоДенежнымСредствамОбороты.Контрагент,
	|	КОНЕЦПЕРИОДА(ЗадолженностиПоДенежнымСредствамОбороты.Период, КВАРТАЛ),
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОбороты.Основание) = ТИП(Документ.НачислениеЗадолженности)
	|			ТОГДА ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Документ.НачислениеЗадолженности).ПрочиеДоходыИРасходы
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ДатыСЧАНаКонецКвартала.ДатаСЧА КАК ДатаСЧА,
	|	_ДатыСЧАНаКонецКвартала.КонецКвартала КАК КонецКвартала,
	|	ФинансовыеПоказатели.Значение КАК СЧА
	|ПОМЕСТИТЬ _СЧА
	|ИЗ
	|	_ДатыСЧАНаКонецКвартала КАК _ДатыСЧАНаКонецКвартала
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
	|		ПО _ДатыСЧАНаКонецКвартала.ДатаСЧА = ФинансовыеПоказатели.Период
	|ГДЕ
	|	ФинансовыеПоказатели.Организация = &Организация
	|	И (ВЫРАЗИТЬ(ФинансовыеПоказатели.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления)) = &СчетДоверительногоУправления
	|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
