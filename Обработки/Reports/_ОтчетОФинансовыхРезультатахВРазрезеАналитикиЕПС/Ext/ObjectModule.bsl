		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних_АналитикаПроцентов.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN_АналитикаПроцентов
		|		ПО (_ИтоговаяТаблица.АналитикаПроцентов = КодыВТорговыхСистемахСрезПоследнихISIN.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних_АналитикаПроцентов
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(_ИтоговаяТаблица.АналитикаПроцентов) = ТИП(Справочник.Паи)
		|					ТОГДА ВЫРАЗИТЬ(_ИтоговаяТаблица.АналитикаПроцентов КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних_АналитикаПроцентов.ПаевойИнвестиционныйФонд
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&КонецПериода, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ_АналитикаПроцентов
		|		ПО _ИтоговаяТаблица.АналитикаПроцентов = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ_АналитикаПроцентов.Объект";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьДанныеОрганизации()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыОрганизацийСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо = &ЮрФизЛицоОрганизации) КАК РеквизитыОрганизацийСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ЮрФизЛицоОрганизации", ЭтотОбъект.Организация.ЮрФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат ВыборкаДетальныеЗаписи.НаименованиеОрганизации;
		
	КонецЕсли;

КонецФункции

Функция ПолучитьДанныеШапки(МассивСчетовДУ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _КлиентДУ
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&МассивСчетовДУ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентДУ.НомерДоговора КАК НомерДоговора,
		|	_КлиентДУ.ДатаЗаключения КАК ДатаДоговора,
		|	РеквизитыКлиентаСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеСчетаДУ
		|ИЗ
		|	_КлиентДУ КАК _КлиентДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиентаСрезПоследних
		|		ПО _КлиентДУ.Клиент = РеквизитыКлиентаСрезПоследних.ЮрФизЛицо";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
 
Функция ПолучитьДоступныеНастройки() Экспорт

    Настройки = Новый Массив;
    Настройки.Добавить("ВариантОпределенияНачальнойДаты");
    Настройки.Добавить("ВариантОтчета");
    Настройки.Добавить("Подписант");
    Настройки.Добавить("ПутьКФайлу");
    Настройки.Добавить("СрокПредоставления");
    Настройки.Добавить("АвтоматическаяОтправка");
    Настройки.Добавить("АдресЭлектроннойПочты");
    Настройки.Добавить("АдресОтправителя");
	Настройки.Добавить("НеСворачиватьДоходыРасходыОтРеализации");
	Настройки.Добавить("НеСворачиватьДоходыРасходыОтПереоценки");

    Возврат Настройки;
	
КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
                
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ВыводитьЦБиПроценты = СтрНачинаетсяС(Справочники.ВариантыОтчетов.ПолучитьСсылку(НастройкиОтчета.ВариантОтчета).Наименование, "Правильные");
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("ВыводитьЦБиПроценты", ВыводитьЦБиПроценты);
	
	Если КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество()>0 Тогда
		КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();	
	КонецЕсли;	
	
	ДокументРезультат = Новый ТабличныйДокумент;
    ПриКомпоновкеРезультата(ДокументРезультат, Неопределено, Ложь);
    НастройкиОтчета.Вставить("Результат", ДокументРезультат);

КонецПроцедуры
