// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о финансовых результатах в разрезе аналитики (ЕПС)",
		"1.47",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция НайтиИдНастройки(Знач Настройки, ПредставлениеНастройки)
	
	Результат = Неопределено;	
	Для Каждого Элемент из Настройки Цикл 
		Если Элемент.ПредставлениеПользовательскойНастройки = ПредставлениеНастройки Тогда 
			Результат = Элемент.ИдентификаторПользовательскойНастройки;
		КонецЕсли;	
		Если Результат = Неопределено Тогда 
			Если Элемент.Структура <> Неопределено Тогда 
				Результат = НайтиИдНастройки(Элемент.Структура, ПредставлениеНастройки);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции	

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	МассивСчетовДУ = Новый Массив;
	МассивСчетовДУ.Добавить(ЭтотОбъект.СчетДоверительногоУправления);
	
	Для Каждого Элемент из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл 
		Если (Найти(Элемент.ЛевоеЗначение, "СчетДоверительногоУправления") = 1) Тогда 			
			Элемент.Использование = Ложь;
			МассивСчетовДУ = Элемент.ПравоеЗначение.ВыгрузитьЗначения();
		КонецЕсли;
	КонецЦикла;	
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	ВыводитьЦБиПроценты = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("ВыводитьЦБиПроценты", ВыводитьЦБиПроценты);
	
	Если ВыводитьЦБиПроценты <> Неопределено И ВыводитьЦБиПроценты Тогда
	
		ИдВыводитьЦБ = НайтиИдНастройки(Настройки.Структура, "Выводить ценные бумаги");
		ПараметрПользовательскойНастройки = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдВыводитьЦБ);	
		ПараметрПользовательскойНастройки.Использование = Истина;
		
		ИдВыводитьПроценты = НайтиИдНастройки(Настройки.Структура, "Выводить ценные бумаги (проценты к получению)");
		ПараметрПользовательскойНастройки = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ИдВыводитьПроценты);	
		ПараметрПользовательскойНастройки.Использование = Истина;
	
	КонецЕсли;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", 				Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yyyy"));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", 				Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеОрганизации", 	ПолучитьДанныеОрганизации());
	
	ДанныеШапки = ПолучитьДанныеШапки(МассивСчетовДУ);
	Если ДанныеШапки.Количество() = 1 Тогда
	
		НаименованиеСчетаДУ = ДанныеШапки[0].НаименованиеСчетаДУ;
		ДанныеДоговоров = "Отчет о финансовых результатах в разрезе аналитики по договору доверительного управления №" + ДанныеШапки[0].НомерДоговора + " от " + Формат(ДанныеШапки[0].ДатаДоговора, "ДФ=dd.MM.yyyy");
	    
	Иначе
		
		НаименованиеСчетаДУ = "";
		ДанныеДоговоров = "Отчет о финансовых результатах в разрезе аналитики по договорам доверительного управления ";
		Для каждого СтрокаДанныеШапки Из ДанныеШапки Цикл
			НаименованиеСчетаДУ = СтрокаДанныеШапки.НаименованиеСчетаДУ;
			ДанныеДоговоров = ДанныеДоговоров + "№" + СтрокаДанныеШапки.НомерДоговора + " от " + Формат(СтрокаДанныеШапки.ДатаДоговора, "ДФ=dd.MM.yyyy") + ",";
		
		КонецЦикла;
		ДанныеДоговоров = Лев(ДанныеДоговоров, СтрДлина(ДанныеДоговоров) - 1);
		
	КонецЕсли;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеСчетаДУ",	НаименованиеСчетаДУ);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДанныеДоговоров",		ДанныеДоговоров);
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
	
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);
	
	КонецЕсли; 
	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка, ПараметрыВыводаПодписей,,, Новый Структура("ТаблицаОтчета", СформироватьТаблицуОтчета(МассивСчетовДУ)));
	
КонецПроцедуры

Функция СформироватьТаблицуОтчета(МассивСчетовДУ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РаботаСОтчетами.ДополнитьТекстЗапросаДляОтчетаОФинансовыхРезультатахВРазрезеАналитики(Запрос);
	
	Запрос.Текст = Запрос.Текст + ПолучитьТекстЗапроса();
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СчетДоверительногоУправления = &СчетДоверительногоУправления", "СчетДоверительногоУправления В (&МассивСчетовДУ)");
	
	Запрос.УстановитьПараметр("НачалоПериода", 	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", 	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("СворачиватьДоходыРасходыОтРеализации", НЕ ЭтотОбъект.НеСворачиватьДоходыРасходыОтРеализации);
	Запрос.УстановитьПараметр("СворачиватьДоходыРасходыОтПереоценки", НЕ ЭтотОбъект.НеСворачиватьДоходыРасходыОтПереоценки);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТекстЗапроса() Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Перенос переоценки в состав прибыли или убытка для ценных бумаг в наличии для продажи или оцениваемых через прочий совокупный доход"" КАК РазделОтчета,
		|	ЕСТЬNULL(ОборотыРасходы.СубконтоДт1, ОборотыДоходы.СубконтоКт1) КАК Аналитика,
		|	0 КАК СтоимостьАктивов,
		|	0 КАК Расходы,
		|	ЕСТЬNULL(ОборотыРасходы.СуммаОборот, 0) КАК ПрочиеРасходы,
		|	ЕСТЬNULL(ОборотыРасходы.СуммаОборот, 0) КАК ИтогоРасходы,
		|	0 КАК Доход,
		|	ЕСТЬNULL(ОборотыДоходы.СуммаОборот, 0) КАК ПрочиеДоходы,
		|	ЕСТЬNULL(ОборотыДоходы.СуммаОборот, 0) КАК ИтогоДоходы
		|ПОМЕСТИТЬ _ПереносПереоценки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОборотыДтКт(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			,
		|			СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций))
		|				И СчетДт <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций11)
		|				И СчетДт <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций12),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|			СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДобавочныйКапитал)),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОборотыРасходы
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.ОборотыДтКт(
		|				&НачалоПериода,
		|				&КонецПериода,
		|				,
		|				СчетДт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДобавочныйКапитал)),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|				СчетКт В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций))
		|					И СчетКт <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций11)
		|					И СчетКт <> ЗНАЧЕНИЕ(ПланСчетов.Единый.ДоходыРасходыОтОпераций12),
		|				ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОборотыДоходы
		|		ПО ОборотыРасходы.СубконтоДт1 = ОборотыДоходы.СубконтоКт1
		|;
