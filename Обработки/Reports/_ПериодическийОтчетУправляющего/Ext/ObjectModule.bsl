
#Область Регистрация_отчета

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Периодический отчет управляющего",
		"1.23",
		"",
		Истина
	);
	
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
КонецФункции

#КонецОбласти

#Область Обработчики_событий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ (ЭтотОбъект.ВыводитьБалансовуюСтоимость ИЛИ ЭтотОбъект.ВыводитьРыночнуюСтоимость) Тогда
		
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран вариант отчета",, "Отчет.ВыводитьБалансовуюСтоимость",, Отказ);
	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Автоматическое_формирование

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("РежимВыводаДвиженийИОстатков");
	Настройки.Добавить("РежимВыводаСтоимости");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("АвтоматическаяОтправка");
	Настройки.Добавить("АдресЭлектроннойПочты");
	Настройки.Добавить("АдресОтправителя");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.НачалоПериода = НастройкиОтчета.Период.ДатаНачала; 
	ЭтотОбъект.КонецПериода = НастройкиОтчета.Период.ДатаОкончания; 
	
	РежимВыводаСтоимости = Неопределено;
	РежимВыводаСтоимости = ?(НастройкиОтчета.Свойство("РежимВыводаСтоимости", РежимВыводаСтоимости), РежимВыводаСтоимости, "0");
	
	ЭтотОбъект.ВыводитьБалансовуюСтоимость = (РежимВыводаСтоимости = "0");
	ЭтотОбъект.ВыводитьРыночнуюСтоимость   = (РежимВыводаСтоимости = "1");
	
	ДокументРезультат = Новый ТабличныйДокумент;
	СформироватьОтчет(ДокументРезультат);
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

#КонецОбласти

#Область Формирование_отчета

Функция ПолучитьОстаткиДС(Период, УБрокера = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	СУММА(ОстаткиДенежныхСредствОстатки.СуммаОстаток) КАК СуммаОстаток
		|ПОМЕСТИТЬ ОстаткиДС
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И &БрокерРС) КАК ОстаткиДенежныхСредствОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиДенежныхСредствОстатки.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДС.Валюта КАК Валюта,
		|	КурсыВалютСрезПоследних.Курс КАК Курс,
		|	ОстаткиДС.СуммаОстаток КАК СуммаВалюта,
		|	ОстаткиДС.СуммаОстаток * КурсыВалютСрезПоследних.Курс * КурсыВалютСрезПоследних.Кратность КАК СуммаРубли
		|ИЗ
		|	ОстаткиДС КАК ОстаткиДС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Период, ) КАК КурсыВалютСрезПоследних
		|		ПО ОстаткиДС.Валюта = КурсыВалютСрезПоследних.Валюта";
		
	Если УБрокера Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БрокерРС", "НЕ Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БрокерРС", "Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)");
	КонецЕсли;		
		
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьЗадолженностиДС(Период)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ВЫБОР
		|					КОГДА НЕ &ВыводитьРыночнуюСтоимость
		|							И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.НачислениеДивидендов)
		|						ТОГДА ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток, 0)
		|					ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДСОжидаемые,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДСБлокированные,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ВводЦенныхБумаг)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.НачислениеЗадолженности)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.Сделка)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.СделкаРЕПО)
		|				ИЛИ ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.СделкаСВалютой)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.НачислениеДивидендов)
		|			ТОГДА ""Дивиденды "" + ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага.Эмитент.Наименование + "", "" + ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|						ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага.ГосударственныйРегистрационныйНомер
		|					КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|						ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага.ГосударственныйРегистрационныйНомер
		|					КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|						ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага.РегистрационныйНомер
		|				КОНЕЦ
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ПогашениеКупона)
		|			ТОГДА ""Купон "" + ЗадолженностиПоДенежнымСредствамОстатки.Основание.Облигация.Эмитент.Наименование + "", "" + ЗадолженностиПоДенежнымСредствамОстатки.Основание.Облигация.ГосударственныйРегистрационныйНомер
		|		КОГДА ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствамОстатки.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|			ТОГДА ""Облигация "" + ЗадолженностиПоДенежнымСредствамОстатки.Основание.ЦеннаяБумага.Эмитент.Наименование
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДСОписание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание
		|ПОМЕСТИТЬ ЗадолженностиДС
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И (ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|						И ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии)
		|						И НЕ ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия))
		|					ИЛИ ВЫРАЗИТЬ(Основание КАК Документ.Сделка).МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|					ИЛИ ВЫРАЗИТЬ(Основание КАК Документ.НачислениеЗадолженности).МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))
		|				И ВЫБОР
		|					КОГДА &ВыводитьРыночнуюСтоимость = ИСТИНА
		|						ТОГДА ТИПЗНАЧЕНИЯ(Основание) <> ТИП(Документ.НачислениеДивидендов)
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|				&Период,
		|				Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами47),
		|				,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ПО (ЕдиныйБухгалтерскийУчетОстатки.Субконто1 = ЗадолженностиПоДенежнымСредствамОстатки.Контрагент)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЗадолженностиДС.ДСОжидаемые) КАК ДСОжидаемые,
		|	СУММА(ЗадолженностиДС.ДСБлокированные) КАК ДСБлокированные,
		|	ЗадолженностиДС.ДСОписание КАК ДСОписание
		|ИЗ
		|	ЗадолженностиДС КАК ЗадолженностиДС
		|ГДЕ
		|	(ЗадолженностиДС.ДСОжидаемые <> 0
		|			ИЛИ ЗадолженностиДС.ДСБлокированные <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиДС.ДСОписание
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток),
		|	СУММА(0),
		|	""% по банковским вкладам "" + ЕдиныйБухгалтерскийУчетОстатки.Субконто1.Наименование
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Документ.МНО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	НЕ &ВыводитьРыночнуюСтоимость
		|	И ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	""% по банковским вкладам "" + ЕдиныйБухгалтерскийУчетОстатки.Субконто1.Наименование";

	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВыводитьРыночнуюСтоимость", 		ЭтотОбъект.ВыводитьРыночнуюСтоимость);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьОстаткиАкции(Период, ПериодДата)
	ТЗРезультат = Новый ТаблицаЗначений;
	КЧ = Новый КвалификаторыЧисла(15, 2);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ТЗРезультат.Колонки.Добавить("Сумма", Новый ОписаниеТипов(МассивТипов, , КЧ));
	ТЗРезультат.Колонки.Добавить("СуммаРынок", Новый ОписаниеТипов(МассивТипов, , КЧ));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
