		Или ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний
	Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "MARKETPRICE3", "MARKETPRICE2");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("ПериодДата",						ПериодДата);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Биржа",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);
	Запрос.УстановитьПараметр("ВалютаУчета",					ПараметрыСеанса.ТекущаяОрганизация.ВалютаУчета);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	РезультатОстаткиЦБ = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_РезультатОстаткиЦБ",,,, "Эмитент");
	Если РезультатОстаткиЦБ.Пустой() Тогда
		Возврат ТЗРезультат;
	КонецЕсли;
	
	ТаблицаПаев = РезультатОстаткиЦБ.Выгрузить();
	// Для рыночной стоимости требуется доп. обработка результата
	РезультатЦенныеБумаги = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_РезультатЦенныеБумаги");
	ЦенныеБумаги = РезультатЦенныеБумаги.Выгрузить();
	
	Объект = Новый Структура;
	Объект.Вставить("СчетДоверительногоУправления",		ЭтотОбъект.СчетДоверительногоУправления);
	Объект.Вставить("ВариантРасчетаОценочнойСтоимости",	Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений);
	Объект.Вставить("Организация",						ЭтотОбъект.Организация);
	Объект.Вставить("ВидУчета",							Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Объект.Вставить("Дата",								НачалоДня(ПериодДата));
	Объект.Вставить("ЦенныеБумаги",						ЦенныеБумаги);
	Объект.Вставить("ЦельРасчета",						Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	Отказ = Ложь;
	РаботаСПереоценкой.ЗаполнитьКотировки(Объект,,, Отказ);
	
	ТаблицаЦен = Объект.ЦенныеБумаги;
	ТаблицаЦен.Свернуть("ЦеннаяБумага, ИсточникЦены, ОценочнаяЦена");
	
	Для Каждого СтрокаПая Из ТаблицаПаев Цикл
		НайденныеСтроки = ТаблицаЦен.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаПая.ЦеннаяБумага));
		Если НайденныеСтроки.Количество() = 1 Тогда
			Котировка = НайденныеСтроки[0].ОценочнаяЦена;
			РыночнаяБезНКД = Окр(СтрокаПая.Количество * Котировка, 2);
			СтрокаПая.СуммаРынок = РыночнаяБезНКД;
			
			НКД = ?(ЗначениеЗаполнено(СтрокаПая.КупонРынок),
				СтрокаПая.КупонРынок,
				СтрокаПая.Количество * РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(СтрокаПая.ЦеннаяБумага, ПериодДата, ЭтотОбъект.СчетДоверительногоУправления));
			СтрокаПая.КупонРынок = НКД;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаПаев;
КонецФункции

Функция ПолучитьОстаткиДоли(Период, ПериодДата)

	//т.к. доли по партиям не учитываются, и по НПФам их не бывает, то вернем пустую таблицу
	
	ТЗРезультат = Новый ТаблицаЗначений;

	КЧ = Новый КвалификаторыЧисла(15,2);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	ТЗРезультат.Колонки.Добавить("Сумма", Новый ОписаниеТипов(МассивТипов, , КЧ));
	ТЗРезультат.Колонки.Добавить("СуммаРынок", Новый ОписаниеТипов(МассивТипов, , КЧ));
	
	Возврат ТЗРезультат;
	
КонецФункции

Функция ПолучитьОстаткиОблигации(Период, ПериодДата)
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
