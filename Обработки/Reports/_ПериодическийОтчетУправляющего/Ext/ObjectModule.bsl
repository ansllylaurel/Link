Процедура ВывестиСделки(ТабДок, МакетПодраздел, ТипСделок = "Сделки") // также "РЕПОАдресные", "РЕПОБезадресные", "РПС", "Тикеты"

	РаботаСОтчетами.КонтрольВалютыРасходовПоСделкамОтличнойОтВалютыУчета(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.НачалоПериода, ЭтотОбъект.КонецПериода);
	
	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|				ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КомиссияБиржи,
		|	СУММА(ВЫБОР
		|			КОГДА ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|				ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КомиссияБрокера,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание КАК Основание
		|ПОМЕСТИТЬ _ЗадолженностиПоКомиссиям
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии))) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗадолженностиПоДенежнымСредствамОбороты.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА РеквизитыЭмитента.ПолноеНаименованиеПоУставу
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА РеквизитыЭмитента.ПолноеНаименованиеПоУставу
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА РеквизитыЭмитента.ПолноеНаименованиеПоУставу
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ДатаРегистрации
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).ДатаСоставления
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ДатаРегистрации
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ДатаРегистрации
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДатаВыпуска,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ДатаАннулирования
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).ДатаПогашения
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ДатаПогашения
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА """"
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДатаПогашения,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ""акция""
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ""вексель""
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ""облигация""
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ""пай""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Вид,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА СделкаЦенныеБумаги.ЦеннаяБумага.Тип
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА СделкаЦенныеБумаги.ЦеннаяБумага.Тип
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА СделкаЦенныеБумаги.ЦеннаяБумага.ТипВекселя
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЦБ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК РегНомер,
		|	СделкаДокумент.Дата КАК ДатаСделки,
		|	СделкаДокумент.ВидСделки КАК ВидСделки,
		|	СделкаДокумент.МестоХранения КАК МестоЗаключения,
		|	СделкаЦенныеБумаги.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Номинал
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Номинал
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал
		|		КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА """"
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Номинал,
		|	СделкаЦенныеБумаги.Цена КАК Цена,
		|	СделкаЦенныеБумаги.Сумма КАК Сумма,
		|	СделкаЦенныеБумаги.СуммаКупона КАК НКД,
		|	_ЗадолженностиПоКомиссиям.КомиссияБиржи КАК КомиссияБиржи,
		|	_ЗадолженностиПоКомиссиям.КомиссияБрокера КАК КомиссияБрокера,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплаты,
		|	УсловияСделокСрезПоследних.ДатаПоставки КАК ДатаПоставки,
		|	УсловияСделокСрезПоследних.ДатаОплаты КАК ДатаОплатыПлан,
		|	УсловияСделокСрезПоследних.ДатаПоставки КАК ДатаПоставкиПлан,
		|	ПлановыеДатыОплатПоТорговойКомиссии.ДатаОплаты КАК ДатаОплатыКомиссииБиржи,
		|	ПлановыеДатыОплатПоБрокерскойКомиссии.ДатаОплаты КАК ДатаОплатыКомиссииБрокера,
		|	СделкаДокумент.Контрагент КАК Контрагент,
		|	СделкаДокумент.НомерСделки КАК НомерСделки,
		|	&ПоляРЕПО КАК ПоляРЕПО,
		|	&ПоляРПС КАК ПоляРПС
		|ИЗ
		|	Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Сделка КАК СделкаДокумент
		|		ПО СделкаЦенныеБумаги.Ссылка = СделкаДокумент.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(КОНЕЦПЕРИОДА(&КонецПериодаДата, ДЕНЬ), ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО СделкаЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериодаДата, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				КОНЕЦПЕРИОДА(&КонецПериодаДата, ДЕНЬ),
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЭмитента
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|					ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|					ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|					ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(СделкаЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|					ТОГДА """"
		|			КОНЕЦ = РеквизитыЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделок.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокСрезПоследних
		|		ПО СделкаЦенныеБумаги.Ссылка = УсловияСделокСрезПоследних.Сделка
		|			И СделкаЦенныеБумаги.ЦеннаяБумага = УсловияСделокСрезПоследних.ЦеннаяБумага
		|			И (&УсловиеРЕПО)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК ПлановыеДатыОплатПоТорговойКомиссии
		|		ПО (УсловияСделокСрезПоследних.Сделка = ПлановыеДатыОплатПоТорговойКомиссии.Основание)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлановыеДатыОплат.СрезПоследних(
		|				&КонецПериода,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)) КАК ПлановыеДатыОплатПоБрокерскойКомиссии
		|		ПО (УсловияСделокСрезПоследних.Сделка = ПлановыеДатыОплатПоБрокерскойКомиссии.Основание)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗадолженностиПоКомиссиям КАК _ЗадолженностиПоКомиссиям
		|		ПО СделкаЦенныеБумаги.Ссылка = _ЗадолженностиПоКомиссиям.Основание
		|			И (&БумагиРЕПО)
		|ГДЕ
		|	СделкаДокумент.Проведен = ИСТИНА
		|	И СделкаДокумент.Организация = &Организация
		|	И СделкаДокумент.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаДокумент.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериодаДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериодаДата, ДЕНЬ)
		|	И &УсловиеМестоХранения
		|	И &УсловиеВидСделки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСделки";
	
	#КонецОбласти
	
	Если ТипСделок = "Сделки" Тогда
			
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения", 	"НЕ СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидСделки", 		"НЕ СделкаДокумент.РежимБиржевыхТоргов.РежимПереговорныхСделок");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРЕПО", 				"NULL");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРПС", 				"NULL");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (&БумагиРЕПО)", 		"");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеРЕПО", 			"ИСТИНА");
	
	ИначеЕсли ТипСделок = "РЕПО" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения", 				"НЕ СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидСделки", 					"СделкаДокумент.ЧастьСделкиРЕПО = 1");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделка", 								"СделкаРЕПО");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СделкаРЕПОСЦентральнымКонтрагентом", 	"СделкаСЦентральнымКонтрагентом");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Сделок", "СделокРЕПО");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРЕПО КАК ПоляРЕПО",
			"СделкаРЕПОДокумент.ДатаПоставкиВторойЧасти КАК ДатаПоставкиЧ2План
			|,СделкаРЕПОДокумент.ДатаОплатыВторойЧасти КАК ДатаОплатыЧ2План
			|,СделкаРЕПОДокумент.СтавкаРЕПО КАК СтавкаРЕПО
			|,СделкаРЕПОЦенныеБумагиВторойЧасти.Цена КАК ЦенаЧ2
			|,СделкаРЕПОЦенныеБумагиВторойЧасти.Сумма КАК СуммаЧ2
			|,СделкаРЕПОЦенныеБумагиВторойЧасти.СуммаКупона КАК НКДЧ2
			|,УсловияСделокРЕПОСрезПоследнихЧ2.ДатаОплаты КАК ДатаОплатыЧ2
			|,УсловияСделокРЕПОСрезПоследнихЧ2.ДатаПоставки КАК ДатаПоставкиЧ2");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (&БумагиРЕПО)",
			"ЛЕВОЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО.ЦенныеБумагиВторойЧасти КАК СделкаРЕПОЦенныеБумагиВторойЧасти 
			|ПО СделкаРЕПОЦенныеБумаги.Ссылка = СделкаРЕПОЦенныеБумагиВторойЧасти.Ссылка
			|	И СделкаРЕПОЦенныеБумаги.ЦеннаяБумага = СделкаРЕПОЦенныеБумагиВторойЧасти.ЦеннаяБумага
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(&КонецПериода, Организация = &Организация) КАК УсловияСделокРЕПОСрезПоследнихЧ2
			|ПО СделкаРЕПОЦенныеБумаги.Ссылка = УсловияСделокРЕПОСрезПоследнихЧ2.СделкаРЕПО
			|	И СделкаРЕПОЦенныеБумаги.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследнихЧ2.ЦеннаяБумага
			|	И УсловияСделокРЕПОСрезПоследнихЧ2.ЧастьСделкиРЕПО = 2");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРПС", 		"NULL");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеРЕПО", 	"УсловияСделокРЕПОСрезПоследних.ЧастьСделкиРЕПО = 1");
		
	ИначеЕсли ТипСделок = "РПС" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения", 	"НЕ СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидСделки", 		"СделкаДокумент.РежимБиржевыхТоргов.РежимПереговорныхСделок");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРЕПО", 				"NULL");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРПС КАК ПоляРПС", 	"ВЫБОР КОГДА СделкаДокумент.РежимБиржевыхТоргов.ПервичноеРазмещение ТОГДА ""V"" ИНАЧЕ """" КОНЕЦ КАК ПервичноеРазмещение");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (&БумагиРЕПО)", 		"");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеРЕПО", 			"ИСТИНА");
		
	ИначеЕсли ТипСделок = "Тикеты" Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМестоХранения", 	"СделкаДокумент.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидСделки", 		"ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРЕПО", 				"NULL");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПоляРПС", 				"NULL");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И (&БумагиРЕПО)", 		"");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеРЕПО", 			"ИСТИНА");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода", 					Новый Граница(НачалоДня(ЭтотОбъект.НачалоПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", 					Новый Граница(КонецДня(ЭтотОбъект.КонецПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериодаДата", 				ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериодаДата", 				ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);

	Сделки = Запрос.Выполнить().Выгрузить();

	Если Сделки.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ТабДок.Вывести(МакетПодраздел);
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка 	= Макет.ПолучитьОбласть("Шапка" + ТипСделок);
	МакетСтрока = Макет.ПолучитьОбласть("Строка" + ТипСделок);
	
	ТабДок.Вывести(МакетШапка);
	Если Сделки.Количество() > 0 Тогда	
		Для каждого СтрокаСделки Из Сделки Цикл
			
			ЗаполнитьЗначенияСвойств(МакетСтрока.Параметры, СтрокаСделки);
			МакетСтрока.Параметры.ДатаВыпуска	= Формат(СтрокаСделки.ДатаВыпуска, "ДФ=dd.MM.yy");
			МакетСтрока.Параметры.ДатаПогашения	= Формат(СтрокаСделки.ДатаПогашения, "ДФ=dd.MM.yy");
			
			ТабДок.Вывести(МакетСтрока);
						
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиВводыВыводыДС(ТабДок, МакетПодраздел, Прочие = Ложь)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводДенежныхСредств.Дата КАК ДатаОперации,
		|	ВводДенежныхСредств.Сумма КАК СуммаОперации,
		|	ВводДенежныхСредств.Сумма КАК СуммаЗнак,
		|	""Приход"" КАК ОписаниеОперации
		|ИЗ
		|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
		|ГДЕ
		|	ВводДенежныхСредств.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериодаДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериодаДата, ДЕНЬ)
		|	И ВводДенежныхСредств.Проведен = ИСТИНА
		|	И ВводДенежныхСредств.Организация = &Организация
		|	И ВводДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И &УсловияВидОперацииВвод
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВыводДенежныхСредств.Дата,
		|	ВыводДенежныхСредств.Сумма,
		|	-ВыводДенежныхСредств.Сумма,
		|	""Расход""
		|ИЗ
		|	Документ.ВыводДенежныхСредств КАК ВыводДенежныхСредств
		|ГДЕ
		|	ВыводДенежныхСредств.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериодаДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериодаДата, ДЕНЬ)
		|	И ВыводДенежныхСредств.Проведен = ИСТИНА
		|	И ВыводДенежныхСредств.Организация = &Организация
		|	И ВыводДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И &УсловияВидОперацииВывод";

	Запрос.УстановитьПараметр("НачалоПериодаДата", 				ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериодаДата", 				ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);

	Если НЕ Прочие Тогда
		
		СтрокаЗаменыВвод = "
		|  (ВводДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)
		|	ИЛИ ВводДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР)
		|	ИЛИ ВводДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратИзлишнеУдержаннойКомиссии))";
		
		СтрокаЗаменыВывод = "
		|  (ВыводДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД)
		|	ИЛИ ВыводДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР)
		|	ИЛИ ВыводДенежныхСредств.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению))";
		
	Иначе
		
		СтрокаЗаменыВвод = "
		|  (ВводДенежныхСредств.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)
		|	И ВводДенежныхСредств.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтПФР)
		|	И ВводДенежныхСредств.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратИзлишнеУдержаннойКомиссии))";
		
		СтрокаЗаменыВывод = "
		|  (ВыводДенежныхСредств.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыводДляОбеспеченияИОУД)
		|	И ВыводДенежныхСредств.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВыплаченыСредстваПФР)
		|	И ВыводДенежныхСредств.ВидОперации <> ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратДенежныхСредствУчредителюПоДоверительномуУправлению))";
		
	КонецЕсли; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияВидОперацииВвод",		СтрокаЗаменыВвод);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияВидОперацииВывод", 	СтрокаЗаменыВывод);
	
	ВводыВыводыДС = Запрос.Выполнить().Выгрузить();

	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка 	= Макет.ПолучитьОбласть("ШапкаВводВыводДС");
	МакетСтрока = Макет.ПолучитьОбласть("СтрокаВводВыводДС");
	МакетПодвал = Макет.ПолучитьОбласть("ПодвалВводВыводДС");
	
	ТабДок.Вывести(МакетШапка);
	
	Если ВводыВыводыДС.Количество() > 0 Тогда
		ТабДок.Вывести(МакетПодраздел);
		Для каждого СтрокаВводыВыводыДС Из ВводыВыводыДС Цикл
			ЗаполнитьЗначенияСвойств(МакетСтрока.Параметры, СтрокаВводыВыводыДС);
			МакетСтрока.Параметры.ДатаВводаВывода 	= Формат(СтрокаВводыВыводыДС.ДатаОперации, "ДФ=dd.MM.yyyy");
			МакетСтрока.Параметры.ВремяВводаВывода 	= Формат(СтрокаВводыВыводыДС.ДатаОперации, "ДЛФ=T");
			ТабДок.Вывести(МакетСтрока);
		КонецЦикла;
		МакетПодвал.Параметры.ИтогСуммаОперации = ВводыВыводыДС.Итог("СуммаЗнак");
	КонецЕсли;
	
	ТабДок.Вывести(МакетПодвал);

КонецПроцедуры

Процедура ВывестиВводыВыводыЦБ(ТабДок, МакетПодраздел, Ввод = Истина)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда
		|		ИНАЧЕ РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ""акция""
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ""облигация""
		|		ИНАЧЕ ""пай""
		|	КОНЕЦ КАК ВидЦБ,
		|	ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.Тип
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.Тип
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЦБ,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.ДатаРегистрации
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.ДатаРегистрации
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДатаВыпуска,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА """"
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.ДатаПогашения
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДатаПогашения,
		|	ВводЦенныхБумагЦенныеБумаги.Количество,
		|	ВЫБОР
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.Номинал
		|		КОГДА ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА НоминалыЦенныхБумагСрезПоследних.Номинал
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Номинал,
		|	ВводЦенныхБумагЦенныеБумаги.Сумма,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаКупона,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаРынок,
		|	ВводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок,
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Рынок
		|ПОМЕСТИТЬ ВводыВыводы
		|ИЗ
		|	Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериодаДата,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&КонецПериодаДата, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериодаДата, ) КАК РеквизитыПИФСрезПоследних
	    |		ПО ВЫРАЗИТЬ(ВводЦенныхБумагЦенныеБумаги.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
		|ГДЕ
		|	ВводЦенныхБумагЦенныеБумаги.Ссылка.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериодаДата, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериодаДата, ДЕНЬ)
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.Проведен = ИСТИНА
		|	И ВводЦенныхБумагЦенныеБумаги.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводыВыводы.Дата КАК ДатаВремя,
		|	ВводыВыводы.Эмитент,
		|	ВводыВыводы.ВидЦБ,
		|	ВводыВыводы.ТипЦБ,
		|	ВводыВыводы.ГосударственныйРегистрационныйНомер,
		|	ВводыВыводы.ДатаВыпуска,
		|	ВводыВыводы.ДатаПогашения,
		|	ВводыВыводы.Количество,
		|	ВводыВыводы.Номинал,
		|	ВводыВыводы.Сумма,
		|	ВводыВыводы.СуммаКупона,
		|	ВводыВыводы.СуммаРынок,
		|	ВводыВыводы.СуммаКупонаРынок,
		|	ВводыВыводы.Рынок КАК Рынок
		|ИЗ
		|	ВводыВыводы КАК ВводыВыводы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Рынок,
		|	ДатаВремя";

	#КонецОбласти
	
	Если НЕ Ввод Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВводЦенныхБумагЦенныеБумаги.Сумма", "ВводЦенныхБумагЦенныеБумаги.СуммаБУ КАК Сумма");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВводЦенныхБумагЦенныеБумаги.СуммаКупона", "ВводЦенныхБумагЦенныеБумаги.СуммаКупонаРынок КАК СуммаКупона");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ввод", "Вывод");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериодаДата", 				ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериодаДата", 				ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Активы = РезультатЗапроса[1].Выгрузить();

	Если Активы.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ТабДок.Вывести(МакетПодраздел);
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаВводВыводЦенныеБумаги"));
	
	Для каждого СтрокаАктив Из Активы Цикл
		МакетСтрокаВводВыводЦенныеБумаги = Макет.ПолучитьОбласть("СтрокаВводВыводЦенныеБумаги");
		ЗаполнитьЗначенияСвойств(МакетСтрокаВводВыводЦенныеБумаги.Параметры, СтрокаАктив, , "ДатаВыпуска,ДатаПогашения");
		МакетСтрокаВводВыводЦенныеБумаги.Параметры.ДатаВыпуска		= Формат(СтрокаАктив.ДатаВыпуска, "ДФ=dd.MM.yy");
		МакетСтрокаВводВыводЦенныеБумаги.Параметры.ДатаПогашения	= Формат(СтрокаАктив.ДатаПогашения, "ДФ=dd.MM.yy");
		
		ТабДок.Вывести(МакетСтрокаВводВыводЦенныеБумаги);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиДвижениеДС(ТабДок, МакетПодраздел)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Сумма КАК Сумма,
		|	ОстаткиДенежныхСредств.Период КАК Период,
		|	ОстаткиДенежныхСредств.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.ВидДвижения КАК ВидДвижения,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности
		|ПОМЕСТИТЬ _ОбщаяТаблица
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ПО ОстаткиДенежныхСредств.Регистратор = ЗадолженностиПоДенежнымСредствам.Регистратор
		|ГДЕ
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиДенежныхСредств.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|	И (ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредств.Регистратор) = ТИП(Документ.ПриходПроцентовПоКредитномуИнструменту)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредств.Регистратор) = ТИП(Документ.ЗакрытиеКредитногоИнструмента)
		|				И ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредств.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
		|				И ОстаткиДенежныхСредств.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратОшибочноЗачисленных)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредств.Регистратор) = ТИП(Документ.ВводДенежныхСредств)
		|				И (ОстаткиДенежныхСредств.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ВозвратИзлишнеУдержаннойКомиссии)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваДоходПоПаямЗПИФ)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОшибочноЗачисленные)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваПроцентЗаПользованиеДенежнымиСредствами))
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредств.Регистратор) = ТИП(Документ.ПриходПроцентовМНО)
		|			ИЛИ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредств.Регистратор) = ТИП(Документ.Оплата)
		|				И (ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюПая)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовПаи)
		|					ИЛИ ОстаткиДенежныхСредств.Регистратор.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоНачислениюДивидендовАкции)))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА -(ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона)
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствам.Сумма + ЗадолженностиПоДенежнымСредствам.СуммаКупона
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствам.Период,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.ВидДвижения,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.ВидЗадолженности
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВозвратуКупонногоДохода)
		|	И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.Оплата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщаяТаблица.Сумма КАК Сумма,
		|	_ОбщаяТаблица.Период КАК Период,
		|	_ОбщаяТаблица.Регистратор КАК Регистратор,
		|	_ОбщаяТаблица.ВидДвижения КАК ВидДвижения,
		|	_ОбщаяТаблица.ТипЗадолженности КАК ТипЗадолженности,
		|	_ОбщаяТаблица.ВидЗадолженности КАК ВидЗадолженности
		|ИЗ
		|	_ОбщаяТаблица КАК _ОбщаяТаблица
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";

	#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", 					ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 					ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", 					Организация);

	ПриходыДС = Запрос.Выполнить().Выгрузить();

	Если ПриходыДС.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабДок.Вывести(МакетПодраздел);

	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка 	= Макет.ПолучитьОбласть("ШапкаДвижениеДС");
	МакетСтрока = Макет.ПолучитьОбласть("СтрокаДвижениеДС");
	
	Если ПриходыДС.Количество() > 0 Тогда
		ТабДок.Вывести(МакетШапка);
				
		Для каждого СтрокаПриходыДС Из ПриходыДС Цикл
			
			МакетСтрока.Параметры.ДатаОперации 	= Формат(СтрокаПриходыДС.Период, "ДФ=dd.MM.yyyy");
			МакетСтрока.Параметры.ВремяОперации = Формат(СтрокаПриходыДС.Период, "ДЛФ=T");
			МакетСтрока.Параметры.СуммаОперации = СтрокаПриходыДС.Сумма;
			
			Если ТипЗнч(СтрокаПриходыДС.Регистратор) = Тип("ДокументСсылка.ПриходПроцентовПоКредитномуИнструменту") 
				ИЛИ  ТипЗнч(СтрокаПриходыДС.Регистратор) = Тип("ДокументСсылка.ЗакрытиеКредитногоИнструмента") И ТипЗнч(СтрокаПриходыДС.Регистратор.КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
				МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Приход % по банковскому депозитному вкладу " + СтрокаПриходыДС.Регистратор.КредитныйИнструмент.Наименование;
			ИначеЕсли ТипЗнч(СтрокаПриходыДС.Регистратор) = Тип("ДокументСсылка.ПриходПроцентовМНО") Тогда
				МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Приход % по МНО";
			ИначеЕсли ТипЗнч(СтрокаПриходыДС.Регистратор) = Тип("ДокументСсылка.ВводДенежныхСредств") Тогда
				МакетСтрока.Параметры.ОписаниеОперации = СтрокаПриходыДС.Регистратор.ВидОперации.Наименование;
			ИначеЕсли ТипЗнч(СтрокаПриходыДС.Регистратор) = Тип("ДокументСсылка.ВыводДенежныхСредств") Тогда
				МакетСтрока.Параметры.ОписаниеОперации = СтрокаПриходыДС.Регистратор.ВидОперации.Наименование;
			ИначеЕсли ТипЗнч(СтрокаПриходыДС.Регистратор) = Тип("ДокументСсылка.Оплата") Тогда
				
				Если СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона Тогда
					МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Погашение купона " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.Облигация;
				ИначеЕсли СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона Тогда
					МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Погашение купона " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.ЦеннаяБумага;	
				ИначеЕсли СтрокаПриходыДС.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода И СтрокаПриходыДС.ТипЗадолженности = Перечисления.ТипыЗадолженности.Кредиторская Тогда
					Если ТипЗнч(СтрокаПриходыДС.Регистратор.Основания[0].Основание) = Тип("ДокументСсылка.ПогашениеКупона") Тогда
						МакетСтрока.Параметры.ОписаниеОперации = "Возврат суммы погашения купона " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.Облигация + ", купленных в рамкам РЕПО";
					Иначе	
						МакетСтрока.Параметры.ОписаниеОперации = "Возврат суммы погашения купона " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.ЦенныеБумаги[0].ЦеннаяБумага + ", купленных в рамкам РЕПО";	
					КонецЕсли;
				ИначеЕсли СтрокаПриходыДС.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода И СтрокаПриходыДС.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская Тогда
					МакетСтрока.Параметры.ОписаниеОперации = "Получение суммы погашения купона " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.ЦенныеБумаги[0].ЦеннаяБумага + ", проданных в рамкам РЕПО";		
				ИначеЕсли СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации Тогда
					МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Погашение облигации " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.ЦеннаяБумага;
				ИначеЕсли СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюПая Тогда
					МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Погашение пая " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.ЦеннаяБумага;	
				ИначеЕсли СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции
				ИЛИ СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки
				ИЛИ СтрокаПриходыДС.Регистратор.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи Тогда
					МакетСтрока.Параметры.ОписаниеОперации = "Поступление ДС. Начисление дивидендов " + СтрокаПриходыДС.Регистратор.Основания[0].Основание.ЦеннаяБумага;
				КонецЕсли;
				
			КонецЕсли;
			
			ТабДок.Вывести(МакетСтрока);
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиОперацииСДепозитами(ТабДок, МакетПодраздел)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.Организация КАК Организация,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент КАК ДепозитныйВклад,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.СуммаПриход КАК СуммаРазмещения,
		|	ДепозитныеВклады.БанковскийСчет.Банк КАК Банк,
		|	ДепозитныеВклады.БанковскийСчет.НомерСчета КАК НомерСчета,
		|	ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо КАК ЮрФизЛицоБанка,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ДепозитныеВклады.БанковскийСчет.Валюта.Код КАК КодВалюты,
		|	ДепозитныеВклады.БанковскийСчет.Валюта КАК Валюта,
		|	ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора КАК НомерДоговораРазмещения,
		|	ДепозитныеВклады.ДатаРегистрации КАК ДатаРегистрации,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.Период КАК Период
		|ПОМЕСТИТЬ _ДействующиеДепозитныеВклады
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Запись,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент = ДепозитныеВклады.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗакрытиеКредитногоИнструмента.Дата КАК Дата,
		|	ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаРегистрации КАК ДепозитныйВкладДатаРегистрации,
		|	ВЫБОР
		|		КОГДА ЗакрытиеКредитногоИнструмента.РежимЗакрытия = ЗНАЧЕНИЕ(Перечисление.РежимыЗакрытияКредитногоИнструмента.Досрочное)
		|			ТОГДА ЗакрытиеКредитногоИнструмента.Дата
		|		ИНАЧЕ УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения
		|	КОНЕЦ КАК ДатаПогашения,
		|	ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора КАК ДепозитныйВкладБанковскийСчетДоговорНомерДоговора,
		|	ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады) КАК ДепозитныйВклад,
		|	ЗакрытиеКредитногоИнструмента.Сумма КАК Сумма,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу
		|ПОМЕСТИТЬ _ЗакрытияДепозитныхВкладов
		|ИЗ
		|	Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ЗакрытиеКредитногоИнструмента.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|ГДЕ
		|	ЗакрытиеКредитногоИнструмента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЗакрытиеКредитногоИнструмента.Проведен
		|	И ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗакрытиеКредитногоИнструмента.КредитныйИнструмент ССЫЛКА Справочник.ДепозитныеВклады
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий КАК ДатаНачалаДействияУсловий,
		|	УсловияКредитныхИнструментов.КредитныйИнструмент КАК ДепозитныйВклад,
		|	УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения,
		|	УсловияКредитныхИнструментов.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	УсловияКредитныхИнструментов.Процент КАК Процент,
		|	УсловияКредитныхИнструментов.Реинвестировать КАК Реинвестировать,
		|	УсловияКредитныхИнструментов.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ _НачальныеУсловияДепозитногоВклада
		|ИЗ
		|	(ВЫБРАТЬ
		|		УсловияКредитныхИнструментов.КредитныйИнструмент КАК КредитныйИнструмент,
		|		МИНИМУМ(УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий) КАК Период
		|	ИЗ
		|		РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(
		|				&КонецПериода,
		|				КредитныйИнструмент В
		|					(ВЫБРАТЬ
		|						_ДействующиеДепозитныеВклады.ДепозитныйВклад
		|					ИЗ
		|						_ДействующиеДепозитныеВклады
		|				
		|					ОБЪЕДИНИТЬ
		|				
		|					ВЫБРАТЬ
		|						_ЗакрытияДепозитныхВкладов.ДепозитныйВклад
		|					ИЗ
		|						_ЗакрытияДепозитныхВкладов КАК _ЗакрытияДепозитныхВкладов)) КАК УсловияКредитныхИнструментов
		|	ГДЕ
		|		УсловияКредитныхИнструментов.Действует
		|	
		|	СГРУППИРОВАТЬ ПО
		|		УсловияКредитныхИнструментов.КредитныйИнструмент) КАК _НачальныеПериодыУсловийДепозитногоВклада
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов КАК УсловияКредитныхИнструментов
		|		ПО _НачальныеПериодыУсловийДепозитногоВклада.КредитныйИнструмент = УсловияКредитныхИнструментов.КредитныйИнструмент
		|			И _НачальныеПериодыУсловийДепозитногоВклада.Период = УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДействующиеДепозитныеВклады.Период КАК Период,
		|	""Размещение"" КАК НаименованиеОперации,
		|	РеквизитыКонтрагентов.ПолноеНаименованиеПоУставу КАК НаименованиеБанка,
		|	_НачальныеУсловияДепозитногоВклада.Процент КАК Процент,
		|	_ДействующиеДепозитныеВклады.Валюта КАК Валюта,
		|	_ДействующиеДепозитныеВклады.СуммаРазмещения КАК СуммаОперации,
		|	_НачальныеУсловияДепозитногоВклада.ДатаПогашения КАК ДатаПогашения,
		|	_ДействующиеДепозитныеВклады.НомерДоговораРазмещения КАК НомерДоговора
		|ПОМЕСТИТЬ _ОбщаяТаблица
		|ИЗ
		|	_ДействующиеДепозитныеВклады КАК _ДействующиеДепозитныеВклады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НачальныеУсловияДепозитногоВклада КАК _НачальныеУсловияДепозитногоВклада
		|		ПО _ДействующиеДепозитныеВклады.ДепозитныйВклад = _НачальныеУсловияДепозитногоВклада.ДепозитныйВклад
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКонтрагентов
		|		ПО _ДействующиеДепозитныеВклады.ЮрФизЛицоБанка = РеквизитыКонтрагентов.ЮрФизЛицо
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ЗакрытияДепозитныхВкладов.Дата,
		|	""Закрытие"",
		|	_ЗакрытияДепозитныхВкладов.ПолноеНаименованиеПоУставу,
		|	_НачальныеУсловияДепозитногоВклада.Процент,
		|	ЕСТЬNULL(_ДействующиеДепозитныеВклады.Валюта, _ЗакрытияДепозитныхВкладов.ДепозитныйВклад.БанковскийСчет.Валюта),
		|	_ЗакрытияДепозитныхВкладов.Сумма,
		|	_ЗакрытияДепозитныхВкладов.ДатаПогашения,
		|	_ЗакрытияДепозитныхВкладов.ДепозитныйВкладБанковскийСчетДоговорНомерДоговора
		|ИЗ
		|	_ЗакрытияДепозитныхВкладов КАК _ЗакрытияДепозитныхВкладов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _НачальныеУсловияДепозитногоВклада КАК _НачальныеУсловияДепозитногоВклада
		|		ПО _ЗакрытияДепозитныхВкладов.ДепозитныйВклад = _НачальныеУсловияДепозитногоВклада.ДепозитныйВклад
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДействующиеДепозитныеВклады КАК _ДействующиеДепозитныеВклады
		|		ПО _ЗакрытияДепозитныхВкладов.ДепозитныйВклад = _ДействующиеДепозитныеВклады.ДепозитныйВклад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщаяТаблица.Период КАК Период,
		|	_ОбщаяТаблица.НаименованиеОперации КАК НаименованиеОперации,
		|	_ОбщаяТаблица.НаименованиеБанка КАК НаименованиеБанка,
		|	_ОбщаяТаблица.Процент КАК Процент,
		|	_ОбщаяТаблица.Валюта КАК Валюта,
		|	_ОбщаяТаблица.СуммаОперации КАК СуммаОперации,
		|	_ОбщаяТаблица.ДатаПогашения КАК ДатаПогашения,
		|	_ОбщаяТаблица.НомерДоговора КАК НомерДоговора
		|ИЗ
		|	_ОбщаяТаблица КАК _ОбщаяТаблица
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	НаименованиеБанка";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", 					ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 					КонецДня(ЭтотОбъект.КонецПериода));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);

	ОперацииСДепозитами = Запрос.Выполнить().Выгрузить();

	Если ОперацииСДепозитами.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабДок.Вывести(МакетПодраздел);
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка = Макет.ПолучитьОбласть("ШапкаОперацииСДепозитами");
	МакетСтрока = Макет.ПолучитьОбласть("СтрокаОперацииСДепозитами");
	
	Если ОперацииСДепозитами.Количество() > 0 Тогда
		ТабДок.Вывести(МакетШапка);
		Для каждого СтрокаДепозиты Из ОперацииСДепозитами Цикл
			
			МакетСтрока.Параметры.Заполнить(СтрокаДепозиты);
			МакетСтрока.Параметры.ДатаОперации 	= Формат(СтрокаДепозиты.Период, "ДФ=dd.MM.yyyy");
			МакетСтрока.Параметры.СуммаОперации = СтрокаДепозиты.СуммаОперации;			
					
			ТабДок.Вывести(МакетСтрока);
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры // ВывестиОперацииСДепозитами

Процедура ВывестиПогашения(ТабДок, МакетПодраздел, ВыводДепозитов = Ложь)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПогашениеЦеннойБумаги.Дата КАК Дата,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.ДатаСоставления
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.ДатаРегистрации
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.ДатаРегистрации
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДатаВыпуска,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.ДатаПогашения
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.ДатаПогашения
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА """"
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ДатаПогашения,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ""вексель""
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ""облигация""
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ""пай""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидЦБ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.Тип
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ПогашениеЦеннойБумаги.ЦеннаяБумага.ТипВекселя
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЦБ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(ПогашениеЦеннойБумаги.ЦеннаяБумага КАК Справочник.Векселя).Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(ПогашениеЦеннойБумаги.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА ТИПЗНАЧЕНИЯ(ПогашениеЦеннойБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА ВЫРАЗИТЬ(ПогашениеЦеннойБумаги.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК РегНомер,
		|	ПогашениеЦеннойБумаги.ЦеннаяБумага КАК Актив,
		|	ПогашениеЦеннойБумаги.Количество КАК Количество,
		|	ПогашениеЦеннойБумаги.Сумма КАК Сумма,
		|	ПогашениеЦеннойБумаги.ПолноеНаименованиеПоУставу КАК Эмитент,
		|	ПогашениеЦеннойБумаги.ДатаПоступленияДС КАК ДатаПоступленияДС
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПогашениеЦеннойБумаги.Дата КАК Дата,
		|		ПогашениеЦеннойБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|		ПогашениеЦеннойБумаги.Количество КАК Количество,
		|		ПогашениеЦеннойБумаги.Сумма КАК Сумма,
		|		РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|		МИНИМУМ(ОплатаОснования.Ссылка.Дата) КАК ДатаПоступленияДС
		|	ИЗ
		|		Документ.ПогашениеЦеннойБумаги КАК ПогашениеЦеннойБумаги
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					&КонецПериода,
		|					Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|						И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО ПогашениеЦеннойБумаги.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|			ПО ПогашениеЦеннойБумаги.Ссылка = ОплатаОснования.Основание
		|	ГДЕ
		|		ПогашениеЦеннойБумаги.Проведен
		|		И ПогашениеЦеннойБумаги.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|		И ПогашениеЦеннойБумаги.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ПогашениеЦеннойБумаги.ЦеннаяБумага,
		|		ПогашениеЦеннойБумаги.Дата,
		|		ПогашениеЦеннойБумаги.Количество,
		|		ПогашениеЦеннойБумаги.Сумма,
		|		РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу) КАК ПогашениеЦеннойБумаги
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗакрытиеКредитногоИнструмента.Дата,
		|	ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).ДатаРегистрации,
		|	ВЫБОР
		|		КОГДА ЗакрытиеКредитногоИнструмента.РежимЗакрытия = ЗНАЧЕНИЕ(Перечисление.РежимыЗакрытияКредитногоИнструмента.Досрочное)
		|			ТОГДА ЗакрытиеКредитногоИнструмента.Дата
		|		ИНАЧЕ УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения
		|	КОНЕЦ,
		|	""депозитный вклад"",
		|	NULL,
		|	ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора,
		|	ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады),
		|	1,
		|	ЗакрытиеКредитногоИнструмента.Сумма,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу,
		|	ЗакрытиеКредитногоИнструмента.Дата
		|ИЗ
		|	Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПоследних.ДатаПогашения КАК ДатаПогашения
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МАКСИМУМ(УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПоследних.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ДатаНачалаДействияУсловий <= &КонецПериода) КАК УсловияКредитныхИнструментовСрезПоследних
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПоследних.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПоследних
		|		ПО ЗакрытиеКредитногоИнструмента.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПоследних.КредитныйИнструмент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|ГДЕ
		|	ЗакрытиеКредитногоИнструмента.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЗакрытиеКредитногоИнструмента.Проведен
		|	И ЗакрытиеКредитногоИнструмента.КредитныйИнструмент ССЫЛКА Справочник.ДепозитныеВклады
		|	И ЗакрытиеКредитногоИнструмента.СчетДоверительногоУправления = &СчетДоверительногоУправления";

	#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода",                ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",                 ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);

	Погашения = Запрос.Выполнить().Выгрузить();
	ОбщееКоличествоСтрок = Погашения.Количество();
	Если ОбщееКоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НайдСтроки = Погашения.НайтиСтроки(Новый Структура("ВидЦБ", "депозитный вклад"));
	КоличествоСтрокДепозитов = НайдСтроки.Количество();
	Если ВыводДепозитов И КоличествоСтрокДепозитов = 0 Тогда
		Возврат;
	ИначеЕсли (Не ВыводДепозитов) И (ОбщееКоличествоСтрок - КоличествоСтрокДепозитов) = 0 Тогда
		Возврат;
	КонецЕсли;  	
			
	ТабДок.Вывести(МакетПодраздел);

	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка 	= Макет.ПолучитьОбласть("ШапкаПогашения");
	МакетСтрока = Макет.ПолучитьОбласть("СтрокаПогашения");
		
	ТабДок.Вывести(МакетШапка);
	Если Погашения.Количество() > 0 Тогда
		
		Для каждого СтрокаПогашения Из Погашения Цикл
			
			Если ВыводДепозитов И ТипЗнч(СтрокаПогашения.Актив) <> Тип("СправочникСсылка.ДепозитныеВклады") Тогда 
				Продолжить;
			КонецЕсли;
			
			Если (Не ВыводДепозитов) И ТипЗнч(СтрокаПогашения.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда 
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(МакетСтрока.Параметры, СтрокаПогашения);
			
			Если ТипЗнч(СтрокаПогашения.Актив) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
				
				ДанныеДепозита = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(СтрокаПогашения.Актив, СтрокаПогашения.Дата - 1);
				
				МакетСтрока.Параметры.ВидЦБ 	= "депозит, " + ДанныеДепозита.НомерДоговора + "," + Формат(ДанныеДепозита.ДатаОткрытия, "ДФ=dd.MM.yyyy") + "/" + Формат(ДанныеДепозита.ДатаПогашения, "ДФ=dd.MM.yyyy; ДП=Неопределено");
				МакетСтрока.Параметры.Номинал 	= ДанныеДепозита.Номинал;				
				МакетСтрока.Параметры.Цена 		= СтрокаПогашения.Сумма / СтрокаПогашения.Количество;
				
			ИначеЕсли ТипЗнч(СтрокаПогашения.Актив) = Тип("СправочникСсылка.Облигации") Тогда
				
				ДанныеОблигации = РаботаСЦеннымиБумагами.ПолучитьНоминалИВалютуЦеннойБумаги(СтрокаПогашения.Актив, СтрокаПогашения.Дата - 1); 
				
				МакетСтрока.Параметры.ВидЦБ 	= "облигация, " + СтрокаПогашения.Актив.ГосударственныйРегистрационныйНомер + ", погаш. " + Формат(СтрокаПогашения.Актив.ДатаПогашения, "ДФ=dd.MM.yyyy");
				МакетСтрока.Параметры.Номинал 	= ДанныеОблигации.Номинал; 				
				МакетСтрока.Параметры.Цена 		= СтрокаПогашения.Сумма / СтрокаПогашения.Количество;
				
			КонецЕсли;
			
			ТабДок.Вывести(МакетСтрока);
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

