		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Дата, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО (НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага = _СтоимостьАктивовНеЦБ.СубъектАналитики)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Дата,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЭмитента
		|		ПО (РеквизитыЭмитента.ЮрФизЛицо = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.Эмитент.ЮрФизЛицо)
		|ГДЕ
		|	_СтоимостьАктивовНеЦБ.ВидАктива В (ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность), ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги))
		|	И _СтоимостьАктивовНеЦБ.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПОЦенныеБумаги.Ссылка КАК Ссылка,
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(СделкаРЕПОЦенныеБумаги.Количество) КАК Количество
		|ПОМЕСТИТЬ _КоличествоЦБКупленныхПоРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|ГДЕ
		|	СделкаРЕПОЦенныеБумаги.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_ЦБКупленныеПоРЕПО.Основание
		|			ИЗ
		|				_ЦБКупленныеПоРЕПО КАК _ЦБКупленныеПоРЕПО)
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкаРЕПОЦенныеБумаги.Ссылка,
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ЦБКупленныеПоРЕПО"" КАК ВидАктива,
		|	_ЦБКупленныеПоРЕПО.СубъектАналитики КАК СубъектАналитики,
		|	_ЦБКупленныеПоРЕПО.ДатаПогашения КАК ДатаПогашения,
		|	_ЦБКупленныеПоРЕПО.ДатаРегистрации КАК ДатаРегистрации,
		|	_ЦБКупленныеПоРЕПО.Эмитент КАК Эмитент,
		|	_ЦБКупленныеПоРЕПО.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	_ЦБКупленныеПоРЕПО.ТипЦБ КАК ТипЦБ,
		|	_КоличествоЦБКупленныхПоРЕПО.Количество КАК Количество,
		|	_ЦБКупленныеПоРЕПО.Эмитент КАК НаименованиеЭмитента,
		|	СУММА(_ЦБКупленныеПоРЕПО.СуммаРынокВВалютеУчета) КАК СуммаРынок,
		|	0 КАК Купон
		|ИЗ
		|	_ЦБКупленныеПоРЕПО КАК _ЦБКупленныеПоРЕПО
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КоличествоЦБКупленныхПоРЕПО КАК _КоличествоЦБКупленныхПоРЕПО
		|		ПО _ЦБКупленныеПоРЕПО.СубъектАналитики = _КоличествоЦБКупленныхПоРЕПО.ЦеннаяБумага
		|			И _ЦБКупленныеПоРЕПО.Основание = _КоличествоЦБКупленныхПоРЕПО.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЦБКупленныеПоРЕПО.СубъектАналитики,
		|	_ЦБКупленныеПоРЕПО.ДатаПогашения,
		|	_ЦБКупленныеПоРЕПО.ДатаРегистрации,
		|	_ЦБКупленныеПоРЕПО.Эмитент,
		|	_ЦБКупленныеПоРЕПО.ГосударственныйРегистрационныйНомер,
		|	_ЦБКупленныеПоРЕПО.ТипЦБ,
		|	_КоличествоЦБКупленныхПоРЕПО.Количество,
		|	_ЦБКупленныеПоРЕПО.Эмитент
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТипЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Резервы"" КАК ВидАктива,
		|	_СтоимостьАктивовНеЦБ.ВидЗадолженности КАК ДСОписание,
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|				ТОГДА -_СтоимостьАктивовНеЦБ.СуммаРынокВВалютеУчета
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРезерва
		|ИЗ
		|	_СтоимостьАктивовНеЦБ КАК _СтоимостьАктивовНеЦБ
		|ГДЕ
		|	_СтоимостьАктивовНеЦБ.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|	И _СтоимостьАктивовНеЦБ.ВидЗадолженности ССЫЛКА Справочник.Резервы
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьАктивовНеЦБ.ВидЗадолженности");
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата",							Период);
	Запрос.УстановитьПараметр("ЦельРасчета",					ЦельРасчета);	
	Запрос.УстановитьПараметр("ВидУчета",						ВидУчета);
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

Функция ПолучитьИмяФайла(ТекСчетДоверительногоУправления)
	
	ТекОтчет = ОбщегоНазначения.ПолучитьИменованныйОбъект("_Отчет_ПериодическийОтчетУправляющего");
	
	НастройкиОтчета = РегистрыСведений.СоставИНастройкиОтчетов.ПолучитьНастройкиОтчета(ЭтотОбъект.КонецПериода, ТекСчетДоверительногоУправления, ТекОтчет);
		
	Если ЗначениеЗаполнено(НастройкиОтчета.ПутьКФайлу) Тогда
		
		ДанныеОтчета = Новый Структура;
		
		ДанныеОтчета.Вставить("Субъект",		ТекСчетДоверительногоУправления);
		ДанныеОтчета.Вставить("Отчет",			ТекОтчет);
		ДанныеОтчета.Вставить("Периодичность",	Неопределено);
		ДанныеОтчета.Вставить("ДатаНачала",		ЭтотОбъект.НачалоПериода);
		ДанныеОтчета.Вставить("ДатаОкончания",	ЭтотОбъект.КонецПериода);
		
		ИмяФайла = РегистрыСведений.СоставИНастройкиОтчетов.ОбработатьПутьКФайлу(НастройкиОтчета.ПутьКФайлу, ДанныеОтчета);
		ИмяФайла = Сред(ИмяФайла, СтрНайти(ИмяФайла, "\", НаправлениеПоиска.СКонца) + 1);
		
	Иначе

		ИмяФайла = "Периодический отчет управляющего ";
			
		ИмяФайла = ИмяФайла + СокрЛП(ТекСчетДоверительногоУправления);
			
		ИмяФайла = ИмяФайла + " c " + Формат(ЭтотОбъект.НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(ЭтотОбъект.КонецПериода, "ДФ=dd.MM.yyyy") + ".xlsx";	
		
	КонецЕсли;
	
	Возврат ИмяФайла;
	
КонецФункции

#КонецОбласти
