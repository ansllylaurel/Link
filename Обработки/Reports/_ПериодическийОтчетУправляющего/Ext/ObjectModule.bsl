		ТабДок.Присоединить(МакетШапкаАкцииИПаиБаланс);
		
		Для каждого СтрокаАкции Из АкцииМы Цикл
			
			МакетСтрокаАкцииИПаи.Параметры.ОписаниеЦБ 	= СтрокаАкции.Эмитент;
			МакетСтрокаАкцииИПаи.Параметры.СерияНомерЦБ = "акция " + НРег(Строка(СтрокаАкции.Тип)) + ", " + СтрокаАкции.ГосударственныйРегистрационныйНомер;
			МакетСтрокаАкцииИПаи.Параметры.Количество 	= СтрокаАкции.Количество;
			МакетСтрокаАкцииИПаи.Параметры.Номинал 		= СтрокаАкции.Номинал;
			ТабДок.Вывести(МакетСтрокаАкцииИПаи);

			МакетСтрокаАкцииИПаиБаланс.Параметры.Цена 	= ?(СтрокаАкции.Количество > 0, СтрокаАкции.Сумма / СтрокаАкции.Количество, 0);
			МакетСтрокаАкцииИПаиБаланс.Параметры.Баланс = СтрокаАкции.Сумма;
			ТабДок.Присоединить(МакетСтрокаАкцииИПаиБаланс);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ПаиМы.Количество() > 0 Тогда
		
		ТабДок.Вывести(МакетПустаяСтрока);
		
		МакетАкцииИПаи.Параметры.ГруппаАктивов = "ПАИ";
		ТабДок.Вывести(МакетАкцииИПаи);

		МакетАкцииИПаиБаланс.Параметры.ИтогБаланс = ПаиМы.Итог("Сумма");
		ТабДок.Присоединить(МакетАкцииИПаиБаланс);
		
		ТабДок.Вывести(МакетШапкаАкцииИПаи);
		ТабДок.Присоединить(МакетШапкаАкцииИПаиБаланс);
		
		Для каждого СтрокаПаи Из ПаиМы Цикл
			
			МакетСтрокаАкцииИПаи.Параметры.ОписаниеЦБ 	= СтрокаПаи.Эмитент;
			МакетСтрокаАкцииИПаи.Параметры.СерияНомерЦБ = СтрокаПаи.ГосударственныйРегистрационныйНомер;
			МакетСтрокаАкцииИПаи.Параметры.Количество 	= СтрокаПаи.Количество;
			МакетСтрокаАкцииИПаи.Параметры.Номинал 		= СтрокаПаи.Номинал;
			ТабДок.Вывести(МакетСтрокаАкцииИПаи);

			МакетСтрокаАкцииИПаиБаланс.Параметры.Цена 	= ?(СтрокаПаи.Количество > 0, СтрокаПаи.Сумма / СтрокаПаи.Количество, 0);
			МакетСтрокаАкцииИПаиБаланс.Параметры.Баланс = СтрокаПаи.Сумма;
			ТабДок.Присоединить(МакетСтрокаАкцииИПаиБаланс);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ОблигацииМы.Количество() > 0 Тогда
		
		ТабДок.Вывести(МакетПустаяСтрока);
		
		ТабДок.Вывести(МакетОблигации);

		МакетОблигацииБаланс.Параметры.ИтогБаланс 	= ОблигацииМы.Итог("Сумма");
		МакетОблигацииБаланс.Параметры.ИтогНКД 		= ОблигацииМы.Итог("Купон");
		ТабДок.Присоединить(МакетОблигацииБаланс);
		
		Для каждого СтрокаГруппаОблигации Из ГруппыОблигацииМы Цикл
			
			Если СтрокаГруппаОблигации.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда
				МакетГруппаОблигации.Параметры.ГруппаОблигаций = "Корпоративные облигации";
			ИначеЕсли СтрокаГруппаОблигации.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда
				МакетГруппаОблигации.Параметры.ГруппаОблигаций = "ОМЗ";
			ИначеЕсли СтрокаГруппаОблигации.Категория = Перечисления.КатегорииОблигаций.Субфедеральная Тогда
				МакетГруппаОблигации.Параметры.ГруппаОблигаций = "Облиг. субъект. РФ";
			ИначеЕсли СтрокаГруппаОблигации.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда
				МакетГруппаОблигации.Параметры.ГруппаОблигаций = "ОФЗ";
			КонецЕсли;
		    	
			ТабДок.Вывести(МакетГруппаОблигации);
			МакетГруппаОблигацииБаланс.Параметры.ИтогБаланс = СтрокаГруппаОблигации.Сумма;
			МакетГруппаОблигацииБаланс.Параметры.ИтогНКД 	= СтрокаГруппаОблигации.Купон;
			ТабДок.Присоединить(МакетГруппаОблигацииБаланс);
			
			ТабДок.Вывести(МакетШапкаОблигации);

			ТабДок.Присоединить(МакетШапкаОблигацииБаланс);
			
			Для каждого СтрокаОблигации Из ОблигацииМы Цикл
				
				Если СтрокаОблигации.Категория <> СтрокаГруппаОблигации.Категория Тогда
					Продолжить;
				КонецЕсли;
				
				МакетСтрокаОблигации.Параметры.ОписаниеЦБ 	= СтрокаОблигации.Эмитент + ", " + Формат(СтрокаОблигации.ДатаРегистрации, "ДФ=dd.MM.yyyy") + "/" + Формат(СтрокаОблигации.ДатаПогашения, "ДФ=dd.MM.yyyy");
				МакетСтрокаОблигации.Параметры.СерияНомерЦБ = "облигация, " + СтрокаОблигации.ГосударственныйРегистрационныйНомер + ", погаш. " + Формат(СтрокаОблигации.ДатаПогашения, "ДФ=dd.MM.yyyy");
				МакетСтрокаОблигации.Параметры.Количество 	= СтрокаОблигации.Количество;
				МакетСтрокаОблигации.Параметры.Номинал 		= СтрокаОблигации.Номинал;
				ТабДок.Вывести(МакетСтрокаОблигации);
				

				МакетСтрокаОблигацииБаланс.Параметры.Цена 	= ?(СтрокаОблигации.Количество > 0, СтрокаОблигации.Сумма / СтрокаОблигации.Количество, 0);
				МакетСтрокаОблигацииБаланс.Параметры.Баланс = СтрокаОблигации.Сумма + СтрокаОблигации.Купон;
				МакетСтрокаОблигацииБаланс.Параметры.НКД 	= СтрокаОблигации.Купон;
				ТабДок.Присоединить(МакетСтрокаОблигацииБаланс);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЦБКупленныеПоРЕПО.Количество() > 0 Тогда
		
		ТабДок.Вывести(МакетПустаяСтрока);
		
		ТабДок.Вывести(МакетГруппаРЕПО);
					
		Если ВыводитьРыночнуюСтоимость Тогда
			
			МакетГруппаРЕПОРынок.Параметры.ИтогРынок = ЦБКупленныеПоРЕПО.Итог("СуммаРынок");
			Если Не НоваяМетодикаРасчетаОценочнойСтоимости Тогда
				МакетГруппаРЕПОРынок.Параметры.ИтогНКД = ЦБКупленныеПоРЕПО.Итог("Купон");
			КонецЕсли;
			ТабДок.Присоединить(МакетГруппаРЕПОРынок);
			
			ТабДок.Вывести(МакетШапкаРЕПО);
			ТабДок.Присоединить(МакетШапкаРЕПОРынок);
			
		Иначе
			
			МакетГруппаРЕПОБаланс.Параметры.ИтогБаланс = ЦБКупленныеПоРЕПО.Итог("СуммаБаланс");
			МакетГруппаРЕПОБаланс.Параметры.ИтогНКД    = ЦБКупленныеПоРЕПО.Итог("Купон");
			ТабДок.Присоединить(МакетГруппаРЕПОБаланс);
			
			ТабДок.Вывести(МакетШапкаРЕПО);
			ТабДок.Присоединить(МакетШапкаРЕПОБаланс);
			
		КонецЕсли;
		
		Для каждого СтрокаЦБКупленныеПоРЕПО Из ЦБКупленныеПоРЕПО Цикл
			
			Если Не ЗначениеЗаполнено(СтрокаЦБКупленныеПоРЕПО.Количество) Тогда
				Продолжить;
			КонецЕсли;
						
			МакетСтрокаРЕПО.Параметры.ОписаниеЦБ   = СокрЛП(СтрокаЦБКупленныеПоРЕПО.НаименованиеЭмитента) + ", " + Формат(СтрокаЦБКупленныеПоРЕПО.ДатаРегистрации, "ДФ=dd.MM.yyyy") + ?(СтрокаЦБКупленныеПоРЕПО.ТипЦБ = "Облигация", "/" + Формат(СтрокаЦБКупленныеПоРЕПО.ДатаПогашения, "ДФ=dd.MM.yyyy"), "");
			МакетСтрокаРЕПО.Параметры.СерияНомерЦБ = СтрокаЦБКупленныеПоРЕПО.ТипЦБ + " " + СтрокаЦБКупленныеПоРЕПО.ГосударственныйРегистрационныйНомер + ?(СтрокаЦБКупленныеПоРЕПО.ТипЦБ = "Облигация", ", погаш. " + Формат(СтрокаЦБКупленныеПоРЕПО.ДатаПогашения, "ДФ=dd.MM.yyyy"), "");
			МакетСтрокаРЕПО.Параметры.Количество   = СтрокаЦБКупленныеПоРЕПО.Количество;
			Если Не НоваяМетодикаРасчетаОценочнойСтоимости Тогда
				МакетСтрокаРЕПО.Параметры.Номинал = СтрокаЦБКупленныеПоРЕПО.Номинал;
			КонецЕсли;
			ТабДок.Вывести(МакетСтрокаРЕПО);       			
			
			Если ВыводитьРыночнуюСтоимость Тогда
				
				МакетСтрокаРЕПОРынок.Параметры.Рынок	= СтрокаЦБКупленныеПоРЕПО.СуммаРынок;
				Если Не НоваяМетодикаРасчетаОценочнойСтоимости Тогда
					МакетСтрокаРЕПОРынок.Параметры.Цена	= ?(СтрокаЦБКупленныеПоРЕПО.Количество > 0, СтрокаЦБКупленныеПоРЕПО.Цена, 0);
					МакетСтрокаРЕПОРынок.Параметры.НКД	= СтрокаЦБКупленныеПоРЕПО.Купон;
				КонецЕсли;
				ТабДок.Присоединить(МакетСтрокаРЕПОРынок);
				
			Иначе	
				
				МакетСтрокаРЕПОБаланс.Параметры.Баланс	= СтрокаЦБКупленныеПоРЕПО.СуммаБаланс;
				Если Не НоваяМетодикаРасчетаОценочнойСтоимости Тогда
					МакетСтрокаРЕПОБаланс.Параметры.Цена	= ?(СтрокаЦБКупленныеПоРЕПО.Количество > 0, СтрокаЦБКупленныеПоРЕПО.Цена, 0);
					МакетСтрокаРЕПОБаланс.Параметры.НКД		= СтрокаЦБКупленныеПоРЕПО.Купон;
				КонецЕсли;
				ТабДок.Присоединить(МакетСтрокаРЕПОБаланс);
				
			КонецЕсли;
				
		КонецЦикла;		
		
	КонецЕсли;
		
КонецПроцедуры

Функция СформироватьОтчет(ТабДок) Экспорт
	
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, 
												"НачалоПериода,КонецПериода,Организация,СчетДоверительногоУправления,ВыводитьБалансовуюСтоимость,ВыводитьРыночнуюСтоимость,РежимВыводаДвиженийИОстатков"); 
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ТабДок.Очистить();
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка 		= Макет.ПолучитьОбласть("Шапка");
	МакетРаздел 	= Макет.ПолучитьОбласть("Раздел");
	МакетПодраздел 	= Макет.ПолучитьОбласть("Подраздел");
	МакетПодвал 	= Макет.ПолучитьОбласть("Подвал");
	              	
	СведенияОКлиенте = КонсолидированнаяОтчетность.СведенияОЮрФизЛице(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.КонецПериода);
	
	МакетШапка.Параметры.Организация   = СведенияОКлиенте.ПолноеНаименованиеОрганизации;
	МакетШапка.Параметры.СчетДУ        = СведенияОКлиенте.ПолноеНаименование;
	МакетШапка.Параметры.КодДУ         = ЭтотОбъект.СчетДоверительногоУправления.КодСчета;
	
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
		МакетШапка.Параметры.ДоговорИлиПравила 	= "Правила №";
		ПИФ 									= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(СчетДоверительногоУправления, ЭтотОбъект.КонецПериода);
		МакетШапка.Параметры.ДоговорДУ     		= ПИФ.НомерПравил + " от " + Формат(ПИФ.ДатаПравил, "ДФ=dd.MM.yyyy");
	Иначе
		МакетШапка.Параметры.ДоговорИлиПравила 	= "Договор №";
		МакетШапка.Параметры.ДоговорДУ     		= ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора + " от " + Формат(ЭтотОбъект.СчетДоверительногоУправления.ДатаЗаключения, "ДФ=dd.MM.yyyy");	
	КонецЕсли;
	
	МакетШапка.Параметры.ПериодОтчета  = РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(ЭтотОбъект.НачалоПериода, ЭтотОбъект.КонецПериода);
	МакетШапка.Параметры.ДатаОтчета    = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
	ТабДок.Вывести(МакетШапка);
	
	Если ЭтотОбъект.РежимВыводаДвиженийИОстатков = 1 Тогда // Движения и остатки
		ВывестиОстаткиАктивов(ТабДок);
	ИначеЕсли ЭтотОбъект.РежимВыводаДвиженийИОстатков = 2 Тогда
		ВывестиОстаткиАктивов(ТабДок, Истина);
		ВывестиОстаткиАктивов(ТабДок);
	КонецЕсли;
	
	МакетРаздел.Параметры.Раздел = "Операции по передаче и изъятию  имущества";
	ТабДок.Вывести(МакетРаздел);

	МакетПодраздел.Параметры.Подраздел = "Передано(изъято)денежных средств:";
		
	ВывестиВводыВыводыДС(ТабДок, МакетПодраздел);
	
	МакетПодраздел.Параметры.Подраздел = "Передано ЦБ:";
	ВывестиВводыВыводыЦБ(ТабДок, МакетПодраздел);
	
	МакетПодраздел.Параметры.Подраздел = "Изъято ЦБ:";	
	ВывестиВводыВыводыЦБ(ТабДок, МакетПодраздел, Ложь);
	
	МакетРаздел.Параметры.Раздел = "Сведения о проведенных сделках";
	ТабДок.Вывести(МакетРаздел);

	МакетПодраздел.Параметры.Подраздел = "Биржевые сделки";
	ВывестиСделки(ТабДок, МакетПодраздел);
		
	МакетПодраздел.Параметры.Подраздел = "Сделки РЕПО";
	ВывестиСделки(ТабДок, МакетПодраздел, "РЕПО");
	
	МакетПодраздел.Параметры.Подраздел = "Биржевые переговорные сделки(заключенные на основании адресных заявок)";
	ВывестиСделки(ТабДок, МакетПодраздел, "РПС");
	
	МакетПодраздел.Параметры.Подраздел = "Внебиржевые сделки";
	ВывестиСделки(ТабДок, МакетПодраздел, "Тикеты");
	
	МакетПодраздел.Параметры.Подраздел = "Операции по депозитным вкладам";
	ВывестиОперацииСДепозитами(ТабДок, МакетПодраздел);
		
	МакетПодраздел.Параметры.Подраздел = "Поступившие купоны, дивиденды, % по депозитам, % на остаток по счету";
	ВывестиДвижениеДС(ТабДок, МакетПодраздел);
		
	МакетПодраздел.Параметры.Подраздел = "Погашение ценных бумаг";
	ВывестиПогашения(ТабДок, МакетПодраздел);
	
	МакетПодраздел.Параметры.Подраздел = "Конвертация ЦБ";
	ВывестиКонвертации(ТабДок, МакетПодраздел);
	
	МакетПодраздел.Параметры.Подраздел = "Операции с валютой.";
	ВывестиСделкиСВалютой(ТабДок, МакетПодраздел);
	
	МакетРаздел.Параметры.Раздел = "Расходы Управляющего.";
	ВывестиРасходыУправляющего(ТабДок, МакетРаздел);
	
	МакетПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
	МакетПодвал.Параметры.ДолжностьПодписанта = ЭтотОбъект.Подписант.Должность;
	ТабДок.Вывести(МакетПодвал); 	
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ТабДок, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	
КонецФункции

Функция СформироватьОтчетПоСпискуСчетовДУ(МассивСчетовДоверительногоУправления, Выгрузить, КаталогВыгрузки) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	
	Для Каждого ТекСчетДоверительногоУправления Из МассивСчетовДоверительногоУправления Цикл
		
		Если Не ЗначениеЗаполнено(ТекСчетДоверительногоУправления) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекРезультат = Новый ТабличныйДокумент;
		ЭтотОбъект.СчетДоверительногоУправления = ТекСчетДоверительногоУправления;
		
		СформироватьОтчет(ТекРезультат);
		
		Если Выгрузить Тогда  			
			ИмяФайла = КаталогВыгрузки + "\" + ПолучитьИмяФайла(ТекСчетДоверительногоУправления);	
			Попытка
				ТекРезультат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		Результат.Вывести(ТекРезультат);
		
		Результат.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

