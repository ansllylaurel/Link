		|			&СубконтоКонтрагентыОснованиеРасчетов,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|ГДЕ
		|	НЕ ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) В (ТИП(Документ.Сделка), ТИП(Документ.СделкаРЕПО), ТИП(Документ.СделкаСвалютой))
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Контрагент,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЦеннаяБумага,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт),
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт),
		|	ЕдиныйБухгалтерскийУчетОстатки.ВидЗадолженности
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ОбъединенныйЗапросЕПС.Контрагент КАК Контрагент,
		|		_ОбъединенныйЗапросЕПС.ВидЗадолженности КАК ВидЗадолженности,
		|		_ОбъединенныйЗапросЕПС.ЦеннаяБумага КАК ЦеннаяБумага,
		|		СУММА(_ОбъединенныйЗапросЕПС.СуммаОстатокДт) КАК СуммаОстатокДт,
		|		СУММА(_ОбъединенныйЗапросЕПС.СуммаОстатокКт) КАК СуммаОстатокКт
		|	ИЗ
		|		_ОбъединенныйЗапросЕПС КАК _ОбъединенныйЗапросЕПС
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ОбъединенныйЗапросЕПС.Контрагент,
		|		_ОбъединенныйЗапросЕПС.ВидЗадолженности,
		|		_ОбъединенныйЗапросЕПС.ЦеннаяБумага) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Контрагент,
		|	ЕдиныйБухгалтерскийУчетОстатки.ЦеннаяБумага,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВидЗадолженности
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	""Резервы под обесценение"",
		|	СУММА(-1 * ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт),
		|	СУММА(0),
		|	NULL
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты25), ЗНАЧЕНИЕ(ПланСчетов.Единый.РасчетыСДебиторамиИКредиторами24)),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ОперацииСПриобретеннымиЦеннымиБумагами.ДоговорСделка,
