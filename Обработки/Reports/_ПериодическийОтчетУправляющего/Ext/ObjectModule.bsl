		|	ОстаткиОблигаций.Сумма КАК Сумма,
		|	ОстаткиОблигаций.Купон КАК Купон,
		|	ОстаткиОблигаций.СуммаРынок КАК СуммаРынок,
		|	ОстаткиОблигаций.КупонРынок КАК КупонРынок,
		|	ОстаткиОблигаций.Номинал КАК Номинал,
		|	ОстаткиОблигаций.ДатаРегистрации КАК ДатаРегистрации,
		|	ОстаткиОблигаций.ДатаПогашения КАК ДатаПогашения,
		|	ОстаткиОблигаций.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _РезультатОстаткиОблигаций
		|ИЗ
		|	ОстаткиОблигаций КАК ОстаткиОблигаций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиОблигаций.ЦеннаяБумага КАК ЦеннаяБумага
		|ПОМЕСТИТЬ _РезультатЦенныеБумаги
		|ИЗ
		|	ОстаткиОблигаций КАК ОстаткиОблигаций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДефолтыПоОблигациямСрезПоследних.Период КАК Период,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация КАК Облигация,
		|	ДефолтыПоОблигациямСрезПоследних.ТипДефолта КАК ТипДефолта,
		|	ДефолтыПоОблигациямСрезПоследних.СтатусДефолта КАК СтатусДефолта,
		|	ДефолтыПоОблигациямСрезПоследних.Облигация.Эмитент КАК ОблигацияЭмитент
		|ПОМЕСТИТЬ _РезультатДефолтыПоОблигациям
		|ИЗ
		|	РегистрСведений.ДефолтыПоОблигациям.СрезПоследних(
		|			&Период,
		|			ТипДефолта = ЗНАЧЕНИЕ(Перечисление.ТипыДефолтаПоОблигациям.ТелоОблигации)
		|				И СтатусДефолта = ЗНАЧЕНИЕ(Перечисление.СтатусыДефолтаПоОблигациям.Дефолт)) КАК ДефолтыПоОблигациямСрезПоследних";
	#КонецОбласти
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "MARKETPRICE3", "MARKETPRICE2");
	
	Запрос.УстановитьПараметр("Период",							Период);
	Запрос.УстановитьПараметр("ПериодДата",						НачалоДня(ПериодДата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Биржа",							ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);
	Запрос.УстановитьПараметр("ВалютаУчета",					ПараметрыСеанса.ТекущаяОрганизация.ВалютаУчета);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Выполнить();
	
	РезультатОстаткиЦБ = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_РезультатОстаткиОблигаций",,,, "Эмитент");
	ТаблицаОблигаций = РезультатОстаткиЦБ.Выгрузить();
	РезультатОстаткиОблигацийИтог = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_РезультатОстаткиОблигацийИтог");
	ТаблицаГрупп = РезультатОстаткиОблигацийИтог.Выгрузить();
	
	Если ВыводитьБалансовуюСтоимость Или ТаблицаОблигаций.Количество() = 0 Тогда
		Возврат Новый Структура("Облигации, ГруппыОблигаций", ТаблицаОблигаций, ТаблицаГрупп);
	КонецЕсли;
	
	// Для рыночной стоимости требуется доп. обработка результата
	РезультатДефолтыПоОблигациям = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_РезультатДефолтыПоОблигациям");
	ТаблицаДефолтов = РезультатДефолтыПоОблигациям.Выгрузить();
	РезультатЦенныеБумаги = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос.МенеджерВременныхТаблиц, "_РезультатЦенныеБумаги");
	ЦенныеБумаги = РезультатЦенныеБумаги.Выгрузить();
	
	Объект = Новый Структура;
	Объект.Вставить("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Объект.Вставить("ВариантРасчетаОценочнойСтоимости", Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений);
	Объект.Вставить("Организация", 						ЭтотОбъект.Организация);
	Объект.Вставить("ВидУчета",							Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
	Объект.Вставить("Дата", 							НачалоДня(ПериодДата));
	Объект.Вставить("ЦенныеБумаги",						ЦенныеБумаги);
	Объект.Вставить("ЦельРасчета",						Справочники.ЦелиРасчета.ЕдиныйПланСчетов);
	
	Отказ = Ложь;
	РаботаСПереоценкой.ЗаполнитьКотировки(Объект,,, Отказ);
	
	ТаблицаЦен = Объект.ЦенныеБумаги;
	ТаблицаОблигаций.Сортировать("Категория");
	ТаблицаЦен.Свернуть("ЦеннаяБумага, ИсточникЦены, ОценочнаяЦена");
	
	СуммаПоКатегории = 0;
	СуммаНКДПоКатегории = 0;
	ТекКатегория = ТаблицаОблигаций[0].Категория;
	Для Каждого СтрокаОблигации Из ТаблицаОблигаций Цикл
		Если ТекКатегория <> СтрокаОблигации.Категория Тогда
			НайдСтрокиКатегории = ТаблицаГрупп.НайтиСтроки(Новый Структура("Категория", ТекКатегория));
			Для Каждого СтрокаКатегории Из НайдСтрокиКатегории Цикл
				СтрокаКатегории.СуммаРынок = СуммаПоКатегории;
				СтрокаКатегории.КупонРынок = СуммаНКДПоКатегории;
			КонецЦикла;
			ТекКатегория        = СтрокаОблигации.Категория;
			СуммаПоКатегории    = 0;
			СуммаНКДПоКатегории = 0;
		КонецЕсли;
		
		// Сначала проверим дефолты
		НайденныеСтроки = ТаблицаДефолтов.НайтиСтроки(Новый Структура("Облигация", СтрокаОблигации.ЦеннаяБумага));
		Если НайденныеСтроки.Количество() >= 1 Тогда // Облигация в дефолте, рыночную стоимость и НКД считаем равными 0
			СтрокаОблигации.СуммаРынок = 0;
			СтрокаОблигации.КупонРынок = 0;
			Продолжить;
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаЦен.НайтиСтроки(Новый Структура("ЦеннаяБумага", СтрокаОблигации.ЦеннаяБумага));
		Если НайденныеСтроки.Количество() = 1 Тогда
			Котировка = НайденныеСтроки[0].ОценочнаяЦена;
			РыночнаяБезНКД = Окр(СтрокаОблигации.Количество * Котировка, 2);
			СтрокаОблигации.СуммаРынок = РыночнаяБезНКД;
			СуммаПоКатегории = СуммаПоКатегории + СтрокаОблигации.СуммаРынок;
			
			НКД = ?(ЗначениеЗаполнено(СтрокаОблигации.КупонРынок),
				СтрокаОблигации.КупонРынок,
				СтрокаОблигации.Количество * РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(СтрокаОблигации.ЦеннаяБумага, ПериодДата, ЭтотОбъект.СчетДоверительногоУправления));
			СтрокаОблигации.КупонРынок = НКД;
			СуммаНКДПоКатегории = СуммаНКДПоКатегории + НКД;
		КонецЕсли;
	КонецЦикла;
	
	НайдСтрокиКатегории = ТаблицаГрупп.НайтиСтроки(Новый Структура("Категория", ТекКатегория));
	Для Каждого СтрокаКатегории Из НайдСтрокиКатегории Цикл
		СтрокаКатегории.СуммаРынок = СуммаПоКатегории;
		СтрокаКатегории.КупонРынок = СуммаНКДПоКатегории;
	КонецЦикла;
	
	Возврат Новый Структура("Облигации, ГруппыОблигаций", ТаблицаОблигаций, ТаблицаГрупп);
КонецФункции

Функция ПолучитьОстаткиЦБКупленныхПоРЕПО(Период, ПериодДата)
	
	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период КАК Период,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Регистратор КАК Регистратор,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.НомерСтроки КАК НомерСтроки,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность КАК Активность,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация КАК Организация,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива КАК ВидАктива,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики КАК СубъектАналитики,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Контрагент КАК Контрагент,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Основание,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности КАК ВидЗадолженности,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта КАК Валюта,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынок КАК СуммаРынок,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынокВВалютеУчета КАК СуммаРынокВВалютеУчета,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ДатаПогашения КАК ДатаПогашения,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ДатаРегистрации КАК ДатаРегистрации,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА ТИПЗНАЧЕНИЯ(НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ""Облигация""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЦБ
		|ПОМЕСТИТЬ _СтоимостьАктивов
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|ГДЕ
		|	(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|			ИЛИ СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги))
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПервойЧастиРЕПО)
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = &Период
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(СделкаРЕПОЦенныеБумаги.Количество) КАК Количество,
		|	СделкаРЕПОЦенныеБумаги.Цена КАК Цена,
		|	СделкаРЕПОЦенныеБумаги.Ссылка КАК Ссылка,
		|	СУММА(СделкаРЕПОЦенныеБумаги.СуммаКупона) КАК СуммаКупона
		|ПОМЕСТИТЬ _КоличествоЦБ
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|ГДЕ
		|	СделкаРЕПОЦенныеБумаги.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_СтоимостьАктивов.Основание
		|			ИЗ
		|				_СтоимостьАктивов КАК _СтоимостьАктивов)
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага,
		|	СделкаРЕПОЦенныеБумаги.Цена,
		|	СделкаРЕПОЦенныеБумаги.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ЕСТЬNULL(БухПартииЦенныхБумагКупленныеПоРЕПООстатки.СтоимостьОстаток, 0)) КАК Сумма
		|ПОМЕСТИТЬ _ПроверкаПоРегистру
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумагКупленныеПоРЕПО.Остатки(
		|			&ПериодГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК БухПартииЦенныхБумагКупленныеПоРЕПООстатки
		|;
		|	
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтоимостьАктивов.СубъектАналитики КАК СубъектАналитики,
		|	_СтоимостьАктивов.Валюта КАК Валюта,
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивов.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги)
		|				ТОГДА _СтоимостьАктивов.СуммаРынокВВалютеУчета
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаРынок,
		|	_СтоимостьАктивов.Номинал КАК Номинал,
		|	_СтоимостьАктивов.ДатаПогашения КАК ДатаПогашения,
		|	_СтоимостьАктивов.ДатаРегистрации КАК ДатаРегистрации,
		|	_СтоимостьАктивов.Эмитент КАК Эмитент,
		|	_СтоимостьАктивов.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	_СтоимостьАктивов.ТипЦБ КАК ТипЦБ,
		|	_КоличествоЦБ.Количество КАК Количество,
		|	_КоличествоЦБ.Цена КАК Цена,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеЭмитента,
		|	СУММА(ВЫБОР
		|			КОГДА _СтоимостьАктивов.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДебиторскаяЗадолженность)
		|				ТОГДА _СтоимостьАктивов.СуммаРынокВВалютеУчета
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Купон,
		|	_ПроверкаПоРегистру.Сумма КАК Проверка
		|ИЗ
		|	_СтоимостьАктивов КАК _СтоимостьАктивов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КоличествоЦБ КАК _КоличествоЦБ
		|		ПО _СтоимостьАктивов.СубъектАналитики = _КоличествоЦБ.ЦеннаяБумага
		|			И _СтоимостьАктивов.Основание = _КоличествоЦБ.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО _СтоимостьАктивов.Эмитент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо,
		|	_ПроверкаПоРегистру КАК _ПроверкаПоРегистру
		|ГДЕ
		|	_ПроверкаПоРегистру.Сумма <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_СтоимостьАктивов.СубъектАналитики,
		|	_СтоимостьАктивов.Валюта,
		|	_СтоимостьАктивов.Номинал,
		|	_СтоимостьАктивов.ДатаПогашения,
		|	_СтоимостьАктивов.ДатаРегистрации,
		|	_СтоимостьАктивов.Эмитент,
		|	_СтоимостьАктивов.ГосударственныйРегистрационныйНомер,
		|	_СтоимостьАктивов.ТипЦБ,
		|	_КоличествоЦБ.Количество,
		|	_КоличествоЦБ.Цена,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу,
		|	_ПроверкаПоРегистру.Сумма
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТипЦБ";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", 					  НачалоДня(ПериодДата));
	Запрос.УстановитьПараметр("ПериодГраница", 				  Период);
	Запрос.УстановитьПараметр("Организация", 	 			  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
				
	Возврат Запрос.Выполнить().Выгрузить();	
	
