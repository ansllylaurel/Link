		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""АкцииНам Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""АкцииМы Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ПаиНам Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ПаиМы Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ОстаткиОблигацийНам Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ОстаткиОблигацийМы Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ОблигацииНам Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ОблигацииМы Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ГруппыОблигацииНам Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 0
		|	""ГруппыОблигацииМы Заглушка"" КАК ВидАктива,
		|	0 КАК Сумма
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_ЗадолженностьБУ.ДСОжидаемые КАК ДСОжидаемые,
		|	_ЗадолженностьБУ.ДСБлокированные КАК ДСБлокированные,
		|	_ЗадолженностьБУ.Контрагент КАК Контрагент,
		|	_ЗадолженностьБУ.ДоговорСделка КАК ДоговорСделка,
		|	_ЗадолженностьБУ.ВидЗадолженности КАК ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА _ЗадолженностьБУ.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|			ТОГДА ""По сделке Т+ № "" + ВЫРАЗИТЬ(_ЗадолженностьБУ.ДоговорСделка КАК Документ.Сделка).НомерСделки
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Документ.ВводЦенныхБумаг)
		|				ИЛИ ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
		|				ИЛИ ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Документ.НачислениеЗадолженности)
		|				ИЛИ ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Документ.Сделка)
		|				ИЛИ ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Документ.СделкаРЕПО)
		|				ИЛИ ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Документ.СделкаСВалютой)
		|			ТОГДА _ЗадолженностьБУ.ВидЗадолженности
		|		КОГДА _ЗадолженностьБУ.ВидЗадолженности = ""По начислению дивидендов""
		|			ТОГДА ""Дивиденды "" + _ЗадолженностьБУ.ДоговорСделка.Эмитент.Наименование + "", "" + ВЫБОР
		|					КОГДА ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Справочник.Акции)
		|						ТОГДА _ЗадолженностьБУ.ДоговорСделка.ГосударственныйРегистрационныйНомер
		|					КОГДА ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Справочник.Паи)
		|						ТОГДА _ЗадолженностьБУ.ДоговорСделка.ГосударственныйРегистрационныйНомер
		|					КОГДА ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Справочник.ДепозитарныеРасписки)
		|						ТОГДА _ЗадолженностьБУ.ДоговорСделка.РегистрационныйНомер
		|				КОНЕЦ
		|		КОГДА _ЗадолженностьБУ.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона))
		|			ТОГДА ""Купон "" + _ЗадолженностьБУ.ДоговорСделка.Эмитент.Наименование + "", "" + _ЗадолженностьБУ.ДоговорСделка.ГосударственныйРегистрационныйНомер
		|		КОГДА _ЗадолженностьБУ.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации))
		|			ТОГДА ""Облигация "" + _ЗадолженностьБУ.ДоговорСделка.Эмитент.Наименование
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(Справочник.ВидыЗадолженности)
		|				ИЛИ ТИПЗНАЧЕНИЯ(_ЗадолженностьБУ.ДоговорСделка) = ТИП(СТРОКА)
		|			ТОГДА _ЗадолженностьБУ.ДоговорСделка
		|		ИНАЧЕ _ЗадолженностьБУ.ВидЗадолженности
		|	КОНЕЦ КАК ДСОписание
		|ИЗ
		|	_ЗадолженностьБУ КАК _ЗадолженностьБУ
		|ГДЕ
		|	(_ЗадолженностьБУ.ДСОжидаемые <> 0
		|			ИЛИ _ЗадолженностьБУ.ДСБлокированные <> 0)";
		
	#КонецОбласти
		
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("Организация", 	 			  	Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	
	СубконтоКонтрагентыДоговоры = Новый Массив;
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	СубконтоКонтрагентыОснованиеРасчетов = Новый Массив;
	СубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СубконтоКонтрагентыОснованиеРасчетов.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОснованиеРасчетов);
	
	Запрос.УстановитьПараметр("СубконтоКонтрагентыДоговоры",	 		СубконтоКонтрагентыДоговоры);
	Запрос.УстановитьПараметр("СубконтоКонтрагентыОснованиеРасчетов", 	СубконтоКонтрагентыОснованиеРасчетов);
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

Функция ПолучитьОстаткиЦБКупленныхПоРЕПО_БУ(Период, ПериодДата)
	
	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПрочиеСредства.Контрагент КАК Контрагент,
		|	ПрочиеСредства.Основание КАК Основание,
		|	ПрочиеСредства.СуммаОстатокДт КАК СуммаОстатокДт,
		|	ПрочиеСредства.СуммаОстатокКт КАК СуммаОстатокКт
		|ПОМЕСТИТЬ _Задолженность
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕдиныйБухгалтерскийУчетОстатки.Контрагент КАК Контрагент,
		|		ЕдиныйБухгалтерскийУчетОстатки.Основание КАК Основание,
		|		СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт) КАК СуммаОстатокДт,
		|		СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт) КАК СуммаОстатокКт
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Основание,
		|			ВЫБОР
		|				КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.СделкаРЕПО
		|					ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.СделкаРЕПО).Контрагент
		|				ИНАЧЕ НЕОПРЕДЕЛЕНО
		|			КОНЕЦ КАК Контрагент,
		|			СУММА(ВЫБОР
		|					КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства21)
		|						ТОГДА -ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт
		|					ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт
		|				КОНЕЦ) КАК СуммаОстатокДт,
		|			СУММА(ВЫБОР
		|					КОГДА ЕдиныйБухгалтерскийУчетОстатки.Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства21)
		|						ТОГДА 0
		|					ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт
		|				КОНЕЦ) КАК СуммаОстатокКт
		|		ИЗ
		|			РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|					&Период,
		|					Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСредства)),
		|					,
		|					Организация = &Организация
		|						И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|						И ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Документ.СделкаРЕПО)) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЕдиныйБухгалтерскийУчетОстатки.Субконто2,
		|			ВЫБОР
		|				КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.СделкаРЕПО
		|					ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.СделкаРЕПО).Контрагент
		|				ИНАЧЕ НЕОПРЕДЕЛЕНО
		|			КОНЕЦ) КАК ЕдиныйБухгалтерскийУчетОстатки
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ЕдиныйБухгалтерскийУчетОстатки.Основание,
		|		ЕдиныйБухгалтерскийУчетОстатки.Контрагент) КАК ПрочиеСредства
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СделкаРЕПОЦенныеБумаги.Ссылка КАК Сделка,
		|	НоминалыЦенныхБумагСрезПоследних.Номинал КАК Номинал,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ДатаПогашения КАК ДатаПогашения,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ДатаРегистрации КАК ДатаРегистрации,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.Эмитент.ЮрФизЛицо КАК Эмитент,
		|	НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА ТИПЗНАЧЕНИЯ(НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ""Облигация""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ТипЦБ,
		|	УсловияСделокРЕПОСрезПоследних.Количество КАК Количество,
		|	УсловияСделокРЕПОСрезПоследних.Цена КАК Цена,
		|	УсловияСделокРЕПОСрезПоследних.СуммаКупона КАК СуммаКупона
		|ПОМЕСТИТЬ _ЦенныеБумагиСделкиРЕПО
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаРЕПОЦБ.Ссылка КАК Ссылка,
		|		СделкаРЕПОЦБ.ЦеннаяБумага КАК ЦеннаяБумага
		|	ИЗ
		|		Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦБ
		|	ГДЕ
		|		СделкаРЕПОЦБ.Ссылка В
		|				(ВЫБРАТЬ
		|					_Задолженность.Основание
		|				ИЗ
		|					_Задолженность
		|				ГДЕ
		|					ТИПЗНАЧЕНИЯ(_Задолженность.Основание) = ТИП(Документ.СделкаРЕПО))
		|		И СделкаРЕПОЦБ.НомерСтроки = 1) КАК СделкаРЕПОЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО СделкаРЕПОЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокРЕПО.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ЧастьСделкиРЕПО = 1) КАК УсловияСделокРЕПОСрезПоследних
		|		ПО СделкаРЕПОЦенныеБумаги.Ссылка = УсловияСделокРЕПОСрезПоследних.СделкаРЕПО
		|			И СделкаРЕПОЦенныеБумаги.ЦеннаяБумага = УсловияСделокРЕПОСрезПоследних.ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЦенныеБумагиСделкиРЕПО.ЦеннаяБумага КАК СубъектАналитики,
		|	_Задолженность.СуммаОстатокДт КАК СуммаБаланс,
		|	_ЦенныеБумагиСделкиРЕПО.Номинал КАК Номинал,
		|	_ЦенныеБумагиСделкиРЕПО.ДатаПогашения КАК ДатаПогашения,
		|	_ЦенныеБумагиСделкиРЕПО.ДатаРегистрации КАК ДатаРегистрации,
		|	_ЦенныеБумагиСделкиРЕПО.Эмитент КАК Эмитент,
		|	_ЦенныеБумагиСделкиРЕПО.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	_ЦенныеБумагиСделкиРЕПО.ТипЦБ КАК ТипЦБ,
		|	_ЦенныеБумагиСделкиРЕПО.Количество КАК Количество,
		|	_ЦенныеБумагиСделкиРЕПО.Цена КАК Цена,
		|	_ЦенныеБумагиСделкиРЕПО.СуммаКупона КАК Купон,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеЭмитента
		|ИЗ
		|	_Задолженность КАК _Задолженность
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумагиСделкиРЕПО КАК _ЦенныеБумагиСделкиРЕПО
		|		ПО _Задолженность.Основание = _ЦенныеБумагиСделкиРЕПО.Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (_ЦенныеБумагиСделкиРЕПО.Эмитент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТипЦБ";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", 					  	Период);
	Запрос.УстановитьПараметр("Организация", 	 			  	Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
				
	Возврат Запрос.Выполнить().Выгрузить();	
	
КонецФункции

Процедура ВывестиОстаткиАктивов(ТабДок, НаНачало = Ложь)
	
	Перем НоваяМетодикаРасчетаОценочнойСтоимости;
	
	Если Не (ЭтотОбъект.ВыводитьБалансовуюСтоимость Или ЭтотОбъект.ВыводитьРыночнуюСтоимость) Тогда
		Возврат;
	КонецЕсли;
	
	Если НаНачало Тогда
		Период = Новый Граница(НачалоДня(ЭтотОбъект.НачалоПериода), ВидГраницы.Включая);
		ПериодДата = ЭтотОбъект.НачалоПериода;
	Иначе
		Период = Новый Граница(КонецДня(ЭтотОбъект.КонецПериода), ВидГраницы.Включая);
		ПериодДата = ЭтотОбъект.КонецПериода;
	КонецЕсли;
	
	// Определяем методику расчета рыночной стоимости
	НоваяМетодикаРасчетаОценочнойСтоимости = Ложь;	
	Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
		ЦельРасчета		= Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении; 
		НастройкиОценки	= РаботаСПереоценкой.ОпределитьНастройкиОценки(ПериодДата, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЦельРасчета);
		ВидУчета		= НастройкиОценки.ВидУчетаДляОстатковПартий;
		
		НоваяМетодикаРасчетаОценочнойСтоимости = Истина;
		Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями
			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами
		Тогда
			Если НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхНакоплений
			ИЛИ НастройкиОценки.ВариантРасчетаОценочнойСтоимости = Справочники.ВариантыРасчетаОценочнойСтоимости.Рыночная2ДляПенсионныхРезервов Тогда
				НоваяМетодикаРасчетаОценочнойСтоимости = Ложь;
			КонецЕсли;	
		КонецЕсли;
	
		// Проверка на наличие рассчитанного СЧА
		Если НоваяМетодикаРасчетаОценочнойСтоимости Тогда
			Если Не РаботаСОтчетами.ПроверитьРегистрациюСЧА(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ПериодДата) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На " + Формат(ПериодДата, "ДФ=dd.MM.yyyy") + " не выполнена регистрация стоимости активов. Данные об остатках выведены не будут.");		
				Возврат;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Получаем макет и области
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетПустаяСтрока 			= Макет.ПолучитьОбласть("ПустаяСтрока");
	МакетШапка 					= Макет.ПолучитьОбласть("Шапка");
	МакетРаздел 				= Макет.ПолучитьОбласть("Раздел");
	МакетПодраздел 				= Макет.ПолучитьОбласть("Подраздел");
	МакетДС 					= Макет.ПолучитьОбласть("ДС");
	МакетДСШапка 				= Макет.ПолучитьОбласть("ДСШапка");
	МакетДССтрока 				= Макет.ПолучитьОбласть("ДССтрока");
	МакетДСДолгШапка 			= Макет.ПолучитьОбласть("ДСДолгШапка");
	МакетДСДолгСтрока 			= Макет.ПолучитьОбласть("ДСДолгСтрока");
	МакетДСДолгИтог 			= Макет.ПолучитьОбласть("ДСДолгИтог");
	МакетАкцииИПаи 				= Макет.ПолучитьОбласть("ГруппаАктивовАкцииИПаи|Главная");
	МакетАкцииИПаиБаланс 		= Макет.ПолучитьОбласть("ГруппаАктивовАкцииИПаи|Баланс");
	МакетАкцииИПаиРынок 		= Макет.ПолучитьОбласть("ГруппаАктивовАкцииИПаи|Рынок");
	МакетШапкаАкцииИПаи 		= Макет.ПолучитьОбласть("ШапкаАкцииИПаи|Главная");
	МакетШапкаАкцииИПаиБаланс 	= Макет.ПолучитьОбласть("ШапкаАкцииИПаи|Баланс");
	МакетШапкаАкцииИПаиРынок 	= Макет.ПолучитьОбласть("ШапкаАкцииИПаи|Рынок");
	МакетСтрокаАкцииИПаи 		= Макет.ПолучитьОбласть("СтрокаАкцииИПаи|Главная");
	МакетСтрокаАкцииИПаиБаланс 	= Макет.ПолучитьОбласть("СтрокаАкцииИПаи|Баланс");
	МакетСтрокаАкцииИПаиРынок 	= Макет.ПолучитьОбласть("СтрокаАкцииИПаи|Рынок");
	МакетДоли 					= Макет.ПолучитьОбласть("ГруппаАктивовДоли|Главная");
	МакетДолиБаланс 			= Макет.ПолучитьОбласть("ГруппаАктивовДоли|Баланс");
	МакетДолиРынок 				= Макет.ПолучитьОбласть("ГруппаАктивовДоли|Рынок");
	МакетШапкаДоли 				= Макет.ПолучитьОбласть("ШапкаДоли|Главная");
	МакетШапкаДолиБаланс 		= Макет.ПолучитьОбласть("ШапкаДоли|Баланс");
	МакетШапкаДолиРынок 		= Макет.ПолучитьОбласть("ШапкаДоли|Рынок");
	МакетСтрокаДоли 			= Макет.ПолучитьОбласть("СтрокаДоли|Главная");
	МакетСтрокаДолиБаланс 		= Макет.ПолучитьОбласть("СтрокаДоли|Баланс");
	МакетСтрокаДолиРынок 		= Макет.ПолучитьОбласть("СтрокаДоли|Рынок");
	МакетОблигации 				= Макет.ПолучитьОбласть("ГруппаАктивовОблигации|Главная");
	МакетОблигацииБаланс 		= Макет.ПолучитьОбласть("ГруппаАктивовОблигации|Баланс");
	МакетОблигацииРынок 		= Макет.ПолучитьОбласть("ГруппаАктивовОблигации|Рынок");
	МакетШапкаОблигации 		= Макет.ПолучитьОбласть("ШапкаОблигации|Главная");
	МакетШапкаОблигацииБаланс 	= Макет.ПолучитьОбласть("ШапкаОблигации|Баланс");
	МакетШапкаОблигацииРынок 	= Макет.ПолучитьОбласть("ШапкаОблигации|Рынок");
	МакетСтрокаОблигации 		= Макет.ПолучитьОбласть("СтрокаОблигации|Главная");
	МакетСтрокаОблигацииБаланс 	= Макет.ПолучитьОбласть("СтрокаОблигации|Баланс");
	МакетСтрокаОблигацииРынок 	= Макет.ПолучитьОбласть("СтрокаОблигации|Рынок");
	МакетГруппаОблигации 		= Макет.ПолучитьОбласть("ГруппаОблигаций|Главная");
	МакетГруппаОблигацииБаланс 	= Макет.ПолучитьОбласть("ГруппаОблигаций|Баланс");
	МакетГруппаОблигацииРынок 	= Макет.ПолучитьОбласть("ГруппаОблигаций|Рынок");
	МакетДепозиты 				= Макет.ПолучитьОбласть("ГруппаАктивовДепозиты");
	МакетШапкаДепозиты 			= Макет.ПолучитьОбласть("ШапкаДепозиты");
	МакетСтрокаДепозиты 		= Макет.ПолучитьОбласть("СтрокаДепозиты");
	МакетПодвалБумаги 			= Макет.ПолучитьОбласть("ПодвалБумаги|Главная");
	МакетПодвалБумагиБаланс 	= Макет.ПолучитьОбласть("ПодвалБумаги|Баланс");
	МакетПодвалБумагиРынок 		= Макет.ПолучитьОбласть("ПодвалБумаги|Рынок");	
	МакетГруппаРЕПО				= Макет.ПолучитьОбласть("ГруппаАктивовРЕПО|" + ?(НоваяМетодикаРасчетаОценочнойСтоимости, "ДепозитыНачало", "Главная"));
	МакетГруппаРЕПОРынок		= Макет.ПолучитьОбласть("ГруппаАктивовРЕПО|" + ?(НоваяМетодикаРасчетаОценочнойСтоимости, "РынокРЕПО", "Рынок"));
	МакетГруппаРЕПОБаланс		= Макет.ПолучитьОбласть("ГруппаАктивовРЕПО|Баланс");
	МакетШапкаРЕПО				= Макет.ПолучитьОбласть("ШапкаАктивовРЕПО|" + ?(НоваяМетодикаРасчетаОценочнойСтоимости, "ДепозитыНачало", "Главная"));
	МакетШапкаРЕПОРынок			= Макет.ПолучитьОбласть("ШапкаАктивовРЕПО|" + ?(НоваяМетодикаРасчетаОценочнойСтоимости, "РынокРЕПО", "Рынок"));
	МакетШапкаРЕПОБаланс		= Макет.ПолучитьОбласть("ШапкаАктивовРЕПО|Баланс");
	МакетСтрокаРЕПО				= Макет.ПолучитьОбласть("СтрокаАктивовРЕПО|" + ?(НоваяМетодикаРасчетаОценочнойСтоимости, "ДепозитыНачало", "Главная"));
	МакетСтрокаРЕПОРынок		= Макет.ПолучитьОбласть("СтрокаАктивовРЕПО|" + ?(НоваяМетодикаРасчетаОценочнойСтоимости, "РынокРЕПО", "Рынок"));
	МакетСтрокаРЕПОБаланс		= Макет.ПолучитьОбласть("СтрокаАктивовРЕПО|Баланс");	
		
	// По новой методике рычночную стоимость активов берем из СЧА
	Если ЭтотОбъект.ВыводитьРыночнуюСтоимость И НоваяМетодикаРасчетаОценочнойСтоимости Тогда
		
		РСА = ОпределитьРыночнуюСтоимостьАктивов(ПериодДата, ЦельРасчета, ВидУчета);
		
		ДСРС				= РСА[2].Выгрузить();
		ДСБрокер			= РСА[3].Выгрузить();
		ЗадолженностиДС		= РСА[4].Выгрузить();
		Акции				= РСА[5].Выгрузить();
		Паи					= РСА[6].Выгрузить();
		Доли				= РСА[7].Выгрузить();
		Облигации			= РСА[9].Выгрузить();
		ГруппыОблигации		= РСА[10].Выгрузить();
		Депозиты			= РСА[11].Выгрузить();
		АкцииНам			= РСА[12].Выгрузить();
		АкцииМы				= РСА[13].Выгрузить();
		ПаиНам 				= РСА[14].Выгрузить();
		ПаиМы				= РСА[15].Выгрузить();
		ОблигацииНам		= РСА[18].Выгрузить();
		ОблигацииМы			= РСА[19].Выгрузить();
		ГруппыОблигацииНам	= РСА[20].Выгрузить();
		ГруппыОблигацииМы	= РСА[21].Выгрузить();
		ЦБКупленныеПоРЕПО	= РСА[24].Выгрузить();
		Резервы				= РСА[25].Выгрузить();
		
	Иначе
		
		// Старая методика определения стоимости активов
		
		ДСРС 				= ПолучитьОстаткиДС(Период);
		ДСБрокер 			= ПолучитьОстаткиДС(Период, Истина);
		ЗадолженностиДС 	= ПолучитьЗадолженностиДС(Период);
		Акции 				= ПолучитьОстаткиАкции(Период, ПериодДата);
		Паи 				= ПолучитьОстаткиПаи(Период, ПериодДата);
		Доли 				= ПолучитьОстаткиДоли(Период, ПериодДата);
		ОстаткиОблигаций 	= ПолучитьОстаткиОблигации(Период, ПериодДата);
		Облигации 			= ОстаткиОблигаций.Облигации;
		ГруппыОблигации 	= ОстаткиОблигаций.ГруппыОблигаций;
		Депозиты			= ПолучитьОстаткиДепозитов(Период, ПериодДата);
		
		Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
			
			АкцииНам 			= ПолучитьАкцииВПути(Период, Перечисления.ТипыЗадолженности.Дебиторская);
			АкцииМы 			= ПолучитьАкцииВПути(Период, Перечисления.ТипыЗадолженности.Кредиторская);
			ПаиНам 				= ПолучитьПаиВПути(Период, Перечисления.ТипыЗадолженности.Дебиторская);
			ПаиМы 				= ПолучитьПаиВПути(Период, Перечисления.ТипыЗадолженности.Кредиторская);
			ОстаткиОблигацийНам = ПолучитьОблигацииВПути(Период, Перечисления.ТипыЗадолженности.Дебиторская);
			ОстаткиОблигацийМы 	= ПолучитьОблигацииВПути(Период, Перечисления.ТипыЗадолженности.Кредиторская);
			ОблигацииНам 		= ОстаткиОблигацийНам.Облигации;
			ОблигацииМы 		= ОстаткиОблигацийМы.Облигации;
			ГруппыОблигацииНам 	= ОстаткиОблигацийНам.ГруппыОблигаций;
			ГруппыОблигацииМы  	= ОстаткиОблигацийМы.ГруппыОблигаций;
			ЦБКупленныеПоРЕПО  	= ПолучитьОстаткиЦБКупленныхПоРЕПО(Период, ПериодДата);
			
		Иначе
			
			ПакетЗапросаБУ = ПолучитьЗадолженностьБУ(Период, ПериодДата); 
			
			ЗадолженностиДС		= ПакетЗапросаБУ[13].Выгрузить();
			АкцииНам			= ПакетЗапросаБУ[3].Выгрузить();
			АкцииМы				= ПакетЗапросаБУ[4].Выгрузить();
			ПаиНам 				= ПакетЗапросаБУ[5].Выгрузить();
			ПаиМы				= ПакетЗапросаБУ[6].Выгрузить();
			ОстаткиОблигацийНам	= ПакетЗапросаБУ[7].Выгрузить();
			ОстаткиОблигацийМы	= ПакетЗапросаБУ[8].Выгрузить();
			ОблигацииНам		= ПакетЗапросаБУ[9].Выгрузить();
			ОблигацииМы			= ПакетЗапросаБУ[10].Выгрузить();
			ГруппыОблигацииНам	= ПакетЗапросаБУ[11].Выгрузить();
			ГруппыОблигацииМы	= ПакетЗапросаБУ[12].Выгрузить();  			
			ЦБКупленныеПоРЕПО  	= ПолучитьОстаткиЦБКупленныхПоРЕПО_БУ(Период, ПериодДата);
			
		КонецЕсли; 
			
		Резервы				= Неопределено;//Пока необходимости для НПФ не было 
		
	КонецЕсли;
	
	Если ЦБКупленныеПоРЕПО = Неопределено Тогда
		Возврат;
	КонецЕсли;
			
	ИтогДСРС 			= ДСРС.Итог("СуммаРубли");
	ИтогДСБрокер 		= ДСБрокер.Итог("СуммаРубли");
	ИтогДС 				= ИтогДСРС + ИтогДСБрокер; 
	ИтогДСОжидаемые 	= ЗадолженностиДС.Итог("ДСОжидаемые");
	ИтогДСБлокированные = ЗадолженностиДС.Итог("ДСБлокированные"); 	
	
	МакетШапкаОстатков = Макет.ПолучитьОбласть("ШапкаОстатков");
	
	МакетШапкаОстатков.Параметры.НачалоКонецПериода = ?(НаНачало, "начало", "конец");
	ИтогоСуммаАктивов = ИтогДС + ИтогДСОжидаемые - ИтогДСБлокированные;
	
	ТабДок.Вывести(МакетПустаяСтрока);

	Если ВыводитьБалансовуюСтоимость Тогда
		ИтогоСуммаАктивов = ИтогоСуммаАктивов + Депозиты.Итог("Номинал") + Депозиты.Итог("Проценты") 
					+ Акции.Итог("Сумма") 
					+ Паи.Итог("Сумма") 
					+ Доли.Итог("Сумма") 
					+ Облигации.Итог("Сумма") 
					+ АкцииНам.Итог("Сумма")
					+ ПаиНам.Итог("Сумма")
					+ ОблигацииНам.Итог("Сумма")
					+ ЦБКупленныеПоРЕПО.Итог("СуммаБаланс")
					- АкцииМы.Итог("Сумма")
					- ПаиМы.Итог("Сумма")
					- ОблигацииМы.Итог("Сумма");	
	Иначе
		ИтогоСуммаАктивов = ИтогоСуммаАктивов + Депозиты.Итог("СуммаРынок") + Депозиты.Итог("КупонРынок")
					+ Акции.Итог("СуммаРынок") 
					+ Паи.Итог("СуммаРынок") 
					+ Доли.Итог("СуммаРынок") 
					+ Облигации.Итог("СуммаРынок") + Облигации.Итог("КупонРынок")
					+ АкцииНам.Итог("Сумма")
					+ ПаиНам.Итог("Сумма")
					+ ОблигацииНам.Итог("Сумма")
					+ ЦБКупленныеПоРЕПО.Итог("СуммаРынок") + ЦБКупленныеПоРЕПО.Итог("Купон")
					- АкцииМы.Итог("Сумма")
					- ПаиМы.Итог("Сумма")
					- ОблигацииМы.Итог("Сумма");
		Если Резервы <> Неопределено Тогда
			ИтогоСуммаАктивов = ИтогоСуммаАктивов - Резервы.Итог("СуммаРезерва");			
		КонецЕсли;				
	КонецЕсли;	
	
	МакетШапкаОстатков.Параметры.ИтогоСтоимостьАктивов 	= Формат(ИтогоСуммаАктивов, "ЧДЦ=2; ЧРГ=' '; ЧН=0");
	МакетШапкаОстатков.Параметры.ВидСтоимости 			= ?(ВыводитьБалансовуюСтоимость, "балансовая", "рыночная");
	
	МакетШапкаОстатков.Параметры.СноскаПроРезервыВОценочнойСтоимости = ?(ВыводитьБалансовуюСтоимость, "", "Оценочная стоимость финансовых вложений отображается с учетом резерва на возможные потери(обесценение) в случае его наличия");
	
	ТабДок.Вывести(МакетШапкаОстатков);
		
	МакетПодраздел.Параметры.Подраздел = "Денежные средства: ";
	ТабДок.Вывести(МакетПодраздел);
		
	МакетДС.Параметры.ДенежныеСредстваСтрока = Формат(ИтогДС, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '") + "(" + ЧислоПрописью(ИтогДС, , ЭтотОбъект.Организация.ВалютаУчета.ПараметрыПрописиНаРусском) + ")";
	ТабДок.Вывести(МакетДС);
	
	Если ДСРС.Количество() > 0 Тогда
		МакетДСШапка.Параметры.ДСМестоУчета = "В т.ч. на расчетных счетах: " + Формат(ИтогДСРС, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '") + "(" + ЧислоПрописью(ИтогДСРС, , ЭтотОбъект.Организация.ВалютаУчета.ПараметрыПрописиНаРусском) + ")";
		ТабДок.Вывести(МакетДСШапка);
				
		Для каждого СтрокаДС Из ДСРС Цикл
			ЗаполнитьЗначенияСвойств(МакетДССтрока.Параметры, СтрокаДС);
			ТабДок.Вывести(МакетДССтрока);
		КонецЦикла;
	КонецЕсли;	
	
	Если ДСБрокер.Количество() > 0 Тогда
		МакетДСШапка.Параметры.ДСМестоУчета = "          на брокерских счетах: " + Формат(ИтогДСБрокер, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '") + "(" + ЧислоПрописью(ИтогДСБрокер, , ЭтотОбъект.Организация.ВалютаУчета.ПараметрыПрописиНаРусском) + ")";
		ТабДок.Вывести(МакетДСШапка);
	          	
		Для каждого СтрокаДС Из ДСБрокер Цикл
			ЗаполнитьЗначенияСвойств(МакетДССтрока.Параметры, СтрокаДС);
			ТабДок.Вывести(МакетДССтрока);
		КонецЦикла;
	КонецЕсли;	
		
	Если ЗадолженностиДС.Количество() > 0 Тогда
		МакетПодраздел.Параметры.Подраздел = "Задолженности: ";
		ТабДок.Вывести(МакетПодраздел);
			
		ТабДок.Вывести(МакетДСДолгШапка);
		
		Для каждого СтрокаДС Из ЗадолженностиДС Цикл
			ЗаполнитьЗначенияСвойств(МакетДСДолгСтрока.Параметры, СтрокаДС);
			ТабДок.Вывести(МакетДСДолгСтрока);
		КонецЦикла;
			
		МакетДСДолгИтог.Параметры.ДСОжидаемыеИтог 		= ИтогДСОжидаемые; 
		МакетДСДолгИтог.Параметры.ДСБлокированныеИтог 	= ИтогДСБлокированные; 
		ТабДок.Вывести(МакетДСДолгИтог);
	КонецЕсли;	
	
	Если Резервы <> Неопределено Тогда
		ИтогРезервы = Резервы.Итог("СуммаРезерва");
		МакетПодраздел.Параметры.Подраздел = "Резервы: " + Формат(ИтогРезервы, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '") + "(" + ЧислоПрописью(ИтогРезервы, , ЭтотОбъект.Организация.ВалютаУчета.ПараметрыПрописиНаРусском) + ")";
		ТабДок.Вывести(МакетПодраздел);
	КонецЕсли;
	
	МакетПодраздел.Параметры.Подраздел = "Финансовые вложения:";
	ТабДок.Вывести(МакетПодраздел);
	
	Если Депозиты.Количество() > 0 Тогда
				
		МакетШапкаДепозитыНачало 		= Макет.ПолучитьОбласть("ШапкаДепозитыОстатки|ДепозитыНачало");
		МакетШапкаДепозитыСтоимость 	= ?(ВыводитьБалансовуюСтоимость, Макет.ПолучитьОбласть("ШапкаДепозитыОстатки|ДепозитыБалансоваяСтоимость"), Макет.ПолучитьОбласть("ШапкаДепозитыОстатки|ДепозитыОценочнаяСтоимость"));
		МакетШапкаДепозитыПроценты 		= Макет.ПолучитьОбласть("ШапкаДепозитыОстатки|ДепозитыПроценты");
		МакетСтрокаДепозитыНачало 		= Макет.ПолучитьОбласть("СтрокаДепозитыОстатки|ДепозитыНачало");
		МакетСтрокаДепозитыСтоимость 	= ?(ВыводитьБалансовуюСтоимость, Макет.ПолучитьОбласть("СтрокаДепозитыОстатки|ДепозитыБалансоваяСтоимость"), Макет.ПолучитьОбласть("СтрокаДепозитыОстатки|ДепозитыОценочнаяСтоимость"));
		МакетСтрокаДепозитыПроценты 	= Макет.ПолучитьОбласть("СтрокаДепозитыОстатки|ДепозитыПроценты"); 	                             
	
		ТабДок.Вывести(МакетПустаяСтрока);
		
		ТабДок.Вывести(МакетШапкаДепозитыНачало);
		
		МакетШапкаДепозитыСтоимость.Параметры.Стоимость = ?(ВыводитьБалансовуюСтоимость, Депозиты.Итог("Номинал"), Депозиты.Итог("СуммаРынок"));
		ТабДок.Присоединить(МакетШапкаДепозитыСтоимость);
		
		МакетШапкаДепозитыПроценты.Параметры.Проценты   = ?(ВыводитьБалансовуюСтоимость, Депозиты.Итог("Проценты"), Депозиты.Итог("КупонРынок"));
		ТабДок.Присоединить(МакетШапкаДепозитыПроценты);
				
		Для каждого СтрокаДепозиты Из Депозиты Цикл
			
			ДанныеДепозита = РаботаСКредитнымиИнструментами.ПолучитьДанныеКредитногоИнструмента(СтрокаДепозиты.ДепозитныйВклад);
						
			МакетСтрокаДепозитыНачало.Параметры.НаименованиеБанка 		= Строка(ДанныеДепозита.НаименованиеБанка) + ", " + Формат(ДанныеДепозита.ДатаОткрытия, "ДФ=dd.MM.yyyy") + "/" + Формат(ДанныеДепозита.ДатаПогашения, "ДФ=dd.MM.yyyy; ДП=Неопределено") + "," + Строка(ДанныеДепозита.Процент) + "%";
			МакетСтрокаДепозитыНачало.Параметры.НаименованиеДоговора 	= "депозит, " + ДанныеДепозита.НомерДоговора + "," + Формат(ДанныеДепозита.ДатаОткрытия, "ДФ=dd.MM.yyyy") + "/" + Формат(ДанныеДепозита.ДатаПогашения, "ДФ=dd.MM.yyyy; ДП=Неопределено");
			
			МакетСтрокаДепозитыНачало.Параметры.Номинал = СтрокаДепозиты.Номинал; //Формат(СтрокаДепозиты.Номинал, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '");
			ТабДок.Вывести(МакетСтрокаДепозитыНачало);
			
			МакетСтрокаДепозитыСтоимость.Параметры.Стоимость = ?(ВыводитьБалансовуюСтоимость, СтрокаДепозиты.Номинал, СтрокаДепозиты.СуммаРынок); //Формат(СтрокаДепозиты.Номинал, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '");
			ТабДок.Присоединить(МакетСтрокаДепозитыСтоимость);
			
			МакетСтрокаДепозитыПроценты.Параметры.Проценты = ?(ВыводитьБалансовуюСтоимость, СтрокаДепозиты.Проценты, СтрокаДепозиты.КупонРынок); //Формат(СтрокаДепозиты.Проценты, "ЧЦ=19; ЧДЦ=2; ЧРГ=' '");
			ТабДок.Присоединить(МакетСтрокаДепозитыПроценты);   			
			
		КонецЦикла;
		
		ТабДок.Вывести(МакетПустаяСтрока);

	КонецЕсли;
	
	Если Акции.Количество() > 0 Тогда
		
		МакетАкцииИПаи.Параметры.ГруппаАктивов = "АКЦИИ";
		ТабДок.Вывести(МакетАкцииИПаи);
		Если ЭтотОбъект.ВыводитьБалансовуюСтоимость Тогда
			МакетАкцииИПаиБаланс.Параметры.ИтогБаланс = Акции.Итог("Сумма");
			ТабДок.Присоединить(МакетАкцииИПаиБаланс);
		КонецЕсли;
		
		Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
			МакетАкцииИПаиРынок.Параметры.ИтогРынок = Акции.Итог("СуммаРынок");
			ТабДок.Присоединить(МакетАкцииИПаиРынок);
		КонецЕсли;
		
		ТабДок.Вывести(МакетШапкаАкцииИПаи);
		Если ЭтотОбъект.ВыводитьБалансовуюСтоимость Тогда
			ТабДок.Присоединить(МакетШапкаАкцииИПаиБаланс);
		КонецЕсли;
		
		Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
			ТабДок.Присоединить(МакетШапкаАкцииИПаиРынок);
		КонецЕсли;
		
		Для каждого СтрокаАкции Из Акции Цикл
			
			МакетСтрокаАкцииИПаи.Параметры.ОписаниеЦБ 	= СтрокаАкции.Эмитент;
			МакетСтрокаАкцииИПаи.Параметры.СерияНомерЦБ = "акция " + НРег(Строка(СтрокаАкции.Тип)) + ", " + СтрокаАкции.ГосударственныйРегистрационныйНомер;
			МакетСтрокаАкцииИПаи.Параметры.Количество 	= СтрокаАкции.Количество;
			МакетСтрокаАкцииИПаи.Параметры.Номинал 		= СтрокаАкции.Номинал;
			ТабДок.Вывести(МакетСтрокаАкцииИПаи);
			
			Если ЭтотОбъект.ВыводитьБалансовуюСтоимость Тогда
				МакетСтрокаАкцииИПаиБаланс.Параметры.Цена 	= ?(СтрокаАкции.Количество > 0, СтрокаАкции.Сумма / СтрокаАкции.Количество, 0);
				МакетСтрокаАкцииИПаиБаланс.Параметры.Баланс = СтрокаАкции.Сумма;
				ТабДок.Присоединить(МакетСтрокаАкцииИПаиБаланс);
			КонецЕсли;
			Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
				МакетСтрокаАкцииИПаиРынок.Параметры.Цена 	= ?(СтрокаАкции.Количество > 0, СтрокаАкции.СуммаРынок / СтрокаАкции.Количество, 0);
				МакетСтрокаАкцииИПаиРынок.Параметры.Баланс 	= СтрокаАкции.СуммаРынок;
				ТабДок.Присоединить(МакетСтрокаАкцииИПаиРынок);
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
		
	Если Паи.Количество() > 0 Тогда
		
		ТабДок.Вывести(МакетПустаяСтрока);
		
		МакетАкцииИПаи.Параметры.ГруппаАктивов = "ПАИ";
		ТабДок.Вывести(МакетАкцииИПаи);
		Если ЭтотОбъект.ВыводитьБалансовуюСтоимость Тогда
			МакетАкцииИПаиБаланс.Параметры.ИтогБаланс = Паи.Итог("Сумма");
			ТабДок.Присоединить(МакетАкцииИПаиБаланс);
		КонецЕсли;
		Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
			МакетАкцииИПаиРынок.Параметры.ИтогРынок = Паи.Итог("СуммаРынок");
			ТабДок.Присоединить(МакетАкцииИПаиРынок);
		КонецЕсли;
		
		ТабДок.Вывести(МакетШапкаАкцииИПаи);
		Если ЭтотОбъект.ВыводитьБалансовуюСтоимость Тогда
			ТабДок.Присоединить(МакетШапкаАкцииИПаиБаланс);
		КонецЕсли;
		Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
			ТабДок.Присоединить(МакетШапкаАкцииИПаиРынок);
		КонецЕсли;
		
		Для каждого СтрокаПаи Из Паи Цикл
			
			МакетСтрокаАкцииИПаи.Параметры.ОписаниеЦБ 	= СтрокаПаи.Эмитент;
			МакетСтрокаАкцииИПаи.Параметры.СерияНомерЦБ = СтрокаПаи.ГосударственныйРегистрационныйНомер;
			МакетСтрокаАкцииИПаи.Параметры.Количество 	= СтрокаПаи.Количество;
			МакетСтрокаАкцииИПаи.Параметры.Номинал 		= СтрокаПаи.Номинал;
			ТабДок.Вывести(МакетСтрокаАкцииИПаи);
			
			Если ЭтотОбъект.ВыводитьБалансовуюСтоимость Тогда
				МакетСтрокаАкцииИПаиБаланс.Параметры.Цена 	= ?(СтрокаПаи.Количество > 0, СтрокаПаи.Сумма / СтрокаПаи.Количество, 0);
				МакетСтрокаАкцииИПаиБаланс.Параметры.Баланс = СтрокаПаи.Сумма;
				ТабДок.Присоединить(МакетСтрокаАкцииИПаиБаланс);
			КонецЕсли;
			Если ЭтотОбъект.ВыводитьРыночнуюСтоимость Тогда
				МакетСтрокаАкцииИПаиРынок.Параметры.Цена 	= ?(СтрокаПаи.Количество > 0, СтрокаПаи.СуммаРынок / СтрокаПаи.Количество, 0);
				МакетСтрокаАкцииИПаиРынок.Параметры.Баланс 	= СтрокаПаи.СуммаРынок;
				ТабДок.Присоединить(МакетСтрокаАкцииИПаиРынок);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Доли.Количество() > 0 Тогда
		
		ТабДок.Вывести(МакетПустаяСтрока);
		
