Процедура ВывестиРасходыУправляющего(ТабДок, МакетРаздел)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			ТОГДА ""комиссия биржи""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ТОГДА ""комиссия брокера""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии)
		|				ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия))
		|			ТОГДА ВЫБОР
		|					КОГДА НЕ &ЭтоПИФ
		|						ТОГДА ""услуги депозитария""
		|					КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НеобходимыеРасходыСпецдепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария))
		|						ТОГДА ""услуги спецдепозитария""
		|					ИНАЧЕ ""услуги депозитария""
		|				КОНЕЦ
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|				ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НеобходимыеРасходыУправляющего)
		|			ТОГДА ВЫБОР
		|					КОГДА &ЭтоПИФ
		|						ТОГДА ""вознаграждение УК""
		|					ИНАЧЕ ""вознаграждение ДУ""
		|				КОНЕЦ
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.БанковскаяКомиссия))
		|			ТОГДА ""комиссия банка""		
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора)
		|			ТОГДА ""вознаграждение спецрегистратора""
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика)
		|			ТОГДА ""вознаграждение оценщика""
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности
		|	КОНЕЦ КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия))
		|			ТОГДА ЗадолженностиПоДенежнымСредствам.Регистратор.СтрокаБанковскойВыписки
		|		ИНАЧЕ ""Убрать""
		|	КОНЕЦ КАК Основание
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|	И ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|	И (ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитарнойКомиссии)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В ИЕРАРХИИ(ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия))
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НеобходимыеРасходыУправляющего)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДФЛ))
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПрочимУслугам)
		|			ИЛИ  &ЭтоПИФ И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюОценщика)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС)
		|			ИЛИ ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоВознаграждениюСпецрегистратора))
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидЗадолженности,
		|	Основание
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	ОБЩИЕ,
		|	ВидЗадолженности";

	#КонецОбласти
	
	Запрос.УстановитьПараметр("НачалоПериода", 					ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 					ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ЭтоПИФ", 						ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);

	Расходы = Запрос.Выполнить().Выгрузить();

	Если Расходы.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ТабДок.Вывести(МакетРаздел);
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка = Макет.ПолучитьОбласть("ШапкаРасходы");
	МакетСтрока = Макет.ПолучитьОбласть("СтрокаРасходы");
	
	Если Расходы.Количество() > 0 Тогда
		
		Для каждого СтрокаРасходы Из Расходы Цикл
			
			Если СтрокаРасходы.Основание = "Убрать" Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаРасходы.ВидЗадолженности) Тогда
				МакетШапка.Параметры.ИтогРасходы = СтрокаРасходы.Сумма;
				ТабДок.Вывести(МакетШапка);
			Иначе
				Если НЕ ЗначениеЗаполнено(СтрокаРасходы.Основание) Тогда
					МакетСтрока.Параметры.ВидРасходов = СтрокаРасходы.ВидЗадолженности;
				Иначе
					МакетСтрока.Параметры.ВидРасходов = Формат(СтрокаРасходы.Основание.Дата, "ДФ=dd.MM.yyyy");
					МакетСтрока.Параметры.ОснованиеРасходов = СтрокаРасходы.Основание.НазначениеПлатежа;
				КонецЕсли;
				
				МакетСтрока.Параметры.СуммаРасходов = СтрокаРасходы.Сумма;
				
				ТабДок.Вывести(МакетСтрока);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 

КонецПроцедуры

Процедура ВывестиСделкиСВалютой(ТабДок, МакетПодраздел)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаСВалютой.Дата,
		|	СделкаСВалютой.ВидСделки,
		|	СделкаСВалютой.Валюта,
		|	СделкаСВалютой.Курс,
		|	ВЫБОР
		|		КОГДА СделкаСВалютой.ОтложенноеИсполнение
		|			ТОГДА СделкаСВалютой.ДатаИсполнения
		|		ИНАЧЕ СделкаСВалютой.Дата
		|	КОНЕЦ КАК ДатаИсполнения,
		|	СделкаСВалютой.Сумма,
		|	СделкаСВалютой.Контрвалюта,
		|	СделкаСВалютой.СуммаКонтрвалюты
		|ИЗ
		|	Документ.СделкаСВалютой КАК СделкаСВалютой
		|ГДЕ
		|	СделкаСВалютой.Проведен
		|	И СделкаСВалютой.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ) И КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|	И СделкаСВалютой.СчетДоверительногоУправления = &СчетДоверительногоУправления";

	Запрос.УстановитьПараметр("НачалоПериода", 					ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 					ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);

	ОперацииСВалютой = Запрос.Выполнить().Выгрузить();

	Если ОперацииСВалютой.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ТабДок.Вывести(МакетПодраздел);
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	МакетШапка = Макет.ПолучитьОбласть("ШапкаОперацииСВалютой");
	МакетСтрока = Макет.ПолучитьОбласть("СтрокаОперацииСВалютой");
	
	ТабДок.Вывести(МакетШапка);
	
	Если ОперацииСВалютой.Количество() > 0 Тогда
		Для каждого СтрокаОперацииСВалютой Из ОперацииСВалютой Цикл
			ЗаполнитьЗначенияСвойств(МакетСтрока.Параметры, СтрокаОперацииСВалютой);
			ТабДок.Вывести(МакетСтрока);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьОстаткиДепозитов(Период, ПериодДата)

	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет КАК СчетУчета,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ДепозитныйВклад,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ДепозитныеВкладыОстатки
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты09), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты11)),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДепозитныеВклады),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Счет,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.УсловияЗаймовКредитовИДепозитов),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДепозитныеВкладыОстатки.ДепозитныйВклад
		|ПОМЕСТИТЬ _ДепозитныеВклады
		|ИЗ
		|	_ДепозитныеВкладыОстатки КАК _ДепозитныеВкладыОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеВклады.ДепозитныйВклад,
		|	ЕСТЬNULL(_ДепозитныеВкладыТело.СуммаОстаток, 0) КАК Номинал,
		|	ЕСТЬNULL(_ДепозитныеВкладыПроценты.СуммаОстаток, 0) + ЕСТЬNULL(_ДепозитныеВкладыКорректировка.СуммаОстаток, 0) КАК Проценты,
		|	ЕСТЬNULL(_ДепозитныеВкладыКорректировка.СуммаОстаток, 0) КАК Корректировка,
		|	ЕСТЬNULL(_ДепозитныеВкладыТело.СуммаОстаток, 0) КАК СуммаРынок,
		|	ЕСТЬNULL(_ДепозитныеВкладыПроценты.СуммаОстаток, 0) КАК КупонРынок
		|ИЗ
		|	_ДепозитныеВклады КАК _ДепозитныеВклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитныеВкладыОстатки КАК _ДепозитныеВкладыТело
		|		ПО _ДепозитныеВклады.ДепозитныйВклад = _ДепозитныеВкладыТело.ДепозитныйВклад
		|			И (_ДепозитныеВкладыТело.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитныеВкладыОстатки КАК _ДепозитныеВкладыКорректировка
		|		ПО _ДепозитныеВклады.ДепозитныйВклад = _ДепозитныеВкладыКорректировка.ДепозитныйВклад
		|			И (_ДепозитныеВкладыКорректировка.СчетУчета В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты09), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты11)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитныеВкладыОстатки КАК _ДепозитныеВкладыПроценты
		|		ПО _ДепозитныеВклады.ДепозитныйВклад = _ДепозитныеВкладыПроценты.ДепозитныйВклад
		|			И (_ДепозитныеВкладыПроценты.СчетУчета = ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03))
		|ГДЕ
		|	_ДепозитныеВклады.ДепозитныйВклад ССЫЛКА Справочник.ДепозитныеВклады";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", 					  Период);
	Запрос.УстановитьПараметр("ПериодДата", 				  НачалоДня(ПериодДата));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация", 				  ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Биржа", 						  ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ-РТС").Биржа);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьЗадолженностьБУ(Период, ПериодДата)
	
	Запрос = Новый Запрос;
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ДоговорСделка,
		|	""Предварительные затраты по сделкам"" КАК ВидЗадолженности,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт КАК СуммаДт,
		|	ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт КАК СуммаКт
		|ПОМЕСТИТЬ _ОперацииСПриобретеннымиЦеннымиБумагами
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ПрочиеСчетаПоОперациямСПриобретеннымиЦеннымиБумагами)),
		|			&СубконтоКонтрагентыОснованиеРасчетов,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации).Эмитент.ЮрФизЛицо КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|	КОНЕЦ КАК ВидЗадолженности,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК ЦеннаяБумага,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт) КАК СуммаОстатокДт,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт) КАК СуммаОстатокКт
		|ПОМЕСТИТЬ _ОбъединенныйЗапросЕПС
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеПрибыльУбыток), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеДляПродажи), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(ПланСчетов.Единый.ДолговыеДляПродажиИДоПогашения)),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦенныеБумаги),
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ЛицевойСчет.ДополнительнаяАналитика В (ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона), ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюТела))) КАК ЕдиныйБухгалтерскийУчетОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто1 КАК Справочник.Облигации).Эмитент.ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.ЛицевойСчет.ДополнительнаяАналитика = ЗНАЧЕНИЕ(Справочник.ДополнительныеАналитикиЛицевыхСчетов.ЗадолженностьПоПогашениюКупона)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюКупона)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПогашениюОблигации)
		|	КОНЕЦ,
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕдиныйБухгалтерскийУчетОстатки.Субконто1,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) В (ТИП(Документ.МНО), ТИП(Документ.СделкаСМО))
		|			ТОГДА ""Проценты по МНО""
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) = ТИП(Документ.МНО)
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.МНО).РасчетныйСчет
		|		КОГДА ТИПЗНАЧЕНИЯ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2) = ТИП(Документ.СделкаСМО)
		|			ТОГДА ВЫРАЗИТЬ(ЕдиныйБухгалтерскийУчетОстатки.Субконто2 КАК Документ.СделкаСМО).РасчетныйСчет
		|		ИНАЧЕ ЕдиныйБухгалтерскийУчетОстатки.Субконто2
		|	КОНЕЦ,
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокДт),
		|	СУММА(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстатокКт)
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&Период,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты))
		|				И НЕ Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты22), ЗНАЧЕНИЕ(ПланСчетов.Единый.Расчеты25)),
		|			&СубконтоКонтрагентыОснованиеРасчетов,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
