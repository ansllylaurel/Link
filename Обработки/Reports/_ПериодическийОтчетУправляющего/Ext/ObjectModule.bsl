Функция ПолучитьАкцииВПути(Период,ТипЗадолженности)

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК Эмитент,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага.Тип КАК Тип,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер,
		|	ЗадолженностиПоЦеннымБумагамОстатки.КоличествоОстаток КАК Количество,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага.Номинал КАК Номинал,
		|	ЗадолженностиПоЦеннымБумагамОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&Период,
		|			ТипЗадолженности = &ТипЗадолженности
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|				И (ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)
		|					ИЛИ ВЫРАЗИТЬ(Основание КАК Документ.Сделка).МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок))) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	Эмитент";

	Запрос.УстановитьПараметр("ТипЗадолженности", 				ТипЗадолженности);
	Запрос.УстановитьПараметр("Период", 						Период);
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	Возврат Запрос.Выполнить().Выгрузить();

