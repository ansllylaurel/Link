
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Перечень сделок",
		"0.73",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	                                
	ИмяПредопределенногоВарианта = РаботаСОтчетамиКлиентСервер.ПолучитьИмяПредопределенногоВариантаОтчета(ЭтотОбъект);
	
	Если Не (ИмяПредопределенногоВарианта = "СКДСделки" Или ИмяПредопределенногоВарианта = "СКДСделкиАтомфонд"  Или ИмяПредопределенногоВарианта = "СКДСделкиГефест" Или ИмяПредопределенногоВарианта = "СКДДвиженияДС") Тогда
		
		Настройки = КомпоновщикНастроек.Настройки;
		Параметры = Настройки.ПараметрыДанных;
		
		Параметры.УстановитьЗначениеПараметра("Период",							Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
		Параметры.УстановитьЗначениеПараметра("ПериодДата",						ЭтотОбъект.Период.ДатаОкончания);
		Параметры.УстановитьЗначениеПараметра("Организация", 					ЭтотОбъект.Организация);	
		Параметры.УстановитьЗначениеПараметра("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
		Параметры.УстановитьЗначениеПараметра("НомерДоговора",             	  	ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора);
		
		// Выполняем программную компоновку
		РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка);	
		
	Иначе
			
		// Фиксируем запуск процедуры
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления,ИмяПредопределенногоВарианта", Новый Структура("ИмяПредопределенногоВарианта", ИмяПредопределенногоВарианта)); 
		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
		
		СтандартнаяОбработка = Ложь;
		
		ЭтоСделки 			= ИмяПредопределенногоВарианта = "СКДСделки";	
		ЭтоСделкиАтомфонд 	= ИмяПредопределенногоВарианта = "СКДСделкиАтомфонд";	
		ЭтоСделкиГефест		= ИмяПредопределенногоВарианта = "СКДСделкиГефест";	
		
		Если ЭтоСделки Тогда
			Макет = ПолучитьМакет("МакетСделки");
		ИначеЕсли ЭтоСделкиАтомфонд Тогда
			Макет = ПолучитьМакет("МакетСделкиАтомфонд");
		ИначеЕсли ЭтоСделкиГефест Тогда
			Макет = ПолучитьМакет("МакетСделкиГефест");
		Иначе
			Макет = ПолучитьМакет("МакетДвиженияДС");
		КонецЕсли;
		
		Шапка  				= Макет.ПолучитьОбласть("Шапка");
		ГруппаОднаЦБ 		= Макет.ПолучитьОбласть("ГруппаОднаЦБ");
		
		Если Не ЭтоСделкиГефест Тогда
			ГруппаНесколькоЦБ 	= Макет.ПолучитьОбласть("ГруппаНесколькоЦБ");
			ДетальныеЗаписи 	= Макет.ПолучитьОбласть("ДетальныеЗаписи");
		КонецЕсли;
	
		ТаблицаРезультат = ПолучитьТаблицуЗначений(ИмяПредопределенногоВарианта);
		
		ДокументРезультат.Вывести(Шапка);
		ПоследняяСтрока = ТаблицаРезультат.Количество() - 1;
		
		Если ЭтоСделкиГефест Тогда
			
			Для ИндексСтроки = 0 По ПоследняяСтрока Цикл
				
				ТекСтрока = ТаблицаРезультат[ИндексСтроки];
				
				Область = ГруппаОднаЦБ;
				ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);								
				ДокументРезультат.Вывести(Область);

			КонецЦикла;
			
		Иначе
						
			Для ИндексСтроки = 0 По ПоследняяСтрока Цикл
				
				ТекСтрока = ТаблицаРезультат[ИндексСтроки];
				
				Если ИндексСтроки < ПоследняяСтрока Тогда
				
					СледСтрока = ТаблицаРезультат[ИндексСтроки + 1];
					ЭтоПередача = Лев(ТекСтрока.Операция, 8) = "Передача"; 
					
					Если (ЭтоСделки ИЛИ ЭтоСделкиАтомфонд ИЛИ ТекСтрока.НомерСтроки = СледСтрока.НомерСтроки)
						И ТекСтрока.Регистратор = СледСтрока.Регистратор
						И Не ЭтоПередача Тогда
					
						ОбластьНесколькоЦБ = ГруппаНесколькоЦБ;
						ЗаполнитьЗначенияСвойств(ОбластьНесколькоЦБ.Параметры, ТекСтрока);
						
						ЗаполнитьИДСделки(ОбластьНесколькоЦБ, ТекСтрока, ЭтоСделки ИЛИ ЭтоСделкиАтомфонд);
						Если ЭтоСделкиАтомфонд Тогда
							//ЗаполнитьРейтинги(ОбластьНесколькоЦБ, ТекСтрока);
						Иначе
							ЗаполнитьДатуНомерДокумента(ОбластьНесколькоЦБ, ТекСтрока, ЭтоСделки);
						КонецЕсли;
						
						ДокументРезультат.Вывести(ОбластьНесколькоЦБ);
						ДокументРезультат.НачатьГруппуСтрок();
						Область = ДетальныеЗаписи;
						ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
						ДокументРезультат.Вывести(Область);
						
						Пока Истина Цикл
							
							ИндексСтроки = ИндексСтроки + 1;
							ТекСтрока = ТаблицаРезультат[ИндексСтроки];
							Область = ДетальныеЗаписи;
							ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
							ДокументРезультат.Вывести(Область);
							Если ИндексСтроки < ПоследняяСтрока Тогда
								СледСтрока = ТаблицаРезультат[ИндексСтроки + 1];
								Если НЕ (ТекСтрока.НомерСтроки = СледСтрока.НомерСтроки И ТекСтрока.Регистратор = СледСтрока.Регистратор) Тогда
									Прервать;
								КонецЕсли; 
							Иначе
								Прервать;
							КонецЕсли;
						
						КонецЦикла; 
						
						ДокументРезультат.ЗакончитьГруппуСтрок();
						
					Иначе
						
						Область = ГруппаОднаЦБ;
						ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
						ЗаполнитьИДСделки(Область, ТекСтрока, ЭтоСделки ИЛИ ЭтоСделкиАтомфонд); 
						Если ЭтоСделкиАтомфонд Тогда
							//ЗаполнитьРейтинги(Область, ТекСтрока);
						Иначе
							ЗаполнитьДатуНомерДокумента(Область, ТекСтрока, ЭтоСделки);
						КонецЕсли;
						ДокументРезультат.Вывести(Область);
						
					КонецЕсли; 
					
				Иначе
					
					Область = ГруппаОднаЦБ;
					ЗаполнитьЗначенияСвойств(Область.Параметры, ТекСтрока);
					ЗаполнитьИДСделки(Область, ТекСтрока, ЭтоСделки ИЛИ ЭтоСделкиАтомфонд);
					Если ЭтоСделкиАтомфонд Тогда
						//ЗаполнитьРейтинги(Область, ТекСтрока);
					Иначе
						ЗаполнитьДатуНомерДокумента(Область, ТекСтрока, ЭтоСделки);
					КонецЕсли;
					ДокументРезультат.Вывести(Область);

				КонецЕсли;
				
			КонецЦикла;	
					
		КонецЕсли;
		
		// Заполняем настройки печати	
		РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
		
		// Фиксируем завершение процедуры
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуЗначений(ИмяПредопределенногоВарианта)

	РеквизитыСчетаДУ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "НомерДоговора,ДатаЗаключения");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода",                	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",                 	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);	
	Запрос.УстановитьПараметр("НомерДоговора",             	  	РеквизитыСчетаДУ.НомерДоговора);
	Запрос.УстановитьПараметр("ДатаДоговора",	             	Формат(РеквизитыСчетаДУ.ДатаЗаключения, "ДФ=dd.MM.yyyy"));
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо",	 					Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания));
		
	Если ИмяПредопределенногоВарианта = "СКДСделки"
		Или ИмяПредопределенногоВарианта = "СКДСделкиАтомфонд" Тогда
		
		#Область СКДСделки_СКДСделкиАтомфонд
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ОперацииСЦеннымиБумагами.Организация КАК Организация,
			|	"""" КАК ИДСделки,
			|	ОперацииСЦеннымиБумагами.Операция КАК ОперацияСсылка,
			|	ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага,
			|	"""" КАК Биржа,
			|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаОперации,
			|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ВремяОперации,
			|	""Передача+"" КАК Операция,
			|	ОперацииСЦеннымиБумагами.Рынок КАК Рынок,
			|	ОперацииСЦеннымиБумагами.Количество КАК Количество,
			|	ОперацииСЦеннымиБумагами.Цена КАК Цена,
			|	ОперацииСЦеннымиБумагами.Валюта КАК ВалютаСделки,
			|	ОперацииСЦеннымиБумагами.Сумма КАК СуммаСделки,
			|	ОперацииСЦеннымиБумагами.СуммаКупона КАК НКД,
			|	"""" КАК СчетБрокера,
			|	"""" КАК НомерСвязи,
			|	0 КАК КлассификацияОСБУ,
			|	ВЫБОР
			|		КОГДА ВводЦенныхБумаг.Контрагент <> &ЮрФизЛицо
			|			ТОГДА ВводЦенныхБумаг.Контрагент
			|		ИНАЧЕ ВводЦенныхБумаг.СчетДоверительногоУправления
			|	КОНЕЦ КАК КонтрагентСсылка,
			|	""Акт приема-передачи б/н"" КАК НаименованиеДокументаОснования,
			|	0 КАК КоэффициентКонвертации,
			|	НЕОПРЕДЕЛЕНО КАК ЦеннаяБумагаКонвертации,
			|	ОперацииСЦеннымиБумагами.Организация.ЮрФизЛицо КАК ОрганизацияЮрФизЛицо,
			|	NULL КАК Брокер,
			|	NULL КАК ПерваяЧастьРЕПО,
			|	NULL КАК ЧастьСделкиРЕПО,
			|	ОперацииСЦеннымиБумагами.Регистратор КАК Регистратор,
			|	ДАТАВРЕМЯ(1, 1, 1) КАК ПланДатаИсполнения,
			|	ЛОЖЬ КАК ОтложенноеИсполнение,
			|	ОперацииСЦеннымиБумагами.ДатаОперации КАК ДатаДокументаОснования,
			|	"""" КАК НомерДокументаОснования
			|ПОМЕСТИТЬ _ОперацииСЦБ
			|ИЗ
			|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
			|		ПО ОперацииСЦеннымиБумагами.Операция = ВводЦенныхБумаг.Ссылка
			|ГДЕ
			|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления = &СчетДоверительногоУправления
			|	И ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления,
			|	ОперацииСЦеннымиБумагами.Организация,
			|	"""",
			|	ОперацииСЦеннымиБумагами.Операция,
			|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
			|	"""",
			|	ОперацииСЦеннымиБумагами.ДатаОперации,
			|	ОперацииСЦеннымиБумагами.ДатаОперации,
			|	""Передача-"",
			|	ОперацииСЦеннымиБумагами.Рынок,
			|	ОперацииСЦеннымиБумагами.Количество,
			|	ОперацииСЦеннымиБумагами.Цена,
			|	ОперацииСЦеннымиБумагами.Валюта,
			|	ОперацииСЦеннымиБумагами.Сумма,
			|	ОперацииСЦеннымиБумагами.СуммаКупона,
			|	"""",
			|	"""",
			|	0,
			|	ВЫБОР
			|		КОГДА ВыводЦенныхБумаг.Контрагент <> &ЮрФизЛицо
			|			ТОГДА ВыводЦенныхБумаг.Контрагент
			|		ИНАЧЕ ВыводЦенныхБумаг.СчетДоверительногоУправления
			|	КОНЕЦ,
			|	""Акт приема-передачи б/н"",
			|	0,
			|	НЕОПРЕДЕЛЕНО,
			|	ОперацииСЦеннымиБумагами.Организация.ЮрФизЛицо,
			|	NULL,
			|	NULL,
			|	NULL,
			|	ОперацииСЦеннымиБумагами.Регистратор,
			|	ДАТАВРЕМЯ(1, 1, 1),
			|	ЛОЖЬ,
			|	ОперацииСЦеннымиБумагами.ДатаОперации,
			|	""""
			|ИЗ
