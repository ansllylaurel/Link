			|УПОРЯДОЧИТЬ ПО
			|	ДатаОперации,
			|	Регистратор,
			|	НомерСтроки";
	
	#КонецОбласти
	
	КонецЕсли; 
	
	Запрос.Текст = ТекстЗапроса;
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции 

Процедура ЗаполнитьДатуНомерДокумента(Область, ТекСтрока, ЭтоСделки)

	//Если ЭтоСделки Тогда
	//
	//	Возврат;
	//	
	//Иначе
		
		Наименование = ТекСтрока.НаименованиеДокументаОснования;
		Номер = ТекСтрока.НомерДокументаОснования;
		Дата = ТекСтрока.ДатаДокументаОснования;
		Область.Параметры.ДокументОснование = Строка(Наименование) + ?(ЗначениеЗаполнено(Номер), " №" + Номер, "") + ?(ЗначениеЗаполнено(Дата), " от " + Формат(Дата, "ДФ=dd.MM.yyyy"), "");
	
	//КонецЕсли; 

КонецПроцедуры

Процедура ЗаполнитьИДСделки(Область, ТекСтрока, ЗаполнитьНомерСвязи)

	Если НЕ ЗначениеЗаполнено(ТекСтрока.ИДСделки) И ЗначениеЗаполнено(ТекСтрока.Сделка) И 
		(ТипЗнч(ТекСтрока.Сделка) = Тип("ДокументСсылка.Сделка") Или ТипЗнч(ТекСтрока.Сделка) = Тип("ДокументСсылка.СделкаРЕПО")) Тогда
		
		Область.Параметры.ИДСделки = ТекСтрока.Сделка.УникальныйИдентификатор();
		
		Если ЗаполнитьНомерСвязи И ЗначениеЗаполнено(ТекСтрока.ПерваяЧастьРЕПО) Тогда
		
			Область.Параметры.НомерСвязи = ТекСтрока.Сделка.УникальныйИдентификатор();
		
		КонецЕсли; 
		
	КонецЕсли; 

КонецПроцедуры

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ВариантОтчета");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);

	РаботаСОтчетамиКлиентСервер.ЗаполнитьДополнительныеСвойстваВариантаОтчета(ЭтотОбъект, НастройкиОтчета.ВариантОтчета);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ЭтотОбъект.СкомпоноватьРезультат(ДокументРезультат); 
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры