		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
ПОМЕСТИТЬ
	_КлиентыОтАгента
ИЗ
	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
ГДЕ
	СчетаДоверительногоУправления.Организация = &amp;Организация
	И СчетаДоверительногоУправления.АгентскийДоговор.Контрагент = &amp;Агент
;

ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СчетаДоверительногоУправления.Ссылка КАК Клиент,
	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
	РеквизитыАгента.КраткоеНаименованиеПоУставу КАК Агент,
	АнкетаФизическогоЛица.ФИОАгента КАК ФИОАгента, 
	РеквизитыКлиентаАнкетные.Фамилия + " " + РеквизитыКлиентаАнкетные.Имя + " " + РеквизитыКлиентаАнкетные.Отчество КАК ФИОКлиента,
	РеквизитыКлиентаАнкетные.Телефоны КАК ТелефоныКлиента,
	РеквизитыКлиентаАнкетные.EMail КАК EMailКлиента,
	ЕСТЬNULL(ВводыДенежныхСредств.Сумма, 0) КАК СуммаВводов,
	ЕСТЬNULL(ВводыДенежныхСредств.ДатаПоследнегоВвода, "") КАК ДатаПоследнегоВвода,
	СтратегииИндивидуальногоИнвестирования.Стратегия,
	ВЫБОР
		КОГДА СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1,1,1)
				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения &gt; &amp;Период
			ТОГДА "Действующие" 
		ИНАЧЕ "Расторгнутые"
	КОНЕЦ КАК СостояниеДоговора
	
ИЗ
	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлиентыОтАгента
		ПО _КлиентыОтАгента.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
	ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ
				ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
				СУММА(ВводыВыводыАктивовВВалютеУчета.БалансоваяСтоимость) КАК Сумма,
				МАКСИМУМ(ВводыВыводыАктивовВВалютеУчета.Период) КАК ДатаПоследнегоВвода
			ИЗ
				РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлиентыОтАгента КАК КлиентыДУ
				ПО КлиентыДУ.СчетДоверительногоУправления = ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления  
			ГДЕ
				ВводыВыводыАктивовВВалютеУчета.Организация = &amp;Организация				
				И ВводыВыводыАктивовВВалютеУчета.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ДенежныеСредства)
				И ВводыВыводыАктивовВВалютеУчета.ВидОперацииВводаВыводаДС = ЗНАЧЕНИЕ(Справочник.ВидыОперацийПриВводеВыводеДенежныхСредств.ПолученыСредстваОтУчредителяВДоверительноеУправление)
				И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
			СГРУППИРОВАТЬ ПО
				ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления
		) КАК ВводыДенежныхСредств
		ПО ВводыДенежныхСредств.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка 	
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			&amp;Период,
			СчетДоверительногоУправления В (ВЫБРАТЬ СчетДоверительногоУправления ИЗ _КлиентыОтАгента)) КАК КлиентыДУ
		ПО КлиентыДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка  
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			&amp;Период,
			Организация = &amp;Организация
				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиентаАнкетные
		ПО РеквизитыКлиентаАнкетные.ЮрФизЛицо = КлиентыДУ.Клиент
	ЛЕВОЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		ПО АнкетаФизическогоЛица.Ссылка = РеквизитыКлиентаАнкетные.Регистратор
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
			&amp;Период,
			Организация = &amp;Организация
				И СчетДоверительногоУправления В (ВЫБРАТЬ СчетДоверительногоУправления ИЗ _КлиентыОтАгента)) КАК СтратегииИндивидуальногоИнвестирования
		ПО СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			&amp;Период,
			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
				И ЮрФизЛицо = &amp;Агент) КАК РеквизитыАгента
		ПО РеквизитыАгента.ЮрФизЛицо = &amp;Агент
</query>
	</dataSet>
	<calculatedField>
		<dataPath>КодОтделения</dataPath>
		<expression>ПОДСТРОКА(НомерДоговора, ДЛИНАСТРОКИ(НомерДоговора) - 3, 4)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Код отделения</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КодАгента</dataPath>
		<expression>ПОДСТРОКА(НомерДоговора, ДЛИНАСТРОКИ(НомерДоговора) - 5, 2)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Код агента</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ДатаЗаключенияРасторжения</dataPath>
