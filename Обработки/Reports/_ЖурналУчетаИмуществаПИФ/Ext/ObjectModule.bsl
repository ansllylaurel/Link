	ВидыСводныхОпераций.Добавить(Перечисления.ВидыОперацийБэкОфиса.СводноеИсполнениеОбязательствПоБиржевымСделкам);
	
	ПараметрыШапки = ПолучитьПараметрыШапки();
	
	Если ПараметрыШапки = Неопределено Тогда
		Если Не (ЗначениеЗаполнено(ЭтотОбъект.ПаевойИнвестиционныйФонд) ИЛИ ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления)) Тогда
			ТекстСообщения = "В параметрах отчета не выбран ПИФ";
		Иначе
			ТекстСообщения = СокрЛП(?(ЭтотОбъект.ПаевойИнвестиционныйФонд = Справочники.ПаевыеИнвестиционныеФонды.ПустаяСсылка(), ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.ПаевойИнвестиционныйФонд)) + " отсутствует в счетах ДУ на дату " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПаевойИнвестиционныйФонд", 		ПараметрыШапки.ПИФ);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеФонда", 				ПараметрыШапки.НаименованиеФонда);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НаименованиеУК", 				ПараметрыШапки.НаименованиеУК);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НомерЛицензии", 					ПараметрыШапки.НомерЛицензии);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаЛицензии", 					Формат(ПараметрыШапки.ДатаЛицензии, "ДФ=dd.MM.yyyy"));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаПравил", 					Формат(ПараметрыШапки.ДатаПравил, "ДФ=dd.MM.yyyy"));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НомерПравил", 					ПараметрыШапки.НомерПравил);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаВремяОтчета", 				ПараметрыШапки.ДатаВремяОтчета);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОрганУтвердившийПравила", 		"Правила доверительного управления фондом от");
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидыСводныхОпераций", 			ВидыСводныхОпераций);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТипПИФ", 						ПараметрыШапки.ТипПИФ);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВалютаУчета", 					ПараметрыШапки.ВалютаУчета);
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
	
	ПараметрыВыводаПодписей = Новый Структура;
	ПараметрыВыводаПодписей.Вставить("ИмяОбласти", "ПодписиБухгалтерскихОтчетовЕПС");
	//ПараметрыВыводаПодписей.Вставить("ДатаФормирования", Формат(ТекущаяДата(), "ДФ='dd ММММ yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
	
		ПараметрыВыводаПодписей.Вставить("ФИОРуководителя", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДолжностьРуководителя", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);
	
	КонецЕсли; 
	   	
	РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка, ПараметрыВыводаПодписей);

КонецПроцедуры

Функция ПолучитьПараметрыШапки()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Организация.ВалютаУчета КАК ВалютаУчета
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			ВЫБОР
		|					КОГДА &СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.)
		|						ТОГДА (ВЫРАЗИТЬ(Клиент КАК Справочник.ПаевыеИнвестиционныеФонды)) = &ПаевойИнвестиционныйФонд
		|					ИНАЧЕ СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				КОНЕЦ
		|				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.ПолноеНаименованиеПоУставу КАК НаименованиеУК,
		|	&Период КАК ДатаВремяОтчета,
		|	СтатусыЛицензийОрганизацииСрезПоследних.Лицензия.ДатаВыдачи КАК ДатаЛицензии,
		|	СтатусыЛицензийОрганизацииСрезПоследних.Лицензия.Серия + "" "" + СтатусыЛицензийОрганизацииСрезПоследних.Лицензия.Номер КАК НомерЛицензии,
		|	_КлиентДоверительногоУправления.Клиент.НомерПравил КАК НомерПравил,
		|	_КлиентДоверительногоУправления.Клиент.ДатаПравил КАК ДатаПравил,
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда КАК НаименованиеФонда,
		|	_КлиентДоверительногоУправления.Клиент КАК ПИФ,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_КлиентДоверительногоУправления.ВалютаУчета КАК ВалютаУчета,
		|	_КлиентДоверительногоУправления.Клиент.Тип КАК ТипПИФ
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации		
		|		 
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(
		|				&Период,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|					И Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)) КАК СтатусыЛицензийОрганизацииСрезПоследних
		|		ПО РеквизитыЮридическихЛицОрганизации.ЮрФизЛицо = СтатусыЛицензийОрганизацииСрезПоследних.Лицензия.ЮрФизЛицо,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления, 
		|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ПаевойИнвестиционныйФонд В (ВЫБРАТЬ _КлиентДоверительногоУправления.Клиент ИЗ _КлиентДоверительногоУправления)) КАК РеквизитыПИФСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд", ЭтотОбъект.ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("Подписант");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхКонтактногоЛица", НастройкиОтчета.Подписант);
	
	ДокументРезультат = Новый ТабличныйДокумент;
