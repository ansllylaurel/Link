
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчетность сбербанка",
		"2.10",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	// Фиксируем запуск процедуры
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	ПараметрыВыполнения = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполнения.Хранилище, ПараметрыВыполнения.Описание);
		
	// Формируем отчет		
	#Область Текст_запроса	
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Организация.ЮрФизЛицо КАК ЮрЛицоОрганизации,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиент
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаФормирования, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Клиент.КодСчета КАК КодСчета,
		|	_Клиент.НомерДоговора КАК НомерДоговора,
		|	_Клиент.ДатаЗаключения КАК ДатаЗаключения,
		|	ЕСТЬNULL(РеквизитыКлиентаЮрЛица.ПолноеНаименованиеПоУставу, ЕСТЬNULL(РеквизитыКлиентаФизЛица.Фамилия + "" "" + РеквизитыКлиентаФизЛица.Имя + "" "" + РеквизитыКлиентаФизЛица.Отчество, _Клиент.Клиент)) КАК Клиент,
		|	ЕСТЬNULL(РеквизитыОрганизации.КраткоеНаименованиеПоУставу, _Клиент.Организация) КАК Организация
		|ИЗ
		|	_Клиент КАК _Клиент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаФормирования,
		|				(Организация, ЮрФизЛицо, Язык) В
		|					(ВЫБРАТЬ
		|						_Клиент.Организация,
		|						_Клиент.Клиент,
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					ИЗ
		|						_Клиент)) КАК РеквизитыКлиентаЮрЛица
		|		ПО (РеквизитыКлиентаЮрЛица.ЮрФизЛицо = _Клиент.Клиент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&ДатаФормирования,
		|				(Организация, ЮрФизЛицо, Язык) В
		|					(ВЫБРАТЬ
		|						_Клиент.Организация,
		|						_Клиент.Клиент,
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					ИЗ
		|						_Клиент)) КАК РеквизитыКлиентаФизЛица
		|		ПО (РеквизитыКлиентаФизЛица.ЮрФизЛицо = _Клиент.Клиент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ДатаФормирования,
		|				(Организация, ЮрФизЛицо, Язык) В
		|					(ВЫБРАТЬ
		|						_Клиент.Организация,
		|						_Клиент.ЮрЛицоОрганизации,
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					ИЗ
		|						_Клиент)) КАК РеквизитыОрганизации
		|		ПО (РеквизитыОрганизации.ЮрФизЛицо = _Клиент.ЮрЛицоОрганизации)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Порядок,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ""Р/сч ДУ""
		|		ИНАЧЕ ""На счете брокера""
		|	КОНЕЦ КАК Строка,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ОстаткиДенежныхСредствОстатки.РасчетныйСчет.НомерСчета
		|		ИНАЧЕ ОстаткиДенежныхСредствОстатки.Брокер
		|	КОНЕЦ КАК РасшифровкаСтроки,
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ОстаткиДенежныхСредствОстатки.СуммаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Остаток,
		|	0 КАК КредиторскаяЗадолженность,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА 0
		|		ИНАЧЕ ОстаткиДенежныхСредствОстатки.СуммаОстаток
		|	КОНЕЦ КАК ДебиторскаяЗадолженность
		|ПОМЕСТИТЬ _ОстаткиДенежныхСредствНаНачало
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&НачалоПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПогашениеКупона
		|				ИЛИ ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПогашениеЦеннойБумаги
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.Облигация.Эмитент
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&НачалоПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиДенежныхСредствНаНачало.Порядок КАК Порядок,
		|	_ОстаткиДенежныхСредствНаНачало.Строка КАК Строка,
		|	_ОстаткиДенежныхСредствНаНачало.РасшифровкаСтроки КАК РасшифровкаСтроки,
		|	СУММА(_ОстаткиДенежныхСредствНаНачало.Остаток * КурсыВалют.Курс / КурсыВалют.Кратность) КАК Остаток,
		|	СУММА(_ОстаткиДенежныхСредствНаНачало.КредиторскаяЗадолженность * КурсыВалют.Курс / КурсыВалют.Кратность) КАК КредиторскаяЗадолженность,
		|	СУММА(_ОстаткиДенежныхСредствНаНачало.ДебиторскаяЗадолженность * КурсыВалют.Курс / КурсыВалют.Кратность) КАК ДебиторскаяЗадолженность
		|ИЗ
		|	_ОстаткиДенежныхСредствНаНачало КАК _ОстаткиДенежныхСредствНаНачало
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|		ПО (КурсыВалют.Валюта = _ОстаткиДенежныхСредствНаНачало.Валюта)
		|			И (КурсыВалют.Период = &НачалоПериода)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ОстаткиДенежныхСредствНаНачало.Порядок,
		|	_ОстаткиДенежныхСредствНаНачало.Строка,
		|	_ОстаткиДенежныхСредствНаНачало.РасшифровкаСтроки
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ОстаткиДенежныхСредствНаНачало.Порядок
		|ИТОГИ
		|	СУММА(Остаток),
		|	СУММА(КредиторскаяЗадолженность),
		|	СУММА(ДебиторскаяЗадолженность)
		|ПО
		|	ОБЩИЕ,
		|	Строка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Порядок,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ""Р/сч ДУ""
		|		ИНАЧЕ ""На счете брокера""
		|	КОНЕЦ КАК Строка,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ОстаткиДенежныхСредствОстатки.РасчетныйСчет.НомерСчета
		|		ИНАЧЕ ОстаткиДенежныхСредствОстатки.Брокер
		|	КОНЕЦ КАК РасшифровкаСтроки,
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ОстаткиДенежныхСредствОстатки.СуммаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Остаток,
		|	0 КАК КредиторскаяЗадолженность,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА 0
		|		ИНАЧЕ ОстаткиДенежныхСредствОстатки.СуммаОстаток
		|	КОНЕЦ КАК ДебиторскаяЗадолженность
		|ПОМЕСТИТЬ _ОстаткиДенежныхСредствНаКонец
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&КонецПериодаГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПогашениеКупона
		|				ИЛИ ЗадолженностиПоДенежнымСредствамОстатки.Основание ССЫЛКА Документ.ПогашениеЦеннойБумаги
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.Основание.Облигация.Эмитент
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта,
		|	0,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ
