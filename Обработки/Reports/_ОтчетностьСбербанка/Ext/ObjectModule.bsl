		|								И РеквизитыЭмитента.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация)
		|						ТОГДА ""Облигации (гос. и муницип.)""
		|					КОГДА Облигации.Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Корпоративная)
		|						ТОГДА ""Облигации (корп.)""
		|					ИНАЧЕ ""Облигации (прочие)""
		|				КОНЕЦ
		|		ИНАЧЕ _Операции.Рынок
		|	КОНЕЦ КАК ВидЦБ,
		|	_Операции.ДатаДоговора КАК ДатаДоговора,
		|	_Операции.ДатаПринятияКУчетуЦБ КАК ДатаПринятияКУчетуЦБ,
		|	_Операции.ДатаПлатежа КАК ДатаПлатежа,
		|	_Операции.СодержаниеОперации КАК СодержаниеОперации,
		|	ЕСТЬNULL(РеквизитыЭмитента.КраткоеНаименованиеПоУставу, ЕСТЬNULL(_Операции.ЦеннаяБумагаЭмитент, _Операции.ЦеннаяБумага)) КАК ЦеннаяБумага,
		|	_Операции.ЦеннаяБумагаГосударственныйРегистрационныйНомер КАК ЦеннаяБумагаГосударственныйРегистрационныйНомер,
		|	ЕСТЬNULL(_Операции.ЦеннаяБумагаДатаПогашения, ДАТАВРЕМЯ(1, 1, 1)) КАК ЦеннаяБумагаДатаПогашения,
		|	_Операции.ЦеннаяБумагаДатаРегистрации КАК ЦеннаяБумагаДатаРегистрации,
		|	_Операции.Количество КАК Количество,
		|	_Операции.Цена КАК Цена,
		|	ВЫБОР
		|		КОГДА _Операции.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА -_Операции.Сумма
		|		ИНАЧЕ _Операции.Сумма
		|	КОНЕЦ КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Операции.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА -_Операции.СуммаКупона
		|		ИНАЧЕ _Операции.СуммаКупона
		|	КОНЕЦ КАК СуммаКупона,
		|	ВЫБОР
		|		КОГДА _Операции.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА -_Операции.Сумма - _Операции.СуммаКупона
		|		ИНАЧЕ _Операции.Сумма + _Операции.СуммаКупона
		|	КОНЕЦ КАК Всего,
		|	ЕСТЬNULL(-_Комиссии.Сумма, 0) КАК СуммаКомиссии,
		|	ВЫБОР
		|		КОГДА _Операции.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА -_Операции.Сумма - _Операции.СуммаКупона - ЕСТЬNULL(_Комиссии.Сумма, 0)
		|		ИНАЧЕ _Операции.Сумма + _Операции.СуммаКупона - ЕСТЬNULL(_Комиссии.Сумма, 0)
		|	КОНЕЦ КАК СуммаПлатежа
		|ИЗ
		|	_Операции КАК _Операции
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Комиссии КАК _Комиссии
		|		ПО (_Комиссии.Основание = _Операции.ОснованиеКомиссии)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (Облигации.Ссылка = _Операции.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаФормирования,
		|				(Подразделение, Язык, ЮрФизЛицо) В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний),
		|						ЗНАЧЕНИЕ(Справочник.Языки.Русский),
		|						_Операции.ЦеннаяБумагаЭмитентЮрФизЛицо
		|					ИЗ
		|						_Операции)) КАК РеквизитыЭмитента
		|		ПО (РеквизитыЭмитента.ЮрФизЛицо = _Операции.ЦеннаяБумагаЭмитентЮрФизЛицо)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидЦБ,
		|	ДатаДоговора
		|ИТОГИ
		|	СУММА(Сумма),
		|	СУММА(СуммаКупона),
		|	СУММА(Всего),
		|	СУММА(СуммаКомиссии),
		|	СУММА(СуммаПлатежа)
		|ПО
		|	ВидЦБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОбороты.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ОстаткиДенежныхСредствОбороты.РасчетныйСчет.НомерСчета
		|		ИНАЧЕ КодБрокера.ДоговорБрокерскогоОбслуживания
		|	КОНЕЦ КАК БанковскийСчет,
		|	ОстаткиДенежныхСредствОбороты.Период КАК ДатаПлатежа,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОбороты.Регистратор) = ТИП(Документ.Оплата)
		|			ТОГДА Оплата.ВидЗадолженности
		|		ИНАЧЕ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОбороты.Регистратор)
		|	КОНЕЦ КАК СодержаниеОперации,
		|	ОстаткиДенежныхСредствОбороты.СуммаОборот КАК СуммаПлатежа,
		|	ОстаткиДенежныхСредствОбороты.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредствОбороты.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ _ПрочиеОперацииПоРасчетномуСчету
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Запись,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО (Оплата.Ссылка = ОстаткиДенежныхСредствОбороты.Регистратор)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&ДатаФормирования,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодБрокера
		|		ПО (КодБрокера.Брокер = ОстаткиДенежныхСредствОбороты.Брокер)
		|ГДЕ
		|	НЕ ТИПЗНАЧЕНИЯ(ОстаткиДенежныхСредствОбороты.Регистратор) В (ТИП(Документ.Сделка), ТИП(Документ.СделкаРЕПО), ТИП(Документ.ИсполнениеОбязательствПоСделке))
		|	И (ОстаткиДенежныхСредствОбороты.Регистратор.ВидЗадолженности ЕСТЬ NULL
		|			ИЛИ НЕ ОстаткиДенежныхСредствОбороты.Регистратор.ВидЗадолженности В (&ИсключенияИзПрочихОперацийПоРасчетномуСчету))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПрочиеОперацииПоРасчетномуСчету.БанковскийСчет КАК БанковскийСчет,
		|	_ПрочиеОперацииПоРасчетномуСчету.ДатаПлатежа КАК ДатаПлатежа,
		|	_ПрочиеОперацииПоРасчетномуСчету.СодержаниеОперации КАК СодержаниеОперации,
		|	_ПрочиеОперацииПоРасчетномуСчету.СуммаПлатежа КАК СуммаПлатежа,
		|	_ПрочиеОперацииПоРасчетномуСчету.Валюта КАК Валюта
		|ИЗ
		|	_ПрочиеОперацииПоРасчетномуСчету КАК _ПрочиеОперацииПоРасчетномуСчету
		|
		|УПОРЯДОЧИТЬ ПО
		|	БанковскийСчет,
		|	ДатаПлатежа,
		|	СуммаПлатежа
		|ИТОГИ
		|	СУММА(СуммаПлатежа)
		|ПО
		|	ОБЩИЕ,
		|	БанковскийСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	""Обнаружены операции с валютными ценными бумагами (%1)"" КАК ТекстОшибки,
		|	_Операции.Регистратор КАК Основание
		|ИЗ
		|	_Операции КАК _Операции
		|ГДЕ
		|	НЕ _Операции.Валюта В (&ВалютаУчета, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	""Обнаружены валютные комиссии за операции с ценными бумагами (%1)"",
		|	_Комиссии.Основание
		|ИЗ
		|	_Комиссии КАК _Комиссии
		|ГДЕ
		|	НЕ _Комиссии.Валюта В (&ВалютаУчета, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	""Обнаружены валютные операции по расчетному счету (%1)"",
		|	_ПрочиеОперацииПоРасчетномуСчету.Регистратор
		|ИЗ
		|	_ПрочиеОперацииПоРасчетномуСчету КАК _ПрочиеОперацииПоРасчетномуСчету
		|ГДЕ
		|	НЕ _ПрочиеОперацииПоРасчетномуСчету.Валюта В (&ВалютаУчета, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	""Обнаружены операции с корзиной ценных бумаг (%1)"",
		|	_Операции.ОснованиеКомиссии
		|ИЗ
		|	_Операции КАК _Операции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Комиссии КАК _Комиссии
		|		ПО (_Комиссии.Основание = _Операции.ОснованиеКомиссии)
		|
		|СГРУППИРОВАТЬ ПО
		|	_Операции.ОснованиеКомиссии
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Операции.ЦеннаяБумага) > 1";
	
	#КонецОбласти	
	
	ДатаФормирования = ТекущаяДатаСеанса();
	
	ИсключенияИзПрочихОперацийПоРасчетномуСчету = Новый Массив;
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюВекселя);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюПая);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоТорговойКомиссии);
	ИсключенияИзПрочихОперацийПоРасчетномуСчету.Добавить(Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Организация",									ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",					ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода",									НачалоДня(ЭтотОбъект.Период.ДатаНачала));	
	Запрос.УстановитьПараметр("КонецПериода",									КонецДня(ЭтотОбъект.Период.ДатаОкончания));
	Запрос.УстановитьПараметр("КонецПериодаГраница",							Новый Граница(КонецДня(ЭтотОбъект.Период.ДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДатаФормирования",								ДатаФормирования);
	Запрос.УстановитьПараметр("ИсключенияИзПрочихОперацийПоРасчетномуСчету",	ИсключенияИзПрочихОперацийПоРасчетномуСчету);	
	Запрос.УстановитьПараметр("ВалютаУчета",									ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета"));
	
	ПакетЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки						= ПакетЗапроса[1].Выгрузить()[0];
	ОстаткиДенежныхСредствНаНачало	= ПакетЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ОстаткиДенежныхСредствНаКонец	= ПакетЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ОперацииСЦеннымиБумагами		= ПакетЗапроса[10].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ПрочиеОперацииПоРасчетномуСчету	= ПакетЗапроса[12].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Ограничения						= ПакетЗапроса[13].Выбрать();

	// Проверим ограничения отчета
	
	Если Ограничения.Следующий() Тогда
		ВызватьИсключение СтрШаблон(Ограничения.ТекстОшибки, Ограничения.Основание);		
	КонецЕсли;
	
	// Шапка
	
	Макет = ПолучитьМакет("Макет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Заполнить(ДанныеШапки);
	ОбластьШапка.Параметры.ДатаФормирования			= Формат(ДатаФормирования, "ДЛФ=D");
	ОбластьШапка.Параметры.ПредставлениеПериода		= ПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, "ФП = Истина");
	ОбластьШапка.Параметры.ПредставлениеДоговора	= СтрШаблон("№ %1 от %2 года", ДанныеШапки.НомерДоговора, Формат(ДанныеШапки.ДатаЗаключения, "ДЛФ=D"));
	ОбластьШапка.Параметры.ЕдиницаИзмерения			= "руб.";
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	// Остатки д/с на начало
	
	ОбластьРаздел = Макет.ПолучитьОбласть("Раздел");
	ОбластьРаздел.Параметры.НаименованиеРаздела = "Денежные средства, переданные в доверительное управление на начало периода";
	ДокументРезультат.Вывести(ОбластьРаздел);
	
	ОбластьШапкаОстатковДС = Макет.ПолучитьОбласть("ШапкаОстатковДС");
	ДокументРезультат.Вывести(ОбластьШапкаОстатковДС);
	
	ОбластьИтогиОстатковДС = Макет.ПолучитьОбласть("ИтогиОстатковДС");
	
	Если ОстаткиДенежныхСредствНаНачало.Следующий() Тогда
		
		СтрокаОстатков = ОстаткиДенежныхСредствНаНачало.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
		Пока СтрокаОстатков.Следующий() Цикл
			
			ОбластьСтрокаОстатковДС = Макет.ПолучитьОбласть("СтрокаОстатковДС");
			ОбластьСтрокаОстатковДС.Параметры.Заполнить(СтрокаОстатков);
			ДокументРезультат.Вывести(ОбластьСтрокаОстатковДС);
				
			РасшифровкаСтроки = СтрокаОстатков.Выбрать();
			Пока РасшифровкаСтроки.Следующий() И ЗначениеЗаполнено(РасшифровкаСтроки.РасшифровкаСтроки) Цикл
				ОбластьРасшифровкаСтрокиОстатковДС = Макет.ПолучитьОбласть("РасшифровкаСтрокиОстатковДС");
				ОбластьРасшифровкаСтрокиОстатковДС.Параметры.Заполнить(РасшифровкаСтроки);
				ДокументРезультат.Вывести(ОбластьРасшифровкаСтрокиОстатковДС);
			КонецЦикла;
			
		КонецЦикла;
		
		ОбластьИтогиОстатковДС.Параметры.Заполнить(ОстаткиДенежныхСредствНаНачало);
	
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьИтогиОстатковДС);		
	
	// Операции с ц/б	
	
	ОбластьШапкаОперацииЦБ = Неопределено;
	
	ОбластьРазделительВидовЦБ	= Макет.ПолучитьОбласть("РазделительВидовЦБ");
	ОбластьИтогоПоВидуЦБ		= Неопределено;
	
	Пока ОперацииСЦеннымиБумагами.Следующий() Цикл
		
		Если ОбластьШапкаОперацииЦБ = Неопределено Тогда
			ОбластьШапкаОперацииЦБ = Макет.ПолучитьОбласть("ШапкаОперацииЦБ");
			ДокументРезультат.Вывести(ОбластьШапкаОперацииЦБ);
		КонецЕсли;
		
		Если ОбластьИтогоПоВидуЦБ <> Неопределено Тогда
			ДокументРезультат.Вывести(ОбластьРазделительВидовЦБ);
		КонецЕсли;
		
		НачатаГруппаСтрок = Ложь;
		
		ОперацияЦБ = ОперацииСЦеннымиБумагами.Выбрать();
		Пока ОперацияЦБ.Следующий() Цикл
			
			Если Не НачатаГруппаСтрок Тогда
				ДокументРезультат.НачатьГруппуСтрок();
				НачатаГруппаСтрок = Истина;
			КонецЕсли;
			
			ОбластьСтрокаОперацииЦБ = Макет.ПолучитьОбласть("СтрокаОперацииЦБ");
			ОбластьСтрокаОперацииЦБ.Параметры.Заполнить(ОперацияЦБ);
			ОбластьСтрокаОперацииЦБ.Параметры.ЦеннаяБумагаДатаРегистрации	= Формат(ОперацияЦБ.ЦеннаяБумагаДатаРегистрации, "ДФ=dd.MM.yy");
			ОбластьСтрокаОперацииЦБ.Параметры.ЦеннаяБумагаДатаПогашения		= Формат(ОперацияЦБ.ЦеннаяБумагаДатаПогашения, "ДФ=dd.MM.yy; ДП=-");
			ДокументРезультат.Вывести(ОбластьСтрокаОперацииЦБ);

		КонецЦикла;
		
		Если НачатаГруппаСтрок Тогда		
			ДокументРезультат.ЗакончитьГруппуСтрок();
		КонецЕсли;
		
		ОбластьИтогоПоВидуЦБ = Макет.ПолучитьОбласть("ИтогоПоВидуЦБ");
		ОбластьИтогоПоВидуЦБ.Параметры.Заполнить(ОперацииСЦеннымиБумагами);
		ДокументРезультат.Вывести(ОбластьИтогоПоВидуЦБ);
		
	КонецЦикла;
	
	// Прочие операции по расчетному счету	
	
	Если ПрочиеОперацииПоРасчетномуСчету.Следующий() Тогда
		
		ВыборкаРасчетныйСчет = ПрочиеОперацииПоРасчетномуСчету.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
		Пока ВыборкаРасчетныйСчет.Следующий() Цикл
			
			ОбластьРасчетныйСчет = Макет.ПолучитьОбласть("РасчетныйСчет");
			ОбластьРасчетныйСчет.Параметры.Заполнить(ВыборкаРасчетныйСчет);
			ДокументРезультат.Вывести(ОбластьРасчетныйСчет);
			
			ДокументРезультат.НачатьГруппуСтрок();
			
			Операция = ВыборкаРасчетныйСчет.Выбрать();
			Пока Операция.Следующий() Цикл
				ОбластьОперацияПоРасчетномуСчету = Макет.ПолучитьОбласть("ОперацияПоРасчетномуСчету");
				ОбластьОперацияПоРасчетномуСчету.Параметры.Заполнить(Операция);
				ДокументРезультат.Вывести(ОбластьОперацияПоРасчетномуСчету);
			КонецЦикла;
			
			ДокументРезультат.ЗакончитьГруппуСтрок();
			
		КонецЦикла;
		
		ОбластьИтогоПоРасчетномуСчету = Макет.ПолучитьОбласть("ИтогоПоРасчетномуСчету");
		ОбластьИтогоПоРасчетномуСчету.Параметры.Заполнить(ПрочиеОперацииПоРасчетномуСчету);
		ДокументРезультат.Вывести(ОбластьИтогоПоРасчетномуСчету);		
		
	КонецЕсли;
	
	// Остатки д/с на конец
	
	ОбластьРаздел = Макет.ПолучитьОбласть("Раздел");
	ОбластьРаздел.Параметры.НаименованиеРаздела = "Денежные средства, переданные в доверительное управление на конец периода";
	ДокументРезультат.Вывести(ОбластьРаздел);
	
	ОбластьШапкаОстатковДС = Макет.ПолучитьОбласть("ШапкаОстатковДС");
	ДокументРезультат.Вывести(ОбластьШапкаОстатковДС);
	
	ОбластьИтогиОстатковДС = Макет.ПолучитьОбласть("ИтогиОстатковДС");
	
	Если ОстаткиДенежныхСредствНаКонец.Следующий() Тогда
		
		СтрокаОстатков = ОстаткиДенежныхСредствНаКонец.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
		Пока СтрокаОстатков.Следующий() Цикл
			
			ОбластьСтрокаОстатковДС = Макет.ПолучитьОбласть("СтрокаОстатковДС");
			ОбластьСтрокаОстатковДС.Параметры.Заполнить(СтрокаОстатков);
			ДокументРезультат.Вывести(ОбластьСтрокаОстатковДС);
				
			РасшифровкаСтроки = СтрокаОстатков.Выбрать();
			Пока РасшифровкаСтроки.Следующий() И ЗначениеЗаполнено(РасшифровкаСтроки.РасшифровкаСтроки) Цикл
				ОбластьРасшифровкаСтрокиОстатковДС = Макет.ПолучитьОбласть("РасшифровкаСтрокиОстатковДС");
				ОбластьРасшифровкаСтрокиОстатковДС.Параметры.Заполнить(РасшифровкаСтроки);
				ДокументРезультат.Вывести(ОбластьРасшифровкаСтрокиОстатковДС);
			КонецЦикла;
			
		КонецЦикла;
		
		ОбластьИтогиОстатковДС.Параметры.Заполнить(ОстаткиДенежныхСредствНаКонец);
	
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьИтогиОстатковДС);	
	
	// Подвал
	
	ПараметрыВыводаПодписей			= Новый Структура;
	СтруктураДанныхКонтактногоЛица	= Неопределено;
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхПодписантаРуководителя", СтруктураДанныхКонтактногоЛица);
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("Директор", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("ДиректорДолжность", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли;
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхПодписантаБухгалтера", СтруктураДанныхКонтактногоЛица);
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("Бухгалтер", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("БухгалтерДолжность", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли;
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхПодписантаИсполнителя", СтруктураДанныхКонтактногоЛица);
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("Исполнитель", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
	КонецЕсли;	
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхПодписантаКлиентаРуководителя", СтруктураДанныхКонтактногоЛица);
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("КлиентДиректор", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("КлиентДиректорДолжность", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли;
	
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхПодписантаКлиентаБухгалтера", СтруктураДанныхКонтактногоЛица);
	Если ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ПараметрыВыводаПодписей.Вставить("КлиентБухгалтер", СтруктураДанныхКонтактногоЛица.КонтактноеЛицо);
		ОснованиеПолномочий = ?(ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий), " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий + ")", "");
		ПараметрыВыводаПодписей.Вставить("КлиентБухгалтерДолжность", СтруктураДанныхКонтактногоЛица.Должность + ОснованиеПолномочий);	
	КонецЕсли;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Заполнить(ДанныеШапки);
	ОбластьПодвал.Параметры.Заполнить(ПараметрыВыводаПодписей);
	ДокументРезультат.Вывести(ОбластьПодвал);
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, Механизм);
		
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("ПодписантРуководитель");	
	Настройки.Добавить("ПодписантГлавбух");
	Настройки.Добавить("Подписант");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ДополнительныеСвойства = ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства;	
	
	// Заполняем настройки отчета	
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	Если НастройкиОтчета.Свойство("ПодписантРуководитель") Тогда 	
		ДополнительныеСвойства.Вставить("СтруктураДанныхПодписантаРуководителя", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛица(НастройкиОтчета.ПодписантРуководитель, ЭтотОбъект.Организация));
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("ПодписантГлавбух") Тогда 	
		ДополнительныеСвойства.Вставить("СтруктураДанныхПодписантаБухгалтера", РаботаСОтчетами.ПолучитьДанныеКонтактногоЛица(НастройкиОтчета.ПодписантГлавбух, ЭтотОбъект.Организация));
	КонецЕсли;
	
	Если НастройкиОтчета.Свойство("Подписант") Тогда 	
		ДополнительныеСвойства.Вставить("СтруктураДанныхПодписантаИсполнителя", НастройкиОтчета.Подписант);
	КонецЕсли;
	
	// Формируем отчет	
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СкомпоноватьРезультат(ДокументРезультат);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры

#КонецОбласти