
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Портфель страховой компании",
		"2.16",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
		
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция ПолучитьКурсыВалютныхАктивовСтраховойКомпании(СчетДоверительногоУправления, Организация, Период)
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Актив,
	               |	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	               |	ВЫБОР
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Акции
	               |			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
	               |			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
	               |			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	               |			ТОГДА ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	               |			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
	               |			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
	               |		КОГДА ОстаткиЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Паи
	               |			ТОГДА ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
	               |		ИНАЧЕ ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета
	               |	КОНЕЦ КАК Валюта
	               |ИЗ
	               |	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |				И ВЫБОР
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.Акции
	               |						ТОГДА ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.Облигации
	               |						ТОГДА ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.Векселя
	               |						ТОГДА ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Векселя).ВалютаНоминала
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
	               |						ТОГДА ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
	               |						ТОГДА ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ВалютаНоминала
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.ПроизводныеФинансовыеИнструменты
	               |						ТОГДА ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).Валюта
	               |					КОГДА ЦеннаяБумага ССЫЛКА Справочник.Паи
	               |						ТОГДА ВЫРАЗИТЬ(ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала
	               |					ИНАЧЕ ВЫРАЗИТЬ(&Организация КАК Справочник.Организации).ВалютаУчета
	               |				КОНЕЦ <> Организация.ВалютаУчета) КАК ОстаткиЦенныхБумагОстатки
	               |ГДЕ
	               |	ОстаткиЦенныхБумагОстатки.КоличествоОстаток > 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОстаткиПрочихАктивовОстатки.Актив,
	               |	ОстаткиПрочихАктивовОстатки.СчетДоверительногоУправления,
	               |	ОстаткиПрочихАктивовОстатки.Валюта
	               |ИЗ
	               |	РегистрНакопления.ОстаткиПрочихАктивов.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |				И Валюта <> Организация.ВалютаУчета) КАК ОстаткиПрочихАктивовОстатки
	               |ГДЕ
	               |	ОстаткиПрочихАктивовОстатки.КоличествоОстаток > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОстаткиПрочихАктивовОстатки.Валюта,
	               |	ОстаткиПрочихАктивовОстатки.Актив,
	               |	ОстаткиПрочихАктивовОстатки.СчетДоверительногоУправления
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент,
	               |	ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления,
	               |	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта
	               |ИЗ
	               |	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
	               |				И ВЫРАЗИТЬ(КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Валюта <> КредитныйИнструмент.Организация.ВалютаУчета) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
	               |ГДЕ
	               |	ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток > 0
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОстаткиДенежныхСредствОстатки.РасчетныйСчет,
	               |	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления,
	               |	ОстаткиДенежныхСредствОстатки.Валюта
	               |ИЗ
	               |	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |				И Валюта <> Организация.ВалютаУчета) КАК ОстаткиДенежныхСредствОстатки
	               |ГДЕ
	               |	ОстаткиДенежныхСредствОстатки.СуммаОстаток > 0";
	
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления",СчетДоверительногоУправления);
		
		ОстаткиВалютныхАктивовСтраховойКомпании = Запрос.Выполнить().Выгрузить();
		
		КурсыВалютАктивовСтраховойКомпании = Документы.РаспределениеАктивовСтраховыхКомпаний.ПолучитьКурсыВалютДляАктивовСтраховойКомпании(
				     ОстаткиВалютныхАктивовСтраховойКомпании, Период, Организация);
		
		Возврат КурсыВалютАктивовСтраховойКомпании;
		
		
КонецФункции
	
Функция ПолучитьКурсыВалютныхРасчетныхСчетовСтраховойКомпании(КурсыВалютАктивовСтраховойКомпании)
	
		// Нужно переименовать поля, чтобы их поставить в СКД
		
		Запрос = Новый Запрос();
		Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.Актив КАК Актив,
		               	|	_КурсыВалютАктивовСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Валюта КАК Валюта,
		               	|	_КурсыВалютАктивовСтраховойКомпании.ДатаКурсаВалют КАК ДатаКурсаВалют,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Курс КАК Курс,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Кратность КАК Кратность
		               	|ПОМЕСТИТЬ _КурсыВалютАктивовСтраховойКомпании
		               	|ИЗ
		               	|	&КурсыВалютАктивовСтраховойКомпании КАК _КурсыВалютАктивовСтраховойКомпании
		               	|;
		               	|
		               	|////////////////////////////////////////////////////////////////////////////////
		               	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.Актив КАК ВалютныйАктив,
		               	|	_КурсыВалютАктивовСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Валюта КАК ВалютаВалютногоАктива,
		               	|	_КурсыВалютАктивовСтраховойКомпании.ДатаКурсаВалют КАК ДатаКурсаВалют,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Курс КАК Курс,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Кратность КАК Кратность,
		               	|	ВЫРАЗИТЬ(_КурсыВалютАктивовСтраховойКомпании.Актив КАК Справочник.БанковскиеСчета).НомерСчета КАК НомерВалютногоРасчетногоСчета,
		               	|	ВЫРАЗИТЬ(_КурсыВалютАктивовСтраховойКомпании.Валюта КАК Справочник.Валюты).Код КАК КодВалюты
		               	|ИЗ
		               	|	_КурсыВалютАктивовСтраховойКомпании КАК _КурсыВалютАктивовСтраховойКомпании
		               	|ГДЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.Актив ССЫЛКА Справочник.БанковскиеСчета";
		Запрос.УстановитьПараметр("КурсыВалютАктивовСтраховойКомпании", КурсыВалютАктивовСтраховойКомпании);
		
		Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции
	
Функция ПолучитьКурсыВалютныхДепозитныхВкладовСтраховойКомпании(КурсыВалютАктивовСтраховойКомпании)
	
		Запрос = Новый Запрос();
		Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.Актив КАК Актив,
		               	|	_КурсыВалютАктивовСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Валюта КАК Валюта,
		               	|	_КурсыВалютАктивовСтраховойКомпании.ДатаКурсаВалют КАК ДатаКурсаВалют,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Курс КАК Курс,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Кратность КАК Кратность
		               	|ПОМЕСТИТЬ _КурсыВалютАктивовСтраховойКомпании
		               	|ИЗ
		               	|	&КурсыВалютАктивовСтраховойКомпании КАК _КурсыВалютАктивовСтраховойКомпании
		               	|;
		               	|
		               	|////////////////////////////////////////////////////////////////////////////////
		               	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.ДатаКурсаВалют КАК ДатаКурсаВалютДепозитногоВклада,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Курс КАК КурсДепозитногоВклада,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Кратность КАК КратностьДепозитногоВклада,
		               	|	ВЫРАЗИТЬ(_КурсыВалютАктивовСтраховойКомпании.Валюта КАК Справочник.Валюты).Код КАК КодВалютыДепозитногоВклада,
		               	|	ВЫРАЗИТЬ(_КурсыВалютАктивовСтраховойКомпании.Актив КАК Справочник.ДепозитныеВклады).Код КАК КодВалютногоДепозитногоВклада
		               	|ИЗ
		               	|	_КурсыВалютАктивовСтраховойКомпании КАК _КурсыВалютАктивовСтраховойКомпании
		               	|ГДЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.Актив ССЫЛКА Справочник.ДепозитныеВклады";
		Запрос.УстановитьПараметр("КурсыВалютАктивовСтраховойКомпании", КурсыВалютАктивовСтраховойКомпании);
		
		Возврат Запрос.Выполнить().Выгрузить();
	
	
КонецФункции

Функция ПолучитьКурсыВалютныхЦенныхБумагСтраховойКомпании(КурсыВалютАктивовСтраховойКомпании, Организация)
	
		
		Запрос = Новый Запрос();
		Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               	|	_КурсыВалютАктивовСтраховойКомпании.Актив КАК Актив,
		               	|	_КурсыВалютАктивовСтраховойКомпании.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Валюта КАК Валюта,
		               	|	_КурсыВалютАктивовСтраховойКомпании.ДатаКурсаВалют КАК ДатаКурсаВалют,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Курс КАК Курс,
		               	|	_КурсыВалютАктивовСтраховойКомпании.Кратность КАК Кратность
		               	|ПОМЕСТИТЬ _КурсыВалютАктивовСтраховойКомпании
		               	|ИЗ
		               	|	&КурсыВалютАктивовСтраховойКомпании КАК _КурсыВалютАктивовСтраховойКомпании
		               	|;
		               	|
