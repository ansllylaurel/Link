Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;
		
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрПериод = КонецДня(НастройкиОтчета.ПараметрыДанных.Элементы.Найти("Период").Значение.Дата); // 17,10,17 Уточнить у Бассъ, правильно ли именно конец дня, а не начало.
	ПараметрСчетДУ = НастройкиОтчета.ПараметрыДанных.Элементы.Найти("СчетДоверительногоУправления").Значение;
	ПараметрОрганизация = НастройкиОтчета.ПараметрыДанных.Элементы.Найти("Организация").Значение;
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "", Новый Структура("Период,Организация,СчетДоверительногоУправления", ПараметрПериод, ПараметрОрганизация, ПараметрСчетДУ));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	КурсыВалютныхАктивовСтраховойКомпании = ПолучитьКурсыВалютныхАктивовСтраховойКомпании(ПараметрСчетДУ, ПараметрОрганизация, ПараметрПериод);
	
	КурсыВалютныхРасчетныхСчетовСтраховойКомпании = ПолучитьКурсыВалютныхРасчетныхСчетовСтраховойКомпании(КурсыВалютныхАктивовСтраховойКомпании);
	КурсыВалютныхДепозитныхВкладовСтраховойКомпании = ПолучитьКурсыВалютныхДепозитныхВкладовСтраховойКомпании(КурсыВалютныхАктивовСтраховойКомпании);
	КурсыВалютныхЦенныхБумагСтраховойКомпании = ПолучитьКурсыВалютныхЦенныхБумагСтраховойКомпании(КурсыВалютныхАктивовСтраховойКомпании, ПараметрОрганизация);
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	СхемаКомпоновкиДанных = ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);

	ВнешнийНаборДанных = Новый Структура("КурсыВалютныхРасчетныхСчетовСтраховойКомпании", КурсыВалютныхРасчетныхСчетовСтраховойКомпании); 

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	// Нельзя использовать связи нескольких наборов данных с одним внешним. Приходится делать отдельные
	ВнешниеНаборыДанных = Новый Структура();
	
	ВнешниеНаборыДанных.Вставить("КурсыВалютныхРасчетныхСчетовСтраховойКомпании", КурсыВалютныхРасчетныхСчетовСтраховойКомпании);
	ВнешниеНаборыДанных.Вставить("КурсыВалютныхДепозитныхВкладовСтраховойКомпании", КурсыВалютныхДепозитныхВкладовСтраховойКомпании);	
	ВнешниеНаборыДанных.Вставить("КурсыВалютныхЦенныхБумагСтраховойКомпании", КурсыВалютныхЦенныхБумагСтраховойКомпании);  
	
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);

	ДокументРезультат.Очистить();

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры
