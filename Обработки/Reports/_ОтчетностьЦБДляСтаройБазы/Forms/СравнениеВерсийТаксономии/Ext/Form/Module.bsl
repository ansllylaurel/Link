		СоответствиеКлючей.Вставить(Ключ, Сред(НовыйКлюч, СтрНайти(НовыйКлюч, ".") + 1));
		
	ИначеЕсли ВерсияНовогоКлюча < ВерсияТаксономии И ВерсияКлюча >= ВерсияТаксономии Тогда
		СоответствиеКлючей.Вставить(НовыйКлюч, Сред(Ключ, СтрНайти(Ключ, ".") + 1));
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура СортироватьЗначенияМассива(МассивЗначений)

	РазделыОтчета = Новый ТаблицаЗначений;
	РазделыОтчета.Колонки.Добавить("ИмяРаздела",              Новый ОписаниеТипов("Строка"));
	РазделыОтчета.Колонки.Добавить("ИмяРазделаДляСортировки", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ИмяРаздела Из МассивЗначений Цикл
		НоваяСтрока = РазделыОтчета.Добавить();
		НоваяСтрока.ИмяРаздела              = ИмяРаздела;
		НоваяСтрока.ИмяРазделаДляСортировки = ОбработатьИмяРазделаДляСортировки(ИмяРаздела);;
	КонецЦикла;	
	
	РазделыОтчета.Сортировать("ИмяРазделаДляСортировки");
	
	МассивЗначений = РазделыОтчета.ВыгрузитьКолонку("ИмяРаздела");
	
КонецПроцедуры

&НаСервере
Процедура ВывестиУровень(Ключ, Уровень, Родитель, Суфикс = "")

	ПараметрыОбласти = Новый Структура;
	ПараметрыОбласти.Вставить("Ключ",		Ключ);
	ПараметрыОбласти.Вставить("НовыйКлюч",	ПолучитьСоответствиеКлюча(Ключ, СтараяВерсия, НоваяВерсия, Родитель));
	
	Если ПустаяСтрока(Суфикс) И ПараметрыОбласти.Ключ <> ПараметрыОбласти.НовыйКлюч Тогда
		Область = СравнениеВерсийТаксономии.ПолучитьОбласть("Уровень" + Уровень + "ЗаменаКлюча");
	Иначе
		Область = СравнениеВерсийТаксономии.ПолучитьОбласть("Уровень" + Уровень + Суфикс);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Область.Параметры, ПараметрыОбласти);
	Результат.Вывести(Область);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтчетаПриИзменении(Элемент)
	
	ЗаполнитьСписокВыбораПериодичности();
	УстановитьПредставлениеОтчета(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеОтчета(Форма)
	
	Если ЗначениеЗаполнено(Форма.Отчет.ВариантОтчета) Тогда

		НайденныеСтроки = Форма.ПредставленияОтчетов.НайтиСтроки(Новый Структура("ИмяОтчета", Форма.Отчет.ВариантОтчета)); 
		Если НайденныеСтроки.Количество() Тогда
			
			Форма.ПредставлениеОтчета = НайденныеСтроки[0].Представление;
			
		Иначе
			
			Форма.ПредставлениеОтчета = "";
			
		КонецЕсли;	
		
	КонецЕсли;

КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокВыбораПериодичности()

	ТекущаяПериодичность = ЭтаФорма.Периодичность;
	
	Элементы.Периодичность.СписокВыбора.Очистить();
	
	МассивПериодичностей = Новый Массив;
	МассивПериодичностей.Добавить("ПоЗапросу");
	МассивПериодичностей.Добавить("Нерегулярная");
	МассивПериодичностей.Добавить("Месячная");
	МассивПериодичностей.Добавить("Квартальная");
	МассивПериодичностей.Добавить("Квартальная (конец года)");
	МассивПериодичностей.Добавить("Годовая");
	
	МассивТочекВхода = ПолучитьМассивТочекВхода(ПоследняяВерсияТаксономии);
	Для Индекс = 0 По МассивТочекВхода.ВГраница() Цикл
		Если ЗначениеЗаполнено(МассивТочекВхода[Индекс]) Тогда
			ИндексПериодичности = Индекс % 6;
			Если Элементы.Периодичность.СписокВыбора.НайтиПоЗначению(ИндексПериодичности + 1) = Неопределено Тогда
				Элементы.Периодичность.СписокВыбора.Добавить(ИндексПериодичности + 1, МассивПериодичностей[ИндексПериодичности]);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
    Элементы.Периодичность.СписокВыбора.СортироватьПоЗначению();
	
	Если Элементы.Периодичность.СписокВыбора.НайтиПоЗначению(ТекущаяПериодичность) = Неопределено Тогда
		Если Элементы.Периодичность.СписокВыбора.Количество() Тогда
			ЭтаФорма.Периодичность = Элементы.Периодичность.СписокВыбора[0].Значение;	
		КонецЕсли;	
	Иначе	    
		ЭтаФорма.Периодичность = ТекущаяПериодичность;	
	КонецЕсли;	
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТочкуВхода(ВерсияТаксономии)
	
	МассивТочекВхода = ПолучитьМассивТочекВхода(ВерсияТаксономии);
	Если Отчет.ВариантОтчета = "ОКУД0420459" Тогда
		// 459-й отчет входит в множество точек входа с разной периодичностью и на каждую периодичность может быть несколько точек входа
		// Ищем любую точку входа подходящей периодичности
		Для Индекс = 0 По МассивТочекВхода.ВГраница() Цикл
			Если ЗначениеЗаполнено(МассивТочекВхода[Индекс]) И Индекс % 6 = ЭтаФорма.Периодичность - 1 Тогда
				Возврат МассивТочекВхода[Индекс];
			КонецЕсли;
		КонецЦикла;	
	ИначеЕсли МассивТочекВхода.Количество() Тогда
		Возврат МассивТочекВхода[ЭтаФорма.Периодичность - 1];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивТочекВхода(ВерсияТаксономии)
	
	Если Отчет.ВариантОтчета = "4263_ods" Тогда
		Возврат "ep_nso_uk_m_15d_ods";
	КонецЕсли;
	
	Если Отчет.ВариантОтчета = "sr_sved_otch_org_otv_predm_obl"
	 ИЛИ Отчет.ВариантОтчета = "sr_sved_otch_org_uk" 
	 ИЛИ Отчет.ВариантОтчета = "sr_sved_otch_org_podpisant" 
	 ИЛИ Отчет.ВариантОтчета = "sr_sved_otch_org_inf_ob_otch" Тогда
		ИмяПакета = "ОКУД0420501";
		
	ИначеЕсли Отчет.ВариантОтчета = "SR_Sved_ObOtchOrg_OtvLicza2"
		ИЛИ Отчет.ВариантОтчета = "SR_Sved_ObOtchOrg_OtvLicza"
		ИЛИ Отчет.ВариантОтчета = "SR_INFO" Тогда
		
		ИмяПакета = "ОКУД0420401";
	Иначе
		ИмяПакета = Отчет.ВариантОтчета;
	КонецЕсли;	
	
	РеквизитОтчёт	= РеквизитФормыВЗначение("Отчет");
	МакетТочкиВхода = РеквизитОтчёт.ПолучитьМакет("ТочкиВхода");
	
	МассивТочекВхода = Новый Массив;
	
	Для НомерСтроки = 2 По МакетТочкиВхода.ВысотаТаблицы Цикл
		Если ИмяПакета = СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 1, НомерСтроки, 1).Текст)
			И ВерсияТаксономии = СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 3, НомерСтроки, 3).Текст) 
			И (СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 4, НомерСтроки, 4).Текст) = "ДА") = Отчет.ТребуетсяПодтверждениеСпецДепа
			И ((СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 5, НомерСтроки, 5).Текст) = "ДА") = ЭтаФорма.МалоеПредприятие 
				ИЛИ ВерсияТаксономии < "4_2") Тогда
			Для НомерКолонки = 6 По 11 Цикл
				МассивТочекВхода.Добавить(СокрЛП(МакетТочкиВхода.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат МассивТочекВхода;
	
КонецФункции

&НаСервере
Функция ПолучитьФабрику(ТочкаВхода, ВерсияТаксономии)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	//Если ОтчетОбъект.Метаданные().Макеты.Найти("Taxonomy" + ВерсияТаксономии) = Неопределено Тогда
	//	ВызватьИсключение "Схемы таксономии " + ВерсияТаксономии + " не загружены в обработку!";
	//КонецЕсли;
	//
	//МакетСТаксономией = ОтчетОбъект.ПолучитьМакет("Taxonomy" + ВерсияТаксономии);
	//
	//АрхивСхемТаксономии = Новый ЧтениеZipФайла(МакетСТаксономией.ОткрытьПотокДляЧтения());

	АрхивСхемТаксономии = ОтчетОбъект.ПолучитьАрхивСВерсиейТаксономии(ВерсияТаксономии);	
	
	ЭлементАрхива = АрхивСхемТаксономии.Элементы.Найти(ТочкаВхода + ".xsd");
	
	Если ЭлементАрхива = Неопределено Тогда
		ВызватьИсключение "В архиве версии таксономии " + ВерсияТаксономии + " нет схемы " + ТочкаВхода;
	КонецЕсли;
	
	АрхивСхемТаксономии.Извлечь(ЭлементАрхива, КаталогВременныхФайлов() + ВерсияТаксономии);
	АрхивСхемТаксономии.Закрыть();

	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(КаталогВременныхФайлов() + ВерсияТаксономии + "\" + ТочкаВхода + ".xsd");
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	УдалитьФайлы(КаталогВременныхФайлов() + "\" + ТочкаВхода, ".xsd");
	
	Возврат НоваяФабрикаXDTO;
	
КонецФункции

&НаСервере
Функция ОбработатьИмяРазделаДляСортировки(Знач ИмяРаздела)
	
	Стр = "";
	Если ВРег(ИмяРаздела) = ВРег("SR_INFO") Тогда
		
		Стр = "Z1"
		
	ИначеЕсли ВРег(ИмяРаздела) = ВРег("sr_sved_otch_org_podpisant") Тогда
		
		Стр = "Z2";
		
	ИначеЕсли ВРег(ИмяРаздела) = ВРег("sr_sved_otch_org_uk") Тогда
		
		Стр = "Z3";
		
	ИначеЕсли ВРег(ИмяРаздела) = ВРег("SR_Sved_ObOtchOrg_OtvLicza") Тогда
		
		Стр = "Z4";
		
	ИначеЕсли ВРег(ИмяРаздела) = ВРег("sr_sved_otch_org_otv_predm_obl") Тогда
		
		Стр = "Z5";
		
	ИначеЕсли ВРег(ИмяРаздела) = ВРег("sr_sved_otch_org_inf_ob_otch") Тогда
		
		Стр = "Z6";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Стр) Тогда
		Возврат Стр;
	КонецЕсли;	
	
	// Имена в некоторых разделах имеют разную структуру. Например: r1 и r_4 не будут правильно упорядочены без обработки
	Стр = ИмяРаздела;

	Стр = СтрЗаменить(ВРег(Стр), "R_", "R");
	
	СоставляющиеИмени = СтрРазделить(Стр, "_");
	
	Для Ном = 0 По СоставляющиеИмени.ВГраница() Цикл
		
		ЧастьИмени = СоставляющиеИмени[Ном];
		Если СтрНачинаетсяС(ЧастьИмени, "0420") Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		Если СтрПодобнаПоРегулярномуВыражению(ЧастьИмени, "^PR\d+$") Тогда	
			
			ЧислоВИмени = Число(СтрЗаменить(ЧастьИмени, "PR", ""));
			ЧислоВИмени = Формат(ЧислоВИмени, "ЧЦ=2; ЧВН=");
			ЧастьИмени = "PR" + ЧислоВИмени;
			СоставляющиеИмени[Ном] = ЧастьИмени;
			
		ИначеЕсли СтрПодобнаПоРегулярномуВыражению(ЧастьИмени, "^R\d+$") Тогда	
			
			ЧислоВИмени = Число(СтрЗаменить(ЧастьИмени, "R", ""));
			ЧислоВИмени = Формат(ЧислоВИмени, "ЧЦ=2; ЧВН=");
			ЧастьИмени = "R" + ЧислоВИмени;
			СоставляющиеИмени[Ном] = ЧастьИмени;
			
		ИначеЕсли СтрПодобнаПоРегулярномуВыражению(ЧастьИмени, "^P\d+$") Тогда		
			
			ЧислоВИмени = Число(СтрЗаменить(ЧастьИмени, "P", ""));
			ЧислоВИмени = Формат(ЧислоВИмени, "ЧЦ=2; ЧВН=");
			ЧастьИмени = "P" + ЧислоВИмени;
			СоставляющиеИмени[Ном] = ЧастьИмени;
			
		ИначеЕсли СтрПодобнаПоРегулярномуВыражению(ЧастьИмени, "^\d+$") Тогда
			
			ЧислоВИмени = Формат(Число(ЧастьИмени), "ЧЦ=2; ЧВН=");
			СоставляющиеИмени[Ном] = ЧислоВИмени;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Стр = СтрСоединить(СоставляющиеИмени, "_");
	
	Возврат Стр;
	
КонецФункции	

&НаСервере
Функция ПолучитьСтруктуруОтчета(ВерсияТаксономии, ТекущаяТочкаВхода)
	
	СтруктураОтчета = Новый Структура;
	
	ТекущаяТочкаВхода = ПолучитьТочкуВхода(ВерсияТаксономии);
	Если ТекущаяТочкаВхода = Неопределено Тогда
		Возврат СтруктураОтчета;
	КонецЕсли;
	
	НоваяФабрикаXDTO = ПолучитьФабрику(ТекущаяТочкаВхода, ВерсияТаксономии);
	
	ТипОбъектаXDTO = НоваяФабрикаXDTO.Тип("XBRL", "type_XBRL_Entry_Point");
	ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

	РазделыОтчета = Новый ТаблицаЗначений;
	РазделыОтчета.Колонки.Добавить("ИмяРазделаДляСортировки", Новый ОписаниеТипов("Строка"));
	РазделыОтчета.Колонки.Добавить("СвойствоXDTO");
	
	Для Каждого СвойствоXDTO Из ТипОбъектаXDTO.Свойства Цикл
		
		Если ЗначениеЗаполнено(ФильтрПоРазделам) И Найти(СокрЛП(ВРег(ФильтрПоРазделам)), ВРег(СвойствоXDTO.Имя)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ФлагДобавления = Ложь;
		ИмяРаздела     = СвойствоXDTO.Имя;
		Если Найти(ИмяРаздела, СтрЗаменить(Отчет.ВариантОтчета, "ОКУД", "")) > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420011" И Найти(ИмяРаздела, "_ods_") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420402" И Найти(ИмяРаздела, "sr_nfo_8") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420402" И Найти(ИмяРаздела, "sr_nfo_8_2") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420402" И Найти(ИмяРаздела, "sr_nfo_8_hc1") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ГКФО_СопроводительноеПисьмо" И Найти(ИмяРаздела, "sr_GKFO_Soprovod") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420419" И Найти(ИмяРаздела, "sr_nfo_3") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420510" И Найти(ИмяРаздела, "sr_nfo_3") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420515" И Найти(ИмяРаздела, "sr_nfo_5") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420406" И Найти(ИмяРаздела, "sr_nfo_6") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420516" И Найти(ИмяРаздела, "sr_nfo_6") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420520" И Найти(ИмяРаздела, "sr_nfo_4") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420432" И Найти(ИмяРаздела, "sr_nfo_2_") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420523" И Найти(ИмяРаздела, "sr_nfo_2_") > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420869" 
			И Найти("dogovory_1, kontragenty_1, obekty_ucheta_r2, obekty_ucheta_r4", ИмяРаздела) > 0 Тогда
			ФлагДобавления = Истина;
		ИначеЕсли Найти("SR_Sved_ObOtchOrg_OtvLicza, sr_sved_otch_org_otv_predm_obl, sr_sved_otch_org_inf_ob_otch", ИмяРаздела) > 0 
			И СтрНачинаетсяС(Отчет.ВариантОтчета, "ОКУД0420") Тогда // Выгружаются вместе с отчетом
			ФлагДобавления = Истина;
		ИначеЕсли Найти("SR_INFO, sr_sved_otch_org_podpisant, sr_sved_otch_org_uk", ИмяРаздела) > 0 
			И СтрНачинаетсяС(Отчет.ВариантОтчета, "ОКУД0420") Тогда // Выгружаются в отдельный отчет
			ФлагДобавления = Истина;
		КонецЕсли;
		
		Если ФлагДобавления Тогда
			НоваяСтрока = РазделыОтчета.Добавить();
			НоваяСтрока.ИмяРазделаДляСортировки = ОбработатьИмяРазделаДляСортировки(СвойствоXDTO.Имя);
			НоваяСтрока.СвойствоXDTO            = СвойствоXDTO;
		КонецЕсли;	

	КонецЦикла;	
	РазделыОтчета.Сортировать("ИмяРазделаДляСортировки");
	
	Для Каждого Раздел Из РазделыОтчета Цикл
		ДобавитьЭлементВСтруктуру(Раздел.СвойствоXDTO, СтруктураОтчета, НоваяФабрикаXDTO, ВерсияТаксономии);
	КонецЦикла;
	
	Возврат СтруктураОтчета;
	
КонецФункции

&НаСервере
Процедура ДобавитьЭлементВСтруктуру(Свойство, СтруктураОтчета, НоваяФабрикаXDTO, ВерсияТаксономии)
	
	Если СтрНачинаетсяС(Свойство.Имя, "Value") И Свойство.Имя <> "Value" Тогда
		Возврат;
	КонецЕсли;
	
	Если Свойство.Форма = ФормаXML.Элемент Тогда
		Если НЕ СтруктураОтчета.Свойство(ПреобразоватьИмяСвойства(Свойство.Имя, ВерсияТаксономии)) Тогда 
			СтруктураОтчета.Вставить(ПреобразоватьИмяСвойства(Свойство.Имя, ВерсияТаксономии), Новый Структура);
		КонецЕсли;	
			
		Для Каждого Свойство1 Из Свойство.Тип.Свойства Цикл
			ДобавитьЭлементВСтруктуру(Свойство1, СтруктураОтчета[ПреобразоватьИмяСвойства(Свойство.Имя, ВерсияТаксономии)], НоваяФабрикаXDTO, ВерсияТаксономии);
		КонецЦикла;
	ИначеЕсли Свойство.Форма = ФормаXML.Атрибут Тогда
		МассивЗначенийФасетов = Новый Массив;		
		Если Свойство.Тип = НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "date")
			ИЛИ Свойство.Тип = НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "dateTime") Тогда
			МассивЗначенийФасетов.Добавить("Дата");
		ИначеЕсли Свойство.Тип = НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "decimal") Тогда
			МассивЗначенийФасетов.Добавить("Число");
		ИначеЕсли Свойство.Тип = НоваяФабрикаXDTO.Тип("http://www.w3.org/2001/XMLSchema", "boolean") Тогда
			МассивЗначенийФасетов.Добавить("Булево");
		ИначеЕсли Свойство.Тип.Фасеты <> Неопределено И Свойство.Тип.Фасеты.Количество() > 0 Тогда
			Для Каждого Фасет Из Свойство.Тип.Фасеты Цикл
				Если Фасет.Вид = ВидФасетаXDTO.Образец 
				 ИЛИ Фасет.Вид = ВидФасетаXDTO.ПробельныеСимволы Тогда
					МассивЗначенийФасетов.Добавить("preserve");
				ИначеЕсли Фасет.Вид = ВидФасетаXDTO.МинДлина Тогда
					//Ничего
				Иначе
					МассивЗначенийФасетов.Добавить(Фасет.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтруктураОтчета.Вставить(Свойство.Имя, МассивЗначенийФасетов);
	Иначе
		Сообщить(Свойство.Форма);
	КонецЕсли;
	
КонецПроцедуры


