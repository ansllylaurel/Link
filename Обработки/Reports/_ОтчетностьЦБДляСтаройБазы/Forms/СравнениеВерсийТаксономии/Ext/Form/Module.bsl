&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьВариантОтчёта();
	ЗаполнитьВерсииТаксономии();
	
	СравнениеВерсийТаксономии = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("СравнениеВерсийТаксономии");
	
	ТолькоРасхождения = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(Отчет.ВариантОтчета) Тогда

		ЗаполнитьСписокВыбораПериодичности();
		УстановитьПредставлениеОтчета(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантОтчёта()
	
	РеквизитОтчёт	= РеквизитФормыВЗначение("Отчет");
	
  	МакетВидимостьРеквизитов = РеквизитОтчёт.ПолучитьМакет("ОписаниеОтчетов");

	ПредставленияОтчетов.Очистить();
  	Для НомерСтрокиПоиска = 2 По МакетВидимостьРеквизитов.ВысотаТаблицы Цикл
		
		ИмяОтчета     = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтрокиПоиска, 1, НомерСтрокиПоиска, 1).Текст); 
		Представление = СокрЛП(МакетВидимостьРеквизитов.Область(НомерСтрокиПоиска, 2, НомерСтрокиПоиска, 2).Текст); 
		Если ПредставленияОтчетов.НайтиСтроки(Новый Структура("ИмяОтчета", ИмяОтчета)).Количество()= 0 Тогда
			
			НоваяСтрока = ПредставленияОтчетов.Добавить();
			НоваяСтрока.ИмяОтчета     = ИмяОтчета;
			НоваяСтрока.Представление = Представление;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	МакетТочкиВхода = РеквизитОтчёт.ПолучитьМакет("ТочкиВхода");
	
	Элементы.ВариантОтчета.СписокВыбора.Очистить();
	
	Элементы.ВариантОтчета.СписокВыбора.Добавить("Все", "Все");
	
	Для НомерСтроки = 3 По МакетТочкиВхода.ВысотаТаблицы Цикл

		ИмяОтчетаТочкиВхода = СокрЛП(МакетТочкиВхода.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		
		Если Элементы.ВариантОтчета.СписокВыбора.НайтиПоЗначению(ИмяОтчетаТочкиВхода) = Неопределено Тогда
			
			Элементы.ВариантОтчета.СписокВыбора.Добавить(ИмяОтчетаТочкиВхода);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ВариантОтчета.СписокВыбора.Добавить("sr_sved_otch_org_otv_predm_obl");
	Элементы.ВариантОтчета.СписокВыбора.Добавить("SR_Sved_ObOtchOrg_OtvLicza2");
	Элементы.ВариантОтчета.СписокВыбора.Добавить("SR_INFO");
	Элементы.ВариантОтчета.СписокВыбора.Добавить("sr_sved_otch_org_podpisant");
	Элементы.ВариантОтчета.СписокВыбора.Добавить("sr_sved_otch_org_uk");
	Элементы.ВариантОтчета.СписокВыбора.Добавить("SR_Sved_ObOtchOrg_OtvLicza");
	Элементы.ВариантОтчета.СписокВыбора.Добавить("sr_sved_otch_org_inf_ob_otch");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВерсииТаксономии()

	ХранилищеВерсийТаксономииЦБ = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки("_ХранилищеВерсийТаксономии");
	
	Для Каждого Макет Из ХранилищеВерсийТаксономииЦБ.Метаданные().Макеты Цикл
		Если СтрНачинаетсяС(Макет.Имя, "Taxonomy") Тогда
			ПоследняяВерсияТаксономии = СтрЗаменить(Макет.Имя, "Taxonomy", "");
			Элементы.НоваяВерсия.СписокВыбора.Добавить(ПоследняяВерсияТаксономии, СтрЗаменить(ПоследняяВерсияТаксономии, "_", "."));
			Элементы.СтараяВерсия.СписокВыбора.Добавить(ПоследняяВерсияТаксономии, СтрЗаменить(ПоследняяВерсияТаксономии, "_", "."));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СравнитьВерсииТаксономии(Команда)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	СравнитьВерсииТаксономииНаСервере();
	
	Длительность   = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	ВремяСравнения = СтрШаблон("Длительность последнего сравнения: %1", ОбщегоНазначенияКлиентСервер.ДлительностьВЧасахМинутахСекундах(Длительность))
	
КонецПроцедуры

&НаСервере
Процедура СравнитьВерсииТаксономииНаСервере()
	
	Если ЭтаФорма.Периодичность = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрана периодичность!");
		Возврат;
	КонецЕсли;                
	
	Результат.Очистить();
	
	СтруктураСтарогоОтчета	= ПолучитьСтруктуруОтчета(СтараяВерсия, СтараяТочкаВхода);
	//СтараяТочкаВхода = СтараяТочкаВхода + ".xsd";
	Элементы.СтараяТочкаВхода.Заголовок = СтараяВерсия;
	СтруктураНовогоОтчета	= ПолучитьСтруктуруОтчета(НоваяВерсия, НоваяТочкаВхода);
	Элементы.НоваяТочкаВхода.Заголовок = НоваяВерсия;
	//НоваяТочкаВхода = НоваяТочкаВхода + ".xsd";
	
	ВывестиОтчетОСравнении(СтруктураНовогоОтчета, СтруктураСтарогоОтчета, 1);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиОтчетОСравнении(СтруктураНовогоОтчета, СтруктураСтарогоОтчета, Уровень, Родитель = "")
	
	Если СтруктураНовогоОтчета = Неопределено И ТипЗнч(СтруктураСтарогоОтчета) = Тип("Структура") Тогда
		СтруктураНовогоОтчета = Новый Структура;
	ИначеЕсли СтруктураНовогоОтчета = Неопределено И ТипЗнч(СтруктураСтарогоОтчета) = Тип("Массив") Тогда
		СтруктураНовогоОтчета = Новый Массив;
	ИначеЕсли СтруктураСтарогоОтчета = Неопределено И ТипЗнч(СтруктураНовогоОтчета) = Тип("Структура") Тогда
		СтруктураСтарогоОтчета = Новый Структура;
	ИначеЕсли СтруктураСтарогоОтчета = Неопределено И ТипЗнч(СтруктураНовогоОтчета) = Тип("Массив") Тогда
		СтруктураСтарогоОтчета = Новый Массив;
	КонецЕсли;
	
	Если ТипЗнч(СтруктураНовогоОтчета) = Тип("Структура") Тогда
		МассивКлючей = Новый Массив;
		
		// Добавляем в массив ключей разделы старого отчета
		Для Каждого ЭлементСтарогоОтчета Из СтруктураСтарогоОтчета Цикл
			МассивКлючей.Добавить(ЭлементСтарогоОтчета.Ключ);
		КонецЦикла;
		
		// Добавляем в массив ключей разделы нового отчета, которые не найдены в старом отчете (проверить соответствие ключей в обработке!) 	
		ПоследнийИндекс = -1;
		
		Для Каждого ЭлементНовогоОтчета Из СтруктураНовогоОтчета Цикл
			Если СтрНачинаетсяС(ЭлементНовогоОтчета.Ключ, "Value") И ЭлементНовогоОтчета.Ключ <> "Value" Тогда
				Продолжить;
			КонецЕсли;
			
			Ключ = ПолучитьСоответствиеКлюча(ЭлементНовогоОтчета.Ключ, НоваяВерсия, СтараяВерсия, Родитель);
			
			Индекс	= МассивКлючей.Найти(Ключ);
			Если Индекс = Неопределено И Ключ = ЭлементНовогоОтчета.Ключ Тогда
				МассивКлючей.Вставить(ПоследнийИндекс + 1, Ключ);
			ИначеЕсли Индекс <> Неопределено Тогда
				ПоследнийИндекс = Индекс;
			КонецЕсли;
		КонецЦикла;	
		
		СортироватьЗначенияМассива(МассивКлючей);
		
		Для Каждого Ключ Из МассивКлючей Цикл
			НовыйКлюч = ПолучитьСоответствиеКлюча(Ключ, СтараяВерсия, НоваяВерсия, Родитель);
			
			ЗначениеЭлементаНовогоОтчета = "";
			ЗначениеЭлементаСтарогоОтчета = "";
			
			Если СтруктураНовогоОтчета.Свойство(НовыйКлюч, ЗначениеЭлементаНовогоОтчета) 
			   И СтруктураСтарогоОтчета.Свойство(Ключ, ЗначениеЭлементаСтарогоОтчета) Тогда
				ВывестиУровень(Ключ, Уровень, Родитель);
				
				ВысотаТаблицы = Результат.ВысотаТаблицы;
				
				ВывестиОтчетОСравнении(ЗначениеЭлементаНовогоОтчета, ЗначениеЭлементаСтарогоОтчета, Уровень + 1, Ключ);
				
				Если ВысотаТаблицы = Результат.ВысотаТаблицы 
					И ТолькоРасхождения
					И НовыйКлюч = Ключ Тогда
					Результат.УдалитьОбласть(Результат.Область("R" + Формат(Результат.ВысотаТаблицы, "ЧРГ=; ЧГ=0")), ТипСмещенияТабличногоДокумента.ПоВертикали);				
				КонецЕсли;
				
			ИначеЕсли СтруктураНовогоОтчета.Свойство(НовыйКлюч, ЗначениеЭлементаНовогоОтчета) Тогда
				ВывестиУровень(Ключ, Уровень, Родитель, "Плюс");
				ВывестиОтчетОСравнении(ЗначениеЭлементаНовогоОтчета, Неопределено, Уровень + 1, Ключ);
				
			Иначе
				ВывестиУровень(Ключ, Уровень, Родитель, "Минус");
				ВывестиОтчетОСравнении(Неопределено, ЗначениеЭлементаСтарогоОтчета, Уровень + 1, Ключ);
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(СтруктураНовогоОтчета) = Тип("Массив") Тогда
		
		МассивЗначений = Новый Массив;
		
		Для Каждого ЭлементСтарогоОтчета Из СтруктураСтарогоОтчета Цикл
			МассивЗначений.Добавить(ЭлементСтарогоОтчета);
		КонецЦикла;
		
		ПоследнийИндекс = -1;
		
		Для Каждого ЭлементНовогоОтчета Из СтруктураНовогоОтчета Цикл
			Ключ	= ПолучитьСоответствиеКлюча(ЭлементНовогоОтчета, НоваяВерсия, СтараяВерсия, Родитель);
			Индекс	= МассивЗначений.Найти(Ключ);
			Если Индекс = Неопределено Тогда
				МассивЗначений.Вставить(ПоследнийИндекс + 1, Ключ);
			Иначе
				ПоследнийИндекс = Индекс;
			КонецЕсли;
		КонецЦикла;	
		
		Для ИндексЗначений = 0 По МассивЗначений.Количество() - 1 Цикл
			Значение		= МассивЗначений[ИндексЗначений];
			НовоеЗначение	= ПолучитьСоответствиеКлюча(Значение, СтараяВерсия, НоваяВерсия, Родитель);

			Если ИндексЗначений = 1 И МассивЗначений.Количество() > 11 Тогда
				Результат.НачатьГруппуСтрок(Значение, Ложь);
			КонецЕсли;
			
			Если СтруктураНовогоОтчета.Найти(НовоеЗначение) <> Неопределено 
			   И СтруктураСтарогоОтчета.Найти(Значение) <> Неопределено Тогда
				Если НЕ ТолькоРасхождения ИЛИ НовоеЗначение <> Значение Тогда
					ВывестиУровень(Значение, Уровень, Родитель);
				КонецЕсли;
			ИначеЕсли СтруктураНовогоОтчета.Найти(НовоеЗначение) <> Неопределено Тогда
				ВывестиУровень(Значение, Уровень, Родитель, "Плюс");
				УдалитьСтроку = Ложь;
			Иначе
				ВывестиУровень(Значение, Уровень, Родитель, "Минус");
				УдалитьСтроку = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивЗначений.Количество() > 11 Тогда
			Результат.ЗакончитьГруппуСтрок();
		КонецЕсли;
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоответствиеКлюча(Знач Ключ, ВерсияКлюча, ВерсияНовогоКлюча, Родитель)
	
	СоответствиеКлючей = Новый Соответствие;

	Если Найти("ОКУД0420401,ОКУД0420402,ОКУД0420404,ОКУД0420406,ОКУД0420409,ОКУД0420410,ОКУД0420411,ОКУД0420412,ОКУД0420414,ОКУД0420415,ОКУД0420416
		|,ОКУД0420417,ОКУД0420419,ОКУД0420429,ОКУД0420431,ОКУД0420432,ОКУД0420449,ОКУД0420453", Отчет.ВариантОтчета) > 0 Тогда
		
        // 5.2 - 6.1 SR_INFO
		ДобавитьСоответствиеКлючей("AdresPocht_Prof_uch",         "Pocht_Adres",        "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("Dolzgnostlizapodpotchetnost", "DolzhDLPodpOtch",    "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("FIOEIO",                      "FIOLiczaPodpisOtch", "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("INN_Prof_uch",                "INN",                "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("Kod_Okato3",                  "Kod_Okato",          "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("Poln_Naim_Prof_uch",          "PolnFirmNaim",       "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("SokrNaim_Prof_uch",           "SokrNaimNFO",        "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
        // 5.2 - 6.1 SR_Sved_ObOtchOrg_OtvLicza
		ДобавитьСоответствиеКлючей("DolzhLiczaOtvZaPrOblast",            "Dolzhnost",                        "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("KontInfLiczaOtvZaPrOblast",          "Telefon",                          "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("LiczoOtvZaPrOblast",                 "FIOLiczaOtvZaPrOblast",            "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("NaimITrazrabotchika",                "PONaKotPodgotovPaketOtch",         "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		ДобавитьСоответствиеКлючей("Priznak_Nulevogo_OtchetaEnumerator", "PriznakNulevogoOtchetaEnumerator", "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		
	КонецЕсли;	
	
	Если Отчет.ВариантОтчета = "ОКУД0420011" Тогда

		Если ВерсияКлюча < "4_2" И ВерсияНовогоКлюча >= "4_2" Тогда
			Ключ = СтрЗаменить(Ключ, "0420011_ODS", "0420011_ODS_UK");
		ИначеЕсли ВерсияНовогоКлюча < "4_2" И ВерсияКлюча >= "4_2" Тогда
			Ключ = СтрЗаменить(Ключ, "0420011_ODS_UK", "0420011_ODS");
		КонецЕсли;
		
		Если ВерсияКлюча < "5_2" И ВерсияНовогоКлюча >= "5_2" Тогда
			Ключ = СтрЗаменить(Ключ, "0420011_ODS_UK", "0420011_ODS_NFO");
		ИначеЕсли ВерсияНовогоКлюча < "5_2" И ВерсияКлюча >= "5_2" Тогда
			Ключ = СтрЗаменить(Ключ, "0420011_ODS_NFO", "0420011_ODS_UK");
		КонецЕсли;
		
		Если ВерсияКлюча < "5_2" И ВерсияНовогоКлюча >= "5_2" Тогда
			СоответствиеКлючей.Вставить("Kod_Inye_Vid_DeyatEnumerator", "Kod_Inye_Vid_DeyatEnumerator2");
			СоответствиеКлючей.Вставить("SR_0420011_ODS_UK_SVED_OTCHETNOST_Item.PolnoeNaimenovanieOtchityvayushhejsyaOrganizaczii", "PolnNaim_SokrNaim_Org");
		ИначеЕсли ВерсияНовогоКлюча < "5_2" И ВерсияКлюча >= "5_2" Тогда
			СоответствиеКлючей.Вставить("Kod_Inye_Vid_DeyatEnumerator2", "Kod_Inye_Vid_DeyatEnumerator");
			СоответствиеКлючей.Вставить("SR_0420011_ODS_NFO_SVED_OTCHETNOST_Item.PolnNaim_SokrNaim_Org", "PolnoeNaimenovanieOtchityvayushhejsyaOrganizaczii");
		КонецЕсли;
		
		ДобавитьСоответствиеКлючей("Kod_Vid_Operaczii_DenSredstvaAxis", "Kod_Vid_Operaczii_DenSredstvaTaxis", "6_1", СоответствиеКлючей, ВерсияКлюча, ВерсияНовогоКлюча);
		
	ИначеЕсли Отчет.ВариантОтчета = "ОКУД0420401" Тогда
		Если ВерсияКлюча < "4_2" И ВерсияНовогоКлюча >= "4_2" Тогда
			
			Если Ключ = "SR_0420401" ИЛИ Ключ = "SR_0420401_Item" Тогда
				Ключ = СтрЗаменить(Ключ, "SR_0420401", "SR_0420401_R1");
			Иначе	
				Ключ = СтрЗаменить(Ключ, "SR_0420401_", "SR_0420401_R");
			КонецЕсли;

		ИначеЕсли ВерсияНовогоКлюча < "4_2" И ВерсияКлюча >= "4_2" Тогда
			
			Если Ключ = "SR_0420401_R1" ИЛИ Ключ = "SR_0420401_R1_Item" Тогда
				Ключ = СтрЗаменить(Ключ, "SR_0420401_R1", "SR_0420401");
			Иначе	
				Ключ = СтрЗаменить(Ключ, "SR_0420401_R", "SR_0420401_");
			КонецЕсли;
			
