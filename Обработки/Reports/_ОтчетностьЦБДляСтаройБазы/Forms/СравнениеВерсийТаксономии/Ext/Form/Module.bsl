&НаКлиенте
Процедура ПоискОтчетовВСхемахXSD(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если НЕ Диалог.Выбрать() Тогда 
		Возврат;
	КонецЕсли;

	//Отчет.КаталогXBRL = Диалог.Каталог;

	РазделыОтчетов = ПолучитьРазделыОтчетов();
	
	МассивСхем = Новый Массив;
	
	КаталогСхем = Диалог.Каталог;
	
	Каталог = Новый Файл(КаталогСхем);
	Если Каталог.Существует() Тогда
		Для Каждого НайденныйФайл Из НайтиФайлы(КаталогСхем, "*.xsd") Цикл
			МассивСхем.Добавить(НайденныйФайл.Имя);
		КонецЦикла;	
	КонецЕсли;
	
	ОписанияТочекВхода = Новый Соответствие;
	ИспользованиеТочекВхода = Новый Соответствие;
	
	Для Каждого ИмяСхемы Из МассивСхем Цикл
		ИспользованиеТочекВхода.Вставить(ИмяСхемы, Ложь);
		
		Файл = Новый Файл(КаталогСхем + "\" + ИмяСхемы);
		Если Файл.Существует() Тогда
			МассивТипов = Новый Массив;
			
			ФайлыXSD = Новый Массив;
			ФайлыXSD.Добавить(КаталогСхем + "\" + ИмяСхемы);
			
			НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
			ТипОбъектаXDTO = НоваяФабрикаXDTO.Тип("XBRL", "type_XBRL_Entry_Point");
			
			Если ТипОбъектаXDTO <> Неопределено Тогда
				Для Каждого Свойство Из ТипОбъектаXDTO.Свойства Цикл
					Если Свойство.Имя = "Name" Тогда
						ОписанияТочекВхода.Вставить(ИмяСхемы, Свойство.ЗначениеПоУмолчанию.Значение);
					Иначе
						МассивТипов.Добавить(НРег(Свойство.Имя));
					КонецЕсли;
					//СписокТипов.Добавить(Свойство.Тип.Имя, Свойство.Имя);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
		Для Каждого ОтчетXBRL Из РазделыОтчетов Цикл
			Для Каждого РазделОтчета Из ОтчетXBRL.Значение.Разделы Цикл 
				Если МассивТипов.Найти(НРег(РазделОтчета)) <> Неопределено Тогда
					Если ОтчетXBRL.Значение.Схемы.Найти(ИмяСхемы) = Неопределено Тогда
						ОтчетXBRL.Значение.Схемы.Добавить(ИмяСхемы);
						ИспользованиеТочекВхода.Вставить(ИмяСхемы, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если ОтчетXBRL.Значение.Схемы.Найти(ИмяСхемы) = Неопределено Тогда
				ИмяОтчета = СтрЗаменить(ОтчетXBRL.Ключ, "ОКУД", "");
				Для Каждого ТипXBRL Из МассивТипов Цикл
					Если СтрЧислоВхождений(ТипXBRL, ИмяОтчета) > 0 Тогда
						ОтчетXBRL.Значение.Схемы.Добавить(ИмяСхемы);
						ИспользованиеТочекВхода.Вставить(ИмяСхемы, Истина);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаполнитьРезультатПоискаОтчетовВСхемахXSD(РазделыОтчетов, ОписанияТочекВхода, ИспользованиеТочекВхода);
	
	Для Каждого ТочкаВхода Из ИспользованиеТочекВхода Цикл
		Если ТочкаВхода.Значение = Ложь И Лев(ТочкаВхода.Ключ, 1) <> "_"  Тогда
			ПереместитьФайл(КаталогСхем + "\" + ТочкаВхода.Ключ, КаталогСхем + "\_" + ТочкаВхода.Ключ);
			
		ИначеЕсли ТочкаВхода.Значение = Истина И Лев(ТочкаВхода.Ключ, 1) = "_"  Тогда
			ПереместитьФайл(КаталогСхем + "\" + ТочкаВхода.Ключ, КаталогСхем + "\" + Сред(ТочкаВхода.Ключ, 2));
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРазделыОтчетов() 
	
	ТочкиВхода	= ПолучитьТаблицуИзМакета("ТочкиВхода");
	РазделыXBRL = ПолучитьТаблицуИзМакета("РазделыXBRL");
	
	РазделыОтчетов = Новый Структура;
	
	Для Каждого СтрокаТочкиВхода Из ТочкиВхода Цикл
		Если НЕ РазделыОтчетов.Свойство(СтрокаТочкиВхода.ИмяПакета) Тогда
			СоставОтчета = Новый Структура("Разделы,Схемы", РазделыXBRL.Скопировать(Новый Структура("ИмяПакета", СтрокаТочкиВхода.ИмяПакета), "ИмяРаздела").ВыгрузитьКолонку("ИмяРаздела"), Новый Массив);
			РазделыОтчетов.Вставить(СтрокаТочкиВхода.ИмяПакета, СоставОтчета); 
		КонецЕсли;
	КонецЦикла;

	Возврат РазделыОтчетов;
	
КонецФункции

Функция ПолучитьТаблицуИзМакета(ИмяМакета, Отказ = Ложь, ПараметрыПоиска = Неопределено)
	
	Таблица = Новый ТаблицаЗначений;
	РеквизитОтчёт	= РеквизитФормыВЗначение("Отчет");
	Макет			= РеквизитОтчёт.ПолучитьМакет(ИмяМакета);
	МалоеПредприятие = Неопределено;
	
	КолонкиМакета = Новый Соответствие;
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ПараметрыКолонки = СтрРазделить(СокрЛП(Макет.Область(1, НомерКолонки, 1, НомерКолонки).Текст), "()", Ложь);
		
		КолонкиМакета.Вставить(ПараметрыКолонки[0], НомерКолонки);
		Если ПараметрыКолонки.Количество() = 1 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов("Строка"));
		ИначеЕсли ПараметрыКолонки.Количество() = 2 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1]));
		ИначеЕсли ПараметрыКолонки.Количество() = 3 И ПараметрыКолонки[1] = "Строка" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1], Новый КвалификаторыСтроки(ПараметрыКолонки[2])));	
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КолонкаМакета Из КолонкиМакета Цикл
			Значение = СокрЛП(Макет.Область(НомерСтроки, КолонкаМакета.Значение, НомерСтроки, КолонкаМакета.Значение).Текст);
			
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ])) Тогда
				НоваяСтрока[КолонкаМакета.Ключ]	= ОбщегоНазначения.МенеджерОбъектаПоСсылке(НоваяСтрока[КолонкаМакета.Ключ]).ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
			Иначе
				НоваяСтрока[КолонкаМакета.Ключ]	= Значение;
			КонецЕсли;
				
			Если ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Строка") И НоваяСтрока[КолонкаМакета.Ключ] <> Значение Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неверно указана ширина колонки %1 в макете %2, не поместилось значение %3, обратитесь к программисту.", КолонкаМакета.Ключ, ИмяМакета, Значение),,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Если ТипЗнч(ПараметрыПоиска) = Тип("Структура") Тогда
		Возврат Таблица.Скопировать(ПараметрыПоиска);
	Иначе
		Возврат Таблица;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьРезультатПоискаОтчетовВСхемахXSD(РазделыОтчетов, ОписанияТочекВхода, ИспользованиеТочекВхода)
	
	Результат.Очистить();
	
	РезультатПоискаОтчетовВСхемахXSD = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("РезультатПоискаОтчетовВСхемахXSD");
	
	ОбластьШапка	= РезультатПоискаОтчетовВСхемахXSD.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= РезультатПоискаОтчетовВСхемахXSD.ПолучитьОбласть("Строка");
	
	Результат.Вывести(ОбластьШапка);
	
	Для Каждого ОтчетXBRL Из РазделыОтчетов Цикл
		ОбластьСтрока.Параметры.ИмяПакета		= ОтчетXBRL.Ключ;
		ОбластьСтрока.Параметры.ИмяСхемы		= "";
		ОбластьСтрока.Параметры.ОписаниеСхемы	= "";
		
		Если ОтчетXBRL.Значение.Схемы.Количество() Тогда
			Для Каждого ИмяСхемы Из ОтчетXBRL.Значение.Схемы Цикл
				ОбластьСтрока.Параметры.ИмяСхемы		= СтрЗаменить(ИмяСхемы, ".xsd", "");
				ОбластьСтрока.Параметры.ОписаниеСхемы	= ОписанияТочекВхода.Получить(ИмяСхемы);
				Результат.Вывести(ОбластьСтрока);
			КонецЦикла;
		Иначе
			Результат.Вывести(ОбластьСтрока);
		КонецЕсли;
	КонецЦикла;
	
	ОбластьСтрока	= РезультатПоискаОтчетовВСхемахXSD.ПолучитьОбласть("Строка");
	Для Каждого ТочкаВхода Из ИспользованиеТочекВхода Цикл
		Если ТочкаВхода.Значение = Ложь Тогда
			ОбластьСтрока.Параметры.ИмяСхемы = СтрЗаменить(ТочкаВхода.Ключ, ".xsd", "");
			Результат.Вывести(ОбластьСтрока);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

