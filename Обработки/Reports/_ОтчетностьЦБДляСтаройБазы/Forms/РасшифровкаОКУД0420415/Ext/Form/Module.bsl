
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	
КонецПроцедуры

&НаСервере
Процедура КомандаСформироватьНаСервере(ДанныеЦБ)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	ОтчетОбъект.ПолучитьДанные_XBRL_ОКУД0420415_Расшифровка(Результат, Периоды, ДепозитарныеКомпании, ЦенныеБумаги, ДанныеЦБ);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформировать(Команда)
	
	Отказ = Ложь;
	
	Если ЭтаФорма.СверятьСФайломЦБ Тогда
		ДанныеЦБ = ЗагрузитьСписокЦенныхБумагИзФайла(Отказ);
	Иначе
		ДанныеЦБ = Новый Массив;
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	КомандаСформироватьНаСервере(ДанныеЦБ);
	
КонецПроцедуры

&НаКлиенте
Функция ЗагрузитьСписокЦенныхБумагИзФайла(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан путь к файлу ЦБ",,,, Отказ);
		Возврат Новый Массив;
	КонецЕсли;
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ПутьКФайлу);
		Excel.Sheets(1).Select();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат Новый Массив;
	КонецПопытки;
	
	ВсегоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count;
	//ВсегоКолонок = Excel.ActiveSheet.UsedRange.Columns.Count;
	
	МассивДанныхExcel = Excel.ActiveSheet.Range(Excel.Cells(3,1), Excel.ActiveSheet.Cells(ВсегоСтрок, 12)).Value.Выгрузить(); 
	
	Excel.ActiveWorkbook.Close();

	//контроль файла
	
	Если МассивДанныхExcel[3][0] <> "Государственный регистрационный номер выпуска ценных бумаг или идентификационный номер выпуска ценных бумаг" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле '" + ПутьКФайлу + "' не найдена колонка 'Государственный регистрационный номер...'!",,,, Отказ);
		Возврат Новый Массив;
	КонецЕсли;
	
	Если МассивДанныхExcel[4][0] <> "Код ISIN ценной бумаги" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файле '" + ПутьКФайлу + "' не найдена колонка 'Код ISIN ценной бумаги'!",,,, Отказ);
		Возврат Новый Массив;
	КонецЕсли;
	
	ДанныеЦБ = Новый Массив;
	
	КоличествоЗаписей = МассивДанныхExcel[0].Количество();
	Для Индекс = 2 По КоличествоЗаписей - 1 Цикл
		
		СтрокаЦБ = Новый Структура;
		СтрокаЦБ.Вставить("НаименованиеЭмитента"				, МассивДанныхExcel[1][Индекс]); 
		СтрокаЦБ.Вставить("ИННЭмитента"							, МассивДанныхExcel[2][Индекс]); 
		СтрокаЦБ.Вставить("ГосударственныйРегистрационныйНомер"	, МассивДанныхExcel[3][Индекс]); 
		СтрокаЦБ.Вставить("ISIN"								, МассивДанныхExcel[4][Индекс]); 
		СтрокаЦБ.Вставить("ТипЦеннойБумаги"						, МассивДанныхExcel[5][Индекс]); 
		СтрокаЦБ.Вставить("НомерСчетаДепо"						, МассивДанныхExcel[6][Индекс]); 
		СтрокаЦБ.Вставить("ВидСчетаДепо"						, МассивДанныхExcel[7][Индекс]); 
		СтрокаЦБ.Вставить("Количество"							, МассивДанныхExcel[8][Индекс]);
		СтрокаЦБ.Вставить("НаименованиеДепозитария"				, МассивДанныхExcel[9][Индекс]);
		СтрокаЦБ.Вставить("ИННДепозитария"						, МассивДанныхExcel[10][Индекс]);
		СтрокаЦБ.Вставить("Период"								, МассивДанныхExcel[11][Индекс]);
		
		ДанныеЦБ.Добавить(СтрокаЦБ);
		
	КонецЦикла;
	
	Возврат ДанныеЦБ;
	
КонецФункции

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЧастиФайла = СтрРазделить(ПутьКФайлу, "\");
	ЧастиФайла.Удалить(ЧастиФайла.Количество() - 1);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие); 
	Диалог.Фильтр				= "Таблицы EXCEL (*.xlsx)|*.xlsx";
	Диалог.Каталог            	= СтрСоединить(ЧастиФайла, "\"); 
	Диалог.МножественныйВыбор 	= Ложь; 
	Диалог.Заголовок          	= "Файл со списком ценных бумаг"; 
	
	Если Диалог.Выбрать() Тогда 
		ПутьКФайлу = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(ПутьКФайлу + "\");

КонецПроцедуры

&НаКлиенте
Процедура ВидимостьРеквизитов()

	Элементы.ЦенныеБумаги.Видимость = НЕ ЭтаФорма.СверятьСФайломЦБ;
	Элементы.ПутьКФайлу.Видимость = ЭтаФорма.СверятьСФайломЦБ;
	
КонецПроцедуры	

&НаКлиенте
Процедура СверятьСФаломЦБПриИзменении(Элемент)
	
	ВидимостьРеквизитов();
	
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидимостьРеквизитов();	
	
КонецПроцедуры

