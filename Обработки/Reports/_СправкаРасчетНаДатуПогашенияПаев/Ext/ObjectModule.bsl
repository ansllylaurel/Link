#Область Интерфейс_внешней_обработки

Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Справка-расчет на дату погашения паев",
		"0",
		"",
		Истина
	);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
КонецФункции

#КонецОбласти


Процедура Сформировать(ДокументРезультат) Экспорт
	
	ДокументРезультат.Очистить();
	
	Макет = ПолучитьМакет("СправкаРасчет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьПайщик = Макет.ПолучитьОбласть("Пайщик");
	ОбластьПогашение = Макет.ПолучитьОбласть("Погашение");
	ОбластьНалог = Макет.ПолучитьОбласть("Налог");
	
	ОбластьШапкаПартии = Макет.ПолучитьОбласть("ШапкаПартии");
	ОбластьПартии = Макет.ПолучитьОбласть("Партии"); 
	ОбластьСрокВладения = Макет.ПолучитьОбласть("СрокВладения"); 
	ОбластьПартииИтого = Макет.ПолучитьОбласть("ПартииИтого"); 
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// 1 отберем погашения
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК ПогашениеПаев,
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ _ПогашенияПаев
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Активность
		|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.ПогашениеПаев)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетНДФЛПайщиковНалоговаяБаза.Ссылка КАК РасчетНДФЛ,
		|	_ПогашенияПаев.ПогашениеПаев КАК ПогашениеПаев
		|ИЗ
		|	_ПогашенияПаев КАК _ПогашенияПаев
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчетНДФЛПайщиков.НалоговаяБаза КАК РасчетНДФЛПайщиковНалоговаяБаза
		|		ПО _ПогашенияПаев.ПогашениеПаев = РасчетНДФЛПайщиковНалоговаяБаза.Основание
		|ГДЕ
		|	РасчетНДФЛПайщиковНалоговаяБаза.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период); 
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	// 2 Расчет ИнвестВычета
	СписокПогашений = РезультатЗапроса.ВыгрузитьКолонку("ПогашениеПаев");
	РаботаСНалогамиКлиентСервер.ПолучитьДанныеДляРасчетаИнвестВычета(СписокПогашений, МенеджерВременныхТаблиц); 
	
	//3 Данные отчета      
	
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;   
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗадолженностиПоДенежнымСредствам.Контрагент КАК Пайщик,
	|	СУММА(ЗадолженностиПоДенежнымСредствам.Сумма) КАК Сумма
	|ПОМЕСТИТЬ _ПогашенияСНачалаГода
	|ИЗ
	|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
	|ГДЕ
	|	ЗадолженностиПоДенежнымСредствам.Активность
	|	И ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ГОД) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
	|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
	|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
	|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.ПогашениеПаев)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗадолженностиПоДенежнымСредствам.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Партии.Пайщик КАК Пайщик,
	|	_Партии.Погашение КАК Погашение,
	|	ЕСТЬNULL(_Партии.Заявка.НомерЗаявки, ""-"") КАК НомерЗаявки,
	|	ЕСТЬNULL(_Партии.Заявка.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗаявки,
	|	_Партии.ПИФ КАК ПИФ,
	|	_Партии.СтоимостьПаяИзСЧА КАК СтоимостьПаяИзСЧА,
	|	СУММА(_Партии.КоличествоПаев) КАК КоличествоПаев,
	|	СУММА(_Партии.СтоимостьПокупки) КАК СтоимостьПокупки,
	|	СУММА(_Партии.СуммаПогашения) КАК СуммаПогашения,
	|	СУММА(_Партии.СуммаСкидки) КАК СуммаСкидки
	|ПОМЕСТИТЬ _ПартииСвернуто
	|ИЗ
	|	_Партии КАК _Партии
	|
	|СГРУППИРОВАТЬ ПО
	|	_Партии.Пайщик,
	|	_Партии.Погашение,
	|	ЕСТЬNULL(_Партии.Заявка.НомерЗаявки, ""-""),
	|	ЕСТЬNULL(_Партии.Заявка.Дата, ДАТАВРЕМЯ(1, 1, 1)),
	|	_Партии.ПИФ,
	|	_Партии.СтоимостьПаяИзСЧА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	_ПартииСвернуто.Пайщик КАК Пайщик,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК ФИО,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.РезидентРФ КАК РезидентРФ,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности КАК ВидУдостоверенияЛичности,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаВыдачиУдостоверенияЛичности КАК ДатаВыдачиУдостоверенияЛичности,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ОрганВыдавшийУдостоверениеЛичности КАК ОрганВыдавшийУдостоверениеЛичности,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.КодОрганаВыдавшегоУдостоверениеЛичности КАК КодОрганаВыдавшегоУдостоверениеЛичности,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Гражданство КАК Гражданство,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.АдресРегистрации КАК АдресРегистрации,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаРождения КАК ДатаРождения,
	|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
	|	_ПартииСвернуто.ПИФ КАК ПИФ,
	|	_ПартииСвернуто.НомерЗаявки КАК НомерЗаявки,
	|	_ПартииСвернуто.ДатаЗаявки КАК ДатаЗаявки,
	|	_ПартииСвернуто.Погашение КАК Погашение
	|ПОМЕСТИТЬ _ИнформацияОПайщиках
	|ИЗ
	|	_ПартииСвернуто КАК _ПартииСвернуто
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
	|		ПО _ПартииСвернуто.Пайщик = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	_ПартииСвернуто.Пайщик КАК Пайщик,
	|	_ПартииСвернуто.Погашение КАК Погашение,
	|	_ПартииСвернуто.НомерЗаявки КАК НомерЗаявки,
	|	_ПартииСвернуто.ДатаЗаявки КАК ДатаЗаявки,
	|	_ПартииСвернуто.СтоимостьПокупки / _ПартииСвернуто.КоличествоПаев КАК Цена,
	|	_ПартииСвернуто.КоличествоПаев КАК КоличествоПаев,
	|	_ПартииСвернуто.СтоимостьПокупки КАК СтоимостьПокупки,
	|	_ПартииСвернуто.СуммаПогашения КАК СуммаПогашения,
	|	_ПартииСвернуто.СуммаСкидки КАК СуммаСкидки,
	|	_ПартииСвернуто.СтоимостьПаяИзСЧА КАК СтоимостьПаяИзСЧА,
	|	ЕСТЬNULL(ДанныеОВыводе.ДатаПолученияДохода, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПолученияДохода,
	|	_ПогашенияСНачалаГода.Сумма КАК СуммаПогашенияСНачалаГода
	|ПОМЕСТИТЬ _ИнформацияОПогашении
	|ИЗ
	|	_ПартииСвернуто КАК _ПартииСвернуто
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ПогашенияСНачалаГода КАК _ПогашенияСНачалаГода
	|		ПО (_ПогашенияСНачалаГода.Пайщик = _ПартииСвернуто.Пайщик)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			МИНИМУМ(ЗадолженностиПоДенежнымСредствам.Период) КАК ДатаПолученияДохода,
	|			ЗадолженностиПоДенежнымСредствам.Основание КАК Погашение
	|		ИЗ
	|			РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
	|		ГДЕ
	|			ЗадолженностиПоДенежнымСредствам.Основание В(&СписокПогашений)
	|			И ЗадолженностиПоДенежнымСредствам.Активность
	|			И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
	|			И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПередПайщиками)
	|			И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			И ТИПЗНАЧЕНИЯ(ЗадолженностиПоДенежнымСредствам.Регистратор) = ТИП(Документ.ВыводДенежныхСредств)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗадолженностиПоДенежнымСредствам.Основание) КАК ДанныеОВыводе
	|		ПО _ПартииСвернуто.Погашение = ДанныеОВыводе.Погашение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА РасчетНДФЛПайщиковНалоговаяБаза.ВидДохода = ЗНАЧЕНИЕ(Справочник.ВидыДоходовНДФЛ.Код1530)
	|			ТОГДА РасчетНДФЛПайщиковНалоговаяБаза.СуммаДохода
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Доход1530,
	|	ВЫБОР
	|		КОГДА РасчетНДФЛПайщиковНалоговаяБаза.ВидДохода = ЗНАЧЕНИЕ(Справочник.ВидыДоходовНДФЛ.Код1531)
	|			ТОГДА РасчетНДФЛПайщиковНалоговаяБаза.СуммаДохода
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Доход1531,
	|	ВЫБОР
	|		КОГДА РасчетНДФЛПайщиковНалоговаяБаза.ВидВычета = ЗНАЧЕНИЕ(Справочник.ВидыВычетовНДФЛ.Код201)
	|			ТОГДА РасчетНДФЛПайщиковНалоговаяБаза.СуммаВычета
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Вычет201,
	|	ВЫБОР
	|		КОГДА РасчетНДФЛПайщиковНалоговаяБаза.ВидВычета = ЗНАЧЕНИЕ(Справочник.ВидыВычетовНДФЛ.Код202)
	|			ТОГДА РасчетНДФЛПайщиковНалоговаяБаза.СуммаВычета
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Вычет202,
	|	ВЫБОР
	|		КОГДА РасчетНДФЛПайщиковНалоговаяБаза.ВидИнвестиционногоВычета = ЗНАЧЕНИЕ(Справочник.ВидыВычетовНДФЛ.Код618)
	|				И РасчетНДФЛПайщиковНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению
	|			ТОГДА РасчетНДФЛПайщиковНалоговаяБаза.СуммаИнвестВычета
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Вычет618,
	|	РасчетНДФЛПайщиковНалоговаяБаза.Ссылка КАК Ссылка,
	|	РасчетНДФЛПайщиковНалоговаяБаза.НомерСтроки КАК НомерСтроки,
	|	РасчетНДФЛПайщиковНалоговаяБаза.Пайщик КАК Пайщик,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
	|	РасчетНДФЛПайщиковНалоговаяБаза.Основание КАК Основание,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ВидНалогооблагаемойБазы КАК ВидНалогооблагаемойБазы,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ВидДохода КАК ВидДохода,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ВидВычета КАК ВидВычета,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаДохода КАК СуммаДохода,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаВычета КАК СуммаВычета,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СтавкаНДФЛ КАК СтавкаНДФЛ,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаНалога КАК СуммаНалога,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ДоходСНачалаГода КАК ДоходСНачалаГода,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ВычетСНачалаГода КАК ВычетСНачалаГода,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ВидИнвестиционногоВычета КАК ВидИнвестиционногоВычета,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаИнвестВычета КАК СуммаИнвестВычета,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СтавкаНДФЛПовышенная КАК СтавкаНДФЛПовышенная,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СуммаНалогаСПревышения КАК СуммаНалогаСПревышения,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ИнвестВычетСНачалаГода КАК ИнвестВычетСНачалаГода,
	|	РасчетНДФЛПайщиковНалоговаяБаза.ПрименятьИнвестВычетПоЗаявлению КАК ПрименятьИнвестВычетПоЗаявлению,
	|	РасчетНДФЛПайщиковНалоговаяБаза.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	РасчетНДФЛПайщиковНалоговаяБаза.КоэффициентВладенияЦБ КАК КоэффициентВладенияЦБ,
	|	РасчетНДФЛПайщиковНалоговаяБаза.РучноеРедактирование КАК РучноеРедактирование,
	|	_ИнвестиционныйВычет.Погашение КАК Погашение,
	|	_ИнвестиционныйВычет.Vi КАК Vi,
	|	_ИнвестиционныйВычет.Vi_x_i КАК Vi_x_i,
	|	_ИнвестиционныйВычет.Кцб КАК Кцб,
	|	_ИнвестиционныйВычет.МаксимальныйВычет КАК Предел
	|ПОМЕСТИТЬ _НалоговаяБаза
	|ИЗ
	|	Документ.РасчетНДФЛПайщиков.НалоговаяБаза КАК РасчетНДФЛПайщиковНалоговаяБаза
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ИнвестиционныйВычет КАК _ИнвестиционныйВычет
	|		ПО РасчетНДФЛПайщиковНалоговаяБаза.Основание = _ИнвестиционныйВычет.Погашение
	|ГДЕ
	|	РасчетНДФЛПайщиковНалоговаяБаза.Ссылка В(&СписокРасчетов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	_Партии.Пайщик КАК Пайщик,
	|	_Партии.Погашение КАК Погашение,
	|	_Партии.ЗачислениеПаев КАК ЗачислениеПаев,
	|	_Партии.ДатаПокупки КАК ДатаПокупки,
	|	_Партии.НомерЗаявки КАК НомерЗаявки,
	|	_Партии.ДатаЗаявки КАК ДатаЗаявки,
	|	_Партии.КоличествоПаев КАК КоличествоПаев,
	|	_Партии.СтоимостьПокупки КАК СтоимостьПокупки,
	|	_Партии.СуммаНадбавки КАК СуммаНадбавки,
	|	_Партии.Цена КАК Цена,
	|	_Партии.СуммаПогашения КАК СуммаПогашения,
	|	_Партии.СрокВладения КАК СрокВладения,
	|	_Партии.СрокВладенияГод КАК СрокВладенияГод,
	|	_Партии.ПроцентСкидки КАК ПроцентСкидки,
	|	_Партии.СуммаСкидки КАК СуммаСкидки,
	|	_Партии.ПИФ КАК ПИФ,
	|	_Партии.Заявка КАК Заявка,
	|	_Партии.Прибыль КАК Прибыль,
	|	_Партии.Vi КАК Vi,
	|	_Партии.Vi_x_i КАК Vi_x_i
	|ИЗ
	|	_Партии КАК _Партии
	|ИТОГИ
	|	СУММА(СтоимостьПокупки),
	|	СУММА(СуммаНадбавки),
	|	СУММА(СуммаПогашения),
	|	СУММА(СуммаСкидки),
	|	СУММА(Прибыль),
	|	СУММА(Vi),
	|	СУММА(Vi_x_i)
	|ПО
	|	Погашение,
	|	СрокВладенияГод";     
	
	Запрос.УстановитьПараметр("СписокРасчетов", РезультатЗапроса.ВыгрузитьКолонку("РасчетНДФЛ"));   
	Запрос.УстановитьПараметр("СписокПогашений", СписокПогашений);

	
	
	
	//	ВыборкаПогашщение = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);  
	ВыборкаПогашение = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);  
	
	ИнфаОПайщиках = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ИнформацияОПайщиках").ПолучитьДанные().Выбрать(); 
	ИнфаОПогашении = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ИнформацияОПогашении").ПолучитьДанные().Выбрать();
	ИнфаНалог = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_НалоговаяБаза").ПолучитьДанные().Выбрать();
	
	
	ОбластьШапка.Параметры.ДатаПогашения = Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"); 
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Пока ВыборкаПогашение.Следующий() Цикл 
		Погашение = ВыборкаПогашение.Погашение; 
		
		ИнфаОПайщиках.Сбросить();
		Если ИнфаОПайщиках.НайтиСледующий(Погашение, "Погашение") Тогда 
			
			ЗаполнитьЗначенияСвойств(ОбластьПайщик.Параметры, ИнфаОПайщиках); 
			ОбластьПайщик.Параметры.Заявка = ИнфаОПайщиках.НомерЗаявки + " от " + Формат(ИнфаОПайщиках.ДатаЗаявки, "ДФ=dd.MM.yyyy"); 
			ОбластьПайщик.Параметры.ПаспортныеДанные  = Строка(ИнфаОПайщиках.ВидУдостоверенияЛичности) +
			" Серия " + ИнфаОПайщиках.СерияУдостоверенияЛичности +
			" № " + ИнфаОПайщиках.НомерУдостоверенияЛичности +
			" Выдан " + Формат(ИнфаОПайщиках.ДатаВыдачиУдостоверенияЛичности, "ДФ=dd.MM.yyyy") +
			" " + ИнфаОПайщиках.ОрганВыдавшийУдостоверениеЛичности +
			" Код подразделения " + ИнфаОПайщиках.КодОрганаВыдавшегоУдостоверениеЛичности;
			
			ДокументРезультат.Вывести(ОбластьПайщик);
			
		КонецЕсли;
		
		ИнфаОПогашении.Сбросить();
		Если ИнфаОПогашении.НайтиСледующий(Погашение, "Погашение") Тогда
			ЗаполнитьЗначенияСвойств(ОбластьПогашение.Параметры, ИнфаОПогашении);
			ДокументРезультат.Вывести(ОбластьПогашение);
		КонецЕсли;
		
		ДокументРезультат.Вывести(ОбластьШапкаПартии);
		
		ВыборкаГодВладения = ВыборкаПогашение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаГодВладения.Следующий() Цикл  
			
			ЗаполнитьЗначенияСвойств(ОбластьСрокВладения.Параметры, ВыборкаГодВладения);
			ДокументРезультат.Вывести(ОбластьСрокВладения);
			
			ВыборкаПартии = ВыборкаГодВладения.Выбрать(ОбходРезультатаЗапроса.Прямой);
			Пока ВыборкаПартии.Следующий() Цикл; 
				ЗаполнитьЗначенияСвойств(ОбластьПартии.Параметры, ВыборкаПартии);
				ДокументРезультат.Вывести(ОбластьПартии);
			КонецЦикла;
		КонецЦикла;  
		
		ЗаполнитьЗначенияСвойств(ОбластьПартииИтого.Параметры, ВыборкаПогашение);
		ДокументРезультат.Вывести(ОбластьПартииИтого);
		
		ИнфаНалог.Сбросить();
		Если ИнфаНалог.НайтиСледующий(Погашение, "Основание") Тогда
			ЗаполнитьЗначенияСвойств(ОбластьНалог.Параметры, ИнфаНалог);
			ОбластьНалог.Параметры.НБСНачалаГода = ИнфаНалог.ДоходСНачалаГода - ИнфаНалог.ВычетСНачалаГода - ИнфаНалог.ИнвестВычетСНачалаГода;  
			ОбластьНалог.Параметры.НБ1530 = ИнфаНалог.Доход1530 - ИнфаНалог.Вычет201 - ИнфаНалог.Вычет618;
			ОбластьНалог.Параметры.НБ1531 = ИнфаНалог.Доход1531 - ИнфаНалог.Вычет202;
			ДокументРезультат.Вывести(ОбластьНалог);
		КонецЕсли;
		
	КонецЦикла;  
		
КонецПроцедуры