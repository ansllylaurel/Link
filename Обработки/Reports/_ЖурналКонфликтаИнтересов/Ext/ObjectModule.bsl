
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Журнал конфликта интересов",
		"0.30",
		"",
		Истина);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольСделокЗаВчерашнийДень", "Контроль сделок за вчерашний день",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Если ИдентификаторКоманды = "КонтрольСделокЗаВчерашнийДень" Тогда
		КонтрольСделокЗаВчерашнийДень(ПараметрыКоманды);
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольСделокЗаВчерашнийДень(ПараметрыКоманды) Экспорт

	КалендарьКотировок = Константы.ОсновнойКалендарьКотировок.Получить();
	ТекущаяДата = ТекущаяДата();
	
	Если Не Справочники.Календари.ЭтоРабочийДень(КалендарьКотировок, ТекущаяДата) Тогда
		Возврат;
	КонецЕсли;
		
	ПредыдущийТорговыйДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(КалендарьКотировок, ТекущаяДата - 60 * 60 * 24);
	ЭтотОбъект.Период.ДатаНачала = ПредыдущийТорговыйДень;
	ЭтотОбъект.Период.ДатаОкончания = КонецДня(ПредыдущийТорговыйДень);
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	ЭтотОбъект.ВыводитьДепозиты = Истина;
	ЭтотОбъект.ВыводитьРазделыПоАффилированнымЛицам = Истина;
	ЭтотОбъект.ВыводитьСделкиРЕПО = Истина;
	ЭтотОбъект.ВыводитьДанныеПредоставляемыеЮрФизЛицами = Истина;
	ЭтотОбъект.ВыводитьРазделыПоСотрудникам = Истина;
	
	ВидыДоговоров = Новый Массив;
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	
	ЭтотОбъект.ТаблицаКлиентов.Загрузить(ПолучитьТаблицуКлиентов(ВидыДоговоров));
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо, ВалютаУчета");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицоУК", РеквизитыОрганизации.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ВалютаУчета", РеквизитыОрганизации.ВалютаУчета);
	Запрос.УстановитьПараметр("ТаблицаКлиентов", ЭтотОбъект.ТаблицаКлиентов);
	Запрос.УстановитьПараметр("ВыводитьСделкиРЕПО", ЭтотОбъект.ВыводитьСделкиРЕПО);
	Запрос.УстановитьПараметр("ВыводитьСделки", Ложь);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоСобственнымСредствам", Истина);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоАффилированнымЛицам", ЭтотОбъект.ВыводитьРазделыПоАффилированнымЛицам);
	Запрос.УстановитьПараметр("ВыводитьДанныеПредоставляемыеЮрФизЛицами", ЭтотОбъект.ВыводитьДанныеПредоставляемыеЮрФизЛицами);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоСотрудникам", ЭтотОбъект.ВыводитьРазделыПоСотрудникам);
	Запрос.УстановитьПараметр("Календарь", КалендарьКотировок);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = "";
	
	ПоместитьСчетаДУВМенеджерВременныхТаблиц(Запрос);
	ПоместитьСделкиВМенеджерВременныхТаблиц(Запрос);
	
	#Область Текст_запроса_пересечения_сделок
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Сделки.Раздел КАК Раздел,
		|	_Сделки.ВидСвязи КАК ВидСвязи,
		|	_Сделки.Дата КАК Дата,
		|	_Сделки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Сделки.Сделка КАК Сделка,
		|	_Сделки.Операция КАК Операция,
		|	_Сделки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Сделки.СрокРЕПО КАК СрокРЕПО,
		|	_Сделки.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_Сделки.ДатаОперации КАК ДатаОперации,
		|	ВЫБОР
		|		КОГДА _Сделки.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА _Сделки.СтавкаРЕПО > _СделкиСобственные.СтавкаРЕПО
		|		ИНАЧЕ _Сделки.СтавкаРЕПО < _СделкиСобственные.СтавкаРЕПО
		|	КОНЕЦ КАК НарушениеПоСтавке,
		|	_Сделки.ДатаОперации > _СделкиСобственные.ДатаОперации КАК НарушениеПоДате,
		|	_СделкиСобственные.Раздел КАК РазделСобственная,
		|	_СделкиСобственные.ВидСвязи КАК ВидСвязиСобственная,
		|	_СделкиСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправленияСобственная,
		|	_СделкиСобственные.Сделка КАК СделкаСобственная,
		|	_СделкиСобственные.ДатаОперации КАК ДатаОперацииСобственная,
		|	_СделкиСобственные.СтавкаРЕПО КАК СтавкаРЕПОСобственная
		|ПОМЕСТИТЬ _ПересеченияСделок
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Сделки КАК _СделкиСобственные
		|		ПО _Сделки.Операция = _СделкиСобственные.Операция
		|			И _Сделки.Рынок = _СделкиСобственные.Рынок
		|			И _Сделки.ЦеннаяБумага = _СделкиСобственные.ЦеннаяБумага
		|			И _Сделки.Дата = _СделкиСобственные.Дата
		|			И _Сделки.СрокРЕПО = _СделкиСобственные.СрокРЕПО
		|			И (ВЫБОР
		|				КОГДА _Сделки.ЭтоРЕПО
		|					ТОГДА _Сделки.Раздел <= 2
		|							И _СделкиСобственные.Раздел > _Сделки.Раздел
		|			КОНЕЦ)";			
	#КонецОбласти 
	
	Запрос.Выполнить();
	
	#Область Вывод_сведений_о_нарушениях_в_сделках_РЕПО
	
	ВидыНарушений = Новый Массив;
	ВидыНарушений.Добавить("НарушениеПоСтавке");
	ВидыНарушений.Добавить("НарушениеПоДате");
	
	Для каждого ВидНарушения Из ВидыНарушений Цикл
	
		ВыборкаСделкаСобстваенная = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
			Запрос, 
			"_ПересеченияСделок",
			,
			,
			ВидНарушения, 
			"РазделСобственная, СчетДоверительногоУправленияСобственная, СделкаСобственная АВТОУПОРЯДОЧИВАНИЕ",
			"СделкаСобственная").Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
		ШаблонСообщения = "По сделке %1 РЕПО со следующими параметрами:
			|%2
			|%3, чем у клиентов:
			|%4"; 
		
		ШаблонПараметровСделки = "	Дата совершения сделки: %1
			|	%2: %3
			|	Ценная бумага: %4
			|	Срок РЕПО: %5
			|	Ставка РЕПО: %6";
			
		Пока ВыборкаСделкаСобстваенная.Следующий() Цикл
			
			Выборка = ВыборкаСделкаСобстваенная.Выбрать();
			
			Если Выборка.Операция = Перечисления.ВидыСделок.Продажа Тогда
				ВидРЕПО = "прямого";
				ОписаниеНарушения = "ставка ниже";
			Иначе
				ВидРЕПО = "обратного";
				ОписаниеНарушения = "ставка выше";
			КонецЕсли;
			
			Если ВидНарушения = "НарушениеПоДате" Тогда
				ОписаниеНарушения = "время совершения сделки ранее"
			КонецЕсли;
			
			ПараметрыСделки = "";
			СписокКлиентов = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				
				Если ПараметрыСделки = "" Тогда
					

						
					ПараметрыСделки = СтрШаблон(ШаблонПараметровСделки,
						Выборка.ДатаОперацииСобственная,
						Выборка.ВидСвязиСобственная,
						Выборка.СчетДоверительногоУправленияСобственная,
						Выборка.ЦеннаяБумага,
						Выборка.СрокРЕПО,
						Выборка.СтавкаРЕПОСобственная); 
				
				КонецЕсли;
					
				СписокКлиентов.Добавить(
					СтрШаблон("		%1 (%2)", 
						Выборка.СчетДоверительногоУправления, 
						?(ВидНарушения = "НарушениеПоСтавке", Выборка.СтавкаРЕПО, Формат(Выборка.ДатаОперации, "ДФ=ЧЧ:мм:сс"))));
				
			КонецЦикла;
			
			ТекстСообщения = СтрШаблон(ШаблонСообщения, 
				ВидРЕПО, 
				ПараметрыСделки, 
				ОписаниеНарушения, 
				СтрСоединить(СписокКлиентов, Символы.ПС));
			
			Результат = Результат + ТекстСообщения + Символы.ПС + Символы.ПС;
			
		КонецЦикла;
	КонецЦикла;		
	#КонецОбласти
	
	УничтожитьВременныеТаблицы(Запрос);
	
	ПоместитьДепозитыВМенеджерВременныхТаблиц(Запрос);
	
	#Область Текст_запроса_пересечения_депозитов
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеВклады.Раздел КАК Раздел,
		|	_ДепозитныеВклады.ВидСвязи КАК ВидСвязи,
		|	_ДепозитныеВклады.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДепозитныеВклады.Банк КАК Банк,
		|	_ДепозитныеВклады.ДатаЗаключенияДоговора КАК ДатаЗаключенияДоговора,
		|	_ДепозитныеВклады.СрокДепозита КАК СрокДепозита,
		|	_ДепозитныеВклады.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	_ДепозитныеВклады.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_ДепозитныеВкладыСобственные.Раздел КАК РазделСобственный,
		|	_ДепозитныеВкладыСобственные.ВидСвязи КАК ВидСвязиСобственный,
		|	_ДепозитныеВкладыСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправленияСобственный,
		|	_ДепозитныеВкладыСобственные.СрокДепозита КАК СрокДепозитаСобственный,
		|	_ДепозитныеВкладыСобственные.ПроцентнаяСтавка КАК ПроцентнаяСтавкаСобственный,
		|	_ДепозитныеВкладыСобственные.ДепозитныйВклад КАК ДепозитныйВкладСобственный,
		|	_ДепозитныеВклады.ДатаПолученияИнформации КАК ДатаПолученияИнформации
		|ИЗ
		|	_ДепозитныеВклады КАК _ДепозитныеВклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитныеВклады КАК _ДепозитныеВкладыСобственные
		|		ПО _ДепозитныеВклады.Банк = _ДепозитныеВкладыСобственные.Банк
		|			И _ДепозитныеВклады.ДатаЗаключенияДоговора = _ДепозитныеВкладыСобственные.ДатаЗаключенияДоговора
		|			И (ТИПЗНАЧЕНИЯ(_ДепозитныеВклады.ДепозитныйВклад) = ТИПЗНАЧЕНИЯ(_ДепозитныеВкладыСобственные.ДепозитныйВклад))
		|			И (_ДепозитныеВклады.Раздел = 1)
		|			И (_ДепозитныеВкладыСобственные.Раздел > 1)
		|ГДЕ
		|	_ДепозитныеВклады.ПроцентнаяСтавка < _ДепозитныеВкладыСобственные.ПроцентнаяСтавка
		|	И ВЫБОР
		|			КОГДА _ДепозитныеВклады.СрокДепозита > _ДепозитныеВкладыСобственные.СрокДепозита
		|				ТОГДА _ДепозитныеВклады.СрокДепозита - _ДепозитныеВкладыСобственные.СрокДепозита < 7
		|			ИНАЧЕ _ДепозитныеВкладыСобственные.СрокДепозита - _ДепозитныеВклады.СрокДепозита < 7
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	РазделСобственный,
		|	СчетДоверительногоУправленияСобственный,
		|	ДепозитныйВкладСобственный
		|ИТОГИ ПО
		|	ДепозитныйВкладСобственный
		|АВТОУПОРЯДОЧИВАНИЕ";		
	#КонецОбласти
	
	РезультатЗапроса = Запрос.Выполнить();
	
	#Область Вывод_сведений_о_нарушениях_в_сделках_МНО_и_депозитах
	ВыборкаСделкаСобстваенная = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ШаблонСообщения = "По %1 со следующими параметрами:
		|%2
		|ставка выше, чем у клиентов:
		|%3";

	ШаблонПараметровСделки = "	Дата совершения сделки: %1
		|	%2: %3
		|	Банк: %4
		|	Срок: %5 дн.
		|	Ставка: %6";
	
	Пока ВыборкаСделкаСобстваенная.Следующий() Цикл
	
		Выборка = ВыборкаСделкаСобстваенная.Выбрать();
		
		ПараметрыСделки = "";
		ТипСделки = "";
		СписокКлиентов = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			
			Если ПараметрыСделки = "" Тогда
				
				ПараметрыСделки = СтрШаблон(ШаблонПараметровСделки,
					Формат(Выборка.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy"),
					Выборка.ВидСвязиСобственный,
					Выборка.СчетДоверительногоУправленияСобственный,
					Выборка.Банк,
					Выборка.СрокДепозитаСобственный,
					Выборка.ПроцентнаяСтавкаСобственный); 
					
				Если ТипЗнч(Выборка.ДепозитныйВклад) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
					ТипСделки = "депозитному вкладу";
				Иначе
					ТипСделки = "сделке МНО";
				КонецЕсли;
			
			КонецЕсли;
				
			СписокКлиентов.Добавить(
				СтрШаблон("		%1 (%2%% на %3 дн.)", 
					Выборка.СчетДоверительногоУправления, 
					Выборка.ПроцентнаяСтавка,
					Выборка.СрокДепозита));
			
		КонецЦикла;
		
		ТекстСообщения = СтрШаблон(ШаблонСообщения, 
			ТипСделки, 
			ПараметрыСделки, 
			СтрСоединить(СписокКлиентов, Символы.ПС));
		
		Результат = Результат + ТекстСообщения + Символы.ПС + Символы.ПС;
	
	КонецЦикла;		
	#КонецОбласти	
	
	Если Не Результат = "" Тогда
	
		РеквизитыОповещения = Новый Структура("Организация, Текст", 
			ПараметрыКоманды.Организация, 
			Результат);
			
		Справочники.Оповещения.СформироватьОповещения(
			"Обработка._ЖурналКонфликтаИнтересов.КонтрольСделокЗаВчерашнийДень", 
			Перечисления.ТипыСобытий.ВнешнийВызов, 
			РеквизитыОповещения);		
	
	КонецЕсли;
		
КонецПроцедуры

Функция СформироватьОтчет() Экспорт
	
	// Зарегистрируем сессию сбора статистики
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,ВыводитьДепозиты,ВыводитьСделкиРЕПО,ВыводитьРазделыПоАффилированнымЛицам,ВыводитьДанныеПредоставляемыеЮрФизЛицами,ВыводитьРазделыПоСотрудникам,ВыводитьСовместноеВладение"); 
	Механизм = "ВнешнийОтчет._ЖурналКонфликтаИнтересов.СформироватьОтчет()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", 								ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 								ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 								ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицоУК", 								ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ВалютаУчета", 								ЭтотОбъект.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ТаблицаКлиентов", 							ЭтотОбъект.ТаблицаКлиентов);
	Запрос.УстановитьПараметр("ВыводитьСделкиРЕПО", 						ЭтотОбъект.ВыводитьСделкиРЕПО);
	Запрос.УстановитьПараметр("ВыводитьСделки", 							Истина);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоСобственнымСредствам", 		Истина);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоАффилированнымЛицам", 		ЭтотОбъект.ВыводитьРазделыПоАффилированнымЛицам);
	Запрос.УстановитьПараметр("ВыводитьДанныеПредоставляемыеЮрФизЛицами",	ЭтотОбъект.ВыводитьДанныеПредоставляемыеЮрФизЛицами);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоСотрудникам",				ЭтотОбъект.ВыводитьРазделыПоСотрудникам);
	Запрос.УстановитьПараметр("Календарь",									Константы.ОсновнойКалендарьКотировок.Получить());
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПоместитьСчетаДУВМенеджерВременныхТаблиц(Запрос);
	
	ОбъектыИСделки 		= Новый ТабличныйДокумент;
	
	МакетОбъектыИСделки = ПолучитьМакет("ОбъектыИСделки");
	ОбластьШапка 						= МакетОбъектыИСделки.ПолучитьОбласть("Шапка");
	ОбластьЗаголовокРаздела 			= МакетОбъектыИСделки.ПолучитьОбласть("ЗаголовокРаздела");
	ОбластьПодзаголовокРаздела 			= МакетОбъектыИСделки.ПолучитьОбласть("ПодзаголовокРаздела");
	ОбластьШапкаОбъектыИнвестирования 	= МакетОбъектыИСделки.ПолучитьОбласть("ШапкаОбъектыИнвестирования");
	ОбластьСтрокаОбъектыИнвестирования 	= МакетОбъектыИСделки.ПолучитьОбласть("СтрокаОбъектыИнвестирования");
	ОбластьШапкаДепозиты 				= МакетОбъектыИСделки.ПолучитьОбласть("ШапкаДепозиты");
	ОбластьСтрокаДепозиты 				= МакетОбъектыИСделки.ПолучитьОбласть("СтрокаДепозиты");
	
	// выводим шапку
	НаименованиеОрганизации = ПолучитьНаименованиеОрганизации(Запрос);
	ПредставлениеПериода = РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания);
	
	ОбластьШапка.Параметры.НаименованиеОрганизации = НаименованиеОрганизации;
	ОбластьШапка.Параметры.ПредставлениеПериода = ПредставлениеПериода;
	ОбъектыИСделки.Вывести(ОбластьШапка);
	
	РынокОблигации = Перечисления.РынкиЦенныхБумаг.Облигации;
	
	// получаем выборку по объектам
	СчетчикРазделов = 1;
	ЗаголовокРаздела = "Перечень объектов инвестирования, приобретённых ";
	СоответствиеРазделов = Новый Соответствие;
	СоответствиеРазделов.Вставить(1, Новый Структура("Раздел, Заголовок", "за счёт средств клиента", 		"Клиент"));
	СоответствиеРазделов.Вставить(2, Новый Структура("Раздел, Заголовок", "за счёт аффилированных лиц", 	"Аффилированное лицо"));
	СоответствиеРазделов.Вставить(3, Новый Структура("Раздел, Заголовок", "за счёт собственного имущества", "Отчитывающаяся организация"));
	СоответствиеРазделов.Вставить(4, Новый Структура("Раздел, Заголовок", "за счёт должностных лиц", 		"Должностное лицо"));
	СоответствиеРазделов.Вставить(5, Новый Структура("Раздел, Заголовок", "за счёт сотрудников", 			"Сотрудник"));
	СоответствиеРазделов.Вставить(6, Новый Структура("Раздел, Заголовок", "за счёт близких родственников должностных лиц", 	"Близкий родственник должностного лица"));
	СоответствиеРазделов.Вставить(7, Новый Структура("Раздел, Заголовок", "за счёт близких родственников сотрудников", 		"Близкий родственник сотрудника"));
	
	#Область Объекты_инвестирования
	ВыборкаРаздел = ПолучитьОбъектыИнвестирования(Запрос);
	Пока ВыборкаРаздел.Следующий() Цикл
		
		ИмяРаздела = Строка(СчетчикРазделов) + ". " + ЗаголовокРаздела + СоответствиеРазделов[ВыборкаРаздел.Раздел].Раздел;
		ОбластьЗаголовокРаздела.Параметры.ИмяРаздела = ИмяРаздела;
		ОбъектыИСделки.Вывести(ОбластьЗаголовокРаздела);
		ОбъектыИСделки.НачатьГруппуСтрок();
		
		ВыборкаТипЗадолженности = ВыборкаРаздел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаТипЗадолженности.Следующий() Цикл
		
			Если ВыборкаТипЗадолженности.ТипЗадолженности <> Неопределено Тогда
				ОбластьПодзаголовокРаздела.Параметры.ИмяПодраздела = ВыборкаТипЗадолженности.ТипЗадолженности;
				ОбъектыИСделки.Вывести(ОбластьПодзаголовокРаздела);
				ОбъектыИСделки.НачатьГруппуСтрок();
			КонецЕсли; 
			
			ОбластьШапкаОбъектыИнвестирования.Параметры.Клиент = СоответствиеРазделов[ВыборкаРаздел.Раздел].Заголовок;
			ОбъектыИСделки.Вывести(ОбластьШапкаОбъектыИнвестирования);
			
			Выборка = ВыборкаТипЗадолженности.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОбластьСтрокаОбъектыИнвестирования.Параметры.Заполнить(Выборка);
				Если Выборка.Рынок = РынокОблигации Тогда
					ОбластьСтрокаОбъектыИнвестирования.Параметры.ВыпускПогашение = Формат(Выборка.ДатаВыпуска, "ДФ=dd.MM.yyyy") + " / " + Формат(Выборка.ДатаПогашения, "ДФ=dd.MM.yyyy");
				КонецЕсли;
				ОбъектыИСделки.Вывести(ОбластьСтрокаОбъектыИнвестирования);
			
			КонецЦикла; 
			
			ОбъектыИСделки.ЗакончитьГруппуСтрок();
		
		КонецЦикла; 
		
		СчетчикРазделов = СчетчикРазделов + 1;
	
	КонецЦикла;	
	#КонецОбласти 
	 
	#Область Депозитные_вклады
	
	КонфликтныеДепозиты = Новый ТаблицаЗначений;
	КонфликтныеДепозиты.Колонки.Добавить("ДатаПолученияИнформации", Новый ОписаниеТипов("Дата"));
	КонфликтныеДепозиты.Колонки.Добавить("Банк", 					Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	КонфликтныеДепозиты.Колонки.Добавить("ДатаЗаключенияДоговора", 	Новый ОписаниеТипов("Дата"));
	КонфликтныеДепозиты.Колонки.Добавить("СрокДепозита", 			Новый ОписаниеТипов("Число"));
	КонфликтныеДепозиты.Колонки.Добавить("ДепозитныеВклады",		Новый ОписаниеТипов("Массив"));
	
	Если ЭтотОбъект.ВыводитьДепозиты Тогда
		ЗаголовокРаздела = "Перечень депозитов, размещенных ";
		ВыборкаРаздел = ПолучитьДепозиты(Запрос);
		Пока ВыборкаРаздел.Следующий() Цикл
			
			ИмяРаздела = Строка(СчетчикРазделов) + ". " + ЗаголовокРаздела + СоответствиеРазделов[ВыборкаРаздел.Раздел].Раздел;
			ОбластьЗаголовокРаздела.Параметры.ИмяРаздела = ИмяРаздела;
			ОбъектыИСделки.Вывести(ОбластьЗаголовокРаздела);
			ОбъектыИСделки.НачатьГруппуСтрок();
			
			ОбластьШапкаДепозиты.Параметры.Клиент = СоответствиеРазделов[ВыборкаРаздел.Раздел].Заголовок;
			ОбъектыИСделки.Вывести(ОбластьШапкаДепозиты);
			
			Выборка = ВыборкаРаздел.Выбрать();
			
			Пока Выборка.Следующий() Цикл
			
				ОбластьСтрокаДепозиты.Параметры.Заполнить(Выборка);
				
				ЦветТекста = Новый Цвет;
				Если Выборка.ЕстьНарушение И Выборка.СоздатьРасследование Тогда
					ЦветТекста = WebЦвета.Красный;
				ИначеЕсли Выборка.ВозможенКонфликт И Выборка.СоздатьРасследование Тогда
					ЦветТекста = WebЦвета.Лосось;
				КонецЕсли;
				
				ОбластьСтрокаДепозиты.Область("R1").ЦветТекста = ЦветТекста;
				ОбъектыИСделки.Вывести(ОбластьСтрокаДепозиты);
				
				Если Выборка.ВозможенКонфликт И Выборка.СоздатьРасследование Тогда
					
					Отказ = Ложь;
					
					СтруктураОтбора = Новый Структура("Банк, ДатаЗаключенияДоговора, СрокДепозита");
					ЗаполнитьЗначенияСвойств(СтруктураОтбора, Выборка);
					
					Если Выборка.Раздел = 1 Тогда
						// клиентские депозиты добавляем в отдельную строку
						СтруктураОтбора.Вставить("ДатаПолученияИнформации", '00010101');
					Иначе
						СтруктураОтбора.Вставить("ДатаПолученияИнформации", Выборка.ДатаПолученияИнформации);
					КонецЕсли;
					
					НайденныеСтроки = КонфликтныеДепозиты.НайтиСтроки(СтруктураОтбора);
					Если НайденныеСтроки.Количество() = 0 Тогда
						СтрокаДепозитов = КонфликтныеДепозиты.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаДепозитов, СтруктураОтбора);
						Если Выборка.Раздел > 1 Тогда
							
							// найдем добавленные ранее клиентские сделки
							СтруктураОтбора.Вставить("ДатаПолученияИнформации", '00010101');
							КлиентскиеДепозиты = КонфликтныеДепозиты.НайтиСтроки(СтруктураОтбора);
							
							Если КлиентскиеДепозиты.Количество() = 1 Тогда
								РаботаСКоллекциями.ДополнитьМассив(СтрокаДепозитов.ДепозитныеВклады, КлиентскиеДепозиты[0].ДепозитныеВклады);
							Иначе
								// такого быть не должно, но проверим на всякий случай
								ТекстОшибки = "";
								Для каждого КлючЗначение Из СтруктураОтбора Цикл
									ТекстОшибки = ТекстОшибки + ", " + КлючЗначение.Ключ + ": " + КлючЗначение.Значение;
								КонецЦикла; 
								ТекстОшибки = Сред(ТекстОшибки, 3);
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Клиентские депозиты не найдены. " + ТекстОшибки,,,, Отказ);
							КонецЕсли; 
							
						КонецЕсли;
						
					Иначе
						СтрокаДепозитов = НайденныеСтроки[0];
					КонецЕсли; 
					
					Если Не Отказ Тогда
					
						РеквизитыДепозитногоВклада = Новый Структура("ВидСвязи, ПредметКонфликта", Выборка.ВидСвязи, Выборка.ДепозитныйВклад); 
						СтрокаДепозитов.ДепозитныеВклады.Добавить(РеквизитыДепозитногоВклада);						
					
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЦикла; 
			
			ОбъектыИСделки.ЗакончитьГруппуСтрок();
			СчетчикРазделов = СчетчикРазделов + 1;
			
		КонецЦикла; 
		
		КлиентскиеДепозиты = КонфликтныеДепозиты.НайтиСтроки(Новый Структура("ДатаПолученияИнформации", '00010101'));
		Для каждого СтрокаКлиентскиеДепозиты Из КлиентскиеДепозиты Цикл
			КонфликтныеДепозиты.Удалить(СтрокаКлиентскиеДепозиты);
		КонецЦикла;
		
	КонецЕсли; 	
	#КонецОбласти 	
	
	#Область Перечень_сделок
	
	КонфликтныеСделки = Новый ТаблицаЗначений;
	КонфликтныеСделки.Колонки.Добавить("Дата", 						Новый ОписаниеТипов("Дата"));
	КонфликтныеСделки.Колонки.Добавить("ДатаПолученияИнформации", 	Новый ОписаниеТипов("Дата"));
	КонфликтныеСделки.Колонки.Добавить("Операция", 					Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСделок"));
	КонфликтныеСделки.Колонки.Добавить("Рынок", 					Новый ОписаниеТипов("ПеречислениеСсылка.РынкиЦенныхБумаг"));
	КонфликтныеСделки.Колонки.Добавить("ЦеннаяБумага", 				Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	КонфликтныеСделки.Колонки.Добавить("СрокРЕПО", 					Новый ОписаниеТипов("Число"));
	КонфликтныеСделки.Колонки.Добавить("Сделки",					Новый ОписаниеТипов("Массив"));
	
	ЗаголовокРаздела = "Перечень сделок, совершённых ";
	ВыборкаРаздел = ПолучитьСделки(Запрос);
	Пока ВыборкаРаздел.Следующий() Цикл
		
		ИмяРаздела = Строка(СчетчикРазделов) + ". " + ЗаголовокРаздела + СоответствиеРазделов[ВыборкаРаздел.Раздел].Раздел;
		ОбластьЗаголовокРаздела.Параметры.ИмяРаздела = ИмяРаздела;
		ОбъектыИСделки.Вывести(ОбластьЗаголовокРаздела);
		ОбъектыИСделки.НачатьГруппуСтрок();
		
		ВыборкаЭтоРЕПО = ВыборкаРаздел.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЭтоРЕПО.Следующий() Цикл
			
			Если ВыборкаЭтоРЕПО.ЭтоРЕПО Тогда
				ОбластьПодзаголовокРаздела.Параметры.ИмяПодраздела = "Перечень сделок РЕПО, совершённых " + СоответствиеРазделов[ВыборкаРаздел.Раздел].Раздел;
				ОбъектыИСделки.Вывести(ОбластьПодзаголовокРаздела);
				ОбъектыИСделки.НачатьГруппуСтрок();
				ОбластьШапкаСделки	= МакетОбъектыИСделки.ПолучитьОбласть("ШапкаСделки");
				ОбластьСтрокаСделки = МакетОбъектыИСделки.ПолучитьОбласть("СтрокаСделки");
			Иначе
				ОбластьШапкаСделки 	= МакетОбъектыИСделки.ПолучитьОбласть("ШапкаСделки|Сделки");
				ОбластьСтрокаСделки = МакетОбъектыИСделки.ПолучитьОбласть("СтрокаСделки|Сделки");
			КонецЕсли; 
			
			ОбластьШапкаСделки.Параметры.Клиент = СоответствиеРазделов[ВыборкаРаздел.Раздел].Заголовок;
			ОбъектыИСделки.Вывести(ОбластьШапкаСделки);
			
			Выборка = ВыборкаЭтоРЕПО.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОбластьСтрокаСделки.Параметры.Заполнить(Выборка);
				Если Выборка.Рынок = РынокОблигации Тогда
					ОбластьСтрокаСделки.Параметры.ВыпускПогашение = Формат(Выборка.ДатаВыпуска, "ДФ=dd.MM.yyyy") + " / " + Формат(Выборка.ДатаПогашения, "ДФ=dd.MM.yyyy");
				КонецЕсли; 
				
				ЦветТекста = Новый Цвет;
				Если (Выборка.НарушениеПоДате Или Выборка.НарушениеПоЦене Или Выборка.НарушениеПоСтавке) И Выборка.СоздатьРасследование Тогда
					ЦветТекста = WebЦвета.Красный;
				ИначеЕсли Выборка.ВозможенКонфликт И Выборка.СоздатьРасследование Тогда
					ЦветТекста = WebЦвета.Лосось;
				КонецЕсли; 
				
				ОбластьСтрокаСделки.Область("R1").ЦветТекста = ЦветТекста;
				ОбъектыИСделки.Вывести(ОбластьСтрокаСделки);
				
				Если Выборка.ВозможенКонфликт И Выборка.СоздатьРасследование Тогда
					
					Отказ = Ложь;
					
					СтруктураОтбора = Новый Структура("Дата, Операция, Рынок, ЦеннаяБумага, СрокРЕПО");
					ЗаполнитьЗначенияСвойств(СтруктураОтбора, Выборка);
					
					Если Выборка.Раздел = 1 Тогда
						// клиентские сделки добавляем в отдельную строку
						СтруктураОтбора.Вставить("ДатаПолученияИнформации", '00010101');
					Иначе
						СтруктураОтбора.Вставить("ДатаПолученияИнформации", Выборка.ДатаПолученияИнформации);
					КонецЕсли;
					
					НайденныеСтроки = КонфликтныеСделки.НайтиСтроки(СтруктураОтбора);
					Если НайденныеСтроки.Количество() = 0 Тогда
						
						СтрокаСделок = КонфликтныеСделки.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаСделок, СтруктураОтбора);
						Если Выборка.Раздел > 1 Тогда
							
							// найдем добавленные ранее клиентские сделки
							СтруктураОтбора.Вставить("ДатаПолученияИнформации", '00010101');
							КлиентскиеСделки = КонфликтныеСделки.НайтиСтроки(СтруктураОтбора);
							
							Если КлиентскиеСделки.Количество() = 1 Тогда
								РаботаСКоллекциями.ДополнитьМассив(СтрокаСделок.Сделки, КлиентскиеСделки[0].Сделки);
							Иначе
								// такого быть не должно, но проверим на всякий случай
								ТекстОшибки = "";
								Для каждого КлючЗначение Из СтруктураОтбора Цикл
									ТекстОшибки = ТекстОшибки + ", " + КлючЗначение.Ключ + ": " + КлючЗначение.Значение;
								КонецЦикла; 
								ТекстОшибки = Сред(ТекстОшибки, 3);
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Клиентские сделки не найдены. " + ТекстОшибки,,,, Отказ);
							КонецЕсли; 
							
						КонецЕсли; 
						
					Иначе
						СтрокаСделок = НайденныеСтроки[0];
					КонецЕсли; 
					
					Если Не Отказ Тогда	
						РеквизитыСделки = Новый Структура("ВидСвязи, ПредметКонфликта", Выборка.ВидСвязи, Выборка.Сделка);
						СтрокаСделок.Сделки.Добавить(РеквизитыСделки);
					КонецЕсли; 

				КонецЕсли;
				
			КонецЦикла; 
			
			ОбъектыИСделки.ЗакончитьГруппуСтрок();
		
		КонецЦикла; 
		
		СчетчикРазделов = СчетчикРазделов + 1;
	
	КонецЦикла;
	
	КлиентскиеСделки = КонфликтныеСделки.НайтиСтроки(Новый Структура("ДатаПолученияИнформации", '00010101'));
	Для каждого СтрокаКлиентскиеСделки Из КлиентскиеСделки Цикл
		КонфликтныеСделки.Удалить(СтрокаКлиентскиеСделки);
	КонецЦикла;
	
	#КонецОбласти 
	
	
	#Область Аффилированные_лица
	
	АффилированныеЛица 		= Новый ТабличныйДокумент;
	МакетАффилированныеЛица = ПолучитьМакет("АффилированныеЛица");
	ОбластьШапка 			= МакетАффилированныеЛица.ПолучитьОбласть("Шапка");
	ОбластьСтрока 			= МакетАффилированныеЛица.ПолучитьОбласть("Строка");
	ОбластьШапкаИзменений 	= МакетАффилированныеЛица.ПолучитьОбласть("ШапкаИзменений");
	ОбластьСтрокаИзменений 	= МакетАффилированныеЛица.ПолучитьОбласть("СтрокаИзменений");
	
	ВыборкаРаздел = ПолучитьАффилированныеЛица(Запрос);
	
	Пока ВыборкаРаздел.Следующий() Цикл
		
		Если ВыборкаРаздел.Раздел = 1 Тогда
			АффилированныеЛица.Вывести(ОбластьШапка);
		ИначеЕсли ВыборкаРаздел.Раздел = 2 Тогда
			ОбластьШапкаИзменений.Параметры.ЗаголовокИзменений = "Включение в список аффилированных лиц";
			АффилированныеЛица.Вывести(ОбластьШапкаИзменений);
		Иначе
			ОбластьШапкаИзменений.Параметры.ЗаголовокИзменений = "Исключение из списка аффилированных лиц";
			АффилированныеЛица.Вывести(ОбластьШапкаИзменений);		
		КонецЕсли; 
		
		АффилированныеЛица.НачатьГруппуСтрок();
		
		Выборка = ВыборкаРаздел.Выбрать();
		НомерСтроки = 1;
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Раздел = 1 Тогда
			
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
				АффилированныеЛица.Вывести(ОбластьСтрока);
				
			Иначе
				
				ОбластьСтрокаИзменений.Параметры.Заполнить(Выборка);
				АффилированныеЛица.Вывести(ОбластьСтрокаИзменений);
			
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
		АффилированныеЛица.ЗакончитьГруппуСтрок();
	
	КонецЦикла; 

	
	#КонецОбласти 	
	
	
	#Область Совместное_владение
	
	КонфликтныеЦенныеБумаги = Новый ТаблицаЗначений;
	КонфликтныеЦенныеБумаги.Колонки.Добавить("Дата", 						Новый ОписаниеТипов("Дата"));
	КонфликтныеЦенныеБумаги.Колонки.Добавить("ДатаПолученияИнформации", 	Новый ОписаниеТипов("Дата"));
	КонфликтныеЦенныеБумаги.Колонки.Добавить("ЦенныеБумаги", 				Новый ОписаниеТипов("Массив"));
		
	Если ЭтотОбъект.ВыводитьСовместноеВладение Тогда
		
		СовместноеВладение = Новый ТабличныйДокумент;
		
		ОбластьШапкаСовместноеВладение = МакетОбъектыИСделки.ПолучитьОбласть("ШапкаСовместноеВладение");
		ОбластьСтрокаСовместноеВладение = МакетОбъектыИСделки.ПолучитьОбласть("СтрокаСовместноеВладение");
		
		ОбластьШапкаСовместноеВладение.Параметры.НаименованиеОрганизации = НаименованиеОрганизации;
		ОбластьШапкаСовместноеВладение.Параметры.ПредставлениеПериода = ПредставлениеПериода;
		
		СовместноеВладение.Вывести(ОбластьШапкаСовместноеВладение);
		
		Выборка = ПолучитьСовместноеВладение(Запрос);
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ПересеченияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ПересеченияСделок.Дата КАК Дата
			|ИЗ
			|	_ПересеченияСделок КАК _ПересеченияСделок
			|ИТОГИ ПО
			|	ЦеннаяБумага";
			
		ВыборкаЦенныхБумаг = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ПредставленияЦенныхБумаг = Новый Соответствие;
		Пока ВыборкаЦенныхБумаг.Следующий() Цикл
			
			ПредставленияЦенныхБумаг.Вставить(ВыборкаЦенныхБумаг.ЦеннаяБумага, Новый Соответствие);
			
			ВыборкаДат = ВыборкаЦенныхБумаг.Выбрать();
			Пока ВыборкаДат.Следующий() Цикл
				Представление = РаботаСОтчетами.ПолучитьПредставлениеЦеннойБумаги(ВыборкаДат.ЦеннаяБумага, ВыборкаДат.Дата, Ложь);
				ПредставленияЦенныхБумаг[ВыборкаЦенныхБумаг.ЦеннаяБумага].Вставить(ВыборкаДат.Дата, Представление);
			КонецЦикла;
		КонецЦикла;
			
		Пока Выборка.Следующий() Цикл
			
			ЦветТекста = Новый Цвет;
			Если Выборка.СоздатьРасследование Тогда
				ЦветТекста = WebЦвета.Красный;
				
				СтруктураОтбора = Новый Структура("Дата, ДатаПолученияИнформации"); 
				ЗаполнитьЗначенияСвойств(СтруктураОтбора, Выборка);
				
				НайденныеСтроки = КонфликтныеЦенныеБумаги.НайтиСтроки(СтруктураОтбора);
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрока = КонфликтныеЦенныеБумаги.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				Иначе
					НоваяСтрока = НайденныеСтроки[0];
				КонецЕсли; 
				
				СтруктураЦБ = Новый Структура("Счет, ВидСвязи, Рынок, ЦеннаяБумага, Количество"); 
				ЗаполнитьЗначенияСвойств(СтруктураЦБ, Выборка);
				НоваяСтрока.ЦенныеБумаги.Добавить(СтруктураЦБ);				
				
			КонецЕсли; 
			
			ОбластьСтрокаСовместноеВладение.Область("R1").ЦветТекста = ЦветТекста;
			ОбластьСтрокаСовместноеВладение.Параметры.Заполнить(Выборка);
			
			ОбластьСтрокаСовместноеВладение.Параметры.ЦеннаяБумагаПредставление = ПредставленияЦенныхБумаг[Выборка.ЦеннаяБумага][Выборка.Дата];
			ОбластьСтрокаСовместноеВладение.Параметры.ЦеннаяБумага = Выборка.ЦеннаяБумага;
			
			СовместноеВладение.Вывести(ОбластьСтрокаСовместноеВладение);
			
		КонецЦикла; 
	
	КонецЕсли; 
	
	#КонецОбласти 
	
	// Завершаем сессию сбора статистики
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Результат = Новый Структура; 
	Результат.Вставить("ОбъектыИСделки", 			ОбъектыИСделки);
	Результат.Вставить("СовместноеВладение", 		СовместноеВладение);
	Результат.Вставить("АффилированныеЛица", 		АффилированныеЛица);
	Результат.Вставить("КонфликтныеДепозиты", 		КонфликтныеДепозиты);
	Результат.Вставить("КонфликтныеСделки", 		КонфликтныеСделки);
	Результат.Вставить("КонфликтныеЦенныеБумаги", 	КонфликтныеЦенныеБумаги);
	
	Возврат Результат; 
	
КонецФункции

#Область Получение_данных

Функция ПолучитьТаблицуКлиентов(ВидДоговораДоверительногоУправления) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", 	ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 	ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", ВидДоговораДоверительногоУправления);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаНачала, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&ВидДоговораДоверительногоУправления)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетаДоверительногоУправления.Наименование";
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьНаименованиеОрганизации(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&ДатаОкончания,
		|			ЮрФизЛицо = &ЮрФизЛицоУК
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	
	НаименованиеОрганизации = "";
	
	Если Выборка.Следующий() Тогда
		НаименованиеОрганизации = Выборка.ПолноеНаименованиеПоУставу;
	КонецЕсли; 
	
	Возврат НаименованиеОрганизации;

КонецФункции

Процедура ПоместитьСчетаДУВМенеджерВременныхТаблиц(Запрос)
    
	#Область Текст_запроса_Клиенты
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ПОМЕСТИТЬ _ТаблицаКлиентов
		|ИЗ
		|	&ТаблицаКлиентов КАК ТаблицаКлиентов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаЗаключения < &ДатаНачала
		|			ТОГДА &ДатаНачала
		|		ИНАЧЕ СчетаДоверительногоУправления.ДатаЗаключения
		|	КОНЕЦ КАК ДатаНачала,
		|	ВЫБОР
		|		КОГДА СчетаДоверительногоУправления.ДатаРасторжения МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ТОГДА КОНЕЦПЕРИОДА(СчетаДоверительногоУправления.ДатаРасторжения, ДЕНЬ)
		|		ИНАЧЕ &ДатаОкончания
		|	КОНЕЦ КАК ДатаОкончания,
		|	ВЫБОР
		|		КОГДА _ТаблицаКлиентов.СчетДоверительногоУправления ЕСТЬ NULL
		|			ТОГДА НЕОПРЕДЕЛЕНО
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Клиент)
		|	КОНЕЦ КАК ВидСвязи
		|ПОМЕСТИТЬ _ПериодыДействияСчетовДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаКлиентов КАК _ТаблицаКлиентов
		|		ПО (_ТаблицаКлиентов.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаНачала)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	&ДатаНачала КАК Период
		|ПОМЕСТИТЬ _ПериодыДействияКлиентов
		|ИЗ
		|	_ПериодыДействияСчетовДУ КАК _ПериодыДействияСчетовДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&ДатаНачала,
		|				(Организация, СчетДоверительногоУправления) В
		|					(ВЫБРАТЬ
		|						&Организация КАК Организация,
		|						_ПериодыДействияСчетовДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|					ИЗ
		|						_ПериодыДействияСчетовДУ КАК _ПериодыДействияСчетовДУ)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Организация = &Организация)
		|			И _ПериодыДействияСчетовДУ.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КлиентыДоверительногоУправления.СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправления.Клиент,
		|	КлиентыДоверительногоУправления.Период
		|ИЗ
		|	_ПериодыДействияСчетовДУ КАК _ПериодыДействияСчетовДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления
		|		ПО (КлиентыДоверительногоУправления.Организация = &Организация)
		|			И _ПериодыДействияСчетовДУ.СчетДоверительногоУправления = КлиентыДоверительногоУправления.СчетДоверительногоУправления
		|			И (КлиентыДоверительногоУправления.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыДействияКлиентов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ПериодыДействияКлиентов.Клиент КАК ЮрФизЛицо,
		|	ВЫБОР
		|		КОГДА _ПериодыДействияСчетовДУ.ДатаНачала > _ПериодыДействияКлиентов.Период
		|			ТОГДА _ПериодыДействияСчетовДУ.ДатаНачала
		|		ИНАЧЕ _ПериодыДействияКлиентов.Период
		|	КОНЕЦ КАК ДатаНачала_Клиент,
		|	ЕСТЬNULL(ДОБАВИТЬКДАТЕ(МИНИМУМ(_ПериодыДействияКлиентовКонец.Период), СЕКУНДА, -1), &ДатаОкончания) КАК ДатаОкончания_Клиент,
		|	_ПериодыДействияСчетовДУ.ВидСвязи КАК ВидСвязи
		|ПОМЕСТИТЬ _ТаблицаПериодовДействия
		|ИЗ
		|	_ПериодыДействияСчетовДУ КАК _ПериодыДействияСчетовДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПериодыДействияКлиентов КАК _ПериодыДействияКлиентов
		|		ПО _ПериодыДействияСчетовДУ.СчетДоверительногоУправления = _ПериодыДействияКлиентов.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодыДействияКлиентов КАК _ПериодыДействияКлиентовКонец
		|		ПО (_ПериодыДействияКлиентов.СчетДоверительногоУправления = _ПериодыДействияКлиентовКонец.СчетДоверительногоУправления)
		|			И (_ПериодыДействияКлиентов.Период < _ПериодыДействияКлиентовКонец.Период)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПериодыДействияКлиентов.СчетДоверительногоУправления,
		|	_ПериодыДействияКлиентов.Клиент,
		|	_ПериодыДействияКлиентов.Период,
		|	_ПериодыДействияСчетовДУ.ДатаНачала,
		|	_ПериодыДействияСчетовДУ.ВидСвязи
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсточникиСведенийПредоставляемыхЮрФизЛицами.Ссылка,
		|	ИсточникиСведенийПредоставляемыхЮрФизЛицами.ЮрФизЛицо,
		|	&ДатаНачала,
		|	&ДатаОкончания,
		|	НЕОПРЕДЕЛЕНО
		|ИЗ
		|	Справочник.ИсточникиСведенийПредоставляемыхЮрФизЛицами КАК ИсточникиСведенийПредоставляемыхЮрФизЛицами
		|ГДЕ
		|	НЕ ИсточникиСведенийПредоставляемыхЮрФизЛицами.ПометкаУдаления
		|	И ИсточникиСведенийПредоставляемыхЮрФизЛицами.Организация = &Организация
		|	И ИсточникиСведенийПредоставляемыхЮрФизЛицами.ЮрФизЛицо <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)";
	#КонецОбласти	
	
	Запрос.Выполнить();
	
	ТаблицаПериодовДействия = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(
		Запрос, 
		"_ТаблицаПериодовДействия",,,, 
		"ЮрФизЛицо, СчетДоверительногоУправления, ДатаНачала_Клиент").Выгрузить();
		
	ТаблицаПериодовДействия.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
	ТаблицаПериодовДействия.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
	
	ТаблицаПериодовДействия.ЗагрузитьКолонку(ТаблицаПериодовДействия.ВыгрузитьКолонку("ДатаНачала_Клиент"), "ДатаНачала");
	ТаблицаПериодовДействия.ЗагрузитьКолонку(ТаблицаПериодовДействия.ВыгрузитьКолонку("ДатаОкончания_Клиент"), "ДатаОкончания");
		
	#Область Заполнение_таблицы_периодов_действия_по_АЛ
		
	Если ЭтотОбъект.ВыводитьРазделыПоАффилированнымЛицам Тогда
	
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	&ДатаНачала КАК ДатаНачала,
			|	АффилированныеЛицаСрезПоследних.АффилированноеЛицо КАК ЮрФизЛицо,
			|	АффилированныеЛицаСрезПоследних.ЯвляетсяАффилированным КАК Действует,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.АффилированноеЛицо) КАК ВидСвязи
			|ПОМЕСТИТЬ _ЗаписиРегистра
			|ИЗ
			|	РегистрСведений.АффилированныеЛица.СрезПоследних(&ДатаНачала, ЮридическоеЛицо = &ЮрФизЛицоУК) КАК АффилированныеЛицаСрезПоследних
			|ГДЕ
			|	&ВыводитьРазделыПоАффилированнымЛицам
			|	И АффилированныеЛицаСрезПоследних.ЯвляетсяАффилированным
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВЫБОР
			|		КОГДА АффилированныеЛица.ЯвляетсяАффилированным
			|			ТОГДА АффилированныеЛица.Период
			|		ИНАЧЕ ДОБАВИТЬКДАТЕ(АффилированныеЛица.Период, СЕКУНДА, -1)
			|	КОНЕЦ,
			|	АффилированныеЛица.АффилированноеЛицо,
			|	АффилированныеЛица.ЯвляетсяАффилированным,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.АффилированноеЛицо)
			|ИЗ
			|	РегистрСведений.АффилированныеЛица КАК АффилированныеЛица
			|ГДЕ
			|	&ВыводитьРазделыПоАффилированнымЛицам
			|	И АффилированныеЛица.ЮридическоеЛицо = &ЮрФизЛицоУК
			|	И АффилированныеЛица.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	&ДатаНачала,
			|	&ЮрФизЛицоУК,
			|	ИСТИНА,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.УправляющаяКомпания)
			|ГДЕ
			|	&ВыводитьРазделыПоСобственнымСредствам";
		
		Запрос.Выполнить();
		ЗаполнитьТаблицуПериодовДействия(Запрос, ТаблицаПериодовДействия);
	
	КонецЕсли; 	
	
	#КонецОбласти
	
    #Область Заполнение_таблицы_периодов_действия_по_сотрудникам 

	Если ЭтотОбъект.ВыводитьРазделыПоСотрудникам Тогда
	
		// Ознакомленные с кодексом
		ТекстЗапросаВнутренниеПеречни = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	&ДатаНачала КАК ДатаНачала,
			|	РегистрСведенийВнутренниеПеречниСрезПоследних.Объект КАК ЮрФизЛицо,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Сотрудник) КАК ВидСвязи,
			|	РегистрСведенийВнутренниеПеречниСрезПоследних.Действует КАК Действует
			|ПОМЕСТИТЬ _ЗаписиРегистра
			|ИЗ
			|	РегистрСведений.ВнутренниеПеречни.СрезПоследних(
			|			&ДатаНачала,
			|			Организация = &Организация
			|				И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЛицаОзнакомленныеСКодексами)) КАК РегистрСведенийВнутренниеПеречниСрезПоследних
			|ГДЕ
			|	РегистрСведенийВнутренниеПеречниСрезПоследних.Действует
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА ВнутренниеПеречни.Действует
			|			ТОГДА НАЧАЛОПЕРИОДА(ВнутренниеПеречни.Период, ДЕНЬ)
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ВнутренниеПеречни.Период, ДЕНЬ)
			|	КОНЕЦ,
			|	ВнутренниеПеречни.Объект,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Сотрудник),
			|	ВнутренниеПеречни.Действует
			|ИЗ
			|	РегистрСведений.ВнутренниеПеречни КАК ВнутренниеПеречни
			|ГДЕ
			|	ВнутренниеПеречни.Организация = &Организация
			|	И ВнутренниеПеречни.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
			|	И ВнутренниеПеречни.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ЛицаОзнакомленныеСКодексами)
			|	И ВнутренниеПеречни.Активность";		
		
		
		Запрос.Текст = ТекстЗапросаВнутренниеПеречни;
		Запрос.Выполнить();
		ЗаполнитьТаблицуПериодовДействия(Запрос, ТаблицаПериодовДействия);
			
		// Должностные лица
		ЗаменаЗначений = Новый Соответствие;
		ЗаменаЗначений.Вставить("Справочник.ВидыПеречнейОбъектов.ЛицаОзнакомленныеСКодексами", 
								"Справочник.ВидыПеречнейОбъектов.ДолжностныеЛицаПН");
		ЗаменаЗначений.Вставить("Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Сотрудник", 
								"Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.ДолжностноеЛицо");
		
		Для каждого КЗ Из ЗаменаЗначений Цикл
		
			ТекстЗапросаВнутренниеПеречни = СтрЗаменить(ТекстЗапросаВнутренниеПеречни, КЗ.Ключ, КЗ.Значение);
		
		КонецЦикла;
		
		Запрос.Текст = ТекстЗапросаВнутренниеПеречни;
		Запрос.Выполнить();
		ЗаполнитьТаблицуПериодовДействия(Запрос, ТаблицаПериодовДействия);
	
	КонецЕсли;
	
	#КонецОбласти
	
	Запрос.Текст = "УНИЧТОЖИТЬ _ТаблицаПериодовДействия";
	Запрос.Выполнить();
	Запрос.УстановитьПараметр("ТаблицаПериодовДействия", ТаблицаПериодовДействия);
	
	Разделы = Новый ТаблицаЗначений;
	Разделы.Колонки.Добавить("Раздел", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	Разделы.Колонки.Добавить("ВидСвязи", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами"));
	
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 1, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Клиент));
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 2, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.АффилированноеЛицо));
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 3, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.УправляющаяКомпания));
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 4, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.ДолжностноеЛицо));
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 5, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Сотрудник));
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 6, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.БлизкийРодственникДолжностногоЛица));
	ЗаполнитьЗначенияСвойств(Разделы.Добавить(), Новый Структура("Раздел, ВидСвязи", 7, Перечисления.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.БлизкийРодственникСотрудника));
	
	Запрос.УстановитьПараметр("Разделы", Разделы);
	
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Разделы.Раздел КАК Раздел,
		|	Разделы.ВидСвязи КАК ВидСвязи
		|ПОМЕСТИТЬ _Разделы
		|ИЗ
		|	&Разделы КАК Разделы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаПериодовДействия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТаблицаПериодовДействия.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТаблицаПериодовДействия.ВидСвязи КАК ВидСвязи,
		|	ТаблицаПериодовДействия.ДатаНачала КАК ДатаНачала,
		|	ТаблицаПериодовДействия.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ _ТаблицаПериодовДействия
		|ИЗ
		|	&ТаблицаПериодовДействия КАК ТаблицаПериодовДействия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаПериодовДействия.ДатаНачала КАК ДатаНачала,
		|	_ТаблицаПериодовДействия.ДатаОкончания КАК ДатаОкончания,
		|	_ТаблицаПериодовДействия.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ТаблицаПериодовДействия.ВидСвязи КАК ВидСвязи
		|ПОМЕСТИТЬ _СчетаДУВрем
		|ИЗ
		|	_ТаблицаПериодовДействия КАК _ТаблицаПериодовДействия
		|ГДЕ
		|	_ТаблицаПериодовДействия.СчетДоверительногоУправления ССЫЛКА Справочник.СчетаДоверительногоУправления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ТаблицаПериодовДействия.ДатаНачала,
		|	_ТаблицаПериодовДействия.ДатаОкончания,
		|	_ТаблицаПериодовДействия.СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ТаблицаПериодовДействия.ВидСвязи <> НЕОПРЕДЕЛЕНО
		|			ТОГДА _ТаблицаПериодовДействия.ВидСвязи
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _ТаблицаПериодовДействия_ИсточникиСвязей.ВидСвязи = ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.ДолжностноеЛицо)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.БлизкийРодственникДолжностногоЛица)
		|				КОГДА _ТаблицаПериодовДействия_ИсточникиСвязей.ВидСвязи = ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Сотрудник)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.БлизкийРодственникСотрудника)
		|			КОНЕЦ
		|	КОНЕЦ
		|ИЗ
		|	_ТаблицаПериодовДействия КАК _ТаблицаПериодовДействия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИсточникиСведенийПредоставляемыхЮрФизЛицами КАК ИсточникиСведенийПредоставляемыхЮрФизЛицами
		|		ПО (ИсточникиСведенийПредоставляемыхЮрФизЛицами.Организация = &Организация)
		|			И (НЕ ИсточникиСведенийПредоставляемыхЮрФизЛицами.ПометкаУдаления)
		|			И (ИсточникиСведенийПредоставляемыхЮрФизЛицами.Ссылка = _ТаблицаПериодовДействия.СчетДоверительногоУправления)
		|			И (&ВыводитьДанныеПредоставляемыеЮрФизЛицами)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаПериодовДействия КАК _ТаблицаПериодовДействия_ИсточникиСвязей
		|		ПО (ИсточникиСведенийПредоставляемыхЮрФизЛицами.ИсточникСвязи = _ТаблицаПериодовДействия_ИсточникиСвязей.ЮрФизЛицо
		|				ИЛИ ИсточникиСведенийПредоставляемыхЮрФизЛицами.ИсточникСвязи = _ТаблицаПериодовДействия_ИсточникиСвязей.СчетДоверительногоУправления)
		|			И (_ТаблицаПериодовДействия_ИсточникиСвязей.ВидСвязи В (ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.ДолжностноеЛицо), ЗНАЧЕНИЕ(Перечисление.ВидыСвязейИсточниковСведенийПредоставляемыхЮрФизЛицами.Сотрудник)))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаДУВрем.ДатаНачала КАК ДатаНачала,
		|	_СчетаДУВрем.ДатаОкончания КАК ДатаОкончания,
		|	_СчетаДУВрем.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_СчетаДУВрем.ВидСвязи КАК ВидСвязи,
		|	ЕСТЬNULL(_Разделы.Раздел, 0) КАК Раздел
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	_СчетаДУВрем КАК _СчетаДУВрем
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Разделы КАК _Разделы
		|		ПО _СчетаДУВрем.ВидСвязи = _Разделы.ВидСвязи
		|ГДЕ
		|	_СчетаДУВрем.ВидСвязи <> НЕОПРЕДЕЛЕНО";		
	#КонецОбласти
	Запрос.Выполнить();
	
	УничтожитьВременныеТаблицы(Запрос);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуПериодовДействия(Запрос, ТаблицаПериодовДействия)

	// формируем табилцу замещающих периодов
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ВложенныйЗапрос.ДатаНачала) КАК ДатаНачала,
		|	ВложенныйЗапрос.ДатаОкончания КАК ДатаОкончания,
		|	ВложенныйЗапрос.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ВложенныйЗапрос.ВидСвязи КАК ВидСвязи
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ЗаписиРегистра_НачалоПериода.ДатаНачала КАК ДатаНачала,
		|		ЕСТЬNULL(МИНИМУМ(_ЗаписиРегистра_ОкончаниеПериода.ДатаНачала), &ДатаОкончания) КАК ДатаОкончания,
		|		_ЗаписиРегистра_НачалоПериода.ЮрФизЛицо КАК ЮрФизЛицо,
		|		_ЗаписиРегистра_НачалоПериода.ВидСвязи КАК ВидСвязи
		|	ИЗ
		|		_ЗаписиРегистра КАК _ЗаписиРегистра_НачалоПериода
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ЗаписиРегистра КАК _ЗаписиРегистра_ОкончаниеПериода
		|			ПО _ЗаписиРегистра_НачалоПериода.ЮрФизЛицо = _ЗаписиРегистра_ОкончаниеПериода.ЮрФизЛицо
		|				И _ЗаписиРегистра_НачалоПериода.ДатаНачала < _ЗаписиРегистра_ОкончаниеПериода.ДатаНачала
		|				И _ЗаписиРегистра_НачалоПериода.Действует <> _ЗаписиРегистра_ОкончаниеПериода.Действует
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ТаблицаПериодовДействия КАК _ТаблицаПериодовДействия
		|			ПО _ЗаписиРегистра_НачалоПериода.ЮрФизЛицо = _ТаблицаПериодовДействия.ЮрФизЛицо
		|	ГДЕ
		|		_ЗаписиРегистра_НачалоПериода.Действует
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ЗаписиРегистра_НачалоПериода.ДатаНачала,
		|		_ЗаписиРегистра_НачалоПериода.ЮрФизЛицо,
		|		_ЗаписиРегистра_НачалоПериода.ВидСвязи) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.ДатаОкончания,
		|	ВложенныйЗапрос.ЮрФизЛицо,
		|	ВложенныйЗапрос.ВидСвязи
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВложенныйЗапрос.ЮрФизЛицо,
		|	ВложенныйЗапрос.ДатаОкончания
		|ИТОГИ ПО
		|	ЮрФизЛицо";
	
	Результат = Запрос.Выполнить();
	ВыборкаЮрФизЛицо = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЮрФизЛицо.Следующий() Цикл
		
		НайденныеСтроки = ТаблицаПериодовДействия.НайтиСтроки(Новый Структура("ЮрФизЛицо", ВыборкаЮрФизЛицо.ЮрФизЛицо));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗамещающаяСтрока = ВыборкаЮрФизЛицо.Выбрать();
		
		Пока ЗамещающаяСтрока.Следующий() Цикл
		
			ТекущийСчетДУ = Неопределено;
			ИндексНовойСтроки = Неопределено;
			СтрокиКУдалению = Новый Массив;
			ДатаНачала_Клиент = Неопределено;
			ДатаОкончания_Клиент = Неопределено;
			
			Для каждого ТекСтрока Из НайденныеСтроки Цикл
				
				Если ЗамещающаяСтрока.ВидСвязи = ТекСтрока.ВидСвязи Тогда
					// это добавленная на предыдущей итерации строка, идем дальше
					Продолжить;
				КонецЕсли;
				
				Если ТекущийСчетДУ = ТекСтрока.СчетДоверительногоУправления И ЗначениеЗаполнено(ИндексНовойСтроки) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТекущийСчетДУ <> ТекСтрока.СчетДоверительногоУправления Тогда
					
					Если ТекущийСчетДУ <> Неопределено Тогда
						
						Если ЗначениеЗаполнено(ИндексНовойСтроки) Тогда
						
							ПараметрыНовойСтроки = Новый Структура("ЮрФизЛицо, ВидСвязи");
							ЗаполнитьЗначенияСвойств(ПараметрыНовойСтроки, ЗамещающаяСтрока);
							ПараметрыНовойСтроки.Вставить("СчетДоверительногоУправления", ТекущийСчетДУ);
							ПараметрыНовойСтроки.Вставить("ДатаНачала", Макс(ЗамещающаяСтрока.ДатаНачала, ДатаНачала_Клиент));
							ПараметрыНовойСтроки.Вставить("ДатаОкончания", Мин(ЗамещающаяСтрока.ДатаОкончания, ДатаОкончания_Клиент));
							ПараметрыНовойСтроки.Вставить("ДатаНачала_Клиент", ДатаНачала_Клиент);
							ПараметрыНовойСтроки.Вставить("ДатаОкончания_Клиент", ДатаОкончания_Клиент);
							
							ДобавитьУдалитьСтроки(ТаблицаПериодовДействия, ИндексНовойСтроки, ПараметрыНовойСтроки, СтрокиКУдалению);							
						
						КонецЕсли;

						ИндексНовойСтроки = Неопределено;
						СтрокиКУдалению = Новый Массив;
					
					КонецЕсли;
					
					ТекущийСчетДУ = ТекСтрока.СчетДоверительногоУправления;
					ДатаНачала_Клиент = ТекСтрока.ДатаНачала_Клиент;
					ДатаОкончания_Клиент = ТекСтрока.ДатаОкончания_Клиент;
					
				КонецЕсли;
				
				Если ЗамещающаяСтрока.ДатаНачала < ТекСтрока.ДатаОкончания И ЗамещающаяСтрока.ДатаОкончания > ТекСтрока.ДатаНачала Тогда
					// Периоды пересекаются
					
					Если ТекСтрока.ДатаНачала < ЗамещающаяСтрока.ДатаНачала Тогда
						
						ИндексНовойСтроки = ТаблицаПериодовДействия.Индекс(ТекСтрока) + 1;
						
						Если ТекСтрока.ДатаОкончания > ЗамещающаяСтрока.ДатаОкончания Тогда
						
							НоваяСтрока = ТаблицаПериодовДействия.Вставить(ИндексНовойСтроки);
							НоваяСтрока.ДатаНачала = ЗамещающаяСтрока.ДатаОкончания + 1;
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, , "ДатаНачала");
						
						КонецЕсли;
						
						ТекСтрока.ДатаОкончания = ЗамещающаяСтрока.ДатаНачала - 1;
													
					ИначеЕсли ТекСтрока.ДатаОкончания > ЗамещающаяСтрока.ДатаОкончания Тогда
						
						ИндексНовойСтроки = ТаблицаПериодовДействия.Индекс(ТекСтрока);
						ТекСтрока.ДатаНачала = ЗамещающаяСтрока.ДатаОкончания + 1;
						
					Иначе
						
						Если ИндексНовойСтроки = Неопределено Тогда
							ИндексНовойСтроки = ТаблицаПериодовДействия.Индекс(ТекСтрока);
						КонецЕсли;
						
						СтрокиКУдалению.Добавить(ТекСтрока);
													
					КонецЕсли;
					
				КонецЕсли;					
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(ИндексНовойСтроки) Тогда
			
				ПараметрыНовойСтроки = Новый Структура("ЮрФизЛицо, ВидСвязи");
					ЗаполнитьЗначенияСвойств(ПараметрыНовойСтроки, ЗамещающаяСтрока);
					ПараметрыНовойСтроки.Вставить("СчетДоверительногоУправления", ТекущийСчетДУ);
					ПараметрыНовойСтроки.Вставить("ДатаНачала", Макс(ЗамещающаяСтрока.ДатаНачала, ДатаНачала_Клиент));
					ПараметрыНовойСтроки.Вставить("ДатаОкончания", Мин(ЗамещающаяСтрока.ДатаОкончания, ДатаОкончания_Клиент));
					ПараметрыНовойСтроки.Вставить("ДатаНачала_Клиент", ДатаНачала_Клиент);
					ПараметрыНовойСтроки.Вставить("ДатаОкончания_Клиент", ДатаОкончания_Клиент);
					
				ДобавитьУдалитьСтроки(ТаблицаПериодовДействия, ИндексНовойСтроки, ПараметрыНовойСтроки, СтрокиКУдалению);				
			
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	Запрос.Текст = "УНИЧТОЖИТЬ _ЗаписиРегистра";
	Запрос.Выполнить();

КонецПроцедуры

Процедура ДобавитьУдалитьСтроки(ТаблицаПериодовДействия, ИндексНовойСтроки, ПараметрыНовойСтроки, СтрокиКУдалению);
	
	НоваяСтрока = ТаблицаПериодовДействия.Вставить(ИндексНовойСтроки);
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыНовойСтроки);
	
	Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		ТаблицаПериодовДействия.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьОбъектыИнвестирования(Запрос, ВыгрузитьРезультат = Ложь)

	#Область Текст_запрос_объекты_инвестирования
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумагОстаткиИОбороты.Период КАК Период,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.Рынок КАК Рынок,
		|	НЕОПРЕДЕЛЕНО КАК ТипЗадолженности,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
		|ПОМЕСТИТЬ _ОборотыЦенныхБумагВрем
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			День,
		|			,
		|			(Организация, СчетДоверительногоУправления) В
		|				(ВЫБРАТЬ
		|					&Организация,
		|					_СчетаДУ.СчетДоверительногоУправления
		|				ИЗ
		|					_СчетаДУ КАК _СчетаДУ)) КАК ОстаткиЦенныхБумагОстаткиИОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.Период,
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.Рынок,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|	КОНЕЦ,
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.ЦеннаяБумага,
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.КоличествоНачальныйОстаток,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.КоличествоРасход
		|		ИНАЧЕ ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.КоличествоПриход
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.КоличествоПриход
		|		ИНАЧЕ ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.КоличествоРасход
		|	КОНЕЦ,
		|	ЗадолженностиПоЦеннымБумагамОстаткиИОбороты.КоличествоКонечныйОстаток
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.ОстаткиИОбороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			День,
		|			,
		|			&ВыводитьСделкиРЕПО
		|				И (Организация, ВидЗадолженности, СчетДоверительногоУправления) В
		|					(ВЫБРАТЬ
		|						&Организация,
		|						ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО),
		|						_СчетаДУ.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)) КАК ЗадолженностиПоЦеннымБумагамОстаткиИОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
