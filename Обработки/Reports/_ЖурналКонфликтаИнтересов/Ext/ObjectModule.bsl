		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Векселя).Серия + "", "" + ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Векселя).Номер
		|		КОНЕЦ КАК СерияНомер,
