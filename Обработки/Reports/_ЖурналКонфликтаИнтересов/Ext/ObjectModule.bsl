		|		КОНЕЦ КАК НоминалНачало,
		|		_ОборотыПоРазделам.КоличествоНачальныйОстаток КАК КоличествоНачальныйОстаток,
		|		_ОборотыПоРазделам.КоличествоПриход КАК КоличествоПриход,
		|		_ОборотыПоРазделам.КоличествоРасход КАК КоличествоРасход,
		|		_ОборотыПоРазделам.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток,
		|		ВЫБОР
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Акции).Номинал
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|				ТОГДА ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Векселя).Номинал
		|			КОГДА _ОборотыПоРазделам.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				ТОГДА ЕСТЬNULL(НоминалыЦенныхБумагОкончание.Номинал, 0)
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК НоминалОкончание,
		|		_ОборотыПоРазделам.ДатаНачала КАК ДатаНачала,
		|		_ОборотыПоРазделам.ДатаОкончания КАК ДатаОкончания,
		|		_ОборотыПоРазделам.ВидСвязи КАК ВидСвязи
		|	ИЗ
		|		_ОборотыПоРазделам КАК _ОборотыПоРазделам
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФСрезПоследних
		|			ПО (ВЫРАЗИТЬ(_ОборотыПоРазделам.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Номиналы КАК НоминалыЦенныхБумагНачало
		|			ПО _ОборотыПоРазделам.ЦеннаяБумага = НоминалыЦенныхБумагНачало.ЦеннаяБумага
		|				И _ОборотыПоРазделам.ДатаНачала = НоминалыЦенныхБумагНачало.ДатаНоминала
		|			ЛЕВОЕ СОЕДИНЕНИЕ _Номиналы КАК НоминалыЦенныхБумагОкончание
		|			ПО _ОборотыПоРазделам.ЦеннаяБумага = НоминалыЦенныхБумагОкончание.ЦеннаяБумага
		|				И _ОборотыПоРазделам.ДатаОкончания = НоминалыЦенныхБумагОкончание.ДатаНоминала) КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Раздел,
		|	СчетДоверительногоУправления,
		|	Рынок,
		|	Эмитент,
		|	СерияНомер";
	#КонецОбласти 
	
	Если ВыгрузитьРезультат Тогда
	
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выгрузить();
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + "
			|ИТОГИ ПО
			|	Раздел,
			|	ТипЗадолженности
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	КонецЕсли; 
		
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _ОборотыЦенныхБумагВрем
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПериодыПолученияОстатков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ОборотыПоРазделам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Номиналы";

	Запрос.Выполнить();
	
	Возврат Выборка;

КонецФункции
 
Функция ПолучитьДепозиты(Запрос)

	ПоместитьДепозитыВМенеджерВременныхТаблиц(Запрос);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДепозитныеВклады.Раздел КАК Раздел,
		|	_ДепозитныеВклады.ДепозитныйВклад КАК ДепозитныйВклад,
		|	СлужебноеРасследованиеДепозитныеВклады.Ссылка КАК СлужебноеРасследование
		|ПОМЕСТИТЬ _Расследования
		|ИЗ
		|	Документ.СлужебноеРасследование.ИнформацияОКонфликте КАК СлужебноеРасследованиеДепозитныеВклады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СлужебноеРасследование КАК СлужебноеРасследование
		|		ПО СлужебноеРасследованиеДепозитныеВклады.Ссылка = СлужебноеРасследование.Ссылка
		|			И (СлужебноеРасследование.Проведен)
		|			И (СлужебноеРасследование.ОбстоятельствоВозникновенияКонфликтаИнтересов = ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.ДепозитныйВклад))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДепозитныеВклады КАК _ДепозитныеВклады
		|		ПО СлужебноеРасследованиеДепозитныеВклады.ПредметКонфликта = _ДепозитныеВклады.ДепозитныйВклад
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДепозитныйВклад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДепозитныеВклады.Раздел КАК Раздел,
		|	_ДепозитныеВклады.ВидСвязи КАК ВидСвязи,
		|	_ДепозитныеВклады.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДепозитныеВклады.Банк КАК Банк,
		|	_ДепозитныеВклады.ДатаЗаключенияДоговора КАК ДатаЗаключенияДоговора,
		|	_ДепозитныеВклады.СрокДепозита КАК СрокДепозита,
		|	_ДепозитныеВклады.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	_ДепозитныеВклады.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_ДепозитныеВклады.ДатаПолученияИнформации КАК ДатаПолученияИнформации,
		|	ЕСТЬNULL(_ДепозитныеВклады.Раздел = 1
		|				И _ДепозитныеВклады.ПроцентнаяСтавка < _ДепозитныеВкладыСобственные.ПроцентнаяСтавка
		|			ИЛИ _ДепозитныеВкладыСобственные.Раздел = 1
		|				И _ДепозитныеВкладыСобственные.ПроцентнаяСтавка < _ДепозитныеВклады.ПроцентнаяСтавка, ЛОЖЬ) КАК ЕстьНарушение,
		|	_ДепозитныеВкладыСобственные.ДепозитныйВклад ЕСТЬ НЕ NULL  КАК ВозможенКонфликт,
		|	_ДепозитныеВкладыСобственные.ДепозитныйВклад КАК ДепозитныйВкладСобственный,
		|	_ДепозитныеВкладыСобственные.ДепозитныйВклад ЕСТЬ НЕ NULL 
		|		И ВложенныйЗапрос.СлужебноеРасследование ЕСТЬ NULL КАК СоздатьРасследование
		|ПОМЕСТИТЬ _ПересеченияДепозитныхВкладов
		|ИЗ
		|	_ДепозитныеВклады КАК _ДепозитныеВклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДепозитныеВклады КАК _ДепозитныеВкладыСобственные
		|		ПО _ДепозитныеВклады.Банк = _ДепозитныеВкладыСобственные.Банк
		|			И _ДепозитныеВклады.ДатаЗаключенияДоговора = _ДепозитныеВкладыСобственные.ДатаЗаключенияДоговора
		|			И _ДепозитныеВклады.СрокДепозита = _ДепозитныеВкладыСобственные.СрокДепозита
		|			И _ДепозитныеВклады.СчетДоверительногоУправления <> _ДепозитныеВкладыСобственные.СчетДоверительногоУправления
		|			И (_ДепозитныеВклады.Раздел = 1
		|					И _ДепозитныеВкладыСобственные.Раздел > 1
		|				ИЛИ _ДепозитныеВклады.Раздел > 1
		|					И _ДепозитныеВкладыСобственные.Раздел = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Расследования.СлужебноеРасследование КАК СлужебноеРасследование,
		|			_Расследования.ДепозитныйВклад КАК ДепозитныйВклад,
		|			_РасследованияСобственные.ДепозитныйВклад КАК ДепозитныйВкладКонфликтный
		|		ИЗ
		|			_Расследования КАК _Расследования
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Расследования КАК _РасследованияСобственные
		|				ПО _Расследования.СлужебноеРасследование = _РасследованияСобственные.СлужебноеРасследование
		|					И (_Расследования.Раздел = 1
		|							И _РасследованияСобственные.Раздел > 1
		|						ИЛИ _Расследования.Раздел > 1
		|							И _РасследованияСобственные.Раздел = 1)) КАК ВложенныйЗапрос
		|		ПО _ДепозитныеВклады.ДепозитныйВклад = ВложенныйЗапрос.ДепозитныйВклад
		|			И (_ДепозитныеВкладыСобственные.ДепозитныйВклад = ВложенныйЗапрос.ДепозитныйВкладКонфликтный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПересеченияДепозитныхВкладов.Раздел КАК Раздел,
		|	_ПересеченияДепозитныхВкладов.ВидСвязи КАК ВидСвязи,
		|	_ПересеченияДепозитныхВкладов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ПересеченияДепозитныхВкладов.Банк КАК Банк,
		|	_ПересеченияДепозитныхВкладов.ДатаЗаключенияДоговора КАК ДатаЗаключенияДоговора,
		|	_ПересеченияДепозитныхВкладов.СрокДепозита КАК СрокДепозита,
		|	_ПересеченияДепозитныхВкладов.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	_ПересеченияДепозитныхВкладов.ДепозитныйВклад КАК ДепозитныйВклад,
		|	_ПересеченияДепозитныхВкладов.ДатаПолученияИнформации КАК ДатаПолученияИнформации,
		|	МАКСИМУМ(_ПересеченияДепозитныхВкладов.ЕстьНарушение) КАК ЕстьНарушение,
		|	МАКСИМУМ(_ПересеченияДепозитныхВкладов.ВозможенКонфликт) КАК ВозможенКонфликт,
		|	МАКСИМУМ(_ПересеченияДепозитныхВкладов.СоздатьРасследование) КАК СоздатьРасследование
		|ИЗ
		|	_ПересеченияДепозитныхВкладов КАК _ПересеченияДепозитныхВкладов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПересеченияДепозитныхВкладов.ДатаЗаключенияДоговора,
		|	_ПересеченияДепозитныхВкладов.Банк,
		|	_ПересеченияДепозитныхВкладов.СчетДоверительногоУправления,
		|	_ПересеченияДепозитныхВкладов.Раздел,
		|	_ПересеченияДепозитныхВкладов.ВидСвязи,
		|	_ПересеченияДепозитныхВкладов.ДатаПолученияИнформации,
		|	_ПересеченияДепозитныхВкладов.ДепозитныйВклад,
		|	_ПересеченияДепозитныхВкладов.ПроцентнаяСтавка,
		|	_ПересеченияДепозитныхВкладов.СрокДепозита
		|
		|УПОРЯДОЧИТЬ ПО
		|	Раздел,
		|	СчетДоверительногоУправления,
		|	Банк,
		|	ДатаЗаключенияДоговора
		|ИТОГИ ПО
		|	Раздел
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _ОперацииПоДаннымУК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ДепозитныеВклады
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Расследования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПересеченияДепозитныхВкладов";
	Запрос.Выполнить();
	
	Возврат Выборка;
	
КонецФункции
 
Функция ПолучитьСделки(Запрос)

	ПоместитьСделкиВМенеджерВременныхТаблиц(Запрос);
		
	#Область ТекстЗапроса_выборка
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Сделки.Раздел КАК Раздел,
		|	_Сделки.Сделка КАК Сделка,
		|	СлужебноеРасследованиеСделки.Ссылка КАК СлужебноеРасследование
		|ПОМЕСТИТЬ _Расследования
		|ИЗ
		|	Документ.СлужебноеРасследование.ИнформацияОКонфликте КАК СлужебноеРасследованиеСделки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СлужебноеРасследование КАК СлужебноеРасследование
		|		ПО СлужебноеРасследованиеСделки.Ссылка = СлужебноеРасследование.Ссылка
		|			И (СлужебноеРасследование.Проведен)
		|			И (СлужебноеРасследование.ОбстоятельствоВозникновенияКонфликтаИнтересов В (ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.Сделка), ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.СделкаРЕПО)))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Сделки КАК _Сделки
		|		ПО СлужебноеРасследованиеСделки.ПредметКонфликта = _Сделки.Сделка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Сделки.Раздел КАК Раздел,
		|	_Сделки.ВидСвязи КАК ВидСвязи,
		|	_Сделки.Дата КАК Дата,
		|	_Сделки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Сделки.Сделка КАК Сделка,
		|	_Сделки.Операция КАК Операция,
		|	_Сделки.Эмитент КАК Эмитент,
		|	_Сделки.Рынок КАК Рынок,
		|	_Сделки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Сделки.СерияНомер КАК СерияНомер,
		|	_Сделки.ДатаВыпуска КАК ДатаВыпуска,
		|	_Сделки.ДатаПогашения КАК ДатаПогашения,
		|	_Сделки.Номинал КАК Номинал,
		|	_Сделки.Количество КАК Количество,
		|	_Сделки.Цена КАК Цена,
		|	_Сделки.Сумма КАК Сумма,
		|	_Сделки.СуммаКупона КАК СуммаКупона,
		|	_Сделки.СрокРЕПО КАК СрокРЕПО,
		|	_Сделки.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_Сделки.ДатаОперации КАК ДатаОперации,
		|	_Сделки.ЭтоРЕПО КАК ЭтоРЕПО,
		|	_Сделки.ДатаПолученияИнформации КАК ДатаПолученияИнформации,
		|	ЕСТЬNULL(_Сделки.Раздел < _СделкиСобственные.Раздел
		|				И _Сделки.ДатаОперации > _СделкиСобственные.ДатаОперации
		|			ИЛИ _СделкиСобственные.Раздел < _Сделки.Раздел
		|				И _СделкиСобственные.ДатаОперации > _Сделки.ДатаОперации, ЛОЖЬ) КАК НарушениеПоДате,
		|	ЕСТЬNULL(_Сделки.Раздел < _СделкиСобственные.Раздел
		|				И ВЫБОР
		|					КОГДА _Сделки.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|						ТОГДА _Сделки.Цена < _СделкиСобственные.Цена
		|					ИНАЧЕ _Сделки.Цена > _СделкиСобственные.Цена
		|				КОНЕЦ
		|			ИЛИ _СделкиСобственные.Раздел < _Сделки.Раздел
		|				И ВЫБОР
		|					КОГДА _Сделки.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|						ТОГДА _СделкиСобственные.Цена < _Сделки.Цена
		|					ИНАЧЕ _СделкиСобственные.Цена > _Сделки.Цена
		|				КОНЕЦ, ЛОЖЬ) КАК НарушениеПоЦене,
		|	_Сделки.ЭтоРЕПО
		|		И ЕСТЬNULL(_Сделки.Раздел < _СделкиСобственные.Раздел
		|					И ВЫБОР
		|						КОГДА _Сделки.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|							ТОГДА _Сделки.СтавкаРЕПО > _СделкиСобственные.СтавкаРЕПО
		|						ИНАЧЕ _Сделки.СтавкаРЕПО < _СделкиСобственные.СтавкаРЕПО
		|					КОНЕЦ
		|				ИЛИ _СделкиСобственные.Раздел < _Сделки.Раздел
		|					И ВЫБОР
		|						КОГДА _Сделки.Операция = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|							ТОГДА _СделкиСобственные.СтавкаРЕПО > _Сделки.СтавкаРЕПО
		|						ИНАЧЕ _СделкиСобственные.СтавкаРЕПО < _Сделки.СтавкаРЕПО
		|					КОНЕЦ, ЛОЖЬ) КАК НарушениеПоСтавке,
		|	_СделкиСобственные.Сделка ЕСТЬ НЕ NULL  КАК ВозможенКонфликт,
		|	_СделкиСобственные.Сделка КАК СделкаСобственная,
		|	_СделкиСобственные.Сделка ЕСТЬ НЕ NULL 
		|		И ВложенныйЗапрос.СлужебноеРасследование ЕСТЬ NULL КАК СоздатьРасследование
		|ПОМЕСТИТЬ _ПересеченияСделок
		|ИЗ
		|	_Сделки КАК _Сделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Сделки КАК _СделкиСобственные
		|		ПО _Сделки.Операция = _СделкиСобственные.Операция
		|			И _Сделки.Рынок = _СделкиСобственные.Рынок
		|			И _Сделки.ЦеннаяБумага = _СделкиСобственные.ЦеннаяБумага
		|			И _Сделки.Дата = _СделкиСобственные.Дата
		|			И _Сделки.СрокРЕПО = _СделкиСобственные.СрокРЕПО
		|			И _Сделки.СчетДоверительногоУправления <> _СделкиСобственные.СчетДоверительногоУправления
		|			И (ВЫБОР
		|				КОГДА _Сделки.ЭтоРЕПО
		|					ТОГДА _Сделки.Раздел <= 2
		|								И _СделкиСобственные.Раздел > _Сделки.Раздел
		|							ИЛИ _СделкиСобственные.Раздел <= 2
		|								И _Сделки.Раздел > _СделкиСобственные.Раздел
		|				ИНАЧЕ _Сделки.Раздел = 1
		|							И _СделкиСобственные.Раздел > 1
		|						ИЛИ _Сделки.Раздел > 1
		|							И _СделкиСобственные.Раздел = 1
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Расследования.СлужебноеРасследование КАК СлужебноеРасследование,
		|			_Расследования.Сделка КАК Сделка,
		|			_РасследованияСобственные.Сделка КАК СделкаКонфликтная
		|		ИЗ
		|			_Расследования КАК _Расследования
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Расследования КАК _РасследованияСобственные
		|				ПО _Расследования.СлужебноеРасследование = _РасследованияСобственные.СлужебноеРасследование
		|					И (_Расследования.Раздел <= 2
		|							И _РасследованияСобственные.Раздел > _Расследования.Раздел
		|						ИЛИ _Расследования.Раздел > 2
		|							И _РасследованияСобственные.Раздел < _Расследования.Раздел)) КАК ВложенныйЗапрос
		|		ПО _Сделки.Сделка = ВложенныйЗапрос.Сделка
		|			И (_СделкиСобственные.Сделка = ВложенныйЗапрос.СделкаКонфликтная)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПересеченияСделок.Раздел КАК Раздел,
		|	_ПересеченияСделок.ВидСвязи КАК ВидСвязи,
		|	_ПересеченияСделок.Дата КАК Дата,
		|	_ПересеченияСделок.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ПересеченияСделок.Сделка КАК Сделка,
		|	_ПересеченияСделок.Операция КАК Операция,
		|	_ПересеченияСделок.Эмитент КАК Эмитент,
		|	_ПересеченияСделок.Рынок КАК Рынок,
		|	_ПересеченияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПересеченияСделок.СерияНомер КАК СерияНомер,
		|	_ПересеченияСделок.ДатаВыпуска КАК ДатаВыпуска,
		|	_ПересеченияСделок.ДатаПогашения КАК ДатаПогашения,
		|	_ПересеченияСделок.Номинал КАК Номинал,
		|	_ПересеченияСделок.Количество КАК Количество,
		|	_ПересеченияСделок.Цена КАК Цена,
		|	_ПересеченияСделок.Сумма КАК Сумма,
		|	_ПересеченияСделок.СуммаКупона КАК СуммаКупона,
		|	_ПересеченияСделок.СрокРЕПО КАК СрокРЕПО,
		|	_ПересеченияСделок.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_ПересеченияСделок.ДатаОперации КАК ДатаОперации,
		|	_ПересеченияСделок.ЭтоРЕПО КАК ЭтоРЕПО,
		|	_ПересеченияСделок.ДатаПолученияИнформации КАК ДатаПолученияИнформации,
		|	МАКСИМУМ(_ПересеченияСделок.НарушениеПоДате) КАК НарушениеПоДате,
		|	МАКСИМУМ(_ПересеченияСделок.НарушениеПоЦене) КАК НарушениеПоЦене,
		|	МАКСИМУМ(_ПересеченияСделок.НарушениеПоСтавке) КАК НарушениеПоСтавке,
		|	МАКСИМУМ(_ПересеченияСделок.ВозможенКонфликт) КАК ВозможенКонфликт,
		|	МАКСИМУМ(_ПересеченияСделок.СоздатьРасследование) КАК СоздатьРасследование
		|ИЗ
		|	_ПересеченияСделок КАК _ПересеченияСделок
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПересеченияСделок.Раздел,
		|	_ПересеченияСделок.ВидСвязи,
		|	_ПересеченияСделок.Дата,
		|	_ПересеченияСделок.СчетДоверительногоУправления,
		|	_ПересеченияСделок.Сделка,
		|	_ПересеченияСделок.Операция,
		|	_ПересеченияСделок.Эмитент,
		|	_ПересеченияСделок.Рынок,
		|	_ПересеченияСделок.ЦеннаяБумага,
		|	_ПересеченияСделок.СерияНомер,
		|	_ПересеченияСделок.ДатаВыпуска,
		|	_ПересеченияСделок.ДатаПогашения,
		|	_ПересеченияСделок.Номинал,
		|	_ПересеченияСделок.Количество,
		|	_ПересеченияСделок.Цена,
		|	_ПересеченияСделок.Сумма,
		|	_ПересеченияСделок.СуммаКупона,
		|	_ПересеченияСделок.СрокРЕПО,
		|	_ПересеченияСделок.СтавкаРЕПО,
		|	_ПересеченияСделок.ДатаОперации,
		|	_ПересеченияСделок.ЭтоРЕПО,
		|	_ПересеченияСделок.ДатаПолученияИнформации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Раздел,
		|	ЭтоРЕПО,
		|	СчетДоверительногоУправления,
		|	Дата,
		|	Рынок,
		|	ЦеннаяБумага,
