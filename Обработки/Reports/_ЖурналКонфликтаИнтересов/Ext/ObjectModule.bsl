#КонецОбласти 
// Функция вызывается из обработки _ВыгрузкаСведенийПредоставляемыхЮрФизЛицами
Функция ПолучитьДанныеДляВыгрузки(ДатаПредоставленияИнформации) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", 								ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 								ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", 								ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицоУК", 								ЭтотОбъект.Организация.ЮрФизЛицо);
	Запрос.УстановитьПараметр("ВалютаУчета", 								ЭтотОбъект.Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ТаблицаКлиентов", 							ЭтотОбъект.ТаблицаКлиентов);
	Запрос.УстановитьПараметр("ВыводитьСделкиРЕПО", 						ЭтотОбъект.ВыводитьСделкиРЕПО);
	Запрос.УстановитьПараметр("ВыводитьСделки", 							Истина);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоСобственнымСредствам", 		Ложь);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоАффилированнымЛицам", 		Ложь);
	Запрос.УстановитьПараметр("ВыводитьДанныеПредоставляемыеЮрФизЛицами",	Ложь);
	Запрос.УстановитьПараметр("ВыводитьРазделыПоСотрудникам",				Ложь);
	Запрос.УстановитьПараметр("Календарь",									Константы.ОсновнойКалендарьКотировок.Получить());
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПоместитьСчетаДУВМенеджерВременныхТаблиц(Запрос);
	
	ОбъектыИнвестирования = ПолучитьОбъектыИнвестирования(Запрос, Истина);
	
	ПоместитьСделкиВМенеджерВременныхТаблиц(Запрос);
	Сделки = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_Сделки").Выгрузить();
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДУ.ДатаНачала КАК ДатаНачала,
		|	_СчетаДУ.ДатаОкончания КАК ДатаОкончания,
		|	_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу, РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество) КАК Наименование
		|ИЗ
		|	_СчетаДУ КАК _СчетаДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО _СчетаДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО _СчетаДУ.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)";
	Запрос.УстановитьПараметр("Период", ДатаПредоставленияИнформации);
	Клиенты = Запрос.Выполнить().Выгрузить();
	
	Возврат Новый Структура("Клиенты, ОбъектыИнвестирования, Сделки", Клиенты, ОбъектыИнвестирования, Сделки);

КонецФункции
 

