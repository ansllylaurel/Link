		|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_Операции.Рынок КАК Рынок,
		|			_Операции.ЦеннаяБумага КАК ЦеннаяБумага,
		|			_Операции.Дата КАК Дата,
		|			Паи.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|			Паи.ГосударственныйРегистрационныйНомер КАК ГосударственныйРегистрационныйНомер
		|		ИЗ
		|			_Операции КАК _Операции
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|				ПО _Операции.ЦеннаяБумага = Паи.Ссылка) КАК ВложенныйЗапрос
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
		|			ПО ВложенныйЗапрос.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд
		|				И ВложенныйЗапрос.Дата >= РеквизитыПИФ.Период
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВложенныйЗапрос.ГосударственныйРегистрационныйНомер,
		|		ВложенныйЗапрос.ПаевойИнвестиционныйФонд,
		|		ВложенныйЗапрос.Дата,
		|		ВложенныйЗапрос.ЦеннаяБумага,
		|		ВложенныйЗапрос.Рынок) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
		|		ПО ВложенныйЗапрос.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд
		|			И ВложенныйЗапрос.Период = РеквизитыПИФ.Период
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_Операции.Дата,
		|	_Операции.ЦеннаяБумага,
		|	Векселя.Номинал,
		|	Векселя.Серия + "", "" + Векселя.Номер,
		|	NULL,
		|	NULL,
		|	_Операции.Рынок,
		|	Векселя.Эмитент
		|ИЗ
		|	_Операции КАК _Операции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Векселя КАК Векселя
		|		ПО _Операции.ЦеннаяБумага = Векселя.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_Операции.Дата,
		|	_Операции.ЦеннаяБумага,
		|	0,
		|	ДепозитарныеРасписки.РегистрационныйНомер,
		|	NULL,
		|	NULL,
		|	_Операции.Рынок,
		|	ДепозитарныеРасписки.Эмитент
		|ИЗ
		|	_Операции КАК _Операции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|		ПО _Операции.ЦеннаяБумага = ДепозитарныеРасписки.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_Операции.Дата,
		|	_Операции.ЦеннаяБумага,
		|	0,
		|	ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер,
		|	NULL,
		|	NULL,
		|	_Операции.Рынок,
		|	ИпотечныеСертификатыУчастия.Эмитент
		|ИЗ
		|	_Операции КАК _Операции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|		ПО _Операции.ЦеннаяБумага = ИпотечныеСертификатыУчастия.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Операции.Сделка КАК Сделка,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(ДанныеКалендаря.Дата, 0)) - 1 КАК СрокРЕПО
		|ПОМЕСТИТЬ _СрокиРЕПО
		|ИЗ
		|	_Операции КАК _Операции
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (_Операции.ЭтоРЕПО)
		|			И (ДанныеКалендаря.Дата МЕЖДУ _Операции.Дата И _Операции.ДатаВторойЧастиРЕПО)
		|			И (ДанныеКалендаря.Календарь = &Календарь)
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|
		|СГРУППИРОВАТЬ ПО
		|	_Операции.Сделка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Операции.Раздел КАК Раздел,
		|	_Операции.ВидСвязи КАК ВидСвязи,
		|	_Операции.Дата КАК Дата,
		|	_Операции.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Операции.Сделка КАК Сделка,
		|	_Операции.ВидСделки КАК Операция,
		|	ЕСТЬNULL(Эмитенты.ЮрФизЛицо, ЕСТЬNULL(УправляющиеКомпании.ЮрФизЛицо, ВЫБОР
		|				КОГДА _Операции.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|					ТОГДА _Операции.Эмитент
		|				ИНАЧЕ _Операции.ЮрФизЛицо
		|			КОНЕЦ)) КАК Эмитент,
		|	_Операции.Рынок КАК Рынок,
		|	_Операции.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЕСТЬNULL(_РеквизитыЦенныхБумаг.ГосударственныйРегистрационныйНомер, _Операции.ИдентификаторЦеннойБумаги) КАК СерияНомер,
		|	_РеквизитыЦенныхБумаг.ДатаВыпуска КАК ДатаВыпуска,
		|	_РеквизитыЦенныхБумаг.ДатаПогашения КАК ДатаПогашения,
		|	_РеквизитыЦенныхБумаг.Номинал КАК Номинал,
		|	_Операции.Количество КАК Количество,
		|	_Операции.Цена * КурсыВалютСделок.Курс / КурсыВалютСделок.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК Цена,
		|	_Операции.Сумма * КурсыВалютСделок.Курс / КурсыВалютСделок.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК Сумма,
		|	_Операции.СуммаКупона * КурсыВалютСделок.Курс / КурсыВалютСделок.Кратность / КурсыВалютыУчета.Курс * КурсыВалютыУчета.Кратность КАК СуммаКупона,
		|	ЕСТЬNULL(_Операции.СрокРЕПО, _СрокиРЕПО.СрокРЕПО) КАК СрокРЕПО,
		|	_Операции.СтавкаРЕПО КАК СтавкаРЕПО,
		|	_Операции.ДатаОперации КАК ДатаОперации,
		|	_Операции.ЭтоРЕПО КАК ЭтоРЕПО,
		|	_Операции.ДатаПолученияИнформации КАК ДатаПолученияИнформации
		|ПОМЕСТИТЬ _Сделки
		|ИЗ
		|	_Операции КАК _Операции
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЦенныхБумаг КАК _РеквизитыЦенныхБумаг
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Эмитенты КАК Эмитенты
		|			ПО _РеквизитыЦенныхБумаг.Эмитент = Эмитенты.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УправляющиеКомпании КАК УправляющиеКомпании
		|			ПО _РеквизитыЦенныхБумаг.Эмитент = УправляющиеКомпании.Ссылка
		|		ПО _Операции.Рынок = _РеквизитыЦенныхБумаг.Рынок
		|			И _Операции.ЦеннаяБумага = _РеквизитыЦенныхБумаг.ЦеннаяБумага
		|			И _Операции.Дата = _РеквизитыЦенныхБумаг.Дата
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютСделок
		|		ПО _Операции.Валюта = КурсыВалютСделок.Валюта
		|			И _Операции.Дата = КурсыВалютСделок.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалютыУчета
		|		ПО (КурсыВалютыУчета.Валюта = &ВалютаУчета)
		|			И _Операции.Дата = КурсыВалютыУчета.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СрокиРЕПО КАК _СрокиРЕПО
		|		ПО _Операции.Сделка = _СрокиРЕПО.Сделка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Рынок,
		|	ЦеннаяБумага,
		|	Сделка";		
	#КонецОбласти 
	
	Запрос.Выполнить();

КонецПроцедуры

Процедура ПоместитьДепозитыВМенеджерВременныхТаблиц(Запрос)

	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДУ.Раздел КАК Раздел,
		|	_СчетаДУ.ВидСвязи КАК ВидСвязи,
		|	_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Банки.ЮрФизЛицо КАК Банк,
		|	ВЫБОР
		|		КОГДА ДепозитныеВклады.ДатаПодтверждения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА Договоры.ДатаЗаключения
		|		ИНАЧЕ ДепозитныеВклады.ДатаПодтверждения
		|	КОНЕЦ КАК ДатаЗаключенияДоговора,
		|	РАЗНОСТЬДАТ(ВЫБОР
		|			КОГДА ДепозитныеВклады.ДатаПодтверждения = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА Договоры.ДатаЗаключения
		|			ИНАЧЕ ДепозитныеВклады.ДатаПодтверждения
		|		КОНЕЦ, ЕСТЬNULL(УсловияКредитныхИнструментовСрезПервых.ДатаПогашения, ДАТАВРЕМЯ(1, 1, 1)), ДЕНЬ) КАК СрокДепозита,
		|	УсловияКредитныхИнструментовСрезПервых.Процент КАК ПроцентнаяСтавка,
		|	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад
		|ПОМЕСТИТЬ _ОперацииПоДаннымУК
		|ИЗ
		|	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			УсловияКредитныхИнструментовСрезПервых.КредитныйИнструмент КАК КредитныйИнструмент,
		|			УсловияКредитныхИнструментовСрезПервых.ДатаПогашения КАК ДатаПогашения,
		|			УсловияКредитныхИнструментовСрезПервых.Процент КАК Процент
		|		ИЗ
		|			(ВЫБРАТЬ
		|				УсловияКредитныхИнструментовСрезПервых.КредитныйИнструмент КАК КредитныйИнструмент,
		|				МИНИМУМ(УсловияКредитныхИнструментовСрезПервых.ДатаНачалаДействияУсловий) КАК ДатаНачалаДействияУсловий
		|			ИЗ
		|				РегистрСведений.УсловияКредитныхИнструментов.СрезПервых(, ) КАК УсловияКредитныхИнструментовСрезПервых
		|			ГДЕ
		|				УсловияКредитныхИнструментовСрезПервых.Действует
		|			
		|			СГРУППИРОВАТЬ ПО
		|				УсловияКредитныхИнструментовСрезПервых.КредитныйИнструмент) КАК АктуальныеДатыНачалаДействия
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПервых(, ) КАК УсловияКредитныхИнструментовСрезПервых
		|				ПО АктуальныеДатыНачалаДействия.КредитныйИнструмент = УсловияКредитныхИнструментовСрезПервых.КредитныйИнструмент
		|					И АктуальныеДатыНачалаДействия.ДатаНачалаДействияУсловий = УсловияКредитныхИнструментовСрезПервых.ДатаНачалаДействияУсловий) КАК УсловияКредитныхИнструментовСрезПервых
		|		ПО ДепозитныеВклады.Ссылка = УсловияКредитныхИнструментовСрезПервых.КредитныйИнструмент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ПО БанковскиеСчета.Банк = Банки.Ссылка
		|		ПО ДепозитныеВклады.БанковскийСчет = БанковскиеСчета.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|		ПО (БанковскиеСчета.Договор = Договоры.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления КАК ДоговорыСчетовДоверительногоУправления
		|		ПО (Договоры.Ссылка = ДоговорыСчетовДоверительногоУправления.Договор)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДУ КАК _СчетаДУ
		|		ПО (_СчетаДУ.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправления.СчетДоверительногоУправления)
		|			И (ВЫБОР
		|				КОГДА ДепозитныеВклады.ДатаПодтверждения = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА Договоры.ДатаЗаключения
		|				ИНАЧЕ ДепозитныеВклады.ДатаПодтверждения
		|			КОНЕЦ МЕЖДУ _СчетаДУ.ДатаНачала И _СчетаДУ.ДатаОкончания)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_СчетаДУ.Раздел,
		|	_СчетаДУ.ВидСвязи,
		|	_СчетаДУ.СчетДоверительногоУправления,
		|	Банки.ЮрФизЛицо,
		|	НАЧАЛОПЕРИОДА(ДокументМНО.Дата, ДЕНЬ),
		|	РАЗНОСТЬДАТ(ДокументМНО.Дата, ДокументМНО.ДатаВозврата, ДЕНЬ),
		|	ДокументМНО.Процент,
		|	ДенежныеСредстваМНООстаткиИОбороты.МНО
		|ИЗ
		|	_СчетаДУ КАК _СчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваМНО.ОстаткиИОбороты(
		|				&ДатаНачала,
		|				&ДатаОкончания,
		|				День,
		|				,
		|				(Организация, СчетДоверительногоУправления) В
		|					(ВЫБРАТЬ
		|						&Организация,
		|						_СчетаДУ.СчетДоверительногоУправления
		|					ИЗ
		|						_СчетаДУ КАК _СчетаДУ)) КАК ДенежныеСредстваМНООстаткиИОбороты
		|		ПО _СчетаДУ.СчетДоверительногоУправления = ДенежныеСредстваМНООстаткиИОбороты.СчетДоверительногоУправления
		|			И (ДенежныеСредстваМНООстаткиИОбороты.Период МЕЖДУ _СчетаДУ.ДатаНачала И _СчетаДУ.ДатаОкончания)
		|			И (ДенежныеСредстваМНООстаткиИОбороты.СуммаКонечныйОстаток > 0)
		|			И (ДенежныеСредстваМНООстаткиИОбороты.Период = НАЧАЛОПЕРИОДА(ДенежныеСредстваМНООстаткиИОбороты.МНО.Дата, ДЕНЬ))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.МНО КАК ДокументМНО
		|		ПО (ДенежныеСредстваМНООстаткиИОбороты.МНО = ДокументМНО.Ссылка)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
		|			ПО БанковскиеСчета.Банк = Банки.Ссылка
		|		ПО (ДенежныеСредстваМНООстаткиИОбороты.РасчетныйСчет = БанковскиеСчета.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииПоДаннымУК.Раздел КАК Раздел,
		|	_ОперацииПоДаннымУК.ВидСвязи КАК ВидСвязи,
		|	_ОперацииПоДаннымУК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОперацииПоДаннымУК.Банк КАК Банк,
		|	_ОперацииПоДаннымУК.ДатаЗаключенияДоговора КАК ДатаЗаключенияДоговора,
		|	_ОперацииПоДаннымУК.СрокДепозита КАК СрокДепозита,
		|	_ОперацииПоДаннымУК.ПроцентнаяСтавка КАК ПроцентнаяСтавка,
		|	_ОперацииПоДаннымУК.ДепозитныйВклад КАК ДепозитныйВклад,
		|	ВложенныйЗапрос.ДатаПолученияИнформации КАК ДатаПолученияИнформации
		|ПОМЕСТИТЬ _ДепозитныеВклады
		|ИЗ
		|	_ОперацииПоДаннымУК КАК _ОперацииПоДаннымУК
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_ОперацииПоДаннымУК.ДатаЗаключенияДоговора КАК ДатаЗаключенияДоговора,
		|			МИНИМУМ(ДанныеКалендаря.Дата) КАК ДатаПолученияИнформации
		|		ИЗ
		|			_ОперацииПоДаннымУК КАК _ОперацииПоДаннымУК
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|				ПО _ОперацииПоДаннымУК.ДатаЗаключенияДоговора < ДанныеКалендаря.Дата
		|					И (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|					И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ОперацииПоДаннымУК.ДатаЗаключенияДоговора) КАК ВложенныйЗапрос
		|		ПО _ОперацииПоДаннымУК.ДатаЗаключенияДоговора = ВложенныйЗапрос.ДатаЗаключенияДоговора
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ДепозитныйВклад";		
	#КонецОбласти
	
	Запрос.Выполнить();

КонецПроцедуры

Процедура УничтожитьВременныеТаблицы(Запрос)
	
	МассивТекстов = Новый Массив;
	
	Для каждого Таблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
	
		Если Не Таблица.ПолноеИмя = "_СчетаДУ" Тогда
			МассивТекстов.Добавить("УНИЧТОЖИТЬ " + Таблица.ПолноеИмя);
		КонецЕсли;
	
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(МассивТекстов, "; " + Символы.ПС);		
	Запрос.Выполнить();

КонецПроцедуры

Функция ПолучитьАффилированныеЛица(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	1 КАК Раздел,
		|	АффилированныеЛицаСрезПоследних.Период КАК Период,
		|	АффилированныеЛицаСрезПоследних.АффилированноеЛицо КАК АффилированноеЛицо,
		|	АффилированныеЛицаСрезПоследних.Основание КАК Основание,
		|	АффилированныеЛицаСрезПоследних.ДатаОснования КАК ДатаОснования,
		|	АффилированныеЛицаСрезПоследних.ДоляАкций КАК ДоляАкций,
		|	АффилированныеЛицаСрезПоследних.СодержаниеИзменения КАК СодержаниеИзменения,
		|	АффилированныеЛицаСрезПоследних.Адрес КАК Адрес,
		|	АффилированныеЛицаСрезПоследних.ПолноеИмя КАК ПолноеИмя,
		|	&ДатаОкончания КАК ДатаРеквизитов
		|ПОМЕСТИТЬ _АффилированныеЛица
		|ИЗ
		|	РегистрСведений.АффилированныеЛица.СрезПоследних(&ДатаНачала, ЮридическоеЛицо = &ЮрФизЛицоУК) КАК АффилированныеЛицаСрезПоследних
		|ГДЕ
		|	АффилированныеЛицаСрезПоследних.ЯвляетсяАффилированным
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА АффилированныеЛица.ЯвляетсяАффилированным
		|			ТОГДА 2
		|		ИНАЧЕ 3
		|	КОНЕЦ,
		|	АффилированныеЛица.Период,
		|	АффилированныеЛица.АффилированноеЛицо,
		|	АффилированныеЛица.Основание,
		|	АффилированныеЛица.ДатаОснования,
		|	АффилированныеЛица.ДоляАкций,
		|	АффилированныеЛица.СодержаниеИзменения,
		|	АффилированныеЛица.Адрес,
		|	АффилированныеЛица.ПолноеИмя,
		|	АффилированныеЛица.Период
		|ИЗ
		|	РегистрСведений.АффилированныеЛица КАК АффилированныеЛица
		|ГДЕ
		|	АффилированныеЛица.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И АффилированныеЛица.ЮридическоеЛицо = &ЮрФизЛицоУК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_АффилированныеЛица.Раздел КАК Раздел,
		|	_АффилированныеЛица.Период КАК Период,
		|	_АффилированныеЛица.АффилированноеЛицо КАК АффилированноеЛицо,
		|	_АффилированныеЛица.Основание КАК Основание,
		|	_АффилированныеЛица.ДатаОснования КАК ДатаОснования,
		|	_АффилированныеЛица.ДоляАкций КАК ДоляАкций,
		|	_АффилированныеЛица.СодержаниеИзменения КАК СодержаниеИзменения,
		|	_АффилированныеЛица.Адрес КАК Адрес,
		|	_АффилированныеЛица.ПолноеИмя КАК Наименование
		|ИЗ
		|	_АффилированныеЛица КАК _АффилированныеЛица
		|
		|УПОРЯДОЧИТЬ ПО
		|	Раздел,
		|	Период,
		|	Наименование
		|ИТОГИ ПО
		|	Раздел";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _АффилированныеЛица";
	Запрос.Выполнить();
	
	Возврат Выборка;

КонецФункции

Функция ПолучитьСовместноеВладение(Запрос)

	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеКалендаря.Дата КАК Дата,
		|	МАКСИМУМ(_ОборотыЦенныхБумаг.Период) КАК Период,
		|	_СчетаДУ.Раздел КАК Раздел,
		|	_СчетаДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ЦенныеБумаги.Рынок КАК Рынок,
		|	_ЦенныеБумаги.ТипЗадолженности КАК ТипЗадолженности,
		|	_СчетаДУ.ДатаНачала КАК ДатаНачала,
		|	_СчетаДУ.ДатаОкончания КАК ДатаОкончания,
		|	_СчетаДУ.ВидСвязи КАК ВидСвязи
		|ПОМЕСТИТЬ _ПериодыПолученияОстатков
		|ИЗ
		|	_СчетаДУ КАК _СчетаДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (ДанныеКалендаря.Дата МЕЖДУ _СчетаДУ.ДатаНачала И _СчетаДУ.ДатаОкончания)
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОборотыЦенныхБумаг КАК _ЦенныеБумаги
		|		ПО _СчетаДУ.СчетДоверительногоУправления = _ЦенныеБумаги.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОборотыЦенныхБумаг КАК _ОборотыЦенныхБумаг
		|		ПО _СчетаДУ.СчетДоверительногоУправления = _ОборотыЦенныхБумаг.СчетДоверительногоУправления
		|			И (_ЦенныеБумаги.ТипЗадолженности = _ОборотыЦенныхБумаг.ТипЗадолженности)
		|			И (_ЦенныеБумаги.ЦеннаяБумага = _ОборотыЦенныхБумаг.ЦеннаяБумага)
		|			И (_ОборотыЦенныхБумаг.Период >= ДанныеКалендаря.Дата)
		|
		|СГРУППИРОВАТЬ ПО
		|	_СчетаДУ.Раздел,
		|	_СчетаДУ.СчетДоверительногоУправления,
		|	_ЦенныеБумаги.ЦеннаяБумага,
		|	_ЦенныеБумаги.Рынок,
		|	_ЦенныеБумаги.ТипЗадолженности,
		|	_СчетаДУ.ДатаНачала,
		|	_СчетаДУ.ДатаОкончания,
		|	_СчетаДУ.ВидСвязи,
		|	ДанныеКалендаря.Дата
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления,
		|	ТипЗадолженности,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПериодыПолученияОстатков.Дата КАК Дата,
		|	_ПериодыПолученияОстатков.Раздел КАК Раздел,
		|	_ПериодыПолученияОстатков.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ПериодыПолученияОстатков.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПериодыПолученияОстатков.Рынок КАК Рынок,
		|	_ПериодыПолученияОстатков.ТипЗадолженности КАК ТипЗадолженности,
		|	_ПериодыПолученияОстатков.ДатаНачала КАК ДатаНачала,
		|	_ПериодыПолученияОстатков.ДатаОкончания КАК ДатаОкончания,
		|	_ПериодыПолученияОстатков.ВидСвязи КАК ВидСвязи,
		|	ВЫБОР
		|		КОГДА _ПериодыПолученияОстатков.Период = _ПериодыПолученияОстатков.Дата
		|			ТОГДА _ОборотыЦенныхБумаг.КоличествоКонечныйОстаток
		|		ИНАЧЕ _ОборотыЦенныхБумаг.КоличествоНачальныйОстаток
		|	КОНЕЦ КАК КоличествоОстаток,
		|	ВложенныйЗапрос.ДатаПолученияИнформации КАК ДатаПолученияИнформации
		|ПОМЕСТИТЬ _Остатки
		|ИЗ
		|	_ПериодыПолученияОстатков КАК _ПериодыПолученияОстатков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОборотыЦенныхБумаг КАК _ОборотыЦенныхБумаг
		|		ПО _ПериодыПолученияОстатков.СчетДоверительногоУправления = _ОборотыЦенныхБумаг.СчетДоверительногоУправления
		|			И (_ОборотыЦенныхБумаг.ТипЗадолженности = _ПериодыПолученияОстатков.ТипЗадолженности)
		|			И (_ОборотыЦенныхБумаг.ЦеннаяБумага = _ПериодыПолученияОстатков.ЦеннаяБумага)
		|			И (_ОборотыЦенныхБумаг.Период = _ПериодыПолученияОстатков.Период)
		|			//И (_ОборотыЦенныхБумаг.КоличествоКонечныйОстаток <> 0)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_ПериодыПолученияОстатков.Дата КАК ДатаОстатка,
		|			МИНИМУМ(ДанныеКалендаря.Дата) КАК ДатаПолученияИнформации
		|		ИЗ
		|			_ПериодыПолученияОстатков КАК _ПериодыПолученияОстатков
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|				ПО _ПериодыПолученияОстатков.Дата < ДанныеКалендаря.Дата
		|					И (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|					И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_ПериодыПолученияОстатков.Дата) КАК ВложенныйЗапрос
		|		ПО _ПериодыПолученияОстатков.Дата = ВложенныйЗапрос.ДатаОстатка
		|ГДЕ ВЫБОР
		|		КОГДА _ПериодыПолученияОстатков.Период = _ПериодыПолученияОстатков.Дата
		|			ТОГДА _ОборотыЦенныхБумаг.КоличествоКонечныйОстаток
		|		ИНАЧЕ _ОборотыЦенныхБумаг.КоличествоНачальныйОстаток
		|	КОНЕЦ <> 0
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведенияПредоставляемыеЮрФизЛицами.ОкончаниеПериода,
		|	_СчетаДУ.Раздел,
		|	_СчетаДУ.СчетДоверительногоУправления,
		|	СведенияПредоставляемыеЮрФизЛицамиОбъектыИнвестирования.ЦеннаяБумага,
		|	СведенияПредоставляемыеЮрФизЛицамиОбъектыИнвестирования.Рынок,
		|	НЕОПРЕДЕЛЕНО,
		|	_СчетаДУ.ДатаНачала,
		|	_СчетаДУ.ДатаОкончания,
		|	_СчетаДУ.ВидСвязи,
		|	СведенияПредоставляемыеЮрФизЛицамиОбъектыИнвестирования.КонечныйОстаток,
		|	НАЧАЛОПЕРИОДА(СведенияПредоставляемыеЮрФизЛицами.Дата, ДЕНЬ)
		|ИЗ
		|	_СчетаДУ КАК _СчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СведенияПредоставляемыеЮрФизЛицами КАК СведенияПредоставляемыеЮрФизЛицами
		|		ПО _СчетаДУ.СчетДоверительногоУправления = СведенияПредоставляемыеЮрФизЛицами.ИсточникСведений
		|			И (СведенияПредоставляемыеЮрФизЛицами.Проведен)
		|			И (СведенияПредоставляемыеЮрФизЛицами.ОкончаниеПериода МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СведенияПредоставляемыеЮрФизЛицами.ОбъектыИнвестирования КАК СведенияПредоставляемыеЮрФизЛицамиОбъектыИнвестирования
		|		ПО (СведенияПредоставляемыеЮрФизЛицамиОбъектыИнвестирования.Ссылка = СведенияПредоставляемыеЮрФизЛицами.Ссылка)
		|			И (СведенияПредоставляемыеЮрФизЛицамиОбъектыИнвестирования.КонечныйОстаток <> 0)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетДоверительногоУправления,
		|	ТипЗадолженности,
		|	ЦеннаяБумага
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СлужебноеРасследованиеЦенныеБумаги.Ссылка КАК СлужебноеРасследование,
		|	_Остатки.Раздел КАК Раздел,
		|	_Остатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Остатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Остатки.Рынок КАК Рынок,
		|	_Остатки.Дата КАК Дата
		|ПОМЕСТИТЬ _Расследования
		|ИЗ
		|	_Остатки КАК _Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СлужебноеРасследование.ЦенныеБумаги КАК СлужебноеРасследованиеЦенныеБумаги
		|		ПО (СлужебноеРасследованиеЦенныеБумаги.Счет = _Остатки.СчетДоверительногоУправления)
		|			И (СлужебноеРасследованиеЦенныеБумаги.Рынок = _Остатки.Рынок)
		|			И (СлужебноеРасследованиеЦенныеБумаги.ЦеннаяБумага = _Остатки.ЦеннаяБумага)
		|			И (СлужебноеРасследованиеЦенныеБумаги.ВидСвязи = _Остатки.ВидСвязи)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СлужебноеРасследование КАК СлужебноеРасследование
		|		ПО (СлужебноеРасследованиеЦенныеБумаги.Ссылка = СлужебноеРасследование.Ссылка)
		|			И (СлужебноеРасследование.Проведен)
		|			И _Остатки.Дата = СлужебноеРасследование.ДатаСделки
		|			И (СлужебноеРасследование.ОбстоятельствоВозникновенияКонфликтаИнтересов = ЗНАЧЕНИЕ(Справочник.ОбстоятельстваВозникновенияКонфликтаИнтересов.СовместноеВладение))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Остатки.Дата КАК Дата,
		|	_Остатки.Раздел КАК Раздел,
		|	_Остатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Остатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_Остатки.Рынок КАК Рынок,
		|	_Остатки.ТипЗадолженности КАК ТипЗадолженности,
		|	_Остатки.ДатаНачала КАК ДатаНачала,
		|	_Остатки.ДатаОкончания КАК ДатаОкончания,
		|	_Остатки.ВидСвязи КАК ВидСвязи,
		|	_Остатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ВложенныйЗапрос.СлужебноеРасследование ЕСТЬ NULL КАК СоздатьРасследование,
		|	_Остатки.ДатаПолученияИнформации КАК ДатаПолученияИнформации
		|ПОМЕСТИТЬ _ПересеченияСделок
		|ИЗ
		|	_Остатки КАК _Остатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Остатки КАК _ОстаткиСобственные
		|		ПО _Остатки.Рынок = _ОстаткиСобственные.Рынок
		|			И _Остатки.ЦеннаяБумага = _ОстаткиСобственные.ЦеннаяБумага
		|			И _Остатки.Дата = _ОстаткиСобственные.Дата
		|			И _Остатки.СчетДоверительногоУправления <> _ОстаткиСобственные.СчетДоверительногоУправления
		|			И (_Остатки.Раздел = 1
		|					И _ОстаткиСобственные.Раздел > 1
		|				ИЛИ _Остатки.Раздел > 1
		|					И _ОстаткиСобственные.Раздел = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Расследования.СлужебноеРасследование КАК СлужебноеРасследование,
		|			_Расследования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|			_Расследования.ЦеннаяБумага КАК ЦеннаяБумага,
		|			_Расследования.Рынок КАК Рынок,
		|			_Расследования.Дата КАК Дата,
		|			_РасследованияСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправленияКонфл,
		|			_РасследованияСобственные.ЦеннаяБумага КАК ЦеннаяБумагаКонфл,
		|			_РасследованияСобственные.Рынок КАК РынокКонфл,
		|			_РасследованияСобственные.Дата КАК ДатаКонфл
		|		ИЗ
		|			_Расследования КАК _Расследования
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Расследования КАК _РасследованияСобственные
		|				ПО _Расследования.СлужебноеРасследование = _РасследованияСобственные.СлужебноеРасследование
		|					И (_Расследования.Раздел = 1
		|							И _РасследованияСобственные.Раздел > 1
		|						ИЛИ _Расследования.Раздел > 1
		|							И _РасследованияСобственные.Раздел = 1)) КАК ВложенныйЗапрос
		|		ПО _Остатки.Рынок = ВложенныйЗапрос.Рынок
		|			И _Остатки.ЦеннаяБумага = ВложенныйЗапрос.ЦеннаяБумага
		|			И _Остатки.Дата = ВложенныйЗапрос.Дата
		|			И _Остатки.СчетДоверительногоУправления = ВложенныйЗапрос.СчетДоверительногоУправления
		|			И (_ОстаткиСобственные.Рынок = ВложенныйЗапрос.РынокКонфл)
		|			И (_ОстаткиСобственные.ЦеннаяБумага = ВложенныйЗапрос.ЦеннаяБумагаКонфл)
		|			И (_ОстаткиСобственные.Дата = ВложенныйЗапрос.ДатаКонфл)
		|			И (_ОстаткиСобственные.СчетДоверительногоУправления = ВложенныйЗапрос.СчетДоверительногоУправленияКонфл)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПересеченияСделок.Дата КАК Дата,
		|	_ПересеченияСделок.Раздел КАК Раздел,
		|	_ПересеченияСделок.СчетДоверительногоУправления КАК Счет,
		|	_ПересеченияСделок.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПересеченияСделок.Рынок КАК Рынок,
		|	_ПересеченияСделок.ТипЗадолженности КАК ТипЗадолженности,
		|	_ПересеченияСделок.ДатаНачала КАК ДатаНачала,
		|	_ПересеченияСделок.ДатаОкончания КАК ДатаОкончания,
		|	_ПересеченияСделок.ВидСвязи КАК ВидСвязи,
		|	_ПересеченияСделок.КоличествоОстаток КАК Количество,
		|	МАКСИМУМ(_ПересеченияСделок.СоздатьРасследование) КАК СоздатьРасследование,
		|	_ПересеченияСделок.ДатаПолученияИнформации КАК ДатаПолученияИнформации
		|ИЗ
		|	_ПересеченияСделок КАК _ПересеченияСделок
		|
		|СГРУППИРОВАТЬ ПО
		|	_ПересеченияСделок.Дата,
		|	_ПересеченияСделок.ЦеннаяБумага,
		|	_ПересеченияСделок.Раздел,
		|	_ПересеченияСделок.Рынок,
		|	_ПересеченияСделок.СчетДоверительногоУправления,
		|	_ПересеченияСделок.ДатаНачала,
		|	_ПересеченияСделок.ТипЗадолженности,
		|	_ПересеченияСделок.КоличествоОстаток,
		|	_ПересеченияСделок.ДатаОкончания,
		|	_ПересеченияСделок.ВидСвязи,
		|	_ПересеченияСделок.ДатаПолученияИнформации
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Рынок,
		|	ЦеннаяБумага,
		|	Раздел,
		|	Счет";
	
	#КонецОбласти 
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	// убиваем лишнее
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _ОборотыЦенныхБумаг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ПериодыПолученияОстатков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Остатки";
	
	Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();

