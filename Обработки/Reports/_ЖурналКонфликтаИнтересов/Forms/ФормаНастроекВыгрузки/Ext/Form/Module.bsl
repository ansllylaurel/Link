
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.АдресСтруктурыОтчетов = Параметры.АдресСтруктурыОтчетов;
	
	ЭтаФорма.СохранитьАффилированныеЛица = Истина;
	ЭтаФорма.СохранитьОбъектыИСделки = Истина;
	ЭтаФорма.СохранитьСовместноеВладение = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПоказатьДиалогВыбораФайла();
	
КонецПроцедуры
	
#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПоказатьДиалогВыбораФайла();
	
КонецПроцедуры

#КонецОбласти 

#Область Команды_формы

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить путь к файлу", , "ПутьКФайлу");
		Возврат;
	КонецЕсли; 
	
	Если Не (ЭтаФорма.СохранитьАффилированныеЛица Или ЭтаФорма.СохранитьОбъектыИСделки Или ЭтаФорма.СохранитьОбъектыИСделки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран ни один раздел для сохранения");
		Возврат;
	КонецЕсли; 
	
	СтруктураРазделов = Новый Структура;
	СтруктураРазделов.Вставить("ОбъектыИСделки", "Объекты и сделки");
	СтруктураРазделов.Вставить("СовместноеВладение", "Совместное владение");
	СтруктураРазделов.Вставить("АффилированныеЛица", "Аффилированные лица");
	
	СтруктураОтчета = ПолучитьИзВременногоХранилища(АдресСтруктурыОтчетов);
	
	ПакетОтображаемыхДокументов = Новый ПакетОтображаемыхДокументов;
	
	Для каждого РазделОтчета Из СтруктураРазделов Цикл
	
		Если ЭтаФорма["Сохранить" + РазделОтчета.Ключ] Тогда
			НовыйЭлемент = ПакетОтображаемыхДокументов.Состав.Добавить(ПоместитьВоВременноеХранилище(СтруктураОтчета[РазделОтчета.Ключ], ЭтаФорма.УникальныйИдентификатор));
			НовыйЭлемент.Наименование = РазделОтчета.Значение; 		
		КонецЕсли; 
	
	КонецЦикла; 
	
	Файл = Новый Файл(ЭтаФорма.ПутьКФайлу);
	Расширение = Сред(Файл.Расширение, 2);
	
	Попытка
		ПакетОтображаемыхДокументов.Записать(ЭтаФорма.ПутьКФайлу, ТипФайлаПакетаОтображаемыхДокументов[Расширение]);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать файл. Система сообщает: " + Символы.ПС + ОписаниеОшибки()); 
	КонецПопытки;
	
	Закрыть();
		
КонецПроцедуры

#КонецОбласти 

#Область Служебные_процедуры_и_функции

&НаКлиенте
Процедура ПоказатьДиалогВыбораФайла();

	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Фильтр = "Книга Excel (*.xlsx)|*.xlsx|Книга Excel 97-2003 (*.xls)|*.xls";
	
	Если ЗначениеЗаполнено(ЭтаФорма.ПутьКФайлу) Тогда
		ДиалогВыбора.ПолноеИмяФайла = ЭтаФорма.ПутьКФайлу;
	КонецЕсли; 
	
	Если ДиалогВыбора.Выбрать() Тогда
		ЭтаФорма.ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

