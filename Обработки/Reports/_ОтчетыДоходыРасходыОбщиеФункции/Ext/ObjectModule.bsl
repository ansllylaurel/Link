КонецФункции	

Процедура ЗапомнитьСумму(ИмяПараметра, ЗначениеПараметра, ОбластиИЗначения, Замена = Ложь)
	
	Перем ТекущееЗначение;
	
	Если ОбластиИЗначения.Свойство(ИмяПараметра, ТекущееЗначение) И НЕ Замена Тогда 
		ОбластиИЗначения[ИмяПараметра] = ТекущееЗначение + ЗначениеПараметра;
	Иначе
		ОбластиИЗначения.Вставить(ИмяПараметра, ЗначениеПараметра);
	КонецЕсли;			
	
КонецПроцедуры

Процедура ВРасшифровку(Имя, СтрокаТаблицыРезультов, Фильтр, ТабРасшифровки)
	
	СтрокаРасшифровки = ТабРасшифровки.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаТаблицыРезультов);
	СтрокаРасшифровки.Фильтр = Фильтр;
	СтрокаРасшифровки.СтрокаОтчета = Имя;
	
КонецПроцедуры	

Процедура ВнестиВПрочие(ТаблицаПрочих, ПрочиеДоходыРасходы, Сумма)
	
	Строка = ТаблицаПрочих.Найти(ПрочиеДоходыРасходы, "ПрочиеДоходыРасходы");
	Если Строка = Неопределено Тогда 
		Строка = ТаблицаПрочих.Добавить();
		Строка.ПрочиеДоходыРасходы = ПрочиеДоходыРасходы;
	КонецЕсли;	
	Строка.Сумма = Строка.Сумма + Сумма;	
	
КонецПРоцедуры	

Функция ВернутьСохраненноеЗначение(ИмяПараметра, ОбластиИЗначения) Экспорт
	
	Перем Рез;
	
	Если ОбластиИЗначения.Свойство(ИмяПараметра, Рез) Тогда 
		Возврат Рез;
	Иначе
		Возврат 0;
	КонецЕсли;	
	
КонецФункции	

Функция РасчетФормулы(Формула, ОбластиИЗначения, Знак)
	
	Рез = 0;
	
	СтрокаФормула = "Рез = ВернутьСохраненноеЗначение(""" + Формула;
	СтрокаФормула = СтрЗаменить(СтрокаФормула, "+", """)+ВернутьСохраненноеЗначение(""");
	СтрокаФормула = СтрЗаменить(СтрокаФормула, "-", """)-ВернутьСохраненноеЗначение(""");
	СтрокаФормула = СтрокаФормула+""")";
	СтрокаФормула = СтрЗаменить(СтрокаФормула, ")", ", ОбластиИЗначения)");
	
	Выполнить(СтрокаФормула);
	
	Рез = Рез*Знак;
	
	Возврат Рез;
	
КонецФункции

Процедура РасчетИтогов(вхТаблица, ОбластиИЗначения)	Экспорт
	
	вхТаблица.Сортировать("ПорядокРасчета Убыв");
	КоличествоЦиклов = вхТаблица[0].ПорядокРасчета;
	
	Для пц = 1 по КоличествоЦиклов Цикл 
		Отбор = Новый Структура();
		Отбор.Вставить("ПорядокРасчета", пц);
		НайденныеСтроки = вхТаблица.НайтиСтроки(Отбор);
		Для Каждого СтрокаТаблицы из НайденныеСтроки Цикл
			Значение = РасчетФормулы(СтрокаТаблицы.Формула, ОбластиИЗначения, СтрокаТаблицы.Знак);
			ЗапомнитьСумму(СтрокаТаблицы.ИмяПараметра, Значение, ОбластиИЗначения, Истина);				
		КонецЦикла;			
	КонецЦикла;	
	
КонецПРоцедуры	

Процедура РаспределениеРезультата(ТаблицаРезультат, ТаблицаНастройки, ЯчейкаПрочиеДоходы, ЯчейкаПрочиеРасходы, ОбластиИЗначения, ТабРасшифровки, ПрочиеДоходы, ПрочиеРасходы, ИтогиСразу = Истина) Экспорт

	ТаблицаРезультат.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастройки Цикл 
		Если СтрокаТаблицыНастроек.ИтоговаяСтрока Тогда 
			Продолжить;
		КонецЕсли;
		
		Имя = СтрокаТаблицыНастроек.ИмяПараметра;
		Значение = 0;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Счет", СтрокаТаблицыНастроек.Счет);
		Отбор.Вставить("ПрочиеДоходыРасходы", СтрокаТаблицыНастроек.СтатьяДоходаРасхода);
		Если СтрокаТаблицыНастроек.ПризнакОРЦБ <> Перечисления.ВидыОбращенияНаОРЦБ.ПустаяСсылка() Тогда
			Отбор.Вставить("ОбращаетсяНаОРЦБ", СтрокаТаблицыНастроек.ПризнакОРЦБ);
		КонецЕсли;
		Отбор.Вставить("Используется", Ложь);      // если два вида актива (гос и гос в валюте) используют одну статью дохода, задвоения не будет 
		
		НайденныеСтроки =  ТаблицаРезультат.НайтиСтроки(Отбор);
		Для Каждого СтрокаТаблицыРезультов Из НайденныеСтроки Цикл 
			Значение = СтрокаТаблицыНастроек.Знак * (СтрокаТаблицыРезультов.СуммаОборотКт + СтрокаТаблицыРезультов.СуммаОборотДт);
					
			УсловиеКоррСчет = ФильтрКоррСчет(СтрокаТаблицыРезультов.КорСчет,СтрокаТаблицыНастроек.ФильтрКорСчет); 
			УсловиеЦеннаяБумага = ВходитВФильтр(СтрокаТаблицыРезультов.ЦенныеБумаги, СтрокаТаблицыНастроек.Фильтр, СтрокаТаблицыРезультов.ОбращаетсяНаОРЦБ, СтрокаТаблицыРезультов.СтранаРегистрации, СтрокаТаблицыРезультов.Регистратор.Дата);  
			УсловиеРегистратор = ФильрДок(СтрокаТаблицыРезультов.Регистратор, СтрокаТаблицыНастроек.ФильтрДок);
			
			Если УсловиеКоррСчет И УсловиеЦеннаяБумага И УсловиеРегистратор Тогда 
				СтрокаТаблицыРезультов.Используется = Истина;
				ЗапомнитьСумму(Имя, Значение, ОбластиИЗначения);
				ВРасшифровку(Имя, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Фильтр, ТабРасшифровки);
			КонецЕсли;	
		КонецЦикла;			
	КонецЦикла;	
	
	//прочие
	Для Каждого СтрокаТаблицыРезультов из ТаблицаРезультат Цикл
		Если СтрокаТаблицыРезультов.Используется Тогда 
			Продолжить;
		КонецЕсли;		
		Значение = (СтрокаТаблицыРезультов.СуммаОборотКт + СтрокаТаблицыРезультов.СуммаОборотДт);
			
		ПрочиеДоходыРасходы = СтрокаТаблицыРезультов.ПрочиеДоходыРасходы;
		
		Если (СтрокаТаблицыРезультов.Счет = ПланыСчетов.Основной.ПрочиеДоходы) ИЛИ (СтрокаТаблицыРезультов.Счет = ПланыСчетов.Основной.Выручка) Тогда 
			ВнестиВПрочие(ПрочиеДоходы, ПрочиеДоходыРасходы, Значение);
			ВРасшифровку(ЯчейкаПрочиеДоходы, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Фильтр, ТабРасшифровки);
		ИначеЕсли (СтрокаТаблицыРезультов.Счет = ПланыСчетов.Основной.ПрочиеРасходы) ИЛИ (СтрокаТаблицыРезультов.Счет = ПланыСчетов.Основной.СебестоимостьПродажи) Тогда 
			ВнестиВПрочие(ПрочиеРасходы, ПрочиеДоходыРасходы, Значение);
			ВРасшифровку(ЯчейкаПрочиеРасходы, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Фильтр, ТабРасшифровки);
		КонецЕсли;			
	КонецЦикла;
	
	ЗапомнитьСумму(ЯчейкаПрочиеДоходы, ПрочиеДоходы.Итог("Сумма"), ОбластиИЗначения);
	ЗапомнитьСумму(ЯчейкаПрочиеРасходы, ПрочиеРасходы.Итог("Сумма"), ОбластиИЗначения);
	
	//итоги
	Если ИтогиСразу Тогда 
		РасчетИтогов(ТаблицаНастройки, ОбластиИЗначения);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура РаспределениеРезультатаЕСП(ТаблицаРезультат, ТаблицаНастройки, ЯчейкаПрочиеДоходы, ЯчейкаПрочиеРасходы, ОбластиИЗначения, ТабРасшифровки, ПрочиеДоходыЕПС, ПрочиеРасходыЕПС)	Экспорт
	
	ТаблицаРезультат.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастройки Цикл 
		Если СтрокаТаблицыНастроек.ИтоговаяСтрока Тогда 
			Продолжить;
		КонецЕсли;
		
		Имя = СтрокаТаблицыНастроек.ИмяПараметра;
		Значение = 0;
		
		Для Каждого СтрокаТаблицыРезультов из ТаблицаРезультат Цикл 
			Если СтрокаТаблицыНастроек.СчетРодитель = СтрокаТаблицыРезультов.СчетРодитель.Код Тогда 
				Условие = СтрокаТаблицыНастроек.Условие;
				УдовлетворяетУсловиюСчет = Ложь;
				УдовлетворяетУсловиюГФУ = Ложь;
				УдовлетворяетУсловиюФильтр = Ложь;
				Если Условие="=" Тогда 
					Если СтрокаТаблицыНастроек.Счет=СтрокаТаблицыРезультов.Счет.Код Тогда 
						УдовлетворяетУсловиюСчет = Истина;
					КонецЕсли;	
				ИначеЕсли Условие="<>" Тогда
					Если СтрокаТаблицыНастроек.Счет<>СтрокаТаблицыРезультов.Счет.Код Тогда 
						УдовлетворяетУсловиюСчет = Истина;
					КонецЕсли;						
				КонецЕсли;
				
				Если НЕ УдовлетворяетУсловиюСчет Тогда 
					Продолжить;
				КонецЕсли;	
				
				Если ПустаяСтрока(СтрокаТаблицыНастроек.ГФУ) Тогда
					УдовлетворяетУсловиюГФУ = Истина;
				Иначе	
					Если СтрокаТаблицыНастроек.ГФУ = СтрокаТаблицыРезультов.ГФУ.Код Тогда 
						УдовлетворяетУсловиюГФУ = Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ УдовлетворяетУсловиюГФУ Тогда 
					Продолжить;
				КонецЕсли;	
				
				УсловиеКоррСчет = ФильтрКоррСчет(СтрокаТаблицыРезультов.КорСчет,СтрокаТаблицыНастроек.ФильтрКорСчет); 
				УсловиеЦеннаяБумага = ВходитВФильтр(СтрокаТаблицыРезультов.ЦенныеБумаги, СтрокаТаблицыНастроек.Фильтр, СтрокаТаблицыРезультов.ОбращаетсяНаОРЦБ, СтрокаТаблицыРезультов.СтранаРегистрации, СтрокаТаблицыРезультов.Регистратор.Дата);  
				
				Если УсловиеКоррСчет И УсловиеЦеннаяБумага Тогда
					УдовлетворяетУсловиюФильтр = Истина
				КонецЕсли;	
			
				Если НЕ УдовлетворяетУсловиюФильтр Тогда 
					Продолжить;
				КонецЕсли;	
				
				//Если УдовлетворяетУсловиюСчет И УдовлетворяетУсловиюГФУ И УдовлетворяетУсловиюФильтр Тогда 
					Доход = СтрокаТаблицыРезультов.СуммаОборотКт;
					Расход = СтрокаТаблицыРезультов.СуммаОборотДт;
					
					Если СтрокаТаблицыНастроек.СуммаВОтчет = "Доход" Тогда 
						Значение = СтрокаТаблицыНастроек.Знак * Доход;
						СтрокаТаблицыРезультов.СуммаОборотДт = 0;  //чтобы в расшифровке было все красиво и понятно
					ИначеЕсли СтрокаТаблицыНастроек.СуммаВОтчет = "Расход" Тогда 
						Значение = СтрокаТаблицыНастроек.Знак * Расход;
						СтрокаТаблицыРезультов.СуммаОборотКт = 0;
					ИначеЕсли СтрокаТаблицыНастроек.СуммаВОтчет = "Оборот" Тогда 
						Значение = СтрокаТаблицыНастроек.Знак * (Доход - Расход);
					ИначеЕсли СтрокаТаблицыНастроек.СуммаВОтчет = "ОстатокДебет" Тогда 
						Значение = СтрокаТаблицыНастроек.Знак * СтрокаТаблицыРезультов.СуммаКонечныйОстатокДт; 
					ИначеЕсли СтрокаТаблицыНастроек.СуммаВОтчет = "ОстатокКредит" Тогда 	
						Значение = СтрокаТаблицыНастроек.Знак * СтрокаТаблицыРезультов.СуммаКонечныйОстатокКт;
					КонецЕсли;	
					СтрокаТаблицыРезультов.Используется = Истина;
					ЗапомнитьСумму(Имя, Значение, ОбластиИЗначения);	
					ВРасшифровку(Имя, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Фильтр, ТабРасшифровки);
					//восстановим значения. они могут понадобиться в других строках
					Если СтрокаТаблицыНастроек.СуммаВОтчет = "Доход" Тогда 
						СтрокаТаблицыРезультов.СуммаОборотДт = Расход;  
					ИначеЕсли СтрокаТаблицыНастроек.СуммаВОтчет = "Расход" Тогда 
						СтрокаТаблицыРезультов.СуммаОборотКт = Доход;
					КонецЕсли;	
				//КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
	КонецЦикла;	
		
	Для Каждого СтрокаТаблицыРезультов из ТаблицаРезультат Цикл
		Если СтрокаТаблицыРезультов.Используется Тогда 
			Продолжить;
		КонецЕсли;	
		Если СтрокаТаблицыРезультов.СуммаОборотКт>0 Тогда 
			ВнестиВПрочие(ПрочиеДоходыЕПС, "", СтрокаТаблицыРезультов.СуммаОборотКт);
			ВРасшифровку(ЯчейкаПрочиеДоходы, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Фильтр, ТабРасшифровки);			
		КонецЕсли;
		Если СтрокаТаблицыРезультов.СуммаОборотДт>0 Тогда 
			ВнестиВПрочие(ПрочиеРасходыЕПС, "", СтрокаТаблицыРезультов.СуммаОборотДт);
			ВРасшифровку(ЯчейкаПрочиеРасходы, СтрокаТаблицыРезультов, СтрокаТаблицыНастроек.Фильтр, ТабРасшифровки);						
		КонецЕсли;
	КонецЦикла;	
	ЗапомнитьСумму(ЯчейкаПрочиеДоходы, ПрочиеДоходыЕПС.Итог("Сумма"), ОбластиИЗначения);
	ЗапомнитьСумму(ЯчейкаПрочиеРасходы, ПрочиеРасходыЕПС.Итог("Сумма"), ОбластиИЗначения);
	
	//итоги
	РасчетИтогов(ТаблицаНастройки, ОбластиИЗначения);
		
КонецПроцедуры	

#КонецОбласти

#Область Печать

Процедура ЗаполнениеОбластиЗначениями(ОбластьОтчет, ОбластиИЗначения)   Экспорт
	
	Для Каждого ЗначениеСтруктуры из ОбластиИЗначения Цикл 	
		Ячейка = ОбластьОтчет.Области.Найти(ЗначениеСтруктуры.Ключ);
		Ячейка.Значение = ЗначениеСтруктуры.Значение;
	КонецЦикла;	
		
КонецПроцедуры

Процедура РасшифровкаПрочиеДоходыРасходы(Что, ОбластьОтчет, Макет, ТаблицаПрочих)	Экспорт
	                                                                                                              
	ОбластьПрочиеДоходыРасходы = Макет.ПолучитьОбласть(Что);

	КоличествоПрочих = 1;
	Для Каждого СтрокаДР ИЗ ТаблицаПрочих Цикл 
		Если КоличествоПрочих = 1 Тогда 
			ТипСмещения = ТипСмещенияТабличногоДокумента.БезСмещения;
		Иначе
			ТипСмещения = ТипСмещенияТабличногоДокумента.ПоВертикали;
		КонецЕсли;	
		
		ОбластьПрочиеДоходыРасходы.Параметры.ПрочиеДоходыРасходы = СтрокаДР.ПрочиеДоходыРасходы;
		ОбластьПрочиеДоходыРасходы.Параметры.Сумма = СтрокаДР.Сумма;
		ОбластьОтчет.ВставитьОбласть(ОбластьПрочиеДоходыРасходы.Область(), ОбластьОтчет.Область(Что), ТипСмещения, Истина );
		КоличествоПрочих = КоличествоПрочих + 1;
	КонецЦикла;	
	
КонецПроцедуры

Процедура ПечатьРасшифровки(Макет, ДокументРасшифровка, РабочаяТаблица)  Экспорт
		
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьИтог = Макет.ПолучитьОбласть("Итог");
	
	ДокументРасшифровка.Вывести(ОбластьШапка);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ТаблицаИтоги = РабочаяТаблица.Скопировать();
	ТаблицаИтоги.Свернуть("СтрокаОтчета", "СуммаОборотКт, СуммаОборотДт");
	
	Для Каждого СтрИтог из ТаблицаИтоги Цикл 
		ЗаполнитьЗначенияСвойств(ОбластьИтог.Параметры, СтрИтог);
		ОбластьИтог.Параметры.СтрокаОтчета = ОбластьИтог.Параметры.СтрокаОтчета;
		ДокументРасшифровка.Вывести(ОбластьИтог);
		                                                                        
		Отбор = Новый Структура;
		Отбор.Вставить("СтрокаОтчета", СтрИтог.СтрокаОтчета);
		
		МассивСтрок = РабочаяТаблица.НайтиСтроки(Отбор);
		
		ДокументРасшифровка.НачатьГруппуСтрок(, Ложь);
		Для Каждого СтрокаРасшифровка из МассивСтрок Цикл 
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаРасшифровка);			
			ДокументРасшифровка.Вывести(ОбластьСтрока);
		КонецЦикла;	
		ДокументРасшифровка.ЗакончитьГруппуСтрок();
	
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

Процедура ПроверкаНастроек(ДокументРезультат, ТаблицаНастройки, Параметры)   Экспорт
	
	ДокументРезультат.Очистить();
	МакетОшибки = ПолучитьМакет("ОшибкиНастройки");
				
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаНастройки.ИмяПараметра КАК ИмяПараметра,
		|	_ТаблицаНастройки.ИтоговаяСтрока КАК ИтоговаяСтрока,
		|	_ТаблицаНастройки.ПорядокРасчета КАК ПорядокРасчета,
		|	_ТаблицаНастройки.Знак КАК Знак,
		|	_ТаблицаНастройки.Счет КАК Счет,
		|	_ТаблицаНастройки.Регистр КАК Регистр,
		|	_ТаблицаНастройки.Аналитика КАК Аналитика,
		|	_ТаблицаНастройки.УчетныйАктив КАК УчетныйАктив,
		|	_ТаблицаНастройки.ПризнакОРЦБ КАК ПризнакОРЦБ,
		|	_ТаблицаНастройки.ФильтрДок КАК ФильтрДок,
		|	_ТаблицаНастройки.ФильтрКорСчет КАК ФильтрКорСчет,
		|	_ТаблицаНастройки.Фильтр КАК Фильтр,
		|	_ТаблицаНастройки.СтатьяДоходаРасхода КАК СтатьяДоходаРасхода
		|ПОМЕСТИТЬ _ТаблицаНастройки
		|ИЗ
		|	&ВнешняяТаблица КАК _ТаблицаНастройки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаНастройки.ИмяПараметра КАК ИмяПараметра,
		|	_ТаблицаНастройки.Счет КАК Счет,
		|	_ТаблицаНастройки.ПризнакОРЦБ КАК ПризнакОРЦБ,
		|	_ТаблицаНастройки.ФильтрДок КАК ФильтрДок,
		|	_ТаблицаНастройки.ФильтрКорСчет КАК ФильтрКорСчет,
		|	_ТаблицаНастройки.Фильтр КАК Фильтр,
		|	_ТаблицаНастройки.СтатьяДоходаРасхода КАК СтатьяДоходаРасхода,
		|	_ТаблицаНастройки.Регистр КАК Регистр,
		|	_ТаблицаНастройки.Аналитика КАК Аналитика,
		|	_ТаблицаНастройки.УчетныйАктив КАК УчетныйАктив
		|ПОМЕСТИТЬ _ИсходнаяТаблица
		|ИЗ
		|	_ТаблицаНастройки КАК _ТаблицаНастройки
		|ГДЕ
		|	_ТаблицаНастройки.ИтоговаяСтрока = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ИсходнаяТаблица.ИмяПараметра) КАК ИмяПараметра,
		|	_ИсходнаяТаблица.Счет КАК Счет,
		|	_ИсходнаяТаблица.ПризнакОРЦБ КАК ПризнакОРЦБ,
		|	_ИсходнаяТаблица.ФильтрДок КАК ФильтрДок,
		|	_ИсходнаяТаблица.ФильтрКорСчет КАК ФильтрКорСчет,
		|	_ИсходнаяТаблица.Фильтр КАК Фильтр,
		|	_ИсходнаяТаблица.СтатьяДоходаРасхода КАК СтатьяДоходаРасхода,
		|	_ИсходнаяТаблица.Аналитика КАК Аналитика,
		|	_ИсходнаяТаблица.УчетныйАктив КАК УчетныйАктив,
		|	_ИсходнаяТаблица.Регистр КАК Регистр
		|ПОМЕСТИТЬ _СтатьиДоходаНеуникальные
		|ИЗ
		|	_ИсходнаяТаблица КАК _ИсходнаяТаблица
		|ГДЕ
		|	_ИсходнаяТаблица.СтатьяДоходаРасхода <> ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИсходнаяТаблица.Счет,
		|	_ИсходнаяТаблица.ПризнакОРЦБ,
		|	_ИсходнаяТаблица.ФильтрДок,
		|	_ИсходнаяТаблица.ФильтрКорСчет,
		|	_ИсходнаяТаблица.Фильтр,
		|	_ИсходнаяТаблица.СтатьяДоходаРасхода,
		|	_ИсходнаяТаблица.Аналитика,
		|	_ИсходнаяТаблица.УчетныйАктив,
		|	_ИсходнаяТаблица.Регистр
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _ИсходнаяТаблица.ИмяПараметра) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИсходнаяТаблица.ИмяПараметра КАК ИмяПараметра,
		|	_ИсходнаяТаблица.Счет КАК Счет,
		|	_ИсходнаяТаблица.ПризнакОРЦБ КАК ПризнакОРЦБ,
		|	_ИсходнаяТаблица.ФильтрДок КАК ФильтрДок,
		|	_ИсходнаяТаблица.ФильтрКорСчет КАК ФильтрКорСчет,
		|	_ИсходнаяТаблица.Фильтр КАК Фильтр,
		|	_ИсходнаяТаблица.СтатьяДоходаРасхода КАК СтатьяДоходаРасхода,
		|	_ИсходнаяТаблица.Регистр КАК Регистр,
		|	_ИсходнаяТаблица.Аналитика КАК Аналитика,
		|	_ИсходнаяТаблица.УчетныйАктив КАК УчетныйАктив
		|ПОМЕСТИТЬ _НеправильнаяНастройка
		|ИЗ
		|	_ИсходнаяТаблица КАК _ИсходнаяТаблица
		|ГДЕ
		|	_ИсходнаяТаблица.Регистр = """"
		|	И _ИсходнаяТаблица.УчетныйАктив = """"
