КонецФункции	
	

#КонецОбласти

#Область РаспределениеРезультата

Функция ВходитВФильтр(вхЦеннаяБумага, Фильтр, ОбращаетсяНаОРЦБ, СтранаРегистрации, вхДата)
	
	Если ПустаяСтрока(Фильтр) Тогда 
		Возврат Истина;
	КонецЕсли;
	
	НачальнаяДатаРамещения = Дата(2017,1,1);    
	Если ВхДата >= Дата(2024, 11, 1) Тогда 
		УчитыватьСтрануРегистрации = Истина;
	Иначе                         
		УчитыватьСтрануРегистрации  = Ложь;
	КонецЕсли;
	
	Если Фильтр = "Корпоративные20" Тогда 
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда 
				Если  НЕ (вхЦеннаяБумага.ДатаНачалаРазмещения >= НачальнаяДатаРамещения 
					И (НЕ УчитыватьСтрануРегистрации ИЛИ (СтранаРегистрации = Справочники.СтраныМира.Россия И УчитыватьСтрануРегистрации))
					И ОбращаетсяНаОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.Обращается) Тогда 
					Возврат Истина;
				КонецЕсли;	
		    КонецЕсли;			
		КонецЕсли;	
	ИначеЕсли Фильтр = "Корпоративные15" Тогда 
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Корпоративная Тогда 
				Если вхЦеннаяБумага.ДатаНачалаРазмещения >= НачальнаяДатаРамещения 
					И (НЕ УчитыватьСтрануРегистрации ИЛИ (СтранаРегистрации = Справочники.СтраныМира.Россия И УчитыватьСтрануРегистрации))
					И ОбращаетсяНаОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.Обращается Тогда 
					Возврат Истина;
				КонецЕсли;	
		    КонецЕсли;			
		КонецЕсли;
	ИначеЕсли Фильтр = "СубФед" Тогда 
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Субфедеральная Тогда 
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли Фильтр = "НеСубФед" Тогда 	
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория <> Перечисления.КатегорииОблигаций.Субфедеральная Тогда 
				Возврат Истина;      //типа я верю, что сюда попадают только госы.
			КонецЕсли;				
		КонецЕсли;
	ИначеЕсли Фильтр = "ОФЗ" Тогда		
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда 
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;			
	ИначеЕсли Фильтр = "неОФЗ" Тогда	
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория <> Перечисления.КатегорииОблигаций.Государственная Тогда 
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;							
	ИначеЕсли Фильтр = "ОФЗПК" Тогда
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда 
				Если вхЦеннаяБумага.Тип = Перечисления.ТипыОблигаций.КупоннаяПК Тогда 
				     Возврат Истина;
				КонецЕсли;	 
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли Фильтр = "ОФЗнеПК" Тогда	
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Государственная Тогда 
				Если вхЦеннаяБумага.Тип <> Перечисления.ТипыОблигаций.КупоннаяПК Тогда 
				     Возврат Истина;
				КонецЕсли;	 
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли Фильтр = "ОМЗ" Тогда		
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория = Перечисления.КатегорииОблигаций.Муниципальная Тогда 
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;			
	ИначеЕсли Фильтр = "неОМЗ" Тогда	
		Если ТипЗнч(вхЦеннаяБумага) = Тип("СправочникСсылка.Облигации") Тогда 
			Если вхЦеннаяБумага.Категория <> Перечисления.КатегорииОблигаций.Муниципальная Тогда 
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;							
	КонецЕсли;	
	
	
	Возврат Ложь;
		
КонецФункции	

Функция ФильтрКоррСчет(КоррСчет, Фильтр)
	
	Если ПустаяСтрока(Фильтр) Тогда 
		Возврат Истина;
	КонецЕсли;
	
	// правильно это будет сделать через настройки учета
	// вследствие цейтнота временно делаю так.
	
	Если Фильтр = "Активы" Тогда 
		Если Лев(КоррСчет.Код,2)="58" Тогда 		
			Возврат Истина;
		КонецЕсли;	
	ИначеЕсли Фильтр = "Комиссии" Тогда 
		Если Лев(КоррСчет.Код,2)<>"58" Тогда 		  //76.16, 60.5
			Возврат Истина;
		КонецЕсли;	
	ИначеЕсли Фильтр = "НКДуплаченный" Тогда    
		Если Лев(КоррСчет.Код,2)="58" Тогда 		
			Возврат Истина;                    
		КонецЕсли;			              
	ИначеЕсли Фильтр = "НКДначисленный" Тогда	
		Если Лев(КоррСчет.Код,4)="76.П" Тогда 		
			Возврат Истина;
		КонецЕсли;			
	ИначеЕсли Фильтр = "НЕ47903" Тогда 
		Если Не Лев(КоррСчет.Код,5)="47903" Тогда 		
			Возврат Истина;
		КонецЕсли;	
	ИначеЕсли Фильтр = "47903" Тогда	
		Если Лев(КоррСчет.Код,5)="47903" Тогда 		
			Возврат Истина;
		КонецЕсли;			
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции

