	Возврат РегистрационныеДанные;
	
КонецФункции

#Область ОтчетыОДоходахИРасходах

Функция ПолучитьНастройкиУчетаАктивов(Организация, СчетДоверительногоУправления, Период, ВидУчета)	Экспорт
	
	ЗапросНастройкиУчетаАктивов = Новый Запрос;
	ЗапросНастройкиУчетаАктивов.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаАктивовСрезПоследних.УчетныйАктив КАК УчетныйАктив,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов КАК АналитикаДоходов,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
	|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаДоходовОтРеализации,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
	|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаДоходовПоследнееПогашение,
	|	ВЫБОР
	|		КОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходов
	|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтРеализации
	|				И НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки <> НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПоследнееПогашение
	|			ТОГДА НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовОтПереоценки
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК АналитикаДоходовОтПереоценки,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаПерекурсовки КАК АналитикаПерекурсовки,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовИндексацииНоминала КАК АналитикаДоходовИндексацииНоминала,
	|	НастройкиУчетаАктивовСрезПоследних.АналитикаДоходовПогашенияИндексируемогоНоминала КАК АналитикаДоходовПогашенияИндексируемогоНоминала
	|ИЗ
	|	РегистрСведений.НастройкиУчетаАктивов.СрезПоследних(
	|			&ОтчетнаяДата,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления В (&СчетДУ)
	|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаАктивовСрезПоследних";
		
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("СчетДУ", СчетДоверительногоУправления);
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("Организация", Организация);
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("ОтчетнаяДата", КонецДня(Период));
	ЗапросНастройкиУчетаАктивов.УстановитьПараметр("ВидУчета", ВидУчета);
	
	Возврат ЗапросНастройкиУчетаАктивов.Выполнить().Выгрузить();	
	
КонецФункции

Функция ПолучитьНастройкиУчетаКомиссии(Организация, СчетДоверительногоУправления, Период, ВидУчета)	Экспорт
	
	ЗапросНастройкиУчетаКомиссии = Новый Запрос;
	ЗапросНастройкиУчетаКомиссии.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиУчетаКомиссииСрезПоследних.ВидЗадолженности КАК ВидЗадолженности,
	|	НастройкиУчетаКомиссииСрезПоследних.Аналитика КАК Аналитика,
	|	НастройкиУчетаКомиссииСрезПоследних.АналитикаРЕПО КАК АналитикаРЕПО
	|ИЗ
	|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
	|			&ОтчетнаяДата,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДУ
	|				И ВидУчета = &ВидУчета) КАК НастройкиУчетаКомиссииСрезПоследних";
		
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("СчетДУ", СчетДоверительногоУправления);
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("Организация", Организация);
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("ОтчетнаяДата", КонецДня(Период));
	ЗапросНастройкиУчетаКомиссии.УстановитьПараметр("ВидУчета", ВидУчета);
	
	Возврат ЗапросНастройкиУчетаКомиссии.Выполнить().Выгрузить();	
	
КонецФункции	

Функция ПолучитьСтатьюДоходаРасходаИзНастройки(МестоХраненияНастройки, УчетныйАктив, ВидАналитики, НастройкиУчетаАктивов, НастройкиУчетаКомиссии) Экспорт
	
	Если МестоХраненияНастройки <> "ПоКоду" Тогда
		Если ПустаяСтрока(УчетныйАктив) ИЛИ ПустаяСтрока(ВидАналитики) Тогда 
			ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
			Возврат ПрочиеДоходыРасходы;
		КонецЕсли;	
	КонецЕсли;
	
	Если МестоХраненияНастройки = "НастройкиУчетаАктивов" Тогда 		
		
		Актив = Справочники.УчетныеАктивы[СокрЛП(УчетныйАктив)];
		
		Колонка = НастройкиУчетаАктивов.Колонки.Найти(ВидАналитики);
		
		СтрокаТЗ = НастройкиУчетаАктивов.Найти(Актив, "УчетныйАктив"); 		
		Если СтрокаТЗ <> Неопределено Тогда 
			ПрочиеДоходыРасходы = СтрокаТЗ[Колонка.Имя];
		Иначе
			ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
		КонецЕсли;
		
		Возврат ПрочиеДоходыРасходы;
	ИначеЕсли МестоХраненияНастройки = "НастройкиУчетаКомиссии" Тогда 
		
		Актив = Справочники.ВидыЗадолженности[СокрЛП(УчетныйАктив)];
		
		СтрокаТЗ = НастройкиУчетаКомиссии.Найти(Актив, "ВидЗадолженности"); 		
		Если СтрокаТЗ <> Неопределено Тогда 
			ПрочиеДоходыРасходы = СтрокаТЗ[ВидАналитики];
		Иначе
			ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
		КонецЕсли;
		
		Возврат ПрочиеДоходыРасходы;
		
	ИначеЕсли МестоХраненияНастройки = "ПоКоду" Тогда 
				
		ПрочиеДоходыРасходы = Справочники.ПрочиеДоходыИРасходы.НайтиПоКоду(СокрЛП(УчетныйАктив));
		Возврат ПрочиеДоходыРасходы;
		
	КонецЕсли;
		
КонецФункции	

Функция ПолучитьТаблицуНастроекИзМакета(Макет, ИмяЗаголовки, ИмяДанные, ИмяКолонки, НастройкиУчетаАктивов, НастройкиУчетаКомиссии)  Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1000));
	ТипЧисло = Новый ОписаниеТипов("Число"); 
	
	ОбластьЗаголовки = Макет.ПолучитьОбласть(ИмяЗаголовки + "|" + ИмяКолонки);
	ОбластьДанные = Макет.ПолучитьОбласть(ИмяДанные + "|" + ИмяКолонки);
	
	Рез = Новый ТаблицаЗначений;
		
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		НаименованиеКолонки = ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст; 
		Если НаименованиеКолонки = "ИтоговаяСтрока" ИЛИ НаименованиеКолонки = "ПорядокРасчета" ИЛИ НаименованиеКолонки = "Знак" Тогда 
			ТипКолонки = ТипЧисло;
		ИначеЕсли НаименованиеКолонки = "Счет" Тогда 
			ТипКолонки = Новый ОписаниеТипов("ПланСчетовСсылка.Основной");
		ИначеЕсли НаименованиеКолонки = "ПризнакОРЦБ" Тогда 
			ТипКолонки = Новый  ОписаниеТипов("ПеречислениеСсылка.ВидыОбращенияНаОРЦБ");
		Иначе
			ТипКолонки = ТипСтрока;
		КонецЕсли;	
		
		Рез.Колонки.Добавить(НаименованиеКолонки, ТипКолонки);
		
	КонецЦикла;	
	
	Рез.Колонки.Добавить("СтатьяДоходаРасхода", Новый ОписаниеТипов("СправочникСсылка.ПрочиеДоходыИРасходы"));
	
	Для индСтроки = 1 по КоличествоСтрок Цикл 
		НоваяСтрока = Рез.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл 
			ТекстЯчейки = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;
			Если Рез.Колонки[индКолонки - 1].Имя = "Счет" Тогда 
				Если ТекстЯчейки = "91.1" Тогда
					НоваяСтрока[ИндКолонки-1] = ПланыСчетов.Основной.ПрочиеДоходы;
				ИначеЕсли ТекстЯчейки = "91.2" Тогда	
					НоваяСтрока[ИндКолонки-1] = ПланыСчетов.Основной.ПрочиеРасходы;
				ИначеЕсли ТекстЯчейки = "90.1.1" Тогда
					НоваяСтрока[ИндКолонки-1] = ПланыСчетов.Основной.Выручка;
				ИначеЕсли ТекстЯчейки = "90.2.1" Тогда	
					НоваяСтрока[ИндКолонки-1] = ПланыСчетов.Основной.СебестоимостьПродажи;
				КонецЕсли;						
			ИначеЕсли Рез.Колонки[индКолонки - 1].Имя = "ПризнакОРЦБ" Тогда 
				Если ТекстЯчейки = "Обращается" Тогда
					НоваяСтрока[ИндКолонки-1] = Перечисления.ВидыОбращенияНаОРЦБ.Обращается;
				ИначеЕсли ТекстЯчейки= "НеОбращается" Тогда	
					НоваяСтрока[ИндКолонки-1] = Перечисления.ВидыОбращенияНаОРЦБ.НеОбращается;
				Иначе	
					НоваяСтрока[ИндКолонки-1] = Перечисления.ВидыОбращенияНаОРЦБ.ПустаяСсылка();
				КонецЕсли;	
			Иначе	
				НоваяСтрока[ИндКолонки-1] = ТекстЯчейки;
			КонецЕсли;
			Если Не НоваяСтрока.ИтоговаяСтрока Тогда 
				НоваяСтрока.СтатьяДоходаРасхода = ПолучитьСтатьюДоходаРасходаИзНастройки(НоваяСтрока.Регистр, НоваяСтрока.УчетныйАктив, НоваяСтрока.Аналитика, НастройкиУчетаАктивов, НастройкиУчетаКомиссии);
			КонецЕсли;	
			
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Рез;
	
КонецФункции	


Функция ТабличныйДокументВТаблицуЗначений(Макет, ИмяЗаголовки, ИмяДанные, ИмяКолонки)  Экспорт
		
	ОбластьЗаголовки = Макет.ПолучитьОбласть(ИмяЗаголовки + "|" + ИмяКолонки);
	ОбластьДанные = Макет.ПолучитьОбласть(ИмяДанные + "|" + ИмяКолонки);
	
	Рез = Новый ТаблицаЗначений;
		
	КоличествоКолонок = ОбластьЗаголовки.ШиринаТаблицы;
	КоличествоСтрок = ОбластьДанные.ВысотаТаблицы;
	
	Для инд = 1 по КоличествоКолонок Цикл 
		Рез.Колонки.Добавить(ОбластьЗаголовки.ПолучитьОбласть(1, инд).ТекущаяОбласть.Текст);
	КонецЦикла;	
	
	Для индСтроки = 1 по КоличествоСтрок Цикл 
		НоваяСтрока = Рез.Добавить();
		Для индКолонки = 1 по КоличествоКолонок Цикл 
			НоваяСтрока[ИндКолонки-1] = ОбластьДанные.ПолучитьОбласть(индСтроки, индКолонки).ТекущаяОбласть.Текст;		
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат Рез;
	
КонецФункции	

Процедура ОбработатьТаблицуНастроек(ТаблицаНастройки, НастройкиУчетаАктивов, НастройкиУчетаКомиссии, Режим = "НУ") Экспорт 
		
	Если Режим = "НУ" Тогда 
		ТаблицаНастройки.Колонки.Добавить("СтатьяДоходаРасхода");
	КонецЕсли;	
	
	Для Каждого СтрокаТЗ из ТаблицаНастройки Цикл 
		СтрокаТЗ.ИтоговаяСтрока = Булево(Число(СтрокаТЗ.ИтоговаяСтрока));
		СтрокаТЗ.ПорядокРасчета = Число(СтрокаТЗ.ПорядокРасчета);
		СтрокаТЗ.Знак = Число(СтрокаТЗ.Знак);
		
		Если Режим = "НУ" Тогда 
			Если СтрокаТЗ.Счет= "91.1" Тогда
				СтрокаТЗ.Счет = ПланыСчетов.Основной.ПрочиеДоходы;
			ИначеЕсли СтрокаТЗ.Счет= "91.2" Тогда	
				СтрокаТЗ.Счет = ПланыСчетов.Основной.ПрочиеРасходы;
			ИначеЕсли СтрокаТЗ.Счет= "90.1.1" Тогда
				СтрокаТЗ.Счет = ПланыСчетов.Основной.Выручка;
			ИначеЕсли СтрокаТЗ.Счет= "90.2.1" Тогда	
				СтрокаТЗ.Счет = ПланыСчетов.Основной.СебестоимостьПродажи;
			КонецЕсли;		
			Если СтрокаТЗ.ПризнакОРЦБ = "Обращается" Тогда
				СтрокаТЗ.ПризнакОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.Обращается;
			ИначеЕсли СтрокаТЗ.ПризнакОРЦБ= "НеОбращается" Тогда	
				СтрокаТЗ.ПризнакОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.НеОбращается;
			Иначе	
				СтрокаТЗ.ПризнакОРЦБ = Перечисления.ВидыОбращенияНаОРЦБ.ПустаяСсылка();
			КонецЕсли;	
			Если Не СтрокаТЗ.ИтоговаяСтрока Тогда 
				СтрокаТЗ.СтатьяДоходаРасхода = ПолучитьСтатьюДоходаРасходаИзНастройки(СтрокаТЗ.Регистр, СтрокаТЗ.УчетныйАктив, СтрокаТз.Аналитика, НастройкиУчетаАктивов, НастройкиУчетаКомиссии);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	МассивКолонок = Новый Массив;
	Для Каждого Колонка из ТаблицаНастройки.Колонки Цикл 
		Если Колонка.Имя <> "УчетныйАктив" Тогда 
			МассивКолонок.Добавить(Колонка.Имя);
		КонецЕсли;			
	КонецЦикла;	
	ТаблицаНастройки.Свернуть(СтрСоединить(МассивКолонок, ","));
	
КонецПроцедуры	

Функция ЗапросДоходыРасходы(Организация, СчетДоверительногоУправления, Период, ВидУчета = "НалоговыйУчет", ДатаНачальная="", ВариантФОГФ = Ложь)  Экспорт
			
	Запрос = Новый Запрос;
	
	Если НЕ ВариантФОГФ Тогда 
	//Если ВидУчета = "НалоговыйУчет" Тогда 
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Обороты.Регистратор КАК Регистратор,
		|	Обороты.Счет КАК Счет,
		|	Обороты.КорСчет КАК КорСчет,
		|	Обороты.Субконто1 КАК ПрочиеДоходыРасходы,
		|	Обороты.Субконто3 КАК ОбращаетсяНаОРЦБ,
		|	Обороты.Субконто2 КАК ЦенныеБумаги,
		|	0 КАК СуммаОборотДт,
		|	Обороты.СуммаОборотКт КАК СуммаОборотКт,
