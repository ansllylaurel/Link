		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			ТОГДА ОстаткиДенежныхСредств.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаПриход,
	ВЫБОР
		КОГДА ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			ТОГДА ОстаткиДенежныхСредств.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаРасход,
	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаНачальныйОстаток,
