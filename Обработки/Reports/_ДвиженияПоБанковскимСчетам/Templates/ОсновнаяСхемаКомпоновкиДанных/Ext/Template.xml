		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаРасход КАК СуммаРасход,
	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.Период КАК Период,
	РеестрПлатежей.СтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК НомерДокумента,
	РеестрПлатежей.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.НомерСчета КАК НомерСчета,
	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК Контрагент,
	ЕСТЬNULL(РеестрПлатежей.СтрокаБанковскойВыписки.НазначениеПлатежа, ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.Регистратор) КАК НазначениеПлатежа,
	ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент КАК ДепозитныйВклад,
	ДепозитныеВклады.БанковскийСчет.Банк.Код КАК БИК,
	ДепозитныеВклады.БанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	ДепозитныеВклады.БанковскийСчет.Банк КАК Банк,
	ДепозитныеВклады.БанковскийСчет КАК БанковскийСчет
{ВЫБРАТЬ
	СуммаПриход КАК ДВСуммаПриход,
	СуммаРасход КАК ДВСуммаРасход,
	СуммаКонечныйОстаток КАК ДВСуммаКонечныйОстаток,
	Период КАК ДВПериод,
	НомерДокумента КАК ДВНомерДокумента,
	НомерСчета КАК ДВНомерСчета,
	ИНН КАК ДВИНН,
	Контрагент КАК ДВКонтрагент,
	НазначениеПлатежа КАК ДВНазначениеПлатежа,
	ДепозитныйВклад.* КАК ДепозитныйВклад,
	БИК КАК ДВБИК,
	КоррСчет КАК ДВКоррСчет,
	Банк.* КАК ДВБанк,
	БанковскийСчет.* КАК ДВБанковскийСчет}
ИЗ
	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.ОстаткиИОбороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Запись,
			ДвиженияИГраницыПериода,
			Организация = &amp;Организация
				И СчетДоверительногоУправления = &amp;СчетДоверительногоУправления
				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		ПО ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.КредитныйИнструмент = ДепозитныеВклады.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
					{(&amp;КонецПериода)},
					Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
						И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
			ПО РеестрПлатежей.СтрокаБанковскойВыписки.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		ПО ДенежныеСредстваВКредитныхИнструментахОстаткиИОбороты.Регистратор = РеестрПлатежей.ДвижениеДенежныхСредств
			И (РеестрПлатежей.ВидДвиженияДенежныхСредств &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу))
{ГДЕ
	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
	ДепозитныеВклады.БанковскийСчет.* КАК ДВБанковскийСчет}

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПроцентыПоКредитнымИнструментам.Сумма,
	0,
	0,
	ПроцентыПоКредитнымИнструментам.Период,
	РеестрПлатежей.СтрокаБанковскойВыписки.НомерПлатежногоДокумента,
	РеестрПлатежей.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.НомерСчета,
	РеквизитыЮридическихЛицСрезПоследних.ИНН,
	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу,
	ЕСТЬNULL(РеестрПлатежей.СтрокаБанковскойВыписки.НазначениеПлатежа, ПроцентыПоКредитнымИнструментам.Регистратор),
	ДепозитныеВклады.Ссылка,
	ДепозитныеВклады.БанковскийСчет.Банк.Код,
	ДепозитныеВклады.БанковскийСчет.Банк.КоррСчет,
	ДепозитныеВклады.БанковскийСчет.Банк,
	ДепозитныеВклады.БанковскийСчет
ИЗ
	РегистрСведений.ПроцентыПоКредитнымИнструментам КАК ПроцентыПоКредитнымИнструментам
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		ПО ПроцентыПоКредитнымИнструментам.КредитныйИнструмент = ДепозитныеВклады.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
					{(&amp;КонецПериода)},
					Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
						И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
			ПО РеестрПлатежей.СтрокаБанковскойВыписки.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		ПО ПроцентыПоКредитнымИнструментам.Регистратор = РеестрПлатежей.ДвижениеДенежныхСредств
			И (РеестрПлатежей.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу))
ГДЕ
	ПроцентыПоКредитнымИнструментам.Организация = &amp;Организация
	И ПроцентыПоКредитнымИнструментам.СчетДоверительногоУправления = &amp;СчетДоверительногоУправления
	И &amp;ПоказыватьНачислениеПроцентовНеНаОстаток
	И ВЫБОР
			КОГДА ПроцентыПоКредитнымИнструментам.Регистратор ССЫЛКА Документ.ПриходПроцентовПоКредитномуИнструменту
				ТОГДА ПроцентыПоКредитнымИнструментам.Регистратор.Реинвестирование
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ = ЛОЖЬ
	И ПроцентыПоКредитнымИнструментам.Сумма &lt;&gt; 0
{ГДЕ
	(ПроцентыПоКредитнымИнструментам.Период &gt;= &amp;НачалоПериода),
	(ПроцентыПоКредитнымИнструментам.Период &lt;= &amp;КонецПериода),
	ДепозитныеВклады.Ссылка КАК ДепозитныйВклад,
	ДепозитныеВклады.БанковскийСчет.* КАК ДВБанковскийСчет}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
