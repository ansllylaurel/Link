
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Непогашенные задолженности",
		"1.11",
		"",
		Истина
	);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтправкаОповещенийОНепогашенныхЗадолженностях", 				"Отправка оповещений о не погашенных в срок задолженностях", 						, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтправкаОповещенийОНепогашенныхЗадолженностяхКонтролерам", 	"Отправка оповещений контролерам о не погашенных в срок задолженностях", 			, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска формирования отчетов по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ТекущаяДата = ТекущаяДата();
	
	Если ИдентификаторКоманды = "ОтправкаОповещенийОНепогашенныхЗадолженностях" Тогда
		
		// Только по рабочим дням
	
		Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			Возврат;	
		КонецЕсли;
		
		ЭтотОбъект.Период = ТекущаяДата;
		
	ИначеЕсли ИдентификаторКоманды = "ОтправкаОповещенийОНепогашенныхЗадолженностяхКонтролерам" Тогда
		
		// На 9-й рабочий день от конца месяца
		
		КонецПредыдущегоМесяца = НачалоМесяца(ТекущаяДата) - 1;
		
		Если Не Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецПредыдущегоМесяца, 9) = НачалоДня(ТекущаяДата) Тогда
			Возврат;	
		КонецЕсли;
		
		ЭтотОбъект.Период = КонецПредыдущегоМесяца;
		
	ИначеЕсли ИдентификаторКоманды = "ОтправкаОповещенийОНесписанныхРезервахПоВыбывшимАктивам" Тогда
		
		// Только по рабочим дням
	
		Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			Возврат;	
		КонецЕсли;
			
		ЭтотОбъект.Период = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата, -2);
		
	Иначе
		
		ВызватьИсключение СтрШаблон("Неизвестный идентификатор команды '%1'", ИдентификаторКоманды);
		
	КонецЕсли; 
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	
	Если ИдентификаторКоманды = "ОтправкаОповещенийОНесписанныхРезервахПоВыбывшимАктивам" Тогда
		ОтправкаОповещенийОНесписанныхРезервахПоВыбывшимАктивам(ИдентификаторКоманды);
	Иначе
		ОтправкаОповещенийОНепогашенныхЗадолженностях(ИдентификаторКоманды);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправкаОповещенийОНесписанныхРезервахПоВыбывшимАктивам(ИдентификаторКоманды)
	
	// Фиксация начала выполнения команды 	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды + "()";
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);	
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
	
	// Формирование	
	НесписанныеРезервы = ЗапросНесписанныхРезервовПодОбесценение();
	
	Если Не НесписанныеРезервы.Пустой() Тогда 
		
		ДокументРезультат = Новый ТабличныйДокумент;
		
		СформироватьОтчетПоРезервам(ДокументРезультат, НесписанныеРезервы);

		ПодготовитьОповещение(ДокументРезультат, Механизм);
			
	КонецЕсли;
	
	// Фиксация завершения формирования отчета	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура ОтправкаОповещенийОНепогашенныхЗадолженностях(ИдентификаторКоманды)
	
	ЭтотОбъект.ЗаполнитьИсключаемыеСчета();
	
	// Фиксация начала выполнения команды 
	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды + "()";
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);	
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
	
	// Формирование
	
	НепогашенныеЗадолженности = ЗапросНепогашенныхЗадолженностей();
	
	Если Не НепогашенныеЗадолженности.Пустой() Тогда 
		
		ДокументРезультат = Новый ТабличныйДокумент;
		
		СформироватьОтчетПоЗадолженности(ДокументРезультат, НепогашенныеЗадолженности);

		ПодготовитьОповещение(ДокументРезультат, Механизм);
			
	КонецЕсли;
	
	// Фиксация завершения формирования отчета
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	
КонецПроцедуры

Процедура ПодготовитьОповещение(ДокументРезультат, Механизм) 
	
	ИмяФайла = ПолучитьИмяВременногоФайла("htm");
	ДокументРезультат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);

	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяФайла);

	УдалитьФайлы(ИмяФайла);

	РеквизитыОповещения = Новый Структура;
	РеквизитыОповещения.Вставить("Организация",	Организация);
	РеквизитыОповещения.Вставить("Дата",		НачалоДня(ЭтотОбъект.Период));
	РеквизитыОповещения.Вставить("ДатаСтрокой",	Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"));
	РеквизитыОповещения.Вставить("Текст",		ТелоПисьма.ПолучитьТекст());
	
	Справочники.Оповещения.СформироватьОповещения(
		Механизм,
		Перечисления.ТипыСобытий.ВнешнийВызов,
		РеквизитыОповещения);
		
КонецПроцедуры		

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	// Фиксация начала формирования отчета
	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя();
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);	
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
	
	// Формирование отчета
	
	НепогашенныеЗадолженности = ЗапросНепогашенныхЗадолженностей();
	
	СформироватьОтчетПоЗадолженности(ДокументРезультат, НепогашенныеЗадолженности);
	
	// Фиксация завершения формирования отчета
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
	
КонецПроцедуры

Процедура ЗаполнитьИсключаемыеСчета() Экспорт
	
	ЭтотОбъект.ИсключаемыеСчета.Очистить();
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ВсеИсключаемыеСчета = Новый Массив;
	ВсеИсключаемыеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Стратегия_ПН"));		// НПФ Стратегия ПН
	ВсеИсключаемыеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Стратегия_ВР"));		// НПФ Стратегия ВР АО
	ВсеИсключаемыеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Стратегия_ПН_АО"));		// НПФ Стратегия ПН АО
	ВсеИсключаемыеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Стратегия_ПН_РОПС"));	// НПФ Стратегия ПН РОПС АО
	ВсеИсключаемыеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_Стратегия_СВ"));		// НПФ Стратегия СВ АО
	ВсеИсключаемыеСчета.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_МЕЧЕЛ_ФОНД"));			// НПФ МЕЧЕЛ-ФОНД ПН АО

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка В(&ВсеИсключаемыеСчета)");

	Запрос.УстановитьПараметр("ВсеИсключаемыеСчета", ВсеИсключаемыеСчета);
	
	ЭтотОбъект.ИсключаемыеСчета.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0));
	
КонецПроцедуры

Функция ЗапросНепогашенныхЗадолженностей()
	
	// Ищем непогашенные задолженности:
	// - cо сроком больше 1 рабочего дня от даты плановой оплаты сделки;
	// - за 10 рабочих дней до плановой оплаты задолженности по вознаграждению управляющего;
	// - cо сроком больше 3 рабочих дней от даты начисления прочих задолженностей.

	#Область Текст_запроса
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамОстатки.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности КАК ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Организация КАК Организация,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Аванс КАК Аванс,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток КАК СуммаОстаток,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК СуммаКупонаОстаток
		|ПОМЕСТИТЬ _ЗадолженностиПоДенежнымСредствам
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(&ПериодВключаяГраницу, &Организация = Организация) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|ГДЕ
		|	НЕ ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления В (&ИсключаемыеСчета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	_ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствам.ВидЗадолженности КАК ВидЗадолженности,
		|	_ЗадолженностиПоДенежнымСредствам.Организация КАК Организация,
		|	_ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ЗадолженностиПоДенежнымСредствам.Валюта КАК Валюта,
		|	_ЗадолженностиПоДенежнымСредствам.Контрагент КАК Контрагент,
		|	_ЗадолженностиПоДенежнымСредствам.Аванс КАК Аванс,
		|	_ЗадолженностиПоДенежнымСредствам.СуммаОстаток КАК СуммаОстаток,
		|	_ЗадолженностиПоДенежнымСредствам.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
		|	НАЧАЛОПЕРИОДА(МИНИМУМ(ЗадолженностиПоДенежнымСредствам.Период), ДЕНЬ) КАК ДатаНачисления
		|ПОМЕСТИТЬ _ДатыНачисленияЗадолженностей
		|ИЗ
		|	_ЗадолженностиПоДенежнымСредствам КАК _ЗадолженностиПоДенежнымСредствам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ПО _ЗадолженностиПоДенежнымСредствам.Основание = ЗадолженностиПоДенежнымСредствам.Основание
		|			И _ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗадолженностиПоДенежнымСредствам.ТипЗадолженности
		|			И _ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗадолженностиПоДенежнымСредствам.ВидЗадолженности
		|			И _ЗадолженностиПоДенежнымСредствам.Организация = ЗадолженностиПоДенежнымСредствам.Организация
		|			И _ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления
		|			И _ЗадолженностиПоДенежнымСредствам.Валюта = ЗадолженностиПоДенежнымСредствам.Валюта
