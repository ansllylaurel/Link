		|	_ПросроченныеЗадолженности.ТипЗадолженности КАК ТипЗадолженности,
		|	ВЫБОР
		|		КОГДА _ПросроченныеЗадолженности.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ""Дебиторская""
		|		ИНАЧЕ ""Кредиторская""
		|	КОНЕЦ КАК ТипЗадолженностиПредставление,
		|	_ПросроченныеЗадолженности.ВидЗадолженности КАК ВидЗадолженности,
		|	ПРЕДСТАВЛЕНИЕ(_ПросроченныеЗадолженности.ВидЗадолженности) КАК ВидЗадолженностиПредставление,
		|	_ПросроченныеЗадолженности.Валюта КАК Валюта,
		|	ПРЕДСТАВЛЕНИЕ(_ПросроченныеЗадолженности.Валюта) КАК ВалютаПредставление,
		|	_ПросроченныеЗадолженности.Контрагент КАК Контрагент,
		|	ПРЕДСТАВЛЕНИЕ(_ПросроченныеЗадолженности.Контрагент) КАК КонтрагентПредставление,
		|	_ПросроченныеЗадолженности.Аванс КАК Аванс,
		|	_ПросроченныеЗадолженности.СуммаОстаток КАК СуммаОстаток,
		|	_ПросроченныеЗадолженности.СуммаКупонаОстаток КАК СуммаКупонаОстаток,
		|	_ПросроченныеЗадолженности.СуммаОстаток + _ПросроченныеЗадолженности.СуммаКупонаОстаток КАК ИтогоСуммаОстаток,
		|	_ПросроченныеЗадолженности.ПлановаяДатаОплаты КАК ПлановаяДатаОплаты,
		|	_ПросроченныеЗадолженности.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ПРЕДСТАВЛЕНИЕ(_ПросроченныеЗадолженности.ЦеннаяБумага) КАК ЦеннаяБумагаПредставление
		|ИЗ
		|	_ПросроченныеЗадолженности КАК _ПросроченныеЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дефолты КАК _Дефолты
		|		ПО (_Дефолты.ЦеннаяБумага = _ПросроченныеЗадолженности.ЦеннаяБумага)
		|			И (_Дефолты.Банкротство
		|				ИЛИ _Дефолты.ДефолтПоТелу
		|				ИЛИ _Дефолты.ДефолтПоКупону)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КатегорияПорядок,
		|	ДатаНачисления УБЫВ,
		|	СчетДоверительногоУправления
		|ИТОГИ
		|	МАКСИМУМ(КатегорияПредставление),
		|	КОЛИЧЕСТВО(Основание)
		|ПО
		|	Категория
		|АВТОУПОРЯДОЧИВАНИЕ");
	
	КоличествоЗаписейВКалендаре = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(*) ИЗ РегистрСведений.ДанныеКалендаря");
	КоличествоЗаписейВКалендаре = КоличествоЗаписейВКалендаре.Выполнить().Выгрузить()[0][0];
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 1000000", СтрШаблон("ПЕРВЫЕ %1", Формат(КоличествоЗаписейВКалендаре, "ЧН=; ЧГ=")));
	
	#КонецОбласти
	
	РабочихДнейНазад1 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Период) - 1, -1);
	РабочихДнейНазад3 = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ЭтотОбъект.Период) - 1, -3);
	
	РабочихДнейПередПлановойОплатойВознаграждения = 10;
	
	Запрос.УстановитьПараметр("ПериодВключаяГраницу",	Новый Граница(ЭтотОбъект.Период, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Период",						ЭтотОбъект.Период);
	Запрос.УстановитьПараметр("РабочихДнейНазад1",			РабочихДнейНазад1);
	Запрос.УстановитьПараметр("РабочихДнейНазад3",			РабочихДнейНазад3);
	Запрос.УстановитьПараметр("РабочихДнейПередОплатойВУК",	РабочихДнейПередПлановойОплатойВознаграждения);
	Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ИсключаемыеСчета",			ЭтотОбъект.ИсключаемыеСчета);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ЗапросНесписанныхРезервовПодОбесценение()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПредстоящихРасходовОстатки.СубъектАналитики КАК СубъектАналитики,
		|	РезервыПредстоящихРасходовОстатки.СуммаОстаток КАК Сумма,
		|	РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.РезервыПредстоящихРасходов.Остатки(
		|			&ПериодВключаяГраницу,
		|			Организация = &Организация
		|				И СубъектАналитики <> НЕОПРЕДЕЛЕНО) КАК РезервыПредстоящихРасходовОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовнеОтносящихсяКЦеннымБумагам
		|		ПО (СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Период = &Период)
		|			И РезервыПредстоящихРасходовОстатки.Организация = СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Организация
		|			И РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления = СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления
		|			И (СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Активность)
		|			И (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.СделкаРЕПО)
		|					ТОГДА СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|				КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Основание) В (ТИП(Документ.ПогашениеКупона), ТИП(Документ.НачислениеДивидендов))
		|					ТОГДА СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|				КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Основание) = ТИП(Документ.ПогашениеЦеннойБумаги)
		|						И СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоПоследнемуПогашениюКупона)
		|					ТОГДА СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Основание = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|				КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Справочник.ДепозитныеВклады)
		|					ТОГДА СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоДепозитномуВкладу)
		|				КОГДА ТИПЗНАЧЕНИЯ(СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СубъектАналитики) = ТИП(Справочник.БрокерскиеКомпании)
		|					ТОГДА СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|							И СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.Валюта = РезервыПредстоящихРасходовОстатки.Валюта
		|				ИНАЧЕ СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СубъектАналитики = РезервыПредстоящихРасходовОстатки.СубъектАналитики
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО (ФинансовыеПоказатели.Период = &Период)
		|			И РезервыПредстоящихРасходовОстатки.Организация = ФинансовыеПоказатели.Организация
		|			И РезервыПредстоящихРасходовОстатки.СчетДоверительногоУправления = ФинансовыеПоказатели.СубъектАналитики
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|ГДЕ
		|	СтоимостьАктивовнеОтносящихсяКЦеннымБумагам.СубъектАналитики ЕСТЬ NULL
		|	И ФинансовыеПоказатели.Значение ЕСТЬ НЕ NULL ");
	
	Запрос.УстановитьПараметр("Период",					НачалоДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("ПериодВключаяГраницу",	Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));	
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура СформироватьОтчетПоЗадолженности(ДокументРезультат, НепогашенныеЗадолженности)
	
	Макет = ПолучитьМакет("Макет");
	
	ВыборкаКатегории = НепогашенныеЗадолженности.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКатегории.Следующий() Цикл
		
		// Заголовок таблицы
		
		ОбластьЗаголовокТаблицы = ПолучитьОбласть(Макет, "ЗаголовокТаблицы", ВыборкаКатегории.Категория);
		ОбластьЗаголовокТаблицы.Параметры.Поле = СтрШаблон(ВыборкаКатегории.КатегорияПредставление + " (%1)", ВыборкаКатегории.Основание);
				
		ДокументРезультат.Вывести(ОбластьЗаголовокТаблицы);		
		
		ДокументРезультат.НачатьГруппуСтрок();
		
		// Шапка таблицы
		
		ОбластьШапкаТаблицы = ПолучитьОбласть(Макет, "ШапкаТаблицы", ВыборкаКатегории.Категория);
		
		ДокументРезультат.Вывести(ОбластьШапкаТаблицы);		
		
		// Сведения о задолженностях
		
		ВыборкаЗадолженности = ВыборкаКатегории.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		Пока ВыборкаЗадолженности.Следующий() Цикл
			
			ВычисляемыеПараметры = Новый Структура("СрокЗадолженности, ДополнительныеСведения");
			
			Если Не ВыборкаЗадолженности.НачисленоБольшеГодаНазад Тогда
				РабочихДнейСМоментаНачисления			= Справочники.Календари.КоличествоРабочихДней(Справочники.Календари.Общероссийский, ВыборкаЗадолженности.ДатаНачисления, НачалоДня(ЭтотОбъект.Период) - 1);
				ВычисляемыеПараметры.СрокЗадолженности	= СтрокаСЧислом(";%1 раб. день;;%1 раб. дня;%1 раб. дней;%1 раб. дня", РабочихДнейСМоментаНачисления, ВидЧисловогоЗначения.Количественное, "L=ru");		
			КонецЕсли;	
			
			Если ВыборкаЗадолженности.Аванс Тогда
				ВычисляемыеПараметры.Вставить("ВидЗадолженностиПредставление", ВыборкаЗадолженности.ВидЗадолженностиПредставление + " (аванс)");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаЗадолженности.ЦеннаяБумага) Тогда
				ВычисляемыеПараметры.ДополнительныеСведения = ВыборкаЗадолженности.ЦеннаяБумага;
			ИначеЕсли ЗначениеЗаполнено(ВыборкаЗадолженности.Контрагент) Тогда
				ВычисляемыеПараметры.ДополнительныеСведения = ВыборкаЗадолженности.Контрагент;
			КонецЕсли;
			
			ОбластьСтрокаТаблицы = ПолучитьОбласть(Макет, "СтрокаТаблицы", ВыборкаКатегории.Категория);
			ОбластьСтрокаТаблицы.Параметры.Заполнить(ВыборкаЗадолженности);
			ОбластьСтрокаТаблицы.Параметры.Заполнить(ВычисляемыеПараметры);
			
			ДокументРезультат.Вывести(ОбластьСтрокаТаблицы);		
			
		КонецЦикла;
		
		ДокументРезультат.ЗакончитьГруппуСтрок();
		
		ДокументРезультат.Вывести(Макет.ПолучитьОбласть("РазделительТаблиц"));
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура СформироватьОтчетПоРезервам(ДокументРезультат, НесписанныеРезервы)
	
	Макет = ПолучитьМакет("Макет");
	
	// Заголовок таблицы		
	ОбластьЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицыОшибки");
	ОбластьЗаголовокТаблицы.Параметры.Поле = "Несписанные суммы резервов под обесценение по активам, отсутствующим в СЧА";
	ДокументРезультат.Вывести(ОбластьЗаголовокТаблицы);	
	
	// Шапка таблицы		
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицыРезервы");	
	ДокументРезультат.Вывести(ОбластьШапкаТаблицы);		
	
	ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицыРезервы");
	
	Выборка = НесписанныеРезервы.Выбрать();
		
	Пока Выборка.Следующий() Цикл
				
		// Строки		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(Выборка);
				
		ДокументРезультат.Вывести(ОбластьСтрокаТаблицы);		
		
	КонецЦикла;	
	
КонецПроцедуры


Функция ПолучитьОбласть(Макет, ИмяОбласти, Категория)
	
	Область = Макет.Области.Найти(ИмяОбласти + Категория);
	
	Возврат ?(Область = Неопределено, Макет.ПолучитьОбласть(ИмяОбласти), Макет.ПолучитьОбласть(ИмяОбласти + Категория));
	
КонецФункции
