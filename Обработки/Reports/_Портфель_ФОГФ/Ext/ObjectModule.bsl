
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Портфель ФОГФ",
		"1.08",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ВидДоговораДоверительногоУправления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДоверительногоУправления, "ВидДоговораДоверительногоУправления");
	Если Не ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет предназначен только для счетов ДУ с видом 'Управление активами ФОГФ'");
		Возврат;
	КонецЕсли;
	
	СтруктураДанныхКонтактногоЛица = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхКонтактногоЛица", СтруктураДанныхКонтактногоЛица);
				
	Если Не ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран ответственный");
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(СтруктураДанныхКонтактногоЛица.КонтактноеЛицо) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран ответственный");
		Возврат;
	КонецЕсли;
	
	СтруктураДанныхГлБухгалтера = Неопределено;
	КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхГлБухгалтера", СтруктураДанныхГлБухгалтера);
				
	Если Не ЗначениеЗаполнено(СтруктураДанныхГлБухгалтера) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран главный бухгалтер");
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(СтруктураДанныхГлБухгалтера.КонтактноеЛицо) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбран главный бухгалтер");
		Возврат;
	КонецЕсли;
			
	// Получим дату СЧА дату отчета
	ТекДатаОкончания 	= НачалоДня(ЭтотОбъект.Период);
		
	ДатаСЧАНаКонецПериода = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ТекДатаОкончания);

	Если ДатаСЧАНаКонецПериода = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчет не сформирован");	
		Возврат;
	КонецЕсли; 	
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	Макет = ПолучитьМакет("Макет");
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
	ОбластьГруппа	= Макет.ПолучитьОбласть("Группа");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал   = Макет.ПолучитьОбласть("Подвал");
		
	Запрос = Новый Запрос;	
	
	#ОБЛАСТЬ ТЕКСТ_ЗАПРОСА
	
	Запрос.Текст = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
	|ПОМЕСТИТЬ _СчетаДоверительногоУправления
	|ИЗ
	|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток КАК БалансоваяСтоимостьБезНКД,
	|	БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток КАК Переоценка,
	|	БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток КАК НКДУплаченныйНачисленный,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток < 0
	|			ТОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Дисконт,
	|	ВЫБОР
	|		КОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияОстаток > 0
	|			ТОГДА БухПартииЦенныхБумагОстатки.ДисконтПремияНачисленныйВВалютеУчетаОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Премия,
	|	БухПартииЦенныхБумагОстатки.КорректировкаЭСПВВалютеУчетаОстаток + БухПартииЦенныхБумагОстатки.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК Корректировка,
	|	БухПартииЦенныхБумагОстатки.СуммаРезервовПодОбесценениеОстаток КАК СуммаРезервовПодОбесценение,
	|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ _ЦенныеБумагиСПартиями_КонецПериода
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
	|			&ДатаОкончания_Граница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = &ВидУчетаБаланс
	|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия))) КАК БухПартииЦенныхБумагОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага,
	|	0,
	|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаНаБалансеОстаток,
	|	0,
	|	0,
	|	0,
	|	0,
	|	0,
	|	БухПартииЦенныхБумагКПолучениюОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
	|			&ДатаОкончания_Граница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = &ВидУчетаБаланс
	|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия))) КАК БухПартииЦенныхБумагКПолучениюОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(_ЦенныеБумаги.БалансоваяСтоимостьБезНКД) КАК БалансоваяСтоимостьБезНКД,
	|	СУММА(_ЦенныеБумаги.Переоценка) КАК Переоценка,
	|	СУММА(_ЦенныеБумаги.НКДУплаченныйНачисленный) КАК НКДУплаченныйНачисленный,
	|	СУММА(_ЦенныеБумаги.Дисконт) КАК Дисконт,
	|	СУММА(_ЦенныеБумаги.Премия) КАК Премия,
	|	СУММА(_ЦенныеБумаги.Корректировка) КАК Корректировка,
	|	СУММА(_ЦенныеБумаги.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
	|	СУММА(_ЦенныеБумаги.Количество) КАК Количество
	|ПОМЕСТИТЬ _ЦенныеБумаги_КонецПериода
	|ИЗ
	|	_ЦенныеБумагиСПартиями_КонецПериода КАК _ЦенныеБумаги
	|
	|СГРУППИРОВАТЬ ПО
	|	_ЦенныеБумаги.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЕСТЬNULL(_ЦенныеБумаги.БалансоваяСтоимостьБезНКД, 0) + ЕСТЬNULL(_ЦенныеБумаги.Переоценка, 0) + ЕСТЬNULL(_ЦенныеБумаги.Дисконт, 0) + ЕСТЬNULL(_ЦенныеБумаги.Премия, 0) + ЕСТЬNULL(_ЦенныеБумаги.Корректировка, 0) - ЕСТЬNULL(_ЦенныеБумаги.СуммаРезервовПодОбесценение, 0)) КАК Сумма_Баланс,
	|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(_ЦенныеБумаги.НКДУплаченныйНачисленный) КАК Купон_Баланс,
	|	СУММА(_ЦенныеБумаги.Количество) КАК Количество
	|ПОМЕСТИТЬ _БалансоваяСтоимостьЦБ_КонецПериода
	|ИЗ
	|	_ЦенныеБумаги_КонецПериода КАК _ЦенныеБумаги
	|
	|СГРУППИРОВАТЬ ПО
	|	_ЦенныеБумаги.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(СтоимостьПереоценки.СуммаВВалютеУчета) КАК Сумма,
	|	СУММА(СтоимостьПереоценки.СуммаКупонаВВалютеУчета) КАК СуммаКупонаВВалютеУчета,
	|	СтоимостьПереоценки.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(СтоимостьПереоценки.Количество) КАК Количество,
	|	СтоимостьПереоценки.Цена КАК Цена,
	|	СтоимостьПереоценки.ЦенаКупона КАК ЦенаКупона
	|ПОМЕСТИТЬ _СтоимостьПереоценки_КонецПериода
	|ИЗ
	|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
	|ГДЕ
	|	СтоимостьПереоценки.Период = НАЧАЛОПЕРИОДА(&ДатаСЧАНаКонецПериода, ДЕНЬ)
	|	И СтоимостьПереоценки.Организация = &Организация
	|	И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|	И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении)
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьПереоценки.ЦеннаяБумага,
	|	СтоимостьПереоценки.Цена,
	|	СтоимостьПереоценки.ЦенаКупона
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_СтоимостьПереоценки_КонецПериода.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_СтоимостьПереоценки_КонецПериода.Количество КАК Количество,
	|	_СтоимостьПереоценки_КонецПериода.Цена КАК ОценочнаяЦена,
	|	_СтоимостьПереоценки_КонецПериода.Сумма КАК РыночнаяСтоимость,
	|	0 КАК БалансоваяСтоимость,
	|	_СтоимостьПереоценки_КонецПериода.ЦенаКупона КАК Купон,
	|	_СтоимостьПереоценки_КонецПериода.СуммаКупонаВВалютеУчета КАК ОценочнаяСтоимостьКупона,
	|	0 КАК БалансоваяСтоимостьКупона,
	|	_СтоимостьПереоценки_КонецПериода.Сумма + _СтоимостьПереоценки_КонецПериода.СуммаКупонаВВалютеУчета КАК ИтогоОценочнаяСтоимость,
	|	_СтоимостьПереоценки_КонецПериода.Сумма + _СтоимостьПереоценки_КонецПериода.СуммаКупонаВВалютеУчета КАК РазницаМеждуОценочнойИБалансовой
	|ПОМЕСТИТЬ _ОбщаяТаблица
	|ИЗ
	|	_СтоимостьПереоценки_КонецПериода КАК _СтоимостьПереоценки_КонецПериода
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	_БалансоваяСтоимостьЦБ_КонецПериода.ЦеннаяБумага,
	|	0,
	|	0,
	|	0,
	|	_БалансоваяСтоимостьЦБ_КонецПериода.Сумма_Баланс,
	|	0,
	|	0,
	|	_БалансоваяСтоимостьЦБ_КонецПериода.Купон_Баланс,
	|	0,
	|	-(_БалансоваяСтоимостьЦБ_КонецПериода.Сумма_Баланс + _БалансоваяСтоимостьЦБ_КонецПериода.Купон_Баланс)
	|ИЗ
	|	_БалансоваяСтоимостьЦБ_КонецПериода КАК _БалансоваяСтоимостьЦБ_КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ОбщаяТаблица.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(_ОбщаяТаблица.Количество) КАК Количество,
	|	СУММА(_ОбщаяТаблица.ОценочнаяЦена) КАК ОценочнаяЦена,
	|	СУММА(_ОбщаяТаблица.РыночнаяСтоимость) КАК РыночнаяСтоимость,
	|	СУММА(_ОбщаяТаблица.БалансоваяСтоимость) КАК БалансоваяСтоимость,
	|	СУММА(_ОбщаяТаблица.Купон) КАК Купон,
	|	СУММА(_ОбщаяТаблица.ОценочнаяСтоимостьКупона) КАК ОценочнаяСтоимостьКупона,
	|	СУММА(_ОбщаяТаблица.БалансоваяСтоимостьКупона) КАК БалансоваяСтоимостьКупона,
	|	СУММА(_ОбщаяТаблица.ИтогоОценочнаяСтоимость) КАК ИтогоОценочнаяСтоимость,
	|	СУММА(_ОбщаяТаблица.РазницаМеждуОценочнойИБалансовой) КАК РазницаМеждуОценочнойИБалансовой
	|ПОМЕСТИТЬ _СвернутаяТаблица
	|ИЗ
	|	_ОбщаяТаблица КАК _ОбщаяТаблица
	|
