	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_СвернутаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ВЫБОР
	|					КОГДА ВЫРАЗИТЬ(_СвернутаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
	|						ТОГДА 1
	|					КОГДА ВЫРАЗИТЬ(_СвернутаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Субфедеральная)
	|						ТОГДА 2
	|					ИНАЧЕ 4
	|				КОНЕЦ
	|		КОГДА ТИПЗНАЧЕНИЯ(_СвернутаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Акции)
	|				И ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ЛОЖЬ) = ИСТИНА
	|			ТОГДА 3
	|		ИНАЧЕ 5
	|	КОНЕЦ КАК Группа,
	|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК НаименованиеЦБ,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(_СвернутаяТаблица.ЦеннаяБумага) = ТИП(Справочник.Облигации)
	|			ТОГДА ВЫБОР
	|					КОГДА ВЫРАЗИТЬ(_СвернутаяТаблица.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Государственная)
	|						ТОГДА ЕСТЬNULL(КодыВТорговыхСистемахКодНаММВБ.Код, """""""")
	|					ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахISIN.Код, """""""")
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахISIN.Код, """""""")
	|	КОНЕЦ КАК ISIN,
	|	_СвернутаяТаблица.Количество КАК Количество,
	|	_СвернутаяТаблица.ОценочнаяЦена КАК ОценочнаяЦена,
	|	_СвернутаяТаблица.РыночнаяСтоимость КАК РыночнаяСтоимость,
	|	_СвернутаяТаблица.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|	_СвернутаяТаблица.Купон КАК Купон,
	|	_СвернутаяТаблица.ОценочнаяСтоимостьКупона КАК ОценочнаяСтоимостьКупона,
	|	_СвернутаяТаблица.БалансоваяСтоимостьКупона КАК БалансоваяСтоимостьКупона,
	|	_СвернутаяТаблица.ИтогоОценочнаяСтоимость КАК ИтогоОценочнаяСтоимость,
	|	_СвернутаяТаблица.РазницаМеждуОценочнойИБалансовой КАК РазницаМеждуОценочнойИБалансовой
	|ИЗ
	|	_СвернутаяТаблица КАК _СвернутаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	|				&ДатаОкончания,
	|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
	|		ПО _СвернутаяТаблица.ЦеннаяБумага.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахISIN
	|		ПО _СвернутаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахISIN.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахКодНаММВБ
	|		ПО _СвернутаяТаблица.ЦеннаяБумага = КодыВТорговыхСистемахКодНаММВБ.Объект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Группа,
	|	НаименованиеЦБ
	|ИТОГИ
	|	СУММА(РыночнаяСтоимость),
	|	СУММА(БалансоваяСтоимость),
	|	СУММА(ОценочнаяСтоимостьКупона),
	|	СУММА(БалансоваяСтоимостьКупона),
	|	СУММА(ИтогоОценочнаяСтоимость),
	|	СУММА(РазницаМеждуОценочнойИБалансовой)
	|ПО
	|	ОБЩИЕ,
	|	Группа";
	
	#КОНЕЦОБЛАСТИ 
	
	Запрос.УстановитьПараметр("ДатаОкончания", 					КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаОкончания_Граница", 			Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая)); 
	Запрос.УстановитьПараметр("ДатаСЧАНаКонецПериода", 			ДатаСЧАНаКонецПериода);
		
	Запрос.УстановитьПараметр("ВидУчетаБаланс",					Перечисления.ВидыУчета.БухгалтерскийУчет);
	Запрос.УстановитьПараметр("ФОГФ",						  	ОбщегоНазначения.ПолучитьИменованныйОбъект("Клиент_ФОГФ"));
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	ИндексПоследнегозапроса = ПакетЗапросов.ВГраница();
	
	// Шапка
	Выборка = ПакетЗапросов[ИндексПоследнегоЗапроса - 1].Выбрать();

	Если Выборка.Следующий() Тогда				
		ОбластьШапка.Параметры.Заполнить(Выборка);
		ОбластьШапка.Параметры.ДатаДоговораДУ = Формат(Выборка.ДатаДоговораДУ, "ДЛФ=DD");
		ОбластьШапка.Параметры.ПолноеНаименованиеФОГФРП = ПолучитьСклоненияСтроки(Выборка.ПолноеНаименованиеФОГФ, "", "ПД=Родительный")[0];
	КонецЕсли;
	
	ОбластьШапка.Параметры.ДатаОтчета 			= Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy");	
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	// Группы ценных бумаг
	ВыборкаОбщиеИтоги = ПакетЗапросов[ИндексПоследнегоЗапроса].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Общие итоги
	Если ВыборкаОбщиеИтоги.Следующий() Тогда
		ОбластьПодвал.Параметры.Заполнить(ВыборкаОбщиеИтоги);
		ВыборкаГруппа = ВыборкаОбщиеИтоги.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
		Пока ВыборкаГруппа.Следующий() Цикл
			ОбластьГруппа.Параметры.Заполнить(ВыборкаГруппа);
			
			ОбластьГруппа.Параметры.НаименованиеЦБ = ПолучитьНаименованиеГруппы(ВыборкаГруппа.Группа);
			
			ДокументРезультат.Вывести(ОбластьГруппа);
			ВыборкаСтроки = ВыборкаГруппа.Выбрать();
			Пока ВыборкаСтроки.Следующий() Цикл
				ОбластьСтрока.Параметры.Заполнить(ВыборкаСтроки);
				ДокументРезультат.Вывести(ОбластьСтрока);
			КонецЦикла;
		КонецЦикла; 	
	КонецЕсли;	
		
	// Подписи	
	
	ОбластьПодвал.Параметры.Ответственный 		= СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
	ОбластьПодвал.Параметры.ДолжностьДиректор 	= СтруктураДанныхКонтактногоЛица.Должность + " (на основании " + СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий +  ")";

	ОбластьПодвал.Параметры.ГлавныйБухгалтер 	= СтруктураДанныхГлБухгалтера.КонтактноеЛицо;
	ОбластьПодвал.Параметры.ДолжностьГлавбух    = СтруктураДанныхГлБухгалтера.Должность;
	
	ДокументРезультат.Вывести(ОбластьПодвал);
		
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Функция ПолучитьНаименованиеГруппы(Группа)
	
	Если Группа = 1 Тогда
		Возврат "Ценные бумаги РФ";
	ИначеЕсли Группа = 2 Тогда
		Возврат "Ценные бумаги субъектов РФ";
	ИначеЕсли Группа = 3 Тогда
		Возврат "Акции российских АО";
	ИначеЕсли Группа = 4 Тогда
		Возврат "Корпоративные облигации";
	КонецЕсли;
	
	Возврат "Прочие ЦБ";
	
КонецФункции
