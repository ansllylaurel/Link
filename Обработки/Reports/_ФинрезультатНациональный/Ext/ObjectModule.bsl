		|					И _Объединение.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|				ТОГДА ВЫБОР
		|						КОГДА _Объединение.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка), ""Ввод ЦБ"")
		|							ТОГДА _Объединение.Сумма
		|						КОГДА _Объединение.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа), ""Вывод ЦБ"", ""Начисление дивидендов"")
		|							ТОГДА -_Объединение.Сумма
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Акции,
		|	СУММА(ВЫБОР
		|			КОГДА _Объединение.ЧастьСделкиРЕПО = 0
		|					И _Объединение.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И (Облигации.Категория В (&КатегорииГос)
		|						ИЛИ НЕ Облигации.Категория В (&КатегорииГос)
		|							И РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма = ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация))
		|				ТОГДА ВЫБОР
		|						КОГДА _Объединение.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка), ""Ввод ЦБ"")
		|							ТОГДА _Объединение.Сумма
		|						КОГДА _Объединение.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа), ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ПолноеПогашение), ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ЧастичноеПогашение), ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.Оферта), ""Вывод ЦБ"", ""Погашение купона"")
		|							ТОГДА -_Объединение.Сумма
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Гос,
		|	СУММА(ВЫБОР
		|			КОГДА _Объединение.ЧастьСделкиРЕПО = 0
		|					И _Объединение.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|					И НЕ Облигации.Категория В (&КатегорииГос)
		|					И РеквизитыЮридическихЛицСрезПоследних.ОрганизационноПравоваяФорма <> ЗНАЧЕНИЕ(Справочник.ОрганизационноПравовыеФормы.ГосударственнаяКорпорация)
		|				ТОГДА ВЫБОР
		|						КОГДА _Объединение.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка), ""Ввод ЦБ"")
		|							ТОГДА _Объединение.Сумма
		|						КОГДА _Объединение.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа), ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ПолноеПогашение), ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.ЧастичноеПогашение), ЗНАЧЕНИЕ(Перечисление.ВидыПогашения.Оферта), ""Вывод ЦБ"", ""Погашение купона"")
		|							ТОГДА -_Объединение.Сумма
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Корп,
		|	СУММА(ВЫБОР
		|			КОГДА _Объединение.Рынок В (""Депозитный вклад"", ""МНО"")
		|				ТОГДА ВЫБОР
		|						КОГДА _Объединение.ВидОперации В (""Размещение"")
		|							ТОГДА _Объединение.Сумма
		|						КОГДА _Объединение.ВидОперации В (""Закрытие"", ""Выплата процентов"", ""Приход процентов"", ""Сторнирование"")
		|							ТОГДА -_Объединение.Сумма
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Депозиты,
		|	СУММА(ВЫБОР
		|			КОГДА _Объединение.ЧастьСделкиРЕПО <> 0
		|				ТОГДА ВЫБОР
		|						КОГДА _Объединение.ВидОперации В (""Покупка (РЕПО)"", ""Покупка (РЕПО ч.2)"")
		|							ТОГДА _Объединение.Сумма
		|						КОГДА _Объединение.ВидОперации В (""Продажа (РЕПО)"", ""Продажа (РЕПО ч.2)"")
		|							ТОГДА -_Объединение.Сумма
		|					КОНЕЦ
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК РЕПО
		|ПОМЕСТИТЬ _Потоки
		|ИЗ
		|	_Объединение КАК _Объединение
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних КАК РеквизитыЮридическихЛицСрезПоследних
		|			ПО Облигации.Эмитент.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|				И (РеквизитыЮридическихЛицСрезПоследних.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|		ПО _Объединение.ЦеннаяБумага = Облигации.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	_Объединение.ДатаРасчетов";
	
#КонецОбласти	
	
	Запрос.УстановитьПараметр("НачалоПериода", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	КатегорииГос = Новый Массив;
	КатегорииГос.Добавить(Перечисления.КатегорииОблигаций.Государственная);
	КатегорииГос.Добавить(Перечисления.КатегорииОблигаций.Субфедеральная);
	КатегорииГос.Добавить(Перечисления.КатегорииОблигаций.Муниципальная);
	Запрос.УстановитьПараметр("КатегорииГос", КатегорииГос);
	Запрос.УстановитьПараметр("ДатаСЧАНачало", ДатаСЧАНачало);
	Запрос.УстановитьПараметр("ДатаСЧАКонец", ДатаСЧАКонец);
	
	РезультатЗапроса = Запрос.Выполнить();
				

	
#Область ЗапросДоходность

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СЧА.Период КАК Период,
		|	_СЧА.Значение КАК СЧА,
		|	_СЧА.ВводыВыводы КАК ВводыВыводы,
		|	_СЧА.Акции КАК АкцииСЧА,
		|	ЕСТЬNULL(_Потоки.Акции, 0) КАК АкцииПоток,
		|	_СЧА.Гос КАК ГосСЧА,
		|	ЕСТЬNULL(_Потоки.Гос, 0) КАК ГосПоток,
		|	_СЧА.Корп КАК КорпСЧА,
		|	ЕСТЬNULL(_Потоки.Корп, 0) КАК КорпПоток,
		|	_СЧА.Депозиты КАК ДепозитыСЧА,
		|	ЕСТЬNULL(_Потоки.Депозиты, 0) КАК ДепозитыПоток,
		|	_СЧА.РЕПО КАК РЕПОСЧА,
		|	ЕСТЬNULL(_Потоки.РЕПО, 0) КАК РЕПОПоток
		|ИЗ
		|	_СЧА КАК _СЧА
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Потоки КАК _Потоки
		|		ПО _СЧА.Период = _Потоки.Период
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	 Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);

#КонецОбласти

	
	//инициализация
	МножительИтого = 1;
	МножительАкции = 1;
	МножительГос = 1;
	МножительКорп = 1;
	МножительДепозиты = 1;
	МножительИное = 1;
	
	СЧАПредыдущий = 0;
	СЧААкцииПредыдущий = 0;
	СЧАГосПредыдущий = 0;
	СЧАКорпПредыдущий = 0;
	СЧАДепозитыПредыдущий = 0;
	СЧАИноеПредыдущий = 0;
	
	ДнейОбщее = 0;
	ДнейАкции = 0;
	ДнейГос = 0;
	ДнейКорп = 0;	
	ДнейДепозиты = 0;
	ДнейИное = 0;
	
	НачалоПериодаОбщее = Неопределено;
	НачалоПериодаАкции = Неопределено;
	НачалоПериодаГос = Неопределено;
	НачалоПериодаКорп = Неопределено;	
	НачалоПериодаДепозиты = Неопределено;
	НачалоПериодаИное = Неопределено;
	
	ДатаПервогоВвода = ДатаНачалаДействияДоговора();
	
	Макет = ПолучитьМакет("РасшифровкаДоходности");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьДоходность = Макет.ПолучитьОбласть("Доходность");
	
	ДокументРасшифровкаДоходность.Вывести(ОбластьШапка);
	
	//расчет доходности 
	ДокументРасшифровкаДоходность.НачатьГруппуСтрок();
	
	Пока Выборка.Следующий() Цикл 
		
		Если Выборка.Период <> ДатаСЧАНачало Тогда 
			
			ИтерацияРасчетаДоходности(СЧАПредыдущий, Выборка.СЧА, Выборка.ВводыВыводы, МножительИтого, ДнейОбщее, НачалоПериодаОбщее, Выборка.Период, ДатаПервогоВвода);		
			ИтерацияРасчетаДоходности(СЧААкцииПредыдущий, Выборка.АкцииСЧА, Выборка.АкцииПоток, МножительАкции, ДнейАкции, НачалоПериодаАкции, Выборка.Период, ДатаПервогоВвода);
			ИтерацияРасчетаДоходности(СЧАГосПредыдущий, Выборка.ГосСЧА, Выборка.ГосПоток, МножительГос, ДнейГос, НачалоПериодаГос, Выборка.Период, ДатаПервогоВвода);
			ИтерацияРасчетаДоходности(СЧАКорпПредыдущий, Выборка.КорпСЧА, Выборка.КорпПоток, МножительКорп, ДнейКорп, НачалоПериодаКорп, Выборка.Период, ДатаПервогоВвода);
			ИтерацияРасчетаДоходности(СЧАДепозитыПредыдущий, Выборка.ДепозитыСЧА, Выборка.ДепозитыПоток, МножительДепозиты, ДнейДепозиты, НачалоПериодаДепозиты, Выборка.Период, ДатаПервогоВвода);
			ИтерацияРасчетаДоходности(СЧАИноеПредыдущий, Выборка.РЕПОСЧА, Выборка.РЕПОПоток, МножительИное, ДнейИное, НачалоПериодаИное, Выборка.Период, ДатаПервогоВвода);
			
		КонецЕсли;
		
		//
		ПолучитьПредыдущееСЧА(СЧАПредыдущий, Выборка.СЧА, НачалоПериодаОбщее, Выборка.Период);
		ПолучитьПредыдущееСЧА(СЧААкцииПредыдущий, Выборка.АкцииСЧА, НачалоПериодаАкции, Выборка.Период);
		ПолучитьПредыдущееСЧА(СЧАГосПредыдущий, Выборка.ГосСЧА, НачалоПериодаГос, Выборка.Период);
		ПолучитьПредыдущееСЧА(СЧАКорпПредыдущий, Выборка.КорпСЧА, НачалоПериодаКорп, Выборка.Период);			
		ПолучитьПредыдущееСЧА(СЧАДепозитыПредыдущий, Выборка.ДепозитыСЧА, НачалоПериодаДепозиты, Выборка.Период);
		ПолучитьПредыдущееСЧА(СЧАИноеПредыдущий, Выборка.РЕПОСЧА, НачалоПериодаИное, Выборка.Период);

		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
		ОбластьСтрока.Параметры.МножительИтого = МножительИтого;
		ОбластьСтрока.Параметры.МножительАкции = МножительАкции;
		ОбластьСтрока.Параметры.МножительГос = МножительГос;
		ОбластьСтрока.Параметры.МножительКорп = МножительКорп;
		ОбластьСтрока.Параметры.МножительДепозиты = МножительДепозиты;
		ОбластьСтрока.Параметры.МножительИное = МножительИное;
		
		ДокументРасшифровкаДоходность.Вывести(ОбластьСтрока);
		
	КонецЦикла;	
	ДокументРасшифровкаДоходность.ЗакончитьГруппуСтрок();
	
	
	ДнейОбщее = ПересчетДней(ДнейОбщее, ДатаСЧАКонец, НачалоПериодаОбщее); 
	ДнейАкции = ПересчетДней(ДнейАкции, ДатаСЧАКонец, НачалоПериодаАкции); 
	ДнейГос = ПересчетДней(ДнейГос, ДатаСЧАКонец, НачалоПериодаГос); 
	ДнейКорп = ПересчетДней(ДнейКорп, ДатаСЧАКонец, НачалоПериодаКорп); 
	ДнейДепозиты = ПересчетДней(ДнейДепозиты, ДатаСЧАКонец, НачалоПериодаДепозиты);
	ДнейИное = ПересчетДней(ДнейИное, ДатаСЧАКонец, НачалоПериодаИное); 
	
	ДнейВГоду = 365; //(КонецГода(ЭтотОбъект.Период.ДатаОкончания) + 1 - НачалоГода(ЭтотОбъект.Период.ДатаОкончания)) / 86400;     #534640 
	
	ДоходностьИтого = ПолучитьДоходностьВПроцентах(МножительИтого, ДнейОбщее, ДнейВГоду); 
	ДоходностьАкции = ПолучитьДоходностьВПроцентах(МножительАкции, ДнейАкции, ДнейВГоду);
	ДоходностьГос = ПолучитьДоходностьВПроцентах(МножительГос, ДнейГос, ДнейВГоду);
	ДоходностьКорп = ПолучитьДоходностьВПроцентах(МножительКорп, ДнейКорп, ДнейВГоду);
	ДоходностьДепозиты = ПолучитьДоходностьВПроцентах(МножительДепозиты, ДнейДепозиты, ДнейВГоду);	
	ДоходностьИное = ПолучитьДоходностьВПроцентах(МножительИное, ДнейИное, ДнейВГоду); 
	
	ОбластьДоходность.Параметры.ДнейОбщее 		= ДнейОбщее;
	ОбластьДоходность.Параметры.ДнейАкции 		= ДнейАкции;
	ОбластьДоходность.Параметры.ДнейГос 		= ДнейГос;
	ОбластьДоходность.Параметры.ДнейКорп 		= ДнейКорп;
	ОбластьДоходность.Параметры.ДнейДепозиты 	= ДнейДепозиты;
	ОбластьДоходность.Параметры.ДнейИное 		= ДнейИное;
	
	ОбластьДоходность.Параметры.ДоходностьИтого 	= ДоходностьИтого;
	ОбластьДоходность.Параметры.ДоходностьАкции 	= ДоходностьАкции;
	ОбластьДоходность.Параметры.ДоходностьГос 		= ДоходностьГос;
	ОбластьДоходность.Параметры.ДоходностьКорп 		= ДоходностьКорп;
	ОбластьДоходность.Параметры.ДоходностьДепозиты 	= ДоходностьДепозиты;
	ОбластьДоходность.Параметры.ДоходностьИное 		= ДоходностьИное;
		
	ДокументРасшифровкаДоходность.Вывести(ОбластьДоходность);
	
	// операции 
#Область ЗапросОперации

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Объединение.ДатаРасчетов КАК ДатаРасчетов,
