
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Финансовый результат и доходность размещения",
		"0.16",
		"",
		Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция СоздатьТаблицуОтчета(НазвЕИ)
	
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда 
		ПолеДоговор = "ПР";
	ИначеЕсли ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ПолеДоговор = "ПН";
	КонецЕсли;			
	
	ТаблицаОтчета = Новый ТаблицаЗначений;
	
	ТаблицаОтчета.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	ТаблицаОтчета.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(5)));
	ТаблицаОтчета.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка"), Новый КвалификаторыСтроки(75));
	ТаблицаОтчета.Колонки.Добавить("Выделение", Новый ОписаниеТипов("Булево"));
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 1;
	НоваяСтрока.НомерСтроки = "1.";
	НоваяСтрока.Показатель = "СЧА " + ПолеДоговор + "[1] на " + Формат(ЭтотОбъект.Период.ДатаНачала, "ДФ=dd.MM.yy") + " г.[2]";      //   ПР. дата
	НоваяСтрока.Выделение = Истина;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 2;
	НоваяСтрока.НомерСтроки = "2.";
	НоваяСтрока.Показатель = "Получено в д/у " + ПолеДоговор + " в отчетном периоде, " + НазвЕИ;       
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 3;
	НоваяСтрока.НомерСтроки = "1.";
	НоваяСтрока.Показатель = "Возвращено из д/у " + ПолеДоговор + " в отчетном периоде, "  + НазвЕИ;  // ПР, единица
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 4;
	НоваяСтрока.НомерСтроки = "4.";
	НоваяСтрока.Показатель = "СЧА " + ПолеДоговор + "[3] на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yy") + " г.[4].";
	НоваяСтрока.Выделение = Истина;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 5;
	НоваяСтрока.НомерСтроки = "5.";
	НоваяСтрока.Показатель = "Финансовый результат:";
	НоваяСтрока.Выделение = Истина;
		
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 6;
	НоваяСтрока.НомерСтроки = "";
	НоваяСтрока.Показатель = "в т.ч. по составляющим";
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 7;
	НоваяСтрока.НомерСтроки = "5.1";
	НоваяСтрока.Показатель = "корректировка стоимости";
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 8;
	НоваяСтрока.НомерСтроки = "5.2";
	НоваяСтрока.Показатель = "реализация";
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 9;
	НоваяСтрока.НомерСтроки = "5.3";
	НоваяСтрока.Показатель = "Полученные дивиденды, проценты";
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 10;
	НоваяСтрока.НомерСтроки = "5.4";
	НоваяСтрока.Показатель = "Начисленные купоны, проценты";
	НоваяСтрока.Выделение = Ложь;
	
	НоваяСтрока = ТаблицаОтчета.Добавить();
	НоваяСтрока.Порядок = 11;
	НоваяСтрока.НомерСтроки = "5.5";
	НоваяСтрока.Показатель = "обязательные расходы (депозитарий, вознаграждение УК и пр.)";
	НоваяСтрока.Выделение = Ложь;
		
	Возврат ТаблицаОтчета;
	
КонецФункции

