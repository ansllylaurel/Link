Процедура ПолучитьПредыдущееСЧА(СЧАПредыдущее, СЧАТекущее, НачалоПериодаРасчета, ПериодРасчета)
	
	СЧАПредыдущее = СЧАТекущее;
	Если СЧАПредыдущее <> 0 И НачалоПериодаРасчета = Неопределено Тогда 
		НачалоПериодаРасчета = ПериодРасчета;		
	КонецЕсли;			
	
КонецПроцедуры 	

Процедура ИтерацияРасчетаДоходности(СЧАПредыдущее, СЧАТекущее, Поток, Множитель, ДнейРасчета, НачалоПериодаРасчета, ПериодРасчета, ДатаПервогоВвода)
	
	Если (ПериодРасчета = ДатаПервогоВвода) И СЧАТекущее <> 0 Тогда 
		ДнейРасчета = ДнейРасчета + 1;
		НачалоПериодаРасчета = ПериодРасчета;
	ИначеЕсли СЧАПредыдущее = 0 Тогда 
		Возврат;		
	ИначеЕсли (СЧАТекущее - Поток) = 0 Тогда 
		Возврат;	                                                              
	ИначеЕсли СЧАТекущее = 0 И СЧАПредыдущее <> 0 Тогда	
		ДнейРасчета = ПересчетДней(ДнейРасчета, ПериодРасчета, НачалоПериодаРасчета);
		НачалоПериодаРасчета = Неопределено;	
		Множитель = Множитель * (СЧАТекущее - Поток)/СЧАПредыдущее;
	Иначе 
		Множитель = Множитель * (СЧАТекущее - Поток)/СЧАПредыдущее; 
	КонецЕсли;	
	
КонецПроцедуры 	

Функция ПересчетДней(ДнейРасчета, ПериодРасчета, НачалоПериодаРасчета)
	
	Если НачалоПериодаРасчета <> Неопределено Тогда 
		ДнейРасчета = ДнейРасчета + (ПериодРасчета - НачалоПериодаРасчета)/(3600*24);
	Иначе
		ДнейРасчета = ДнейРасчета + 0;  // не было актива;
	КонецЕсли;	
	
	Возврат ДнейРасчета;
	
КонецФункции	

Функция ПолучитьДоходностьВПроцентах(Множитель, ДнейУчетаАктива, ДнейВГоду)
	
	Если ДнейУчетаАктива <> 0 Тогда 		
		Возврат Окр((Множитель - 1)/ДнейУчетаАктива*ДнейВГоду*100, 2);
	Иначе 
		Возврат 0;   //актива не было. Доходность = 0;
	КонецЕсли;
	
КонецФункции	