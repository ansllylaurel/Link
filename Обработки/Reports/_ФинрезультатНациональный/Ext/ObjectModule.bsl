	|	_ТаблицаОтчета.Показатель КАК Показатель,
	|	_ТаблицаОтчета.Выделение КАК Выделение,
	|	ЕСТЬNULL(_Показатели.Акции, 0) / &Коэффициент КАК Акции,
	|	ЕСТЬNULL(_Показатели.Гос, 0) / &Коэффициент КАК Гос,
	|	ЕСТЬNULL(_Показатели.Корп, 0) / &Коэффициент КАК Корп,
	|	ЕСТЬNULL(_Показатели.Депозиты, 0) / &Коэффициент КАК Депозиты,
	|	ЕСТЬNULL(_Показатели.Иное, 0) / &Коэффициент КАК Иное,
	|	ЕСТЬNULL(_Показатели.Итого, 0) / &Коэффициент КАК Итого
	|ИЗ
	|	_ТаблицаОтчета КАК _ТаблицаОтчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ _Показатели КАК _Показатели
	|		ПО _ТаблицаОтчета.Порядок = _Показатели.Порядок";
#КонецОбласти	
	
	Возврат ТекстЗапроса; 
	
КонецФункции	

Процедура Сформировать(ДокументРезультат, ДокументРасшифровкаПоказатели, ДокументРасшифровкаДоходность, Настройка) Экспорт
	
	Сессия = Неопределено;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,СчетДоверительногоУправления");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();	
	
	Попытка
    	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
	Исключение
	КонецПопытки;	
	
	ДокументРезультат.Очистить();
	ДокументРасшифровкаПоказатели.Очистить();
	ДокументРасшифровкаДоходность.Очистить();	
	
	ЕдиницаИзмерения = Настройка.ЕдиницаИзмерения;
	КолЗнак = Настройка.ТочностьЕдиницыИзмерения;
	
	Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1 Тогда 
		НазвЕИ = "руб";
		Коэффициент = 1;				
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда 
		НазвЕИ = "тыс. руб";
		Коэффициент = 1000;		
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда 
		НазвЕИ = "млн. руб";
		Коэффициент = 1000000;	
	КонецЕсли;	
	СтрокаФормат = "ЧДЦ="+КолЗнак+"; ЧРД=,; ЧРГ=' '; ЧН=-; ЧГ=3,0";
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	РаботаСОтчетами.ДополнитьТекстЗапросаДляОтчетаОФинансовыхРезультатахВРазрезеАналитики(Запрос);
	
	Запрос.Текст = Запрос.Текст + ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("ВнешняяТаблица", СоздатьТаблицуОтчета(НазвЕИ));
	Запрос.УстановитьПараметр("НачалоПериода", ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Коэффициент", Коэффициент);

	
	КатегорииГос = Новый Массив;
	КатегорииГос.Добавить(Перечисления.КатегорииОблигаций.Государственная);
	КатегорииГос.Добавить(Перечисления.КатегорииОблигаций.Субфедеральная);
	КатегорииГос.Добавить(Перечисления.КатегорииОблигаций.Муниципальная);
	Запрос.УстановитьПараметр("КатегорииГос", КатегорииГос);
	
	ДатаСЧАНачало = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
				ЭтотОбъект.Организация, 
				ЭтотОбъект.СчетДоверительногоУправления, 
				НачалоДня(ЭтотОбъект.Период.ДатаНачала) - 3600*24);
				
	Если ДатаСЧАНачало = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет СЧА на " + Формат(НачалоДня(ЭтотОбъект.Период.ДатаНачала) - 3600*24, "ДФ=dd.MM.yyyy"));				
		Возврат;
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("ДатаСЧАНачало", ДатаСЧАНачало);
	
	ДатаСЧАКонец = РегистрыСведений.НастройкиФормированияСЧА.ПолучитьБлижайшуюДатуФормированияСЧА(
				ЭтотОбъект.Организация, 
				ЭтотОбъект.СчетДоверительногоУправления, 
				НачалоДня(ЭтотОбъект.Период.ДатаОкончания));
				
	Если ДатаСЧАКонец = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет СЧА на " + Формат(НачалоДня(ЭтотОбъект.Период.ДатаОкончания), "ДФ=dd.MM.yyyy"));				
		Возврат;
	КонецЕсли;	
				
				
	Запрос.УстановитьПараметр("ДатаСЧАКонец", ДатаСЧАКонец);
		
	СчетаДоходыРасходы = Новый Массив;
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ПрочиеДоходыРасходы);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоОбеспечениюДеятельности);   
	//СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыПоРезервам);
	СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыИРасходыПоДеятельностиПоНПО);   
	//СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыОтОпераций11);  //курсовые разницы
	//СчетаДоходыРасходы.Добавить(ПланыСчетов.Единый.ДоходыРасходыОтОпераций12);   

	Запрос.УстановитьПараметр("СчетаДоходыРасходы", СчетаДоходыРасходы);	
	
	Запрос.УстановитьПараметр("Счет47903", ПланыСчетов.Единый.АктивыВДУ03);	
	Запрос.УстановитьПараметр("Счет710", ПланыСчетов.Единый.ПроцентныеДоходы01);	
																			   
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Макет = ПолучитьМакет("Отчет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтр = Макет.ПолучитьОбласть("СтрОбычная");
	ОбластьСтрПолужирная = Макет.ПолучитьОбласть("СтрПолужирная");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьСтр.Область("R1C3:R1C9").Формат = СтрокаФормат;
	ОбластьСтрПолужирная.Область("R1C3:R1C9").Формат = СтрокаФормат;
	
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда 
		ОбластьШапка.Параметры.ВидДоговора = "ПР";
		ОбластьШапка.Параметры.ВидДоговора2 = "ПЕНСИОННЫХ РЕЗЕРВОВ";
	ИначеЕсли ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
		ОбластьШапка.Параметры.ВидДоговора = "ПН";
		ОбластьШапка.Параметры.ВидДоговора2 = "ПЕНСИОННЫХ НАКОПЛЕНИЙ";
	КонецЕсли;			
	
	ОбластьШапка.Параметры.НазвЕИ = НазвЕИ;
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Выделение Тогда 
			ЗаполнитьЗначенияСвойств(ОбластьСтрПолужирная.Параметры, Выборка);
			ДокументРезультат.Вывести(ОбластьСтрПолужирная);			
		Иначе
			ЗаполнитьЗначенияСвойств(ОбластьСтр.Параметры, Выборка);
			ДокументРезультат.Вывести(ОбластьСтр);
		КонецЕсли;	
	КонецЦикла;	
	
	ОбластьДоходность = Макет.ПолучитьОбласть("СтрДоходность");
	Доходность = РасчитатьДоходность(ДокументРасшифровкаДоходность, ДатаСЧАНачало, ДатаСЧАКонец);
	ЗаполнитьЗначенияСвойств(ОбластьДоходность.Параметры, Доходность);
	ДокументРезультат.Вывести(ОбластьДоходность); 
	ДокументРезультат.Вывести(ОбластьПодвал);
	
	//расшифрока 
#Область ЗапросРасшифровка

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Расшифровка.Порядок КАК Порядок,
		|	_Расшифровка.РазделОтчета КАК РазделОтчета,
		|	_Расшифровка.Аналитика КАК Аналитика,
		|	_Расшифровка.Акции КАК Акции,
		|	_Расшифровка.Гос КАК Гос,
		|	_Расшифровка.Корп КАК Корп,
		|	_Расшифровка.Депозиты КАК Депозиты,
		|	_Расшифровка.Иное КАК Иное
		|ИЗ
		|	_Расшифровка КАК _Расшифровка
		|ИТОГИ
		|	СУММА(Акции),
		|	СУММА(Гос),
		|	СУММА(Корп),
		|	СУММА(Депозиты),
		|	СУММА(Иное)
		|ПО
		|	Порядок,
		|	РазделОтчета";

	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
#КонецОбласти

	Макет = ПолучитьМакет("РасшифровкаПоказателей");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьПоказатели = Макет.ПолучитьОбласть("СтрПоказатели");
	ОбластьАналитика = Макет.ПолучитьОбласть("СтрАналитика");
	ОбластьДетали = Макет.ПолучитьОбласть("СтрДетали");
	
	ДокументРасшифровкаПоказатели.Вывести(ОбластьШапка);
	
	Пока Выборка.Следующий() Цикл 
		
		ЗаполнитьЗначенияСвойств(ОбластьПоказатели.Параметры, Выборка);
		Если Выборка.Порядок = 7  Тогда
			ОбластьПоказатели.Параметры.НомерСтроки = "5.1";
		ИначеЕсли Выборка.Порядок = 8  Тогда
			ОбластьПоказатели.Параметры.НомерСтроки = "5.2";
		ИначеЕсли  Выборка.Порядок = 9 ИЛИ Выборка.Порядок = 10  Тогда
			ОбластьПоказатели.Параметры.НомерСтроки = "5.3, 5.4 без разделения";
		КонецЕсли;	
		
		ДокументРасшифровкаПоказатели.Вывести(ОбластьПоказатели);
		
		ВыборкаРазделы = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ДокументРасшифровкаПоказатели.НачатьГруппуСтрок();
		Пока ВыборкаРазделы.Следующий() Цикл 
			ЗаполнитьЗначенияСвойств(ОбластьАналитика.Параметры, ВыборкаРазделы);
			ДокументРасшифровкаПоказатели.Вывести(ОбластьАналитика);
			
			ВыборкаДетали = ВыборкаРазделы.Выбрать(ОбходРезультатаЗапроса.Прямой);
			
			ДокументРасшифровкаПоказатели.НачатьГруппуСтрок();
			Пока ВыборкаДетали.Следующий() Цикл 
				ЗаполнитьЗначенияСвойств(ОбластьДетали.Параметры, ВыборкаДетали);
				ДокументРасшифровкаПоказатели.Вывести(ОбластьДетали);
			КонецЦикла; 	
			ДокументРасшифровкаПоказатели.ЗакончитьГруппуСтрок();
		КонецЦикла;	
		ДокументРасшифровкаПоказатели.ЗакончитьГруппуСтрок();		
	КонецЦикла;	
	ДокументРасшифровкаПоказатели.ПоказатьУровеньГруппировокСтрок(0);
	
	
#Область ЗапросПроцентыПолученные

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПроцентыПолученные.Регистратор КАК Регистратор,
		|	_ПроцентыПолученные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_ПроцентыПолученные.Акции КАК Акции,
		|	_ПроцентыПолученные.Гос КАК Гос,
		|	_ПроцентыПолученные.Корп КАК Корп,
		|	_ПроцентыПолученные.Депозиты КАК Депозиты,
		|	_ПроцентыПолученные.Иное КАК Иное
		|ИЗ
		|	_ПроцентыПолученные КАК _ПроцентыПолученные
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистратор
		|ИТОГИ
		|	СУММА(Акции),
		|	СУММА(Гос),
		|	СУММА(Корп),
		|	СУММА(Депозиты),
		|	СУММА(Иное)
		|ПО
		|	ОБЩИЕ";

	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

#КонецОбласти

	ОбластьШапка2 = Макет.ПолучитьОбласть("Шапка2");
	ОбластьСтр = Макет.ПолучитьОбласть("Стр");
	
	ДокументРасшифровкаПоказатели.Вывести(ОбластьШапка2);
	
	Пока Выборка.Следующий() Цикл 
		
		ЗаполнитьЗначенияСвойств(ОбластьСтр.Параметры, Выборка);
		ДокументРасшифровкаПоказатели.Вывести(ОбластьСтр);
		
		ВыборкаДетали = Выборка.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		ДокументРасшифровкаПоказатели.НачатьГруппуСтрок();
		Пока ВыборкаДетали.Следующий() Цикл 
			ЗаполнитьЗначенияСвойств(ОбластьСтр.Параметры, ВыборкаДетали);
			ДокументРасшифровкаПоказатели.Вывести(ОбластьСтр);
		КонецЦикла; 	
		ДокументРасшифровкаПоказатели.ЗакончитьГруппуСтрок();
		
	КонецЦикла;	
	ДокументРасшифровкаПоказатели.ПоказатьУровеньГруппировокСтрок(0);
	
	Если Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	КонецЕсли;
	
КонецПроцедуры	

Функция ДатаНачалаДействияДоговора()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(МИНИМУМ(ВводыВыводыАктивовВВалютеУчета.Период), ДЕНЬ) КАК Период
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления = &СчетДоверительногоУправления";
	
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления); 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Период;
	КонецЕсли;	
	
КонецФункции	

Функция РасчитатьДоходность(ДокументРасшифровкаДоходность, ДатаСЧАНачало, ДатаСЧАКонец)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
#Область ЗапросВременныеТаблицы	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _Дни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата МЕЖДУ ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, -1) И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ЕдиныйБухгалтерскийУчетОбороты.Период, ДЕНЬ) КАК Период,
		|	ЕдиныйБухгалтерскийУчетОбороты.Субконто2 КАК Депозит,
		|	-ЕдиныйБухгалтерскийУчетОбороты.СуммаОборот КАК Сумма
		|ПОМЕСТИТЬ _КорретировкаПП
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
