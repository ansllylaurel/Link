
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Контроль остатков ценных бумаг",
		"1.57",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Вариант = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.КлючВарианта;
	
	Если Вариант = "СЧА" Тогда
		
		ПроверяемыеРеквизиты.Добавить("ПериодИнтервал");
		ПроверяемыеРеквизиты.Добавить("ВидУчета");
		
		Если ЭтотОбъект.РежимОтбора = 0 Тогда
			ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
		ИначеЕсли ЭтотОбъект.РежимОтбора = 1 Тогда
			ПроверяемыеРеквизиты.Добавить("ВидЛицензии");
		ИначеЕсли ЭтотОбъект.РежимОтбора = 2 Тогда
			ПроверяемыеРеквизиты.Добавить("ВидДоговора");
		КонецЕсли;
		
	ИначеЕсли Вариант = "СверкаСДаннымиНСД" Тогда	
		
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	Вариант = РаботаСОтчетамиКлиентСервер.ПолучитьКлючВариантаОтчета(ЭтотОбъект);
	
	СвойстваОбъектаДляСтатистики = "Период, Организация, СчетДоверительногоУправления";
	
	#Область Заполняем_параметры_с_учетом_вариантов_отчета
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ЭтотОбъект.Период);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОкончаниеПериодаГраницаДня",	новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ЭтотОбъект.Организация);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Настройки.ПараметрыДанных.Элементы.Найти("ПериодИнтервал").Использование	= Ложь;
	Настройки.ПараметрыДанных.Элементы.Найти("Календарь").Использование			= Ложь;
	Настройки.ПараметрыДанных.Элементы.Найти("ВидЛицензии").Использование		= Ложь;
	Настройки.ПараметрыДанных.Элементы.Найти("ВидДоговора").Использование		= Ложь;
	
	Если Вариант = "ФинРез" Тогда
	
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода",				ЭтотОбъект.ПериодИнтервал.ДатаНачала);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОкончаниеПериода",			НачалоДня(ЭтотОбъект.ПериодИнтервал.ДатаОкончания));
		
	ИначеЕсли Вариант = "СверкаПоДС" Тогда
		
		ЗаполнитьНастройкиСверкаПоДС(Настройки, ЭтотОбъект.СхемаКомпоновкиДанных);
		
	ИначеЕсли Вариант = "ПартииРСБУ_НУ" ИЛИ Вариант = "ПоКоличествуИВидуУчета" Тогда
		
		ЗаполнитьНастройкиПартииРСБУ_НУ(Настройки);	
		
	ИначеЕсли Вариант = "ЕПС" ИЛИ Вариант = "СверкаЕПСДляПартийНаЛицевыхСчетах" Тогда
		
		Если Вариант = "СверкаЕПСДляПартийНаЛицевыхСчетах"
			И ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) 
			И НЕ БухгалтерскийУчет.ОпределитьНастройкуУчета(ЭтотОбъект.Период, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, "ОтражатьПартииНаЛицевыхСчетах") Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для данного счет Д/у учет партий на лицевых счетах не ведется!");
			
			ОшибкаФормирования = Истина;
		
		КонецЕсли;
		
		СчетаУчета = Новый Массив;
		СчетаУчета.Добавить(ПланыСчетов.Единый.ДолговыеПрибыльУбыток);
		СчетаУчета.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажи);
		СчетаУчета.Добавить(ПланыСчетов.Единый.ДолговыеЧерезПСД);
		СчетаУчета.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажиИДоПогашения);
		СчетаУчета.Добавить(ПланыСчетов.Единый.ДолевыеПоСправедливой);
		СчетаУчета.Добавить(ПланыСчетов.Единый.ДолевыеДляПродажи);
		СчетаУчета.Добавить(ПланыСчетов.Единый.УчастиеВДочернихОбществахИПаевыхФондах);
		
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетаУчета",	СчетаУчета);
		
		МассивСчетовСПравильнымУчетомПП = Новый Массив;
		
		// Аквилон
		МассивСчетовАквилон = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Аквилон"),
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
			ТекущаяДата());

		РаботаСКоллекциями.ДополнитьМассив(МассивСчетовСПравильнымУчетомПП, МассивСчетовАквилон, Ложь);

		// Национальный
		МассивСчетовНациональный = РегистрыСведений.КлиентыДоверительногоУправления.СчетаДоверительногоУправленияКлиента(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"),
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"),
			ТекущаяДата());

		РаботаСКоллекциями.ДополнитьМассив(МассивСчетовСПравильнымУчетомПП, МассивСчетовНациональный, Ложь);
		
		
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("МассивСчетовСПравильнымУчетомПП",	МассивСчетовСПравильнымУчетомПП);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Облигация_Автодор_002",				ОбщегоНазначения.ПолучитьИменованныйОбъект("Облигация_Автодор_002"));
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДУ_РЭМ",				ОбщегоНазначения.ПолучитьИменованныйОбъект("СчетДУ_РЭМ"));
		
	ИначеЕсли Вариант = "СЧА" Тогда
		
		#Область Настройки_варианта_СЧА
		
		Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
			НаборыДанныхСверкаПоСЧА = ЭтотОбъект.СхемаКомпоновкиДанных.НаборыДанных.Найти("СверкаПоСЧА");
			НаборыДанныхСверкаПоСЧА.Запрос = СтрЗаменить(
				НаборыДанныхСверкаПоСЧА.Запрос,
				"РегистрБухгалтерии.БухгалтерскийУчет",
				"РегистрБухгалтерии." + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета)
			);
		КонецЕсли;
		
		// Для сверки по СЧА определим выбранные поля
		ТекущиеНастройки = КомпоновщикНастроек.ПолучитьНастройки();

		//Отображать ЦБ из бух.партий
		ОтображатьДанныеИзБухПартий = ПолучитьИспользованиеЭлементаУсловногоОформления(ТекущиеНастройки, "Отображать ЦБ из бух.партий");
		УстановитьИспользованиеВыбранногоПоля(КомпоновщикНастроек.Настройки, "Сумма_Партии", ОтображатьДанныеИзБухПартий);
		УстановитьИспользованиеВыбранногоПоля(КомпоновщикНастроек.Настройки, "НКД_Партии", ОтображатьДанныеИзБухПартий);
		УстановитьИспользованиеВыбранногоПоля(КомпоновщикНастроек.Настройки, "СЧА_Партии", ОтображатьДанныеИзБухПартий);
		УстановитьИспользованиеВыбранногоПоля(КомпоновщикНастроек.Настройки, "Количество_Партии", ОтображатьДанныеИзБухПартий);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОтображатьДанныеИзБухПартий", ОтображатьДанныеИзБухПартий);
		
		// Отображать ЦБ из остатков на счетах БУ (58, 76.П)
		ОтображатьДанныеИзОстатковНаСчетахБУ = ПолучитьИспользованиеЭлементаУсловногоОформления(ТекущиеНастройки, "Отображать тело и купон ЦБ");
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОтображатьДанныеИзОстатковНаСчетахБУ", ОтображатьДанныеИзОстатковНаСчетахБУ);

		//Отображать для ЦБ только итоги
		ОтображатьДляЦБТолькоИтоги = НЕ ОтображатьДанныеИзОстатковНаСчетахБУ;
		
		КоличествоЭлементов = Настройки.Выбор.Элементы.Количество();
		Для сц =0 по КоличествоЭлементов-1 Цикл
			ЭлементВыбора = Настройки.Выбор.Элементы.Получить(сц);
			Если ЭлементВыбора.Заголовок = "Сумма" 
				ИЛИ ЭлементВыбора.Заголовок = "НКД"
			Тогда
				ЭлементВыбора.Использование = НЕ ОтображатьДляЦБТолькоИтоги;
			КонецЕсли;
		КонецЦикла;

		// Установим параметры
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидУчета",					ЭтотОбъект.ВидУчета);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ЦельРасчета",				Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаФормирования",			КонецДня(ЭтотОбъект.ПериодИнтервал.ДатаОкончания));
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("НачалоПериода",				ЭтотОбъект.ПериодИнтервал.ДатаНачала);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОкончаниеПериода",			НачалоДня(ЭтотОбъект.ПериодИнтервал.ДатаОкончания));
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОкончаниеПериодаКонецДня",	Новый Граница(КонецДня(ЭтотОбъект.ПериодИнтервал.ДатаОкончания), ВидГраницы.Включая));
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ПериодИнтервал",				ЭтотОбъект.ПериодИнтервал);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Календарь",					Справочники.Календари.Общероссийский);
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВыводимыеДни",				ЭтотОбъект.ВыводимыеДни);	
		
		Настройки.ПараметрыДанных.Элементы.Найти("Период").Использование = Ложь;
		Настройки.ПараметрыДанных.Элементы.Найти("СчетДоверительногоУправления").Использование = Ложь;
		
		Если ЭтотОбъект.РежимОтбора = 0 Тогда
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		ИначеЕсли ЭтотОбъект.РежимОтбора = 1 Тогда
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидЛицензии", ЭтотОбъект.ВидЛицензии);
		ИначеЕсли ЭтотОбъект.РежимОтбора = 2 Тогда
			Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидДоговора", ЭтотОбъект.ВидДоговора);
		КонецЕсли;
		
		// Следующие настройки определяю костыльным образом в запросе,
		// при добавлении хранимых (не расчетных) настроек запрос следует скорректировать:
		//	УчитыватьВСЧАРезервыЗаВознаграждениеДепозитария
		//	УчитыватьВСЧАРезервыЗаВознаграждениеУправляющего
		//	УчитыватьВСЧАРезервыЗаПрочиеВозмещаемыеРасходыУправляющего
		
		#КонецОбласти
		
	ИначеЕсли Вариант = "СверкаСДаннымиНСД" Тогда
		
		// Исключаем период, т.к. он определяется из данных файла
		
		СвойстваОбъектаДляСтатистики = "Организация, СчетДоверительногоУправления"; 
		
		Настройки.ПараметрыДанных.Элементы.Найти("Период").Использование					 = Ложь;
		Настройки.ПараметрыДанных.Элементы.Найти("ОкончаниеПериодаГраницаДня").Использование = Ложь;
		
	ИначеЕсли Вариант = "Сверка7раздел" Тогда 
		
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("КлиентСургут",				ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Сургутнефтегаз"));
		//хардкод в запрросе  _КорректировкаПредварительно. У сургутов стоит настройка ОтражатьПартииНаЛицевыхСчетах = Да, но на Корретировке нет партий. суммы надо сворачивать. 
		
	КонецЕсли;
	
	#КонецОбласти
	
	#Область Регистрируем_новую_сессию_статистики
	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПриКомпоновкеРезультата()";
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, СвойстваОбъектаДляСтатистики, Новый Структура("Вариант", Вариант));
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
		
	ДополнительныеПараметрыСтатистикиПоРезультатамРаботы = Новый Структура;
	
	#КонецОбласти
	
	ОшибкаФормирования = Ложь;	
	ВнешниеНаборыДанных = Неопределено;
	
	Если Вариант = "СверкаСуммБУ_НУ" Тогда
		
		#Область Сверка_сумм_РСБУ_НУ					
		
		ОстаткиПартийСверка = Неопределено;
		
		ЗаполнитьНастройкиПартииСверкаСуммБУ_НУ(Настройки, ОстаткиПартийСверка);
		
		ВнешниеНаборыДанных = Новый Структура("ДанныеСверкиРСБУ", ОстаткиПартийСверка);
		
		#КонецОбласти		
		
	ИначеЕсли Вариант = "СверкаСПереоценкой" Тогда
		
		#Область Сверка_с_переоценкой			
		
		СтрокиПереоценкиСверка = Неопределено;	
		
		ЗаполнитьНастройкиПартииСверкаСПереоценкой(Настройки, СтрокиПереоценкиСверка);	
					
		ВнешниеНаборыДанных = Новый Структура("ДанныеСверкиСПереоценкой", СтрокиПереоценкиСверка);
		
		#КонецОбласти		
		
	ИначеЕсли Вариант = "СверкаРЕПО" Тогда
		
		#Область Сверка_РЕПО
		
		ДанныеСверкиПоРЕПО = Неопределено;
		
		ЗаполнитьНастройкиПартииСверкаРЕПО(Настройки, ДанныеСверкиПоРЕПО);
		
		ВнешниеНаборыДанных = Новый Структура("ДанныеСверкиПоРЕПО", ДанныеСверкиПоРЕПО);
		
		#КонецОбласти		

	ИначеЕсли Вариант = "СверкаСДаннымиНСД" Тогда
			
		#Область Сверка_с_данными_НСД
		
		АдресФайлаНСД	= КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.АдресФайлаНСД;
		ИмяФайлаНСД		= ПолучитьИмяВременногоФайла("XLSX");
		
		ДвоичныеДанныеФайлаНСД = ПолучитьИзВременногоХранилища(АдресФайлаНСД);	
		ДвоичныеДанныеФайлаНСД.Записать(ИмяФайлаНСД);
		
		ДанныеНСД = Новый ТабличныйДокумент;
		
		Попытка
			ДанныеНСД.Прочитать(ИмяФайлаНСД);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка чтения файла: " + ОписаниеОшибки(), , , , ОшибкаФормирования);
		КонецПопытки;
		
		УдалитьФайлы(ИмяФайлаНСД);
		
		Если Не ОшибкаФормирования Тогда
			
			ИскомыйПрефиксОтчета = "Справка по расчету стоимости облигации";
			ПрефиксОтчета		 = ДанныеНСД.Область(2, 2).Текст; 
			
			ИскомыйПрефиксДаты	= "Отчетная дата:";
			ПрефиксДаты			= ДанныеНСД.Область(3, 2).Текст; 
			
			Если Не СтрНачинаетсяС(ПрефиксОтчета, ИскомыйПрефиксОтчета) ИЛИ Не СтрНачинаетсяС(ПрефиксДаты, ИскомыйПрефиксДаты) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Формат отчета не соответствует ожидаемому.", , , , ОшибкаФормирования);
			КонецЕсли;
			
			Если Не ОшибкаФормирования Тогда
			
				// Получаем бумагу
				
				ОписаниеБумаги			= Сред(ПрефиксОтчета, СтрДлина(ИскомыйПрефиксОтчета) + 1);
				РазделительКодаБумаги	= СтрНайти(ОписаниеБумаги, "/");
				КодБумаги				= СокрЛП(?(РазделительКодаБумаги > 0, Сред(ОписаниеБумаги, 1, РазделительКодаБумаги - 1), ОписаниеБумаги));
				
				ЦеннаяБумага = Справочники.Облигации.НайтиПоРеквизиту("ГосударственныйРегистрационныйНомер", КодБумаги);
			
				Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
					ДополнительныеПараметрыСтатистикиПоРезультатамРаботы.Вставить("ЦеннаяБумага", ЦеннаяБумага);		
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось найти бумагу по коду '%1'", КодБумаги), , , , ОшибкаФормирования);
				КонецЕсли;
				
				Если Не ОшибкаФормирования Тогда
				
					// Получаем дату отчета
					
					ДатаСтрокой = СокрЛП(Сред(ПрефиксДаты, СтрДлина(ИскомыйПрефиксДаты) + 1));
					
					Попытка
						ЭтотОбъект.Период = Дата(ДатаСтрокой + " 00:00:00");
					Исключение
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось определить отчетную дату по строке '%1'", ДатаСтрокой), , , , ОшибкаФормирования);
					КонецПопытки;
					
					Если Не ОшибкаФормирования Тогда
						
						Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ЭтотОбъект.Период);
						
						ДополнительныеПараметрыСтатистикиПоРезультатамРаботы.Вставить("Период", ЭтотОбъект.Период);		
						
						// Ищем ключевые колонки и заполняем таблицу данных
						
						ШапкаТаблицы = ДанныеНСД.Область(5, , 6);
						
						Колонки = Новый Структура;
						Колонки.Вставить("КодМетода",								Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Код метода")); // Чтобы понять окончание таблицы в файле
						Колонки.Вставить("ИдентификаторПартии",						Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Идентификатор партии", , "Строка",										"СтрокаДанных1С.НомерСделки"));
						Колонки.Вставить("Количество",								Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Количество", , "Число",													"СтрокаДанных1С.Количество"));
						Колонки.Вставить("ПремияДисконтПриПП",						Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Премия/дисконт при первоначальном признании", , "Число",					"СтрокаДанных1С.ДисконтПремияПокупки"));
						Колонки.Вставить("КорректировкаПриПП",						Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Корректировка при первоначальном признании", , "Число",					"СтрокаДанных1С.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная"));
						Колонки.Вставить("СправедливаяСтоимостьНаДатуПризнания",	Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Справедливая стоимость на дату признания", , "Число",					"СтрокаДанных1С.СтоимостьПокупки + СтрокаДанных1С.РасходыПриПокупкеВСтоимости"));
						Колонки.Вставить("ПремияДисконтНаОтчетнуюДату",				Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Премия/дисконт на отчетную дату", , "Число",								"?(СтрокаДанных1С.ДисконтПремияПокупки < 0, СтрокаДанных1С.ДисконтПремияПокупки + СтрокаДанных1С.ДисконтПремияНачисленный, СтрокаДанных1С.ДисконтПремияНачисленный)"));
						Колонки.Вставить("ВеличинаСписанияПремииДисконта",			Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Величина списания премии/дисконта", , "Число",							"?(СтрокаДанных1С.ДисконтПремияПокупки < 0, -СтрокаДанных1С.ДисконтПремияНачисленный, СтрокаДанных1С.ДисконтПремияПокупки - СтрокаДанных1С.ДисконтПремияНачисленный)"));
						Колонки.Вставить("ПремияДисконтПриППСУчетомВывода",			Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Премия/дисконт при первонач. признании (с учетом вывода)", ,	"Число",	"СтрокаДанных1С.ДисконтПремия"));
						Колонки.Вставить("ОстатокПремииДисконта",					Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Остаток премии/дисконта", , "Число",										"?(СтрокаДанных1С.ДисконтПремияПокупки < 0, СтрокаДанных1С.ДисконтПремияПокупки + СтрокаДанных1С.ДисконтПремияНачисленный, СтрокаДанных1С.ДисконтПремияНачисленный)"));
						Колонки.Вставить("ОценочнаяСтоимостьНаОтчетнуюДату",		Новый Структура("ИмяКолонки, НомерКолонки, Тип, Формула", "Оценочная стоимость на отчетную дату", , "Число",						"СтрокаДанных1С.Стоимость + СтрокаДанных1С.ДисконтПремияНачисленный + СтрокаДанных1С.КорректировкаЭСП + СтрокаДанных1С.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные"));
						
						СверяемыеДанные = Новый ТаблицаЗначений;
						СверяемыеДанные.Колонки.Добавить("Примечание",		Новый ОписаниеТипов("Строка"));
						СверяемыеДанные.Колонки.Добавить("Партия",			Метаданные.ОпределяемыеТипы.Партия.Тип);
						СверяемыеДанные.Колонки.Добавить("СтрокаПартии",	Метаданные.ОпределяемыеТипы.СтрокаПартии.Тип);
						
						НенайденныеКолонки = Новый Массив;
						
						Для Каждого Колонка Из Колонки Цикл
							
							СверяемыеДанные.Колонки.Добавить(Колонка.Ключ, ?(Колонка.Значение.Тип = Неопределено, Неопределено, Новый ОписаниеТипов(Колонка.Значение.Тип)));
							Если ЗначениеЗаполнено(Колонка.Значение.Формула) Тогда
								СверяемыеДанные.Колонки.Добавить(Колонка.Ключ + "1С",			 	СверяемыеДанные.Колонки[Колонка.Ключ].ТипЗначения);
								СверяемыеДанные.Колонки.Добавить(Колонка.Ключ + "1С_Расшифровка",	Новый ОписаниеТипов("ХранилищеЗначения"));
							КонецЕсли;
							
							Область = ДанныеНСД.НайтиТекст(Колонка.Значение.ИмяКолонки, , ШапкаТаблицы, , Истина, , Истина);
							
							Если Область = Неопределено Тогда
								НенайденныеКолонки.Добавить(Колонка.Значение.ИмяКолонки);		
							Иначе
								Колонка.Значение.НомерКолонки = Область.Лево;
							КонецЕсли;
							
						КонецЦикла;
						
						Если НенайденныеКолонки.Количество() > 0 Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось найти поля: " + СтрСоединить(НенайденныеКолонки, ", "), , , , ОшибкаФормирования);
						КонецЕсли;
						
						Если Не ОшибкаФормирования Тогда
						
							#Область Заполняем_таблицу_данных_НСД
							
							Для СтрокаДанныхНСД = 7 По ДанныеНСД.ВысотаТаблицы Цикл
								
								Если ПустаяСтрока(ДанныеНСД.Область(СтрокаДанныхНСД, Колонки.КодМетода.НомерКолонки).Текст) Тогда
									Прервать;
								КонецЕсли;
								
								СтрокаДанных = СверяемыеДанные.Добавить();
								
								Для Каждого Колонка Из Колонки Цикл
									
									Если Колонка.Ключ <> "КодМетода" Тогда
										
										ЗначениеНСД = ДанныеНСД.Область(СтрокаДанныхНСД, Колонка.Значение.НомерКолонки).Текст;
										
										Если Колонка.Значение.Тип = "Число" Тогда // Проверим корректность числового значения
											
											Попытка
												СтрокаДанных[Колонка.Ключ] = Число(ЗначениеНСД);
											Исключение
												СтрокаДанных.Примечание = ?(ПустаяСтрока(СтрокаДанных.Примечание), "", СтрокаДанных.Примечание + Символы.ПС)
													+ СтрШаблон("Поле '%1' в строке %2 содержит нечисловые данные: '%3'", Колонка.Значение.ИмяКолонки, Формат(СтрокаДанныхНСД, "ЧГ="), ЗначениеНСД);
											КонецПопытки;

										Иначе
											СтрокаДанных[Колонка.Ключ] = ЗначениеНСД;
										КонецЕсли;
										
									КонецЕсли;
									
								КонецЦикла;
								
							КонецЦикла;
							
							Колонки.Удалить("КодМетода"); // больше не нужен
							
							#КонецОбласти
							
							#Область Заполняем_таблицу_данных_УК
							
							Запрос = Новый Запрос(
								"ВЫБРАТЬ РАЗРЕШЕННЫЕ
								|	ОстаткиПартий.Партия КАК Партия,
								|	ОстаткиПартий.СтрокаПартии КАК СтрокаПартии,
								|	ОстаткиПартий.КоличествоОстаток КАК Количество,
								|	ВЫБОР
								|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиПартий.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
								|			ТОГДА РеклассификацияАктивовЕПСПартии.СуммаПокупки
								|		ИНАЧЕ ОстаткиПартий.СтоимостьПокупкиОстаток
								|	КОНЕЦ КАК СтоимостьПокупки,
								|	ОстаткиПартий.РасходыПриПокупкеВСтоимостиВВалютеУчетаОстаток КАК РасходыПриПокупкеВСтоимости,
								|	ОстаткиПартий.СтоимостьВВалютеУчетаОстаток КАК Стоимость,
								|	ОстаткиПартий.ДисконтПремияОстаток КАК ДисконтПремия,
								|	ОстаткиПартий.ДисконтПремияПокупкиОстаток КАК ДисконтПремияПокупки,
								|	ОстаткиПартий.ДисконтПремияНачисленныйВВалютеУчетаОстаток КАК ДисконтПремияНачисленный,
								|	ОстаткиПартий.КорректировкаЭСПВВалютеУчетаОстаток КАК КорректировкаЭСП,
								|	ОстаткиПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальнаяОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеНачальная,
								|	ОстаткиПартий.РазницаПервоначальногоПризнанияНеНаблюдаемыеДанныеВВалютеУчетаОстаток КАК РазницаПервоначальногоПризнанияНеНаблюдаемыеДанные,
								|	ВЫБОР
								|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиПартий.Партия) = ТИП(Документ.Сделка)
								|			ТОГДА ВЫРАЗИТЬ(ОстаткиПартий.Партия КАК Документ.Сделка).НомерСделки
								|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиПартий.Партия) = ТИП(Документ.ИсполнениеОбязательствПоСделке)
								|			ТОГДА ВЫРАЗИТЬ(ВЫРАЗИТЬ(ОстаткиПартий.Партия КАК Документ.ИсполнениеОбязательствПоСделке).Основание КАК Документ.Сделка).НомерСделки
								|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиПартий.Партия) = ТИП(Документ.ВводЦенныхБумаг)
								|			ТОГДА ВЫБОР
								|					КОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки <> """"
								|						ТОГДА ВводЦенныхБумагЦенныеБумаги.НомерСделки
								|					ИНАЧЕ """"
								|				КОНЕЦ
								|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиПартий.Партия) = ТИП(Документ.РеклассификацияАктивовЕПС)
								|			ТОГДА ВЫБОР
								|					КОГДА РеклассификацияАктивовЕПСПартии.НомерСделки <> """"
								|						ТОГДА РеклассификацияАктивовЕПСПартии.НомерСделки
								|					ИНАЧЕ """"
								|				КОНЕЦ
								|		ИНАЧЕ """"
								|	КОНЕЦ КАК НомерСделки,
								|	ВЫБОР
								|		КОГДА ТИПЗНАЧЕНИЯ(ОстаткиПартий.Партия) = ТИП(Документ.ВводЦенныхБумаг)
								|				И ОстаткиПартий.Партия.Дата >= &ДатаЕПС
								|			ТОГДА ВводЦенныхБумагЦенныеБумаги.ДатаПокупки
								|		ИНАЧЕ НАЧАЛОПЕРИОДА(ОстаткиПартий.Партия.Дата, ДЕНЬ)
								|	КОНЕЦ КАК ДатаПокупки
								|ИЗ
								|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
								|			&Период,
								|			Организация = &Организация
								|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
								|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
								|				И Рынок = &Рынок
								|				И ЦеннаяБумага = &ЦеннаяБумага
								|				И (НЕ &ТолькоБумагиПоАС
								|					ИЛИ УчетныйАктивЕПС В (&УчетныеАктивыОцениваемыеПоАС))) КАК ОстаткиПартий
								|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумагЦенныеБумаги
								|		ПО ОстаткиПартий.Партия = ВводЦенныхБумагЦенныеБумаги.Ссылка
								|			И ОстаткиПартий.СтрокаПартии = ВводЦенныхБумагЦенныеБумаги.СтрокаПартии
								|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеклассификацияАктивовЕПС.Партии КАК РеклассификацияАктивовЕПСПартии
								|		ПО ОстаткиПартий.Партия = РеклассификацияАктивовЕПСПартии.Ссылка
								|			И ОстаткиПартий.СтрокаПартии = РеклассификацияАктивовЕПСПартии.НомерСтроки
								|
								|УПОРЯДОЧИТЬ ПО
								|	ДатаПокупки,
								|	Партия,
								|	СтрокаПартии");
							
							ПредставлениеОтбора			 = "Только бумаги, оцениваемые по амортизированной стоимости";
							ТолькоБумагиПоАС			 = ПолучитьИспользованиеЭлементаОтбора(КомпоновщикНастроек.ПолучитьНастройки(), ПредставлениеОтбора);
							УчетныеАктивыОцениваемыеПоАС = ?(ТолькоБумагиПоАС, Кэширование.УчетныеАктивыОцениваемыеПоАмортизированнойСтоимости(), Неопределено);
							
							Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
							Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
							Запрос.УстановитьПараметр("Рынок",							РаботаСЦеннымиБумагамиКлиентСервер.РынокПоЦеннойБумаге(ЦеннаяБумага));
							Запрос.УстановитьПараметр("ЦеннаяБумага",					ЦеннаяБумага);
							Запрос.УстановитьПараметр("Период",							Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
							Запрос.УстановитьПараметр("ДатаЕПС",						РегистрыСведений.НастройкиУчетаОбщие.ПолучитьДатуНачалаНеобходимостиДанныхЕПСВоВводахЦБ(ЭтотОбъект.СчетДоверительногоУправления));
							
							Запрос.УстановитьПараметр("ТолькоБумагиПоАС",				ТолькоБумагиПоАС);
							Запрос.УстановитьПараметр("УчетныеАктивыОцениваемыеПоАС",	УчетныеАктивыОцениваемыеПоАС);
							
							Данные1С = Запрос.Выполнить().Выгрузить();
							Данные1С.Индексы.Добавить("НомерСделки");
							Данные1С.Индексы.Добавить("Количество");
							
							Если ТолькоБумагиПоАС Тогда
								ДополнительныеПараметрыСтатистикиПоРезультатамРаботы.Вставить("Отбор", ПредставлениеОтбора);
							КонецЕсли;
							
							#КонецОбласти

							#Область Сопоставляем_данные_НСД_и_УК
							
							// Сопоставляем данные:
							// 1. сначала по номеру сделки, 
							// 2. потом по количеству
							// 3. затем переносим несопоставленные данные 1С
							
							Для ШагСопоставления = 1 По 3 Цикл
								
								Если ШагСопоставления = 1 Тогда
									Поле			= "ИдентификаторПартии";
									Поле1С			= "НомерСделки";
									ИсточникДанных	= СверяемыеДанные;
								ИначеЕсли ШагСопоставления = 2 Тогда
									Поле			= "Количество";
									Поле1С			= "Количество";
									ИсточникДанных	= СверяемыеДанные;
								Иначе
									ИсточникДанных	= Данные1С;
								КонецЕсли;
								
								ИндексСтроки			= 0;
								КоличествоСтрок			= ИсточникДанных.Количество();
								ПродолжитьСопоставление = (Данные1С.Количество() > 0) И ИндексСтроки < КоличествоСтрок;
								
								Пока ПродолжитьСопоставление Цикл
									
									Если ШагСопоставления = 3 Тогда
										СтрокаДанных	= СверяемыеДанные.Добавить();
										СтрокаДанных1С	= ИсточникДанных.Получить(ИндексСтроки);
									Иначе
										СтрокаДанных	= ИсточникДанных.Получить(ИндексСтроки);
										СтрокаДанных1С	= ?(ЗначениеЗаполнено(СтрокаДанных[Поле]), Данные1С.Найти(СтрокаДанных[Поле], Поле1С), Неопределено); 
									КонецЕсли;
									
									Если СтрокаДанных1С <> Неопределено Тогда
										
										ЗаполнитьЗначенияСвойств(СтрокаДанных, СтрокаДанных1С, "Партия, СтрокаПартии");
										
										Для каждого Колонка Из Колонки Цикл
											Если ЗначениеЗаполнено(Колонка.Значение.Формула) Тогда
												СтрокаДанных[Колонка.Ключ + "1С"]				= Вычислить(Колонка.Значение.Формула);
												СтрокаДанных[Колонка.Ключ + "1С_Расшифровка"]	= Новый ХранилищеЗначения(Новый Структура("Формула, СтрокаДанных1С", Колонка.Значение.Формула, РаботаСКоллекциями.ТаблицаЗначений_СтрокаВСтруктуру(СтрокаДанных1С)));
											КонецЕсли;
										КонецЦикла;
										
										Если ШагСопоставления <> 3 Тогда
											Данные1С.Удалить(СтрокаДанных1С);
										КонецЕсли;
										
									КонецЕсли;
									
									ИндексСтроки = ИндексСтроки + 1;
									
									ПродолжитьСопоставление = (Данные1С.Количество() > 0) И ИндексСтроки < КоличествоСтрок;
										
								КонецЦикла;
								
							КонецЦикла;

							#КонецОбласти
							
							// Добавляем результаты сверки во внешние данные
							
							Для Каждого Колонка Из СверяемыеДанные.Колонки Цикл
								Колонка.Имя = "СверкаСДаннымиНСД_" + Колонка.Имя;							
							КонецЦикла;
							
							ВнешниеНаборыДанных = Новый Структура("СверкаСДаннымиНСД", СверяемыеДанные);
							
						КонецЕсли;
					
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
		
		#КонецОбласти
		
	КонецЕсли;
	
	// При ошибке формирования прерываем построение отчета 
	
	Если ОшибкаФормирования Тогда
			
		СтандартнаяОбработка = Ложь;
		
	Иначе
		
		// Выполняем программную компоновку
		
		ДополнительныеПараметры = Новый Структура("РегистрацияСтатистики", Ложь);
		
		РаботаСОтчетами.ВыполнитьКомпоновкуПрограммно(ЭтотОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка,,,, ВнешниеНаборыДанных, ДополнительныеПараметры);	
		
		#Область Сворачиваем_группировки
		
		Если Вариант = "СЧА" Тогда
			
			СворачиватьГруппировки = ПолучитьИспользованиеЭлементаУсловногоОформления(КомпоновщикНастроек.ПолучитьНастройки(), "Сворачивать группы строк");
			Если СворачиватьГруппировки Тогда
				ДокументРезультат.ПоказатьУровеньГруппировокСтрок(1);
				ДокументРезультат.ПоказатьУровеньГруппировокСтрок(0);
			КонецЕсли;
			
		ИначеЕсли Вариант = "СверкаРЕПО" Тогда
			
			ДокументРезультат.ПоказатьУровеньГруппировокСтрок(2);		
			
		КонецЕсли;
		
		#КонецОбласти
		
		// Заполняем настройки печати	
		
		РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());		
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , ДополнительныеПараметрыСтатистикиПоРезультатамРаботы);	
	
КонецПроцедуры

#Область Вспомогательные_функции

Функция НайтиВыбранноеПоле(ВсеПоля, Поле)
	Если ТипЗнч(Поле) = Тип("Строка") Тогда
		ИскомоеПоле = Новый ПолеКомпоновкиДанных(Поле);
	Иначе
		ИскомоеПоле = Поле;
	КонецЕсли;
	
	Для Каждого ВыбранноеПоле Из ВсеПоля Цикл
		Если ТипЗнч(ВыбранноеПоле) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			НайденноеПоле = НайтиВыбранноеПоле(ВыбранноеПоле.Элементы, ИскомоеПоле);
			Если НайденноеПоле <> Неопределено Тогда
				Возврат НайденноеПоле;
			КонецЕсли;
		ИначеЕсли ВыбранноеПоле.Поле = ИскомоеПоле Тогда
			Возврат ВыбранноеПоле;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

Процедура УстановитьИспользованиеВыбранногоПоля(Настройки, Поле, Использование)
	ВыбранноеПоле = НайтиВыбранноеПоле(Настройки.Выбор.Элементы, Поле);
	Если ВыбранноеПоле <> Неопределено Тогда
		ВыбранноеПоле.Использование = Использование;
	КонецЕсли;		
КонецПроцедуры

Функция ПолучитьИспользованиеЭлементаУсловногоОформления(Настройки, ПредставлениеЭлемента)
	
	Возврат ПолучитьИспользованиеЭлементаНастроекПоПредставлению(Настройки.УсловноеОформление, ПредставлениеЭлемента);
	
КонецФункции

Функция ПолучитьИспользованиеЭлементаОтбора(Настройки, ПредставлениеЭлемента)
	
	Возврат ПолучитьИспользованиеЭлементаНастроекПоПредставлению(Настройки.Отбор, ПредставлениеЭлемента);
	
КонецФункции

Функция ПолучитьИспользованиеЭлементаНастроекПоПредставлению(Настройки, ПредставлениеЭлемента)
	
	Для Каждого ЭлементНастроек Из Настройки.Элементы Цикл
		Если ЭлементНастроек.Представление = ПредставлениеЭлемента Тогда
			Возврат ЭлементНастроек.Использование;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;

КонецФункции

Функция ПолучитьУчетныеАктивы(Купоны = Ложь)
	
	Результат = новый Массив;
	
	Если НЕ Купоны Тогда
		Результат.Добавить(Справочники.УчетныеАктивы.Акции);
		Результат.Добавить(Справочники.УчетныеАктивы.АкцииИностранныхЭмитентов);
		Результат.Добавить(Справочники.УчетныеАктивы.ВекселяДисконтные);
		Результат.Добавить(Справочники.УчетныеАктивы.ВекселяПроцентные);
		Результат.Добавить(Справочники.УчетныеАктивы.Еврооблигации);
		Результат.Добавить(Справочники.УчетныеАктивы.ИпотечныеСертификатыУчастия);
		Результат.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальные);
		Результат.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалюте);
		Результат.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративные);
		Результат.Добавить(Справочники.УчетныеАктивы.Паи);
		Результат.Добавить(Справочники.УчетныеАктивы.ПаиИностранныхЭмитентов);
		Результат.Добавить(Справочники.УчетныеАктивы.Доли);
	Иначе
		Результат.Добавить(Справочники.УчетныеАктивы.ЕврооблигацииКупон);
		Результат.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеИМуниципальныеКупон);
		Результат.Добавить(Справочники.УчетныеАктивы.ОблигацииГосударственныеНоминированныеВИностраннойВалютеКупон);
		Результат.Добавить(Справочники.УчетныеАктивы.ОблигацииКорпоративныеКупон);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьНастройкиСверкаПоДС(Настройки, СхемаКомпоновкиДанных)
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Рубли",				ЭтотОбъект.Организация.ВалютаУчета);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидУчета",			ЭтотОбъект.ВидУчета);
	
	Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
		
		//НаборыДанныхСверкаПоДС = ЭтотОбъект.СхемаКомпоновкиДанных.НаборыДанных.Найти("СверкаПоДС");
		НаборыДанныхСверкаПоДС = СхемаКомпоновкиДанных.НаборыДанных.Найти("СверкаПоДС");
		
		НаборыДанныхСверкаПоДС.Запрос = СтрЗаменить(
		НаборыДанныхСверкаПоДС.Запрос,
		"БухгалтерскийУчет",
		РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета)
		);
	КонецЕсли;
	
КонецПроцедуры 	

Процедура ЗаполнитьНастройкиПартииРСБУ_НУ(Настройки)
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидУчета", ЭтотОбъект.ВидУчета);
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиПартииСверкаСуммБУ_НУ(Настройки, ОстаткиПартийСверка)
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВложенныйЗапрос.Рынок КАК Рынок,
			|	ВложенныйЗапрос.ЦеннаяБумага КАК ЦеннаяБумага,
			|	СУММА(ВложенныйЗапрос.СтоимостьВВалютеУчетаОстаток) КАК СтоимостьВВалютеУчетаОстаток,
			|	СУММА(ВложенныйЗапрос.ПереоценкаВВалютеУчетаОстаток) КАК ПереоценкаВВалютеУчетаОстаток,
			|	СУММА(ВложенныйЗапрос.СтоимостьКупонаВВалютеУчетаОстаток) КАК СтоимостьКупонаВВалютеУчетаОстаток,
			|	СУММА(ВложенныйЗапрос.ПереоценкаКупонаВВалютеУчетаОстаток) КАК ПереоценкаКупонаВВалютеУчетаОстаток,
			|	СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК КоличествоОстаток,
			|	СУММА(ВложенныйЗапрос.ИндексацияНоминалаОстаток) КАК ИндексацияНоминалаОстаток,
			|	СУММА(ВложенныйЗапрос.ИндексацияНоминалаЗаВремяВладенияОстаток) КАК ИндексацияНоминалаЗаВремяВладенияОстаток,
			|	СУММА(ВложенныйЗапрос.СтоимостьОстаток) КАК СтоимостьОстаток,
			|	СУММА(ВложенныйЗапрос.ПереоценкаОстаток) КАК ПереоценкаОстаток,
			|	СУММА(ВложенныйЗапрос.СтоимостьКупонаОстаток) КАК СтоимостьКупонаОстаток,
			|	СУММА(ВложенныйЗапрос.ПереоценкаКупонаОстаток) КАК ПереоценкаКупонаОстаток,
			|	ВложенныйЗапрос.ПроданоВРЕПО КАК ПроданоВРЕПО,
			|	ВложенныйЗапрос.КупленоПоРЕПО КАК КупленоПоРЕПО
			|ИЗ
			|	(ВЫБРАТЬ
			|		БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		БухПартииЦенныхБумагОстатки.Рынок КАК Рынок,
			|		БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
			|		СУММА(БухПартииЦенныхБумагОстатки.СтоимостьВВалютеУчетаОстаток) КАК СтоимостьВВалютеУчетаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаВВалютеУчетаОстаток) КАК ПереоценкаВВалютеУчетаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.СтоимостьКупонаВВалютеУчетаОстаток) КАК СтоимостьКупонаВВалютеУчетаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаКупонаВВалютеУчетаОстаток) КАК ПереоценкаКупонаВВалютеУчетаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.КоличествоОстаток) КАК КоличествоОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.ИндексацияНоминалаОстаток) КАК ИндексацияНоминалаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.ИндексацияНоминалаЗаВремяВладенияОстаток) КАК ИндексацияНоминалаЗаВремяВладенияОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.СтоимостьОстаток) КАК СтоимостьОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаОстаток) КАК ПереоценкаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.СтоимостьКупонаОстаток) КАК СтоимостьКупонаОстаток,
			|		СУММА(БухПартииЦенныхБумагОстатки.ПереоценкаКупонаОстаток) КАК ПереоценкаКупонаОстаток,
			|		ЛОЖЬ КАК ПроданоВРЕПО,
			|		ЛОЖЬ КАК КупленоПоРЕПО
			|	ИЗ
			|		РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
			|				&ОкончаниеПериодаКонецДня,
			|				Организация = &Организация
			|					И ВидУчета = &ВидУчета
			|					И (СчетДоверительногоУправления = &СчетДоверительногоУправления
			|						ИЛИ &СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))) КАК БухПартииЦенныхБумагОстатки
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(
			|					&ОкончаниеПериодаКонецДня,
			|					Организация = &Организация
			|						И (СчетДоверительногоУправления = &СчетДоверительногоУправления
			|							ИЛИ &СчетДоверительногоУправления = ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))) КАК НастройкиУчетаОбщиеСрезПоследних
