			|				ИЛИ ЕСТЬNULL(БухгалтерскийУчетОстатки.Счет, ЗНАЧЕНИЕ(ПланСчетов.Основной.)) = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПартииРЕПОПокупкаТело)
			|				ИЛИ ЕСТЬNULL(БухгалтерскийУчетОстаткиКупон.Счет, ЗНАЧЕНИЕ(ПланСчетов.Основной.)) = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПартииРЕПОПокупкаКупон)
			|			ТОГДА ""Куплены по РЕПО""
			|		ИНАЧЕ ""Собственные""
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА НЕ ОстаткиПартийСчетаУчета.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА ОстаткиПартийСчетаУчета.ЦеннаяБумага
			|		КОГДА НЕ БухгалтерскийУчетОстатки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА БухгалтерскийУчетОстатки.ЦеннаяБумага
			|		КОГДА НЕ БухгалтерскийУчетОстаткиКупон.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА БухгалтерскийУчетОстаткиКупон.ЦеннаяБумага
			|		КОГДА НЕ БухгалтерскийУчетОстаткиПереоценка.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА БухгалтерскийУчетОстаткиПереоценка.ЦеннаяБумага
			|		КОГДА НЕ БухгалтерскийУчетОстаткиПереоценкаКупона.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА БухгалтерскийУчетОстаткиПереоценкаКупона.ЦеннаяБумага
			|		КОГДА НЕ БухгалтерскийУчетИндексацияНоминалаОстатки.ЦеннаяБумага ЕСТЬ NULL
			|			ТОГДА БухгалтерскийУчетИндексацияНоминалаОстатки.ЦеннаяБумага
			|		ИНАЧЕ 0
			|	КОНЕЦ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиВсе.СчетДоверительногоУправления КАК СчетДоверительногоУправленияСверкаРСБУ,
			|	ОстаткиВсе.Рынок КАК Рынок,
			|	ОстаткиВсе.УчетныйАктив КАК УчетныйАктивСверкаРСБУ,
			|	ОстаткиВсе.ЦеннаяБумага КАК ЦеннаяБумагаСверкаРСБУ,
			|	ОстаткиВсе.КоличествоПартии КАК КоличествоПартииСверкаРСБУ,
			|	ОстаткиВсе.КоличествоБУ КАК КоличествоБУСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьВВалютеУчетаПартии КАК СтоимостьВВалютеУчетаПартииСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьВВалютеУчетаБУ КАК СтоимостьВВалютеУчетаБУСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьПартии КАК СтоимостьПартииСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьБУ КАК СтоимостьБУСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаВВалютеУчетаПартии КАК ПереоценкаВВалютеУчетаПартииСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаВВалютеУчетаБУ КАК ПереоценкаВВалютеУчетаБУСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаПартии КАК ПереоценкаПартииСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаБУ КАК ПереоценкаБУСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьКупонаВВалютеУчетаПартии КАК СтоимостьКупонаВВалютеУчетаПартииСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьКупонаВВалютеУчетаБУ КАК СтоимостьКупонаВВалютеУчетаБУСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьКупонаПартии КАК СтоимостьКупонаПартииСверкаРСБУ,
			|	ОстаткиВсе.СтоимостьКупонаБУ КАК СтоимостьКупонаБУСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаКупонаВВалютеУчетаПартии КАК ПереоценкаКупонаВВалютеУчетаПартииСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаКупонаВВалютеУчетаБУ КАК ПереоценкаКупонаВВалютеУчетаБУСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаКупонаПартии КАК ПереоценкаКупонаПартииСверкаРСБУ,
			|	ОстаткиВсе.ПереоценкаКупонаБУ КАК ПереоценкаКупонаБУСверкаРСБУ,
			|	ОстаткиВсе.Местонахождение КАК Местонахождение,
			|	ОстаткиВсе.ИндексацияНоминалаПартии КАК ИндексацияНоминалаПартииСверкаРСБУ,
			|	ОстаткиВсе.ИндексацияНоминалаЗаВремяВладенияПартии КАК ИндексацияНоминалаЗаВремяВладенияПартииСверкаРСБУ,
			|	ОстаткиВсе.ИндексацияНоминалаБУ КАК ИндексацияНоминалаБУСверкаРСБУ,
			|	ОстаткиВсе.ИндексацияНоминалаЗаВремяВладенияБУ КАК ИндексацияНоминалаЗаВремяВладенияБУСверкаРСБУ
			|ИЗ
			|	ОстаткиВсе КАК ОстаткиВсе
			|ГДЕ
			|	ОстаткиВсе.ЦеннаяБумага <> 0";
		
		Если ЭтотОбъект.ВидУчета <> Перечисления.ВидыУчета.БухгалтерскийУчет Тогда
			Запрос.Текст = СтрЗаменить(
				Запрос.Текст,
				"РегистрБухгалтерии.БухгалтерскийУчет",
				"РегистрБухгалтерии." + РаботаСМетаданнымиПовтИсп.ПолучитьИдентификаторПеречисления(ЭтотОбъект.ВидУчета)
			);
		КонецЕсли;
		
		УчетныеАктивыБумаги = ПолучитьУчетныеАктивы(Ложь);
		УчетныеАктивыКупоны = ПолучитьУчетныеАктивы(Истина);
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
		Запрос.УстановитьПараметр("ВидУчета", ЭтотОбъект.ВидУчета);
		Запрос.УстановитьПараметр("ОкончаниеПериодаКонецДня", Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
		Запрос.УстановитьПараметр("ОстаткиПартий", ОстаткиПартий);
		Запрос.УстановитьПараметр("УчетныеАктивыБумаги", УчетныеАктивыБумаги);
		Запрос.УстановитьПараметр("УчетныеАктивыКупоны", УчетныеАктивыКупоны);
			
		ОстаткиПартийСверка = Запрос.Выполнить().Выгрузить();
		
		СтрокиБезУчетногоАктива = ОстаткиПартийСверка.НайтиСтроки(новый Структура("УчетныйАктивСверкаРСБУ", Справочники.УчетныеАктивы.ПустаяСсылка()));
		
		Для Каждого СтрокаБезУчетногоАктива из СтрокиБезУчетногоАктива Цикл
			
			ТипЦБ = ТипЗнч(СтрокаБезУчетногоАктива.ЦеннаяБумагаСверкаРСБУ);
			Если ТипЦБ = Тип("СправочникСсылка.Облигации") Тогда
				СтрокаБезУчетногоАктива.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;
			ИначеЕсли ТипЦБ = Тип("СправочникСсылка.Акции") Тогда
				СтрокаБезУчетногоАктива.Рынок = Перечисления.РынкиЦенныхБумаг.Акции;
			ИначеЕсли ТипЦБ = Тип("СправочникСсылка.Паи") Тогда
				СтрокаБезУчетногоАктива.Рынок = Перечисления.РынкиЦенныхБумаг.Паи;
			КонецЕсли;
			СтрокаБезУчетногоАктива.УчетныйАктивСверкаРСБУ = БухгалтерскийУчет.ОпределитьУчетныйАктив(ЭтотОбъект.Период, СтрокаБезУчетногоАктива.Рынок, СтрокаБезУчетногоАктива.ЦеннаяБумагаСверкаРСБУ, ЛОЖЬ);
			
		КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиПартииСверкаСПереоценкой(Настройки, СтрокиПереоценкиСверка)
	
	СтрокиПереоценкиСверка = новый ТаблицаЗначений;
	СтрокиПереоценкиСверка.Колонки.Добавить("СчетДоверительногоУправленияСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ЦеннаяБумагаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("МестонахождениеСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("БалансоваяСуммаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("БалансоваяСуммаВВалютеУчетаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("БалансоваяСуммаКупонаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("БалансоваяСуммаКупонаВВалютеУчетаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ОценочнаяСуммаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ОценочнаяСуммаВВалютеУчетаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ОценочнаяСуммаКупонаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ОценочнаяСуммаКупонаВВалютеУчетаСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ПолеЦеныСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ИсточникЦеныСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ДатаКотировкиСверкаСПереоценкой");
	СтрокиПереоценкиСверка.Колонки.Добавить("ДатаКотировкиКупонаСверкаСПереоценкой");
	
	ЦельРасчета = БухгалтерскийУчет.ОпределитьЦельРасчетаПоВидуУчета(ЭтотОбъект.ВидУчета);
	
	ДокументПереоценка = Новый Структура;
	ДокументПереоценка.Вставить("Дата", КонецДня(ЭтотОбъект.Период));
	ДокументПереоценка.Вставить("Организация", ЭтотОбъект.Организация);
	ДокументПереоценка.Вставить("ВидУчета", ЭтотОбъект.ВидУчета);
	ДокументПереоценка.Вставить("ПереоцениватьНаОснованииНастроекУчета", Истина);
	ДокументПереоценка.Вставить("ЦенныеБумаги", Новый ТаблицаЗначений);
	ДокументПереоценка.Вставить("ЦельРасчета", ЦельРасчета);
	ДокументПереоценка.Вставить("РассчитыватьПроцентныеПоказатели", Ложь);
	
	СписокСчетовДУ = Новый Массив;
	Если ЗначениеЗаполнено(ЭтотОбъект.СчетДоверительногоУправления) Тогда
		СписокСчетовДУ.Добавить(ЭтотОбъект.СчетДоверительногоУправления);
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
		|ГДЕ
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет";
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("Период", ЭтотОбъект.Период);
		Если ЭтотОбъект.ВидУчета = Перечисления.ВидыУчета.НалоговыйУчет Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "БухгалтерскийУчет", "НалоговыйУчет");
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СписокСчетовДУ.Добавить(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ТекущийСчетДоверительногоУправления из СписокСчетовДУ Цикл
		
		НастройкиЦелиРасчета = БухгалтерскийУчет.ОпределитьНастройкиЦелиРасчета(ЭтотОбъект.Период, ЭтотОбъект.Организация, ТекущийСчетДоверительногоУправления, ЦельРасчета);
		
		Если НЕ ЗначениеЗаполнено(НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументПереоценка.Вставить("СчетДоверительногоУправления", ТекущийСчетДоверительногоУправления);
		ДокументПереоценка.Вставить("ВариантРасчетаОценочнойСтоимости", НастройкиЦелиРасчета.ВариантРасчетаОценочнойСтоимости);
		
		//РаботаСПереоценкой.ПолучитьЦенныеБумаги(ЭтотОбъект, МенеджерВТ, "ТаблицаПартийЦБ", ПараметрыПолученияПартий.УчестьПартииКПолучению, ПараметрыПолученияПартий.УчестьБумагиТПлюс, ПараметрыПолученияПартий.УчестьБумагиПоРЕПО, , , РасшифровкаРасчета);
		//
		//Запрос = Новый Запрос;
		//Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
		//Запрос.Текст = 
		//	"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//	|	ТаблицаПартийЦБ.Рынок КАК Рынок,
		//	|	ТаблицаПартийЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
		//	|	СУММА(ТаблицаПартийЦБ.Количество) КАК Количество
		//	|ИЗ
		//	|	ТаблицаПартийЦБ КАК ТаблицаПартийЦБ
		//	|
		//	|СГРУППИРОВАТЬ ПО
		//	|	ТаблицаПартийЦБ.Рынок,
		//	|	ТаблицаПартийЦБ.ЦеннаяБумага";
		//
		//ТаблицаЦБ = Запрос.Выполнить().Выгрузить();
		
		Отказ = Ложь;
		
		РаботаСПереоценкой.ПолучитьТабличнуюЧастьПереоценки(ДокументПереоценка, Неопределено, Отказ);
		
		ЦенныеБумагиПереоценки = ДокументПереоценка.ЦенныеБумаги;
		Если ЦенныеБумагиПереоценки.Колонки.Количество() <> 0 Тогда
			
			//округлим "4 знака"
			Если НастройкиЦелиРасчета.ТочностьЦеныОценки > 2 ИЛИ НастройкиЦелиРасчета.ТочностьЦеныКупона > 2 Тогда
				Для каждого СтрокаПереоценки из ЦенныеБумагиПереоценки Цикл
					СтрокаПереоценки.ОценочнаяСумма = Окр(СтрокаПереоценки.ОценочнаяСумма, 2);
					СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = Окр(СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета, 2);
					СтрокаПереоценки.ОценочнаяСуммаКупона = Окр(СтрокаПереоценки.ОценочнаяСуммаКупона, 2);
					СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета = Окр(СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета, 2);
				КонецЦикла;
			КонецЕсли;
			
			ЦенныеБумагиПереоценки.Свернуть("ЦеннаяБумага,ПолеЦены,ИсточникЦены,ДатаКотировки,ДатаКотировкиКупона", "БалансоваяСумма,БалансоваяСуммаВВалютеУчета,БалансоваяСуммаКупона,БалансоваяСуммаКупонаВВалютеУчета,ОценочнаяСумма,ОценочнаяСуммаВВалютеУчета,ОценочнаяСуммаКупона,ОценочнаяСуммаКупонаВВалютеУчета");
			Для каждого СтрокаПереоценки из ЦенныеБумагиПереоценки Цикл
				СтрокаОтчета = СтрокиПереоценкиСверка.Добавить();
				СтрокаОтчета.СчетДоверительногоУправленияСверкаСПереоценкой = ДокументПереоценка.СчетДоверительногоУправления;
				СтрокаОтчета.ЦеннаяБумагаСверкаСПереоценкой = СтрокаПереоценки.ЦеннаяБумага;
				СтрокаОтчета.МестонахождениеСверкаСПереоценкой = "Собственные";
				СтрокаОтчета.БалансоваяСуммаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСумма;
				СтрокаОтчета.БалансоваяСуммаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСуммаВВалютеУчета;
				СтрокаОтчета.БалансоваяСуммаКупонаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСуммаКупона;
				СтрокаОтчета.БалансоваяСуммаКупонаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСуммаКупонаВВалютеУчета;
				СтрокаОтчета.ОценочнаяСуммаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСумма;
				СтрокаОтчета.ОценочнаяСуммаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета;
				СтрокаОтчета.ОценочнаяСуммаКупонаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСуммаКупона;
				СтрокаОтчета.ОценочнаяСуммаКупонаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета;
				Если СтрокаПереоценки.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена Тогда
					СтрокаОтчета.ПолеЦеныСверкаСПереоценкой = СтрокаПереоценки.ПолеЦены;
					СтрокаОтчета.ИсточникЦеныСверкаСПереоценкой = "";
					СтрокаОтчета.ДатаКотировкиСверкаСПереоценкой = "";
				Иначе
					СтрокаОтчета.ПолеЦеныСверкаСПереоценкой = СтрокаПереоценки.ПолеЦены;
					СтрокаОтчета.ИсточникЦеныСверкаСПереоценкой = СтрокаПереоценки.ИсточникЦены;
					СтрокаОтчета.ДатаКотировкиСверкаСПереоценкой = СтрокаПереоценки.ДатаКотировки;
				КонецЕсли;
				СтрокаОтчета.ДатаКотировкиКупонаСверкаСПереоценкой = СтрокаПереоценки.ДатаКотировкиКупона;
			КонецЦикла;
			
		КонецЕсли;
		
		ДокументПереоценка.ЦенныеБумаги.Колонки.Очистить(); 
		
		МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
		Документы.ПереоценкаЦенныхБумаг.ЗаполнитьЦенныеБумагиПроданныеВРЕПО(ДокументПереоценка, МенеджерВременныхТаблиц, "ТаблицаПартийЦБ", Отказ);
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заполнить партии, проданные в РЕПО для " + ДокументПереоценка.СчетДоверительногоУправления);
			Продолжить;
		КонецЕсли; 
		СообщенияОбОценочнойСтоимости = Неопределено;
		РаботаСПереоценкой.ЗаполнитьКотировки(ДокументПереоценка, МенеджерВременныхТаблиц, СообщенияОбОценочнойСтоимости, Отказ);
		
		Документы.ПереоценкаЦенныхБумаг.ПрименитьПолитикуУчетаПереоценкиПроданныеВРЕПО(ДокументПереоценка, Ложь, СообщенияОбОценочнойСтоимости, Организация.ВалютаУчета, Отказ);
		
		
		ЦенныеБумагиПереоценки = ДокументПереоценка.ЦенныеБумаги;
		Если ЦенныеБумагиПереоценки.Колонки.Количество() <> 0 Тогда
			
			//округлим "4 знака"
			Если НастройкиЦелиРасчета.ТочностьЦеныОценки > 2 ИЛИ НастройкиЦелиРасчета.ТочностьЦеныКупона > 2 Тогда
				Для каждого СтрокаПереоценки из ЦенныеБумагиПереоценки Цикл
					СтрокаПереоценки.ОценочнаяСумма = Окр(СтрокаПереоценки.ОценочнаяСумма, 2);
					СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета = Окр(СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета, 2);
					СтрокаПереоценки.ОценочнаяСуммаКупона = Окр(СтрокаПереоценки.ОценочнаяСуммаКупона, 2);
					СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета = Окр(СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета, 2);
				КонецЦикла;
			КонецЕсли;
			
			ЦенныеБумагиПереоценки.Свернуть("ЦеннаяБумага,ПолеЦены,ИсточникЦены,ДатаКотировки,ДатаКотировкиКупона", "БалансоваяСумма,БалансоваяСуммаВВалютеУчета,БалансоваяСуммаКупона,БалансоваяСуммаКупонаВВалютеУчета,ОценочнаяСумма,ОценочнаяСуммаВВалютеУчета,ОценочнаяСуммаКупона,ОценочнаяСуммаКупонаВВалютеУчета");
			Для каждого СтрокаПереоценки из ЦенныеБумагиПереоценки Цикл
				СтрокаОтчета = СтрокиПереоценкиСверка.Добавить();
				СтрокаОтчета.СчетДоверительногоУправленияСверкаСПереоценкой = ДокументПереоценка.СчетДоверительногоУправления;
				СтрокаОтчета.ЦеннаяБумагаСверкаСПереоценкой = СтрокаПереоценки.ЦеннаяБумага;
				СтрокаОтчета.МестонахождениеСверкаСПереоценкой = "Проданы в РЕПО";
				СтрокаОтчета.БалансоваяСуммаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСумма;
				СтрокаОтчета.БалансоваяСуммаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСуммаВВалютеУчета;
				СтрокаОтчета.БалансоваяСуммаКупонаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСуммаКупона;
				СтрокаОтчета.БалансоваяСуммаКупонаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.БалансоваяСуммаКупонаВВалютеУчета;
				СтрокаОтчета.ОценочнаяСуммаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСумма;
				СтрокаОтчета.ОценочнаяСуммаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСуммаВВалютеУчета;
				СтрокаОтчета.ОценочнаяСуммаКупонаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСуммаКупона;
				СтрокаОтчета.ОценочнаяСуммаКупонаВВалютеУчетаСверкаСПереоценкой = СтрокаПереоценки.ОценочнаяСуммаКупонаВВалютеУчета;
				Если СтрокаПереоценки.ПолеЦены = Перечисления.ИсточникиЦеныДляПереоценки.БалансоваяЦена Тогда
					СтрокаОтчета.ПолеЦеныСверкаСПереоценкой = СтрокаПереоценки.ПолеЦены;
					СтрокаОтчета.ИсточникЦеныСверкаСПереоценкой = 0;
					СтрокаОтчета.ДатаКотировкиСверкаСПереоценкой = 0;
				Иначе
					СтрокаОтчета.ПолеЦеныСверкаСПереоценкой = СтрокаПереоценки.ПолеЦены;
					СтрокаОтчета.ИсточникЦеныСверкаСПереоценкой = СтрокаПереоценки.ИсточникЦены;
					СтрокаОтчета.ДатаКотировкиСверкаСПереоценкой = СтрокаПереоценки.ДатаКотировки;
				КонецЕсли;
				СтрокаОтчета.ДатаКотировкиКупонаСверкаСПереоценкой = СтрокаПереоценки.ДатаКотировкиКупона;
			КонецЦикла;
			
		КонецЕсли;		
	КонецЦикла;
	//СтрокиПереоценкиСверка = ДокументПереоценка.ЦенныеБумаги.Скопировать(,"ЦеннаяБумага,БалансоваяСумма,БалансоваяСуммаВВалютеУчета,БалансоваяСуммаКупона,БалансоваяСуммаКупонаВВалютеУчета,ОценочнаяСумма,ОценочнаяСуммаВВалютеУчета,ОценочнаяСуммаКупона,ОценочнаяСуммаКупонаВВалютеУчета");		
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиПартииСверкаРЕПО(Настройки, ДанныеСверкиПоРЕПО)
	
	Отказ = Ложь;
		
		СуммыЗаймовПоПериодам = Документы.ПереоценкаЗадолженностиПоДенежнымСредствам.РассчитатьПроцентыПоРЕПО(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, КонецДня(ЭтотОбъект.Период), ЭтотОбъект.ВидУчета,, Отказ);
		
		Если Отказ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось рассчитать проценты по сделкам РЕПО");
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СуммыЗаймовПоПериодам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СуммыЗаймовПоПериодам.Основание КАК СделкаРЕПО,
			|	СуммыЗаймовПоПериодам.ВидСделки КАК ВидСделкиРЕПО,
			|	СуммыЗаймовПоПериодам.Контрагент КАК Контрагент,
			|	СуммыЗаймовПоПериодам.ВалютаСделки КАК ВалютаСделки,
			|	СуммыЗаймовПоПериодам.ДатаРЕПО КАК ДатаРЕПО,
			|	СуммыЗаймовПоПериодам.ДатаЗакрытияРЕПО КАК ДатаЗакрытияРЕПО,
			|	СуммыЗаймовПоПериодам.СуммаРЕПО КАК СуммаРЕПО,
			|	СуммыЗаймовПоПериодам.СуммаЗакрытияРЕПО КАК СуммаЗакрытияРЕПО,
			|	СуммыЗаймовПоПериодам.ПериодС КАК ПериодС,
			|	СуммыЗаймовПоПериодам.ПериодПо КАК ПериодПо,
			|	СуммыЗаймовПоПериодам.СуммаПериода КАК СуммаПериода,
			|	СуммыЗаймовПоПериодам.СуммаВЗалоге КАК СуммаВЗалоге,
			|	СуммыЗаймовПоПериодам.СуммаПроцентов КАК СуммаПроцентов
			|ПОМЕСТИТЬ _СуммыЗаймовПоПериодамИзПереоценки
			|ИЗ
			|	&СуммыЗаймовПоПериодам КАК СуммыЗаймовПоПериодам
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СуммыЗаймовПоПериодамИзПереоценки.СделкаРЕПО КАК СделкаРЕПО,
			|	МАКСИМУМ(_СуммыЗаймовПоПериодамИзПереоценки.ДатаЗакрытияРЕПО) КАК ДатаЗакрытияРЕПО,
			|	СУММА(_СуммыЗаймовПоПериодамИзПереоценки.СуммаПроцентов) КАК СуммаПроцентов
			|ПОМЕСТИТЬ _СделкиРЕПО
			|ИЗ
			|	_СуммыЗаймовПоПериодамИзПереоценки КАК _СуммыЗаймовПоПериодамИзПереоценки
			|
			|СГРУППИРОВАТЬ ПО
			|	_СуммыЗаймовПоПериодамИзПереоценки.СделкаРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_СуммыЗаймовПоПериодамИзПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_СделкиРЕПО.СделкаРЕПО КАК СделкаРЕПО,
			|	_СуммыЗаймовПоПериодамИзПереоценки.ВидСделкиРЕПО КАК ВидСделкиРЕПО,
			|	_СуммыЗаймовПоПериодамИзПереоценки.Контрагент КАК Контрагент,
			|	_СуммыЗаймовПоПериодамИзПереоценки.ВалютаСделки КАК ВалютаСделки,
			|	_СуммыЗаймовПоПериодамИзПереоценки.ДатаРЕПО КАК ДатаРЕПО,
			|	_СделкиРЕПО.ДатаЗакрытияРЕПО КАК ДатаЗакрытияРЕПО,
			|	_СуммыЗаймовПоПериодамИзПереоценки.СуммаРЕПО КАК СуммаРЕПО,
			|	_СуммыЗаймовПоПериодамИзПереоценки.СуммаЗакрытияРЕПО КАК СуммаЗакрытияРЕПО,
			|	_СуммыЗаймовПоПериодамИзПереоценки.ПериодС КАК ПериодС,
			|	_СуммыЗаймовПоПериодамИзПереоценки.ПериодПо КАК ПериодПо,
			|	_СуммыЗаймовПоПериодамИзПереоценки.СуммаПериода КАК СуммаПериода,
			|	_СуммыЗаймовПоПериодамИзПереоценки.СуммаВЗалоге КАК СуммаВЗалоге,
			|	_СделкиРЕПО.СуммаПроцентов КАК СуммаПроцентов
			|ПОМЕСТИТЬ _СуммыЗаймовПоПериодам
			|ИЗ
			|	_СделкиРЕПО КАК _СделкиРЕПО
			|		ЛЕВОЕ СОЕДИНЕНИЕ _СуммыЗаймовПоПериодамИзПереоценки КАК _СуммыЗаймовПоПериодамИзПереоценки
			|		ПО _СделкиРЕПО.СделкаРЕПО = _СуммыЗаймовПоПериодамИзПереоценки.СделкаРЕПО
			|			И _СделкиРЕПО.ДатаЗакрытияРЕПО = _СуммыЗаймовПоПериодамИзПереоценки.ДатаЗакрытияРЕПО
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(НалоговыйУчетОстатки.СуммаОстаток, 0) КАК НачисленныеПроцентыПоРЕПОВВалютеУчета,
			|	ЕСТЬNULL(НалоговыйУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК НачисленныеПроцентыПоРЕПО,
			|	НалоговыйУчетОстатки.Субконто1 КАК СделкаРЕПО,
			|	НалоговыйУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫРАЗИТЬ(НалоговыйУчетОстатки.Субконто1 КАК Документ.СделкаРЕПО).ВидСделки КАК ВидСделкиРЕПО,
			|	ВЫРАЗИТЬ(НалоговыйУчетОстатки.Субконто1 КАК Документ.СделкаРЕПО).ВалютаСделки КАК ВалютаСделки,
			|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(НалоговыйУчетОстатки.Субконто1 КАК Документ.СделкаРЕПО).Дата, ДЕНЬ) КАК ДатаРЕПО
			|ПОМЕСТИТЬ _ПроцентыПоРЕПО
			|ИЗ
			|	РегистрБухгалтерии.НалоговыйУчет.Остатки(
			|			&Период,
			|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПроцентыПоКраткосрочнымКредитам)
			|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.НалоговыеНачисленияПоРЕПО),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
			|			Организация = &Организация
			|				И (СчетДоверительногоУправления В (&СписокСтратегий)
			|					ИЛИ &ПоВсемСчетамДУ)) КАК НалоговыйУчетОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(НалоговыйУчетОстатки.СуммаОстаток, 0) КАК СуммаЗаймаВВалютеУчета,
			|	ЕСТЬNULL(НалоговыйУчетОстатки.ВалютнаяСуммаОстаток, 0) КАК СуммаЗайма,
			|	НалоговыйУчетОстатки.Субконто1 КАК СделкаРЕПО,
			|	НалоговыйУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВЫРАЗИТЬ(НалоговыйУчетОстатки.Субконто1 КАК Документ.СделкаРЕПО).ВидСделки КАК ВидСделкиРЕПО,
			|	ВЫРАЗИТЬ(НалоговыйУчетОстатки.Субконто1 КАК Документ.СделкаРЕПО).ВалютаСделки КАК ВалютаСделки,
			|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(НалоговыйУчетОстатки.Субконто1 КАК Документ.СделкаРЕПО).Дата, ДЕНЬ) КАК ДатаРЕПО
			|ПОМЕСТИТЬ _СуммыЗаймов
			|ИЗ
			|	РегистрБухгалтерии.НалоговыйУчет.Остатки(
			|			&Период,
			|			Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПредоставленныеЗаймы)
			|				ИЛИ Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.КраткосрочныеКредиты),
			|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.СделкаРЕПО),
			|			Организация = &Организация
			|				И (СчетДоверительногоУправления В (&СписокСтратегий)
			|					ИЛИ &ПоВсемСчетамДУ)) КАК НалоговыйУчетОстатки
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МАКСИМУМ(_СуммыЗаймовПоПериодам.ПериодС) КАК ПериодС,
			|	_СуммыЗаймовПоПериодам.СделкаРЕПО КАК СделкаРЕПО,
			|	_СуммыЗаймовПоПериодам.СчетДоверительногоУправления КАК СчетДоверительногоУправления
