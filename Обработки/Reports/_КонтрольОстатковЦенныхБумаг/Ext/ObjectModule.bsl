Функция Проверка(ПараметрыПроверки) Экспорт
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ВнешнийНаборДанных = Неопределено;	
	
	ЭтотОбъект.Организация = ПараметрыПроверки.Организация;      
	ЭтотОбъект.Период = ПараметрыПроверки.Период; 
	ЭтотОбъект.СчетДоверительногоУправления = ПараметрыПроверки.Счет;
	ЭтотОбъект.ВидУчета = ПараметрыПроверки.ВидУчета;
		
	ЭтотОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(ПараметрыПроверки.Настройка);
		
	Настройки = КомпоновщикНастроек.Настройки;
	
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", ЭтотОбъект.Период);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ОкончаниеПериодаГраницаДня",	новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ЭтотОбъект.Организация);
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Настройки.ПараметрыДанных.Элементы.Найти("ПериодИнтервал").Использование	= Ложь;
	Настройки.ПараметрыДанных.Элементы.Найти("Календарь").Использование			= Ложь;
	Настройки.ПараметрыДанных.Элементы.Найти("ВидЛицензии").Использование		= Ложь;
	Настройки.ПараметрыДанных.Элементы.Найти("ВидДоговора").Использование		= Ложь;
			
	Вариант = ПараметрыПроверки.Вариант;
	
	СхемаКомпоновкиДанных = ЭтотОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Если Вариант = "СверкаПоДС" Тогда
		
		ЗаполнитьНастройкиСверкаПоДС(Настройки, СхемаКомпоновкиДанных);
		
	ИначеЕсли Вариант = "ПартииРСБУ_НУ" ИЛИ Вариант = "ПоКоличествуИВидуУчета" Тогда
				
		ЗаполнитьНастройкиПартииРСБУ_НУ(Настройки);
		
	КонецЕсли;
	
	Если Вариант = "СверкаСуммБУ_НУ" Тогда
					
		ОстаткиПартийСверка = Неопределено;	
		ЗаполнитьНастройкиПартииСверкаСуммБУ_НУ(Настройки, ОстаткиПартийСверка);
		ВнешнийНаборДанных = Новый Структура("ДанныеСверкиРСБУ", ОстаткиПартийСверка);		

	ИначеЕсли Вариант = "СверкаСПереоценкой" Тогда	
			
		СтрокиПереоценкиСверка = Неопределено;
		ЗаполнитьНастройкиПартииСверкаСПереоценкой(Настройки, СтрокиПереоценкиСверка);				
		ВнешнийНаборДанных = Новый Структура("ДанныеСверкиСПереоценкой", СтрокиПереоценкиСверка);		
		
	ИначеЕсли Вариант = "СверкаРЕПО" Тогда
		
		ДанныеСверкиПоРЕПО = Неопределено;
		ЗаполнитьНастройкиПартииСверкаРЕПО(Настройки, ДанныеСверкиПоРЕПО);				
		ВнешнийНаборДанных = Новый Структура("ДанныеСверкиПоРЕПО", ДанныеСверкиПоРЕПО);		

	КонецЕсли;
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешнийНаборДанных);	
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ОстатокБэкОфис", Новый ОписаниеТипов("Число"));
	
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
			
	ИмяКолонкиСчетДУ = ИмяКолонкиСчетДоверительногоУправления(ТЗ);
						
	Если ТЗ.Количество() = 0 ИЛИ
		
		//ИТОГО
		(ТЗ.Количество() = 1 И (НЕ ЗначениеЗаполнено(ТЗ[0][ИмяКолонкиСчетДУ]))) Тогда
		       		
		//Группировка по счету
		
		Возврат Истина;
	Иначе
		Возврат Ложь;							
	КонецЕсли;
	
КонецФункции

Функция ИмяКолонкиСчетДоверительногоУправления(ТЗ)
	
	Для Каждого Колонка ИЗ ТЗ.Колонки Цикл
		Если СтрНайти(Колонка.Имя, "СчетДоверительногоУправления") > 0 Тогда
			Возврат Колонка.Имя;
		КонецЕсли;					
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗаписатьРезультатВФайлы(СКД = Неопределено, Настройки = Неопределено, МакетКомпоновки = Неопределено, Постфикс = "", СохранятьРезультатВФайлы = Ложь) Экспорт

	Файл = Новый Файл("\\ap69\Developers\Виктор\КИД\");
	Если Не СохранятьРезультатВФайлы Или Файл.Существует() Тогда
		
		СтруктураХМЛ = Новый Структура;
		
		Если Не СКД = Неопределено Тогда
		
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, СКД, "DataCompositionSchema", "http://v8.1c.ru/8.1/data-composition-system/schema");
			СтруктураХМЛ.Вставить("Схема", ЗаписьXML.Закрыть());
		
		КонецЕсли; 
		
		Если Не Настройки = Неопределено Тогда
		
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Настройки, "Settings", "http://v8.1c.ru/8.1/data-composition-system/settings");
			СтруктураХМЛ.Вставить("Настройки", ЗаписьXML.Закрыть());
			
		КонецЕсли;
		
		Если Не МакетКомпоновки = Неопределено Тогда
			
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			СериализаторXDTO.ЗаписатьXML(ЗаписьXML, МакетКомпоновки, "DataCompositionTemplate", "http://v8.1c.ru/8.1/data-composition-system/composition-template");
			СтруктураХМЛ.Вставить("Макет", ЗаписьXML.Закрыть());
					
		КонецЕсли; 
		
		Если СохранятьРезультатВФайлы Тогда
			
			Для каждого Элемент Из СтруктураХМЛ Цикл
				
				ИмяФайла = Файл.ПолноеИмя + "\" + Элемент.Ключ + ?(Постфикс = "", "", "-" + Постфикс) + ".xml";
				ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла);
				ЗаписьТекста.Записать(Элемент.Значение);
				ЗаписьТекста.Закрыть();
			
			КонецЦикла; 
		
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат СтруктураХМЛ;

КонецФункции

#КонецОбласти
