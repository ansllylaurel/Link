// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт	
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о деятельности по управлению ценными бумагами",
		"0.10",
		"",
		Истина
	);
		
	// команды отсутствуют - только интерактивный запуск
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьПроверкуНаНаличиеУКлиентНедопустимыхСделок()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Клиент",			Клиент);
	Запрос.УстановитьПараметр("НачалоПериода",	Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",	Период.ДатаОкончания);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СделкаРЕПО.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СделкиРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.СчетДоверительногоУправления = &Клиент
		|	И СделкаРЕПО.Проведен
		|	И СделкаРЕПО.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Сделка.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _СделкиПоНеподдерживаемымРынкам
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И Сделка.СчетДоверительногоУправления = &Клиент
		|	И Сделка.Проведен
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ Сделка.Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Клиент,
		|	НЕ _СделкиПоНеподдерживаемымРынкам.Ссылка ЕСТЬ NULL КАК НеподдерживаемыеРынки,
		|	НЕ _СделкиРЕПО.Ссылка ЕСТЬ NULL КАК СделкиРЕПО
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиРЕПО КАК _СделкиРЕПО
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СделкиПоНеподдерживаемымРынкам КАК _СделкиПоНеподдерживаемымРынкам
		|		ПО (ИСТИНА)
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &Клиент";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.НеподдерживаемыеРынки Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента " + Выборка.Клиент + " в отчетном периоде обнаружено наличие сделок по рынкам ценных бумаг, отличных от Акций и Облигаций. Данный отчет не поддерживает сделки по таким рынкам.");
		КонецЕсли;
		
		Если Выборка.СделкиРЕПО Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У клиента " + Выборка.Клиент + " обнаружено наличие сделок РЕПО в отчетном периоде. Данный отчет не поддерживает этот вид сделок");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВариантыДДСДляОтбораДоходов()
	
	ВариантыДДС = Новый Массив;
	
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоВозвратуКупонногоДохода);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоДепозитномуВкладуПроценты);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовИпотечныеСертификатыУчастия);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоНачислениюРаспределяемойПрибылиООО);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоПогашениюКупона);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона);
	ВариантыДДС.Добавить(Справочники.ВидыЗадолженности.РасчетыСПайщикамиПоВыплатеДоходаПоИнвестиционнымПаям);
	
	Возврат ВариантыДДС;
	
КонецФункции

Процедура СформироватьОтчет() Экспорт
	
	// Фиксируем старт операции
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Период,Организация,Клиент");	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьОтчет()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	// Проверка и формирование		
	ВыполнитьПроверкуНаНаличиеУКлиентНедопустимыхСделок();
	
	Результат.Очистить();
	
	Макет = ПолучитьМакет("Макет");
	
	Шапка									= Макет.ПолучитьОбласть("Шапка");
	СтрокаОперацииСДС						= Макет.ПолучитьОбласть("СтрокаОперацииСДС");
	ЗаголовокДвивидены						= Макет.ПолучитьОбласть("ЗаголовокДвивидены");
	СтрокаДивиденды							= Макет.ПолучитьОбласть("СтрокаДивиденды");
	ЗаголовокСделки							= Макет.ПолучитьОбласть("ЗаголовокСделки");
	ЗаголовокЭмитент						= Макет.ПолучитьОбласть("ЗаголовокЭмитент");
	ЗаголовокТипАктива						= Макет.ПолучитьОбласть("ЗаголовокТипАктива");
	СтрокаСделки							= Макет.ПолучитьОбласть("СтрокаСделки");
	ЗаголовокОперацииСовершенныеРанее		= Макет.ПолучитьОбласть("ЗаголовокОперацииСовершенныеРанее");
	СтрокаОперацииСовершенныеРанее			= Макет.ПолучитьОбласть("СтрокаОперацииСовершенныеРанее");
	ЗаголовокСведенияОКредитныхОрганизациях	= Макет.ПолучитьОбласть("ЗаголовокСведенияОКредитныхОрганизациях");
	СтрокаСведенияОКредитныхОрганизациях	= Макет.ПолучитьОбласть("СтрокаСведенияОКредитныхОрганизациях");
	ЗаголовокСведенияОБрокере				= Макет.ПолучитьОбласть("ЗаголовокСведенияОБрокере");
	СтрокаСведенияОБрокере					= Макет.ПолучитьОбласть("СтрокаСведенияОБрокере");
	ЗаголовокСведенияОДепозитариях			= Макет.ПолучитьОбласть("ЗаголовокСведенияОДепозитариях");
	СтрокаСведенияОДепозитариях				= Макет.ПолучитьОбласть("СтрокаСведенияОДепозитариях");
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ГраницаНачалоПериода",					Новый Граница(Период.ДатаНачала, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ГраницаКонецПериода",					Новый Граница(Период.ДатаОкончания, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоПериода",							Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",							Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Клиент",									Клиент);
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("ОперацииДДС",							ПолучитьОперацииДДС());
	Запрос.УстановитьПараметр("Рубль",									Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("ВидыЗадолженностиДляТаблицыДивидендов",	ПолучитьВариантыДДСДляОтбораДоходов());
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ОперацииДДС.Вид КАК Перечисление.ВидыДвиженийДенежныхСредств) КАК Вид,
		|	ОперацииДДС.Вариант КАК Вариант,
		|	ВЫРАЗИТЬ(ОперацииДДС.Операция КАК СТРОКА) КАК Операция
		|ПОМЕСТИТЬ _ОперацииДДС
		|ИЗ
		|	&ОперацииДДС КАК ОперацииДДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _ДанныеДоговора
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, СчетДоверительногоУправления = &Клиент) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Сделка.Ссылка КАК Сделка
		|ПОМЕСТИТЬ _СписокСделок
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И Сделка.СчетДоверительногоУправления = &Клиент
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Сделка.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаЦенныеБумаги.Ссылка КАК Сделка,
		|	СделкаЦенныеБумаги.Ссылка.Дата КАК ДатаСделки,
		|	СделкаЦенныеБумаги.Ссылка.ВидСделки КАК ВидСделки,
		|	СделкаЦенныеБумаги.Ссылка.Рынок КАК Рынок,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|			ТОГДА ВЫРАЗИТЬ(СделкаЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА ВЫБОР
		|					КОГДА СделкаЦенныеБумаги.ЦеннаяБумага.Подкатегория <> ЗНАЧЕНИЕ(Перечисление.ВидыГосударственныхОблигаций.ПустаяСсылка)
		|						ТОГДА СделкаЦенныеБумаги.ЦеннаяБумага.Подкатегория
		|					ИНАЧЕ ""Облигация""
		|				КОНЕЦ
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|			ТОГДА ""Акция""
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи)
		|			ТОГДА ""Пай""
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ДепозитарныеРасписки)
		|			ТОГДА ""Депозитарная расписка""
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия)
		|			ТОГДА ""Ипотечный сертификат участия""
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Векселя)
		|			ТОГДА ""Вексель""
		|	КОНЕЦ КАК ТипЦБ,
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.Ссылка.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|			ТОГДА СделкаЦенныеБумаги.ЦеннаяБумага.ГосударственныйРегистрационныйНомер
