		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.ЮрФизЛицо = КонтактнаяИнформацияСрезПоследних.Объект
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|	И ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &Клиент
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &НачалоПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо.Представление) КАК Наименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеПолное,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК Адрес,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания КАК ДоговорБрокерскогоОбслуживания
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &Клиент) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо = КонтактнаяИнформацияСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&КонецПериода, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация = &Организация
		|	И КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления = &Клиент
		|	И (ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &НачалоПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо.Представление) КАК Наименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК НаименованиеПолное,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН,
		|	КонтактнаяИнформацияСрезПоследних.Представление КАК Адрес
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮридическийАдрес)) КАК КонтактнаяИнформацияСрезПоследних
		|		ПО СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо = КонтактнаяИнформацияСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО СчетаДоверительногоУправления.СпециализированныйДепозитарий.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &Клиент
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	#КонецОбласти
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеШапки				= РезультатЗапроса[РезультатЗапроса.Количество()-8].Выбрать();
	ОперацииСДС				= РезультатЗапроса[РезультатЗапроса.Количество()-7].Выбрать();
	ДивидендыКупоны			= РезультатЗапроса[РезультатЗапроса.Количество()-6].Выбрать();
	СделкиЭмитент			= РезультатЗапроса[РезультатЗапроса.Количество()-5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ИсполненныеСделки		= РезультатЗапроса[РезультатЗапроса.Количество()-4].Выбрать();
	СведенияОБанках			= РезультатЗапроса[РезультатЗапроса.Количество()-3].Выбрать();
	СведенияОБрокерах		= РезультатЗапроса[РезультатЗапроса.Количество()-2].Выбрать();
	СведенияОДепозитариях	= РезультатЗапроса[РезультатЗапроса.Количество()-1].Выбрать();
	
	// Вывод шакпи.
	Если ДанныеШапки.Следующий() Тогда
		
		Шапка.Параметры.Заполнить(ДанныеШапки);
		
		Шапка.Параметры.ДатаДоговора	= Формат(ДанныеШапки.ДатаДоговора,	"ДФ='dd.MM.yyyy ''г.'''");
		
		Если Год(ДанныеШапки.НачалоПериода) = Год(ДанныеШапки.КонецПериода)
			И Месяц(ДанныеШапки.НачалоПериода) = Месяц(ДанныеШапки.КонецПериода)
			И НачалоМесяца(ДанныеШапки.НачалоПериода) = ДанныеШапки.НачалоПериода
			И КонецМесяца(ДанныеШапки.КонецПериода) = ДанныеШапки.КонецПериода Тогда
			Шапка.Параметры.ПредставлениеПериода = Формат(ДанныеШапки.НачалоПериода, "ДФ='MMMM гггг'")
		Иначе
			Шапка.Параметры.ПредставлениеПериода = Формат(ДанныеШапки.НачалоПериода, "ДФ=dd.MM.yyyy") + " - " + Формат(ДанныеШапки.КонецПериода, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат.Вывести(Шапка);
	
	// Операции с ДС.
	Пока ОперацииСДС.Следующий() Цикл
		СтрокаОперацииСДС.Параметры.Заполнить(ОперацииСДС);
		
		Результат.Вывести(СтрокаОперацииСДС);
	КонецЦикла;
	
	// Дивиденды, купоны, проценты.
	Результат.Вывести(ЗаголовокДвивидены);
	
	Пока ДивидендыКупоны.Следующий() Цикл
		СтрокаДивиденды.Параметры.Заполнить(ДивидендыКупоны);
		
		Результат.Вывести(СтрокаДивиденды);
	КонецЦикла;
	
	// Сделки.
	ВыведенЗаголовок = Ложь;
	
	Пока СделкиЭмитент.Следующий() Цикл
		
		Если НЕ ВыведенЗаголовок Тогда
			Результат.Вывести(ЗаголовокСделки);
			
			ВыведенЗаголовок = Истина;
		КонецЕсли;
		
		ЗаголовокЭмитент.Параметры.Заполнить(СделкиЭмитент);
		
		Результат.Вывести(ЗаголовокЭмитент);
		
		СделкиТипАктива = СделкиЭмитент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока СделкиТипАктива.Следующий() Цикл
			
			ЗаголовокТипАктива.Параметры.Заполнить(СделкиТипАктива);
			
			Результат.Вывести(ЗаголовокТипАктива);
			
			Сделки = СделкиТипАктива.Выбрать();
			
			Пока Сделки.Следующий() Цикл
				СтрокаСделки.Параметры.Заполнить(Сделки);
				
				СтрокаСделки.Параметры.Основание = "Отчет брокера от " + Формат(Сделки.Дата, "ДФ=dd.MM.yyyy");
				
				Результат.Вывести(СтрокаСделки);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Операции, расчитанные в период отчета.
	Результат.Вывести(ЗаголовокОперацииСовершенныеРанее);
	
	Пока ИсполненныеСделки.Следующий() Цикл
		СтрокаОперацииСовершенныеРанее.Параметры.Заполнить(ИсполненныеСделки);
		
		Результат.Вывести(СтрокаОперацииСовершенныеРанее);
	КонецЦикла;
	
	//Сведения о банках.
	Результат.Вывести(ЗаголовокСведенияОКредитныхОрганизациях);
	
	Пока СведенияОБанках.Следующий() Цикл
		СтрокаСведенияОКредитныхОрганизациях.Параметры.Заполнить(СведенияОБанках);
		
		Результат.Вывести(СтрокаСведенияОКредитныхОрганизациях);
	КонецЦикла;
	
	//Сведения о брокерах.
	Результат.Вывести(ЗаголовокСведенияОБрокере);
	
	Пока СведенияОБрокерах.Следующий() Цикл
		СтрокаСведенияОБрокере.Параметры.Заполнить(СведенияОБрокерах);
		
		Результат.Вывести(СтрокаСведенияОБрокере);
	КонецЦикла;
	
	//Сведения о депозитариях.
	Результат.Вывести(ЗаголовокСведенияОДепозитариях);
	
	Пока СведенияОДепозитариях.Следующий() Цикл
		СтрокаСведенияОДепозитариях.Параметры.Заполнить(СведенияОДепозитариях);
		
		Результат.Вывести(СтрокаСведенияОДепозитариях);
	КонецЦикла;
	
	// Заполняем настройки печати	
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Результат, ЭтотОбъект.Метаданные().ПолноеИмя(), Истина, ОриентацияСтраницы.Ландшафт);
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Функция ПолучитьОперацииДДС()
	
	ТипыВариантов = Новый Массив;
	
	ТипыВариантов.Добавить(Тип("СправочникСсылка.ВидыЗадолженности"));
	ТипыВариантов.Добавить(Тип("СправочникСсылка.ВидыОперацийПриВводеВыводеДенежныхСредств"));
	ТипыВариантов.Добавить(Тип("ПеречислениеСсылка.ВидыПереводовДенежныхСредств"));
	
	ОперацииДДС = Новый ТаблицаЗначений;
	
	ОперацииДДС.Колонки.Добавить("Вид",			Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДвиженийДенежныхСредств"));
	ОперацииДДС.Колонки.Добавить("Вариант",		Новый ОписаниеТипов(ТипыВариантов));
	ОперацииДДС.Колонки.Добавить("Операция",	Новый ОписаниеТипов("Строка"));
	
	Макет = ПолучитьМакет("ОперацииДДС");
	
	Индекс = 2;
	
	Пока Макет.Область(Индекс, 1).Текст <> "" Цикл
		
		НоваяСтрока = ОперацииДДС.Добавить();
		
		Попытка
			НоваяСтрока.Вид = Вычислить(Макет.Область(Индекс, 1).Текст);
		Исключение
			ОперацииДДС.Удалить(НоваяСтрока);
			Индекс = Индекс + 1;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить значение вида ДДС при сборке таблицы операций ДДС! Вычисляемое выражение '" + Макет.Область(Индекс, 1).Текст + "'.");
			Продолжить;
		КонецПопытки;
		
		Попытка
			НоваяСтрока.Вариант = Вычислить(Макет.Область(Индекс, 2).Текст);
		Исключение
			ОперацииДДС.Удалить(НоваяСтрока);
			Индекс = Индекс + 1;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось вычислить значение варианта ДДС при сборке таблицы операций ДДС! Вычисляемое выражение '" + Макет.Область(Индекс, 2).Текст + "'.");
			Продолжить;
		КонецПопытки;
		
		НоваяСтрока.Операция = Макет.Область(Индекс, 3).Текст;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Возврат ОперацииДДС;
	
КонецФункции

#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	// Заполняем настройки отчета	

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
	ЭтотОбъект.Клиент = НастройкиОтчета.СчетДоверительногоУправления; 
	
	// Формируем отчет	
	
	СформироватьОтчет();
	
	НастройкиОтчета.Вставить("Результат", ЭтотОбъект.Результат);
	
КонецПроцедуры

#КонецОбласти