	ВыборкаПереходнаМСФО9 = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПереходНаМСФО9").ПолучитьДанные().Выбрать();
	Пока ВыборкаПереходнаМСФО9.Следующий() Цикл 
	
	Если ВыборкаПереходнаМСФО9.СуммаПерехода <> 0 Тогда
		ОбластьОтчет.Параметры.ПереходНаМСФО9 = ", с учетом суммы разницы первого применения МСФО 9 в размере " +
			ВыборкаПереходнаМСФО9.СуммаПерехода + " (" +  
			СтрЗаменить(ЧислоПрописью(ВыборкаПереходнаМСФО9.СуммаПерехода, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2"), "-", "минус ") + ")."; 
