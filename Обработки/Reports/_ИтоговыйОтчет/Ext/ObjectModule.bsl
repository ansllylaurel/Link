	КомиссияБанка = 0;
	КомиссияПрочая = 0;
	 
	Пока ВыборкаКомиссии.Следующий() Цикл
		СуммаИные = СуммаИные + ВыборкаКомиссии.Сумма; 
		
		Если ВыборкаКомиссии.Наименование = "комиссия покупка" Тогда
			КомиссияПокупка = КомиссияПокупка + ВыборкаКомиссии.Сумма; 	
		ИначеЕсли ВыборкаКомиссии.Наименование = "комиссия продажа" Тогда
			КомиссияПродажа = КомиссияПродажа + ВыборкаКомиссии.Сумма; 	
		ИначеЕсли ВыборкаКомиссии.Наименование = "комиссия РЕПО" Тогда
			КомиссияРЕПО = КомиссияРЕПО + ВыборкаКомиссии.Сумма; 	
		ИначеЕсли ВыборкаКомиссии.Наименование = "комиссия банка" Тогда
			КомиссияБанка = КомиссияБанка + ВыборкаКомиссии.Сумма; 	
		ИначеЕсли ВыборкаКомиссии.Наименование = "прочие комиссии" Тогда
			КомиссияПрочая = КомиссияПрочая + ВыборкаКомиссии.Сумма; 				
		КонецЕсли;	
