		ДатаНачалаДоговора = СведенияОбОрганизации.ДатаДоговора;
	КонецЕсли;	
	
	Отчет = ПолучитьМакет("Отчет"); 
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда 
		ОбластьОтчет = Отчет.ПолучитьОбласть("ОтчетПН");		
	ИначеЕсли ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами Тогда 
		ОбластьОтчет = Отчет.ПолучитьОбласть("ОтчетПР");	
