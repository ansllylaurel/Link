	ОбластьОтчет.Параметры.СуммаВводы = СуммаВводы;
	ОбластьОтчет.Параметры.СуммаВводыПропись = ЧислоПрописью(СуммаВводы, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	ОбластьОтчет.Параметры.СуммаВыводы = СуммаВыводы;
	ОбластьОтчет.Параметры.СуммаВыводыПропись = ЧислоПрописью(СуммаВыводы, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	
	ОбластьРасшифровка.Параметры.СуммаВводы = СуммаВводы;				
	ОбластьРасшифровка.Параметры.СуммаВыводы = СуммаВыводы;				
	ОбластьРасшифровка.Параметры.СуммаВводыДС = СуммаВводыДС;				
	ОбластьРасшифровка.Параметры.СуммаВыводыДС = СуммаВыводыДС;				
	ОбластьРасшифровка.Параметры.Дебиторка = Дебиторка;				
	ОбластьРасшифровка.Параметры.Кредиторка = Кредиторка;				
	ОбластьРасшифровка.Параметры.СуммаВводыЦБ = СуммаВводыЦБ;				
	ОбластьРасшифровка.Параметры.СуммаВыводыЦБ = СуммаВыводыЦБ;				
	
	
	ВознаграждениеДепозитария = 0;
	ВознаграждениеУК = 0;
	РасходыДепозитария = 0;
	
	ВыборкаВознаграждения = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Вознаграждения").ПолучитьДанные().Выбрать();
	Пока ВыборкаВознаграждения.Следующий() Цикл
		Если ВыборкаВознаграждения.Наименование = "Вознаграждение депозитария" Тогда
			ВознаграждениеДепозитария = ВознаграждениеДепозитария + ВыборкаВознаграждения.Сумма;
		ИначеЕсли ВыборкаВознаграждения.Наименование = "Вознаграждение управляющей компании" Тогда
			ВознаграждениеУК = ВознаграждениеУК + ВыборкаВознаграждения.Сумма;
		ИначеЕсли ВыборкаВознаграждения.Наименование = "Расходы депозитария" Тогда	
			РасходыДепозитария = РасходыДепозитария + ВыборкаВознаграждения.Сумма;
