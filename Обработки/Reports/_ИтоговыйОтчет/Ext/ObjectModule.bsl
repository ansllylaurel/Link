		ОбластьОтчет.Параметры.КапиталКонецПропись = ЧислоПрописью(ВыборкаКапитал.КапиталКонец, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");		
		
		ОбластьРасшифровка.Параметры.КапиталНачало = ВыборкаКапитал.КапиталНачало;
		ОбластьРасшифровка.Параметры.КапиталКонец = ВыборкаКапитал.КапиталКонец;	
