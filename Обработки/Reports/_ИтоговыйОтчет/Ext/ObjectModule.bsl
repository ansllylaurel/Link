	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажи);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеЧерезПСД);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолговыеДляПродажиИДоПогашения);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеПоСправедливой);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.ДолевыеДляПродажи);
	СчетаЦБ.Добавить(ПланыСчетов.Единый.УчастиеВДочернихОбществахИПаевыхФондах);
