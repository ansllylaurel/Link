		|			) КАК ЕдиныйБухгалтерскийУчетОбороты";
	
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления); 

	Если Год(ЭтотОбъект.Период.ДатаНачала) = 2025 
		И НачалоГода(ЭтотОбъект.Период.ДатаНачала) = НачалоДня(ЭтотОбъект.Период.ДатаНачала) Тогда
		Запрос.УстановитьПараметр("ДатаНачальная", ЭтотОбъект.Период.ДатаНачала + 2); //Надо учеть смену учетной политики в 2025 г.
		Запрос.УстановитьПараметр("УчитыватьПереходНаМСФО9", 1); 
	Иначе
		Запрос.УстановитьПараметр("ДатаНачальная", ЭтотОбъект.Период.ДатаНачала);
		Запрос.УстановитьПараметр("УчитыватьПереходНаМСФО9", 0);  
