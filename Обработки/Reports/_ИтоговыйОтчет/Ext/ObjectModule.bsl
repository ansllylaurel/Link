	КонецЕсли;	
	
	// 
	ОбластьОтчет.Параметры.ДатаОтчета = Формат(ЭтотОбъект.Период.ДатаОкончания,"ДЛФ=DD");
	ОбластьОтчет.Параметры.НомерДоговора = СведенияОбОрганизации.НомерДоговора;
	ОбластьОтчет.Параметры.ДатаДоговора = СтрЗаменить(Формат(СведенияОбОрганизации.ДатаДоговора,"ДЛФ=DD"), "г.", "");
	//ОбластьОтчет.Параметры.Год = Формат(Год(ЭтотОбъект.Период.ДатаОкончания),"ЧГ=0"); 
	ОбластьОтчет.Параметры.ВГоду = ВГоду; 
	ОбластьОтчет.Параметры.ЗаГод = ЗаГод; 
	
