	СуммаИные = РасходыДепозитария;
	
	
	ВыборкаКомиссии = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Комиссии").ПолучитьДанные().Выбрать();
	КомиссияПокупка = 0;
	КомиссияПродажа = 0;
