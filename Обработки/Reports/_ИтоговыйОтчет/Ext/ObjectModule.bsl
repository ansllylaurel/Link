	Если ВыборкаФинрез.Следующий() Тогда 
		ОбластьОтчет.Параметры.ФинРез = ВыборкаФинрез.Сумма;
		ОбластьОтчет.Параметры.ФинРезПропись = ЧислоПрописью(МатематическиеФункции.МодульЧисла(ВыборкаФинрез.Сумма), "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");	
		ОбластьРасшифровка.Параметры.ФинРез = ВыборкаФинрез.Сумма;		
