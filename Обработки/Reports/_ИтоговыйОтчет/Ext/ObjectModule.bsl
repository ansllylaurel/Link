			ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний) Тогда
		ОбластьОтчет.Параметры.СуммаИные = СуммаИные;
		ОбластьОтчет.Параметры.СуммаИныеПропись = ЧислоПрописью(СуммаИные, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	КонецЕсли;	
	
	ОбластьРасшифровка.Параметры.СуммаИные = СуммаИные;				
	ОбластьРасшифровка.Параметры.КомиссияПокупка = КомиссияПокупка;				
	ОбластьРасшифровка.Параметры.КомиссияПродажа = КомиссияПродажа;				
	ОбластьРасшифровка.Параметры.КомиссияРЕПО = КомиссияРЕПО;				
	ОбластьРасшифровка.Параметры.КомиссияБанка = КомиссияБанка;		
	ОбластьРасшифровка.Параметры.КомиссияПрочая = КомиссияПрочая;	
	ОбластьРасшифровка.Параметры.РасходыДепозитария = РасходыДепозитария;	
	
	Отказ = Ложь;
	ВознаграждениеНачисляетсяВБазеБухгалтерии = РегистрыСведений.УсловияДоговоровДоверительногоУправления.ОплатаВознагражденияУправляющегоИУслугСпецдепозитарияИзСобственныхСредствКлиента(ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления, ЭтотОбъект.Период.ДатаОкончания, Отказ);
	
	Если Не Отказ И ВознаграждениеНачисляетсяВБазеБухгалтерии Тогда 
		
		ТаблицаВознаграждениеУК = РаботаСВнешнимиСистемами.ПолучитьДанныеБухгалтерииОВознагражденииУК("Начисленное", ЭтотОбъект.Период.ДатаНачала, ЭтотОбъект.Период.ДатаОкончания, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления);

		Если ТаблицаВознаграждениеУК = Неопределено Тогда
			
			Если Сессия <> Неопределено Тогда
				РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
			КонецЕсли;
			
			Возврат;
		Иначе
			ВознаграждениеУК = ТаблицаВознаграждениеУК.Итог("Сумма");
		КонецЕсли; 	
		
	КонецЕсли;	

	Если НЕ (ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов 
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний) Тогда
		ОбластьОтчет.Параметры.ВознаграждениеДепозитария = ВознаграждениеДепозитария;
		ОбластьОтчет.Параметры.ВознаграждениеДепозитарияПропись = ЧислоПрописью(ВознаграждениеДепозитария, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	КонецЕсли;	
	ОбластьОтчет.Параметры.ВознаграждениеУК = ВознаграждениеУК;
	ОбластьОтчет.Параметры.ВознаграждениеУКПропись = ЧислоПрописью(ВознаграждениеУК, "Л = ru_RU; НП = Истина; НД = Истина", "рубль,рубля,рублей,м,копейка,копейки,копеек, ж,2");
	
	ОбластьРасшифровка.Параметры.ВознаграждениеДепозитария = ВознаграждениеДепозитария;				
	ОбластьРасшифровка.Параметры.ВознаграждениеУК = ВознаграждениеУК;				
	
	ДокументРезультат.Вывести(ОбластьОтчет);
	ДокументРасшифровка.Вывести(ОбластьРасшифровка);
	
	// подписи
	ОбластьПодписи =  Отчет.ПолучитьОбласть("Подписи");	
	ОбластьПодписи.Параметры.НаименованиеКлиентКраткое = СведенияОбОрганизации.КраткоеНаименование;
	ОбластьПодписи.Параметры.НаименованиеУК_Краткое = СведенияОбОрганизации.НаименованиеОрганизации;	
	
	Если ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями  
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами  
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов Тогда 
		ОбластьПодписи.Параметры.Фонд = "Фонд";
	ИначеЕсли ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний 
		ИЛИ ЭтотОбъект.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний Тогда	
		ОбластьПодписи.Параметры.Фонд = "Страховая компания";	
	КонецЕсли;	
	
	Если КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхПодписантОтКлиента") Тогда 
		СтруктураДанныхПодписантОтКлиента = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.СтруктураДанныхПодписантОтКлиента;	
		Если ЗначениеЗаполнено(СтруктураДанныхПодписантОтКлиента) Тогда
			ОбластьПодписи.Параметры.ПодписантКлиент = ВернутьФИОПодписанта(
				СтруктураДанныхПодписантОтКлиента.КонтактноеЛицо, 
				Ложь, 
				ЭтотОбъект.Период.ДатаОкончания, 
				ЭтотОбъект.Организация).ФИОСокращенно;
		КонецЕсли;	
	КонецЕсли;	
				
	Если КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Свойство("СтруктураДанныхРуководитель") Тогда 
		СтруктураДанныхРуководитель = КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.СтруктураДанныхРуководитель;	
		Если ЗначениеЗаполнено(СтруктураДанныхРуководитель) Тогда
			ОбластьПодписи.Параметры.ПодписантУК = ВернутьФИОПодписанта(
				СтруктураДанныхРуководитель.КонтактноеЛицо, 
				Истина, 
				ЭтотОбъект.Период.ДатаОкончания, 
				ЭтотОбъект.Организация).ФИОСокращенно;		
		КонецЕсли;	
	КонецЕсли;
	ДокументРезультат.Вывести(ОбластьПодписи);
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, "Отчет.ИтоговыйОтчет", , ОриентацияСтраницы.Портрет);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры	

Функция ПолучитьДатуПервогоВвода()
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(ВводДенежныхСредств.Дата, ДЕНЬ) КАК Дата
	|ИЗ
	|	Документ.ВводДенежныхСредств КАК ВводДенежныхСредств
	|ГДЕ
	|	ВводДенежныхСредств.Организация = &Организация
	|	И ВводДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(ВводЦенныхБумаг.Дата, ДЕНЬ)
	|ИЗ
	|	Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
	|ГДЕ
	|	ВводЦенныхБумаг.Организация = &Организация
	|	И ВводЦенныхБумаг.СчетДоверительногоУправления = &СчетДоверительногоУправления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Дата;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции
	
