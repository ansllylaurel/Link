	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	БухПартииЦенныхБумагКПолучениюОстатки.ЦеннаяБумага,
	|	0,
	|	БухПартииЦенныхБумагКПолучениюОстатки.ПереоценкаНаБалансеОстаток,
	|	0,
	|	0
	|ИЗ
	|	РегистрНакопления.БухПартииЦенныхБумагКПолучению.Остатки(
	|			&ДатаОкончания_Граница,
	|			Организация = &Организация
	|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	|				И ВидУчета = &ВидУчета
	|				И Рынок В (ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Паи), ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.ИпотечныеСертификатыУчастия))) КАК БухПартииЦенныхБумагКПолучениюОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
	|	СУММА(_ЦенныеБумаги.БалансоваяСтоимостьБезНКД) КАК БалансоваяСтоимостьБезНКД,
	|	СУММА(_ЦенныеБумаги.Переоценка) КАК Переоценка,
	|	СУММА(_ЦенныеБумаги.НКДУплаченныйНачисленный) КАК НКДУплаченныйНачисленный,
	|	СУММА(_ЦенныеБумаги.СуммаРезервовПодОбесценение) КАК СуммаРезервовПодОбесценение,
	|	СУММА(_ЦенныеБумаги.БалансоваяСтоимостьБезНКД + _ЦенныеБумаги.Переоценка + _ЦенныеБумаги.НКДУплаченныйНачисленный - _ЦенныеБумаги.СуммаРезервовПодОбесценение) КАК ИтогоБух
	|ПОМЕСТИТЬ _ТаблицаЦБ_Бух
	|ИЗ
	|	_ЦенныеБумагиСПартиями КАК _ЦенныеБумаги
	|
	|СГРУППИРОВАТЬ ПО
	|	_ЦенныеБумаги.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_ТаблицаЦБ.ЦеннаяБумага КАК ЦеннаяБумага,
	|	_ТаблицаЦБ.НомерСтроки КАК НомерСтроки,
	|	_ТаблицаЦБ.Стоимость КАК Стоимость,
	|	_ТаблицаЦБ.Сумма КАК Сумма,
	|	_ТаблицаЦБ.Купон КАК Купон,
	|	_ТаблицаЦБ.Количество КАК Количество,
	|	_ТаблицаЦБ.ИтогоРынок КАК ИтогоРынок,
	|	ЕСТЬNULL(_ТаблицаЦБ_Бух.БалансоваяСтоимостьБезНКД, 0) КАК БалансоваяСтоимостьБезНКД,
	|	ЕСТЬNULL(_ТаблицаЦБ_Бух.Переоценка, 0) КАК Переоценка,
	|	ЕСТЬNULL(_ТаблицаЦБ_Бух.НКДУплаченныйНачисленный, 0) КАК НКДУплаченныйНачисленный,
	|	ЕСТЬNULL(_ТаблицаЦБ_Бух.СуммаРезервовПодОбесценение, 0) КАК СуммаРезервовПодОбесценение,
	|	ЕСТЬNULL(_ТаблицаЦБ_Бух.ИтогоБух, 0) КАК ИтогоБух
	|ПОМЕСТИТЬ _ЦенныеБумаги
	|ИЗ
	|	_ТаблицаЦБ КАК _ТаблицаЦБ
	|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЦБ_Бух КАК _ТаблицаЦБ_Бух
	|		ПО _ТаблицаЦБ.ЦеннаяБумага = _ТаблицаЦБ_Бух.ЦеннаяБумага
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	_Показатели.НомерСтроки КАК НомерСтроки,
	|	_Показатели.Сумма КАК Сумма
	|ИЗ
	|	_Показатели КАК _Показатели
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	_Итоги.НомерСтроки,
	|	_Итоги.Сумма
	|ИЗ
	|	_Итоги КАК _Итоги
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Строка090"",
	|	СУММА(_Итоги.Сумма * _Итоги.Знак)
	|ИЗ
	|	_Итоги КАК _Итоги";
	
	#КОНЕЦОБЛАСТИ 
	
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ВидУчета",						Перечисления.ВидыУчета.БухгалтерскийУчет);
	Запрос.УстановитьПараметр("ЦельРасчета",					Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении);	
	Запрос.УстановитьПараметр("ДатаСЧАНаКонецПериода", 			ДатаСЧАНаКонецПериода);
	Запрос.УстановитьПараметр("ДатаОкончания_Граница", 			Новый Граница(КонецДня(ЭтотОбъект.Период), ВидГраницы.Включая));
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл 
		ОбластьОтчет.Параметры[Выборка.НомерСтроки] = Выборка.Сумма; 
	КонецЦикла;	


	ОбластьОтчет.Параметры.ГлавныйБухгалтер 	= СтруктураДанныхГлБухгалтера.КонтактноеЛицо;
	ОбластьОтчет.Параметры.ДолжностьГлавбух    = СтруктураДанныхГлБухгалтера.Должность;
	ДокументРезультат.Вывести(ОбластьОтчет);
	
	ТаблицаЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЦенныеБумаги").ПолучитьДанные().Выгрузить();
	АктивыНеЦБ = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_АктивыНеЦБ").ПолучитьДанные().Выгрузить(); 
	АктивыНеЦБ_Бух = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_АктивыНеЦБ_Бух").ПолучитьДанные().Выгрузить(); 
	Если ДокументРасшифровка <> Неопределено Тогда  
		ЗаполнитьРасшифровку(ДокументРасшифровка, ТаблицаЦБ, АктивыНеЦБ, АктивыНеЦБ_Бух) ;
	КонецЕсли;	
		
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение операции
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура ЗаполнитьРасшифровку(ДокументРасшифровка, ТаблицаЦБ, АктивыНеЦБ, АктивыНеЦБ_Бух)
	
	Макет = ПолучитьМакет("Расшифровка"); 
	
	ТаблицаЦБ.Сортировать("НомерСтроки, ЦеннаяБумага"); 
	АктивыНеЦБ.Сортировать("НомерСтроки"); 
	АктивыНеЦБ_Бух.Сортировать("НомерСтроки, Счет"); 
	
	
	ОбластьШапкаБЦ = Макет.ПолучитьОбласть("ШапкаЦБ");
	ОбластьСтрокаЦБ = Макет.ПолучитьОбласть("СтрокаЦБ");
	ОбластьШапкаНеБЦ = Макет.ПолучитьОбласть("ШапкаНеЦБ");
	ОбластьСтрокаНеЦБ = Макет.ПолучитьОбласть("СтрокаНеЦБ");
	ОбластьШапкаНеБЦ_Бух = Макет.ПолучитьОбласть("ШапкаНеЦБ_Бух");
	ОбластьСтрокаНеЦБ_Бух = Макет.ПолучитьОбласть("СтрокаНеЦБ_Бух");
	
	// ценные бумаги. На уровне запроса объединены данные СЧА и БУ.
	ДокументРасшифровка.Вывести(ОбластьШапкаБЦ);
	
	Для Каждого СтрокаТаблицаЦБ из ТаблицаЦБ Цикл 
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаЦБ.Параметры, СтрокаТаблицаЦБ);
		ДокументРасшифровка.Вывести(ОбластьСтрокаЦБ);
	КонецЦикла;	
		
	// Активы не ЦБ. 
	ДокументРасшифровка.Вывести(ОбластьШапкаНеБЦ);
	Для Каждого СтрокаАктивыНеЦБ из АктивыНеЦБ Цикл 
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаНеЦБ.Параметры, СтрокаАктивыНеЦБ);
		ДокументРасшифровка.Вывести(ОбластьСтрокаНеЦБ);
	КонецЦикла;	
	
	// Активы не ЦБ (бух) 
	ДокументРасшифровка.Вывести(ОбластьШапкаНеБЦ_Бух);
	Для Каждого СтрокаАктивыНеЦБ_Бух из АктивыНеЦБ_Бух Цикл 
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаНеЦБ_Бух.Параметры, СтрокаАктивыНеЦБ_Бух);
		ДокументРасшифровка.Вывести(ОбластьСтрокаНеЦБ_Бух);
	КонецЦикла;	
	
	
КонецПроцедуры	

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	
//	ЭтотОбъект.Подписант	= НастройкиОтчета.Подписант.КонтактноеЛицо;
	ЭтотОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("СтруктураДанныхГлБухгалтера",	НастройкиОтчета.Подписант);

	ЭтотОбъект.Период		= НастройкиОтчета.Период.ДатаОкончания;	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	СформироватьОтчет(ДокументРезультат);
	
	НастройкиОтчета.Вставить("Результат", ДокументРезультат);
	
КонецПроцедуры
