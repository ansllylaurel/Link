
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет агенту о расторгнутых / незаключенных договорах",
		"0.11",
		"",
		Истина);
	
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Функция СформироватьОтчет(ПараметрыОтчета) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыОтчета, "Организация, АгентскийДоговор, НачалоПериода, КонецПериода", ПараметрыОтчета.Подписант);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьОтчет()";
    Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",		ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("АгентскийДоговор",	ПараметрыОтчета.АгентскийДоговор);
	Запрос.УстановитьПараметр("НачалоПериода",		ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",		ПараметрыОтчета.КонецПериода);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СДУ,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
		|ПОМЕСТИТЬ _СДУ
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И СчетаДоверительногоУправления.ДатаРасторжения >= &НачалоПериода
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.ДатаЗаключения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И СчетаДоверительногоУправления.АгентскийДоговор = &АгентскийДоговор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СДУ,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _Клиенты
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			,
		|			СчетДоверительногоУправления В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					_СДУ.СДУ КАК СДУ
		|				ИЗ
		|					_СДУ КАК _СДУ)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|";
	
	Запрос.Выполнить();
	
	РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(
		Запрос, ТекущаяДатаСеанса(), ПараметрыОтчета.Организация, Новый Структура("ИмяТаблицы, ПолеФизЛица", "_Клиенты", "Клиент"), "_ДатыПолученияДокументовОСмерти");
		
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК Клиент,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК ФИО,
		|	ВЫБОР
		|		КОГДА РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаСмерти = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА NULL
		|		ИНАЧЕ РеквизитыФизическихЛицАнкетныеСрезПоследних.ДатаСмерти
		|	КОНЕЦ КАК ДатаСмерти,
		|	_ДатыПолученияДокументовОСмерти.Дата КАК ДатаПолученияДокументовОСмерти
		|ПОМЕСТИТЬ _ФИО
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И ЮрФизЛицо В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_Клиенты.Клиент КАК Клиент
		|					ИЗ
		|						_Клиенты КАК _Клиенты)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПолученияДокументовОСмерти КАК _ДатыПолученияДокументовОСмерти
		|		ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = _ДатыПолученияДокументовОСмерти.ФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления КАК СДУ
		|ПОМЕСТИТЬ _СДУСВводомДС
		|ИЗ
		|	РегистрНакопления.ВводыВыводыАктивовВВалютеУчета КАК ВводыВыводыАктивовВВалютеУчета
		|ГДЕ
		|	ВводыВыводыАктивовВВалютеУчета.Организация = &Организация
		|	И ВводыВыводыАктивовВВалютеУчета.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				_СДУ.СДУ КАК СДУ
		|			ИЗ
		|				_СДУ КАК _СДУ)
		|	И ВводыВыводыАктивовВВалютеУчета.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_ФИО.ФИО, """") КАК ФИО,
		|	_СДУ.НомерДоговора КАК НомерДоговора,
		|	_СДУ.ДатаДоговора КАК ДатаДоговора,
		|	ВЫБОР
		|		КОГДА НЕ _ФИО.ДатаПолученияДокументовОСмерти ЕСТЬ NULL
		|			ТОГДА _ФИО.ДатаСмерти
		|		ИНАЧЕ _СДУ.ДатаРасторжения
		|	КОНЕЦ КАК ДатаРасторжения,
		|	ВЫБОР
		|		КОГДА НЕ _ФИО.ДатаСмерти ЕСТЬ NULL
		|			ТОГДА 0
		|		КОГДА _СДУСВводомДС.СДУ ЕСТЬ NULL
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Статус
		|ИЗ
		|	_СДУ КАК _СДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Клиенты КАК _Клиенты
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ФИО КАК _ФИО
		|			ПО _Клиенты.Клиент = _ФИО.Клиент
		|		ПО _СДУ.СДУ = _Клиенты.СДУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СДУСВводомДС КАК _СДУСВводомДС
		|		ПО _СДУ.СДУ = _СДУСВводомДС.СДУ
		|ГДЕ
		|	ВЫБОР
		|			КОГДА НЕ _ФИО.ДатаПолученияДокументовОСмерти ЕСТЬ NULL
		|				ТОГДА _ФИО.ДатаПолученияДокументовОСмерти
		|			ИНАЧЕ _СДУ.ДатаРасторжения
		|		КОНЕЦ МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	Статус УБЫВ
		|ИТОГИ ПО
		|	Статус
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК АгентскийДоговор,
		|	Договоры.Контрагент КАК ЮрФизЛицо,
		|	Договоры.НомерДоговора КАК НомерДоговора,
		|	Договоры.ДатаЗаключения КАК ДатаДоговора
		|ПОМЕСТИТЬ _ДанныеАгентскогоДоговора
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Ссылка = &АгентскийДоговор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыФизическихЛицСрезПоследних.Фамилия + "" "" + РеквизитыФизическихЛицСрезПоследних.Имя + "" "" + РеквизитыФизическихЛицСрезПоследних.Отчество КАК НаименованиеАгента
		|ПОМЕСТИТЬ _РеквизитыАгента
		|ИЗ
		|	РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|			&КонецПериода,
		|			(ЮрФизЛицо, Организация, Язык) В
		|				(ВЫБРАТЬ
		|					_ДанныеАгентскогоДоговора.ЮрФизЛицо КАК ЮрФизЛицо,
		|					&Организация КАК Организация,
		|					ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык
		|				ИЗ
		|					_ДанныеАгентскогоДоговора КАК _ДанныеАгентскогоДоговора)) КАК РеквизитыФизическихЛицСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&КонецПериода,
		|			(ЮрФизЛицо, Язык) В
		|				(ВЫБРАТЬ
		|					_ДанныеАгентскогоДоговора.ЮрФизЛицо КАК ЮрФизЛицо,
		|					ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык
		|				ИЗ
		|					_ДанныеАгентскогоДоговора КАК _ДанныеАгентскогоДоговора)) КАК РеквизитыЮридическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РеквизитыАгента.НаименованиеАгента КАК Агент,
		|	_ДанныеАгентскогоДоговора.НомерДоговора КАК НомерДоговора,
		|	_ДанныеАгентскогоДоговора.ДатаДоговора КАК ДатаДоговора
		|ИЗ
		|	_ДанныеАгентскогоДоговора КАК _ДанныеАгентскогоДоговора,
		|	_РеквизитыАгента КАК _РеквизитыАгента";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаПоПризнаку = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДанныеАгентскогоДоговора = РезультатЗапроса[5].Выгрузить()[0];
	
	Макет = ПолучитьМакет("Макет");
	
	// Получаем области макета.
	Шапка			= Макет.ПолучитьОбласть("Шапка");
	ШапкаТаблицы	= Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаТаблицы	= Макет.ПолучитьОбласть("СтрокаТаблицы");
	Подвал			= Макет.ПолучитьОбласть("Подвал");
	
	// Выводим шапку.
	
	Шапка.Параметры.Агент				= ДанныеАгентскогоДоговора.Агент;
	Шапка.Параметры.НомерДоговора		= ДанныеАгентскогоДоговора.НомерДоговора;
	Шапка.Параметры.ДатаДоговора		= Формат(ДанныеАгентскогоДоговора.ДатаДоговора, "ДФ='dd.MM.yyyy ''г.'''");
	Шапка.Параметры.ДатаФормирования	= ТекущаяДата();
	Шапка.Параметры.НачалоПериода		= Формат(ПараметрыОтчета.НачалоПериода, "ДФ=dd.MM.yyyy");
	Шапка.Параметры.КонецПериода		= Формат(ПараметрыОтчета.КонецПериода, "ДФ=dd.MM.yyyy");
	
	ТабличныйДокумент.Вывести(Шапка);
	
	Пока ВыборкаПоПризнаку.Следующий() Цикл
		
		// Выводим шапку таблицы.
		Если ВыборкаПоПризнаку.Статус = 2 Тогда
			ШапкаТаблицы.Параметры.ТекстЗаголовка = "Расторгнутые договоры";
		ИначеЕсли ВыборкаПоПризнаку.Статус = 1 Тогда 
			ШапкаТаблицы.Параметры.ТекстЗаголовка = "Договоры, признанные незаключенными";
		Иначе
			ШапкаТаблицы.Параметры.ТекстЗаголовка = "Прекращенные договоры в связи со смертью клиента, информация по которым получена в отчетном месяце";			
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ШапкаТаблицы);
		
		// Выводим тело таблицы.
		Выборка = ВыборкаПоПризнаку.Выбрать();
		
		НомерСтроки = 1;
		
		Пока Выборка.Следующий() Цикл
			СтрокаТаблицы.Параметры.НомерСтроки = НомерСтроки;
			СтрокаТаблицы.Параметры.Заполнить(Выборка);
			ТабличныйДокумент.Вывести(СтрокаТаблицы);
			
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	Если ПараметрыОтчета.Свойство("Подписант") И ЗначениеЗаполнено(ПараметрыОтчета.Подписант) Тогда
		ДанныеПодписанта = ПараметрыОтчета.Подписант;
		
		Подвал.Параметры.Должность = ДанныеПодписанта.Должность + ?(ЗначениеЗаполнено(ДанныеПодписанта.ОснованиеПолномочий), " (на основании " + ДанныеПодписанта.ОснованиеПолномочий + ")", "");
		Подвал.Параметры.Подписант = ДанныеПодписанта.КонтактноеЛицо;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Подвал);
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ТабличныйДокумент;
	
КонецФункции