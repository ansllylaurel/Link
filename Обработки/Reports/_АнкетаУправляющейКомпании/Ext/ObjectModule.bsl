#Область СЧА_10_крупнейших_клиентов_последнюю_отчетную_дату_и_дату_годом_ранее 

	// 9 Укажите 10 крупнейших клиентов по объему средств под управлением на последнюю отчетную дату и дату годом ранее
	
	Если ВключенныеОтчеты.Получить("СЧА10КрупнейшихКлиентов") = Истина Тогда 	
	
		Запрос = Новый Запрос(
