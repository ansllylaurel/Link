
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Анкета управляющей компании",
		"0.58",
		"",
		Истина,
		""
	);
		
	// команды отсутствуют - только интерактивный запуск
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Вариант = РаботаСОтчетамиКлиентСервер.ПолучитьКлючВариантаОтчета(ЭтотОбъект);
	
	Если Вариант = "СтруктураИДинамикаСЧА" Тогда
		
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");	
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	Вариант = РаботаСОтчетамиКлиентСервер.ПолучитьКлючВариантаОтчета(ЭтотОбъект);
	
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя();
	ПараметрыСтатистики	= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, , Новый Структура("ВариантОтчета", Вариант));
    Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);

	БиржаММВБ			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	ВалютаРубли			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	КалендарьКотировок	= ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок");
	ВалютаУчета			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ВалютаУчета");
	
	ПараметрыОтчета = Новый Структура;		
	ПараметрыОтчета.Вставить("Организация",					ЭтотОбъект.Организация);
	ПараметрыОтчета.Вставить("ОтчетнаяДата",				ЭтотОбъект.ОтчетнаяДата);
	ПараметрыОтчета.Вставить("ОтчетнаяДатаКонецДня",		КонецДня(ЭтотОбъект.ОтчетнаяДата));
	ПараметрыОтчета.Вставить("ОтчетнаяДатаКонецДняГраница",	Новый Граница(КонецДня(ЭтотОбъект.ОтчетнаяДата), ВидГраницы.Включая));
	ПараметрыОтчета.Вставить("БиржаММВБ",					БиржаММВБ);
	ПараметрыОтчета.Вставить("ВалютаУчета",					ВалютаУчета);
	ПараметрыОтчета.Вставить("ВалютаРубли",					ВалютаРубли);
	ПараметрыОтчета.Вставить("КалендарьКотировок",			КалендарьКотировок);	
	ПараметрыОтчета.Вставить("ТипыЦенныхБумаг",				Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип.Типы());	
	
	ПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных;
	ПараметрыДанных.УстановитьЗначениеПараметра("Организация",					ПараметрыОтчета.Организация);
	ПараметрыДанных.УстановитьЗначениеПараметра("ОтчетнаяДата",					ПараметрыОтчета.ОтчетнаяДата);
	ПараметрыДанных.УстановитьЗначениеПараметра("ОтчетнаяДатаКонецДня",			ПараметрыОтчета.ОтчетнаяДатаКонецДня);
	ПараметрыДанных.УстановитьЗначениеПараметра("ОтчетнаяДатаКонецДняГраница",	ПараметрыОтчета.ОтчетнаяДатаКонецДняГраница);
	ПараметрыДанных.УстановитьЗначениеПараметра("БиржаММВБ",					ПараметрыОтчета.БиржаММВБ);
	ПараметрыДанных.УстановитьЗначениеПараметра("ВалютаУчета",					ПараметрыОтчета.ВалютаУчета);
	ПараметрыДанных.УстановитьЗначениеПараметра("ВалютаРубли",					ПараметрыОтчета.ВалютаРубли);
	ПараметрыДанных.УстановитьЗначениеПараметра("ТипыЦенныхБумаг",				ПараметрыОтчета.ТипыЦенныхБумаг);
	
	// Задаем округление
	
	Если ЭтотОбъект.ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
		ФорматСумм = "ЧС=3";
	ИначеЕсли ЭтотОбъект.ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		ФорматСумм = "ЧС=6";
	Иначе	
		ФорматСумм = "ЧС=0;";
	КонецЕсли;	
	
	Для Каждого НаборДанных Из СхемаКомпоновкиДанных.НаборыДанных Цикл
		Для Каждого ПолеНабораДанных Из НаборДанных.Поля Цикл
			ПолеОформленияФормат = ПолеНабораДанных.Оформление.Элементы.Найти("Формат");
			Если ПолеОформленияФормат <> Неопределено И СтрНайти(ПолеОформленияФормат.Значение, "[ЧС]") > 0 Тогда
				ПолеОформленияФормат.Значение = СтрЗаменить(ПолеОформленияФормат.Значение, "[ЧС]", ФорматСумм);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Определяем включенные отчеты
	
	ВключенныеОтчеты = Новый Соответствие;
	
	НастройкиКомпоновкиДанных = КомпоновщикНастроек.ПолучитьНастройки();
	
	Для Каждого ЭлементСтруктуры Из НастройкиКомпоновкиДанных.Структура Цикл
		Если ЭлементСтруктуры.Использование Тогда
			ВключенныеОтчеты.Вставить(ЭлементСтруктуры.Имя, Истина);		
		КонецЕсли;
	КонецЦикла;
	
	// Собираем данные
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ОбщиеВременныеТаблицы	= "_ДанныеСЧА77, _КатегорииКлиентов, _КатегорииСчетовДУ, _КатегорииПИФ, _Последние8Кварталов, _Последние4Квартала, _Последние2Года, _КлиентыСрезПоПоследним8Кварталам, _ТаблицаВознаграждений";
	
	ПоместитьКатегорииКлиентовВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц);
	ПоместитьВременныеИнтервалыВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц);
	ПоместитьСрезКлиентовПоПоследним8КварталамВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц);
	
	Если ВключенныеОтчеты.Получить("Вознаграждения_УК") = Истина
		ИЛИ ВключенныеОтчеты.Получить("Вознаграждения_УК_Бухгалтерия") = Истина
		ИЛИ ВключенныеОтчеты.Получить("ДоходыОт10КрупнейшихКлиентов") = Истина
		ИЛИ ВключенныеОтчеты.Получить("ДоходыОт3КрупнейшихКлиентов") = Истина
		ИЛИ ВключенныеОтчеты.Получить("ДоходыОт10КрупнейшихКлиентовЗа4Квартала") = Истина
		ИЛИ ВключенныеОтчеты.Получить("ДоходыОтВсехКлиентов") = Истина
	Тогда
		ПоместитьВознагражденияВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц);
	КонецЕсли;
	
	ВнешниеНаборыДанных = Новый Структура; 	
	
#Область СЧА_из_7_7

	Если ВключенныеОтчеты.Получить("СЧА_за_9_кварталов") = Истина
		ИЛИ ВключенныеОтчеты.Получить("СЧА10КрупнейшихКлиентов") = Истина 		
		ИЛИ ВключенныеОтчеты.Получить("ДинамикаСЧАПортфелей") = Истина 
		ИЛИ ВключенныеОтчеты.Получить("АктивыДепозитариев") = Истина
		ИЛИ ВключенныеОтчеты.Получить("ДоляАктивовПоИсточникамСредств") = Истина
		ИЛИ ВключенныеОтчеты.Получить("СтруктураПортфелей") = Истина
	Тогда
		
		Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
			ДанныеСЧА77 = ПолучитьСЧАИзМакета("_СЧА_из_77_РЭМ, _Форма501_РЭМ_без_2018");
		ИначеЕсли ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
			ДанныеСЧА77 = ПолучитьСЧАИзМакета("_СЧА_из_77_Траст, _Форма501_Траст_без_2018");
		Иначе
			ДанныеСЧА77 = ПолучитьСЧАИзМакета(""); 	
		КонецЕсли;
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеСЧА77.Период КАК Период,
			|	ДанныеСЧА77.Организация КАК Организация,
			|	ДанныеСЧА77.СубъектАналитики КАК СубъектАналитики,
			|	ДанныеСЧА77.ВидПоказателя КАК ВидПоказателя,
			|	ДанныеСЧА77.Значение КАК Значение
			|ПОМЕСТИТЬ _ДанныеСЧА77
			|ИЗ
			|	&ДанныеСЧА77 КАК ДанныеСЧА77");	
			
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("ДанныеСЧА77", ДанныеСЧА77);
		
		Запрос.Выполнить();
	
	КонецЕсли;

#КонецОбласти
	
#Область СЧА_за_9_кварталов	

	Если ВключенныеОтчеты.Получить("СЧА_за_9_кварталов") = Истина Тогда

		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДанныеСЧА77.Период КАК Период,
			|	_ДанныеСЧА77.Организация КАК Организация,
			|	_ДанныеСЧА77.СубъектАналитики КАК СубъектАналитики,
			|	_ДанныеСЧА77.ВидПоказателя КАК ВидПоказателя,
			|	_ДанныеСЧА77.Значение КАК Значение
			|ПОМЕСТИТЬ _ФинансовыеПоказатели
			|ИЗ
			|	_ДанныеСЧА77 КАК _ДанныеСЧА77
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ФинансовыеПоказатели.Период,
			|	ФинансовыеПоказатели.Организация,
			|	ФинансовыеПоказатели.СубъектАналитики,
			|	ФинансовыеПоказатели.ВидПоказателя,
			|	ФинансовыеПоказатели.Значение
			|ИЗ
			|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|ГДЕ
			|	ФинансовыеПоказатели.Организация = &Организация
			|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_Последние8Кварталов.КонецПериодаНачалоДня КАК Период,
			|	ДатыРегистрацииСЧА.ДатаРегистрации КАК ДатаРегистрацииСЧА,
			|	ЕСТЬNULL(_КатегорииСчетовДУ.Категория, СчетаДоверительногоУправления.Ссылка) КАК Категория,
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДУ,
			|	ФинансовыеПоказатели.Значение КАК СЧА,
			|	РАЗНОСТЬДАТ(ДатыРегистрацииСЧА.ДатаРегистрации, _Последние8Кварталов.КонецПериода, ДЕНЬ) > 2 КАК ЭтоСтароеСЧА,
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
			|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения
			|ПОМЕСТИТЬ _ВеличинаСредствПодУправлением
			|ИЗ
			|	_Последние8Кварталов КАК _Последние8Кварталов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО (СчетаДоверительногоУправления.Организация = &Организация)
			|			И (СчетаДоверительногоУправления.ДатаЗаключения <= _Последние8Кварталов.КонецПериодаНачалоДня)
			|			И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > _Последние8Кварталов.КонецПериодаНачалоДня)
			|			И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
			|		ЛЕВОЕ СОЕДИНЕНИЕ _КатегорииСчетовДУ КАК _КатегорииСчетовДУ
			|		ПО _КатегорииСчетовДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				_Последние8Кварталов.КонецПериодаНачалоДня КАК Период,
			|				ФинансовыеПоказатели.СубъектАналитики КАК СубъектАналитики,
			|				МАКСИМУМ(ФинансовыеПоказатели.Период) КАК ДатаРегистрации
			|			ИЗ
			|				_ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Последние8Кварталов КАК _Последние8Кварталов
			|					ПО (ФинансовыеПоказатели.Период МЕЖДУ _Последние8Кварталов.НачалоПериода И _Последние8Кварталов.КонецПериодаНачалоДня)
			|			ГДЕ
			|				ФинансовыеПоказатели.Организация = &Организация
			|				И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
			|			
			|			СГРУППИРОВАТЬ ПО
			|				_Последние8Кварталов.КонецПериодаНачалоДня,
			|				ФинансовыеПоказатели.СубъектАналитики) КАК ДатыРегистрацииСЧА
			|			ПО (ДатыРегистрацииСЧА.СубъектАналитики = ФинансовыеПоказатели.СубъектАналитики)
			|				И (ДатыРегистрацииСЧА.ДатаРегистрации = ФинансовыеПоказатели.Период)
			|		ПО (ФинансовыеПоказатели.Организация = &Организация)
			|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
			|			И (ФинансовыеПоказатели.СубъектАналитики = СчетаДоверительногоУправления.Ссылка)
			|			И (ДатыРегистрацииСЧА.Период = _Последние8Кварталов.КонецПериодаНачалоДня)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
