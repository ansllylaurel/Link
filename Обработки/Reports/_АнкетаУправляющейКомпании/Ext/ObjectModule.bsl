			|					КОГДА ЕСТЬNULL(КотировкиАкций.LISTNAME, 0) = 1
			|							ИЛИ ВходящиеВИндексММВБ.ЦеннаяБумага ЕСТЬ НЕ NULL 
			|						ТОГДА ""Акции котировального списка I уровня или индекса ММВБ""
			|					ИНАЧЕ ""Иные акции""
			|				КОНЕЦ
			|		КОГДА СтоимостьПереоценкиЦБ.ЦеннаяБумага ССЫЛКА Справочник.Паи
			|			ТОГДА ""Инвестиционные паи ПИФов""
			|		КОГДА ВЫРАЗИТЬ(СтоимостьПереоценкиЦБ.ЦеннаяБумага КАК Справочник.ПроизводныеФинансовыеИнструменты).ТипПроизводногоФинансовогоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводныхФинансовыхИнструментов.Фьючерс)
			|			ТОГДА ""Производные финансовые инструменты""
			|		ИНАЧЕ СтоимостьПереоценкиЦБ.ЦеннаяБумага.УчетныйАктивЦБРФ.Наименование
			|	КОНЕЦ,
			|	СтоимостьПереоценкиЦБ.СуммаВВалютеУчета + СтоимостьПереоценкиЦБ.СуммаКупонаВВалютеУчета,
			|	СтоимостьПереоценкиЦБ.ЦеннаяБумага.ВалютаНоминала,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.ЦенныеБумаги),
			|	СтоимостьПереоценкиЦБ.ЦеннаяБумага ССЫЛКА Справочник.Облигации,
			|	СтоимостьПереоценкиЦБ.ЦеннаяБумага,
			|	СтоимостьПереоценкиЦБ.СчетДоверительногоУправления,
			|	СтоимостьПереоценкиЦБ.Регистратор,
			|	_ПоследниеПереоценкиЦБ.Период
			|ИЗ
			|	РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценкиЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПоследниеПереоценкиЦБ КАК _ПоследниеПереоценкиЦБ
			|		ПО (_ПоследниеПереоценкиЦБ.Ссылка = СтоимостьПереоценкиЦБ.Регистратор)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ОтобранныеПортфели КАК _ОтобранныеПортфели
			|		ПО (_ОтобранныеПортфели.СчетДоверительногоУправления = СтоимостьПереоценкиЦБ.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумагСводные.СрезПоследних(
			|				&ОтчетнаяДатаКонецДня,
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
			|					И Биржа = &БиржаММВБ) КАК КотировкиАкций
			|		ПО (КотировкиАкций.ЦеннаяБумага = СтоимостьПереоценкиЦБ.ЦеннаяБумага)
			|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ПеречниОбъектов.Объект КАК ЦеннаяБумага
			|		ИЗ
			|			РегистрСведений.ПеречниОбъектов.СрезПоследних(
			|					&ОтчетнаяДатаКонецДня,
			|					ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ММВБ)
			|						И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СоставИндексаММВБ)) КАК ПеречниОбъектов
			|		ГДЕ
			|			ПеречниОбъектов.Включен = ИСТИНА) КАК ВходящиеВИндексММВБ
			|		ПО (ВходящиеВИндексММВБ.ЦеннаяБумага = СтоимостьПереоценкиЦБ.ЦеннаяБумага)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	НастройкиЦелейРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НастройкиЦелейРасчета.ВидУчетаДляОстатковПартий КАК ВидУчета,
			|	_ДетализацияАктивов.РасшифровкаАктива КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ПараметрыПартий
			|ИЗ
			|	_ПоследниеПереоценкиЦБ КАК _ПоследниеПереоценкиЦБ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДетализацияАктивов КАК _ДетализацияАктивов
			|		ПО (_ДетализацияАктивов.СчетДоверительногоУправления = _ПоследниеПереоценкиЦБ.СчетДоверительногоУправления)
			|			И (_ДетализацияАктивов.ЭтоОблигация = ИСТИНА)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЦелейРасчета КАК НастройкиЦелейРасчета
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				НастройкиЦелейРасчета.Организация КАК Организация,
			|				НастройкиЦелейРасчета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|				НастройкиЦелейРасчета.ЦельРасчета КАК ЦельРасчета,
			|				МАКСИМУМ(НастройкиЦелейРасчета.Период) КАК Период
			|			ИЗ
			|				РегистрСведений.НастройкиЦелейРасчета КАК НастройкиЦелейРасчета
			|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПоследниеПереоценкиЦБ КАК _ПоследниеПереоценкиЦБ
			|					ПО (НастройкиЦелейРасчета.Организация = &Организация)
			|						И НастройкиЦелейРасчета.СчетДоверительногоУправления = _ПоследниеПереоценкиЦБ.СчетДоверительногоУправления
			|						И (НастройкиЦелейРасчета.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ОценкаОбъектовВУправлении))
			|						И НастройкиЦелейРасчета.Период <= _ПоследниеПереоценкиЦБ.Период
			|			
			|			СГРУППИРОВАТЬ ПО
			|				НастройкиЦелейРасчета.Организация,
			|				НастройкиЦелейРасчета.СчетДоверительногоУправления,
			|				НастройкиЦелейРасчета.ЦельРасчета) КАК ПоследниеНастройкиЦелейРасчета
			|			ПО (ПоследниеНастройкиЦелейРасчета.Организация = НастройкиЦелейРасчета.Организация)
			|				И (ПоследниеНастройкиЦелейРасчета.СчетДоверительногоУправления = НастройкиЦелейРасчета.СчетДоверительногоУправления)
			|				И (ПоследниеНастройкиЦелейРасчета.ЦельРасчета = НастройкиЦелейРасчета.ЦельРасчета)
			|				И (ПоследниеНастройкиЦелейРасчета.Период = НастройкиЦелейРасчета.Период)
			|		ПО (НастройкиЦелейРасчета.СчетДоверительногоУправления = _ПоследниеПереоценкиЦБ.СчетДоверительногоУправления)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДетализацияАктивов.ОбъектВложений КАК ОбъектВложений,
			|	_ДетализацияАктивов.ИсточникСредств КАК ИсточникСредств,
			|	_ДетализацияАктивов.ТипВложений КАК ТипВложений,
			|	_ДетализацияАктивов.Сумма КАК Сумма,
			|	_ДетализацияАктивов.ВидАктива КАК ВидАктива,
			|	_ДетализацияАктивов.ЭтоОблигация КАК ЭтоОблигация,
			|	_ДетализацияАктивов.РасшифровкаАктива КАК РасшифровкаАктива,
			|	_ДетализацияАктивов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДетализацияАктивов.Регистратор КАК Регистратор,
			|	_ДетализацияАктивов.Период КАК Период,
			|	_ПараметрыПартий.ВидУчета КАК ВидУчета
			|ИЗ
			|	_ДетализацияАктивов КАК _ДетализацияАктивов
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ПараметрыПартий КАК _ПараметрыПартий
			|		ПО (_ПараметрыПартий.СчетДоверительногоУправления = _ДетализацияАктивов.СчетДоверительногоУправления)
			|			И (_ПараметрыПартий.ЦеннаяБумага = _ДетализацияАктивов.РасшифровкаАктива)
			|ИТОГИ
			|	МАКСИМУМ(ЭтоОблигация),
			|	МАКСИМУМ(Период),
			|	МАКСИМУМ(ВидУчета)
			|ПО
			|	СчетДоверительногоУправления");
		
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;			
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ОтчетнаяДата", ЭтотОбъект.ОтчетнаяДата);
		Запрос.УстановитьПараметр("ОтчетнаяДатаКонецДня", КонецДня(ЭтотОбъект.ОтчетнаяДата));
		Запрос.УстановитьПараметр("БиржаММВБ", БиржаММВБ);
		Запрос.УстановитьПараметр("ПортфелиДляДинамикиСЧА", ПортфелиДляДинамикиСЧА);
		
		ПартииОблигаций = Новый ТаблицаЗначений;
		ПартииОблигаций.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		ПартииОблигаций.Колонки.Добавить("ЦеннаяБумага", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
		ПартииОблигаций.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		ПартииОблигаций.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число"));
		ПартииОблигаций.Колонки.Добавить("ДюрацияВГодах", Новый ОписаниеТипов("Число"));
			
		ВыборкаПоКлиентам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);		
		Пока ВыборкаПоКлиентам.Следующий() Цикл
			
			Если ВыборкаПоКлиентам.ЭтоОблигация Тогда // Есть облигации
				
				// ПФР не ведет партионный учет, поэтому дюрацию бумаг берем из котировок	
				
				МетодОценкиСтоимости = БухгалтерскийУчет.ОпределитьНастройкуДляВидаУчета(ЭтотОбъект.ОтчетнаяДата, ЭтотОбъект.Организация, ВыборкаПоКлиентам.СчетДоверительногоУправления, ВыборкаПоКлиентам.ВидУчета, "МетодОценкиСтоимости");  
					
				Если МетодОценкиСтоимости = Перечисления.МетодыОценкиСтоимости.ПоСреднему Тогда 
					
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
						|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
						|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
						|	ВЫРАЗИТЬ(КотировкиЦенныхБумаг.DURATION / 365 КАК ЧИСЛО(27, 5)) КАК ДюрацияВГодах
						|ИЗ
						|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
						|			&Период,
						|			(Организация, СчетДоверительногоУправления, ВидУчета, Рынок, ЦеннаяБумага) В
						|				(ВЫБРАТЬ
						|					&Организация,
						|					_ПараметрыПартий.СчетДоверительногоУправления,
						|					_ПараметрыПартий.ВидУчета,
						|					ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации),
						|					_ПараметрыПартий.ЦеннаяБумага
						|				ИЗ
						|					_ПараметрыПартий КАК _ПараметрыПартий
						|				ГДЕ
						|					_ПараметрыПартий.СчетДоверительногоУправления = &СчетДоверительногоУправления)) КАК БухПартииЦенныхБумагОстатки
						|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КотировкиЦенныхБумагСводные.СрезПоследних(
						|				&ОтчетнаяДатаКонецДня,
						|				Биржа = &БиржаММВБ
						|					И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК КотировкиЦенныхБумаг
						|		ПО (КотировкиЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага)
						|";
					
				Иначе
					
					Запрос.Текст = "
						|ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
						|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
						|	БухПартииЦенныхБумагОстатки.Партия КАК Партия,
						|	БухПартииЦенныхБумагОстатки.СтрокаПартии КАК СтрокаПартии,
						|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество,
						|	БухПартииЦенныхБумагОстатки.СтоимостьПокупкиОстаток / БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК ЦенаПокупки,
						|	ЕСТЬNULL(ВводЦенныхБумаг.ДатаПокупки, БухПартииЦенныхБумагОстатки.Партия.Дата) КАК ДатаПокупки
						|ИЗ
						|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
						|			&Период,
						|			(Организация, СчетДоверительногоУправления, ВидУчета, Рынок, ЦеннаяБумага) В
						|				(ВЫБРАТЬ
						|					&Организация,
						|					_ПараметрыПартий.СчетДоверительногоУправления,
						|					_ПараметрыПартий.ВидУчета,
						|					ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации),
						|					_ПараметрыПартий.ЦеннаяБумага
						|				ИЗ
						|					_ПараметрыПартий КАК _ПараметрыПартий
						|				ГДЕ
						|					_ПараметрыПартий.СчетДоверительногоУправления = &СчетДоверительногоУправления)) КАК БухПартииЦенныхБумагОстатки
						|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводЦенныхБумаг.ЦенныеБумаги КАК ВводЦенныхБумаг    
						|	ПО ВводЦенныхБумаг.Ссылка = БухПартииЦенныхБумагОстатки.Партия
						|		И ВводЦенныхБумаг.НомерСтроки = БухПартииЦенныхБумагОстатки.СтрокаПартии
						|		И ВводЦенныхБумаг.ЦеннаяБумага = БухПартииЦенныхБумагОстатки.ЦеннаяБумага
						|		И ВводЦенныхБумаг.ДатаПокупки <> ДАТАВРЕМЯ(1, 1, 1)
						|";
					
				КонецЕсли;	
					
				Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ВыборкаПоКлиентам.Период), ВидГраницы.Включая));
				Запрос.УстановитьПараметр("СчетДоверительногоУправления", ВыборкаПоКлиентам.СчетДоверительногоУправления);
				
				ПартииОблигацийКлиента = Запрос.Выполнить().Выгрузить();
				
			КонецЕсли;
			
			ВыборкаПоАктивам = ВыборкаПоКлиентам.Выбрать();
			Пока ВыборкаПоАктивам.Следующий() Цикл
				
				Если ВыборкаПоАктивам.ЭтоОблигация Тогда
					
					ПартииБумагиКлиента = ПартииОблигацийКлиента.НайтиСтроки(Новый Структура("ЦеннаяБумага", ВыборкаПоАктивам.РасшифровкаАктива));
					Для Каждого СтрокаПартииБумагиКлиента Из ПартииБумагиКлиента Цикл
						
						Если МетодОценкиСтоимости = Перечисления.МетодыОценкиСтоимости.ПоСреднему Тогда 
							
							Если Не ЗначениеЗаполнено(СтрокаПартииБумагиКлиента.ДюрацияВГодах) Тогда
								Сообщить("Не определена дюрация бумаги """ + Строка(СтрокаПартииБумагиКлиента.ЦеннаяБумага) + """ для """ + Строка(СтрокаПартииБумагиКлиента.СчетДоверительногоУправления) + """");
								Продолжить;
							КонецЕсли;
							
							СтрокаПартии = ПартииОблигаций.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаПартии, СтрокаПартииБумагиКлиента);					
							
						Иначе
							
							Если СтрокаПартииБумагиКлиента.ЦенаПокупки = 0 Тогда
								Сообщить("Не определена цена """ + Строка(СтрокаПартииБумагиКлиента.ЦеннаяБумага) + """ по партии """ + Строка(СтрокаПартииБумагиКлиента.Партия) + """ для """ + Строка(СтрокаПартииБумагиКлиента.СчетДоверительногоУправления) + """");
								Продолжить;
							КонецЕсли;
								
							СтрокаПартии = ПартииОблигаций.Добавить();
							ЗаполнитьЗначенияСвойств(СтрокаПартии, СтрокаПартииБумагиКлиента);					
								
							ДанныеРасчета = Справочники.Облигации.ПолучитьДоходностьИДюрацию(СтрокаПартииБумагиКлиента.ЦеннаяБумага, Истина, СтрокаПартииБумагиКлиента.ДатаПокупки, СтрокаПартииБумагиКлиента.ЦенаПокупки, СтрокаПартииБумагиКлиента.СчетДоверительногоУправления, БиржаММВБ); 
							СтрокаПартии.ДюрацияВГодах = Окр(ДанныеРасчета.Дюрация / 365, 5);
							
