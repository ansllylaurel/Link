			|		ПО _ВеличинаСредствПодУправлениемЗа2Года.Клиент = РеквизитыКлиентаФизЛица.ЮрФизЛицо
			|			И (РеквизитыКлиентаФизЛица.Организация = &Организация)
			|			И (РеквизитыКлиентаФизЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПИФ
			|		ПО ПИФ.Ссылка = _ВеличинаСредствПодУправлениемЗа2Года.Клиент
			|ГДЕ
			|	(НЕ &Скрывать_ОПИФ_ИПИФ_БПИФ
			|			ИЛИ ПИФ.Тип ЕСТЬ NULL
			|			ИЛИ НЕ ПИФ.Тип В (
			|				ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый),
			|				ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Интервальный),
			|				ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Биржевой)))			
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период9,
			|	СЧА9 УБЫВ
			|ИТОГИ ПО
			|	Период9");

		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Для Каждого ПараметрОтчета Из ПараметрыОтчета Цикл
			Запрос.УстановитьПараметр(ПараметрОтчета.Ключ, ПараметрОтчета.Значение);
		КонецЦикла;

		Запрос.УстановитьПараметр("Скрывать_ОПИФ_ИПИФ_БПИФ", Ложь);		
		
		СЧА10КрупнейшихКлиентов = Новый ТаблицаЗначений;
