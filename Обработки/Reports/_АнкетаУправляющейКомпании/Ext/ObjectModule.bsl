			|		И _ПартииОблигаций.ЦеннаяБумага = _ДетализацияАктивов.РасшифровкаАктива";
		
		Запрос.УстановитьПараметр("ПартииОблигаций", ПартииОблигаций);
		
		ВнешниеНаборыДанных.Вставить("СтруктураПортфеляПоИнструментам", Запрос.Выполнить().Выгрузить());
		
		СистемныеФункции.УдалитьТаблицыИзМенеджераВременныхТаблиц(МенеджерВременныхТаблиц, , ОбщиеВременныеТаблицы);
		
