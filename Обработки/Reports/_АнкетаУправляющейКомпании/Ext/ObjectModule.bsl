			|			И (ФинансовыеПоказатели.СубъектАналитики ССЫЛКА Справочник.СчетаДоверительногоУправления)
			|			И (ДатыРегистрацииСЧА.Период = _Последние2Года.КонецПериодаНачалоДня)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО (СчетаДоверительногоУправления.Ссылка = ФинансовыеПоказатели.СубъектАналитики)
			|			И (СчетаДоверительногоУправления.ДатаЗаключения <= _Последние2Года.КонецПериодаНачалоДня)
			|			И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > _Последние2Года.КонецПериодаНачалоДня)
			|			И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ОтчетнаяДатаКонецДня, ) КАК КлиентыДУ
			|		ПО (КлиентыДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
			|СГРУППИРОВАТЬ ПО
			|	КлиентыДУ.Клиент,
			|	_Последние2Года.КонецПериодаНачалоДня
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ВеличинаСредствПодУправлениемЗа2Года.Период КАК Период9,
			|	_ВеличинаСредствПодУправлениемЗа2Года.СЧА КАК СЧА9,
			|	ЕСТЬNULL(РеквизитыКлиентаЮрЛица.КраткоеНаименованиеПоУставу, ЕСТЬNULL(РеквизитыКлиентаФизЛица.Фамилия + "" "" + ПОДСТРОКА(РеквизитыКлиентаФизЛица.Имя, 1, 1) + "" "" + ПОДСТРОКА(РеквизитыКлиентаФизЛица.Отчество, 1, 1), _ВеличинаСредствПодУправлениемЗа2Года.Клиент)) КАК КраткоеНаименованиеПоУставу9,
			|	РеквизитыКлиентаЮрЛица.ОГРН КАК ОГРН9,
			|	_ВеличинаСредствПодУправлениемЗа2Года.ДатаРегистрацииСЧА КАК ДатаРегистрацииСЧА9,
			|	_ВеличинаСредствПодУправлениемЗа2Года.ЭтоСтароеСЧА КАК ЭтоСтароеСЧА9
			|ИЗ
			|	_ВеличинаСредствПодУправлениемЗа2Года КАК _ВеличинаСредствПодУправлениемЗа2Года
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(&ОтчетнаяДатаКонецДня, ) КАК РеквизитыКлиентаЮрЛица
			|		ПО _ВеличинаСредствПодУправлениемЗа2Года.Клиент = РеквизитыКлиентаЮрЛица.ЮрФизЛицо
