			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами)
			|			ТОГДА ""средства пенсионных резервов НПФ""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих)
			|			ТОГДА ""средства накоплений для жилищного обеспечения военнослужащих""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний)
			|			ТОГДА ""средства страховых резервов""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
			|				И КлиентыДУ.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды
			|				И ВЫРАЗИТЬ(КлиентыДУ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый), ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Интервальный))
			|			ТОГДА ""средства открытых и интервальных ПИФов""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
			|				И КлиентыДУ.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды
			|				И ВЫРАЗИТЬ(КлиентыДУ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды).Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый)
			|			ТОГДА ""средства ЗПИФов""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций)
			|			ТОГДА ""средства фондов СРО""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов)
			|			ТОГДА ""средства эндаумент-фондов""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный))
			|			ТОГДА ""средства корпоративных клиентов в ИДУ""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
			|			ТОГДА ""средства физических лиц в ИДУ""
			|	КОНЕЦ КАК Категория,
			|	ВЫБОР
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
			|			ТОГДА ""Средства пенсионных накоплений""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих)
			|			ТОГДА ""Средства накоплений для жилищного обеспечения военнослужащих""
			|		КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний)
			|			ТОГДА ""Средства страховых резервов""
			|		ИНАЧЕ ""Иные средства под управлением""
			|	КОНЕЦ КАК УкрупненнаяКатегория
			|ПОМЕСТИТЬ _КатегорииСчетовДУ
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ОтчетнаяДатаКонецДня, ) КАК КлиентыДУ
			|		ПО (КлиентыДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка)
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПаевойИнвестиционныйФонд.Ссылка КАК ПаевойИнвестиционныйФонд,
			|	ВЫБОР
			|		КОГДА ПаевойИнвестиционныйФонд.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Открытый), ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Интервальный))
			|			ТОГДА ""средства открытых и интервальных ПИФов""
			|		КОГДА ПаевойИнвестиционныйФонд.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыПифовВЗависимостиОтЛиквидности.Закрытый)
			|			ТОГДА ""средства ЗПИФов""
			|	КОНЕЦ КАК Категория
			|ПОМЕСТИТЬ _КатегорииПИФ
			|ИЗ
			|	Справочник.ПаевыеИнвестиционныеФонды КАК ПаевойИнвестиционныйФонд";
		
		#КонецОбласти
		
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",			ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ОтчетнаяДата",			ЭтотОбъект.ОтчетнаяДата);
	Запрос.УстановитьПараметр("ОтчетнаяДатаКонецДня",	КонецДня(ЭтотОбъект.ОтчетнаяДата));
	
	Запрос.Выполнить();

КонецПроцедуры

Процедура ПоместитьВременныеИнтервалыВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц) 
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, КВАРТАЛ, _Глубины.Значение), КВАРТАЛ) КАК НачалоПериода,
		|	КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, КВАРТАЛ, _Глубины.Значение), КВАРТАЛ) КАК КонецПериода,
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, КВАРТАЛ, _Глубины.Значение), КВАРТАЛ), ДЕНЬ) КАК КонецПериодаНачалоДня
		|ПОМЕСТИТЬ _Последние8Кварталов
		|ИЗ
		|	(ВЫБРАТЬ
		|		0 КАК Значение
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-1
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-2
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-3
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-4
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-5
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-6
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-7
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-8) КАК _Глубины
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, ГОД, _Глубины.Значение - 1) КАК НачалоПериода,
		|	ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, ГОД, _Глубины.Значение) КАК КонецПериода
		|ПОМЕСТИТЬ _Последние4Квартала
		|ИЗ
		|	(ВЫБРАТЬ
		|		0 КАК Значение
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-1) КАК _Глубины
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, ГОД, _Глубины.Значение), ДЕНЬ) КАК КонецПериода,
		|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&ОтчетнаяДата, ГОД, _Глубины.Значение), ДЕНЬ) КАК КонецПериодаНачалоДня
		|ПОМЕСТИТЬ _Последние2Года
		|ИЗ
		|	(ВЫБРАТЬ
		|		0 КАК Значение
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		-1) КАК _Глубины";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("ОтчетнаяДата", ЭтотОбъект.ОтчетнаяДата);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПоместитьСрезКлиентовПоПоследним8КварталамВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Последние8Кварталов.КонецПериодаНачалоДня КАК Период,
		|	КлиентыДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДУ.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентыСрезПоПоследним8Кварталам
		|ИЗ
		|	_Последние8Кварталов КАК _Последние8Кварталов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДУ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_Последние8Кварталов.КонецПериодаНачалоДня КАК Период,
		|				КлиентыДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|				МАКСИМУМ(КлиентыДУ.Период) КАК ДатаИзменения
		|			ИЗ
		|				_Последние8Кварталов КАК _Последние8Кварталов
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДУ
		|					ПО (КлиентыДУ.СчетДоверительногоУправления.Организация = &Организация)
		|						И (КлиентыДУ.Период <= _Последние8Кварталов.КонецПериодаНачалоДня)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_Последние8Кварталов.КонецПериодаНачалоДня,
		|				КлиентыДУ.СчетДоверительногоУправления) КАК ДатыИзменений
		|			ПО (ДатыИзменений.СчетДоверительногоУправления = КлиентыДУ.СчетДоверительногоУправления)
		|				И (ДатыИзменений.ДатаИзменения = КлиентыДУ.Период)
		|		ПО (ДатыИзменений.Период = _Последние8Кварталов.КонецПериодаНачалоДня)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ОтчетнаяДата", ЭтотОбъект.ОтчетнаяДата);
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПоместитьВознагражденияВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц)
	
	Если ЭтотОбъект.ОтчетнаяДата >= '20200101' Тогда
		
		ТаблицаВознаграждений = РаботаСВнешнимиСистемами.ПолучитьДанныеБухгалтерииОВознагражденииУК("Начисленное", НачалоГода(ДобавитьМесяц(ЭтотОбъект.ОтчетнаяДата, -24)), КонецДня(ЭтотОбъект.ОтчетнаяДата), ЭтотОбъект.Организация);
		
		СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаВознаграждений, "_ТаблицаВознаграждений", МенеджерВременныхТаблиц);
		
	Иначе
		
		#Область Уплаченное_вознаграждение
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДвиженияДС.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ) КАК Период,
			|	СУММА(ВЫБОР
			|			КОГДА ДвиженияДС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|				ТОГДА ДвиженияДС.Сумма
			|			ИНАЧЕ -ДвиженияДС.Сумма
			|		КОНЕЦ) КАК Сумма
			|ПОМЕСТИТЬ ВТ_ВознагражденияУК
			|ИЗ
			|	РегистрНакопления.ОстаткиДенежныхСредств КАК ДвиженияДС
			|ГДЕ
			|	ДвиженияДС.Организация = &Организация
			|	И ДвиженияДС.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
			|	И ДвиженияДС.Период МЕЖДУ &НачалоПериода И &КонецПериода
			|
			|СГРУППИРОВАТЬ ПО
			|	ДвиженияДС.СчетДоверительногоУправления,
			|	НАЧАЛОПЕРИОДА(ДвиженияДС.Период, ДЕНЬ);
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВТ_ВознагражденияУК.Период КАК Период,
			|	ВТ_ВознагражденияУК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВТ_ВознагражденияУК.Сумма КАК Сумма,
			|	КлиентыДУ.Клиент КАК Клиент
			|ПОМЕСТИТЬ _ТаблицаВознаграждений
			|ИЗ
			|	ВТ_ВознагражденияУК КАК ВТ_ВознагражденияУК
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДУ
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ВТ_ВознагражденияУК.Период КАК Период,
			|				ВТ_ВознагражденияУК.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|				МАКСИМУМ(КлиентыДУ.Период) КАК ДатаИзменения
			|			ИЗ
			|				ВТ_ВознагражденияУК КАК ВТ_ВознагражденияУК
			|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДУ
			|					ПО (КлиентыДУ.СчетДоверительногоУправления = ВТ_ВознагражденияУК.СчетДоверительногоУправления)
			|						И (КлиентыДУ.Период <= ВТ_ВознагражденияУК.Период)
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ВТ_ВознагражденияУК.Период,
			|				ВТ_ВознагражденияУК.СчетДоверительногоУправления) КАК ДатыИзменений
			|			ПО (ДатыИзменений.СчетДоверительногоУправления = КлиентыДУ.СчетДоверительногоУправления)
			|				И (ДатыИзменений.ДатаИзменения = КлиентыДУ.Период)
			|		ПО (КлиентыДУ.СчетДоверительногоУправления = ВТ_ВознагражденияУК.СчетДоверительногоУправления)
			|			И (ДатыИзменений.Период = ВТ_ВознагражденияУК.Период)";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("Организация",	ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("НачалоПериода",	НачалоГода(ДобавитьМесяц(ЭтотОбъект.ОтчетнаяДата, -24))); // 8 кварталов
		Запрос.УстановитьПараметр("КонецПериода",	КонецДня(ЭтотОбъект.ОтчетнаяДата));
		
		Запрос.Выполнить();
			
		#КонецОбласти	
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура УстановитьПредставлениеОтбора(ИмяРаздела, Представление = Неопределено)  
	
	Для Каждого ЭлементСтруктуры Из КомпоновщикНастроек.Настройки.Структура Цикл
		
		Если ЭлементСтруктуры.Имя = ИмяРаздела Тогда
			
			ИскомыйПараметр			= Новый ПолеКомпоновкиДанных("ПараметрыДанных.Пустышка");
			НайденныйЭлементОтбора	= Неопределено;
			
			ЭлементыОтбора = ?(ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных"), ЭлементСтруктуры.Строки[0].Отбор.Элементы, ЭлементСтруктуры.Отбор.Элементы);  
			Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
				Для Каждого ПараметрВывода Из ЭлементСтруктуры.ПараметрыВывода.Элементы Цикл
					Если ПараметрВывода.Параметр = Новый ПараметрКомпоновкиДанных("Заголовок") Тогда
						Если Представление = Неопределено Тогда
							ПараметрВывода.Значение = ПолучитьЗаголовокРазделаПоУмолчанию(ИмяРаздела);
						Иначе
							ПараметрВывода.Значение = ПолучитьЗаголовокРазделаПоУмолчанию(ИмяРаздела) + " (отбор: " + Представление + ")";
						КонецЕсли;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Возврат;
			КонецЕсли;
			
			Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
				Если ЭлементОтбора.ЛевоеЗначение = ИскомыйПараметр Тогда
					НайденныйЭлементОтбора = ЭлементОтбора;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Представление <> Неопределено Тогда
				
				ЭлементОтбора = ?(НайденныйЭлементОтбора = Неопределено, ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")), НайденныйЭлементОтбора);
				ЭлементОтбора.ЛевоеЗначение	= ИскомыйПараметр;
				ЭлементОтбора.ВидСравнения	= ВидСравненияКомпоновкиДанных.Заполнено;
				ЭлементОтбора.Представление = Представление;
				
			ИначеЕсли НайденныйЭлементОтбора <> Неопределено Тогда
				
				ЭлементСтруктуры.Отбор.Элементы.Удалить(НайденныйЭлементОтбора);	
				
			КонецЕсли;	
				
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьЗаголовокРазделаПоУмолчанию(ИмяРаздела)
	
	Для Каждого ЭлементСтруктуры Из СхемаКомпоновкиДанных.НастройкиПоУмолчанию.Структура Цикл	
	
		Для Каждого ПараметрВывода Из ЭлементСтруктуры.ПараметрыВывода.Элементы Цикл
			Если ПараметрВывода.Параметр = Новый ПараметрКомпоновкиДанных("Заголовок") Тогда
				Возврат ПараметрВывода.Значение;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;
	
	Возврат "";	
	
КонецФункции

Функция ПолучитьСЧАИзМакета(ИменаМакетов)
	
	ФинансовыеПоказатели = Новый ТаблицаЗначений;
	ФинансовыеПоказатели.Колонки.Добавить("Период", Метаданные.РегистрыСведений.ФинансовыеПоказатели.СтандартныеРеквизиты.Период.Тип);
	ФинансовыеПоказатели.Колонки.Добавить("Организация", Метаданные.РегистрыСведений.ФинансовыеПоказатели.Измерения.Организация.Тип);
	ФинансовыеПоказатели.Колонки.Добавить("СубъектАналитики", Метаданные.РегистрыСведений.ФинансовыеПоказатели.Измерения.СубъектАналитики.Тип);
	ФинансовыеПоказатели.Колонки.Добавить("ВидПоказателя", Метаданные.РегистрыСведений.ФинансовыеПоказатели.Измерения.ВидПоказателя.Тип);
	ФинансовыеПоказатели.Колонки.Добавить("Значение", Метаданные.РегистрыСведений.ФинансовыеПоказатели.Ресурсы.Значение.Тип);
	
	Ошибки = Новый Массив;
	ПроверятьДанныеНаДубли = Ложь;
	
	СтруктураИмен = Новый Структура(ИменаМакетов);
	Для Каждого Макет Из СтруктураИмен Цикл  	
	
		ДанныеМакета = ПолучитьМакет(Макет.Ключ);

		СериализованныеДанные = Новый ТаблицаЗначений;
		СериализованныеДанные.Колонки.Добавить("Период",     Новый ОписаниеТипов("Дата"));
		СериализованныеДанные.Колонки.Добавить("КодСчетаДУ", Метаданные.Справочники.СчетаДоверительногоУправления.Реквизиты.КодСчета.Тип);
		СериализованныеДанные.Колонки.Добавить("Количество", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СериализованныеДанные.Колонки.Добавить("Сумма",      Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);

		Для НомСтр = 1 По ДанныеМакета.ВысотаТаблицы Цикл
			СуммаМакет	= СтрЗаменить(ДанныеМакета.Область(НомСтр, 4).Текст, " ", "");
			ДатаМакет	= ДанныеМакета.Область(НомСтр, 5).Текст;	
			
			Если Не ЗначениеЗаполнено(СуммаМакет)
				ИЛИ Не ЗначениеЗаполнено(ДатаМакет)
			Тогда
				Продолжить;
			КонецЕсли;
			
			СуммаМакет = Число(СуммаМакет);
			Если СуммаМакет = 0 Тогда
				Продолжить;	
			КонецЕсли;
			
			СтрокаСериализованныеДанные = СериализованныеДанные.Добавить();
			СтрокаСериализованныеДанные.Период     = Дата(Лев(ДатаМакет, 6) + "20" + Сред(ДатаМакет, "7") + " 00:00:00"); //РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ДанныеМакета.Область(НомСтр, 5).Текст);
			СтрокаСериализованныеДанные.КодСчетаДУ = ДанныеМакета.Область(НомСтр, 2).Текст;
			СтрокаСериализованныеДанные.Сумма      = СуммаМакет;
		КонецЦикла;

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СериализованныеДанные.Период КАК Период,
			|	СериализованныеДанные.КодСчетаДУ КАК КодСчетаДУ,
			|	СериализованныеДанные.Количество КАК Количество,
			|	СериализованныеДанные.Сумма КАК Сумма
			|ПОМЕСТИТЬ _СериализованныеДанные
			|ИЗ
			|	&СериализованныеДанные КАК СериализованныеДанные
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ПИФ,
			|	_СериализованныеДанные.Период КАК Период,
			|	_СериализованныеДанные.Сумма КАК Сумма,
			|	_СериализованныеДанные.КодСчетаДУ КАК КодСчетаДУ,
			|	ФинансовыеПоказатели.Значение КАК ЗарегистрированноеСЧА
			|ИЗ
			|	_СериализованныеДанные КАК _СериализованныеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ПО СчетаДоверительногоУправления.Организация = &Организация
			|			И _СериализованныеДанные.КодСчетаДУ = СчетаДоверительногоУправления.КодСчета
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(, ) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО (СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
			|		ПО ФинансовыеПоказатели.Организация = СчетаДоверительногоУправления.Организация
			|			И ФинансовыеПоказатели.СубъектАналитики = СчетаДоверительногоУправления.Ссылка
			|			И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок) 
			|			И ФинансовыеПоказатели.Период = _СериализованныеДанные.Период
			|ГДЕ
			|	ФинансовыеПоказатели.Период ЕСТЬ NULL";

		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("СериализованныеДанные", СериализованныеДанные);
			
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.СчетДоверительногоУправления = NULL Тогда
				//Если ЗначениеЗаполнено(Выборка.КодСчетаДУ) Тогда
				//	ВывестиОшибку("Не найден клиент с кодом '" + Выборка.КодСчетаДУ + "'", Ошибки);
				//КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Выборка.Сумма) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ПроверятьДанныеНаДубли И ФинансовыеПоказатели.НайтиСтроки(Новый Структура("СубъектАналитики, Период", Выборка.СчетДоверительногоУправления, Выборка.Период)).Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Запись = ФинансовыеПоказатели.Добавить();
			Запись.Период           = Выборка.Период;
			Запись.Организация      = Выборка.Организация;
			Запись.СубъектАналитики = Выборка.СчетДоверительногоУправления;
			Запись.ВидПоказателя    = Справочники.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок;
			Запись.Значение         = Выборка.Сумма;

		КонецЦикла;

		Если СтруктураИмен.Количество() > 1 И ПроверятьДанныеНаДубли = Ложь Тогда
			ФинансовыеПоказатели.Индексы.Добавить("СубъектАналитики, Период");
			ПроверятьДанныеНаДубли = Истина;
		КонецЕсли;

	КонецЦикла;
	
	Возврат ФинансовыеПоказатели; 	
	
КонецФункции

Процедура ВывестиОшибку(ТекстОшибки, Ошибки)
	Если Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		Сообщить(ТекстОшибки);
		Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти