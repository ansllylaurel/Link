			|					ГДЕ
			|						_ДействующиеСчетаДУ.СпецДеп = ЗНАЧЕНИЕ(Справочник.ДепозитарныеКомпании.ПустаяСсылка))) КАК ОстаткиЦенныхБумаг
			|ГДЕ
			|	ОстаткиЦенныхБумаг.ДепозитарныйСчет.Депозитарий <> ЗНАЧЕНИЕ(Справочник.ДепозитарныеКомпании.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	ОстаткиЦенныхБумаг.ДепозитарныйСчет.Депозитарий,
			|	ОстаткиЦенныхБумаг.СчетДоверительногоУправления
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Исполнители.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	Исполнители.ДепозитарныйСчет.Депозитарий КАК Депозитарий
			|ПОМЕСТИТЬ _ДепозитарииИзИсполнителей
			|ИЗ
			|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК Исполнители
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДействующиеСчетаДУ КАК _ДействующиеСчетаДУ
			|		ПО (_ДействующиеСчетаДУ.СчетДоверительногоУправления = Исполнители.СчетДоверительногоУправления)
			|			И (Исполнители.Организация = &Организация)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ОтчетнаяДата, ) КАК УсловияДоговоровОбщиеСрезПоследних
			|			ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = Исполнители.ДепозитарныйСчет.Договор)
			|ГДЕ
			|	(Исполнители.ДатаЗакрытия > &ОтчетнаяДата
			|			ИЛИ Исполнители.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
			|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
			|		ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ОтчетнаяДата)
			|	И (Исполнители.ДепозитарныйСчет.Договор.ДатаЗаключения <= &ОтчетнаяДата
			|			ИЛИ Исполнители.ДепозитарныйСчет.Договор.ДатаЗаключения = ДАТАВРЕМЯ(1, 1, 1))
