			|						И (ФинансовыеПоказатели.Организация = &Организация)
			|						И (ФинансовыеПоказатели.Период <= &ОтчетнаяДата)
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ФинансовыеПоказатели.СубъектАналитики) КАК ДатыРегистрацииСЧА
			|			ПО (ДатыРегистрацииСЧА.СубъектАналитики = ФинансовыеПоказатели.СубъектАналитики)
			|				И (ДатыРегистрацииСЧА.ДатаРегистрации = ФинансовыеПоказатели.Период)
			|		ПО (ФинансовыеПоказатели.СубъектАналитики = _ДепозитарииИСпецДепозитарииСчетовДУ.СчетДоверительногоУправления)
			|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
			|			И (ФинансовыеПоказатели.Организация = &Организация)
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&ОтчетнаяДатаКонецДня, ) КАК РеквизитыЮрЛица
			|		ПО (РеквизитыЮрЛица.ЮрФизЛицо = _ДепозитарииИСпецДепозитарииСчетовДУ.Депозитарий.ЮрФизЛицо)
			|			И (РеквизитыЮрЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
