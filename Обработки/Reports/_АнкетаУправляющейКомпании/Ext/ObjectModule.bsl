		СЧА10КрупнейшихКлиентов.Колонки.Добавить("СЧА9", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("КраткоеНаименованиеПоУставу9", Новый ОписаниеТипов("Строка"));
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("ОГРН9", Новый ОписаниеТипов("Строка"));
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("НаправлениеДУ9", Новый ОписаниеТипов("Строка"));
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("НомерВГруппе9", Новый ОписаниеТипов("Число"));
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("СчетДУ9", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("ДатаРегистрацииСЧА9", Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.Дата)));
		СЧА10КрупнейшихКлиентов.Колонки.Добавить("ЭтоСтароеСЧА9", Новый ОписаниеТипов("Булево"));

		ВыборкаПоДате = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоДате.Следующий() Цикл
			НомерВГруппе = 0;
			
			ВыборкаПоКлиенту = ВыборкаПоДате.Выбрать(ОбходРезультатаЗапроса.Прямой);
			Пока ВыборкаПоКлиенту.Следующий() Цикл
				НомерВГруппе = НомерВГруппе + 1;
				
				НоваяСтрока = СЧА10КрупнейшихКлиентов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоКлиенту);
				НоваяСтрока.НомерВГруппе9 = НомерВГруппе;
				
				// СЧА10КрупнейшихКлиентов
