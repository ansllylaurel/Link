	#КонецОбласти	
	
	#Область Итоговый_запрос_динамики_СЧА	

	Если ВключенныеОтчеты.Получить("ДинамикаСЧАПортфелей") = Истина Тогда

		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДанныеСЧА77.Период КАК Период,
