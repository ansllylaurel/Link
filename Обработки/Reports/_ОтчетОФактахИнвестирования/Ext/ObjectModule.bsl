// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Отчет о фактах инвестирования ",
		"0.24",
		"",
		Истина);
	
	// Команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
КонецФункции

Процедура Сформировать(Результат, СоответствиеИННКлиентов) Экспорт
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "НачалоПериода,КонецПериода,Организация,СчетДоверительногоУправления");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".Сформировать()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Результат.Очистить();
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ВыводитьЦенныеБумаги = (ЭтотОбъект.КонецПериода < Дата("20210531"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("НачалоПериода"				, ЭтотОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода"				, ЭтотОбъект.КонецПериода);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Организация"					, ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ВидУчета"					, ?(БухгалтерскийУчет.ВедетсяУчетЕПС(ЭтотОбъект.КонецПериода, ЭтотОбъект.Организация, ЭтотОбъект.СчетДоверительногоУправления), Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, Перечисления.ВидыУчета.БухгалтерскийУчет));
	Запрос.УстановитьПараметр("ВыводитьЦенныеБумаги"		, ВыводитьЦенныеБумаги);
	
	#Область Реквизиты_шапки
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК ЮрФизЛицоКлиента,
		|	КлиентыДоверительногоУправленияСрезПоследних.Организация.ЮрФизЛицо КАК ЮрФизЛицоОрганизации,
		|	КлиентыДоверительногоУправленияСрезПоследних.Организация КАК Организация
		|ПОМЕСТИТЬ _ЮрФизЛица
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеквизитыКлиента.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеКлиента,
		|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеОрганизации,
		|	РеквизитыОрганизации.ЮридическийАдрес КАК ЮридическийАдрес,
		|	РеквизитыОрганизации.МестоНахождения КАК МестоНахождения,
		|	РеквизитыОрганизации.ПочтовыйАдрес КАК ПочтовыйАдрес,
		|	РеквизитыОрганизации.Телефоны КАК Телефоны,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	РеквизитыКлиента.ИНН КАК ИННКлиента
		|ПОМЕСТИТЬ _РеквизитыШапки
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И (Организация, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						_ЮрФизЛица.Организация КАК Организация,
		|						_ЮрФизЛица.ЮрФизЛицоОрганизации КАК ЮрФизЛицоОрганизации
		|					ИЗ
		|						_ЮрФизЛица КАК _ЮрФизЛица)) КАК РеквизитыОрганизации,
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&КонецПериода,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И (Организация, ЮрФизЛицо) В
		|					(ВЫБРАТЬ
		|						_ЮрФизЛица.Организация КАК Организация,
		|						_ЮрФизЛица.ЮрФизЛицоКлиента КАК ЮрФизЛицоКлиента
		|					ИЗ
		|						_ЮрФизЛица КАК _ЮрФизЛица)) КАК РеквизитыКлиента,
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &СчетДоверительногоУправления";
	#КонецОбласти
	Запрос.Выполнить();
		
	ТаблицаРеквизитовШапки = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_РеквизитыШапки").Выгрузить();
	
	Если ТаблицаРеквизитовШапки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные по выбранному счету доверительного управления");
		Возврат;
	КонецЕсли;
	
	РеквизитыШапки = ТаблицаРеквизитовШапки[0];
	
	#КонецОбласти
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент КАК ДепозитныйВклад,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.Период КАК ДатаРазмещения,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.СуммаПриход КАК СтоимостьОбъекта,
		|	МАКСИМУМ(УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий) КАК ПериодПроцентов
		|ПОМЕСТИТЬ ВТДепозиты1
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Организация = &Организация
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ) КАК УсловияКредитныхИнструментов
		|		ПО ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент = УсловияКредитныхИнструментов.КредитныйИнструмент
		|			И (УсловияКредитныхИнструментов.Процент <> 0)
		|			И (УсловияКредитныхИнструментов.Действует)
		|			И (ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.ВыводКредитногоИнструмента
		|					И РАЗНОСТЬДАТ(УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий, ДенежныеСредстваВКредитныхИнструментахОбороты.Период, ДЕНЬ) > 0
		|				ИЛИ ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.РазмещениеКредитногоИнструмента
		|					И РАЗНОСТЬДАТ(УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий, ДенежныеСредстваВКредитныхИнструментахОбороты.Период, ДЕНЬ) >= -1)
		|ГДЕ
		|	(ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.ВыводКредитногоИнструмента
		|			ИЛИ ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор ССЫЛКА Документ.РазмещениеКредитногоИнструмента)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.Период,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.КредитныйИнструмент,
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.СуммаПриход
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТДепозиты.ДепозитныйВклад КАК ДепозитныйВклад,
		|	ВТДепозиты.ДатаРазмещения КАК ДатаРазмещения,
		|	ВТДепозиты.СтоимостьОбъекта КАК СтоимостьОбъекта,
		|	УсловияКредитныхИнструментов.Процент КАК Ставка,
		|	УсловияКредитныхИнструментов.ДатаПогашения КАК ДатаПогашения
		|ПОМЕСТИТЬ ВТДепозиты2
		|ИЗ
		|	ВТДепозиты1 КАК ВТДепозиты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияКредитныхИнструментов.СрезПоследних(&КонецПериода, ) КАК УсловияКредитныхИнструментов
		|		ПО ВТДепозиты.ДепозитныйВклад = УсловияКредитныхИнструментов.КредитныйИнструмент
		|			И ВТДепозиты.ПериодПроцентов = УсловияКредитныхИнструментов.ДатаНачалаДействияУсловий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Отбор.ДепозитныйВклад КАК ДепозитныйВклад,
		|	СредневзвешенныеПроцентныеСтавки.НачалоРасчетногоМесяца КАК НачалоРасчетногоМесяца,
		|	СредневзвешенныеПроцентныеСтавки.Вид КАК Вид,
		|	СредневзвешенныеПроцентныеСтавки.ГруппаБанков КАК ГруппаБанков,
		|	СредневзвешенныеПроцентныеСтавки.ВидШкалы КАК ВидШкалы,
		|	СредневзвешенныеПроцентныеСтавки.ИнтервалШкалы КАК ИнтервалШкалы,
		|	СредневзвешенныеПроцентныеСтавки.Валюта КАК Валюта,
		|	СредневзвешенныеПроцентныеСтавки.ПроцентнаяСтавка КАК ПроцентнаяСтавка
		|ПОМЕСТИТЬ _ДействующиеСредневзвешенныеСтавки
		|ИЗ
		|	РегистрСведений.СредневзвешенныеПроцентныеСтавки КАК СредневзвешенныеПроцентныеСтавки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТДепозиты2.ДепозитныйВклад КАК ДепозитныйВклад,
		|			СредневзвешенныеПроцентныеСтавки.Вид КАК Вид,
		|			СредневзвешенныеПроцентныеСтавки.ГруппаБанков КАК ГруппаБанков,
		|			СредневзвешенныеПроцентныеСтавки.ВидШкалы КАК ВидШкалы,
		|			СредневзвешенныеПроцентныеСтавки.ИнтервалШкалы КАК ИнтервалШкалы,
		|			СредневзвешенныеПроцентныеСтавки.Валюта КАК Валюта,
		|			СредневзвешенныеПроцентныеСтавки.НачалоРасчетногоМесяца КАК НачалоРасчетногоМесяца,
		|			МАКСИМУМ(СредневзвешенныеПроцентныеСтавки.Период) КАК Период
		|		ИЗ
		|			ВТДепозиты2 КАК ВТДепозиты2
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СредневзвешенныеПроцентныеСтавки КАК СредневзвешенныеПроцентныеСтавки
		|				ПО ВТДепозиты2.ДатаРазмещения >= СредневзвешенныеПроцентныеСтавки.НачалоРасчетногоМесяца
		|					И ВТДепозиты2.ДатаРазмещения >= СредневзвешенныеПроцентныеСтавки.Период
		|					И (СредневзвешенныеПроцентныеСтавки.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыСредневзвешенныхСтавок.ПоДепозитамНФО))
		|					И (СредневзвешенныеПроцентныеСтавки.ГруппаБанков = ЗНАЧЕНИЕ(Перечисление.ГруппыБанковДляПолученияРыночнойПроцентнойСтавки.ВсеБанкиРФ))
		|					И (СредневзвешенныеПроцентныеСтавки.ВидШкалы = ЗНАЧЕНИЕ(Перечисление.ВидыШкалСредневзвешенныхПроцентныхСтавковПоДепозитам.Развернутая))
		|					И (СредневзвешенныеПроцентныеСтавки.ИнтервалШкалы = ВЫБОР
		|						КОГДА РАЗНОСТЬДАТ(ВТДепозиты2.ДатаРазмещения, ВТДепозиты2.ДатаПогашения, ДЕНЬ) <= 30
		|								ИЛИ ВТДепозиты2.ДепозитныйВклад.ДоВостребования
		|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.До30ДнейВключаяДоВостребования)
		|						КОГДА РАЗНОСТЬДАТ(ВТДепозиты2.ДатаРазмещения, ВТДепозиты2.ДатаПогашения, ДЕНЬ) <= 90
		|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От31До90Дней)
		|						КОГДА РАЗНОСТЬДАТ(ВТДепозиты2.ДатаРазмещения, ВТДепозиты2.ДатаПогашения, ДЕНЬ) <= 180
		|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От91До180Дней)
		|						КОГДА ДОБАВИТЬКДАТЕ(ВТДепозиты2.ДатаРазмещения, ГОД, 1) >= ВТДепозиты2.ДатаПогашения
		|							ТОГДА ЗНАЧЕНИЕ(Перечисление.ИнтервалыШкалСредневзвешенныхПроцентныхСтавокПоДепозитам.От181ДняДо1Года)
		|						КОГДА ДОБАВИТЬКДАТЕ(ВТДепозиты2.ДатаРазмещения, ГОД, 3) >= ВТДепозиты2.ДатаПогашения
