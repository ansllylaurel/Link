		|	ВТ_Отчет2.РыночнаяЦена КАК РыночнаяЦена
		|ПОМЕСТИТЬ _ТаблицаОтчета
		|ИЗ
		|	ВТ_Отчет2 КАК ВТ_Отчет2
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|		ПО ВТ_Отчет2.Эмитент = РеквизитыЮридическихЛиц.ЮрФизЛицо
		|			И (РеквизитыЮридическихЛиц.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|			И (РеквизитыЮридическихЛиц.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|			И ВТ_Отчет2.ПериодРеквизитов = РеквизитыЮридическихЛиц.Период
		|ГДЕ
		|	(РеквизитыЮридическихЛиц.ИНН ЕСТЬ NULL
		|			ИЛИ РеквизитыЮридическихЛиц.ИНН В (&МассивИННЭмитентов)
		|			ИЛИ РеквизитыЮридическихЛиц.ИНН = """")";
	#КонецОбласти
	
	МассивИННЭмитентов = Новый Массив;
	ДатаСоответствия = Дата(1, 1, 1);
	
	Если СоответствиеИННКлиентов.Получить(РеквизитыШапки.ИННКлиента) <> Неопределено Тогда
		СоответствиеДат = СоответствиеИННКлиентов.Получить(РеквизитыШапки.ИННКлиента);
		Для Каждого Элемент Из СоответствиеДат Цикл
			Если Элемент.Ключ <= КонецПериода Тогда
				ДатаСоответствия = Макс(ДатаСоответствия, Элемент.Ключ);
			КонецЕсли;
		КонецЦикла;
		
		Если ДатаСоответствия <> Дата(1, 1, 1) Тогда
			МассивИННЭмитентов = СоответствиеДат.Получить(ДатаСоответствия);
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивИННЭмитентов", МассивИННЭмитентов);
	Запрос.УстановитьПараметр("ОсновнаяБиражаДляКотировок", Константы.ОсновнаяБиржаДляКотировок.Получить());
	
	Запрос.Выполнить();
	
	Макет = ПолучитьМакет("МакетОтчета");
	
	ОбластьШапка			= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрокаДепозиты	= Макет.ПолучитьОбласть("СтрокаДепозиты");
	ОбластьСтрокаЦБ			= Макет.ПолучитьОбласть("СтрокаЦБ");
	
	ОбластьШапка.Параметры.Заполнить(РеквизитыШапки);
	ОбластьШапка.Параметры.ДатаЗаключения = Формат(РеквизитыШапки.ДатаЗаключения, "ДФ=dd.MM.yyyy");
	
	Результат.Вывести(ОбластьШапка);
	
	ТаблицаОтчета = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ТаблицаОтчета").Выгрузить();
	
	Для Каждого СтрокаОтчета Из ТаблицаОтчета Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаОтчета.Эмитент) Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СтрокаОтчета.ВидАктива + " " + СокрЛП(СтрокаОтчета.НаименованиеОбъекта) + " не указан эмитент");
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаОтчета.ИННЭмитента) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У эмитента """ + СокрЛП(СтрокаОтчета.Эмитент) + """ не указан ИНН!");
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаОтчета.РыночнаяЦена) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У " + СтрокаОтчета.ВидАктива + " " + СокрЛП(СтрокаОтчета.НаименованиеОбъекта) + " отсутствует " + ?(СтрокаОтчета.ВидАктива = "Депозит", "средняя рыночная ставка!", " рыночная цена"));
		КонецЕсли;
		
	КонецЦикла;
	
	#Область Депозиты
	
	ТаблицаДепозиты = ТаблицаОтчета.НайтиСтроки(Новый Структура("ВидАктива", "Депозит"));
	
	Результат.Вывести(Макет.ПолучитьОбласть("ШапкаДепозиты"));
	Для Каждого СтрокаДепозиты Из ТаблицаДепозиты Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаДепозиты.Параметры, СтрокаДепозиты);
		Результат.Вывести(ОбластьСтрокаДепозиты);
	КонецЦикла;
	
	Результат.Вывести(Макет.ПолучитьОбласть("ПодвалДепозиты"));
	
	#КонецОбласти	
	
	#Область Ценные_бумаги
	
	Если ВыводитьЦенныеБумаги Тогда
		ТаблицаЦБ = ТаблицаОтчета.НайтиСтроки(Новый Структура("ВидАктива", "ЦБ"));
		Результат.Вывести(Макет.ПолучитьОбласть("ШапкаЦБ"));
		Для Каждого СтрокаЦБ Из ТаблицаЦБ Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаЦБ.Параметры, СтрокаЦБ);
			Результат.Вывести(ОбластьСтрокаЦБ);
		КонецЦикла;
	КонецЕсли;
	
	#КонецОбласти
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПодвал.Параметры.Подписант = ЭтотОбъект.Подписант.КонтактноеЛицо;
	ОбластьПодвал.Параметры.ДолжностьПодписанта = ЭтотОбъект.Подписант.Должность;
	
	Результат.Вывести(ОбластьПодвал);
	
	// Заполняем настройки печати	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(Результат, ЭтотОбъект.Метаданные().ПолноеИмя());
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры
