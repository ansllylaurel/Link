									КонецЕсли;	
								КонецЦикла;	
								
							КонецЕсли;
							
						КонецЦикла;	
						
					КонецЦикла;					
					// NVP 
					СписокЗаголовков_npvPoint = Заголовок_trade.ПолучитьЭлементыПоИмени("npvPoint");
					
					Для Каждого Заголовок_npvPoint Из СписокЗаголовков_npvPoint Цикл
						
						ДатаNPV = Дата(1,1,1);
