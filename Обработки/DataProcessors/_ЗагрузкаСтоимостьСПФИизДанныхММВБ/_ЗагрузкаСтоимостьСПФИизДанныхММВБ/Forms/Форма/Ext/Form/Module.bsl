					КонецЦикла;
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;		
		
		ДанныеФайла.Свернуть("НомерСделки, НаименованиеВалюты, ДатаNPV, СтавкаВходящихПлатежей, СтавкаИсходящихПлатежей, ПериодичностьВходящихПлатежей", "СуммаNPV, ДебиторскаяЗадолженность, КредиторскаяЗадолженность");
			
		
	ИначеЕсли НомерСессии = "2" Тогда
		
		ДанныеФайла = Новый Структура;
