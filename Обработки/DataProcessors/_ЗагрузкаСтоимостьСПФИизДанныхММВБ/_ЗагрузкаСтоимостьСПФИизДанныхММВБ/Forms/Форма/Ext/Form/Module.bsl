									ДатаПотокаСтрокой = УзелЗаголовок_paymentCalculationPeriod.ТекстовоеСодержимое;
									
									Попытка 
										ДатаПотока = Дата(СтрЗаменить(ДатаПотокаСтрокой,"-",""));
									Исключение
										
									КонецПопытки;	
								КонецЕсли;
							КонецЦикла;	
							
							Если ДатаПотока > ДатаТорговая тогда
								
								СписокЗаголовков_forecastPaymentAmount = Заголовок_paymentCalculationPeriod.ПолучитьЭлементыПоИмени("forecastPaymentAmount");
								
								Для Каждого Заголовок_forecastPaymentAmount Из СписокЗаголовков_forecastPaymentAmount Цикл
									НаименованиеВалюты = "";
									Задолженность = 0;
									Для Каждого УзелЗаголовок_forecastPaymentAmount Из Заголовок_forecastPaymentAmount.ДочерниеУзлы Цикл
										Если Нрег(УзелЗаголовок_forecastPaymentAmount.ИмяУзла) = "currency" Тогда
											НаименованиеВалюты = УзелЗаголовок_forecastPaymentAmount.ТекстовоеСодержимое;	
										ИначеЕсли Нрег(УзелЗаголовок_forecastPaymentAmount.ИмяУзла) = "amount" Тогда
											СуммаСтрокой = СтрЗаменить(УзелЗаголовок_forecastPaymentAmount.ТекстовоеСодержимое, ".", ",");
											
											Попытка 
												Задолженность = Число(СуммаСтрокой);
											Исключение
												
											КонецПопытки;	
										КонецЕсли;
									КонецЦикла;	
									
									Если ЗначениеЗаполнено(Плательщик) И ЗначениеЗаполнено(ДатаТорговая) И ЗначениеЗаполнено(Задолженность) Тогда
										НоваяСтрокаДанныеФайла = ДанныеФайла.Добавить();
										НоваяСтрокаДанныеФайла.НомерСделки = НомерСделки;
										НоваяСтрокаДанныеФайла.НаименованиеВалюты = НаименованиеВалюты;
										НоваяСтрокаДанныеФайла.ДатаNPV = ДатаТорговая;
										
										Если ВРЕГ(Плательщик) = "NCCB" Тогда
											НоваяСтрокаДанныеФайла.ДебиторскаяЗадолженность = Задолженность;
										Иначе
											НоваяСтрокаДанныеФайла.КредиторскаяЗадолженность = Задолженность;
										КонецЕсли;	
									КонецЕсли;	
								КонецЦикла;	
								
								СписокЗаголовков_calculationPeriod = Заголовок_paymentCalculationPeriod.ПолучитьЭлементыПоИмени("calculationPeriod");
								
								Для Каждого Заголовок_calculationPeriod Из СписокЗаголовков_calculationPeriod Цикл
									СтавкаФиксированнная = 0;
									Для Каждого УзелЗаголовок_calculationPeriod Из Заголовок_calculationPeriod.ДочерниеУзлы Цикл
										Если Нрег(УзелЗаголовок_calculationPeriod.ИмяУзла) = "fixedrate" Тогда
											СтавкаСтрокой = СтрЗаменить(УзелЗаголовок_calculationPeriod.ТекстовоеСодержимое, ".", ",");
											
											Попытка 
												СтавкаФиксированнная = Число(СтавкаСтрокой);
											Исключение
												
											КонецПопытки;	
										КонецЕсли;
									КонецЦикла;	
									
									Если ЗначениеЗаполнено(СтавкаФиксированнная) Тогда
										Если ВРЕГ(Плательщик) = "NCCB" Тогда
											СтавкаВходящихПлатежей = СтавкаФиксированнная*100;
										Иначе
											СтавкаИсходящихПлатежей = СтавкаФиксированнная*100;
