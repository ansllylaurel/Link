&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	//ДиалогВыбораФайла.Фильтр = "XML-файл (*.xml)|*.xml"; 
	ДиалогВыбораФайла.Каталог            = Объект.ИмяФайла;
	ДиалогВыбораФайла.Заголовок = "Выберите каталог с архивом файлов";
	ДиалогВыбораФайла.ПредварительныйПросмотр = Истина;
	ДиалогВыбораФайла.ИндексФильтра = 0;
	Если ДиалогВыбораФайла.Выбрать() Тогда
		Объект.ИмяФайла = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("Сформировать");
	ВыполнитьСформировать(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСформировать(ПараметрыСессии)
	
	ФайлыКаталога = НайтиФайлы(Объект.ИмяФайла, "Reports*.zip", Истина);
	
	ВременныйКаталог = КаталогВременныхФайлов() + "tempSPFI";
	СоздатьКаталог(ВременныйКаталог);
	УдалитьФайлыВКаталоге(ВременныйКаталог, "*.*");
	
	Для Каждого Файл Из ФайлыКаталога Цикл
		
		Попытка
			ZIPАрхив = Новый ЧтениеZipФайла(Файл.ПолноеИмя);	
		Исключение
			ТекстОшибки = НСтр("ru ='Не удалось открыть файл '" + Файл.Имя + "'. Загрузка не произведена");
			ТекстОшибки = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
		Попытка
			ZIPАрхив.ИзвлечьВсе(ВременныйКаталог);
		Исключение
			ТекстОшибки = НСтр("ru ='Не удалось распаковать файл '" + Файл.Имя + "'. Загрузка не произведена");
			ТекстОшибки = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;	
			
	КонецЦикла;
	
	// При загрузке из личного кабинета Zip в Zip'е поэтому попытаемся еще раз его распаковать
	ФайлыКаталогаПоискВложенногоZIP = НайтиФайлы(ВременныйКаталог, "Reports*.zip", Истина);
	
	Для Каждого ФайлВложенногоZIP Из ФайлыКаталогаПоискВложенногоZIP Цикл
		
		Попытка
			ZIPАрхив = Новый ЧтениеZipФайла(ФайлВложенногоZIP.ПолноеИмя);	
		Исключение
			ТекстОшибки = НСтр("ru ='Не удалось открыть файл '" + ФайлВложенногоZIP.Имя + "'. Загрузка не произведена");
			ТекстОшибки = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
		Попытка
			ZIPАрхив.ИзвлечьВсе(ВременныйКаталог);
		Исключение
			ТекстОшибки = НСтр("ru ='Не удалось распаковать файл '" + ФайлВложенногоZIP.Имя + "'. Загрузка не произведена");
			ТекстОшибки = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;	
		
	КонецЦикла;
	
	
	ФайлыВременногоКаталога = НайтиФайлы(ВременныйКаталог, "*.xml", Истина);
	
	ФайлыВременногоКаталогаСписок = Новый СписокЗначений;
	ФайлыВременногоКаталогаСписок.ЗагрузитьЗначения(ФайлыВременногоКаталога);
	
	Для Каждого ФайлВременногоКаталогаЭлементСписка Из ФайлыВременногоКаталогаСписок Цикл
		
		ФайлВременногоКаталогаЭлементСписка.Представление = ФайлВременногоКаталогаЭлементСписка.Значение.ИмяБезРасширения;
		
	КонецЦикла;
	
	ФайлыВременногоКаталогаСписок.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	
	Для Каждого ФайлВременногоКаталогаЭлементСписка Из ФайлыВременногоКаталогаСписок Цикл
		
		ФайлВременногоКаталога = ФайлВременногоКаталогаЭлементСписка.Значение;
		
		Файл = Новый Файл(ФайлВременногоКаталога.ПолноеИмя);
		
		Если Файл.Существует() Тогда
			
			РезультатРаботы = ОбработатьФайлНаСервере(ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлВременногоКаталога.ПолноеИмя), ЭтаФорма.УникальныйИдентификатор));
			
			Если РезультатРаботы <> Неопределено Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка файла " + ФайлВременногоКаталога.Имя + " успешно выполнена!");
				
			КонецЕсли;
			
		Иначе
			ТекстОшибки = "Файл " + ФайлВременногоКаталога.Имя + " не открывается. Загрузка не произведена";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

// Проверяет существование каталога 
// Параметры:
//  ИмяКаталога - Строка - путь к каталогу
// Возвращаемое значение:
//  булево 
//
&НаКлиенте
Функция ПроверитьСуществованиеКаталога(ИмяКаталога) 
    КаталогНаДиске = Новый Файл(ИмяКаталога);
	Если КаталогНаДиске.Существует() Тогда
		Возврат КаталогНаДиске.ЭтоКаталог();
	Иначе	
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

// Удаляет файлы в каталоге 
// Параметры:
//  ИмяКаталога		- Строка - путь к каталогу
//  МаскаИмениФайла - Строка - маска имени удаляемых файлов
//
&НаКлиенте
Процедура УдалитьФайлыВКаталоге(ИмяКаталога, МаскаИмениФайла = "*.*") Экспорт
	Если ПроверитьСуществованиеКаталога(ИмяКаталога) Тогда
		УдаляемыеФайлы = НайтиФайлы(ИмяКаталога, МаскаИмениФайла);
		Для СчетчикФайлов = 1 По УдаляемыеФайлы.Количество() Цикл
			УдаляемыйОбъект = УдаляемыеФайлы[СчетчикФайлов-1];
			Если УдаляемыйОбъект.ЭтоФайл() Тогда
				УдаляемыйОбъект.УстановитьТолькоЧтение(Ложь);				
			Иначе	
				УдалитьФайлыВКаталоге(УдаляемыйОбъект.ПолноеИмя, МаскаИмениФайла);
			КонецЕсли;	
		КонецЦикла;	
		УдалитьФайлы(ИмяКаталога, МаскаИмениФайла);
	КонецЕсли;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ОбработатьФайлНаСервере(АдресВХранилище)
	
	Попытка
		
		// Получаем данные из файла.
		ДанныеФайла = ПолучитьДанныеФайла(АдресВХранилище);
		
		// Выполняем все в одной транзакции.
		НачатьТранзакцию();
		
		Если ТипЗнч(ДанныеФайла) = Тип("ТаблицаЗначений") Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ДанныеФайла.НомерСделки КАК НомерСделки,
			               |	ДанныеФайла.НаименованиеВалюты КАК НаименованиеВалюты,
			               |	ДанныеФайла.ДатаNPV КАК Период,
			               |	ДанныеФайла.СуммаNPV КАК СуммаNPV,
			               |	ДанныеФайла.ДебиторскаяЗадолженность КАК ДебиторскаяЗадолженность,
			               |	ДанныеФайла.КредиторскаяЗадолженность КАК КредиторскаяЗадолженность,
			               |	ДанныеФайла.СтавкаВходящихПлатежей КАК СтавкаВходящихПлатежей,
			               |	ДанныеФайла.СтавкаИсходящихПлатежей КАК СтавкаИсходящихПлатежей,
			               |	ДанныеФайла.ПериодичностьВходящихПлатежей КАК ПериодичностьВходящихПлатежей
			               |ПОМЕСТИТЬ ДанныеФайла
			               |ИЗ
			               |	&ДанныеФайла КАК ДанныеФайла
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ДанныеФайла.НомерСделки КАК НомерСделки,
			               |	ДанныеФайла.НаименованиеВалюты КАК НаименованиеВалюты,
			               |	ДанныеФайла.Период КАК Период,
			               |	ДанныеФайла.СуммаNPV КАК NPV,
			               |	ДанныеФайла.ДебиторскаяЗадолженность КАК ДебиторскаяЗадолженность,
			               |	ДанныеФайла.КредиторскаяЗадолженность КАК КредиторскаяЗадолженность,
			               |	ДанныеФайла.СтавкаВходящихПлатежей КАК СтавкаВходящихПлатежей,
			               |	ДанныеФайла.СтавкаИсходящихПлатежей КАК СтавкаИсходящихПлатежей,
			               |	ДанныеФайла.ПериодичностьВходящихПлатежей КАК ПериодичностьВходящихПлатежей,
			               |	Валюты.Ссылка КАК Валюта,
			               |	СделкаСПФИ.Ссылка КАК СПФИ,
			               |	СделкаСПФИ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			               |	СделкаСПФИ.Организация КАК Организация,
			               |	СделкаСПФИ.СтавкаВходящихПлатежей КАК СтавкаВходящихПлатежейСделка,
			               |	СделкаСПФИ.СтавкаИсходящихПлатежей КАК СтавкаИсходящихПлатежейСделка,
			               |	СделкаСПФИ.ПериодичностьВходящихПлатежей КАК ПериодичностьВходящихПлатежейСделка,
			               |	СделкаСПФИ.ПериодичностьИсходящихПлатежей КАК ПериодичностьИсходящихПлатежейСделка
			               |ИЗ
			               |	ДанныеФайла КАК ДанныеФайла
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
			               |		ПО ДанныеФайла.НаименованиеВалюты = Валюты.Наименование
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаСПФИ КАК СделкаСПФИ
			               |		ПО ДанныеФайла.НомерСделки = СделкаСПФИ.НомерСделки
			               |			И (НЕ СделкаСПФИ.ПометкаУдаления)";
			
			Запрос.УстановитьПараметр("ДанныеФайла", ДанныеФайла);
			
			УстановитьПривилегированныйРежим(Истина);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НоваяЗапись = РегистрыСведений.СтоимостьСПФИ.СоздатьМенеджерЗаписи();
				НоваяЗапись.Период = ВыборкаДетальныеЗаписи.Период;
				НоваяЗапись.Организация = ВыборкаДетальныеЗаписи.Организация;
				НоваяЗапись.СчетДоверительногоУправления = ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
				НоваяЗапись.СПФИ = ВыборкаДетальныеЗаписи.СПФИ;
				НоваяЗапись.Валюта = ВыборкаДетальныеЗаписи.Валюта;
				НоваяЗапись.NPV = ВыборкаДетальныеЗаписи.NPV;
				НоваяЗапись.ДебиторскаяЗадолженность = ВыборкаДетальныеЗаписи.ДебиторскаяЗадолженность;
				НоваяЗапись.КредиторскаяЗадолженность = ВыборкаДетальныеЗаписи.КредиторскаяЗадолженность;
				НоваяЗапись.Записать();
				
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
			УстановитьПривилегированныйРежим(Ложь);
			
			
			ВыборкаДетальныеЗаписи.Сбросить();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаВходящихПлатежей) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаВходящихПлатежейСделка)
					Или ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаИсходящихПлатежей) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаИсходящихПлатежейСделка) Тогда
					
					Попытка
						ОбъектСПФИ = ВыборкаДетальныеЗаписи.СПФИ.ПолучитьОбъект();
						Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаВходящихПлатежей) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаВходящихПлатежейСделка) Тогда
							
							ОбъектСПФИ.СтавкаВходящихПлатежей = ВыборкаДетальныеЗаписи.СтавкаВходящихПлатежей;
							ОбъектСПФИ.СтавкаИсходящихПлатежей = ОбщегоНазначения.ПолучитьИменованныйОбъект("БазоваяСтавкаОблигаций_RUONIA");
							
							ОбъектСПФИ.Записать(РежимЗаписиДокумента.Запись);

						ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаИсходящихПлатежей) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СтавкаИсходящихПлатежейСделка) Тогда	
							
							ОбъектСПФИ.СтавкаВходящихПлатежей = ОбщегоНазначения.ПолучитьИменованныйОбъект("БазоваяСтавкаОблигаций_RUONIA");
							ОбъектСПФИ.СтавкаИсходящихПлатежей = ВыборкаДетальныеЗаписи.СтавкаИсходящихПлатежей;
							
							ОбъектСПФИ.Записать(РежимЗаписиДокумента.Запись);
							
						КонецЕсли;	
						
						Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежей) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьИсходящихПлатежейСделка) Тогда	
							
							Если ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежей = "1" Тогда
								ОбъектСПФИ.ПериодичностьИсходящихПлатежей = Перечисления.ПериодичностиВыплатыПроцентов.Ежемесячно;
							ИначеЕсли ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежей = "3" Тогда
								ОбъектСПФИ.ПериодичностьИсходящихПлатежей = Перечисления.ПериодичностиВыплатыПроцентов.Ежеквартально;
							КонецЕсли;	
							
							ОбъектСПФИ.Записать(РежимЗаписиДокумента.Запись);
							
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежей) И Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежейСделка) Тогда	
							
							Если ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежей = "1" Тогда
								ОбъектСПФИ.ПериодичностьВходящихПлатежей = Перечисления.ПериодичностиВыплатыПроцентов.Ежемесячно;
							ИначеЕсли ВыборкаДетальныеЗаписи.ПериодичностьВходящихПлатежей = "3" Тогда
								ОбъектСПФИ.ПериодичностьВходящихПлатежей = Перечисления.ПериодичностиВыплатыПроцентов.Ежеквартально;
							КонецЕсли;	
							
							ОбъектСПФИ.Записать(РежимЗаписиДокумента.Запись);
							
                        КонецЕсли;
						
						
					Исключение
						
					КонецПопытки;	
					
				КонецЕсли;	
			КонецЦикла;
			
			
			Возврат Истина;
		ИначеЕсли ТипЗнч(ДанныеФайла) = Тип("Структура") Тогда	
			
			УстановитьПривилегированныйРежим(Истина);
			
			НаборЗаписей = РегистрыСведений.СтоимостьСПФИ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Период.Установить(НачалоДня(ДанныеФайла.ДатаТорговая));
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() > 0 Тогда
			
				Для Каждого Запись Из НаборЗаписей Цикл
					
					Если ДанныеФайла.ОценкаМаржинальногоТребования < 0 И Запись.ОценкаМаржинальногоТребования <> ДанныеФайла.ОценкаМаржинальногоТребования И ДанныеФайла.ДатаТорговая >= Дата(2024, 11, 28) Тогда
						// Это первая запись о минусе, тогда об этом сообщим.	
						
						РеквизитыОповещения = Новый Структура("Период, ТекстОповещения", ПредставлениеПериода(НачалоДня(ДанныеФайла.ДатаТорговая), КонецДня(ДанныеФайла.ДатаТорговая)), "");
						
						РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<br><p style=""font-family: Arial;font-size: 10pt;line-height: 1.13;""><span style=""font-size: 10pt;"">На дату: " + Формат(ДанныеФайла.ДатаТорговая, "ДФ=dd.MM.yyyy") + " оценка маржинального требования по СПФИ: " + Формат(ДанныеФайла.ОценкаМаржинальногоТребования ,"ЧЦ=15; ЧДЦ=2")  + "</span></p>";
						
						Справочники.Оповещения.СформироватьОповещения("Обработка._ЗагрузкаСтоимостьСПФИизДанныхММВБ", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
						
					КонецЕсли;	
					
					Запись.РазмерГО = ДанныеФайла.РазмерГО;
					Запись.ОценкаМаржинальногоТребования = ДанныеФайла.ОценкаМаржинальногоТребования;
					
				КонецЦикла;			
				
				НаборЗаписей.Записать();
				
			Иначе
				// Такого быть не должно, но если произошло а оценка маржинального требования отрицательная - сообщим на всякий случай
				Если ДанныеФайла.ОценкаМаржинальногоТребования < 0 И ДанныеФайла.ДатаТорговая >= Дата(2024, 11, 28) Тогда
					
					РеквизитыОповещения = Новый Структура("Период, ТекстОповещения", ПредставлениеПериода(НачалоДня(ДанныеФайла.ДатаТорговая), КонецДня(ДанныеФайла.ДатаТорговая)), "");
					
					РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<br><p style=""font-family: Arial;font-size: 10pt;line-height: 1.13;""><span style=""font-size: 10pt;"">На дату: " + Формат(ДанныеФайла.ДатаТорговая, "ДФ=dd.MM.yyyy") + " оценка маржинального требования по СПФИ: " + Формат(ДанныеФайла.ОценкаМаржинальногоТребования ,"ЧЦ=15; ЧДЦ=2")  + "</span></p>";
					
					Справочники.Оповещения.СформироватьОповещения("Обработка._ЗагрузкаСтоимостьСПФИизДанныхММВБ", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
					
				КонецЕсли;
			КонецЕсли;
			
			УстановитьПривилегированныйРежим(Ложь);
			
			ЗафиксироватьТранзакцию();
			
			Возврат Истина;
		Иначе
			
			ОтменитьТранзакцию();
			
			Возврат Неопределено
		КонецЕсли;	
		
	Исключение
		
		Возврат Неопределено
		
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеФайла(АдресВХранилище)
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	
	ПолучитьИзВременногоХранилища(АдресВХранилище).Записать(ИмяВременногоФайла);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);

	ПостроительDOM	= Новый ПостроительDOM;
	ДокументDOM		= ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();

	УдалитьФайлы(ИмяВременногоФайла);
	
	
	// Дату все же берем из header а не из tradeDate
	ДатаТорговая = Дата(1,1,1);
	НомерСессии = "";
	
	СписокЗаголовков_header = ДокументDOM.ПолучитьЭлементыПоИмени("header");
	Для Каждого Заголовок_header Из СписокЗаголовков_header Цикл
		
		СписокЗаголовков_clearingDate = Заголовок_header.ПолучитьЭлементыПоИмени("clearingDate");
		
		Для Каждого Заголовок_clearingDate Из СписокЗаголовков_clearingDate Цикл
			ДатаСтрокой = Заголовок_clearingDate.ТекстовоеСодержимое;
			
			Попытка 
				ДатаТорговая = Дата(СтрЗаменить(ДатаСтрокой,"-",""));
			Исключение
				
			КонецПопытки;	
		КонецЦикла;
		
		СписокЗаголовков_clearingSessionNo = Заголовок_header.ПолучитьЭлементыПоИмени("clearingSessionNo");
		
		Для Каждого Заголовок_clearingSessionNo Из СписокЗаголовков_clearingSessionNo Цикл
			НомерСессии = Заголовок_clearingSessionNo.ТекстовоеСодержимое;
		КонецЦикла;
		
	КонецЦикла;	
	
	Если НомерСессии = "1" Тогда
		
		ДанныеФайла = Новый ТаблицаЗначений;
		ДанныеФайла.Колонки.Добавить("НомерСделки", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(25)));
		ДанныеФайла.Колонки.Добавить("НаименованиеВалюты", Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(25)));
		ДанныеФайла.Колонки.Добавить("ДатаNPV", Новый ОписаниеТипов("Дата"));
		ДанныеФайла.Колонки.Добавить("СуммаNPV", Новый ОписаниеТипов("Число"));
		ДанныеФайла.Колонки.Добавить("ДебиторскаяЗадолженность", Новый ОписаниеТипов("Число"));
		ДанныеФайла.Колонки.Добавить("КредиторскаяЗадолженность", Новый ОписаниеТипов("Число"));
		ДанныеФайла.Колонки.Добавить("СтавкаВходящихПлатежей", Новый ОписаниеТипов("Число"));
		ДанныеФайла.Колонки.Добавить("СтавкаИсходящихПлатежей", Новый ОписаниеТипов("Число"));
		ДанныеФайла.Колонки.Добавить("ПериодичностьВходящихПлатежей", Новый ОписаниеТипов("Строка"));
		
		
		// До 16.12.24 было пространство имен ms:
		
		СписокЗаголовков_ms_trade = ДокументDOM.ПолучитьЭлементыПоИмени("ms:trade");
		
		Для Каждого Заголовок_ms_trade Из СписокЗаголовков_ms_trade Цикл
			
			СписокЗаголовков_SWAP = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("swap");	
			
			// Если Кол-во SWAP равно нулю - тогда это не наша ветка. Нам нужны те что по свопам.
			Если СписокЗаголовков_SWAP.Количество() > 0 Тогда
				
				НомерСделки = "";
				ДатаNPV = Дата(1,1,1);
				СуммаNPV = 0;
				
				СтавкаВходящихПлатежей = 0;
				СтавкаИсходящихПлатежей = 0;
				
				ПериодичностьВходящихПлатежей = "";
				
				СписокЗаголовков_partyTradeIdentifier = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("partyTradeIdentifier");
				
				Для Каждого Заголовок_partyTradeIdentifier Из СписокЗаголовков_partyTradeIdentifier Цикл
					НомерСделки = Заголовок_partyTradeIdentifier.ТекстовоеСодержимое
				КонецЦикла;
				
				Если Не ЗначениеЗаполнено(ДатаТорговая) Тогда
					СписокЗаголовков_tradeDate = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("tradeDate");
					
					Для Каждого Заголовок_tradeDate Из СписокЗаголовков_tradeDate Цикл
						ДатаСтрокой = Заголовок_tradeDate.ТекстовоеСодержимое;
						
						Попытка 
							ДатаТорговая = Дата(СтрЗаменить(ДатаСтрокой,"-",""));
						Исключение
							
						КонецПопытки;	
					КонецЦикла;
				КонецЕсли;
				
				Для Каждого Заголовок_SWAP Из СписокЗаголовков_SWAP Цикл
					
					// Долги
					СписокЗаголовков_swapStream = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("swapStream");
					
					Для Каждого Заголовок_swapStream Из СписокЗаголовков_swapStream Цикл
						
						Плательщик = "";
						
						СписокЗаголовков_payerPartyReference = Заголовок_swapStream.ПолучитьЭлементыПоИмени("payerPartyReference");
						
						Для Каждого Заголовок_payerPartyReference Из СписокЗаголовков_payerPartyReference Цикл
							Для Каждого Аттрибут Из Заголовок_payerPartyReference.Атрибуты Цикл
								Плательщик = Аттрибут.ТекстовоеСодержимое;	
							КонецЦикла;	
						КонецЦикла;	
						
						СписокЗаголовков_calculationPeriodDates = Заголовок_swapStream.ПолучитьЭлементыПоИмени("calculationPeriodDates");
						
						Для Каждого Заголовок_calculationPeriodDates Из СписокЗаголовков_calculationPeriodDates Цикл
							Для Каждого УзелЗаголовок_calculationPeriodDates Из Заголовок_calculationPeriodDates.ДочерниеУзлы Цикл
								Если Нрег(УзелЗаголовок_calculationPeriodDates.ИмяУзла) = "calculationperiodfrequency" Тогда
									Для Каждого УзелЗаголовок_calculationPeriodFrequency Из УзелЗаголовок_calculationPeriodDates.ДочерниеУзлы Цикл
                                    	Если Нрег(УзелЗаголовок_calculationPeriodFrequency.ИмяУзла) = "periodmultiplier" Тогда
											ПериодичностьВходящихПлатежей = УзелЗаголовок_calculationPeriodFrequency.ТекстовоеСодержимое;
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЦикла;	
						КонецЦикла;	
						
						СписокЗаголовков_paymentCalculationPeriod = Заголовок_swapStream.ПолучитьЭлементыПоИмени("paymentCalculationPeriod");
						
						Для Каждого Заголовок_paymentCalculationPeriod Из СписокЗаголовков_paymentCalculationPeriod Цикл
							ДатаПотока = Дата(1,1,1);
							
							Для Каждого УзелЗаголовок_paymentCalculationPeriod Из Заголовок_paymentCalculationPeriod.ДочерниеУзлы Цикл
								Если Нрег(УзелЗаголовок_paymentCalculationPeriod.ИмяУзла) = "adjustedpaymentdate" Тогда
									ДатаПотокаСтрокой = УзелЗаголовок_paymentCalculationPeriod.ТекстовоеСодержимое;
									
									Попытка 
										ДатаПотока = Дата(СтрЗаменить(ДатаПотокаСтрокой,"-",""));
									Исключение
										
									КонецПопытки;	
								КонецЕсли;
							КонецЦикла;	
							
							Если ДатаПотока > ДатаТорговая тогда
								
								СписокЗаголовков_forecastPaymentAmount = Заголовок_paymentCalculationPeriod.ПолучитьЭлементыПоИмени("forecastPaymentAmount");
								
								Для Каждого Заголовок_forecastPaymentAmount Из СписокЗаголовков_forecastPaymentAmount Цикл
									НаименованиеВалюты = "";
									Задолженность = 0;
									Для Каждого УзелЗаголовок_forecastPaymentAmount Из Заголовок_forecastPaymentAmount.ДочерниеУзлы Цикл
										Если Нрег(УзелЗаголовок_forecastPaymentAmount.ИмяУзла) = "currency" Тогда
											НаименованиеВалюты = УзелЗаголовок_forecastPaymentAmount.ТекстовоеСодержимое;	
										ИначеЕсли Нрег(УзелЗаголовок_forecastPaymentAmount.ИмяУзла) = "amount" Тогда
											СуммаСтрокой = СтрЗаменить(УзелЗаголовок_forecastPaymentAmount.ТекстовоеСодержимое, ".", ",");
											
											Попытка 
												Задолженность = Число(СуммаСтрокой);
											Исключение
												
											КонецПопытки;	
										КонецЕсли;
									КонецЦикла;	
									
									Если ЗначениеЗаполнено(Плательщик) И ЗначениеЗаполнено(ДатаТорговая) И ЗначениеЗаполнено(Задолженность) Тогда
										НоваяСтрокаДанныеФайла = ДанныеФайла.Добавить();
										НоваяСтрокаДанныеФайла.НомерСделки = НомерСделки;
										НоваяСтрокаДанныеФайла.НаименованиеВалюты = НаименованиеВалюты;
										НоваяСтрокаДанныеФайла.ДатаNPV = ДатаТорговая;
										
										Если ВРЕГ(Плательщик) = "NCCB" Тогда
											НоваяСтрокаДанныеФайла.ДебиторскаяЗадолженность = Задолженность;
										Иначе
											НоваяСтрокаДанныеФайла.КредиторскаяЗадолженность = Задолженность;
										КонецЕсли;	
									КонецЕсли;	
								КонецЦикла;	
								
								СписокЗаголовков_calculationPeriod = Заголовок_paymentCalculationPeriod.ПолучитьЭлементыПоИмени("calculationPeriod");
								
								Для Каждого Заголовок_calculationPeriod Из СписокЗаголовков_calculationPeriod Цикл
									СтавкаФиксированнная = 0;
									Для Каждого УзелЗаголовок_calculationPeriod Из Заголовок_calculationPeriod.ДочерниеУзлы Цикл
										Если Нрег(УзелЗаголовок_calculationPeriod.ИмяУзла) = "fixedrate" Тогда
											СтавкаСтрокой = СтрЗаменить(УзелЗаголовок_calculationPeriod.ТекстовоеСодержимое, ".", ",");
											
											Попытка 
												СтавкаФиксированнная = Число(СтавкаСтрокой);
											Исключение
												
											КонецПопытки;	
										КонецЕсли;
									КонецЦикла;	
									
									Если ЗначениеЗаполнено(СтавкаФиксированнная) Тогда
										Если ВРЕГ(Плательщик) = "NCCB" Тогда
											СтавкаВходящихПлатежей = СтавкаФиксированнная*100;
										Иначе
											СтавкаИсходящихПлатежей = СтавкаФиксированнная*100;
										КонецЕсли;	
									КонецЕсли;	
								КонецЦикла;	
								
							КонецЕсли;
							
						КонецЦикла;	
						
					КонецЦикла;	
					
					// NVP 
					СписокЗаголовков_ms_npvPoint = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("ms:npvPoint");
					
					Для Каждого Заголовок_ms_npvPoint Из СписокЗаголовков_ms_npvPoint Цикл
						
						ДатаNPV = Дата(1,1,1);
						СуммаNPV = 0;
						НаименованиеВалюты = "";
						
						
						СписокЗаголовков_ms_npvCurrency = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("ms:npvCurrency");
						
						Для Каждого Заголовок_ms_npvCurrency Из СписокЗаголовков_ms_npvCurrency Цикл
							
							НаименованиеВалюты = Заголовок_ms_npvCurrency.ТекстовоеСодержимое;
							
						КонецЦикла;	
						
						
						СписокЗаголовков_ms_npvDate = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("ms:npvDate");
						
						Для Каждого Заголовок_ms_npvDate Из СписокЗаголовков_ms_npvDate Цикл
							ДатаСтрокой = Заголовок_ms_npvDate.ТекстовоеСодержимое;
							
							Попытка 
								ДатаNPV = Дата(СтрЗаменить(ДатаСтрокой,"-",""));
							Исключение
								
							КонецПопытки;	
						КонецЦикла;	
						
						СписокЗаголовков_ms_npvAmount = Заголовок_ms_trade.ПолучитьЭлементыПоИмени("ms:npvAmount");
						
						Для Каждого Заголовок_ms_npvAmount Из СписокЗаголовков_ms_npvAmount Цикл
							СуммаСтрокой = СтрЗаменить(Заголовок_ms_npvAmount.ТекстовоеСодержимое, ".", ",");
							
							Попытка 
								СуммаNPV = Число(СуммаСтрокой);
							Исключение
								
							КонецПопытки;	
						КонецЦикла;	
						
						Если ЗначениеЗаполнено(НомерСделки) И ЗначениеЗаполнено(ДатаNPV) Тогда
							НоваяСтрокаДанныеФайла = ДанныеФайла.Добавить();
							НоваяСтрокаДанныеФайла.НомерСделки = НомерСделки;
							НоваяСтрокаДанныеФайла.НаименованиеВалюты = НаименованиеВалюты;
							НоваяСтрокаДанныеФайла.ДатаNPV = ДатаNPV;
							НоваяСтрокаДанныеФайла.СуммаNPV = СуммаNPV;
						КонецЕсли;	
					КонецЦикла;	
				КонецЦикла;	
				
				Если ЗначениеЗаполнено(НомерСделки) И ((ЗначениеЗаполнено(СтавкаВходящихПлатежей) Или (ЗначениеЗаполнено(СтавкаИсходящихПлатежей)) Или (ЗначениеЗаполнено(ПериодичностьВходящихПлатежей)))) Тогда //стыдно, но только так мы это можем получить. Простить и понять.
					Для Каждого СтрокаДанныеФайла Из ДанныеФайла Цикл
						Если СтрокаДанныеФайла.НомерСделки = НомерСделки Тогда 
							СтрокаДанныеФайла.СтавкаВходящихПлатежей = СтавкаВходящихПлатежей;	
							СтрокаДанныеФайла.СтавкаИсходящихПлатежей = СтавкаИсходящихПлатежей;	
							СтрокаДанныеФайла.ПериодичностьВходящихПлатежей = ПериодичностьВходящихПлатежей;	
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
		
		// а после 16.12.24 часто бывает без него:
		
		СписокЗаголовков_trade = ДокументDOM.ПолучитьЭлементыПоИмени("trade");
		
		Для Каждого Заголовок_trade Из СписокЗаголовков_trade Цикл
			
			СписокЗаголовков_SWAP = Заголовок_trade.ПолучитьЭлементыПоИмени("swap");	
			
			// Если Кол-во SWAP равно нулю - тогда это не наша ветка. Нам нужны те что по свопам.
			Если СписокЗаголовков_SWAP.Количество() > 0 Тогда
				
				НомерСделки = "";
				ДатаNPV = Дата(1,1,1);
				СуммаNPV = 0;
				
				СтавкаВходящихПлатежей = 0;
				СтавкаИсходящихПлатежей = 0;
				
				ПериодичностьВходящихПлатежей = "";
				ПериодичностьИсходящихПлатежей= "";
				
				СписокЗаголовков_partyTradeIdentifier = Заголовок_trade.ПолучитьЭлементыПоИмени("partyTradeIdentifier");
				
				Для Каждого Заголовок_partyTradeIdentifier Из СписокЗаголовков_partyTradeIdentifier Цикл
					НомерСделки = Заголовок_partyTradeIdentifier.ТекстовоеСодержимое
				КонецЦикла;
				
				Если Не ЗначениеЗаполнено(ДатаТорговая) Тогда
					СписокЗаголовков_tradeDate = Заголовок_trade.ПолучитьЭлементыПоИмени("tradeDate");
					
					Для Каждого Заголовок_tradeDate Из СписокЗаголовков_tradeDate Цикл
						ДатаСтрокой = Заголовок_tradeDate.ТекстовоеСодержимое;
						
						Попытка 
							ДатаТорговая = Дата(СтрЗаменить(ДатаСтрокой,"-",""));
						Исключение
							
						КонецПопытки;	
					КонецЦикла;
				КонецЕсли;
				
				Для Каждого Заголовок_SWAP Из СписокЗаголовков_SWAP Цикл
					
					// Долги
					СписокЗаголовков_swapStream = Заголовок_trade.ПолучитьЭлементыПоИмени("swapStream");
					
					Для Каждого Заголовок_swapStream Из СписокЗаголовков_swapStream Цикл
						
						Плательщик = "";
						
						СписокЗаголовков_payerPartyReference = Заголовок_swapStream.ПолучитьЭлементыПоИмени("payerPartyReference");
						
						Для Каждого Заголовок_payerPartyReference Из СписокЗаголовков_payerPartyReference Цикл
							Для Каждого Аттрибут Из Заголовок_payerPartyReference.Атрибуты Цикл
								Плательщик = Аттрибут.ТекстовоеСодержимое;	
							КонецЦикла;	
						КонецЦикла;	
						
						СписокЗаголовков_calculationPeriodDates = Заголовок_swapStream.ПолучитьЭлементыПоИмени("calculationPeriodDates");
						
						Для Каждого Заголовок_calculationPeriodDates Из СписокЗаголовков_calculationPeriodDates Цикл
							Для Каждого УзелЗаголовок_calculationPeriodDates Из Заголовок_calculationPeriodDates.ДочерниеУзлы Цикл
								Если Нрег(УзелЗаголовок_calculationPeriodDates.ИмяУзла) = "calculationperiodfrequency" Тогда
									Для Каждого УзелЗаголовок_calculationPeriodFrequency Из УзелЗаголовок_calculationPeriodDates.ДочерниеУзлы Цикл
                                    	Если Нрег(УзелЗаголовок_calculationPeriodFrequency.ИмяУзла) = "periodmultiplier" Тогда
											ПериодичностьВходящихПлатежей = УзелЗаголовок_calculationPeriodFrequency.ТекстовоеСодержимое;
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЦикла;	
						КонецЦикла;	
						
						СписокЗаголовков_paymentCalculationPeriod = Заголовок_swapStream.ПолучитьЭлементыПоИмени("paymentCalculationPeriod");
						
						Для Каждого Заголовок_paymentCalculationPeriod Из СписокЗаголовков_paymentCalculationPeriod Цикл
							ДатаПотока = Дата(1,1,1);
							
							Для Каждого УзелЗаголовок_paymentCalculationPeriod Из Заголовок_paymentCalculationPeriod.ДочерниеУзлы Цикл
