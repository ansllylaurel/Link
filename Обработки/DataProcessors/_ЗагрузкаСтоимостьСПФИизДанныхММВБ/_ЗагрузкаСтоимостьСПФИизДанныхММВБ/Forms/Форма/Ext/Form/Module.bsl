						КонецЦикла;	
						
						СписокЗаголовков_npvAmount = Заголовок_trade.ПолучитьЭлементыПоИмени("npvAmount");
						
						Для Каждого Заголовок_npvAmount Из СписокЗаголовков_npvAmount Цикл
							СуммаСтрокой = СтрЗаменить(Заголовок_npvAmount.ТекстовоеСодержимое, ".", ",");
							
							Попытка 
								СуммаNPV = Число(СуммаСтрокой);
