#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.ИспользуемаяБазаДанных = "Рабочая";
	
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	ОбъектЗначение.УстановитьПараметрыСоединенияСSQL();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Список значений "СчетаДУ" не имеет фиксированного типа данных, поэтому его нужно установить
	Объект.СчетаДУ.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления");
	
	ДатаНачалаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	Объект.ИспользуемаяБазаДанных = "Рабочая";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	ДатаНачалаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаНачалаПриИзмененииНаСервере()
	КоличествоКалендарныхДней = (Объект.ДатаОкончания - Объект.ДатаНачала) / (60 * 60 * 24) + 1;
	Попытка
		КоличествоТорговыхДней = Справочники.Календари.КоличествоРабочихДней(
			ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"), Объект.ДатаНачала, Объект.ДатаОкончания);
	Исключение
	КонецПопытки;
	Объект.ТаблицаДанных.Очистить();
	Объект.ТаблицаОпераций.Очистить();
	ТаблицаВыбранныхОпераций.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДанныхПриАктивизацииСтроки(Элемент)
	// Составление списка счетов ДУ
	ВыбранныеСчетаДУ = Новый Соответствие(); // Соответствие(Справочник.СчетДоверительногоУправления, Истина)
	Для Каждого ВыделеннаяСтрока Из Элементы.ТаблицаДанных.ВыделенныеСтроки Цикл
		НайденнаяСтрока = Объект.ТаблицаДанных.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если НайденнаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВыбранныеСчетаДУ.Вставить(НайденнаяСтрока.СчетДоверительногоУправления, Истина);
	КонецЦикла;
	// Поиск нужных строк операций и вывод их в таблицу интерфейса
	ТаблицаВыбранныхОпераций.Очистить();
	Для Каждого КлючЗначение Из ВыбранныеСчетаДУ Цикл
		ВыбранныйСчетДУ = КлючЗначение.Ключ;
		НайденныеСтроки = Объект.ТаблицаОпераций.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ВыбранныйСчетДУ));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			СтрокаВыбранныхОпераций = ТаблицаВыбранныхОпераций.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВыбранныхОпераций, НайденнаяСтрока);
		КонецЦикла;
	КонецЦикла;
	ТаблицаВыбранныхОпераций.Сортировать("Период, Операция");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	КомандаЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура КомандаЗаполнитьНаСервере()
	ТаблицаВыбранныхОпераций.Очистить();
	// Получение данных и заполнение таблиц формы
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	ОбъектЗначение.ЗаполнитьПоТекущимПараметрам();
	ЗначениеВРеквизитФормы(ОбъектЗначение, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузить(Команда)
	// Проверка корректности параметров
	Если Объект.ТаблицаДанных.Количество() = 0 Тогда
		Предупреждение("Таблица пустая. Заполнение происходит через кнопку ""Заполнить"".",, "Проверка корректности параметров");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Предупреждение("Даты начала и окончания должны быть заполнены.",, "Проверка корректности параметров");
		Возврат;
	КонецЕсли;
	КоличествоОбработанныхЗаписей = КомандаВыгрузитьНаСервере();
	Если КоличествоОбработанныхЗаписей <> Неопределено И КоличествоОбработанныхЗаписей > 0 Тогда
		Предупреждение("Выгружено записей: " + КоличествоОбработанныхЗаписей,, "Результат выполнения");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция КомандаВыгрузитьНаСервере()
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	Возврат ОбъектЗначение.ВыгрузитьДанныеВSQL();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт
	ПриСменеТекущейОрганизацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСменеТекущейОрганизацииНаСервере() Экспорт
	// Не используется после того, как осталась одна компания (14 апреля 2026)
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
КонецПроцедуры

#КонецОбласти
