#Область События_Формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Период        = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	
	ШаблонЗапросаНаПодтверждениеМНО = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ШаблонПодтвержденияМНО");
	ЭтаФорма.ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо");
	
	УстановитьКаталогНаСервере();
		
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("ФормаРСА", 	"Сверка СЧА и РСА");
	ЭтаФорма.ФормыПервичныхДокументовСЭД.Добавить("МНО", 		"МНО");
	
	// создадим реквизиты формы
	НовыеРеквизитыФормы = Новый Массив;
	
	Для каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаРСА" Тогда 
			НаименованиеРеквизита = "СЧА и РСА";
		Иначе
			НаименованиеРеквизита = ФормаПервичныхДокументовСЭД.Значение;
		КонецЕсли;
		НовыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево")));
		НовыеРеквизитыФормы.Добавить(
			Новый РеквизитФормы(ФормаПервичныхДокументовСЭД.Значение, Новый ОписаниеТипов("Булево"), "АктивныеСчетаДоверительногоУправления", НаименованиеРеквизита));
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(НовыеРеквизитыФормы, Новый Массив);
	
	// создадим элементы управления, соотв. новым реквизитам формы
	Для каждого ФормаПервичныхДокументовСЭД Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		Если ФормаПервичныхДокументовСЭД.Значение = "ФормаРСА" Тогда 
			НаименованиеРеквизита = "СЧА и РСА";
		Иначе
			НаименованиеРеквизита = ФормаПервичныхДокументовСЭД.Значение;
		КонецЕсли;

		ПолеФлажкаФормы = Элементы.Добавить(ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.ГруппаФормы);
		ПолеФлажкаФормы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаФормы.ПутьКДанным        = ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаФормы.Заголовок          = ФормаПервичныхДокументовСЭД.Представление;
		ПолеФлажкаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		
		ПолеФлажкаФормы.УстановитьДействие("ПриИзменении", "Подключаемый_ФлажкиФормПриИзменении");
		
		ПолеФлажкаТаблицы = Элементы.Вставить("АктивныеСчетаДоверительногоУправления" + ФормаПервичныхДокументовСЭД.Значение, Тип("ПолеФормы"), Элементы.АктивныеСчетаДоверительногоУправления, Элементы.АктивныеСчетаДоверительногоУправленияФлажок);
		ПолеФлажкаТаблицы.Вид                = ВидПоляФормы.ПолеФлажка;
		ПолеФлажкаТаблицы.ПутьКДанным        = "АктивныеСчетаДоверительногоУправления." + ФормаПервичныхДокументовСЭД.Значение;
		ПолеФлажкаТаблицы.Заголовок          = НаименованиеРеквизита;
		ПолеФлажкаТаблицы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеФлажкаТаблицы.ТолькоПросмотр     = Истина;
		
		ЭтаФорма[ФормаПервичныхДокументовСЭД.Значение] = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ОбновитьАктивныеСчетаДоверительногоУправления();
	УстановитьКаталогНаСервере(); 
	 
КонецПроцедуры

&НаКлиенте
Процедура АктивныеСчетаДоверительногоУправленияПередНачаломИзменения(Элемент, Отказ)

	ТекущиеДанные = Элементы.АктивныеСчетаДоверительногоУправления.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.АктивныеСчетаДоверительногоУправления.ТекущийЭлемент = Элементы.АктивныеСчетаДоверительногоУправленияСчетДоверительногоУправления Тогда
		Отказ = Истина;
		ОткрытьЗначение(ТекущиеДанные.СчетДоверительногоУправления);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область События_Элементов_Формы

&НаКлиенте
Процедура КаталогФайловОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Объект.КаталогФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогФайлов;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогФайлов = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Объект.Организация, Подписант));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ПодписантДолжность = СтруктураДанныхКонтактногоЛица.Должность;
	ВыбранноеЗначение  = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ФлажкиФормПриИзменении(Элемент)
	
	Элементы["АктивныеСчетаДоверительногоУправления" + Элемент.Имя].Видимость = ЭтаФорма[Элемент.Имя];
	
	КомандаОбновить(Неопределено);
	
КонецПроцедуры // Подключаемый_ФлажкиФормПриИзменении

#КонецОбласти

#Область Команды_Формы

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновить");
	Попытка
		ОбновитьАктивныеСчетаДоверительногоУправления();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЭкспортировать");
	Попытка
		ВыполнитьЭкспорт(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЭкспорт(ПараметрыСессии)
	
	// Проверяем каталог верхнего уровня
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(Объект.КаталогФайлов, Отказ);
	
	Если Отказ Тогда
		Сообщить("Экспорт данных прерван");
		ДобавитьТекстОшибки(ПараметрыСессии, "Не удалось создать каталог файлов");
		Возврат;	
	КонецЕсли;

	МассивСчетовДУ = Новый Массив;
	Для каждого Элемент Из ЭтаФорма.ФормыПервичныхДокументовСЭД Цикл
		
		МассивСчетовДУ.Очистить();
		Для каждого СтрокаАктивныеСчетаДоверительногоУправления Из ЭтаФорма.АктивныеСчетаДоверительногоУправления Цикл
			
			Если Не СтрокаАктивныеСчетаДоверительногоУправления.Флажок Тогда
				Продолжить;
			КонецЕсли;            			
		
			Если СтрокаАктивныеСчетаДоверительногоУправления[Элемент.Значение] Тогда
				МассивСчетовДУ.Добавить(СтрокаАктивныеСчетаДоверительногоУправления.СчетДоверительногоУправления);	
			КонецЕсли;
		КонецЦикла;
		
		Если МассивСчетовДУ.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не Элемент.Значение = "МНО" Тогда
			
			КаталогДаты = "\" + Формат(Объект.Период, "ДФ=yyyy.MM") + "\" + Формат(Объект.Период, "ДФ=yyyy.MM.dd") + "\"; 
			ТекКаталогФайлов = Объект.КаталогФайлов + "\" + "СЧА_РСА" + КаталогДаты;
					
			Отказ = Ложь;
			РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(ТекКаталогФайлов, Отказ);
			
			Если Отказ Тогда
				Сообщить("Экспорт данных прерван");
				ДобавитьТекстОшибки(ПараметрыСессии, "Не удалось создать каталог СЧА_РСА");
				Возврат;	
			КонецЕсли;
			
			ПолучитьФорму("ВнешняяОбработка._ЭкспортДанныхВОСД.Форма." + Элемент.Значение)
						.СфомироватьДокументыСЭД(Объект.Организация, МассивСчетовДУ, Объект.Период, ТекКаталогФайлов, Подписант);
		Иначе
			ПечатьЗапросовНаПодтверждениеМНО(МассивСчетовДУ, ПараметрыСессии);			
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Экспорт данных завершен");
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
