
&НаСервере
Процедура ПолучитьСписокРасчетныхСчетовПИФ()
	
	СписокСчетов.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.Организация КАК Организация,
		|	РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БанковскиеСчета.Банк КАК Банк,
		|	БанковскиеСчета.ТранзитныйПИФ
		|		ИЛИ БанковскиеСчета.Транзитный КАК ТранзитныйПИФ,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет,
		|	РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия КАК ДатаЗакрытия,
		|	ВЫБОР
		|		КОГДА РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &Дата
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Закрыт,
		|	БанковскиеСчета.Банк.Наименование КАК БанкНаименование,
		|	БанковскиеСчета.Договор.ДатаЗаключения КАК ДатаЗаключенияСчета,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ЗначенияДополнительныхСведенийНачало.Значение, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ЗначенияДополнительныхСведенийНачало.Значение
		|		КОГДА ЕСТЬNULL(ЗначенияДополнительныхСведенийОкончание.Значение, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ЗначенияДополнительныхСведенийОкончание.Значение
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаНачалаПИФ,
		|	БанковскиеСчета.Валюта КАК Валюта
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК РегистрСведенийИсполнителиПоДенежнымСредствамСобственные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПО РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = БанковскиеСчета.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Дата, ТИПЗНАЧЕНИЯ(Клиент) = ТИП(Справочник.ПаевыеИнвестиционныеФонды)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийОкончание
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведенийОкончание.Объект
		|				И (ЗначенияДополнительныхСведенийОкончание.Свойство.Ключ = ""ДатаОкончанияФормированияПИФ"")
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведенийНачало
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведенийНачало.Объект
		|				И (ЗначенияДополнительныхСведенийНачало.Свойство.Ключ = ""ДатаНачалаФормированияПИФ"")
		|		ПО РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.ПометкаУдаления = ЛОЖЬ
		|	И ЕСТЬNULL(РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.ПометкаУдаления, ЛОЖЬ) = ЛОЖЬ
		|	И (РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &Дата)
		|	И РегистрСведенийИсполнителиПоДенежнымСредствамСобственные.Организация = &Организация
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
		|	И БанковскиеСчета.Договор.ДатаЗаключения <= &Дата
		|	И ВЫБОР
		|			КОГДА ЕСТЬNULL(ЗначенияДополнительныхСведенийНачало.Значение, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ЗначенияДополнительныхСведенийНачало.Значение
		|			КОГДА ЕСТЬNULL(ЗначенияДополнительныхСведенийОкончание.Значение, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ЗначенияДополнительныхСведенийОкончание.Значение
		|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|		КОНЕЦ > ДАТАВРЕМЯ(1, 1, 1)
		|	И ВЫБОР
		|			КОГДА ЕСТЬNULL(ЗначенияДополнительныхСведенийНачало.Значение, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ЗначенияДополнительныхСведенийНачало.Значение
		|			КОГДА ЕСТЬNULL(ЗначенияДополнительныхСведенийОкончание.Значение, ДАТАВРЕМЯ(1, 1, 1)) > ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ЗначенияДополнительныхСведенийОкончание.Значение
		|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|		КОНЕЦ <= &Дата";
	
	Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтрокаСпискаСчетов = СписокСчетов.Добавить();
		СтрокаСпискаСчетов.Пометка = Истина;
		СтрокаСпискаСчетов.СчетДоверительногУправления = ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
		СтрокаСпискаСчетов.НомерСчета = ВыборкаДетальныеЗаписи.НомерСчета;
		СтрокаСпискаСчетов.Банк = ВыборкаДетальныеЗаписи.Банк;
		СтрокаСпискаСчетов.ТранзитныйПИФ = ВыборкаДетальныеЗаписи.ТранзитныйПИФ;
		СтрокаСпискаСчетов.Валюта = ВыборкаДетальныеЗаписи.Валюта;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИменаФайловВыписокПИФ()
	
	ПолучитьСписокРасчетныхСчетовПИФ();
	
	СписокОшибок = Новый Массив;
	
	СписокБанков = Новый СписокЗначений;
	СписокБанков.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_Руснар"), "РНБ");
	СписокБанков.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_МКБ"), "МКБ");
	СписокБанков.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ"), "ВТБ");
	СписокБанков.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_МТС"), "МТС");
	СписокБанков.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ГПБ"), "ГПБ");
	СписокБанков.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВБРР"), "ВБРР");
	
	Для Каждого СтрокаСпискаСчетов Из СписокСчетов Цикл
		
		Банк = СписокБанков.НайтиПоЗначению(СтрокаСпискаСчетов.Банк);
		
		Если Банк = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не настроено сохранение выписок по банку "
				+ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаСпискаСчетов.Банк, "Наименование"));
		Иначе
			СтрокаСпискаСчетов.ИмяИсходногоФайла = ПолучитьПутиКФайлу(Банк.Представление, Объект.Дата, СтрокаСпискаСчетов.НомерСчета, СписокОшибок);
			СтрокаСпискаСчетов.ПредставлениеБанка = Банк.Представление;
		КонецЕсли;
		
		Если СтрокаСпискаСчетов.ИмяИсходногоФайла = "" Тогда
			СтрокаСпискаСчетов.Пометка = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СписокОшибок.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибки определения файлов! Проверьте наличие");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПутиКФайлу(ПредставлениеБанка, Дата, НомерСчета, СписокОшибок)
	
	ИсходныеФайлы = Новый Массив;
	
	ПутьКПапке = СтрШаблон("\\g1\shares\UK\RPI\PORTF\Бухгалтерия\Выписки\РПИ\%1\%2\%3_%4\%5\",
		ПредставлениеБанка, Формат(Дата, "ДФ=yyyy"), Формат(Дата, "ДФ=ММ"), Формат(Дата, "ДФ=ММММ"), Формат(Дата, "ДФ=dd.ММ.yyyy"));
	Если Не СуществуетКаталог(ПутьКПапке, СписокОшибок) Тогда
		Возврат "";
	КонецЕсли;
	
	ЭтоПустаяВыписка = Ложь;
	
	Если ПредставлениеБанка = "МКБ" Тогда
		
		Если Дата >= Дата(2023,12,1) Тогда
			ИмяФайла = СтрШаблон("%1_%2",НомерСчета, Формат(Дата, "ДФ=ddMMyyyy"));
		Иначе
			ИмяФайла = СтрШаблон("%1_%2",НомерСчета, Формат(Дата, "ДФ=yyyyMMdd"));
		КонецЕсли;
		
		ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		
		Если Не ЭтоПустаяВыписка Тогда
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".pdf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + "reg.pdf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		Иначе
			Если Дата >= Дата(2023,12,1) Тогда
				ПутьКПапке = ПутьКПапке + "без_оборотов\";
				ИмяФайла = "_" + ИмяФайла;
			Иначе
				ПутьКПапке = ПутьКПапке + "_Empty\";
			КонецЕсли;
			
			Если Не СуществуетКаталог(ПутьКПапке, СписокОшибок) Тогда
				Возврат "";
			КонецЕсли;
			
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".pdf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		КонецЕсли;
		
	ИначеЕсли ПредставлениеБанка = "ГПБ" Тогда

		ИмяФайла = СтрШаблон("%2_%1", НомерСчета, Формат(Дата, "ДФ=ddMMyyyy"));
		
		ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		
		Если Не ЭтоПустаяВыписка Тогда
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".pdf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		Иначе
			ПутьКПапке = ПутьКПапке + "без_оборотов\";
			ИмяФайла = "_" + ИмяФайла;
			
			Если Не СуществуетКаталог(ПутьКПапке, СписокОшибок) Тогда
				Возврат "";
			КонецЕсли;
			
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".pdf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		КонецЕсли;
		
	ИначеЕсли (ПредставлениеБанка = "РНБ" И Дата >= Дата(2025,02,11)) ИЛИ ПредставлениеБанка = "ВБРР" Тогда

		ИмяФайла = СтрШаблон("%1_%2",НомерСчета, Формат(Дата, "ДФ=ddMMyyyy"));
		
		ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		
		Если Не ЭтоПустаяВыписка Тогда
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".rtf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		Иначе
			ПутьКПапке = ПутьКПапке + "без_оборотов\";
			ИмяФайла = "_" + ИмяФайла;
			
			Если Не СуществуетКаталог(ПутьКПапке, СписокОшибок) Тогда
				Возврат "";
			КонецЕсли;
			
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".rtf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		КонецЕсли;
		
	ИначеЕсли ПредставлениеБанка = "РНБ" ИЛИ ПредставлениеБанка = "ВТБ" ИЛИ ПредставлениеБанка = "МТС" Тогда
		
		Если ПредставлениеБанка = "МТС" Тогда
			ИмяФайла = СтрШаблон("StatementRu_%1", НомерСчета);
		Иначе
			ИмяФайла = СтрШаблон("%1_%2", НомерСчета, Формат(Дата, "ДФ=ddMMyy"));
		КонецЕсли;
		
		ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		
		Если Не ЭтоПустаяВыписка Тогда
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".rtf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		Иначе
			Если ПредставлениеБанка <> "МТС" Тогда
				ПутьКПапке = ПутьКПапке + "_Empty\";
				Если Не СуществуетКаталог(ПутьКПапке, СписокОшибок) Тогда
					Возврат "";
				КонецЕсли;
			КонецЕсли;
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".txt", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
			ПроверитьНаличиеФайла(ПутьКПапке + ИмяФайла + ".rtf", ЭтоПустаяВыписка, ИсходныеФайлы, СписокОшибок);
		КонецЕсли;
		
	Иначе
		
		ДобавитьОшибкуВСписок("Не определены имена выписок по банку  " + ПредставлениеБанка, СписокОшибок);
		
	КонецЕсли;
	
	Возврат СтрСоединить(ИсходныеФайлы, ";");
	
КонецФункции

&НаКлиенте
Функция СуществуетКаталог(ИмяКаталога, СписокОшибок = Неопределено)
	КаталогНаДиске = Новый Файл(ИмяКаталога);
	Если НЕ КаталогНаДиске.Существует() Тогда
		Если СписокОшибок <> Неопределено Тогда
			ДобавитьОшибкуВСписок("Не обнаружен каталог " + ИмяКаталога, СписокОшибок);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция ПроверитьНаличиеФайла(ИмяФайла, ЭтоПустаяВыписка, СписокФайлов, СписокОшибок)
	ИсходныйФайл = Новый Файл(ИмяФайла);
	Если Не ИсходныйФайл.Существует() Тогда
		Если СтрНайти(ИмяФайла, "_Empty") = 0 И Не ЭтоПустаяВыписка Тогда
			ЭтоПустаяВыписка = Истина;
		Иначе
			ДобавитьОшибкуВСписок("Не обнаружен файл " + ИмяФайла, СписокОшибок);
		КонецЕсли;
		Возврат Ложь;
	Иначе
		СписокФайлов.Добавить(ИмяФайла);
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ДобавитьОшибкуВСписок(ТекстОшибки, СписокОшибок)
	
	Если СписокОшибок.Найти(ТекстОшибки) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		СписокОшибок.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ПолучитьИменаФайловВыписокПИФ();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ПолучитьИменаФайловВыписокПИФ();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация   = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.Дата        = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата()), -2);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПолучитьИменаФайловВыписокПИФ();
КонецПроцедуры

&НаКлиенте
Процедура ПереименоватьФайлы(Команда)
	Сессия = НачалоСбораСтатистики();
	СписокОшибок = Новый Массив;
	
	ПутьКПапке = СтрШаблон("\\g1\shares\UK\RPI\PORTF\ПИФы\ПИФы РПИ\ЭДО ДК, БК РПИ\%1\выписки\%2 %3\%4\",
		Формат(Объект.Дата, "ДФ=yyyy"), НРег(Формат(Объект.Дата, "ДФ=ММММ")), Формат(Объект.Дата, "ДФ=yy"), Формат(Объект.Дата, "ДФ=ddММyy"));
	//ПутьКПапке = СтрШаблон("\\ap69\Developers\Сашечка\Отчеты\%1\выписки\%2 %3\%4\",
	//	Формат(Объект.Дата, "ДФ=yyyy"), НРег(Формат(Объект.Дата, "ДФ=ММММ")), Формат(Объект.Дата, "ДФ=yy"), Формат(Объект.Дата, "ДФ=ddММyy"));

	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	Если Не СуществуетКаталог(ПутьКПапке) Тогда
		СоздатьКаталог(ПутьКПапке);
	КонецЕсли;
	Если СуществуетКаталог(ПутьКПапке, СписокОшибок) Тогда
		Для Каждого СтрокаСпискаСчетов Из СписокСчетов Цикл
			Если СтрокаСпискаСчетов.Пометка Тогда
				ИмяФонда = ПолучитьНазваниеФонда(СтрокаСпискаСчетов.СчетДоверительногУправления);
				ФайлыДляКопирования = СтрРазделить(СтрокаСпискаСчетов.ИмяИсходногоФайла, ";");
				Для Каждого ИмяФайлаИсточника Из ФайлыДляКопирования Цикл
					Если НайтиФайлы(ИмяФайлаИсточника).Количество() = 0 Тогда
						ДобавитьОшибкуВСписок("Не обнаружен файл " + ИмяФайлаИсточника, СписокОшибок);
						Продолжить;
					КонецЕсли;
					Расширение = Прав(ИмяФайлаИсточника, 4);
					ЭтоПлатежки = Прав(ИмяФайлаИсточника, 7) = "reg.pdf";
					ИмяФайла = СтрШаблон("%1_%5 %2_%3%6%4", ИмяФонда, СтрокаСпискаСчетов.ПредставлениеБанка,
						Формат(Объект.Дата, "ДФ=ddММyy"), ?(СтрокаСпискаСчетов.ТранзитныйПИФ, " ТРАНЗ", ""),
						?(ЭтоПлатежки, "пп", "выписка"), ?(ВалютаУчета <> СтрокаСпискаСчетов.Валюта, " " + СтрокаСпискаСчетов.Валюта, ""));
					ИмяФайлаПолучателя = ПутьКПапке + ИмяФайла + Расширение;
					
					Попытка
						КопироватьФайл(ИмяФайлаИсточника, ИмяФайлаПолучателя);
					Исключение
						ДобавитьОшибкуВСписок("Не удалось скопировать файл """ + ИмяФайлаИсточника + """ в """ + ИмяФайлаПолучателя
							+ """. Проверьте наличие исходного файла и повторите попытку", СписокОшибок);
					КонецПопытки;
					
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СписокОшибок.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибки определения файлов! Проверьте наличие");
	КонецЕсли;
	
	ОкончаниеСбораСтатистики(Сессия);
КонецПроцедуры

&НаКлиенте
Функция ПолучитьНазваниеФонда(ИсходноеИмяФонда)
	
	ИсходноеИмяФондаВРег = ВРег(ИсходноеИмяФонда);
	Если СтрНайти(ИсходноеИмяФондаВРег, ВРег("""Алгоритм""")) <> 0 Тогда
		Возврат "Алгоритм";
	ИначеЕсли СтрНайти(ИсходноеИмяФондаВРег, ВРег("""Промышленные Инвестиции""")) <> 0 Тогда
		Возврат "ПИ";
	ИначеЕсли СтрНайти(ИсходноеИмяФондаВРег, ВРег("""Коммерческие Инвестиции""")) <> 0 Тогда
		Возврат "КИ";
	ИначеЕсли СтрНайти(ИсходноеИмяФондаВРег, ВРег("""Спортивные перспективы""")) <> 0 Тогда
		Возврат "СП";
	ИначеЕсли СтрНайти(ИсходноеИмяФондаВРег, ВРег("""Казначейский резервный""")) <> 0 Тогда
		Возврат "КР";
	КонецЕсли;
	
	ИмяФонда = СтрЗаменить(ИсходноеИмяФонда, "ЗПИФ","");
	ИмяФонда = СтрЗаменить(ИмяФонда, "ПИФ","");
	ИмяФонда = СтрЗаменить(ИмяФонда, "комбинированный","");
	ИмяФонда = СтрЗаменить(ИмяФонда, "недвижимости","");
	ИмяФонда = СтрЗаменить(ИмяФонда, """","");
	ИмяФонда = СтрЗаменить(ИмяФонда, "«","");
	ИмяФонда = СтрЗаменить(ИмяФонда, "»","");
	ИмяФонда = СтрЗаменить(ИмяФонда, " ","");
	
	Возврат ИмяФонда;
	
КонецФункции

&НаСервере
Функция НачалоСбораСтатистики()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	
	// Фиксируем запуск процедуры
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики();
	Механизм = ОтчетОбъект.Метаданные().ПолноеИмя();
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);	
	Возврат Сессия;
КонецФункции

&НаСервере
Процедура ОкончаниеСбораСтатистики(Сессия)
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Механизм = ОтчетОбъект.Метаданные().ПолноеИмя();
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
КонецПроцедуры	

&НаСервере
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики()
	
	ПараметрыОбработки = Новый Структура;
	
	ПараметрыОбработки.Вставить("Организация",						Объект.Организация);
	ПараметрыОбработки.Вставить("НачалоПериода",					Формат(Объект.Дата, "ДФ=dd.MM.yyyy"));
	
	Описание = "Организация: " + Объект.Организация + "
				|Дата: " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОбработки, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	Для Каждого ТекСтрока Из СписокСчетов Цикл
		Если ТекСтрока.ИмяИсходногоФайла <> "" Тогда
			ТекСтрока.Пометка = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
	
	Для Каждого ТекСтрока Из СписокСчетов Цикл
		ТекСтрока.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

