// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Проверка ставки размещенных депозитов на рыночность", "0.15", "", Истина);
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверитьСтавку", "Отправить отчет",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Возвращает параметры выполняемой по регламентному заданию команды для подключения к механизму регистрации работы
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды  
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды, ПараметрыКоманды)
	
	ПараметрыОтчета = Новый Соответствие();
	ПараметрыОтчета.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	ПараметрыОтчета.Вставить("Период", ЭтотОбъект.Период);

	Если ПараметрыКоманды.Свойство("Организация") Тогда
		ПараметрыОтчета.Вставить("Организация", ПараметрыКоманды.Организация);
	КонецЕсли;
	
	Если ПараметрыКоманды.Свойство("ПолучателиОповещения") Тогда
		ПараметрыОтчета.Вставить("ПолучателиОповещения", ПараметрыКоманды.ПолучателиОповещения);
	КонецЕсли;
	
	Описание = "";
	Для Каждого ПараметрОтчета Из ПараметрыОтчета Цикл
		Описание = Описание + ПараметрОтчета.Ключ + ": " + ПараметрОтчета.Значение + Символы.ПС;		
	КонецЦикла;
	Описание = Лев(Описание, СтрДлина(Описание) - СтрДлина(Символы.ПС));	
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета);
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

Процедура ВыполнитьКоманду(Метод, Экземпляры) Экспорт
	
	Если Метод = "ПроверитьСтавку" Тогда
		ТекущаяДата = НачалоДня(ТекущаяДата());
		
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
			ДатаПроверки = Справочники.Календари.ДобавитьКДатеРабочиеДниБезКэшированияРезультата(Справочники.Календари.Общероссийский, ТекущаяДата, -2);
			ПроверитьСтавку(НачалоДня(ДатаПроверки));
		Иначе
			Возврат;
		КонецЕсли;	
	Иначе
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроверитьСтавку(Дата) Экспорт
	
	ПараметрыПодключения = РаботаСоСтрокамиКлиентСервер.ПолучитьПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	СсылкаИБ = СтрШаблон("e1c://server/%1/%2", ПараметрыПодключения.Srvr, ПараметрыПодключения.Ref);
	
	ОрганизацияРЭМ = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ");

	ОповещенияПоОрганизациям = Новый Массив();
	
	СписокВозврата = ПолучитьДепозиты(Дата, ОрганизацияРЭМ);
	ДепозитыРЭМ = СписокВозврата.ТаблицаДепозитов;
	СписокСчетовДУПоКоторымНеСформированУчет = СписокВозврата.СписокСчетовДУПоКоторымНеСформированУчет;
	
	РеквизитыОповещения = Новый Структура("Организация, Период, ТекстОповещения", ОрганизацияРЭМ, ПредставлениеПериода(НачалоДня(Дата), КонецДня(Дата)), "");
	
	РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<br><p style=""font-family: Arial;font-size: 10pt;line-height: 1.13;""><span style=""font-size: 10pt;"">Дата: " + Формат(Дата, "ДФ=dd.MM.yyyy") + "</span></p>";
	РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<table border=""0"" cellspacing=""2"" CELLPADDING=2 WIDTH=""80%"" bordercolor = ""gray"" bgcolor=""#000000""><tr bgcolor=""#FFFFFF""><td><b>Счет ДУ</b></td><td><b>Депозит</b></td><td><b>Ставка по договору</b></td><td><b>ЭСП по договору</b></td><td><b>Рыночная ставка</b></td><td><b>Мин рыночная</b></td><td><b>Макс рыночная</b></td><td><b>Принимаемая ставка для учета</b></td><td><b>Корректировка ПП</b></td></tr>";
	
	Для Каждого СтрокаТаблицыДепозитов Из ДепозитыРЭМ Цикл
				
		Если Не ЗначениеЗаполнено(СтрокаТаблицыДепозитов.СтавкаЭСП) Тогда
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<tr bgcolor=""#FFFFFF"">";
		Иначе
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<tr bgcolor=""#ff6663"">";
		КонецЕсли;	
		
		СсылкаСчетДУ = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(СтрокаТаблицыДепозитов.СчетДУ);
		СсылкаАктив = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(СтрокаТаблицыДепозитов.Актив);
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td valign = ""top""><A href=""" + СсылкаСчетДУ + """>" + Строка(СтрокаТаблицыДепозитов.СчетДУ) + "</A></td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td valign = ""top""><A href=""" + СсылкаАктив + """>" + Строка(СтрокаТаблицыДепозитов.Актив) + "</A></td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top""><A href=""" + СсылкаАктив + """>" + Формат(СтрокаТаблицыДепозитов.СтавкаПоДоговору, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицыДепозитов.СтавкаЭСП, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицыДепозитов.СреднерыночнаяСтавка, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицыДепозитов.НижняяГраницаСреднерыночнойСтавки, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицыДепозитов.ВерхняяГраницаСреднерыночнойСтавки, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицыДепозитов.ПроцентПоАктиву, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицыДепозитов.КорректировкаПП, "ЧЦ=15; ЧДЦ=2; ЧН=-") + "</td>";
		
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "</tr>";
		
	КонецЦикла;
	
	РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "</table>";
	
	Если СписокСчетовДУПоКоторымНеСформированУчет.Количество() > 0 Тогда
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения +  "<br><p style=""font-family: Arial;font-size: 10pt;line-height: 1.13;"">Счета внутреннего учета по которым не сформирован учет на момент формирования отчета:</p>";
		
		Для Каждого СчетДУ Из СписокСчетовДУПоКоторымНеСформированУчет Цикл
			СсылкаСчетДУ = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(СчетДУ.Значение);
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<br><p><A href=""" + СсылкаСчетДУ + """>" + Строка(СчетДУ.Значение) + "</A></p>";
		КонецЦикла;	
	КонецЕсли;	
	
	ОповещенияПоОрганизациям.Добавить(РеквизитыОповещения);
	
	Для Каждого Оповещение Из ОповещенияПоОрганизациям Цикл
	
		Справочники.Оповещения.СформироватьОповещения("Обработка._ПроверкаСтавкиРазмещенныхДепозитовНаРыночность", Перечисления.ТипыСобытий.ВнешнийВызов, Оповещение);
	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДепозиты(Дата, Организация = Неопределено)
	
	СоответствиеВозврата = Новый Структура;
	
	ТаблицаДепозитов = Новый ТаблицаЗначений;
	ТаблицаДепозитов.Колонки.Добавить("Организация",  Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаДепозитов.Колонки.Добавить("СчетДУ",  Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаДепозитов.Колонки.Добавить("Актив",  Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады"));
	ТаблицаДепозитов.Колонки.Добавить("СтавкаПоДоговору",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("СтавкаЭСП",  Метаданные.ОпределяемыеТипы.ЭффективнаяПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("СреднерыночнаяСтавка",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("МинимальнаяСредневзвешеннаяСтавка",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("МаксимальнаяСредневзвешеннаяСтавка",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("НижняяГраницаСреднерыночнойСтавки",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("ВерхняяГраницаСреднерыночнойСтавки",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("ПроцентПоАктиву",  Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип);
	ТаблицаДепозитов.Колонки.Добавить("КорректировкаПП",  Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
	
	Запрос = Новый Запрос;
	//Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	//
	//Справочники.СчетаДоверительногоУправления.ПоместитьДействующиеСчетаДоверительногоУправленияВМенеджерВременныхТаблиц(
	//	Запрос.МенеджерВременныхТаблиц,
	//	Дата,
	//	?(ЗначениеЗаполнено(Организация), Новый Структура("Организация,", Организация), Неопределено),
	//	"СчетаДУДействующиеВПериоде"); 
	//	
	//Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	//               |	СчетаДУДействующиеВПериоде.Ссылка КАК Ссылка,
	//               |	СчетаДУДействующиеВПериоде.Ссылка.Организация КАК Организация
	//               |ИЗ
	//               |	СчетаДУДействующиеВПериоде КАК СчетаДУДействующиеВПериоде";	
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК Ссылка,
	               |	ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация КАК Организация
	               |ИЗ
	               |	Справочник.ДепозитныеВклады КАК ДепозитныеВклады
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
	               |				&Дата,
	               |				ВЫБОР
	               |						КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяССылка)
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ Организация = &Организация
	               |					КОНЕЦ
	               |					И Активный) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
	               |		ПО ДепозитныеВклады.БанковскийСчет.Договор = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор
	               |			И (НЕ ДепозитныеВклады.ПометкаУдаления)
	               |			И (ВЫБОР
	               |				КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ДепозитныеВклады.Организация = &Организация
	               |			КОНЕЦ)
	               |			И (НАЧАЛОПЕРИОДА(ДепозитныеВклады.ДатаРегистрации, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ))
	               |ГДЕ
	               |	НЕ ДепозитныеВклады.ПометкаУдаления
	               |	И ВЫБОР
	               |			КОГДА &Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ДепозитныеВклады.Организация = &Организация
	               |		КОНЕЦ
	               |	И НАЧАЛОПЕРИОДА(ДепозитныеВклады.ДатаРегистрации, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)";
	
	Запрос.УстановитьПараметр("Дата"				, Дата);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	СписокСчетовДУПоКоторымНеСформированУчет = Новый СписокЗначений;
	СписокСчетовДУПоКоторымСформированУчет = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		СтоимостиДепозитныхВкладов = РаботаСКредитнымиИнструментами.ПолучитьСтоимостиКредитныхИнструментовПоСчетуДоверительногоУправленияПоРыночнойСтавкеСУчетомПериодичностиОценки(
			Выборка.Ссылка,
			КонецДня(Дата),
			Справочники.ЦелиРасчета.ЕдиныйПланСчетов,
			Перечисления.ТипыКредитныхИнструментов.ДепозитныйВклад,,,);
			
		Для Каждого СтрокаСтоимостиДепозитныхВкладов Из СтоимостиДепозитныхВкладов Цикл
			
			Если НачалоДня(СтрокаСтоимостиДепозитныхВкладов.ДатаРегистрации) = НачалоДня(Дата) Тогда
				
				Если (СписокСчетовДУПоКоторымНеСформированУчет.НайтиПоЗначению(Выборка.Ссылка) = Неопределено) И (СписокСчетовДУПоКоторымСформированУчет.НайтиПоЗначению(Выборка.Ссылка) = Неопределено) Тогда
					ОтборДатЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.СформироватьСтруктуруОтбораДатЗапрета(Выборка.Организация, Выборка.Ссылка, Перечисления.ГруппыЗапретаРедактирования.Проводки, Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет);
					ДатыЗапретаРедактирования     = РегистрыСведений.ДатыЗапретаРедактирования.ПолучитьДатыЗапретаРедактирования(ОтборДатЗапретаРедактирования);
					ТребуетсяСнятиеЗапрета = РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьЗапретРедактирования(Дата, ДатыЗапретаРедактирования);
					
					Если Не ТребуетсяСнятиеЗапрета Тогда
						СписокСчетовДУПоКоторымНеСформированУчет.Добавить(Выборка.Ссылка);
					Иначе
						СписокСчетовДУПоКоторымСформированУчет.Добавить(Выборка.Ссылка);
					КонецЕсли;	
				КонецЕсли;
				
				НоваяСтрокаТаблицыДепозитов = ТаблицаДепозитов.Добавить();	
				НоваяСтрокаТаблицыДепозитов.Организация = Выборка.Организация;
				НоваяСтрокаТаблицыДепозитов.СчетДУ = Выборка.Ссылка;
				НоваяСтрокаТаблицыДепозитов.Актив = СтрокаСтоимостиДепозитныхВкладов.Актив;
				НоваяСтрокаТаблицыДепозитов.СтавкаПоДоговору = СтрокаСтоимостиДепозитныхВкладов.СтавкаПоДоговору;
				
				Если СокрЛП(ВРег(СтрокаСтоимостиДепозитныхВкладов.МетодРасчета)) <> "ЛИНЕЙНО" Тогда
					ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицыДепозитов, СтрокаСтоимостиДепозитныхВкладов);
					НоваяСтрокаТаблицыДепозитов.СтавкаЭСП = Окр(Справочники.ДепозитныеВклады.ПолучитьДоходностьИДюрацию(СтрокаСтоимостиДепозитныхВкладов.КредитныйИнструмент).Доходность, 2);
					НоваяСтрокаТаблицыДепозитов.КорректировкаПП = 0;
					
					Если НачалоДня(СтрокаСтоимостиДепозитныхВкладов.ДатаПроверкиНаРыночность) = НачалоДня(Дата) Тогда
						НоваяСтрокаТаблицыДепозитов.КорректировкаПП = СтрокаСтоимостиДепозитныхВкладов.ПроцентыЭСП;
					Иначе	
						
						ТаблицаДепозит = Новый ТаблицаЗначений;
						ТаблицаДепозит.Колонки.Добавить("КредитныйИнструмент",  Новый ОписаниеТипов("СправочникСсылка.ДепозитныеВклады"));
						ТаблицаДепозит.Колонки.Добавить("ВидАктива", 			Новый ОписаниеТипов("ПеречислениеСсылка.ВидыАктивовДляПроверкиНаРыночность"));
						ТаблицаДепозит.Колонки.Добавить("Номинал",         Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
						ТаблицаДепозит.Колонки.Добавить("Проценты",        Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
						ТаблицаДепозит.Колонки.Добавить("Задолженность",   Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
						
						НоваяСтрокаТаблицаДепозит = ТаблицаДепозит.Добавить();
						НоваяСтрокаТаблицаДепозит.КредитныйИнструмент 	= СтрокаСтоимостиДепозитныхВкладов.КредитныйИнструмент;
						НоваяСтрокаТаблицаДепозит.ВидАктива 			= Перечисления.ВидыАктивовДляПроверкиНаРыночность.Депозиты;
						НоваяСтрокаТаблицаДепозит.Номинал         = СтрокаСтоимостиДепозитныхВкладов.Номинал;
						НоваяСтрокаТаблицаДепозит.Проценты        = 0;
						
						ДепозитыПоРыночнойСтавке = РаботаСоСтоимостьюПоРыночнойСтавке.ПолучитьСтоимостьКредитныхИнструментовПоРыночнойСтавке(
						ТаблицаДепозит,
						Выборка.Ссылка,
						КонецДня(СтрокаСтоимостиДепозитныхВкладов.ДатаПроверкиНаРыночность),
						Справочники.ЦелиРасчета.ЕдиныйПланСчетов,
						Неопределено,
						);
						
						Для Каждого ДепозитПоРыночнойСтавке Из ДепозитыПоРыночнойСтавке Цикл
							
							Если ДепозитПоРыночнойСтавке.ПроцентыЭСП <> 0 Тогда
								
								НоваяСтрокаТаблицыДепозитов.КорректировкаПП = ДепозитПоРыночнойСтавке.ПроцентыЭСП;
								
							КонецЕсли;	
						КонецЦикла;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;

	СоответствиеВозврата.Вставить("ТаблицаДепозитов", ТаблицаДепозитов);
	СоответствиеВозврата.Вставить("СписокСчетовДУПоКоторымНеСформированУчет", СписокСчетовДУПоКоторымНеСформированУчет);
	
	Возврат СоответствиеВозврата;
	
КонецФункции

Процедура СформироватьОтчет(Дата, Результат, Организация) Экспорт
	
	// Фиксируем запуск процедуры
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьОтчет()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	Результат.Очистить();
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	Если Организация <> Справочники.Организации.ПустаяСсылка() Тогда
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		ОбластьШапка.Параметры.Организация = Организация;
		ОбластьШапка.Параметры.Дата = Дата;
		
		СписокВозврата = ПолучитьДепозиты(Дата, Организация);
		ТаблицаДепозитов = СписокВозврата.ТаблицаДепозитов;
		СписокСчетовДУПоКоторымНеСформированУчет = СписокВозврата.СписокСчетовДУПоКоторымНеСформированУчет;
		
	Иначе
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка1");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка1");
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал1");
		
		ОбластьШапка.Параметры.Дата = Дата;
		
		СписокВозврата = ПолучитьДепозиты(Дата);
		ТаблицаДепозитов = СписокВозврата.ТаблицаДепозитов;
		СписокСчетовДУПоКоторымНеСформированУчет = СписокВозврата.СписокСчетовДУПоКоторымНеСформированУчет;
		
		
		//ДепозитыРЭМ = ПолучитьДепозиты(Дата, ОрганизацияРЭМ);
		//ДепозитыТраст = ПолучитьДепозиты(Дата, ОрганизацияТраст);
		
	КонецЕсли;
	
	Результат.Вывести(ОбластьШапка);
	
	Для Каждого СтрокаТаблицыДепозитов Из ТаблицаДепозитов Цикл
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТаблицыДепозитов);
		Результат.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	Результат.Вывести(ОбластьПодвал);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры
