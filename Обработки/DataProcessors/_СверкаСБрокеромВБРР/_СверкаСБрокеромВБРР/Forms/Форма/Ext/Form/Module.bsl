КонецФункции // ПолучитьВалюту

&НаСервереБезКонтекста
Функция ПолучитьЦеннуюБумагу(Знач ЦеннаяБумагаТекст)
	
	// рег. номер ц/б содержится справа от последнего нижнего подчеркивания
	// например, "Магнит1P01_4B02-01-60525-P-001P"
	
	РегНомер = Сред(ЦеннаяБумагаТекст, СтрНайти(ЦеннаяБумагаТекст, "_", НаправлениеПоиска.СКонца) + 1);
	Если ПустаяСтрока(РегНомер) Тогда
		ВызватьИсключение "Не удалось выделить рег. номер из описания ценной бумаги '" + ЦеннаяБумагаТекст + "'";
	КонецЕсли;
	
	// у этих пидорасов русские буквы в рег. номерах
	РегНомер = СтрЗаменить(РегНомер, "А", "A");
	РегНомер = СтрЗаменить(РегНомер, "В", "B");
	РегНомер = СтрЗаменить(РегНомер, "С", "C");
	РегНомер = СтрЗаменить(РегНомер, "Е", "E");
	РегНомер = СтрЗаменить(РегНомер, "К", "");
	РегНомер = СтрЗаменить(РегНомер, "Н", "H");
	РегНомер = СтрЗаменить(РегНомер, "М", "M");
	РегНомер = СтрЗаменить(РегНомер, "О", "O");
	РегНомер = СтрЗаменить(РегНомер, "Р", "P");
	РегНомер = СтрЗаменить(РегНомер, "Т", "T");
	РегНомер = СтрЗаменить(РегНомер, "Х", "X");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Акции.Ссылка
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.ГосударственныйРегистрационныйНомер = &ГосударственныйРегистрационныйНомер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.Ссылка
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.ГосударственныйРегистрационныйНомер = &ГосударственныйРегистрационныйНомер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Паи.Ссылка
		|ИЗ
		|	Справочник.Паи КАК Паи
		|ГДЕ
		|	Паи.ГосударственныйРегистрационныйНомер = &ГосударственныйРегистрационныйНомер
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИпотечныеСертификатыУчастия.Ссылка
		|ИЗ
		|	Справочник.ИпотечныеСертификатыУчастия КАК ИпотечныеСертификатыУчастия
		|ГДЕ
		|	ИпотечныеСертификатыУчастия.ГосударственныйРегистрационныйНомер = &ГосударственныйРегистрационныйНомер";
		
	Запрос.УстановитьПараметр("ГосударственныйРегистрационныйНомер", РегНомер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если      Выборка.Количество() = 0 Тогда
		ВызватьИсключение "Не удалось определить ценную бумагу по рег. номеру '" + РегНомер + "'";
	ИначеЕсли Выборка.Количество() > 1 Тогда
		ВызватьИсключение "Найдено более одной ценной бумаги с рег. номером '" + РегНомер + "'";
	Иначе
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции // ПолучитьЦеннуюБумагу

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыСделкиПоНомеру(НомерСделки, ПараметрыОтчетаБрокера, ПараметрыСессии = Неопределено)
	
	Если Найти(НомерСделки, "В") > 0 Тогда // т.к. иногда пишется "Сделка № 000 в режиме торгов (T0)"
		НомерСделки = СокрП(Лев(НомерСделки, Найти(НомерСделки, "В") - 1));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка,
		|	Сделка.МестоХранения
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И Сделка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Сделка.Брокер = &Брокер
		|	И Сделка.НомерСделки = &НомерСделки
		|	И НЕ Сделка.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПО.МестоХранения
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Организация = &Организация
		|	И СделкаРЕПО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СделкаРЕПО.Брокер = &Брокер
		|	И (СделкаРЕПО.НомерСделки = &НомерСделки
		|			ИЛИ СделкаРЕПО.НомерСделкиСЦентральнымКонтрагентом = &НомерСделки)
		|	И СделкаРЕПО.ЧастьСделкиРЕПО = 1
		|	И НЕ СделкаРЕПО.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчетаБрокера.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОтчетаБрокера.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер", ПараметрыОтчетаБрокера.Брокер);
	Запрос.УстановитьПараметр("НомерСделки", НомерСделки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если      Выборка.Количество() = 0 Тогда
		ТекстОшибки = "Не удалось определить сделку по номеру '" + НомерСделки + "' Комиссия брокера по этой сделке не будет загружена";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
		
	ИначеЕсли Выборка.Количество() > 1 Тогда
		ТекстОшибки = "Найдено более одной сделки по номеру '" + НомерСделки + "' Комиссия брокера по этой сделке не будет загружена";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
		
	Иначе
		Выборка.Следующий();
		
		РеквизитыСделки = Новый Структура("Ссылка, МестоХранения, ЦеннаяБумага");
		ЗаполнитьЗначенияСвойств(РеквизитыСделки, Выборка);
		
		КоличествоЦенныхБумаг = Выборка.Ссылка.ЦенныеБумаги.Количество();
		Если      КоличествоЦенныхБумаг = 0 Тогда
			ТекстОшибки = "В документе '" + Выборка.Ссылка + "' (№ сделки " + НомерСделки + ") нет ценных бумаг Комиссия брокера по этой сделке не будет загружена";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат Неопределено;
		ИначеЕсли КоличествоЦенныхБумаг > 1 Тогда
			ТекстОшибки = "В документе '" + Выборка.Ссылка + "' (№ сделки " + НомерСделки + ") более одной ценной бумаги Комиссия брокера по этой сделке не будет загружена";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат Неопределено;
		КонецЕсли;
		
		РеквизитыСделки.ЦеннаяБумага = Выборка.Ссылка.ЦенныеБумаги[0].ЦеннаяБумага;
		
		Возврат РеквизитыСделки;
		
	КонецЕсли;
	
КонецФункции // ПолучитьРеквизитыСделкиПоНомеру

&НаСервереБезКонтекста
Функция ИмпортироватьКомиссиюБрокераПоСделкам(КомиссияБрокераПоСделкам, ПараметрыОтчетаБрокера)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// пометим на удаление ранее созданные начисления и оплаты
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеЗадолженности.Ссылка
		|ИЗ
		|	Документ.НачислениеЗадолженности КАК НачислениеЗадолженности
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(НачислениеЗадолженности.Дата, ДЕНЬ) = &Период
		|	И НачислениеЗадолженности.Организация = &Организация
		|	И НачислениеЗадолженности.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НачислениеЗадолженности.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|	И НачислениеЗадолженности.Брокер = &Брокер
		|	И НЕ НачислениеЗадолженности.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Оплата.Ссылка
		|ИЗ
		|	Документ.Оплата КАК Оплата
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(Оплата.Дата, ДЕНЬ) = &Период
		|	И Оплата.Организация = &Организация
		|	И Оплата.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Оплата.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|	И Оплата.Брокер = &Брокер
		|	И НЕ Оплата.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Период",                       ПараметрыОтчетаБрокера.Период);
	Запрос.УстановитьПараметр("Организация",                  ПараметрыОтчетаБрокера.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыОтчетаБрокера.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Брокер",                       ПараметрыОтчетаБрокера.Брокер);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Документ = Выборка.Ссылка.ПолучитьОбъект();
		Документ.УстановитьПометкуУдаления(Истина);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("'" + Документ + "' помечен на удаление", Документ);
	КонецЦикла;
	
	// создадим новые начисления и оплаты
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КомиссияБрокераПоСделкам.Сделка,
		|	КомиссияБрокераПоСделкам.МестоХранения КАК МестоХранения,
		|	КомиссияБрокераПоСделкам.НомерСделки КАК НомерСделки,
		|	КомиссияБрокераПоСделкам.ЦеннаяБумага,
		|	КомиссияБрокераПоСделкам.Сумма
		|ПОМЕСТИТЬ _КомиссияБрокераПоСделкам
		|ИЗ
		|	&КомиссияБрокераПоСделкам КАК КомиссияБрокераПоСделкам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КомиссияБрокераПоСделкам.Сделка,
		|	_КомиссияБрокераПоСделкам.МестоХранения КАК МестоХранения,
		|	_КомиссияБрокераПоСделкам.НомерСделки,
		|	_КомиссияБрокераПоСделкам.ЦеннаяБумага,
		|	_КомиссияБрокераПоСделкам.Сумма
		|ИЗ
		|	_КомиссияБрокераПоСделкам КАК _КомиссияБрокераПоСделкам
		|ГДЕ
		|	_КомиссияБрокераПоСделкам.Сумма > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	_КомиссияБрокераПоСделкам.НомерСделки
		|ИТОГИ ПО
		|	МестоХранения";
		
	Запрос.УстановитьПараметр("КомиссияБрокераПоСделкам", КомиссияБрокераПоСделкам.Получить());
		
	ВыборкаМестаХранения = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаМестаХранения.Следующий() Цикл
		// создадим новое поступление
		НачислениеЗадолженности = Документы.НачислениеЗадолженности.СоздатьДокумент();
		
		НачислениеЗадолженности.Дата                         = ПараметрыОтчетаБрокера.Период + 19*60*60 - 1;
		НачислениеЗадолженности.Организация                  = ПараметрыОтчетаБрокера.Организация;
		НачислениеЗадолженности.СчетДоверительногоУправления = ПараметрыОтчетаБрокера.СчетДоверительногоУправления;
		НачислениеЗадолженности.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии;
		НачислениеЗадолженности.Брокер                       = ПараметрыОтчетаБрокера.Брокер;
		НачислениеЗадолженности.МестоХранения                = ВыборкаМестаХранения.МестоХранения;
		НачислениеЗадолженности.Валюта                       = ПараметрыОтчетаБрокера.Организация.ВалютаУчета;
		НачислениеЗадолженности.Контрагент                   = ПараметрыОтчетаБрокера.Брокер.ЮрФизЛицо;
		НачислениеЗадолженности.Ответственный                = РаботаСПользователями.ТекущийПользователь();
		НачислениеЗадолженности.Комментарий                  = "Создан аппаратно-техническими средствами " + ТекущаяДата();
		
		НачислениеЗадолженности.ДатаПолученияДокумента		= НачислениеЗадолженности.Дата;
		
		// создадим новую оплату
		ОплатаЗадолженности = Документы.Оплата.СоздатьДокумент();
		
		ОплатаЗадолженности.Дата                         = ПараметрыОтчетаБрокера.Период + 19*60*60;
		ОплатаЗадолженности.Организация                  = ПараметрыОтчетаБрокера.Организация;
		ОплатаЗадолженности.СчетДоверительногоУправления = ПараметрыОтчетаБрокера.СчетДоверительногоУправления;
		ОплатаЗадолженности.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
		ОплатаЗадолженности.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии;
		ОплатаЗадолженности.Брокер                       = ПараметрыОтчетаБрокера.Брокер;
		ОплатаЗадолженности.МестоХранения                = ВыборкаМестаХранения.МестоХранения;
		ОплатаЗадолженности.ВалютаОплаты                 = ПараметрыОтчетаБрокера.Организация.ВалютаУчета;
		ОплатаЗадолженности.Контрагент  				 = ОплатаЗадолженности.Брокер.ЮрФизЛицо;
		ОплатаЗадолженности.Ответственный                = РаботаСПользователями.ТекущийПользователь();
		ОплатаЗадолженности.Комментарий                  = "Создан аппаратно-техническими средствами " + ТекущаяДата();
		
		// добавить строки в табличные части начисления задолженноси и её оплаты
		ВыборкаСделки = ВыборкаМестаХранения.Выбрать();
		Пока ВыборкаСделки.Следующий() Цикл
			НоваяСтрокаОснованияНачисления = НачислениеЗадолженности.Основания.Добавить();
			НоваяСтрокаОснованияНачисления.Основание    = ВыборкаСделки.Сделка;
			НоваяСтрокаОснованияНачисления.ЦеннаяБумага = ВыборкаСделки.ЦеннаяБумага;
			НоваяСтрокаОснованияНачисления.ДатаОплаты   = ПараметрыОтчетаБрокера.Период;
			НоваяСтрокаОснованияНачисления.Сумма        = ВыборкаСделки.Сумма;
			
			НоваяСтрокаОплаты = ОплатаЗадолженности.Основания.Добавить();
			НоваяСтрокаОплаты.Основание   = ВыборкаСделки.Сделка;
			НоваяСтрокаОплаты.Валюта      = ОплатаЗадолженности.ВалютаОплаты;
			НоваяСтрокаОплаты.Сумма       = ВыборкаСделки.Сумма;
			НоваяСтрокаОплаты.СуммаОплаты = ВыборкаСделки.Сумма;
			
		КонецЦикла;
		
		Попытка
			НачислениеЗадолженности.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ '" + НачислениеЗадолженности + "'", НачислениеЗадолженности);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать начисление комиссии брокера. Система сообщает: " + ОписаниеОшибки());
		КонецПопытки;
		
		Если НачислениеЗадолженности.Проведен Тогда
			Попытка
				ОплатаЗадолженности.Записать(РежимЗаписиДокумента.Проведение);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ '" + ОплатаЗадолженности + "'", ОплатаЗадолженности);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать оплату комиссии брокера. Система сообщает: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции // ИмпортироватьКомиссиюБрокераПоСделкам

	
&НаСервереБезКонтекста
Функция ПреобразоватьМассивСтруктурВТаблицуЗначений(КолонкиТаблицы, СодержимоеТаблицы)
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Для каждого КлючЗнач Из КолонкиТаблицы Цикл
		ТаблицаЗначений.Колонки.Добавить(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;
	
	Для каждого ЭлементСодержимоеТаблицы Из СодержимоеТаблицы Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), ЭлементСодержимоеТаблицы);
	КонецЦикла;
	
	ХранилищеТаблицы = Новый ХранилищеЗначения(ТаблицаЗначений);
	
	Возврат ХранилищеТаблицы;
	
КонецФункции // ПреобразоватьМассивСтруктурВТаблицуЗначений

