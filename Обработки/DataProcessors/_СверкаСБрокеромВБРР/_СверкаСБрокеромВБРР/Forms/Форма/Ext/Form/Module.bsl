Функция ПолучитьЗаголовокПоля(ИмяПоля, Заголовки)
	Перем ЗаголовокПоля;
	
	Если Не Заголовки.Свойство(ИмяПоля, ЗаголовокПоля) Тогда
		ЗаголовокПоля = ИмяПоля;
	КонецЕсли;
	
	Возврат ЗаголовокПоля;
	
КонецФункции // ПолучитьЗаголовокПоля


&НаСервере
Процедура ЗаполнитьОтчетОСверкеНаСервере(Данные, Отчет)
	
	Отчет.Очистить();
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетОРасхождениях");
	
	// заголовок отчета
	Область = Макет.ПолучитьОбласть("ЗаголовокОтчета");
	Область.Параметры.ЗаголовокОтчета = Данные.ЗаголовокОтчета;
	
	Отчет.Вывести(Область);
	
	// параметры отчета
	Область = Макет.ПолучитьОбласть("ПараметрыОтчета");
	
	Для каждого КлючЗнач Из Данные.ПараметрыОтчета Цикл
		Область.Параметры.ИмяПараметра      = ПолучитьЗаголовокПоля(КлючЗнач.Ключ, Данные.Заголовки);
		Область.Параметры.ЗначениеПараметра = КлючЗнач.Значение;
		Отчет.Вывести(Область);
	КонецЦикла;
	
	// наборы данных
	Для каждого НаборДанных Из Данные.НаборыДанных Цикл
		Область = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		Область.Параметры.ЗаголовокТаблицы = НаборДанных.Заголовок;
		Отчет.Вывести(Область);
		
		// отобразим шапку
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|ПустаяКолонка");
		Отчет.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|Измерение");
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина) Цикл
			Область.Параметры.Заголовок = ПолучитьЗаголовокПоля(Поле, Данные.Заголовки);
			Отчет.Присоединить(Область);
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ШапкаТаблицы|Ресурсы");
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
			Область.Параметры.Заголовок = ПолучитьЗаголовокПоля(Поле, Данные.Заголовки);
			Отчет.Присоединить(Область);
		КонецЦикла;
		
		// подготовим запрос для сравнения и выборки расхождений
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("ДанныеВнешнейСистемы", НаборДанных.ДанныеВнешнейСистемы.Получить());
		Для каждого КлючЗнач Из Данные.ПараметрыОтчета Цикл
			Запрос.УстановитьПараметр(КлючЗнач.Ключ, КлючЗнач.Значение);
		КонецЦикла;
		
		Запрос.Текст = СтрЗаменить(НаборДанных.ДанныеУчетнойСистемы, "ИЗ", "ПОМЕСТИТЬ _ДанныеУчетнойСистемы" + Символы.ПС + "ИЗ") +
			"
			|;
			|
			|////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДанныеВнешнейСистемы.*
			|ПОМЕСТИТЬ _ДанныеВнешнейСистемыРазвернутые
			|ИЗ
			|	&ДанныеВнешнейСистемы КАК ДанныеВнешнейСистемы
			|;
			|
			|////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&КлючевыеПоля,
			|	&СуммыРесурсов
			|ПОМЕСТИТЬ _ДанныеВнешнейСистемы
			|ИЗ
			|	_ДанныеВнешнейСистемыРазвернутые КАК _ДанныеВнешнейСистемыРазвернутые
			|СГРУППИРОВАТЬ ПО
			|	&КлючевыеПоля
			|;
			|
			|////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&СводныеКлючевыеПоля,
			|	&СводныеРесурсы,
			|	&УсловияПоискаРасхождения
			|ИЗ
			|	_ДанныеУчетнойСистемы КАК _ДанныеУчетнойСистемы
			|	ПОЛНОЕ СОЕДИНЕНИЕ _ДанныеВнешнейСистемы КАК _ДанныеВнешнейСистемы
			|	ПО &УсловиеСоединенияКлючевыхПолей
			|ГДЕ
			|	&УсловияПоискаРасхождений";
			
		КлючевыеПоля = "";
		СуммыРесурсов = "";
		СводныеКлючевыеПоля = "";
		СводныеРесурсы = "";
		УсловиеСоединенияКлючевыхПолей = "";
		УсловияПоискаРасхождения = "";
		УсловияПоискаРасхождений = "";
				
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина) Цикл
			КлючевыеПоля = КлючевыеПоля
				+ ?(ПустаяСтрока(КлючевыеПоля), "", "," + Символы.ПС + Символы.Таб)
				+ Поле;
			
			СводныеКлючевыеПоля = СводныеКлючевыеПоля
				+ ?(ПустаяСтрока(СводныеКлючевыеПоля), "", "," + Символы.ПС + Символы.Таб)
				+ СтрЗаменить("ЕСТЬNULL(_ДанныеУчетнойСистемы.%1, _ДанныеВнешнейСистемы.%1) КАК %1", "%1", Поле);
				
			УсловиеСоединенияКлючевыхПолей = УсловиеСоединенияКлючевыхПолей
				+ ?(ПустаяСтрока(УсловиеСоединенияКлючевыхПолей), "", " И ")
				+ СтрЗаменить("_ДанныеУчетнойСистемы.%1 = _ДанныеВнешнейСистемы.%1", "%1", Поле);
		КонецЦикла;
		
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
			СуммыРесурсов = СуммыРесурсов
				+ ?(ПустаяСтрока(СуммыРесурсов), "", "," + Символы.ПС + Символы.Таб)
				+ СтрЗаменить("СУММА(%1) КАК %1", "%1", Поле);
				
			СводныеРесурсы = СводныеРесурсы
				+ ?(ПустаяСтрока(СводныеРесурсы), "", "," + Символы.ПС + Символы.Таб)
				+ СтрЗаменить("_ДанныеУчетнойСистемы.%1 КАК %1УчетнойСистемы", "%1", Поле)
				+ "," + Символы.ПС + Символы.Таб + СтрЗаменить("_ДанныеВнешнейСистемы.%1 КАК %1ВнешнейСистемы", "%1", Поле);
				
		КонецЦикла;
		
		Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
			УсловияПоискаРасхождения = УсловияПоискаРасхождения
				+ ?(ПустаяСтрока(УсловияПоискаРасхождения), "", " ИЛИ ")
				+ СтрЗаменить("(ЕСТЬNULL(_ДанныеУчетнойСистемы.%1, 0) <> ЕСТЬNULL(_ДанныеВнешнейСистемы.%1, 0))", "%1", Поле);
		КонецЦикла;
		УсловияПоискаРасхождения = "ВЫБОР КОГДА " + УсловияПоискаРасхождения + " ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Расхождение";
		
		УсловияПоискаРасхождений = "ИСТИНА";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлючевыеПоля", КлючевыеПоля);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СуммыРесурсов", СуммыРесурсов);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СводныеКлючевыеПоля", СводныеКлючевыеПоля);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СводныеРесурсы", СводныеРесурсы);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединенияКлючевыхПолей", УсловиеСоединенияКлючевыхПолей);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияПоискаРасхождения", УсловияПоискаРасхождения);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияПоискаРасхождений", УсловияПоискаРасхождений);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Область = Макет.ПолучитьОбласть("СтрокаТаблицы|ПустаяКолонка");
			Отчет.Вывести(Область);
			
			Область = Макет.ПолучитьОбласть("СтрокаТаблицы|Измерение");
			Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.КлючевыеПоля, ",", Истина, Истина) Цикл
				Область.Параметры.Значение = Выборка[Поле];
				Отчет.Присоединить(Область);
			КонецЦикла;
			
			ОбластьБезРасхождений = Макет.ПолучитьОбласть("СтрокаТаблицы|Ресурсы");
			ОбластьСРасхождениями = Макет.ПолучитьОбласть("СтрокаТаблицыРасхождения|Ресурсы");
			Для каждого Поле Из РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборДанных.Ресурсы, ",", Истина, Истина) Цикл
				Если Выборка.Расхождение Тогда
					Область = ОбластьСРасхождениями;
				Иначе
					Область = ОбластьБезРасхождений;
				КонецЕсли;
				
				Область.Параметры.ЗначениеУчетнойСистемы = Выборка[Поле + "УчетнойСистемы"];
				Область.Параметры.ЗначениеВнешнейСистемы = Выборка[Поле + "ВнешнейСистемы"];
				Отчет.Присоединить(Область);
			КонецЦикла;
		КонецЦикла;
			
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьОтчетОСверкеНаСервере


&НаКлиенте
Функция Подстрока(Знач СтрокаТекст, Знач ПозицияС = 1, Знач ПозицияПо = 0)
	
	Если ПозицияПо = 0 Тогда
		ПозицияПо = СтрДлина(СтрокаТекст);
	КонецЕсли;
	
	Возврат Сред(СтрокаТекст, ПозицияС, ПозицияПо - ПозицияС + 1);
	
КонецФункции // Подстрока

&НаКлиенте
Функция НормализоватьПробелы(Знач СтрокаТекст)
	
	Пока Найти(СтрокаТекст, "  ") > 0 Цикл
		СтрокаТекст = СтрЗаменить(СтрокаТекст, "  ", "");
	КонецЦикла;
	
	Возврат СтрокаТекст;
	
КонецФункции // НормализоватьПробелы

&НаКлиенте
Функция ПреобразоватьВЧисло(Знач СтрокаЧисло)
	
	Возврат Число(СтрЗаменить(СтрокаЧисло, ",", ""));
	
КонецФункции // ПреобразоватьВЧисло


&НаКлиенте
Функция НайтиЗаголовкиТаблицОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицыДенежныхСредств, ПозицияЗаголовкаТаблицыЦенныхБумаг, ПлозицияЗаголовкаТаблицыСделок, ПараметрыСессии = Неопределено)
	
	КлючТаблицыДенежныхСредств = "СОСТОЯНИЕ ЛИЦЕВОГО СЧЕТА КЛИЕНТА";
	КлючТаблицыЦенныхБумаг     = "ДВИЖЕНИЕ ПО ДЕПОЗИТАРНОМУ СЧЕТУ КЛИЕНТА";
	КлючТаблицыСделок          = "РЕЕСТР СДЕЛОК";
	
	ПозицияЗаголовкаТаблицыДенежныхСредств = 0;
	ПозицияЗаголовкаТаблицыЦенныхБумаг = 0;
	ПлозицияЗаголовкаТаблицыСделок = 0;
	
	Для НомСтр = 1 По ТекстОтчета.КоличествоСтрок() Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Найти(ТекСтрокаОтчета, КлючТаблицыДенежныхСредств) = 1 Тогда
			Если ПозицияЗаголовкаТаблицыДенежныхСредств = 0 Тогда
				ПозицияЗаголовкаТаблицыДенежныхСредств = НомСтр;
			Иначе
				ТекстОшибки = "Ошибка формата файла: найдено более одной таблицы с состояниями лицевых счетов";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
			
		ИначеЕсли Найти(ТекСтрокаОтчета, КлючТаблицыЦенныхБумаг) = 1 Тогда
			Если ПозицияЗаголовкаТаблицыЦенныхБумаг = 0 Тогда
				ПозицияЗаголовкаТаблицыЦенныхБумаг = НомСтр;
			Иначе
				ТекстОшибки = "Ошибка формата файла: найдено более одной таблицы с движениями по депозитарному счету";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
			
		ИначеЕсли Найти(ТекСтрокаОтчета, КлючТаблицыСделок) = 1 Тогда
			Если ПлозицияЗаголовкаТаблицыСделок = 0 Тогда
				ПлозицияЗаголовкаТаблицыСделок = НомСтр;
			Иначе
				ТекстОшибки = "Ошибка формата файла: найдено более одной таблицы сделок";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // НайтиЗаголовкиТаблицОтчета

&НаКлиенте
Функция НайтиГраницыКолонокТаблицыОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицы)
	
	ГраницыКолонок = Неопределено;
	
	// в заголовках таблицы встречаются объединенные ячейки; чтобы их не учитывать будем искать
	// две последовательно расположенные строки с одинаковыми границами или по последней строке
	// если таких не будет найдено
	
	Для НомСтр = ПозицияЗаголовкаТаблицы + 1 По ТекстОтчета.КоличествоСтрок() Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Лев(ТекСтрокаОтчета, 1) = ЭтаФорма.ПризнакКонцаТаблицы Тогда
			Прервать;
		КонецЕсли;
		
		Если Не СтрНачинаетсяС(ТекСтрокаОтчета, ЭтаФорма.РазделительКолонок) Или Не СтрЗаканчиваетсяНа(ТекСтрокаОтчета, ЭтаФорма.РазделительКолонок) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ГраницыКолонок = Неопределено Тогда
			// создадим массив раздилителей
			ГраницыКолонок = Новый Массив;
			Для Инд = 1 По СтрЧислоВхождений(ТекСтрокаОтчета, ЭтаФорма.РазделительКолонок) Цикл
				ГраницыКолонок.Добавить(СтрНайти(ТекСтрокаОтчета, ЭтаФорма.РазделительКолонок,,, Инд));
			КонецЦикла;
			
		Иначе
			// проверим, соответствуют ли разделители текущей строки ранее заполненному массив,
			// для чего получим массив разделителей из текущей строки
			ГраницыКолонокСледСтроки = Новый Массив;
			Для Инд = 1 По СтрЧислоВхождений(ТекСтрокаОтчета, ЭтаФорма.РазделительКолонок) Цикл
				ГраницыКолонокСледСтроки.Добавить(СтрНайти(ТекСтрокаОтчета, ЭтаФорма.РазделительКолонок,,, Инд));
			КонецЦикла;
			
			// сравним два массива
			Если ГраницыКолонок.Количество() <> ГраницыКолонокСледСтроки.Количество() Тогда
				ГраницыКолонок = Неопределено;
			Иначе
				Для каждого ГраницаКолонки Из ГраницыКолонок Цикл
					Если ГраницыКолонокСледСтроки.Найти(ГраницаКолонки) = Неопределено Тогда
						ГраницыКолонок = Неопределено;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ГраницыКолонок <> Неопределено Тогда // найдена вторая строка, совпадающая с первой
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ГраницыКолонок;
	
КонецФункции // НайтиГраницыКолонокТаблицыОтчета

&НаКлиенте
Функция ПолучитьЗначенияКолонокСтрокиОтчета(СтрокаОтчета, ГраницыКолонокТаблицыОтчета)
	
	ЗначенияКолонокСтрокиОтчета = Новый Массив;
	
	Для Инд = 0 По ГраницыКолонокТаблицыОтчета.ВГраница() - 1 Цикл
		ПозицияЛевойГраницыКолонки  = ГраницыКолонокТаблицыОтчета[Инд];
		ПозицияПравойГраницыКолонки = ГраницыКолонокТаблицыОтчета[Инд + 1];
		
		ЗначенияКолонокСтрокиОтчета.Добавить(СокрЛП(Подстрока(СтрокаОтчета, ПозицияЛевойГраницыКолонки + 1, ПозицияПравойГраницыКолонки - 1)));
	КонецЦикла;

	Возврат ЗначенияКолонокСтрокиОтчета;
	
КонецФункции // ПолучитьЗначенияКолонокСтрокиОтчета

&НаКлиенте
Функция ПолучитьЗначенияКолонокОтчета(ТекстОтчета, ГраницыКолонокТаблицыОтчета, НомСтр)
	
	Если Сред(ТекстОтчета.ПолучитьСтроку(НомСтр), ГраницыКолонокТаблицыОтчета[0], 1) <> РазделительКолонок Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// сначала получим значения из самой строки
	ЗначенияКолонокОтчета = ПолучитьЗначенияКолонокСтрокиОтчета(ТекстОтчета.ПолучитьСтроку(НомСтр), ГраницыКолонокТаблицыОтчета);
		
	// деление таблицы на строки в этих ацких таблицах отсутствует как класс: текст между строками может
	// идти сплошняком по всей колонке, а что это перенос значения или начало новой строки - хер знает
	// для борьбы с этим безобразием эмпирическим путем выделяем колонку (удовлетворяет № 2), в которой
	// переносов вроде бы быть не должно и работаем с ней
	ИндКолБезПереносов = 1; // т.к. нумерация колонок начинается с 0
	
	Если НомСтр < ТекстОтчета.КоличествоСтрок() Тогда
		Пока Истина Цикл
			СледСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр + 1);
			Если Лев(СледСтрокаОтчета, 1) <> ЭтаФорма.РазделительКолонок И Прав(СледСтрокаОтчета, 1) <> ЭтаФорма.РазделительКолонок Тогда
				Прервать;
			КонецЕсли;
			
			ЗначенияКолонокСледСтрокиОтчета = ПолучитьЗначенияКолонокСтрокиОтчета(СледСтрокаОтчета, ГраницыКолонокТаблицыОтчета);
			
			// считаем, что все значения, в которых значение колонки без переноса не заполнены,
			// относятся к предыдущей строке
			Если Не ПустаяСтрока(ЗначенияКолонокСледСтрокиОтчета[ИндКолБезПереносов]) Тогда
				Прервать;
			Иначе
				Для Инд = 0 По ЗначенияКолонокОтчета.Количество() - 1 Цикл
					ЗначенияКолонокОтчета[Инд] = ЗначенияКолонокОтчета[Инд] + ЗначенияКолонокСледСтрокиОтчета[Инд];
				КонецЦикла;
			
				НомСтр = НомСтр + 1
			КонецЕсли;			
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЗначенияКолонокОтчета;
	
КонецФункции // ПолучитьЗначенияКолонокОтчета


&НаКлиенте
Функция ДесериализоватьПараметрыОтчетаБрокера(ТекстОтчета, ПараметрыСессии = Неопределено)
	
	ПараметрыОтчетаБрокера = Новый Структура("Организация, Брокер, ФайлОтчета, ДатаОтчета, СчетДоверительногоУправления, НачалоПериодаОтчета, КонецПериодаОтчета",
		Объект.Организация, ЭтаФорма.Брокер, ТекстОтчета.ИспользуемоеИмяФайла);
		
	КлючСтрокиДатаОтчета     = "ОТЧЕТ ОТ";
	КлючСтрокиНомерДоговора  = "К ДОГОВОРУ ОБ ОКАЗАНИИ БРОКЕРСКИХ УСЛУГ №";
	КлючСтрокиПериодОтчетаС  = "ОТЧЕТ ЗА ПЕРИОД С";
	КлючСтрокиПериодОтчетаПо = "ПО";
		
	Для НомСтр = 1 По 5 Цикл
		СтрокаОтчетНорм = НормализоватьПробелы(ТекстОтчета.ПолучитьСтроку(НомСтр));
		
		Если      СтрНачинаетсяС(СтрокаОтчетНорм, КлючСтрокиДатаОтчета) Тогда
			ПараметрыОтчетаБрокера.ДатаОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Сред(СтрокаОтчетНорм, СтрДлина(КлючСтрокиДатаОтчета) + 2));
			
		ИначеЕсли СтрНачинаетсяС(СтрокаОтчетНорм, КлючСтрокиНомерДоговора) Тогда
			НомерДоговора = Сред(СтрокаОтчетНорм, СтрДлина(КлючСтрокиНомерДоговора) + 2);
			
			ПараметрыОтчетаБрокера.СчетДоверительногоУправления = НайтиКлиентаПоНомеруДоговораСБрокером(ПараметрыОтчетаБрокера.Брокер, НомерДоговора, ПараметрыОтчетаБрокера.Организация, ПараметрыОтчетаБрокера.ДатаОтчета);
			Если Не ЗначениеЗаполнено(ПараметрыОтчетаБрокера.СчетДоверительногоУправления) Тогда
				ТекстОшибки = "Не удалось определить клиента по номеру договора '" + НомерДоговора + "'";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат Неопределено;
			КонецЕсли;
			
		ИначеЕсли СтрНачинаетсяС(СтрокаОтчетНорм, КлючСтрокиПериодОтчетаС) Тогда
			ПараметрыОтчетаБрокера.НачалоПериодаОтчета = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Сред(СтрокаОтчетНорм, СтрДлина(КлючСтрокиПериодОтчетаС) + 2, Найти(СтрокаОтчетНорм, КлючСтрокиПериодОтчетаПо) - СтрДлина(КлючСтрокиПериодОтчетаС) - 2));
			ПараметрыОтчетаБрокера.КонецПериодаОтчета  = КонецДня(РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(Сред(СтрокаОтчетНорм, Найти(СтрокаОтчетНорм, КлючСтрокиПериодОтчетаПо) + СтрДлина(КлючСтрокиПериодОтчетаПо) + 1)));

		КонецЕсли;
		
	КонецЦикла;	
		
	Если      Не ЗначениеЗаполнено(ПараметрыОтчетаБрокера.ДатаОтчета) Тогда
		ТекстОшибки = "Ошибка формата файла: не удалось определить дату отчета";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыОтчетаБрокера.СчетДоверительногоУправления) Тогда
		ТекстОшибки = "Ошибка формата файла: не удалось определить номер договора с брокером";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыОтчетаБрокера.НачалоПериодаОтчета) Или Не ЗначениеЗаполнено(ПараметрыОтчетаБрокера.КонецПериодаОтчета) Тогда
		ТекстОшибки = "Ошибка формата файла: не удалось определить период отчета";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПараметрыОтчетаБрокера;
	
КонецФункции // ДесериализоватьПараметрыОтчетаБрокера

&НаКлиенте
Функция ДесериализоватьОстаткиДенежныхСредств(ТекстОтчета, ПозицияЗаголовкаТаблицы)
	
	СтрокаОстаткиДенежныхСредствШаблон = Новый ФиксированнаяСтруктура("Валюта, СуммаНачальныйОстаток, СуммаКонечныйОстаток");
	ОстаткиДенежныхСредств = Новый Массив;
		
	ГраницыКолонокТаблицыОтчета = НайтиГраницыКолонокТаблицыОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицы);
	Если ГраницыКолонокТаблицыОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КлючВходящийОстатка  = "ВХОДЯЩИЙ ОСТАТОК";
	КлючИсходящийОстаток = "ИСХОДЯЩИЙ ОСТАТОК";
	
	Для НомСтр = ПозицияЗаголовкаТаблицы + 1 По ТекстОтчета.КоличествоСтрок() Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Лев(ТекСтрокаОтчета, 1) = ЭтаФорма.ПризнакКонцаТаблицы Тогда
			Прервать;
		КонецЕсли;
		
		ЗначенияКолонок = Неопределено;
		
		Если      СтрНайти(ТекСтрокаОтчета, КлючВходящийОстатка) > 0 Тогда
			ЗначенияКолонок = ПолучитьЗначенияКолонокОтчета(ТекстОтчета, ГраницыКолонокТаблицыОтчета, НомСтр);
			ТипСуммы        = "СуммаНачальныйОстаток";
		ИначеЕсли СтрНайти(ТекСтрокаОтчета, КлючИсходящийОстаток) > 0 Тогда
			ЗначенияКолонок = ПолучитьЗначенияКолонокОтчета(ТекстОтчета, ГраницыКолонокТаблицыОтчета, НомСтр);
			ТипСуммы        = "СуммаКонечныйОстаток";
		Иначе
			Продолжить;
		КонецЕсли;
		
		// ключевые поля могут содержаться и в других колонках других таблиц
		Если Не СтрНачинаетсяС(ЗначенияКолонок[0], КлючВходящийОстатка) И Не СтрНачинаетсяС(ЗначенияКолонок[0], КлючИсходящийОстаток) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОстаткиДенежныхСредств = Новый Структура(СтрокаОстаткиДенежныхСредствШаблон);
		СтрокаОстаткиДенежныхСредств["Валюта"] = ПолучитьВалюту(Сред(ЗначенияКолонок[0], Найти(ЗначенияКолонок[0], ",") + 2));
		СтрокаОстаткиДенежныхСредств[ТипСуммы] = ПреобразоватьВЧисло(ЗначенияКолонок[1]);
		
		ОстаткиДенежныхСредств.Добавить(СтрокаОстаткиДенежныхСредств);
		
	КонецЦикла;
	
	ОстаткиДенежныхСредств = ПреобразоватьМассивСтруктурВТаблицуЗначений(
		ПолучитьСтруктуруТаблицыОстатковДенежныхСредств(), ОстаткиДенежныхСредств);
		
	Возврат ОстаткиДенежныхСредств;
	
КонецФункции // ДесериализоватьОстаткиДенежныхСредств

&НаКлиенте
Функция ДесериализоватьОстаткиЦенныхБумаг(ТекстОтчета, ПозицияЗаголовкаТаблицы)
	
	СтрокаОстаткиЦенныхБумагШаблон = Новый ФиксированнаяСтруктура("ЦеннаяБумага, КоличествоНачальныйОстаток, КоличествоКонечныйОстаток");
	ОстаткиЦенныхБумаг = Новый Массив;
		
	ГраницыКолонокТаблицыОтчета = НайтиГраницыКолонокТаблицыОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицы);
	Если ГраницыКолонокТаблицыОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбработанЗаголовокТаблицы = Ложь;
	
	Для НомСтр = ПозицияЗаголовкаТаблицы + 1 По ТекстОтчета.КоличествоСтрок() Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Лев(ТекСтрокаОтчета, 1) = ЭтаФорма.ПризнакКонцаТаблицы Тогда
			Прервать;
		КонецЕсли;
		
		ЗначенияКолонок = ПолучитьЗначенияКолонокОтчета(ТекстОтчета, ГраницыКолонокТаблицыОтчета, НомСтр);
		Если ЗначенияКолонок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ОбработанЗаголовокТаблицы Тогда
			ОбработанЗаголовокТаблицы = Истина;
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(ЗначенияКолонок[0]) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОстаткиЦенныхБумаг = Новый Структура(СтрокаОстаткиЦенныхБумагШаблон);
		СтрокаОстаткиЦенныхБумаг.ЦеннаяБумага               = ПолучитьЦеннуюБумагу(ЗначенияКолонок[0]);
		СтрокаОстаткиЦенныхБумаг.КоличествоНачальныйОстаток = ПреобразоватьВЧисло(ЗначенияКолонок[1]);
		СтрокаОстаткиЦенныхБумаг.КоличествоКонечныйОстаток  = ПреобразоватьВЧисло(ЗначенияКолонок[4]);
		
		ОстаткиЦенныхБумаг.Добавить(СтрокаОстаткиЦенныхБумаг);
		
	КонецЦикла;
	
	ОстаткиЦенныхБумаг = ПреобразоватьМассивСтруктурВТаблицуЗначений(
		ПолучитьСтруктуруТаблицыОстатковЦенныхБумаг(), ОстаткиЦенныхБумаг);
	
	Возврат ОстаткиЦенныхБумаг;	
	
КонецФункции // ДесериализоватьОстаткиЦенныхБумаг

&НаКлиенте
Функция ДесериализоватьКомиссиюБрокераПоСделкам(ТекстОтчета, ПозицияЗаголовкаТаблицы, ПараметрыОтчетаБрокера, ПараметрыСессии = Неопределено)
	
	СтрокаКомиссияБрокераПоСделкамШаблон = Новый ФиксированнаяСтруктура("НомерСделки, Сделка, МестоХранения, ЦеннаяБумага, Сумма");
	КомиссияБрокераПоСделкам = Новый Массив;
		
	ГраницыКолонокТаблицыОтчета = НайтиГраницыКолонокТаблицыОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицы);
	Если ГраницыКолонокТаблицыОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// в последней колонкесодержится номер сделки, так что колонок должно быть строго 18
	Если ГраницыКолонокТаблицыОтчета.Количество() <> 19 Тогда
		ТекстОшибки = "Ошибка десериализации реестра сделок Количество колонок таблицы отлично от 18";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
	КонецЕсли;
	
	КлючНомераСделки = "СДЕЛКА №";
	
	Для НомСтр = ПозицияЗаголовкаТаблицы + 1 По ТекстОтчета.КоличествоСтрок() Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(НомСтр);
		
		Если Лев(ТекСтрокаОтчета, 1) = ЭтаФорма.ПризнакКонцаТаблицы Тогда
			Прервать;
		КонецЕсли;
		
		Если Найти(ТекСтрокаОтчета, КлючНомераСделки) = 0 Тогда
			Продолжить;
		КонецЕсли;
			
		ЗначенияКолонок = ПолучитьЗначенияКолонокОтчета(ТекстОтчета, ГраницыКолонокТаблицыОтчета, НомСтр);
		Если ЗначенияКолонок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Найти(ЗначенияКолонок[17], КлючНомераСделки) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаКомиссияБрокераПоСделкам = Новый Структура(СтрокаКомиссияБрокераПоСделкамШаблон);
		СтрокаКомиссияБрокераПоСделкам.НомерСделки = СокрЛП(Сред(ЗначенияКолонок[17], СтрДлина(КлючНомераСделки) + 1));
		
		РеквизитыСделки = ПолучитьРеквизитыСделкиПоНомеру(СтрокаКомиссияБрокераПоСделкам.НомерСделки, ПараметрыОтчетаБрокера, ПараметрыСессии);
		Если РеквизитыСделки <> Неопределено Тогда
			СтрокаКомиссияБрокераПоСделкам.Сделка        = РеквизитыСделки.Ссылка;
			СтрокаКомиссияБрокераПоСделкам.МестоХранения = РеквизитыСделки.МестоХранения;
			СтрокаКомиссияБрокераПоСделкам.ЦеннаяБумага  = РеквизитыСделки.ЦеннаяБумага;
			СтрокаКомиссияБрокераПоСделкам.Сумма         = ПреобразоватьВЧисло(ЗначенияКолонок[15]);
		
			КомиссияБрокераПоСделкам.Добавить(СтрокаКомиссияБрокераПоСделкам);
		КонецЕсли;
		
	КонецЦикла;
	
	КомиссияБрокераПоСделкам = ПреобразоватьМассивСтруктурВТаблицуЗначений(
		ПолучитьСтруктуруТаблицыКомиссииБрокера(), КомиссияБрокераПоСделкам);
		
	Возврат КомиссияБрокераПоСделкам;
	
КонецФункции // ДесериализоватьКомиссиюБрокераПоСделкам

&НаКлиенте
Функция ОбработатьТекстОтчета(ИмяФайлОтчета, ПараметрыСессии = Неопределено)
		
	Файл = Новый Файл(ИмяФайлОтчета);
	Если Не Файл.Существует() Тогда
		ТекстОшибки = "Указанный файл не найден Возможно он был удален или перемещен";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, "ФайлОтчетаБрокера");
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстОтчета = Новый ТекстовыйДокумент;
	ТекстОтчета.Прочитать(ИмяФайлОтчета);
	ТекстОтчета.ИспользуемоеИмяФайла = ИмяФайлОтчета;
	
	// первичная обработка текста отчета
	Для Инд = -ТекстОтчета.КоличествоСтрок() По -1 Цикл
		ТекСтрокаОтчета = ТекстОтчета.ПолучитьСтроку(-Инд);
		Если ПустаяСтрока(ТекСтрокаОтчета) Тогда
			ТекстОтчета.УдалитьСтроку(-Инд);
		Иначе
			ТекстОтчета.ЗаменитьСтроку(-Инд, СокрЛП(ВРег(ТекСтрокаОтчета)));
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстОтчета;
	
КонецФункции // ОбработатьТекстОтчета


&НаКлиенте
Процедура ОбработатьОтчетыБрокера(Команда, ПараметрыСессии)
	Перем ПозицияЗаголовкаТаблицыДенежныхСредств, ПозицияЗаголовкаТаблицыЦенныхБумаг, ПозицияЗаголовкаТаблицыСделок;
	
	// пока считаем, что сверка идет только на дату, т.е. период отчета должен совпадать с датой сверки
	Для каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		
		Если Не СтрокаФайлыОтчетов.Выбран Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстОтчета = ОбработатьТекстОтчета(СтрокаФайлыОтчетов.ИмяФайла, ПараметрыСессии);
		Если ТекстОтчета = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		// пошла десериализация
		ПараметрыОтчетаБрокера = ДесериализоватьПараметрыОтчетаБрокера(ТекстОтчета, ПараметрыСессии);
		Если ПараметрыОтчетаБрокера = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ПараметрыОтчетаБрокера.НачалоПериодаОтчета <> ЭтаФорма.ДатаСверки
			Или НачалоДня(ПараметрыОтчетаБрокера.КонецПериодаОтчета) <> ЭтаФорма.ДатаСверки
		Тогда
			ТекстОшибки = "Отчет '" + СтрокаФайлыОтчетов.ИмяФайла + "' не содержит данных за дату " + Формат(ЭтаФорма.ДатаСверки, "ДФ=dd.MM.yyyy");
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		Если Команда = ЭтаФорма.Команды.КомандаСверить Тогда
			Если Не НайтиЗаголовкиТаблицОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицыДенежныхСредств, ПозицияЗаголовкаТаблицыЦенныхБумаг, ПозицияЗаголовкаТаблицыСделок, ПараметрыСессии) Тогда
				Возврат;
			КонецЕсли;
			
			Если      ПозицияЗаголовкаТаблицыДенежныхСредств = 0 Тогда
				ТекстОшибки = "Ошибка формата файла: не удалось найти таблицу с состоянием лицевого счета клиента";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			ИначеЕсли ПозицияЗаголовкаТаблицыЦенныхБумаг = 0 Тогда
				ТекстОшибки = "Ошибка формата файла: не удалось найти таблицу с движениями по депозитарному счету";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
			
			ОстаткиДенежныхСредств = ДесериализоватьОстаткиДенежныхСредств(ТекстОтчета, ПозицияЗаголовкаТаблицыДенежныхСредств);
			Если ОстаткиДенежныхСредств = Неопределено Тогда
				ТекстОшибки = "Не удалось прочитать таблицу остатков денежных средств";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
			
			ОстаткиЦенныхБумаг = ДесериализоватьОстаткиЦенныхБумаг(ТекстОтчета, ПозицияЗаголовкаТаблицыЦенныхБумаг);
			Если ОстаткиЦенныхБумаг = Неопределено Тогда
				ТекстОшибки = "Не удалось прочитать таблицу остатков ценных бумаг";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
			
			// текущие данные для сравнения будем выбирать запросами
			НаборОстаткиДенежныхСредств = Новый Структура;
			НаборОстаткиДенежныхСредств.Вставить("Заголовок", "Остатки денежных средств");
			НаборОстаткиДенежныхСредств.Вставить("КлючевыеПоля", "Валюта");
			НаборОстаткиДенежныхСредств.Вставить("Ресурсы", "СуммаНачальныйОстаток, СуммаКонечныйОстаток");
			НаборОстаткиДенежныхСредств.Вставить("ДанныеВнешнейСистемы", ОстаткиДенежныхСредств);
			НаборОстаткиДенежныхСредств.Вставить("ДанныеУчетнойСистемы", 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОстаткиДенежныхСредствОстаткиИОбороты.Валюта,
				|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаНачальныйОстаток,
				|	ОстаткиДенежныхСредствОстаткиИОбороты.СуммаКонечныйОстаток
				|ИЗ
				|	РегистрНакопления.ОстаткиДенежныхСредств.ОстаткиИОбороты(
				|			&НачалоПериодаОтчета,
				|			&КонецПериодаОтчета,
				|			Период,
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И Брокер = &Брокер) КАК ОстаткиДенежныхСредствОстаткиИОбороты");
				
				
			НаборОстаткиЦенныхБумаг = Новый Структура;
			НаборОстаткиЦенныхБумаг.Вставить("Заголовок", "Остатки ценных бумаг");
			НаборОстаткиЦенныхБумаг.Вставить("КлючевыеПоля", "ЦеннаяБумага");
			НаборОстаткиЦенныхБумаг.Вставить("Ресурсы", "КоличествоНачальныйОстаток, КоличествоКонечныйОстаток");
			НаборОстаткиЦенныхБумаг.Вставить("ДанныеВнешнейСистемы", ОстаткиЦенныхБумаг);
			НаборОстаткиЦенныхБумаг.Вставить("ДанныеУчетнойСистемы",
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага,
				|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоНачальныйОстаток,
				|	ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
				|			&НачалоПериодаОтчета,
				|			&КонецПериодаОтчета,
				|			Период,
				|			,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И (ДепозитарныйСчет.ВидСчета = ЗНАЧЕНИЕ(Перечисление.ВидыДепозитарныхСчетов.Основной)
				|					ИЛИ ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
				|						И ДепозитарныйСчет.Брокер = &Брокер)) КАК ОстаткиЦенныхБумагОстаткиИОбороты");
				
			НаборыДанных = Новый Массив;
			НаборыДанных.Добавить(НаборОстаткиДенежныхСредств);
			НаборыДанных.Добавить(НаборОстаткиЦенныхБумаг);
			
			Заголовки = Новый Структура;
			Заголовки.Вставить("ФайлОтчета", "Файл отчета");
			Заголовки.Вставить("ДатаОтчета", "Дата отчета");
			Заголовки.Вставить("СчетДоверительногоУправления", "Счет доверит. упр.");
			Заголовки.Вставить("НачалоПериодаОтчета", "Нач. периода");
			Заголовки.Вставить("КонецПериодаОтчета", "Кон. периода");
			Заголовки.Вставить("СуммаНачальныйОстаток", "Сумма, нач. остаток");
			Заголовки.Вставить("СуммаКонечныйОстаток", "Сумма, кон. остаток");
			Заголовки.Вставить("ЦеннаяБумага", "Ценная бумага");
			Заголовки.Вставить("КоличествоНачальныйОстаток", "Количество, нач. остаток");
			Заголовки.Вставить("КоличествоКонечныйОстаток", "Количество, кон. остаток");
			
			ДанныеДляСверки = Новый Структура;
			ДанныеДляСверки.Вставить("ЗаголовокОтчета", "Сверка с отчетом брокера ВБРР");
			ДанныеДляСверки.Вставить("ПараметрыОтчета", ПараметрыОтчетаБрокера);
			ДанныеДляСверки.Вставить("НаборыДанных", НаборыДанных);
			ДанныеДляСверки.Вставить("Заголовки", Заголовки);
			
			Отчет = Новый ТабличныйДокумент;
			Отчет.ОтображатьСетку     = Ложь;
			Отчет.Защита              = Ложь;
			Отчет.ТолькоПросмотр      = Истина;
			Отчет.ОтображатьЗаголовки = Ложь;
			
			ЗаполнитьОтчетОСверкеНаСервере(ДанныеДляСверки, Отчет);
			
			Отчет.Показать(ПараметрыОтчетаБрокера.СчетДоверительногоУправления);
			
		ИначеЕсли Команда = ЭтаФорма.Команды.КомандаЗагрузитьКомиссиюБрокера Тогда
			Если ПараметрыОтчетаБрокера.НачалоПериодаОтчета <> НачалоДня(ПараметрыОтчетаБрокера.КонецПериодаОтчета) Тогда
				ТекстОшибки = "Импорт комиссии брокера за период более одного дня не поддерживается";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
			
			ПараметрыОтчетаБрокера.Вставить("Период", ПараметрыОтчетаБрокера.НачалоПериодаОтчета);
			
			Если Не НайтиЗаголовкиТаблицОтчета(ТекстОтчета, ПозицияЗаголовкаТаблицыДенежныхСредств, ПозицияЗаголовкаТаблицыЦенныхБумаг, ПозицияЗаголовкаТаблицыСделок, ПараметрыСессии) Тогда
				Возврат;
			КонецЕсли;
			
			Если ПозицияЗаголовкаТаблицыСделок = 0 Тогда
				ТекстОшибки = "Ошибка формата файла: не удалось найти таблицу сделок";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
			
			КомиссияБрокераПоСделкам = ДесериализоватьКомиссиюБрокераПоСделкам(
				ТекстОтчета, ПозицияЗаголовкаТаблицыСделок, ПараметрыОтчетаБрокера, ПараметрыСессии);
			Если КомиссияБрокераПоСделкам = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			ИмпортироватьКомиссиюБрокераПоСделкам(КомиссияБрокераПоСделкам, ПараметрыОтчетаБрокера);
						
			ОповеститьОбИзменении(Тип("ДокументСсылка.НачислениеЗадолженности"));
			ОповеститьОбИзменении(Тип("ДокументСсылка.Оплата"));

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКаталогДанных()
	
	Если ЗначениеЗаполнено(ЭтаФорма.ДатаСверки) Тогда
		Объект.КаталогДанных = ПолучитьКаталогДанных(Объект.Организация, ЭтаФорма.ДатаСверки);
		КомандаОбновитьСписокФайлов(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ВБРР");
	Если Не ЗначениеЗаполнено(ЭтаФорма.Брокер) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.РежимСверки = 0; // на дату
	ЭтаФорма.ДатаСверки  = ТекущаяДата() - 86400;
	
	ЭтаФорма.РазделительКолонок  = "Ј";
	ЭтаФорма.ПризнакКонцаТаблицы = "ђ";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьКаталогДанных();
	
	РежимСверкиПриИзменении(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура РежимСверкиПриИзменении(Элемент)
	
	Элементы.ГруппаСверкаНаДату.Видимость   = (ЭтаФорма.РежимСверки = 0);
	Элементы.ГруппаСверкаЗаПериод.Видимость = (ЭтаФорма.РежимСверки = 1);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаСверкиПриИзменении(Элемент)
	
	ЭтаФорма.ПериодСверки.ДатаНачала    = ЭтаФорма.ДатаСверки;
	ЭтаФорма.ПериодСверки.ДатаОкончания = ЭтаФорма.ДатаСверки;
	
	ЗаполнитьКаталогДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодСверкиПриИзменении(Элемент)
	
	ЭтаФорма.ДатаСверки = ЭтаФорма.ПериодСверки.ДатаОкончания;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогДанных;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогДанных = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогДанныхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ПустаяСтрока(Объект.КаталогДанных) Тогда
		ЗапуститьПриложение(Объект.КаталогДанных);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаСверить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСверить");
	ОбработатьОтчетыБрокера(Команда, ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьКомиссиюБрокера(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗагрузитьКомиссиюБрокера");
	ОбработатьОтчетыБрокера(Команда, ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокФайлов(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновитьСписокФайлов");
	ВыполнитьОбновлениеСпискаФайлов();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновлениеСпискаФайлов()
	
	Этаформа.ФайлыОтчетов.Очистить();
	
	НайденыеФайлы = НайтиФайлы(Объект.КаталогДанных, "*.txt");
	
	Для каждого НайденыйФайл Из НайденыеФайлы Цикл
		НоваяСтрока = ЭтаФорма.ФайлыОтчетов.Добавить();
		НоваяСтрока.Выбран   = Истина;
		НоваяСтрока.ИмяФайла = НайденыйФайл.ПолноеИмя;
	КонецЦикла;
	
	Если Этаформа.ФайлыОтчетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В указанном каталоге файлы отчетов не найдены");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьВсе(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаВыделитьВсе");
	ВыполнитьВыделениеВсех();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыделениеВсех()
	
	Для каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		СтрокаФайлыОтчетов.Выбран = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВыделение(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСнятьВыделение");
	ВыполнитьСнятиеВыделения();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСнятиеВыделения()
	
	Для каждого СтрокаФайлыОтчетов Из ЭтаФорма.ФайлыОтчетов Цикл
		СтрокаФайлыОтчетов.Выбран = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервереБезКонтекста
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
	
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		РеквизитФормыВЗначение("Объект"), ИмяКоманды);
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
	
КонецПроцедуры

#КонецОбласти
