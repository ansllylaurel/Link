Функция ДатаИзСтрокиГГГГММДД(Знач СтрокаГГГГММДД, Разделитель = ".")
	
	Возврат Дата(СтрЗаменить(СтрокаГГГГММДД, Разделитель, ""));
	
КонецФункции // ДатаИзСтрокиГГГГММДД

Функция ЧислоИзСтроки(Знач ЧислоСтр)
	
	Если ПустаяСтрока(ЧислоСтр) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Лев(ЧислоСтр, 1) = "." Тогда
		ЧислоСтр = "0" + ЧислоСтр;
	КонецЕсли;
	
	Возврат Число(ЧислоСтр);
	
КонецФункции // ЧислоИзСтроки

