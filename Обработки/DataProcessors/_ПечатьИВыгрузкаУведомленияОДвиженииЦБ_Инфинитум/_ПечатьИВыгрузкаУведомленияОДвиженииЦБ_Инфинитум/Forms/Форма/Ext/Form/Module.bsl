#Область События_Формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация 			  	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	Объект.ДатаИВремяФормирования 	= ТекущаяДата();
	Объект.НомерПервогоСообщения 	= 1;
				
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ОбновитьВидимостьЭлементов();
	Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ВводЦенныхБумаг");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область События_Элементов_Формы

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Объект.Организация, Объект.Подписант));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ПодписантДолжность = СтруктураДанныхКонтактногоЛица.Должность;
	ВыбранноеЗначение  = СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
		
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогДанных + "\");

КонецПроцедуры

&НаКлиенте
Процедура ДокументыДиженияЦБДокументПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДокументыДвиженияЦБ.ТекущиеДанные;
	Если ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ВыводЦенныхБумаг.ПустаяСсылка")
		Или ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ВводЦенныхБумаг.ПустаяСсылка")
		Или ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ПереводЦенныхБумаг.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущиеДанные.Документ, "Рынок, ДепозитарныйСчет, " + ?(Объект.ВидДвижения >= 2, "ДепозитарныйСчетПолучатель", "Контрагент"));
	
	// У перевода выведем счет ДЕПО в Инфинитуме. Это либо отправитель, либо получатель
	Если Объект.ВидДвижения = 2 Тогда
		ДепозитарийСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.ДепозитарныйСчет, "Депозитарий");
		Если ДепозитарийСчета = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум") Тогда
			ДЕПО_Инфинитум = РеквизитыДокумента.ДепозитарныйСчет;
		Иначе
			ДЕПО_Инфинитум = РеквизитыДокумента.ДепозитарныйСчетПолучатель;
		КонецЕсли;		
	Иначе
		ДЕПО_Инфинитум = РеквизитыДокумента.ДепозитарныйСчет;	
	КонецЕсли;
	
	ТекущиеДанные.Рынок 		= РеквизитыДокумента.Рынок;
	ТекущиеДанные.СчетДепо 		= ДЕПО_Инфинитум;
	ТекущиеДанные.Контрагент 	= ?(Объект.ВидДвижения >= 2, "", РеквизитыДокумента.Контрагент);  	
	
КонецПроцедуры     

&НаКлиенте
Процедура ВидДвиженияПриИзменении(Элемент)
	
	ОбновитьВидимостьЭлементов();
	
	Если Объект.ДокументыДвиженияЦБ.Количество() > 0 Тогда
		Объект.ДокументыДвиженияЦБ.Очистить();
	КонецЕсли;	
		
	// Назначим тип для выбора документам в табличной части
	Если Объект.ВидДвижения = 0 Тогда
		Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ВводЦенныхБумаг");
	ИначеЕсли Объект.ВидДвижения = 1 Тогда
	    Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ВыводЦенныхБумаг");
	Иначе
		Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ПереводЦенныхБумаг");
	КонецЕсли;
	
	ОбновитьСписокВыбораКонтрагента();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
		
	Объект.НаименованиеДепонента = СформироватьНаименованиеДепонента(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДатаИВремяФормирования);
	
	ОбновитьСписокВыбораКонтрагента();

	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументыДвиженияЦБ[0].Документ) Тогда
		Объект.ДокументыДвиженияЦБ.Очистить(); 
		Возврат;
	КонецЕсли;
	
	Если Объект.СчетДоверительногоУправления <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументыДвиженияЦБ[0].Документ, "СчетДоверительногоУправления") Тогда
		Объект.ДокументыДвиженияЦБ.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИВремяФормированияПриИзменении(Элемент)
	
	Объект.НаименованиеДепонента = СформироватьНаименованиеДепонента(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДатаИВремяФормирования);
	
	ОбновитьСписокВыбораКонтрагента();
	
	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументыДвиженияЦБ[0].Документ) Тогда
		Объект.ДокументыДвиженияЦБ.Очистить(); 
		Возврат;
	КонецЕсли;
	
	Если НачалоДня(Объект.ДатаИВремяФормирования) <> НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументыДвиженияЦБ[0].Документ, "Дата")) Тогда
		Объект.ДокументыДвиженияЦБ.Очистить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДокументыДвиженияЦБПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	УсловиеВыполнено = ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И Объект.ДатаИВремяФормирования <> '00010101';
	ТекстСообщения = "Счет ДУ, дата и время составления должны быть заполнены";
	
	Если Объект.ВидДвижения < 2 Тогда
		УсловиеВыполнено = УсловиеВыполнено И ЗначениеЗаполнено(Объект.Контрагент);
		ТекстСообщения = "Счет ДУ, контрагент, дата и время составления должны быть заполнены";
	КонецЕсли;
	
	Если Не УсловиеВыполнено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	Объект.ДокументыДвиженияЦБ.Очистить();
	ЗаполнитьТаблицуДокументовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим спецдеп, разрешен только Инфинитум
	Если Не ПроверитьСпецДепозитарий(ВыбранноеЗначение, Объект.ВидДвижения) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	// Обновляем организацию
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Объект.СчетДоверительногоУправления = "";    
	Элементы.Контрагент.СписокВыбора.Очистить();
	Объект.Контрагент = "";
	Объект.ДокументыДвиженияЦБ.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область Команды_Формы

&НаКлиенте
Процедура Печать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Печать");
	ВыполнитьПечать(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПечать(ПараметрыСессии)
	
	// Печать доступна только для вида "Передача" и "Перевод"
	Если Объект.ВидДвижения = 0 Тогда
		ТекстОшибки = "Печать доступна только для вида движения 'Передача' или 'Перевод'";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнение() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка заполнения");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьСпецДепозитарий(Объект.СчетДоверительногоУправления, Объект.ВидДвижения, ПараметрыСессии) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка специализированного депозитария");
		Возврат;
	КонецЕсли;

	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		ТекстОшибки = "Не указаны документы для печати";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьДокументыНаСервере() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка документов");
		Возврат;
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	Отказ = Ложь;
	ПечатьНаСервере(ТабДокумент, Отказ);
	
	Если Отказ Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Ошибка при формировании печатной формы на сервере");
		Возврат;
	КонецЕсли;
	
	ТабДокумент.ОриентацияСтраницы 	= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ОтображатьСетку 	= Ложь;
	ТабДокумент.ТолькоПросмотр 		= Истина;
	ИспользуемоеИмяФайла = ?(ПустаяСтрока(Объект.КаталогДанных), "", Объект.КаталогДанных + "\") + "Уведомление_" + СокрЛП(Объект.Организация) + "_" + СокрЛП(Объект.Контрагент) + ".xlsx"; 
	ТабДокумент.Показать("Уведомление", ИспользуемоеИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьТаблицуДокументов(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗаполнитьТаблицуДокументов");
	ВыполнитьЗаполнениеТаблицыДокументов(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеТаблицыДокументов(ПараметрыСессии)
	
	УсловиеВыполнено = ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И Объект.ДатаИВремяФормирования <> '00010101' И Объект.СрокПеререгистрацииПрав <> '00010101';
	ТекстСообщения = "Счет ДУ, срок перерегистрации, дата и время составления должны быть заполнены";
	
	Если Объект.ВидДвижения < 2 Тогда
		УсловиеВыполнено = УсловиеВыполнено И ЗначениеЗаполнено(Объект.Контрагент);
		ТекстСообщения = "Счет ДУ, контрагент, срок перерегистрации, дата и время составления должны быть заполнены";
	КонецЕсли;
	
	Если Не УсловиеВыполнено Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстСообщения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуДокументовНаСервере(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЭкспортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЭкспортировать");
	ВыполнитьЭкспорт(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЭкспорт(ПараметрыСессии)
	
	Если Не ПроверитьЗаполнение() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка заполнения");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьКаталог(ПараметрыСессии) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка каталога выгрузки");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьСпецДепозитарий(Объект.СчетДоверительногоУправления, Объект.ВидДвижения, ПараметрыСессии) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка специализированного депозитария");
		Возврат;
	КонецЕсли;

	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		ТекстОшибки = "Не указаны документы для выгрузки";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьДокументыНаСервере() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка документов");
		Возврат;
	КонецЕсли;

	// При выгрузке дополнительно проверяем реквизиты контрагента
	Если Объект.ВидДвижения < 2 Тогда
		
		ПроверяемыеРеквизиты = Новый Массив;
		ПроверяемыеРеквизиты.Добавить("НомерДепозитарногоДоговораКонтрагента");
		ПроверяемыеРеквизиты.Добавить("ДатаДепозитарногоДоговораКонтрагента");
		ПроверяемыеРеквизиты.Добавить("НомерРазделаКонтрагента");		
		
		Отказ = Ложь;
		Для Каждого ТекРеквизит Из ПроверяемыеРеквизиты Цикл
			Если Не ЗначениеЗаполнено(Объект[ТекРеквизит]) Тогда
				ТекстОшибки = "Не указано значение реквизита " + Элементы[ТекРеквизит].Заголовок;
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "Объект." + ТекРеквизит, , Отказ);
			КонецЕсли;
		КонецЦикла;
		
		Если Отказ Тогда
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не заполнены обязательные реквизиты контрагента");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
		
	Отказ = Ложь;
	ЭкспортироватьНаСервере(Отказ, ПараметрыСессии);
	
	Если Не Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка завершена");
	КонецЕсли;

КонецПроцедуры

