		ЗаписьXML.ЗаписатьНачалоЭлемента("id");
		ЗаписьXML.ЗаписатьТекст(?(Объект.ВидДвижения = 2, ПакетДанных.МестоХраненияКонтрагента, ПакетДанных.МестоХранения)); 
		ЗаписьXML.ЗаписатьКонецЭлемента();	
		ЗаписьXML.ЗаписатьНачалоЭлемента("organization");
		ЗаписьXML.ЗаписатьТекст("NADC");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("sd_type");
		ЗаписьXML.ЗаписатьТекст("112");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("sd_id");
		ЗаписьXML.ЗаписатьНачалоЭлемента("id");
		ЗаписьXML.ЗаписатьТекст(?(Объект.ВидДвижения = 2, ПакетДанных.ИдентификаторСДКонтрагента, ПакетДанных.ИдентификаторСД)); 
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьНачалоЭлемента("organization");
		ЗаписьXML.ЗаписатьТекст("NADC");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("section");
		ЗаписьXML.ЗаписатьНачалоЭлемента("id");
		ЗаписьXML.ЗаписатьТекст(СокрЛП(?(Объект.ВидДвижения = 2, ?(ПакетДанных.ВидПеревода = "Перевод_Поступление", ПакетДанных.РазделМестаХранения, ПакетДанных.РазделМестаХраненияПолучатель), Объект.НомерРазделаКонтрагента)));
		ЗаписьXML.ЗаписатьКонецЭлемента();	
		ЗаписьXML.ЗаписатьНачалоЭлемента("organization");
		ЗаписьXML.ЗаписатьТекст("NADC");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();	
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("payment_terms");
		ЗаписьXML.ЗаписатьНачалоЭлемента("payment_term");
		ЗаписьXML.ЗаписатьНачалоЭлемента("payment_term_type_code");
		ЗаписьXML.ЗаписатьТекст("FOP");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("trade_date");
		ЗаписьXML.ЗаписатьТекст(Формат(Объект.ДатаИВремяФормирования, "ДФ=yyyy-MM-dd"));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("settlement_date");
		ЗаписьXML.ЗаписатьТекст(Формат(ПакетДанных.ДатаПеререгистрации, "ДФ=yyyy-MM-dd"));
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
	КонецЕсли;	

	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
		
	// Заменяем пространства имен на исходные
	ТекстФайла = Новый ТекстовыйДокумент;
	ТекстФайла.Прочитать(ИмяФайлаXML, "UTF-8");
		
	Кавычки = Символ(34);
	
	ЗаменяемаяСтрока = "<" + КорневойТэг + " xmlns='http://www.w3.org/2001/XMLSchema-instance' xmlns:xsd='http://www.w3.org/2001/XMLSchema'>";
	ЗаменяемаяСтрока = СтрЗаменить(ЗаменяемаяСтрока, "'", Кавычки);
	СтрокаЗамены = "<" + КорневойТэг + " xmlns:xsd='http://www.w3.org/2001/XMLSchema' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' version='1'>";
										 
	СтрокаЗамены = СтрЗаменить(СтрокаЗамены, "'", Кавычки);
		
	ТекстФайла.ЗаменитьСтроку(2, СтрокаЗамены);
	
	Попытка 
		ТекстФайла.Записать(ИмяФайлаXML, "UTF-8");
	Исключение
		ТекстОшибки = "Не удалось записать файл " + ИмяФайлаXML + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,, Отказ);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДокументовНаСервере(ПараметрыСессии = Неопределено)
	
	Объект.ДокументыДвиженияЦБ.Очистить();
	
	ВыборкаДокументовПоЦБ = ПолучитьВыборкуДокументов(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДатаИВремяФормирования, Объект.Контрагент, Объект.ВидДвижения);
	
	Если ВыборкаДокументовПоЦБ.Количество() = 0 Тогда
		
		ТекстДокумента = "вводы";
		Если Объект.ВидДвижения = 1 Тогда
			ТекстДокумента = "выводы";
		ИначеЕсли Объект.ВидДвижения >= 2 Тогда
			ТекстДокумента = "переводы";
		КонецЕсли;
		
		ТекстОшибки = "Отсутствуют " + ТекстДокумента + " ценных бумаг на выбранную дату"
			+ ?(Объект.ВидДвижения >= 2, "", " по контрагенту " + СокрЛП(Объект.Контрагент));
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;

	КонецЕсли;
	
	Пока ВыборкаДокументовПоЦБ.Следующий() Цикл
		НоваяСтрока = Объект.ДокументыДвиженияЦБ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДокументовПоЦБ);
		НоваяСтрока.ДатаПеререгистрации = Объект.СрокПеререгистрацииПрав;
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьНаименованиеДепонента(Организация, СчетДоверительногоУправления, Период)
	
	Если Не ЗначениеЗаполнено(СчетДоверительногоУправления) Тогда		
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.СВ)
		|			ТОГДА ""Срочная выплата""
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.ВР)
		|			ТОГДА ""Выплатной резерв""
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораПоУправлениюПенсионнымиНакоплениямиИРезервами = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровПоУправлениюПенсионнымиНакоплениямиИРезервами.РОПС)
		|			ТОГДА ""РОПС""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидДоговораПН,
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ТОГДА "" Д.У. средствами пенсионных накоплений для финансирования накопительной пенсии ""
		|		ИНАЧЕ "" Д.У. ""
		|	КОНЕЦ КАК ВставкаДУ,
		|	РеквизитыОрганизации.ПолноеНаименованиеПоУставу КАК НаименованиеОрганизации,
		|	РеквизитыКлиента.ПолноеНаименованиеПоУставу КАК НаименованиеКлиента
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыОрганизации
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Организация.ЮрФизЛицо = РеквизитыОрганизации.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыКлиента
		|		ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыКлиента.ЮрФизЛицо";
	
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не сформировано наименование депонента");
		Возврат "";
	КонецЕсли;
	
	Возврат Выборка.НаименованиеОрганизации + Выборка.ВставкаДУ + Выборка.НаименованиеКлиента + ?(ПустаяСтрока(Выборка.ВидДоговораПН), "", " (" + Выборка.ВидДоговораПН + ")");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВыборкуДокументов(Организация, СчетДоверительногоУправления, ДатаДокумента, Контрагент, ВидДвижения)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Документ,
		|	Документ.ДепозитарныйСчет КАК СчетДепо,
		|	Документ.Контрагент КАК Контрагент,
		|	Документ.Рынок КАК Рынок		
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК Документ
		|ГДЕ
		|	Документ.Организация = &Организация
		|	И Документ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
		|	И НЕ Документ.ПометкаУдаления";
	
	Если ВидДвижения < 2 Тогда
		Запрос.Текст = Запрос.Текст + "
		|И Документ.Контрагент = &Контрагент";
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		
	ИначеЕсли ВидДвижения = 3 Тогда
	
		Запрос.Текст = Запрос.Текст + "
		|И Документ.ДепозитарныйСчет.Депозитарий = Документ.ДепозитарныйСчетПолучатель.Депозитарий";
		
	КонецЕсли;
	
	Если ВидДвижения = 0 Тогда
		// Поступление
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг", 	"Документ.ВводЦенныхБумаг");
	ИначеЕсли ВидДвижения >= 2 Тогда
		// Перевод
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг", 	"Документ.ПереводЦенныхБумаг");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Контрагент", 		"""""");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ДепозитарныйСчет КАК СчетДепо", 	"ВЫБОР КОГДА Документ.ДепозитарныйСчет.Депозитарий = &Инфинитум ТОГДА Документ.ДепозитарныйСчет ИНАЧЕ Документ.ДепозитарныйСчетПолучатель КОНЕЦ КАК СчетДепо");
		Запрос.УстановитьПараметр("Инфинитум", 	ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата", 							НачалоДня(ДатаДокумента));
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаСервере
Процедура ПечатьНаСервере(ТабДокумент, Отказ)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ОбъектОбработки.СформироватьПечатнуюФормуУведомления(ТабДокумент, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()
	
	ВидимостьГруппыКонтрагент = Объект.ВидДвижения < 2;
	
	Элементы.ГруппаКонтрагент.Видимость = ВидимостьГруппыКонтрагент;
	
	Если Не ВидимостьГруппыКонтрагент Тогда
		
		Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
			Объект.Контрагент = "";
			Элементы.Контрагент.СписокВыбора.Очистить();
		КонецЕсли;
		
		Если ПустаяСтрока(Объект.НомерДепозитарногоДоговораКонтрагента) Тогда
			Объект.НомерДепозитарногоДоговораКонтрагента = "";
		КонецЕсли;
		
		Если ПустаяСтрока(Объект.НомерРазделаКонтрагента) Тогда
			Объект.НомерРазделаКонтрагента = "";
		КонецЕсли;
		
		Если Объект.ДатаДепозитарногоДоговораКонтрагента <> '00010101' Тогда
			Объект.ДатаДепозитарногоДоговораКонтрагента = '00010101';
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьКаталог(ПараметрыСессии = Неопределено)
	
	ТекстСообщения = "";
	Если ПустаяСтрока(Объект.КаталогДанных) Тогда
		ТекстСообщения = "Не указан каталог для выгрузки файлов";
	Иначе
		ТекКаталог = Новый Файл(Объект.КаталогДанных);	
		Если ТекКаталог.Существует() Тогда
			Если ТекКаталог.ЭтоФайл() Тогда
				ТекстСообщения = "Указан путь к файлу выгрузки данных, а не каталог. Необходимо выбрать каталог";
			ИначеЕсли ТекКаталог.ПолучитьТолькоЧтение() Тогда
				ТекстСообщения = "Отсутствует доступ к выбранному каталогу выгрузки";				
			КонецЕсли;
		Иначе
			ТекстСообщения = "Выбранный каталог выгрузки не существует";	
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстСообщения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КаталогДанных");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьДокументыНаСервере()
	Возврат ПроверитьДокументы(Объект.ДокументыДвиженияЦБ.Выгрузить(), Объект.ДатаИВремяФормирования, Объект.ВидДвижения, Объект.Контрагент);
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДокументы(ТаблицаДокументов, ДатаФормирования, ВидДвижения, Контрагент)
	
	// У всех документов проверяем дату и пометку удаления; 
	// В переводах у счета ДЕПО-отправителя или у счета ДЕПО-получателя должен быть Инфинитум, для вида движения 3 - в обоих случаях Инфинитум;
	// У вводов и выводов проверяем контрагента
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Документ КАК Документ,
		|	_Документы.СчетДепо КАК ДепозитарныйСчет,
		|	_Документы.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ _Документы
		|ИЗ
		|	&Документы КАК _Документы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Документ КАК Документ,
		|	""Дата"" КАК ВидОшибки
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(_Документы.Документ КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ) <> &Период
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""ПометкаУдаления""
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	ВЫРАЗИТЬ(_Документы.Документ КАК Документ.ВводЦенныхБумаг).ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""ДепозитарныйСчет""
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	ВЫРАЗИТЬ(_Документы.ДепозитарныйСчет КАК Справочник.ДепозитарныеСчета).Депозитарий <> &Инфинитум
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""ДепозитарныйСчетПолучатель""
		|ИЗ
		|	Документ.ПереводЦенныхБумаг КАК ПереводЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Документы КАК _Документы
		|		ПО ПереводЦБ.Ссылка = _Документы.Документ
		|ГДЕ
		|	ПереводЦБ.ДепозитарныйСчетПолучатель.Депозитарий <> &Инфинитум
		|	И &ВидДвижения = 3
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""ПереводМеждуСпецДепами""
		|ИЗ
		|	Документ.ПереводЦенныхБумаг КАК ПереводЦБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Документы КАК _Документы
		|		ПО ПереводЦБ.Ссылка = _Документы.Документ
		|ГДЕ
		|	&ВидДвижения = 2
		|	И ПереводЦБ.ДепозитарныйСчетПолучатель.Депозитарий = &Инфинитум
		|	И ПереводЦБ.ДепозитарныйСчет.Депозитарий = &Инфинитум
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""Контрагент""
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	&ВидДвижения < 2
		|	И _Документы.Контрагент <> &Контрагент";
	
	Если ВидДвижения = 1 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВводЦенныхБумаг", "Документ.ВыводЦенныхБумаг");
	ИначеЕсли ВидДвижения >= 2 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВводЦенныхБумаг", "Документ.ПереводЦенныхБумаг"); 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Документы", 		ТаблицаДокументов);
	Запрос.УстановитьПараметр("Период", 		НачалоДня(ДатаФормирования));
	Запрос.УстановитьПараметр("ВидДвижения", 	ВидДвижения);
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
	Запрос.УстановитьПараметр("Инфинитум", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум")); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Успешно = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = "";
		Если Выборка.ВидОшибки = "Дата" Тогда 
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " дата не совпадает с указанной";
		ИначеЕсли Выборка.ВидОшибки = "ПометкаУдаления" Тогда  			
			ТекстОшибки = "Документ " + СокрЛП(Выборка.Документ) + " помечен на удаление, его необходимо убрать из таблицы к выгрузке"; 	
		ИначеЕсли Выборка.ВидОшибки = "ДепозитарныйСчет" Тогда  			
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " депозитарий одного из счетов ДЕПО 'Откуда' или 'Куда' должен быть 'Инфинитум'"; 
		ИначеЕсли Выборка.ВидОшибки = "ДепозитарныйСчетПолучатель" Тогда  			
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " депозитарий счетов ДЕПО 'Откуда' и 'Куда' должен быть 'Инфинитум'"; 
		ИначеЕсли Выборка.ВидОшибки = "ПереводМеждуСпецДепами" Тогда  			
			ТекстОшибки = "У перевода между спец. депами " + СокрЛП(Выборка.Документ) + " 'Инфинитум' может быть депозитарием только у одного из счетов ДЕПО 'Откуда' или 'Куда'"; 	
		ИначеЕсли Выборка.ВидОшибки = "Контрагент" Тогда
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " контрагент не совпадает с выбранным";
		КонецЕсли;			
			
		Если ТекстОшибки <> "" Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Выборка.Документ);	
			Успешно = Ложь;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Успешно;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьСпецДепозитарий(СчетДоверительногоУправления, ВидДвижения, ПараметрыСессии = Неопределено)
	
	Если ВидДвижения >= 2 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЭтоИнфинитум = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "СпециализированныйДепозитарий") = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_Инфинитум");
	
	Если Не ЭтоИнфинитум Тогда
		ТекстОшибки = "У счета доверительного управления должен быть специализированный депозитарий 'Инфинитум'";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Возврат ЭтоИнфинитум;
		
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокВыбораКонтрагента()

	Если Объект.ВидДвижения >= 2 Тогда
		// для перевода просто очищаем, контрагент не требуется
		Элементы.Контрагент.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
	
	Если Не (ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И ЗначениеЗаполнено(Объект.ДатаИВремяФормирования)) Тогда
		Элементы.Контрагент.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
		
	СписокКонтрагентов = ПолучитьСписокКонтрагентов(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДатаИВремяФормирования, Объект.ВидДвижения);
	
	Элементы.Контрагент.СписокВыбора.ЗагрузитьЗначения(СписокКонтрагентов);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокКонтрагентов(Организация, СчетДоверительногоУправления, ДатаДокумента, ВидДвижения)	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Документ.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК Документ
		|ГДЕ
		|	Документ.Организация = &Организация
		|	И Документ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
		|	И НЕ Документ.ПометкаУдаления
		|	И Документ.Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)";
				
	Если ВидДвижения = 0 Тогда
		// Поступление
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг", 	"Документ.ВводЦенныхБумаг");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата", 							НачалоДня(ДатаДокумента));

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");

КонецФункции

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элемент.СписокВыбора.Количество() = 0 Тогда
		
		СтандартнаяОбработка = Ложь;				
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют " + ?(Объект.ВидДвижения = 0, "вводы", "выводы") + " ценных бумаг на выбранную дату");
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервереБезКонтекста
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
	
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		РеквизитФормыВЗначение("Объект"), ИмяКоманды);
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
	
КонецПроцедуры

#КонецОбласти
