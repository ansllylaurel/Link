						Оплата.Записать(РежимЗаписиДокумента.Проведение);
					Исключение
						Оплата.Записать(РежимЗаписиДокумента.Запись);
					КонецПопытки;
				Иначе
					Оплата.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
			КонецЕсли;
			
			// создадим новое поступление
			Оплата = Документы.Оплата.СоздатьДокумент();
			
			Оплата.Дата                         = ЭтотОбъект.ДатаСверки + 20*60*60 + 1;
			Оплата.Организация                  = ЭтотОбъект.Организация;
			Оплата.ВидЗадолженности             = Справочники.ВидыЗадолженности.ПоБрокерскойКомиссии;
			Оплата.ВидДвижения                  = Перечисления.ВидыДвижений.Расход;
			Оплата.СчетДоверительногоУправления = Выборка.СчетДоверительногоУправления;
			Оплата.МестоХранения                = Выборка.МестоХранения;
			Оплата.ВалютаОплаты                 = ЭтотОбъект.Организация.ВалютаУчета;
			Оплата.Брокер                       = Брокер;
			Оплата.Контрагент 					= Брокер.ЮрФизЛицо;
			Оплата.Ответственный                = РаботаСПользователями.ТекущийПользователь();
			Оплата.Комментарий                  = "Создан аппаратно-техническими средствами " + ТекущаяДата();

		КонецЕсли;
		
		// добавим строку в начисление
		НоваяСтрокаОснования = Оплата.Основания.Добавить();
		
		НоваяСтрокаОснования.Основание  = Выборка.Сделка;
		НоваяСтрокаОснования.Валюта     = Оплата.ВалютаОплаты;
		НоваяСтрокаОснования.Сумма      = Выборка.Сумма;
		
	КонецЦикла;
	
	// запишем ранее созданные документы, если таковые были
	Если Оплата <> Неопределено Тогда
		Если Оплата.ПроверитьЗаполнение() Тогда
			Попытка
				Оплата.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Оплата.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
		Иначе
			Оплата.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
