&НаКлиенте
Процедура РежимСверкиПриИзменении(Элемент)
	
	Элементы.ГруппаСверкаЗаПериод.Видимость = (ЭтаФорма.РежимСверки = 1);
	Элементы.Клиенты.Видимость              = (ЭтаФорма.РежимСверки = 0);
	Элементы.ГруппаСверкаНаДату.Видимость   = (ЭтаФорма.РежимСверки = 0);
	
КонецПроцедуры

&НаКлиенте
Процедура ВерсияФорматаПриИзменении(Элемент)
	
	Если ЭтаФорма.ВерсияФормата = 0 Тогда
		ЭтаФорма.ФорматДанных = ?(Объект.ДатаСверки >= Дата(2015, 6, 9), 2, 1);
	Иначе
		ЭтаФорма.ФорматДанных = ЭтаФорма.ВерсияФормата;
	КонецЕсли;
	
	ЗаполнитьКаталогДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбораКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогДанных;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогДанных = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;	
	
КонецПроцедуры


&НаКлиенте
Процедура КомандаСверить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСверить");
	ВыполнитьСверку(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверку(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка заполнения");
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.РежимСверки = 1 Тогда // сверка за период
		
		Объект.ДатаСверки = ЭтаФорма.НачДатаСверки;
		
		Если ЭтаФорма.ВерсияФормата = 0 Тогда
			ЭтаФорма.ФорматДанных = ?(Объект.ДатаСверки >= Дата(2015, 6, 9), 2, 1);
		Иначе
			ЭтаФорма.ФорматДанных = ЭтаФорма.ВерсияФормата;
		КонецЕсли;

		Пока Объект.ДатаСверки <= ЭтаФорма.КонДатаСверки Цикл
			ЗаполнитьКаталогДанных();
			КомандаОбновитьСписокКлиентов(Неопределено);
			
			СверитьВыбранныхКлиентовНаДату(ПараметрыСессии);
			
			Объект.ДатаСверки = Объект.ДатаСверки + 86400;
		КонецЦикла;
		
	Иначе
		СверитьВыбранныхКлиентовНаДату(ПараметрыСессии);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузитьКомиссию(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗагрузитьКомиссию");
	ВыполнитьЗагрузкуКомиссии(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗагрузкуКомиссии(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка заполнения");
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаКлиенты Из ЭтаФорма.Клиенты Цикл
		
		Если Не СтрокаКлиенты.Выбран Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаКлиенты.ИмяФайла) Тогда
			ТекстОшибки = "По клиенту " + СтрокаКлиенты.СчетДУ
				+ " за выбранный период есть движения денег/бумаг, но нет отчета брокера";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			Предупреждение(ТекстОшибки);
			Продолжить;
		КонецЕсли;
		
		Если      ЭтаФорма.ФорматДанных = 1 Тогда
			ДанныеБрокера = ПолучитьДанныеБрокераВФормате1(СтрокаКлиенты.ИмяФайла);
		ИначеЕсли ЭтаФорма.ФорматДанных = 2 Тогда
			ДанныеБрокера = ПолучитьДанныеБрокераВФормате2(СтрокаКлиенты.ИмяФайла);
		КонецЕсли;
		
		ЗагрузитьКомиссиюБрокераНаСервере(СтрокаКлиенты.СчетДУ, ДанныеБрокера);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьСписокКлиентов(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаОбновитьСписокКлиентов");
	ВыполнитьОбновлениеСпискаКлиентов();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновлениеСпискаКлиентов()
	
	Этаформа.Клиенты.Очистить();
	
	Если      ЭтаФорма.ФорматДанных = 1 Тогда
		МаскаФайлов = "*.xls";
	ИначеЕсли ЭтаФорма.ФорматДанных = 2 Тогда
		МаскаФайлов = "*.xlsx";
	КонецЕсли;
	
	НайденыеФайлы = НайтиФайлы(Объект.КаталогДанных, МаскаФайлов);
	
	Для каждого НайденыйФайл Из НайденыеФайлы Цикл
		
		СчетДУ = ОпределитьСчетДУ(Объект.ДатаСверки, ЭтаФорма.Брокер, Объект.Организация, НайденыйФайл.ИмяБезРасширения, ЭтаФорма.ФорматДанных);
		
		Если Не СчетДУ = Неопределено Тогда
			НоваяСтрока = ЭтаФорма.Клиенты.Добавить();
			НоваяСтрока.Выбран   = Истина;
			НоваяСтрока.СчетДУ   = СчетДУ;
			НоваяСтрока.ИмяФайла = НайденыйФайл.ПолноеИмя;
		КонецЕсли;
		
	КонецЦикла;
	
	СчетаДУПоКоторымЕстьДвижения = ПолучитьСчетаДУПоКоторымЕстьДвижения(Объект.ДатаСверки, ЭтаФорма.Брокер, Объект.Организация);
	
	Для Каждого СчетДУ ИЗ СчетаДУПоКоторымЕстьДвижения Цикл
		Отбор = Новый Структура("СчетДУ", СчетДУ);
		Если ЭтаФорма.Клиенты.НайтиСтроки(Отбор).Количество() = 0 Тогда
			НоваяСтрока = ЭтаФорма.Клиенты.Добавить();
			НоваяСтрока.Выбран   = Истина;
			НоваяСтрока.СчетДУ   = СчетДУ;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьВсе(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаВыделитьВсе");
	ВыполнитьВыделениеВсех();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
