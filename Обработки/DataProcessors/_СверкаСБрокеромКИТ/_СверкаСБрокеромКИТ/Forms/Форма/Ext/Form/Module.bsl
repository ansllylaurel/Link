&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	Объект.ДатаСверки  = ТекущаяДата() - 86400;
	
	ЭтаФорма.КонДатаСверки = ТекущаяДата();
	ЭтаФорма.НачДатаСверки = НачалоНедели(ЭтаФорма.КонДатаСверки);

//	ЭтаФорма.ПутьНачальный = "\\g1\shares\UK\Client\РегионЭсМ\ОТДЕЛ_ ВНУТРЕННЕГО_ УЧЕТА\Брокеры\КИТ\Отчеты брокера\";
	ЭтаФорма.Брокер        = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_КИТ_Финанс");
	
	ЭтаФорма.ОтображатьПротоколыСверкиТолькоПриНаличииРасхождений = Истина;
		
КонецПроцедуры

&НаСервере
