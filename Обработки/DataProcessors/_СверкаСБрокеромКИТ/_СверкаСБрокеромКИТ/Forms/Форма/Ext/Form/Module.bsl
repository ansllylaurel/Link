
&НаСервереБезКонтекста
Функция ПолучитьСчетаДУПоКоторымЕстьДвижения(ДатаСверки, Брокер, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОбороты.СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Обороты(
		|			&НачДата,
		|			&КонДата,
		|			Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер) КАК ОстаткиДенежныхСредствОбороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОстаткиЦенныхБумагОбороты.СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Обороты(
		|			&НачДата,
		|			&КонДата,
		|			Период,
		|			Организация = &Организация
		|				И ДепозитарныйСчет.Брокер = &Брокер) КАК ОстаткиЦенныхБумагОбороты";
		
	Запрос.УстановитьПараметр("Организация",	Организация);	
	Запрос.УстановитьПараметр("НачДата",		НачалоДня(ДатаСверки));
	Запрос.УстановитьПараметр("КонДата",		КонецДня(ДатаСверки));
	Запрос.УстановитьПараметр("Брокер",			Брокер);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	
КонецФункции

&НаСервереБезКонтекста
Функция ОпределитьСчетДУ(ДатаСверки, Брокер, Организация, знач ИмяФайла, ФорматДанных)
	
	// В версии 1 Файл именуется по следующей схеме:
	//   <Код клиента>_<еще раз код клиента>-<и снова код клиента>_<ДДММГГ - торговый день >_<ЧЧСС - время формирования>.xls
	//   например, 39334_39334-39334_260314_2345.xls
	//
	// В версии 2 поменялся формат файла на xlsx и к имени добавился префикс "Stocks-report_"
	//   например, Stocks-report_39334-25.05.2015-101322.xlsx
	
	Если      ФорматДанных = 1 Тогда
		КодКлиента = Лев(ИмяФайла, 5);
	ИначеЕсли ФорматДанных = 2 Тогда
		КодКлиента = Сред(ИмяФайла, 15, 5);
	Иначе
		ВызватьИсключение "Неизвестная версия формата файла";
	КонецЕсли;
	
	// найдем клиента по коду
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И Код = &Код) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних";

	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Брокер", 		Брокер);
	Запрос.УстановитьПараметр("Код",    		КодКлиента);
	Запрос.УстановитьПараметр("Период", 		ДатаСверки);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетДоверительногоУправления;
	Иначе		
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ОпределитьСчетДУ

