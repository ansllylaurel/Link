// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Импорт перечня банков 580-П",
		"0.05",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "_ИмпортПеречняБанков580П", "Импорт перечня банков 580-П",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = "_ИмпортПеречняБанков580П" Тогда
		ИмпортироватьПереченьБанков580П();
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьКоманду

Процедура ИмпортироватьПереченьБанков580П() Экспорт
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИмпортироватьПереченьБанков580П");
	ВыполнитьИмпорт(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

Процедура ВыполнитьИмпорт(ПараметрыСессии)
	
	ТаблицаПеречняБанков580 = ПолучитьТаблицуПеречняБанков580П(ПараметрыСессии);
	
	Если ТаблицаПеречняБанков580 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьПеречень580П(ТаблицаПеречняБанков580, ПараметрыСессии);
	ОповеститьОбОшибках();	

КонецПроцедуры

Функция ПолучитьТаблицуПеречняБанков580П(ПараметрыСессии)
	
	СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();

	ТекстЗапроса = 
		"SET NOCOUNT ON
		|
		|IF OBJECT_ID('tempdb..#CBR_LIST') IS NOT NULL
		|	Drop Table #CBR_LIST
		|;
		|IF OBJECT_ID('tempdb..#CBR_ListDate') IS NOT NULL
		|	Drop Table #CBR_ListDate
		|;
		|IF OBJECT_ID('tempdb..#Reg_LIST') IS NOT NULL
		|	Drop Table #Reg_LIST
		|
		|SELECT
		|	Files.Source_Id AS Source_Id,
		|	CBR_LIST.StateDate AS StateDate,
		|	CASE
		|		WHEN CBR_LIST.BankName = 'АО РОСЭКСИМБАНК' AND CBR_LIST.RegNumber = '2790'
		|		THEN '2790-Г'
		|		ELSE CBR_LIST.RegNumber
		|	END AS RegNumber,
		|	CBR_LIST.BankName AS BankName,
		|	MIN(Files.Upload_Time) AS Upload_Time
		|INTO #CBR_LIST
		|FROM 
		|	Externals.dbo.CBR_Lists AS CBR_LIST
		|LEFT JOIN Externals.dbo.Files AS Files
		|	ON CBR_LIST.[File_Id] = Files.Id
		|GROUP BY
		|	Files.Source_Id,
		|	CBR_LIST.StateDate,
		|	CBR_LIST.RegNumber,
		|	CBR_LIST.BankName
		|;		
		|SELECT
		|	CBR_LIST.Source_Id,
		|	CBR_LIST.StateDate AS StateDate,
		|	MAX(CBR_LIST_LAST.StateDate) AS LastStateDate,
		|	CBR_LIST.Upload_Time
		|INTO #CBR_ListDate
		|FROM
		|	(SELECT DISTINCT
		|		Source_Id,StateDate,Upload_Time
		|	FROM
		|		#CBR_LIST) AS CBR_LIST
		|LEFT JOIN #CBR_LIST AS CBR_LIST_LAST 
		|	ON CBR_LIST.Source_Id = CBR_LIST_LAST.Source_Id
		|		AND CBR_LIST.StateDate > CBR_LIST_LAST.StateDate
		|GROUP BY	
		|	CBR_LIST.Source_Id,
		|	CBR_LIST.StateDate,
		|	CBR_LIST.Upload_Time
		|;
		|SELECT DISTINCT
		|	Source_Id,RegNumber
		|INTO #Reg_LIST
		|FROM #CBR_LIST
		|;	
		|SELECT
		|	CBR_ListDate.StateDate AS Период,
		|	CBR_ListDate.Upload_Time AS ДатаОбновления,
		|	Reg_LIST.RegNumber AS РегНомер,
		|	ISNULL(CBR_LIST.BankName, CBR_LIST_LAST.BankName) AS Наименование,
		|	CASE 
		|		WHEN CBR_LIST_LAST.RegNumber IS NULL
		|			THEN 1
		|		ELSE 0
		|		END AS Включен
		|FROM	
		|	#CBR_ListDate AS CBR_ListDate
		|	LEFT JOIN #Reg_LIST AS Reg_LIST
		|		ON Reg_LIST.Source_Id = CBR_ListDate.Source_Id
		|	LEFT JOIN #CBR_LIST AS CBR_LIST
		|		ON CBR_ListDate.Source_Id = CBR_LIST.Source_Id
		|			AND CBR_ListDate.StateDate = CBR_LIST.StateDate
		|			AND Reg_LIST.RegNumber = CBR_LIST.RegNumber
		|	LEFT JOIN #CBR_LIST AS CBR_LIST_LAST
		|		ON CBR_ListDate.Source_Id = CBR_LIST_LAST.Source_Id
		|			AND CBR_ListDate.LastStateDate = CBR_LIST_LAST.StateDate
		|			AND Reg_LIST.RegNumber = CBR_LIST_LAST.RegNumber
		|WHERE
		|	CBR_ListDate.Source_Id = 3
		|	AND ((CBR_LIST.RegNumber IS NULL AND CBR_LIST_LAST.RegNumber IS NOT NULL)
		|	OR (CBR_LIST.RegNumber IS NOT NULL AND CBR_LIST_LAST.RegNumber IS NULL))
		|ORDER BY
		|	ISNULL(CBR_LIST.BankName, CBR_LIST_LAST.BankName)";
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Период"			, Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("ДатаОбновления"	, Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("РегНомер"			, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("Наименование"		, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("Включен"			, Новый ОписаниеТипов("Булево"));
	
	ТаблицаПеречняБанков580 = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок);
		
	Если ТаблицаПеречняБанков580 = Неопределено Тогда 
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не удалось получить таблицу перечня из Externals");
		ЗарегистрироватьОшибку("Не удалось получить таблицу перечня из Externals");
	КонецЕсли;

	Возврат ТаблицаПеречняБанков580;
	
КонецФункции

Процедура ЗагрузитьПеречень580П(ТаблицаПеречняБанков580, ПараметрыСессии)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Банки.Ссылка КАК Банк,
		|	Лицензии.Номер КАК РегНомер
		|ПОМЕСТИТЬ _ЛицензииБанков
		|ИЗ
		|	Справочник.Банки КАК Банки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|		ПО Банки.ЮрФизЛицо = Лицензии.ЮрФизЛицо
		|			И (Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.ЛицензияБанкаРоссии))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПеречняБанков580.Период КАК Период,
		|	ТаблицаПеречняБанков580.ДатаОбновления КАК ДатаОбновления,
		|	ТаблицаПеречняБанков580.РегНомер КАК РегНомер,
		|	ТаблицаПеречняБанков580.Наименование КАК Наименование,
		|	ТаблицаПеречняБанков580.Включен КАК Включен
		|ПОМЕСТИТЬ _ТаблицаПеречняБанков580
		|ИЗ
		|	&ТаблицаПеречняБанков580 КАК ТаблицаПеречняБанков580
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПеречняБанков580.Период КАК Период,
		|	_ТаблицаПеречняБанков580.РегНомер КАК РегНомер,
		|	_ТаблицаПеречняБанков580.Наименование КАК Наименование,
		|	_ТаблицаПеречняБанков580.Включен КАК Включен
		|ПОМЕСТИТЬ _НеНайденБанк
		|ИЗ
		|	_ТаблицаПеречняБанков580 КАК _ТаблицаПеречняБанков580
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЛицензииБанков КАК _ЛицензииБанков
		|		ПО _ТаблицаПеречняБанков580.РегНомер = _ЛицензииБанков.РегНомер
		|ГДЕ
		|	_ЛицензииБанков.Банк ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПеречняБанков580.Период КАК Период,
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ) КАК ВнешняяСистема,
		|	ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ПереченьКредитныхОрганизаций580П) КАК ВидПеречня,
		|	_ЛицензииБанков.Банк КАК Объект,
		|	_ТаблицаПеречняБанков580.Включен КАК Включен,
		|	ЕСТЬNULL(ПеречниОбъектов.ДатаОбновления, _ТаблицаПеречняБанков580.ДатаОбновления) КАК ДатаОбновления,
		|	""ЦБ РФ"" КАК Источник
		|ПОМЕСТИТЬ _ПеречеьОбъектов
		|ИЗ
		|	_ТаблицаПеречняБанков580 КАК _ТаблицаПеречняБанков580
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЛицензииБанков КАК _ЛицензииБанков
		|		ПО _ТаблицаПеречняБанков580.РегНомер = _ЛицензииБанков.РегНомер
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПеречниОбъектов КАК ПеречниОбъектов
		|		ПО _ТаблицаПеречняБанков580.Период = ПеречниОбъектов.Период
		|			И (ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ЦБРФ) = ПеречниОбъектов.ВнешняяСистема)
		|			И (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.ПереченьКредитныхОрганизаций580П) = ПеречниОбъектов.ВидПеречня)
		|			И (_ЛицензииБанков.Банк = ПеречниОбъектов.Объект)
		|			И _ТаблицаПеречняБанков580.Включен = ПеречниОбъектов.Включен";
	
	Запрос.УстановитьПараметр("ТаблицаПеречняБанков580"	, ТаблицаПеречняБанков580);
	
	Запрос.Выполнить();
	
	Для Каждого СтрокаДанных Из Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_НеНайденБанк").ПолучитьДанные().Выгрузить() Цикл
		ТекстОшибки = "Не найден банк '" + СтрокаДанных.Наименование + "' по рег.номеру " + СтрокаДанных.РегНомер;
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ЗарегистрироватьОшибку(ТекстОшибки);
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.ПеречниОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВнешняяСистема.Установить(Справочники.ВнешниеСистемы.ЦБРФ);
	НаборЗаписей.Отбор.ВидПеречня.Установить(Справочники.ВидыПеречнейОбъектов.ПереченьКредитныхОрганизаций580П);
	
	НаборЗаписей.Загрузить(Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ПеречеьОбъектов").ПолучитьДанные().Выгрузить());
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки)=Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры // ОповеститьОбОшибках

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(ЭтотОбъект, ИмяКоманды);
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
КонецПроцедуры

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;