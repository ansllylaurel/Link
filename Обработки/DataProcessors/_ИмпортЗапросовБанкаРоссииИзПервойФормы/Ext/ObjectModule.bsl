// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Импорт запросов банка России из первой формы", "0.05","", Истина);
		
	//команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортироватьЗапросыБанкаРоссии", "Импортировать запросы банка России",,  Ложь, "ВызовСерверногоМетода");

	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;	
	
	Если ИдентификаторКоманды = "ИмпортироватьЗапросыБанкаРоссии" Тогда
		
		Если ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
			ИмпортироватьЗапросы();	
		Иначе
			ЗарегистрироватьОшибку("Не удалось выполнить команду [" + ИдентификаторКоманды + "]. Не указано значение параметра [Организация].");	
		КонецЕсли;
					
	Иначе
		ЗарегистрироватьОшибку("Для команды [" + ИдентификаторКоманды + "] не определены действия.");
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура ИмпортироватьЗапросы(НачалоПериода = Неопределено, ИнтерактивныйВызов = Ложь) Экспорт
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортироватьЗапросы()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация", Новый Структура("ИнтерактивныйВызов", ИнтерактивныйВызов));
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	Сервер_1Ф = ?(ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза, "1f", "test1f") + ".g1.lan";
	
	Если ЗначениеЗаполнено(НачалоПериода) Тогда 
		КонецПериода = КонецДня(НачалоПериода);
	Иначе
		КонецПериода = КонецДня(ТекущаяДатаСеанса());
		НачалоПериода = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, КонецПериода, -2);	
	КонецЕсли;
	
	БанкРоссииЮрЛицо = ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрЛицо_ЦБРФ");
	
	Запрос = Новый Запрос; 
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТестЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ДокИсходящий.Ссылка КАК ДокИсходящий
		|ПОМЕСТИТЬ _ЗапросыБанкаРоссии_1С
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования 
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент КАК ДокИсходящий
		|			ПО ИсходящийДокументОснования.Ссылка = ДокИсходящий.Ссылка
		|			И Не ДокИсходящий.ПометкаУдаления
		|			И ДокИсходящий.Дата > &МинусТриМесяца 
		|		ПО ИсходящийДокументОснования.Основание = ВходящийДокумент.Ссылка
		|ГДЕ
		|	ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.Отправитель = &БанкРоссииЮрЛицо
		|	И ВходящийДокумент.Дата > &МинусТриМесяца
		|	И ВходящийДокумент.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыПервойФормы
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.ПерваяФорма)
		|				И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Организации), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ВходящиеДокументы))
		|				И Объект В
		|					(ВЫБРАТЬ
		|						&Организация КАК Объект
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						&БанкРоссииЮрЛицо
		|			
		|					ОБЪЕДИНИТЬ
		|			
		|					ВЫБРАТЬ
		|						_ЗапросыБанкаРоссии_1С.Ссылка
		|					ИЗ
		|						_ЗапросыБанкаРоссии_1С КАК _ЗапросыБанкаРоссии_1С)) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗапросыБанкаРоссии_1С.Ссылка КАК Ссылка,
		|	_ЗапросыБанкаРоссии_1С.ДокИсходящий КАК ДокИсходящий,
		|	_КодыПервойФормы.Код КАК Код
		|ПОМЕСТИТЬ _РанееИмпортированныеЗапросы
		|ИЗ
		|	_ЗапросыБанкаРоссии_1С КАК _ЗапросыБанкаРоссии_1С
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыПервойФормы КАК _КодыПервойФормы
		|		ПО _ЗапросыБанкаРоссии_1С.Ссылка = _КодыПервойФормы.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КодОрганизации.Код КАК КодОрганизации,
		|	_КодБанкаРоссии.Код КАК КодБанкаРоссии
		|ИЗ
		|	_КодыПервойФормы КАК _КодОрганизации
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыПервойФормы КАК _КодБанкаРоссии
		|		ПО (_КодБанкаРоссии.Объект = &БанкРоссииЮрЛицо)
		|ГДЕ
		|	_КодОрганизации.Объект = &Организация";
#КонецОбласти
	
	Запрос.УстановитьПараметр("МинусТриМесяца", ДобавитьМесяц(КонецПериода, -3));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("БанкРоссииЮрЛицо", БанкРоссииЮрЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда 
		
		Если ЗначениеЗаполнено(Выборка.КодОрганизации) И ЗначениеЗаполнено(Выборка.КодБанкаРоссии) Тогда
			КодОрганизации = Выборка.КодОрганизации;
			КодБанкаРоссии = Выборка.КодБанкаРоссии;
		Иначе
		
			Если Не ЗначениеЗаполнено(Выборка.КодОрганизации) Тогда
				ЗарегистрироватьОшибку("Не удалось определить код организации [" + ЭтотОбъект.Организация + "] в первой форме.", Механизм, Сессия);
			ИначеЕсли Не ЗначениеЗаполнено(Выборка.КодБанкаРоссии) Тогда
				ЗарегистрироватьОшибку("Не удалось определить код юр лица [" + БанкРоссииЮрЛицо + "] в первой форме.", Механизм, Сессия);	
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
	
	КонецЕсли; 
	
	КодыРанееИмпортированныхЗапросов = Запрос.МенеджерВременныхТаблиц.Таблицы["_РанееИмпортированныеЗапросы"].ПолучитьДанные().Выгрузить().ВыгрузитьКолонку("Код");
			
	ПараметрыПодключения = РаботаСВнешнимиСистемами.ПерваяФорма_ПолучитьПараметрыПодключения(Сервер_1Ф);
	
	Если ПараметрыПодключения = Неопределено Тогда
		ЗарегистрироватьОшибку("Не удалось установить соединение с первой формой.", Механизм, Сессия);
		Возврат;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("startRow", 0);
	СтруктураЗапроса.Вставить("endRow", 9999);
	СтруктураЗапроса.Вставить("sortModel", РаботаСКоллекциями.ЗначениеВМассив(Новый Структура("sort, colId", "desc", "taskId")));
		
	ОтборПоДате = Новый Структура;
	ОтборПоДате.Вставить("dateFrom", Формат(НачалоПериода, "ДФ=yyyy-MM-ddT00:00:00"));
	ОтборПоДате.Вставить("filterType", "date");
	ОтборПоДате.Вставить("type", "greaterThan");
	
	СтруктураЗапроса.Вставить("filterModel", Новый Структура("modifiedDate", ОтборПоДате)); 
	
	ВыборПараметров = Новый Массив;
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "task", "task"));
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "taskId", "numberValue"));
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam51", "extParam", "LookUpField")); //компания (Рэм, Траст)
	ВыборПараметров.Добавить(Новый Структура("field, type, extParamType", "ExtParam440", "extParam", "LookUpField")); //Инициатор запроса (Банк России)

	СтруктураЗапроса.Вставить("select", ВыборПараметров);
		
	ТелоЗапроса = ПолучитьСтрокуJSON(СтруктураЗапроса);
		
	ТекстСообщения = "Не удалось получить данные запросов банка России из первой формы.";
		
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api-core/datasource/subcat/169/data", ТелоЗапроса, ТекстСообщения); 
	
	Если HTTPОтвет = Неопределено Тогда	
		ЗарегистрироватьОшибку(ТекстСообщения, Механизм, Сессия);
		Возврат;	
	КонецЕсли;     

	РезультатЗапроса = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8"));
	
	Если РезультатЗапроса.Свойство("totalCount") И РезультатЗапроса.totalCount = 0 Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли; 
	
	Если Не РезультатЗапроса.Свойство("tasksDataSourceResponse") Тогда
		ЗарегистрироватьОшибку(ТекстСообщения, Механизм, Сессия);
		Возврат;
	КонецЕсли;

	ДанныеПервойФормы = Новый ТаблицаЗначений;
	ДанныеПервойФормы.Колонки.Добавить("НомерЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ДанныеПервойФормы.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ДанныеПервойФормы.Колонки.Добавить("Получено", Новый ОписаниеТипов("Дата"));
	ДанныеПервойФормы.Колонки.Добавить("РегистрационныйНомер", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	ДанныеПервойФормы.Колонки.Добавить("НомерСвязаннойЗадачи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ДанныеПервойФормы.Колонки.Добавить("МассивФайлов", Новый ОписаниеТипов("Массив"));
	
	Для Каждого ТекДанные Из РезультатЗапроса.tasksDataSourceResponse Цикл
		
		Если ТекДанные.Свойство("isRejected") И ТекДанные.isRejected Тогда
			Продолжить;	
		КонецЕсли; 
		
		Если Не (ТекДанные.Свойство("taskId") И ТекДанные.Свойство("extParams")) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерЗадачи = Формат(ТекДанные.taskId, "ЧГ=0");
		
		Если КодыРанееИмпортированныхЗапросов.Найти(НомерЗадачи) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		extParams = ТекДанные.extParams;
		
		Если Не (extParams.Свойство("ExtParam51") И extParams.Свойство("ExtParam440")) Тогда
			Продолжить;			
		КонецЕсли;  
		
		Если Формат(extParams.ExtParam51.intValue, "ЧГ=0") <> КодОрганизации 
			Или Формат(extParams.ExtParam440.intValue, "ЧГ=0") <> КодБанкаРоссии Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗначенияРеквизитов = ПолучитьЗначенияРеквизитовДляВходящегоДокумента(ТекДанные.task.taskText);
		Исключение
			ЗарегистрироватьОшибку("Ошибка чтения HTML заголовка задачи [" + НомерЗадачи + "]." + Символы.ПС + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		Если ЗначенияРеквизитов = Неопределено Тогда
			ЗарегистрироватьОшибку("Не удалось определить значения реквизитов задачи [" + НомерЗадачи + "].");
			Продолжить; 
		КонецЕсли;
		
		// т.к. перечень задач получаем по значению поля modifiedDate (дата изменения),
		// проверяем ещё и дату "Получено" - что-бы исключить загрузку старых данных.  
		Если ЗначенияРеквизитов.Получено < НачалоПериода Тогда
			Продолжить;
		КонецЕсли;
		
		//если понадобится интерактивно загрузить данные в прошлых периодах, загружаем только на дату указанную на форме.
		Если ИнтерактивныйВызов И ЗначенияРеквизитов.Получено > КонецПериода Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДанныеПервойФормы.Добавить();
		
		НоваяСтрока.НомерЗадачи = НомерЗадачи; 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияРеквизитов);
		
		//получим файлы
		МассивФайлов = ПолучитьМассивФайлов(НомерЗадачи, ПараметрыПодключения);
		
		Если МассивФайлов <> Неопределено Тогда 
			НоваяСтрока.МассивФайлов = МассивФайлов; 
		КонецЕсли;
										
	КонецЦикла; 
	
	Если ДанныеПервойФормы.Количество() = 0 Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли;
	
#Область Текст_Запроса	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеПервойФормы.НомерЗадачи КАК НомерЗадачи,
		|	ДанныеПервойФормы.Сообщение КАК Сообщение,
		|	ДанныеПервойФормы.Получено КАК Получено,
		|	ДанныеПервойФормы.РегистрационныйНомер КАК РегистрационныйНомер,
		|	ДанныеПервойФормы.НомерСвязаннойЗадачи КАК НомерСвязаннойЗадачи
		|ПОМЕСТИТЬ _ДанныеПервойФормы
		|ИЗ
		|	&ДанныеПервойФормы КАК ДанныеПервойФормы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.НомерЗадачи КАК НомерЗадачи,
		|	ВЫБОР
		|		КОГДА МИНИМУМ(ДанныеКалендаря.Дата) = ВложенныйЗапрос.ПолученоНачалоДня
		|			ТОГДА ВложенныйЗапрос.Получено
		|		ИНАЧЕ МИНИМУМ(ДанныеКалендаря.Дата)
		|	КОНЕЦ КАК Дата
		|ПОМЕСТИТЬ _ДатыНовыхДокументов
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ДанныеПервойФормы.НомерЗадачи КАК НомерЗадачи,
		|		_ДанныеПервойФормы.Получено КАК Получено,
		|		НАЧАЛОПЕРИОДА(_ДанныеПервойФормы.Получено, ДЕНЬ) КАК ПолученоНачалоДня
		|	ИЗ
		|		_ДанныеПервойФормы КАК _ДанныеПервойФормы) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ПО ВложенныйЗапрос.ПолученоНачалоДня <= ДанныеКалендаря.Дата
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|			И (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Получено,
		|	ВложенныйЗапрос.НомерЗадачи,
		|	ВложенныйЗапрос.ПолученоНачалоДня
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеПервойФормы.НомерЗадачи КАК НомерЗадачи,
		|	_ДанныеПервойФормы.Сообщение КАК Сообщение,
		|	_ДанныеПервойФормы.Получено КАК Получено,
		|	_ДанныеПервойФормы.РегистрационныйНомер КАК РегистрационныйНомер,
		|	_ДатыНовыхДокументов.Дата КАК ДатаДокумента,
		|	_ДанныеПервойФормы.НомерСвязаннойЗадачи КАК НомерСвязаннойЗадачи,
		|	_РанееИмпортированныеЗапросы.Ссылка КАК ДокРодительИсходящего,
		|	_РанееИмпортированныеЗапросы.ДокИсходящий КАК ДокИсходящий,
		|	""<tr><td>%1</td><td>%2</td><td>%3</td></tr>"" КАК Шаблон
		|ИЗ
		|	_ДанныеПервойФормы КАК _ДанныеПервойФормы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РанееИмпортированныеЗапросы КАК _РанееИмпортированныеЗапросы
		|		ПО _ДанныеПервойФормы.НомерСвязаннойЗадачи = _РанееИмпортированныеЗапросы.Код
		|			И (_ДанныеПервойФормы.НомерСвязаннойЗадачи <> """")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыНовыхДокументов КАК _ДатыНовыхДокументов
		|		ПО _ДанныеПервойФормы.НомерЗадачи = _ДатыНовыхДокументов.НомерЗадачи";
#КонецОбласти

	Запрос.УстановитьПараметр("ДанныеПервойФормы", ДанныеПервойФормы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщения = "";
	
	Пока Выборка.Следующий() Цикл 
				
		НовыйДокумент = Документы.ВходящийДокумент.СоздатьДокумент();
		НовыйДокумент.Дата = Выборка.ДатаДокумента;
		НовыйДокумент.СпособПолучения = Перечисления.СпособыПолученияДокументов.ЭлектронныйДокумент;
		НовыйДокумент.Организация = ЭтотОбъект.Организация;
		НовыйДокумент.Отправитель = БанкРоссииЮрЛицо;
		НовыйДокумент.Статус = Перечисления.СтатусыВходящихДокументов.НаРегистрации;
		НовыйДокумент.ВидВходящегоДокумента = Выборка.Сообщение;
		НовыйДокумент.НомерВходящегоДокумента = Выборка.РегистрационныйНомер;
		НовыйДокумент.ДатаВходящегоДокумента = Выборка.Получено;
		
		ОтветственныйСотрудник = РегистрыСведений.ДолжностныеЛицаОрганизаций.ПолучитьДолжностноеЛицо(
					Выборка.ДатаДокумента,
					ЭтотОбъект.Организация,
					Перечисления.ВидыДолжностныхЛиц.Контролер); //нужен контролер или ген.дир
								
		Если ЗначениеЗаполнено(ОтветственныйСотрудник) Тогда
			РеквизитыОтветственногоСотрудника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтветственныйСотрудник, "ЮрФизЛицо, Пользователь");
			 
			НовыйДокумент.ОтветственныйСотрудник = РеквизитыОтветственногоСотрудника.ЮрФизЛицо;
			НовыйДокумент.Ответственный = РеквизитыОтветственногоСотрудника.Пользователь; 
		Иначе
			ЗарегистрироватьОшибку("Ошибка загрузки входящего документа на основании задачи [" + Выборка.НомерЗадачи + "]. Не удалось определить ответственного сотрудника.");
			Продолжить;
		КонецЕсли;
										
		Если ЗначениеЗаполнено(Выборка.ДокИсходящий) Тогда
			СтрокаОснования = НовыйДокумент.Основания.Добавить();
			СтрокаОснования.Основание = Выборка.ДокИсходящий; 				
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.НомерСвязаннойЗадачи) Тогда
			
			Если Не ЗначениеЗаполнено(Выборка.ДокРодительИсходящего) Тогда
				ЗарегистрироватьОшибку("При создании входящего документа по задаче [" + Выборка.НомерЗадачи + "] не удалось определить основание (исходящий документ) по номеру 1Ф [" + Выборка.НомерСвязаннойЗадачи + "] в разделе [Связанные сообщения].");	
			ИначеЕсли Не ЗначениеЗаполнено(Выборка.ДокИсходящий) Тогда
				ЗарегистрироватьОшибку("При создании входящего документа по задаче [" + Выборка.НомерЗадачи + "] не удалось определить основание (исходящий документ).
									   |Основание исходящего документа [" + Выборка.ДокРодительИсходящего + "], номер 1Ф [" + Выборка.НомерСвязаннойЗадачи + "]");	
			КонецЕсли;
			
		КонецЕсли;
		
		НовыйДокумент.Комментарий = "Создан аппаратно-техническими средствами " + ТекущаяДатаСеанса();
		
		НачатьТранзакцию();
		
		Попытка
		
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
			
			НовыйДокумент.Ответственный = РеквизитыОтветственногоСотрудника.Пользователь;
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		
			РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(
				НовыйДокумент.Ссылка,
				Справочники.ВнешниеСистемы.ПерваяФорма,
				Справочники.ГруппыИмпортируемыхОбъектов.ВходящиеДокументы,
				Выборка.НомерЗадачи);
		
		Исключение	
			ОтменитьТранзакцию();
			Продолжить;
		КонецПопытки; 
		
		СтрокаТаблицы = ДанныеПервойФормы.Найти(Выборка.НомерЗадачи, "НомерЗадачи");
		
		Если СтрокаТаблицы <> Неопределено Тогда
			ЗагрузитьФайлыВХранилище(НовыйДокумент.Ссылка, СтрокаТаблицы.МассивФайлов);
		КонецЕсли;
			
		ЗафиксироватьТранзакцию();
		
		Если ИнтерактивныйВызов Тогда
			ЗарегистрироватьОшибку("Создан документ [" + НовыйДокумент.Ссылка + "] на основании задачи [" + Выборка.НомерЗадачи + "]");						
		Иначе
			СсылкаНаЗадачу = "<A href=""http://" + Сервер_1Ф + "/maintaskform.aspx?TaskID=" + Выборка.НомерЗадачи + """>" + Выборка.НомерЗадачи + "</A>";
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтрШаблон(Выборка.Шаблон, ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(НовыйДокумент.Ссылка), СсылкаНаЗадачу, Выборка.Сообщение);
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда 
		
		ТекстСообщения =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body     {font-family: ""Arial""; font-size: 12px;}
			|		table    {text-align: left; border-spacing: 0; border-collapse: collapse;}
			|		td       {border: 1px solid #ACC8BD; padding: 5px;}
			|		.top     {background: #E4F0DD;}
			|	</style>
			|</head><body><table cols=""3"">
			|<tr class=""top""><td>Входящий документ</td><td>Задача 1Ф</td><td>Сообщение</td></tr>
			|"  + ТекстСообщения + "</table></body></html>";
       			
			РеквизитыОповещения = Новый Структура("Организация, Текст", ЭтотОбъект.Организация, ТекстСообщения);
			Справочники.Оповещения.СформироватьОповещения("Обработка._ИмпортЗапросовБанкаРоссииИзПервойФормы", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
	КонецЕсли; 
		
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
		
КонецПроцедуры 

Функция ПолучитьЗначенияРеквизитовДляВходящегоДокумента(ТекСтрока)
	
	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.УстановитьСтроку(ТекСтрока);
	ПостроительДом = Новый ПостроительDOM;
	ДокументДом = ПостроительДом.Прочитать(ЧтениеHTML);
		
	Если ДокументДом.ПолучитьЭлементыПоИмени("tr").Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ЗначенияРеквизитов = Новый Структура();

	Для Каждого СтрокаТаблицы Из ДокументДом.ПолучитьЭлементыПоИмени("tr") Цикл
		
		Если СтрокаТаблицы.ПервыйДочерний.ТекстовоеСодержимое = "Сообщение" Тогда	
			
			ЗначенияРеквизитов.Вставить("Сообщение", СокрЛП(СтрокаТаблицы.ПоследнийДочерний.ТекстовоеСодержимое));
			
		ИначеЕсли СтрокаТаблицы.ПервыйДочерний.ТекстовоеСодержимое = "Получено" Тогда
			
			ЗначенияРеквизитов.Вставить("Получено", Дата(СтрокаТаблицы.ПоследнийДочерний.ТекстовоеСодержимое));

		ИначеЕсли СтрокаТаблицы.ПервыйДочерний.ТекстовоеСодержимое = "Рег. номер" Тогда
			
			ЗначенияРеквизитов.Вставить("РегистрационныйНомер", СокрЛП(СтрокаТаблицы.ПоследнийДочерний.ТекстовоеСодержимое));
			
		ИначеЕсли СтрокаТаблицы.ПервыйДочерний.ТекстовоеСодержимое = "Связанные сообщения" Тогда 
			
			СтрНачало = СтрНайти(СтрокаТаблицы.ПоследнийДочерний.ТекстовоеСодержимое, "Задача 1Ф:", НаправлениеПоиска.СКонца) + 10;
			
			НомерСвязаннойЗадачи = "";
			
			Для Индекс = СтрНачало По СтрДлина(СтрокаТаблицы.ПоследнийДочерний.ТекстовоеСодержимое) Цикл
				
				ТекСимвол = Сред(СтрокаТаблицы.ПоследнийДочерний.ТекстовоеСодержимое, Индекс, 1);
				
				Если Не ЗначениеЗаполнено(ТекСимвол) Тогда
					Продолжить;	
				КонецЕсли;
				
				Если РаботаСоСтрокамиКлиентСервер.СтрокаСодержитТолькоДопустимыеСимволы(ТекСимвол, "0123456789") Тогда
					НомерСвязаннойЗадачи = НомерСвязаннойЗадачи + ТекСимвол;
				Иначе
					Прервать;
				КонецЕсли;
	
			КонецЦикла;
			
			Если ЗначениеЗаполнено(НомерСвязаннойЗадачи) Тогда				
				ЗначенияРеквизитов.Вставить("НомерСвязаннойЗадачи", НомерСвязаннойЗадачи);
			КонецЕсли;

		КонецЕсли;	
		
	КонецЦикла;
	
	Если ЗначенияРеквизитов.Количество() > 2 Тогда
		Возврат ЗначенияРеквизитов;
	КонецЕсли;
								
КонецФункции

Функция ПолучитьСтрокуJSON(СтруктураДанных)
	
	ЗаписьJSON          = Новый ЗаписьJSON;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции 

Функция ПолучитьМассивФайлов(НомерЗадачи, ПараметрыПодключения)
	
	ТекстСообщения = "Не удалось загрузить файлы из задачи [" + НомерЗадачи + "].";
	
	ТелоЗапроса = ПолучитьСтрокуJSON(Новый Структура("taskId, selectedInfoParts", НомерЗадачи, РаботаСКоллекциями.ЗначениеВМассив("Files")));
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("POST", ПараметрыПодключения, "/api/tasks", ТелоЗапроса, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда	
		ЗарегистрироватьОшибку(ТекстСообщения);
		Возврат Неопределено;	
	КонецЕсли;     

	РезультатЗапроса = ДесериализоватьJSON(HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8")); 
	
	Если Не РезультатЗапроса.Свойство("files") Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ИдФайлов = "";
	
	Для Каждого ТекФайлИнфо Из РезультатЗапроса.files Цикл
		ИдФайлов = ИдФайлов + ?(ИдФайлов = "", "", "%2C") + Формат(ТекФайлИнфо.id, "ЧГ=0");	
	КонецЦикла; 
	
	Если Не ЗначениеЗаполнено(ИдФайлов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	HTTPОтвет = РаботаСВнешнимиСистемами.HTTP_ВыполнитьЗапрос("GET", ПараметрыПодключения, "/api/files/zip/" + ИдФайлов,, ТекстСообщения);
	
	Если HTTPОтвет = Неопределено Тогда	
		ЗарегистрироватьОшибку(ТекстСообщения);
		Возврат Неопределено;	
	КонецЕсли; 
	
	КаталогФайлов = КаталогВременныхФайлов();
	КаталогФайлов = КаталогФайлов + ?(СтрЗаканчиваетсяНа(КаталогФайлов, "\"), "", "\") + НомерЗадачи; 
	
	ЧтениеZIP = Новый ЧтениеZipФайла(HTTPОтвет.ПолучитьТелоКакПоток()); 
	
	МассивФайлов = Новый Массив;
	
	Для Каждого ФайлАрхива Из ЧтениеZIP.Элементы Цикл
		
		Попытка
			ЧтениеZIP.Извлечь(ФайлАрхива, КаталогФайлов, РежимВосстановленияПутейФайловZIP.НеВосстанавливать); 
		Исключение
			ЗарегистрироватьОшибку("Не удалось получить файлы из архива загруженного из задачи [" + НомерЗадачи + "]. " + ОписаниеОшибки());
			Прервать;	
		КонецПопытки;
		
		ПолноеИмяФайла = КаталогФайлов + "\" + ФайлАрхива.Имя; 
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("ПолноеИмя", ФайлАрхива.Имя);
		ОписаниеФайла.Вставить("Хранение", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайла)));		
		
		МассивФайлов.Добавить(ОписаниеФайла);
		
		УдалитьФайлы(ПолноеИмяФайла);
			
	КонецЦикла;
	
	ЧтениеZIP.Закрыть();
	
	Если МассивФайлов.Количество() > 0 Тогда
		Возврат МассивФайлов;	
	Конецесли;
			
КонецФункции 

Процедура ЗагрузитьФайлыВХранилище(НовыйДокумент, МассивФайлов)
		
	Если МассивФайлов.Количество() > 0 Тогда 
		
		ДанныеВерсий = Обработки.РаботаСФайлами.ПрисоединитьФайл(НовыйДокумент, МассивФайлов);
		
		Если ДанныеВерсий.Количество() = 0 Тогда
			
			ЗарегистрироватьОшибку("Не удалось загрузить файлы к объекту [" + СокрЛП(НовыйДокумент) + "]");
			
		Иначе
			
			Для Каждого ЗаписьВерсии Из ДанныеВерсий Цикл
				
				Если ЗаписьВерсии.Свойство("ТекстОшибки") Тогда
					ЗарегистрироватьОшибку(ЗаписьВерсии.ТекстОшибки);
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
		
КонецПроцедуры

Функция ДесериализоватьJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON();
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

Процедура ЗарегистрироватьОшибку(ТекстОшибки, Механизм = Неопределено, Сессия = Неопределено)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
	Если Механизм <> Неопределено И Сессия <> Неопределено Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, ТекстОшибки);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках() Экспорт
		
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры 

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;

