		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Организация = ПериодПредыдущейЗаписи.Организация
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ЮрФизЛицо_Ключ = ПериодПредыдущейЗаписи.ЮрФизЛицо_Ключ
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Язык = ПериодПредыдущейЗаписи.Язык
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыСотрудниковОрганизации_Предварительно КАК _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись
		|		ПО (ПериодПредыдущейЗаписи.ПериодПеред = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Период)
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Организация = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Организация
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ЮрФизЛицо_Ключ = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.ЮрФизЛицо_Ключ
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Язык = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Язык
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Фамилия = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Фамилия
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Имя = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Имя
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Отчество = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Отчество
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Пол = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Пол
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ДатаРождения = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.ДатаРождения
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ИНН = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.ИНН
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ВидУдостоверенияЛичности_Ключ = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.ВидУдостоверенияЛичности_Ключ
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.СерияУдостоверенияЛичности = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.СерияУдостоверенияЛичности
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.НомерУдостоверенияЛичности = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.НомерУдостоверенияЛичности
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ДатаВыдачиУдостоверенияЛичности = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.ДатаВыдачиУдостоверенияЛичности
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.ОрганВыдавшийУдостоверениеЛичности = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.ОрганВыдавшийУдостоверениеЛичности
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.КодОрганаВыдавшегоУдостоверениеЛичности = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.КодОрганаВыдавшегоУдостоверениеЛичности
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.РезидентРФ = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.РезидентРФ
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.Гражданство = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Гражданство
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.СНИЛС = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.СНИЛС
		|			И _РеквизитыСотрудниковОрганизации_Предварительно.МестоРождения = _РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.МестоРождения
		|ГДЕ
		|	_РеквизитыСотрудниковОрганизации_ПредварительноПредыдущаяЗапись.Период ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Обнаружено несколько кодов Матрикс для физ лица [Наименование] ([КодВоВнешнейСистеме]), необходимо ипортировать физ.лицо из Матрикс вручную."" КАК Шаблон,
		|	_ЮрФизЛица.КодВоВнешнейСистеме КАК КодВоВнешнейСистеме,
		|	_ЮрФизЛица.Наименование КАК Наименование
		|ПОМЕСТИТЬ Контроль_УникальностиКодовМХ
		|ИЗ
		|	_ЮрФизЛица КАК _ЮрФизЛица
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЮрФизЛица.КодВоВнешнейСистеме,
		|	_ЮрФизЛица.Наименование
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1";

#КонецОбласти	


	Запрос.Выполнить();
	
	ВременныеТаблицы = Новый Соответствие;
	Для Каждого ВременнаяТаблица Из Запрос.МенеджерВременныхТаблиц.Таблицы Цикл
		Если ТаблицыФайла.Получить(ВременнаяТаблица.ПолноеИмя) = Неопределено Тогда
			ВременныеТаблицы.Вставить(ВременнаяТаблица.ПолноеИмя, ВременнаяТаблица.ПолучитьДанные().Выгрузить());
		КонецЕсли;
	КонецЦикла;	
	
	ДанныеФайла.Вставить("ВременныеТаблицы", ВременныеТаблицы);
	
	ИсходныеТаблицы = Новый Соответствие;
	
	ПравилаИмпорта = ПолучитьТаблицуИзМакета("ПравилаИмпорта");
	ПравилаИмпорта.Колонки.Добавить("Тип");
	
	Для Каждого ПравилоИмпорта Из ПравилаИмпорта Цикл
		ПравилоИмпорта.ИмяТаблицы = ПравилоИмпорта.ВидМД + "_" + ПравилоИмпорта.ИмяМД;
		Если ПравилоИмпорта.ВидМД = "Справочник" И (ПравилоИмпорта.Импортируется ИЛИ ПравилоИмпорта.ИмпортируетсяИзМХ) Тогда
			ПравилоИмпорта.Тип = Тип(ПравилоИмпорта.ВидМД + "Ссылка." + ПравилоИмпорта.ИмяМД);
		КонецЕсли;
	КонецЦикла;
	
	ДополнитьТекстЗапросаТаблицамиМетаданных(Запрос, ПравилаИмпорта);
	
	Запрос.Выполнить();
	
	КонтрольЗаполненияИсходныхТаблиц(Запрос);

	Для Каждого ПравилоИмпорта Из ПравилаИмпорта Цикл
		Если ПравилоИмпорта.Импортируется ИЛИ ПравилоИмпорта.ИмпортируетсяИзМХ Тогда
			ИсходныеТаблицы.Вставить(ПравилоИмпорта.ИмяТаблицы, ПолучитьВременнуюТаблицуИзЗапроса(Запрос, ПравилоИмпорта.ВидМД + "_" + ПравилоИмпорта.ИмяМД, ПравилоИмпорта.Сортировка));
			
			Если ПравилоИмпорта.ВидМД = "Справочник" Тогда
				ИсходныеТаблицы.Вставить("Расхождения_" + ПравилоИмпорта.ИмяМД, ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "Расхождения_" + ПравилоИмпорта.ИмяМД));
			КонецЕсли;
		Иначе //если не импортируется, то проверяем что всё смогли идентифицировать
			
			ТаблицаКонтроля = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "Контроль_" + ПравилоИмпорта.ИмяМД).НайтиСтроки(Новый Структура("Идентифицирован", Ложь));
			Для Каждого СтрокаКонтроля Из ТаблицаКонтроля Цикл
				ТекстОшибки = СтрШаблон("Не удалось идентифицировать элемент ЗУП: %1.%2: %3 (%4). Возможно, не задан код в регистре 'Коды во внешних системах'", ПравилоИмпорта.ВидМД, ПравилоИмпорта.ИмяМД, СокрЛП(СтрокаКонтроля.Наименование), СокрЛП(СтрокаКонтроля.КодВоВнешнейСистеме));
					
				Если ПравилоИмпорта.ВидМД = "Справочник" Тогда
					ТекстОшибки = ТекстОшибки + СтрШаблон(", Внешняя система: %1, Группа объектов: %2", ЭтотОбъект.ВнешняяСистема, ПравилоИмпорта.ГруппаОбъектов);		
				КонецЕсли;
				
				ЗарегистрироватьОшибку(ТекстОшибки);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИсходныеТаблицы.Вставить("ТаблицаПоискаВМатрикс", ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ТаблицаПоискаВМатрикс"));
	ИсходныеТаблицы.Вставить("ПравилаИмпорта", ПравилаИмпорта);

	ДанныеФайла.Вставить("ИсходныеТаблицы", ИсходныеТаблицы);
	
КонецПроцедуры

Процедура ПоместитьВЗапрос_КодыФизическихЛицМХ(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Persons.GUID КАК GUID,
		|	Persons.INN КАК ИНН,
		|	Persons.Birth_Date КАК ДатаРождения,
		|	Persons_Name.Name_Last КАК Фамилия,
		|	Persons_Name.Name_First КАК Имя,
		|	Persons_Name.Name_Second КАК Отчество
		|ПОМЕСТИТЬ _ТаблицаПоискаВМатрикс
		|ИЗ
		|	_Persons КАК Persons
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Persons_Name.GUID КАК GUID,
		|			МИНИМУМ(Persons_Name.Date_From) КАК Date_From
		|		ИЗ
		|			_Persons_Name КАК Persons_Name
		|		
		|		СГРУППИРОВАТЬ ПО
		|			Persons_Name.GUID) КАК Persons_Name_Date_From
		|		ПО Persons.GUID = Persons_Name_Date_From.GUID
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Persons_Name КАК Persons_Name
		|		ПО Persons.GUID = Persons_Name.GUID
		|			И (Persons_Name_Date_From.Date_From = Persons_Name.Date_From)";
	
	Запрос.Выполнить();
	
#Область ТекстЗапроса
	ТекстЗапроса = 
		"SET NOCOUNT ON
		|;
		|
		|IF OBJECT_ID('tempdb..#Person') IS NOT NULL
		|	Drop Table #Person
		|	
		|CREATE TABLE #Person(
		|	GUID nvarchar(36),
		|	ИНН nvarchar(12),
		|	ДатаРождения date,
		|	Фамилия nvarchar(4000),
		|	Имя nvarchar(4000),
		|	Отчество nvarchar(4000)
		|)
		|;
		|INSERT INTO
		|	#Person
		|SELECT		
		|	GUID,
		|	ИНН,
		|	ДатаРождения,
		|	Фамилия,
		|	Имя,
		|	Отчество
		|FROM (
		|	&ДанныеПоискаВМатрикс
		|) Person
		|;
		|SELECT 
		|	[Person].GUID [GUID],
		|	[ContactFaces].ContactFaceID [КодМатрикс] 
		|FROM
		|	#Person [Person]
		|	INNER JOIN ReferenceBooks.dbo.ContactFaces [ContactFaces]
		|	ON [Person].Фамилия = [ContactFaces].LastNameIP
		|		AND [Person].Имя = [ContactFaces].FirstNameIP
		|		AND [Person].Отчество = [ContactFaces].MiddleNameIP
		|		AND ([Person].ДатаРождения = [ContactFaces].BirthDate
		|			OR [Person].ИНН = [ContactFaces].INN)";
#КонецОбласти		

	ДанныеПоискаВМатрикс = Новый Массив;
	КоличествоЗаписей	 = 0;

	Для Каждого СтрокаПоискаВМатрикс Из ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_ТаблицаПоискаВМатрикс") Цикл
		КоличествоЗаписей = КоличествоЗаписей + 1;
		
		ДанныеПоискаВМатрикс.Добавить(
			"SELECT"
			+ " '"  + СтрокаПоискаВМатрикс.GUID + "'" + ?(КоличествоЗаписей = 1, " GUID", "") 
			+ ", '" + СтрокаПоискаВМатрикс.ИНН + "'" + ?(КоличествоЗаписей = 1, " ИНН", "") 
			+ ", '"  + Формат(СтрокаПоискаВМатрикс.ДатаРождения, "ДФ=yyyy/MM/dd") + "'" + ?(КоличествоЗаписей = 1, " ДатаРождения", "")
			+ ", '" + СтрокаПоискаВМатрикс.Фамилия + "'" + ?(КоличествоЗаписей = 1, " Фамилия", "")
			+ ", '" + СтрокаПоискаВМатрикс.Имя + "'" + ?(КоличествоЗаписей = 1, " Имя", "")
			+ ", '" + СтрокаПоискаВМатрикс.Отчество + "'" + ?(КоличествоЗаписей = 1, " Отчество", "")
		);
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДанныеПоискаВМатрикс", СтрСоединить(ДанныеПоискаВМатрикс, Символы.ПС + "UNION ALL" + Символы.ПС));

	СтрокаСоединенияСМатрих = РаботаСВнешнимиСистемами.СтрокаСоединенияСМатрих(); //"Driver={SQL Server};Server=AP22.G1.LAN;UID=svc_API_AM;PWD=p8z4gr39VAxXAfhn;Database=MatriX";
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("GUID",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	ТипыКолонок.Вставить("КодМатрикс",	Новый ОписаниеТипов("Число"));

	ДанныеМатрих = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединенияСМатрих, ТекстЗапроса, ТипыКолонок);
	
	Если ДанныеМатрих = Неопределено Тогда // будет поиск по пустой таблице
		ДанныеМатрих = Новый ТаблицаЗначений;
		Для Каждого ТипКолонки Из ТипыКолонок Цикл
			ДанныеМатрих.Колонки.Добавить(ТипКолонки.Ключ, ТипКолонки.Значение);	
		КонецЦикла;
	КонецЕсли;
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ДанныеМатрих, "_КодыФизическихЛицМХ", Запрос);
	
КонецПроцедуры

Функция ПеречислениеВТаблицу(ИмяПеречисления)

	ТаблицаЗначенийПеречисления = Новый ТаблицаЗначений;
	ТаблицаЗначенийПеречисления.Колонки.Добавить("Ссылка",				Новый ОписаниеТипов("ПеречислениеСсылка." + ИмяПеречисления));
	ТаблицаЗначенийПеречисления.Колонки.Добавить("КодВоВнешнейСистеме",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80)));
	ТаблицаЗначенийПеречисления.Колонки.Добавить("Наименование",		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(80)));
	
	ИсключаемыеСостоянияСотрудникаОрганизации = СтрРазделить("ПоУходуЗаРебенком,Карантин,ГосударственныеОбязанности,НеРаботает,ОтпускУчебный,ГосударственныеОбязанности,Прогулы,Простой,ТравмаНаПроизводстве,ПоУходуЗаВзрослым,Протезирование,ПособиеПриДолечивании", ",", Ложь);
	
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		
		Если ИмяПеречисления = "СостоянияСотрудникаОрганизации" 
		   И ИсключаемыеСостоянияСотрудникаОрганизации.Найти(ЗначениеПеречисления.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаЗначенийПеречисления.Добавить();
		НоваяСтрока.Ссылка	= Перечисления[ИмяПеречисления][ЗначениеПеречисления.Имя];
		НоваяСтрока.КодВоВнешнейСистеме = ЗначениеПеречисления.Имя;
		НоваяСтрока.Наименование = Строка(НоваяСтрока.Ссылка);
		
	КонецЦикла;
	
	ЗначенияСтарыхВерсийЗУП = Новый Структура;
	
	Если ИмяПеречисления = "СостоянияСотрудникаОрганизации" Тогда
		
		ЗначенияСтарыхВерсийЗУП.Вставить("Работает",						Перечисления.СостоянияСотрудникаОрганизации.Работа);
		ЗначенияСтарыхВерсийЗУП.Вставить("Уволен",							Перечисления.СостоянияСотрудникаОрганизации.Увольнение);
		ЗначенияСтарыхВерсийЗУП.Вставить("Заболевание",						Перечисления.СостоянияСотрудникаОрганизации.Болезнь);
		ЗначенияСтарыхВерсийЗУП.Вставить("ВКомандировке",					Перечисления.СостоянияСотрудникаОрганизации.Командировка);
		ЗначенияСтарыхВерсийЗУП.Вставить("ОтпускЕжегодный",					Перечисления.СостоянияСотрудникаОрганизации.ОтпускОсновной);
		ЗначенияСтарыхВерсийЗУП.Вставить("ОтпускБезСохраненияЗарплаты",		Перечисления.СостоянияСотрудникаОрганизации.ОтпускНеоплачиваемыйПоРазрешениюРаботодателя);
		ЗначенияСтарыхВерсийЗУП.Вставить("ВОтпускеПоБеременностиИРодам",	Перечисления.СостоянияСотрудникаОрганизации.ОтпускПоБеременностиИРодам);
		ЗначенияСтарыхВерсийЗУП.Вставить("ВОтпускеПоУходуЗаРебенком",		Перечисления.СостоянияСотрудникаОрганизации.ОтпускПоУходуЗаРебенком);
		ЗначенияСтарыхВерсийЗУП.Вставить("ОтсутствуетПоНевыясненнойПричине",Перечисления.СостоянияСотрудникаОрганизации.ОтсутствиеПоНевыясненнымПричинам);
		ЗначенияСтарыхВерсийЗУП.Вставить("ПоУходуЗаРебенком",				Перечисления.СостоянияСотрудникаОрганизации.Болезнь);
		ЗначенияСтарыхВерсийЗУП.Вставить("Карантин",						Перечисления.СостоянияСотрудникаОрганизации.Болезнь);
		ЗначенияСтарыхВерсийЗУП.Вставить("ГосударственныеОбязанности",		Перечисления.СостоянияСотрудникаОрганизации.ВыполнениеГосударственныхОбязанностей);
		
	КонецЕсли;
	
	Если ИмяПеречисления = "ВидыКадровыхСобытий" Тогда
		
		ЗначенияСтарыхВерсийЗУП.Вставить("ПриемНаРаботу",	Перечисления.ВидыКадровыхСобытий.Прием);
		ЗначенияСтарыхВерсийЗУП.Вставить("НачальныеДанные", Перечисления.ВидыКадровыхСобытий.Прием);
		
	КонецЕсли;
	
	Для Каждого ЗначениеСтарыхВерсийЗУП Из ЗначенияСтарыхВерсийЗУП Цикл
		
		НоваяСтрока = ТаблицаЗначенийПеречисления.Добавить();
		НоваяСтрока.Ссылка				= ЗначениеСтарыхВерсийЗУП.Значение;
		НоваяСтрока.КодВоВнешнейСистеме = ЗначениеСтарыхВерсийЗУП.Ключ;
		НоваяСтрока.Наименование 		= Строка(ЗначениеСтарыхВерсийЗУП.Значение);
		
	КонецЦикла;
		
	Возврат ТаблицаЗначенийПеречисления;
	
КонецФункции

Функция ПолучитьСтруктуруВизуализации() Экспорт
	
	ПравилаИмпорта	= ПолучитьТаблицуИзМакета("ПравилаИмпорта");
	ПараметрыПоиска = Новый Структура("Основной,ТаблицаРодитель", Истина, "");
	
	Возврат ПолучитьПодчиненныеЭлементыЭлементыСтруктурыВизуализации(ПравилаИмпорта, ПараметрыПоиска)[0];
	
КонецФункции

Функция ПолучитьПодчиненныеЭлементыЭлементыСтруктурыВизуализации(ПравилаИмпорта, ПараметрыПоиска)

	ПодчиненныеЭлементы = Новый Массив;

	НайденныеСтроки = ПравилаИмпорта.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого ПравилоИмпорта Из НайденныеСтроки Цикл
		ИмяТаблицы = ПравилоИмпорта.ВидМД + "_" + ПравилоИмпорта.ИмяМД;
		
		СтруктураВизуализации = Новый Структура;
		СтруктураВизуализации.Вставить("ВидМД",					ПравилоИмпорта.ВидМД);
		СтруктураВизуализации.Вставить("ИмяТаблицы",			ИмяТаблицы);
		СтруктураВизуализации.Вставить("ТаблицаРодитель",		ПравилоИмпорта.ТаблицаРодитель);
		СтруктураВизуализации.Вставить("ТаблицаРасхождений",	СтрЗаменить(ИмяТаблицы, "Справочник_", "Расхождения_"));
		СтруктураВизуализации.Вставить("Наименование",			ПравилоИмпорта.Представление);
		СтруктураВизуализации.Вставить("ПодчиненныеЭлементы", 	ПолучитьПодчиненныеЭлементыЭлементыСтруктурыВизуализации(ПравилаИмпорта, Новый Структура("ТаблицаРодитель", ПравилоИмпорта.ИмяМД)));
		СтруктураВизуализации.Вставить("РучнаяЗагрузка",		ПравилоИмпорта.РучнаяЗагрузка);
		
		ПодчиненныеЭлементы.Добавить(СтруктураВизуализации);
	КонецЦикла;	
	
	Возврат ПодчиненныеЭлементы;
	
КонецФункции

Функция ОбъектXDTOВТаблицу(Знач ОбъектXDTO, Источник)
	
	ПутьИсточника	= СтрРазделить(Источник, ".");
	
	Для Каждого ЭлементПутиИсточника Из ПутьИсточника Цикл
		ОбъектXDTO = ОбъектXDTO[ЭлементПутиИсточника];
	КонецЦикла;
	
	ТипСвойстваXDTO		= ТипЗнч(ОбъектXDTO);
	ТаблицаОбъектаXDTO	= Новый ТаблицаЗначений;
	
	Если ТипСвойстваXDTO = Тип("СписокXDTO") Тогда
		СвойстваXDTO = ОбъектXDTO.ВладеющееСвойство.Тип.Свойства;
		
	ИначеЕсли ТипСвойстваXDTO = Тип("ОбъектXDTO") Тогда
		СвойстваXDTO = ОбъектXDTO.Свойства();
		
	КонецЕсли;
		
	Для Каждого СвойствоXDTO Из СвойстваXDTO Цикл
		Если СвойствоXDTO.Тип.Имя = "Дата" Тогда
			ТаблицаОбъектаXDTO.Колонки.Добавить(СвойствоXDTO.Имя, Новый ОписаниеТипов("Дата"));
		Иначе
			ТаблицаОбъектаXDTO.Колонки.Добавить(СвойствоXDTO.Имя, Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
		КонецЕсли;
	КонецЦикла;	
	
	Если ТипСвойстваXDTO = Тип("СписокXDTO") Тогда
		
		Для Каждого СтрокаXDTO Из ОбъектXDTO Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаОбъектаXDTO.Добавить(), СтрокаXDTO);
		КонецЦикла;
		
	ИначеЕсли ТипСвойстваXDTO = Тип("ОбъектXDTO") Тогда
		ЗаполнитьЗначенияСвойств(ТаблицаОбъектаXDTO.Добавить(), ОбъектXDTO);
		
	Иначе
		ВызватьИсключение "Тип " + ТипСвойстваXDTO + " свойства XDTO не поддерживается"
	КонецЕсли;
	
	Возврат ТаблицаОбъектаXDTO;
	
КонецФункции

Функция ПроверитьСоответствиеОрганизацииВФайла(ОбъектXDTO)
	
	ГуидыОрганизаций = ПолучитьГуидыОрганизаций();
	НайденнаяСтрока = ГуидыОрганизаций.Найти(ОбъектXDTO.Firm_GUID, "GUID");
	
	Возврат (НайденнаяСтрока <> Неопределено И НайденнаяСтрока.Организация = ЭтотОбъект.Организация);
	
КонецФункции // ПроверитьСоответствиеОрганизацииВФайла

Функция ПолучитьМассивАрхивныхЭлементов()
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Период",						ЭтотОбъект.ДатаСоздания);
	Запрос.УстановитьПараметр("ВнешняяСистема", 			ЭтотОбъект.ВнешняяСистема);
	Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Firm_GUID",					ЭтотОбъект.Firm_GUID);
	Запрос.УстановитьПараметр("ДатаЗапретаРедактирования",	ЭтотОбъект.ДатаЗапретаРедактирования);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сотрудники.Ссылка КАК Ссылка,
		|	Сотрудники.ЮрФизЛицо КАК ЮрФизЛицо,
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия ЕСТЬ НЕ NULL 
		|		И СотрудникиОрганизацииСрезПоследних.ВидСобытия = ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|		И СотрудникиОрганизацииСрезПоследних.Период < &ДатаЗапретаРедактирования КАК АрхивныеДанные
		|ПОМЕСТИТЬ _Сотрудники
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = &ВнешняяСистема
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Сотрудники)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО Сотрудники.Ссылка = КодыВоВнешнихСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Период, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ПО Сотрудники.Ссылка = СотрудникиОрганизацииСрезПоследних.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	_Сотрудники КАК _Сотрудники
		|ГДЕ
		|	_Сотрудники.АрхивныеДанные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КодыФизическихЛиц.Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица)) КАК КодыФизическихЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Сотрудники КАК _Сотрудники
		|		ПО КодыФизическихЛиц.Объект = _Сотрудники.ЮрФизЛицо
		|
		|СГРУППИРОВАТЬ ПО
		|	КодыФизическихЛиц.Объект
		|
		|ИМЕЮЩИЕ
		|	МИНИМУМ(_Сотрудники.АрхивныеДанные) = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КодыПодразделений.Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Подразделения)) КАК КодыПодразделений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Период, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ПО КодыПодразделений.Объект = СотрудникиОрганизацииСрезПоследних.Подразделение
		|			И (СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		|		ПО (СотрудникиОрганизации.Организация = &Организация)
		|			И (СотрудникиОрганизации.Период < &Период)
		|			И КодыПодразделений.Объект = СотрудникиОрганизации.Подразделение
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.Период ЕСТЬ NULL
		|	И СотрудникиОрганизации.Период ЕСТЬ НЕ NULL 
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КодыДолжностей.Объект
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = &ВнешняяСистема
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Должности)) КАК КодыДолжностей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации.СрезПоследних(&Период, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ПО КодыДолжностей.Объект = СотрудникиОрганизацииСрезПоследних.Должность
		|			И (СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СотрудникиОрганизации КАК СотрудникиОрганизации
		|		ПО (СотрудникиОрганизации.Организация = &Организация)
		|			И (СотрудникиОрганизации.Период < &Период)
		|			И КодыДолжностей.Объект = СотрудникиОрганизации.Должность
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.Период ЕСТЬ NULL
		|	И СотрудникиОрганизации.Период ЕСТЬ НЕ NULL ";
	
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура КонтрольЗаполненияИсходныхТаблиц(Запрос)
	
	ИменаТаблицКонтроля = Новый Массив;
	ИменаТаблицКонтроля.Добавить("Контроль_УникальностиКодовМХ");
	
	Для Каждого ИмяТаблицыКонтроля Из ИменаТаблицКонтроля Цикл
		Для Каждого СтрокаКонтроля Из ПолучитьВременнуюТаблицуИзЗапроса(Запрос, ИмяТаблицыКонтроля) Цикл
			ЗарегистрироватьОшибку(СформироватьСтрокуПоШаблону(СтрокаКонтроля, СтрокаКонтроля.Шаблон));
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ДополнитьТекстЗапросаТаблицамиМетаданных 

Процедура ДополнитьТекстЗапросаТаблицамиМетаданных(Запрос, ПравилаИмпорта)
	
	ЭлементыТекстаЗапроса = Новый Массив;
	
	Для Каждого ПравилоИмпорта Из ПравилаИмпорта Цикл
		Если ПравилоИмпорта.ВидМД = "Справочник" Тогда
			РеквизитыСправочника = ПолучитьЗагружаемыеРеквизиты(ПравилоИмпорта, Запрос);
			ЭлементыТекстаЗапроса.Добавить(ПолучитьТекстЗапросаСправочника(ПравилоИмпорта, Запрос, РеквизитыСправочника));
			ЭлементыТекстаЗапроса.Добавить(ПолучитьТекстЗапросаТаблицыРасхождений(ПравилоИмпорта, Запрос, РеквизитыСправочника));
			
		ИначеЕсли ПравилоИмпорта.ВидМД = "РегистрСведений" Тогда
			ИзмеренияРегистра = ПолучитьЗагружаемыеРеквизиты(ПравилоИмпорта, Запрос, "Измерения");
			РеквизитыРегистра = ПолучитьЗагружаемыеРеквизиты(ПравилоИмпорта, Запрос, "Реквизиты");
			
			ЭлементыТекстаЗапроса.Добавить(ПолучитьТекстЗапросаРегистра(ПравилоИмпорта, Запрос, ИзмеренияРегистра, РеквизитыРегистра));
			
		КонецЕсли;	
			
	КонецЦикла;	
	
	ПереносТекстЗапроса =
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
	
	Запрос.Текст = СтрСоединить(ЭлементыТекстаЗапроса, ПереносТекстЗапроса);
	
КонецПроцедуры

Функция ПолучитьЗагружаемыеРеквизиты(ПравилоИмпорта, Запрос, ВидРеквизитов = "")
	
	ТаблицаСДаннымиЗУП = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_" + ПравилоИмпорта.ИмяМД);
	ЗагружаемыеРеквизиты = Новый Массив;
	
	Если ПравилоИмпорта.ВидМД = "Справочник" Тогда
		Если ТаблицаСДаннымиЗУП.Колонки.Найти("Наименование") <> Неопределено Тогда
			ЗагружаемыеРеквизиты.Добавить(Новый Структура("Имя", "Наименование"));
		КонецЕсли;
		
		Если Метаданные.Справочники[ПравилоИмпорта.ИмяМД].Иерархический Тогда
			Если ТаблицаСДаннымиЗУП.Колонки.Найти("Родитель") <> Неопределено Тогда
				ЗагружаемыеРеквизиты.Добавить(Новый Структура("Имя, ИмяТаблицы", "Родитель", ПравилоИмпорта.ИмяТаблицы));
			КонецЕсли;
		КонецЕсли;	
		
		Для Каждого Реквизит Из Метаданные.Справочники[ПравилоИмпорта.ИмяМД].Реквизиты Цикл
			Если ТаблицаСДаннымиЗУП.Колонки.Найти(Реквизит.Имя) <> Неопределено Тогда
				ЗагружаемыеРеквизиты.Добавить(ПолучитьОписаниеЗагружаемогоРеквизита(ПравилоИмпорта, Реквизит));
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ПравилоИмпорта.ВидМД = "РегистрСведений" Тогда
		
		Если ВидРеквизитов = "Измерения" Тогда
			Для Каждого Измерение Из Метаданные.РегистрыСведений[ПравилоИмпорта.ИмяМД].Измерения Цикл
				Если ТаблицаСДаннымиЗУП.Колонки.Найти(Измерение.Имя) <> Неопределено Тогда
					ЗагружаемыеРеквизиты.Добавить(ПолучитьОписаниеЗагружаемогоРеквизита(ПравилоИмпорта, Измерение));
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ВидРеквизитов = "Реквизиты" Тогда
			
			Для Каждого Ресурс Из Метаданные.РегистрыСведений[ПравилоИмпорта.ИмяМД].Ресурсы Цикл
				Если ТаблицаСДаннымиЗУП.Колонки.Найти(Ресурс.Имя) <> Неопределено Тогда
					ЗагружаемыеРеквизиты.Добавить(ПолучитьОписаниеЗагружаемогоРеквизита(ПравилоИмпорта, Ресурс));
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Реквизит Из Метаданные.РегистрыСведений[ПравилоИмпорта.ИмяМД].Реквизиты Цикл
				Если ТаблицаСДаннымиЗУП.Колонки.Найти(Реквизит.Имя) <> Неопределено Тогда
					ЗагружаемыеРеквизиты.Добавить(ПолучитьОписаниеЗагружаемогоРеквизита(ПравилоИмпорта, Измерение));
				КонецЕсли;
			КонецЦикла;

		
		КонецЕсли;
	КонецЕсли;
		
	Возврат ЗагружаемыеРеквизиты;
	
КонецФункции

Функция ПолучитьОписаниеЗагружаемогоРеквизита(ПравилоИмпорта, Реквизит)
	
	ЗагружаемыйРеквизит = Новый Структура("Имя");
	ЗаполнитьЗначенияСвойств(ЗагружаемыйРеквизит, Реквизит); 
	
	ПравилоИмпортаРеквизита = ПравилоИмпорта.Владелец().Найти(Реквизит.Тип.Типы()[0],"Тип");
	Если ПравилоИмпортаРеквизита <> Неопределено Тогда
		ЗагружаемыйРеквизит.Вставить("ИмяТаблицы", ПравилоИмпортаРеквизита.ИмяТаблицы);
	КонецЕсли;
	
	Возврат ЗагружаемыйРеквизит;
	
КонецФункции

Функция ПолучитьТекстЗапросаСправочника(ПравилоИмпорта, Запрос, РеквизитыСправочника)
	
	ТаблицаСДаннымиЗУП = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_" + ПравилоИмпорта.ИмяМД);
	
	ЭлементыТекстаЗапроса = Новый Массив;
	ЭлементыТекстаЗапроса.Добавить("ВЫБРАТЬ РАЗРЕШЕННЫЕ");
	ЭлементыТекстаЗапроса.Добавить("	""Справочник_%1"" КАК ИмяТаблицы,");
	ЭлементыТекстаЗапроса.Добавить("	ЕСТЬNULL(%1.Ссылка, _%1.Ключ) КАК Ключ,");
	ЭлементыТекстаЗапроса.Добавить("	ЕСТЬNULL(%1.ВерсияДанных, ВЫРАЗИТЬ(_%1.Ключ КАК Справочник.%1).ВерсияДанных) КАК ВерсияДанных,");
	
	Если ЗначениеЗаполнено(ПравилоИмпорта.ПолеРодитель) Тогда 
		ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
			"	ЕСТЬNULL(_%1.%2_Ключ, %1.%2) КАК КлючРодитель,",
			ПравилоИмпорта.ИмяМД,
			ПравилоИмпорта.ПолеРодитель));
	КонецЕсли;
	
#Область СтатусЗагрузки
	ЭлементыСтатусаЗагрузки = Новый Массив;
	ЭлементыСтатусаЗагрузки.Добавить("	ВЫБОР");
	
	ЭлементыСтатусаЗагрузки.Добавить(
		"		КОГДА %1.Ссылка В (&МассивАрхивныхЭлементов)
		|			ТОГДА 9");
			
	ЭлементыСтатусаЗагрузки.Добавить(
		"		КОГДА ТИПЗНАЧЕНИЯ(_%1.Ссылка) <> ТИП(Справочник.%1)
		|				И %1.Ссылка ЕСТЬ NULL
		|			ТОГДА 1
		|		КОГДА _%1.Ссылка ЕСТЬ NULL
		|			ТОГДА 2");
	
	ЭлементыСтатусаЗагрузки.Добавить(СтрШаблон(
		"		КОГДА ЕСТЬNULL(_%1.КодВоВнешнейСистеме, """") <> ЕСТЬNULL(Коды%2.Код, """")",
		ПравилоИмпорта.ИмяМД,
		ПравилоИмпорта.ГруппаОбъектов));
		
	Если ПравилоИмпорта.Импортируется Тогда
		Для Каждого Реквизит Из РеквизитыСправочника Цикл
			ЭлементыСтатусаЗагрузки.Добавить(СтрШаблон(
				"				ИЛИ ЕСТЬNULL(_%1.%2, """") <> ЕСТЬNULL(%1.%2, """")",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЦикла;
	КонецЕсли;
	
	ЭлементыСтатусаЗагрузки.Добавить(	
		"			ТОГДА 3");
		
	ЭлементыСтатусаЗагрузки.Добавить(	
		"		ИНАЧЕ 4
		|	КОНЕЦ КАК СтатусЗагрузки,");
	
	ЭлементыТекстаЗапроса.Добавить(СтрСоединить(ЭлементыСтатусаЗагрузки, Символы.ПС));
	
#КонецОбласти

#Область ОбновитьРеквизиты
	ЭлементыОбновитьРеквизиты = Новый Массив;
	Для Каждого Реквизит Из РеквизитыСправочника Цикл
		ЭлементыОбновитьРеквизиты.Добавить(СтрШаблон(
			"ЕСТЬNULL(_%1.%2, """") <> ЕСТЬNULL(%1.%2, """")",
			ПравилоИмпорта.ИмяМД,
			Реквизит.Имя));
			
		Если Реквизит.Свойство("ИмяТаблицы") И НЕ Реквизит.Имя = "Родитель" Тогда 	
			ЭлементыОбновитьРеквизиты.Добавить(СтрШаблон(
			"	ЕСТЬNULL(%1.СтатусЗагрузки < 4, ЛОЖЬ)",
			Реквизит.ИмяТаблицы));
		КонецЕсли;
	КонецЦикла;
	
	ЭлементыТекстаЗапроса.Добавить("	" + СтрСоединить(ЭлементыОбновитьРеквизиты, Символы.ПС + "		ИЛИ ") + " КАК ОбновитьРеквизиты,");
#КонецОбласти

	ЭлементыТекстаЗапроса.Добавить("	ЕСТЬNULL(_%1.Ссылка, %1.Ссылка) КАК Ссылка,");
	
#Область Реквизиты
	Для Каждого Реквизит Из РеквизитыСправочника Цикл
		ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
			"	ЕСТЬNULL(_%1.%2, %1.%2) КАК %2,",
			ПравилоИмпорта.ИмяМД,
			Реквизит.Имя));
			
		Если ТаблицаСДаннымиЗУП.Колонки.Найти(Реквизит.Имя + "_Ключ") <> Неопределено Тогда
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2_Ключ, %1.%2) КАК %2_Ключ,",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;	
			
		Если Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	""%1"" КАК %2_Тип,",
			    Реквизит.ИмяТаблицы,
				Реквизит.Имя));
		КонецЕсли;
		
		Если Реквизит.Свойство("ИмяТаблицы") И НЕ Реквизит.Имя = "Родитель" Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	_%1.%2 ЕСТЬ НЕ NULL  
				|		И  %1.%2 ЕСТЬ НЕ NULL
				|		И (_%1.%2 <> %1.%2 ИЛИ %3.СтатусЗагрузки < 4) КАК %2_Изменен,",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя,
				Реквизит.ИмяТаблицы));
		ИначеЕсли Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	_%1.%2 ЕСТЬ НЕ NULL  
				|		И  %1.%2 ЕСТЬ НЕ NULL
				|		И _%1.%2 <> %1.%2 КАК %2_Изменен,",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		Иначе
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2, %1.%2) <> ЕСТЬNULL(%1.%2, _%1.%2) КАК %2_Изменен,",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;
		
		ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
			"	%1.%2 КАК %2_СтароеЗначение,",
			ПравилоИмпорта.ИмяМД,
			Реквизит.Имя));
			
	КонецЦикла;
#КонецОбласти

	ЭлементыТекстаЗапроса.Добавить(СтрШаблон("	ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.%1) КАК ГруппаОбъектов,", ПравилоИмпорта.ГруппаОбъектов));
	ЭлементыТекстаЗапроса.Добавить(СтрШаблон("	_%1.КодВоВнешнейСистеме КАК КодВоВнешнейСистеме,", ПравилоИмпорта.ИмяМД));
	ЭлементыТекстаЗапроса.Добавить(СтрШаблон("	ЕСТЬNULL(_%1.КодВоВнешнейСистеме, """") <> ЕСТЬNULL(Коды%2.Код, """") КАК ОбновитьКодВоВнешнейСистеме", ПравилоИмпорта.ИмяМД, ПравилоИмпорта.ГруппаОбъектов));
	
	Если ТаблицаСДаннымиЗУП.Колонки.Найти("КодМатрикс") <> Неопределено Тогда
		ЭлементыТекстаЗапроса.Добавить(",	ЕСТЬNULL(КодыМатрикс.Код, _%1.КодМатрикс) КАК КодМатрикс");
	КонецЕсли;
	
	ЭлементыТекстаЗапроса.Добавить(
		"ПОМЕСТИТЬ Справочник_%1
		|ИЗ
		|	_%1 КАК _%1");
	
	Для Каждого Реквизит Из РеквизитыСправочника Цикл
		Если Реквизит.Свойство("ИмяТаблицы") И НЕ Реквизит.Имя = "Родитель" Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"		ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %1
				|		ПО _%2.%3_Ключ = %1.Ключ",
			    Реквизит.ИмяТаблицы,
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;
	КонецЦикла;
		
	ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
		"		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.%1 КАК %1
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|					&Период,
		|					ВнешняяСистема = &ВнешняяСистема
		|						И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.%2)) КАК Коды%2
		|			ПО %1.Ссылка = Коды%2.Объект",
		ПравилоИмпорта.ИмяМД,
		ПравилоИмпорта.ГруппаОбъектов));

	Если ТаблицаСДаннымиЗУП.Колонки.Найти("КодМатрикс") <> Неопределено Тогда
		ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
			"			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|					&Период,
			|					ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
			|						И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.%2)) КАК КодыМатрикс
			|			ПО %1.Ссылка = КодыМатрикс.Объект",
			ПравилоИмпорта.ИмяМД,
			ПравилоИмпорта.ГруппаОбъектов));
	КонецЕсли;
		
	ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
		"		ПО _%1.Ссылка = %1.Ссылка",
		ПравилоИмпорта.ИмяМД));
		
	Возврат СтрШаблон(СтрСоединить(ЭлементыТекстаЗапроса, Символы.ПС), ПравилоИмпорта.ИмяМД);
		
КонецФункции

Функция ПолучитьТекстЗапросаРегистра(ПравилоИмпорта, Запрос, ИзмеренияРегистра, РеквизитыРегистра)

	ТаблицаСДаннымиЗУП = ПолучитьВременнуюТаблицуИзЗапроса(Запрос, "_" + ПравилоИмпорта.ИмяМД);
	
	ЭлементыТекстаЗапроса = Новый Массив;
	ЭлементыТекстаЗапроса.Добавить("ВЫБРАТЬ РАЗРЕШЕННЫЕ");
	ЭлементыТекстаЗапроса.Добавить("	""РегистрСведений_%1"" КАК ИмяТаблицы,");
	
	Если ЗначениеЗаполнено(ПравилоИмпорта.ПолеРодитель) Тогда 
		ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
			"	ЕСТЬNULL(_%1.%2_Ключ, %1.%2) КАК КлючРодитель,",
			ПравилоИмпорта.ИмяМД,
			ПравилоИмпорта.ПолеРодитель));
	КонецЕсли;

#Область СтатусЗагрузки
	ЭлементыСтатусаЗагрузки = Новый Массив;
	ЭлементыСтатусаЗагрузки.Добавить("	ВЫБОР");
	
	ТекстШаблона = 	"		КОГДА %1.%2 ЕСТЬ NULL И Справочник_%3.СтатусЗагрузки <> 5 И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования
					|			ТОГДА 1

					|		КОГДА %1.%2 ЕСТЬ NULL
					|			ТОГДА 5
					
					|		КОГДА _%1.%2 ЕСТЬ NULL  И Справочник_%3.СтатусЗагрузки <> 5 И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования
					|			ТОГДА 2
					
					|		КОГДА _%1.%2 ЕСТЬ NULL
					|			ТОГДА 6";
	
	Если ТаблицаСДаннымиЗУП.Колонки.Найти("Период") = Неопределено Тогда
		
		ТекстШаблона = СтрЗаменить(ТекстШаблона, "И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования", "");
		
	КонецЕсли;	
	
	ЭлементыСтатусаЗагрузки.Добавить(СтрШаблон(ТекстШаблона,
												ПравилоИмпорта.ИмяМД,
												ПравилоИмпорта.ПолеРодитель,
												ПравилоИмпорта.ТаблицаРодитель));
	
	ЭлементыСравненияРеквизитов = Новый Массив;
	
	Для Каждого Реквизит Из РеквизитыРегистра Цикл
		ЭлементыСравненияРеквизитов.Добавить(СтрШаблон(
			"ЕСТЬNULL(_%1.%2, """") <> ЕСТЬNULL(%1.%2, """")",
			ПравилоИмпорта.ИмяМД,
			Реквизит.Имя));
			
		Если Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыСравненияРеквизитов.Добавить(СтрШаблон(
			"ЕСТЬNULL(%1.СтатусЗагрузки < 4, ЛОЖЬ)",
			Реквизит.ИмяТаблицы));
		КонецЕсли;
			
	КонецЦикла;
		
	ЭлементыСтатусаЗагрузки.Добавить("		КОГДА " + СтрСоединить(ЭлементыСравненияРеквизитов, Символы.ПС + "			ИЛИ "));	

    ТекстШаблона3 = "ТОГДА		
				|	ВЫБОР КОГДА Справочник_%3.СтатусЗагрузки <> 5 И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования
				|			ТОГДА 3 
				|			ИНАЧЕ 7
				|	КОНЕЦ";
	
	ТекстШаблона4 =	"	ИНАЧЕ
					|		ВЫБОР КОГДА Справочник_%3.СтатусЗагрузки <> 5 И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования
					|			ТОГДА 4 
					|			ИНАЧЕ 8
					|		КОНЕЦ
					|	КОНЕЦ КАК СтатусЗагрузки,";
	

	Если ТаблицаСДаннымиЗУП.Колонки.Найти("Период") = Неопределено Тогда
		
		ТекстШаблона3 = СтрЗаменить(ТекстШаблона3, "И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования", "");
		ТекстШаблона4 = СтрЗаменить(ТекстШаблона4, "И ЕСТЬNULL(_%1.Период, %1.Период) >= &ДатаЗапретаРедактирования", "");
		
	КонецЕсли;	
	
	
	ЭлементыСтатусаЗагрузки.Добавить(СтрШаблон(ТекстШаблона3,
												ПравилоИмпорта.ИмяМД,
												ПравилоИмпорта.ПолеРодитель,
												ПравилоИмпорта.ТаблицаРодитель));
	
	
	ЭлементыСтатусаЗагрузки.Добавить(СтрШаблон(ТекстШаблона4,	
												ПравилоИмпорта.ИмяМД,
												ПравилоИмпорта.ПолеРодитель,
												ПравилоИмпорта.ТаблицаРодитель));
	
	ЭлементыТекстаЗапроса.Добавить(СтрСоединить(ЭлементыСтатусаЗагрузки, Символы.ПС));
	
#КонецОбласти

	Если ТаблицаСДаннымиЗУП.Колонки.Найти("Период") <> Неопределено Тогда
		ЭлементыТекстаЗапроса.Добавить("	ЕСТЬNULL(_%1.Период, %1.Период) КАК Период,");
	КонецЕсли;	
	
	ЭлементыПолейЗапроса = Новый Массив;
	
#Область ИзмеренияРегистра
	Для Каждого Измерение Из ИзмеренияРегистра Цикл
		
		Если Измерение.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(%1.Наименование, %2.%3) КАК %3",
				Измерение.ИмяТаблицы,
				ПравилоИмпорта.ИмяМД,
				Измерение.Имя));
		Иначе
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2, %1.%2) КАК %2",
				ПравилоИмпорта.ИмяМД,
				Измерение.Имя));
		КонецЕсли;
		
		Если ТаблицаСДаннымиЗУП.Колонки.Найти(Измерение.Имя + "_Ключ") <> Неопределено Тогда
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2_Ключ, %1.%2) КАК %2_Ключ",
				ПравилоИмпорта.ИмяМД,
				Измерение.Имя));
		КонецЕсли;	
		
		Если Измерение.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	""%1"" КАК %2_Тип,",
			    Измерение.ИмяТаблицы,
				Измерение.Имя));
		КонецЕсли;
		
	КонецЦикла;
#КонецОбласти

#Область Реквизиты
	Для Каждого Реквизит Из РеквизитыРегистра Цикл
		Если Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(%1.Наименование, %2.%3) КАК %3",
				Реквизит.ИмяТаблицы,
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		Иначе
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2, %1.%2) КАК %2",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;
				
		Если Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	_%1.%2 ЕСТЬ НЕ NULL  
				|		И  %1.%2 ЕСТЬ НЕ NULL
				|		И (_%1.%2 <> %1.%2 ИЛИ %3.СтатусЗагрузки < 4) КАК %2_Изменен",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя,
				Реквизит.ИмяТаблицы));
		Иначе
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2, %1.%2) <> ЕСТЬNULL(%1.%2, _%1.%2) КАК %2_Изменен",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;
			
		ЭлементыПолейЗапроса.Добавить(СтрШаблон(
			"	%1.%2 КАК %2_СтароеЗначение",
			ПравилоИмпорта.ИмяМД,
			Реквизит.Имя));
		
		Если ТаблицаСДаннымиЗУП.Колонки.Найти(Реквизит.Имя + "_Ключ") <> Неопределено Тогда
			ЭлементыПолейЗапроса.Добавить(СтрШаблон(
				"	ЕСТЬNULL(_%1.%2_Ключ, %1.%2) КАК %2_Ключ",
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;	
		
		Если Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"	""%1"" КАК %2_Тип,",
			    Реквизит.ИмяТаблицы,
				Реквизит.Имя));
		КонецЕсли;
			
	КонецЦикла;
#КонецОбласти

	ЭлементыТекстаЗапроса.Добавить(СтрСоединить(ЭлементыПолейЗапроса, "," + Символы.ПС));
	
	ЭлементыТекстаЗапроса.Добавить(
		"ПОМЕСТИТЬ РегистрСведений_%1
		|ИЗ
		|_%1 КАК _%1");
		
	ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
		"		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			%1.*
		|		ИЗ
		|			РегистрСведений.%1 КАК %1
		|		ГДЕ
		|			%1.Организация = &Организация) КАК %1",
		ПравилоИмпорта.ИмяМД));
		
	ЭлементыСоединения = Новый Массив;
	Если ТаблицаСДаннымиЗУП.Колонки.Найти("Период") <> Неопределено Тогда
		ЭлементыСоединения.Добавить("%1.Период = _%1.Период");
	КонецЕсли;
		
	Для Каждого Измерение Из ИзмеренияРегистра Цикл
		ЭлементыСоединения.Добавить(СтрШаблон(
			"	%1.%2 = _%1.%2",
			ПравилоИмпорта.ИмяМД, 
			Измерение.Имя));
	КонецЦикла;
	
	ЭлементыТекстаЗапроса.Добавить("ПО " + СтрСоединить(ЭлементыСоединения, Символы.ПС + "			И "));

	Для Каждого Измерение Из ИзмеренияРегистра Цикл
		Если Измерение.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"		ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %1
				|		ПО ЕСТЬNULL(_%2.%3_Ключ,%2.%3) = %1.Ключ",
			    Измерение.ИмяТаблицы,
				ПравилоИмпорта.ИмяМД,
				Измерение.Имя));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из РеквизитыРегистра Цикл
		Если Реквизит.Свойство("ИмяТаблицы") Тогда 	
			ЭлементыТекстаЗапроса.Добавить(СтрШаблон(
				"		ЛЕВОЕ СОЕДИНЕНИЕ %1 КАК %1
				|		ПО ЕСТЬNULL(_%2.%3_Ключ,%2.%3) = %1.Ключ",
			    Реквизит.ИмяТаблицы,
				ПравилоИмпорта.ИмяМД,
				Реквизит.Имя));
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрШаблон(СтрСоединить(ЭлементыТекстаЗапроса, Символы.ПС), ПравилоИмпорта.ИмяМД);
	
КонецФункции

Функция ПолучитьТекстЗапросаТаблицыРасхождений(ПравилоИмпорта, Запрос, РеквизитыСправочника)
	
	ЭлементыТекстаЗапроса = Новый Массив;
		
#Область ШаблонКодВоВнешнейСистеме
	ШаблонКодВоВнешнейСистеме = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(%1.Ссылка, _%1.Ключ) КАК Ключ,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(_%1.КодВоВнешнейСистеме, """") = ЕСТЬNULL(КодыВоВнешнихСистемах.Код, """")
			|			ТОГДА 4
			|		ИНАЧЕ Справочник_%1.СтатусЗагрузки
			|	КОНЕЦ КАК СтатусЗагрузки,
			|	""КодВоВнешнейСистеме"" КАК Реквизит,
			|	_%1.КодВоВнешнейСистеме КАК ЗначениеЗУП,
			|	КодыВоВнешнихСистемах.Код КАК Значение
			|ПОМЕСТИТЬ Расхождения_%1
			|ИЗ
			|	_%1 КАК _%1
			|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.%1 КАК %1
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|					&Период,
			|					ВнешняяСистема = &ВнешняяСистема
			|						И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.%2)) КАК КодыВоВнешнихСистемах
			|			ПО %1.Ссылка = КодыВоВнешнихСистемах.Объект
			|		ПО _%1.Ссылка = %1.Ссылка
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник_%1 КАК Справочник_%1
			|	ПО ЕСТЬNULL(%1.Ссылка, _%1.Ключ) = Справочник_%1.Ключ"; 
#КонецОбласти
	
#Область ШаблонРеквизита
	ШаблонРеквизита = 
			"
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЕСТЬNULL(%1.Ссылка, _%1.Ключ),
			|	ВЫБОР
			|		КОГДА _%1.%3 = ЕСТЬNULL(%1ЗУП.%3, %1.%3)
			|			ТОГДА 4
			|		ИНАЧЕ Справочник_%1.СтатусЗагрузки
			|	КОНЕЦ,
			|	""%3"",
			|	_%1.%3 КАК %3,
			|	ЕСТЬNULL(%1ЗУП.%3, %1.%3)
			|ИЗ
			|	_%1 КАК _%1
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.%1 КАК %1ЗУП
			|		ПО _%1.Ссылка = %1ЗУП.Ссылка
			|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.%1 КАК %1
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
			|					&Период,
			|					ВнешняяСистема = &ВнешняяСистема
			|						И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.%2)) КАК КодыВоВнешнихСистемах
			|			ПО %1.Ссылка = КодыВоВнешнихСистемах.Объект
			|		ПО _%1.Ссылка = %1.Ссылка
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник_%1 КАК Справочник_%1
			|	ПО ЕСТЬNULL(%1.Ссылка, _%1.Ключ) = Справочник_%1.Ключ"; 
			
#КонецОбласти

	ЭлементыТекстаЗапроса.Добавить(СтрШаблон(ШаблонКодВоВнешнейСистеме, ПравилоИмпорта.ИмяМД, ПравилоИмпорта.ГруппаОбъектов));
	
	Для Каждого Реквизит Из РеквизитыСправочника Цикл
		ЭлементыТекстаЗапроса.Добавить(СтрШаблон(ШаблонРеквизита, ПравилоИмпорта.ИмяМД, ПравилоИмпорта.ГруппаОбъектов, Реквизит.Имя));
	КонецЦикла;
	
	Возврат СтрСоединить(ЭлементыТекстаЗапроса, Символы.ПС);
	
КонецФункции

#КонецОбласти

#Область ЗаписьДанных

Процедура ЗаписатьДанные(ДанныеФайла) Экспорт
	
	ЭтотОбъект.ИнформацияОбОбновлении.Очистить();

	ПравилаИмпорта = ДанныеФайла.ИсходныеТаблицы.Получить("ПравилаИмпорта");
	
	Для Каждого ПравилоИмпорта Из ПравилаИмпорта Цикл
		Если ПравилоИмпорта.ВидМД = "Справочник" И (ПравилоИмпорта.Импортируется ИЛИ ПравилоИмпорта.ИмпортируетсяИзМХ) Тогда
			ТаблицаСправочника = ДанныеФайла.ИсходныеТаблицы.Получить("Справочник_" + ПравилоИмпорта.ИмяМД);
			
			Для Каждого СтрокаДанных Из ТаблицаСправочника Цикл
				Если СтрокаДанных.УстранитьРасхождения Тогда
					
					НачатьТранзакцию();
					
					Отказ = Ложь;
					
					Если ТипЗнч(СтрокаДанных.Ключ) <> Тип("Строка") Тогда
						Если СтрокаДанных.ВерсияДанных <> СтрокаДанных.Ключ.ВерсияДанных Тогда
							ЗарегистрироватьОшибку("С момента чтения данных элемент справочника " + ПравилоИмпорта.ИмяМД + ": " + СтрокаДанных.Ключ + " изменился. Необходимо прочитать файл заново.");
							ОтменитьТранзакцию();
							Продолжить;
						КонецЕсли;
						
						Попытка
							СтрокаДанных.Ключ.ПолучитьОбъект().Заблокировать();
						Исключение
							ЗарегистрироватьОшибку("Не удалось заблокировать элемент справочника " + ПравилоИмпорта.ИмяМД + ": " + СтрокаДанных.Ключ); 
							ОтменитьТранзакцию();
							Продолжить;
						КонецПопытки;
					КонецЕсли;
					
					ЗаписатьЭлементСправочника(ДанныеФайла, СтрокаДанных, Отказ);
					
					Если Отказ Тогда
						ОтменитьТранзакцию();
						УдалитьИнформациюОбОбновлении(СтрокаДанных);
						Продолжить;
					КонецЕсли;
					
					Если ПравилоИмпорта.Основной Тогда 
						ПараметрыПоиска = Новый Структура("ВидМД, ТаблицаРодитель", "РегистрСведений", ПравилоИмпорта.ИмяМД);
						НайденныеСтроки = ПравилаИмпорта.НайтиСтроки(ПараметрыПоиска);
						
						Для Каждого ПравилоРегистра Из НайденныеСтроки Цикл
							ЗаписатьРегистрСведений(ДанныеФайла, ПравилоРегистра, СтрокаДанных, Отказ);
						КонецЦикла;
					КонецЕсли;
					
					Если Отказ Тогда 
						ОтменитьТранзакцию();
						УдалитьИнформациюОбОбновлении(СтрокаДанных);
					Иначе
						ЗафиксироватьТранзакцию();
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого СтрокаИнформацияОбОбновлении Из ЭтотОбъект.ИнформацияОбОбновлении Цикл
		Если СтрокаИнформацияОбОбновлении.Создан Тогда
			Если СтрокаИнформацияОбОбновлении.ВнешняяСистема = Справочники.ВнешниеСистемы.Матрих Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаИнформацияОбОбновлении.ОписаниеИзменений, СтрокаИнформацияОбОбновлении.Объект);		
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("'%1' (%2, %3) импортирован из %4", СтрокаИнформацияОбОбновлении.Объект, СтрокаИнформацияОбОбновлении.ГруппаОбъектов, СтрокаИнформацияОбОбновлении.КодВоВнешнейСистеме, СтрокаИнформацияОбОбновлении.ВнешняяСистема), СтрокаИнформацияОбОбновлении.Объект);	
			КонецЕсли;
			
		ИначеЕсли СтрокаИнформацияОбОбновлении.Обновлен Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("'%1' (%2, %3) обновлён из %4" + Символы.ПС + "%5", СтрокаИнформацияОбОбновлении.Объект, СтрокаИнформацияОбОбновлении.ГруппаОбъектов, СтрокаИнформацияОбОбновлении.КодВоВнешнейСистеме, СтрокаИнформацияОбОбновлении.ВнешняяСистема, СтрокаИнформацияОбОбновлении.ОписаниеИзменений), СтрокаИнформацияОбОбновлении.Объект);	
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Обновление '%1' (%2, %3) из %4  не требуется", СтрокаИнформацияОбОбновлении.Объект, СтрокаИнформацияОбОбновлении.ГруппаОбъектов, СтрокаИнформацияОбОбновлении.КодВоВнешнейСистеме, СтрокаИнформацияОбОбновлении.ВнешняяСистема), СтрокаИнформацияОбОбновлении.Объект);	
			
		КонецЕсли;
		
		РегистрыСведений.ОбновленияОбъектовИзВнешнихСистем.ЗарегистрироватьДатуОбновления(СтрокаИнформацияОбОбновлении.Объект, ЭтотОбъект.ВнешняяСистема, СтрокаИнформацияОбОбновлении.ОписаниеИзменений);
	КонецЦикла;	
		
	Если ЭтотОбъект.ИнтерактивныйЗапуск Тогда
		Запрос = Новый Запрос;
		ЗаполнитьИсходныеТаблицы(Запрос, ДанныеФайла);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьЭлементСправочника(ДанныеФайла, СтрокаДанных, Отказ)
	
	Если СтрокаДанных.СтатусЗагрузки > 0 Тогда
		ПравилоИмпорта = ДанныеФайла.ИсходныеТаблицы.Получить("ПравилаИмпорта").Найти(СтрокаДанных.ИмяТаблицы, "ИмяТаблицы");
		
		Если ПравилоИмпорта.ИмпортируетсяИзМХ Тогда
			Если СтрокаДанных.СтатусЗагрузки = 1 Тогда
				ПарамерыПоискаВМатрикс	= ДанныеФайла.ИсходныеТаблицы.Получить("ТаблицаПоискаВМатрикс").Найти(СтрокаДанных.КодВоВнешнейСистеме, "GUID");
				СтрокаДанных.Ссылка		= ИмпортироватьИзМатрикс(СтрокаДанных.КодМатрикс, ПарамерыПоискаВМатрикс, ПравилоИмпорта);
				
				Если НЕ ЗначениеЗаполнено(СтрокаДанных.Ссылка) Тогда
					Отказ = Истина;
					Возврат;
				КонецЕсли;
				
				УстановитьКодВнешнейСистемы(СтрокаДанных.КодВоВнешнейСистеме, СтрокаДанных);
				
			ИначеЕсли СтрокаДанных.СтатусЗагрузки = 2 Тогда
				УстановитьКодВнешнейСистемы("", СтрокаДанных);
				
			ИначеЕсли СтрокаДанных.СтатусЗагрузки = 3 Тогда
				Если СтрокаДанных.ОбновитьКодВоВнешнейСистеме Тогда
					УстановитьКодВнешнейСистемы(СтрокаДанных.КодВоВнешнейСистеме, СтрокаДанных);	
				КонецЕсли;
				
			КонецЕсли;
		Иначе
			Если СтрокаДанных.СтатусЗагрузки = 1 Тогда
				ЭлементСправочника = Справочники[ПравилоИмпорта.ИмяМД].СоздатьЭлемент();
			Иначе
				ЭлементСправочника = СтрокаДанных.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
			ЭлементСправочника.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы", Истина);
			
			УстановитьОбновитьСсылкиВСтрокеДанных(ДанныеФайла, СтрокаДанных, Отказ);
			
			Если СтрокаДанных.ОбновитьРеквизиты Тогда
				ЗаполнитьЗначенияСвойств(ЭлементСправочника, СтрокаДанных);
				
				Попытка
					ТекстСообщения = "Не удалось импортировать элемент справочника '" + СтрокаДанных.ГруппаОбъектов + "' с кодом '" + СтрокаДанных.КодВоВнешнейСистеме + "'. Система сообщает: ";
					ЭлементСправочника.Записать();
				Исключение
					ВывестиОписаниеОшибки(ТекстСообщения, ОписаниеОшибки(), Отказ);
					Возврат;
				КонецПопытки;
					
				СтрокаДанных.Ссылка = ЭлементСправочника.Ссылка;

				ДополнитьИнформациюОбОбновлении(СтрокаДанных, СтрСоединить(ДополнитьИнформациюОРасхожденииРеквизитов(СтрокаДанных), Символы.ПС));
			КонецЕсли;
			
			Если ЭлементСправочника.ПометкаУдаления <> (СтрокаДанных.СтатусЗагрузки = 2) Тогда
				ЭлементСправочника.УстановитьПометкуУдаления(СтрокаДанных.СтатусЗагрузки = 2);
			КонецЕсли;
			
			Если СтрокаДанных.ОбновитьКодВоВнешнейСистеме Тогда
				УстановитьКодВнешнейСистемы(СтрокаДанных.КодВоВнешнейСистеме, СтрокаДанных);	
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаДанных.СтатусЗагрузки >= 4 Тогда
			ДополнитьИнформациюОбОбновлении(СтрокаДанных, "")
		Иначе	
			СтрокаДанных.СтатусЗагрузки = 4;
			СтрокаДанных.УстранитьРасхождения = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьРегистрСведений(ДанныеФайла, ПравилоИмпорта, СтрокаРодитель, Отказ)
	
	ПараметрыПоиска = Новый Структура(ПравилоИмпорта.ПолеРодитель + "_Ключ", СтрокаРодитель.Ключ);
	ТаблицаРегистра = ДанныеФайла.ИсходныеТаблицы.Получить(ПравилоИмпорта.ВидМД + "_" + ПравилоИмпорта.ИмяМД).Скопировать(ПараметрыПоиска);

	НаборЗаписей = РегистрыСведений[ПравилоИмпорта.ИмяМД].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор[ПравилоИмпорта.ПолеРодитель].Установить(СтрокаРодитель.Ссылка);
	НаборЗаписей.Отбор.Организация.Установить(ЭтотОбъект.Организация);
	НаборЗаписей.Прочитать();
	ЗаписиВРегистреОтсутствуют = НаборЗаписей.Количество() = 0 И ПравилоИмпорта.ИмяМД = "РеквизитыСотрудниковОрганизации";
	
	УстранитьРасхождения = Ложь;
	Для Каждого СтрокаРегистра Из ТаблицаРегистра Цикл
		Если СтрокаРегистра.УстранитьРасхождения //Есть строки для записи
		   И СтрокаРегистра.СтатусЗагрузки < 4 Тогда //Есть расхождения
			УстранитьРасхождения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если УстранитьРасхождения Или ЗаписиВРегистреОтсутствуют Тогда 
		
		НаборСтрокДляЗаписи = Новый Массив;
		
		РасхожденияРеквизитов = Новый Массив;
		РасхожденияРеквизитов.Добавить("Изменены записи регистра сведений " + Метаданные.РегистрыСведений[ПравилоИмпорта.ИмяМД].Представление());
		
		Для Каждого СтрокаРегистра Из ТаблицаРегистра Цикл
			Если (СтрокаРегистра.СтатусЗагрузки = 1 И СтрокаРегистра.УстранитьРасхождения)  		//Добавление новой записи  (данные из ЗУП)
				ИЛИ (СтрокаРегистра.СтатусЗагрузки = 2 И НЕ СтрокаРегистра.УстранитьРасхождения)	//Отказ от удаления записи (данные из УФО)
				ИЛИ (СтрокаРегистра.СтатусЗагрузки = 3 И СтрокаРегистра.УстранитьРасхождения)      	//Устранение расхождения в существуюшей записи (данные из ЗУП)
				ИЛИ СтрокаРегистра.СтатусЗагрузки = 4 												//Расхождений нет, запись сохраняется (данные из ЗУП) 
				ИЛИ СтрокаРегистра.СтатусЗагрузки = 6												//Отказ от удаления записи в закрытом периоде в ЗУП (данные УФО)
				ИЛИ СтрокаРегистра.СтатусЗагрузки = 8		 										//Расхождений нет в закрытом периоде (данные ЗУП) 
				Или ЗаписиВРегистреОтсутствуют Тогда                                                //Считаем что может быть только добавление новых записей
				
				НаборСтрокДляЗаписи.Добавить(СтрокаРегистра);
				
				РасхожденияРеквизитов = ДополнитьИнформациюОРасхожденииРеквизитов(СтрокаРегистра, РасхожденияРеквизитов);
				
			ИначеЕсли СтрокаРегистра.СтатусЗагрузки = 3 И НЕ СтрокаРегистра.УстранитьРасхождения  	
				//Отказ от устранения расхождений в существуюшей записи, вернуть все реквизиты (данные из УФО)
				ИЛИ СтрокаРегистра.СтатусЗагрузки = 7 Тогда 										
				//Отказ от устранения расхождений в существуюшей записи закрытого периода, вернуть все реквизиты (данные из УФО)
				
				Для Каждого Колонка Из ТаблицаРегистра.Колонки Цикл
					Если СтрЗаканчиваетсяНа(Колонка.Имя, "_СтароеЗначение") Тогда
						СтрокаРегистра[СтрЗаменить(Колонка.Имя, "_СтароеЗначение", "")] = СтрокаРегистра[Колонка.Имя];
					КонецЕсли;
				КонецЦикла;
				
				НаборСтрокДляЗаписи.Добавить(СтрокаРегистра);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаписатьНаборЗаписейРегистра(ДанныеФайла, НаборСтрокДляЗаписи, ПравилоИмпорта.ИмяМД, Новый Структура(ПравилоИмпорта.ПолеРодитель, СтрокаРодитель.Ссылка), Отказ);
		ДополнитьИнформациюОбОбновлении(СтрокаРодитель, СтрСоединить(РасхожденияРеквизитов, Символы.ПС));
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьНаборЗаписейРегистра(ДанныеФайла, НаборСтрокДляЗаписи, ИмяРегистра, Отбор = Неопределено, Отказ)
	
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	
	Если Отбор <> Неопределено Тогда
		Для Каждого ЭлементОтбора Из Отбор Цикл
			НаборЗаписей.Отбор[ЭлементОтбора.Ключ].Установить(ЭлементОтбора.Значение);
		КонецЦикла;
	КонецЕсли;
	
	НаборЗаписей.Отбор.Организация.Установить(ЭтотОбъект.Организация);
	
	Для Каждого СтрокаРегистра Из НаборСтрокДляЗаписи Цикл
		УстановитьОбновитьСсылкиВСтрокеДанных(ДанныеФайла, СтрокаРегистра, Отказ);
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), СтрокаРегистра);
	КонецЦикла;	

	НаборЗаписей.ДополнительныеСвойства.Вставить("ИмпортИзВнешнейСистемы", Истина);
	
	Попытка 
		ТекстСообщения = "Не удалось импортировать записи регистра сведений '" + Метаданные.РегистрыСведений[ИмяРегистра].Представление() + ". Система сообщает: ";
		НаборЗаписей.Записать();
	Исключение 
		ВывестиОписаниеОшибки(ТекстСообщения, ОписаниеОшибки(), Отказ);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьОбновитьСсылкиВСтрокеДанных(ДанныеФайла, СтрокаДанных, Отказ)
	
	Для Каждого Колонка Из СтрокаДанных.Владелец().Колонки Цикл
		Если СтрЗаканчиваетсяНа(Колонка.Имя, "_Тип") И ЗначениеЗаполнено(СтрокаДанных[СтрЗаменить(Колонка.Имя, "_Тип", "_Ключ")]) Тогда
			СтрокаДанныхРеквизита = ДанныеФайла.ИсходныеТаблицы.Получить(СтрокаДанных[Колонка.Имя]).Найти(СтрокаДанных[СтрЗаменить(Колонка.Имя, "_Тип", "_Ключ")], "Ключ");
			Если СтрокаДанныхРеквизита <> Неопределено Тогда
				Если СтрокаДанныхРеквизита.СтатусЗагрузки < 4 Тогда
					ЗаписатьЭлементСправочника(ДанныеФайла, СтрокаДанныхРеквизита, Отказ);
				КонецЕсли;
				СтрокаДанных[СтрЗаменить(Колонка.Имя, "_Тип", "")] = СтрокаДанныхРеквизита.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Процедура УстановитьКодВнешнейСистемы(КодВоВнешнейСистеме, СтрокаДанных)
	
	Если ЗначениеЗаполнено(КодВоВнешнейСистеме) Тогда
	
		МенеджерЗаписи = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период			= Дата(1980, 1, 1);
		МенеджерЗаписи.Объект			= СтрокаДанных.Ссылка;
		МенеджерЗаписи.ВнешняяСистема	= ЭтотОбъект.ВнешняяСистема;
		МенеджерЗаписи.ГруппаОбъектов	= СтрокаДанных.ГруппаОбъектов;
		МенеджерЗаписи.Код				= СтрокаДанных.КодВоВнешнейСистеме;
		МенеджерЗаписи.Записать();
		
		ДополнитьИнформациюОбОбновлении(СтрокаДанных, СтрШаблон("КодВоВнешнейСистеме (%1) [] -> [%2]", ЭтотОбъект.ВнешняяСистема, СтрокаДанных.КодВоВнешнейСистеме));  
		
	Иначе
		
		НаборЗаписей = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.ВнешняяСистема.Установить(ЭтотОбъект.ВнешняяСистема);
		НаборЗаписей.Отбор.ГруппаОбъектов.Установить(СтрокаДанных.ГруппаОбъектов);
		НаборЗаписей.Отбор.Объект.Установить(СтрокаДанных.Ссылка);
		
		НаборЗаписей.Записать();
		
		ДополнитьИнформациюОбОбновлении(СтрокаДанных, СтрШаблон("КодВоВнешнейСистеме (%1) [%2] -> []", ЭтотОбъект.ВнешняяСистема, СтрокаДанных.КодВоВнешнейСистеме));  
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура УстановитьСсылкиПоКлючу(СтрокаСправочника, ТаблицаОбработки, Поля)
	
	Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл
		ПараметрыПоиска = Новый Структура(Поле + "_Ключ", СтрокаСправочника.Ключ);
		НайденныеСтроки = ТаблицаОбработки.НайтиСтроки(ПараметрыПоиска);
		
		Для Каждого СтрокаДанных Из НайденныеСтроки Цикл
			СтрокаДанных[Поле] = СтрокаСправочника.Ссылка;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Функция ИмпортироватьИзМатрикс(КодМатрикс, ПарамерыПоискаВМатрикс, ПравилоИмпорта)
	
	Если НЕ ЗначениеЗаполнено(КодМатрикс) Тогда
		АнкетаФизическогоЛица = Документы.АнкетаФизическогоЛица.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(АнкетаФизическогоЛица, ПарамерыПоискаВМатрикс);
		КодМатрикс = РаботаСВнешнимиСистемами.ПолучитьКодМатрихФизическогоЛица(АнкетаФизическогоЛица);
		
		ШаблонОписания = "'%1' (%2, %3) создан в %4";
	Иначе
		ШаблонОписания = "'%1' (%2, %3) импортирован из %4";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодМатрикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОбработкаИмпортНСИ = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
	ОбработкаИмпортНСИ.ГруппаПравил   = "Матрих";
	ОбработкаИмпортНСИ.ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов[ПравилоИмпорта.ГруппаОбъектов];
	ОбработкаИмпортНСИ.Подразделение  = Справочники.Подразделения.ГруппаКомпаний;
	ОбработкаИмпортНСИ.Язык           = Справочники.Языки.Русский;
	
	ОбработкаИмпортНСИ.НеСообщатьОСозданииНовыхОбъектов = Истина;
	ОбработкаИмпортНСИ.НеСообщатьОбИзмененииОбъектов    = Истина;
	
	СтрокаИмпортируемыеОбъекты = ОбработкаИмпортНСИ.ИмпортируемыеОбъекты.Добавить();
	СтрокаИмпортируемыеОбъекты.КодВоВнешнейСистеме = Формат(КодМатрикс, "ЧГ=0") ;
	
	Если ОбработкаИмпортНСИ.ИмпортироватьДанные() = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		ИмпортированныйОбъект = ОбработкаИмпортНСИ.ИмпортируемыеОбъекты[0].Объект;
	КонецЕсли;	
	
	СтрокаИнформацииОбОбновлении = ЭтотОбъект.ИнформацияОбОбновлении.Добавить();
	СтрокаИнформацииОбОбновлении.ВнешняяСистема	 		= Справочники.ВнешниеСистемы.Матрих;
	СтрокаИнформацииОбОбновлении.Объект			 		= ИмпортированныйОбъект;
	СтрокаИнформацииОбОбновлении.ГруппаОбъектов			= ОбработкаИмпортНСИ.ГруппаОбъектов;
	СтрокаИнформацииОбОбновлении.КодВоВнешнейСистеме	= КодМатрикс;
	СтрокаИнформацииОбОбновлении.Создан					= Истина;
	СтрокаИнформацииОбОбновлении.ОписаниеИзменений		= СтрШаблон(ШаблонОписания, ИмпортированныйОбъект, ОбработкаИмпортНСИ.ГруппаОбъектов, КодМатрикс, Справочники.ВнешниеСистемы.Матрих);
	
	Возврат ИмпортированныйОбъект;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаФайловИзПочты

Процедура ЗагрузитьФайлыИзПочтыВExternals(Отказ = Ложь) Экспорт
	
	ГуидыОрганизаций = ПолучитьГуидыОрганизаций();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПослеДатыОтправления"	, ЭтотОбъект.ПериодЗагрузкиПисем.ДатаНачала);
	ПараметрыОтбора.Вставить("ДоДатыОтправления"	, ЭтотОбъект.ПериодЗагрузкиПисем.ДатаОкончания);
	
	Письма = РаботаСЭлектроннойПочтой.ЗагрузитьСообщения(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты,, ПараметрыОтбора);

	ТаблицаФайлов = РаботаСВнешнимиСистемами.ПодготовитьТаблицуСохраненияФайловВExternals();
	
	Для Каждого Письмо Из Письма Цикл
		Если СтрЧислоВхождений(Письмо.Тема, ЭтотОбъект.ТемаПисьма) > 0 Тогда
			Для Каждого Вложение Из Письмо.Вложения Цикл
				Если СтрЗаканчиваетсяНа(ВРЕГ(Вложение.Ключ), ".ZIP") Тогда
					
					ИмяФайлаXML = "";
					ДвоичныеДанныеФайла = ИзвлечьИзАрхива(Вложение.Значение, ИмяФайлаXML, "Cert98Mau");
					
					ОбъектXDTO = ПолучитьОбъектXDTO(Новый Структура("ДвоичныеДанные, АдресФайла", ДвоичныеДанныеФайла, ИмяФайлаXML), Отказ);
					
					Если ОбъектXDTO = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаГуидыОрганизаций = ГуидыОрганизаций.Найти(ОбъектXDTO.Firm_GUID, "GUID");
					Если СтрокаГуидыОрганизаций = Неопределено Тогда //не идентифицировали организацию
						Продолжить;
						
					ИначеЕсли СтрокаГуидыОрганизаций.Организация <> ЭтотОбъект.Организация Тогда
						Продолжить;
						
					КонецЕсли;	
					
					Если СтрЧислоВхождений(Письмо.Отправитель, ЭтотОбъект.ОтправительВыгрузки) = 0 Тогда
						ЗарегистрироватьОшибку(
							СтрШаблон("Отправитель данных из ЗУП '%1' не соответсвует заданному в настройках регламентного задания '%2'. Письмо: %3 от %4", 
								Письмо.Отправитель, 
								ЭтотОбъект.ОтправительВыгрузки,
								Письмо.Тема,
								Письмо.ДатаОтправления));
						Продолжить;
					КонецЕсли;
					
					Если Строка(ОбъектXDTO.version) <> ЭтотОбъект.ВерсияВыгрузки Тогда
						ЗарегистрироватьОшибку(
							СтрШаблон("Версия файла с данными из ЗУП '%1' не соответсвует ожидаемой '%2'. Письмо: %3 от %4", 
								Строка(ОбъектXDTO.version), 
								ЭтотОбъект.ВерсияВыгрузки,
								Письмо.Тема,
								Письмо.ДатаОтправления));
						Продолжить;
					КонецЕсли;
					
					Если Строка(ОбъектXDTO.work) <> "1" Тогда
						ЗарегистрироватьОшибку(
							СтрШаблон("Данные ЗУП выгружены не из рабочей базы. Письмо: %1 от %2", 
								Письмо.Тема,
								Письмо.ДатаОтправления));
						Продолжить;
					КонецЕсли;
					
					ДанныеФайла = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаXML);
					ДанныеФайла.Вставить("ДвоичныеДанные", ДвоичныеДанныеФайла);
					
					ДанныеАрхива = РаботаСФайламиКлиентСервер.ПоместитьДвоичныеДанныеВАрхив(ДанныеФайла);

					ФайлЗУП = ТаблицаФайлов.Добавить();
					ФайлЗУП.ИмяФайла				 = ДанныеАрхива.Имя;
					ФайлЗУП.ДвоичныеДанные			 = ДанныеАрхива.ДвоичныеДанные;
					ФайлЗУП.ДатаПубликации		 	 = ОбъектXDTO.Generated;
					ФайлЗУП.ИдентификаторОрганизации = СтрокаГуидыОрганизаций.ВнутреннийУИД;
					ФайлЗУП.Источник				 = 31;
					ФайлЗУП.ХешСумма				 = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДанныеФайла.ДвоичныеДанные, ХешФункция.SHA256);
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаФайлов.Количество() = 0 Тогда
		ЗарегистрироватьОшибку(
			СтрШаблон("По организации %1 не получены на почту данные ЗУП за %2", 
				ЭтотОбъект.Организация, 
				Формат(ЭтотОбъект.ПериодЗагрузкиПисем.ДатаНачала, "ДФ=dd.MM.yyyy")));
		Отказ = Истина;
	КонецЕсли;
	
	РаботаСВнешнимиСистемами.СохранитьМассивФайловВExternals(ТаблицаФайлов);
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Функция ИзвлечьИзАрхива(ДвоичныеДанные, ИмяФайлаXML = "", Пароль = "")
	
	КаталогАрхива = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
	
	Архив = Новый ЧтениеZipФайла(ДвоичныеДанные.ОткрытьПотокДляЧтения());
	ЭлементАрхива = Архив.Элементы[0];
	ИмяФайлаXML = ЭлементАрхива.Имя;
	Архив.Извлечь(ЭлементАрхива, КаталогАрхива + "\",, Пароль);
	Архив.Закрыть();
	
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(КаталогАрхива + "\" + ЭлементАрхива.Имя);
	
	УдалитьФайлы(КаталогАрхива + "\" + ИмяФайлаXML);
	
	Возврат ДвоичныеДанныеФайла;
	
КонецФункции

#КонецОбласти

#Область ДополнительныеПроцедуры

Функция ПолучитьОбъектXDTO(РеквизитыФайла, Отказ)
	
#Область Схема

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	ЭтотОбъект.ПолучитьМакет("Схема").Записать(ИмяВременногоФайла);
	
	МассивСхемXSD = Новый Массив;
	МассивСхемXSD.Добавить(ИмяВременногоФайла);
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(МассивСхемXSD);
	
#КонецОбласти	

	ПутьКФайлу	= ПолучитьИмяВременногоФайла("xml");
	
	Файл = Новый ТекстовыйДокумент;
	
	Если РеквизитыФайла.Свойство("ДвоичныеДанные") Тогда
		Файл.Прочитать(РеквизитыФайла.ДвоичныеДанные.ОткрытьПотокДляЧтения());
		
	ИначеЕсли РеквизитыФайла.Свойство("ФайлВExternals") Тогда
		Файл.Прочитать(ИзвлечьИзАрхива(РеквизитыФайла.ФайлВExternals.File_Data).ОткрытьПотокДляЧтения());
		
	Иначе
		Файл.Прочитать(ПолучитьИзВременногоХранилища(РеквизитыФайла.АдресФайлаВХ).ОткрытьПотокДляЧтения());
		
	КонецЕсли;
	
	Файл.ЗаменитьСтроку(1, СтрЗаменить(Файл.ПолучитьСтроку(1), "<PersonsZUP", "<PersonsZUP xmlns=""1C_ZUP"""));
	Файл.Записать(ПутьКФайлу);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
	
	ТипXDTO = НоваяФабрикаXDTO.Тип("1C_ZUP", "PersonsZUP");  

	Попытка
		ОбъектXDTO = НоваяФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
	Исключение
		ЗарегистрироватьОшибку("Файл [" + РеквизитыФайла.АдресФайла + "] не соответствует схеме XSD. Система сообщает: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ПолучитьВременнуюТаблицуИзЗапроса(Запрос, ИмяТаблицы, Сортировка = "")
	
	Таблица = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы).ПолучитьДанные().Выгрузить();
	
	ПравилоИмпорта = ПолучитьТаблицуИзМакета("ПравилаИмпорта").Найти(ИмяТаблицы, "ИмяТаблицы");
	Если ПравилоИмпорта <> Неопределено Тогда
		Таблица.Колонки.Вставить(0, "УстранитьРасхождения", Новый ОписаниеТипов("Булево"));
		
		Если НЕ ЭтотОбъект.ИнтерактивныйЗапуск И НЕ ПравилоИмпорта.РучнаяЗагрузка Тогда
			Если Таблица.Колонки.Найти("СтатусЗагрузки") <> Неопределено Тогда
				Для Каждого СтрокаТаблицы Из Таблица Цикл
					Если СтрокаТаблицы.СтатусЗагрузки > 0 Тогда
						СтрокаТаблицы.УстранитьРасхождения = Истина;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сортировка) Тогда
		Таблица.Сортировать(Сортировка);
	КонецЕсли;
		
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТаблицуИзМакета(ИмяМакета, Отказ = Ложь, ПараметрыПоиска = Неопределено)
	
	Таблица = Новый ТаблицаЗначений;
	Макет	= ПолучитьМакет(ИмяМакета);
	
	КолонкиМакета = Новый Соответствие;
	Для НомерКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ПараметрыКолонки = СтрРазделить(СокрЛП(Макет.Область(1, НомерКолонки, 1, НомерКолонки).Текст), "()", Ложь);
		
		КолонкиМакета.Вставить(ПараметрыКолонки[0], НомерКолонки);
		Если ПараметрыКолонки.Количество() = 1 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов("Строка"));
		ИначеЕсли ПараметрыКолонки.Количество() = 2 Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1]));
		ИначеЕсли ПараметрыКолонки.Количество() = 3 И ПараметрыКолонки[1] = "Строка" Тогда
			Таблица.Колонки.Добавить(ПараметрыКолонки[0], Новый ОписаниеТипов(ПараметрыКолонки[1], Новый КвалификаторыСтроки(ПараметрыКолонки[2])));	
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
		
		НоваяСтрока = Таблица.Добавить();
		Для Каждого КолонкаМакета Из КолонкиМакета Цикл
			Значение = СокрЛП(Макет.Область(НомерСтроки, КолонкаМакета.Значение, НомерСтроки, КолонкаМакета.Значение).Текст);
			
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ])) Тогда
				НоваяСтрока[КолонкаМакета.Ключ]	= ОбщегоНазначения.МенеджерОбъектаПоСсылке(НоваяСтрока[КолонкаМакета.Ключ]).ПолучитьСсылку(Новый УникальныйИдентификатор(Значение));
			Иначе
				НоваяСтрока[КолонкаМакета.Ключ]	= Значение;
			КонецЕсли;
				
			Если ТипЗнч(НоваяСтрока[КолонкаМакета.Ключ]) = Тип("Строка") И НоваяСтрока[КолонкаМакета.Ключ] <> Значение Тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Неверно указана ширина колонки %1 в макете %2, не поместилось значение %3, обратитесь к программисту.", КолонкаМакета.Ключ, ИмяМакета, Значение),,,, Отказ);
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	Если ИмяМакета = "ПравилаИмпорта" Тогда
		Таблица.Колонки.Добавить("ИмяТаблицы");
		Для Каждого ПравилоИмпорта Из Таблица Цикл
			ПравилоИмпорта.ИмяТаблицы = ПравилоИмпорта.ВидМД + "_" + ПравилоИмпорта.ИмяМД;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПоиска) = Тип("Структура") Тогда
		Возврат Таблица.Скопировать(ПараметрыПоиска);
	Иначе
		Возврат Таблица;
	КонецЕсли;
	
КонецФункции

Функция ЗарегистрироватьСессиюСбораСтатистики(Механизм)
	
	СвойстваОбъекта = "Организация";
	
	ПараметрыВыполнения = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, СвойстваОбъекта);
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполнения.Хранилище, ПараметрыВыполнения.Описание);
	
	Возврат Сессия;
	
КонецФункции

