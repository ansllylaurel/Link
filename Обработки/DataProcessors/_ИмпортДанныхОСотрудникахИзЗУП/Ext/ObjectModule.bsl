
#Область Интерфейс_внешней_обработки

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Импорт данных о сотрудниках",
		"0.37",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортДанныхОСотрудникахИзЗУП", "Импорт данных о сотрудниках из ЗУП", , Ложь, "ВызовСерверногоМетода");

	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках()
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") 
	 ИЛИ ЭтотОбъект.ДополнительныеСвойства.Ошибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();	
	
КонецПроцедуры // ОповеститьОбОшибках

Процедура ДополнитьИнформациюОбОбновлении(СтрокаДанных, ОписаниеИзменений)
	
	СтрокаИнформацииОбОбновлении = ЭтотОбъект.ИнформацияОбОбновлении.Найти(СтрокаДанных.Ссылка, "Объект");
	
	Если СтрокаИнформацииОбОбновлении = Неопределено Тогда
		СтрокаИнформацииОбОбновлении = ЭтотОбъект.ИнформацияОбОбновлении.Добавить();
		СтрокаИнформацииОбОбновлении.ВнешняяСистема	 		= ЭтотОбъект.ВнешняяСистема;
		СтрокаИнформацииОбОбновлении.Объект			 		= СтрокаДанных.Ссылка;
		СтрокаИнформацииОбОбновлении.ГруппаОбъектов			= СтрокаДанных.ГруппаОбъектов;
		СтрокаИнформацииОбОбновлении.КодВоВнешнейСистеме	= СтрокаДанных.КодВоВнешнейСистеме;
		СтрокаИнформацииОбОбновлении.Создан					= (СтрокаДанных.СтатусЗагрузки = 1);
		СтрокаИнформацииОбОбновлении.Обновлен				= (СтрокаДанных.СтатусЗагрузки <> 1 И СтрокаДанных.СтатусЗагрузки < 4);
		
		Если СтрокаДанных.СтатусЗагрузки = 2 Тогда
			ПравилоИмпорта = ПолучитьТаблицуИзМакета("ПравилаИмпорта").Найти(СтрокаДанных.ИмяТаблицы, "ИмяТаблицы");
			
			Если ПравилоИмпорта.ИмпортируетсяИзМХ Тогда 
				СтрокаИнформацииОбОбновлении.ОписаниеИзменений = СтрШаблон("Очищен код внешней системы, т.к. отсутсвует в %4", ЭтотОбъект.ВнешняяСистема);
			Иначе	
				СтрокаИнформацииОбОбновлении.ОписаниеИзменений = СтрШаблон("Помечен на удаление, т.к. отсутсвует в %1", ЭтотОбъект.ВнешняяСистема);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ОписаниеИзменений) Тогда
		СтрокаИнформацииОбОбновлении.Обновлен = Истина;
		Если ЗначениеЗаполнено(СтрокаИнформацииОбОбновлении.ОписаниеИзменений) Тогда
			СтрокаИнформацииОбОбновлении.ОписаниеИзменений = СтрокаИнформацииОбОбновлении.ОписаниеИзменений + Символы.ПС + ОписаниеИзменений;
		Иначе
			СтрокаИнформацииОбОбновлении.ОписаниеИзменений = ОписаниеИзменений;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьИнформациюОбОбновлении(СтрокаДанных)
	
	МассивСтрокДляУдаления = ЭтотОбъект.ИнформацияОбОбновлении.НайтиСтроки(Новый Структура("Объект", СтрокаДанных.Ссылка));
	
	Для Каждого СтрокаИнформацииОбОбновлении Из МассивСтрокДляУдаления Цикл
		ЭтотОбъект.ИнформацияОбОбновлении.Удалить(СтрокаИнформацииОбОбновлении);
	КонецЦикла;
	
КонецПроцедуры

Функция ДополнитьИнформациюОРасхожденииРеквизитов(СтрокаДанных, РасхожденияРеквизитов = Неопределено)
	
	Если РасхожденияРеквизитов = Неопределено Тогда
		РасхожденияРеквизитов = Новый Массив;
	КонецЕсли;
	
	Если СтрокаДанных.СтатусЗагрузки = 3 Тогда
		Для Каждого Колонка Из СтрокаДанных.Владелец().Колонки Цикл
			Если СтрЗаканчиваетсяНа(Колонка.Имя, "_СтароеЗначение") Тогда
				ИмяРеквизита = СтрЗаменить(Колонка.Имя, "_СтароеЗначение", "");
				Если СтрокаДанных[ИмяРеквизита + "_Изменен"] Тогда
					Если СтрокаДанных.Владелец().Колонки.Найти("Период") = Неопределено Тогда
						РасхожденияРеквизитов.Добавить(СтрШаблон("%1: [%2] -> [%3]", ИмяРеквизита, СтрокаДанных[Колонка.Имя], СтрокаДанных[ИмяРеквизита]));
					Иначе
						РасхожденияРеквизитов.Добавить(СтрШаблон("%1: [%2] -> [%3] %4", ИмяРеквизита, СтрокаДанных[Колонка.Имя], СтрокаДанных[ИмяРеквизита], СтрокаДанных.Период));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	Возврат РасхожденияРеквизитов;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыКоманды);
	ЭтотОбъект.ДатаЗапретаРедактирования = ТекущаяДата() - 86400 * 31;
	
	// Организуем сбор статистики
	Механизм	= ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия		= ЗарегистрироватьСессиюСбораСтатистики(Механизм);
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "ИмпортДанныхОСотрудникахИзЗУП") Тогда
		Если Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата()) Тогда
			ЭтотОбъект.ПериодЗагрузкиПисем.Вариант = ВариантСтандартногоПериода.Сегодня;
			ЭтотОбъект.ТемаПисьма = "Выгрузка из ЗУП";
			ЗагрузитьДанныеОСотрудниках();
		КонецЕсли;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	

КонецПроцедуры

#КонецОбласти

#Область АвтоЗагрузкаДанных

Процедура ЗагрузитьДанныеОСотрудниках() Экспорт
	
	Отказ = Ложь;
	
	ЗагрузитьФайлыИзПочтыВExternals(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПоследнийФайлЗУП = ПолучитьПоследнийФайлЗУП();
	Если ПоследнийФайлЗУП = Неопределено Тогда
		ЗарегистрироватьОшибку("В базе Externals нет файлов из ЗУП");
		Возврат;
	КонецЕсли;	
	
	РеквизитыФайла = Новый Структура();
	РеквизитыФайла.Вставить("АдресФайла"	, Строка(ПоследнийФайлЗУП));
	РеквизитыФайла.Вставить("ФайлВExternals", ПоследнийФайлЗУП);
	
	ДанныеФайла = ПрочитатьДанныеФайла(РеквизитыФайла);
	Если ДанныеФайла <> Неопределено Тогда
		ЗаписатьДанные(ДанныеФайла);
		
		Если Не ПустаяСтрока(ЭтотОбъект.ПолучателиОтчета) Тогда
			ОтчетHTML = СформироватьОтчетОбОбновлении(ДанныеФайла);
			
			ТемаПисьма = "Обновление нормативно-справочной информации из " + ЭтотОбъект.ВнешняяСистема;
			
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", ЭтотОбъект.ПолучателиОтчета, ТемаПисьма, ОтчетHTML, ТипТекстаПочтовогоСообщения.HTML);
			
			РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма,, Истина);
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПоследнийФайлЗУП()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	dbo_Files.Ссылка КАК Ссылка
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
		|ГДЕ
		|	dbo_Files.Source_Id = &Source_Id
		|	И dbo_Files.Organization = &Organization
		|
		|УПОРЯДОЧИТЬ ПО
		|	dbo_Files.Publication_Date УБЫВ";
	
	Запрос.УстановитьПараметр("Organization",	Строка(ЭтотОбъект.Организация.УникальныйИдентификатор()));
	Запрос.УстановитьПараметр("Source_Id",		ВнешниеИсточникиДанных.Externals.Таблицы.Data_Sources.НайтиПоПолю("Id", 31));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

Функция СформироватьОтчетОбОбновлении(ДанныеФайла)

	Результат = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Отчет");
	
	ОбластьЗаголовок					= Макет.ПолучитьОбласть("Заголовок|ШиринаЗаголовка");
	ОбластьРазделитель					= Макет.ПолучитьОбласть("Разделитель|ШиринаЗаголовка");
	ОбластьЗаголовокРанееОбновленные	= Макет.ПолучитьОбласть("ЗаголовокРанееОбновленные");
	ОбластьСтрокаРанееОбновленные		= Макет.ПолучитьОбласть("СтрокаРанееОбновленные");
	ОбластьПодвалРанееОбновленные		= Макет.ПолучитьОбласть("ПодвалРанееОбновленные");

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") И ЭтотОбъект.ДополнительныеСвойства.Ошибки.Количество() > 0 Тогда
		РезультатОбновления = "Выполнено с ошибками";
	Иначе
		РезультатОбновления = "Успешно";
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.Обработано			= ЭтотОбъект.ИнформацияОбОбновлении.Количество();
	ОбластьЗаголовок.Параметры.Обновлено			= ЭтотОбъект.ИнформацияОбОбновлении.НайтиСтроки(Новый Структура("Обновлен", Истина)).Количество();
	ОбластьЗаголовок.Параметры.ДатаОбновления		= ТекущаяДатаСеанса();
	ОбластьЗаголовок.Параметры.РезультатОбновления	= РезультатОбновления;
	ОбластьЗаголовок.Параметры.ВнешняяСистема		= ЭтотОбъект.ВнешняяСистема;
	
	Результат.Вывести(ОбластьЗаголовок);
	
	ИменаЗагружаемыхГруппОбъектов = Новый Массив;
	
	Для Каждого Правило Из ПолучитьТаблицуИзМакета("ПравилаИмпорта",, Новый Структура("ВидМД", "Справочник")) Цикл
		Если Правило.Импортируется ИЛИ Правило.ИмпортируетсяИзМХ Тогда
			
			Для Каждого СтрокаСправочника Из ДанныеФайла.ИсходныеТаблицы.Получить("Справочник_" + Правило.ИмяМД) Цикл
				
				ВывестиДанные = Ложь;
				МассивОбластейДляВывода = Новый Массив;
				
				ОбластьОбъект = Макет.ПолучитьОбласть("Объект");
				
				Если Правило.ИмяМД = "Сотрудники" Тогда
					ОбластьОбъект.Параметры.Ссылка = СтрШаблон("%1 (%2: %3)", СтрокаСправочника.Ссылка, ТипЗнч(СтрокаСправочника.Ссылка), СтрокаСправочника.ВидЗанятости);
				Иначе
					ОбластьОбъект.Параметры.Ссылка = СтрШаблон("%1 (%2)", СтрокаСправочника.Ссылка, ТипЗнч(СтрокаСправочника.Ссылка));
				КонецЕсли;
				
				МассивОбластейДляВывода.Добавить(ОбластьОбъект);
				
				ВывестиРеквизиты(МассивОбластейДляВывода, СтрокаСправочника.Ключ, Правило.ИмяМД, ДанныеФайла, ВывестиДанные);
				
				Если Правило.ИмяМД = "ЮрФизЛица" Тогда
					ВывестиДанныеРегистра(МассивОбластейДляВывода, СтрокаСправочника.Ключ, "РеквизитыСотрудниковОрганизации", ДанныеФайла, ВывестиДанные, "Период,Фамилия,Имя,Отчество,Пол,ДатаРождения,ИНН,ВидУдостоверенияЛичности,СерияУдостоверенияЛичности,НомерУдостоверенияЛичности,ДатаВыдачиУдостоверенияЛичности,ОрганВыдавшийУдостоверениеЛичности,КодОрганаВыдавшегоУдостоверениеЛичности,РезидентРФ,Гражданство,СНИЛС,МестоРождения");
				КонецЕсли;
				
				Если Правило.ИмяМД = "Сотрудники" Тогда
					ВывестиДанныеРегистра(МассивОбластейДляВывода, СтрокаСправочника.Ключ, "СотрудникиОрганизации", ДанныеФайла, ВывестиДанные, "Период,Подразделение,Должность,ВидСобытия");
					ВывестиДанныеРегистра(МассивОбластейДляВывода, СтрокаСправочника.Ключ, "СостояниеСотрудниковОрганизаций", ДанныеФайла, ВывестиДанные, "Период,Состояние");
				КонецЕсли;
				
				Если ВывестиДанные Тогда
					ВывестиОбласти(Результат, МассивОбластейДляВывода);
				КонецЕсли;
				
			КонецЦикла;
			
			ИменаЗагружаемыхГруппОбъектов.Добавить(Правило.ИмяМД);
			
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыОбновления = Новый Структура;
	ПараметрыОбновления.Вставить("ВнешняяСистема", ЭтотОбъект.ВнешняяСистема);
	ПараметрыОбновления.Вставить("ИменаЗагружаемыхГруппОбъектов", ИменаЗагружаемыхГруппОбъектов);
	ПараметрыОбновления.Вставить("ИсключатьОбновленныеРанееПомеченныеНаУдаление", Истина);
	
	РанееОбновленные	= Обработки.ИмпортНормативноСправочнойИнформации.ВыбратьОбъектыОбновленныеРанееТекущейДаты(ПараметрыОбновления);

	Если РанееОбновленные.Количество() > 0 Тогда
		
		ОбластьЗаголовокРанееОбновленные.Параметры.Дата = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
		
		Результат.Вывести(ОбластьЗаголовокРанееОбновленные);
		
		Пока РанееОбновленные.Следующий() Цикл
			ОбластьСтрокаРанееОбновленные.Параметры.Заполнить(РанееОбновленные);
			Результат.Вывести(ОбластьСтрокаРанееОбновленные);
		КонецЦикла;
		
		Результат.Вывести(ОбластьПодвалРанееОбновленные);
		
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") И ЭтотОбъект.ДополнительныеСвойства.Ошибки.Количество() > 0 Тогда
		Результат.Вывести(Макет.ПолучитьОбласть("ЗаголовокОшибки|ШиринаЗаголовка"));
		
		РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(ЭтотОбъект.ДополнительныеСвойства.Ошибки);
		
		Для Каждого Ошибка Из ЭтотОбъект.ДополнительныеСвойства.Ошибки Цикл
			ОбластьСтрокаОшибки = Макет.ПолучитьОбласть("СтрокаОшибки|ШиринаЗаголовка");
			ОбластьСтрокаОшибки.Параметры.СообщениеОбОшибке = Ошибка;
			Результат.Вывести(ОбластьСтрокаОшибки);
		КонецЦикла;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("html");
	
	Результат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяВременногоФайла);
	
	Текст = ТелоПисьма.ПолучитьТекст();
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Текст;
	
КонецФункции

Процедура ВывестиРеквизиты(МассивОбластей, Ключ, ИмяСправочника, ДанныеФайла, ВывестиДанные)
	
	МассивОбластейДляВывода = Новый Массив;
	Макет = ПолучитьМакет("Отчет");
	ТаблицаРеквизитов = ДанныеФайла.ИсходныеТаблицы.Получить("Расхождения_" + ИмяСправочника).НайтиСтроки(Новый Структура("Ключ", Ключ));
	
	Для Каждого Реквизит Из ТаблицаРеквизитов Цикл
		Если Реквизит.СтатусЗагрузки = 1 ИЛИ Реквизит.СтатусЗагрузки = 2 ИЛИ Реквизит.СтатусЗагрузки = 3 Тогда
			ОбластьСтрокаРеквизиты	= Макет.ПолучитьОбласть("СтрокаРеквизиты|ШиринаЗаголовка");
			ОбластьСтрокаРеквизиты.Параметры.Заполнить(Реквизит);
			МассивОбластейДляВывода.Добавить(ОбластьСтрокаРеквизиты);
			ВывестиДанные = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивОбластейДляВывода.Количество() Тогда
		МассивОбластей.Добавить(Макет.ПолучитьОбласть("ШапкаРеквизиты|ШиринаЗаголовка"));
		
		Для Каждого Область Из МассивОбластейДляВывода Цикл
			МассивОбластей.Добавить(Область);
		КонецЦикла;
		
		МассивОбластей.Добавить(Макет.ПолучитьОбласть("Разделитель|ШиринаЗаголовка"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиДанныеРегистра(МассивОбластей, Ключ, ИмяРегистра, ДанныеФайла, ВывестиДанные, РеквизитыСтрокой)
	
	Макет = ПолучитьМакет("Отчет");
	
	ОбластьИмяРегистра		= Макет.ПолучитьОбласть("ИмяРегистра|ШиринаЗаголовка");
	ОбластьРазделитель		= Макет.ПолучитьОбласть("ШапкаРегистр|ГоризонтальныйРазделитель");
	
	МетаД = Метаданные.РегистрыСведений[ИмяРегистра];
	
	ТаблицаРегистра = ДанныеФайла.ИсходныеТаблицы.Получить("РегистрСведений_" + ИмяРегистра).НайтиСтроки(Новый Структура("КлючРодитель", Ключ));
	
	МассивОбластейДляВывода = Новый Массив;
	
	Для Каждого СтрокаРегистра Из ТаблицаРегистра Цикл
		МассивГоризонтальныхОбластей = Новый Массив;
		МассивГоризонтальныхОбластей.Добавить(ОбластьРазделитель);
		
		ОбластьСтрокаРегистр	= Макет.ПолучитьОбласть("СтрокаРегистр|Реквизит");
		
		Если СтрокаРегистра.СтатусЗагрузки = 1 Тогда
		    ОбластьСтрокаРегистр.Параметры.Значение = "Добавлена запись";
		ИначеЕсли СтрокаРегистра.СтатусЗагрузки = 2 Тогда
			ОбластьСтрокаРегистр.Параметры.Значение = "Удалена запись";
		ИначеЕсли СтрокаРегистра.СтатусЗагрузки = 3 Тогда
			ОбластьСтрокаРегистр.Параметры.Значение = "Обновление";
		Иначе
			Продолжить;
		КонецЕсли;		
		
		ВывестиДанные = Истина;
		
		МассивГоризонтальныхОбластей.Добавить(ОбластьСтрокаРегистр);
		
		Для Каждого Реквизит Из СтрРазделить(РеквизитыСтрокой, ",") Цикл
			ОбластьСтрокаРегистр = Макет.ПолучитьОбласть("СтрокаРегистр|Реквизит");		
			ОбластьСтрокаРегистр.Параметры.Значение = СтрокаРегистра[Реквизит];
			МассивГоризонтальныхОбластей.Добавить(ОбластьСтрокаРегистр);
	
			Если СтрокаРегистра.СтатусЗагрузки = 3
			   И СтрокаРегистра.Владелец().Колонки.Найти(Реквизит + "_Изменен") <> Неопределено
			   И СтрокаРегистра[Реквизит + "_Изменен"] = Истина Тогда
			   ОбластьСтрокаРегистр.ТекущаяОбласть.Шрифт = Новый Шрифт(ОбластьСтрокаРегистр.ТекущаяОбласть.Шрифт,,, Истина);
			КонецЕсли;
		КонецЦикла;
		
		МассивОбластейДляВывода.Добавить(МассивГоризонтальныхОбластей);
		
		Если СтрокаРегистра.СтатусЗагрузки = 3 Тогда
			МассивГоризонтальныхОбластей = Новый Массив;
			МассивГоризонтальныхОбластей.Добавить(ОбластьРазделитель);		
			
			ОбластьСтрокаРегистр = Макет.ПолучитьОбласть("СтрокаРегистр|Реквизит");
			ОбластьСтрокаРегистр.Параметры.Значение = "		Старое значение:";
			
			МассивГоризонтальныхОбластей.Добавить(ОбластьСтрокаРегистр);
			
			Для Каждого Реквизит Из СтрРазделить(РеквизитыСтрокой, ",") Цикл
				ОбластьСтрокаРегистр = Макет.ПолучитьОбласть("СтрокаРегистр|Реквизит");
				
				Если СтрокаРегистра.Владелец().Колонки.Найти(Реквизит + "_Изменен") <> Неопределено
				   И СтрокаРегистра[Реквизит + "_Изменен"] = Истина Тогда
					ОбластьСтрокаРегистр.Параметры.Значение = СтрокаРегистра[Реквизит + "_СтароеЗначение"];
					ОбластьСтрокаРегистр.ТекущаяОбласть.Шрифт = Новый Шрифт(ОбластьСтрокаРегистр.ТекущаяОбласть.Шрифт,,, Истина);
				КонецЕсли;
				
				МассивГоризонтальныхОбластей.Добавить(ОбластьСтрокаРегистр);
				
			КонецЦикла;
			
			МассивОбластейДляВывода.Добавить(МассивГоризонтальныхОбластей);
		КонецЕсли;		
		
	КонецЦикла;
	
	Если МассивОбластейДляВывода.Количество() Тогда
		
		ОбластьИмяРегистра.Параметры.ИмяРегистра = МетаД.Синоним;
		МассивОбластей.Добавить(ОбластьИмяРегистра);

		МассивГоризонтальныхОбластей = Новый Массив;
		МассивГоризонтальныхОбластей.Добавить(ОбластьРазделитель);
		
		ОбластьШапкаРегистр		= Макет.ПолучитьОбласть("ШапкаРегистр|Реквизит");
		ОбластьШапкаРегистр.Параметры.ИмяРеквизита = "Статус";
		МассивГоризонтальныхОбластей.Добавить(ОбластьШапкаРегистр);
		
		Для Каждого Реквизит Из СтрРазделить(РеквизитыСтрокой, ",") Цикл
			ОбластьШапкаРегистр		= Макет.ПолучитьОбласть("ШапкаРегистр|Реквизит");
			
			Если МетаД.Измерения.Найти(Реквизит) <> Неопределено Тогда
				ОбластьШапкаРегистр.Параметры.ИмяРеквизита = МетаД.Измерения[Реквизит].Синоним;
			ИначеЕсли МетаД.Ресурсы.Найти(Реквизит) <> Неопределено Тогда
				ОбластьШапкаРегистр.Параметры.ИмяРеквизита = МетаД.Ресурсы[Реквизит].Синоним;
			ИначеЕсли МетаД.Реквизиты.Найти(Реквизит) <> Неопределено Тогда
				ОбластьШапкаРегистр.Параметры.ИмяРеквизита = МетаД.Реквизиты[Реквизит].Синоним;
			Иначе
				ОбластьШапкаРегистр.Параметры.ИмяРеквизита = Реквизит
			КонецЕсли;

			МассивГоризонтальныхОбластей.Добавить(ОбластьШапкаРегистр);
		КонецЦикла;
		
		МассивОбластей.Добавить(МассивГоризонтальныхОбластей);
	
		Для Каждого Область Из МассивОбластейДляВывода Цикл
			МассивОбластей.Добавить(Область);
		КонецЦикла;
		
		МассивОбластей.Добавить(Макет.ПолучитьОбласть("Разделитель|ШиринаЗаголовка"));
		
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ВывестиОбласти(Результат, МассивОбластейДляВывода)
	
	Для Каждого ОбластьДляВывода Из МассивОбластейДляВывода Цикл
		Если ТипЗнч(ОбластьДляВывода) = Тип("Массив") Тогда
			Для Индекс = 0 По ОбластьДляВывода.ВГраница() Цикл
				Если Индекс = 0 Тогда
					Результат.Вывести(ОбластьДляВывода[Индекс]);
				Иначе
					Результат.Присоединить(ОбластьДляВывода[Индекс]);
				КонецЕсли;
			КонецЦикла;
		Иначе 
			Результат.Вывести(ОбластьДляВывода);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПодготовкаДанных

Функция ПрочитатьДанныеФайла(РеквизитыФайла) Экспорт
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	
	ОбъектXDTO = ПолучитьОбъектXDTO(РеквизитыФайла, Ложь);
	Если ОбъектXDTO = Неопределено Тогда
		ОповеститьОбОшибках();
		Возврат Неопределено;
	КонецЕсли;
	
	ГуидыОрганизаций	= ПолучитьГуидыОрганизаций();
	НайденнаяСтрока		= ГуидыОрганизаций.Найти(ОбъектXDTO.Firm_GUID, "GUID");
	
	Если НайденнаяСтрока = Неопределено Тогда
		ЗарегистрироватьОшибку("Не удалось определить внешнюю систему по Firm_GUID " + ОбъектXDTO.Firm_GUID);
		ОповеститьОбОшибках();
		Возврат Неопределено;
	
	ИначеЕсли НайденнаяСтрока.Организация <> ЭтотОбъект.Организация Тогда
		ЗарегистрироватьОшибку("Организация в выбранном файле не соответствует текущей");
		ОповеститьОбОшибках();
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЭтотОбъект.ВнешняяСистема	= НайденнаяСтрока.ВнешняяСистема;
	ЭтотОбъект.Firm_GUID		= ОбъектXDTO.Firm_GUID;
	ЭтотОбъект.ДатаСоздания		= ОбъектXDTO.Generated;
	
	ДанныеФайла = Новый Структура;
	
	Запрос = Новый Запрос;
	
	ЗаполнитьИсходныеТаблицы(Запрос, ДанныеФайла, ОбъектXDTO);
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") И ЭтотОбъект.ДополнительныеСвойства.Ошибки.Количество() Тогда
		ОповеститьОбОшибках();
		Возврат Неопределено;
	Иначе
		ОповеститьОбОшибках();
		
		Возврат ДанныеФайла;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьИсходныеТаблицы(Запрос, ДанныеФайла, ОбъектXDTO = Неопределено)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период",						ЭтотОбъект.ДатаСоздания);
	Запрос.УстановитьПараметр("ВнешняяСистема", 			ЭтотОбъект.ВнешняяСистема);
	Запрос.УстановитьПараметр("Организация",				ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Firm_GUID",					ЭтотОбъект.Firm_GUID);
	Запрос.УстановитьПараметр("ДатаЗапретаРедактирования", 	ЭтотОбъект.ДатаЗапретаРедактирования);
	Запрос.УстановитьПараметр("МассивАрхивныхЭлементов",	ПолучитьМассивАрхивныхЭлементов());
	
	Если ДанныеФайла.Свойство("ТаблицыФайла") Тогда
		ТаблицыФайла = ДанныеФайла.ТаблицыФайла;
		
	Иначе
		
		ТаблицыФайла = Новый Соответствие;
		
		ТаблицыФайла.Вставить("Firms",				ОбъектXDTOВТаблицу(ОбъектXDTO, "Firms.Firm"));
		ТаблицыФайла.Вставить("Departments",		ОбъектXDTOВТаблицу(ОбъектXDTO, "Departments.Department"));
		ТаблицыФайла.Вставить("Positions_types",	ОбъектXDTOВТаблицу(ОбъектXDTO, "Positions_types.Position_type"));
		ТаблицыФайла.Вставить("Employees_types",	ОбъектXDTOВТаблицу(ОбъектXDTO, "Employees_types.Employee_type"));
		ТаблицыФайла.Вставить("Conditions_types",	ОбъектXDTOВТаблицу(ОбъектXDTO, "Conditions_types.Condition_type"));
		ТаблицыФайла.Вставить("HREvent_types",		ОбъектXDTOВТаблицу(ОбъектXDTO, "HREvent_types.HREvent_type"));
		ТаблицыФайла.Вставить("Docs_types",			ОбъектXDTOВТаблицу(ОбъектXDTO, "Docs_types.Doc_type"));
		ТаблицыФайла.Вставить("Countries",			ОбъектXDTOВТаблицу(ОбъектXDTO, "Countries.Countri"));
		ТаблицыФайла.Вставить("Employees",			ОбъектXDTOВТаблицу(ОбъектXDTO, "Employees.Employee"));
		ТаблицыФайла.Вставить("Persons",			ОбъектXDTOВТаблицу(ОбъектXDTO, "Persons.Person"));
		ТаблицыФайла.Вставить("Persons_Name",		ОбъектXDTOВТаблицу(ОбъектXDTO, "Persons_Name.Person_Name"));
		ТаблицыФайла.Вставить("Docs",				ОбъектXDTOВТаблицу(ОбъектXDTO, "Docs.Doc"));
		ТаблицыФайла.Вставить("Conditions",			ОбъектXDTOВТаблицу(ОбъектXDTO, "Conditions.Condition"));
		ТаблицыФайла.Вставить("Positions",			ОбъектXDTOВТаблицу(ОбъектXDTO, "Positions.Position"));
		ТаблицыФайла.Вставить("Persons_Resident",	ОбъектXDTOВТаблицу(ОбъектXDTO, "Persons_Resident.Person_Resident"));
		ТаблицыФайла.Вставить("Persons_Country",	ОбъектXDTOВТаблицу(ОбъектXDTO, "Persons_Country.Person_Country"));
		ТаблицыФайла.Вставить("WorksExperience",	ОбъектXDTOВТаблицу(ОбъектXDTO, "WorksExperience.WorkExperience"));
		
		ТаблицыФайла.Вставить("ВидыЗанятостиСотрудников",		ПеречислениеВТаблицу("ВидыЗанятостиСотрудников"));
		ТаблицыФайла.Вставить("СостоянияСотрудникаОрганизации",	ПеречислениеВТаблицу("СостоянияСотрудникаОрганизации"));
		ТаблицыФайла.Вставить("ВидыКадровыхСобытий",			ПеречислениеВТаблицу("ВидыКадровыхСобытий"));
		
		ДанныеФайла.Вставить("ТаблицыФайла", ТаблицыФайла);
		
	КонецЕсли;
	
	Для Каждого ИсходнаяТаблица Из ТаблицыФайла Цикл
		
		ПоляИндексирования = Неопределено;
		Если ИсходнаяТаблица.Значение.Колонки.Найти("GUID") <> Неопределено 
