// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Сверка со списком террористов",
		"0.12",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоОтправкаОтчета", "Ежедн.отчет о найденных совпадениях", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для формирования отчета и отправки на почту по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	Перем АдресатыПриНайденныхСопадениях, АдресатыПриОшибках, ОтправлятьОшибкиПоискаКода, ОтправлятьНепроверенныеЛица, ОшибкиСверки;	
	
	Ошибки = Новый Массив();
	ПриВыполненииВозниклиОшибки = Ложь;
	
	// Обрабатываем только известные команды
	Если Лев(ИдентификаторКоманды, 18) <> "АвтоОтправкаОтчета" Тогда
		ПриВыполненииВозниклиОшибки = Истина;
		Ошибки.Добавить("Неизвестный идентификатор команды """ + ИдентификаторКоманды + """");
	КонецЕсли;
	
	// Заполним параметры команды
	Если Не ПриВыполненииВозниклиОшибки Тогда
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
		Если Не ПараметрыКоманды.Свойство("АдресатыПриНайденныхСопадениях", АдресатыПриНайденныхСопадениях) ИЛИ Не ЗначениеЗаполнено(АдресатыПриНайденныхСопадениях) Тогда
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Не указан или не заполнен параметр ""АдресатыПриНайденныхСопадениях""");
		КонецЕсли;
		Если Не ПараметрыКоманды.Свойство("АдресатыПриОшибках", АдресатыПриОшибках) ИЛИ Не ЗначениеЗаполнено(АдресатыПриОшибках) Тогда
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Не указан или не заполнен параметр ""АдресатыПриОшибках""");
		КонецЕсли;
		Если Не ПараметрыКоманды.Свойство("ОтправлятьОшибкиПоискаКода", ОтправлятьОшибкиПоискаКода) ИЛИ ТипЗнч(ОтправлятьОшибкиПоискаКода) <> Тип("Булево") Тогда
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Не указан или некорректно заполнен параметр ""ОтправлятьОшибкиПоискаКода""");
		КонецЕсли;
		Если Не ПараметрыКоманды.Свойство("ОтправлятьНепроверенныеЛица", ОтправлятьНепроверенныеЛица) ИЛИ ТипЗнч(ОтправлятьНепроверенныеЛица) <> Тип("Булево") Тогда
			ПриВыполненииВозниклиОшибки = Истина;
			Ошибки.Добавить("Не указан или некорректно заполнен параметр ""ОтправлятьНепроверенныеЛица""");
		КонецЕсли;
	КонецЕсли;
	
	// Организуем сбор статистики
	Механизм			= ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
	ПараметрыВыполнения	= ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды);
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполнения.Хранилище, ПараметрыВыполнения.Описание);
	
	// Выполняем сверку
	Если Не ПриВыполненииВозниклиОшибки Тогда
		ПроверенныеЛица = РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСпискомТеррористовВMatrix(, ОшибкиСверки);
		
		// Параметры макета
		Макет = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьМакет("МакетОтчета");
		
		ПараметрыОформления	= Новый Структура;
		ПараметрыОформления.Вставить("ЗаголовокОтчета",		Макет.ПолучитьОбласть("ЗаголовокОтчета"));
		ПараметрыОформления.Вставить("ЗаголовокТаблицы",	Макет.ПолучитьОбласть("ЗаголовокТаблицы"));
		ПараметрыОформления.Вставить("ПолеШапки",			Макет.ПолучитьОбласть("ПолеШапки"));
		ПараметрыОформления.Вставить("ПолеТаблицы",			Макет.ПолучитьОбласть("ПолеТаблицы"));
		ПараметрыОформления.Вставить("РазделительТаблиц",	Макет.ПолучитьОбласть("РазделительТаблиц"));
		
		ДатаОтчета = ТекущаяДата();
		
		// Отчет о найденных совпадениях
		Если ПроверенныеЛица <> Неопределено Тогда
			НайденныеСовпадения = ПроверенныеЛица.НайтиСтроки(Новый Структура("Пройдена", Ложь));
			Если НайденныеСовпадения.Количество() > 0 Тогда
				ОтчетОНайденныхСовпадениях = Новый ТабличныйДокумент;
				ПараметрыОформления.ЗаголовокОтчета.Параметры.Поле = "Сверка со списком террористов на " + Строка(ДатаОтчета);			
				ОтчетОНайденныхСовпадениях.Вывести(ПараметрыОформления.ЗаголовокОтчета);
				
				РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
					ОтчетОНайденныхСовпадениях,
					НайденныеСовпадения,
					Новый Структура("НомерСтроки, ЮрФизЛица, Комментарий", "№ п/п", "Юр. / физ. лицо", "Комментарий"),
					ПараметрыОформления,
					"Лица, имеющие совпадения со списком террористов"
				);
				
				// Автоширина колонок
				РаботаСОтчетами.ПодобратьШиринуКолонокТаблицыОтчета(ОтчетОНайденныхСовпадениях, 1, 2, ОтчетОНайденныхСовпадениях.ВысотаТаблицы, ОтчетОНайденныхСовпадениях.ШиринаТаблицы, 60);
				
				// Заполняем параметры печати
				РаботаСОтчетами.ЗаполнитьНастройкиПечати(ОтчетОНайденныхСовпадениях, "РезультатСверкиСоСпискомТеррористовВMatrix", Истина, ОриентацияСтраницы.Портрет);
			КонецЕсли;
		КонецЕсли;
		
		// Ошибки выполнения
		Если ПроверенныеЛица = Неопределено Тогда
			ОтчетОбОшибках = Новый ТабличныйДокумент;
			ПараметрыОформления.ЗаголовокОтчета.Параметры.Поле = "Сверка со списком террористов на " + Строка(ДатаОтчета);			
			ОтчетОбОшибках.Вывести(ПараметрыОформления.ЗаголовокОтчета);
			
			ПараметрыОформления.ОбластьЗаголовкаТаблицы.Параметры.Поле = "При выполнении сверки произошли ошибки";			
			ОтчетОбОшибках.Вывести(ПараметрыОформления.ОбластьЗаголовкаТаблицы);
			
			// Ошибки сверки
		ИначеЕсли ЗначениеЗаполнено(ОшибкиСверки) Тогда
			ОтчетОбОшибках = Новый ТабличныйДокумент;
			ПараметрыОформления.ЗаголовокОтчета.Параметры.Поле = "Сверка со списком террористов на " + Строка(ДатаОтчета);			
			ОтчетОбОшибках.Вывести(ПараметрыОформления.ЗаголовокОтчета);
			
			ОтчетОбОшибкахЗаполнен = Ложь;
			
			// Ошибки поиска кода во внешней системе
			Если ОтправлятьОшибкиПоискаКода Тогда
				ОшибкиПоискаКодаВоВнешнейСистеме = Неопределено;
				Если ОшибкиСверки.Свойство("ОшибкиПоискаКодаВоВнешнейСистеме", ОшибкиПоискаКодаВоВнешнейСистеме) Тогда	
					РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
						ОтчетОбОшибках,
						ОшибкиПоискаКодаВоВнешнейСистеме,
						Новый Структура("НомерСтроки, Ссылка", "№ п/п", "Юр. / физ. лицо"),
						ПараметрыОформления,
						"Ошибки поиска внешнего кода в системе Матрих"
					);
					ОтчетОбОшибкахЗаполнен = Истина;		
				КонецЕсли;
			КонецЕсли;
			
			// Ненайденные лица
			Если ОтправлятьНепроверенныеЛица Тогда
				НеПроверенныеЛица = Неопределено;
				Если ОшибкиСверки.Свойство("НеПроверенныеЛица", НеПроверенныеЛица) Тогда
					РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(
						ОтчетОбОшибках,
						НеПроверенныеЛица,
						Новый Структура("НомерСтроки, Ссылка, Код, Категория", "№ п/п", "Юр. / физ. лицо", "Внешний код", "Категория"),
						ПараметрыОформления,
						"Непроверенные лица"
					);
					ОтчетОбОшибкахЗаполнен = Истина;		
				КонецЕсли;
			КонецЕсли;
			
			// Если отчет об ошибках не был заполнен, то уничтожаем его
			Если Не ОтчетОбОшибкахЗаполнен Тогда
				ОтчетОбОшибках = Неопределено;	
				
			Иначе
				// Автоширина колонок
				РаботаСОтчетами.ПодобратьШиринуКолонокТаблицыОтчета(ОтчетОбОшибках, 1, 2, ОтчетОбОшибках.ВысотаТаблицы, ОтчетОбОшибках.ШиринаТаблицы, 60);
				
				// Заполняем параметры печати
				РаботаСОтчетами.ЗаполнитьНастройкиПечати(ОтчетОбОшибках, "РезультатСверкиСоСпискомТеррористовВMatrix", Истина, ОриентацияСтраницы.Портрет);
			КонецЕсли;
		КонецЕсли;
		
		// Отправляем отчеты при необходимости
		
		Если ОтчетОНайденныхСовпадениях <> Неопределено Тогда
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".pdf");
			ОтчетОНайденныхСовпадениях.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
			
			Вложения = Новый Соответствие;
			Вложения.Вставить("Отчет " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy") + ".pdf", Новый Файл(ИмяВременногоФайла));
			
			Попытка
				РаботаСЭлектроннойПочтой.ОтправитьПростоеЭлектронноеПисьмо(
					АдресатыПриНайденныхСопадениях,
					"Найденные совпадения со списком террористов на " + Строка(ДатаОтчета),
					"Отчет о найденных совпадениях со списком террористов на " + Строка(ДатаОтчета),
					Вложения,
					РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(),
					Ложь
				);
			Исключение
				ПриВыполненииВозниклиОшибки = Истина;
				Ошибки.Добавить("Ошибка отправки отчета на электронную почту: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		Если ОтчетОбОшибках <> Неопределено Тогда
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".pdf");
			ОтчетОбОшибках.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
			
			Вложения = Новый Соответствие;
			Вложения.Вставить("Отчет " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy") + ".pdf", Новый Файл(ИмяВременногоФайла));
			
			Попытка
				РаботаСЭлектроннойПочтой.ОтправитьПростоеЭлектронноеПисьмо(
					АдресатыПриОшибках,
					"Ошибки сверки со списком террористов на " + Строка(ДатаОтчета),
					"Отчет об ошибках сверки со списком террористов на " + Строка(ДатаОтчета),
					Вложения,
					РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(),
					Ложь
				);
			Исключение
				ПриВыполненииВозниклиОшибки = Истина;
				Ошибки.Добавить("Ошибка отправки отчета на электронную почту: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	// Если были ошибки, сохраняем их
	Если ПриВыполненииВозниклиОшибки Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Ошибки, ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	КонецЕсли;
	
	// Завершаем сессию
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	
КонецПроцедуры // ВыполнитьКоманду

