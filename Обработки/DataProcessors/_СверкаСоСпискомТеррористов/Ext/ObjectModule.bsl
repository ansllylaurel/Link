// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ

Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды)
	
	ПараметрыОтчета = Новый Соответствие();
	ПараметрыОтчета.Вставить("Идентификатор команды", ИдентификаторКоманды);
	ПараметрыОтчета.Вставить("ВыборочнаяПроверка", Ложь);
	
	Описание =
		"Идентификатор команды: " + ИдентификаторКоманды + "
		|Выборочная проверка: Нет
		|Проверяемые лица: Полный список";
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики