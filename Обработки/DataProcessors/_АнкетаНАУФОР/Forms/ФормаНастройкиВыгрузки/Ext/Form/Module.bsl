
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтруктураФайла = Параметры.СтруктураФайла;
	Квартальная = Параметры.Квартальная;
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("Раздел", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3)));
	ТаблицаРеквизитов.Колонки.Добавить("Подраздел", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	
	ТаблицаРеквизитов.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("РеквизитФормы"));
	
	Для каждого ЭлементСтруктуры Из СтруктураФайла Цикл
	
		Если ЗначениеЗаполнено(ЭлементСтруктуры.Раздел) И (Квартальная И ЭлементСтруктуры.Квартальная
			Или Не Квартальная И ЭлементСтруктуры.Годовая) Тогда
		
			Если ТаблицаРеквизитов.Найти(ЭлементСтруктуры.Раздел, "Подраздел") = Неопределено Тогда
			
				НовыйРеквизит = Новый РеквизитФормы(
					"_" + ЭлементСтруктуры.Раздел,
					Новый ОписаниеТипов("Булево"),
					,
					ЭлементСтруктуры.Заголовок,
					Истина);
				
				НоваяСтрока = ТаблицаРеквизитов.Добавить();
				НоваяСтрока.Раздел 		= СтрРазделить(ЭлементСтруктуры.Раздел, "_")[0];
				НоваяСтрока.Подраздел 	= ЭлементСтруктуры.Раздел;				
				НоваяСтрока.Реквизит 	= НовыйРеквизит;			
				
			КонецЕсли; 
		
		КонецЕсли; 
	
	КонецЦикла;
	
	ДобавляемыеРеквизиты = ТаблицаРеквизитов.ВыгрузитьКолонку("Реквизит");
		
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаРеквизитов", ТаблицаРеквизитов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаРеквизитов.Раздел КАК Раздел,
		|	ТаблицаРеквизитов.Подраздел КАК Подраздел
		|ПОМЕСТИТЬ _ТаблицаРеквизитов
		|ИЗ
		|	&ТаблицаРеквизитов КАК ТаблицаРеквизитов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ТаблицаРеквизитов.Раздел КАК Раздел,
		|	_ТаблицаРеквизитов.Подраздел КАК Подраздел
		|ИЗ
		|	_ТаблицаРеквизитов КАК _ТаблицаРеквизитов
		|ИТОГИ ПО
		|	Раздел";
	
	ВыборкаРаздел = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРаздел.Следующий() Цикл
	
		Выборка = ВыборкаРаздел.Выбрать();
		
		Родитель = ЭтаФорма;
		
		Если Выборка.Количество() > 1 Тогда
			
			НоваяГруппа = Элементы.Добавить("Группа_" + ВыборкаРаздел.Раздел, Тип("ГруппаФормы"), ЭтаФорма);
			НоваяГруппа.Вид 		= ВидГруппыФормы.ОбычнаяГруппа;
			НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
			
			Родитель = НоваяГруппа;
			
			ГруппаКнопки = Элементы.Добавить("Кнопки_" + ВыборкаРаздел.Раздел, Тип("ГруппаФормы"), Родитель);
			ГруппаКнопки.Вид 		= ВидГруппыФормы.КоманднаяПанель;
			//ГруппаКнопки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
			//ГруппаКнопки.Отображение = ОтображениеОбычнойГруппы.Нет;
			
			ДобавитьКомандуИзмененияФлажков(Истина, ВыборкаРаздел.Раздел, ГруппаКнопки);
			ДобавитьКомандуИзмененияФлажков(Ложь, ВыборкаРаздел.Раздел, ГруппаКнопки);
			
		КонецЕсли; 
		
		Пока Выборка.Следующий() Цикл
		
			ИмяРеквизита = "_" + Выборка.Подраздел;
			
			НовыйЭлемент = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Родитель); 
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
			НовыйЭлемент.ПутьКДанным = ИмяРеквизита;
			НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
			
			ЗаполнитьЗначенияСвойств(ЭтаФорма.ТаблицаРазделов.Добавить(), Выборка);
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

#Область Команды_изменения_флажков

&НаСервере
Процедура ДобавитьКомандуИзмененияФлажков(УстановитьФлажки, Раздел, ГруппаКнопки)

	Если УстановитьФлажки Тогда
	
		ИмяКоманды = "КомандаУстановитьФлажки";
		ЗаголовокКоманды = "Установить флажки";
		Картинка = БиблиотекаКартинок.СнятьФлажки;
		
	Иначе
		
		ИмяКоманды = "КомандаСнятьФлажки";
		ЗаголовокКоманды = "Снять флажки";
		Картинка = БиблиотекаКартинок.УстановитьФлажки;
	
	КонецЕсли; 
	
	НоваяКоманда = ЭтаФорма.Команды.Добавить(ИмяКоманды + "_" + Раздел);
	НоваяКоманда.Действие 		= ИмяКоманды;
	НоваяКоманда.Заголовок 		= ЗаголовокКоманды;
	НоваяКоманда.Картинка 		= Картинка;
	НоваяКоманда.Отображение 	= ОтображениеКнопки.Картинка;
	НоваяКоманда.Подсказка 		= ЗаголовокКоманды;

	НоваяКнопка = Элементы.Добавить(НоваяКоманда.Имя, Тип("КнопкаФормы"), ГруппаКнопки);
	НоваяКнопка.ИмяКоманды = НоваяКоманда.Имя;
	
КонецПроцедуры
                                    
&НаКлиенте
Процедура КомандаУстановитьФлажки(Команда)
	
	Раздел = СтрЗаменить(Команда.Имя, "КомандаУстановитьФлажки_", "");
	ИзменитьФлажки(Истина, Раздел);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьФлажки(Команда)
	
	Раздел = СтрЗаменить(Команда.Имя, "КомандаСнятьФлажки_", "");
	ИзменитьФлажки(Ложь, Раздел);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажки(Значение, Раздел)

	Для каждого СтрокаРаздел Из ЭтаФорма.ТаблицаРазделов Цикл
	
		Если СтрокаРаздел.Раздел = Раздел Тогда
			ЭтаФорма["_" + СтрокаРаздел.Подраздел] = Значение;
		КонецЕсли; 
	
	КонецЦикла; 

КонецПроцедуры
 
#КонецОбласти 

&НаКлиенте
Процедура КомандаВыгрузить(Команда)
	
	МассивРазделов = Новый Массив;
	
	Для каждого СтрокаРаздел Из ЭтаФорма.ТаблицаРазделов Цикл
	
		Если ЭтаФорма["_" + СтрокаРаздел.Подраздел] Тогда
			
			МассивРазделов.Добавить(СтрокаРаздел.Подраздел);
			
		КонецЕсли; 
	
	КонецЦикла; 
	
	Закрыть(МассивРазделов);
	
КонецПроцедуры
