	    |					Организация = &Организация
	    |						И СчетДоверительногоУправления В
	    |							(ВЫБРАТЬ
	    |								_ФинансовыеПоказатели.СчетДоверительногоУправления КАК СчетДоверительногоУправления
	    |							ИЗ
	    |								_ФинансовыеПоказатели КАК _ФинансовыеПоказатели
	    |							ГДЕ
	    |								_ФинансовыеПоказатели.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)),
	    |					,
	    |					) КАК БухгалтерскийУчетОбороты
	    |		ГДЕ
	    |			ВЫБОР
	    |					КОГДА БухгалтерскийУчетОбороты.Счет = ЗНАЧЕНИЕ(ПланСчетов.Основной.ПрочиеРасходы)
	    |						ТОГДА БухгалтерскийУчетОбороты.Субконто1
	    |					ИНАЧЕ БухгалтерскийУчетОбороты.Субконто2
	    |				КОНЕЦ = &ПрочиеДоходыИРасходы) КАК ВложенныйЗапрос
	    |		ПО _ФинансовыеПоказатели.СчетДоверительногоУправления = ВложенныйЗапрос.СчетДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПаевыеИнвестиционныеФонды КАК ПаевыеИнвестиционныеФонды
	    |		ПО _ФинансовыеПоказатели.Клиент = ПаевыеИнвестиционныеФонды.Ссылка
	    |ГДЕ
	    |	_ФинансовыеПоказатели.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
	    |	И ДоговорыАудит.ДатаЗаключения <= &КонецПериода
	    |	И ДоговорыАудит.ДатаРасторжения > &НачалоПериода";
	
	#КонецОбласти 
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;

КонецФункции

&НаСервереБезКонтекста
Процедура ПолучитьСтоимостиПоЕдиномуБухУчету(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	_СчетаДоверительногоУправления.Дата КАК Дата
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|ГДЕ
		|	_СчетаДоверительногоУправления.ИсточникСтоимости = ""ЕдиныйБухгалтерскийУчет""
		|ИТОГИ ПО
		|	Дата";
	
	ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	БалансоваяСтоимостьЕдиныйБухУчет = Новый ТаблицаЗначений;
	БалансоваяСтоимостьЕдиныйБухУчет.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	БалансоваяСтоимостьЕдиныйБухУчет.Колонки.Добавить("Сумма", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип));
	
	Пока ВыборкаДата.Следующий() Цикл
	
		Выборка = ВыборкаДата.Выбрать();
		МассивСчетов = Новый Массив;
		Пока Выборка.Следующий() Цикл
			МассивСчетов.Добавить(Выборка.Ссылка);
		КонецЦикла; 
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕдиныйБухгалтерскийУчетОстатки.СчетДоверительногоУправления СчетДоверительногоУправления,
			|	ЕСТЬNULL(ЕдиныйБухгалтерскийУчетОстатки.СуммаОстаток, 0) КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
			|				&ГраницаОкончания,
			|				ПОДСТРОКА(Счет.Код, 1, 3) В (""202"", ""205"", ""206"", ""306"", ""501"", ""502"", ""503"", ""504"", ""506"", ""507"", ""509"")
			|					ИЛИ Счет.Код = ""60324""
			|					ИЛИ Счет.Код = ""47425""
			|					ИЛИ Счет.Код = ""47017""
			|					ИЛИ ПОДСТРОКА(Счет.Код, 1, 3) В (""479"", ""474"", ""603"", ""470"")
			|						И Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный),
			|				,
			|				Организация = &Организация
			|					И СчетДоверительногоУправления В
			|						(&МассивСчетов)) КАК ЕдиныйБухгалтерскийУчетОстатки";
		
		Запрос.УстановитьПараметр("ГраницаОкончания", Новый Граница(КонецДня(ВыборкаДата.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
		
		ВыборкаСтоимости = Запрос.Выполнить().Выбрать();
		Пока ВыборкаСтоимости.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(БалансоваяСтоимостьЕдиныйБухУчет.Добавить(), ВыборкаСтоимости);
		КонецЦикла; 
	
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("БалансоваяСтоимостьЕдиныйБухУчет", БалансоваяСтоимостьЕдиныйБухУчет);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БалансоваяСтоимостьЕдиныйБухУчет.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БалансоваяСтоимостьЕдиныйБухУчет.Сумма КАК Сумма
		|ПОМЕСТИТЬ _БалансоваяСтоимостьЕдиныйБухУчет
		|ИЗ
		|	&БалансоваяСтоимостьЕдиныйБухУчет КАК БалансоваяСтоимостьЕдиныйБухУчет";
	
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьСтоимостиПоБухУчету(Запрос)
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	_СчетаДоверительногоУправления.Дата КАК Дата
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|ГДЕ
		|	_СчетаДоверительногоУправления.ИсточникСтоимости = ""БухгалтерскийУчет""
		|ИТОГИ ПО
		|	Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Основной.Ссылка КАК Счет,
		|	1 КАК КоэффицентДт,
		|	ВЫБОР
		|		КОГДА Основной.Код В (""63.6"", ""63.11"")
		|			ТОГДА 1
		|		КОГДА ПОДСТРОКА(Основной.Код, 1, 2) МЕЖДУ ""60"" И ""76""
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК КоэффицентКт
		|ПОМЕСТИТЬ _ОтборПоСчетам
		|ИЗ
		|	ПланСчетов.Основной КАК Основной
		|ГДЕ
		|	(ПОДСТРОКА(Основной.Код, 1, 2) МЕЖДУ ""51"" И ""76""
		|			ИЛИ ПОДСТРОКА(Основной.Код, 1, 2) = ""98"")";
	
	ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	БалансоваяСтоимостьБухУчет = Новый ТаблицаЗначений;
	БалансоваяСтоимостьБухУчет.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	БалансоваяСтоимостьБухУчет.Колонки.Добавить("Сумма", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип));
	
	Пока ВыборкаДата.Следующий() Цикл
	
		Выборка = ВыборкаДата.Выбрать();
		МассивСчетов = Новый Массив;
		Пока Выборка.Следующий() Цикл
			МассивСчетов.Добавить(Выборка.Ссылка);
		КонецЦикла; 
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	БухгалтерскийУчетОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	СУММА(БухгалтерскийУчетОстатки.СуммаОстатокДт * _ОтборПоСчетам.КоэффицентДт - БухгалтерскийУчетОстатки.СуммаОстатокКт * _ОтборПоСчетам.КоэффицентКт) КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.БухгалтерскийУчет.Остатки(
			|			&ГраницаОкончания,
			|			Счет В
			|				(ВЫБРАТЬ
			|					_ОтборПоСчетам.Счет
			|				ИЗ
			|					_ОтборПоСчетам КАК _ОтборПоСчетам),
			|			,
			|			Организация = &Организация
			|				И СчетДоверительногоУправления В (&МассивСчетов)) КАК БухгалтерскийУчетОстатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ОтборПоСчетам КАК _ОтборПоСчетам
			|		ПО БухгалтерскийУчетОстатки.Счет = _ОтборПоСчетам.Счет
			|
			|СГРУППИРОВАТЬ ПО
			|	БухгалтерскийУчетОстатки.СчетДоверительногоУправления";
		
		Запрос.УстановитьПараметр("ГраницаОкончания", Новый Граница(КонецДня(ВыборкаДата.Дата), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
		
		ВыборкаСтоимости = Запрос.Выполнить().Выбрать();
		Пока ВыборкаСтоимости.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(БалансоваяСтоимостьБухУчет.Добавить(), ВыборкаСтоимости);
		КонецЦикла; 
	
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("БалансоваяСтоимостьБухУчет", БалансоваяСтоимостьБухУчет);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БалансоваяСтоимостьБухУчет.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	БалансоваяСтоимостьБухУчет.Сумма КАК Сумма
		|ПОМЕСТИТЬ _БалансоваяСтоимостьБухУчет
		|ИЗ
		|	&БалансоваяСтоимостьБухУчет КАК БалансоваяСтоимостьБухУчет";
	
	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьРасшифровку(МенеджерВременныхТаблиц)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогДУ <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА 1
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА 2
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА 3
		|	КОНЕЦ КАК Раздел,
		|	ВЫБОР
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогДУ <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогДУ
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогИИС
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИС
		|	КОНЕЦ КАК Клиент,
		|	ВЫБОР
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогДУ <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогДУОбъем
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ДогИИСОбъем
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИСОбъем
		|	КОНЕЦ КАК СЧА,
		|	ВЫБОР
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИСОбъем_ЗакрытыеИИС
		|	КОНЕЦ КАК СЧАЗакрытыхИИС,
		|	ВЫБОР
		|		КОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИС <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_ЗакрДогИИСОбъем_ВыведеноНаследникамИИС
		|	КОНЕЦ КАК ВыведеноНаследникамПрекращенныхИИС,
		|	ВЫБОР
		|		КОГДА ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Порядок,
		|	ВЫБОР
		|		КОГДА ЮрФизЛица.Ссылка ЕСТЬ НЕ NULL 
		|			ТОГДА Таблица_Управление_ДУ_Врем.Строка_УпДУ_КлиентыДУ_ФизРезид ЕСТЬ НЕ NULL 
		|					ИЛИ Таблица_Управление_ДУ_Врем.Строка_УпДУ_КлиентыДУ_ЮрРезид ЕСТЬ НЕ NULL 
		|	КОНЕЦ КАК Резидент,
		|	Таблица_Управление_ДУ_Врем.УчитыватьВКоличестве КАК УчитыватьВКоличестве
		|ИЗ
		|	Таблица_Управление_ДУ_Врем КАК Таблица_Управление_ДУ_Врем
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО Таблица_Управление_ДУ_Врем.Клиент = ЮрФизЛица.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Раздел,
		|	Порядок,
		|	Клиент
		|АВТОУПОРЯДОЧИВАНИЕ";
	#КонецОбласти 	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТабДок = Новый ТабличныйДокумент;
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Расшифровка");
	
	СтруктураМакета = Новый Структура;
	
	Для НомерРаздела = 1 По 3 Цикл
	
		СтруктураРаздела = Новый Структура("Шапка, Строка", 
			Макет.ПолучитьОбласть("Шапка" + НомерРаздела),
			Макет.ПолучитьОбласть("Строка" + НомерРаздела));
			
		СтруктураМакета.Вставить("Раздел" + НомерРаздела, СтруктураРаздела);
	
	КонецЦикла; 
	
	Пока Выборка.Следующий() Цикл
	
		СтруктураРаздела = СтруктураМакета["Раздел" + Выборка.Раздел];
		Если СтруктураРаздела.Свойство("Шапка") Тогда
			ТабДок.Вывести(СтруктураРаздела.Шапка);
		    СтруктураРаздела.Удалить("Шапка");
		КонецЕсли;
		
		СтруктураРаздела.Строка.Параметры.Заполнить(Выборка);
		
		Зачеркнутый = ((Выборка.Раздел = 2 ИЛИ Выборка.Раздел = 3) И Не Выборка.УчитыватьВКоличестве);
		Область = СтруктураРаздела.Строка.Область();
		Область.Шрифт = Новый Шрифт(Область.Шрифт, ,,,,, Зачеркнутый);
		
		ТабДок.Вывести(СтруктураРаздела.Строка);
		
	КонецЦикла;
	
	ЭтаФорма.Таблица_Управление_ДУ_Расшифровка = ТабДок;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел7()

	ПоследнийРабочийДень					   = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Объект.Период.ДатаОкончания);
	ДатаОтчетности							   = ТекущаяДатаСеанса();
	СчетаДоверительногоУправления			   = ПолучитьТаблицуКлиентов(Объект.Организация, Объект.Период);
	ВидыОперацийВводаВыводаДенежныхСредствПоДУ = Справочники.ВидыОперацийПриВводеВыводеДенежныхСредств.ВидыОперацийСАктивамиДоверительногоУправления();
	
	Запрос = Новый Запрос;
	
	РаботаСОтчетами.ПоместитьДатыПолученияДокументовОСмертиВМенеджерВременныхТаблиц(Запрос, ДатаОтчетности, Объект.Организация, , "_ДатыПолученияДокументовОСмерти");	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(СчетаДоверительногоУправления, "_СчетаДоверительногоУправления", Запрос);
	
	Запрос.УстановитьПараметр("Организация", 		  Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", 		  Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", ПоследнийРабочийДень);
	Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СУММА(ДвиженияЛК.Количество_Клиентов) КАК Количество_Клиентов,
		|	СУММА(ДвиженияЛК.Сумма_средств_ЛК) КАК Сумма_средств_ЛК
		|ИЗ
		|	(ВЫБРАТЬ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Пайщик) КАК Количество_Клиентов,
		|		0 КАК Сумма_средств_ЛК
		|	ИЗ
		|		РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.ОстаткиИОбороты(
		|				&НачалоПериода,
		|				&ПоследнийРабочийДень,
		|				,
		|				,
		|				Организация = &Организация
		|					И ПаевойИнвестиционныйФонд В
		|						(ВЫБРАТЬ
		|							_СчетаДоверительногоУправления.Клиент
		|						ИЗ
		|							_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)) КАК ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты
		|	ГДЕ
		|		ВЫРАЗИТЬ(ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.Партия КАК Документ.ЗачислениеПаев).Заявка.ИсточникЗаявки = ЗНАЧЕНИЕ(Перечисление.ИсточникиАнкетИЗаявок.Сайт)
		|		И ДолиПайщиковВИнвестиционномФондеОстаткиИОбороты.КоличествоПриход > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		0,
		|		ДенежныеСредстваПереданныеВОплатуПаевОбороты.СуммаПриход
		|	ИЗ
		|		РегистрНакопления.ДенежныеСредстваПереданныеВОплатуПаев.Обороты(
		|				&НачалоПериода,
		|				&ПоследнийРабочийДень,
		|				Регистратор,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В
		|						(ВЫБРАТЬ
		|							_СчетаДоверительногоУправления.Ссылка
		|						ИЗ
		|							_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления)) КАК ДенежныеСредстваПереданныеВОплатуПаевОбороты
		|	ГДЕ
		|		ВЫРАЗИТЬ(ВЫРАЗИТЬ(ДенежныеСредстваПереданныеВОплатуПаевОбороты.Регистратор КАК Документ.ВводДенежныхСредств).Основание КАК Документ.ЗаявкаПайщика).ИсточникЗаявки = ЗНАЧЕНИЕ(Перечисление.ИсточникиАнкетИЗаявок.Сайт)) КАК ДвиженияЛК";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭтоРЭМ = (Объект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));	
	Если ЭтоРЭМ Тогда

		// 7.2
		ЭтаФорма.Идентификация_клиентов = "Да";
		// 7.3
		ЭтаФорма.Идентификация_ЕСИА = "Да";
		// 7.4
		ЭтаФорма.Личный_кабинет = Истина;
		// 7.5
		ЭтаФорма.Количество_Договоров_ДУ = 0;
		// 7.6
		ЭтаФорма.Количество_Клиентов = 0;
		// 7.7
		ЭтаФорма.Сумма_средств_ЛК = 0;
			
		Если Выборка.Следующий() Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);
			
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьРаздел9()
	
	Бухгалтерия = РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией(Объект.Организация);
	
	Если Бухгалтерия <> Неопределено Тогда
	
		ОрганизацияБухгалтерии = РаботаСВнешнимиСистемами.ПолучитьОрганизациюБухгалтерии(Бухгалтерия, Объект.Организация);
		
		ЗаполнитьРазделыИзОФР(Бухгалтерия, ОрганизацияБухгалтерии);
		ЗаполнитьРазделыИзБаланса(Бухгалтерия, ОрганизацияБухгалтерии);
		
		Если Квартальная Или ЭтаФорма.ВерсияФайла >= "2021" Тогда
			
			Для Месяц = 1 По 3 Цикл
				КонецМесяца = НачалоДня(КонецМесяца(ДобавитьМесяц(НачалоКвартала(Объект.Период.ДатаОкончания), Месяц - 1)));
				ЭтаФорма["СобСред1_" + Месяц] = КонецМесяца;
				ЭтаФорма["СобСред2_" + Месяц] = РаботаСВнешнимиСистемами.ПолучитьСтоимостьСобственныхСредствИзБухгалтерии(Объект.Организация, КонецМесяца, Бухгалтерия);
			КонецЦикла;
			
		КонецЕсли;
		
		Если Не Квартальная Тогда
		
			КонецМесяца = НачалоДня(Объект.Период.ДатаОкончания);
			Собственные_Средства_руб = РаботаСВнешнимиСистемами.ПолучитьСтоимостьСобственныхСредствИзБухгалтерии(Объект.Организация, КонецМесяца, Бухгалтерия);
		
		КонецЕсли; 
	
	КонецЕсли;

КонецПроцедуры
 
&НаСервере
Функция ЗаполнитьРазделыИзОФР(Бухгалтерия, ОрганизацияБухгалтерии)
	
	Запрос = Бухгалтерия.NewObject("Запрос");
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Показатели.ИмяПоказателя КАК ИмяПоказателя,
		|	УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Показатели.Значение КАК Значение
		|ИЗ
		|	Документ.УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Показатели КАК УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Показатели
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
		|				ВЫБРАТЬ ПЕРВЫЕ 1 
		|					УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Ссылка КАК Ссылка,
		|					УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Дата
		|				ИЗ Документ.УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020 КАК УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Организации КАК УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Организации
		|					ПО УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Организации.Ссылка = УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Ссылка
		|						И УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Организации.Организация = &Организация
		|					 	И УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.ДатаНачала = &ДатаНачала
		|						И УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.ДатаОкончания = &ДатаОкончания
		|						И НЕ УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.ПометкаУдаления
		|						И УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Перечисление.ПорядкиОкругленияОтчетности.Окр1)
		|						И УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Состояние В (ЗНАЧЕНИЕ(Перечисление.УПЦБ_СостоянияОтчетов.Подготовлен),
		|										ЗНАЧЕНИЕ(Перечисление.УПЦБ_СостоянияОтчетов.Возвращен),ЗНАЧЕНИЕ(Перечисление.УПЦБ_СостоянияОтчетов.Утвержден))
		|				СГРУППИРОВАТЬ ПО 
		|					УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Ссылка,
		|					УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Дата
		|				ИМЕЮЩИЕ Количество(УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Организации.Организация) = 1
		|				УПОРЯДОЧИТЬ ПО
		|					УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Дата УБЫВ) КАК УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020
		|		ПО УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Показатели.Ссылка = УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020.Ссылка
		|ГДЕ
		|	 УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Показатели.ИмяРаздела = ""ОтчетТитульнаяСтраница""
		|		И УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020Показатели.ИмяПоказателя В (&СписокПолей)";	
	
	Если Год(Объект.Период.ДатаОкончания) = 2023 Тогда
		ИмяДокумента = "УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2022";
	ИначеЕсли Год(Объект.Период.ДатаОкончания) >= 2025 Тогда
		ИмяДокумента = "УПЦБ_ОтчетОФинансовыхРезультатах_843_2025";
	Иначе
		ИмяДокумента = "УПЦБ_ОтчетОФинансовыхРезультатах532_4128_" + Формат(Объект.Период.ДатаОкончания, "ДФ=yyyy");
	КонецЕсли; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПЦБ_ОтчетОФинансовыхРезультатах532_4128_2020", ИмяДокумента);
	
	Если ЭтаФорма.Квартальная И Год(Объект.Период.ДатаОкончания) < 2025 Тогда
		СписокПолей = """П1001"", ""П1201"", ""П1301"", ""П1501"", ""П1701"", ""П2201""";
	Иначе
		СписокПолей = """П1002"", ""П1202"", ""П1302"", ""П1502"", ""П1702"", ""П2202""";
	КонецЕсли; 
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СписокПолей", СписокПолей);
	
	Запрос.УстановитьПараметр("Организация",	ОрганизацияБухгалтерии);
	Запрос.УстановитьПараметр("ДатаНачала",		НачалоГода(Объект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания",	НачалоДня(Объект.Период.ДатаОкончания));

	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные для заполнения раздела 9." + Символы.ПС + "Система сообщает: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	Выборка = Результат.Выбрать();
	
	ЭтаФорма.Выручка_Коммисия = 0;
	ЭтаФорма.Расходы_Персонал = 0;
	ЭтаФорма.Расходы_Операционные = 0;
	ЭтаФорма.Расходы_Административные = 0;
	ЭтаФорма.Прибыль_ДоНалогообложения = 0;
	ЭтаФорма.Чистая_Прибыль = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Значение = Выборка.Значение / 1000;
		
		Если Выборка.ИмяПоказателя = "П1001" Или Выборка.ИмяПоказателя = "П1002" Тогда
			ЭтаФорма.Выручка_Коммисия = Значение;
		ИначеЕсли Выборка.ИмяПоказателя = "П1201" Или Выборка.ИмяПоказателя = "П1202" Тогда
			ЭтаФорма.Расходы_Персонал = Значение;
		ИначеЕсли Выборка.ИмяПоказателя = "П1301" Или Выборка.ИмяПоказателя = "П1302" Тогда
			ЭтаФорма.Расходы_Операционные = Значение;
		ИначеЕсли Выборка.ИмяПоказателя = "П1501" Или Выборка.ИмяПоказателя = "П1502" Тогда
			ЭтаФорма.Расходы_Административные = Значение;
		ИначеЕсли Выборка.ИмяПоказателя = "П1701" Или Выборка.ИмяПоказателя = "П1702" Тогда
			ЭтаФорма.Прибыль_ДоНалогообложения = Значение;
		ИначеЕсли Выборка.ИмяПоказателя = "П2201" Или Выборка.ИмяПоказателя = "П2202" Тогда
			ЭтаФорма.Чистая_Прибыль = Значение;
		КонецЕсли; 
	
	КонецЦикла; 
	
	Если Выборка.Количество() = 0 Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(
				"В базе бухгалтерии отсутствует Отчёт о финансовых результатах со статусом 'Проверен, на утверждении', 'Отправлен на уточнение' или 'Утвержден' за %1. 
				|Формирование отчёта невозможно. Обратитесь в бухгалтерию.", 
				ПредставлениеПериода(НачалоГода(Объект.Период.ДатаНачала), Объект.Период.ДатаОкончания)));
	
	КонецЕсли; 
	
КонецФункции

&НаСервере
Функция ЗаполнитьРазделыИзБаланса(Бухгалтерия, ОрганизацияБухгалтерии)
	//УПЦБ_Баланс_532_4128_2_2020
	Запрос = Бухгалтерия.NewObject("Запрос");
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УПЦБ_Баланс_532_4128_2_2020Показатели.ИмяПоказателя КАК ИмяПоказателя,
		|	УПЦБ_Баланс_532_4128_2_2020Показатели.Значение КАК Значение
		|ИЗ
		|	Документ.УПЦБ_Баланс_532_4128_2_2020.Показатели КАК УПЦБ_Баланс_532_4128_2_2020Показатели
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
		|				ВЫБРАТЬ ПЕРВЫЕ 1 
		|					УПЦБ_Баланс_532_4128_2_2020.Ссылка КАК Ссылка,
		|					УПЦБ_Баланс_532_4128_2_2020.Дата
		|				ИЗ Документ.УПЦБ_Баланс_532_4128_2_2020 КАК УПЦБ_Баланс_532_4128_2_2020
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УПЦБ_Баланс_532_4128_2_2020.Организации КАК УПЦБ_Баланс_532_4128_2_2020Организации
		|					ПО УПЦБ_Баланс_532_4128_2_2020Организации.Ссылка = УПЦБ_Баланс_532_4128_2_2020.Ссылка
		|						И УПЦБ_Баланс_532_4128_2_2020Организации.Организация = &Организация
		|					 	И УПЦБ_Баланс_532_4128_2_2020.ДатаНачала = &ДатаНачала
		|						И УПЦБ_Баланс_532_4128_2_2020.ДатаОкончания = &ДатаОкончания
		|						И НЕ УПЦБ_Баланс_532_4128_2_2020.ПометкаУдаления
		|						И УПЦБ_Баланс_532_4128_2_2020.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Перечисление.ПорядкиОкругленияОтчетности.Окр1)
		|						И УПЦБ_Баланс_532_4128_2_2020.Состояние В (ЗНАЧЕНИЕ(Перечисление.УПЦБ_СостоянияОтчетов.Подготовлен),
		|										ЗНАЧЕНИЕ(Перечисление.УПЦБ_СостоянияОтчетов.Возвращен),ЗНАЧЕНИЕ(Перечисление.УПЦБ_СостоянияОтчетов.Утвержден))
		|				СГРУППИРОВАТЬ ПО 
		|					УПЦБ_Баланс_532_4128_2_2020.Ссылка,
		|					УПЦБ_Баланс_532_4128_2_2020.Дата
		|				ИМЕЮЩИЕ Количество(УПЦБ_Баланс_532_4128_2_2020.Организация) = 1
		|				УПОРЯДОЧИТЬ ПО
		|					УПЦБ_Баланс_532_4128_2_2020.Дата УБЫВ) КАК УПЦБ_Баланс_532_4128_2_2020
		|		ПО УПЦБ_Баланс_532_4128_2_2020Показатели.Ссылка = УПЦБ_Баланс_532_4128_2_2020.Ссылка
		|ГДЕ
		|	 УПЦБ_Баланс_532_4128_2_2020Показатели.ИмяРаздела = ""ОтчетТитульнаяСтраница""
		|		И УПЦБ_Баланс_532_4128_2_2020Показатели.ИмяПоказателя В (&СписокПолей)";	
	
	
	Если Год(Объект.Период.ДатаОкончания) = 2023 Тогда
		ИмяДокумента = "УПЦБ_Баланс_532_4128_2_2022";
		СписокПолей = """П2003""";
	ИначеЕсли Год(Объект.Период.ДатаОкончания) >= 2025 Тогда
		ИмяДокумента = "УПЦБ_Баланс_843_2025";
		СписокПолей = """П2203""";
	Иначе
		ИмяДокумента = "УПЦБ_Баланс_532_4128_2_" + Формат(Объект.Период.ДатаОкончания, "ДФ=yyyy");
		СписокПолей = """П2003""";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПЦБ_Баланс_532_4128_2_2020", ИмяДокумента);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&СписокПолей",                СписокПолей);
	
	Запрос.УстановитьПараметр("Организация",	ОрганизацияБухгалтерии);
	Запрос.УстановитьПараметр("ДатаНачала",		НачалоГода(Объект.Период.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания",	НачалоДня(Объект.Период.ДатаОкончания));

	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось получить данные для заполнения раздела 9." + Символы.ПС + "Система сообщает: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЭтаФорма.Размер_Активов = Выборка.Значение / 1000;
	Иначе 
		ЭтаФорма.Размер_Активов = 0;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтрШаблон(
				"В базе бухгалтерии отсутствует отчёт Бухгалтерский баланс со статусом 'Проверен, на утверждении', 'Отправлен на уточнение' или 'Утвержден' за %1. 
				|Формирование отчёта невозможно. Обратитесь в бухгалтерию.", 
				ПредставлениеПериода(НачалоГода(Объект.Период.ДатаНачала), Объект.Период.ДатаОкончания)));
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьДанныеПоПИФ(Запрос, Дата)
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыПИФСрезПоследних.ПолноеНаименованиеФонда КАК ПолноеНаименованиеФонда,
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд.НомерПравил КАК НомерПравил,
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд.ДатаПравил КАК ДатаПравил,
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд.Тип КАК ТипПИФ,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаВознаграждениеУправляющего КАК НастройкаРасчетаРезервовЗаВознаграждениеУправляющего,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаВознаграждениеДепозитария КАК НастройкаРасчетаРезервовЗаВознаграждениеДепозитария,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.НастройкаРасчетаРезервовЗаПрочиеВозмещаемыеРасходыУправляющего КАК НастройкаРасчетаРезервовЗаПрочиеВозмещаемыеРасходыУправляющего,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.МинимальнаяСуммаЗачисления КАК МинимальнаяСуммаЗачисления,
		|	РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда КАК КраткоеНаименованиеФонда,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд.Категория КАК Категория,
		|	УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПредназначенДляКвалИнвесторов КАК ПредназначенДляКвалИнвесторов,
		|	РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
		|ИЗ
		|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&КонецПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияПравилПаевогоИнвестиционногоФонда.СрезПоследних(&ПоследнийРабочийДень, ) КАК УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних
		|		ПО РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд = УсловияПравилПаевогоИнвестиционногоФондаСрезПоследних.ПаевойИнвестиционныйФонд";

	Результат = Запрос.Выполнить().Выгрузить();
	
	ТипСтавка = Метаданные.ОпределяемыеТипы.ПроцентнаяСтавка.Тип;
	Результат.Колонки.Добавить("ПроцентВознагражденияУК", 								ТипСтавка);
	Результат.Колонки.Добавить("ПроцентВознагражденияСпецДепозитарияИСпецРегистратора", ТипСтавка);
	Результат.Колонки.Добавить("ПроцентПрочихРасходов",		 							ТипСтавка);
	
	СтруктураПараметров = Новый Структура("Период", Дата);	
	Для Каждого СтрокаРезультата из Результат Цикл
		
		Если Справочники.НастройкиРасчета.НастройкаРасчетаРезерваПИФСодержитСтавку(СтрокаРезультата.НастройкаРасчетаРезервовЗаВознаграждениеУправляющего) Тогда
			СтрокаРезультата.ПроцентВознагражденияУК = Справочники.НастройкиРасчета.Рассчитать(СтрокаРезультата.НастройкаРасчетаРезервовЗаВознаграждениеУправляющего, СтруктураПараметров);
		КонецЕсли;
		
		Если Справочники.НастройкиРасчета.НастройкаРасчетаРезерваПИФСодержитСтавку(СтрокаРезультата.НастройкаРасчетаРезервовЗаВознаграждениеДепозитария) Тогда
			СтрокаРезультата.ПроцентВознагражденияСпецДепозитарияИСпецРегистратора = Справочники.НастройкиРасчета.Рассчитать(СтрокаРезультата.НастройкаРасчетаРезервовЗаВознаграждениеДепозитария, СтруктураПараметров);
		КонецЕсли;
		
		Если Справочники.НастройкиРасчета.НастройкаРасчетаРезерваПИФСодержитСтавку(СтрокаРезультата.НастройкаРасчетаРезервовЗаПрочиеВозмещаемыеРасходыУправляющего) Тогда
			СтрокаРезультата.ПроцентПрочихРасходов = Справочники.НастройкиРасчета.Рассчитать(СтрокаРезультата.НастройкаРасчетаРезервовЗаПрочиеВозмещаемыеРасходыУправляющего, СтруктураПараметров);
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Результат", Результат);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Результат.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
		|	Результат.ПолноеНаименованиеФонда КАК ПолноеНаименованиеФонда,
		|	Результат.НомерПравил КАК НомерПравил,
		|	Результат.ДатаПравил КАК ДатаПравил,
		|	Результат.ТипПИФ КАК ТипПИФ,
		|	Результат.ПроцентВознагражденияУК КАК ПроцентВознагражденияУК,
		|	Результат.ПроцентВознагражденияСпецДепозитарияИСпецРегистратора КАК ПроцентВознагражденияСпецДепозитарияИСпецРегистратора,
		|	Результат.ПроцентПрочихРасходов КАК ПроцентПрочихРасходов,
		|	Результат.МинимальнаяСуммаЗачисления КАК МинимальнаяСуммаЗачисления,
		|	Результат.КраткоеНаименованиеФонда КАК КраткоеНаименованиеФонда,
		|	Результат.Категория КАК Категория,
		|	Результат.ПредназначенДляКвалИнвесторов КАК ПредназначенДляКвалИнвесторов
		|ПОМЕСТИТЬ _ДанныеПИФ
		|ИЗ
		|	&Результат КАК Результат";
	
	Запрос.Выполнить();
	
КонецПроцедуры

#КонецОбласти 

#Область Выгрузка_в_ХМЛ

&НаКлиентеНаСервереБезКонтекста 
Функция ПолучитьСтруктуруФайла(ОписаниеСтруктурыФайла)

	ЭлементыСтруктуры = Новый Массив;
	Для НомерСтроки = 2 По ОписаниеСтруктурыФайла.ВысотаТаблицы Цикл
		
		СтруктураФайла = Новый Структура;
		СтруктураФайла.Вставить("ТегЭлемента", 	ОписаниеСтруктурыФайла.Область(НомерСтроки, 1, НомерСтроки, 1).Текст);
		СтруктураФайла.Вставить("ТегСтроки", 	ОписаниеСтруктурыФайла.Область(НомерСтроки, 2, НомерСтроки, 2).Текст);
		СтруктураФайла.Вставить("Заголовки", 	СтрРазделить(ОписаниеСтруктурыФайла.Область(НомерСтроки, 3, НомерСтроки, 3).Текст, ",", Ложь));
		СтруктураФайла.Вставить("Квартальная", 	ПолучитьБулевоИзСтруктурыФайла(ОписаниеСтруктурыФайла, НомерСтроки, 5));
		СтруктураФайла.Вставить("Годовая", 		ПолучитьБулевоИзСтруктурыФайла(ОписаниеСтруктурыФайла, НомерСтроки, 6));
		СтруктураФайла.Вставить("Код", 			ПолучитьБулевоИзСтруктурыФайла(ОписаниеСтруктурыФайла, НомерСтроки, 7));
		СтруктураФайла.Вставить("Раздел", 		ОписаниеСтруктурыФайла.Область(НомерСтроки, 8, НомерСтроки, 8).Текст);
		СтруктураФайла.Вставить("Заголовок", 	ОписаниеСтруктурыФайла.Область(НомерСтроки, 9, НомерСтроки, 9).Текст);
		
		ЭлементыСтруктуры.Добавить(СтруктураФайла);
	
	КонецЦикла; 
	
	Возврат ЭлементыСтруктуры;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьБулевоИзСтруктурыФайла(ОписаниеСтруктурыФайла, НомерСтроки, НомерКолонки)

	Значение = ОписаниеСтруктурыФайла.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст;
	Возврат ?(ЗначениеЗаполнено(Значение), Булево(Значение), Ложь);

КонецФункции 

&НаСервере
Функция ОбработанныйТегЭлемента(ТегЭлемента)
	
	Позиция20 = СтрНайти(ТегЭлемента, "_20");
	
	Возврат ?(Позиция20 > 0, Сред(ТегЭлемента, 1, Позиция20 - 1), ТегЭлемента);
	
КонецФункции	

&НаСервере
Процедура ПодготовитьДанныеВФорматеXMLНаСервере(АдресДанных, НомераРазделов = Неопределено)
	
	Запись = Новый ЗаписьXML;
	ПотокВПамяти = Новый ПотокВПамяти;
	Запись.ОткрытьПоток(ПотокВПамяти);
	
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("Отчет");

	Запись.ЗаписатьАтрибут("Код", ?(ЭтаФорма.Квартальная, "UKAnk_k", "UKAnk_y"));
	Если ЭтаФорма.ВерсияФайла = "2020" Тогда
		Запись.ЗаписатьАтрибут("version", "2.0");
		ФорматнаяСтрока = "ЧРД=.; ЧН=; ЧГ=0; ДФ=yyyy-MM-dd; БЛ=нет; БИ=да";
	ИначеЕсли ЭтаФорма.ВерсияФайла = "2021" 
		Или ЭтаФорма.ВерсияФайла = "2023" Тогда 
		Запись.ЗаписатьАтрибут("version", "2.1");
		ФорматнаяСтрока = "ЧРД=.; ЧН=; ЧГ=0; ДФ=yyyy-MM-dd; БЛ=нет; БИ=Да";
	ИначеЕсли ЭтаФорма.ВерсияФайла >= "2025" Тогда
		Запись.ЗаписатьАтрибут("version", "2.2");
		ФорматнаяСтрока = "ЧРД=.; ЧН=; ЧГ=0; ДФ=yyyy-MM-dd; БЛ=нет; БИ=Да";
	КонецЕсли; 
	Запись.ЗаписатьАтрибут("IsTemp", "true");
	
	// <Отчет GUID="{A3A23394-3565-4C54-A182-30A3CC372349}" Код="UKAnk_y" IsTemp="true">
	// как быть с ГУИД - хз, для квартальной Код="UKAnk_k", для годовой Код="UKAnk_y"
	// также добавить version="2.0"
	
	СтруктураФайла = ПолучитьСтруктуруФайла(ОписаниеСтруктурыФайла);
	
	Для каждого ЭлементСтруктуры Из СтруктураФайла Цикл
		
		Если ТипЗнч(НомераРазделов) = Тип("Массив") И НомераРазделов.Найти(ЭлементСтруктуры.Раздел) = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Запись.ЗаписатьНачалоЭлемента(ОбработанныйТегЭлемента(ЭлементСтруктуры.ТегЭлемента));
		
		Если ЭлементСтруктуры.ТегЭлемента = "Лицензии_УК" Тогда
			
			Запись.ЗаписатьНачалоЭлемента("Строка_Лицензия_Заголовок");
			Запись.ЗаписатьКонецЭлемента();
			
			Запись.ЗаписатьНачалоЭлемента("Строка_Лицензия_УК");
			Запись.ЗаписатьНачалоЭлемента("Номер_Лицензии_УК");
			Запись.ЗаписатьТекст(Формат(ЭтаФорма.Номер_Лицензии_УК, ФорматнаяСтрока));
			Запись.ЗаписатьКонецЭлемента();
			Запись.ЗаписатьКонецЭлемента();
			
			ВыгрузитьТаблицу(Запись, ЭлементСтруктуры, ЭтаФорма[ЭлементСтруктуры.ТегЭлемента], ФорматнаяСтрока);
			
		ИначеЕсли ЭлементСтруктуры.ТегЭлемента = "Таблица_Сотрудники" Тогда
			
			Запись.ЗаписатьНачалоЭлемента("Строка_Сотрудники_Заголовок");
			Запись.ЗаписатьКонецЭлемента();
			
			Для НомерПоказателя = 1 По 5 Цикл
			
				ИмяРеквизита = "Строка_Сотрудники_Показатель" + НомерПоказателя;
				
				Запись.ЗаписатьНачалоЭлемента(ИмяРеквизита);
				Запись.ЗаписатьНачалоЭлемента("Значение");
				Запись.ЗаписатьТекст(Формат(ЭтаФорма[ИмяРеквизита], ФорматнаяСтрока));
				Запись.ЗаписатьКонецЭлемента();
				Запись.ЗаписатьКонецЭлемента();
			
			КонецЦикла; 

		ИначеЕсли ЭлементСтруктуры.ТегЭлемента = "Таблица_Жалобы" Тогда
			
			Запись.ЗаписатьНачалоЭлемента("Строка_Жалобы_Заголовок");
			Запись.ЗаписатьКонецЭлемента();
			
			Для НомерПоказателя = 1 По 10 Цикл
			
				ИмяРеквизита = "Строка_Жалобы_Показатель" + НомерПоказателя;
				
				Запись.ЗаписатьНачалоЭлемента(ИмяРеквизита);
				Запись.ЗаписатьНачалоЭлемента("Значение");
				Запись.ЗаписатьТекст(Формат(ЭтаФорма[ИмяРеквизита], ФорматнаяСтрока));
				Запись.ЗаписатьКонецЭлемента();
				Запись.ЗаписатьКонецЭлемента();
			
			КонецЦикла; 
			
		ИначеЕсли ЭлементСтруктуры.ТегЭлемента = "Таблица_Собственные_Средства" Тогда
			
			Для НомерСтроки = 1 По 2 Цикл
				
				Запись.ЗаписатьНачалоЭлемента("Строка_СобСред" + ?(НомерСтроки = 1, "_Дата", ""));
				Для НомерКолонки = 1 По 3 Цикл
				
					ИмяРеквизита = "СобСред" + НомерСтроки + "_" + НомерКолонки;
					Запись.ЗаписатьНачалоЭлемента(ИмяРеквизита);
					Запись.ЗаписатьТекст(Формат(ЭтаФорма[ИмяРеквизита], ФорматнаяСтрока));
					Запись.ЗаписатьКонецЭлемента();
				
				КонецЦикла; 
				Запись.ЗаписатьКонецЭлемента();
			
			КонецЦикла; 
			
		Иначе
			
			Данные = ЭтаФорма[ЭлементСтруктуры.ТегЭлемента];
			
			Если ТипЗнч(Данные) = Тип("ДанныеФормыКоллекция") Тогда
				ВыгрузитьТаблицу(Запись, ЭлементСтруктуры, Данные, ФорматнаяСтрока);
			Иначе
				
				Если ЭлементСтруктуры.Код Тогда
					Запись.ЗаписатьНачалоЭлемента("Код");
				КонецЕсли; 
				
				Запись.ЗаписатьТекст(Формат(Данные, ФорматнаяСтрока));
				
				Если ЭлементСтруктуры.Код Тогда
					Запись.ЗаписатьКонецЭлемента();
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли; 
		
		Запись.ЗаписатьКонецЭлемента();
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	
	ПоместитьВоВременноеХранилище(ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные(), АдресДанных);
	
КонецПроцедуры

&НаСервере
Функция КолонкиСПрочеркомВместоНуля()
	
	КоллекцияКолонок = Новый Массив;
	КоллекцияКолонок.Добавить("Строка_Уп_ЗаблокированныеАктивыСтоимость");
	КоллекцияКолонок.Добавить("Строка_Уп_ПринРезидентыФиз");
	КоллекцияКолонок.Добавить("Строка_Уп_ПринНерезидентыФиз");
	КоллекцияКолонок.Добавить("Строка_Уп_ПринРезидентыЮр");
	КоллекцияКолонок.Добавить("Строка_Уп_ПринНерезидентыЮр");
	КоллекцияКолонок.Добавить("Строка_Уп_ПринПаевыеФонды");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_МинимальнаяСуммаВыдачи");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_ЗаблокированныеАктивыСтоимость");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_ПринРезидентыФиз");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_ПринНерезидентыФиз");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_ПринРезидентыЮр");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_ПринНерезидентыЮр");
	КоллекцияКолонок.Добавить("Строка_Уп_ЗИП_ПринПаевыеФонды");

	КоллекцияКолонок.Добавить("Строка_УпИИС_ДогИИС_ПИФ");
	КоллекцияКолонок.Добавить("Строка_УпИИС_ОбъемСредствИИС_ПИФ");
	КоллекцияКолонок.Добавить("Строка_УпИИС_КолЗакрДог_ПИФ");
