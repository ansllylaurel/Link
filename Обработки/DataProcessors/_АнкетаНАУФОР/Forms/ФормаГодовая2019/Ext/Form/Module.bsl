	Возврат КоллекцияКолонок;
	
КонецФункции

&НаСервере
Процедура ВыгрузитьТаблицу(Запись, ЭлементСтруктуры, Таблица, ФорматнаяСтрока)

	Для каждого ЗаголовокТаблицы Из ЭлементСтруктуры.Заголовки Цикл
		
		Запись.ЗаписатьНачалоЭлемента(ЗаголовокТаблицы);
		Запись.ЗаписатьКонецЭлемента();
	
	КонецЦикла; 
	
	КолонкиТаблицы = ЭтаФорма.ПолучитьРеквизиты(ЭлементСтруктуры.ТегЭлемента);
	
	Если ЭлементСтруктуры.ТегЭлемента = "Коллекция_Сотрудники" Тогда
		КолонкиКоллекцииОбразование = ЭтаФорма.ПолучитьРеквизиты("Коллекция_Сотрудники.Коллекция_Образование")
	КонецЕсли;
		
	Для каждого СтрокаТаблица Из Таблица Цикл
	
		Запись.ЗаписатьНачалоЭлемента(ЭлементСтруктуры.ТегСтроки);
		
		Для каждого Колонка Из КолонкиТаблицы Цикл
			
			Если Колонка.Имя = "СчетДоверительногоУправления" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЭтаФорма.Элементы[ЭлементСтруктуры.ТегЭлемента + Колонка.Имя].Видимость Тогда
				
				// Не выгружаем невидимые колонки кроме таблиц, где их выгружать надо
				Если Не СтрНайти("Строка_Уп_ИИС", ЭлементСтруктуры.ТегСтроки) > 0 Тогда
					
					Продолжить;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
			
			Запись.ЗаписатьНачалоЭлемента(Колонка.Имя);
			Значение = СтрокаТаблица[Колонка.Имя];
			
			Если Значение = 0 И КолонкиСПрочеркомВместоНуля().Найти(Колонка.Имя) <> Неопределено Тогда
				
				Значение = "-";
				
			КонецЕсли;
			
			Если Колонка.Имя = "Строка_Уп_ЗИП_ФондКвал" И Значение = Истина Тогда
				
				Значение = "квалифицированных";
				
			КонецЕсли;	
			
			Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Дата") Или ТипЗнч(Значение) = Тип("Булево") Тогда
				Значение = Формат(Значение, ФорматнаяСтрока);
			КонецЕсли; 
			
			Если Колонка.Имя = "Строка_Уп_НомерРегистрации" Или Колонка.Имя = "Строка_Уп_ЗИП_НомерРегистрации" Тогда
				Значение = СтрЗаменить(Значение, "-", "");
			КонецЕсли; 
			
			Если Колонка.Имя = "Коллекция_Образование" Тогда
				
				Для каждого СтрокаНайденныеСтроки Из Значение Цикл
					Запись.ЗаписатьНачалоЭлемента("Образование_1");
						Для каждого КолонкаОбразование Из КолонкиКоллекцииОбразование Цикл
								
							Запись.ЗаписатьНачалоЭлемента(КолонкаОбразование.Имя);
							Значение = СтрокаНайденныеСтроки[КолонкаОбразование.Имя];
							Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Дата") Или ТипЗнч(Значение) = Тип("Булево") Тогда
								Значение = Формат(Значение, ФорматнаяСтрока);
							КонецЕсли; 
							Запись.ЗаписатьТекст(Значение);
							Запись.ЗаписатьКонецЭлемента();
								
						КонецЦикла; 
					Запись.ЗаписатьКонецЭлемента();
				КонецЦикла; 
				
				Значение = "";
				
			КонецЕсли;
			
			Значение = Строка(Значение);
			Если ЗначениеЗаполнено(Значение) Тогда
				Запись.ЗаписатьТекст(Значение);
			КонецЕсли;
			Запись.ЗаписатьКонецЭлемента();
		
		КонецЦикла; 
			
		Запись.ЗаписатьКонецЭлемента();
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти 

#Область Сохранение_и_загрузка

&НаСервере
Функция ПоместитьСохраняемыеДанныеВоВременноеХранилищеНаСервере()
	
	СтруктураФайла = ПолучитьСтруктуруФайла(ЭтаФорма.ОписаниеСтруктурыФайла);
	
	СохраняемыеЗначения = Новый Структура("Период, Организация, Квартальная, Номер_Лицензии_УК, Таблица_Управление_ДУ_Расшифровка", 
		Объект.Период, 
		Объект.Организация, 
		ЭтаФорма.Квартальная,
		ЭтаФорма.Номер_Лицензии_УК,
		ЭтаФорма.Таблица_Управление_ДУ_Расшифровка);
	
	Для каждого ЭлементСтруктуры Из СтруктураФайла Цикл
		СохранятьЭлемент = ?(ЭтаФорма.Квартальная, ЭлементСтруктуры.Квартальная, ЭлементСтруктуры.Годовая);
		Если СохранятьЭлемент Тогда
			
			Если ЭлементСтруктуры.ТегЭлемента = "Таблица_Сотрудники" Тогда
				
				Для НомерПоказателя = 1 По 5 Цикл
			
					ИмяРеквизита = "Строка_Сотрудники_Показатель" + НомерПоказателя;
					СохраняемыеЗначения.Вставить(ИмяРеквизита, ЭтаФорма[ИмяРеквизита]);
				
				КонецЦикла;
				
			ИначеЕсли ЭлементСтруктуры.ТегЭлемента = "Таблица_Жалобы" Тогда
				
				Для НомерПоказателя = 1 По 10 Цикл
				
					ИмяРеквизита = "Строка_Жалобы_Показатель" + НомерПоказателя;
					СохраняемыеЗначения.Вставить(ИмяРеквизита, ЭтаФорма[ИмяРеквизита]);
				
				КонецЦикла; 
				
			ИначеЕсли ЭлементСтруктуры.ТегЭлемента = "Таблица_Собственные_Средства" Тогда
				
				Для НомерСтроки = 1 По 2 Цикл
				
					Для НомерКолонки = 1 По 3 Цикл
					
						ИмяРеквизита = "СобСред" + НомерСтроки + "_" + НомерКолонки;
						СохраняемыеЗначения.Вставить(ИмяРеквизита, ЭтаФорма[ИмяРеквизита]);
					
					КонецЦикла; 
									
				КонецЦикла;
				
			ИначеЕсли ЭлементСтруктуры.ТегЭлемента = "Коллекция_Сотрудники" Тогда
				
				Коллекция_Образование = Неопределено;
				ИндексСтроки = 0;
				Для каждого Строка Из ЭтаФорма.Коллекция_Сотрудники Цикл
				
					Если Коллекция_Образование = Неопределено Тогда
						Коллекция_Образование = Строка.Коллекция_Образование.Выгрузить();
						Коллекция_Образование.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
						Коллекция_Образование.ЗаполнитьЗначения(ИндексСтроки, "ИндексСтроки");
					Иначе
						Для каждого СтрокаОбразование Из Строка.Коллекция_Образование.Выгрузить() Цикл
							НоваяСтрокаОбразование = Коллекция_Образование.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаОбразование, СтрокаОбразование);
							НоваяСтрокаОбразование.ИндексСтроки = ИндексСтроки;
						КонецЦикла; 
					КонецЕсли; 
										
					ИндексСтроки = ИндексСтроки + 1;
				
				КонецЦикла; 
				
				СтруктураСотрудники = Новый Структура;
				СтруктураСотрудники.Вставить("Коллекция_Сотрудники", ЭтаФорма[ЭлементСтруктуры.ТегЭлемента].Выгрузить()); 
				СтруктураСотрудники.Вставить("Коллекция_Образование", Коллекция_Образование);
				
				СохраняемыеЗначения.Вставить("СтруктураСотрудники", СтруктураСотрудники);
				
			ИначеЕсли ЗначениеЗаполнено(ЭлементСтруктуры.ТегСтроки) Тогда 
				СохраняемыеЗначения.Вставить(ЭлементСтруктуры.ТегЭлемента, ЭтаФорма[ЭлементСтруктуры.ТегЭлемента].Выгрузить());
			Иначе
				СохраняемыеЗначения.Вставить(ЭлементСтруктуры.ТегЭлемента, ЭтаФорма[ЭлементСтруктуры.ТегЭлемента]);
			КонецЕсли; 
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(СохраняемыеЗначения, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ВосстановитьНаСервере(АдресЗначений)

	СохраненныеЗначения = ПолучитьИзВременногоХранилища(АдресЗначений);
	
	УдалитьИзВременногоХранилища(АдресЗначений);
	
	Если ТипЗнч(СохраненныеЗначения) <> Тип("Структура") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения сохраненных значений.");
		Возврат;
	КонецЕсли;
	
	Если Не СохраненныеЗначения.Свойство("Номер_Лицензии_УК") Тогда
		ЭтаФорма.Номер_Лицензии_УК = "";
	КонецЕсли; 
	
	Если Не СохраненныеЗначения.Свойство("Таблица_Управление_ДУ_Расшифровка") Тогда
		ЭтаФорма.Таблица_Управление_ДУ_Расшифровка.Очистить();	
	КонецЕсли; 
	
	РеквизитыОбъекта = СтрРазделить("Период,Организация", ",");
	РеквизитыФормы = СтрРазделить("Квартальная,Номер_Лицензии_УК,Таблица_Управление_ДУ_Расшифровка", ",");
	
	Для каждого СохраненноеЗначение Из СохраненныеЗначения Цикл
	
		Если РеквизитыОбъекта.Найти(СохраненноеЗначение.Ключ) <> Неопределено Тогда
			Объект[СохраненноеЗначение.Ключ] = СохраненноеЗначение.Значение;
		ИначеЕсли РеквизитыФормы.Найти(СохраненноеЗначение.Ключ) <> Неопределено Тогда
			ЭтаФорма[СохраненноеЗначение.Ключ] = СохраненноеЗначение.Значение;
		ИначеЕсли ТипЗнч(СохраненноеЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
			ЭтаФорма[СохраненноеЗначение.Ключ].Загрузить(СохраненноеЗначение.Значение);
		ИначеЕсли СохраненноеЗначение.Ключ = "СтруктураСотрудники" Тогда
			
			СтруктураСотрудники = СохраненноеЗначение.Значение;
			Коллекция_Образование = СтруктураСотрудники.Коллекция_Образование;
			
			ЭтаФорма.Коллекция_Сотрудники.Очистить();
			
			Для каждого СтрокаСотрудники Из СтруктураСотрудники.Коллекция_Сотрудники Цикл
			
				НоваяСтрокаСотрудники = ЭтаФорма.Коллекция_Сотрудники.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСотрудники, СтрокаСотрудники);
				
				СтрокиОбразование = Коллекция_Образование.НайтиСтроки(Новый Структура("ИндексСтроки", СтруктураСотрудники.Коллекция_Сотрудники.Индекс(СтрокаСотрудники)));
				
				Для каждого СтрокаОбразование Из СтрокиОбразование Цикл
				
					ЗаполнитьЗначенияСвойств(НоваяСтрокаСотрудники.Коллекция_Образование.Добавить(), СтрокаОбразование);
				
				КонецЦикла; 
			
			КонецЦикла; 
			
		Иначе
			ЭтаФорма[СохраненноеЗначение.Ключ] = СохраненноеЗначение.Значение;
		КонецЕсли; 
	
	КонецЦикла;  
	
КонецПроцедуры

#КонецОбласти 

&НаСервереБезКонтекста 
Функция ПолучитьДанныеПоСчетуДУ(Организация, Период, ИмяТаблицы, ВерсияФайла)

	МенеджерВременныхТаблиц = ПодготовитьДанныеРаздел5(Организация, Период, ВерсияФайла);
	ВременнаяТаблица = МенеджерВременныхТаблиц.Таблицы.Найти(ИмяТаблицы);
	
	Если ВременнаяТаблица <> Неопределено Тогда
		
		РезультатЗапроса = ВременнаяТаблица.ПолучитьДанные();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Данные = Новый Структура; 
			Для каждого Колонка Из РезультатЗапроса.Колонки Цикл
				Данные.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);			
			КонецЦикла; 
			
			Возврат Данные;
		
		КонецЕсли; 
		
	КонецЕсли; 

КонецФункции

&НаКлиентеНаСервереБезКонтекста 
Процедура ОбновитьИтоги(ЭтаФорма, ИмяТаблицы = "")

	МассивТаблиц = Новый Массив;
		
	Если ИмяТаблицы = "" Тогда
		МассивТаблиц.Добавить("Таблица_Управление");
		МассивТаблиц.Добавить("Таблица_Управление_ЗИП");
		МассивТаблиц.Добавить("Таблица_Управление_СтраховыеКомпании");
		МассивТаблиц.Добавить("Таблица_Управление_ДУПР");
		МассивТаблиц.Добавить("Таблица_Управление_ДУПН");
		МассивТаблиц.Добавить("Таблица_Управление_ДУКФ");
		МассивТаблиц.Добавить("Таблица_Управление_ДУ");
	Иначе
		МассивТаблиц.Добавить(ИмяТаблицы);
	КонецЕсли; 
	
	Для каждого ТекТаблица Из МассивТаблиц Цикл
	
		Если ТекТаблица = "Таблица_Управление" Тогда
			ЭтаФорма.ИтогоОПИФ = ЭтаФорма.Таблица_Управление.Итог("Строка_Уп_СЧА");
		ИначеЕсли ТекТаблица = "Таблица_Управление_ЗИП" Тогда
			ЭтаФорма.ИтогоЗПИФ = ЭтаФорма.Таблица_Управление_ЗИП.Итог("Строка_Уп_ЗИП_СЧА");
		ИначеЕсли ТекТаблица = "Таблица_Управление_СтраховыеКомпании" Тогда
			ЭтаФорма.ИтогоСтраховые = ЭтаФорма.Таблица_Управление_СтраховыеКомпании.Итог("Строка_Уп_СтраховКомп_Средства");
		ИначеЕсли ТекТаблица = "Таблица_Управление_ДУПР" Тогда
			ЭтаФорма.ИтогоПР = ЭтаФорма.Таблица_Управление_ДУПР.Итог("Строка_УпДУПР_СЧА");
		ИначеЕсли ТекТаблица = "Таблица_Управление_ДУПН" Тогда
			ЭтаФорма.ИтогоПН = ЭтаФорма.Таблица_Управление_ДУПН.Итог("Строка_УпДУПН_СЧА");
		ИначеЕсли ТекТаблица = "Таблица_Управление_ДУКФ" Тогда
			ЭтаФорма.ИтогоСРО = ЭтаФорма.Таблица_Управление_ДУКФ.Итог("Строка_УпДУКФ_СЧА");
		ИначеЕсли ТекТаблица = "Таблица_Управление_ДУ" Тогда
			ЭтаФорма.ИтогоДУ = ЭтаФорма.Таблица_Управление_ДУ.Итог("Строка_УпДУ_ДогДУОбъем") + ЭтаФорма.Таблица_Управление_ДУ.Итог("Строка_УпДУ_ДогИИСОбъем");
			ТекСтрока = ЭтаФорма.Элементы[ТекТаблица].ТекущиеДанные;
			Если ТекСтрока <> Неопределено Тогда
				ТекСтрока.Строка_УпДУ_ДогДУ = ТекСтрока.Строка_УпДУ_КлиентыДУ_ФизРезид + ТекСтрока.Строка_УпДУ_КлиентыДУ_ФизНеРезид + ТекСтрока.Строка_УпДУ_КлиентыДУ_ЮрРезид + ТекСтрока.Строка_УпДУ_КлиентыДУ_ЮрНеРезид;
			КонецЕсли; 
		КонецЕсли; 
		
	КонецЦикла; 
	
	ЭтаФорма.Общая_СЧА = ЭтаФорма.ИтогоОПИФ + ЭтаФорма.ИтогоЗПИФ + ЭтаФорма.ИтогоСтраховые + ЭтаФорма.ИтогоПР + ЭтаФорма.ИтогоПН + ЭтаФорма.ИтогоСРО + ЭтаФорма.ИтогоДУ;

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицыФормы(Реквизиты, МенеджерВременныхТаблиц)

	Для каждого ВременнаяТаблица Из МенеджерВременныхТаблиц.Таблицы Цикл
	
		Если ВременнаяТаблица.ПолноеИмя = "Коллекция_Сотрудники" Тогда
			
			ЭтаФорма.Коллекция_Сотрудники.Очистить();
			
			ТаблицаОбразование = МенеджерВременныхТаблиц.Таблицы.Найти("Коллекция_Образование").ПолучитьДанные().Выгрузить();
			ТаблицаОбразование.Сортировать("НомерПоПорядку");
			
			ТаблицаКоллекция_Сотрудники = ВременнаяТаблица.ПолучитьДанные().Выгрузить();
			ТаблицаКоллекция_Сотрудники.Сортировать("ФИО, СоветДиректоров Убыв");
			
			ДвеДолжности = ТаблицаКоллекция_Сотрудники.Скопировать(, "Коллекция_Образование");
			ДвеДолжности.Колонки.Добавить("Счетчик", Новый ОписаниеТипов("Число"));
			ДвеДолжности.ЗаполнитьЗначения(1, "Счетчик");
			ДвеДолжности.Свернуть("Коллекция_Образование", "Счетчик");
			СоставляющиеДопИнформации = Новый Массив;
			
			
			ТекСотрудник = Неопределено;
			
			Для каждого СтрокаТаблицаКоллекция_Сотрудники Из ТаблицаКоллекция_Сотрудники Цикл
			
				Если ТекСотрудник <> СтрокаТаблицаКоллекция_Сотрудники.Коллекция_Образование Тогда
					
					ТекСотрудник = СтрокаТаблицаКоллекция_Сотрудники.Коллекция_Образование;
					
					ТаблицаПоФизику = ТаблицаОбразование.Скопировать(Новый Структура("ЮрФизЛицо", СтрокаТаблицаКоллекция_Сотрудники.Коллекция_Образование), "Образование, Направление_подготовки, Специальность");
								
					НоваяСтрока = ЭтаФорма.Коллекция_Сотрудники.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицаКоллекция_Сотрудники, , "Коллекция_Образование");
					НоваяСтрока.Коллекция_Образование.Загрузить(ТаблицаПоФизику);
					
					СоветДиректоров = СтрокаТаблицаКоллекция_Сотрудники.СоветДиректоров;
					
					Если ДвеДолжности.НайтиСтроки(Новый Структура("Коллекция_Образование, Счетчик",
						СтрокаТаблицаКоллекция_Сотрудники.Коллекция_Образование, 2)).Количество() Тогда

						СоставляющиеДопИнформации.Добавить(СтрШаблон("%1 является %2 с %3", СтрокаТаблицаКоллекция_Сотрудники.ФИО, 
							ПолучитьСклоненияСтроки(СтрокаТаблицаКоллекция_Сотрудники.Должность, , "ПД=Творительный")[0], 
							Формат(СтрокаТаблицаКоллекция_Сотрудники.Назначение_на_должность, "ДФ=dd.MM.yyyy")));
							
					КонецЕсли;		
				
				Иначе
					
					НоваяСтрока.Должность = НоваяСтрока.Должность + ", " + СтрокаТаблицаКоллекция_Сотрудники.Должность;
					
					Если СоветДиректоров И Не СтрокаТаблицаКоллекция_Сотрудники.СоветДиректоров Тогда
						НоваяСтрока.Назначение_на_должность = Мин(НоваяСтрока.Назначение_на_должность, СтрокаТаблицаКоллекция_Сотрудники.Назначение_на_должность);
					ИначеЕсли Не СтрокаТаблицаКоллекция_Сотрудники.СоветДиректоров Тогда 
						НоваяСтрока.Назначение_на_должность = СтрокаТаблицаКоллекция_Сотрудники.Назначение_на_должность;
					КонецЕсли; 

					Если ДвеДолжности.НайтиСтроки(Новый Структура("Коллекция_Образование, Счетчик",
						СтрокаТаблицаКоллекция_Сотрудники.Коллекция_Образование, 2)).Количество() Тогда

						СоставляющиеДопИнформации.Добавить(СтрШаблон("%1 является %2 с %3", СтрокаТаблицаКоллекция_Сотрудники.ФИО, 
							ПолучитьСклоненияСтроки(СтрокаТаблицаКоллекция_Сотрудники.Должность, , "ПД=Творительный")[0], 
							Формат(СтрокаТаблицаКоллекция_Сотрудники.Назначение_на_должность, "ДФ=dd.MM.yyyy")));
							
					КонецЕсли;		
					
				КонецЕсли; 								
			
			КонецЦикла; 			
			
			ЭтаФорма.Дополнительная_информация = СтрСоединить(СоставляющиеДопИнформации, Символы.ПС);
			
		ИначеЕсли ВременнаяТаблица.ПолноеИмя = "Коллекция_Образование" Тогда
			Продолжить;
			
		ИначеЕсли ВременнаяТаблица.ПолноеИмя = "_ВладельцыПаев"	 Тогда
			РезультатЗапроса = ВременнаяТаблица.ПолучитьДанные().Выгрузить();	
			Если РезультатЗапроса.Количество() Тогда
				
				ЭтаФорма.КолУникВлад = РезультатЗапроса[0].КоличествоВладельцевПаев;
				
			КонецЕсли;
			
		Иначе
			
			Для каждого ТекРеквизит Из Реквизиты Цикл
				Если ТекРеквизит.Имя = ВременнаяТаблица.ПолноеИмя Тогда
					
					Если СтрНайти("Таблица_Управление_ДУ, Таблица_Управление_ДУ_2025, Таблица_Управление_ИИС", ВременнаяТаблица.ПолноеИмя) > 0 Тогда
						РезультатЗапроса = ВременнаяТаблица.ПолучитьДанные().Выгрузить();
					ИначеЕсли ВременнаяТаблица.ПолноеИмя = "Таблица_Контрагенты_СД"
						Или ВременнаяТаблица.ПолноеИмя = "Таблица_Контрагенты_Рег" 
						Или ВременнаяТаблица.ПолноеИмя = "Таблица_Контрагенты_Оценщики" 
						Или ВременнаяТаблица.ПолноеИмя = "Таблица_Контрагенты_Агент" Тогда 	
						РезультатЗапроса = ВременнаяТаблица.ПолучитьДанные().Выгрузить();
						РезультатЗапроса.Сортировать("СчетДоверительногоУправления");
						РезультатЗапроса.Колонки.Добавить("Срок_действия", Новый ОписаниеТипов("Строка"));
						Для каждого Строка Из РезультатЗапроса Цикл
							Строка.Срок_действия = Формат(Строка.ДатаЗаключения, "ДФ=dd.MM.yyyy") + " - " + Формат(Строка.ДатаРасторжения, "ДФ=dd.MM.yyyy");
						КонецЦикла; 
					Иначе
						Запрос = Новый Запрос;
						Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
						ТекстЗапроса = 
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	*
							|ИЗ
							|	ИмяТаблицы КАК ИмяТаблицы
							|
							|УПОРЯДОЧИТЬ ПО
							|	ИмяТаблицы.СчетДоверительногоУправления
							|АВТОУПОРЯДОЧИВАНИЕ";
						Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ИмяТаблицы", ВременнаяТаблица.ПолноеИмя);
						РезультатЗапроса = Запрос.Выполнить().Выгрузить();
					КонецЕсли; 
					ЭтаФорма[ТекРеквизит.Имя].Загрузить(РезультатЗапроса);
				КонецЕсли; 
			КонецЦикла;
			
		КонецЕсли; 
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтчетВФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Диалог = ДополнительныеПараметры.Диалог;
	Если (ВыбранныеФайлы <> Неопределено) Тогда 
		ДополнительныеПараметры.ДвоичныеДанные.Записать(Диалог.ПолноеИмяФайла);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьЭлементов(Форма)
	
	// Элементы, видимые только если они есть в структуре файла
	ОсобыеЭлементы = Новый Массив;
	ОсобыеЭлементы.Добавить(Форма.Элементы.Таблица_Управление_ДУ);
	ОсобыеЭлементы.Добавить(Форма.Элементы.Таблица_Управление_ДУ_2025);
	ОсобыеЭлементы.Добавить(Форма.Элементы.Таблица_Управление_ИИС);
	ОсобыеЭлементы.Добавить(Форма.Элементы.Таблица_Контрагенты_Оценщики);
	ОсобыеЭлементы.Добавить(Форма.Элементы.Таблица_Контрагенты_Оценщики_2026);
	ОсобыеЭлементы.Добавить(Форма.Элементы.Таблица_Жалобы);
	
	ОбработанныеЭлементы = Новый Массив;
	
	СтруктураФайла = ПолучитьСтруктуруФайла(Форма.ОписаниеСтруктурыФайла);
	
	Для каждого ЭлементСтруктуры Из СтруктураФайла Цикл
		Элемент = Форма.Элементы.Найти(ЭлементСтруктуры.ТегЭлемента);
		Если Элемент <> Неопределено Тогда
			Элемент.Видимость = ?(Форма.Квартальная, ЭлементСтруктуры.Квартальная, ЭлементСтруктуры.Годовая);
			ОбработанныеЭлементы.Добавить(Элемент);
		КонецЕсли; 
	КонецЦикла; 	
	Для Каждого Элемент Из Форма.Элементы Цикл
		
		Если (ТипЗнч(Элемент) = Тип("ТаблицаФормы") Или ТипЗнч(Элемент) = Тип("ГруппаФормы")) И ОбработанныеЭлементы.Найти(Элемент) = Неопределено И ОсобыеЭлементы.Найти(Элемент) <> Неопределено Тогда
			
			Элемент.Видимость = Ложь;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Элементы = Форма.Элементы;
	Элементы.Таблица_УправлениеСтрока_Уп_ПаиСтоимостьОкончанияФормир.Видимость         = Форма.ВерсияФайла < "2025";
	Элементы.Таблица_Управление_ЗИПСтрока_Уп_ЗИП_ПаиСтоимостьОкончанияФормир.Видимость = Форма.ВерсияФайла < "2025";	
	Элементы.Таблица_Управление_ЗИПСтрока_Уп_ЗИП_Инвесторы.Видимость                   = Форма.ВерсияФайла < "2025";
    // Доработки 2026
	Элементы.Строка_Сотрудники_Показатель5.Видимость                                     = Форма.ВерсияФайла < "2026";
	Элементы.Таблица_УправлениеСтрока_Уп_МинимальнаяСуммаПервойПокупки.Видимость         = Форма.ВерсияФайла < "2026";
 	Элементы.Таблица_УправлениеСтрока_Уп_МинимальнаяСуммаДляПайщиков.Видимость           = Форма.ВерсияФайла < "2026";
 	Элементы.Таблица_Управление_ЗИПСтрока_Уп_ЗИП_МинимальнаяСуммаВыдачи.Видимость        = Форма.ВерсияФайла < "2026";
 	Элементы.Таблица_Управление_ЗИПСтрока_Уп_ЗИП_МинимальнаяСуммаПервойПокупки.Видимость = Форма.ВерсияФайла < "2026";
 	Элементы.Таблица_Управление_ЗИПСтрока_Уп_ЗИП_МинимальнаяСуммаДляПайщиков.Видимость   = Форма.ВерсияФайла < "2026";

	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВерсиюФайла(ЭтаФорма)

	Если ЭтаФорма.Объект.Период.ДатаОкончания < '20211231' Тогда
		ЭтаФорма.ВерсияФайла = "2020";
	ИначеЕсли ЭтаФорма.Объект.Период.ДатаОкончания >= '20251231' Тогда
		ЭтаФорма.ВерсияФайла = "2026";
	ИначеЕсли ЭтаФорма.Объект.Период.ДатаОкончания >= '20250331' Тогда
		ЭтаФорма.ВерсияФайла = "2025";
	ИначеЕсли ЭтаФорма.Объект.Период.ДатаОкончания >= '20230930' Тогда
		ЭтаФорма.ВерсияФайла = "2023";
	ИначеЕсли ЭтаФорма.Объект.Период.ДатаОкончания >= '20211231' Тогда
		ЭтаФорма.ВерсияФайла = "2021";
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьОписаниеСтруктурыФайла()

	ОбработкаНаСервере = РеквизитФормыВЗначение("Объект");
	ЭтаФорма.ОписаниеСтруктурыФайла = ОбработкаНаСервере.ПолучитьМакет("СтруктураФайла" + ЭтаФорма.ВерсияФайла);

КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста 
Функция ЖалобыИОбращения(ЭтаФорма)

	Если ЭтаФорма.ВерсияФайла >= "2025" Тогда
		
		ЖалобыИОбращения = Новый Массив;
		ЖалобыИОбращения.Добавить(ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.Жалоба"));
		ЖалобыИОбращения.Добавить(ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.ЖалобаИногоЛица"));
		
	Иначе	
		
		ЖалобыИОбращения = Новый Массив;
		ЖалобыИОбращения.Добавить(ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.Жалоба"));
		ЖалобыИОбращения.Добавить(ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.ОбращениеКлиента"));
		ЖалобыИОбращения.Добавить(ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.ОбращениеПотенциальногоКлиента"));
		ЖалобыИОбращения.Добавить(ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.ОбращениеИное"));
		
	КонецЕсли;
	Возврат ЖалобыИОбращения;

КонецФункции

