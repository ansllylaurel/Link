&НаКлиенте
Процедура ВывестиРасшифровкуПоказателяКвалификации(Элемент)

	ТабДок = РасшифровкаПоказателяКвалификации(Элемент.Имя);
	ТабДок.Показать(ПредставлениеПоказателяКвалификацииПоИмениЭлемента(Элемент.Имя));

КонецПроцедуры

&НаСервере
Функция РасшифровкаПоказателяКвалификации(ИмяПоказателя)

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ОтображатьСетку     = Ложь;
	ТабДок.ТолькоПросмотр      = Истина;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	МакетРасшифровки = ОбъектНаСервере.ПолучитьМакет("Расшифровка");
	ОбластьШапка = МакетРасшифровки.ПолучитьОбласть("Шапка4");
	ТабДок.Вывести(ОбластьШапка);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",  Объект.Организация);
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(Объект.Период.ДатаОкончания));
	Запрос.Текст = ЗапросРасшифровкиПоказателяКвалификации(ИмяПоказателя);
	
	//Результат = Запрос.Выполнить().Выгрузить();
	//
	//Возврат Новый ТабличныйДокумент;
	
	Номер = 0;
	
	ВыборкаСотрудники = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСотрудники.Следующий() Цикл
		
		НачальнаяСтрокаОбласти = ТабДок.ВысотаТаблицы + 1;
		
		Номер = Номер + 1;
		СтрокаВыведена = Ложь;
		Выборка = ВыборкаСотрудники.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОбластьСтрока = МакетРасшифровки.ПолучитьОбласть("Строка4");
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			ОбластьСтрока.Параметры.Номер = Номер;
			
			ТабДок.Вывести(ОбластьСтрока);
			Если Не СтрокаВыведена Тогда

				ТабДок.НачатьГруппуСтрок();
				СтрокаВыведена = Истина;
				
			КонецЕсли;	
			
		КонецЦикла;
		ТабДок.Область(НачальнаяСтрокаОбласти, 1, ТабДок.ВысотаТаблицы, 1).Объединить();
		ТабДок.Область(НачальнаяСтрокаОбласти, 2, ТабДок.ВысотаТаблицы, 2).Объединить();
		ТабДок.ЗакончитьГруппуСтрок();
		
	КонецЦикла;	
	
	ТабДок.ПоказатьУровеньГруппировокСтрок(0);
	Возврат ТабДок;	
	
КонецФункции

&НаСервере
Функция ЗапросРасшифровкиПоказателяКвалификации(ИмяПоказателя)

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	СотрудникиОрганизацииСрезПоследних.Сотрудник.ЮрФизЛицо КАК ЮрФизЛицо
	               |ПОМЕСТИТЬ _РаботающиеФизЛица
	               |ИЗ
	               |	РегистрСведений.СотрудникиОрганизации.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СостояниеСотрудниковОрганизацийСрезПоследних
	               |		ПО СотрудникиОрганизацииСрезПоследних.Сотрудник = СостояниеСотрудниковОрганизацийСрезПоследних.Сотрудник
	               |ГДЕ
	               |	СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
	               |	И ЕСТЬNULL(СостояниеСотрудниковОрганизацийСрезПоследних.Состояние, """") <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.ОтпускПоБеременностиИРодам)
	               |	И ЕСТЬNULL(СостояниеСотрудниковОрганизацийСрезПоследних.Состояние, """") <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.ОтпускПоУходуЗаРебенком)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	_РаботающиеФизЛица.ЮрФизЛицо.Наименование КАК ФИО,
	               |	СведенияОКвалификацииФизическихЛиц.ЮрФизЛицо КАК Сотрудник,
	               |	СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ВидДокумента КАК ВидДокумента,
	               |	СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ТипКвалификационногоАттестата КАК ТипАттестата
	               |ИЗ
	               |	РегистрСведений.СведенияОКвалификацииФизическихЛиц КАК СведенияОКвалификацииФизическихЛиц
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РаботающиеФизЛица КАК _РаботающиеФизЛица
	               |		ПО СведенияОКвалификацииФизическихЛиц.ЮрФизЛицо = _РаботающиеФизЛица.ЮрФизЛицо
	               |ГДЕ
	               |	СведенияОКвалификацииФизическихЛиц.Организация = &Организация
	               |	И СведенияОКвалификацииФизическихЛиц.ДатаПолученияСведений <= &КонецПериода
	               |	И (СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ДатаОкончанияДействия > &КонецПериода
	               |			ИЛИ СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
	               |	И &Отбор
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	_РаботающиеФизЛица.ЮрФизЛицо.Наименование,
	               |	СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ТипКвалификационногоАттестата.Порядок
	               |ИТОГИ ПО
	               |	Сотрудник";
	
	ТекстОтбораПоказатель3 = "СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.КвалификационныйАттестат), 
		|ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.Свидетельство))";
	
	ТекстОтбораПоказатель4 = "СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.КвалификационныйАттестат) 
		|И СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ТипКвалификационногоАттестата В (ЗНАЧЕНИЕ(Перечисление.ТипыКвалификационныхАттестатов.ПятогоТипа), 
		|ЗНАЧЕНИЕ(Перечисление.ТипыКвалификационныхАттестатов.ПятогоТипаПервогоТипаДУ))";
	
	Если ИмяПоказателя = "Строка_Сотрудники_Показатель3" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор", ТекстОтбораПоказатель3);
		
	Иначе	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор", ТекстОтбораПоказатель4);
		
	КонецЕсли;	
	Возврат ТекстЗапроса;	
	
КонецФункции	

&НаКлиенте
Функция ПредставлениеПоказателяКвалификацииПоИмениЭлемента(ИмяПоказателя)
	
	Заголовок = "";
	Если ИмяПоказателя = "Строка_Сотрудники_Показатель3" Тогда
		
		Заголовок = "Количество сотрудников компании, имеющих квалификационный аттестат или свидетельство о квалификации";
		
	ИначеЕсли ИмяПоказателя = "Строка_Сотрудники_Показатель4" Тогда

		Заголовок = "Количество сотрудников компании, имеющих квалификационный аттестат 5-го типа";
		
	Иначе
		
		ВызватьИсключение СтрШаблон("Передан неизвестный показатель квалификации %1", ИмяПоказателя);
		
	КонецЕсли;	
		
	Возврат Заголовок;
	
КонецФункции	

#Область Команды_формы

&НаКлиенте
Процедура КомандаЗаполнить(Команда)
	
	ЗаполнитьНаСервере();
	ОбновитьИтоги(ЭтаФорма);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузить(Команда)
	
	АдресДанных = ПоместитьВоВременноеХранилище(, ЭтаФорма.УникальныйИдентификатор);
	ПодготовитьДанныеВФорматеXMLНаСервере(АдресДанных);
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресДанных);
	Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
		
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Диалог.Фильтр				= "Файл XML (*.xml)|*.xml";
		Диалог.МножественныйВыбор 	= Ложь; 
		Диалог.Заголовок          	= "Введите имя файла"; 
		
		Диалог.Показать(Новый ОписаниеОповещения("ЗаписатьОтчетВФайлЗавершение", ЭтаФорма, Новый Структура("Диалог, ДвоичныеДанные", Диалог, ДвоичныеДанные)));
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыгрузитьРазделы(Команда)
	
	СтруктураФайла = ПолучитьСтруктуруФайла(ОписаниеСтруктурыФайла);
	
	ПараметрыФормы = Новый Структура("СтруктураФайла, Квартальная", 
		СтруктураФайла, 
		ЭтаФорма.Квартальная);
		
	ВыбранныеРазделы = ОткрытьФормуМодально("ВнешняяОбработка._АнкетаНАУФОР.Форма.ФормаНастройкиВыгрузки", ПараметрыФормы);
	
	Если ТипЗнч(ВыбранныеРазделы) = Тип("Массив") Тогда
	
		АдресДанных = ПоместитьВоВременноеХранилище(, ЭтаФорма.УникальныйИдентификатор);
		ПодготовитьДанныеВФорматеXMLНаСервере(АдресДанных, ВыбранныеРазделы);
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресДанных);
		Если ТипЗнч(ДвоичныеДанные) = Тип("ДвоичныеДанные") Тогда
			
			Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			Диалог.Фильтр				= "Файл XML (*.xml)|*.xml";
			Диалог.МножественныйВыбор 	= Ложь; 
			Диалог.Заголовок          	= "Введите имя файла"; 
			
			Диалог.Показать(Новый ОписаниеОповещения("ЗаписатьОтчетВФайлЗавершение", ЭтаФорма, Новый Структура("Диалог, ДвоичныеДанные", Диалог, ДвоичныеДанные)));
			
		КонецЕсли;		
	
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранить(Команда)

	АдресСохраняемыхДанных = ПоместитьСохраняемыеДанныеВоВременноеХранилищеНаСервере();
	
	ВыборНастроек = РаботаСФормамиКлиент.СохранитьНастройкиИзВременногоХранилищаВХранилищеВариантовИНастроекОтчетов("ВнешняяОбработка._АнкетаНАУФОР.2020", ЭтаФорма.КлючТекущихНастроек, АдресСохраняемыхДанных);
	
	Если ТипЗнч(ВыборНастроек) = Тип("ВыборНастроек") Тогда
		ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВосстановить(Команда)
	
	Если ЭтаФорма.Модифицированность И (Вопрос("Изменения не сохранены. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет) Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеНастроек = РаботаСФормамиКлиент.ПоместитьНастройкиИзХранилищаВариантовИНастроекОтчетовВоВременноеХранилище("ВнешняяОбработка._АнкетаНАУФОР.2020", ЭтаФорма.КлючТекущихНастроек, ЭтаФорма.УникальныйИдентификатор);
	
	Если ОписаниеНастроек <> Неопределено Тогда
		
		ВосстановитьНаСервере(ОписаниеНастроек.АдресНастроекВоВременномХранилище);
		
		ЭтаФорма.Модифицированность = Ложь;
		
		ОбновитьВидимостьЭлементов(ЭтаФорма);
		ОбновитьИтоги(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Заполнение_отчета

&НаСервереБезКонтекста
Функция ПолучитьТаблицуКлиентов(Организация, Период, СчетДоверительногоУправления = Неопределено)

	Запрос = Новый Запрос;
	
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Период.ДатаОкончания);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", Организация.ВалютаУчета);
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", ПоследнийРабочийДень);
	Запрос.УстановитьПараметр("ПоследнийРабочийДеньГраница", Новый Граница(КонецДня(ПоследнийРабочийДень), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	
	#Область Текст_запроса_актуальные_счета_ДУ
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	СчетаДоверительногоУправления.СпециализированныйДепозитарий КАК СпециализированныйДепозитарий,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.КодСчета КАК КодСчета
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецПериода, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И (&СчетДоверительногоУправления = НЕОПРЕДЕЛЕНО
		|			ИЛИ СчетаДоверительногоУправления.Ссылка В (&СчетДоверительногоУправления))
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &КонецПериода)
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &КонецПериода
		|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК Период
		|ПОМЕСТИТЬ _ДатаПервойОперации
		|ИЗ
		|	_СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.СчетДоверительногоУправления,
		|	МИНИМУМ(ВложенныйЗапрос.Период)
		|ИЗ
		|	(ВЫБРАТЬ
		|		ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		ОстаткиДенежныхСредств.Период КАК Период
		|	ИЗ
		|		РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО ОстаткиДенежныхСредств.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|				И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|	ГДЕ
		|		ОстаткиДенежныхСредств.Активность
		|		И ОстаткиДенежныхСредств.Период <= КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ОстаткиЦенныхБумаг.СчетДоверительногоУправления,
		|		ОстаткиЦенныхБумаг.Период
		|	ИЗ
		|		РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ПО ОстаткиЦенныхБумаг.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		|				И (СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет))
		|	ГДЕ
		|		ОстаткиЦенныхБумаг.Активность
		|		И ОстаткиЦенныхБумаг.Период <= КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	_СчетаДоверительногоУправления.Организация КАК Организация,
		|	_СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	_СчетаДоверительногоУправления.СпециализированныйДепозитарий КАК СпециализированныйДепозитарий,
		|	_ДатаПервойОперации.Период КАК ДатаЗаключения,
		|	_СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	_СчетаДоверительногоУправления.Клиент КАК Клиент,
		|	_СчетаДоверительногоУправления.КодСчета КАК КодСчета
		|ПОМЕСТИТЬ _АктуальныеСчетаДоверительногоУправления
		|ИЗ
		|	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатаПервойОперации КАК _ДатаПервойОперации
		|		ПО _СчетаДоверительногоУправления.Ссылка = _ДатаПервойОперации.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СтатусыЛицензийСрезПоследних.Лицензия КАК Лицензия,
		|	Лицензии.ЮрФизЛицо КАК Клиент,
		|	Лицензии.Номер КАК Номер
		|ПОМЕСТИТЬ _Лицензии
		|ИЗ
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних(, ) КАК СтатусыЛицензийСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _АктуальныеСчетаДоверительногоУправления КАК _АктуальныеСчетаДоверительногоУправления
		|			ПО Лицензии.ЮрФизЛицо = _АктуальныеСчетаДоверительногоУправления.Клиент
		|		ПО СтатусыЛицензийСрезПоследних.Лицензия = Лицензии.Ссылка
		|			И (Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоПенсионномуСтрахованию))
		|ГДЕ
		|	СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СчетаДоверительногоУправления";
	#КонецОбласти 
	
	Запрос.Выполнить();
	
	Если ПоследнийРабочийДень = НачалоДня(Период.ДатаОкончания) Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_АктуальныеСчетаДоверительногоУправления.Организация КАК Организация,
			|	_АктуальныеСчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	&КонецПериода КАК Дата
			|ПОМЕСТИТЬ _ДатыРасчетаСЧА
			|ИЗ
			|	_АктуальныеСчетаДоверительногоУправления КАК _АктуальныеСчетаДоверительногоУправления";
		Запрос.Выполнить();
	Иначе
		ПоместитьТаблицуДатРасчетаСЧАВМенеджерВременныхТаблиц(Запрос);
	КонецЕсли; 
	
	#Область Текст_запроса_счета_ДУ
	
	Запрос.Текст = 
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	ВложенныйЗапрос.Организация КАК Организация,
	    |	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |	ВложенныйЗапрос.Дата КАК Дата,
	    |	МАКСИМУМ(ЕСТЬNULL(ЛицензииДУ.Действует, ЛОЖЬ)) КАК ДействуетЛицензияДУ,
	    |	МАКСИМУМ(ЕСТЬNULL(ЛицензииПИФНПФ.Действует, ЛОЖЬ)) КАК ДействуетЛицензияПИФНПФ
	    |ПОМЕСТИТЬ _ЛицензииДУ
	    |ИЗ
	    |	(ВЫБРАТЬ
	    |		_ДатыРасчетаСЧА.Организация КАК Организация,
	    |		_ДатыРасчетаСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |		_ДатыРасчетаСЧА.Дата КАК Дата,
	    |		МАКСИМУМ(ЛицензииДоговоровДоверительногоУправления.Период) КАК ДатаЛицензии
	    |	ИЗ
	    |		_ДатыРасчетаСЧА КАК _ДатыРасчетаСЧА
	    |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
	    |			ПО _ДатыРасчетаСЧА.Организация = ЛицензииДоговоровДоверительногоУправления.Организация
	    |				И _ДатыРасчетаСЧА.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
	    |				И _ДатыРасчетаСЧА.Дата >= ЛицензииДоговоровДоверительногоУправления.Период
	    |	
	    |	СГРУППИРОВАТЬ ПО
	    |		_ДатыРасчетаСЧА.Организация,
	    |		_ДатыРасчетаСЧА.СчетДоверительногоУправления,
	    |		_ДатыРасчетаСЧА.Дата) КАК ВложенныйЗапрос
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДУ
	    |		ПО ВложенныйЗапрос.Организация = ЛицензииДУ.Организация
	    |			И ВложенныйЗапрос.СчетДоверительногоУправления = ЛицензииДУ.СчетДоверительногоУправления
	    |			И ВложенныйЗапрос.ДатаЛицензии = ЛицензииДУ.Период
	    |			И (ЛицензииДУ.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами))
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииПИФНПФ
	    |		ПО ВложенныйЗапрос.Организация = ЛицензииПИФНПФ.Организация
	    |			И ВложенныйЗапрос.СчетДоверительногоУправления = ЛицензииПИФНПФ.СчетДоверительногоУправления
	    |			И ВложенныйЗапрос.ДатаЛицензии = ЛицензииПИФНПФ.Период
	    |			И (ЛицензииПИФНПФ.Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ))
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	ВложенныйЗапрос.Организация,
	    |	ВложенныйЗапрос.СчетДоверительногоУправления,
	    |	ВложенныйЗапрос.Дата
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_АктуальныеСчетаДоверительногоУправления.Организация КАК Организация,
	    |	_АктуальныеСчетаДоверительногоУправления.Ссылка КАК Ссылка,
	    |	ЕСТЬNULL(_ДатыРасчетаСЧА.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК Дата,
	    |	_АктуальныеСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
	    |	_АктуальныеСчетаДоверительногоУправления.СпециализированныйДепозитарий КАК СпециализированныйДепозитарий,
	    |	_АктуальныеСчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
	    |	_АктуальныеСчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
	    |	_АктуальныеСчетаДоверительногоУправления.Клиент КАК Клиент,
	    |	ВЫБОР
	    |		КОГДА _АктуальныеСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ))
	    |				И _ЛицензииДУ.ДействуетЛицензияДУ
	    |			ТОГДА ""ОценкаОбъектовВУправлении""
	    |		КОГДА _АктуальныеСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний))
	    |				ИЛИ _АктуальныеСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФОГФ))
	    |					И _ЛицензииДУ.ДействуетЛицензияПИФНПФ
	    |			ТОГДА ВЫБОР
	    |					КОГДА ЕСТЬNULL(НастройкиУчетаОбщие.ВестиЕдиныйБухгалтерскийУчет, ЛОЖЬ)
	    |						ТОГДА ""ЕдиныйБухгалтерскийУчет""
	    |					КОГДА ЕСТЬNULL(НастройкиУчетаОбщие.ВестиБухгалтерскийУчет, ЛОЖЬ)
	    |						ТОГДА ""БухгалтерскийУчет""
	    |					ИНАЧЕ НЕОПРЕДЕЛЕНО
	    |				КОНЕЦ
	    |		ИНАЧЕ ""ОценкаОбъектовВУправлении""
	    |	КОНЕЦ КАК ИсточникСтоимости,
	    |	_АктуальныеСчетаДоверительногоУправления.КодСчета КАК КодСчета
	    |ПОМЕСТИТЬ _СчетаДоверительногоУправления
	    |ИЗ
	    |	_АктуальныеСчетаДоверительногоУправления КАК _АктуальныеСчетаДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыРасчетаСЧА КАК _ДатыРасчетаСЧА
	    |		ПО _АктуальныеСчетаДоверительногоУправления.Организация = _ДатыРасчетаСЧА.Организация
	    |			И _АктуальныеСчетаДоверительногоУправления.Ссылка = _ДатыРасчетаСЧА.СчетДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ЛицензииДУ КАК _ЛицензииДУ
	    |		ПО _АктуальныеСчетаДоверительногоУправления.Организация = _ЛицензииДУ.Организация
	    |			И _АктуальныеСчетаДоверительногоУправления.Ссылка = _ЛицензииДУ.СчетДоверительногоУправления
	    |			И (_ДатыРасчетаСЧА.Дата = _ЛицензииДУ.Дата)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	    |			_ДатыРасчетаСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	    |			_ДатыРасчетаСЧА.Дата КАК Дата,
	    |			МАКСИМУМ(НастройкиУчетаОбщие.Период) КАК ПериодНастроекУчета
	    |		ИЗ
	    |			_ДатыРасчетаСЧА КАК _ДатыРасчетаСЧА
	    |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
	    |				ПО _ДатыРасчетаСЧА.Организация = НастройкиУчетаОбщие.Организация
	    |					И _ДатыРасчетаСЧА.СчетДоверительногоУправления = НастройкиУчетаОбщие.СчетДоверительногоУправления
	    |					И _ДатыРасчетаСЧА.Дата >= НастройкиУчетаОбщие.Период
	    |		
	    |		СГРУППИРОВАТЬ ПО
	    |			_ДатыРасчетаСЧА.СчетДоверительногоУправления,
	    |			_ДатыРасчетаСЧА.Дата) КАК ДатыНастроекУчета
	    |		ПО _АктуальныеСчетаДоверительногоУправления.Ссылка = ДатыНастроекУчета.СчетДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаОбщие КАК НастройкиУчетаОбщие
	    |		ПО _АктуальныеСчетаДоверительногоУправления.Организация = НастройкиУчетаОбщие.Организация
	    |			И _АктуальныеСчетаДоверительногоУправления.Ссылка = НастройкиУчетаОбщие.СчетДоверительногоУправления
	    |			И (ДатыНастроекУчета.ПериодНастроекУчета = НастройкиУчетаОбщие.Период)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_СчетаДоверительногоУправления.Организация КАК Организация,
	    |	_СчетаДоверительногоУправления.Ссылка КАК Ссылка,
	    |	_СчетаДоверительногоУправления.Дата КАК Дата,
	    |	_Лицензии.Номер КАК НомерЛицензииКлиента,
	    |	_СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
	    |	_СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
	    |	_СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
	    |	_СчетаДоверительногоУправления.Клиент КАК Клиент,
	    |	_СчетаДоверительногоУправления.СпециализированныйДепозитарий КАК СпециализированныйДепозитарий,
	    |	_СчетаДоверительногоУправления.ИсточникСтоимости КАК ИсточникСтоимости,
	    |	_ЛицензииДУ.ДействуетЛицензияДУ КАК ДействуетЛицензияДУ,
	    |	_ЛицензииДУ.ДействуетЛицензияПИФНПФ КАК ДействуетЛицензияПИФНПФ
	    |ИЗ
	    |	_СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _Лицензии КАК _Лицензии
	    |		ПО (_Лицензии.Клиент = _СчетаДоверительногоУправления.Клиент)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ _ЛицензииДУ КАК _ЛицензииДУ
	    |		ПО _СчетаДоверительногоУправления.Ссылка = _ЛицензииДУ.СчетДоверительногоУправления";
		
	#КонецОбласти
	
	Результат = Запрос.Выполнить();
	
	Выборка = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_СчетаДоверительногоУправления", , , "ИсточникСтоимости = НЕОПРЕДЕЛЕНО").Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить стоимость активов по клиенту '" + Выборка.Ссылка + "'");
	КонецЦикла;
	
	Возврат Результат.Выгрузить();

КонецФункции
 
&НаСервереБезКонтекста
Процедура ПоместитьТаблицуДатРасчетаСЧАВМенеджерВременныхТаблиц(Запрос)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СчетаДоверительногоУправления.Организация КАК Организация,
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(_СчетаДоверительногоУправления.ДатаЗаключения, ДЕНЬ) < &ПоследнийРабочийДень
		|			ТОГДА &ПоследнийРабочийДень
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(_СчетаДоверительногоУправления.ДатаЗаключения, ДЕНЬ)
		|	КОНЕЦ КАК ДатаНачала,
		|	ВЫБОР
		|		КОГДА _СчетаДоверительногоУправления.ДатаРасторжения > &КонецПериода
		|				ИЛИ _СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА &КонецПериода
		|		ИНАЧЕ _СчетаДоверительногоУправления.ДатаРасторжения
		|	КОНЕЦ КАК ДатаОкончания
		|ПОМЕСТИТЬ _СчетаДоверительногоУправления
		|ИЗ
		|	_АктуальныеСчетаДоверительногоУправления КАК _СчетаДоверительногоУправления";
	
	
	Запрос.Выполнить();
	
	ПараметрыДатСЧА = Новый Структура("ВидДействия, ДополнитьРабочимиДнями, ИмяТаблицыДатДействияЗаПериод, УдалитьВсеВременныеТаблицы", 
									"СЧА", Ложь, "_ВсеДатыРасчетаСЧА", Истина);
	
	Запрос.Текст = Справочники.НастройкиРегламентныхДействий.ПолучитьТекстЗапросаПоДатамРегламентныхДействий(ПараметрыДатСЧА);
	
	Запрос.Текст = стрЗаменить(Запрос.Текст, "&ДатаС", "&ПоследнийРабочийДень");
	Запрос.Текст = стрЗаменить(Запрос.Текст, "&ДатаПо", "&КонецПериода");
	
	Запрос.Выполнить();
	
	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВсеДатыРасчетаСЧА.Организация КАК Организация,
		|	_ВсеДатыРасчетаСЧА.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	МАКСИМУМ(_ВсеДатыРасчетаСЧА.Дата) КАК Дата
		|ПОМЕСТИТЬ _ДатыРасчетаСЧА
		|ИЗ
		|	_ВсеДатыРасчетаСЧА КАК _ВсеДатыРасчетаСЧА
		|
		|СГРУППИРОВАТЬ ПО
		|	_ВсеДатыРасчетаСЧА.СчетДоверительногоУправления,
		|	_ВсеДатыРасчетаСЧА.Организация";
	Запрос.Выполнить();
	
	Запрос.Текст = 	
		"УНИЧТОЖИТЬ _СчетаДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ВсеДатыРасчетаСЧА";

	Запрос.Выполнить();
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьНаСервере()
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Объект, "Период, Организация"); 
	Механизм			= "_АнкетаНАУФОР.Форма.КомандаЗаполнитьНаСервере()";
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);            
	
	ЗаполнитьОбщиеРеквизиты();
	Реквизиты = ЭтаФорма.ПолучитьРеквизиты();
	
	МенеджерВременныхТаблиц = ПодготовитьДанныеРаздел5(Объект.Организация, Объект.Период, ЭтаФорма.ВерсияФайла);
	
	ЗаполнитьТаблицыФормы(Реквизиты, МенеджерВременныхТаблиц);
	СформироватьРасшифровку(МенеджерВременныхТаблиц);
		
	МенеджерВременныхТаблиц = ПодготовитьДанныеРаздел2(Объект.Организация, Объект.Период, ЭтаФорма.ВерсияФайла);
	ЗаполнитьТаблицыФормы(Реквизиты, МенеджерВременныхТаблиц);	
	ЗаполнитьРаздел2_1();
	
	ЗаполнитьРаздел7();
	// Вынесли заполнение раздела 9 в отдельную команду
	//ЗаполнитьРаздел9();
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не забудьте заполнить данные 9-го раздела перед окончательной выгрузкой.");
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбщиеРеквизиты()

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВсеСотрудники.ЮрФизЛицо) КАК Всего,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА ВсеСотрудники.ОбеспечиваетДеятельностьУК
		|				ТОГДА ВсеСотрудники.ЮрФизЛицо
		|		КОНЕЦ) КАК ОбеспечивающихДеятельностьУК
		|ПОМЕСТИТЬ _КоличествоСотрудников
		|ИЗ
		|	(ВЫБРАТЬ
		|		СотрудникиОрганизацииСрезПоследних.Сотрудник.ЮрФизЛицо КАК ЮрФизЛицо,
		|		МАКСИМУМ(ВнутренниеПеречниСрезПоследних.Объект ЕСТЬ НЕ NULL ) КАК ОбеспечиваетДеятельностьУК
		|	ИЗ
		|		РегистрСведений.СотрудникиОрганизации.СрезПоследних(&ОкончаниеПериода, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(&ОкончаниеПериода, Организация = &Организация) КАК СостояниеСотрудниковОрганизацийСрезПоследних
		|			ПО СотрудникиОрганизацииСрезПоследних.Сотрудник = СостояниеСотрудниковОрганизацийСрезПоследних.Сотрудник
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВнутренниеПеречни.СрезПоследних(
		|					&ОкончаниеПериода,
		|					Организация = &Организация
		|						И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СотрудникиОбеспечивающиеДеятельностьУК)) КАК ВнутренниеПеречниСрезПоследних
		|			ПО СотрудникиОрганизацииСрезПоследних.Сотрудник.ЮрФизЛицо = ВнутренниеПеречниСрезПоследних.Объект
		|				И (ВнутренниеПеречниСрезПоследних.Действует)
		|	ГДЕ
		|		СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|		И ЕСТЬNULL(СостояниеСотрудниковОрганизацийСрезПоследних.Состояние, """") <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.ОтпускПоБеременностиИРодам)
		|		И ЕСТЬNULL(СостояниеСотрудниковОрганизацийСрезПоследних.Состояние, """") <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.ОтпускПоУходуЗаРебенком)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СотрудникиОрганизацииСрезПоследних.Сотрудник.ЮрФизЛицо) КАК ВсеСотрудники
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГОД(&ОкончаниеПериода) КАК Год,
		|	КВАРТАЛ(&ОкончаниеПериода) КАК Квартал,
		|	&ТекущаяДата КАК Заполнение_Дата,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК Наименование_УК,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.Телефоны КАК Контактный_Телефон,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.EMail КАК Контактный_Адрес_электронной_почты,
		|	Лицензии.Номер КАК Номер_Лицензии_УК,
		|	ВходящиеДокументы.Сведения_о_предписаниях КАК Сведения_о_предписаниях,
		|	ВходящиеДокументы.Сведения_о_предписаниях_информация КАК Сведения_о_предписаниях_информация,
		|	ВходящиеДокументы.Количество_Жалоб КАК Количество_Жалоб,
		|	Нарушения.Нарушения_Контролер КАК Нарушения_Контролер,
		|	_КоличествоСотрудников.Всего КАК Строка_Сотрудники_Показатель1,
		|	_КоличествоСотрудников.ОбеспечивающихДеятельностьУК КАК Строка_Сотрудники_Показатель2,
		|	ПравилаПОДФТ.Дата КАК Дата_Правил_ПОДФТ
		|ПОМЕСТИТЬ _ДанныеУК
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ОкончаниеПериода,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|				И Организация = &Организация) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Лицензии КАК Лицензии
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних КАК СтатусыЛицензийСрезПоследних
		|			ПО Лицензии.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия
		|				И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|		ПО РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = Лицензии.ЮрФизЛицо
		|			И (Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)),
		|	(ВЫБРАТЬ
		|		СУММА(ВЫБОР
		|				КОГДА ВходящийДокумент.ТипВходящегоДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ПредписаниеОбУстраненииНарушения)
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ) КАК Сведения_о_предписаниях,
		|		СУММА(ВЫБОР
		|				КОГДА ВходящийДокумент.ТипВходящегоДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ПредписаниеОПредоставленииИнформации)
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ) КАК Сведения_о_предписаниях_информация,
		|		СУММА(ВЫБОР
		|				КОГДА ВходящийДокумент.ТипВходящегоДокумента В (&ЖалобыИОбращения)
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ) КАК Количество_Жалоб
		|	ИЗ
		|		Документ.ВходящийДокумент КАК ВходящийДокумент
		|	ГДЕ
		|		ВходящийДокумент.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|		И ВходящийДокумент.Проведен
		|		И ВходящийДокумент.Организация = &Организация
		|		И ВходящийДокумент.ПоЛицензииУКПИФ) КАК ВходящиеДокументы,
		|	(ВЫБРАТЬ
		|		КОЛИЧЕСТВО(Нарушение.Ссылка) КАК Нарушения_Контролер
		|	ИЗ
		|		Документ.Нарушение КАК Нарушение
		|	ГДЕ
		|		Нарушение.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|		И НЕ Нарушение.ПометкаУдаления
		|		И Нарушение.Организация = &Организация
		|		И Нарушение.ПоЛицензииУКПИФ) КАК Нарушения,
		|	_КоличествоСотрудников КАК _КоличествоСотрудников,
		|	(ВЫБРАТЬ
		|		МАКСИМУМ(ВнутреннийДокумент.Дата) КАК Дата
		|	ИЗ
		|		Документ.ВнутреннийДокумент КАК ВнутреннийДокумент
		|	ГДЕ
		|		ВнутреннийДокумент.Дата <= &ОкончаниеПериода
		|		И ВнутреннийДокумент.ВидВнутреннегоДокумента = ЗНАЧЕНИЕ(Справочник.ВидыВнутреннихДокументов.ПравилаПОДФТ)
		|		И ВнутреннийДокумент.Организация = &Организация
		|		И НЕ ВнутреннийДокумент.ПометкаУдаления) КАК ПравилаПОДФТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Лицензии.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|			ТОГДА ""Доверительное управление""
		|		ИНАЧЕ Лицензии.ВидДеятельности
		|	КОНЕЦ КАК Тип_Лицензии,
		|	Лицензии.Номер КАК Номер_Лицензии
		|ПОМЕСТИТЬ _ЛицензииУК
		|ИЗ
		|	Справочник.Лицензии КАК Лицензии
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(&ОкончаниеПериода, ) КАК СтатусыЛицензийСрезПоследних
		|		ПО Лицензии.Ссылка = СтатусыЛицензийСрезПоследних.Лицензия
		|			И (СтатусыЛицензийСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует))
		|			И (Лицензии.ВидДеятельности <> ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ))
		|ГДЕ
		|	Лицензии.ЮрФизЛицо = &ЮрФизЛицо";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Объект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ЮрФизЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("ЖалобыИОбращения", ЖалобыИОбращения(ЭтаФорма));
	
	Запрос.Выполнить();
	
	Выборка_ДанныеУК = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ДанныеУК").ПолучитьДанные().Выбрать();
	Выборка_ДанныеУК.Следующий();
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка_ДанныеУК);
	
	ВТ_ЛицензииУК = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЛицензииУК").ПолучитьДанные().Выгрузить();
	ВТ_ЛицензииУК.Сортировать("Номер_Лицензии");
	
	ЭтаФорма.Лицензии_УК.Загрузить(ВТ_ЛицензииУК);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел2_1()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",  Объект.Организация);
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(Объект.Период.ДатаОкончания));
	Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СотрудникиОрганизацииСрезПоследних.Сотрудник.ЮрФизЛицо КАК ЮрФизЛицо
		|ПОМЕСТИТЬ _РаботающиеФизЛица
		|ИЗ
		|	РегистрСведений.СотрудникиОрганизации.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СотрудникиОрганизацииСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеСотрудниковОрганизаций.СрезПоследних(&КонецПериода, Организация = &Организация) КАК СостояниеСотрудниковОрганизацийСрезПоследних
		|		ПО (СотрудникиОрганизацииСрезПоследних.Сотрудник = СостояниеСотрудниковОрганизацийСрезПоследних.Сотрудник)
		|ГДЕ
		|	СотрудникиОрганизацииСрезПоследних.ВидСобытия <> ЗНАЧЕНИЕ(Перечисление.ВидыКадровыхСобытий.Увольнение)
		|	И ЕСТЬNULL(СостояниеСотрудниковОрганизацийСрезПоследних.Состояние, """") <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.ОтпускПоБеременностиИРодам)
		|	И ЕСТЬNULL(СостояниеСотрудниковОрганизацийСрезПоследних.Состояние, """") <> ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудникаОрганизации.ОтпускПоУходуЗаРебенком)
		|
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СведенияОКвалификацииФизическихЛиц.Организация КАК Организация,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ВидДокумента В (ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.КвалификационныйАттестат), ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.Свидетельство))
		|				ТОГДА СведенияОКвалификацииФизическихЛиц.ЮрФизЛицо
		|		КОНЕЦ) КАК Строка_Сотрудники_Показатель3,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.КвалификационныйАттестат)
		|					И СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ТипКвалификационногоАттестата В (ЗНАЧЕНИЕ(Перечисление.ТипыКвалификационныхАттестатов.ПятогоТипа), ЗНАЧЕНИЕ(Перечисление.ТипыКвалификационныхАттестатов.ПятогоТипаПервогоТипаДУ))
		|				ТОГДА СведенияОКвалификацииФизическихЛиц.ЮрФизЛицо
		|		КОНЕЦ) КАК Строка_Сотрудники_Показатель4,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
		|			КОГДА СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовОКвалификации.АттестатПОДФТ)
		|				ТОГДА СведенияОКвалификацииФизическихЛиц.ЮрФизЛицо
		|		КОНЕЦ) КАК Строка_Сотрудники_Показатель5
		|ИЗ
		|	РегистрСведений.СведенияОКвалификацииФизическихЛиц КАК СведенияОКвалификацииФизическихЛиц
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РаботающиеФизЛица КАК _РаботающиеФизЛица
		|	ПО СведенияОКвалификацииФизическихЛиц.ЮрФизЛицо = _РаботающиеФизЛица.ЮрФизЛицо
		|ГДЕ
		|	СведенияОКвалификацииФизическихЛиц.Организация = &Организация
		|	И СведенияОКвалификацииФизическихЛиц.ДатаПолученияСведений <= &КонецПериода
		|	И (СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ДатаОкончанияДействия > &КонецПериода
		|			ИЛИ СведенияОКвалификацииФизическихЛиц.ДокументОКвалификации.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))  
		|			
		|
		|СГРУППИРОВАТЬ ПО
		|	СведенияОКвалификацииФизическихЛиц.Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Выборка);
		
	Иначе
		
		ЭтаФорма.Строка_Сотрудники_Показатель3 = 0;	
		ЭтаФорма.Строка_Сотрудники_Показатель4 = 0;	
		ЭтаФорма.Строка_Сотрудники_Показатель5 = 0;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьДанныеРаздел2(Организация, Период, ВерсияФайла)
	
	Запрос = Новый Запрос;
	
	ПоследнийРабочийДень = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Период.ДатаОкончания);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",                      Организация);
	Запрос.УстановитьПараметр("КонецПериода",                     НачалоДня(Период.ДатаОкончания));
	Запрос.УстановитьПараметр("ДополнятьДолжностьПодразделением", ВерсияФайла >= "2025" );
	
	#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК Цифра
		|ПОМЕСТИТЬ _Цифры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	3
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	4
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	5
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	6
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	7
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	8
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	9
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(&КонецПериода, ДЕНЬ, -(10000 * _Цифры4.Цифра + 1000 * _Цифры3.Цифра + 100 * _Цифры2.Цифра + 10 * _Цифры1.Цифра + _Цифры.Цифра)) КАК Дата
		|ПОМЕСТИТЬ _Календарь
		|ИЗ
		|	_Цифры КАК _Цифры,
		|	_Цифры КАК _Цифры1,
		|	_Цифры КАК _Цифры2,
		|	_Цифры КАК _Цифры3,
		|	_Цифры КАК _Цифры4
		|ГДЕ
		|	_Цифры4.Цифра < 4
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
