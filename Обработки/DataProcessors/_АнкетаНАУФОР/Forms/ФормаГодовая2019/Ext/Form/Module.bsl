
#Область Обработчики_событий_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	//ЭтаФорма.Квартальная = Ложь;
	//Элементы.Квартальная.Доступность = Ложь;
	Объект.Период.Вариант = ?(ЭтаФорма.Квартальная, ВариантСтандартногоПериода.ПрошлыйКвартал, ВариантСтандартногоПериода.ПрошлыйГод);
	
	УстановитьВерсиюФайла(ЭтаФорма);
	ЗаполнитьОписаниеСтруктурыФайла();
	
	ОбновитьВидимостьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность Тогда
	
		Если Не ЗавершениеРаботы Тогда
			Отказ = (Вопрос("Изменения не сохранены. Закрыть?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет);
		Иначе
			Отказ = Истина;
			ТекстПредупреждения = "Изменения не сохранены";
		КонецЕсли;		
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 

#Область Обработчики_событий_элементов_формы

&НаКлиенте
Процедура Сведения_о_предписанияхОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Отбор = Новый Структура("Организация, ТипВходящегоДокумента", Объект.Организация, ПредопределенноеЗначение("Перечисление.ТипыВходящихДокументов.ПредписаниеОбУстраненииНарушения"));
	Форма = ПолучитьФорму("Документ.ВходящийДокумент.ФормаСписка", Новый Структура("Отбор", Отбор), ЭтаФорма, Элемент);
	Форма.ЗакрыватьПриЗакрытииВладельца = Истина;
	
	ЭлементСписок = Форма.Элементы.Список;
	ЗаполнитьЗначенияСвойств(ЭлементСписок.Период, Объект.Период);
	ЭлементСписок.Обновить();
	
	Если Не Форма.Открыта() Тогда
		Форма.Открыть();
	Иначе
		Форма.Активизировать();
	КонецЕсли;
	
КонецПроцедуры

