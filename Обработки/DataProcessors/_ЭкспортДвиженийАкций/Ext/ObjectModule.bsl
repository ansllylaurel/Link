				ДатаНач = ДатаНач + (60 * 60 * 24);
				Продолжить;
			ИначеЕсли ТаблицаОшибок.Количество() > 0 Тогда
				Для Каждого Стр Из ТаблицаОшибок Цикл
					ТекстСообщения = ТекстСообщения + 
					"<tr>
					|	<td>" + Формат(ДатаНач, "ДЛФ=Д") + "</td>
					|	<td>" + Стр.System_UID			 + "</td>
					|	<td>" + Стр.Invest_Code			 + "</td>
					|	<td>" + Стр.Security_ID			 + "</td>
					|	<td>" + Стр.Begin_Volume		 + "</td>
					|	<td>" + Стр.Movement_Volume		 + "</td>
					|	<td>" + Стр.End_Volume			 + "</td>
					|</tr>" + Символы.ПС;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		ДатаНач = ДатаНач + (60 * 60 * 24);
	КонецЦикла;
	
	Если ТекстСообщения <> "" Тогда
		ТекстСообщения =
		"<html>
		|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
		|	<style>
		|		body {
		|			font: 8pt sans-serif;
		|		}
		|		table {
		|			text-align: center;
		|			border-spacing: 0;
		|			border-collapse: collapse;
		|		}
		|		td {
		|			font-size: 1em;
		|			border: 1px solid black;
		|			padding: 5px 20px 5px 20px;
		|		}
		|		.top {
		|			color: black;
		|			font-size: 12px;
		|			background: lightgrey;
		|		}
		|	</style>
		|</head>
		|<body>
		|<table cols=""6""> 
		|<tr class=""top"">
		|<td>Дата</td>
		|<td>КодУК</td>
		|<td>СчетДУ</td>
		|<td>КодЦБ</td>
		|<td>Нач.Остаток</td>
		|<td>Оборот</td>
		|<td>Кон.Остаток</td>
		|</tr>"
		+ ТекстСообщения + "</table></body></html>";
		
		Если ЗначениеЗаполнено(ПолучателиОповещений) Тогда
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста",
			ПолучателиОповещений,
			"Ошибка при проверке данных в MatriX_External (Движение акций)!",
			ТекстСообщения,
			"HTML");
			РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

Функция SQL_Format(Дата = Неопределено, Время =  Неопределено, Число =  Неопределено)
	
	Если Не Дата = Неопределено Тогда
		Если ЗначениеЗаполнено(Дата) Тогда
			Возврат  Формат(Дата, "ДЛФ=Д"); 
		Иначе
			Возврат "NULL";
		КонецЕсли;
	ИначеЕсли Не Время = Неопределено Тогда
		Если ЗначениеЗаполнено(Время) Тогда
			Возврат  Формат(Время, "ДФ=HH:mm:ss");
		Иначе
			Возврат "NULL";
		КонецЕсли;
	ИначеЕсли Не Число = Неопределено Тогда
		ЧислоSQL = Формат(Число, "ЧРД=.; ЧГ=0");
		Если ПустаяСтрока(ЧислоSQL) Тогда
			Возврат "0";
		КонецЕсли;
		
		Возврат ЧислоSQL;
	КонецЕсли;

КонецФункции

Функция СформироватьДанныеДляВыгрузки()
	
	ДанныеДляВыгрузки = Новый Структура();
	//Операции
	Запрос = Новый Запрос;
	
	#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиЦенныхБумаг.Период КАК ДатаИсполнения,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ОстаткиЦенныхБумаг.Организация.ЮрФизЛицо) КАК ОрганизацияЮрФизЛицо,
		|	ОстаткиЦенныхБумаг.СчетДоверительногоУправления КАК СчетДУ,
		|	ВЫБОР
		|		КОГДА ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА 1
		|		КОГДА ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			ТОГДА -1
		|	КОНЕЦ КАК ВидДвижения,
		|	ВЫБОР
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.КонвертацияЦенныхБумаг
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.КорректировкаРегистров
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.СнятиеЦеннойБумагиСУчета
		|			ТОГДА ВЫБОР
		|					КОГДА ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|						ТОГДА ""IN""
		|					КОГДА ОстаткиЦенныхБумаг.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|						ТОГДА ""OUT""
		|				КОНЕЦ
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг
		|			ТОГДА ""IN""
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|			ТОГДА ""OUT""
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.Сделка
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.СделкаРЕПО
		|			ТОГДА ВЫБОР
		|					КОГДА ОстаткиЦенныхБумаг.Регистратор.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|						ТОГДА ""BUY""
		|					КОГДА ОстаткиЦенныхБумаг.Регистратор.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|						ТОГДА ""SELL""
		|				КОНЕЦ
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ОтменаСделки
		|			ТОГДА ВЫБОР
		|					КОГДА ВложенныйЗапрос.Основание.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|						ТОГДА ""BUY""
		|					КОГДА ВложенныйЗапрос.Основание.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|						ТОГДА ""SELL""
		|				КОНЕЦ
		|	КОНЕЦ КАК ВидСделки,
		|	ОстаткиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ОстаткиЦенныхБумаг.Количество КАК Количество,
		|	ВЫБОР
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ВводЦенныхБумаг
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ВыводЦенныхБумаг
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.КонвертацияЦенныхБумаг
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.КорректировкаРегистров
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.СнятиеЦеннойБумагиСУчета
		|			ТОГДА ОстаткиЦенныхБумаг.Регистратор.Номер
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.Сделка
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.СделкаРЕПО
		|			ТОГДА ВЫБОР
		|					КОГДА ОстаткиЦенныхБумаг.Регистратор.НомерСделки = """"
		|							ИЛИ ОстаткиЦенныхБумаг.Регистратор.НомерСделки ЕСТЬ NULL
		|						ТОГДА ВЫБОР
		|								КОГДА ОстаткиЦенныхБумаг.Регистратор.НомерСделкиСЦентральнымКонтрагентом = """"
		|										ИЛИ ОстаткиЦенныхБумаг.Регистратор.НомерСделкиСЦентральнымКонтрагентом ЕСТЬ NULL
		|									ТОГДА ОстаткиЦенныхБумаг.Регистратор.Номер
		|								ИНАЧЕ ОстаткиЦенныхБумаг.Регистратор.НомерСделкиСЦентральнымКонтрагентом
		|							КОНЕЦ
		|					ИНАЧЕ ОстаткиЦенныхБумаг.Регистратор.НомерСделки
		|				КОНЕЦ
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ОтменаСделки
		|			ТОГДА ВЫБОР
		|					КОГДА ВложенныйЗапрос.Основание.НомерСделки = """"
		|							ИЛИ ВложенныйЗапрос.Основание.НомерСделки ЕСТЬ NULL
		|						ТОГДА ВЫБОР
		|								КОГДА ВложенныйЗапрос.Основание.НомерСделкиСЦентральнымКонтрагентом = """"
		|										ИЛИ ВложенныйЗапрос.Основание.НомерСделкиСЦентральнымКонтрагентом ЕСТЬ NULL
		|									ТОГДА ВложенныйЗапрос.Основание.Номер
		|								ИНАЧЕ ВложенныйЗапрос.Основание.НомерСделкиСЦентральнымКонтрагентом
		|							КОНЕЦ
		|					ИНАЧЕ ВложенныйЗапрос.Основание.НомерСделки
		|				КОНЕЦ
		|	КОНЕЦ КАК НомерСделки,
		|	ВЫБОР
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|			ТОГДА ВложенныйЗапрос.Основание.Дата
		|		ИНАЧЕ ОстаткиЦенныхБумаг.Регистратор.Дата
		|	КОНЕЦ КАК Дата,
		|	ВЫБОР
		|		КОГДА ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|				ИЛИ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|			ТОГДА ВложенныйЗапрос.Основание.Дата
		|		ИНАЧЕ ОстаткиЦенныхБумаг.Регистратор.Дата
		|	КОНЕЦ КАК ВремяСделки
		|ПОМЕСТИТЬ _ОперацииСЦБ
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ОперацииСЦеннымиБумагами.Операция КАК Операция,
		|			ОперацииСЦеннымиБумагами.Основание КАК Основание,
		|			ОперацииСЦеннымиБумагами.ЦеннаяБумага КАК ЦеннаяБумага
		|		ИЗ
		|			РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|		ГДЕ
		|			(ОперацииСЦеннымиБумагами.Операция ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|					ИЛИ ОперацииСЦеннымиБумагами.Операция ССЫЛКА Документ.ПоставкаЦенныхБумаг
		|					ИЛИ ОперацииСЦеннымиБумагами.Операция ССЫЛКА Документ.ОтменаСделки
		|						И ОперацииСЦеннымиБумагами.Организация = &Организация
		|						И ОперацииСЦеннымиБумагами.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|						И (ОперацииСЦеннымиБумагами.ДатаОперации МЕЖДУ &НачалоПериода И &КонецПериода))) КАК ВложенныйЗапрос
		|		ПО ОстаткиЦенныхБумаг.Регистратор = ВложенныйЗапрос.Операция
		|			И ОстаткиЦенныхБумаг.ЦеннаяБумага = ВложенныйЗапрос.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&НачалоПериода, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО ОстаткиЦенныхБумаг.Организация.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|ГДЕ
		|	ОстаткиЦенныхБумаг.Организация = &Организация
		|	И ОстаткиЦенныхБумаг.Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|	И ОстаткиЦенныхБумаг.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И НЕ ОстаткиЦенныхБумаг.Регистратор ССЫЛКА Документ.ПереводЦенныхБумаг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОперацииСЦБ.ДатаИсполнения КАК Settlement_Date,
		|	КодМатрихЮрЛицаОрганизацииСрезПоследних.Код КАК Company_ID,
		|	КодыМатрихКлиентовСрезПоследних.Код КАК Client_ID,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Наименование КАК Client_Name,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.КодСчета КАК Invest_Code,
		|	_ОперацииСЦБ.ВидДвижения КАК Direction,
		|	_ОперацииСЦБ.ВидСделки КАК Operation_Type_UID,
		|	КодыМатрихАкцийСрезПоследних.Код КАК Security_ID,
		|	_ОперацииСЦБ.Количество КАК Volume,
		|	_ОперацииСЦБ.НомерСделки КАК Deal_Number,
		|	_ОперацииСЦБ.Дата КАК Deal_Date,
		|	_ОперацииСЦБ.ВремяСделки КАК Deal_Time
		|ИЗ
		|	_ОперацииСЦБ КАК _ОперацииСЦБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&НачалоПериода, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|					&НачалоПериода,
		|					ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|						И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыМатрихКлиентовСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = КодыМатрихКлиентовСрезПоследних.Объект
		|		ПО _ОперацииСЦБ.СчетДУ = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)) КАК КодыМатрихАкцийСрезПоследних
		|		ПО _ОперацииСЦБ.ЦеннаяБумага = КодыМатрихАкцийСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодМатрихЮрЛицаОрганизацииСрезПоследних
		|		ПО _ОперацииСЦБ.ОрганизацияЮрФизЛицо = КодМатрихЮрЛицаОрганизацииСрезПоследних.Объект";	
	#КонецОбласти 
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	
	ДанныеДляВыгрузки.Вставить("Операции", Запрос.Выполнить().Выгрузить());
	//Остатки
	Запрос = Новый Запрос;
	
	#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _Дни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Дни.Дата КАК Дата,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ОстаткиЦенныхБумагОстаткиИОбороты.Организация.ЮрФизЛицо) КАК ОрганизацияЮрФизЛицо,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага КАК ЦеннаяБумага,
		|	СУММА(ВЫБОР
		|			КОГДА _Дни.Дата = ОстаткиЦенныхБумагОстаткиИОбороты.Период
		|					И ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоОборот < 0
		|					И ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток = 0
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Флаг,
		|	СУММА(ВЫБОР
		|			КОГДА ОстаткиЦенныхБумагОстаткиИОбороты.Период = &НачалоПериода
		|				ТОГДА ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоКонечныйОстаток
		|			ИНАЧЕ ВЫБОР
		|					КОГДА ОстаткиЦенныхБумагОстаткиИОбороты.Период <= _Дни.Дата
		|						ТОГДА ОстаткиЦенныхБумагОстаткиИОбороты.КоличествоОборот
		|					ИНАЧЕ 0
		|				КОНЕЦ
		|		КОНЕЦ) КАК Количество
		|ПОМЕСТИТЬ _Остатки
		|ИЗ
		|	_Дни КАК _Дни,
		|	РегистрНакопления.ОстаткиЦенныхБумаг.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			День,
		|			,
		|			Организация = &Организация
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)) КАК ОстаткиЦенныхБумагОстаткиИОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&НачалоПериода, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО ОстаткиЦенныхБумагОстаткиИОбороты.Организация.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиЦенныхБумагОстаткиИОбороты.СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстаткиИОбороты.ЦеннаяБумага,
		|	_Дни.Дата,
		|	ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, ОстаткиЦенныхБумагОстаткиИОбороты.Организация.ЮрФизЛицо)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Остатки.Дата КАК Date,
		|	КодМатрихЮрЛицаОрганизацииСрезПоследних.Код КАК Company_ID,
		|	КодыМатрихКлиентовСрезПоследних.Код КАК Client_ID,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.КодСчета КАК Invest_Code,
		|	КодыМатрихАкцийСрезПоследних.Код КАК Security_ID,
		|	_Остатки.Количество КАК Volume
		|ИЗ
		|	_Остатки КАК _Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&НачалоПериода, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|					&НачалоПериода,
		|					ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|						И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды))) КАК КодыМатрихКлиентовСрезПоследних
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.Клиент = КодыМатрихКлиентовСрезПоследних.Объект
		|		ПО _Остатки.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодМатрихЮрЛицаОрганизацииСрезПоследних
		|		ПО _Остатки.ОрганизацияЮрФизЛицо = КодМатрихЮрЛицаОрганизацииСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&НачалоПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.Акции)) КАК КодыМатрихАкцийСрезПоследних
		|		ПО _Остатки.ЦеннаяБумага = КодыМатрихАкцийСрезПоследних.Объект
		|ГДЕ
		|	(_Остатки.Флаг > 0
		|			ИЛИ _Остатки.Количество > 0)";
	#КонецОбласти 
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	
	ДанныеДляВыгрузки.Вставить("Остатки", Запрос.Выполнить().Выгрузить());
	
	Возврат ДанныеДляВыгрузки;
	
КонецФункции

Процедура ВыгрузитьДанные(ПараметрыСессии)
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение("Driver={SQL Server};Server=AP15.G1.LAN;UID=svc_API_AM;PWD=p8z4gr39VAxXAfhn;Database=MatriX_External"); 
	Если Соединение = Неопределено Тогда
		ЗарегистрироватьОшибку("Не удалось установить соединение  с MatriX_External", ПараметрыСессии);
		Возврат;
	КонецЕсли;
	//1С. - русская раскладка  
	Если Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		КодКомпании = "1С.UK.RASM";
	ИначеЕсли Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		КодКомпании = "1С.UK.RPI";
	Иначе
		ЗарегистрироватьОшибку("Для " + Организация.Наименование + " выгрузка не предусмотрена!", ПараметрыСессии);
		Возврат;
	КонецЕсли;
#Область ОТКРЫТИЕ_СЕСИИ
	//Открываем сессию
	ТекстЗапроса = "EXEC AM.usp_Shares_Group_Ownership_Export_Begin
	|@System_UID = '" + КодКомпании + "',
	|@Date_From  = '" + SQL_Format(Период.ДатаНачала) + "',
	|@Date_To    = '" + SQL_Format(Период.ДатаОкончания) + "'";
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибку("Не удалось получить ID сессии!", ПараметрыСессии);
		Возврат;
	Иначе
		НаборЗаписей.MoveFirst();
		ИД_Сесии = НаборЗаписей.Fields.Item(0).Value;
	КонецЕсли;
#КонецОбласти
	
#Область ОЧИСТКА
	ТекстЗапроса = "DELETE FROM AM.Shares_Group_Ownership_Remains 
				   |WHERE [System_UID] = '" + КодКомпании + "' AND [Date] BETWEEN '" + SQL_Format(Период.ДатаНачала) + "' AND '" + SQL_Format(Период.ДатаОкончания) + "'";
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибку("Перед выгрузкой данных не удалось очистить таблицу остатков!", ПараметрыСессии);
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "DELETE FROM AM.Shares_Group_Ownership_Operations 
				   |WHERE [System_UID] = '" + КодКомпании + "' AND [Settlement_Date] BETWEEN '" + SQL_Format(Период.ДатаНачала) + "' AND '" + SQL_Format(Период.ДатаОкончания) + "'";
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибку("Перед выгрузкой данных не удалось очистить таблицу операций!", ПараметрыСессии);
		Возврат;
	КонецЕсли;
#КонецОбласти
		
#Область ВЫГРУЗКА_ДАННЫХ	
	Данные = СформироватьДанныеДляВыгрузки();
	
	Для Каждого Элемент Из Данные Цикл
		Таблица = Элемент.Значение;
		Если Таблица.Количество() > 0 Тогда
			Для Каждого Строка Из Таблица Цикл
				ClientID = ?(КодыПифов.Получить(Строка.Client_ID) = Неопределено, Строка.Client_ID, КодыПифов.Получить(Строка.Client_ID));
				Если Элемент.Ключ = "Операции" Тогда
					ТекстЗапроса = "INSERT AM.Shares_Group_Ownership_Operations (
					|[System_UID],
					|[Settlement_Date],
					|[Settlement_Time],
					|[Company_ID],
					|[Client_ID],
					|[Client_Name],
					|[Invest_Code],
					|[Direction],
					|[Operation_Type_UID],
					|[Security_ID],
					|[Volume],
					|[Deal_Number],
					|[Deal_Date],
					|[Deal_Time])
					|
					|VALUES (  
					|'" + КодКомпании       				  + "',
					|'" + SQL_Format(Строка.Settlement_Date)  + "',
					|'" + SQL_Format(,Строка.Settlement_Date) + "',
					|'" + Строка.Company_ID					  + "',
					|'" + ClientID							  + "', 
					|'" + Строка.Client_Name				  + "',
					|'" + Строка.Invest_Code				  + "',
					|'" + Строка.Direction					  + "',
					|'" + Строка.Operation_Type_UID 		  + "',
					|'" + Строка.Security_ID				  + "',
					|'" + SQL_Format(,,Строка.Volume)		  + "',
					|'" + Строка.Deal_Number				  + "', 
					|'" + SQL_Format(Строка.Deal_Date)		  + "',
					|'" + SQL_Format(,Строка.Deal_Time)		  + "')";
					
				ИначеЕсли Элемент.Ключ = "Остатки" Тогда
					ТекстЗапроса = "INSERT AM.Shares_Group_Ownership_Remains (
					|[System_UID],
					|[Date],
					|[Company_ID],
					|[Client_ID],
					|[Invest_Code],
					|[Security_ID],
					|[Volume])
					|
					|VALUES (
					|'" + КодКомпании   			  + "',
					|'" + SQL_Format(Строка.Date)     + "',
					|'" + Строка.Company_ID		  	  + "',
					|'" + ClientID					  + "',
					|'" + Строка.Invest_Code		  + "',
					|'" + Строка.Security_ID		  + "',
					|'" + SQL_Format(,,Строка.Volume) + "')";
					
				КонецЕсли;
				
				НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
				Если НаборЗаписей = Неопределено Тогда
					ЗарегистрироватьОшибку("Не удалось выпонить запрос! " + ТекстЗапроса, ПараметрыСессии);
					Возврат;
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
#КонецОбласти

	//Закрываем сессию
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, "EXEC AM.usp_Shares_Group_Ownership_Export_End @Session_ID = '" + SQL_Format(,,ИД_Сесии) + "'");
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибку("Не удалось выпонить запрос завершения сессии!", ПараметрыСессии);
		Возврат;
	КонецЕсли;
	//Если КодКомпании = "1С.UK.RPI" Тогда
	//	ВыполнитьПроверку(Соединение);
	//КонецЕсли;
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	
КонецПроцедуры

Процедура Выгрузить(ПараметрыСессии) Экспорт
		
	ВыгрузитьДанные(ПараметрыСессии);
	ОповеститьОбОшибках();
	
