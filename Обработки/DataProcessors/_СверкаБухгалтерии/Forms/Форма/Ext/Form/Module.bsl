&НаКлиенте
Процедура СписокОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "СписокОтчетовСформировать" Тогда
		
		ИмяОбработкиСлужебное = РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(Элемент.ТекущиеДанные.Отчет);
		
		ПараметрыФормы = Новый Структура;
		
		Если Элемент.ТекущиеДанные.Наименование = "Контроль остатков ценных бумаг" Тогда
			
			ПараметрыФормы.Вставить("КлючВарианта", Элемент.ТекущиеДанные.Вариант);
			ПараметрыФормы.Вставить("СформироватьПриОткрытии", Ложь);
								
			//ПараметрыФормы.Вставить("ПользовательскиеНастройки", 
			//	ЗаполнитьПользовательскиеНастройкиОтчета(ИмяОбработкиСлужебное, Новый Структура("СчетДоверительногоУправления", Элемент.ТекущиеДанные.СчетДУ), Элемент.ТекущиеДанные.Вариант));
			
			ФормаОтчета = ПолучитьФорму("ВнешнийОтчет." + ИмяОбработкиСлужебное + ".Форма", ПараметрыФормы, ЭтаФорма);
			
			ФормаОтчета.Отчет.Организация = Объект.Организация;
			ФормаОтчета.Отчет.Период = Объект.Период.Дата;
			
			//ПараметрСчетДУ = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("СчетДоверительногоУправления");
			//
			//Если ПараметрСчетДУ <> Неопределено Тогда
			//	ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("СчетДоверительногоУправления").Значение = Элемент.ТекущиеДанные.СчетДУ; 				
			//КонецЕсли;			
			
			ФормаОтчета.Отчет.СчетДоверительногоУправления = Элемент.ТекущиеДанные.СчетДУ; 
			ФормаОтчета.Отчет.ВидУчета = Элемент.ТекущиеДанные.ВидУчета;
			
			ПользовательскиеНастройки = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
			
			Если ПользовательскиеНастройки.Количество() > 0  Тогда
				ПользовательскиеНастройки[0].Использование = Истина;				
			КонецЕсли;			
			
			ФормаОтчета.СкомпоноватьРезультат(РежимКомпоновкиРезультата.Непосредственно);
			
			ФормаОтчета.Открыть();		
			
		ИначеЕсли Элемент.ТекущиеДанные.Наименование = "Сверка с брокером БК РЕГИОН" Тогда
			
			СчетаСДоговоромБКРегион = СчетаСДоговоромБрокера(ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
		
			ПараметрыФормы.Вставить("ДатаСверки", Объект.Период.Дата);
			
			ФормаОтчета = ПолучитьФорму("ВнешняяОбработка." + ИмяОбработкиСлужебное + ".Форма", ПараметрыФормы, ЭтаФорма);
			ФормаОтчета.Объект.Организация = Объект.Организация;
			
			ФормаОтчета.Объект.СписокСчетовДУ.ЗагрузитьЗначения(СчетаСДоговоромБКРегион);
			ФормаОтчета.ИспользоватьОтборПоСчетамДоверительногоУправления = Истина;			
			ФормаОтчета.Элементы.СчетДоверительногоУправления.Видимость = Истина;
			
			Если Элемент.ТекущиеДанные.Вариант = "Сверка с месячным отчетом брокера" Тогда
				
				ФормаОтчета.СверкаСМесячнымОтчетомБрокера = НачалоДня(КонецМесяца(Объект.Период.Дата)) = Объект.Период.Дата;
			
				Если ФормаОтчета.СверкаСМесячнымОтчетомБрокера Тогда
					Ключ = "КаталогЕмесячныхОтчетовБрокераРегион";
					ФормаОтчета.Объект.ПутьКОтчетамБрокера = ФайлОтчетаБрокераРегион(Ключ, Объект.Организация, Объект.Период.Дата);
				Иначе
					ФормаОтчета.Объект.ПутьКФайлуОстатков = ФормаОтчета.ПолучитьИмяФайлаОстатков(Объект.Организация, Объект.Период.Дата);
				КонецЕсли;
				
			КонецЕсли;	
						
			ФормаОтчета.КомандаСверить(Неопределено);			
			ФормаОтчета.Открыть();
			
		ИначеЕсли Элемент.ТекущиеДанные.Наименование = "Сверка с брокером ГПБ" Тогда
			
			СчетаСДоговоромГПБ = СчетаСДоговоромБрокера(ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
			
			ПараметрыФормы.Вставить("ДатаСверки", Объект.Период.Дата);
			
			ФормаОтчета = ПолучитьФорму("ВнешняяОбработка." + ИмяОбработкиСлужебное + ".Форма", ПараметрыФормы, ЭтаФорма);
			ФормаОтчета.Объект.Организация = Объект.Организация;
			Ключ = "ШаблонКаталогаОтчетов";
			ФормаОтчета.Объект.КаталогДанных = ФайлОтчетаБрокераГПБ(Ключ, Объект.Организация, Объект.Период.Дата);
			
			ФормаОтчета.КомандаОбновитьСписокФайлов(Неопределено);
			ФормаОтчета.Открыть();
			
			Для Каждого СтрокаТаблицыФайлыОтчетов из ФормаОтчета.ФайлыОтчетов Цикл 
				Если СчетаСДоговоромГПБ.Найти(СтрокаТаблицыФайлыОтчетов.СчетДоверительногоУправления) = Неопределено Тогда 
					СтрокаТаблицыФайлыОтчетов.Выбран = Ложь;
				КонецЕсли;					
			КонецЦикла;	
						
			ФормаОтчета.КомандаСверить(ФормаОтчета.Команды.КомандаСверить);	
						
		КонецЕсли;		
		
	КонецЕсли;
		
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФайлОтчетаБрокераРегион(Ключ, Организация, Период)
	
