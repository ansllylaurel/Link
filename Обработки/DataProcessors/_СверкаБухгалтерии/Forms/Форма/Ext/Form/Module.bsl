&НаКлиенте
Процедура ДекорацияИзменитьНажатие(Элемент)
	
	Если ЭтаФорма.ВидыУчета.Количество() = 0 Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для текущей организации не заданы настройки учета на " + Формат(Объект.НачалоПериода, "ДФ=dd.MM.yyyy"));
		Возврат;	
	КонецЕсли; 
	
	Если ЭтаФорма.ВидыУчета.ОтметитьЭлементы("Выбор видов учета") Тогда
		ОбновитьПредставлениеВидовУчета(ЭтаФорма.ВидыУчета, Элементы.ДекорацияВидыУчета.Заголовок);		
	КонецЕсли;
	
	ОбновитьСписокОтчетов();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Обновляем виды учета и заголовок, если они еще не обновлены
	Если  ЭтаФорма.ВидыУчета.Количество() = 0 Тогда
		ЗаполнитьВидыУчета(Объект.Период.Дата, Объект.Организация, ЭтаФорма.ВидыУчета, Истина);				
	КонецЕсли;
	
	ОбновитьПредставлениеВидовУчета(ЭтаФорма.ВидыУчета, Элементы.ДекорацияВидыУчета.Заголовок);	
	НастроитьВидимостьДоступностьЭлементовФормы();
	ОбновитьСписокСчетовДУ();
	ОбновитьСписокОтчетов();
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеВидовУчета(ВидыУчета, ТекстВидыУчета)

	ТекстВидыУчета = "Виды учета:";
	Для каждого ЭлементСписка Из ВидыУчета Цикл	
		Если ЭлементСписка.Пометка Тогда		
			ТекстВидыУчета = ТекстВидыУчета + ?(Прав(ТекстВидыУчета, 1) = ":", " ", "; ") + СтрЗаменить(Строка(ЭлементСписка.Значение), " учет", "");			
		КонецЕсли;	
	КонецЦикла; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьВидыУчета(Период, Организация, ВидыУчета, СохранятьВыбранныеВидыУчета = Ложь)
	
	ВидыУчетаДляПроведения = Новый Массив;
	Для каждого ВидУчета Из ВидыУчета Цикл
		Если ВидУчета.Пометка Тогда
			ВидыУчетаДляПроведения.Добавить(ВидУчета.Значение);
		КонецЕсли; 
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет КАК ВестиЕдиныйБухгалтерскийУчет,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет КАК ВестиНалоговыйУчет
		|ПОМЕСТИТЬ _НастройкиУчета
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, Организация = &Организация) КАК НастройкиУчетаОбщиеСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НастройкиУчета.ВестиБухгалтерскийУчет КАК Пометка,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет) КАК Значение
		|ПОМЕСТИТЬ _ВидыУчета
		|ИЗ
		|	_НастройкиУчета КАК _НастройкиУчета
		|ГДЕ
		|	_НастройкиУчета.ВестиБухгалтерскийУчет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_НастройкиУчета.ВестиЕдиныйБухгалтерскийУчет,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|ИЗ
		|	_НастройкиУчета КАК _НастройкиУчета
		|ГДЕ
		|	_НастройкиУчета.ВестиЕдиныйБухгалтерскийУчет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_НастройкиУчета.ВестиНалоговыйУчет,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет)
		|ИЗ
		|	_НастройкиУчета КАК _НастройкиУчета
		|ГДЕ
		|	_НастройкиУчета.ВестиНалоговыйУчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЛОЖЬ КАК Пометка,
		|	_ВидыУчета.Значение КАК Значение
		|ИЗ
		|	_ВидыУчета КАК _ВидыУчета";

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);

	Выборка = Запрос.Выполнить().Выбрать();
	ВидыУчета.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		Пометка = СохранятьВыбранныеВидыУчета И Не (ВидыУчетаДляПроведения.Найти(Выборка.Значение) = Неопределено);
		ВидыУчета.Добавить(Выборка.Значение,, Пометка);
		
	КонецЦикла; 
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокСчетовДУ()	
	
	СписокСчетовДУ.Очистить();
	
	Если ЭтаФорма.РежимОтбора = 1 Тогда
		СписокСчетовДУ.Добавить(ЭтаФорма.СчетДоверительногоУправления);		
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 Тогда
		ЗаполнитьСчетаДУ(ПолучитьДействующихКлиентов(Объект.Организация, ЭтаФорма.ВидДоговораДоверительногоУправления, Объект.Период.Дата, Ложь));		
	ИначеЕсли ЭтаФорма.РежимОтбора = 4 Тогда		
		ЗаполнитьСчетаДУ(ПолучитьДействующихКлиентов(Объект.Организация, ЭтаФорма.КлиентДоверительногоУправления, Объект.Период.Дата, Ложь));		
	КонецЕсли;
			
КонецПроцедуры

Функция ПолучитьДействующихКлиентов(Организация, ГруппаКлиентов, Период, ВыводитьСообщенияОбИсключенныхСчетах = Истина) Экспорт
	
	// Выводить исключенные счета не будем, т. к. остался только вспомогательный счет ДУ "НЕОПРЕДЕЛЁН"
	ВыводитьСообщенияОбИсключенныхСчетах = Ложь;
	
	// Клиент считается действующим, если у него не закрыт договор есть хотя бы одно движение по д/с или ц/б,
	// но есть исключения
	ИсклКодыСчетовДоверительногоУправления = Новый Массив;
	//ИсклКодыСчетовДоверительногоУправления.Добавить("DU_NPF343"); // НПФ МЕЧЕЛ-ФОНД ПН АО
	//ИсклКодыСчетовДоверительногоУправления.Добавить("DU_PIF358"); // ЗПИФ долгосрочных прямых инвестиций "Ритм"
	//ИсклКодыСчетовДоверительногоУправления.Добавить("О"); // НЕОПРЕДЕЛЁН
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);

	Если ТипЗнч(ГруппаКлиентов) = Тип("СправочникСсылка.СтратегииИндивидуальногоИнвестирования") Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И Стратегия = &Стратегия) КАК СтратегииИндивидуальногоИнвестирования
			|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестирования.СчетДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)";
			
		Запрос.УстановитьПараметр("Стратегия", ГруппаКлиентов);
		
	ИначеЕсли ТипЗнч(ГруппаКлиентов) = Тип("ПеречислениеСсылка.ВидыДоговоровДоверительногоУправления")
			Или ТипЗнч(ГруппаКлиентов) = Тип("Массив")
	Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, ) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В(&ВидДоговораДоверительногоУправления)
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)
			|	И НЕ СчетаДоверительногоУправления.КодСчета В (&ИсклКодыСчетовДоверительногоУправления)
			|	И ВЫБОР
			|			КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
			|				ТОГДА СчетаДоверительногоУправления.ДатаЗаключения <= &Период
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
		
		Запрос.УстановитьПараметр("ВидДоговораДоверительногоУправления", ГруппаКлиентов);
		Запрос.УстановитьПараметр("ИсклКодыСчетовДоверительногоУправления", ИсклКодыСчетовДоверительногоУправления);
		
		// отобразим искл. товарищей
		Если ВыводитьСообщенияОбИсключенныхСчетах Тогда
			ТекстОповещения = "";
			Для каждого ИсклКодСчетаДоверительногоУправления Из ИсклКодыСчетовДоверительногоУправления Цикл
				Попытка
					ИсключаемоеЗначение = Справочники.СчетаДоверительногоУправления.НайтиПоРеквизиту("КодСчета", ИсклКодСчетаДоверительногоУправления);
				Исключение
					Продолжить;
				КонецПопытки;
				
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсключаемоеЗначение, "Организация") <> Организация Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстОповещения = ТекстОповещения
					+ ?(ПустаяСтрока(ТекстОповещения), "", ", ")
					+ "'" + ИсключаемоеЗначение + "'";
			КонецЦикла;
						
			Если ЗначениеЗаполнено(ТекстОповещения) Тогда
				ТекстОповещения = "Искл. следующие счета д/у: " + ТекстОповещения;
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОповещения);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Метаданные.ОпределяемыеТипы.КлиентыДоверительногоУправления.Тип.СодержитТип(ТипЗнч(ГруппаКлиентов)) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
			|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора
			|ПОМЕСТИТЬ _СчетаДоверительногоУправления
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Клиент В (&Клиент)) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
			|ГДЕ
			|	СчетаДоверительногоУправления.Организация = &Организация
			|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)
			|	И НЕ СчетаДоверительногоУправления.КодСчета В (&ИсклКодыСчетовДоверительногоУправления)
			|	И ВЫБОР
			|			КОГДА СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)
			|				ТОГДА СчетаДоверительногоУправления.ДатаЗаключения <= &Период
			|			ИНАЧЕ ИСТИНА
			|		КОНЕЦ";
		
		Запрос.УстановитьПараметр("Клиент", ГруппаКлиентов);
		Запрос.УстановитьПараметр("ИсклКодыСчетовДоверительногоУправления", ИсклКодыСчетовДоверительногоУправления);
		
		// отобразим искл. товарищей
		Если ВыводитьСообщенияОбИсключенныхСчетах Тогда
			ТекстОповещения = "";
			Для каждого ИсклКодСчетаДоверительногоУправления Из ИсклКодыСчетовДоверительногоУправления Цикл
				Попытка
					ИсключаемоеЗначение = Справочники.СчетаДоверительногоУправления.НайтиПоРеквизиту("КодСчета", ИсклКодСчетаДоверительногоУправления);
				Исключение
					Продолжить;
				КонецПопытки;
				
				Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсключаемоеЗначение, "Организация") <> Организация Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстОповещения = ТекстОповещения
					+ ?(ПустаяСтрока(ТекстОповещения), "", ", ")
					+ "'" + ИсключаемоеЗначение + "'";
			КонецЦикла;
				
			Если ЗначениеЗаполнено(ТекстОповещения) Тогда
				ТекстОповещения = "Искл. следующие счета д/у: " + ТекстОповещения;
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОповещения);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		ВызватьИсключение "Получение действующих клиентов по группе '" + ГруппаКлиентов + "' не поддерживается";
		
	КонецЕсли;
	
	// оставим только тех, у кого есть остатки денег и/или бумаг
	Запрос.Текст = Запрос.Текст +
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ОстаткиДенежныхСредств.Организация = &Организация
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ОстаткиЦенныхБумаг.СчетДоверительногоУправления
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг КАК ОстаткиЦенныхБумаг
		|ГДЕ
		|	ОстаткиЦенныхБумаг.Период <= КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ОстаткиЦенныхБумаг.Организация = &Организация
		|	И ОстаткиЦенныхБумаг.СчетДоверительногоУправления В
		|			(ВЫБРАТЬ
		|				_СчетаДоверительногоУправления.СчетДоверительногоУправления
		|			ИЗ
		|				_СчетаДоверительногоУправления)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ПолучитьДействующихКлиентов

Процедура ЗаполнитьСчетаДУ(КоллекцияСчетовДУ)
	
	Для Каждого Счет Из КоллекцияСчетовДУ Цикл
		СписокСчетовДУ.Добавить(Счет.СчетДоверительногоУправления);		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы();
	
	Если (ЭтаФорма.РежимОтбора = 1 И ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления))
			Или (ЭтаФорма.РежимОтбора = 2 И ЗначениеЗаполнено(ЭтаФорма.ВидДоговораДоверительногоУправления))
			Или (ЭтаФорма.РежимОтбора = 4 И ЗначениеЗаполнено(ЭтаФорма.КлиентДоверительногоУправления))			
	Тогда
		ОбновитьСписокСчетовДУ();
		ОбновитьСписокОтчетов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьДоступностьЭлементовФормы()
			
	Элементы.СчетДоверительногоУправления.Видимость = (ЭтаФорма.РежимОтбора = 1);
	Элементы.ВидДоговораДоверительногоУправления.Видимость = (ЭтаФорма.РежимОтбора = 2);
	Элементы.КлиентДоверительногоУправления.Видимость = (ЭтаФорма.РежимОтбора = 4);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Период.Дата) Тогда
		ОбновитьСписокОтчетов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ОбновитьСписокСчетовДУ();
		ОбновитьСписокОтчетов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораДоверительногоУправленияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ВидДоговораДоверительногоУправления) Тогда
		ОбновитьСписокСчетовДУ();
		ОбновитьСписокОтчетов();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентДоверительногоУправленияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.КлиентДоверительногоУправления) Тогда
		ОбновитьСписокСчетовДУ();
		ОбновитьСписокОтчетов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОтчетовПриИзменении(Элемент)
	
	Для Каждого Отчет из СписокОтчетов Цикл 
		Если Отчет.Вариант = Элемент.ТекущиеДанные.Значение Тогда 
			Отчет.Использование = Элемент.ТекущиеДанные.Пометка;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

#Область СборСтатистики

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ВариантРегистрации)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация",							Объект.Организация);
	ПараметрыОтчета.Вставить("Период",								Объект.Период);
	ПараметрыОтчета.Вставить("ВидДоговораДоверительногоУправления",	ВидДоговораДоверительногоУправления);
	ПараметрыОтчета.Вставить("СчетДоверительногоУправления",		СчетДоверительногоУправления);
	ПараметрыОтчета.Вставить("ВидыУчета",							ВидыУчета);
	ПараметрыОтчета.Вставить("ОтборОтчетов",						ОтборОтчетов);
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыОтчета, Новый ФиксированнаяСтруктура(ПараметрыОтчета));
	
	Механизм = РеквизитФормыВЗначение("Объект").Метаданные().ПолноеИмя() + "." + ВариантРегистрации;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессииСбораСтатистики = Новый Структура;
	ПараметрыСессииСбораСтатистики.Вставить("Механизм", Механизм);
	ПараметрыСессииСбораСтатистики.Вставить("Сессия", 	Сессия);
		
	Возврат ПараметрыСессииСбораСтатистики;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики)

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики.Механизм, ПараметрыСессииСбораСтатистики.Сессия);	
	
КонецПроцедуры

#КонецОбласти
