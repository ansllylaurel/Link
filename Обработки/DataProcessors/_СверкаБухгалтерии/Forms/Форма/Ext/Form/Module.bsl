&НаКлиенте
Процедура Проверить(Команда)
	
	РезультатСверкаСБрокеромРегион = Неопределено;
	РезультатСверкаСБрокеромГПБ = Неопределено;

	ПараметрыСессииСбораСтатистики = ЗарегистрироватьНовуюСессию("ОбщееВремяВыполнения");
	
	Для Каждого Строка из СписокОтчетов Цикл
		
		Строка.ПроверкаПройдена = "";

		Если Строка.Использование Тогда
			
			Если Строка.Наименование = "Контроль остатков ценных бумаг" Тогда			
				
				ПроверитьСтрокуНаСервере(СписокОтчетов.Индекс(Строка));
				
			ИначеЕсли Строка.Наименование = "Сверка с брокером БК РЕГИОН" Тогда
				
				Если РезультатСверкаСБрокеромРегион = Неопределено Тогда	
					
					СчетаСДоговоромБКРегион = СчетаСДоговоромБрокера(ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
					
					ИмяОбработкиСлужебное = РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(Строка.Отчет);
					
					ПараметрыФормы = Новый Структура();
					ПараметрыФормы.Вставить("ДатаСверки", Объект.Период.Дата);
										
					ФормаОтчета = ПолучитьФорму("ВнешняяОбработка." + ИмяОбработкиСлужебное + ".Форма", ПараметрыФормы, ЭтаФорма);
															
					ПараметрыПроверки = Новый Структура("Организация, ДатаСверки, СчетаДоверительногоУправления, СверкаСМесячнымОтчетомБрокера", 
						Объект.Организация, Объект.Период.Дата, СчетаСДоговоромБКРегион, НачалоДня(КонецМесяца(Объект.Период.Дата)) = Объект.Период.Дата);					
					РезультатСверкаСБрокеромРегион = ФормаОтчета.Проверить(ПараметрыПроверки);
					
				КонецЕсли;				
				
				ИмяВарианта = СтрЗаменить(Строка.Вариант, "БК РЕГИОН", "");
				ИмяВарианта = СтрЗаменить(Трег(ИмяВарианта), " ","");
				
				Строка.ПроверкаПройдена = ?(РезультатСверкаСБрокеромРегион[ИмяВарианта] = Неопределено, Ложь, 
					РезультатСверкаСБрокеромРегион[ИмяВарианта].Найти(Строка.СчетДУ) = Неопределено); 
					
			ИначеЕсли Строка.Наименование = "Сверка с брокером ГПБ" Тогда		
					
				Если РезультатСверкаСБрокеромГПБ = Неопределено Тогда	
					
					СчетаСДоговоромГПБ = СчетаСДоговоромБрокера(ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
								
					ИмяОбработкиСлужебное = РаботаСДополнительнымиОтчетамиИОбработками.ПодключитьВнешнююОбработку(Строка.Отчет);
					
					ПараметрыФормы = Новый Структура();
					ПараметрыФормы.Вставить("ДатаСверки", Объект.Период.Дата);
										
					ФормаОтчета = ПолучитьФорму("ВнешняяОбработка." + ИмяОбработкиСлужебное + ".Форма", ПараметрыФормы, ЭтаФорма);
															
					ПараметрыПроверки = Новый Структура("Организация, ДатаСверки, СчетаДоверительногоУправления", 
						Объект.Организация, Объект.Период.Дата, СчетаСДоговоромГПБ);					
					РезультатСверкаСБрокеромГПБ = ФормаОтчета.Проверить(ПараметрыПроверки);
					
				КонецЕсли;		
				
				ИмяВарианта = СтрЗаменить(Строка.Вариант, "ГПБ", "");
				ИмяВарианта = СтрЗаменить(Трег(ИмяВарианта), " ","");
		
				Строка.ПроверкаПройдена = ?(РезультатСверкаСБрокеромГПБ[ИмяВарианта] = Неопределено, Ложь, 
					РезультатСверкаСБрокеромГПБ[ИмяВарианта].Найти(Строка.СчетДУ) = Неопределено); 
					
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессииСбораСтатистики);
КонецПроцедуры

&НаСервере
Процедура ПроверитьСтрокуНаСервере(ИндексСтроки)
	
	Строка = СписокОтчетов[ИндексСтроки];
	
	ОтчетОбъект = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки(Строка.Отчет);
	
	ВариантыОтчета = ОтчетОбъект.СхемаКомпоновкиДанных.ВариантыНастроек;
	Для Каждого Вариант ИЗ ВариантыОтчета Цикл
		Если Вариант.Имя = Строка.Вариант Тогда
			ПараметрыПроверки = Новый Структура("Организация, Период, Счет, Настройка, Вариант, ВидУчета", 
			Объект.Организация, Объект.Период.Дата, Строка.СчетДУ, Вариант.Настройки, Вариант.Имя, Строка.ВидУчета);
			
			Строка.ПроверкаПройдена = ОтчетОбъект.Проверка(ПараметрыПроверки);					
			
		КонецЕсли;				
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере(ИмяОтчетаОбработки)
	
    Возврат Справочники.ДополнительныеОтчетыИОбработки.НайтиПоНаименованию(ИмяОтчетаОбработки).Ссылка;
	
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");		
	
КонецПроцедуры

Процедура ОбновитьСписокОтчетов()
	
	СписокОтчетов.Очистить();
	ОтборОтчетов.Очистить();
	
	НастройкиОтчетаКонтрольОстатков = НастройкиОтчетаКонтрольОстатков();
	
	СчетаСДоговоромБКРегион = СчетаСДоговоромБрокера(ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	СчетаСДоговоромГПБ = СчетаСДоговоромБрокера(ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	
	НастройкиПоВидуУчета = ПолучитьНастройкиПоВидамУчета();
	
	Для Каждого СтрокаНастройки из НастройкиПоВидуУчета Цикл  
		СчетДУ = СтрокаНастройки.СчетДоверительногоУправления;	
			
	//Для Каждого СчетДУ ИЗ СписокСчетовДУ Цикл
		
		СписокОтчеты = Новый Соответствие();
		
		Если СчетДУ = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
				
		Для Каждого ВидУчета Из ВидыУчета Цикл
			
			Если Не ВидУчета.Пометка Тогда 
				Продолжить;
			КонецЕсли;
			
			Если ВидУчета.Значение = Перечисления.ВидыУчета.БухгалтерскийУчет И Не СтрокаНастройки.ВестиБухгалтерскийУчет Тогда 
				Продолжить;
			КонецЕсли;	
			
			Если ВидУчета.Значение = Перечисления.ВидыУчета.НалоговыйУчет И Не СтрокаНастройки.ВестиНалоговыйУчет Тогда 
				Продолжить;
			КонецЕсли;	
			
			Если ВидУчета.Значение = Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет И Не СтрокаНастройки.ВестиЕдиныйБухгалтерскийУчет Тогда 
				Продолжить;
			КонецЕсли;	

			СписокОтчеты.Вставить(ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере("Контроль остатков ценных бумаг"), НастройкиОтчетаКонтрольОстатков);
			ЗаполнитьСписокОтчетов(СписокОтчеты, ВидУчета.Значение, СчетДУ);
			
		КонецЦикла;
		
		Если СчетаСДоговоромБКРегион.Найти(СчетДУ) <> Неопределено Тогда
			
			СписокОтчеты.Очистить();
			
			СписокВариантовСверкаСБрокером = Новый Массив();
			СписокВариантовСверкаСБрокером.Добавить("Сверка с отчетом брокера БК РЕГИОН");
			
			//Если НачалоДня(КонецМесяца(Объект.Период.Дата)) = Объект.Период.Дата Тогда
			//	СписокВариантовСверкаСБрокером.Добавить("Сверка с месячным отчетом брокера БК РЕГИОН");
			//КонецЕсли;                                          
			
			СписокОтчеты.Вставить(ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере("Сверка с брокером БК РЕГИОН"), СписокВариантовСверкаСБрокером);
			ЗаполнитьСписокОтчетов(СписокОтчеты, , СчетДУ);		
			
		КонецЕсли;
		
		Если СчетаСДоговоромГПБ.Найти(СчетДУ) <> Неопределено Тогда
			
			СписокОтчеты.Очистить();
			
			СписокВариантовСверкаСБрокером = Новый Массив();
			СписокВариантовСверкаСБрокером.Добавить("Сверка с отчетом брокера ГПБ");
						
			СписокОтчеты.Вставить(ПолучитьСсылкуНаВнешнийОтчетОбработкуПоИмениНаСервере("Сверка с брокером ГПБ"), СписокВариантовСверкаСБрокером);
			ЗаполнитьСписокОтчетов(СписокОтчеты, , СчетДУ);		
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНастройкиПоВидамУчета()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиУчетаОбщиеСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиБухгалтерскийУчет КАК ВестиБухгалтерскийУчет,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиЕдиныйБухгалтерскийУчет КАК ВестиЕдиныйБухгалтерскийУчет,
		|	НастройкиУчетаОбщиеСрезПоследних.ВестиНалоговыйУчет КАК ВестиНалоговыйУчет
		|ИЗ
		|	РегистрСведений.НастройкиУчетаОбщие.СрезПоследних(&Период, СчетДоверительногоУправления В (&СписокСчетовДУ)) КАК НастройкиУчетаОбщиеСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", Объект.Период.Дата);
	Запрос.УстановитьПараметр("СписокСчетовДУ", СписокСчетовДУ.ВыгрузитьЗначения());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция СчетаСДоговоромБрокера(Брокер)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Дата,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И СчетДоверительногоУправления В (&СчетаДоверительногоУправления)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Дата, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Дата) = ИСТИНА";
	
	Запрос.УстановитьПараметр("Дата", Объект.Период.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетаДоверительногоУправления", СписокСчетовДУ.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("Брокер", Брокер);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетДоверительногоУправления");
	
КонецФункции


Функция НастройкиОтчетаКонтрольОстатков()
	
	Настройки = Новый Структура();
	
	//По количеству ценных бумаг
	Настройки.Вставить("ПоКоличествуИВидуУчета", Новый Структура("Представление, ВидыУчета",
		"Сверка количества бумаг по бэк-офису и партиям", 
		"Налоговый учет, Бухгалтерский учет, Единый бухгалтерский учет"));    
	
	//Правильность партий РСБУ/НУ
	Настройки.Вставить("ПартииРСБУ_НУ", Новый Структура("Представление, ВидыУчета", 
		"Проверка партий на корректность стоимости = стоимость покупки + расходы при покупке + переоценка",
		"Налоговый учет, Бухгалтерский учет"));			
	
	//Сверка с переоценкой по ценным бумагам для РСБУ/НУ
	Настройки.Вставить("СверкаСПереоценкой", Новый Структура("Представление, ВидыУчета", 
		"Сверка остатков по ценным бумагам на счетах учета с данными необходимых переоценок",
		"Налоговый учет, Бухгалтерский учет"));
	
	//Сверка по ДС для РСБУ/НУ
	Настройки.Вставить("СверкаПоДС", Новый Структура("Представление, ВидыУчета", 
		"Сверка остатков ДС по бэк-офису и данным учета на расчетных счетах и у брокера", 
		"Налоговый учет, Бухгалтерский учет"));
	
	//Сверка РЕПО(суммы займов и проценты)"
	Настройки.Вставить("СверкаРЕПО", Новый Структура("Представление, ВидыУчета", 
		"Сверка сумм займов по данным бэкофиса и начисленных процентов  по незавершенным сделкам РЕПО с остатками на счетах учета",
		"Налоговый учет, Бухгалтерский учет"));
	
	//Сверка сумм счетов и партий БУ/НУ
	Настройки.Вставить("СверкаСуммБУ_НУ", Новый Структура("Представление, ВидыУчета", 
		"Сверка количества бумаг по бэк-офису и партиям учета", 
		"Налоговый учет, Бухгалтерский учет"));
	
	//Сверка 7-го раздела
	Настройки.Вставить("Сверка7раздел", Новый Структура("Представление, ВидыУчета", 
		"Сверка 7-го раздела", 
		"Единый бухгалтерский учет"));
	
	Возврат Настройки;
	
КонецФункции

Процедура ЗаполнитьСписокОтчетов(СписокОтчеты, ВидУчета, СчетДУ)
	
	//ОтчетОбъект = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьОбъектВнешнейОбработки(ОтчетСсылка.Ключ);
	
	Для Каждого ОтчетСсылка ИЗ СписокОтчеты Цикл
			
		//Если ОтчетСсылка.Ключ.Вид = Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет Тогда			
			
		//	ВариантыОтчета = ОтчетОбъект.СхемаКомпоновкиДанных.ВариантыНастроек;
		//	
		//	Для Каждого Вариант ИЗ ВариантыОтчета Цикл				
		//		Если ОтчетСсылка.Значение.Найти(Вариант.Имя) <> Неопределено Тогда
		//			ДобавитьСтрокуОтчета(ОтчетСсылка.Ключ, Вариант.Имя, ВидУчета, СчетДУ);				
		//		КонецЕсли;				
		//	КонецЦикла;	
		//Иначе
		
		НастройкиОтчета = ОтчетСсылка.Значение;
		
		Если ОтчетСсылка.Ключ.Наименование = "Контроль остатков ценных бумаг" Тогда			
			
			Для Каждого Вариант ИЗ НастройкиОтчета Цикл
				Если СтрНайти(Вариант.Значение.ВидыУчета, Строка(ВидУчета)) > 0 Тогда
					ДобавитьСтрокуОтчета(ОтчетСсылка.Ключ, Вариант.Ключ, ВидУчета, СчетДУ, Вариант.Значение.Представление);
					Если ОтборОтчетов.НайтиПоЗначению(Вариант.Ключ) = Неопределено Тогда
						ОтборОтчетов.Добавить(Вариант.Ключ, Вариант.Значение.Представление, Ложь);
					КонецЕсли;	
				КонецЕсли;		
			КонецЦикла;
			
		Иначе
			
			Для Каждого Вариант ИЗ НастройкиОтчета Цикл
				ДобавитьСтрокуОтчета(ОтчетСсылка.Ключ, Вариант,, СчетДУ, Вариант);
				Если ОтборОтчетов.НайтиПоЗначению(Вариант) = Неопределено Тогда
					ОтборОтчетов.Добавить(Вариант, Вариант, Ложь);
				КонецЕсли;					
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуОтчета(ОтчетСсылка, Вариант = "", ВидУчета = "", СчетДУ, Представление)
	
	НС = СписокОтчетов.Добавить();
	НС.Отчет = ОтчетСсылка;
	НС.Вариант = Вариант;
	НС.Сформировать = "Открыть отчет";
	НС.Наименование = ОтчетСсылка.Наименование;	
	НС.ВидУчета = ВидУчета;
	НС.СчетДУ = СчетДУ;
	
	НС.ПредставлениеВарианта = Представление;
	
КонецПроцедуры

