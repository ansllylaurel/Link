
&НаКлиенте
Процедура Прочитать(Команда)

	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("Прочитать");
	ВыполнитьЧтение(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЧтение(ПараметрыСессии)

	Объект.ЗагружаемыеДанные.Очистить();
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");		
		Excel.WorkBooks.Open(Объект.ПутьКФайлу);
		Excel.Sheets(1).Select();		
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;

	КоличествоСтрок = Excel.ActiveSheet.UsedRange.Rows.Count();
	
	Для НомСтр = 2 По КоличествоСтрок Цикл
				
		НоваяСтрока = ЭтаФорма.Объект.ЗагружаемыеДанные.Добавить();
		
		НоваяСтрока.ПИФ = Excel.Cells(НомСтр, 1).Value;
		НоваяСтрока.КодПИФ = Excel.Cells(НомСтр, 2).Value;
		НоваяСтрока.Количество = Excel.Cells(НомСтр, 3).Value;
		НоваяСтрока.СЧА = Excel.Cells(НомСтр, 4).Value;
		
		// Формат даты в excel: 28.06.19
		ДатаСтроки = Excel.Cells(НомСтр, 5).Value;
		Попытка
			НоваяСтрока.Период = Дата(Лев(ДатаСтроки, 6) + "20" + Прав(ДатаСтроки, 2) + "  00:00:00");
		Исключение
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Excel.ActiveWorkbook.Close();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Фильтр = "Таблицы EXCEL (*.xls;*.xlsx)|*.xls;*.xlsx";

	Если ДиалогВыбора.Выбрать() Тогда
		Объект.ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСозданиеКорректировки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СоздатьКорректировкиНаСервере(ДополнительныеПараметры);		
	КонецЕсли;	
			
КонецПроцедуры

Процедура СоздатьКорректировкиНаСервере(ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.ТекущаяКорректировка = Неопределено Тогда
		ДокументОбъект = Документы.КорректировкаРегистров.СоздатьДокумент();
	Иначе
		ДокументОбъект = ДополнительныеПараметры.ТекущаяКорректировка.ПолучитьОбъект();
	КонецЕсли;
	
	НачатьТранзакцию();		
	
	Попытка
	
		ДокументОбъект.Организация                  = ДополнительныеПараметры.Организация;		
		ДокументОбъект.Дата                         = КонецДня(ДополнительныеПараметры.Период);
		ДокументОбъект.СчетДоверительногоУправления = ДополнительныеПараметры.СчетДоверительногоУправления;
		
		ДокументОбъект.Ответственный                = РаботаСПользователями.ТекущийПользователь();
		ДокументОбъект.Комментарий                  = "Загружено из 1С 7.7";
		
		СтрокаТаблицаРегистров = ДокументОбъект.ТаблицаРегистров.Добавить();
		СтрокаТаблицаРегистров.Имя = "ФинансовыеПоказатели";		
		
		ДокументОбъект.Записать();
		
		НаборФинансовыеПоказатели = РегистрыСведений.ФинансовыеПоказатели.СоздатьНаборЗаписей();
		НаборФинансовыеПоказатели.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
		НаборФинансовыеПоказатели.Очистить();
		//НаборФинансовыеПоказатели.Прочитать();
		
		Запись = НаборФинансовыеПоказатели.Добавить();
		Запись.Период = ДополнительныеПараметры.Период;
		Запись.Организация = ДополнительныеПараметры.Организация; 
		Запись.СубъектАналитики = ДополнительныеПараметры.СчетДоверительногоУправления;
		Запись.ВидПоказателя = ПредопределенноеЗначение("Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок");		
		Запись.Значение = ДополнительныеПараметры.СЧА;		
		
		НаборФинансовыеПоказатели.Записать();
	
		Если ТранзакцияАктивна() Тогда		
			ЗафиксироватьТранзакцию();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Записан документ: " + ДокументОбъект.Ссылка);		
		КонецЕсли;
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДополнитьПараметрыВыполненияСессии(ДополнительныеПараметры.ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
	КонецПопытки;
	
	
КонецПроцедуры
	
&НаСервереБезКонтекста
Функция СозданнаяКорректировка(Организация, Дата, СчетДУ)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.СубъектАналитики = &СубъектАналитики
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И НАЧАЛОПЕРИОДА(ФинансовыеПоказатели.Период, ДЕНЬ) = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СубъектАналитики", СчетДУ);
	Запрос.УстановитьПараметр("Период", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Регистратор;
	КонецЕсли;
		
	Возврат Неопределено;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСчетДоверительногоУправленияПоКодуКонтрагентаИз1С77(КодВнешнейСистемы) 
	
	Обработка = Обработки.ИмпортНормативноСправочнойИнформации.Создать();
	ГруппаОбъектов = Справочники.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды;		
	ПараметрыПоиска = Новый Структура("ВнешняяСистема", ПредопределенноеЗначение("Справочник.ВнешниеСистемы.РПИ77ПИФ"));	
	Возврат Обработка.ПолучитьОбъектПоКодуВнешнейСистемы(ПараметрыПоиска, КодВнешнейСистемы, ГруппаОбъектов, Ложь); 
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоКорректировка(Ссылка)
	Возврат ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРегистров");
КонецФункции

&НаКлиенте
Процедура СоздатьКорректировки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("СоздатьКорректировки");
	ВыполнитьСозданиеКорректировок(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСозданиеКорректировок(ПараметрыСессии)
	
	ОрганизацияПользователя = Объект.Организация;
	
	Для Каждого Строка Из Объект.ЗагружаемыеДанные Цикл
		
		СчетДоверительногоУправления = ПолучитьСчетДоверительногоУправленияПоКодуКонтрагентаИз1С77(Строка.КодПИФ);
		
		//Неопределено не будет, там ВызватьИсключение
		Если СчетДоверительногоУправления = Неопределено Тогда
			ТекстОшибки = "Не найден счет ДУ по коду " + Строка.КодПИФ;
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Продолжить;
		КонецЕсли;		
		
		ОрганизацияСчетаДУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "Организация");
		
		Если ОрганизацияСчетаДУ <> ОрганизацияПользователя Тогда
			ТекстОшибки = СтрШаблон(
				"Организация счета ДУ ""%1"": ""%2"" отличается от текущей организации пользователя: ""%3""", 
				СчетДоверительногоУправления, ОрганизацияСчетаДУ, ОрганизацияПользователя);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);			
			Продолжить;
		КонецЕсли;
		
		ТекущаяКорректировка = СозданнаяКорректировка(ОрганизацияПользователя, КонецДня(Строка.Период), СчетДоверительногоУправления);
		
		ДопПараметры = Новый Структура("ТекущаяКорректировка, Организация, СчетДоверительногоУправления, Период, СЧА, ПараметрыСессии", ТекущаяКорректировка, ОрганизацияПользователя, СчетДоверительногоУправления, Строка.Период, Строка.СЧА, ПараметрыСессии);
		
		Если ТекущаяКорректировка = Неопределено Тогда
			СоздатьКорректировкиНаСервере(ДопПараметры);
		Иначе
			Если ЭтоКорректировка(ТекущаяКорректировка) Тогда
				Оповещение = Новый ОписаниеОповещения("ВыполнитьСозданиеКорректировки", ЭтотОбъект, ДопПараметры);		
				ПоказатьВопрос(Оповещение, "По счету: " + СчетДоверительногоУправления + Символы.ПС + "Уже создан документ: " + ТекущаяКорректировка + Символы.ПС + "Перезаполнить его?", РежимДиалогаВопрос.ДаНетОтмена,,,,);
			Иначе
				ТекстОшибки = "По счету " + СчетДоверительногоУправления + " показатель уже рассчитан";
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки); 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
						
	КонецЦикла;
	
КонецПроцедуры

