Процедура ИмпортСвязанныхЛицИнфинитум(СвязанноеЛицо = Неопределено, Отчет = Неопределено) Экспорт

	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация,ЮрЛицо,СвязанноеЛицо");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортСвязанныхЛицИнфинитум";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	#Область Получение_данных_из_Externals
	Отбор = "";
	
	Если ЗначениеЗаполнено(СвязанноеЛицо) Тогда
		
		КодИнфинитум = ПолучитьКодЛицаИнфинитум(СвязанноеЛицо);
		
		Если ЗначениеЗаполнено(КодИнфинитум) Тогда
			
			Отбор = СтрШаблон("(dbo_Infinitum_Related_Companies.Person_Code_1 = ""%1"" OR dbo_Infinitum_Related_Companies.Person_Code_2 = ""%1"")", КодИнфинитум);
			
		Иначе
			
			СведенияОСвязанномЛице = ПолучитьСведенияОСвязанномЛице(СвязанноеЛицо);
			
			Если ТипЗнч(СведенияОСвязанномЛице) = Тип("Структура") Тогда
			
				Отбор = СтрШаблон("(dbo_Infinitum_Related_Companies.VAT_Registration_No_1 = ""%1"" OR dbo_Infinitum_Related_Companies.VAT_Registration_No_2 = ""%1"")", СведенияОСвязанномЛице.ИНН);
					
			Иначе
				
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли; 

	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	dbo_Infinitum_Related_Companies.File_Id КАК File_Id,
		|	dbo_Infinitum_Related_Companies.A109IDAnalit КАК A109IDAnalit,
