		|	_ОбъектыКодовВоВнешнихСистемах.ГруппаОбъектов КАК ГруппаОбъектов,
		|	_ОбъектыКодовВоВнешнихСистемах.Код КАК Код,
		|	_ОбъектыКодовВоВнешнихСистемах.Объект КАК Объект
		|ИЗ
		|	_ОбъектыКодовВоВнешнихСистемах КАК _ОбъектыКодовВоВнешнихСистемах
		|ГДЕ
		|	_ОбъектыКодовВоВнешнихСистемах.Объект <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
	
		Запись = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Записать();
	
	КонецЦикла; 
	
	ЗафиксироватьТранзакцию();		
	#КонецОбласти 
	
	#Область Подготовка_изменений_для_записи
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыИнфинитум
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Период,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Инфинитум)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнешниеДанные.Starting_Date КАК Период,
		|	Организации.Ссылка КАК Организация,
		|	_КодыИнфинитумЮрФизЛицо.Объект КАК ЮрФизЛицо,
		|	_КодыИнфинитумСвязанноеЮрФизЛицо.Объект КАК СвязанноеЮрФизЛицо,
		|	ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум) КАК ТипСвязи,
		|	ИСТИНА КАК Действует
		|ПОМЕСТИТЬ _СвязанныеЛицаНовые
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитумЮрФизЛицо
		|			ПО _ВнешниеДанные.Person_Code_1 = _КодыИнфинитумЮрФизЛицо.Код
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитумСвязанноеЮрФизЛицо
		|			ПО _ВнешниеДанные.Person_Code_2 = _КодыИнфинитумСвязанноеЮрФизЛицо.Код
		|		ПО (Организации.Ссылка В (&МассивОрганизаций))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ВнешниеДанные.Expire_Date,
		|	Организации.Ссылка,
		|	_КодыИнфинитумЮрФизЛицо.Объект,
		|	_КодыИнфинитумСвязанноеЮрФизЛицо.Объект,
		|	ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум),
		|	ЛОЖЬ
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ВнешниеДанные КАК _ВнешниеДанные
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитумЮрФизЛицо
		|			ПО _ВнешниеДанные.Person_Code_1 = _КодыИнфинитумЮрФизЛицо.Код
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитумСвязанноеЮрФизЛицо
		|			ПО _ВнешниеДанные.Person_Code_2 = _КодыИнфинитумСвязанноеЮрФизЛицо.Код
		|		ПО (Организации.Ссылка В (&МассивОрганизаций))
		|			И (_ВнешниеДанные.Expire_Date <> ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.Период, &Период) КАК Период,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.Организация, СвязанныеЛицаТекущие.Организация) КАК Организация,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.ЮрФизЛицо, СвязанныеЛицаТекущие.ЮрФизЛицо) КАК ЮрФизЛицо,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.ТипСвязи, СвязанныеЛицаТекущие.ТипСвязи) КАК ТипСвязи,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.СвязанноеЮрФизЛицо, СвязанныеЛицаТекущие.СвязанноеЮрФизЛицо) КАК СвязанноеЮрФизЛицо,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.Действует, ЛОЖЬ) КАК Действует,
		|	ДАТАВРЕМЯ(1,1,1) КАК ДатаОснования,
		|	ДАТАВРЕМЯ(1,1,1) КАК ДатаВключенияВСписок,
		|	_СвязанныеЛицаНовые.Действует ЕСТЬ NULL КАК Удалить
		|ПОМЕСТИТЬ _ДанныеДляЗаписи
		|ИЗ
		|	_СвязанныеЛицаНовые КАК _СвязанныеЛицаНовые
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СвязанныеЛица.Период КАК Период,
		|			СвязанныеЛица.Организация КАК Организация,
		|			СвязанныеЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|			СвязанныеЛица.ТипСвязи КАК ТипСвязи,
		|			СвязанныеЛица.СвязанноеЮрФизЛицо КАК СвязанноеЮрФизЛицо,
		|			СвязанныеЛица.Действует КАК Действует
		|		ИЗ
		|			РегистрСведений.СвязанныеЛица КАК СвязанныеЛица
		|		ГДЕ
		|			СвязанныеЛица.Организация В(&МассивОрганизаций)
		|			И СвязанныеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)
		|			И &УсловияОтбора) КАК СвязанныеЛицаТекущие
		|		ПО _СвязанныеЛицаНовые.Период = СвязанныеЛицаТекущие.Период
		|			И _СвязанныеЛицаНовые.Организация = СвязанныеЛицаТекущие.Организация
		|			И _СвязанныеЛицаНовые.ЮрФизЛицо = СвязанныеЛицаТекущие.ЮрФизЛицо
		|			И _СвязанныеЛицаНовые.СвязанноеЮрФизЛицо = СвязанныеЛицаТекущие.СвязанноеЮрФизЛицо
		|			И _СвязанныеЛицаНовые.ТипСвязи = СвязанныеЛицаТекущие.ТипСвязи
		|			И _СвязанныеЛицаНовые.Действует = СвязанныеЛицаТекущие.Действует
		|ГДЕ
		|	(_СвязанныеЛицаНовые.Период ЕСТЬ NULL
		|			ИЛИ СвязанныеЛицаТекущие.Период ЕСТЬ NULL)";
	
	Если ЗначениеЗаполнено(СвязанноеЛицо) Тогда
		УсловияОтбора = "(СвязанныеЛица.СвязанноеЮрФизЛицо = &СвязанноеЛицо ИЛИ СвязанныеЛица.ЮрФизЛицо = &СвязанноеЛицо)";
		Запрос.УстановитьПараметр("СвязанноеЛицо", СвязанноеЛицо);
	Иначе
		УсловияОтбора = "ИСТИНА";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбора", УсловияОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();		
	#КонецОбласти 
	
	ЗаписатьИзмененныеДанные(Запрос, Отчет, "Обновление списков связанных лиц из Инфинитум");
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры 

Процедура ИмпортСрезаСвязанныхЛицИнфинитум(Отчет = Неопределено) Экспорт
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация,ЮрЛицо,СвязанноеЛицо");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортСрезаСвязанныхЛицИнфинитум";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	#Область Получение_данных_из_Externals
	// Получаем полный список связанных для дальнейшей обработки
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДата()));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	dbo_Infinitum_Related_Companies.Starting_Date КАК Starting_Date,
		|	dbo_Infinitum_Related_Companies.Type_Dependence КАК Type_Dependence,
		|	dbo_Infinitum_Related_Companies.Influence_through_trust_agreement КАК Influence_through_trust_agreement,
		|	dbo_Infinitum_Related_Companies.Person_Code_1 КАК Person_Code_1,
		|	dbo_Infinitum_Related_Companies.VAT_Registration_No_1 КАК VAT_Registration_No_1,
		|	dbo_Infinitum_Related_Companies.Person_Code_2 КАК Person_Code_2,
		|	dbo_Infinitum_Related_Companies.VAT_Registration_No_2 КАК VAT_Registration_No_2,
		|	dbo_Infinitum_Related_Companies.Share КАК Share
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Infinitum_Related_Companies КАК dbo_Infinitum_Related_Companies";
	
	Запрос.УстановитьПараметр("ДанныеИнфинитум", Запрос.Выполнить().Выгрузить());
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеИнфинитум.Starting_Date КАК Starting_Date,
		|	ДанныеИнфинитум.Type_Dependence КАК Type_Dependence,
		|	ДанныеИнфинитум.Influence_through_trust_agreement КАК Influence_through_trust_agreement,
		|	ДанныеИнфинитум.Person_Code_1 КАК Person_Code_1,
		|	ДанныеИнфинитум.VAT_Registration_No_1 КАК VAT_Registration_No_1,
		|	ДанныеИнфинитум.Person_Code_2 КАК Person_Code_2,
		|	ДанныеИнфинитум.VAT_Registration_No_2 КАК VAT_Registration_No_2,
		|	ДанныеИнфинитум.Share КАК Share
		|ПОМЕСТИТЬ _ДанныеИнфинитум
		|ИЗ
		|	&ДанныеИнфинитум КАК ДанныеИнфинитум";
	
	Запрос.Выполнить();
	
	#КонецОбласти 
	
	// Регистрируем коды во внешних системах
	ЗарегистрироватьКодыИнфинитум(Запрос);
	
	// _ЭмитентыСГоловами - таблица подчиненных и их родительских организаций
	// Считаем родительскими организациями Person_Code_1 по видам связи 16 и 17, а также Person_Code_2 по видам связи 18 и 19
	
	// _Головы_18_19_50 - еще раз отбираем лиц по связям 18 и 19 с долей 50%, но только тех, кто не оказался подчиненным в таблице _ЭмитентыСГоловами 
	// т.е. это те 18 и 19 головы, над которыми точно никого нет по данным Инфинитум. Это нужно для построения таблицы _Подмены
	// Возможны ситуации, когда над юр. лицом есть голова по типу связи 18 с долей 50%, а также одно или несколько лиц по типу связи 19 с долей 50%
	// таким образом получаем, что те, кто стоят выше по типу связи 19 оказываются еще выше, чем 18
	// _Подмены - в эту таблицу помещаем в качестве родителей 19, в качестве подчиненных - 18 с учетом вышесказанного
	// Например, МКБ (код инфинитум 12415), для него есть вышестоящие:
	// Тип связи 18, доля 50, ООО "Концерн "РОССИУМ" (37466)
	// Тип связи 19, доля 50, ООО "РЕГИОН Девелопмент" (12846)
	// Тип связи 19, доля 50, ООО "ХОЛДИНГОВАЯ КОМПАНИЯ "ДОМИНАНТА" (299452)
	// Получается, РД и Доминанта стоят в иерархии выше РОССИУМА, т.е. для МКБ головой будет не РОССИУМ, а РД и Доминанта
	
	// _Головы - заполняется аналогично таблице _ЭмитентыСГоловами, но головная организация не должна попадать в качестве подчиненной в _ЭмитентыСГоловами и _Подмены
	// т.е. это головы, над которыми точно никого нет по данным Инфинитум. От этих голов мы дальше будем строить иерархию вниз

	#Область Подготовка_данных_для_сбора_групп
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_1 КАК Подчиненный,
		|	_ДанныеИнфинитум.Person_Code_2 КАК Родитель,
		|	_ДанныеИнфинитум.Type_Dependence КАК ВидСвязи,
		|	_ДанныеИнфинитум.Share КАК Доля
		|ПОМЕСТИТЬ _ЭмитентыСГоловами
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|ГДЕ
		|	_ДанныеИнфинитум.Type_Dependence В (18, 19)
		|	И _ДанныеИнфинитум.Influence_through_trust_agreement = 2
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_2,
		|	_ДанныеИнфинитум.Person_Code_1,
		|	_ДанныеИнфинитум.Type_Dependence,
		|	_ДанныеИнфинитум.Share
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|ГДЕ
		|	_ДанныеИнфинитум.Type_Dependence В (16, 17)
		|	И _ДанныеИнфинитум.Influence_through_trust_agreement = 2
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Подчиненный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_1 КАК Подчиненный,
		|	_ДанныеИнфинитум.Person_Code_2 КАК Родитель,
		|	_ДанныеИнфинитум.Type_Dependence КАК ВидСвязи
		|ПОМЕСТИТЬ _Головы_18_19_50
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|ГДЕ
		|	_ДанныеИнфинитум.Type_Dependence В (18, 19)
		|	И _ДанныеИнфинитум.Share = ""50.0""
		|	И _ДанныеИнфинитум.Influence_through_trust_agreement = 2
		|	И НЕ _ДанныеИнфинитум.Person_Code_2 В
		|				(ВЫБРАТЬ
		|					_ЭмитентыСГоловами.Подчиненный
		|				ИЗ
		|					_ЭмитентыСГоловами КАК _ЭмитентыСГоловами)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Головы_18_50.Родитель КАК Подчиненный,
		|	Головы_19_50.Родитель КАК Родитель
		|ПОМЕСТИТЬ _Подмены
		|ИЗ
		|	(ВЫБРАТЬ
		|		_Головы_18_19_50.Подчиненный КАК Подчиненный
		|	ИЗ
		|		_Головы_18_19_50 КАК _Головы_18_19_50
		|	ГДЕ
		|		_Головы_18_19_50.ВидСвязи = 18
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_Головы_18_19_50.Подчиненный
		|	
		|	ИМЕЮЩИЕ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Головы_18_19_50.Родитель) = 1) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Головы_18_19_50 КАК Головы_19_50
		|		ПО ВложенныйЗапрос.Подчиненный = Головы_19_50.Подчиненный
		|			И (Головы_19_50.ВидСвязи = 19)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Головы_18_19_50 КАК Головы_18_50
		|		ПО ВложенныйЗапрос.Подчиненный = Головы_18_50.Подчиненный
		|			И (Головы_18_50.ВидСвязи = 18)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_1 КАК Код
		|ПОМЕСТИТЬ _Головы
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|ГДЕ
		|	_ДанныеИнфинитум.Type_Dependence В (16, 17)
		|	И _ДанныеИнфинитум.Influence_through_trust_agreement = 2
		|	И НЕ _ДанныеИнфинитум.Person_Code_1 В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					_ЭмитентыСГоловами.Подчиненный
		|				ИЗ
		|					_ЭмитентыСГоловами КАК _ЭмитентыСГоловами)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_2
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|ГДЕ
		|	_ДанныеИнфинитум.Type_Dependence В (18, 19)
		|	И _ДанныеИнфинитум.Influence_through_trust_agreement = 2
		|	И НЕ _ДанныеИнфинитум.Person_Code_2 В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					_ЭмитентыСГоловами.Подчиненный
		|				ИЗ
		|					_ЭмитентыСГоловами КАК _ЭмитентыСГоловами
		|		
		|				ОБЪЕДИНИТЬ ВСЕ
		|		
		|				ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					_Подмены.Подчиненный
		|				ИЗ
		|					_Подмены КАК _Подмены)";
	#КонецОбласти 
	
	Запрос.Выполнить();
	Подчиненные = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_ЭмитентыСГоловами").ПолучитьДанные().Выгрузить();
	ВыборкаПодмены = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Подмены").ПолучитьДанные().Выбрать();
	ВыборкаРодители = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_Головы").ПолучитьДанные().Выбрать();
	
	#Область Группы_верхнего_уровня
	
	Пока ВыборкаПодмены.Следующий() Цикл
		
		// добавим строки для подмены группы по 18 связям с 50% на родителей по 19 связи с 50%
		ЗаполнитьЗначенияСвойств(Подчиненные.Добавить(), ВыборкаПодмены);
			
	КонецЦикла; 
	
	Подчиненные.Колонки.Добавить("Обработан", Новый ОписаниеТипов("Булево"));
	
	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Подчиненный", 	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	Группы.Колонки.Добавить("Родитель", 	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	Группы.Колонки.Добавить("ЧерезКого", 	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	Группы.Колонки.Добавить("ВидСвязи", 	Новый ОписаниеТипов("Число"));
	
	Пока ВыборкаРодители.Следующий() Цикл
		
		// обходим ВТ _Головы, для каждой головы добавляем всех его прямых подчиненных из ВТ _ЭмитентыСГоловами
		РодителиПоПодчиненному = Подчиненные.НайтиСтроки(Новый Структура("Родитель", ВыборкаРодители.Код));
		
		Для каждого СтрокаПодчиненные Из РодителиПоПодчиненному Цикл
		
			НоваяСтрока = Группы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодчиненные);
			НоваяСтрока.ЧерезКого = ВыборкаРодители.Код;
			
			СтрокаПодчиненные.Обработан = Истина;
			
		КонецЦикла; 
	
	КонецЦикла; 
			
	#КонецОбласти
	
	#Область Подчиненные_группы
	
	// выбираем из таблицы _ЭмитентыСГоловами тех родителей, кто еще не вошел в группы по самым верхним головам
	// т.е. это родители второго уровня
	ТаблицаРодителей = Подчиненные.Скопировать(Новый Структура("Обработан", Ложь), "Родитель, Обработан");
	ТаблицаРодителей.Свернуть("Родитель, Обработан");
	
	ВсегоРодителей = ТаблицаРодителей.Количество();
	ОбработаноРодителей = 0;
	Индекс = 0;
	
	ИскатьВПодчиненных = Ложь;
	
	Пока ОбработаноРодителей < ВсегоРодителей Цикл
		
		// обходим оставшихся родителей. Ищем их среди починенных в уже созданных группах
		СтрокаРодитель = ТаблицаРодителей[Индекс];
		ЧерезКого = СтрокаРодитель.Родитель;
		
		Если ИскатьВПодчиненных Тогда
		
			ИскатьВПодчиненных = Ложь;
			ЗаполнитьГруппуПодчиненными(Группы, Подчиненные, ЧерезКого, ЧерезКого);
			СтрокаРодитель.Обработан = Истина;
			
		Иначе
			
			НайденныеГруппы = Группы.НайтиСтроки(Новый Структура("Подчиненный", ЧерезКого));
			
			Родитель = Неопределено;
			
			Для каждого СтрокаГруппы Из НайденныеГруппы Цикл
				
				// один родитель второго уровня может входить в несколько групп
				// его подчиненные должны войти во все вышестоящие группы
				Если СтрокаГруппы.Родитель <> Родитель Тогда
					 
					Родитель = СтрокаГруппы.Родитель;
					ЗаполнитьГруппуПодчиненными(Группы, Подчиненные, Родитель, ЧерезКого);

				КонецЕсли; 
				
				СтрокаРодитель.Обработан = Истина;
			
			КонецЦикла;			
		
		КонецЕсли; 
		
		Если НайденныеГруппы.Количество() > 0 Тогда
			ОбработаноРодителей = ОбработаноРодителей + 1;
		КонецЕсли; 
		
		Если ОбработаноРодителей < ВсегоРодителей И Индекс + 1 = ВсегоРодителей Тогда
			
			// повтояем тоже самое, т.е. уходим вниз по иерархии
			ТаблицаРодителей = ТаблицаРодителей.Скопировать(Новый Структура("Обработан", Ложь));
			
			Если ТаблицаРодителей.Количество() = ВсегоРодителей Тогда
			
				// алгоритм поиска родителя в существующх группах ничего не дал
				// т.е. это новый родитель верхнего уровня. Создадим его группу
				ИскатьВПодчиненных = Истина;
			
			КонецЕсли; 
			
			ВсегоРодителей = ТаблицаРодителей.Количество();
			ОбработаноРодителей = 0;
			Индекс = 0;
			
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли; 		
			
	КонецЦикла;
			
	#КонецОбласти
	
	#Область Текст_запроса_фильрация_по_юр_лицам_1С
	
	Запрос.УстановитьПараметр("Группы", Группы);
	
	// _Группы1С - оставляем только строки с подчиненными, имеющимися в 1С, при этом наличие родителя в 1С нам не важно.
	// Может быть так, что в 1С нет родителя, но есть несколько его подчиненных. В таком случае мы должны связать их в группу, 
	// где в качестве родителя будет один из участников группы
	// _НеПустыеГруппы - здесь только группы, в которых заполнен родитель или количество участников более одного
	// 
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Группы.Подчиненный КАК Подчиненный,
		|	Группы.Родитель КАК Родитель,
		|	Группы.ВидСвязи КАК ВидСвязи,
		|	Группы.ЧерезКого КАК ЧерезКого
		|ПОМЕСТИТЬ _Группы
		|ИЗ
		|	&Группы КАК Группы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Объект КАК Объект,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ПОМЕСТИТЬ _КодыИнфинитум
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Инфинитум)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Группы.Подчиненный КАК ПодчиненныйКод,
		|	_Группы.Родитель КАК РодительКод,
		|	_КодыИнфинитум_Подчиненный.Объект КАК Подчиненный,
		|	ЕСТЬNULL(_КодыИнфинитум_Родитель.Объект, НЕОПРЕДЕЛЕНО) КАК Родитель
		|ПОМЕСТИТЬ _Группы1С
		|ИЗ
		|	_Группы КАК _Группы
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитум_Родитель
		|		ПО _Группы.Родитель = _КодыИнфинитум_Родитель.Код
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитум_Подчиненный
		|		ПО _Группы.Подчиненный = _КодыИнфинитум_Подчиненный.Код
		|ГДЕ
		|	_КодыИнфинитум_Подчиненный.Код ЕСТЬ НЕ NULL 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Группы1С.ПодчиненныйКод КАК ПодчиненныйКод,
		|	_Группы1С.РодительКод КАК РодительКод,
		|	_Группы1С.Подчиненный КАК Подчиненный,
		|	_Группы1С.Родитель КАК Родитель
		|ПОМЕСТИТЬ _НеПустыеГруппы
		|ИЗ
		|	_Группы1С КАК _Группы1С
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_Группы1С.РодительКод КАК РодительКод
		|		ИЗ
		|			_Группы1С КАК _Группы1С
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_Группы1С.РодительКод
		|		
		|		ИМЕЮЩИЕ
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Группы1С.ПодчиненныйКод) > 1) КАК _НеПустыеГруппы
		|		ПО _Группы1С.РодительКод = _НеПустыеГруппы.РодительКод
		|ГДЕ
		|	(НЕ _НеПустыеГруппы.РодительКод ЕСТЬ NULL
		|			ИЛИ _Группы1С.Родитель <> НЕОПРЕДЕЛЕНО)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_НеПустыеГруппы.ПодчиненныйКод КАК ПодчиненныйКод,
		|	_НеПустыеГруппы.РодительКод КАК РодительКод,
		|	_НеПустыеГруппы.Родитель КАК Родитель,
		|	_НеПустыеГруппы.Подчиненный КАК Подчиненный,
		|	КоличествоГрупп.Количество КАК КоличествоГрупп,
		|	_КоличествоПодчиненных.КоличествоПодчиненных КАК КоличествоПодчиненных
		|ИЗ
		|	_Группы1С КАК _НеПустыеГруппы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_НеПустыеГруппы.РодительКод КАК РодительКод,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _НеПустыеГруппы.ПодчиненныйКод) КАК КоличествоПодчиненных
		|		ИЗ
		|			_НеПустыеГруппы КАК _НеПустыеГруппы
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_НеПустыеГруппы.РодительКод) КАК _КоличествоПодчиненных
		|		ПО _НеПустыеГруппы.РодительКод = _КоличествоПодчиненных.РодительКод
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			_НеПустыеГруппы.ПодчиненныйКод КАК ПодчиненныйКод,
		|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _НеПустыеГруппы.РодительКод) КАК Количество
		|		ИЗ
		|			_НеПустыеГруппы КАК _НеПустыеГруппы
		|		
		|		СГРУППИРОВАТЬ ПО
		|			_НеПустыеГруппы.ПодчиненныйКод) КАК КоличествоГрупп
		|		ПО _НеПустыеГруппы.ПодчиненныйКод = КоличествоГрупп.ПодчиненныйКод
		|
		|УПОРЯДОЧИТЬ ПО
		|	КоличествоПодчиненных УБЫВ,
		|	КоличествоГрупп УБЫВ";		
	#КонецОбласти 
	
	ВходящиеВНесколькоГрупп = Запрос.Выполнить().Выгрузить();
	ВходящиеВНесколькоГрупп.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка"));
	
	#Область Объединение_групп
	// Если не задан родитель и одна группа полностью входит в другую - ее можно удалить
	
	Для каждого Строка Из ВходящиеВНесколькоГрупп Цикл
		
		Если ЗначениеЗаполнено(Строка.Действие) И Строка.КоличествоГрупп = 1 Тогда
			// эту строку уже обработали
			Продолжить;
		КонецЕсли; 
		
		//Если Строка.КоличествоПодчиненных = 1 И Родитель = Неопределено Тогда
		//	если группа из одного, либо мы ее включим в другую, либо она так и останется из одного
		//	позже к этой группе может присоединиться кто-то еще по связям 14 и 15
		//	УСТАРЕЛО:
		//	// если один подчиненный и родитель не задан - смысла в группе нет, удаляем
		//	// на самом деле этот вариант был отсечен еще на этапе запроса, но заглушка осталась на всякий случай
		//	Строка.Действие = "Удалить запись";
		//	
		//Иначе
		Если Строка.Родитель <> Неопределено Или Строка.КоличествоГрупп = 1 Тогда 
			
			// если задан родитель - группа составлена, она не может войти ни в какую другую
			// если эмитент входит в одну группу - объединять не с кем
			Строка.Действие = "Ничего не делаем";
			
		ИначеЕсли Строка.Родитель = Неопределено И Строка.КоличествоГрупп > 1 Тогда
			
			// такую группу можно объединить, если она полностью входит в какую-либо другую группу
			РодителиПоПодчиненному = ВходящиеВНесколькоГрупп.НайтиСтроки(Новый Структура("ПодчиненныйКод", Строка.ПодчиненныйКод));
			СоответствиеГрупп = Новый Массив;
			
			Для каждого СтрокаРодители Из РодителиПоПодчиненному Цикл
				
				СтрокиГруппы = ВходящиеВНесколькоГрупп.НайтиСтроки(Новый Структура("РодительКод", СтрокаРодители.РодительКод));
				СоставГруппы = ВходящиеВНесколькоГрупп.Скопировать(СтрокиГруппы).ВыгрузитьКолонку("ПодчиненныйКод");
				СоответствиеГрупп.Добавить(Новый Структура("Родитель, Состав, Строки, Действие", СтрокаРодители.РодительКод, СоставГруппы, СтрокиГруппы, ""));
			
			КонецЦикла; 
			
			Для Индекс = 0 По СоответствиеГрупп.ВГраница() Цикл
			
				Для Индекс2 = Индекс + 1 По СоответствиеГрупп.ВГраница() Цикл
				
					ПерваяГруппа = СоответствиеГрупп[Индекс];
					ВтораяГруппа = СоответствиеГрупп[Индекс2];
					
					Если РаботаСКоллекциями.ЭлементыПервогоСпискаВходятВоВторойСписок(ВтораяГруппа.Состав, ПерваяГруппа.Состав) Тогда
					
						ВтораяГруппа.Действие = "Включить в '" + ПерваяГруппа.Родитель + "'";
						
					Иначе 
						
						ВтораяГруппа.Действие = "Не удалось включить в группу '" + ПерваяГруппа.Родитель + "'";
					
					КонецЕсли;
				
				КонецЦикла; 
			
			КонецЦикла; 
			
			Для каждого Группа Из СоответствиеГрупп Цикл
			
				Если ЗначениеЗаполнено(Группа.Действие) Тогда
				
					Для каждого ИсходнаяСтрока Из Группа.Строки Цикл
						Если СтрНайти(ИсходнаяСтрока.Действие, Группа.Действие) = 0 Тогда
							Если ИсходнаяСтрока.Действие = "" Тогда
								ИсходнаяСтрока.Действие = Группа.Действие;
							Иначе
								ИсходнаяСтрока.Действие = ИсходнаяСтрока.Действие + Символы.ПС + Группа.Действие;
							КонецЕсли; 
						КонецЕсли; 
					КонецЦикла; 
				
				КонецЕсли; 
			
			КонецЦикла; 
		
		//Иначе
		//	
		//	Строка.Действие = "Разобраться";
			
		КонецЕсли; 
	
	КонецЦикла;
	
	#КонецОбласти 
	
	#Область Добавляем_ассоциированные_и_совместный_контроль
	
	// _ГруппыСРодителем - добавляем родителя в состав группы в качестве подчиненного, далее по подчиненным будем брать записи из таблицы _ПрочиеСвязи
	// 
	
	Запрос.УстановитьПараметр("ВходящиеВНесколькоГрупп", ВходящиеВНесколькоГрупп);
	Запрос.УстановитьПараметр("ПрочиеСвязиВДвеСтороны", Ложь);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящиеВНесколькоГрупп.ПодчиненныйКод КАК ПодчиненныйКод,
		|	ВходящиеВНесколькоГрупп.РодительКод КАК РодительКод,
		|	ВходящиеВНесколькоГрупп.Подчиненный КАК Подчиненный,
		|	ВходящиеВНесколькоГрупп.Родитель КАК Родитель,
		|	ВходящиеВНесколькоГрупп.Действие КАК Действие
		|ПОМЕСТИТЬ _ВходящиеВНесколькоГрупп
		|ИЗ
		|	&ВходящиеВНесколькоГрупп КАК ВходящиеВНесколькоГрупп
		|ГДЕ
		|	ПОДСТРОКА(ВходящиеВНесколькоГрупп.Действие, 1, 8) <> ""Включить""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_1 КАК Person_Code_1,
		|	_ДанныеИнфинитум.Person_Code_2 КАК Person_Code_2
		|ПОМЕСТИТЬ _ПрочиеСвязи
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|ГДЕ
		|	_ДанныеИнфинитум.Type_Dependence В (14, 15)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВходящиеВНесколькоГрупп.ПодчиненныйКод КАК ПодчиненныйКод,
		|	_ВходящиеВНесколькоГрупп.РодительКод КАК РодительКод,
		|	_ВходящиеВНесколькоГрупп.Подчиненный КАК Подчиненный,
		|	_ВходящиеВНесколькоГрупп.Родитель КАК Родитель
		|ПОМЕСТИТЬ _ГруппыСРодителем
		|ИЗ
		|	_ВходящиеВНесколькоГрупп КАК _ВходящиеВНесколькоГрупп
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ВходящиеВНесколькоГрупп.РодительКод,
		|	_ВходящиеВНесколькоГрупп.РодительКод,
		|	_ВходящиеВНесколькоГрупп.Родитель,
		|	_ВходящиеВНесколькоГрупп.Родитель
		|ИЗ
		|	_ВходящиеВНесколькоГрупп КАК _ВходящиеВНесколькоГрупп
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ГруппыСРодителем.РодительКод КАК РодительКод,
		|	ВЫБОР
		|		КОГДА _ГруппыСРодителем.ПодчиненныйКод = _ПрочиеСвязи.Person_Code_1
		|			ТОГДА _ПрочиеСвязи.Person_Code_2
		|		ИНАЧЕ _ПрочиеСвязи.Person_Code_1
		|	КОНЕЦ КАК ПодчиненныйКод,
		|	_ГруппыСРодителем.Родитель КАК Родитель
		|ПОМЕСТИТЬ _ПрочиеСвязанные
		|ИЗ
		|	_ГруппыСРодителем КАК _ГруппыСРодителем
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПрочиеСвязи КАК _ПрочиеСвязи
		|		ПО (_ГруппыСРодителем.ПодчиненныйКод = _ПрочиеСвязи.Person_Code_1
		|				ИЛИ (&ПрочиеСвязиВДвеСтороны И _ГруппыСРодителем.ПодчиненныйКод = _ПрочиеСвязи.Person_Code_2))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВходящиеВНесколькоГрупп.ПодчиненныйКод КАК ПодчиненныйКод,
		|	_ВходящиеВНесколькоГрупп.РодительКод КАК РодительКод,
		|	_ВходящиеВНесколькоГрупп.Подчиненный КАК Подчиненный,
		|	_ВходящиеВНесколькоГрупп.Родитель КАК Родитель
		|ПОМЕСТИТЬ _ПолныеГруппы
		|ИЗ
		|	_ВходящиеВНесколькоГрупп КАК _ВходящиеВНесколькоГрупп
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ПрочиеСвязанные.ПодчиненныйКод,
		|	_ПрочиеСвязанные.РодительКод,
		|	_КодыИнфинитум_Подчиненный.Объект,
		|	_ПрочиеСвязанные.Родитель
		|ИЗ
		|	_ПрочиеСвязанные КАК _ПрочиеСвязанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КодыИнфинитум КАК _КодыИнфинитум_Подчиненный
		|		ПО _ПрочиеСвязанные.ПодчиненныйКод = _КодыИнфинитум_Подчиненный.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ПолныеГруппы.ПодчиненныйКод КАК ПодчиненныйКод,
		|	_ПолныеГруппы.РодительКод КАК РодительКод,
		|	_ПолныеГруппы.Подчиненный КАК Подчиненный,
		|	_ПолныеГруппы.Родитель КАК Родитель,
		|	_Группы.ВидСвязи КАК ВидСвязи
		|ИЗ
		|	_ПолныеГруппы КАК _ПолныеГруппы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Группы КАК _Группы
		|		ПО (_ПолныеГруппы.Родитель = НЕОПРЕДЕЛЕНО)
		|			И _ПолныеГруппы.ПодчиненныйКод = _Группы.Подчиненный
		|
		|УПОРЯДОЧИТЬ ПО
		|	РодительКод,
		|	ВидСвязи УБЫВ,
		|	ПодчиненныйКод";
	
	#КонецОбласти 
	
	#Область Подбор_родителей
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаПоискаРодителей = РезультатЗапроса.Выбрать();
	
	ПолныеГруппы = СистемныеФункции.ПолучитьДанныеВременнойТаблицыЗапроса(Запрос, "_ПолныеГруппы").Выгрузить();
	
	Пока ВыборкаПоискаРодителей.СледующийПоЗначениюПоля("РодительКод") Цикл
	
		НайденныеСтроки = ПолныеГруппы.НайтиСтроки(Новый Структура("РодительКод", ВыборкаПоискаРодителей.РодительКод));
		Для каждого Строка Из НайденныеСтроки Цикл
		
			Строка.РодительКод = ВыборкаПоискаРодителей.ПодчиненныйКод;
			Строка.Родитель = ВыборкаПоискаРодителей.Подчиненный;
		
		КонецЦикла; 
	
	КонецЦикла;
	
	#КонецОбласти 
	
	#Область Запись_данных_в_регистр
	
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	МассивОрганизаций.Добавить(ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ"));
	Запрос.УстановитьПараметр("МассивОрганизаций", МассивОрганизаций);
	Запрос.УстановитьПараметр("ПолныеГруппы", ПолныеГруппы);
	Запрос.УстановитьПараметр("Период", '19800101');
	
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _ПолныеГруппы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПолныеГруппы.Родитель КАК ЮрФизЛицо,
		|	ПолныеГруппы.Подчиненный КАК СвязанноеЮрФизЛицо
		|ПОМЕСТИТЬ _ПолныеГруппы
		|ИЗ
		|	&ПолныеГруппы КАК ПолныеГруппы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	_ПолныеГруппы.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ПолныеГруппы.СвязанноеЮрФизЛицо КАК СвязанноеЮрФизЛицо,
		|	&Период КАК Период,
		|	ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум) КАК ТипСвязи,
		|	ИСТИНА КАК Действует,
		|	ЛОЖЬ КАК Удалить
		|ПОМЕСТИТЬ _СвязанныеЛицаНовые
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПолныеГруппы КАК _ПолныеГруппы
		|		ПО (Организации.Ссылка В (&МассивОрганизаций))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.Период, &Период) КАК Период,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.Организация, СвязанныеЛицаТекущие.Организация) КАК Организация,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.ЮрФизЛицо, СвязанныеЛицаТекущие.ЮрФизЛицо) КАК ЮрФизЛицо,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.ТипСвязи, СвязанныеЛицаТекущие.ТипСвязи) КАК ТипСвязи,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.СвязанноеЮрФизЛицо, СвязанныеЛицаТекущие.СвязанноеЮрФизЛицо) КАК СвязанноеЮрФизЛицо,
		|	ЕСТЬNULL(_СвязанныеЛицаНовые.Действует, ЛОЖЬ) КАК Действует,
		|	ДАТАВРЕМЯ(1,1,1) КАК ДатаОснования,
		|	ДАТАВРЕМЯ(1,1,1) КАК ДатаВключенияВСписок,
		|	_СвязанныеЛицаНовые.Действует ЕСТЬ NULL КАК Удалить
		|ПОМЕСТИТЬ _ДанныеДляЗаписи
		|ИЗ
		|	_СвязанныеЛицаНовые КАК _СвязанныеЛицаНовые
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СвязанныеЛица.Период КАК Период,
		|			СвязанныеЛица.Организация КАК Организация,
		|			СвязанныеЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|			СвязанныеЛица.ТипСвязи КАК ТипСвязи,
		|			СвязанныеЛица.СвязанноеЮрФизЛицо КАК СвязанноеЮрФизЛицо,
		|			СвязанныеЛица.Действует КАК Действует
		|		ИЗ
		|			РегистрСведений.СвязанныеЛица КАК СвязанныеЛица
		|		ГДЕ
		|			СвязанныеЛица.Организация В(&МассивОрганизаций)
		|			И СвязанныеЛица.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)) КАК СвязанныеЛицаТекущие
		|		ПО _СвязанныеЛицаНовые.Период = СвязанныеЛицаТекущие.Период
		|			И _СвязанныеЛицаНовые.Организация = СвязанныеЛицаТекущие.Организация
		|			И _СвязанныеЛицаНовые.ЮрФизЛицо = СвязанныеЛицаТекущие.ЮрФизЛицо
		|			И _СвязанныеЛицаНовые.СвязанноеЮрФизЛицо = СвязанныеЛицаТекущие.СвязанноеЮрФизЛицо
		|			И _СвязанныеЛицаНовые.ТипСвязи = СвязанныеЛицаТекущие.ТипСвязи
		|			И _СвязанныеЛицаНовые.Действует = СвязанныеЛицаТекущие.Действует
		|ГДЕ
		|	(_СвязанныеЛицаНовые.Период ЕСТЬ NULL
		|			ИЛИ СвязанныеЛицаТекущие.Период ЕСТЬ NULL)";
	
	РезультатЗапроса = Запрос.Выполнить();		
	
	ЗаписатьИзмененныеДанные(Запрос, Отчет, "Обновление списков связанных лиц из Инфинитум");
	
	#КонецОбласти 
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура ЗаписатьИзмененныеДанные(Запрос, Отчет, Тема)

	ОтправитьОповещение = Ложь;
	
	Если Отчет = Неопределено Тогда
		
		Отчет = Новый ТабличныйДокумент;
		ОтправитьОповещение = Истина;
		
	КонецЕсли;
	
	Макет = ПолучитьМакет("Отчет");
	ОбластьЗаголовок 		= Макет.ПолучитьОбласть("ЗаголовокОтчета");
	ОбластьШапкаТаблицы 	= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрокаТаблицы 	= Макет.ПолучитьОбласть("СтрокаТаблицы");
	ОбластьПодвалТаблицы 	= Макет.ПолучитьОбласть("ПодвалТаблицы");

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА _ДанныеДляЗаписи.Удалить
		|					ТОГДА 1
		|				ИНАЧЕ 0
		|			КОНЕЦ), 0) КАК Удалено,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА _ДанныеДляЗаписи.Удалить
		|					ТОГДА 0
		|				ИНАЧЕ ВЫБОР
		|						КОГДА _ДанныеДляЗаписи.Действует
		|							ТОГДА 1
		|						ИНАЧЕ 0
		|					КОНЕЦ
		|			КОНЕЦ), 0) КАК ВключеноВСписок,
		|	ЕСТЬNULL(СУММА(ВЫБОР
		|				КОГДА _ДанныеДляЗаписи.Удалить
		|					ТОГДА 0
		|				ИНАЧЕ ВЫБОР
		|						КОГДА _ДанныеДляЗаписи.Действует
		|							ТОГДА 0
		|						ИНАЧЕ 1
		|					КОНЕЦ
		|			КОНЕЦ), 0) КАК ИсключеноИзСписка
		|ИЗ
		|	_ДанныеДляЗаписи КАК _ДанныеДляЗаписи";
	ДанныеШапки = Запрос.Выполнить().Выбрать();
	
	ДанныеШапки.Следующий();
	ОбластьЗаголовок.Параметры.Заполнить(ДанныеШапки);
	ОбластьЗаголовок.Параметры.ДатаОбновления = ТекущаяДата();
	Отчет.Вывести(ОбластьЗаголовок);	
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДляЗаписи.Период КАК Период,
		|	_ДанныеДляЗаписи.Организация КАК Организация,
		|	_ДанныеДляЗаписи.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ДанныеДляЗаписи.ТипСвязи КАК ТипСвязи,
		|	_ДанныеДляЗаписи.СвязанноеЮрФизЛицо КАК СвязанноеЮрФизЛицо,
		|	_ДанныеДляЗаписи.ДатаОснования КАК ДатаОснования,
		|	_ДанныеДляЗаписи.ДатаВключенияВСписок КАК ДатаВключенияВСписок,
		|	_ДанныеДляЗаписи.Действует КАК Действует,
		|	_ДанныеДляЗаписи.Удалить КАК Удалить
		|ИЗ
		|	_ДанныеДляЗаписи КАК _ДанныеДляЗаписи
		|
		|УПОРЯДОЧИТЬ ПО
		|	_ДанныеДляЗаписи.Организация,
		|	_ДанныеДляЗаписи.ЮрФизЛицо,
		|	_ДанныеДляЗаписи.СвязанноеЮрФизЛицо,
		|	_ДанныеДляЗаписи.Удалить УБЫВ,
		|	_ДанныеДляЗаписи.Период";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Если Выборка.Количество() > 0 Тогда
		Отчет.Вывести(ОбластьШапкаТаблицы);
	КонецЕсли; 
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ТипСвязи) Тогда
			
			Запись = РегистрыСведений.СвязанныеЛица.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			
			Если Выборка.Удалить Тогда
				Запись.Удалить();
				ОбластьСтрокаТаблицы.Параметры.Действие = "Удалена запись " + ?(Выборка.Действует, "о вхождении в список", "об исключении из списка");
			Иначе
				Запись.Записать();
				ОбластьСтрокаТаблицы.Параметры.Действие = ?(Выборка.Действует, "Включен в список", "Исключен из списка");
			КонецЕсли; 	
			
			ОбластьСтрокаТаблицы.Область(1, 1, 1, 7).ЦветТекста = Новый Цвет();
			
		Иначе
			
			ОбластьСтрокаТаблицы.Параметры.Действие = "Ошибка обновления данных";
			ОбластьСтрокаТаблицы.Область(1, 1, 1, 7).ЦветТекста = Новый Цвет(255, 0, 0);
		
		КонецЕсли;
		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(Выборка);		
		Отчет.Вывести(ОбластьСтрокаТаблицы);
		
	КонецЦикла; 
	
	Если Выборка.Количество() > 0 Тогда
		
		Отчет.Вывести(ОбластьПодвалТаблицы);
		Если ОтправитьОповещение Тогда
			ОтправитьОповещение(Отчет, Тема);
		КонецЕсли; 
		
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();

КонецПроцедуры

Функция ПолучитьКодЛицаИнфинитум(СвязанноеЛицо)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			,
		|			ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Инфинитум)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)
		|				И Объект = &Объект) КАК КодыВоВнешнихСистемахСрезПоследних";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект", СвязанноеЛицо);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		Возврат Выборка.Код;
	
	КонецЕсли;	 

КонецФункции
 
Процедура ОтправитьОповещение(Отчет, Тема)

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("html");
	
	Отчет.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяВременногоФайла);
	
	ТекстПисьма = ТелоПисьма.ПолучитьТекст();
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	РеквизитыОповещения = Новый Структура("Текст, Тема", ТекстПисьма, Тема);
	Справочники.Оповещения.СформироватьОповещения("Обработка._УправлениеСвязаннымиЛицами", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры

Процедура ЗаменитьКавычкиУдалитьПробелы(Строка, Кэш, МассивЗамен)

	Значение = Кэш.Получить(Строка);
	Если Значение = Неопределено Тогда
		
		ИсходнаяСтрока = Строка;
		
		Для Каждого ЭлементЗамены Из МассивЗамен Цикл
			Строка = СтрЗаменить(Строка, ЭлементЗамены, """");
		КонецЦикла;
		
		Пока СтрНайти(Строка, "  ") > 0 Цикл
			Строка = СтрЗаменить(Строка, "  ", " ");
		КонецЦикла;	
		
		Строка = СокрЛП(Строка);
		
	    Кэш.Вставить(ИсходнаяСтрока, Строка);
		
	Иначе
		
		Строка = Значение;
		
	КонецЕсли;

КонецПроцедуры

