		|	dbo_Infinitum_Related_Companies.KPP_Code_1 КАК KPP_Code_1,
		|	dbo_Infinitum_Related_Companies.Person_Name_1 КАК Person_Name_1,
		|	dbo_Infinitum_Related_Companies.Person_Name_Short_1 КАК Person_Name_Short_1,
