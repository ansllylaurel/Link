// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Управление связанными лицами",
		"1.32",
		"",
		Истина
	);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортСведенийОСвязанныхЛицах", "Импорт сведений о связанных лицах",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортСвязанныхЛицИнфинитум", "Импорт связанных лиц Инфинитум",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортСрезаСвязанныхЛицИнфинитум", "Импорт среза связанных лиц Инфинитум",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортСвязанныхЛицИзXML", "Импорт связанных лиц из XML",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
		
	Если ИдентификаторКоманды = "ИмпортСведенийОСвязанныхЛицах" Тогда
		ИмпортироватьСведенияОСвязанныхЛицах();
	ИначеЕсли ИдентификаторКоманды = "ИмпортСвязанныхЛицИнфинитум" Тогда
		ИмпортСвязанныхЛицИнфинитум();
	ИначеЕсли ИдентификаторКоманды = "ИмпортСрезаСвязанныхЛицИнфинитум" Тогда
		ИмпортСрезаСвязанныхЛицИнфинитум();
	ИначеЕсли ИдентификаторКоманды = "ИмпортСвязанныхЛицИзXML" Тогда
		// Параметры команды: Организация, ИмяКаталога
		ИмпортСвязанныхЛицИзXML(ПараметрыКоманды);
	КонецЕсли;
	
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры

Процедура ИмпортироватьСведенияОСвязанныхЛицах(Организация = Неопределено, ЮрЛицо = Неопределено, СвязанноеЛицо = Неопределено, Отчет = Неопределено) Экспорт

	ИменаПараметров = "Организация,ЮрЛицо,СвязанноеЛицо";
	Параметры = Новый Структура(ИменаПараметров, Организация, ЮрЛицо, СвязанноеЛицо);
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Параметры, ИменаПараметров);
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортироватьСведенияОСвязанныхЛицах";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	Отборы = Новый Массив;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Отборы.Добавить("rc.matrix_organization_id = " + ПолучитьКодМатрих(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо")));
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЮрЛицо) Тогда
		Отборы.Добавить("rc.matrix_firm_id = " + ПолучитьКодМатрих(ЮрЛицо));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвязанноеЛицо) Тогда
		
		ВидЮрФизЛица = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СвязанноеЛицо, "ВидЮрФизЛица");
		
		Если ВидЮрФизЛица = Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
			
			Описание = "Импорт сведений для физических лиц не требуется";
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , Описание);
			Возврат;
		
		КонецЕсли;
		
		СведенияОСвязанномЛице = ПолучитьСведенияОСвязанномЛице(СвязанноеЛицо);
		Если ТипЗнч(СведенияОСвязанномЛице) = Тип("Структура") Тогда
		
			Отборы.Добавить(СтрШаблон("((rc.INN = %1 AND rc.OGRN = %2) OR rc.name in (%3))", 
				СведенияОСвязанномЛице.ИНН,
				СведенияОСвязанномЛице.ОГРН,
				СведенияОСвязанномЛице.Наименование));
				
		Иначе
			
			ТекстОшибки = "Не удалось получить реквизиты связанного лица";
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , , ТекстОшибки);
			Возврат;
			
		КонецЕсли; 

	КонецЕсли; 
	
	#Область Текст_запроса_к_Externals
	
	ТекстЗапроса = 
		"SELECT DISTINCT
		|	rc.matrix_organization_id,
		|	rc.matrix_firm_id, 
		|	CAST(rc.date AS DateTime) date,
		|	rc.INN, 
		|	rc.OGRN, 
		|	rc.name, 
		|	CAST(rc.date_from AS DateTime) date_from, 
		|	CAST(rc.date_basement AS DateTime) date_basement, 
		|	rc.comment, 
		|	rc.relation
		|FROM Externals.dbo.Related_Companies rc
		|WHERE 1=1";
	
	#КонецОбласти 
	
	Если Отборы.Количество() > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "1=1", СтрСоединить(Отборы, " AND "));
	КонецЕсли; 
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("date", 					Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("matrix_organization_id", 	Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТипыКолонок.Вставить("matrix_firm_id", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТипыКолонок.Вставить("INN", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("OGRN", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("name", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("date_from", 				Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("date_basement", 			Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("comment", 				Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("relation", 				Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	
	СтрокаСоединения = СтрокаСоединения();
	ДополнительныеПараметры = Новый Структура("ВозвращатьПустуюТаблицу", Истина);
	ВнешниеДанные = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок,, ДополнительныеПараметры);
	
	Если ВнешниеДанные = Неопределено Тогда
		ТекстОшибки = "Произошла исключительная ситуация при получении таблицы. Информация об ошибке зарегистрирована функцией ADODBC_ПолучитьТаблицуДанныхССервера";
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , , ТекстОшибки);
		Возврат;
	Иначе
		
		МассивПолейДляОбработки = СтрРазделить("INN,OGRN,name,comment,relation", ",");
		
		МассивЗамен = Новый Массив;

		МассивЗамен.Добавить("«");
		МассивЗамен.Добавить("»");
		МассивЗамен.Добавить("“");
		МассивЗамен.Добавить("”");
		МассивЗамен.Добавить("‘‘");
		МассивЗамен.Добавить("’’");
		
		Кэш = Новый Соответствие;
		
		СоответствиеТиповСвязей = СоответствиеТиповСвязей();

		ВнешниеДанные.Колонки.Добавить("ТипСвязи", Новый ОписаниеТипов("СправочникСсылка.ТипыСвязейЮрФизЛиц"));
		
		ОшибкиТиповСвязей = Новый Массив;
		
		Для каждого Строка Из ВнешниеДанные Цикл
		
			Для каждого ИмяПоля Из МассивПолейДляОбработки Цикл
			
				ЗаменитьКавычкиУдалитьПробелы(Строка[ИмяПоля], Кэш, МассивЗамен);
				
				Если ИмяПоля = "relation" Тогда
					
					Если Строка.matrix_organization_id = Строка.matrix_firm_id И ЗначениеЗаполнено(Строка.relation) Тогда
						
						ТипСвязи = СоответствиеТиповСвязей.Получить(Строка.relation);
		
						Если ТипСвязи = Неопределено И ОшибкиТиповСвязей.Найти(Строка.relation) = Неопределено Тогда
							ОшибкиТиповСвязей.Добавить(Строка.relation);
						Иначе
							Строка.ТипСвязи = ТипСвязи;
						КонецЕсли;
						
					Иначе
						
						Строка.ТипСвязи = Справочники.ТипыСвязейЮрФизЛиц.Клиентские;
						
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла; 
		КонецЦикла;
		
		Если ОшибкиТиповСвязей.Количество() > 0 Тогда
			
			Если ОшибкиТиповСвязей.Количество() = 1 Тогда
				ТекстСообщения = "Не задано соответствие для типа связи " + ОшибкиТиповСвязей[0];
			Иначе
				ТекстСообщения = "Не задано соответствие для типов связей:" + Символы.ПС + СтрСоединить(ОшибкиТиповСвязей, Символы.ПС);
			КонецЕсли; 
			
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ТекстСообщения, Механизм, , Сессия);
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , , ТекстСообщения);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Отчет = Неопределено;
			Возврат;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	#Область Текст_запроса
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнешниеДанные.matrix_organization_id КАК КодОрганизации,
		|	ВнешниеДанные.matrix_firm_id КАК КодЮрЛица,
		|	ВнешниеДанные.date КАК Дата,
		|	ВЫБОР
		|		КОГДА ВнешниеДанные.INN В (&ПустыеЗначенияКодов)
		|			ТОГДА """"
		|		ИНАЧЕ ВнешниеДанные.INN
		|	КОНЕЦ КАК ИНН,
		|	ВЫБОР
		|		КОГДА ВнешниеДанные.OGRN В (&ПустыеЗначенияКодов)
		|			ТОГДА """"
		|		ИНАЧЕ ВнешниеДанные.OGRN
		|	КОНЕЦ КАК ОГРН,
		|	ЕСТЬNULL(ВнешниеДанные.name, """") КАК Наименование,
		|	ВЫБОР
		|		КОГДА ВнешниеДанные.date_from = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ВнешниеДанные.date_basement
		|		ИНАЧЕ ВнешниеДанные.date_from
		|	КОНЕЦ КАК ДатаВключения,
		|	ВЫБОР
		|		КОГДА ВнешниеДанные.date_basement = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ВнешниеДанные.date_from
		|		ИНАЧЕ ВнешниеДанные.date_basement
		|	КОНЕЦ КАК ДатаОснования,
		|	ВнешниеДанные.comment КАК Комментарий,
		|	ВнешниеДанные.ТипСвязи КАК ТипСвязи
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	&ВнешниеДанные КАК ВнешниеДанные
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИНН,
		|	ОГРН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	ЕСТЬNULL(ДокументыЮридическихЛицСрезПоследних.Номер, """") КАК ОГРН,
		|	РеквизитыЮридическихЛицСрезПоследних.TIN КАК TIN,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу + РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу + РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК Наименование
		|ПОМЕСТИТЬ _ГоловныеОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо) КАК ГоловнаяОрганизация
		|		ИЗ
		|			РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних КАК СвязанныеЮридическиеЛицаСрезПоследних
		|				ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|					И (СвязанныеЮридическиеЛицаСрезПоследних.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|					И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)) КАК ГоловныеОрганизации
