#Область Выгрузка_в_Externals

Функция ВыгрузитьДанныеВExternals(Контекст) Экспорт

	ТаблицаИмпортируемыхДанных = Контекст.ТаблицаИмпортируемыхДанных;
	
	Если ТаблицаИмпортируемыхДанных.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения());
	РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, "SET LANGUAGE Russian;");
	
	СтрокиКОбновлению = Новый Массив;
	СтрокиКДобавлению = Новый Массив;
	ПакетЗапросов = Неопределено;
	СтрокиКУдалению = Новый Массив;
	
	Для каждого Строка Из ТаблицаИмпортируемыхДанных Цикл
		
		Если Строка.Действие = "Взять из файла" И ЗначениеЗаполнено(Строка.id) Тогда
			// обновляем записи
			
			ТекстЗапросаОбновления = 
				"SELECT 
				|	id = &id,
				|	date = &date,
				|	matrix_organization_id = &matrix_organization_id,
				|	matrix_firm_id = &matrix_firm_id,
				|	INN = &INN,
				|	OGRN = &OGRN,
				|	name = &name,
				|	date_from = &date_from,
				|	comment = &comment,
				|	relation = &relation,
				|	date_basement = &date_basement";
			
			ПодставитьОбщиеЗначенияВЗапрос(ТекстЗапросаОбновления, Контекст);
			
			Для каждого Колонка Из ТаблицаИмпортируемыхДанных.Колонки Цикл
				
				Если Не Колонка.Имя = "Действие" Тогда
					ПодставитьЗначениеКолонкиВЗапрос(ТекстЗапросаОбновления, Колонка.Имя, Строка[Колонка.Имя]);
				КонецЕсли; 
								
			КонецЦикла;
			
			СтрокиКОбновлению.Добавить(ТекстЗапросаОбновления);
			
		ИначеЕсли Строка.Действие = "Взять из файла" Тогда 
			// добавляем записи
			
			ТекстЗапросаДобавления = "(&date, &matrix_organization_id, &matrix_firm_id, &INN, &OGRN, &name, &date_from, &comment, &relation, &date_basement)";
			
			ПодставитьОбщиеЗначенияВЗапрос(ТекстЗапросаДобавления, Контекст);
			
			Для каждого Колонка Из ТаблицаИмпортируемыхДанных.Колонки Цикл
				
				Если Не (Колонка.Имя = "Действие" Или Колонка.Имя = "id") Тогда
					ПодставитьЗначениеКолонкиВЗапрос(ТекстЗапросаДобавления, Колонка.Имя, Строка[Колонка.Имя]);
				КонецЕсли; 
								
			КонецЦикла;
			
			Если ПакетЗапросов = Неопределено Или ПакетЗапросов.Количество() > 999 Тогда
				ПакетЗапросов = Новый Массив;
				СтрокиКДобавлению.Добавить(ПакетЗапросов);
			КонецЕсли; 
			
			ПакетЗапросов.Добавить(ТекстЗапросаДобавления);
			
		ИначеЕсли Строка.Действие = "Удалить" Тогда
			// удаляем записи
			
			СтрокиКУдалению.Добавить("'" + Формат(Строка.id, "ЧГ=0") + "'");
			
		КонецЕсли;
			
	КонецЦикла;
	
	ДопПараметры = Новый Структура("РежимБезУведомлений");
	
	Если СтрокиКОбновлению.Количество() > 0 Тогда
	                 
		ТекстЗапросаОбновления = 
			"UPDATE r
			|SET date = t.date,
			|matrix_organization_id = t.matrix_organization_id,
			|matrix_firm_id = t.matrix_firm_id,
			|INN = t.INN,
			|OGRN = t.OGRN,
			|name = t.name,
			|date_from = t.date_from,
			|comment = t.comment,
			|relation = t.relation,
			|date_basement = t.date_basement
			|FROM [Externals].[dbo].[Related_Companies] r
			|JOIN (
			|    &Подзапрос
			|) t ON t.id = r.id";
		
		ТекстЗапросаОбновления = СтрЗаменить(ТекстЗапросаОбновления, "&Подзапрос", СтрСоединить(СтрокиКОбновлению, Символы.ПС + "UNION ALL" + Символы.ПС));
		РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапросаОбновления, ДопПараметры);
	
	КонецЕсли; 
	
	Если СтрокиКДобавлению.Количество() > 0 Тогда
	
		Для каждого ПакетЗапросов Из СтрокиКДобавлению Цикл
		
			ТекстЗапросаДобавления = 
				"INSERT INTO [Externals].[dbo].[Related_Companies] (date, matrix_organization_id, matrix_firm_id, INN, OGRN, name, date_from, comment, relation, date_basement)
				|VALUES &Значения";
			
			ТекстЗапросаДобавления = СтрЗаменить(ТекстЗапросаДобавления, "&Значения", СтрСоединить(ПакетЗапросов, ", " + Символы.ПС));
			РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапросаДобавления, ДопПараметры);			
		
		КонецЦикла; 

	КонецЕсли;
	
	Если СтрокиКУдалению.Количество() > 0 Тогда
	
		ТекстЗапросаУдаления = 
			"DELETE FROM [Externals].[dbo].[Related_Companies]
			|WHERE [id] IN (&СписокID)";
		
		ТекстЗапросаУдаления = СтрЗаменить(ТекстЗапросаУдаления, "&СписокID", СтрСоединить(СтрокиКУдалению, ", "));
		РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапросаУдаления, ДопПараметры);
	
	КонецЕсли;
	
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	
	Если ДопПараметры.Свойство("Ошибки") Тогда
	
		Для каждого Ошибка Из ДопПараметры.Ошибки Цикл
		
			ЗарегистрироватьОшибку(Ошибка);
		
		КонецЦикла;
		
		Возврат Ложь;
	
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

Процедура ПодставитьОбщиеЗначенияВЗапрос(ТекстЗапроса, Контекст)
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&date,", 						"'" + Формат(Контекст.ДатаСведений, "ДФ=yyyyMMdd") + "',");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&matrix_organization_id", 	"'" + Контекст.КодМатрихОрганизации + "'");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&matrix_firm_id", 			"'" + Контекст.КодМатрихЮрЛица + "'");
КонецПроцедуры

Процедура ПодставитьЗначениеКолонкиВЗапрос(ТекстЗапроса, ИмяКолонки, Знач Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда 
		Значение = "NULL";
	ИначеЕсли СтрНачинаетсяС(ИмяКолонки, "date_") Тогда
		Значение = "'" + Формат(Значение, "ДФ=yyyyMMdd") + "'";
	ИначеЕсли ИмяКолонки = "id" Тогда
		Значение = Формат(Значение, "ЧГ=0");
	Иначе
		Значение = "N'" + СтрЗаменить(Значение, "'", "''") + "'";
	КонецЕсли; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&" + ИмяКолонки, Значение);
	
КонецПроцедуры
	
#КонецОбласти

#Область Связанные_лица_Инфинитум

Процедура ЗарегистрироватьКодыИнфинитум(Запрос)

	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_1 КАК Person_Code,
		|	_ДанныеИнфинитум.VAT_Registration_No_1 КАК VAT_Registration_No
		|ПОМЕСТИТЬ _РеквизитыИнфинитум
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДанныеИнфинитум.Person_Code_2,
		|	_ДанныеИнфинитум.VAT_Registration_No_2
		|ИЗ
		|	_ДанныеИнфинитум КАК _ДанныеИнфинитум
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.TIN КАК TIN,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК Наименование
		|ПОМЕСТИТЬ _ГоловныеОрганизации
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо) КАК ГоловнаяОрганизация
		|		ИЗ
		|			РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|					,
		|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних КАК СвязанныеЮридическиеЛицаСрезПоследних
		|				ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|					И (СвязанныеЮридическиеЛицаСрезПоследних.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
		|					И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)) КАК ГоловныеОрганизации
		|		ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ГоловныеОрганизации.ГоловнаяОрганизация
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИНН
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_РеквизитыИнфинитум.Person_Code КАК Person_Code,
		|	_РеквизитыИнфинитум.VAT_Registration_No КАК VAT_Registration_No
		|ПОМЕСТИТЬ _НовыеКодыВоВнешнихСистемах
		|ИЗ
		|	_РеквизитыИнфинитум КАК _РеквизитыИнфинитум
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Инфинитум)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО _РеквизитыИнфинитум.Person_Code = КодыВоВнешнихСистемахСрезПоследних.Код
		|ГДЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Период КАК Период,
		|	ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Инфинитум) КАК ВнешняяСистема,
		|	ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица) КАК ГруппаОбъектов,
		|	_НовыеКодыВоВнешнихСистемах.Person_Code КАК Код,
		|	_ГоловныеОрганизации.ЮрФизЛицо КАК Объект
		|ИЗ
		|	_НовыеКодыВоВнешнихСистемах КАК _НовыеКодыВоВнешнихСистемах
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизации
		|		ПО (_НовыеКодыВоВнешнихСистемах.VAT_Registration_No <> """")
		|			И (_НовыеКодыВоВнешнихСистемах.VAT_Registration_No = _ГоловныеОрганизации.ИНН
		|				ИЛИ _НовыеКодыВоВнешнихСистемах.VAT_Registration_No = _ГоловныеОрганизации.TIN)
		|ГДЕ
		|	НЕ _ГоловныеОрганизации.ЮрФизЛицо ЕСТЬ NULL";		
	#КонецОбласти 
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
	
		Запись = РегистрыСведений.КодыВоВнешнихСистемах.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Записать();
	
	КонецЦикла; 
	
	ЗафиксироватьТранзакцию();
	
	Запрос.Текст = 
		"УНИЧТОЖИТЬ _РеквизитыИнфинитум
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ГоловныеОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _НовыеКодыВоВнешнихСистемах";
	
	Запрос.Выполнить();

КонецПроцедуры 

Процедура ЗаполнитьГруппуПодчиненными(Группы, Подчиненные, Родитель, ЧерезКого)
	
	ПодчиненныеПоРодителю = Подчиненные.НайтиСтроки(Новый Структура("Родитель", ЧерезКого));
	
	Для каждого СтрокаПодчиненные Из ПодчиненныеПоРодителю Цикл
		
		НоваяСтрока = Группы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодчиненные, , "Родитель, ВидСвязи");
		НоваяСтрока.Родитель = Родитель;
		НоваяСтрока.ЧерезКого = ЧерезКого;
		
		СтрокаПодчиненные.Обработан = Истина;
		
	КонецЦикла;

КонецПроцедуры


#КонецОбласти 

#Область Импорт_из_XML

Процедура ИмпортСвязанныхЛицИзXML(ПараметрыКоманды)

	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыКоманды, "Организация");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортСвязанныхЛицИзXML";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыВыполненияДляСбораСтатистики.Хранилище, ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СтатистикаИмпорта = Новый Массив;
	
	ДанныеФайлов = РаботаСФайламиКлиентСервер.ПолучитьФайлыДляОбработкиИзКаталога(ПараметрыКоманды.ИмяКаталога, "linked_persons_*.xml");
	
	Если ДанныеФайлов = Неопределено Тогда
		
		ЗарегистрироватьОшибку("Не удалось прочитать данные файлов. Отсутствует папка с файлами [" + ПараметрыКоманды.ИмяКаталога + "]!");
		Возврат;
		
	КонецЕсли;
	
	ОбработанныеФайлы = Новый Массив;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
	
		Для каждого ДанныеФайла Из ДанныеФайлов Цикл
		
			ФайлЗагружен = Ложь;
			РезультатЧтенияФайла = ПрочитатьФайлXML(Новый ДвоичныеДанные(ДанныеФайла.Файл.ПолноеИмя), ДанныеФайла.Файл.ПолноеИмя, ПараметрыКоманды.Организация);
			
			Если ТипЗнч(РезультатЧтенияФайла) = Тип("Структура") Тогда
				
				ТаблицаИмпортируемыхДанных = ПолучитьТаблицуИмпортируемыхДанных(РезультатЧтенияФайла.ИмпортируемыеДанные);
				
				ЮрЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыКоманды.Организация, "ЮрФизЛицо");
				
				Контекст = Новый Структура;
				Контекст.Вставить("ТаблицаИмпортируемыхДанных", ТаблицаИмпортируемыхДанных);
				Контекст.Вставить("ДатаСведений", ДанныеФайла.Файл.ПолучитьВремяИзменения());
				Контекст.Вставить("КодМатрихОрганизации", ПолучитьКодМатрих(ЮрЛицоОрганизации));
				Контекст.Вставить("КодМатрихЮрЛица", РезультатЧтенияФайла.КодМатрихЮрЛица);
				
				ТекстЗапроса = 
					"DELETE FROM [Externals].[dbo].[Related_Companies]
					|WHERE [matrix_firm_id] = 'КодМатриксЮрЛица'
					|  AND [matrix_organization_id] = 'КодМатриксОрганизации'
					|  AND [date] = 'ДатаСведений'";
				
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КодМатриксЮрЛица", Контекст.КодМатрихЮрЛица);
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КодМатриксОрганизации",Контекст.КодМатрихОрганизации);
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДатаСведений", Формат(Контекст.ДатаСведений, "ДФ=yyyy-MM-dd"));
				
				Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения());
				ДопПараметры = Новый Структура("РежимБезУведомлений");
				РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса, ДопПараметры);
				
				Если ДопПараметры.Свойство("Ошибки") Тогда
					
					Для каждого Ошибка Из ДопПараметры.Ошибки Цикл
						ТекстОшибки = СтрШаблон("Ошибка удаления списка связанных.
							|Организация: %1
							|Клиент: %2
							|Дата списка: %3
							|Система сообщает: %4", 
								ПараметрыКоманды.Организация, 
								РезультатЧтенияФайла.ЮрФизЛицо,
								Контекст.ДатаСведений,
								Ошибка);
						ЗарегистрироватьОшибку(ТекстОшибки);
					КонецЦикла;
					
				Иначе
					
					ФайлЗагружен = ВыгрузитьДанныеВExternals(Контекст);
					ИмпортироватьСведенияОСвязанныхЛицах(ПараметрыКоманды.Организация, РезультатЧтенияФайла.ЮрФизЛицо);
					
					ОбработанныеФайлы.Добавить(ДанныеФайла.Файл);
					
					РеквизитыОповещения = Новый Структура;
					РеквизитыОповещения.Вставить("Организация", ПараметрыКоманды.Организация);
					РеквизитыОповещения.Вставить("Клиент", РезультатЧтенияФайла.ЮрФизЛицо);
					РеквизитыОповещения.Вставить("Дата", Формат(Контекст.ДатаСведений, "ДФ=dd.MM.yyyy"));
					РеквизитыОповещения.Вставить("ИмяФайла", ДанныеФайла.Файл.Имя);
					ИмяИсточника = "_УправлениеСвязаннымиЛицами.ИмпортСвязанныхЛицИзXML()";
					Справочники.Оповещения.СформироватьОповещения(ИмяИсточника, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
					
				КонецЕсли;				
				
			ИначеЕсли ТипЗнч(РезультатЧтенияФайла) = Тип("Строка") Тогда
				ЗарегистрироватьОшибку(СтрШаблон("Ошибка чтения файла '%1': %2", ДанныеФайла.Файл.ПолноеИмя, РезультатЧтенияФайла));
			Иначе
				ЗарегистрироватьОшибку("Непредвиденная ошибка чтения файла " + ДанныеФайла.Файл.ПолноеИмя);
			КонецЕсли;
			
			СтатистикаИмпорта.Добавить(СтрШаблон("%1 файл '%2'", ?(ФайлЗагружен, "Загружен", "Не удалось загрузить"), ДанныеФайла.Файл.Имя));
		
		КонецЦикла;
		
		РаботаСФайламиКлиентСервер.ПеренестиОбработанныеФайлыВКаталог(ОбработанныеФайлы);
	
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, , СтрСоединить(СтатистикаИмпорта, Символы.ПС));

КонецПроцедуры

Функция ПолучитьТаблицуИмпортируемыхДанных(ИмпортируемыеДанные)

	ТаблицаИмпортируемыхДанных = Новый ТаблицаЗначений;
	
	//МассивКопируемыхПолей = СтрРазделить("id,date_from,name,comment,INN,OGRN,relation,date_basement,relation_type", ",");
	МассивКопируемыхПолей = СтрРазделить("id,date_from,name,comment,INN,OGRN,relation,date_basement", ",");
	ПоляВнешнейТаблицы = Метаданные.ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Related_Companies.Поля;
	
	Для каждого Поле Из ПоляВнешнейТаблицы Цикл
		Если МассивКопируемыхПолей.Найти(Поле.Имя) <> Неопределено Тогда
			ТаблицаИмпортируемыхДанных.Колонки.Добавить(Поле.Имя, Поле.Тип);
		КонецЕсли; 
	КонецЦикла;

	ТаблицаИмпортируемыхДанных.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	
	Для каждого Строка Из ИмпортируемыеДанные Цикл
	
		НоваяСтрока = ТаблицаИмпортируемыхДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.date_basement = ПолучитьДатуИзСтроки(Строка.BasementStartDate);
		НоваяСтрока.relation = Строка.RelationType;
		//НоваяСтрока.relation_type = ?(Строка.PersonType = "Связанное", 5, 6);
		НоваяСтрока.Действие = "Взять из файла";
		
	КонецЦикла;
	
	Возврат ТаблицаИмпортируемыхДанных;

КонецФункции

Функция ПрочитатьФайлXML(ДанныеФайла, ПолноеИмяФайла, Организация) Экспорт
	
	Файл = Новый Файл(ПолноеИмяФайла);
	
	Если СтрНачинаетсяС(НРег(Файл.ИмяБезРасширения), "linked_persons_") И НРег(Файл.Расширение) = ".xml" Тогда
		
		ИмяФайла = СтрЗаменить(НРег(Файл.ИмяБезРасширения), "linked_persons_", "");
		МассивПодстрок = СтрРазделить(ИмяФайла, "_");
		ДатаСведений = Дата(МассивПодстрок[1]);
		Результат = ПолучитьДанныеЮрЛица(МассивПодстрок[0], ДатаСведений, Организация);
		
		Если Результат = Неопределено Тогда
			Возврат "Не удалось определить юр. лицо по ИНН " + МассивПодстрок[0];
		КонецЕсли;
		
	Иначе
		
		Возврат "Имя файла не соответствует шаблону ""linked_persons_ИНН_ДатаВФорматеГГГГММДД_01.xml""";
		
	КонецЕсли;
	
	Результат.Вставить("ДатаСведений", ДатаСведений);
	
	Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
		
	Схема = ПолучитьМакет("Схема"); 
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Схема.Записать(ИмяВременногоФайла);
	
	Фабрика = СоздатьФабрикуXDTO(ИмяВременногоФайла);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Попытка
		ФайлОбъектXDTO = Фабрика.ПрочитатьXML(ЧтениеXML, Фабрика.Тип("LinkedPersons", "File"));
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
		
	ИмпортируемыеДанные = Новый Массив;
	
	Для каждого СтрокаСвязанныхЛиц Из ФайлОбъектXDTO.LinkedPerson Цикл
		
		Строка = Новый Структура;
		
		Для каждого Свойство Из Фабрика.Тип("LinkedPersons", "LinkedPerson").Свойства Цикл
			Строка.Вставить(Свойство.Имя, СтрокаСвязанныхЛиц.Получить(Свойство));
		КонецЦикла;
		
		ИмпортируемыеДанные.Добавить(Строка);
		
	КонецЦикла;
	
	Результат.Вставить("ИмпортируемыеДанные", ИмпортируемыеДанные);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеЮрЛица(ИНН, ДатаСписка, Организация)

	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК КодМатрихЮрЛица
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&Период,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо = КодыВоВнешнихСистемахСрезПоследних.Объект
		|ГДЕ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН = &ИНН";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", ДатаСписка);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		ДанныеЮрЛица = Новый Структура("КодМатрихЮрЛица, ЮрФизЛицо");
		ЗаполнитьЗначенияСвойств(ДанныеЮрЛица, Выборка);

		Возврат ДанныеЮрЛица;
	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДатуИзСтроки(ДатаСтрока)

	Результат = NULL;
	
	Если ЗначениеЗаполнено(ДатаСтрока) Тогда
	
		Попытка
			Результат = Дата(ДатаСтрока + " 00:00:00");
		Исключение
		КонецПопытки; 	
	
	КонецЕсли; 
	
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Обработка_ошибок

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках(ЕстьОшибки) Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
		КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры // ОповеститьОбОшибках

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;