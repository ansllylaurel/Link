Функция ПолучитьСведенияОСвязанномЛице(СвязанноеЛицо) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.TIN КАК TIN
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЮрФизЛицо", СвязанноеЛицо);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
		
	Если Выборка.Следующий() Тогда
		
		СведенияОСвязанномЛице = Новый Структура;
		МассивНаименований = Новый Массив;
		
		Для каждого Колонка Из Результат.Колонки Цикл
			
			ИмяКолонки = Колонка.Имя;
			Значение = Выборка[ИмяКолонки];
			ЗначениеСтрока = "'" + СтрЗаменить(Значение, "'", "''") + "'";
			
			Если ИмяКолонки = "ИНН" Или ИмяКолонки = "ОГРН" Или ИмяКолонки = "TIN" Тогда
				СведенияОСвязанномЛице.Вставить(Колонка.Имя, ЗначениеСтрока);
			ИначеЕсли ЗначениеЗаполнено(Значение) Тогда 
				МассивНаименований.Добавить(ЗначениеСтрока);
			КонецЕсли; 
		
		КонецЦикла; 
		
		СведенияОСвязанномЛице.Вставить("Наименование", СтрСоединить(МассивНаименований, ", "));
		
		Возврат СведенияОСвязанномЛице;
	
	КонецЕсли;
	
КонецФункции

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Если Метод = "ИмпортироватьСведенияОСвязанныхЛицах" Тогда
		
		КлючиЗапуска = Новый ТаблицаЗначений;
	
		КлючиЗапуска.Колонки.Добавить("СвязанноеЛицо",	Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
		КлючиЗапуска.Колонки.Добавить("Идентификатор",	Новый ОписаниеТипов("УникальныйИдентификатор"));
		
		// Фиксируем запуск.
		Для Каждого ТекЭкземпляр Из Экземпляры Цикл
			
			НовыйКлюч = КлючиЗапуска.Добавить();
			
			ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
			НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
			
		КонецЦикла;
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КлючиЗапуска.СвязанноеЛицо КАК СвязанноеЛицо,
			|	КлючиЗапуска.Идентификатор КАК Идентификатор
			|ПОМЕСТИТЬ _КлючиЗапуска
			|ИЗ
			|	&КлючиЗапуска КАК КлючиЗапуска
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_КлючиЗапуска.СвязанноеЛицо КАК СвязанноеЛицо,
			|	_КлючиЗапуска.Идентификатор КАК Идентификатор
			|ИЗ
			|	_КлючиЗапуска КАК _КлючиЗапуска
			|ИТОГИ ПО
			|	СвязанноеЛицо";
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
		
		Результат = Запрос.Выполнить();
		ВыборкаСвязанноеЛицо = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСвязанноеЛицо.Следующий() Цикл
		
			ИмпортироватьСведенияОСвязанныхЛицах(,, ВыборкаСвязанноеЛицо.СвязанноеЛицо);
			
			ВыборкаИдентификатор = ВыборкаСвязанноеЛицо.Выбрать();
			Пока ВыборкаИдентификатор.Следующий() Цикл
				РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ВыборкаИдентификатор.Идентификатор);
			КонецЦикла; 
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

