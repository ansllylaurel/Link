		|	dbo_Infinitum_Related_Companies.VAT_Registration_No_2 КАК VAT_Registration_No_2,
		|	dbo_Infinitum_Related_Companies.KPP_Code_2 КАК KPP_Code_2,
		|	dbo_Infinitum_Related_Companies.Person_Name_2 КАК Person_Name_2,
		|	dbo_Infinitum_Related_Companies.Person_Name_Short_2 КАК Person_Name_Short_2,
		|	dbo_Infinitum_Related_Companies.Category_Person_2 КАК Category_Person_2,
		|	dbo_Infinitum_Related_Companies.OKOPF_2 КАК OKOPF_2,
		|	dbo_Infinitum_Related_Companies.Starting_Date КАК Starting_Date,
		|	dbo_Infinitum_Related_Companies.Expire_Date КАК Expire_Date,
		|	dbo_Infinitum_Related_Companies.Share КАК Share
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 1
		|		dbo_Files.Id КАК Id
		|	ИЗ
		|		ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
		|	ГДЕ
		|		dbo_Files.Source_Id.Id = 22
		|		И dbo_Files.sha256hash ЕСТЬ NULL
		|	
		|	УПОРЯДОЧИТЬ ПО
		|		dbo_Files.Upload_Time УБЫВ) КАК ВложенныйЗапрос
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.Externals.Таблица.dbo_Infinitum_Related_Companies КАК dbo_Infinitum_Related_Companies
		|		ПО ВложенныйЗапрос.Id = dbo_Infinitum_Related_Companies.File_Id
		|ГДЕ
		|	&Отбор";
	
	Если ЗначениеЗаполнено(Отбор) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", Отбор);
	Иначе
		Запрос.УстановитьПараметр("Отбор", Истина);
	КонецЕсли; 
	
	ВнешниеДанные = Запрос.Выполнить().Выгрузить();		
