		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЛица КАК _ТекущиеДанные
		|		ПО _НовыеДанные.Период = _ТекущиеДанные.Период
		|			И _НовыеДанные.Организация = _ТекущиеДанные.Организация
		|			И _НовыеДанные.ЮрФизЛицо = _ТекущиеДанные.ЮрФизЛицо
		|			И _НовыеДанные.ТипСвязи = _ТекущиеДанные.ТипСвязи
		|			И _НовыеДанные.СвязанноеЮрФизЛицо = _ТекущиеДанные.СвязанноеЮрФизЛицо
		|			И _НовыеДанные.Действует = _ТекущиеДанные.Действует
		|			И _НовыеДанные.ДатаВключенияВСписок = _ТекущиеДанные.ДатаВключенияВСписок
		|			И _НовыеДанные.ДатаОснования = _ТекущиеДанные.ДатаОснования
		|ГДЕ
		|	(_НовыеДанные.Период ЕСТЬ NULL
		|				И _ТекущиеДанные.ТипСвязи.КонтрольПоУказанию5343У
		|				И НЕ _ТекущиеДанные.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.Инфинитум)
		|				И &УсловияОтбора
		|			ИЛИ _ТекущиеДанные.Период ЕСТЬ NULL)";
	
	#КонецОбласти 
	
	Отборы.Очистить();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Отборы.Добавить("_ТекущиеДанные.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЮрЛицо) Тогда
		Отборы.Добавить("_ТекущиеДанные.ЮрФизЛицо = &ЮрФизЛицо");
		Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрЛицо);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвязанноеЛицо) Тогда
		Отборы.Добавить("_ТекущиеДанные.СвязанноеЮрФизЛицо = &СвязанноеЮрФизЛицо");
		Запрос.УстановитьПараметр("СвязанноеЮрФизЛицо", СвязанноеЛицо);
	КонецЕсли;
	
	Если Отборы.Количество() > 0 Тогда
		УсловияОтбора = СтрСоединить(Отборы, " И ");
	Иначе
		УсловияОтбора = "ИСТИНА";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПустыеЗначенияКодов", ПустыеЗначенияКодов());
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбора", УсловияОтбора);
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ВнешниеДанные", ВнешниеДанные);
	
	Результат = Запрос.Выполнить();
	
	ЗаписатьИзмененныеДанные(Запрос, Отчет, "Обновление списков связанных лиц");
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Функция СоответствиеТиповСвязей()
	
	ТипыСвязей = Справочники.ТипыСвязейЮрФизЛиц; 
			
	СоответствиеТиповСвязей = Новый Соответствие;
	
	СоответствиеТиповСвязей.Вставить(
		"Вышестоящая материнская компания", 
		ТипыСвязей.ВышестоящаяМатеринскаяКомпания);
		
