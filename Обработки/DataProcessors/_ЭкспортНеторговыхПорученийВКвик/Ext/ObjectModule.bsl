// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Экспорт неторговых поручений в КВИК",
		"0.56",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ЭкспортПорученийВКВИК", "Экспорт поручений в квик"  ,, Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ЭтотОбъект.ДатаЭкспорта = ТекущаяДатаСеанса();	
	//В неторговые (но рабочие) дни через QUIK могут отправляться поручения на переводы ДС 
	Если Не ЭтоРабочийИлиТорговыйДень(НачалоДня(ЭтотОбъект.ДатаЭкспорта)) Тогда
		Возврат;
	КонецЕсли;
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыКоманды, "Организация, Брокер, СерверSQL, БазаДанныхSQL, ТаблицаПорученийSQL, ТаблицаТранзакцийSQL, НомерКвика");
	АдресФайлаЭкспорта = ПараметрыКоманды.АдресФайла;
	ЭтотОбъект.ДатаЭкспорта = ТекущаяДатаСеанса();
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Не ПеренестиДанныеФайловВАрхив(АдресФайлаЭкспорта) Тогда
		ОповеститьОбОшибках();
		Возврат;
	КонецЕсли;
	
	//Открываем сессию										 
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация,Брокер,СерверSQL,БазаДанныхSQL,ТаблицаПорученийSQL,ТаблицаТранзакцийSQL,НомерКвика");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ЭкспортироватьДанные(АдресФайлаЭкспорта);
	УстранитьРасхождения();
	ОповеститьОбОшибках();
	
	//Закрываем сессию
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура ПоместитьДанныеПорученийВоВременнуюТаблицу(Запрос) Экспорт
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоручение.Дата КАК Дата,
		|	ДокПоручение.Номер КАК Номер,
		|	ДокПоручение.Ссылка КАК Ссылка,
		|	ДокПоручение.Проведен КАК Проведен,
		|	ДокПоручение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокПоручение.Сумма КАК Сумма,
		|	ДокПоручение.Валюта КАК Валюта,
		|	ДокПоручение.Брокер КАК Брокер,
		|	ДокПоручение.МестоХранения КАК МестоХранения,
		|	ДокПоручение.МестоХраненияСтрокой КАК МестоХраненияСтрокой,
		|	ДокПоручение.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокПоручение.БрокерПолучатель КАК БрокерПолучатель,
		|	ДокПоручение.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	ДокПоручение.МестоХраненияПолучательСтрокой КАК МестоХраненияПолучательСтрокой,
		|	ДокПоручение.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель,
		|	СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Период КАК ПериодСтатуса,
		|	СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус КАК Статус,
		|	ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус, НЕОПРЕДЕЛЕНО) В (&АктивныеСтатусы)
		|		ИЛИ ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) > &НачалоДня КАК АктивныйСтатус,
		|	ПереводДенежныхСредств.Ссылка КАК ПереводСсылка,
		|	ПереводДенежныхСредств.Проведен КАК ПереводПроведен
		|ПОМЕСТИТЬ _ТаблицаПоручений
		|ИЗ
		|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(&КонецДня, ) КАК СтатусыПорученийНаПереводДенежныхСредствСрезПоследних
		|		ПО ДокПоручение.Ссылка = СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.ПоручениеНаПереводДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ПО ДокПоручение.Ссылка = ПереводДенежныхСредств.Основание
		|			И (ПереводДенежныхСредств.Дата >= &ДатаТМинусОдин)
		|			И (ПереводДенежныхСредств.Брокер = &Брокер)
		|			И (ПереводДенежныхСредств.Организация = &Организация)
		|			И (НЕ ПереводДенежныхСредств.ПометкаУдаления)
		|ГДЕ
		|	ДокПоручение.Организация = &Организация
		|	И ДокПоручение.Дата МЕЖДУ &ДатаТМинусОдин И &КонецДня
		|	И (ДокПоручение.Дата < &НачалоДня
		|				И (ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Статус, НЕОПРЕДЕЛЕНО) В (&АктивныеСтатусы)
		|					ИЛИ ЕСТЬNULL(СтатусыПорученийНаПереводДенежныхСредствСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) > &НачалоДня)
		|			ИЛИ ДокПоручение.Дата > &НачалоДня)
		|	И ДокПоручение.Брокер = &Брокер
		|	И ДокПоручение.Проведен";
#КонецОбласти
		
	АктивныеСтатусы = Новый Массив;
	АктивныеСтатусы.Добавить(Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Активно);
	АктивныеСтатусы.Добавить(Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Отправлено);

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер", ЭтотОбъект.Брокер);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.ДатаЭкспорта));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ЭтотОбъект.ДатаЭкспорта));
	Запрос.УстановитьПараметр("ДатаТМинусОдин", ПолучитьПредыдущуюДату(ЭтотОбъект.ДатаЭкспорта));
	Запрос.УстановитьПараметр("ДатаНачалаКонтроляАкцептов", РаботаСДокументами.ДатаНачалаКонтроляАкцептов());
	Запрос.УстановитьПараметр("АктивныеСтатусы", АктивныеСтатусы);

	Запрос.Выполнить();
	
КонецПроцедуры

Функция ЭтоРабочийИлиТорговыйДень(НачалоДня)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ДанныеКалендаряКотировок.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ИЛИ ДанныеОбщероссийскогоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагРабочийДень
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаряКотировок,
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеОбщероссийскогоКалендаря
		|ГДЕ
		|	ДанныеКалендаряКотировок.Календарь = &КалендарьКотировок
		|	И ДанныеОбщероссийскогоКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаряКотировок.Дата = &НачалоДня
		|	И ДанныеОбщероссийскогоКалендаря.Дата = &НачалоДня";
	
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат[0].ФлагРабочийДень;
	
КонецФункции

Функция ЭтоПервыйРабочийДеньМесяца(ДатаЭкспорта)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ДанныеКалендаря.Дата) КАК ПервыйРабочийДеньМесяца
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца";
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаЭкспорта));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(ДатаЭкспорта));
	Результат = Запрос.Выполнить().Выгрузить();
		
	Если Результат[0].ПервыйРабочийДеньМесяца = НачалоДня(ДатаЭкспорта) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
		
КонецФункции

Функция ПолучитьПредыдущуюДату(ДатаЭкспорта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ДанныеКалендаря.Дата) КАК ПредыдущаяДата
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата < &КонецПериода
		|	И ДанныеКалендаря.Дата > &НачалоПериода";
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(ДатаЭкспорта, -1));
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(ДатаЭкспорта));
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат[0].ПредыдущаяДата;
	
КонецФункции

Процедура ЗарегистрироватьОшибкуЭкспорта(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ЕстьОшибки = Ложь) Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Очистить();	
	
КонецПроцедуры

Функция ПолучитьКодКласса_Инструмента(МестоХранения, ВалютаНаименование, ИмяБрокера)
	
#Область Коды	
	// Коды классов и инструментов в Квике БК РЕГИОН
	//===============================================================
	// Код класса || Код инстр-та || Валюта || Место хранения / раздел 
	//===============================================================
	// INSTRUSD   || RURCU        || RUB    || ММВБ / FX(валюта)
	// INSTRUSD   || RURCUEUR     || EUR    || ММВБ / FX(валюта) 
	// INSTRUSD   || RURCUUSD     || USD    || ММВБ / FX(валюта) 
	// INSTRUSD   || RURCUGBP     || GBP    || ММВБ / FX(валюта)
	// INSTRUSD   || RURCUCNY     || CNY    || ММВБ / FX(валюта)
	//===============================================================
	// INSTR      || RUREQTV      || RUB    || ММВБ / Т+
	// INSTR      || RUREUR       || EUR    || ММВБ / Т+ 
	// INSTR      || RURUSD       || USD    || ММВБ / Т+ 
	// INSTR      || RURGBP       || GBP    || ММВБ / Т+
	// INSTR      || RURCNY       || CNY    || ММВБ / Т+
	//===============================================================
	// INSTRFORTS || RURFORTS     || RUB    || ММВБ / FORTS
	// INSTRFORTS || RURFORTSEUR  || EUR    || ММВБ / FORTS
	// INSTRFORTS || RURFORTSUSD  || USD    || ММВБ / FORTS 
	// INSTRFORTS || RURFORTSGBP  || GBP    || ММВБ / FORTS
	// INSTRFORTS || RURFORTSCNY  || CNY    || ММВБ / FORTS
	//===============================================================
	// INSTR2     || RURVNEBRUR   || RUB    || Внебиржевой
	// INSTR2     || RURVNEBEUR   || EUR    || Внебиржевой 
	// INSTR2     || RURVNEBUSD   || USD    || Внебиржевой 
	// INSTR2     || RURVNEBGBP   || GBP    || Внебиржевой
	// INSTR2     || RURVNEBCNY   || CNY    || Внебиржевой
	//===============================================================
	
	//ГПБ
	//===============================================================
	// MNP_M_T0   || RUR_M_T0_SUR || RUB    || ММВБ
	// MNP_M_T0   || RUR_M_T0_EUR || EUR    || ММВБ 
	// MNP_M_T0   || RUR_M_T0_USD || USD    || ММВБ 
	// MNP_M_T0   || RUR_M_T0_CNY || CNY    || ММВБ
	//===============================================================
	// MNP_OTC    || RUR_OTC_SUR  || RUB    || Внебиржевой
	// MNP_OTC    || RUR_OTC_EUR  || EUR    || Внебиржевой 
	// MNP_OTC    || RUR_OTC_USD  || USD    || Внебиржевой 
	// MNP_OTC    || RUR_OTC_CNY  || CNY    || Внебиржевой
	//===============================================================	
#КонецОбласти

	Если ИмяБрокера = "Брокер_БК_Регион" Тогда 

		Если НЕ (ВалютаНаименование = "RUB" Или ВалютаНаименование = "EUR" 
			Или ВалютаНаименование = "USD" Или ВалютаНаименование = "GBP" Или ВалютаНаименование = "CNY") Тогда
			ЗарегистрироватьОшибкуЭкспорта("Для валюты [" + ВалютаНаименование + "] на стороне QUIKа брокера [" + ИмяБрокера  + "] отсутствует площадка и код класса!");
			Возврат Неопределено;
		КонецЕсли;
		
		Если МестоХранения.Наименование = "ММВБ-РТС, раздел FORTS" Тогда
			КодКлассаНТП = "INSTRFORTS";
			
			Если ВалютаНаименование = "RUB" Тогда
				КодИнструмента = "RURFORTS";
			Иначе
				КодИнструмента = "RURFORTS" + СокрЛП(ВалютаНаименование);
			КонецЕсли;
			
		ИначеЕсли МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			КодКлассаНТП = "INSTR2";
			
			Если ВалютаНаименование = "RUB" Тогда
				КодИнструмента = "RURVNEBRUR";
			Иначе
				КодИнструмента = "RURVNEB" + СокрЛП(ВалютаНаименование);
			КонецЕсли;
			
		ИначеЕсли МестоХранения.Наименование = "ММВБ-РТС, раздел FX (валюта)" Тогда
			КодКлассаНТП = "INSTRUSD";
			
			Если ВалютаНаименование = "RUB" Тогда
				КодИнструмента = "RURCU";
			Иначе
				КодИнструмента = "RURCU" + СокрЛП(ВалютаНаименование);
			КонецЕсли;
			
		ИначеЕсли МестоХранения.Наименование = "ММВБ-РТС, раздел Т+" Тогда
			
			КодКлассаНТП = "INSTR";
			
			Если ВалютаНаименование = "RUB" Тогда
				КодИнструмента = "RUREQTV";
			Иначе
				КодИнструмента = "RUR" + СокрЛП(ВалютаНаименование);
			КонецЕсли;
		Иначе
			ЗарегистрироватьОшибкуЭкспорта("Не удалось получить код площадки для QUIKа брокера [" + ИмяБрокера  + "] по месту хранения [" + МестоХранения.Наименование + "] и валюте [" + ВалютаНаименование + "]");
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ИмяБрокера = "Брокер_ГПБ" Тогда
		
		Если НЕ (ВалютаНаименование = "RUB" Или ВалютаНаименование = "EUR" 
			Или ВалютаНаименование = "USD" Или ВалютаНаименование = "CNY") Тогда
			ЗарегистрироватьОшибкуЭкспорта("Для валюты [" + ВалютаНаименование + "] на стороне QUIKа брокера [" + ИмяБрокера  + "] отсутствует площадка и код класса!");
			Возврат Неопределено;
		КонецЕсли;
		
		Если МестоХранения.Наименование = "ММВБ-РТС" Тогда
			
			КодКлассаНТП = "MNP_M_T0";
			
			Если ВалютаНаименование = "RUB" Тогда
				КодИнструмента = "RUR_M_T0_SUR";
			Иначе
				КодИнструмента = "RUR_M_T0_" + СокрЛП(ВалютаНаименование);
			КонецЕсли;
			
		ИначеЕсли МестоХранения = Справочники.МестаХранения.ВнебиржевойРынок Тогда
			
			КодКлассаНТП = "MNP_OTC";
			
			Если ВалютаНаименование = "RUB" Тогда
				КодИнструмента = "RUR_OTC_SUR";
			Иначе
				КодИнструмента = "RUR_OTC_" + СокрЛП(ВалютаНаименование);
			КонецЕсли;

		Иначе
			ЗарегистрироватьОшибкуЭкспорта("Не удалось получить код площадки для QUIKа брокера [" + ИмяБрокера  + "] по месту хранения [" + МестоХранения.Наименование + "] и валюте [" + ВалютаНаименование + "]");
			Возврат Неопределено;	
		КонецЕсли;
		
	Иначе
		ЗарегистрироватьОшибкуЭкспорта("Для QUIKа брокера [" + ИмяБрокера  + "] не описаны правила определения кодов классов и инструментов.");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("КодКлассаНТП, КодИнструмента", КодКлассаНТП, КодИнструмента);
		
КонецФункции

Функция ПолучитьКодКлиента(КодУБрокера, КодFORTS, МестоХраненияСтрокой, МестоХраненияНаименование, ДатаДоговораСБрокером)
	
	КодКлиента = СтрЗаменить(КодУБрокера, "_", "/");
	
	Если МестоХраненияСтрокой = "Биржевые_РЕПО" Или МестоХраненияСтрокой = "Внебиржевые_REPO_R" Тогда
		КодКлиента = КодКлиента + "/R";
	ИначеЕсли МестоХраненияСтрокой = "Биржевые_Валютная" Или МестоХраненияСтрокой = "Внебиржевые_Валютный_V" Или МестоХраненияНаименование = "ММВБ-РТС, раздел FX (валюта)" Тогда
		
		Если ЭтотОбъект.ДатаЭкспорта > Дата(2022, 06, 09) // с этой даты брокер перевел все валютные портфели на валютные секции.
			Или ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") И ЭтотОбъект.ДатаЭкспорта > Дата(2021, 11, 03) Тогда
			КодКлиента = КодКлиента + "/V"; // всех клиентов УК Траст перевели с валютных портфелей на валютные секции.	
		Иначе
			КодКлиента = КодКлиента + ?(ДатаДоговораСБрокером <= Дата(2020, 12, 1), "V", "/V"); // брокер перешел с валютных портфелей на валютные секции.
		КонецЕсли;
		
	ИначеЕсли МестоХраненияСтрокой = "Внебиржевые_VN" Тогда
		КодКлиента = КодКлиента + "/VN";
	ИначеЕсли МестоХраненияСтрокой = "Биржевые_FORTS" Или МестоХраненияНаименование = "ММВБ-РТС, раздел FORTS" Тогда
		КодКлиента = КодFORTS;
	Иначе
		КодКлиента = КодКлиента;
	КонецЕсли;
	
	Если ПустаяСтрока(КодКлиента) Тогда
		Возврат Неопределено;
	Иначе
		Возврат КодКлиента;
	КонецЕсли;
	
КонецФункции
	
Функция СформироватьСтрокуЭкспорта(СтрокаДанных)
	
	Если Не ЗначениеЗаполнено(СтрокаДанных.НомерТранзакции) Тогда
		//Длина Ид транзакции в Квике максимум 10 цифр. Номер транзакции формируем из номера документа.
		//При записи в tri-файл для каждого поручения необходим уникальный номер, т.к. при импорте данных QUIK анализирует файл ответов,
		//в котором фиксируются записи с номерами ранее загруженных поручений.
		ИДТранзакции = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(СтрокаДанных.Номер);
		ИДТранзакции = Прав(ИДТранзакции, 10);
		
		Пока Лев(ИДТранзакции, 1) = "0" Цикл
			ИДТранзакции = Прав(ИДТранзакции, СтрДлина(ИДТранзакции) - 1);
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Истина);
			
		МенеджерЗаписиНомераТранзакций = РегистрыСведений.НомераТранзакций.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписиНомераТранзакций.Субъект        = СтрокаДанных.Ссылка;
		МенеджерЗаписиНомераТранзакций.ВнешняяСистема = Справочники.ВнешниеСистемы.QUIK;
		МенеджерЗаписиНомераТранзакций.Номер          = ИДТранзакции;
		МенеджерЗаписиНомераТранзакций.Записать();
		
		УстановитьПривилегированныйРежим(Ложь);
	Иначе
		ИДТранзакции = СтрокаДанных.НомерТранзакции;
	КонецЕсли;
			
	КодыКвик = ПолучитьКодКласса_Инструмента(СтрокаДанных.МестоХранения, СтрокаДанных.Валюта.Наименование, СтрокаДанных.БрокерИмяИменнованногоОбъекта);
	КодОтправителя = ПолучитьКодКлиента(СтрокаДанных.КодСчетаДУуБрокера, СтрокаДанных.КодFORTSСчетаДУуБрокера, СтрокаДанных.МестоХраненияСтрокой, СтрокаДанных.МестоХранения.Наименование, СтрокаДанных.ДатаЗаключенияДоговораБрокерскогоОбслуживания);
	
	Если КодыКвик = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если КодОтправителя = Неопределено Тогда
		ЗарегистрироватьОшибкуЭкспорта("Не удалось определить код отправителя для счета ДУ [" + СтрокаДанных.СчетДоверительногоУправления + "] и месту хранения [" + СтрокаДанных.МестоХранения.Наименование + "]");
		Возврат "";
	КонецЕсли;
	
	Если СтрокаДанных.ТипПоручения = "Вывод" Тогда
		
		Если ПустаяСтрока(СтрокаДанных.НаименованиеВладельцаДляДокументов) Тогда
			
			ТекстОшибки = "В договоре банковского обслуживания для счета [" + СтрокаДанных.СчетПолучатель + "] пустое поле [НаименованиеВладельцаДляДокументов]";
			
			РегистрыСведений.СтатусыПорученийНаПереводДенежныхСредств.УстановитьСтатусПоручения(СтрокаДанных.Ссылка, Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте, "[1C] " + ТекстОшибки);
			ЗарегистрироватьОшибкуЭкспорта(ТекстОшибки);
			Возврат "";
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаДанных.ИНН) Тогда
			ЗарегистрироватьОшибкуЭкспорта("У владельца счета [" + СтрокаДанных.СчетПолучатель + "] отсутствует ИНН!");
			Возврат "";
		КонецЕсли;

		СтрокаЭкспорта = "ACTION=NEW_INSTR_TYPE_5; " +
						 "TRANS_ID="      + ИДТранзакции + "; " +
						 "DOC_COMMENT="   + СтрокаДанных.Ссылка.УникальныйИдентификатор() + "; " +
						 "CLASSCODE="     + КодыКвик.КодКлассаНТП + "; " +
						 "INSTR_RATE=1; " +
						 "CLIENT_CODE="	  + КодОтправителя + "; " +
						 "AGREE_SERV="    + СокрЛП(СтрокаДанных.НомерДоговораБрокерскогоОбслуживания) + "|" + Формат(СтрокаДанных.ДатаЗаключенияДоговораБрокерскогоОбслуживания, "ДФ=ггггММдд") + "|; " +
						 "VOLUME="        + Формат(СтрокаДанных.Сумма, "ЧРД=.; ЧГ=0") + "; " +
						 "SECCODE="       + КодыКвик.КодИнструмента + "; " +
						 "BENEFACTOR="    + СокрЛП(СтрокаДанных.Получатель) + "|" + СокрЛП(СтрокаДанных.НаименованиеВладельцаДляДокументов) + "|||" + СтрокаДанных.ИНН + "|" + СтрокаДанных.РеквизитыСчетПолучатель 
						                  + ?(СтрокаДанных.БрокерИмяИменнованногоОбъекта = "Брокер_ГПБ", "|" + КодОтправителя, "") + "|;";
	ИначеЕсли СтрокаДанных.ТипПоручения = "Перевод" Тогда
			 
		КодыКвикПолучателя = ПолучитьКодКласса_Инструмента(СтрокаДанных.МестоХраненияПолучатель, СтрокаДанных.Валюта.Наименование, СтрокаДанных.БрокерИмяИменнованногоОбъекта);
		КодПолучателя = ПолучитьКодКлиента(СтрокаДанных.КодСчетаДУуБрокера, СтрокаДанных.КодFORTSСчетаДУуБрокера, СтрокаДанных.МестоХраненияПолучательСтрокой, СтрокаДанных.МестоХраненияПолучатель.Наименование, СтрокаДанных.ДатаЗаключенияДоговораБрокерскогоОбслуживания);
		
		Если КодыКвикПолучателя = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Если КодПолучателя = Неопределено Тогда
			ЗарегистрироватьОшибкуЭкспорта("Не удалось определить код получателя для счета ДУ [" + СтрокаДанных.СчетДоверительногоУправления + "] и месту хранения [" + СтрокаДанных.МестоХраненияПолучатель.Наименование + "]");
			Возврат "";
		КонецЕсли;
		
		СтрокаЭкспорта = "ACTION=NEW_INSTR_TYPE_3; " +
						 "TRANS_ID="	   + ИДТранзакции + "; " +
						 "DOC_COMMENT="	   + СтрокаДанных.Ссылка.УникальныйИдентификатор() + "; " +
						 "CLASSCODE="	   + КодыКвик.КодКлассаНТП + "; " +
						 "INSTR_RATE=1; "  +
						 "CLIENT_CODE="	   + КодОтправителя + "; " +
						 "AGREE_SERV="	   + СокрЛП(СтрокаДанных.НомерДоговораБрокерскогоОбслуживания) + "|" + Формат(СтрокаДанных.ДатаЗаключенияДоговораБрокерскогоОбслуживания, "ДФ=ггггММдд") + "|; "+
						 "VOLUME="		   + Формат(СтрокаДанных.Сумма, "ЧРД=.; ЧГ=0") + "; " +
						 "SECCODE="		   + КодыКвик.КодИнструмента + "; " +
						 "SECCODE_CP="	   + КодыКвикПолучателя.КодИнструмента + "; " +
						 "CLIENT_CODE_CP=" + КодПолучателя + ";"
						 ;

	ИначеЕсли СтрокаДанных.ТипПоручения = "Отмена поручения" Тогда
		//На стороне квика пока отсутствует возможность отмены НТП через tri-файл
	КонецЕсли;

	Возврат СтрокаЭкспорта;
	
КонецФункции

Функция ПолучитьДанныеИзКвика(ТолькоДанныеТаблицыТранзакций = Ложь) Экспорт
		
	СтрокаСоединения = "Driver={SQL Server};Server=" + ЭтотОбъект.СерверSQL + ".G1.LAN;Database=" + ЭтотОбъект.БазаДанныхSQL;
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
	Если Соединение = Неопределено Тогда
		ЗарегистрироватьОшибкуЭкспорта("Не удалось установить соединение с сервером! Описание ошибки: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаНомеров = "'" + ЭтотОбъект.НомерКвика + "'";
	СтрокаНомеров = СтрЗаменить(СтрокаНомеров,",","','");

	ТекстЗапроса = "SELECT CAST(TransNum AS varchar(10)) TransNum, Status, StatusText, ResultMsg, MIN(TransDateTime) TransDateTime
	               |FROM " + ЭтотОбъект.ТаблицаТранзакцийSQL + "
				   |WHERE NOT Status IN (0, 1, 3) AND Uid IN (" + СтрокаНомеров + ") AND TradeDate = '" + Формат(ЭтотОбъект.ДатаЭкспорта, "ДФ=ггггММдд") + "'
				   |GROUP BY TransNum, Status, StatusText, ResultMsg"; 
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибкуЭкспорта("Не выполнен запрос! Не удалось получить данные из таблицы [" + ЭтотОбъект.ТаблицаТранзакцийSQL + "]! Описание ошибки: " + ОписаниеОшибки());;
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаПоручений = Новый ТаблицаЗначений;
	ТаблицаПоручений.Колонки.Добавить("НомерПоручения", Новый ОписаниеТипов("Число"), "НомерПоручения");
	ТаблицаПоручений.Колонки.Добавить("СтатусПоручения", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)), "СтатусПоручения");
	ТаблицаПоручений.Колонки.Добавить("ПоручениеСсылка", Новый ОписаниеТипов("ДокументСсылка.ПоручениеНаПереводДенежныхСредств"), "ПоручениеСсылка");
	ТаблицаПоручений.Колонки.Добавить("ВремяОшибки", Новый ОписаниеТипов("Дата"), "ВремяОшибки");
	ТаблицаПоручений.Колонки.Добавить("СтатусОшибки", Новый ОписаниеТипов("Число"), "СтатусОшибки");
	ТаблицаПоручений.Колонки.Добавить("СтатусОшибкиТекст", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(250)), "СтатусОшибкиТекст");
	ТаблицаПоручений.Колонки.Добавить("СообщениеОбОшибке", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(250)), "СообщениеОбОшибке");
	ТаблицаПоручений.Колонки.Добавить("ОшибкаПриЭкспорте", Новый ОписаниеТипов("Булево"), "ОшибкаПриЭкспорте");
  
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("TransDateTime", Новый ОписаниеТипов("Дата"));
	ТипыКолонок.Вставить("TransNum", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ТипыКолонок.Вставить("Status", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("StatusText", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("ResultMsg", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(250)));
	
	ТаблицаТранзакций = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
	
	Если ТолькоДанныеТаблицыТранзакций Тогда
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		Возврат ТаблицаТранзакций;
	КонецЕсли;
		
	Если ТаблицаТранзакций <> Неопределено Тогда
		
		Запрос = Новый Запрос; 
		
#Область ТЕКСТ_ЗАПРОСА
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаТранзакций.TransDateTime КАК Время,
			|	ТаблицаТранзакций.TransNum КАК НомерТранзакции,
			|	ТаблицаТранзакций.Status КАК Статус,
			|	ТаблицаТранзакций.StatusText КАК СтатусТекст,
			|	ТаблицаТранзакций.ResultMsg КАК Сообщение
			|ПОМЕСТИТЬ _ТаблицаТранзакцийQUIK
			|ИЗ
			|	&ТаблицаТранзакций КАК ТаблицаТранзакций
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Ссылка КАК ПоручениеСсылка,
			|	НомераТранзакций.Номер КАК Номер
			|ПОМЕСТИТЬ _Транзакции
			|ИЗ
			|	РегистрСведений.НомераТранзакций КАК НомераТранзакций
			|ГДЕ
			|	НомераТранзакций.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.QUIK)
			|	И ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Организация = &Организация
			|	И ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Дата >= &НачалоДня
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Транзакции.ПоручениеСсылка КАК Ссылка,
			|	ТаблицаТранзакцийQUIK.Время КАК Время,
			|	ТаблицаТранзакцийQUIK.Статус КАК Статус,
			|	ТаблицаТранзакцийQUIK.СтатусТекст КАК СтатусТекст,
			|	ТаблицаТранзакцийQUIK.Сообщение КАК Сообщение
			|ИЗ
			|	_ТаблицаТранзакцийQUIK КАК ТаблицаТранзакцийQUIK
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Транзакции КАК Транзакции
			|		ПО (Транзакции.Номер = ТаблицаТранзакцийQUIK.НомерТранзакции)";
#КонецОбласти 

		Запрос.УстановитьПараметр("ТаблицаТранзакций", ТаблицаТранзакций);
		Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ЭтотОбъект.ДатаЭкспорта));
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		
		ТаблицаОшибокПриЭкспорте = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаТаблицыОшибокПриЭкспорте Из ТаблицаОшибокПриЭкспорте Цикл
			
			НоваяСтрока                   = ТаблицаПоручений.Добавить();	
			НоваяСтрока.ПоручениеСсылка   = СтрокаТаблицыОшибокПриЭкспорте.Ссылка;
			НоваяСтрока.ВремяОшибки       = СтрокаТаблицыОшибокПриЭкспорте.Время;
			НоваяСтрока.СтатусОшибки      = СтрокаТаблицыОшибокПриЭкспорте.Статус;
			НоваяСтрока.СтатусОшибкиТекст = СтрокаТаблицыОшибокПриЭкспорте.СтатусТекст;
			НоваяСтрока.СообщениеОбОшибке = "[QUIK] " + СтрокаТаблицыОшибокПриЭкспорте.Сообщение;
			НоваяСтрока.ОшибкаПриЭкспорте = Истина;
			
		КонецЦикла;
	
	КонецЕсли;
	
	ТекстЗапроса = "SELECT DISTINCT Number, Status, Comment Uid 
	               |FROM " + ЭтотОбъект.ТаблицаПорученийSQL + " 
				   |WHERE (RegisterDate = '" + Формат(ЭтотОбъект.ДатаЭкспорта, "ДЛФ=Д") + "' OR AcceptDate = '" + Формат(ЭтотОбъект.ДатаЭкспорта, "ДЛФ=Д") + "' OR AcceptDate IS NULL) 
				   |AND Uid IN (" + СтрокаНомеров + ")";
	
	НаборЗаписей = РаботаСВнешнимиСистемами.ADODBC_ВыполнитьЗапрос(Соединение, ТекстЗапроса);
	
	Если НаборЗаписей = Неопределено Тогда
		ЗарегистрироватьОшибкуЭкспорта("Не выполнен запрос! Не удалось получить данные из таблицы [" + ЭтотОбъект.БазаДанныхSQL + "].[" + ЭтотОбъект.ТаблицаПорученийSQL + "]!");
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		Возврат Неопределено;
	КонецЕсли;
		
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Number", Новый ОписаниеТипов("Число"));
	ТипыКолонок.Вставить("Status", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	ТипыКолонок.Вставить("Uid", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	
	ТаблицаДанных = РаботаСВнешнимиСистемами.ADODBC_ВыгрузитьНаборВТаблицуЗначений(НаборЗаписей, ТипыКолонок);
	РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	
	Если ТаблицаДанных = Неопределено Тогда
		Возврат ТаблицаПоручений;
	КонецЕсли;
		
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл 
		
		Если СтрДлина(СокрЛП(СтрокаТаблицыДанных.Uid)) <> 36 Тогда
			//ЗарегистрироватьОшибкуЭкспорта("В таблице [NonTradesOrders] присутствуют данные без уникального идентификатора [поле: BasisUid]! ");
	        Продолжить;
		Иначе
			
			ТестоваяБаза = Не ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза;
			
			Попытка
				ДокументСсылка = Документы.ПоручениеНаПереводДенежныхСредств.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаТаблицыДанных.Uid));
			Исключение
				ЗарегистрироватьОшибкуЭкспорта(?(ТестоваяБаза, "Вы используете тестовую базу. ", "") + "Не удалось найти поручение на перевод ДС по уникальному идентификатору [" + СтрокаТаблицыДанных.Uid + "]");
				Продолжить;
			КонецПопытки;
			
			Если ДокументСсылка.ПолучитьОбъект() = Неопределено Тогда
				ЗарегистрироватьОшибкуЭкспорта(?(ТестоваяБаза, "Вы используете тестовую базу. ", "") + "Не удалось найти поручение на перевод ДС по уникальному идентификатору [" + СтрокаТаблицыДанных.Uid + "]");
				Продолжить;
			КонецЕсли; 
			
		КонецЕсли;
		
		Если ПустаяСтрока(СтрокаТаблицыДанных.Status) Тогда
			//ЗарегистрироватьОшибкуЭкспорта("В таблице [" + ЭтотОбъект.ТаблицаПорученийSQL + "] присутствуют поручения без статуса!");
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока                   = ТаблицаПоручений.Добавить();
		НоваяСтрока.НомерПоручения    = СтрокаТаблицыДанных.Number;
		НоваяСтрока.СтатусПоручения   = СтрокаТаблицыДанных.Status;
		НоваяСтрока.ПоручениеСсылка   = ДокументСсылка;
		НоваяСтрока.ОшибкаПриЭкспорте = Ложь;
		
	КонецЦикла; 
				
	Возврат ТаблицаПоручений;

КонецФункции

Процедура УстранитьРасхождения() Экспорт
	
	ТаблицаДанныхИзКвика = ПолучитьДанныеИзКвика(); 
	
	Если ТаблицаДанныхИзКвика = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ПоместитьДанныеПорученийВоВременнуюТаблицу(Запрос);
			
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанныхИзКвика.НомерПоручения КАК НомерПорученияКвик,
		|	ТаблицаДанныхИзКвика.СтатусПоручения КАК СтатусПорученияКвик,
		|	ТаблицаДанныхИзКвика.ПоручениеСсылка КАК ПоручениеСсылка,
		|	ТаблицаДанныхИзКвика.ВремяОшибки КАК ВремяОшибки,
		|	ТаблицаДанныхИзКвика.СтатусОшибки КАК СтатусОшибки,
		|	ТаблицаДанныхИзКвика.СтатусОшибкиТекст КАК СтатусОшибкиТекст,
		|	ТаблицаДанныхИзКвика.СообщениеОбОшибке КАК СообщениеОбОшибке,
		|	ТаблицаДанныхИзКвика.ОшибкаПриЭкспорте КАК ОшибкаПриЭкспорте
		|ПОМЕСТИТЬ _ТаблицаДанныхИзКвика
		|ИЗ
		|	&ТаблицаДанныхИзКвика КАК ТаблицаДанныхИзКвика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПоручений.Ссылка КАК Ссылка,
		|	_ТаблицаПоручений.Статус КАК ТекущийСтатусПоручения1C,
		|	_ТаблицаПоручений.Статус КАК Статус,
		|	_ТаблицаПоручений.ПериодСтатуса КАК ПериодСтатуса,
		|	_ТаблицаПоручений.ПереводСсылка КАК ПереводСсылка,
		|	_ТаблицаПоручений.Брокер КАК Брокер,
		|	_ТаблицаПоручений.БрокерПолучатель КАК БрокерПолучатель,
		|	_ТаблицаПоручений.МестоХранения КАК МестоХранения,
		|	_ТаблицаПоручений.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	_ТаблицаПоручений.МестоХраненияСтрокой КАК МестоХраненияСтрокой,
		|	_ТаблицаПоручений.МестоХраненияПолучательСтрокой КАК МестоХраненияПолучательСтрокой,
		|	_ТаблицаПоручений.РасчетныйСчетПолучатель КАК РасчетныйСчетПолучатель
		|ПОМЕСТИТЬ _ТекПоручения
		|ИЗ
		|	_ТаблицаПоручений КАК _ТаблицаПоручений
		|ГДЕ
		|	(_ТаблицаПоручений.Дата > &НачалоДня
		|			ИЛИ _ТаблицаПоручений.Дата < &НачалоДня
		|				И _ТаблицаПоручений.АктивныйСтатус)
		|	И НЕ _ТаблицаПоручений.Статус ЕСТЬ NULL
		|	И НЕ _ТаблицаПоручений.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОжидаетАкцепта))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТекПоручения.Ссылка КАК Ссылка,
		|	_ТекПоручения.Статус КАК ТекущийСтатусПоручения1C,
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК НомерПорученияКвикИзРегистра,
		|	_ТаблицаДанныхИзКвика.НомерПорученияКвик КАК НомерПорученияКвик,
		|	_ТаблицаДанныхИзКвика.СтатусПорученияКвик КАК СтатусПорученияКвик,
		|	_ТаблицаДанныхИзКвика.СообщениеОбОшибке КАК СообщениеОбОшибке,
		|	ВЫБОР
		|		КОГДА _ТаблицаДанныхИзКвика.ОшибкаПриЭкспорте ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА _ТекПоручения.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Отправлено), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте))
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ _ТаблицаДанныхИзКвика.ОшибкаПриЭкспорте
		|	КОНЕЦ КАК ОшибкаПриЭкспорте,
		|	РАЗНОСТЬДАТ(_ТекПоручения.ПериодСтатуса, &ТекущаяДатаСеанса, МИНУТА) КАК ВременнойИнтервал,
		|	ВЫБОР
		|		КОГДА _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Отправлено)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик ЕСТЬ NULL
		|						ТОГДА _ТекПоручения.Статус
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Активно)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Запрос на отмену""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ЗапросНаОтмену)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Снято""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено)
		|					КОГДА _ТаблицаДанныхИзКвика.ОшибкаПриЭкспорте
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте)
		|				КОНЕЦ
		|		КОГДА _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Активно)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Запрос на отмену""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ЗапросНаОтмену)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Снято""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно""
		|						ТОГДА _ТекПоручения.Статус
		|				КОНЕЦ
		|		КОГДА _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ЗапросНаОтмену)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Активно)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Снято""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Запрос на отмену""
		|						ТОГДА _ТекПоручения.Статус
		|				КОНЕЦ
		|		КОГДА _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте)
		|			ТОГДА ВЫБОР
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик ЕСТЬ NULL
		|							ИЛИ _ТаблицаДанныхИзКвика.СтатусПорученияКвик = """"
		|						ТОГДА _ТекПоручения.Статус
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Активно)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Снято""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено)
		|					КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Запрос на отмену""
		|						ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ЗапросНаОтмену)
		|				КОНЕЦ
		|		ИНАЧЕ _ТекПоручения.Статус
		|	КОНЕЦ КАК НовыйСтатусПоручения1С,
		|	ВЫБОР
		|		КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено""
		|				И _ТекПоручения.ПереводСсылка ЕСТЬ NULL
		|				И НЕ(_ТекПоручения.Брокер = _ТекПоручения.БрокерПолучатель
		|						И _ТекПоручения.МестоХранения = _ТекПоручения.МестоХраненияПолучатель
		|						И (_ТекПоручения.МестоХранения = &ММВБ_ТорговыйПлюс
		|							ИЛИ _ТекПоручения.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|								И НЕ(_ТекПоручения.МестоХраненияСтрокой = ""Внебиржевые_Валютный_V""
		|										ИЛИ _ТекПоручения.МестоХраненияПолучательСтрокой = ""Внебиржевые_Валютный_V""))
		|						И _ТекПоручения.РасчетныйСчетПолучатель = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК СоздатьПеревод,
		|	ВЫБОР
		|		КОГДА _ТаблицаДанныхИзКвика.СтатусПорученияКвик ЕСТЬ NULL
		|				И НЕ КодыВоВнешнихСистемахСрезПоследних.Код ЕСТЬ NULL
		|				И _ТекПоручения.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Активно), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено), ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ЗапросНаОтмену))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОшибкаВыводаДанныхПоODBC,
		|	ВЫБОР
		|		КОГДА _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ЗапросНаОтмену)
		|					И (_ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно""
		|						ИЛИ _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено"")
		|				ИЛИ _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Снято)
		|					И (_ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно""
		|						ИЛИ _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Исполнено""
		|						ИЛИ _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Запрос на отмену"")
		|				ИЛИ _ТекПоручения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.Исполнено)
		|					И (_ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Снято""
		|						ИЛИ _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Запрос на отмену""
		|						ИЛИ _ТаблицаДанныхИзКвика.СтатусПорученияКвик = ""Активно"")
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОшибкаСменыСтатуса
		|ИЗ
		|	_ТекПоручения КАК _ТекПоручения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&КонецДня,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.QUIK)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.НомераПоручений)) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО _ТекПоручения.Ссылка = КодыВоВнешнихСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаДанныхИзКвика КАК _ТаблицаДанныхИзКвика
		|		ПО _ТекПоручения.Ссылка = _ТаблицаДанныхИзКвика.ПоручениеСсылка";
#КонецОбласти

	Запрос.УстановитьПараметр("ТаблицаДанныхИзКвика", ТаблицаДанныхИзКвика);
	Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ММВБ_ТорговыйПлюс", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+"));
	
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаДанных.Количество() < ТаблицаДанныхИзКвика.Количество() Тогда
		ЗарегистрироватьОшибкуЭкспорта("В QUIKе количество поручений [" + ТаблицаДанныхИзКвика.Количество() + "] превышает количество поручений в 1С [" + ТаблицаДанных.Количество() + "]");
	КонецЕсли;
	
	Если ТаблицаДанных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивПоручений = Новый Массив;
	ЗарегистрированаОшибкаВыводаДанныхПоODBC = Ложь;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
				
		//Если возникнет ошибка при экспорте в QUIK, но поручение все же экспортируется
		//Или в таблице поручений присутствует несколько записей по одному поручению с разными статусами.(такое возможно если криво настроен вывод данных ODBC)
		Если МассивПоручений.Найти(СтрокаДанных.Ссылка) = Неопределено Тогда
			МассивПоручений.Добавить(СтрокаДанных.Ссылка);
		Иначе
			ЗарегистрироватьОшибкуЭкспорта("Экспорт поручения [" + СтрокаДанных.Ссылка + "] осуществлен с ошибкой, или в таблице NonTradeOrders присутствует несколько различных записей по одному поручению!");
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДанных.ОшибкаВыводаДанныхПоODBC Тогда

			Если Не ЗарегистрированаОшибкаВыводаДанныхПоODBC Тогда
				ЗарегистрироватьОшибкуЭкспорта("В таблице [" + ЭтотОбъект.БазаДанныхSQL + "].[" + ЭтотОбъект.ТаблицаПорученийSQL + "] отсутствуют записи о поручениях (с активным статусом). Проверьте настройки вывода данных по ODBC из QUIKа!");
				ЗарегистрированаОшибкаВыводаДанныхПоODBC = Истина;
			КонецЕсли;
			
			Продолжить;

		КонецЕсли;
		
		Если СтрокаДанных.ОшибкаСменыСтатуса Тогда
			
			ЗарегистрироватьОшибкуЭкспорта("Возникла ошибка при попытке смены статуса поручения [" + СтрокаДанных.Ссылка + "] . Статус в квике [" + СтрокаДанных.СтатусПорученияКвик + "] -> Текущий статус в 1С [" + СтрокаДанных.ТекущийСтатусПоручения1C + "].");
			Продолжить;
			
		КонецЕсли;
		
		Если СтрокаДанных.НовыйСтатусПоручения1С = Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Отправлено И СтрокаДанных.ВременнойИнтервал > 30 Тогда 
			ЗарегистрироватьОшибкуЭкспорта("[" + СтрокаДанных.Ссылка + "] отсутствует в Квике. Поручение отправлено в Квик более 30 мин. назад. Проверьте вывод данных по ODBC!");
		КонецЕсли;
		
		Если СтрокаДанных.ОшибкаПриЭкспорте И СтрокаДанных.ТекущийСтатусПоручения1C <> Перечисления.СтатусыПорученийНаПереводДенежныхСредств.ОшибкаПриЭкспорте Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаДанных.СообщениеОбОшибке) Тогда   
				ЗарегистрироватьОшибкуЭкспорта("[" + СтрокаДанных.Ссылка + "] со статусом 1С [" + СтрокаДанных.ТекущийСтатусПоручения1C + "] отсутствует в Квике! Проверьте вывод данных по ODBC из Квика!");
			КонецЕсли;
			
		КонецЕсли;
							
		Если Не ЗначениеЗаполнено(СтрокаДанных.НомерПорученияКвикИзРегистра) И ЗначениеЗаполнено(СтрокаДанных.НомерПорученияКвик) Тогда
			РаботаСВнешнимиСистемами.ЗарегистрироватьКодОбъектаВоВнешнейСистеме(СтрокаДанных.Ссылка, Справочники.ВнешниеСистемы.QUIK, Справочники.ГруппыИмпортируемыхОбъектов.НомераПоручений, Формат(СтрокаДанных.НомерПорученияКвик, "ЧГ="));
		КонецЕсли;
		
		Если СтрокаДанных.НовыйСтатусПоручения1С <> СтрокаДанных.ТекущийСтатусПоручения1C Тогда
			РегистрыСведений.СтатусыПорученийНаПереводДенежныхСредств.УстановитьСтатусПоручения(СтрокаДанных.Ссылка, СтрокаДанных.НовыйСтатусПоручения1С, СтрокаДанных.СообщениеОбОшибке);
		КонецЕсли;
		
		Если СтрокаДанных.СоздатьПеревод Тогда
			
			ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;
			Документ = Документы.ПереводДенежныхСредств.СоздатьДокумент();
			Документ.Заполнить(СтрокаДанных.Ссылка);
			
			Если НачалоДня(ЭтотОбъект.ДатаЭкспорта) = НачалоДня(ТекущаяДатаСеанса()) Тогда
				Документ.Дата = ТекущаяДатаСеанса();
			Иначе
				Документ.Дата = КонецДня(ЭтотОбъект.ДатаЭкспорта);                         
			КонецЕсли;
			
			Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
			Документ.Комментарий   = "Создан аппаратно-техническими средствами " + ТекущаяДата();
			
			Попытка
				Документ.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Документ.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
			
		КонецЕсли;
						
	КонецЦикла;
		
КонецПроцедуры

Процедура ЭкспортироватьДанные(АдресФайла) Экспорт
	
	ТекстовыйДокументДляЭкспорта = Новый ТекстовыйДокумент;
	
	НачатьТранзакцию();
	
	БлокировкаДанных = Новый БлокировкаДанных();
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств");
	БлокировкаДанных.Заблокировать();
		
	Запрос = Новый Запрос;
		
	ПоместитьДанныеПорученийВоВременнуюТаблицу(Запрос);
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	_ТаблицаПоручений.Ссылка КАК ПоручениеСсылка,
	    |	ВЫБОР
	    |		КОГДА _ТаблицаПоручений.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке)
	    |			ТОГДА ИСТИНА
	    |		ИНАЧЕ ЛОЖЬ
	    |	КОНЕЦ КАК ЗарегистрироватьСтатус
	    |ПОМЕСТИТЬ _СтатусыПоручений
	    |ИЗ
	    |	_ТаблицаПоручений КАК _ТаблицаПоручений
	    |ГДЕ
	    |	_ТаблицаПоручений.Дата >= &НачалоДня
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	МАКСИМУМ(_СтатусыПоручений.ЗарегистрироватьСтатус) КАК ЕстьНовыеПоручения
	    |ИЗ
	    |	_СтатусыПоручений КАК _СтатусыПоручений
	    |
	    |ИМЕЮЩИЕ
	    |	МАКСИМУМ(_СтатусыПоручений.ЗарегистрироватьСтатус) = ИСТИНА";
		
	Если Запрос.Выполнить().Пустой() Тогда
		ОтменитьТранзакцию();
		Возврат;
	КонецЕсли;
			
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.НомерДоговора КАК НомерДоговора,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения КАК ДатаЗаключения,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.КодFORTS КАК КодFORTS,
		|	ИменованныеОбъекты.Имя КАК БрокерИмяИменнованногоОбъекта
		|ПОМЕСТИТЬ _КодыУБрокеров
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&КонецДня,
		|			Брокер = &Брокер
		|				И Организация = &Организация
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						_ТаблицаПоручений.СчетДоверительногоУправления
		|					ИЗ
		|						_ТаблицаПоручений КАК _ТаблицаПоручений)) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИменованныеОбъекты КАК ИменованныеОбъекты
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер = ИменованныеОбъекты.Объект
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Договоры.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДополнительноеСоглашение)
		|				И Договоры.НаименованиеВладельцаДляДокументов = """"
		|			ТОГДА ОснованияДопСоглашений.НаименованиеВладельцаДляДокументов
		|		ИНАЧЕ Договоры.НаименованиеВладельцаДляДокументов
		|	КОНЕЦ КАК НаименованиеВладельцаДляДокументов
		|ПОМЕСТИТЬ _ДоговорыБанковскогоОбслуживания
		|ИЗ
		|	_ТаблицаПоручений КАК _ТаблицаПоручений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК ОснованияДопСоглашений
		|			ПО Договоры.Основание = ОснованияДопСоглашений.Ссылка
		|		ПО _ТаблицаПоручений.РасчетныйСчетПолучатель.Договор = Договоры.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЮрЛица.Ссылка КАК Ссылка,
		|	СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо КАК ГоловнаяОрганизация
		|ПОМЕСТИТЬ _ЮрЛица
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ТаблицаПоручений.Брокер.ЮрФизЛицо КАК Ссылка
		|	ИЗ
		|		_ТаблицаПоручений КАК _ТаблицаПоручений
		|	ГДЕ
		|		_ТаблицаПоручений.Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		_ТаблицаПоручений.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо
		|	ИЗ
		|		_ТаблицаПоручений КАК _ТаблицаПоручений
		|	ГДЕ
		|		_ТаблицаПоручений.РасчетныйСчетПолучатель <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		_ТаблицаПоручений.РасчетныйСчетПолучатель.ЮрФизЛицо
		|	ИЗ
		|		_ТаблицаПоручений КАК _ТаблицаПоручений
		|	ГДЕ
		|		_ТаблицаПоручений.РасчетныйСчетПолучатель <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)) КАК ЮрЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&НачалоДня, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО ЮрЛица.Ссылка = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ЮрЛицо КАК ЮрЛицо,
		|	ВложенныйЗапрос.ФлГоловнаяОрганизация КАК ФлГоловнаяОрганизация,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование,
		|	РеквизитыЮридическихЛицСрезПоследних.ИНН КАК ИНН
		|ПОМЕСТИТЬ _РеквизитыЮрФизЛиц
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ЮрЛица.Ссылка КАК ЮрЛицо,
		|		_ЮрЛица.Ссылка КАК Ссылка,
		|		ЛОЖЬ КАК ФлГоловнаяОрганизация
		|	ИЗ
		|		_ЮрЛица КАК _ЮрЛица
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		_ЮрЛица.Ссылка,
		|		_ЮрЛица.ГоловнаяОрганизация,
		|		ИСТИНА
		|	ИЗ
		|		_ЮрЛица КАК _ЮрЛица
		|	ГДЕ
		|		НЕ _ЮрЛица.ГоловнаяОрганизация ЕСТЬ NULL) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&КонецДня,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.Ссылка = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Ссылка КАК Поручение,
		|	НомераТранзакций.Номер КАК Номер
		|ПОМЕСТИТЬ _Транзакции
		|ИЗ
		|	РегистрСведений.НомераТранзакций КАК НомераТранзакций
		|ГДЕ
		|	НомераТранзакций.ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.QUIK)
		|	И ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Организация = &Организация
		|	И ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Брокер = &Брокер
		|	И ВЫРАЗИТЬ(НомераТранзакций.Субъект КАК Документ.ПоручениеНаПереводДенежныхСредств).Дата >= &НачалоДня
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПоручений.Ссылка КАК ПоручениеСсылка,
		|	ВЫБОР
		|		КОГДА _ТаблицаПоручений.РасчетныйСчетПолучатель <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|			ТОГДА _ТаблицаПоручений.РасчетныйСчетПолучатель.Банк.Код + ""|"" + _ТаблицаПоручений.РасчетныйСчетПолучатель.НомерСчета + ""|"" + ВЫБОР
		|					КОГДА _КодыУБрокеров.БрокерИмяИменнованногоОбъекта = ""Брокер_ГПБ""
		|						ТОГДА ЕСТЬNULL(РеквизитыГоловныхБанков.КраткоеНаименованиеПоУставу, РеквизитыБанков.КраткоеНаименованиеПоУставу)
		|					ИНАЧЕ РеквизитыБанков.КраткоеНаименованиеПоУставу
		|				КОНЕЦ + ""|"" + _ТаблицаПоручений.РасчетныйСчетПолучатель.Банк.КоррСчет
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК РеквизитыСчетПолучатель,
		|	ВЫБОР
		|		КОГДА _ТаблицаПоручений.РасчетныйСчетПолучатель <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|			ТОГДА ВЫБОР
		|					КОГДА _КодыУБрокеров.БрокерИмяИменнованногоОбъекта = ""Брокер_ГПБ""
		|						ТОГДА ДоговорыБанковскогоОбслуживания.НаименованиеВладельцаДляДокументов
		|					ИНАЧЕ ""р/с "" + _ТаблицаПоручений.РасчетныйСчетПолучатель.НомерСчета + "", "" + РеквизитыБанков.СокращенноеНаименование
		|				КОНЕЦ
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Получатель,
		|	ВЫБОР
		|		КОГДА _ТаблицаПоручений.РасчетныйСчетПолучатель <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|			ТОГДА _ТаблицаПоручений.РасчетныйСчетПолучатель.НомерСчета + "", "" + РеквизитыБанков.СокращенноеНаименование
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК СчетПолучатель,
		|	ДоговорыБанковскогоОбслуживания.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов
		|ПОМЕСТИТЬ _БанковскиеРеквизитыСтрокой
		|ИЗ
		|	_ТаблицаПоручений КАК _ТаблицаПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыУБрокеров КАК _КодыУБрокеров
		|		ПО _ТаблицаПоручений.СчетДоверительногоУправления = _КодыУБрокеров.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДоговорыБанковскогоОбслуживания КАК ДоговорыБанковскогоОбслуживания
		|		ПО _ТаблицаПоручений.РасчетныйСчетПолучатель.Договор = ДоговорыБанковскогоОбслуживания.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛиц КАК РеквизитыБанков
		|		ПО _ТаблицаПоручений.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо = РеквизитыБанков.ЮрЛицо
		|			И (НЕ РеквизитыБанков.ФлГоловнаяОрганизация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛиц КАК РеквизитыГоловныхБанков
		|		ПО _ТаблицаПоручений.РасчетныйСчетПолучатель.Банк.ЮрФизЛицо = РеквизитыГоловныхБанков.ЮрЛицо
		|			И (РеквизитыГоловныхБанков.ФлГоловнаяОрганизация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаПоручений.Номер КАК Номер,
		|	_ТаблицаПоручений.Ссылка КАК Ссылка,
		|	_ТаблицаПоручений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ТаблицаПоручений.БрокерПолучатель = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|				И НЕ _ТаблицаПоручений.РасчетныйСчетПолучатель = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|			ТОГДА ""Вывод""
		|		ИНАЧЕ ""Перевод""
		|	КОНЕЦ КАК ТипПоручения,
		|	_ТаблицаПоручений.Сумма КАК Сумма,
		|	_ТаблицаПоручений.Валюта КАК Валюта,
		|	_ТаблицаПоручений.МестоХранения КАК МестоХранения,
		|	_ТаблицаПоручений.МестоХраненияСтрокой КАК МестоХраненияСтрокой,
		|	_ТаблицаПоручений.МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	_ТаблицаПоручений.МестоХраненияПолучательСтрокой КАК МестоХраненияПолучательСтрокой,
		|	_БанковскиеРеквизитыСтрокой.СчетПолучатель КАК СчетПолучатель,
		|	_БанковскиеРеквизитыСтрокой.Получатель КАК Получатель,
		|	_БанковскиеРеквизитыСтрокой.РеквизитыСчетПолучатель КАК РеквизитыСчетПолучатель,
		|	_БанковскиеРеквизитыСтрокой.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов,
		|	_РеквизитыВладельцев.ИНН КАК ИНН,
		|	_КодыУБрокеров.Код КАК КодСчетаДУуБрокера,
		|	_КодыУБрокеров.КодFORTS КАК КодFORTSСчетаДУуБрокера,
		|	_КодыУБрокеров.НомерДоговора КАК НомерДоговораБрокерскогоОбслуживания,
		|	_КодыУБрокеров.ДатаЗаключения КАК ДатаЗаключенияДоговораБрокерскогоОбслуживания,
		|	_КодыУБрокеров.БрокерИмяИменнованногоОбъекта КАК БрокерИмяИменнованногоОбъекта,
		|	Транзакции.Номер КАК НомерТранзакции,
		|	_СтатусыПоручений.ЗарегистрироватьСтатус КАК ЗарегистрироватьСтатус
		|ИЗ
		|	_ТаблицаПоручений КАК _ТаблицаПоручений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _КодыУБрокеров КАК _КодыУБрокеров
		|		ПО _ТаблицаПоручений.СчетДоверительногоУправления = _КодыУБрокеров.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ _БанковскиеРеквизитыСтрокой КАК _БанковскиеРеквизитыСтрокой
		|		ПО _ТаблицаПоручений.Ссылка = _БанковскиеРеквизитыСтрокой.ПоручениеСсылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыЮрФизЛиц КАК _РеквизитыВладельцев
		|		ПО _ТаблицаПоручений.РасчетныйСчетПолучатель.ЮрФизЛицо = _РеквизитыВладельцев.ЮрЛицо
		|			И (НЕ _РеквизитыВладельцев.ФлГоловнаяОрганизация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Транзакции КАК Транзакции
		|		ПО _ТаблицаПоручений.Ссылка = Транзакции.Поручение
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтатусыПоручений КАК _СтатусыПоручений
		|		ПО _ТаблицаПоручений.Ссылка = _СтатусыПоручений.ПоручениеСсылка
		|ГДЕ
		|	_ТаблицаПоручений.Дата >= &НачалоДня
		|	И (_ТаблицаПоручений.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПорученийНаПереводДенежныхСредств.ГотовКОтправке)
		|			ИЛИ НЕ Транзакции.Номер ЕСТЬ NULL)";

#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	ФлагПерезаписатьФайл = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(Выборка.БрокерИмяИменнованногоОбъекта) Или Не ЗначениеЗаполнено(Выборка.КодСчетаДУуБрокера) Тогда
			ЗарегистрироватьОшибкуЭкспорта("Не удалось определить код брокера [" + ЭтотОбъект.Брокер + "] для клиента [" + Выборка.СчетДоверительногоУправления + "].");
			Продолжить;
		КонецЕсли;
		
		СтрокаЭкспорта = СформироватьСтрокуЭкспорта(Выборка);
		
		Если СтрокаЭкспорта = "" Тогда
			Продолжить;
		Иначе
			ТекстовыйДокументДляЭкспорта.ДобавитьСтроку(СтрокаЭкспорта);	
		КонецЕсли;
		
		Если Выборка.ЗарегистрироватьСтатус И ПараметрыСеанса.ЭтоРабочаяИнформационнаяБаза Тогда
			
			РегистрыСведений.СтатусыПорученийНаПереводДенежныхСредств.УстановитьСтатусПоручения(Выборка.Ссылка, Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Отправлено);
			//регистрация статуса "Отправлено" говорит о том, что поручение новое и еще не отправлялось в QUIK 
			ФлагПерезаписатьФайл = Истина; 
			
		КонецЕсли;
		
	КонецЦикла; 
	
	//Возникает конфликт доступа к tri-файлу между Квиком и 1С. Квик читает файл каждые 60 сек.
	//Если нет новых поручений - файл не перезаписываем.
	Если ФлагПерезаписатьФайл Тогда
		
		Если ЗаписатьДанныеВФайл(ТекстовыйДокументДляЭкспорта, АдресФайла) Тогда
			ЗафиксироватьТранзакцию();
		Иначе
			ОтменитьТранзакцию();
		КонецЕсли;
		
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;
		
КонецПроцедуры

Функция ПеренестиДанныеФайловВАрхив(ИмяТрайФайла)
	
	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		ИмяФайла = "RAM";
	ИначеЕсли ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
		ИмяФайла = "TRAST";
	Иначе
		ЗарегистрироватьОшибкуЭкспорта("Для организации [" + ЭтотОбъект.Организация + "] не настроена архивация tri-файлов.");
		Возврат Ложь;
	КонецЕсли;
	
	Если ЭтотОбъект.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион") Тогда
	//	ИмяФайла = ИмяФайла + "_" + "BK";	
	ИначеЕсли ЭтотОбъект.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ") Тогда
		ИмяФайла = ИмяФайла + "_" + "GPB";	
	Иначе
		ЗарегистрироватьОшибкуЭкспорта("Для брокера [" + ЭтотОбъект.Брокер + "] не настроена архивация tri-файлов.");
		Возврат Ложь;
	КонецЕсли;
		
	ТрайФайл = Новый Файл(СокрЛП(ИмяТрайФайла));
	
	Если Не ТрайФайл.Существует()  Тогда
		ЗарегистрироватьОшибкуЭкспорта("Не удалось получить данные для архивации. Не найден файл [" + ИмяТрайФайла + "]. " + ОписаниеОшибки());
		Возврат Ложь;
	КонецЕсли;
	
	Папка = ТрайФайл.Путь;
	
	ПредыдущаяДата = ПолучитьПредыдущуюДату(ЭтотОбъект.ДатаЭкспорта);
	ИмяФайлаАрхива = ИмяФайла + "_" + Нрег(Формат(ПредыдущаяДата, "ДФ=""ММММ_гггг""")) + ".txt";
	
	ИмяФайлаАрхива = Папка + ИмяФайлаАрхива;
	
	АрхивФайл = Новый Файл(ИмяФайлаАрхива);
	
	Если Не АрхивФайл.Существует() Тогда
		ЗарегистрироватьОшибкуЭкспорта("Не удалось перенести данные в архив. Не найден файл [" + ИмяФайлаАрхива + "]. " + ОписаниеОшибки());
		Возврат Ложь;
	КонецЕсли;
	
	АрхивТекстФайла = Новый ТекстовыйДокумент;
	АрхивТекстФайла.ИспользуемоеИмяФайла = ИмяФайлаАрхива;
	
	Если Не ПрочитатьФайл(АрхивТекстФайла, ИмяФайлаАрхива) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	//Проверяем нужно ли переносить данные.
	ФайлАрхиваПуст = Истина;
	
	Если АрхивТекстФайла.КоличествоСтрок() > 0 Тогда
		
		ФайлАрхиваПуст = Ложь;
		УстановленаДатаАрхивирования = Ложь;
		
		Для Инд = -АрхивТекстФайла.КоличествоСтрок() По -1 Цикл
			ТекСтрокаФайла = АрхивТекстФайла.ПолучитьСтроку(-Инд);
			
			Если Найти(ТекСтрокаФайла, "архив_дата=") > 0  Тогда
				
				УстановленаДатаАрхивирования = Истина;
				
				Если Сред(ТекСтрокаФайла, СтрНайти(ТекСтрокаФайла, "архив_дата=") + 11, 10) = Формат(ПредыдущаяДата, "ДФ=""гггг-ММ-дд""") Тогда
					//Архивирование уже осуществлено
					Возврат Истина;
				Иначе
					//Доп. проверка. Проверяем дату последней архивации
					ДатаПоследнейАрхивацииПлан = Формат(ПолучитьПредыдущуюДату(Дата(ПредыдущаяДата)), "ДФ=""гггг-ММ-дд""");
					ДатаПоследнейАрхивацииФакт = Сред(ТекСтрокаФайла, СтрНайти(ТекСтрокаФайла, "архив_дата=") + 11, 10);
					Если ДатаПоследнейАрхивацииПлан = ДатаПоследнейАрхивацииФакт Тогда
						Прервать;
					Иначе
						ЗарегистрироватьОшибкуЭкспорта("Ошибка данных в архив-файле. Дата последней архивации [" + ДатаПоследнейАрхивацииФакт + "] не равна дате [" + ДатаПоследнейАрхивацииПлан + "]");
						Возврат Ложь;
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли ПустаяСтрока(ТекСтрокаФайла) Тогда
				Продолжить;	
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не УстановленаДатаАрхивирования Тогда
			ЗарегистрироватьОшибкуЭкспорта("Файл [" + ИмяФайлаАрхива + "]. Не удалось определить дату последний архивации!");
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Если ЭтоПервыйРабочийДеньМесяца(Дата(ПредыдущаяДата)) Тогда
			//Если файл архива пуст и при этом дата архиваций равна первому рабочему дню - так и должно быть.
			//На каждый месяц создается новый файл для архивации. 
		Иначе
			ЗарегистрироватьОшибкуЭкспорта("При архивации обнаружена ошибка. Файл [" + ИмяФайлаАрхива + "] пуст!");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	//Переносим данные из tri-файла
	ТекстТрайФайла = Новый ТекстовыйДокумент;
	ТекстТрайФайла.ИспользуемоеИмяФайла = ИмяТрайФайла;
	Если Не ПрочитатьФайл(ТекстТрайФайла, ИмяТрайФайла) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ФайлАрхиваПуст Тогда
		АрхивТекстФайла.ДобавитьСтроку("Архив файла: " + ИмяТрайФайла);//инфа о файле источнике
	КонецЕсли;
	                                            
	АрхивТекстФайла.ДобавитьСтроку(Символы.ПС + "--- поручения_архив_дата=" + Формат(ПредыдущаяДата,"ДФ=""гггг-ММ-дд"""));
	Если ТекстТрайФайла.КоличествоСтрок() > 0 Тогда
		Для Инд = 1 По ТекстТрайФайла.КоличествоСтрок() Цикл							   
			АрхивТекстФайла.ДобавитьСтроку(ТекстТрайФайла.ПолучитьСтроку(Инд));
		КонецЦикла;
	Иначе
		АрхивТекстФайла.ДобавитьСтроку("Данные отсутствуют");
	КонецЕсли;
	АрхивТекстФайла.ДобавитьСтроку("--- поручения_архив_дата=" + Формат(ПредыдущаяДата,"ДФ=""гггг-ММ-дд"""));
	
	//Если это первый рабочий день месяца
	// -создаем новый файл (на текущий месяц)
	// -переносим данные из файла логов и файла ответов в файл предыдущего месяца
	// -очищаем файл логов, файл ответов, файл поручений
	
	АрхивФайлЗаписан = Ложь;
	
	Если ЭтоПервыйРабочийДеньМесяца(ЭтотОбъект.ДатаЭкспорта) Тогда
	//Создали Файл на текущий месяц
		ИмяФайлаНовогоАрхива = Папка + ИмяФайла + "_" + Нрег(Формат(ТекущаяДата(), "ДФ=""ММММ_гггг""")) + ".txt";
		
		НовыйФайл = Новый ТекстовыйДокумент;
		Попытка 
			
			НовыйФайл.Прочитать(ИмяФайлаНовогоАрхива);
			ЗарегистрироватьОшибкуЭкспорта("При попытке создания нового файла для архивирования данных обнаружен одноименный файл: " + ИмяФайлаНовогоАрхива);
			Возврат Ложь;
			
		Исключение
			
			Если Не ЗаписатьДанныеВФайл(НовыйФайл, ИмяФайлаНовогоАрхива) Тогда
				ЗарегистрироватьОшибкуЭкспорта("Не удалось создать новый архив-файл: " + ИмяФайлаНовогоАрхива);
				Возврат Ложь;
			КонецЕсли;
			
		КонецПопытки;
		
	//Копируем файл логов
		ИмяЛогФайла = Папка + ИмяФайла + "_" + "Logs.trr";
		
		ЛогФайл = Новый Файл(ИмяЛогФайла);
		Если Не ЛогФайл.Существует()  Тогда
			ЗарегистрироватьОшибкуЭкспорта("Не удалось получить данные для архивации. Не найден файл [" + ИмяЛогФайла + "]. " + ОписаниеОшибки());
			Возврат Ложь;
		КонецЕсли;
		
		ТекстЛогФайла = Новый ТекстовыйДокумент;
		ТекстЛогФайла.ИспользуемоеИмяФайла = ИмяЛогФайла;
		Если Не ПрочитатьФайл(ТекстЛогФайла, ИмяЛогФайла) Тогда
			Возврат Ложь;
		КонецЕсли;
				
		АрхивТекстФайла.ДобавитьСтроку(Символы.ПС + "Архив файла: " + ИмяЛогФайла);
		АрхивТекстФайла.ДобавитьСтроку("--- логи_архив_дата=" + Формат(ПредыдущаяДата,"ДФ=""гггг-ММ-дд"""));
		
		Для Инд = 1 по ТекстЛогФайла.КоличествоСтрок() Цикл
			АрхивТекстФайла.ДобавитьСтроку(ТекстЛогФайла.ПолучитьСтроку(Инд));
		КонецЦикла;
		АрхивТекстФайла.ДобавитьСтроку("--- логи_архив_дата=" + Формат(ПредыдущаяДата,"ДФ=""гггг-ММ-дд"""));
		
	//Копируем файл ответов
		ИмяФайлаОтветов = Папка + ИмяФайла + "_" + "Output.tro";
		
		ФайОтветов = Новый Файл(ИмяФайлаОтветов);
		Если Не ФайОтветов.Существует()  Тогда
			ЗарегистрироватьОшибкуЭкспорта("Не удалось получить данные для архивации. Не найден файл [" + ИмяФайлаОтветов + "]. " + ОписаниеОшибки());
			Возврат Ложь;
		КонецЕсли;
		
		ТекстФайлаОтветов = Новый ТекстовыйДокумент;
		ТекстФайлаОтветов.ИспользуемоеИмяФайла = ИмяФайлаОтветов;
		Если Не ПрочитатьФайл(ТекстФайлаОтветов, ИмяФайлаОтветов) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		АрхивТекстФайла.ДобавитьСтроку(Символы.ПС + "Архив файла: " + ИмяФайлаОтветов);
		АрхивТекстФайла.ДобавитьСтроку("--- ответы_архив_дата=" + Формат(ПредыдущаяДата,"ДФ=""гггг-ММ-дд"""));		
		Для Инд = 1 по ТекстФайлаОтветов.КоличествоСтрок() Цикл
			АрхивТекстФайла.ДобавитьСтроку(ТекстФайлаОтветов.ПолучитьСтроку(Инд));
		КонецЦикла;
		АрхивТекстФайла.ДобавитьСтроку("--- ответы_архив_дата=" + Формат(ПредыдущаяДата,"ДФ=""гггг-ММ-дд"""));
		
		//Проверка если файл архива записан
		Если ЗаписатьДанныеВФайл(АрхивТекстФайла, ИмяФайлаАрхива) Тогда
			АрхивФайлЗаписан = Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
			
	//Очищаем данные файлов
		Если Не ЗаписатьДанныеВФайл(Новый ТекстовыйДокумент, ИмяЛогФайла) Тогда 
			ЗарегистрироватьОшибкуЭкспорта("Не удалось очистить данные файла [" + ИмяЛогФайла + "]. " + ОписаниеОшибки());
			Возврат Ложь;
		КонецЕсли;
		Если Не ЗаписатьДанныеВФайл(Новый ТекстовыйДокумент, ИмяФайлаОтветов) Тогда
			ЗарегистрироватьОшибкуЭкспорта("Не удалось очистить данные файла [" + ИмяФайлаОтветов + "]. " + ОписаниеОшибки());
			Возврат Ложь;	
		КонецЕсли;
		Если Не ЗаписатьДанныеВФайл(Новый ТекстовыйДокумент, ИмяТрайФайла) Тогда 
			ЗарегистрироватьОшибкуЭкспорта("Не удалось очистить данные файла [" + ИмяТрайФайла + "]. " + ОписаниеОшибки());
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если АрхивФайлЗаписан Тогда
		Возврат Истина;
	Иначе
		Если ЗаписатьДанныеВФайл(АрхивТекстФайла, ИмяФайлаАрхива) Тогда
			
			//очищаем tri-файл
			Если Не ЗаписатьДанныеВФайл(Новый ТекстовыйДокумент, ИмяТрайФайла) Тогда 
				ЗарегистрироватьОшибкуЭкспорта("Не удалось очистить данные файла [" + ИмяТрайФайла + "]. " + ОписаниеОшибки());
				Возврат Ложь;
			КонецЕсли;
			
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ЗаписатьДанныеВФайл(ТекстовыйДокумент, АдресФайла)
	
	Для НомерПопытки = 1 По 3 Цикл
	
		Попытка
			ТекстовыйДокумент.Записать(АдресФайла, КодировкаТекста.ANSI);
			Возврат Истина;
		Исключение
			Если НомерПопытки = 3 Тогда
				ЗарегистрироватьОшибкуЭкспорта("Не удалось записать данные в tri-файл [" + АдресФайла + "]. " + ОписаниеОшибки());
				Возврат Ложь;
			Иначе
				Timeout(3); // 3 секунды
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
КонецФункции

Функция ПрочитатьФайл(ТекстовыйДокумент, АдресФайла)
	
	Для НомерПопытки = 1 По 3 Цикл
	
		Попытка
			ТекстовыйДокумент.Прочитать(АдресФайла);
			Возврат Истина;
		Исключение
			Если НомерПопытки = 3 Тогда
				ЗарегистрироватьОшибкуЭкспорта("Не удалось прочитать файл [" + АдресФайла + "]. " + ОписаниеОшибки());
				Возврат Ложь;
			Иначе
				Timeout(3); // 3 секунды
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
КонецФункции

Процедура Timeout(Секунды)
    
    КомандаWindows = "Timeout /T " + Строка(Секунды) + " /NoBreak";
    ЗапуститьПриложение(КомандаWindows, , Истина);
    
КонецПроцедуры


ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
