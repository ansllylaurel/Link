
&НаСервере
Функция ПодтвердитьНаСервере()
	
	Если ПроверкаПройдена Тогда
	
		// Если на дату контроля зафиксированы нарушения, нельзя поставить признак "проверка пройдена".
	
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(*) КАК КоличествоНарушений
			|ИЗ
			|	Документ.Нарушение КАК Нарушение
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстранениеНарушения КАК УстранениеНарушения
			|		ПО (УстранениеНарушения.Основание = Нарушение.Ссылка)
			|			И (УстранениеНарушения.НарушениеУстранено)
			|ГДЕ
			|	(&Период МЕЖДУ Нарушение.ДатаВыявления И УстранениеНарушения.Дата
			|			ИЛИ Нарушение.ДатаВыявления < &Период
			|				И УстранениеНарушения.Ссылка ЕСТЬ NULL)
			|	И Нарушение.Организация = &Организация
			|	И Нарушение.СчетДоверительногоУправления = &СчетДоверительногоУправления";
		
		Запрос.УстановитьПараметр("Период", Объект.Период );
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", Объект.СчетДоверительногоУправления );
		Запрос.УстановитьПараметр("Организация", Объект.Организация );
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Пока Результат.Следующий() Цикл
		
			Если Результат.КоличествоНарушений > 0 Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Невозможно установить признак ""ПроверкаПройдена"". На данную дату известны нарушения страховщика.");
				Возврат ложь;

			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Организация =  Объект.Организация;
	МенеджерЗаписи.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
	МенеджерЗаписи.ПериодСверки = Объект.Период;
	МенеджерЗаписи.Основание = Справочники.ВнешниеСистемы.ЖурналНарушенийСтраховыхКрмпаний;
	МенеджерЗаписи.Ответственный = РаботаСПользователями.ТекущийПользователь();
	МенеджерЗаписи.Пройдена = ПроверкаПройдена;
	МенеджерЗаписи.РучнойРежим = Истина;
	МенеджерЗаписи.Примечание = Примечание;
	МенеджерЗаписи.Период = Объект.Период;
	
	МенеджерЗаписи.Записать();
	
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура Подтвердить(Команда)
	Если ПодтвердитьНаСервере() = Истина Тогда
		ЭтаФорма.Закрыть();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Результаты контроля занесены в журнал");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры
