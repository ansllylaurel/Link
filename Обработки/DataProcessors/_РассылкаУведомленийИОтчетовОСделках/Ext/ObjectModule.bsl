	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Отказ = Истина;
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		РеквизитыОповещения = Новый Структура();
		РеквизитыОповещения.Вставить("НомерДокумента",					СокрЛП(Выборка.Номер));
		РеквизитыОповещения.Вставить("Дата",							Формат(Дата, "ДФ=dd.MM.yyyy"));
		РеквизитыОповещения.Вставить("КонтрагентНаБирже", 				?(СокрЛП(Выборка.КонтрагентНаБирже) = "", "Нет данных", СокрЛП(Выборка.КонтрагентНаБирже)));
		РеквизитыОповещения.Вставить("Организация",						Организация);
		РеквизитыОповещения.Вставить("СчетДоверительногоУправления",	Выборка.СчетДоверительногоУправления);
		
		НаименованиеЦеннойБумаги = СокрЛП(Выборка.ТипЦБ) +
			?(Выборка.КраткоеНаименованиеЭмитента = "", "", " "+ СокрЛП(Выборка.КраткоеНаименованиеЭмитента)) +
			?(Выборка.РегистрационныйНомер = "", "", ", " + СокрЛП(Выборка.РегистрационныйНомер)) + 
			?(Выборка.Номинал = "", "", ", " + Формат(Выборка.Номинал, "ЧГ=0")) + 
			?(Выборка.ВалютаНоминала = "", "", " " + СокрЛП(Выборка.ВалютаНоминала));
		
		РеквизитыОповещения.Вставить("ЦеннаяБумага", 					НаименованиеЦеннойБумаги);
		
		Справочники.Оповещения.СформироватьОповещения("ВнешняяОбработка._РассылкаУведомленийИОтчетовОСделках.ОтправитьУведомленияОСделкахРПС", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура ОтправитьУведомленияОСделкахРПС_Национальный(Дата, Организация, Отказ = Ложь) Экспорт
	
#Область Начало_сессии

	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ОтправитьУведомленияОСделкахРПС_Национальный";
	
	ПараметрыОтчета = Новый Структура("Дата, Организация, Клиент", Дата, Организация, "НПФ Национальный");
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	Описание  = "Дата: " + Дата + Символы.ПС + "Организация: " + Организация;	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
		
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
#КонецОбласти
    	
#Область Текст_запроса

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделки.Ссылка.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
		|	ВЫБОР
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Акции).Эмитент.Наименование)
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.Наименование)
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.Наименование)
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо.Наименование)
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.Наименование)
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу, ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Закладные).Банк.Наименование)
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Эмитент,
		|	ВЫБОР
		|		КОГДА Сделки.Ссылка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ""Покупка""
		|		ИНАЧЕ ""Продажа""
		|	КОНЕЦ КАК ВидСделки,
		|	ВЫБОР
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|				И ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
		|			ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|				И ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер <> """"
		|			ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).ГосударственныйРегистрационныйНомер
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|				И ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
		|			ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|				И ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
		|			ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|				И ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Векселя).Номер <> """"
		|			ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Векселя).Номер
		|		КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|				И ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер <> """"
		|			ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).РегистрационныйНомер
		|		ИНАЧЕ ЕСТЬNULL(КодыВТорговыхСистемахСрезПоследнихISIN.Код, КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Код)
		|	КОНЕЦ КАК ИдентификаторЦБ,
		|	Сделки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	Сделки.Дата КАК Дата,
		|	Сделки.Ссылка.КонтрагентНаБирже КАК Контрагент,
		|	Сделки.Сумма КАК Сумма,
		|	Сделки.Количество КАК Количество,
		|	Сделки.Сумма / Сделки.Количество КАК Цена
		|ИЗ
		|	(ВЫБРАТЬ
		|		СделкаЦенныеБумаги.Ссылка КАК Ссылка,
		|		НАЧАЛОПЕРИОДА(СделкаЦенныеБумаги.Ссылка.Дата, ДЕНЬ) КАК Дата,
		|		СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|		СУММА(СделкаЦенныеБумаги.Количество) КАК Количество,
		|		СУММА(СделкаЦенныеБумаги.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность) КАК Сумма
		|	ИЗ
		|		Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют КАК КурсыВалют
		|			ПО (КурсыВалют.Период = НАЧАЛОПЕРИОДА(СделкаЦенныеБумаги.Ссылка.Дата, ДЕНЬ))
		|				И (КурсыВалют.Валюта = СделкаЦенныеБумаги.Ссылка.ВалютаСделки)
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ПО СделкаЦенныеБумаги.Ссылка.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|	ГДЕ
		|		СделкаЦенныеБумаги.Ссылка.Организация = &Организация
		|		И СделкаЦенныеБумаги.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|		И СделкаЦенныеБумаги.Ссылка.РежимПереговорныхСделок
		|		И НЕ СделкаЦенныеБумаги.Ссылка.ПервичноеРазмещение
		|		И НЕ СделкаЦенныеБумаги.Ссылка.РежимБиржевыхТоргов.Аукцион
		|		И СделкаЦенныеБумаги.Ссылка.Проведен
		|		И НЕ СделкаЦенныеБумаги.Ссылка.ВыкупЭмитентом
		|		И КлиентыДоверительногоУправленияСрезПоследних.Клиент = &Клиент
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СделкаЦенныеБумаги.Ссылка,
		|		НАЧАЛОПЕРИОДА(СделкаЦенныеБумаги.Ссылка.Дата, ДЕНЬ),
		|		СделкаЦенныеБумаги.ЦеннаяБумага
		|	
		|	ИМЕЮЩИЕ
		|		СУММА(СделкаЦенныеБумаги.Сумма * КурсыВалют.Курс / КурсыВалют.Кратность) <= 200000000) КАК Сделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.ЮрФизЛицо
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.ЮрФизЛицо
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.ЮрФизЛицо
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Закладные).Банк.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВторговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследнихISIN
		|		ПО Сделки.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА Сделки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|					ТОГДА ВЫРАЗИТЬ(Сделки.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.КодНаММВБ)) КАК КодыВТорговыхСистемахСрезПоследнихКодНаММВБ
		|		ПО Сделки.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследнихКодНаММВБ.Объект
		|ИТОГИ ПО
		|	НомерДоговораДУ");
	
#КонецОбласти
	
	Запрос.УстановитьПараметр("ДатаНачала",		НачалоДня(Дата));
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецДня(Дата));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Клиент", 		ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Национальный"));
		
	ВыборкаСчетДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаСчетДУ.Количество() = 0 Тогда
		Отказ = Истина;
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("Макет");
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСделка	= Макет.ПолучитьОбласть("Сделка");
	ОбластьПодвал	= Макет.ПолучитьОбласть("Подвал");
	
	ФорматФайла	= "docx";
	
	Пока ВыборкаСчетДУ.Следующий() Цикл
		
		НомерДоговораДУ = ВыборкаСчетДУ.НомерДоговораДУ;
		Результат = Новый ТабличныйДокумент;
		Результат.Вывести(ОбластьШапка);
		
		Выборка = ВыборкаСчетДУ.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОбластьСделка.Параметры.Заполнить(Выборка);
			ОбластьСделка.Параметры.Дата = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
			Результат.Вывести(ОбластьСделка);
				
		КонецЦикла;
		
		Результат.Вывести(ОбластьПодвал);
		
		РеквизитыОповещения = Новый Структура();
			
		РеквизитыОповещения.Вставить("Организация",		Организация);
		РеквизитыОповещения.Вставить("НомерДоговораДУ",	НомерДоговораДУ);
				
		ИмяФайла	= СтрШаблон("Уведомление о сделках РПС %1.%2", НомерДоговораДУ, ФорматФайла);
					
		ПотокВПамяти = Новый ПотокВПамяти();
		Результат.Записать(ПотокВПамяти, ТипФайлаТабличногоДокумента[ФорматФайла]); 
		ДвоичныеДанныеФайла = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		
		Вложения = Новый Соответствие;
		Вложения.Вставить(ИмяФайла, ДвоичныеДанныеФайла);

		РеквизитыОповещения.Вставить("Вложения", Вложения);
		
		Справочники.Оповещения.СформироватьОповещения("ВнешняяОбработка._РассылкаУведомленийИОтчетовОСделках.ОтправитьУведомленияОСделкахРПС_Национальный", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры
