
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Рассылка уведомлений и отчетов о сделках", "0.09", "", Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "РассылкаДанныхОСделкахВРежимеPSOB",				"Рассылка данных о сделках в режиме PSOB",,	Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "УведомлениеОЗаключенииСделокРПС",  				"Уведомление о заключении сделок РПС",,	Ложь, "ВызовСерверногоМетода");
    РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "УведомлениеОЗаключенииСделокРПС_Национальный", 	"Уведомление о заключении сделок РПС (Национальный)",,	Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции 

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	Организация = ПараметрыКоманды.Организация;
	
	Если ИдентификаторКоманды = "РассылкаДанныхОСделкахВРежимеPSOB" Тогда
		
		ДатаФормированияОтчета = НачалоДня(ТекущаяДатаСеанса());
				
		Если ЭтоПервыйРабочийДеньМесяца(ДатаФормированияОтчета) Тогда
					
			ДатаПредыдущегоМесяца = ДобавитьМесяц(ДатаФормированияОтчета, -1);
			
			//проверяем сделки каждый первый рабочий день месяца с 01.01.2026
			ПериодОтчета = Новый СтандартныйПериод;
			ПериодОтчета.ДатаНачала    = Дата(2026,01,01);
			ПериодОтчета.ДатаОкончания = КонецМесяца(ДатаПредыдущегоМесяца);
			
			СформироватьИОтправитьОтчетОСделкахВРежимеPSOB(ПериодОтчета, Организация,, Истина);
			
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "УведомлениеОЗаключенииСделокРПС" Тогда
		
		Дата = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2);
				
		Если ЗначениеЗаполнено(Дата) И ЗначениеЗаполнено(Организация) Тогда
			ОтправитьУведомленияОСделкахРПС(Дата, Организация);
		КонецЕсли;
		
	ИначеЕсли ИдентификаторКоманды = "УведомлениеОЗаключенииСделокРПС_Национальный" Тогда
		
		Дата = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2);
		Организация = ПараметрыКоманды.Организация;
		
		Если ЗначениеЗаполнено(Дата) И ЗначениеЗаполнено(Организация) Тогда
			ОтправитьУведомленияОСделкахРПС_Национальный(Дата, Организация);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры // ВыполнитьКоманду

Функция ЭтоПервыйРабочийДеньМесяца(ДатаФормированияОтчета)
		
	//Рассылаем отчет в первый рабочий день месяца	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МИНИМУМ(ДанныеКалендаря.Дата) КАК ПервыйРабочийДеньМесяца
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|	И ДанныеКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)";
	
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(ДатаФормированияОтчета));
	Запрос.УстановитьПараметр("КонецМесяца" , КонецМесяца(ДатаФормированияОтчета));
	
	Результат = Запрос.Выполнить().Выгрузить();
		
	Если Результат[0].ПервыйРабочийДеньМесяца = НачалоДня(ДатаФормированияОтчета) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции //ЭтоПервыйРабочийДеньМесяца

Функция СформироватьИОтправитьОтчетОСделкахВРежимеPSOB(Период, Организация, ПолучателиОтчета = "", СформироватьОповещения = Ложь) Экспорт
	
#Область НАЧАЛО_СЕССИИ	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".СформироватьИОтправитьОтчетОСделкахВРежимеPSOB";
	
	ПараметрыОтчета = Новый Структура("Период, ПолучателиОтчета", Период, ПолучателиОтчета);
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	Описание  = "Период: " + Период + Символы.ПС + "ПолучателиОтчета: " + ПолучателиОтчета;	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
#КонецОбласти
			
	Запрос = Новый Запрос;
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Организация КАК Организация,
		|	Сделка.Ссылка КАК Ссылка,
		|	Сделка.Дата КАК Дата,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.НомерСделки КАК НомерСделки
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО Сделка.Ссылка = ЗначенияДополнительныхСведений.Объект
		|			И (ЗначенияДополнительныхСведений.Свойство = &РаскрытыйКонтрагент)
		|ГДЕ
		|	Сделка.Проведен = ИСТИНА
		|	И Сделка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Сделка.Организация = &Организация
		|	И Сделка.РежимБиржевыхТоргов В (&Режим_ММВБ_PSOB, &Режим_ММВБ_PTOB)
		|	И (ЗначенияДополнительныхСведений.Значение ЕСТЬ NULL
		|			ИЛИ ЗначенияДополнительныхСведений.Значение = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	Дата,
		|	НомерСделки
		|ИТОГИ ПО
		|	Организация";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Режим_ММВБ_PSOB", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_PSOB"));
	Запрос.УстановитьПараметр("Режим_ММВБ_PTOB", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_PTOB"));
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("РаскрытыйКонтрагент", ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоРеквизиту("Ключ", "_РаскрытыйКонтрагент"));
		
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
#Область ТЕКСТ_ПИСЬМА	
	Текст_HTML = "";
	Пока Выборка.Следующий() Цикл
		
		Текст_HTML = Текст_HTML + 
			"<tr class=""company"">
			|	<td colspan=""4"", align = ""left"">" + Выборка.Организация + "</td>
			|</tr>";
		
		ВыборкаДетальныеЗаписи = Выборка.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Текст_HTML = Текст_HTML + 
				"<tr> 
				|	<td>" + Формат(ВыборкаДетальныеЗаписи.Дата, "ДЛФ=Д") + "</td>
				|	<td>" + Формат(ВыборкаДетальныеЗаписи.Дата, "ДЛФ=В") + "</td>
				|	<td>" + ВыборкаДетальныеЗаписи.СчетДоверительногоУправления + "</td>
				|	<td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(ВыборкаДетальныеЗаписи.Ссылка, ВыборкаДетальныеЗаписи.НомерСделки) + "</td> 
				|</tr>";
		КонецЦикла;
				
	КонецЦикла;
	
	Если Текст_HTML = "" Тогда
		
		Текст_HTML =
			"<html><head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8""></head>
			|<body><a>В период с " + Формат(Период.ДатаНачала, "ДЛФ=Д") + " по " + Формат(Период.ДатаОкончания, "ДЛФ=Д") + " отсутствуют сделки в режиме PSOB/PTOB, у которых не заполнено значение [Раскрытый контрагент].</a>
			|</body></html>";
		
	Иначе
		
		Текст_HTML =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style>
			|		body  { font: 10pt sans-serif; }
			|		table { text-align: center; border-spacing: 0; border-collapse: collapse; }
			|		td    { font-size: 1em; border: 1px solid #CCC085; padding: 5px 20px 5px 20px; }
			|		.company { font-size: 14px; background: #F8F2D8; }
			|		.top  { font-size: 15px; background: #F4ECC5; }
			|	</style>
			|</head>
			|<body>
			|<a>Перечень сделок cовершенных в режиме PSOB/PTOB (РПС:А1-Облигации) в период с " + Формат(Период.ДатаНачала, "ДЛФ=Д") + " по " + Формат(Период.ДатаОкончания, "ДЛФ=Д") + ", у которых не заполнено значение [Раскрытый контрагент]</a>
			|<table cols=""4""><tr class=""top""><td>Дата сделки</td><td>Время сделки</td><td>Счет доверительного управления</td><td>Сделка</td></tr>"
			+ Текст_HTML + "</table></body></html>";
			
	КонецЕсли;
#КонецОбласти

	Если ЗначениеЗаполнено(ПолучателиОтчета) Тогда
	
	    ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", ПолучателиОтчета, "Отчет о сделках (режим PSOB,PTOB РПС:А1-Облигации). УК " + Строка(Организация), Текст_HTML, "HTML");		
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
		
	ИначеЕсли СформироватьОповещения Тогда
		
		РеквизитыОповещения = Новый Структура("Тема, Текст", "Отчет о сделках (режим PSOB,PTOB РПС:А1-Облигации). УК " + Строка(Организация), Текст_HTML);
		Справочники.Оповещения.СформироватьОповещения("ВнешняяОбработка._РассылкаУведомленийИОтчетовОСделках.СформироватьИОтправитьОтчетОСделкахВРежимеPSOB", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат Текст_HTML;

КонецФункции //СформироватьИОтправитьОтчетОСделкахВРежимеPSOB

Процедура ОтправитьУведомленияОСделкахРПС(Дата, Организация, Отказ = Ложь) Экспорт
	
#Область НАЧАЛО_СЕССИИ
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ОтправитьУведомленияОСделкахРПС";
	
	ПараметрыОтчета = Новый Структура("Дата, Организация", Дата, Организация);
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета, Новый СжатиеДанных(9));
	
	Описание  = "Дата: " + Дата + Символы.ПС + "Организация: " + Организация;	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
		
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
#КонецОбласти

	ИсключаемыеКодыРасчетовНаБирже = Новый Массив;
	ИсключаемыеКодыРасчетовНаБирже.Добавить("Z0");
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акция""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Векселя
		|			ТОГДА ""Вексель""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ДепозитарныеРасписки
		|			ТОГДА ""Депозитарная расписка""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Доли
		|			ТОГДА ""Доля""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Закладные
		|			ТОГДА ""Закладная""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.ИпотечныеСертификатыУчастия
		|			ТОГДА ""Ипотечный сертификат участия""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Облигация""
		|		КОГДА СделкаЦенныеБумаги.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""Пай""
