

&НаСервереБезКонтекста
Функция ПолучитьНастройкиРезевногоКопированияЖурналаРегистрацииПоУмолчанию()
	
	НастройкиРезевногоКопированияЖурналаРегистрации = Новый Структура();
	НастройкиРезевногоКопированияЖурналаРегистрации.Вставить(
		//"КаталогЖурнала", "\\ap73\d$\srvinfo\reg_1541\4c0872e7-4afe-4ace-8569-e90b8133f6e9\1Cv8Log");
		"КаталогЖурнала", "\\ap36\c$\Program Files\1cv8\srvinfo\reg_1541\dc090ddc-8056-47bf-939c-906b2671dafd\1Cv8Log\");
	НастройкиРезевногоКопированияЖурналаРегистрации.Вставить(
		//"КаталогАрхива", "\\ap70\f$\Backup\AssetManagement\1Cv8Log");
		"КаталогАрхива", "\\ap36\f$\Backup\AssetManagement\1Cv8Log");
		
	Возврат НастройкиРезевногоКопированияЖурналаРегистрации;
	
КонецФункции

&НаСервереБезКонтекста
Процедура РезевногоКопированияЖурналаРегистрации()
	
	Объект = Новый Структура;
	Объект.Вставить("ДополнительныеСвойства", Новый Структура);
	
	ДанныеДляСтатистики = Новый Структура;
	
	НастройкиРезевногоКопирования = ПолучитьНастройкиРезевногоКопированияЖурналаРегистрацииПоУмолчанию();
	
	Механизм = "_ОбслуживаниеИнформационнойБазы.РезевногоКопированияЖурналаРегистрации"; //ЭтотОбъект.Метаданные().Имя + "." + ИдентификаторКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, НастройкиРезевногоКопирования);

	// ищем каталоги из настроек и, если они не найдены, прекращаем процесс
	// т.к. копировать нечего/некуда
	КаталогЖурнала = Новый Файл(НастройкиРезевногоКопирования.КаталогЖурнала);
	Если Не КаталогЖурнала.Существует() Тогда
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
			"Не найден каталог журнала регистрации 1С " + КаталогЖурнала.ПолноеИмя);
		Возврат;
	КонецЕсли;
	
	КаталогАрхива = Новый Файл(НастройкиРезевногоКопирования.КаталогАрхива);
	Если Не КаталогАрхива.Существует() Тогда
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
			"Не найден каталог архива журнала регистрации 1С " + КаталогАрхива.ПолноеИмя);
		Возврат;
	КонецЕсли;
	
	// копируем словарь журнала регистрации
	ИмяФайлаСловаря = "1Cv8.lgf";
	
	ФайлСловаря = Новый Файл(НастройкиРезевногоКопирования.КаталогЖурнала + "\" + ИмяФайлаСловаря);
	Если Не ФайлСловаря.Существует() Тогда
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
			"Не найден файл словаря журнала регистрации 1С " + ФайлСловаря.ПолноеИмя);
	Иначе
		Попытка
			КопироватьФайл(ФайлСловаря.ПолноеИмя, НастройкиРезевногоКопирования.КаталогАрхива + "\" + ИмяФайлаСловаря);
			ДанныеДляСтатистики.Вставить("LGF", "" + ФайлСловаря.ПолучитьВремяИзменения() + ", " + ФайлСловаря.Размер());
		Исключение
			РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
				"Не удалось скопировать файл " + ФайлСловаря.ПолноеИмя + ". Система сообщает: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	// копируем файл журнала за вчера
	ТекущийДень = НачалоДня(ТекущаяДата());
	ПредДень = ТекущийДень - 86400;
	
	КаталогАрхиваЗаТекущийМесяц = Новый Файл(НастройкиРезевногоКопирования.КаталогАрхива + "\" + Формат(ТекущийДень, "ДФ=yyyy-MM"));
	Если Не КаталогАрхиваЗаТекущийМесяц.Существует() Тогда
		Попытка
			СоздатьКаталог(КаталогАрхиваЗаТекущийМесяц.ПолноеИмя);
		Исключение
			РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
				"Не удалось создать каталог " + КаталогАрхиваЗаТекущийМесяц.ПолноеИмя + ". Система сообщает: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Если КаталогАрхиваЗаТекущийМесяц.Существует() Тогда
		// файлы по маске ГГГГММДД*.lgp почему-то ищутся сильно дольше, чем файлы по *.lgp
		// с последующим отбором
		МаскаИмениФайла = Формат(ТекущийДень, "ДФ=yyyyMM");
		ДлинаМаскиИмениФайла = СтрДлина(МаскаИмениФайла);
		
		ФайлЖурналаЗаПредДень = Неопределено;
		
		ФайлыЖурнала = НайтиФайлы(НастройкиРезевногоКопирования.КаталогЖурнала, "*.lgp", Ложь);
		Для каждого ФайлЖурнала Из ФайлыЖурнала Цикл
			Если Лев(ФайлЖурнала.Имя, ДлинаМаскиИмениФайла) = МаскаИмениФайла Тогда
				ФайлЖурналаЗаПредДень = ФайлЖурнала;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ФайлЖурналаЗаПредДень = Неопределено Тогда
			РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
				"Не удалось найти файл журнала регистрации за " + Формат(ПредДень, "ДФ=dd.MM.yyyy") + ". Система сообщает: " + ОписаниеОшибки());
		Иначе
			Попытка
				КопироватьФайл(ФайлЖурналаЗаПредДень.ПолноеИмя, КаталогАрхиваЗаТекущийМесяц.ПолноеИмя + "\" + ФайлЖурналаЗаПредДень.Имя);
				ДанныеДляСтатистики.Вставить("LGP", "" + ФайлЖурналаЗаПредДень.Имя + ", " + ФайлЖурналаЗаПредДень.ПолучитьВремяИзменения() + ", " + ФайлЖурналаЗаПредДень.Размер());
			Исключение
				РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
					"Не удалось скопировать файл " + ФайлЖурналаЗаПредДень.ПолноеИмя + ". Система сообщает: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	// если это первое число месяца архивируем файлы файлы журнала за предыдущий месяц
	Если День(ТекущийДень) = 1 Тогда
		
		КаталогЗаПредыдущийМесяц = Новый Файл(НастройкиРезевногоКопирования.КаталогАрхива + "\" + Формат(ПредДень, "ДФ=yyyy-MM"));
		Если Не КаталогЗаПредыдущийМесяц.Существует() Тогда
			РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(Объект,
				"Не удалось найти каталог " + КаталогЗаПредыдущийМесяц.ПолноеИмя + ". Система сообщает: " + ОписаниеОшибки());
		КонецЕсли;
		
	КонецЕсли;
	
	РаботаСДополнительнымиОтчетамиИОбработками.ОповеститьОВнутрОшибках(Объект);
	
	Если Объект.ДополнительныеСвойства.Свойство("Ошибки")
			И ТипЗнч(Объект.ДополнительныеСвойства.Ошибки) = Тип("Массив")
			И Объект.ДополнительныеСвойства.Ошибки.Количество() > 0
	Тогда
		ТекстОшибки = СтрСоединить(Объект.ДополнительныеСвойства.Ошибки, Символы.ПС);
	Иначе
		ТекстОшибки = Неопределено;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДанныеДляСтатистики, ТекстОшибки);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(Знач ИмяКоманды)
	
	// имя команды начинается со слова "Команда"
	// эту часть необходимо обрезать
	Если СтрНачинаетсяС(ИмяКоманды, "Команда") Тогда
		ИмяКоманды = Сред(ИмяКоманды, СтрДлина("Команда") + 1);
	КонецЕсли;
	
	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ОбъектНаСервере.ВыполнитьКоманду(ИмяКоманды, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКоманду(Команда)
	
	Если Вопрос("Выполнить команду """ + Команда.Имя + """?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ВыполнитьКомандуНаСервере(Команда.Имя);
	КонецЕсли;

КонецПроцедуры

