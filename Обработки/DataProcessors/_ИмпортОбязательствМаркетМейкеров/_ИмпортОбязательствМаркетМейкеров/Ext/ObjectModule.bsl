// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Импорт обязательств маркет-мейкеров",
		"0.06",
		"",
		Истина
	);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортОбязательствМаркетМейкеров", "Импорт обязательств маркет-мейкеров",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Если ИдентификаторКоманды = "ИмпортОбязательствМаркетМейкеров" Тогда
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("ИмпортОбязательствМаркетМейкеров",
			Новый Структура("ДатаСведений, ИмпортироватьТолькоРасторгнутые", НачалоДня(ТекущаяДатаСеанса()), Ложь));
		ИмпортироватьОбязательстваМаркетМейкеров(ПараметрыСессии);
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИмпортироватьОбязательстваМаркетМейкеров(ПараметрыСессии, ДатаСведений = Неопределено, ИмпортироватьТолькоРасторгнутые = Ложь, ЮрЛицо = Неопределено, ЦеннаяБумага = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаСведений) Тогда
	
		ДатаСведений = НачалоДня(ТекущаяДатаСеанса());
	
	КонецЕсли; 
		
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("Date", 							Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("Organisation_Name", 				Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("Issuer_Name", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(250)));
	ТипыКолонок.Вставить("Security_Code", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТипыКолонок.Вставить("Security_Name", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(300)));
	ТипыКолонок.Вставить("Responsibility", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТипыКолонок.Вставить("Contract_Start_Date", 			Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("Contract_Start_Date_Disclosure", 	Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТипыКолонок.Вставить("Contract_Time", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТипыКолонок.Вставить("Trading_Mode", 					Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТипыКолонок.Вставить("Change_Date", 					Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("Change_Date_Disclosure", 			Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТипыКолонок.Вставить("Contract_End_Date", 				Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ТипыКолонок.Вставить("Contract_End_Date_Disclosure", 	Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	#Область Текст_запроса_к_Externals
	ТекстЗапроса = 
		"SELECT 
		|    CAST([Date] AS DateTime) AS Date
		|    ,replace(replace(replace(replace(replace(replace(Organisation_Name, 
		|    nchar(8217)+nchar(8217), char(34)), 
		|    nchar(8216)+nchar(8216), char(34)), 
		|    nchar(8221), char(34)), 
		|    nchar(8220), char(34)), 
		|    char(187), char(34)), 
		|    char(171), char(34)) AS Organisation_Name
		|    ,[Issuer_Name]
		|    ,[Security_Code]
		|    ,[Security_Name]
		|    ,[Responsibility]
		|    ,CAST([Contract_Start_Date] AS DateTime) AS Contract_Start_Date 
		|    ,[Contract_Start_Date_Disclosure]
		|    ,[Contract_Time]
		|    ,[Trading_Mode]
		|    ,CAST([Change_Date] AS DateTime) AS Change_Date 
		|    ,[Change_Date_Disclosure]
		|    ,CAST([Contract_End_Date] AS DateTime) AS Contract_End_Date 
		|    ,[Contract_End_Date_Disclosure]
		|FROM [Externals].[dbo].[Marketmakers_Stock_Market] m
		|     WHERE [Date] = '&ДатаСведений' AND [Responsibility] LIKE '%цены%'";		
	#КонецОбласти 
	
	Если ИмпортироватьТолькоРасторгнутые Тогда
	
		ТекстЗапроса = ТекстЗапроса + " 
		|		AND Contract_End_Date IS NOT NULL AND Contract_End_Date <= '&ДатаСведений' ";
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + " 
		|		AND (Contract_End_Date > '&ДатаСведений' OR Contract_End_Date IS NULL)";
	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЮрЛицо) Тогда
		
		НаименованияСтрокой = ПолучитьНаименованияЮрЛицаСтрокой(ЮрЛицо);
		Если НаименованияСтрокой = "" Тогда
			ТекстОшибки = "Наименование юридического лица: " + ЮрЛицо + " не найдено";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + 
			" AND replace(replace(replace(replace(replace(replace(Organisation_Name, 
			|    nchar(8217)+nchar(8217), char(34)), 
			|    nchar(8216)+nchar(8216), char(34)), 
			|    nchar(8221), char(34)), 
			|    nchar(8220), char(34)), 
			|    char(187), char(34)), 
			|    char(171), char(34)) in (" + НаименованияСтрокой + ")";
	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ЦеннаяБумага) Тогда
		
		КодыЦеннойБумагиСтрокой = ПолучитьКодыЦеннойБумагиСтрокой(ЦеннаяБумага);
		Если КодыЦеннойБумагиСтрокой = "" Тогда
			ТекстОшибки = "Код ценной бумаги: " + ЦеннаяБумага + " не найден";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + 
			" AND Security_Code in (" + КодыЦеннойБумагиСтрокой + ")";
	
	КонецЕсли; 
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаСведений", Формат(ДатаСведений, "ДФ=yyyy-MM-dd"));
	
	СтрокаСоединения = СтрокаСоединения();
	ДополнительныеПараметры = Новый Структура("ВозвращатьПустуюТаблицу", Истина);
	
	ВнешниеДанные = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок,, ДополнительныеПараметры);
	
	Если ВнешниеДанные <> Неопределено И ВнешниеДанные.Количество() > 0 Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ВнешниеДанные", ВнешниеДанные);
		Запрос.УстановитьПараметр("Период", ДатаСведений);
		#Область Текст_запроса
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВнешниеДанные.Organisation_Name КАК НаименованиеЮрЛица,
			|	ВнешниеДанные.Issuer_Name КАК НаименованиеЭмитента,
			|	ВнешниеДанные.Security_Code КАК КодЦеннойБумаги,
			|	ВнешниеДанные.Security_Name КАК НазваниеЦеннойБумаги,
			|	ВнешниеДанные.Contract_Start_Date КАК ДатаНачалаДейтсвияДоговора,
			|	ВнешниеДанные.Contract_Start_Date_Disclosure КАК ДатаНачалаДейтсвияДоговора_Раскрытие,
			|	ВнешниеДанные.Trading_Mode КАК РежимТоргов,
			|	ВнешниеДанные.Contract_End_Date КАК ДатаРасторжения,
			|	ВнешниеДанные.Contract_End_Date_Disclosure КАК ДатаРасторжения_Раскрытие
			|ПОМЕСТИТЬ _ВнешниеДанные
			|ИЗ
			|	&ВнешниеДанные КАК ВнешниеДанные
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
			|	_ВнешниеДанные.НаименованиеЮрЛица КАК Наименование
			|ПОМЕСТИТЬ _ГоловныеОрганизации
			|ИЗ
			|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|			&Период,
			|			Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			ЕСТЬNULL(СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо, РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо) КАК ГоловнаяОрганизация
			|		ИЗ
			|			РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
			|					&Период,
			|					Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
			|						И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
			|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних КАК СвязанныеЮридическиеЛицаСрезПоследних
			|				ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
			|					И (СвязанныеЮридическиеЛицаСрезПоследних.ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация))
			|					И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)) КАК ГоловныеОрганизации
			|		ПО РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо = ГоловныеОрганизации.ГоловнаяОрганизация
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
			|			_ВнешниеДанные.НаименованиеЮрЛица КАК НаименованиеЮрЛица
			|		ИЗ
			|			_ВнешниеДанные КАК _ВнешниеДанные) КАК _ВнешниеДанные
			|		ПО (РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу + РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу + РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование ПОДОБНО ""%"" + _ВнешниеДанные.НаименованиеЮрЛица + ""%"")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ВнешниеДанные.КодЦеннойБумаги КАК КодЦеннойБумаги,
			|	КодыВТорговыхСистемахСрезПоследних.Объект КАК ЦеннаяБумага
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
			|		ПО _ВнешниеДанные.КодЦеннойБумаги = КодыВТорговыхСистемахСрезПоследних.Код
			|			И (_ВнешниеДанные.КодЦеннойБумаги <> """")
			|			И (НЕ КодыВТорговыхСистемахСрезПоследних.Объект.ПометкаУдаления)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ВнешниеДанные.КодЦеннойБумаги,
			|	Акции.Ссылка
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
			|		ПО _ВнешниеДанные.КодЦеннойБумаги = КодыВТорговыхСистемахСрезПоследних.Код
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
			|		ПО (КодыВТорговыхСистемахСрезПоследних.Код ЕСТЬ NULL)
			|			И _ВнешниеДанные.КодЦеннойБумаги = Акции.ГосударственныйРегистрационныйНомер
			|			И (_ВнешниеДанные.КодЦеннойБумаги <> """")
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ВнешниеДанные.КодЦеннойБумаги,
			|	ДепозитарныеРасписки.Ссылка
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
			|		ПО _ВнешниеДанные.КодЦеннойБумаги = КодыВТорговыхСистемахСрезПоследних.Код
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
			|		ПО (КодыВТорговыхСистемахСрезПоследних.Код ЕСТЬ NULL)
			|			И _ВнешниеДанные.КодЦеннойБумаги = ДепозитарныеРасписки.РегистрационныйНомер
			|			И (_ВнешниеДанные.КодЦеннойБумаги <> """")
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ВнешниеДанные.КодЦеннойБумаги,
			|	Облигации.Ссылка
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
			|		ПО _ВнешниеДанные.КодЦеннойБумаги = КодыВТорговыхСистемахСрезПоследних.Код
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
			|		ПО (КодыВТорговыхСистемахСрезПоследних.Код ЕСТЬ NULL)
			|			И _ВнешниеДанные.КодЦеннойБумаги = Облигации.ГосударственныйРегистрационныйНомер
			|			И (_ВнешниеДанные.КодЦеннойБумаги <> """")
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ВнешниеДанные.КодЦеннойБумаги,
			|	Паи.Ссылка
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
			|		ПО _ВнешниеДанные.КодЦеннойБумаги = КодыВТорговыхСистемахСрезПоследних.Код
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
			|		ПО (КодыВТорговыхСистемахСрезПоследних.Код ЕСТЬ NULL)
			|			И _ВнешниеДанные.КодЦеннойБумаги = Паи.ГосударственныйРегистрационныйНомер
			|			И (_ВнешниеДанные.КодЦеннойБумаги <> """")
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ВнешниеДанные.НаименованиеЮрЛица КАК НаименованиеЮрЛица,
			|	_ВнешниеДанные.РежимТоргов КАК РежимТоргов,
			|	_ВнешниеДанные.КодЦеннойБумаги КАК КодЦеннойБумаги,
			|	_ГоловныеОрганизации.ЮрФизЛицо КАК ЮрФизЛицо,
			|	_ЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
			|	_ВнешниеДанные.ДатаНачалаДейтсвияДоговора КАК ДатаНачалаДейтсвияДоговора,
			|	_ВнешниеДанные.ДатаНачалаДейтсвияДоговора_Раскрытие КАК ДатаНачалаДейтсвияДоговора_Раскрытие,
			|	_ВнешниеДанные.ДатаРасторжения КАК ДатаРасторжения,
			|	_ВнешниеДанные.ДатаРасторжения_Раскрытие КАК ДатаРасторжения_Раскрытие
			|ПОМЕСТИТЬ _ОбязательстваМаркетМейкеров
			|ИЗ
			|	_ВнешниеДанные КАК _ВнешниеДанные
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ГоловныеОрганизации КАК _ГоловныеОрганизации
			|		ПО (_ГоловныеОрганизации.Наименование = _ВнешниеДанные.НаименованиеЮрЛица)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
			|		ПО _ВнешниеДанные.КодЦеннойБумаги = _ЦенныеБумаги.КодЦеннойБумаги
			|			И (НЕ _ЦенныеБумаги.ЦеннаяБумага.ПометкаУдаления)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	МИНИМУМ(ЕСТЬNULL(_ОбязательстваМаркетМейкеров.ДатаНачалаДейтсвияДоговора, &Период)) КАК Период,
			|	ЕСТЬNULL(_ОбязательстваМаркетМейкеров.ЮрФизЛицо, ОбязательстваМаркетМейкеровСрезПоследних.ЮрФизЛицо) КАК ЮрФизЛицо,
			|	ЕСТЬNULL(_ОбязательстваМаркетМейкеров.ЦеннаяБумага, ОбязательстваМаркетМейкеровСрезПоследних.ЦеннаяБумага) КАК ЦеннаяБумага,
			|	ЕСТЬNULL(_ОбязательстваМаркетМейкеров.РежимТоргов, ОбязательстваМаркетМейкеровСрезПоследних.РежимТоргов) КАК РежимТоргов,
			|	НЕ _ОбязательстваМаркетМейкеров.ДатаНачалаДейтсвияДоговора ЕСТЬ NULL КАК Действует,
			|	МИНИМУМ(ЕСТЬNULL(_ОбязательстваМаркетМейкеров.ДатаНачалаДейтсвияДоговора_Раскрытие, &Период)) КАК ДатаРаскрытияИнформации
			|ИЗ
			|	_ОбязательстваМаркетМейкеров КАК _ОбязательстваМаркетМейкеров
			|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ОбязательстваМаркетМейкеровСрезПоследних.Период КАК Период,
			|			ОбязательстваМаркетМейкеровСрезПоследних.ДатаРаскрытияИнформации КАК ДатаРаскрытияИнформации,
			|			ОбязательстваМаркетМейкеровСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
			|			ОбязательстваМаркетМейкеровСрезПоследних.ЦеннаяБумага КАК ЦеннаяБумага,
			|			ОбязательстваМаркетМейкеровСрезПоследних.РежимТоргов КАК РежимТоргов
			|		ИЗ
			|			РегистрСведений.ОбязательстваМаркетМейкеров.СрезПоследних(&Период, ) КАК ОбязательстваМаркетМейкеровСрезПоследних
			|		ГДЕ
			|			ОбязательстваМаркетМейкеровСрезПоследних.Действует) КАК ОбязательстваМаркетМейкеровСрезПоследних
			|		ПО _ОбязательстваМаркетМейкеров.ЮрФизЛицо = ОбязательстваМаркетМейкеровСрезПоследних.ЮрФизЛицо
			|			И _ОбязательстваМаркетМейкеров.ЦеннаяБумага = ОбязательстваМаркетМейкеровСрезПоследних.ЦеннаяБумага
			|			И _ОбязательстваМаркетМейкеров.РежимТоргов = ОбязательстваМаркетМейкеровСрезПоследних.РежимТоргов
			|ГДЕ
			|	(_ОбязательстваМаркетМейкеров.ЮрФизЛицо ЕСТЬ NULL
			|			ИЛИ ОбязательстваМаркетМейкеровСрезПоследних.ЮрФизЛицо ЕСТЬ NULL)
			|
			|СГРУППИРОВАТЬ ПО
			|	ЕСТЬNULL(_ОбязательстваМаркетМейкеров.ЮрФизЛицо, ОбязательстваМаркетМейкеровСрезПоследних.ЮрФизЛицо),
			|	ЕСТЬNULL(_ОбязательстваМаркетМейкеров.ЦеннаяБумага, ОбязательстваМаркетМейкеровСрезПоследних.ЦеннаяБумага),
			|	ЕСТЬNULL(_ОбязательстваМаркетМейкеров.РежимТоргов, ОбязательстваМаркетМейкеровСрезПоследних.РежимТоргов),
			|	НЕ _ОбязательстваМаркетМейкеров.ДатаНачалаДейтсвияДоговора ЕСТЬ NULL
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	МИНИМУМ(_ОбязательстваМаркетМейкеров.ДатаРасторжения),
			|	_ОбязательстваМаркетМейкеров.ЮрФизЛицо,
			|	_ОбязательстваМаркетМейкеров.ЦеннаяБумага,
			|	_ОбязательстваМаркетМейкеров.РежимТоргов,
			|	ЛОЖЬ,
			|	МИНИМУМ(_ОбязательстваМаркетМейкеров.ДатаРасторжения_Раскрытие)
			|ИЗ
			|	_ОбязательстваМаркетМейкеров КАК _ОбязательстваМаркетМейкеров
			|ГДЕ
			|	_ОбязательстваМаркетМейкеров.ДатаРасторжения > ДАТАВРЕМЯ(1, 1, 1)
			|
			|СГРУППИРОВАТЬ ПО
			|	_ОбязательстваМаркетМейкеров.РежимТоргов,
			|	_ОбязательстваМаркетМейкеров.ЦеннаяБумага,
			|	_ОбязательстваМаркетМейкеров.ЮрФизЛицо";
		#КонецОбласти 
		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
		
			Запись = РегистрыСведений.ОбязательстваМаркетМейкеров.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись, Выборка);
			Запись.Записать();
		
		КонецЦикла; 
		
	ИначеЕсли ВнешниеДанные = Неопределено Или ВнешниеДанные.Количество() = 0 Тогда
		ТекстОшибки = "Не обнаружено данных для загрузки";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли; 
	
КонецПроцедуры
 
Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Если Метод = "ИмпортироватьОбязательстваМаркетМейкера" Тогда
		ИмпортироватьОбязательстваМаркетМейкера(Экземпляры);
	ИначеЕсли Метод = "ИмпортироватьМаркетМейкеровПоЦеннойБумаге" Тогда 
		ИмпортироватьМаркетМейкеровПоЦеннойБумаге(Экземпляры);
	Иначе
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

Процедура ИмпортироватьОбязательстваМаркетМейкера(Экземпляры)

	КлючиЗапуска = Новый ТаблицаЗначений;

	КлючиЗапуска.Колонки.Добавить("ЮрФизЛицо",	Новый ОписаниеТипов("СправочникСсылка.ЮрФизЛица"));
	КлючиЗапуска.Колонки.Добавить("Идентификатор",	Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	// Фиксируем запуск.
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		
		НовыйКлюч = КлючиЗапуска.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
		
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлючиЗапуска.ЮрФизЛицо КАК ЮрФизЛицо,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _КлючиЗапуска
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлючиЗапуска.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_КлючиЗапуска.Идентификатор КАК Идентификатор
		|ИЗ
		|	_КлючиЗапуска КАК _КлючиЗапуска
		|ИТОГИ ПО
		|	ЮрФизЛицо";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	
	Результат = Запрос.Выполнить();
	ВыборкаСвязанноеЛицо = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСвязанноеЛицо.Следующий() Цикл
	
		ИмпортироватьОбязательстваМаркетМейкеров(,,, ВыборкаСвязанноеЛицо.ЮрФизЛицо);
		
		ВыборкаИдентификатор = ВыборкаСвязанноеЛицо.Выбрать();
		Пока ВыборкаИдентификатор.Следующий() Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ВыборкаИдентификатор.Идентификатор);
		КонецЦикла; 
	
	КонецЦикла;

КонецПроцедуры
 
Процедура ИмпортироватьМаркетМейкеровПоЦеннойБумаге(Экземпляры)

	КлючиЗапуска = Новый ТаблицаЗначений;

	КлючиЗапуска.Колонки.Добавить("ЦеннаяБумага",	Метаданные.ОпределяемыеТипы.ЦенныеБумаги.Тип);
	КлючиЗапуска.Колонки.Добавить("Идентификатор",	Новый ОписаниеТипов("УникальныйИдентификатор"));
	
	// Фиксируем запуск.
	Для Каждого ТекЭкземпляр Из Экземпляры Цикл
		
		НовыйКлюч = КлючиЗапуска.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовыйКлюч, ТекЭкземпляр.Параметры);
		НовыйКлюч.Идентификатор = ТекЭкземпляр.Идентификатор;
		
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлючиЗапуска.ЦеннаяБумага КАК ЦеннаяБумага,
		|	КлючиЗапуска.Идентификатор КАК Идентификатор
		|ПОМЕСТИТЬ _КлючиЗапуска
		|ИЗ
		|	&КлючиЗапуска КАК КлючиЗапуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлючиЗапуска.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_КлючиЗапуска.Идентификатор КАК Идентификатор
		|ИЗ
		|	_КлючиЗапуска КАК _КлючиЗапуска
		|ИТОГИ ПО
		|	ЦеннаяБумага";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КлючиЗапуска", КлючиЗапуска);
	
	Результат = Запрос.Выполнить();
	ВыборкаСвязанноеЛицо = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСвязанноеЛицо.Следующий() Цикл
	
		ИмпортироватьОбязательстваМаркетМейкеров(,,,, ВыборкаСвязанноеЛицо.ЦеннаяБумага);
		
		ВыборкаИдентификатор = ВыборкаСвязанноеЛицо.Выбрать();
		Пока ВыборкаИдентификатор.Следующий() Цикл
			РаботаСРегламентнымиЗаданиями.ЗафиксироватьВыполнениеОтложенногоЗадания(ВыборкаИдентификатор.Идентификатор);
		КонецЦикла; 
	
	КонецЦикла;

КонецПроцедуры
 
Функция ПолучитьНаименованияЮрЛицаСтрокой(ЮрЛицо)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.СокращенноеНаименование КАК СокращенноеНаименование
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних";
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЮрФизЛицо", ЮрЛицо);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
		
	Если Выборка.Следующий() Тогда
		
		МассивНаименований = Новый Массив;
		
		Для каждого Колонка Из Результат.Колонки Цикл
			
			ИмяКолонки = Колонка.Имя;
			Значение = Выборка[ИмяКолонки];
						
			Если ЗначениеЗаполнено(Значение) Тогда 
				ЗначениеСтрока = "'" + СтрЗаменить(Значение, "'", "''") + "'";
				МассивНаименований.Добавить(ЗначениеСтрока);
			КонецЕсли; 
		
		КонецЦикла; 
		
		Возврат СтрСоединить(МассивНаименований, ", ");
	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКодыЦеннойБумагиСтрокой(ЦеннаяБумага)
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			,
		|			ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|				И Объект = &Объект) КАК КодыВТорговыхСистемахСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Акции.ГосударственныйРегистрационныйНомер
		|ИЗ
		|	Справочник.Акции КАК Акции
		|ГДЕ
		|	Акции.Ссылка = &Объект
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДепозитарныеРасписки.РегистрационныйНомер
		|ИЗ
		|	Справочник.ДепозитарныеРасписки КАК ДепозитарныеРасписки
		|ГДЕ
		|	ДепозитарныеРасписки.Ссылка = &Объект
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Облигации.ГосударственныйРегистрационныйНомер
		|ИЗ
		|	Справочник.Облигации КАК Облигации
		|ГДЕ
		|	Облигации.Ссылка = &Объект
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Паи.ГосударственныйРегистрационныйНомер
		|ИЗ
		|	Справочник.Паи КАК Паи
		|ГДЕ
		|	Паи.Ссылка = &Объект";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект", ЦеннаяБумага);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	МассивКодов = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Код) Тогда 
			ЗначениеСтрока = "'" + СтрЗаменить(Выборка.Код, "'", "''") + "'";
			МассивКодов.Добавить(ЗначениеСтрока);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат СтрСоединить(МассивКодов, ", ");
	
КонецФункции

Функция СтрокаСоединения() Экспорт
	
	Возврат РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
	
КонецФункции

