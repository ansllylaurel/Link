// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки          опов
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Ожидаемые оферты", "0.04", "", Истина);
		
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтчетПоОжидаемымОфертам", "Отчет по ожидаемым офертам", ,Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	// Организуем сбор статистики
	ПараметрыВыполненияДляСбораСтатистики = ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды, ПараметрыКоманды);
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание
	);
	
	Если ИдентификаторКоманды = "ОтчетПоОжидаемымОфертам" Тогда
		ТекущаяДата = ТекущаяДата();
		ОжидаемыеОферты(Новый Структура("ДатаНачала, ДатаОкончания", НачалоНедели(ТекущаяДата), КонецНедели(ТекущаяДата)));
	КонецЕсли;
	
	// Завершаем сессию
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры // ВыполнитьКоманду

// Возвращает параметры выполняемой по регламентному заданию команды для подключения к механизму регистрации работы
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды  
Функция ПолучитьПараметрыВыполненияДляСбораСтатистики(ИдентификаторКоманды, ПараметрыКоманды)
	
	ПараметрыОтчета = Новый Соответствие();
	ПараметрыОтчета.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);

	Если ПараметрыКоманды.Свойство("ПолучателиОповещения") Тогда
		ПараметрыОтчета.Вставить("ПолучателиОповещения", ПараметрыКоманды.ПолучателиОповещения);
	КонецЕсли;
	
	Описание = "";
	Для Каждого ПараметрОтчета Из ПараметрыОтчета Цикл
		Описание = Описание + ПараметрОтчета.Ключ + ": " + ПараметрОтчета.Значение + Символы.ПС;		
	КонецЦикла;
	Описание = Лев(Описание, СтрДлина(Описание) - СтрДлина(Символы.ПС));	
	
	Хранилище = Новый ХранилищеЗначения(ПараметрыОтчета);
	
	ПараметрыВыполненияДляСбораСтатистики = Новый Структура("Хранилище, Описание", Хранилище, Описание);
	
	Возврат ПараметрыВыполненияДляСбораСтатистики;
	
КонецФункции // ПолучитьПараметрыВыполненияДляСбораСтатистики

Процедура ВыполнитьМетод(Метод, Экземпляры) Экспорт
	
	Если Метод = "ОжидаемыеОферты" Тогда
		Для Каждого ТекЭкземпляр Из Экземпляры Цикл
			ОжидаемыеОферты(ТекЭкземпляр.Параметры);
		КонецЦикла;	
	Иначе
		Возврат;
	КонецЕсли; 
	
КонецПроцедуры

Функция ПолучитьРеквизитыОповещения(ДатаНачала, ДатаОкончания, Организация)

	ПараметрыПодключения = РаботаСоСтрокамиКлиентСервер.ПолучитьПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	СсылкаИБ = СтрШаблон("e1c://server/%1/%2", ПараметрыПодключения.Srvr, ПараметрыПодключения.Ref);
	
	РеквизитыОповещения = Новый Структура("Организация, Период, ТекстОповещения", Организация, ПредставлениеПериода(ДатаНачала, ДатаОкончания), "");
	
	РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<table border=""0"" cellspacing=""1"" bgcolor=""#000000""><tr bgcolor=""#FFFFFF""><td><b>Дата оферты</b></td><td><b>Облигация</b></td><td><b>Счета ДУ</b></td></tr>";
	
	ТаблицаОферт = ПолучитьОжидаемыеОферты(ДатаНачала, ДатаОкончания, Организация);
	Для каждого СтрокаТаблицаОферт Из ТаблицаОферт Цикл
	
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<tr bgcolor=""#FFFFFF"">";
		
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Формат(СтрокаТаблицаОферт.ДатаОферты, "ДФ=dd.MM.yyyy") + "</td>";
		Ссылка = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(СтрокаТаблицаОферт.Облигация);
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td valign = ""top""><A href=""" + Ссылка + """>" + Строка(СтрокаТаблицаОферт.Облигация) + "</A></td>";
		
	    РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td>" + СтрЗаменить(СтрокаТаблицаОферт.СчетаДУ, Символы.ПС, "<br>") + "</td>";
	    
		РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "</tr>";
	
	КонецЦикла;
	
	РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "</table>";
	
	Возврат РеквизитыОповещения;	

КонецФункции

Процедура ОжидаемыеОферты(Параметры) Экспорт

	Справочники.Оповещения.СформироватьОповещения("Обработка._ОжидаемыеОферты", 
		Перечисления.ТипыСобытий.ВнешнийВызов, 
		ПолучитьРеквизитыОповещения(Параметры.ДатаНачала, Параметры.ДатаОкончания, ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ")));
		
КонецПроцедуры

Функция ПолучитьОжидаемыеОферты(ДатаНачала, ДатаОкончания, Организация)

	ТаблицаОферт = Новый ТаблицаЗначений;
	
	ТаблицаОферт.Колонки.Добавить("ДатаОферты", Новый ОписаниеТипов("Дата"));
	ТаблицаОферт.Колонки.Добавить("Облигация", Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ТаблицаОферт.Колонки.Добавить("СчетаДУ", Новый ОписаниеТипов("Строка"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	УсловияОферт.ДатаВыкупа КАК ДатаВыкупа,
		|	БухПартииЦенныхБумагОстатки.УчетныйАктивЕПС.СчетУчета.Родитель.Код КАК СчетУчета
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&ДатаОстатков,
		|			ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|				И Организация = &Организация
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И УчетныйАктивЕПС.Родитель В (ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеЧерезПСД), ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения))) КАК БухПартииЦенныхБумагОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = УсловияОферт.Облигация
		|			И (УсловияОферт.ДатаВыкупа >= &НачалоПериода)
		|			И (УсловияОферт.ДатаВыкупа <= &ОкончаниеПериода)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВыкупа,
		|	ЦеннаяБумага,
		|	СчетДоверительногоУправления
		|ИТОГИ ПО
		|	ДатаВыкупа,
		|	ЦеннаяБумага";
	
	Запрос.УстановитьПараметр("ДатаОстатков", КонецДня(ДатаНачала));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДатаВыкупа = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДатаВыкупа.Следующий() Цикл
		
		ВыборкаЦеннаяБумага = ВыборкаДатаВыкупа.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЦеннаяБумага.Следующий() Цикл
			
			СчетаДУ = "";
			ВыборкаДетальныеЗаписи = ВыборкаЦеннаяБумага.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				СчетаДУ = СчетаДУ + Строка(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления) + " - " + ВыборкаДетальныеЗаписи.СчетУчета + Символы.ПС;
			КонецЦикла;	
			
			СтрокаТаблицаОферт = ТаблицаОферт.Добавить();
			СтрокаТаблицаОферт.ДатаОферты = ВыборкаДатаВыкупа.ДатаВыкупа;
			СтрокаТаблицаОферт.Облигация = ВыборкаЦеннаяБумага.ЦеннаяБумага;
			СтрокаТаблицаОферт.СчетаДУ = СчетаДУ;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОферт;

КонецФункции

Процедура СформироватьОтчет(ДатаНачала, ДатаОкончания, Результат, Организация) Экспорт

	Результат.Очистить();
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ОбластьШапка.Параметры.Организация = Организация;
	ОбластьШапка.Параметры.ПериодСтр = ПредставлениеПериода(ДатаНачала, ДатаОкончания);
	
	Результат.Вывести(ОбластьШапка);
	
	ТаблицаОферт = ПолучитьОжидаемыеОферты(ДатаНачала, ДатаОкончания, Организация);
	Для каждого СтрокаТаблицаОферт Из ТаблицаОферт Цикл
	
		ОбластьСтрока.Параметры.ДатаОферты = СтрокаТаблицаОферт.ДатаОферты;
		ОбластьСтрока.Параметры.Облигация = СтрокаТаблицаОферт.Облигация;
		ОбластьСтрока.Параметры.СчетаДУ = СтрокаТаблицаОферт.СчетаДУ;
			
		Результат.Вывести(ОбластьСтрока);
	
	КонецЦикла;
		
КонецПроцедуры

