&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.МножественныйВыбор          = Ложь; 
	ДиалогОткрытияФайла.ПроверятьСуществованиеФайла = Истина;
	ДиалогОткрытияФайла.Фильтр                      = "Файлы xsd|*.xsd;";
	ДиалогОткрытияФайла.Заголовок                   = "Выберите файл для загрузки";	
	ДиалогОткрытияФайла.Каталог                     = КаталогИИмяФайлаИзПолногоИмени(Объект.ИмяФайла).Каталог;
	
	ДиалогОткрытияФайла.Показать(Новый ОписаниеОповещения("ПриВыбореФайла", ЭтаФорма));

КонецПроцедуры

&НаКлиенте
Функция КаталогИИмяФайлаИзПолногоИмени(ПолноеИмяФайла)
	
	СтруктураИмени = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайла);
	Возврат Новый Структура("Каталог, ИмяФайла", СтруктураИмени.Путь, СтруктураИмени.Имя);
	
КонецФункции	

&НаКлиенте
Процедура ПриВыбореФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если НЕ ВыбранныеФайлы = Неопределено Тогда
		Объект.ИмяФайла = СокрЛП(ВыбранныеФайлы[0]);
		
		ФильтрРазделы.Очистить();
		ФильтрОси.ПолучитьЭлементы().Очистить();
		УстановитьВидимостьЭлементов();
		Результат = Новый ТабличныйДокумент;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл(Команда) Экспорт
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("ПрочитатьФайл");
	ВыполнитьЧтениеФайла(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЧтениеФайла(ПараметрыСессии)
	
	ФайлНаДиске = Новый Файл(Объект.ИмяФайла);
	
	Если НЕ ФайлНаДиске.Существует() Тогда
		ТекстОшибки = "Файл не найден";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Если Найти(ВРег(ФайлНаДиске.Расширение), ".XSD") = 0 Тогда
		ТекстОшибки = "Файл не является XSD-схемой";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОчисткаДанныхВременногоХранилища();
	СформироватьПредставлениеXSDСхемыНаСервере(ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ФайлНаДиске.ПолноеИмя), УникальныйИдентификатор));
	ЗаполнитьФильтрОсей();
	РазвернутьДеревоФильтраОсей();
	СформироватьОтчет();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.ГруппаУправлениеФильтрами.Видимость  = ФильтрРазделы.Количество() > 0;
	Элементы.ГруппаЗагрузкаИзФайлаExcel.Видимость = Не Объект.ВнешнееОткрытие;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоФильтраОсей()
	
	Для Каждого Группа Из ФильтрОси.ПолучитьЭлементы() Цикл
		Элементы.ФильтрОси.Развернуть(Группа.ПолучитьИдентификатор());
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПредставлениеXSDСхемыНаСервере(АдресФайла)
	
	ДанныеТочки = РеквизитФормыВЗначение("Объект").ПредставлениеXSD(АдресФайла);
	
	УникальныеЗначенияОсейПоРазделам.Загрузить(ДанныеТочки.УникальныеЗначенияЗакрытыхОсей);
	ТабличныеДанные.Загрузить(ДанныеТочки.ТабличныеДанные);
	
	ЗаполнитьФильтрРазделовНаСервере(ДанныеТочки.ИменаРазделов);
	
	ТабДокШапкаОтчета = ДанныеТочки.ТабличныйДокумент;
	ТабДокПропуск     = ДанныеТочки.ТабДокПропуск;
	
КонецПроцедуры	

&НаКлиенте
Процедура СформироватьОтчет()
	
	ТабличныеРазделы = Новый Массив;
	
	ЕстьФильтрОсей = ФильтрОси.ПолучитьЭлементы().Количество() > 0;
	
	Для Каждого ВыбранныйРаздел Из ФильтрРазделы Цикл
		Видимость = ВыбранныйРаздел.Использование И (Не ЕстьФильтрОсей Или ПройденФильтрОсей(ВРег(ВыбранныйРаздел.Имя)));
		
		НайденныеСтроки = ТабличныеДанные.НайтиСтроки(Новый Структура("Раздел", ВРег(ВыбранныйРаздел.Имя)));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ТабличныеРазделы.Добавить(Новый Структура("Раздел, Видимость, Область, Адрес", ВыбранныйРаздел.Имя, Видимость, , НайденнаяСтрока.ТабДокументАдрес));
		КонецЦикла;	
	КонецЦикла;	
	
	//Сообщить(СтрШаблон("Перед: %1", ТекущаяУниверсальнаяДатаВМиллисекундах()));
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Результат = СформироватьОтчетНаСервере(ТабличныеРазделы, ТабДокШапкаОтчета, ТабДокПропуск);	
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	//Сообщить(СтрШаблон("Время получения результата формирования отчета: %1", ОбщегоНазначенияКлиентСервер.ДлительностьВЧасахМинутахСекундах(ВремяОкончания - ВремяНачала)));
	//
	//Сообщить(СтрШаблон("После возврата: %1", ТекущаяУниверсальнаяДатаВМиллисекундах()));
	
	Для Каждого ТабличныйРаздел Из ТабличныеРазделы Цикл
		НайденныеСтроки = ФильтрРазделы.НайтиСтроки(Новый Структура("Имя", ТабличныйРаздел.Раздел));
		Если НайденныеСтроки.Количество() = 1 Тогда
			НайденныеСтроки[0].Область = ТабличныйРаздел.Область;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьОтчетНаСервере(РазделыДляВывода, ТабДокШапкаОтчета, ТабДокПропуск)
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Результат = Новый ТабличныйДокумент;
	Результат.Вывести(ТабДокШапкаОтчета);
	
	Для Каждого РазделДляВывода Из РазделыДляВывода Цикл
		Результат.Вывести(ТабДокПропуск);
		Область = Результат.Вывести(ПолучитьИзВременногоХранилища(РазделДляВывода.Адрес).Получить());
		РазделДляВывода.Область = Новый Структура("Верх, Низ", Область.Верх, Область.Низ);
		
		Если Не РазделДляВывода.Видимость Тогда
			ОбластьТабДок = Результат.Область(РазделДляВывода.Область.Верх - 1, , РазделДляВывода.Область.Низ);
			ОбластьТабДок.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	//Сообщить(СтрШаблон("Время формирования отчета в процедуре: %1", ОбщегоНазначенияКлиентСервер.ДлительностьВЧасахМинутахСекундах(ВремяОкончания - ВремяНачала)));
	
	Возврат Результат;
	//Возврат ПоместитьВоВременноеХранилище(Результат, Новый УникальныйИдентификатор);
	
КонецФункции	

&НаКлиенте
Функция ПройденФильтрОсей(Раздел)
	
	Рез = Истина;
	
	Ключи = Новый Массив;
	
	Для Каждого Группа Из ФильтрОси.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаГруппы Из Группа.ПолучитьЭлементы() Цикл
			Если СтрокаГруппы.Использование И Ключи.Найти(СтрокаГруппы.Ключ) = Неопределено Тогда
				Ключи.Добавить(СтрокаГруппы.Ключ);
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;	
	
	НайденныеСтроки = УникальныеЗначенияОсейПоРазделам.НайтиСтроки(Новый Структура("Раздел", Раздел));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если Ключи.Найти(НайденнаяСтрока.Ключ) = Неопределено Тогда
			Рез = Ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Рез;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьФильтрРазделовНаСервере(ИменаРазделов) 
	
	ФильтрОси.ПолучитьЭлементы().Очистить();
	ФильтрРазделы.Очистить();
	Для Каждого ИмяРаздела Из ИменаРазделов Цикл
		НоваяСтрока = ФильтрРазделы.Добавить();
		НоваяСтрока.Использование = ?(Объект.ВнешнийФильтрРазделы.Количество() И Объект.ВнешнийФильтрРазделы.НайтиСтроки(Новый Структура("Имя", ВРег(ИмяРаздела))).Количество() = 0, 
										Ложь, 
										Истина);
		НоваяСтрока.Имя           = ИмяРаздела;
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьФильтрОсей()
	
	ОтфильтрованныеОси = Новый Массив;
	
	Для Каждого Группа Из ФильтрОси.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаГруппы Из Группа.ПолучитьЭлементы() Цикл
			Если Не СтрокаГруппы.Использование Тогда
				ОтфильтрованныеОси.Добавить(СтрокаГруппы.Ключ);
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;	
	
	ФильтрОси.ПолучитьЭлементы().Очистить();
	
	ВыбранныеРазделы = ФильтрРазделы.НайтиСтроки(Новый Структура("Использование", Истина));
	
	Ключи = Новый Массив;
	Оси   = Новый Массив;
	
	Для Каждого ВыбранныйРаздел Из ВыбранныеРазделы Цикл
		НайденныеСтроки = УникальныеЗначенияОсейПоРазделам.НайтиСтроки(Новый Структура("Раздел", ВРег(ВыбранныйРаздел.Имя)));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если Оси.Найти(НайденнаяСтрока.Описание) = Неопределено Тогда
				Оси.Добавить(НайденнаяСтрока.Описание);
			КонецЕсли;	
			Если Ключи.Найти(НайденнаяСтрока.Ключ) = Неопределено Тогда
				Ключи.Добавить(НайденнаяСтрока.Ключ);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	ВыведенныеКлючи = Новый Массив;
	
	СтрокиДерева = ФильтрОси.ПолучитьЭлементы();
	Для Каждого Ось Из Оси Цикл
		
		НоваяГруппа = СтрокиДерева.Добавить();
		НоваяГруппа.Ось       = Ось;
		НоваяГруппа.ЭтоГруппа = Истина;
		
		ЭлементыГруппы = НоваяГруппа.ПолучитьЭлементы();
		
		НайденныеСтроки = УникальныеЗначенияОсейПоРазделам.НайтиСтроки(Новый Структура("Описание", Ось));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если Не Ключи.Найти(НайденнаяСтрока.Ключ) = Неопределено И ВыведенныеКлючи.Найти(НайденнаяСтрока.Ключ) = Неопределено Тогда
				НоваяСтрока = ЭлементыГруппы.Добавить();
				НоваяСтрока.Ось           = НайденнаяСтрока.ОписаниеЗначения;
				НоваяСтрока.ЭтоГруппа     = Ложь;
				НоваяСтрока.Использование = ОтфильтрованныеОси.Найти(НайденнаяСтрока.Ключ) = Неопределено;
				НоваяСтрока.Ключ          = НайденнаяСтрока.Ключ;
				ВыведенныеКлючи.Добавить(НайденнаяСтрока.Ключ);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		СтандартнаяОбработка = Ложь;
		Если Расшифровка.ВидРасшифровки = "Фасеты" Тогда
			ПараметрыФормы = Новый Структура("Расшифровка", Расшифровка);
			ОткрытьФорму("ВнешняяОбработка._ВизуализацияСтруктурыТочкиВхода.Форма.ФормаПросмотраФасетов", ПараметрыФормы, ЭтаФорма, Истина, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиФильтра(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("УстановитьФлажкиФильтра");
	УправлениеФлажкамиФильтра(Истина);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиФильтра(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("СнятьФлажкиФильтра");
	УправлениеФлажкамиФильтра(Ложь);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлажкамиФильтра(Значение)
	
	Таблица = ?(СтрНайти(ЭтаФорма.ТекущийЭлемент.Имя, "Оси") > 0, "Оси", "Разделы");
	
	Если Таблица = "Разделы" Тогда
		
		Если Элементы.ФильтрРазделы.ВыделенныеСтроки.Количество() > 1 Тогда
			Для Каждого ИдентификаторСтроки Из Элементы.ФильтрРазделы.ВыделенныеСтроки Цикл
				Фильтр = ФильтрРазделы.НайтиПоИдентификатору(ИдентификаторСтроки);
				Фильтр.Использование = Значение;
				УстановитьВидимостьРаздела(Фильтр);
			КонецЦикла;	
		Иначе	
			Для Каждого Фильтр Из ФильтрРазделы Цикл
				Фильтр.Использование = Значение;
				УстановитьВидимостьРаздела(Фильтр);
			КонецЦикла;	
		КонецЕсли;
		ЗаполнитьФильтрОсей();
		РазвернутьДеревоФильтраОсей();
		
	ИначеЕсли Таблица = "Оси" Тогда
		
		Если Элементы.ФильтрОси.ВыделенныеСтроки.Количество() > 1 
			Или Элементы.ФильтрОси.ВыделенныеСтроки.Количество() = 1 
				И ФильтрОси.НайтиПоИдентификатору(Элементы.ФильтрОси.ВыделенныеСтроки[0]).ЭтоГруппа Тогда
			Для Каждого ИдентификаторСтроки Из Элементы.ФильтрОси.ВыделенныеСтроки Цикл
				СтрокаДерева = ФильтрОси.НайтиПоИдентификатору(ИдентификаторСтроки);
				СтрокаДерева.Использование = Значение;
				Если СтрокаДерева.ЭтоГруппа Тогда
					Для Каждого СтрокаГруппы Из СтрокаДерева.ПолучитьЭлементы() Цикл
						СтрокаГруппы.Использование = Значение;
					КонецЦикла;	
			    КонецЕсли;
			КонецЦикла;	
		Иначе	
			Для Каждого Группа Из ФильтрОси.ПолучитьЭлементы() Цикл
				Для Каждого СтрокаГруппы Из Группа.ПолучитьЭлементы() Цикл
					СтрокаГруппы.Использование = Значение;
				КонецЦикла;	
			КонецЦикла;	
		КонецЕсли;
		
	КонецЕсли;
	
	Для Каждого Фильтр Из ФильтрРазделы Цикл
		УстановитьВидимостьРаздела(Фильтр);
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

	ОбъектНаСервере = РеквизитФормыВЗначение("Объект");
	ИспользуемоеИмяФайла = ОбъектНаСервере.ИспользуемоеИмяФайла;
	
	Если Параметры.Свойство("ВнешнийФильтр") Тогда
		Для Каждого ИмяРаздела Из Параметры.ВнешнийФильтр Цикл
			НоваяСтрока = Объект.ВнешнийФильтрРазделы.Добавить();
			НоваяСтрока.Имя = ИмяРаздела;
		КонецЦикла;
		Объект.ВнешнееОткрытие = Объект.ВнешнийФильтрРазделы.Количество() > 0;
		Объект.ИмяФайла        = Параметры.ИмяФайла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Объект.ВнешнееОткрытие Тогда
		ПодключитьОбработчикОжидания("ОбработчикОтложенногоФормирования", 0.1, Истина);
	КонецЕсли;	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОтложенногоФормирования() Экспорт
	
	ПрочитатьФайл(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура УникальныеЗначенияОсейПередСворачиванием(Элемент, Строка, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрРазделыПриИзменении(Элемент)
	
	ЗаполнитьФильтрОсей();
	
	РазвернутьДеревоФильтраОсей();
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("Сформировать");
	СформироватьОтчет();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("СброситьФильтры");
	ВыполнитьСбросФильтров();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСбросФильтров()
	
	Для Каждого СтрокаФильтра Из ФильтрРазделы Цикл
		СтрокаФильтра.Использование = (Объект.ВнешнийФильтрРазделы.НайтиСтроки(Новый Структура("Имя", ВРег(СтрокаФильтра.Имя))).Количество() > 0) Или Объект.ВнешнийФильтрРазделы.Количество() = 0;
		УстановитьВидимостьРаздела(СтрокаФильтра);	
	КонецЦикла;	
	ФильтрОси.ПолучитьЭлементы().Очистить();
	ФильтрРазделыПриИзменении(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
	Если Объект.ВнешнееОткрытие Тогда
		Объект.ИмяФайла = ЭтаФорма.Параметры.ИмяФайла; // При внешнем открытии автоматически сохраняемое в настройках имя файла нужно взять из переданных параметров
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатПриАктивизацииОбласти(Элемент)
	
	УстановитьПризнакВыделенияРаздела();	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакВыделенияРаздела()
	
	Для Каждого СтрокаФильтра Из ФильтрРазделы Цикл
		СтрокаФильтра.Выделен = Ложь;
	КонецЦикла;
	
	ВыделенныеОбласти = Результат.ВыделенныеОбласти;
	Для Каждого ВыделеннаяОбласть Из ВыделенныеОбласти Цикл
		Если ТипЗнч(ВыделеннаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
			Для Каждого СтрокаФильтра Из ФильтрРазделы Цикл
				ЕстьВыделение = ВыделеннаяОбласть.Верх <= СтрокаФильтра.Область.Низ И ВыделеннаяОбласть.Низ >= СтрокаФильтра.Область.Верх;
				Если ЕстьВыделение И СтрокаФильтра.Использование Тогда
					СтрокаФильтра.Выделен = Истина;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрРазделыИспользованиеПриИзменении(Элемент)
	
	ЗаполнитьФильтрОсей();
	
	РазвернутьДеревоФильтраОсей();
	
	ТекущиеДанные = Элементы.ФильтрРазделы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		УстановитьВидимостьРаздела(ТекущиеДанные);	
	КонецЕсли;	
	УстановитьПризнакВыделенияРаздела();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьРаздела(Раздел)
	
	ЕстьФильтрОсей = ФильтрОси.ПолучитьЭлементы().Количество() > 0;
	Видимость = Раздел.Использование И (Не ЕстьФильтрОсей Или ПройденФильтрОсей(ВРег(Раздел.Имя)));
	
	ОбластьТабДок = Результат.Область(Раздел.Область.Верх - 1, , Раздел.Область.Низ);
	ОбластьТабДок.Видимость = Видимость;
	// Вновь отображенная группировка выводится в развернутом виде. Установка видимости в Ложь, чтобы свернуть группу
	Если Видимость Тогда
		//ОбластьТабДок = Результат.Область(Раздел.Область.Верх + 1 + ЕстьУникальныеЗначенияОсей(Раздел.Имя), , Раздел.Область.Низ);
		//ОбластьТабДок.Видимость = Ложь;
		СвернутьРазвернутьРаздел(Раздел, Истина);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура СвернутьРазвернутьРаздел(Раздел, Свернуть = Неопределено)
	
	ОбластьТабДок = Результат.Область(Раздел.Область.Верх + 1 + ЕстьУникальныеЗначенияОсей(Раздел.Имя), , Раздел.Область.Низ);
	Если Свернуть = Неопределено Тогда
		Свернуть = ОбластьТабДок.Видимость;
	КонецЕсли;	
	
	ОбластьТабДок.Видимость = Не Свернуть;
	
КонецПроцедуры	

&НаКлиенте
Функция ЕстьУникальныеЗначенияОсей(Раздел)
	
	Возврат УникальныеЗначенияОсейПоРазделам.НайтиСтроки(Новый Структура("Раздел", ВРег(Раздел))).Количество() > 0;
	
КонецФункции	

&НаКлиенте
Процедура ФильтрОсиИспользованиеПриИзменении(Элемент)
	
	Для Каждого Фильтр Из ФильтрРазделы Цикл
		УстановитьВидимостьРаздела(Фильтр);
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура ФильтрРазделыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяОбласть = Результат.ТекущаяОбласть;
	
	Раздел = Элементы.ФильтрРазделы.ТекущиеДанные;
	Если Раздел <> Неопределено Тогда

		ЕстьФильтрОсей = ФильтрОси.ПолучитьЭлементы().Количество() > 0;
		Видимость = Раздел.Использование И (Не ЕстьФильтрОсей Или ПройденФильтрОсей(ВРег(Раздел.Имя)));
		Если Видимость Тогда
			СвернутьРазвернутьРаздел(Раздел)	
		КонецЕсли;
	КонецЕсли;	
	
	Результат.ТекущаяОбласть = ТекущаяОбласть;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчисткаДанныхВременногоХранилища()
	
	Адреса = Новый Массив;
	Для Каждого ДанныеРаздела Из ТабличныеДанные Цикл
		Адреса.Добавить(ДанныеРаздела.ТабДокументАдрес);
		Для Каждого Адрес Из СтрРазделить(ДанныеРаздела.АдресаЭлементовРасшифровок, "#") Цикл
			Адреса.Добавить(Адрес);
		КонецЦикла;
	КонецЦикла;	
	ОчисткаДанныхВременногоХранилищаНаСервере(Адреса);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчисткаДанныхВременногоХранилищаНаСервере(Адреса)
	
	АдресаВременногоХранилища = Новый ТаблицаЗначений;
	АдресаВременногоХранилища.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Адрес Из Адреса Цикл
		НоваяСтрока = АдресаВременногоХранилища.Добавить();	
		НоваяСтрока.Адрес = Адрес;
	КонецЦикла;	
	
	АдресаВременногоХранилища.Свернуть("Адрес");
	
	// Удаление табличных документов из временного хранилища
	Для Каждого СтрокаАдреса Из АдресаВременногоХранилища Цикл
		Если ЭтоАдресВременногоХранилища(СтрокаАдреса.Адрес) Тогда
			УдалитьИзВременногоХранилища(СтрокаАдреса.Адрес);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Не ЗавершениеРаботы Тогда // Если работа приложения завершается, то и очищать временное хранилище не имеет смысла
		ОчисткаДанныхВременногоХранилища();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РезультатВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Если ЗначениеЗаполнено(Область.Текст) Тогда
			СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, СокрЛП(Область.Текст)));
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Буфер(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("Буфер");
	ВыполнитьКопированиеВБуфер(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКопированиеВБуфер(ПараметрыСессии)
	
	ВыделенныеОбласти = Результат.ВыделенныеОбласти;
	Если ВыделенныеОбласти.Количество() = 1 Тогда
		ВыделеннаяОбласть = ВыделенныеОбласти[0];
		
		СтрокиСТекстом  = Новый СписокЗначений;
		СтолбцыСТекстом = Новый СписокЗначений;
		
		Для ТекСтрока = ВыделеннаяОбласть.Верх По ВыделеннаяОбласть.Низ Цикл
			Для ТекСтолбец = ВыделеннаяОбласть.Лево По ВыделеннаяОбласть.Право Цикл
				ТекущаяОбласть = Результат.Область(ТекСтрока, ТекСтолбец, ТекСтрока, ТекСтолбец);
				Если ТекущаяОбласть.Видимость Тогда
					ТекущийТекст = СокрЛП(ТекущаяОбласть.Текст);
					Если ЗначениеЗаполнено(ТекущийТекст) Тогда
						Если СтолбцыСТекстом.НайтиПоЗначению(ТекСтолбец) = Неопределено Тогда
							СтолбцыСТекстом.Добавить(ТекСтолбец);	
						КонецЕсли;	
						Если СтрокиСТекстом.НайтиПоЗначению(ТекСтрока) = Неопределено Тогда
							СтрокиСТекстом.Добавить(ТекСтрока);	
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;
		СтрокиСТекстом.СортироватьПоЗначению();
		СтолбцыСТекстом.СортироватьПоЗначению();
		
		ИтоговыйТекст = "";
		Для Каждого СтрокаСписка Из СтрокиСТекстом Цикл
			ТекстСтроки = Новый Массив;
			Для Каждого СтолбецСписка Из СтолбцыСТекстом Цикл
				ТекущаяОбласть = Результат.Область(СтрокаСписка.Значение, СтолбецСписка.Значение, СтрокаСписка.Значение, СтолбецСписка.Значение);
				ТекущийТекст   = СокрЛП(ТекущаяОбласть.Текст);
				ТекстСтроки.Добавить(ТекущийТекст);
			КонецЦикла;	
			ИтоговыйТекст = ИтоговыйТекст + СтрСоединить(ТекстСтроки, Символы.Таб) + Символы.ПС;
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(ИтоговыйТекст) Тогда
			ИтоговыйТекст = Лев(ИтоговыйТекст, СтрДлина(ИтоговыйТекст) - 1);
		КонецЕсли;	
		
		Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
			СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ИтоговыйТекст));
		Иначе
			ТекстОшибки = "Буфер обмена недоступен";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ПоказатьПредупреждение(, ТекстОшибки);
		КонецЕсли;
		
	Иначе
		ТекстОшибки = "Не выделена одна область";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервереБезКонтекста
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)  
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, 
		ПараметрыСессии.Сессия, 
		Новый Структура("ТекстОшибки", ТекстОшибки));
		
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессиюНаСервере(ИмяКоманды)
	
	Возврат
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
			РеквизитФормыВЗначение("Объект"), ИмяКоманды);

КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия);
	
КонецПроцедуры

#КонецОбласти