
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьДанныеНаСервере(Параметры);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(Параметры)
	
	Если Параметры.Свойство("Расшифровка") Тогда
		
		Расшифровка = Параметры.Расшифровка;
		
		ИмяТипаСтрока = Расшифровка.ИмяТипа;
		
		ТекстXML = ПолучитьИзВременногоХранилища(Расшифровка.АдресXML).Получить();
		
		Представление = Новый ФорматированнаяСтрока(СтрШаблон(" (%1)", Расшифровка.Представление), Новый Шрифт( , , , Истина), Новый Цвет(192, 0, 0));
		ИмяТипа       = Новый ФорматированнаяСтрока(Расшифровка.ИмяТипа, Новый Шрифт( , , Истина));
		ОписаниеТипа  = Новый ФорматированнаяСтрока(ИмяТипа, Представление);
		
		ТаблицаФасетов = ПолучитьИзВременногоХранилища(Расшифровка.АдресФасеты).Получить();
				
		Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Фасеты");
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Для Каждого СтрокаФасета Из ТаблицаФасетов Цикл
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьСтрока.Параметры.Заполнить(СтрокаФасета);
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;	
		
		Если ТаблицаФасетов.Количество() Тогда
			Элементы.Ограничения.Заголовок = СтрШаблон("Ограничения (%1)", ТаблицаФасетов.Количество());
		КонецЕсли;	
	КонецЕсли;	
	ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.Закрыть;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличныйДокументВыбор(Элемент, Область, СтандартнаяОбработка)
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Если ЗначениеЗаполнено(Область.Текст) Тогда
			СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, СокрЛП(Область.Текст)));
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеТипаНажатие(Элемент, СтандартнаяОбработка)

	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		СтандартнаяОбработка = Ложь;
		СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ИмяТипаСтрока));
	КонецЕсли;	
	Состояние("Имя типа скопировано в буфер обмена");
	
КонецПроцедуры

&НаКлиенте
Процедура Буфер(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("Буфер");
	ВыполнитьКопированиеВБуфер(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКопированиеВБуфер(ПараметрыСессии)
	
	Если Не СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		ТекстОшибки = НСтр("ru = 'Буфер обмена недоступен.'");
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ВыделенныеОбласти = ТабличныйДокумент.ВыделенныеОбласти;
	Если ВыделенныеОбласти.Количество() <> 1 Тогда
		ТекстОшибки = НСтр("ru = 'Выделите одну область для копирования.'");
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ВыделеннаяОбласть = ВыделенныеОбласти[0];
	
	СтрокиСТекстом  = Новый СписокЗначений;
	СтолбцыСТекстом = Новый СписокЗначений;
	
	Для ТекСтрока = ВыделеннаяОбласть.Верх По ВыделеннаяОбласть.Низ Цикл
		Для ТекСтолбец = ВыделеннаяОбласть.Лево По ВыделеннаяОбласть.Право Цикл
			ТекущаяОбласть = ТабличныйДокумент.Область(ТекСтрока, ТекСтолбец, ТекСтрока, ТекСтолбец);
			Если ТекущаяОбласть.Видимость Тогда
				ТекущийТекст = СокрЛП(ТекущаяОбласть.Текст);
				Если ЗначениеЗаполнено(ТекущийТекст) Тогда
					Если СтолбцыСТекстом.НайтиПоЗначению(ТекСтолбец) = Неопределено Тогда
						СтолбцыСТекстом.Добавить(ТекСтолбец);
					КонецЕсли;
					Если СтрокиСТекстом.НайтиПоЗначению(ТекСтрока) = Неопределено Тогда
						СтрокиСТекстом.Добавить(ТекСтрока);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	СтрокиСТекстом.СортироватьПоЗначению();
	СтолбцыСТекстом.СортироватьПоЗначению();
	
	ИтоговыйТекст = "";
	Для Каждого СтрокаСписка Из СтрокиСТекстом Цикл
		ТекстСтроки = Новый Массив;
		Для Каждого СтолбецСписка Из СтолбцыСТекстом Цикл
			ТекущаяОбласть = ТабличныйДокумент.Область(СтрокаСписка.Значение, СтолбецСписка.Значение, СтрокаСписка.Значение, СтолбецСписка.Значение);
			ТекущийТекст   = СокрЛП(ТекущаяОбласть.Текст);
			ТекстСтроки.Добавить(ТекущийТекст);
		КонецЦикла;
		ИтоговыйТекст = ИтоговыйТекст + СтрСоединить(ТекстСтроки, Символы.Таб) + Символы.ПС;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ИтоговыйТекст) Тогда
		ИтоговыйТекст = Лев(ИтоговыйТекст, СтрДлина(ИтоговыйТекст) - 1);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИтоговыйТекст) Тогда
		ТекстОшибки = НСтр("ru = 'В выделенной области нет текста для копирования.'");
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	СредстваБуфераОбмена.ПоместитьДанныеАсинх(Новый ЭлементБуфераОбмена(СтандартныйФорматДанныхБуфераОбмена.Текст, ИтоговыйТекст));
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти