		|			И _ПорученияДляИмпорта.ТипЗадолженности = _ОшибкиПоручений1С.ТипЗадолженности
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиДублейНомеровПоручений КАК _ОшибкиДублейНомеровПоручений
		|		ПО _ПорученияДляИмпорта.СчетДоверительногоУправления = _ОшибкиДублейНомеровПоручений.СчетДУ
		|			И _ПорученияДляИмпорта.НомерВходящегоДокумента = _ОшибкиДублейНомеровПоручений.НомерВходящегоДокумента
		|			И _ПорученияДляИмпорта.ТипЗадолженности = _ОшибкиДублейНомеровПоручений.ТипЗадолженности
		|ГДЕ
		|	(_Поручения1С.Ссылка ЕСТЬ NULL
		|				И _ПорученияДляИмпорта.ДатаИсполненияПо >= &ДатаФайлов
		|				И _ПорученияДляИмпорта.СрокНачалоФакт >= &ДатаЗагрузкиМинусОдинДень
		|				И _ПорученияДляИмпорта.ПереводМеждуУК = ЛОЖЬ
		|				И _ОшибкиДублейНомеровПоручений.НомерВходящегоДокумента ЕСТЬ NULL
		|				И _ОшибкиПоручений1С.НомерВходящегоДокумента ЕСТЬ NULL
		|			ИЛИ НЕ &ИмпортПорученийНаРегламенте)";
#КонецОбласти 

	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаФайлов", ЭтотОбъект.ДатаФайлов);
	Запрос.УстановитьПараметр("ДатаЗагрузкиВСистему", ЭтотОбъект.ДатаЗагрузкиВСистему);
	Запрос.УстановитьПараметр("ДатаЗагрузкиМинусОдинДень", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ЭтотОбъект.ДатаЗагрузкиВСистему, -2));
	Запрос.УстановитьПараметр("ТрастБывшийФилиал", ОбщегоНазначения.ПолучитьИменованныйОбъект("ЮрФизЛицо_Траст_БывФилиал"));
	Запрос.УстановитьПараметр("ТаблицаДанных", ТаблицаДанных);
	Запрос.УстановитьПараметр("ИмпортПорученийНаРегламенте", ИмпортПорученийНаРегламенте);
	Запрос.УстановитьПараметр("Ответственный", РегистрыСведений.ОтветственныеЗаОперации.ОпределитьОтветственного(ЭтотОбъект.Организация, "ПоручениеНаДвижениеДенежныхСредств",, ЭтотОбъект.ДатаЗагрузкиВСистему, РаботаСПользователями.ТекущийПользователь()));
	Запрос.УстановитьПараметр("Комментарий", "Создан аппаратно-техническими средствами " + ТекущаяДата());
	Запрос.УстановитьПараметр("ЗамененныеФайлы", ЗамененныеФайлы);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиВидаПоручений"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.ИмяФайла, Выборка.ВидДокумента), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияСчетовДУ"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.ДДУНомер, Формат(Выборка.ДДУДата, "ДФ=dd.MM.yyyy")), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ВозможныеПереводыМеждуУК"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		ЗафиксироватьТекстУведомления("Ошибка загрузки поручения на перевод из ДУ в ДУ: " + СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.ДДУНомер, Формат(Выборка.ДДУДата, "ДФ=dd.MM.yyyy")), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияИсполнителей"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.НомерСчета, Выборка.БИК, Выборка.СчетДУ, Выборка.ДДУНомер), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияРасчетныхСчетов"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		ЗафиксироватьТекстУведомления("Ошибка определения расчетного счета: " + СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.РасчСчет, Выборка.БИК), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла; 
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияСчетовИзНастроекУчетаДоходовПоЦеннымБумагам"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.СчетДУ, Выборка.ДДУНомер), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияКонтрагентов"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.ИНН), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;

	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиОпределенияВалют"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(Выборка.ТекстСообщения, СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиПоручений1С"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.Количество, Выборка.НомерВходящегоДокумента, Выборка.СчетДУ), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиДублейНомеровПоручений"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		ЗафиксироватьТекстУведомления("Ошибка дублей номеров поручений: " + СтрШаблон(Выборка.ТекстСообщения, Выборка.Количество, Выборка.НомерВходящегоДокумента, Выборка.СчетДУ), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиСрокаИсполнения"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ДатаИсполненияПо), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиНаименования"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Если ПреобразоватьСтрокуДляСревнения(Выборка.Наименование) <> ПреобразоватьСтрокуДляСревнения(Выборка.НаименованиеДляДокументов) Тогда 	
			ЗафиксироватьТекстУведомления("Ошибка в наименовании: " + СтрШаблон(Выборка.ТекстСообщения, Выборка.НомерПоручения, Выборка.ИмяФайла, Выборка.Наименование, Выборка.НаименованиеДляДокументов, Выборка.НомерСчета), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);
		КонецЕсли;
		
	КонецЦикла; 
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиРанееОбработанныеПоручения"].ПолучитьДанные().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(СтрШаблон(Выборка.ТекстСообщения, Выборка.ИмяФайла, Выборка.НомерПоручения), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиЗамененныхФайлов"].ПолучитьДанные().Выбрать();
	
	СообщениеОбИзменениях = "";

	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(Выборка.ИмяФайла, СообщениеОбИзменениях,, ИмпортПорученийНаРегламенте);	
	КонецЦикла;
	
	Если ИмпортПорученийНаРегламенте Тогда
		
		Если СообщениеОбИзменениях <> "" Тогда
			ЗафиксироватьТекстУведомления("<table cols=""1""><tr class=""top""><td>Новые файлы</td></tr>", СообщениеОбИзменениях, Истина, ИмпортПорученийНаРегламенте);
			СформироватьОповещенияПользователям("Импорт поручений фонда. Получены файлы с изменениями.", СообщениеОбИзменениях);
		КонецЕсли;
		
		Если СообщениеОбОшибках <> "" Тогда
			ЗафиксироватьТекстУведомления("<table cols=""1""><tr class=""top""><td>Текст ошибки</td></tr>", СообщениеОбОшибках, Истина, ИмпортПорученийНаРегламенте);
			СформироватьОповещенияПользователям("Импорт поручений фонда. Ошибки.", СообщениеОбОшибках);	
		КонецЕсли;

	КонецЕсли; 
	
	Если ЗамененныеФайлы.Количество() > 0 Тогда
		
		//Если для файла прислали замену, а файл еще не загружался - сразу отправляем его в "обработано",
		//т.к. дальнейшая загрузка будет осуществляться из файла замены.
		МассивЗамененныхФайлов = Новый Массив;  
			
		Для Каждого ТекЭлемент Из МассивФайлов Цикл
			
			Если Не (ЗамененныеФайлы.Найти(ТекЭлемент.Файл.Имя) = Неопределено Или ТекЭлемент.Обработан) Тогда
				МассивЗамененныхФайлов.Добавить(ТекЭлемент.Файл);	
			КонецЕсли;

		КонецЦикла; 
		
		РаботаСФайламиКлиентСервер.ПеренестиОбработанныеФайлыВКаталог(МассивЗамененныхФайлов);
		
	КонецЕсли;
		
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ЗагрузитьПоручения(ТаблицаДанных, ИмпортПорученийНаРегламенте, СтатистикаИмпортаПоручений)
	
	ОбработанныеФайлы = Новый Массив;
	
	ПорученияНаВвод_Записаны  = "";
	ПорученияНаВвод_Проведены = "";
	
	ПорученияНаВывод_Записаны  = "";
	ПорученияНаВывод_Проведены = "";
	
	ТекстСообщенияПользователям = "";
	
	Если ИмпортПорученийНаРегламенте Тогда
		//Перед загрузкой устанавливаем Истину, т.к. на регламенте падает ошибка.
		ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;
	Конецесли;
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		
		ПоручениеНаВвод = (СтрокаТаблицыДанных.ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская);
		
		Если ЗначениеЗаполнено(СтрокаТаблицыДанных.ПоручениеСсылка) Тогда
			Поручение = СтрокаТаблицыДанных.ПоручениеСсылка.ПолучитьОбъект();	
		Иначе	
			Поручение = Документы.ПоручениеНаДвижениеДенежныхСредств.СоздатьДокумент();	
		КонецЕсли;
		
		Если Поручение.ЭтоНовый() Тогда
			
			ТекДатаСеанса = ТекущаяДатаСеанса();
			
			Если НачалоДня(ЭтотОбъект.ДатаЗагрузкиВСистему) = НачалоДня(ТекДатаСеанса) Тогда
				Поручение.Дата = ТекДатаСеанса;
			Иначе
				Поручение.Дата = ЭтотОбъект.ДатаЗагрузкиВСистему + (9 * 60 + 30) * 60; //9:30
			КонецЕсли;
		
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поручение, СтрокаТаблицыДанных,, "Проведен");
		
		Если СтрокаТаблицыДанных.ПоручениеНаПереводМеждуСчетамиДУ Тогда
			Поручение.КонтрагентДоговорТекстом = СтрокаТаблицыДанных.КонтрагентДоговорТекстом + ", договор ДУ " + СтрокаТаблицыДанных.ДДУНомер + " от " + Формат(СтрокаТаблицыДанных.ДДУДата, "ДФ=dd.MM.yyyy");  		
		КонецЕсли;
		
		ОшибкаПроведения = Ложь;
				
		Попытка
			
			Поручение.Записать(РежимЗаписиДокумента.Проведение);
			
			Если ПоручениеНаВвод Тогда 
				ПорученияНаВвод_Проведены = ПорученияНаВвод_Проведены + ?(ПорученияНаВвод_Проведены = "", "", ", ") + СтрокаТаблицыДанных.НомерВходящегоДокумента + ?(СтрокаТаблицыДанных.ПоручениеНаПереводМеждуСчетамиДУ, " (перевод между счетами ДУ)", "");
			Иначе
				ПорученияНаВывод_Проведены = ПорученияНаВывод_Проведены + ?(ПорученияНаВывод_Проведены = "", "", ", ") + СтрокаТаблицыДанных.НомерВходящегоДокумента + ?(СтрокаТаблицыДанных.ПоручениеНаПереводМеждуСчетамиДУ, " (перевод между счетами ДУ)", "");
			КонецЕсли;
			
			ЗафиксироватьТекстУведомления(ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Поручение.Ссылка, Строка(Поручение) + " (Проведен)"), ТекстСообщенияПользователям,, ИмпортПорученийНаРегламенте);
			
			Если Не СтрокаТаблицыДанных.Обработан Тогда
				ОбработанныеФайлы.Добавить(Новый Структура("Имя, Путь", СтрокаТаблицыДанных.ИмяФайла, СтрокаТаблицыДанных.Каталог));
			КонецЕсли;
			
		Исключение
			
			ЗафиксироватьТекстУведомления("Не удалось провести поручение на " + ?(ПоручениеНаВвод, "ввод", "вывод") + " № " + СтрокаТаблицыДанных.НомерВходящегоДокумента + Символы.ПС + ОписаниеОшибки(), ТекстСообщенияПользователям,, ИмпортПорученийНаРегламенте);  
			ОшибкаПроведения = Истина;
			
		КонецПопытки;
		
		Если ОшибкаПроведения Тогда
			
			Попытка
				
				Поручение.Записать(РежимЗаписиДокумента.Запись);
			
				Если ПоручениеНаВвод Тогда 
					ПорученияНаВвод_Записаны = ПорученияНаВвод_Записаны + ?(ПорученияНаВвод_Записаны = "", "", ", ") + СтрокаТаблицыДанных.НомерВходящегоДокумента + ?(СтрокаТаблицыДанных.ПоручениеНаПереводМеждуСчетамиДУ, " (перевод между счетами ДУ)", "");
				Иначе
					ПорученияНаВывод_Записаны = ПорученияНаВывод_Записаны + ?(ПорученияНаВывод_Записаны = "", "", ", ") + СтрокаТаблицыДанных.НомерВходящегоДокумента + ?(СтрокаТаблицыДанных.ПоручениеНаПереводМеждуСчетамиДУ, " (перевод между счетами ДУ)", "");
				КонецЕсли;
				
				ЗафиксироватьТекстУведомления(ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Поручение.Ссылка, Строка(Поручение) + " (Записан)"), ТекстСообщенияПользователям,, ИмпортПорученийНаРегламенте); 	
				
			Исключение
				ЗафиксироватьТекстУведомления("Не удалось записать поручение на " + ?(ПоручениеНаВвод, "ввод", "вывод") + " № " + СтрокаТаблицыДанных.НомерВходящегоДокумента + Символы.ПС + ОписаниеОшибки(), ТекстСообщенияПользователям,, ИмпортПорученийНаРегламенте); 
			КонецПопытки;
						
		КонецЕсли;
		
	КонецЦикла;
	
	РаботаСФайламиКлиентСервер.ПеренестиОбработанныеФайлыВКаталог(ОбработанныеФайлы);
		
	Если ПорученияНаВвод_Записаны <> "" Или ПорученияНаВвод_Проведены <> "" Тогда  
		СтатистикаИмпортаПоручений.Вставить("ПорученияНаВводДС",  ?(ПорученияНаВвод_Записаны <> "", "Записаны: " + ПорученияНаВвод_Записаны, "") + ?(ПорученияНаВвод_Проведены <> "", "Проведены: " + ПорученияНаВвод_Проведены, ""));
	КонецЕсли;
	
	Если ПорученияНаВывод_Записаны  <> "" Или ПорученияНаВывод_Проведены <> "" Тогда
		СтатистикаИмпортаПоручений.Вставить("ПорученияНаВыводДС",  ?(ПорученияНаВывод_Записаны <> "", "Записаны: " + ПорученияНаВывод_Записаны, "") + ?(ПорученияНаВывод_Проведены <> "", "Проведены: " + ПорученияНаВывод_Проведены, ""));
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") И ТекстСообщенияПользователям <> "" Тогда
		
		ЗафиксироватьТекстУведомления("<table cols=""1""><tr class=""top""><td>Новые поручения</td></tr>", ТекстСообщенияПользователям, Истина, ИмпортПорученийНаРегламенте); 
		СформироватьОповещенияПользователям("Импорт поручений фонда. Уведомление о новых поручениях.", ТекстСообщенияПользователям);
		
	КонецЕсли;
	
КонецПроцедуры

