
////////////////////////////////////////////////////////////////////////////////
// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Импорт поручений фонда", "0.45", "", Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ИмпортироватьПорученияФонда", "Импортировать поручения фонда из ЭДО",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверитьСрокИсполненияПоручений", "Проверить срок исполнения поручений",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.ДатаФайлов         = ТекущаяДатаСеанса();
	ЭтотОбъект.ДатаЗагрузкиВСистему = ЭтотОбъект.ДатаФайлов; 
	
	Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ЭтотОбъект.ДатаФайлов) Тогда
		Возврат;	
	КонецЕсли;
	
	ЭтотОбъект.Организация  = ПараметрыКоманды.Организация; 
		
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Организация) Тогда
		ЗафиксироватьТекстУведомления("Не указан параметр [Организация]. Команда импорта поручений отклонена.");
	КонецЕсли;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		
		Если Найти(ИдентификаторКоманды, "ИмпортироватьПорученияФонда") = 1 Тогда
			
			ЭтотОбъект.ИмяКаталога = ПараметрыКоманды.ИмяКаталога;

			Если Не ЗначениеЗаполнено(ЭтотОбъект.ИмяКаталога) Тогда
				ЗафиксироватьТекстУведомления("Не указан параметр [Имя каталога]. Команда импорта поручений отклонена.");
			Иначе
				ИмпортироватьПорученияФонда();	
			КонецЕсли;	
				
		ИначеЕсли Найти(ИдентификаторКоманды, "ПроверитьСрокИсполненияПоручений") = 1 Тогда
			
			ПроверитьСрокИсполненияПоручений();
			
		Иначе
			ЗафиксироватьТекстУведомления("Для команды [" + ИдентификаторКоманды + "] не определены действия.");
		КонецЕсли;
		
	КонецЕсли;
	
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры

Процедура ИмпортироватьПорученияФонда(ТаблицаДанных = Неопределено) Экспорт
	
	Если Не ЭтотОбъект.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ИмпортПорученийНаРегламенте = ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник"); 
	
	//Начало сессии
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ИмпортироватьПорученияФонда()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаФайлов,Организация");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	СтатистикаИмпортаПоручений = Новый Структура();
	
	Если ИмпортПорученийНаРегламенте Тогда
		ТаблицаДанных = ПолучитьДанныеФайлов(Истина);
	КонецЕсли;
	
	Если ТаблицаДанных <> Неопределено Тогда			
		ЗагрузитьПоручения(ТаблицаДанных, ИмпортПорученийНаРегламенте, СтатистикаИмпортаПоручений);	
	КонецЕсли;
	
	//Конец сессии
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, СтатистикаИмпортаПоручений);
	
КонецПроцедуры

Процедура ПроверитьСрокИсполненияПоручений()
	
	//Начало сессии
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ПроверитьСрокИсполненияПоручений()";
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаФайлов,Организация");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ТекстСообщенияПользователям = "";
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДОБАВИТЬКДАТЕ(МИНИМУМ(ДанныеКалендаря.Дата), ДЕНЬ, -1) КАК ДатаПроверки
		|ПОМЕСТИТЬ _ДанныеКалендаря
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Дата > &ДатаПроверки
		|	И ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание КАК Поручение,
		|	ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ДатаИсполненияПо КАК ПоручениеДатаИсполненияПо,
		|	ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоДенежнымСредствамПоПоручениям.Остатки(, Организация = &Организация) КАК ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки
		|		ПО _ДанныеКалендаря.ДатаПроверки >= ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).ДатаИсполненияПо
		|		И ВЫРАЗИТЬ(ЗадолженностиПоДенежнымСредствамПоПоручениямОстатки.Основание КАК Документ.ПоручениеНаДвижениеДенежныхСредств).СпособПередачи <> ЗНАЧЕНИЕ(Перечисление.СпособыПередачиПоручений.ВнутренняяСистема) 
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоручениеНаДвижениеДенежныхСредств.Ссылка,
		|	ВЫБОР
		|		КОГДА ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ПоручениеНаДвижениеДенежныхСредств.Дата, ДЕНЬ), ДЕНЬ, 30)
		|		ИНАЧЕ ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо
		|	КОНЕЦ,
		|	ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления
		|ИЗ
		|	_ДанныеКалендаря КАК _ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоручениеНаДвижениеДенежныхСредств КАК ПоручениеНаДвижениеДенежныхСредств
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеЗадолженностейПоПоручению КАК СписаниеЗадолженностейПоПоручению
		|			ПО ПоручениеНаДвижениеДенежныхСредств.Ссылка = СписаниеЗадолженностейПоПоручению.Поручение
		|				И (СписаниеЗадолженностейПоПоручению.Проведен)
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления
		|			ИЗ
		|				РегистрНакопления.ОстаткиДенежныхСредств.Остатки(, Организация = &Организация) КАК ОстаткиДенежныхСредствОстатки
		|			ГДЕ
		|				ОстаткиДенежныхСредствОстатки.СуммаОстаток > 0
		|			
		|			ОБЪЕДИНИТЬ
		|			
		|			ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления
		|			ИЗ
		|				РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(, Организация = &Организация) КАК ОстаткиЦенныхБумагОстатки
		|			ГДЕ
		|				ОстаткиЦенныхБумагОстатки.КоличествоОстаток > 0) КАК ВложенныйЗапрос
		|			ПО ПоручениеНаДвижениеДенежныхСредств.СчетДоверительногоУправления = ВложенныйЗапрос.СчетДоверительногоУправления
		|		ПО (ВЫБОР
		|				КОГДА ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА _ДанныеКалендаря.ДатаПроверки >= ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(ПоручениеНаДвижениеДенежныхСредств.Дата, ДЕНЬ), ДЕНЬ, 30)
		|				ИНАЧЕ _ДанныеКалендаря.ДатаПроверки >= ПоручениеНаДвижениеДенежныхСредств.ДатаИсполненияПо
		|			КОНЕЦ)
		|			И (ПоручениеНаДвижениеДенежныхСредств.Проведен)
		|			И (ПоручениеНаДвижениеДенежныхСредств.Организация = &Организация)
		|			И (ПоручениеНаДвижениеДенежныхСредств.ВыводВсехАктивов)
		|ГДЕ
		|	СписаниеЗадолженностейПоПоручению.Ссылка ЕСТЬ NULL";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("ДатаПроверки", ЭтотОбъект.ДатаФайлов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщенияПользователям = "";
	
	Пока Выборка.Следующий() Цикл
		ЗафиксироватьТекстУведомления(Формат(Выборка.ПоручениеДатаИсполненияПо, "ДФ=dd.MM.yyyy") 
										+ "</td><td>" + Выборка.СчетДоверительногоУправления 
										+ "</td><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Поручение, Строка(Выборка.Поручение)), ТекстСообщенияПользователям,, Истина);	
	КонецЦикла;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") И ТекстСообщенияПользователям <> "" Тогда
		
		ЗафиксироватьТекстУведомления("<tr class=""top""><td>Дата исполнения</td><td>Счет доверительного управления</td><td>Поручение</td></tr>", ТекстСообщенияПользователям, Истина, Истина);
		ЗафиксироватьТекстУведомления("<table cols=""3""><tr class=""top""><td colspan=""3"">Перечень поручений с истекающим сроком исполнения</td></tr>", ТекстСообщенияПользователям, Истина, Истина);

		СформироватьОповещенияПользователям("Внимание! Истекает срок исполнения поручений!", ТекстСообщенияПользователям);
		
	КонецЕсли;
	
	//Конец сессии
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

Процедура ЗафиксироватьТекстУведомления(ТекстУведомления, Сообщение = Неопределено, ТекстВНачалоСообщения = Ложь, ИмпортПорученийНаРегламенте = Ложь)
		
	Если ИмпортПорученийНаРегламенте И Сообщение <> Неопределено Тогда
		
		ТекТекст = ?(СтрНачинаетсяС(ТекстУведомления, "<t"), ТекстУведомления, "<tr><td>" + ТекстУведомления + "</td></tr>"); 
		
		Если ТекстВНачалоСообщения Тогда
			Сообщение = ТекТекст + Сообщение;
		Иначе
			Сообщение = Сообщение + ТекТекст;
		КонецЕсли; 
		
	Иначе
	
		Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
		КонецЕсли;
		
		МассивСообщений = ПолучитьСообщенияПользователю(Истина);
		
		Если МассивСообщений.Количество() > 0 Тогда

			ТекТекст = ТекстУведомления + Символы.ПС + ". Сообщения пользователю:";
			
			Для Каждого ТекСообщение Из МассивСообщений Цикл
				
				Если ТекСообщение.Текст = "" Тогда
					Продолжить;
				Иначе
					ТекТекст = ТекТекст + Символы.ПС + ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных); 
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			ТекТекст = ТекстУведомления;                                  
		КонецЕсли;
		
	    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекТекст) = Неопределено Тогда    	
			ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекТекст);
		КонецЕсли;	
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках(ЕстьОшибки)Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
		КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры

Функция ПолучитьДанныеФайлов(ИмпортПорученийНаРегламенте = Ложь) Экспорт
	
	СообщениеОбОшибках = "";
	
	//На регламенте проверяем два дня, т.к. фонд может прислать поручения и за предыдущий день.
	Если ИмпортПорученийНаРегламенте Тогда
		
		Если ЭтотОбъект.ДатаФайлов = Дата(2022, 08, 12) Тогда
			//12.08.22 внесли изменения в схему. При работе на регламенте проверяются два дня (текущий и предыдущий),
			//Получилось, что при проверке файлов за предыдущий день (11.08.22) файлы не проходили проверку по новой схеме.
			//Добавил разовую заглушку.
			ПредыдущийРабочийДень = ЭтотОбъект.ДатаФайлов	
		Иначе
			ПредыдущийРабочийДень = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ЭтотОбъект.ДатаФайлов - (24 * 60 * 60), -1);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтотОбъект.ДатаФайлов < Дата(2022, 08, 12) Тогда
		Макет = ЭтотОбъект.ПолучитьМакет("Схема");	
	Иначе
		//В реквизитах получателя изменили имя элемента "Коррсчет" -> "КоррСчет".
		Макет = ЭтотОбъект.ПолучитьМакет("Схема_2");
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xsd");
	Макет.Записать(ИмяВременногоФайла);
	
	МассивСхемXSD = Новый Массив;
	МассивСхемXSD.Добавить(ИмяВременногоФайла);
	
	СвояФабрикаXDTO = СоздатьФабрикуXDTO(МассивСхемXSD);
	
	МассивФайлов = РаботаСФайламиКлиентСервер.ПолучитьФайлыДляОбработкиИзКаталога(ЭтотОбъект.ИмяКаталога, "*.xml", Не ИмпортПорученийНаРегламенте); 
	
	Если МассивФайлов = Неопределено Или МассивФайлов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	ТаблицаДанных = ПолучитьТаблицуЗначенийДляДанных();
	
	ЗамененныеФайлы = Новый Массив;
	
	Для Каждого ТекЭлемент Из МассивФайлов Цикл
		
		Файл = ТекЭлемент.Файл;
		
		Если Не (ИмпортПорученийНаРегламенте Или Лев(Файл.Имя, 8) = Формат(ЭтотОбъект.ДатаФайлов, "ДФ=yyyyMMdd")) Тогда
			Продолжить;
		КонецЕсли;
			 
		Если СтрНайти(НРег(Файл.ИмяБезРасширения), "замен") > 0 Тогда
			
			ИмяФайла = Файл.Имя;
			
			Если СтрНайти(ИмяФайла, "_замена") = 0 Тогда
				
				ЗафиксироватьТекстУведомления("Имя замененного файла [" + Файл.Имя + "] не соответствует формату: Дата_ВидПоручения_НомерПоручения_НомерДоговора_замена.xml", СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);	
				Продолжить;
				
			Иначе
				
				//Фонд может прислать исправленнные файлы. Необходимо оповестить пользователей о наличии измененных файлов.
				//После чего пользователи должны интерактивно загрузить изменения.
				ИмяЗамененногоФайла = СтрЗаменить(ИмяФайла, "_замена", ""); 
				ЗамененныеФайлы.Добавить(ИмяЗамененногоФайла);
				
			КонецЕсли;
			
		КонецЕсли;
					
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(Файл.ПолноеИмя);

		ТипXDTO = СвояФабрикаXDTO.Тип("1C_NPF_UK_Exchange", "NPFUKExchange");                                                                                            
		
		Попытка
			ОбъектXDTO = СвояФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ТипXDTO);
		Исключение
			
			ТекстОшибки = "Файл [" + Файл.ПолноеИмя + "] не соответствует схеме XSD. Поручение не будет загружено!" + Символы.ПС + ОписаниеОшибки();
			
			ЗафиксироватьТекстУведомления(ТекстОшибки, СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);			
			Продолжить;
			
		КонецПопытки;
		
		Если ОбъектXDTO.ВерсияФормата <> "1.01" Тогда
			ЗафиксироватьТекстУведомления("У файла [" + Файл.ПолноеИмя + "] версия формата [" + ОбъектXDTO.ВерсияФормата + "] не соответствует версии [1.01]. Поручение не будет загружено!", СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);
			Продолжить;
		КонецЕсли;
							
		Для Каждого Поручение Из ОбъектXDTO.СекцияДокумента Цикл
			
			Если Не (Поручение.Дата = ЭтотОбъект.ДатаФайлов Или ИмпортПорученийНаРегламенте И Поручение.Дата = ПредыдущийРабочийДень) Тогда
					 
				ЗафиксироватьТекстУведомления("Дата поручения [" + Формат(Поручение.Дата, "ДФ=dd.MM.yyyy") + "] в Файле [" + Файл.ПолноеИмя + "] не соответствует дате Т-1! Поручение не будет загружено!", СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);
				Продолжить;
				
			КонецЕсли;
									
			НоваяСтрока = ТаблицаДанных.Добавить();
			
			ФайлДокумент = Новый ТекстовыйДокумент;
			
			Попытка
				ФайлДокумент.Прочитать(Файл.ПолноеИмя);
			Исключение
				ЗафиксироватьТекстУведомления("Не удалось прочитать файл [" + Файл.ПолноеИмя + "]." + Символы.ПС + ОписаниеОшибки(), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);
				Возврат Неопределено;
			КонецПопытки;
			
			НоваяСтрока.ИмяФайла          = Файл.Имя; 
			НоваяСтрока.Каталог           = Файл.Путь;
			НоваяСтрока.Обработан         = ТекЭлемент.Обработан;
			НоваяСтрока.ФайлТекст         = ФайлДокумент.ПолучитьТекст();
			НоваяСтрока.ВидДокумента      = Поручение.ВидДокумента; 
			НоваяСтрока.НомерПоручения    = Поручение.Номер;
			НоваяСтрока.ДатаПоручения     = Поручение.Дата; 
			НоваяСтрока.СрокНачало        = ?(Поручение.СрокНачало < ЭтотОбъект.ДатаЗагрузкиВСистему, ЭтотОбъект.ДатаЗагрузкиВСистему, Поручение.СрокНачало);
			НоваяСтрока.СрокНачалоФакт    = Поручение.СрокНачало;
			НоваяСтрока.СрокОкончание     = Поручение.СрокОкончание;
			НоваяСтрока.Сумма             = Поручение.Сумма;
			НоваяСтрока.КодВалюты         = Поручение.КодВалюты;
			НоваяСтрока.НазначениеПлатежа = Поручение.НазначениеПлатежа;
			НоваяСтрока.ЗаменаФайла       = (СтрНайти(НРег(Файл.Имя), "_замена") > 0);
			
			//в поручение нужно записывать время создания файла
			Если ЭтотОбъект.ДатаЗагрузкиВСистему > Дата(2023, 02, 21) Тогда
				
				Попытка
					FileSO = Новый COMОбъект("Scripting.FileSystemObject");
					File = FileSO.GetFile(Файл.ПолноеИмя);
					НоваяСтрока.ВремяСозданияФайла = File.DateCreated;
				Исключение
					ЗафиксироватьТекстУведомления("Не удалось установить время получения поручения [" + Поручение.Номер + "]." + Символы.ПС + ОписаниеОшибки(), СообщениеОбОшибках,, ИмпортПорученийНаРегламенте);
				КонецПопытки; 
				
			КонецЕсли;
			
			Для Каждого Реквизит Из Поручение.РеквизитыОтправителя.Свойства() Цикл
				НоваяСтрока["Откуда" + Реквизит.Имя] = ?(Реквизит.Имя = "ДДУНомер", СтрЗаменить(Поручение.РеквизитыОтправителя[Реквизит.Имя], "№", ""), Поручение.РеквизитыОтправителя[Реквизит.Имя]);	
			КонецЦикла;
			
			Для Каждого Реквизит Из Поручение.РеквизитыПолучателя.Свойства() Цикл
				НоваяСтрока["Куда" + Реквизит.Имя] = ?(Реквизит.Имя = "ДДУНомер", СтрЗаменить(Поручение.РеквизитыПолучателя[Реквизит.Имя], "№", ""), Поручение.РеквизитыПолучателя[Реквизит.Имя]);		
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
		
	Если ТаблицаДанных.Количество() = 0 Тогда
		
		Если Не ИмпортПорученийНаРегламенте Тогда
			ЗафиксироватьТекстУведомления("В файлах отсутствуют поручения для загрузки на дату [" + Формат(ЭтотОбъект.ДатаФайлов, "ДФ=dd.MM.yyyy") + "].");
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаДанных.ИмяФайла КАК ИмяФайла,
		|	ТаблицаДанных.Обработан КАК Обработан,
		|	ТаблицаДанных.Каталог КАК Каталог,
		|	ТаблицаДанных.ВремяСозданияФайла КАК ВремяСозданияФайла,
		|	ТаблицаДанных.ФайлТекст КАК ФайлТекст,
		|	ТаблицаДанных.ЗаменаФайла КАК ЗаменаФайла,
		|	ТаблицаДанных.ВидДокумента КАК ВидДокумента,
		|	ТаблицаДанных.НомерПоручения КАК НомерПоручения,
		|	ТаблицаДанных.ДатаПоручения КАК ДатаПоручения,
		|	ТаблицаДанных.СрокНачало КАК СрокНачало,
		|	ТаблицаДанных.СрокНачалоФакт КАК СрокНачалоФакт,
		|	ТаблицаДанных.СрокОкончание КАК СрокОкончание,
		|	ТаблицаДанных.Сумма КАК Сумма,
		|	ТаблицаДанных.КодВалюты КАК КодВалюты,
		|	ТаблицаДанных.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ТаблицаДанных.ОткудаНаименование КАК ОткудаНаименование,
		|	ТаблицаДанных.ОткудаДДУНомер КАК ОткудаДДУНомер,
		|	ТаблицаДанных.ОткудаДДУДата КАК ОткудаДДУДата,
		|	ТаблицаДанных.ОткудаРасчСчет КАК ОткудаРасчСчет,
		|	ТаблицаДанных.ОткудаКоррСчет КАК ОткудаКоррСчет,
		|	ТаблицаДанных.ОткудаИНН КАК ОткудаИНН,
		|	ТаблицаДанных.ОткудаБанкНаименование КАК ОткудаБанкНаименование,
		|	ТаблицаДанных.ОткудаБИК КАК ОткудаБИК,
		|	ТаблицаДанных.ОткудаБанкГород КАК ОткудаБанкГород,
		|	ТаблицаДанных.КудаНаименование КАК КудаНаименование,
		|	ТаблицаДанных.КудаДДУНомер КАК КудаДДУНомер,
		|	ТаблицаДанных.КудаДДУДата КАК КудаДДУДата,
		|	ТаблицаДанных.КудаРасчСчет КАК КудаРасчСчет,
		|	ТаблицаДанных.КудаКоррСчет КАК КудаКоррСчет,
		|	ТаблицаДанных.КудаИНН КАК КудаИНН,
		|	ТаблицаДанных.КудаБанкНаименование КАК КудаБанкНаименование,
		|	ТаблицаДанных.КудаБИК КАК КудаБИК,
		|	ТаблицаДанных.КудаБанкГород КАК КудаБанкГород
		|ПОМЕСТИТЬ _ВнешниеДанные
		|ИЗ
		|	&ТаблицаДанных КАК ТаблицаДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВнешниеДанные.КодВалюты КАК Код,
		|	Валюты.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _Валюты
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
		|		ПО _ВнешниеДанные.КодВалюты = Валюты.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.НомерПоручения КАК НомерПоручения,
		|	ВложенныйЗапрос.ИмяФайла КАК ИмяФайла,
		|	ВложенныйЗапрос.ВидДокумента КАК ВидДокумента,
		|	ВложенныйЗапрос.Направление КАК Направление,
		|	ВложенныйЗапрос.ДДУНомер КАК ДДУНомер,
		|	ВложенныйЗапрос.ДДУДата КАК ДДУДата,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторженияДоговора,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _СчетаДУ
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ВнешниеДанные.НомерПоручения КАК НомерПоручения,
		|		_ВнешниеДанные.ИмяФайла КАК ИмяФайла,
		|		_ВнешниеДанные.ВидДокумента КАК ВидДокумента,
		|		_ВнешниеДанные.ОткудаДДУНомер КАК ДДУНомер,
		|		_ВнешниеДанные.ОткудаДДУДата КАК ДДУДата,
		|		""Откуда"" КАК Направление
		|	ИЗ
		|		_ВнешниеДанные КАК _ВнешниеДанные
		|	ГДЕ
		|		_ВнешниеДанные.ОткудаДДУНомер <> """"
		|		И _ВнешниеДанные.ОткудаДДУДата <> ДАТАВРЕМЯ(1, 1, 1)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ВнешниеДанные.НомерПоручения,
		|		_ВнешниеДанные.ИмяФайла,
		|		_ВнешниеДанные.ВидДокумента,
		|		_ВнешниеДанные.КудаДДУНомер,
		|		_ВнешниеДанные.КудаДДУДата,
		|		""Куда""
		|	ИЗ
		|		_ВнешниеДанные КАК _ВнешниеДанные
		|	ГДЕ
		|		_ВнешниеДанные.КудаДДУНомер <> """"
		|		И _ВнешниеДанные.КудаДДУДата <> ДАТАВРЕМЯ(1, 1, 1)) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаФайлов, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ПО ВложенныйЗапрос.ДДУНомер = СчетаДоверительногоУправления.НомерДоговора
		|			И ВложенныйЗапрос.ДДУДата = СчетаДоверительногоУправления.ДатаЗаключения
		|			И (СчетаДоверительногоУправления.Организация = &Организация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СчетаДУ.НомерПоручения КАК НомерПоручения,
		|	_СчетаДУ.ИмяФайла КАК ИмяФайла,
		|	_СчетаДУ.Направление КАК Направление,
		|	_СчетаДУ.ДДУНомер КАК ДДУНомер,
		|	_СчетаДУ.ДДУДата КАК ДДУДата,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта КАК Валюта,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта.Код КАК КодВалюты,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.НомерСчета КАК НомерСчета,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.Код КАК БИК,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументов
		|ПОМЕСТИТЬ _ВсеИсполнителиПоДС
		|ИЗ
		|	_СчетаДУ КАК _СчетаДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО _СчетаДУ.СчетДоверительногоУправления = ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления
