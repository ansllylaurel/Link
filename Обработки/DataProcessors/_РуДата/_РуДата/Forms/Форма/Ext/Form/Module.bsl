	ИначеЕсли ЭтаФорма.ВидЦен = "Mifid" Тогда
		ИдентификаторПлощадки = 222;	
	ИначеЕсли ЭтаФорма.ВидЦен = "RUDIP" Тогда
		ИдентификаторПлощадки = 193;	
	Иначе
