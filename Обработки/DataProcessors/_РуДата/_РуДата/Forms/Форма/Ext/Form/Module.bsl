
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	ЭтаФорма.Сервер	= "dh2.efir-net.ru";	
	ЭтаФорма.Логин	= "region-api-test1";
	ЭтаФорма.Пароль	= "Rg7y6w1";
	
	ЭтаФорма.Дата			= ТекущаяДата();
	ЭтаФорма.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.ВидЦен			= "TRAX";
	
	СтрокаОтбораЦен = Элементы.ОтборЦен.СписокВыбора.НайтиПоЗначению("");
	Если СтрокаОтбораЦен <> Неопределено Тогда
		Элементы.ОтборЦен.СписокВыбора.Удалить(СтрокаОтбораЦен);	
	КонецЕсли;
	
	//Для каждого Элемент Из Элементы.ВидЦен.СписокВыбора Цикл
	//	ЗаполнитьЗначенияСвойств(ПолныйСписокВидаЦен.Добавить(), Элемент);
	//КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	ОбновитьВидимостьДоступность(ЭтаФорма);	

	ТекущийОтборЦен	= ЭтаФорма.ОтборЦен;
	ТекущийВидЦен	= ЭтаФорма.ВидЦен;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если ЭтаФорма.ТекущаяКоманда = Команды.ПолучитьНКД.Имя Тогда
		
		ПроверяемыеРеквизиты.Добавить("Облигация");
		
	ИначеЕсли ЭтаФорма.ТекущаяКоманда = Команды.ПолучитьЦены.Имя Тогда 	
		
		Если ЭтаФорма.ОтборЦен = "ПоЦеннойБумаге" Тогда
			
			ПроверяемыеРеквизиты.Добавить("ЦеннаяБумага");
			
		ИначеЕсли ЭтаФорма.ОтборЦен = "ПоСчетуДоверительногоУправления" Тогда
			
			ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
		
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЦенПриИзменении(Элемент)

	Если (ЭтаФорма.ОтборЦен = "ПоСчетуДоверительногоУправления" ИЛИ ЭтаФорма.ОтборЦен = "ПоЦеннойБумаге" И ЭтаФорма.ВидЦен = "")
		<> (ТекущийОтборЦен = "ПоСчетуДоверительногоУправления" ИЛИ ТекущийОтборЦен = "ПоЦеннойБумаге" И ЭтаФорма.ВидЦен = "")
	Тогда
		ЭтаФорма.ПоляЦен.Очистить();
	КонецЕсли;
	
	ОбновитьВидимостьДоступность(ЭтаФорма);	
	
	//Если Элементы.ВидЦен.СписокВыбора.НайтиПоЗначению(ЭтаФорма.ВидЦен) = Неопределено Тогда
	//	ЭтаФорма.ВидЦен = Элементы.ВидЦен.СписокВыбора.Получить(0);	
	//КонецЕсли;
	
	ТекущийОтборЦен = ЭтаФорма.ОтборЦен;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЦенПриИзменении(Элемент)
	
	Если ЭтаФорма.ОтборЦен = "ПоЦеннойБумаге"
		И ЗначениеЗаполнено(ЭтаФорма.ВидЦен) <> ЗначениеЗаполнено(ТекущийВидЦен)
	Тогда
		ЭтаФорма.ПоляЦен.Очистить();
	КонецЕсли;
	
	ОбновитьВидимостьДоступность(ЭтаФорма);	
	
	ТекущийВидЦен = ЭтаФорма.ВидЦен;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
