	//	Если ЗначениеЗаполнено(Элемент.Значение) ИЛИ ЭтаФорма.ОтборЦен <> "ПоЦеннойБумаге" Тогда
	//		ЗаполнитьЗначенияСвойств(Элементы.ВидЦен.СписокВыбора.Добавить(), Элемент);
	//	КонецЕсли;
	//КонецЦикла;
	
КонецПроцедуры

