		Для Каждого СтрокаПоля Из ЭтаФорма.ПоляЦен Цикл
			Если СтрокаПоля.Отметка Тогда
				ОтборПолей.Добавить(СтрокаПоля.Поле);
				ПорядокПолей.Вставить(СтрокаПоля.Поле, СтрокаПоля.Поле);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("tradeSite",	ИдентификаторПлощадки);
	ПараметрыЗапроса.Вставить("isin",		ПолучитьISIN(ЭтаФорма.ЦеннаяБумага));
	ПараметрыЗапроса.Вставить("date",		Формат(ЭтаФорма.Дата, "ДФ=yyyy-MM-dd"));
	//ПараметрыЗапроса.Вставить("issId",	0);
	//ПараметрыЗапроса.Вставить("dateType",	"ACTUAL");
	ПараметрыЗапроса.Вставить("official",	ЭтаФорма.ОфициальныеИтоги);
	//ПараметрыЗапроса.Вставить("fields",		ОтборПолей);
	
	РезультатЗапроса = ОбъектРудата.ДанныеПоРезультатамТоргов(ЭтаФорма.Сервер, ПараметрыЗапроса, ОписаниеРезультата);
	
