&НаКлиенте
Процедура ВыполнитьПолучениеНКД(Команда, ПараметрыСессии)
	
	ЭтаФорма.ТекущаяКоманда = Команда.Имя;
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ТекстОшибки = "Не пройдена проверка заполнения реквизитов";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Купон = ПолучитьНКДНаСервере();
	Если ЭтаФорма.Купон = Неопределено Тогда
		ТекстОшибки = "Не удалось получить НКД";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНКДНаСервере()
	
	ОбъектРудата = РеквизитФормыВЗначение("Объект");
	ОбъектРудата.ПолучитьТокен(ЭтаФорма.Сервер, ЭтаФорма.Логин, ЭтаФорма.Пароль);
	
	//ПараметрыИстории = Новый Структура;
	//ПараметрыИстории.Вставить("engine", "stock");
	//ПараметрыИстории.Вставить("market", "shares");
	//ПараметрыИстории.Вставить("boardid", ОбъектРудата.МассивЗначений("TQBR"));
	//ПараметрыИстории.Вставить("instruments", ОбъектРудата.МассивЗначений("SBER"));
	//ПараметрыИстории.Вставить("dateFrom", '2021-01-10');
	//ПараметрыИстории.Вставить("dateTo", '2021-01-15');

	//ИсторияСбербанк = ОбъектРудата.История(ПараметрыИстории);	
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("filter", "isin='" + ПолучитьISIN(ЭтотОбъект.Облигация) + "'");
	ПараметрыДанных.Вставить("parameters", ОбъектРудата.МассивЗначений(""));
	ПараметрыДанных.Вставить("count", 1);
	ПараметрыДанных.Вставить("pageNum", 0);
	ПараметрыДанных.Вставить("pageSize", 0);
	
	ДанныеИнструмента = ОбъектРудата.ДанныеИнструмента(ЭтаФорма.Сервер, ПараметрыДанных);	
	Если ДанныеИнструмента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ИД = ДанныеИнструмента[0].fintoolId;
	
	ПараметрыНКД = Новый Структура;
	ПараметрыНКД.Вставить("fintoolIds", ОбъектРудата.МассивЗначений(ИД));
	ПараметрыНКД.Вставить("cashFlowCalcDate", Формат(ЭтотОбъект.Дата, "ДФ=yyyy-MM-dd"));
	ПараметрыНКД.Вставить("shiftDays", 0);
	ПараметрыНКД.Вставить("shiftTypeSource", 0);
	ПараметрыНКД.Вставить("typeCurrency", "");
	ПараметрыНКД.Вставить("useRounding", Истина);
	
	ДанныеНКД = ОбъектРудата.ДанныеНКД(ЭтаФорма.Сервер, ПараметрыНКД);
	
	Возврат ДанныеНКД[0].accruedInterest;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьISIN(Облигация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(
		|			,
		|			ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)
		|				И Объект = &Облигация) КАК КодыВТорговыхСистемахСрезПоследних";
	
	Запрос.УстановитьПараметр("Облигация", Облигация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Код;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область Получение_цен

&НаКлиенте
Процедура ПолучитьЦены(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПолучитьЦены");
	ВыполнитьПолучениеЦен(Команда, ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПолучениеЦен(Команда, ПараметрыСессии)

	ЭтаФорма.ТекущаяКоманда = Команда.Имя;
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ТекстОшибки = "Не пройдена проверка заполнения реквизитов";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = ПолучитьЦеныНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦеныНаСервере()
	
	РезультатЗапросаЦен.Очистить();
	ОписаниеРезультата = Новый СписокЗначений;
	ПорядокПолей = Неопределено;
	
	ОбъектРудата = РеквизитФормыВЗначение("Объект");
	ОбъектРудата.ПолучитьТокен(ЭтаФорма.Сервер, ЭтаФорма.Логин, ЭтаФорма.Пароль); 
	
	Если ЭтаФорма.ОтборЦен = "" ИЛИ ЭтаФорма.ОтборЦен = "ПоСчетуДоверительногоУправления" Тогда
		
		КодыИнструментов = Неопределено;
		
		Если ЭтаФорма.ОтборЦен = "ПоСчетуДоверительногоУправления" Тогда
			
			#Область Запрос_бумаг_из_портфеля
			
			// Идентификаторы инструментов: ISIN или регистрационный номер (RegCode) или код НРД (NRDCode);
			
			Запрос = Новый Запрос(
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага
				|ПОМЕСТИТЬ _ОстаткиЦенныхБумаг
				|ИЗ
				|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
				|			&Период,
				|			Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиЦенныхБумагОстатки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	_ОстаткиЦенныхБумаг.ЦеннаяБумага КАК ЦеннаяБумага,
				|	ЕСТЬNULL(КодыISIN.Код, _ОстаткиЦенныхБумаг.ЦеннаяБумага.ГосударственныйРегистрационныйНомер) КАК Код
				|ИЗ
				|	_ОстаткиЦенныхБумаг КАК _ОстаткиЦенныхБумаг
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыISIN
				|		ПО (КодыISIN.Объект = _ОстаткиЦенныхБумаг.ЦеннаяБумага)
				|
				|УПОРЯДОЧИТЬ ПО
				|	ВЫБОР
				|		КОГДА _ОстаткиЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Облигации
				|				И ВЫРАЗИТЬ(_ОстаткиЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации).Категория = ЗНАЧЕНИЕ(Перечисление.КатегорииОблигаций.Еврооблигация)
				|			ТОГДА 0
				|		ИНАЧЕ 1
				|	КОНЕЦ");
			
			#КонецОбласти
			
			Запрос.УстановитьПараметр("Период",							КонецДня(ЭтаФорма.Дата));
			Запрос.УстановитьПараметр("Организация",					ЭтаФорма.Организация);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтаФорма.СчетДоверительногоУправления);
			
			КодыИнструментов = Запрос.Выполнить().Выгрузить();
			
		КонецЕсли;
		
		РезультатЗапроса = ДанныеПоИтогамТорговПоИнструментам(ОбъектРудата, КодыИнструментов, ОписаниеРезультата, ПорядокПолей);		
		
	ИначеЕсли ЭтаФорма.ОтборЦен = "ПоЦеннойБумаге" Тогда
		
		Если ЭтаФорма.ВидЦен = "" Тогда
			
			КодыИнструментов = Новый ТаблицаЗначений;
			КодыИнструментов.Колонки.Добавить("ЦеннаяБумага");
			КодыИнструментов.Колонки.Добавить("Код");
			
			ЗаполнитьЗначенияСвойств(КодыИнструментов.Добавить(),
				Новый Структура("ЦеннаяБумага, Код", ЭтаФорма.ЦеннаяБумага, ПолучитьISIN(ЭтаФорма.ЦеннаяБумага)));
			
			РезультатЗапроса = ДанныеПоИтогамТорговПоИнструментам(ОбъектРудата, КодыИнструментов, ОписаниеРезультата, ПорядокПолей); 
			
		ИначеЕсли ЭтаФорма.Шаг = "" Тогда
			
			РезультатЗапроса = ДанныеПоРезультатамТоргов(ОбъектРудата, ОписаниеРезультата, ПорядокПолей); 
			
		Иначе
			
			РезультатЗапроса = ДанныеОТоргах(ОбъектРудата, ОписаниеРезультата, ПорядокПолей);
			
		КонецЕсли;
		
	Иначе
		ТекстОшибки = СтрШаблон("Неизвестный отбор цен: '%1'", ЭтаФорма.ОтборЦен);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки); 
		Возврат ТекстОшибки;
	КонецЕсли;
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат "Не удалось получить цены";
	КонецЕсли;
	
	ЗаполнитьЦенныеБумагиВРезультатеЗапроса(РезультатЗапроса, ПорядокПолей, КодыИнструментов); 
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("", , , РезультатЗапросаЦен); 
	
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, РезультатЗапроса, ПорядокПолей, , , Истина); 
	
	// Отладочная штука
	ОбластьЗамены = РезультатЗапросаЦен.НайтиТекст("<Неопределено>", , , , Истина);
	Пока ОбластьЗамены <> Неопределено Цикл
		ОбластьЗамены.Текст = "";
		ОбластьЗамены = РезультатЗапросаЦен.НайтиТекст("<Неопределено>", ОбластьЗамены, , , Истина);
	КонецЦикла;
	// Конец отладочной штуки
	
	РезультатЗапросаЦен.ФиксацияСверху = 1;
	
	Для каждого СтрокаОписания Из ОписаниеРезультата Цикл
		Если ЭтаФорма.ПоляЦен.НайтиСтроки(Новый Структура("Поле", СтрокаОписания.Значение)).Количество() = 0 Тогда
			СтрокаПоля = ЭтаФорма.ПоляЦен.Добавить();
			СтрокаПоля.Поле		= СтрокаОписания.Значение;
			СтрокаПоля.Описание	= СтрокаОписания.Представление;
			СтрокаПоля.Отметка	= Истина;		
		КонецЕсли;	
	КонецЦикла; 
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ДанныеОТоргах(ОбъектРудата, ОписаниеРезультата, ПорядокПолей = Неопределено)
	
	// Параметры метода
	
	// issId		integer(int64)		Идентификатор инструмента
	// isin			string				ISIN
	// dateFrom		string(date-time)	Обязательный параметр. Дата начала периода
	// dateTo		string(date-time)	Обязательный параметр. Дата окончания периода
	// step			string				Обязательный параметр. Шаг 5 – 5-минутки; 30 – получасовики; 60 – часовики; 1440 – EndOfDay
	// rowNum		integer(int32)		Макимальное возвращаемое количество записей.
	// fields		string[]			Список кодовых наименований полей, колонка name из выходной таблицы метода /Info/Fields. По умолчанию выводятся все доступные поля.
	// official		boolean				Запрос официальных итогов: 1 – запрашивать официальные итоги
	// sort			string				Сортировка по указанному полю, в виде FIELD=[A
	// tradeSite	string				Идентификатор ID из справочника «Торговые площадки» или код режима торгов МБ. Используется для уточнения указанного Isin
	
	Если ЭтаФорма.ВидЦен = "TRAX" Тогда
		ИдентификаторПлощадки = 192;	
	ИначеЕсли ЭтаФорма.ВидЦен = "Mifid" Тогда
		ИдентификаторПлощадки = 222;	
	ИначеЕсли ЭтаФорма.ВидЦен = "RUDIP" Тогда
		ИдентификаторПлощадки = 193;	
	ИначеЕсли ЭтаФорма.ВидЦен = "" И ЭтаФорма.ОтборЦен <> "ПоЦеннойБумаге" Тогда
		ИдентификаторПлощадки = Неопределено;		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Некорректный вид цен: '%1'", ЭтаФорма.ВидЦен)); 
		Возврат Неопределено;
	КонецЕсли; 
	
	ОтборПолей = Новый Массив;
	
	Если ЭтаФорма.ПоляЦен.Количество() > 0 Тогда
		
		ПорядокПолей = Новый Структура;
		
		Для Каждого СтрокаПоля Из ЭтаФорма.ПоляЦен Цикл
			Если СтрокаПоля.Отметка Тогда
				ОтборПолей.Добавить(СтрокаПоля.Поле);
				ПорядокПолей.Вставить(СтрокаПоля.Поле, СтрокаПоля.Поле);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("tradeSite",	ИдентификаторПлощадки);
	ПараметрыЗапроса.Вставить("isin",		ПолучитьISIN(ЭтаФорма.ЦеннаяБумага));
	ПараметрыЗапроса.Вставить("dateFrom",	Формат(ЭтаФорма.Дата, "ДФ=yyyy-MM-dd"));
	ПараметрыЗапроса.Вставить("dateTo",		Формат(ЭтаФорма.Дата, "ДФ=yyyy-MM-dd"));
	ПараметрыЗапроса.Вставить("step",		ЭтаФорма.Шаг);
	ПараметрыЗапроса.Вставить("official",	ЭтаФорма.ОфициальныеИтоги);
	//ПараметрыЗапроса.Вставить("fields",		ОтборПолей);
	
	РезультатЗапроса = ОбъектРудата.ДанныеОТоргах(ЭтаФорма.Сервер, ПараметрыЗапроса, ОписаниеРезультата);
	
	Возврат РезультатЗапроса;
	
КонецФункции

&НаСервере
Функция ДанныеПоРезультатамТоргов(ОбъектРудата, ОписаниеРезультата, ПорядокПолей = Неопределено)
	
