КонецФункции

&НаСервере
Функция ДанныеПоИтогамТорговПоИнструментам(ОбъектРудата, КодыИнструментов = Неопределено, ОписаниеРезультата, ПорядокПолей = Неопределено)
	
	РезультатФункции = Неопределено;
	
	// Параметры метода
	
	// codes		string[]			Идентификаторы инструментов: ISIN или регистрационный номер (RegCode) или код НРД (NRDCode); Максимальное количество элементов: 20
	// fintoolIds	integer[]			Числовые идентификаторы в базе Интерфакс; если заданы и Codes и FintoolIds - используется FintoolIds; Максимальное количество элементов: 20
	// tradeSites	integer[]			Список торговых площадок, ID из справочника «Торговые площадки»;
	// boardIds		string[]			Список boardID для MOEX
	// dateFrom		string(date-time)	Дата начала периода; умолчание - вчера;
	// dateTo		string(date-time)	Дата окончания периода; умолчание - вчера;
	// fields		string[]			Обязательный, список кодовых наименований полей, колонка name из выходной таблицы метода /Info/Fields;
	// official		boolean				Флаг официальных итогов
	
	Если ЭтаФорма.ВидЦен = "TRAX" Тогда
		ИдентификаторыПлощадки = РаботаСКоллекциями.ЗначениеВМассив(192);	
	ИначеЕсли ЭтаФорма.ВидЦен = "Mifid" Тогда
		ИдентификаторыПлощадки = РаботаСКоллекциями.ЗначениеВМассив(222);	
	ИначеЕсли ЭтаФорма.ВидЦен = "RUDIP" Тогда
		ИдентификаторыПлощадки = РаботаСКоллекциями.ЗначениеВМассив(193);	
	ИначеЕсли ЭтаФорма.ВидЦен = "" Тогда
		ИдентификаторыПлощадки = Новый Массив;		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Некорректный вид цен: '%1'", ЭтаФорма.ВидЦен)); 
		Возврат Неопределено;
	КонецЕсли; 
	
	ОтборПолей = ОбъектРудата.ПолучитьОписаниеРезультатаЗапросаДанныхПоИтогамТорговПоИнструментам().ВыгрузитьЗначения();
	
	Если ЭтаФорма.ПоляЦен.Количество() > 0 Тогда
		
		ПорядокПолей = Новый Структура;
		
		Для Каждого СтрокаПоля Из ЭтаФорма.ПоляЦен Цикл
			Если СтрокаПоля.Отметка Тогда
				ОтборПолей.Добавить(СтрокаПоля.Поле);
				ПорядокПолей.Вставить(СтрокаПоля.Поле, СтрокаПоля.Поле);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

	ВсеКоды = ?(КодыИнструментов = Неопределено, Новый Массив, КодыИнструментов.ВыгрузитьКолонку("Код"));
	
	КоличествоЗапросов = Макс(Окр(ВсеКоды.Количество() / 20 + 0.5, 0, РежимОкругления.Окр15как10), 1); 
	
	Для НомерЗапроса = 1 По КоличествоЗапросов Цикл
		
		Коды = Новый Массив;
		
		Если ВсеКоды.Количество() > 0 Тогда
			Для НомерКода = (НомерЗапроса - 1) * 20 По Мин(НомерЗапроса * 20 - 1, ВсеКоды.ВГраница()) Цикл
				Коды.Добавить(ВсеКоды[НомерКода]);		
			КонецЦикла;
		КонецЕсли;
		
		ПараметрыЗапроса = Новый Структура;
		ПараметрыЗапроса.Вставить("tradeSites",	ИдентификаторыПлощадки);
		//ПараметрыЗапроса.Вставить("fintoolIds",	?(КодыИнструментов = Неопределено, Новый Массив, ИдентификаторыИнструментов(ОбъектРудата, КодыИнструментов)));
		//ПараметрыЗапроса.Вставить("codes",		?(КодыИнструментов = Неопределено, Новый Массив, КодыИнструментов.ВыгрузитьКолонку("Код")));
		ПараметрыЗапроса.Вставить("codes",		Коды);
		ПараметрыЗапроса.Вставить("dateFrom",	Формат(ЭтаФорма.Дата, "ДФ=yyyy-MM-dd"));
		ПараметрыЗапроса.Вставить("dateTo",		Формат(ЭтаФорма.Дата, "ДФ=yyyy-MM-dd"));
		ПараметрыЗапроса.Вставить("official",	ЭтаФорма.ОфициальныеИтоги);
		ПараметрыЗапроса.Вставить("fields",		ОтборПолей);
		
		РезультатЗапроса = ОбъектРудата.ДанныеПоИтогамТорговПоИнструментам(ЭтаФорма.Сервер, ПараметрыЗапроса, ОписаниеРезультата);
		
		Если РезультатФункции = Неопределено Тогда
			РезультатФункции = РезультатЗапроса;
		Иначе
			Для каждого КолонкаИсточник Из РезультатЗапроса.Колонки Цикл
				Если РезультатФункции.Колонки.Найти(КолонкаИсточник.Имя) = Неопределено Тогда
					РезультатФункции.Колонки.Добавить(КолонкаИсточник.Имя, КолонкаИсточник.Тип);		
				КонецЕсли;			
			КонецЦикла; 
			
			РаботаСКоллекциями.ТаблицаЗначений_Дополнить(РезультатЗапроса, РезультатФункции);
		КонецЕсли;
		
	КонецЦикла;  
	
	Возврат РезультатФункции;
	
КонецФункции

&НаСервере
Функция ИдентификаторыИнструментов(ОбъектРудата, КодыИнструментов)
		
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("filter",		"isin in ('" + СтрСоединить(КодыИнструментов, "', '") + "')");
	//ПараметрыДанных.Вставить("parameters",	Новый Массив);
	//ПараметрыДанных.Вставить("count",		КодыИнструментов.Количество());
	//ПараметрыДанных.Вставить("pageNum",	0);
	//ПараметрыДанных.Вставить("pageSize",	0);
	
	ДанныеИнструмента = ОбъектРудата.ДанныеИнструмента(ЭтаФорма.Сервер, ПараметрыДанных);	
	Если ДанныеИнструмента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ДанныеИнструмента.Свернуть("fintoolId");
	
	Возврат ДанныеИнструмента.ВыгрузитьКолонку("fintoolId");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЦенныеБумагиВРезультатеЗапроса(РезультатЗапроса, ПорядокПолей, Знач КодыИнструментов, Знач ПоляКода = "isin, seccode")
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПорядокПолей <> Неопределено Тогда
		НовыйПорядокПолей = Новый Структура("ЦеннаяБумага", "Ценная бумага");
		РаботаСКоллекциями.ДополнитьСтруктуру(НовыйПорядокПолей, ПорядокПолей, Истина);		
		ПорядокПолей = НовыйПорядокПолей;
	КонецЕсли;
	
	ПоляКода = СтрРазделить(ПоляКода, ", ", Ложь);
	
	Если КодыИнструментов = Неопределено Тогда
		
		Коды = Новый Массив;
		
		Для каждого ПолеКода Из ПоляКода Цикл
			КодыВрем = РезультатЗапроса.ВыгрузитьКолонку(ПолеКода);	
			РаботаСКоллекциями.ДополнитьМассив(Коды, КодыВрем, Истина);
		КонецЦикла;
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыISIN.Объект КАК ЦеннаяБумага,
			|	КодыISIN.Код КАК Код
			|ИЗ
			|	РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыISIN
			|ГДЕ
			|	КодыISIN.Код В(&Коды)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Облигации.Ссылка,
			|	Облигации.ГосударственныйРегистрационныйНомер
			|ИЗ
			|	Справочник.Облигации КАК Облигации
			|ГДЕ
			|	Облигации.ГосударственныйРегистрационныйНомер В(&Коды)");
		
		Запрос.УстановитьПараметр("Период",	КонецДня(ЭтаФорма.Дата));
		Запрос.УстановитьПараметр("Коды",	Коды);
		
		КодыИнструментов = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	КодыИнструментов.Индексы.Добавить("Код");
	
	РезультатЗапроса.Колонки.Вставить(0, "ЦеннаяБумага");
	
	Для каждого СтрокаРезультата Из РезультатЗапроса Цикл
		Для Каждого ПолеКода Из ПоляКода Цикл
			Если ЗначениеЗаполнено(СтрокаРезультата[ПолеКода]) Тогда
				СтрокаИнструмента = КодыИнструментов.Найти(СтрокаРезультата[ПолеКода], "Код");
				Если СтрокаИнструмента <> Неопределено Тогда
					СтрокаРезультата.ЦеннаяБумага = СтрокаИнструмента.ЦеннаяБумага;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла; 
	
	РезультатЗапроса.Сортировать("ЦеннаяБумага", Новый СравнениеЗначений);
	
КонецПроцедуры

#КонецОбласти

#Область Получение_торговых_площадок

&НаКлиенте
Процедура ПолучитьТорговыеПлощадки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПолучитьТорговыеПлощадки");
	ВыполнитьПолучениеТорговыхПлощадок(Команда, ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПолучениеТорговыхПлощадок(Команда, ПараметрыСессии)

	ЭтаФорма.ТекущаяКоманда = Команда.Имя;
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ТекстОшибки = "Не пройдена проверка заполнения реквизитов";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = ПолучитьТорговыеПлощадкиНаСервере();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТорговыеПлощадкиНаСервере()
	
	ДокументРезультат.Очистить();
	
	ОбъектРудата = РеквизитФормыВЗначение("Объект");
	ОбъектРудата.ПолучитьТокен(ЭтаФорма.Сервер, ЭтаФорма.Логин, ЭтаФорма.Пароль); 
	
	РезультатЗапроса = ОбъектРудата.ТорговыеПлощадки(ЭтаФорма.Сервер);
	
	Если РезультатЗапроса = Неопределено Тогда
		Возврат "Не удалось получить торговые площадки";
	КонецЕсли;
	
	Если РезультатЗапроса.Колонки.Найти("id") <> Неопределено Тогда
		РезультатЗапроса.Сортировать("id", Новый СравнениеЗначений);	
	КонецЕсли;
	
	ПараметрыВывода = РаботаСОтчетами.ПодготовитьПараметрыВыводаТаблицыЗначенийВТабличныйДокумент("", , , ДокументРезультат); 
	ПараметрыВывода.Вставить("СобственныйФорматСтрок", Истина);
	
	РаботаСОтчетами.ВывестиТаблицуЗначенийВТабличныйДокумент(ПараметрыВывода, РезультатЗапроса, , , , Истина); 
	
	// Отладочная штука
	ОбластьЗамены = ДокументРезультат.НайтиТекст("<Неопределено>", , , , Истина);
	Пока ОбластьЗамены <> Неопределено Цикл
		ОбластьЗамены.Текст = "";
		ОбластьЗамены = ДокументРезультат.НайтиТекст("<Неопределено>", ОбластьЗамены, , , Истина);
	КонецЦикла;
	// Конец отладочной штуки
	
	ДокументРезультат.ФиксацияСверху = 1;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервереБезКонтекста
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,
		Новый Структура("ТекстОшибки", ТекстОшибки));

КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)

	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		РеквизитФормыВЗначение("Объект"), ИмяКоманды);

КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия);

КонецПроцедуры

#КонецОбласти
