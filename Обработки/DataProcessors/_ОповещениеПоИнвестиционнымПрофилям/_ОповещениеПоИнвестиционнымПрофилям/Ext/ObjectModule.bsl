#Область ПрограммныйИнтерфейс

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Оповещение по инвестиционным профилям",
		"0.08",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОповещениеПоИнвестиционнымПрофилям", "Оповещение по инвестиционным профилям",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Период		= НачалоДня(ТекущаяДата()); 
	Организация	= ПараметрыКоманды.Организация;
	Получатели	= ПараметрыКоманды.Получатели;
	
	Если Найти(ИдентификаторКоманды, "ОповещениеПоИнвестиционнымПрофилям") = 1  Тогда
		ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды);
		СформироватьИОтправитьОповещениеПоИнвестиционнымПрофилям(Получатели, ПараметрыСессии);
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьКоманду

Процедура СформироватьИОтправитьОповещениеПоИнвестиционнымПрофилям(Получатели, ПараметрыСессии = Неопределено) Экспорт
	
	Оповещение = СформироватьОповещение();
	
	Если Оповещение <> Неопределено Тогда
		ОтправитьПисьмо(Оповещение, Получатели, ПараметрыСессии);
	КонецЕсли;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Функция СформироватьОповещение() Экспорт
	
	Макет = ПолучитьМакет("Макет");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("Период",			Период);
	Запрос.УстановитьПараметр("Организация",	Организация);
	
	ВыборкаТипы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаТипы.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Результат = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Пока ВыборкаТипы.Следующий() Цикл
		
		Если ВыборкаТипы.Тип = 0 Тогда
			Заголовок	= Макет.ПолучитьОбласть("ЗаголовокОтсутствие");
			Строка		= Макет.ПолучитьОбласть("СтрокаОтсутствие");
		Иначе
			
			Заголовок	= Макет.ПолучитьОбласть("Заголовок");
			Строка		= Макет.ПолучитьОбласть("Строка");
			
			Если ВыборкаТипы.Тип = 1 Тогда
				Заголовок.Параметры.Заголовок = "У следующих СДУ закончился период действия инвестиционного профиля";
			Иначе
				Заголовок.Параметры.Заголовок = "У следующих СДУ период действия инвестиционного профиля подходит к концу";
			КонецЕсли;
			
		КонецЕсли;
		
		Подвал = Макет.ПолучитьОбласть("Подвал");
		
		Результат.Вывести(Заголовок);
		
		Выборка = ВыборкаТипы.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Строка.Параметры.Заполнить(Выборка);
			Результат.Вывести(Строка);
		КонецЦикла;
		
		Результат.Вывести(Подвал);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеПроцедурыИФункции

Процедура ЗарегистрироватьОшибку(ТекстОшибки, ПараметрыСессии = Неопределено)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки)=Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
	ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	
КонецПроцедуры // ОповеститьОбОшибках

Процедура ОтправитьПисьмо(Содержание, Получатели, ПараметрыСессии = Неопределено)
	
	Если Содержание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УчетнаяЗапись = РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("htm");
	
	Попытка
		Содержание.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.HTML);
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.Прочитать(ИмяВременногоФайла);
	Исключение
		
		ЗарегистрироватьОшибку("Не удалось сформировать сообщение из-за ошибки:" + Символы.ПС + ОписаниеОшибки(), ПараметрыСессии);
		
		Возврат;
		
	КонецПопытки;
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", Получатели, "Оповещение по инвестиционным профилям", ТелоПисьма.ПолучитьТекст(), ТипТекстаПочтовогоСообщения.HTML);
	
	РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса()
	
	Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК СДУ,
		|	СчетаДоверительногоУправления.Представление КАК Представление,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта ЕСТЬ NULL КАК ОтсутствуетПрофиль,
		|	ВЫБОР
		|		КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.ИнтервалДат)
		|			ТОГДА ИнвестиционныеПрофилиСрезПоследних.ОкончаниеПериодаГоризонта
		|		КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыЗаключенияДоговора)
		|			ТОГДА ДОБАВИТЬКДАТЕ(СчетаДоверительногоУправления.ДатаЗаключения, ГОД, ИнвестиционныеПрофилиСрезПоследних.ОтносительныйСрокГоризонта)
		|		КОГДА ИнвестиционныеПрофилиСрезПоследних.ВариантГоризонта = ЗНАЧЕНИЕ(Перечисление.ВариантыИнвестиционногоГоризонта.КоличествоЛетСДатыРегистрацииПрофиля)
		|			ТОГДА ДОБАВИТЬКДАТЕ(ИнвестиционныеПрофилиСрезПоследних.Период, ГОД, ИнвестиционныеПрофилиСрезПоследних.ОтносительныйСрокГоризонта)
		|	КОНЕЦ КАК ДатаОкончанияПрофиля
		|ПОМЕСТИТЬ _ИтоговаяТаблица
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтратегииИндивидуальногоИнвестирования.СрезПоследних(&Период, Организация = &Организация) КАК СтратегииИндивидуальногоИнвестированияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = СтратегииИндивидуальногоИнвестированияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИнвестиционныеПрофили.СрезПоследних(&Период, Организация = &Организация) КАК ИнвестиционныеПрофилиСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = ИнвестиционныеПрофилиСрезПоследних.СубъектУчета
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЮридическогоЛица), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиФизическогоЛица), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиСаморегулируемыхОрганизаций), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЦелевыхКапиталов), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеРезервамиСтраховыхКомпаний), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеИмуществомСтраховыхКомпаний))
		|	И НЕ СчетаДоверительногоУправления.ПометкаУдаления
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения > &Период)
		|	И НЕ ЕСТЬNULL(СтратегииИндивидуальногоИнвестированияСрезПоследних.Стратегия.Стандартная, ЛОЖЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИтоговаяТаблица.СДУ КАК СДУ,
		|	_ИтоговаяТаблица.Представление КАК Представление,
		|	_ИтоговаяТаблица.НомерДоговора КАК НомерДоговора,
		|	_ИтоговаяТаблица.ДатаОкончанияПрофиля КАК ДатаОкончания,
		|	ВЫБОР
		|		КОГДА _ИтоговаяТаблица.ОтсутствуетПрофиль
		|			ТОГДА 0
		|		КОГДА _ИтоговаяТаблица.ДатаОкончанияПрофиля < &Период
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Тип
		|ИЗ
		|	_ИтоговаяТаблица КАК _ИтоговаяТаблица
		|ГДЕ
		|	(_ИтоговаяТаблица.ОтсутствуетПрофиль
		|			ИЛИ РАЗНОСТЬДАТ(&Период, _ИтоговаяТаблица.ДатаОкончанияПрофиля, ДЕНЬ) <= 30)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Тип,
		|	_ИтоговаяТаблица.СДУ.Наименование
		|ИТОГИ ПО
		|	Тип";
	
КонецФункции

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки) Экспорт
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(ЭтотОбъект, ИмяКоманды);
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
КонецПроцедуры

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;