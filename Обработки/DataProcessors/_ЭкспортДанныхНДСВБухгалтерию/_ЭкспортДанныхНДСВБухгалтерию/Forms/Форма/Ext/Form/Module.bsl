Процедура ПриОткрытии(Отказ)
КонецПроцедуры

&НаКлиенте
Процедура ПередатьДанныеВБухгалтерию(Команда) 
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ПередатьДанныеВБухгалтерию");
	Попытка
		ПередатьДанныеВБухгалтериюНаСервере(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьКолонкуИзТаблицыЗначений(Таблица, ИмяКолонки)
	
	КолонкаДокумента = Таблица.Колонки.Найти(ИмяКолонки);
	Если КолонкаДокумента <> Неопределено Тогда
		Таблица.Колонки.Удалить(Таблица.Колонки.Индекс(КолонкаДокумента));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьXMLДляЭкспорта(КнигаПродаж, КнигаПокупок)
	
	ТаблицаДанных = ДанныеФормыВЗначение(ТЗПродаж, Тип("ТаблицаЗначений"));
	УдалитьКолонкуИзТаблицыЗначений(ТаблицаДанных, "СчФ");
	УдалитьКолонкуИзТаблицыЗначений(ТаблицаДанных, "Покупатель");
	УдалитьКолонкуИзТаблицыЗначений(ТаблицаДанных, "СчетДоверительногоУправления");
	
	КнигаПродаж = ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаДанных);
	
	ТаблицаДанных = ДанныеФормыВЗначение(ТЗПокупок, Тип("ТаблицаЗначений"));
	УдалитьКолонкуИзТаблицыЗначений(ТаблицаДанных, "СчФ");
	УдалитьКолонкуИзТаблицыЗначений(ТаблицаДанных, "Продавец");
	УдалитьКолонкуИзТаблицыЗначений(ТаблицаДанных, "СчетДоверительногоУправления");
	
	КнигаПокупок = ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаДанных);
	
КонецПроцедуры

&НаСервере
Процедура ПередатьДанныеВБухгалтериюНаСервере(ПараметрыСессии)
	
	Если НЕ ЭтоПолноправныйБухгалтерУКПИ() Тогда
		ТекстОшибки = "Текущий пользователь не является полноправным бухгалтером. Экспорт не произведен";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	// получим код юр. лица организации	
	IDMXОрганизации = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыВоВнешнихСистемахСрезПоследних.Код КАК Код
		|ИЗ
		|	РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|			&Дата,
		|			Объект В
		|					(ВЫБРАТЬ
		|						Организации.ЮрФизЛицо КАК ЮрФизЛицо
		|					ИЗ
		|						Справочник.Организации КАК Организации
		|					ГДЕ
		|						Организации.Ссылка = &Организация)
		|				И ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|				И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица)) КАК КодыВоВнешнихСистемахСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		IDMXОрганизации = ВыборкаДетальныеЗаписи.Код;
	Иначе
		ТекстОшибки = "Не удалось определить код юр. лица организации. Экспорт не произведен";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	// получим данные для экспорта
	КнигаПродаж = "";
	КнигаПокупок = "";
	
	ПолучитьXMLДляЭкспорта(КнигаПродаж, КнигаПокупок);
	
	
	// экспорт данных
	Бухгалтерия = РаботаСВнешнимиСистемами.ПолучитьCOMСоединениеСБухгалтерией(Объект.Организация);
	Если Бухгалтерия = Неопределено Тогда
		ДобавитьТекстОшибки(ПараметрыСессии, "Не удалось получить COM-соединение с бухгалтерией");
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Попытка 
		
		РезультатВыполнения = Бухгалтерия.РЕГ_ЗаполнениеДеклрацииНДС.ПолучитьДанныеЗаполнитьДекларациюНДС(IDMXОрганизации, КонецДня(Период.ДатаОкончания), КнигаПокупок, КнигаПродаж, ТекстОшибки);
		
	Исключение
		
		РезультатВыполнения = Ложь;
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		
		ЗаписьЖурналаРегистрации(
				"Ошибка выполнения",
				УровеньЖурналаРегистрации.Ошибка,,
				"ВнешняяОбработка._ЭкспортДанныхНДСВБухгалтерию",
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				
		// Сообщение для пользователя
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
				
	КонецПопытки;
	
	Бухгалтерия = "";
	
	
	// сообщения для пользователя
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(РезультатВыполнения = Истина, "Данные экспортированы успешно", "Ошибка экспорта"));
	
	Если РезультатВыполнения <> Истина Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ДобавитьТекстОшибки(ПараметрыСессии, ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки, "Ошибка экспорта"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ЭтаФорма.Элементы.СоздатьДокументыДляКнигиПокупокИПродаж.Доступность = ЭтоПолноправныйБухгалтерУКПИ()
		ИЛИ РольДоступна(Метаданные.Роли.ПолныеПрава);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицыПокупокИПродаж(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("ЗаполнитьТаблицыПокупокИПродаж");
	Попытка
		ЗаполнитьТаблицыПокупокИПродажНаСервере(ПараметрыСессии);
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАвансовыеСчФ(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактура.НомерСчетаФактуры КАК НомерСчетаФактуры,
		|	СчетФактура.Дата КАК Дата
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактура КАК СчетФактура
		|		ПО (СчетФактура.Ссылка = ЗадолженностиПоДенежнымСредствам.Основание)
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Регистратор = &Ссылка
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСПоАвансам)
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетФактура.Дата";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Новый Структура;
	Результат.Вставить("АвансСФ_Номер");
	Результат.Вставить("АвансСФ_Дата");
	
	Результат = "";
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если Результат <> "" Тогда
			Результат = Результат + ", ";
		КонецЕсли;
		
		Результат = Результат + "№ " + ВыборкаДетальныеЗаписи.НомерСчетаФактуры + " от " + Формат(ВыборкаДетальныеЗаписи.Дата, "ДФ=dd.MM.yyyy")
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьТаблицыПокупокИПродажНаСервере(ПараметрыСессии)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствам.Сумма КАК Сумма
		|ПОМЕСТИТЬ _ДвиженияНДС
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам КАК ЗадолженностиПоДенежнымСредствам
		|ГДЕ
		|	ЗадолженностиПоДенежнымСредствам.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ЗадолженностиПоДенежнымСредствам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.НДСТекущегоПериода)
		|	И ЗадолженностиПоДенежнымСредствам.Организация = &Организация
		|	И ЗадолженностиПоДенежнымСредствам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления.ДатаЗаключения <= ЗадолженностиПоДенежнымСредствам.Период
		|	И ЗадолженностиПоДенежнымСредствам.Активность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДвиженияНДС.Основание КАК Основание,
		|	МИНИМУМ(УсловияСделокСНедвижимостью.Период) КАК Период
		|ПОМЕСТИТЬ _ДатыПостановкиНаУчетНедвижимостиПоЗаявкам
		|ИЗ
		|	_ДвиженияНДС КАК _ДвиженияНДС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСделокСНедвижимостью КАК УсловияСделокСНедвижимостью
		|		ПО _ДвиженияНДС.Основание = УсловияСделокСНедвижимостью.АктПриемаПередачи
		|ГДЕ
		|	УсловияСделокСНедвижимостью.Активность
		|	И _ДвиженияНДС.Основание ССЫЛКА Документ.ВводПрочихАктивов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДвиженияНДС.Основание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДвиженияНДС.Основание КАК Основание
		|ПОМЕСТИТЬ _РазличныеОснования
		|ИЗ
		|	_ДвиженияНДС КАК _ДвиженияНДС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадолженностиПоДенежнымСредствам.Основание КАК Основание,
		|	ЗадолженностиПоДенежнымСредствам.Регистратор КАК Регистратор,
		|	ЗадолженностиПоДенежнымСредствам.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ЕСТЬNULL(СчетФактура.ТипСчетаФактуры, 0) = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Выданный)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ЕСТЬNULL(СчетФактура.ТипСчетаФактуры, 0) = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Полученный)
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И АктПриемаПередачиОбъектовНедвижимости.Ссылка ЕСТЬ НЕ NULL 
		|			ТОГДА АктПриемаПередачиОбъектовНедвижимости.Ссылка.Дата
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И НачислениеЗадолженности.Ссылка ЕСТЬ НЕ NULL 
		|			ТОГДА НачислениеЗадолженности.Ссылка.Дата
		|		КОГДА _ДатыПостановкиНаУчетНедвижимостиПоЗаявкам.Основание ЕСТЬ НЕ NULL 
		|			ТОГДА _ДатыПостановкиНаУчетНедвижимостиПоЗаявкам.Период
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствам.Период
		|	КОНЕЦ КАК ДатаПринятияНаУчет,
		|	ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская) КАК ЭтоКнигаПродаж,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ВЫБОР
		|					КОГДА СчетФактура.Ссылка ЕСТЬ НЕ NULL 
		|						ТОГДА ВЫБОР
		|								КОГДА СчетФактура.ТипСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Выданный)
		|									ТОГДА ""22""
		|								КОГДА СчетФактура.ТипСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Полученный)
		|									ТОГДА ""02""
		|							КОНЕЦ
		|					КОГДА АктПриемаПередачиОбъектовНедвижимости.Ссылка ЕСТЬ НЕ NULL 
		|						ТОГДА ВЫБОР
		|								КОГДА АктПриемаПередачиОбъектовНедвижимости.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|									ТОГДА ""01""
		|							КОНЕЦ
		|					КОГДА НачислениеЗадолженности.Ссылка ЕСТЬ НЕ NULL 
		|						ТОГДА ВЫБОР
		|								КОГДА НачислениеЗадолженности.СчетФактураСводный
		|									ТОГДА ""27""
		|								ИНАЧЕ ""01""
		|							КОНЕЦ
		|					КОГДА _ДатыПостановкиНаУчетНедвижимостиПоЗаявкам.Основание ЕСТЬ НЕ NULL 
		|						ТОГДА ""01""
		|					КОГДА КорректировкаЗадолженности.Ссылка ЕСТЬ НЕ NULL 
		|						ТОГДА ВЫБОР
		|								КОГДА КорректировкаЗадолженности.ВидЗадолженности В (&ВидыДебиторскойЗадолженности)
		|									ТОГДА ""18""
		|								ИНАЧЕ ""01""
		|							КОНЕЦ
		|				КОНЕЦ
		|		КОГДА ЗадолженностиПоДенежнымСредствам.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Кредиторская)
		|			ТОГДА ВЫБОР
		|					КОГДА СчетФактура.Ссылка ЕСТЬ НЕ NULL 
		|						ТОГДА ВЫБОР
		|								КОГДА СчетФактура.ТипСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Выданный)
		|									ТОГДА ""02""
		|								КОГДА СчетФактура.ТипСчетаФактуры = ЗНАЧЕНИЕ(Перечисление.ТипыСчетовФактур.Полученный)
