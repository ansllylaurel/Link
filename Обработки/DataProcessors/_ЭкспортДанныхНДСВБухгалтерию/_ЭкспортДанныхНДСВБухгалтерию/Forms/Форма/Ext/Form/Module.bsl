		|		ПО (СчетФактура.Контрагент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ НачислениеЗадолженности.Контрагент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ АктПриемаПередачиОбъектовНедвижимости.Контрагент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ КорректировкаЗадолженности.Контрагент = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ ЗаявкаПайщика.Пайщик = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И Организация = &Организация) КАК РеквизитыЮридическихЛицГрузоотправительАнкетныеСрезПоследних
		|		ПО (СчетФактура.Грузоотправитель = РеквизитыЮридическихЛицГрузоотправительАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ НачислениеЗадолженности.Грузоотправитель = РеквизитыЮридическихЛицГрузоотправительАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ АктПриемаПередачиОбъектовНедвижимости.Грузоотправитель = РеквизитыЮридическихЛицГрузоотправительАнкетныеСрезПоследних.ЮрФизЛицо
		|				ИЛИ КорректировкаЗадолженности.Грузоотправитель = РеквизитыЮридическихЛицГрузоотправительАнкетныеСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&ОкончаниеПериода,
		|				Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|					И ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							Справочник.Организации.ЮрФизЛицо
		|						ИЗ
		|							Справочник.Организации
		|						ГДЕ
		|							Справочник.Организации.Ссылка = &Организация)
		|					И Организация = &Организация) КАК РеквизитыОрганизацииАнкетныеСрезПоследних
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ОкончаниеПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов В (ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ЮридическиеЛица), ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ФизическиеЛица))) КАК КодыВоВнешнихСистемахСрезПоследних
		|		ПО (СчетФактура.Контрагент = КодыВоВнешнихСистемахСрезПоследних.Объект
		|				ИЛИ НачислениеЗадолженности.Контрагент = КодыВоВнешнихСистемахСрезПоследних.Объект
		|				ИЛИ АктПриемаПередачиОбъектовНедвижимости.Контрагент = КодыВоВнешнихСистемахСрезПоследних.Объект
		|				ИЛИ КорректировкаЗадолженности.Контрагент = КодыВоВнешнихСистемахСрезПоследних.Объект
		|				ИЛИ ЗаявкаПайщика.Пайщик = КодыВоВнешнихСистемахСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ОкончаниеПериода, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ЗадолженностиПоДенежнымСредствам.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхСведений КАК ЗначенияДополнительныхСведений
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = ЗначенияДополнительныхСведений.Объект)
		|			И (ЗначенияДополнительныхСведений.Свойство.Ключ = ""КодЮрлицаВМатрикс"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ОкончаниеПериода, ) КАК РеквизитыПИФСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
		|			И (РеквизитыОрганизацииАнкетныеСрезПоследних.ЮрФизЛицо = РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВоВнешнихСистемах.СрезПоследних(
		|				&ОкончаниеПериода,
		|				ВнешняяСистема = ЗНАЧЕНИЕ(Справочник.ВнешниеСистемы.Матрих)
		|					И ГруппаОбъектов = ЗНАЧЕНИЕ(Справочник.ГруппыИмпортируемыхОбъектов.ПаевыеИнвестиционныеФонды)) КАК КодОрганизацииВоВнешнихСистемахСрезПоследних
		|		ПО (КлиентыДоверительногоУправленияСрезПоследних.Клиент = КодОрганизацииВоВнешнихСистемахСрезПоследних.Объект)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период";
	
	Запрос.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ОкончаниеПериода", Период.ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	ВидыДебиторскойЗадолженности = Новый Массив;
	ВидыДебиторскойЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоПрочимДоходам);
	ВидыДебиторскойЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоИнымДоходамПоИмуществу);
	ВидыДебиторскойЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоАренде);
	ВидыДебиторскойЗадолженности.Добавить(Справочники.ВидыЗадолженности.ПоАрендеПеременнаяЧасть);
	
	Запрос.УстановитьПараметр("ВидыДебиторскойЗадолженности", ВидыДебиторскойЗадолженности);
	
	ВалютаРубли = ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ТЗПродаж.Очистить();
	ТЗПокупок.Очистить();
	
	СписокОшибок = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ВыборкаДетальныеЗаписи.Регистратор + " попала в выгрузку. Проверьте корректность данных");
			Для Каждого Кол Из РезультатЗапроса.Колонки Цикл
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("	" + Кол.Имя + " = " + ВыборкаДетальныеЗаписи[Кол.Имя]);
			КонецЦикла;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ВыборкаДетальныеЗаписи);
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ВыборкаДетальныеЗаписи.Регистратор + " не попала в выгрузку. Внесите данные вручную");
			//Продолжить;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ИНН = NULL Тогда
			ЗафиксироватьОшибку("Не заведена анкета для контрагента " + ВыборкаДетальныеЗаписи.Контрагент +"!", СписокОшибок, ПараметрыСессии); 
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.КодКонтрагентаВМатрикс = "" Тогда
			ЗафиксироватьОшибку("В дополнительных сведениях не указан код юрлица в Матрикс для фонда " + ВыборкаДетальныеЗаписи.СчетДоверительногоУправления +"!", СписокОшибок, ПараметрыСессии); 
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ЭтоКнигаПродаж Тогда
			
			СтрокаПродажи = ТЗПродаж.Добавить();
			СтрокаПродажи.СчетДоверительногоУправления 	= ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
			СтрокаПродажи.КодВидаОперации 				= ВыборкаДетальныеЗаписи.КодВидаОперации;
			СтрокаПродажи.НомерСФ 						= ВыборкаДетальныеЗаписи.НомерСчетаФактуры;
			СтрокаПродажи.ДатаСФ 						= ВыборкаДетальныеЗаписи.ДатаСчетаФактуры;
			СтрокаПродажи.НомерСФКорректируемый			= ВыборкаДетальныеЗаписи.НомерСчетаФактурыКорректируемого;
			СтрокаПродажи.ДатаСФКорректируемый			= ВыборкаДетальныеЗаписи.ДатаСчетаФактурыКорректируемого;
			СтрокаПродажи.ИННПокупателя					= ВыборкаДетальныеЗаписи.ИНН;
			СтрокаПродажи.НаимПокупателя				= ВыборкаДетальныеЗаписи.НаименованиеКонтрагента;
			СтрокаПродажи.КПППокупателя					= ВыборкаДетальныеЗаписи.КПП;
			СтрокаПродажи.Стоимость						= ВыборкаДетальныеЗаписи.СуммаСНДС - ВыборкаДетальныеЗаписи.СуммаНДС;
			СтрокаПродажи.СуммаНДС						= ВыборкаДетальныеЗаписи.Сумма;
			СтрокаПродажи.СуммаСФ						= ВыборкаДетальныеЗаписи.СуммаСНДС;
			СтрокаПродажи.ВалКурс						= 1;
			СтрокаПродажи.Валюта						= ВалютаРубли.Код;
			СтрокаПродажи.Покупатель					= ВыборкаДетальныеЗаписи.Контрагент;
			СтрокаПродажи.СчФ							= ВыборкаДетальныеЗаписи.Основание;
			СтрокаПродажи.IDMX							= ВыборкаДетальныеЗаписи.КодКонтрагентаВМатрикс;
			СтрокаПродажи.ПлатежныеДокументы 			= Документы.СчетФактура.ПолучитьПлатежныеДокументы(ВыборкаДетальныеЗаписи.СчетФактура);
			СтрокаПродажи.Период 						= ВыборкаДетальныеЗаписи.Период;
			
			Если ВыборкаДетальныеЗаписи.КолвоСчетовФактурНаАванс > 0 Тогда
//				СтрокаПродажи.СчетФактураНаАванс		= Обработки.ПечатьИВыгрузкаДокументовПоНедвижимости.ПолучитьАвансовыеСчФ(ВыборкаДетальныеЗаписи.Основание);
				СтрокаПродажи.СчетФактураНаАванс		= ПолучитьАвансовыеСчФ(ВыборкаДетальныеЗаписи.Основание);
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаПродажи.НомерСФКорректируемый) Тогда
				Если СтрокаПродажи.КодВидаОперации = "18" Тогда
					СтрокаПродажи.Корректировочный		= "Корректировка";
				Иначе
					СтрокаПродажи.Корректировочный		= "Исправление";
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			СтрокаПокупки = ТЗПокупок.Добавить();
			СтрокаПокупки.СчетДоверительногоУправления 	= ВыборкаДетальныеЗаписи.СчетДоверительногоУправления;
			СтрокаПокупки.КодВидаОперации 				= ВыборкаДетальныеЗаписи.КодВидаОперации;
			СтрокаПокупки.НомерСФ 						= ВыборкаДетальныеЗаписи.НомерСчетаФактуры;
			СтрокаПокупки.ДатаСФ 						= ВыборкаДетальныеЗаписи.ДатаСчетаФактуры;
			СтрокаПокупки.НомерСФКорректируемый			= ВыборкаДетальныеЗаписи.НомерСчетаФактурыКорректируемого;
			СтрокаПокупки.ДатаСФКорректируемый			= ВыборкаДетальныеЗаписи.ДатаСчетаФактурыКорректируемого;
			СтрокаПокупки.НаимПродавца 					= ВыборкаДетальныеЗаписи.НаименованиеКонтрагента;
			СтрокаПокупки.ИННПродавца 					= ВыборкаДетальныеЗаписи.ИНН;
			СтрокаПокупки.КПППродавца 					= ВыборкаДетальныеЗаписи.КПП;
			СтрокаПокупки.Стоимость 					= ВыборкаДетальныеЗаписи.СуммаСНДС - ВыборкаДетальныеЗаписи.СуммаНДС;
			СтрокаПокупки.СуммаНДС 						= ВыборкаДетальныеЗаписи.Сумма;
			Если ТипЗнч(ВыборкаДетальныеЗаписи.Основание) = Тип("ДокументСсылка.ВводПрочихАктивов") Тогда
				СтрокаПокупки.СуммаСФ					= 0;
			Иначе
				СтрокаПокупки.СуммаСФ					= ВыборкаДетальныеЗаписи.СуммаСНДС;
			КонецЕсли;
			СтрокаПокупки.ДатаПринятияНаУчет 			= ВыборкаДетальныеЗаписи.ДатаПринятияНаУчет;
			СтрокаПокупки.Продавец 						= ВыборкаДетальныеЗаписи.Контрагент;
			СтрокаПокупки.СчФ 							= ВыборкаДетальныеЗаписи.Основание;
			СтрокаПокупки.IDMX 							= ВыборкаДетальныеЗаписи.КодКонтрагентаВМатрикс;
			Если ВыборкаДетальныеЗаписи.КодВидаОперации = "22" Тогда
				СтрокаПокупки.ПлатежныеДокументы 		= "";
			Иначе	
				СтрокаПокупки.ПлатежныеДокументы 		= Документы.СчетФактура.ПолучитьПлатежныеДокументы(ВыборкаДетальныеЗаписи.СчетФактура);
			КонецЕсли;
			СтрокаПокупки.Период 						= ВыборкаДетальныеЗаписи.Период;

			Если ВыборкаДетальныеЗаписи.КолвоСчетовФактурНаАванс > 0 Тогда
				//СтрокаПокупки.СчетФактураНаАванс		= Обработки.ПечатьИВыгрузкаДокументовПоНедвижимости.ПолучитьАвансовыеСчФ(ВыборкаДетальныеЗаписи.Основание);
				СтрокаПокупки.СчетФактураНаАванс		= ПолучитьАвансовыеСчФ(ВыборкаДетальныеЗаписи.Основание);
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаПокупки.НомерСФКорректируемый) Тогда
				Если СтрокаПокупки.КодВидаОперации = "18" Тогда
					СтрокаПокупки.Корректировочный		= "Корректировка";
				Иначе
					СтрокаПокупки.Корректировочный		= "Исправление";
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЭтаФорма.Элементы.ГруппаПокупки.Заголовок = "Покупки (" +ТЗПокупок.Количество() +")";
	ЭтаФорма.Элементы.ГруппаПродажи.Заголовок = "Продажи (" +ТЗПродаж.Количество() +")";
	
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьОшибку(Ошибка, СписокОшибок, ПараметрыСессии);
	
	Если СписокОшибок.Найти(Ошибка) = Неопределено Тогда
		СписокОшибок.Добавить(Ошибка);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибка); 
		ДобавитьТекстОшибки(ПараметрыСессии, Ошибка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьXMLВФайлы(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("СохранитьXMLВФайлы");
	Попытка
		ВыполнитьСохранениеXMLВФайлы();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСохранениеXMLВФайлы()
	
	КнигаПродаж = "";
	КнигаПокупок = "";
	
	ПолучитьXMLДляЭкспорта(КнигаПродаж, КнигаПокупок);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "*.xml"; 
	Диалог.Расширение = "*.xml";
	
	Диалог.Заголовок = "Выберите имя файла для сохранения книги Покупок";
	Диалог.ПолноеИмяФайла = "КнигаПокупок "+ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания)+".xml";
	Если Диалог.Выбрать() Тогда
		Файл = Новый ЗаписьТекста(Диалог.ПолноеИмяФайла);
		Файл.ЗаписатьСтроку(КнигаПокупок);
		Файл.Закрыть();
	КонецЕсли;
	
	Диалог.Заголовок = "Выберите имя файла для сохранения книги Продаж";
	Диалог.ПолноеИмяФайла = "КнигаПродаж "+ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания)+".xml";
	Если Диалог.Выбрать() Тогда
		Файл = Новый ЗаписьТекста(Диалог.ПолноеИмяФайла);
		Файл.ЗаписатьСтроку(КнигаПродаж);
		Файл.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоПолноправныйБухгалтерУКПИ() 
	
	АдресЭлектроннойПочты = НРег(ПараметрыСеанса.ТекущийПользователь.АдресЭлектроннойПочты);
	
	Если АдресЭлектроннойПочты = "kozhuhova@ukpi.ru" ИЛИ АдресЭлектроннойПочты = "kaplina@region.ru" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
		
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
