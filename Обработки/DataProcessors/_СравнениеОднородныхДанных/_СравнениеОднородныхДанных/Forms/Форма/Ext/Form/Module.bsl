&НаСервереБезКонтекста
Функция БухгалтерскиеПроводкиЗаПериод(НачалоПериода, КонецПериода)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""БухгалтерскийУчет"" КАК __ИмяВыборки__,
		|	БухгалтерскийУчет.Регистратор КАК __Ключ__Регистратор,
		|	БухгалтерскийУчет.НомерСтроки КАК __Ключ__НомерСтроки,
		|	БухгалтерскийУчет.СчетДт,
		|	БухгалтерскийУчет.СчетКт,
		|	БухгалтерскийУчет.Организация,
		|	БухгалтерскийУчет.СчетДоверительногоУправления,
		|	БухгалтерскийУчет.ВалютаДт,
		|	БухгалтерскийУчет.ВалютаКт,
		|	БухгалтерскийУчет.КоличествоДт,
		|	БухгалтерскийУчет.КоличествоКт,
		|	БухгалтерскийУчет.Сумма,
		|	БухгалтерскийУчет.ВалютнаяСуммаДт,
		|	БухгалтерскийУчет.ВалютнаяСуммаКт,
		|	БухгалтерскийУчет.Содержание
		|ИЗ
		|	РегистрБухгалтерии.БухгалтерскийУчет КАК БухгалтерскийУчет
		|ГДЕ
		|	БухгалтерскийУчет.Активность
		|	И БухгалтерскийУчет.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""НалоговыйУчет"" КАК __ИмяВыборки__,
		|	НалоговыйУчет.Регистратор КАК __Ключ__Регистратор,
		|	НалоговыйУчет.НомерСтроки КАК __Ключ__НомерСтроки,
		|	НалоговыйУчет.СчетДт,
		|	НалоговыйУчет.СчетКт,
		|	НалоговыйУчет.Организация,
		|	НалоговыйУчет.СчетДоверительногоУправления,
		|	НалоговыйУчет.ВалютаДт,
		|	НалоговыйУчет.ВалютаКт,
		|	НалоговыйУчет.КоличествоДт,
		|	НалоговыйУчет.КоличествоКт,
		|	НалоговыйУчет.Сумма,
		|	НалоговыйУчет.ВалютнаяСуммаДт,
		|	НалоговыйУчет.ВалютнаяСуммаКт,
		|	НалоговыйУчет.Содержание
		|ИЗ
		|	РегистрБухгалтерии.НалоговыйУчет КАК НалоговыйУчет
		|ГДЕ
		|	НалоговыйУчет.Активность
		|	И НалоговыйУчет.Период МЕЖДУ &НачалоПериода И &КонецПериода";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериода", "ДАТАВРЕМЯ(" + Формат(НачалоПериода, "ДФ='yyyy, MM, dd, 00, 00, 00'") + ")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонецПериода", "ДАТАВРЕМЯ(" + Формат(КонецПериода, "ДФ='yyyy, MM, dd, 23, 59, 59'") + ")");
		
	Возврат ТекстЗапроса;
	
КонецФункции // БухгалтерскиеПроводкиЗаПериод

