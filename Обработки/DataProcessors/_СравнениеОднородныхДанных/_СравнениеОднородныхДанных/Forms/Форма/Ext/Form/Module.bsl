
&НаСервереБезКонтекста
Функция ПресетДвиженияДокументовОдногоВидаЗаПериод(ИмяДокумента, НачалоПериода, КонецПериода)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка,
		|	Документ.МоментВремени
		|ПОМЕСТИТЬ
		|	_Регистраторы
		|ИЗ
		|	Документ.&ИмяДокумента КАК Документ
		|ГДЕ
		|	Документ.Проведен
		|	И Документ.Дата МЕЖДУ ДАТАВРЕМЯ(&НачалоПериода) И ДАТАВРЕМЯ(&КонецПериода)
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;";
	
	ШаблонЗапроса =
		"
		|
		|///////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""&ИмяРегистра"" КАК __ИмяВыборки__,
		|	&ИмяРегистра.Регистратор КАК __Ключ__Регистратор,
		|	&ИмяРегистра.НомерСтроки КАК __Ключ__НомерСтроки,
		|	&ИмяРегистра.*
		|ИЗ
		|	&ВидРегистра.&ИмяРегистра КАК &ИмяРегистра
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Регистраторы КАК _Регистраторы
		|		ПО _Регистраторы.Ссылка = &ИмяРегистра.Регистратор
		|ГДЕ
		|	&ИмяРегистра.Активность
		|;";
		
	ЗапросДвиженияПоОперациямСЦБ =
		"
		|
		|///////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ОперацииСЦеннымиБумагами"" КАК __ИмяВыборки__,
		|	ОперацииСЦеннымиБумагами.Регистратор КАК __Ключ__Регистратор,
		|	ОперацииСЦеннымиБумагами.НомерСтроки КАК __Ключ__НомерСтроки,
		|	ОперацииСЦеннымиБумагами.Активность,
		|	ОперацииСЦеннымиБумагами.Операция,
		|	ОперацииСЦеннымиБумагами.ЧастьСделкиРЕПО,
		|	ОперацииСЦеннымиБумагами.ВидДвижения,
		|	ОперацииСЦеннымиБумагами.Основание,
		|	ОперацииСЦеннымиБумагами.Организация,
		|	ОперацииСЦеннымиБумагами.СчетДоверительногоУправления,
		|	ОперацииСЦеннымиБумагами.Рынок,
		|	ОперацииСЦеннымиБумагами.ЦеннаяБумага,
		|	ОперацииСЦеннымиБумагами.ДатаПоставкиПлановая,
		|	ОперацииСЦеннымиБумагами.ДатаПоставки,
		|	ОперацииСЦеннымиБумагами.ДатаОплатыПлановая,
		|	ОперацииСЦеннымиБумагами.ДатаОплаты,
		|	ОперацииСЦеннымиБумагами.Количество,
		|	ОперацииСЦеннымиБумагами.Цена,
		|	ОперацииСЦеннымиБумагами.ЦенаПроцент,
		|	ОперацииСЦеннымиБумагами.ЦенаКупона,
		|	ОперацииСЦеннымиБумагами.Сумма,
		|	ОперацииСЦеннымиБумагами.СуммаКупона,
		|	ОперацииСЦеннымиБумагами.ДатаОперации
		|ИЗ
		|	РегистрСведений.ОперацииСЦеннымиБумагами КАК ОперацииСЦеннымиБумагами
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Регистраторы КАК _Регистраторы
		|		ПО _Регистраторы.Ссылка = ОперацииСЦеннымиБумагами.Регистратор
		|ГДЕ
		|	ОперацииСЦеннымиБумагами.Активность
		|УПОРЯДОЧИТЬ ПО
		|	_Регистраторы.МоментВремени,
		|	ОперацииСЦеннымиБумагами.НомерСтроки
		|;";
	
	Для каждого РегистрМД Из Метаданные.Документы[ИмяДокумента].Движения Цикл
		Если      Метаданные.РегистрыНакопления.Содержит(РегистрМД) Тогда
			ВидРегистра = "РегистрНакопления";
		ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(РегистрМД) Тогда
			ВидРегистра = "РегистрБухгалтерии";
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(РегистрМД) Тогда
			ВидРегистра = "РегистрСведений";
		КонецЕсли;
		
		Если РегистрМД.Имя = "ОперацииСЦеннымиБумагами" Тогда
			ТекстЗапроса = ТекстЗапроса + ЗапросДвиженияПоОперациямСЦБ;
		Иначе
			ТекстЗапроса = ТекстЗапроса + СтрЗаменить(СтрЗаменить(ШаблонЗапроса, "&ВидРегистра", ВидРегистра), "&ИмяРегистра", РегистрМД.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяДокумента", ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериода", Формат(НачалоПериода, "ДФ='yyyy, MM, dd, 00, 00, 00'"));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонецПериода", Формат(КонецПериода, "ДФ='yyyy, MM, dd, 23, 59, 59'"));
	
	Возврат ТекстЗапроса;

КонецФункции // ПресетДвиженияДокументовОдногоВидаЗаПериод

&НаСервереБезКонтекста
Функция ПресетОборотыПоВсемРегистрамНакопленияЗаПериод(НачалоПериода, КонецПериода)
	
	ТекстЗапроса = "";
	
	ШаблонЗапроса =
		"///////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""&ИмяРегистра"" КАК __ИмяВыборки__,
		|	&Измерения,
		|	&Ресурсы
		|ИЗ
		|	РегистрНакопления.&ИмяРегистра.Обороты(&НачалоПериода, &КонецПериода, Период, ) КАК &ИмяРегистраОбороты
		|;";
	
	Для каждого РегистрМД Из Метаданные.РегистрыНакопления Цикл
		Если Лев(РегистрМД.Имя, 3) = "Бух" Тогда
			Продолжить;
		КонецЕсли;
			
		Измерения = "";
		Ресурсы   = "";
		
		Для каждого ПолеМД Из РегистрМД.Измерения Цикл
			Измерения = Измерения + ?(ПустаяСтрока(Измерения), "", "," + Символы.ПС + Символы.Таб) + РегистрМД.Имя + "Обороты." + ПолеМД.Имя + " КАК __Ключ__" + ПолеМД.Имя;
		КонецЦикла;
		
		Для каждого ПолеМД Из РегистрМД.Ресурсы Цикл
			Если РегистрМД.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
				Ресурсы = Ресурсы + ?(ПустаяСтрока(Ресурсы), "", "," + Символы.ПС + Символы.Таб) + РегистрМД.Имя + "Обороты." + ПолеМД.Имя + "Оборот";
			Иначе
				Ресурсы = Ресурсы + ?(ПустаяСтрока(Ресурсы), "", "," + Символы.ПС + Символы.Таб) + РегистрМД.Имя + "Обороты." + ПолеМД.Имя + "Приход";
				Ресурсы = Ресурсы + ?(ПустаяСтрока(Ресурсы), "", "," + Символы.ПС + Символы.Таб) + РегистрМД.Имя + "Обороты." + ПолеМД.Имя + "Расход";
			КонецЕсли;
		КонецЦикла;
		
		ТекстЗапросаПоРегистру = СтрЗаменить(ШаблонЗапроса, "&ИмяРегистра", РегистрМД.Имя);
		ТекстЗапросаПоРегистру = СтрЗаменить(ТекстЗапросаПоРегистру, "&Измерения", Измерения);
		ТекстЗапросаПоРегистру = СтрЗаменить(ТекстЗапросаПоРегистру, "&Ресурсы", Ресурсы);
		
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "", Символы.ПС + Символы.ПС) + ТекстЗапросаПоРегистру;
	КонецЦикла;	
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериода", "ДАТАВРЕМЯ(" + Формат(НачалоПериода, "ДФ='yyyy, MM, dd, 00, 00, 00'") + ")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонецПериода", "ДАТАВРЕМЯ(" + Формат(КонецПериода, "ДФ='yyyy, MM, dd, 23, 59, 59'") + ")");
	
	Возврат ТекстЗапроса;
	
КонецФункции // ПресетОборотыПоВсемРегистрамНакопленияЗаПериод

&НаСервереБезКонтекста
Функция ТорговаяКомиссияЗаПериод(НачалоПериода, КонецПериода)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОбороты.Основание ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.Основание.Основание
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамОбороты.Основание
		|	КОНЕЦ КАК __Ключ__Основание,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ТипЗадолженности КАК __Ключ__ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности КАК __Ключ__ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Организация КАК __Ключ__Организация,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления КАК __Ключ__СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта КАК __Ключ__Валюта,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаПриход) КАК СуммаПриход,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаРасход) КАК СуммаРасход,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаПриход) КАК СуммаКупонаПриход,
		|	СУММА(ЗадолженностиПоДенежнымСредствамОбороты.СуммаКупонаРасход) КАК СуммаКупонаРасход
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Обороты(&НачалоПериода, &КонецПериода, Период, ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)) КАК ЗадолженностиПоДенежнымСредствамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОбороты.Основание ССЫЛКА Документ.ИсполнениеОбязательствПоСделке
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОбороты.Основание.Основание
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамОбороты.Основание
		|	КОНЕЦ,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОбороты.ВидЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Организация,
		|	ЗадолженностиПоДенежнымСредствамОбороты.СчетДоверительногоУправления,
		|	ЗадолженностиПоДенежнымСредствамОбороты.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Организация КАК __Ключ__Организация,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК __Ключ__СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредств.Брокер КАК __Ключ__Брокер,
		|	ОстаткиДенежныхСредств.МестоХранения КАК __Ключ__МестоХранения,
		|	ОстаткиДенежныхСредств.РасчетныйСчет КАК __Ключ__РасчетныйСчет,
		|	ОстаткиДенежныхСредств.Валюта КАК __Ключ__Валюта,
		|	СУММА(ОстаткиДенежныхСредств.Сумма) КАК Сумма
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиДенежныхСредств.Организация,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредств.Брокер,
		|	ОстаткиДенежныхСредств.МестоХранения,
		|	ОстаткиДенежныхСредств.РасчетныйСчет,
		|	ОстаткиДенежныхСредств.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УсловияСделокСрезПоследних.Организация КАК __Ключ__Организация,
		|	УсловияСделокСрезПоследних.Сделка КАК __Ключ__Сделка,
		|	УсловияСделокСрезПоследних.Рынок КАК __Ключ__Рынок,
		|	УсловияСделокСрезПоследних.ЦеннаяБумага КАК __Ключ__ЦеннаяБумага,
		|	УсловияСделокСрезПоследних.Отменено,
		|	УсловияСделокСрезПоследних.ДепозитарныйСчет,
		|	УсловияСделокСрезПоследних.ДатаИсполнения,
		|	УсловияСделокСрезПоследних.ДатаОплаты,
		|	УсловияСделокСрезПоследних.ДатаПоставки,
		|	УсловияСделокСрезПоследних.ВалютаОплаты,
		|	УсловияСделокСрезПоследних.СобственныйКурсОплаты,
		|	УсловияСделокСрезПоследних.КурсОплаты,
		|	УсловияСделокСрезПоследних.Количество,
		|	УсловияСделокСрезПоследних.Цена,
		|	УсловияСделокСрезПоследних.ЦенаПроцент,
		|	УсловияСделокСрезПоследних.ЦенаКупона,
		|	УсловияСделокСрезПоследних.Сумма,
		|	УсловияСделокСрезПоследних.СуммаКупона,
		|	УсловияСделокСрезПоследних.КомиссияБрокера,
		|	УсловияСделокСрезПоследних.ТорговаяКомиссия,
		|	УсловияСделокСрезПоследних.ОтложенноеИсполнение,
		|	УсловияСделокСрезПоследних.РаздельноеИсполнение
		|ИЗ
		|	РегистрСведений.УсловияСделок.СрезПоследних(&КонецПериода) КАК УсловияСделокСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	УсловияСделокСрезПоследних.Период";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НачалоПериода", "ДАТАВРЕМЯ(" + Формат(НачалоПериода, "ДФ='yyyy, MM, dd, 00, 00, 00'") + ")");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КонецПериода", "ДАТАВРЕМЯ(" + Формат(КонецПериода, "ДФ='yyyy, MM, dd, 23, 59, 59'") + ")");
	
	Возврат ТекстЗапроса;
	
КонецФункции // ТорговаяКомиссияЗаПериод

&НаСервереБезКонтекста
Функция ОстаткиПоРегистрамДокументаНаДату(ИмяДокумента, Период)
	
	ТекстЗапроса = "";
	
	Для каждого РегистрМД Из Метаданные.Документы[ИмяДокумента].Движения Цикл
		Если      Метаданные.РегистрыНакопления.Содержит(РегистрМД) Тогда
			ВидРегистра = "РегистрНакопления";
		ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(РегистрМД) Тогда // пока не актуально
			Продолжить;
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(РегистрМД) Тогда
			ВидРегистра = "РегистрСведений";
		КонецЕсли;
		
		ТекстЗапросаКРегистру = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
		
		Для каждого ИзмерениеМД Из РегистрМД.Измерения Цикл
			ТекстЗапросаКРегистру = ТекстЗапросаКРегистру + Символы.ПС + Символы.Таб + ИзмерениеМД.Имя + " КАК __Ключ__" + ИзмерениеМД.Имя + ",";
		КонецЦикла;
		
		Для каждого РесурсМД Из РегистрМД.Ресурсы Цикл
			ТекстЗапросаКРегистру = ТекстЗапросаКРегистру + Символы.ПС + Символы.Таб + РесурсМД.Имя + ?(ВидРегистра = "РегистрНакопления", "Остаток", "") + ",";
		КонецЦикла;
		
		ТекстЗапросаКРегистру = Лев(ТекстЗапросаКРегистру, СтрДлина(ТекстЗапросаКРегистру) - 1);
		ТекстЗапросаКРегистру = ТекстЗапросаКРегистру + Символы.ПС + "ИЗ";
		
		Если      ВидРегистра = "РегистрНакопления" Тогда
			ТекстЗапросаКРегистру = ТекстЗапросаКРегистру + Символы.ПС + Символы.Таб + "РегистрНакопления." + РегистрМД.Имя + ".Остатки(&Период)";
		ИначеЕсли ВидРегистра = "РегистрСведений" Тогда
			Если РегистрМД.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				ТекстЗапросаКРегистру = ТекстЗапросаКРегистру + Символы.ПС + Символы.Таб + "РегистрСведений." + РегистрМД.Имя;
			Иначе
				ТекстЗапросаКРегистру = ТекстЗапросаКРегистру + Символы.ПС + Символы.Таб + "РегистрСведений." + РегистрМД.Имя + ".СрезПоследних(&Период)";
			КонецЕсли;
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "",  Символы.ПС + ";" + Символы.ПС + Символы.ПС + "////////////////////////////////////////////////////////////////////////////////" + Символы.ПС) + ТекстЗапросаКРегистру;
		
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Период", "ДАТАВРЕМЯ(" + Формат(Период, "ДФ='yyyy, MM, dd, 23, 59, 59'") + ")");
	
	Возврат ТекстЗапроса;
	
КонецФункции // ОстаткиПоРегистрамСделокНаДату

&НаСервереБезКонтекста
