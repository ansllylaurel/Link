&НаСервере
Функция НайтиРасхождения(ВнутрДанные, ВнешнДанные)
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Расхождения");
	
	ЕстьРасхождения = Ложь;
	ИмяВыборки      = "";
	
	ШапкаПустаяКолонка    = Макет.ПолучитьОбласть("ШапкаТаблицы|Пустая");
	ШапкаКолонка          = Макет.ПолучитьОбласть("ШапкаТаблицы|Колонка");
	СтрокаПустаяКолонка   = Макет.ПолучитьОбласть("НетРасхождений|Пустая");
	СтрокаЕстьРасхождения = Макет.ПолучитьОбласть("ЕстьРасхождения|Колонка");
	СтрокаНетРасхождений  = Макет.ПолучитьОбласть("НетРасхождений|Колонка");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаОтчета"));
	
	// подготовим запрос для поиска расхождений
	КлючевыеПоля                     = "";
	УсловиеСоединенияПоКлючевымПолям = "";
	УсловиеПоискаРасхождений         = "";	
	
	Для каждого Колонка Из ВнутрДанные.Колонки Цикл
		Если Найти(Колонка.Имя, "__Ключ__") = 1 Тогда
			КлючевыеПоля = КлючевыеПоля + ?(ПустаяСтрока(КлючевыеПоля), "", "," + Символы.ПС + Символы.Таб) + Колонка.Имя;
			
			УсловиеСоединенияПоКлючевымПолям = УсловиеСоединенияПоКлючевымПолям + ?(ПустаяСтрока(УсловиеСоединенияПоКлючевымПолям), "", Символы.ПС + Символы.Таб + Символы.Таб + "И ")
				+ "_ВнутрДанные." + Колонка.Имя + " = _ВнешнДанные." + Колонка.Имя;
		КонецЕсли;		
			
		УсловиеПоискаРасхождений = УсловиеПоискаРасхождений + ?(ПустаяСтрока(УсловиеПоискаРасхождений), "", Символы.ПС + Символы.Таб + Символы.Таб + "ИЛИ ")
			+ "(_ВнутрДанные." + Колонка.Имя + " <> _ВнешнДанные." + Колонка.Имя + " ИЛИ _ВнутрДанные." + Колонка.Имя + " ЕСТЬ NULL ИЛИ _ВнешнДанные." + Колонка.Имя + " ЕСТЬ NULL)";
	КонецЦикла;
		
	Если КлючевыеПоля = "" Тогда
		ВызватьИсключение "В таблице отсутствуют ключевые поля";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнутрДанные.*
		|ПОМЕСТИТЬ _ВнутрДанные
		|ИЗ
		|	&ВнутрДанные КАК ВнутрДанные
		|ИНДЕКСИРОВАТЬ ПО
		|	&КлючевыеПоля
		|;
		|
		|///////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВнешнДанные.*
		|ПОМЕСТИТЬ _ВнешнДанные
		|ИЗ
		|	&ВнешнДанные КАК ВнешнДанные
		|ИНДЕКСИРОВАТЬ ПО
		|	&КлючевыеПоля
		|;
		|
		|///////////////////////////////////////////////////////////////////		
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВнутрДанные.*,
		|	_ВнешнДанные.*
		|ИЗ
		|	_ВнутрДанные
		|	ПОЛНОЕ СОЕДИНЕНИЕ _ВнешнДанные
		|	ПО &УсловиеСоединенияПоКлючевымПолям
		|ГДЕ
		|	&УсловиеПоискаРасхождений";
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&КлючевыеПоля",                     КлючевыеПоля);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединенияПоКлючевымПолям", УсловиеСоединенияПоКлючевымПолям);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоискаРасхождений",         УсловиеПоискаРасхождений);
	
	// выполним запрос и отобразим расхождения
	Запрос.УстановитьПараметр("ВнутрДанные", ВнутрДанные);
	Запрос.УстановитьПараметр("ВнешнДанные", ВнешнДанные);
	
	Расхождения = Запрос.Выполнить().Выгрузить();
	
	Для Инд = 0 По Расхождения.Количество() - 1 Цикл
		// отобразим шапку
		Если Инд = 0 Тогда
			ТабДок.Вывести(ШапкаПустаяКолонка);
			
			Для каждого Колонка Из ВнутрДанные.Колонки Цикл
				Если      Колонка.Имя = "__ИмяВыборки__" Тогда
					ИмяВыборки = ?(ВнутрДанные.Количество() > 0, ВнутрДанные[0][Колонка.Имя], ВнешнДанные[0][Колонка.Имя]);
					Продолжить;
				ИначеЕСли Найти(Колонка.Имя, "__Ключ__") = 1 Тогда
					ШапкаКолонка.Параметры["ИмяКолонки"] = СтрЗаменить(Колонка.Имя, "__Ключ__", "*");
				Иначе
					ШапкаКолонка.Параметры["ИмяКолонки"] = Колонка.Имя;
				КонецЕсли;
				
				ТабДок.Присоединить(ШапкаКолонка);
			КонецЦикла;
		КонецЕсли;
		
		// отобразим строки
		ТабДок.Вывести(СтрокаПустаяКолонка);
		
		Для каждого Колонка Из ВнутрДанные.Колонки Цикл
			Если Колонка.Имя = "__ИмяВыборки__" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Расхождения[Инд][Колонка.Имя] = Расхождения[Инд][Колонка.Имя + "1"] Тогда
				Область = СтрокаНетРасхождений;
			Иначе
				Область = СтрокаЕстьРасхождения;
			КонецЕсли;
				
			Область.Параметры["ВнутрЗначение"]   = Расхождения[Инд][Колонка.Имя];
			Область.Параметры["ВнешнееЗначение"] = Расхождения[Инд][Колонка.Имя + "1"];
			
			ТабДок.Присоединить(Область);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат
		Новый Структура("ИмяВыборки, ЕстьРасхождения, Таблица", ИмяВыборки, (Расхождения.Количество() > 0), ТабДок);
	
КонецФункции // НайтиРасхождения
	
&НаСервере
Процедура СериализоватьВыборкуНаСервере(ИмяФайла)
	
	Запрос = Новый Запрос;
	Запрос.Текст = Объект.ЗапросОтбора;
	
	Пакеты = Запрос.ВыполнитьПакет();
	
	// формирование файла
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Данные");
	
	ЗаписьXML.ЗаписатьАтрибут("Источник", СтрокаСоединенияИнформационнойБазы());
	ЗаписьXML.ЗаписатьАтрибут("Период",   Строка(ТекущаяДата()));
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Отбор");
	ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(Объект.ЗапросОтбора));
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Отбор
	
	Для каждого Пакет Из Пакеты Цикл
		
		ТаблицаДанных = Пакет.Выгрузить();
		
		Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") Тогда
			ЗаписьXML.ЗаписатьНачалоЭлемента("Таблица");
			ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(ТаблицаДанных));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // Данные
	
	ЗаписьXML.Закрыть();
	
	Сообщить("Сериализация выборки завершена.");
	
КонецПроцедуры // СериализоватьВыборкуНаСервере

&НаСервере
Функция СравнитьССериализованнойВыборкойНаСервере(ИмяФайла, ПараметрыСессии)
	
	Расхождения = Новый Массив;
	
	// десериализуем внеш. выборку
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	
	Запрос = Новый Запрос;
	
	ВнешниеДанные = Новый Массив;
	
	ИмяТекущегоУзла = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		Если      ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяТекущегоУзла = ЧтениеXML.Имя;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Если      ИмяТекущегоУзла = "Отбор" Тогда
				Запрос.Текст = ДесериализоватьЗначение(ЧтениеXML.Значение);
			ИначеЕсли ИмяТекущегоУзла = "Таблица" Тогда
				ВнешниеДанные.Добавить(ДесериализоватьЗначение(ЧтениеXML.Значение));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
	
	Объект.ЗапросОтбора = Запрос.Текст;
	
	// получим данные и сравним с текущей выборкой
	Пакеты = Запрос.ВыполнитьПакет();
	
	Для Инд = 0 По Пакеты.Количество() - 1 Цикл
		Попытка
			Расхождения.Добавить(НайтиРасхождения(Пакеты[Инд].Выгрузить(), ВнешниеДанные[Инд]));
		Исключение
			ТекстОшибки = "Сверка таблиц № " + (Инд + 1) + " не производилась"
				+ Символы.ПС + ОписаниеОшибки();
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
	КонецЦикла;
	
	Возврат Расхождения;
	
КонецФункции // СравнитьССериализованнойВыборкойНаСервере

