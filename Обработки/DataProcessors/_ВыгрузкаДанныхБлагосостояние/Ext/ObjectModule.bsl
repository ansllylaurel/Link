Функция Получить_ВидОперацииПоступленияНаРасчетныйСчет(Шапка)

	Если Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона Тогда
		ПоступлениеДоходаНКДПоОблигации = Новый Структура("Актив,ДатаОкончанияКупонногоПериода,СуммаНКД");
		ПоступлениеДоходаНКДПоОблигации.Актив							= Получить_Актив(Шапка);
		ПоступлениеДоходаНКДПоОблигации.ДатаОкончанияКупонногоПериода	= Шапка.ДатаОкончанияКупонногоПериода;
		ПоступлениеДоходаНКДПоОблигации.СуммаНКД						= Шапка.СуммаНКД;
		
		Возврат Новый Структура("ПоступлениеДоходаНКДПоОблигации", ПоступлениеДоходаНКДПоОблигации);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств Тогда
		Возврат Новый Структура("ВводДенежныхСредствВДУ", ПустоеЗначение);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата
		И Шапка.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи Тогда
		
		ПоступлениеДивидендов = Новый Структура("Актив,СуммаДивидендов");
		ПоступлениеДивидендов.Актив				= Получить_Актив(Шапка);
		ПоступлениеДивидендов.СуммаДивидендов	= Шапка.СуммаДивидендов;
		
		Возврат Новый Структура("ПоступлениеДивидендов", ПоступлениеДивидендов);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовМНО Тогда
		
		ПоступлениеПроцентовПоБанковскимСчетам = Новый Структура("БанковскийСчетДляПроцентов, СделкаМНО");
		ПоступлениеПроцентовПоБанковскимСчетам.БанковскийСчетДляПроцентов	= Шапка.БанковскийСчетПортфеля;
		ПоступлениеПроцентовПоБанковскимСчетам.СделкаМНО					= Шапка.СделкаМНО;
		
		Возврат Новый Структура("ПоступлениеПроцентовПоБанковскимСчетам", ПоступлениеПроцентовПоБанковскимСчетам);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств
		И Шапка.ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СоСчетаБрокераНаРасчетныйСчет Тогда
		
		ВызватьИсключение "Нет описания выгрузки документов ПоступленияНаРасчетныйСчет с видом Перевод денежных средств со счёта брокера на расчётный счёт. Пример в задаче #347586";
		
	Иначе
		ВызватьИсключение "Нет описания выгрузки документов ПоступленияНаРасчетныйСчет с видом " + Строка(Шапка.ВидДвиженияДенежныхСредств);
		
	КонецЕсли;
	
КонецФункции

Функция Получить_ПервичныйДокументПоступленияНаРасчетныйСчет(Шапка)

	ПервичныйДокумент = "";	
	
	Если Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств Тогда
		
		Комментарий = НРег(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.UID, "Комментарий"));
		
		НачалоНомера = СтрНайти(Комментарий, "распоряжение");
		
		Если НачалоНомера > 0 Тогда 
			
			НомерПервойЦифры		= Неопределено;
			НомерПоследнейЦифры		= Неопределено; 
			
			Для НомерСимвола = НачалоНомера По СтрДлина(Комментарий) Цикл
				КодСимвола = КодСимвола(Комментарий, НомерСимвола);
				Если КодСимвола > 47 И КодСимвола < 58 Тогда
					Если НомерПервойЦифры = Неопределено Тогда
						НомерПервойЦифры = НомерСимвола;
					КонецЕсли;
					НомерПоследнейЦифры = НомерСимвола;
				ИначеЕсли НомерПервойЦифры <> Неопределено Тогда
					Прервать;		
				КонецЕсли;		
			КонецЦикла;
			
			Если НомерПервойЦифры <> Неопределено Тогда
				ПервичныйДокумент = Сред(Комментарий, НомерПервойЦифры, НомерПоследнейЦифры - НомерПервойЦифры + 1);  		
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПервичныйДокумент;
	
КонецФункции

Функция Получить_ВидОперацииСписанияСРасчетногоСчета(Шапка)
	
	Если Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств Тогда
		Возврат Новый Структура("ВыводДенежныхСредствИзДУ", ПустоеЗначение);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата 
		И (Шапка.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии
			ИЛИ Шапка.ВариантДвиженияДенежныхСредств.Родитель = Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
		Возврат Новый Структура("КомиссияБанка", ПустоеЗначение);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата 
		И Шапка.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего Тогда
		Возврат Новый Структура("ВознаграждениеУК", Новый Структура("ДоговорКонтрагента", СчетДоверительногоУправления));
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата 
		И Шапка.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария Тогда
		
		ДоговорСоСпецДепом = ДоговорСоСпецДепом();
		
		ДобавитьСправочникКВыгрузке(ДоговорСоСпецДепом);
		Возврат Новый Структура("ВознаграждениеСД", Новый Структура("ДоговорКонтрагента", ДоговорСоСпецДепом));
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств
		И Шапка.ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.МеждуРасчетнымиСчетами Тогда
		
		ПереводНаДругойСчетФонда = Новый Структура("ВалютаСчетаПолучателя,СуммаВВалютеСчетаПолучателя");
		
		ЗаполнитьЗначенияРеквизитов(ПереводНаДругойСчетФонда, Шапка);
	
		Если Шапка.КурсВалютыСчетаПолучателя <> 1 Тогда
			ПереводНаДругойСчетФонда.Вставить("КурсВалютыСчетаПолучателя"		, Шапка.КурсВалютыСчетаПолучателя);
			ПереводНаДругойСчетФонда.Вставить("КратностьВалютыСчетаПолучателя"	, Шапка.КратностьВалютыСчетаПолучателя);
		КонецЕсли;
		
		Возврат Новый Структура("ПереводНаДругойСчетФонда", ПереводНаДругойСчетФонда);
		
	ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств
		И Шапка.ВариантДвиженияДенежныхСредств = Перечисления.ВидыПереводовДенежныхСредств.СРасчетногоСчетаНаСчетБрокера Тогда
		
		ВызватьИсключение "Нет описания выгрузки документов СписанияСрасчетногоСчета с видом Перевод денежных средств с расчётного счёта на счёт брокера. Пример в задаче #347586";
		
	Иначе
		ВызватьИсключение "Нет описания выгрузки документов СписанияСрасчетногоСчета с видом " + Строка(Шапка.ВидДвиженияДенежныхСредств);
		
	КонецЕсли;
		
КонецФункции	

Функция Получить_ВыводыЦенныхБумагИзДУ()
	
	ВыводЦенныхБумагИзДУ = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВыводЦенныхБумаг.Ссылка КАК UID,
		|	ВыводЦенныхБумаг.Ссылка.Дата КАК Дата,
		|	ВыводЦенныхБумаг.Ссылка.Номер КАК Номер,
		|	ВыводЦенныхБумаг.Ссылка.СчетДоверительногоУправления КАК Портфель,
		|	ВыводЦенныхБумаг.Ссылка.ДепозитарныйСчет КАК МестоХраненияЦБ,
		|	ВыводЦенныхБумаг.УчетныйАктивЕПС.Родитель КАК РодительВидаУчетногоАктива,
		|	ВыводЦенныхБумаг.ЦеннаяБумага КАК Актив_UID,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Актив_ISIN_Код,
		|	ВЫБОР
		|		КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акция""
		|		КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Облигация""
		|		КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""ПаиПИФ""
		|	КОНЕЦ КАК Актив_ТипАктива,
		|	ВЫБОР
		|		КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала.Наименование
		|		КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала.Наименование
		|		КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФ.КраткоеНаименованиеФонда + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала.Наименование
		|	КОНЕЦ КАК Актив_Наименование,
		|	ВыводЦенныхБумаг.Количество КАК Количество
		|ИЗ
		|	Документ.ВыводЦенныхБумаг.ЦенныеБумаги КАК ВыводЦенныхБумаг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО ВыводЦенныхБумаг.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
		|		ПО (ВЫБОР
		|				КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФ
		|		ПО (ВЫБОР
		|				КОГДА ВыводЦенныхБумаг.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|					ТОГДА ВЫРАЗИТЬ(ВыводЦенныхБумаг.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|			КОНЕЦ = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	ВыводЦенныхБумаг.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ВыводЦенныхБумаг.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ВыводЦенныхБумаг.Ссылка.Проведен
		|ИТОГИ ПО
		|	UID";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Шапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Шапка.Следующий() Цикл
		РеквизитыШапки = Новый Структура("UID, Дата, Номер, Портфель");
		
		ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Шапка);
		
		РеквизитыШапки.Вставить("ТипПортфеля");
		РеквизитыШапки.Вставить("Активы", Новый Структура("Запись", Новый Массив));
		
		Активы = Шапка.Выбрать();
		Пока Активы.Следующий() Цикл
			Запись = Новый Структура;
			Запись.Вставить("Актив"		, Получить_Актив(Активы));
			Запись.Вставить("Количество", Активы.Количество);
			
			РеквизитыШапки.Активы.Запись.Добавить(Запись);
			
			Если НЕ ЗначениеЗаполнено(РеквизитыШапки.ТипПортфеля) И ЗначениеЗаполнено(Активы.РодительВидаУчетногоАктива) Тогда
				РеквизитыШапки.ТипПортфеля = Получить_ТипПортфеля(Активы.РодительВидаУчетногоАктива);
			КонецЕсли;
		КонецЦикла;
		
		РеквизитыШапки.Вставить("МестоХраненияЦБ", Получить_МестоХранения(Шапка.МестоХраненияЦБ));
		
		ВыводЦенныхБумагИзДУ.Добавить(РеквизитыШапки);
		
	КонецЦикла;
	
	Возврат Новый Структура("ВыводЦенныхБумагИзДУ", ВыводЦенныхБумагИзДУ);
	
КонецФункции

Функция Получить_ДенежныеСредства(НаДату)
	
	Записи = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ОстаткиДенежныхСредствОстатки.РасчетныйСчет
		|		ИНАЧЕ ОстаткиДенежныхСредствОстатки.Брокер.ЮрФизЛицо
		|	КОНЕЦ КАК __content,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредствОстатки.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|			ТОГДА ""Банковский""
		|		ИНАЧЕ ""Брокерский""
		|	КОНЕЦ КАК ТипСчета,
		|	ОстаткиДенежныхСредствОстатки.Валюта.Код КАК Валюта,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК Сумма,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания КАК ДоговорБрокерскогоОбслуживания
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(&НаДату, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&НаДату, СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО ОстаткиДенежныхСредствОстатки.Организация = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация
		|			И ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредствОстатки.Брокер = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер";
	
	УстановитьПараметрыЗапроса(Запрос);
	Запрос.УстановитьПараметр("НаДату", НаДату);

	Остаток = Запрос.Выполнить().Выбрать();
	Пока Остаток.Следующий() Цикл
		Запись = Новый Структура("Валюта, Сумма");
		ЗаполнитьЗначенияРеквизитов(Запись, Остаток);
		Запись.Вставить("МестоХранения", Новый Структура("__content, ТипСчета", Остаток.__content, Остаток.ТипСчета));
		Записи.Добавить(Запись);
		
		Если ЗначениеЗаполнено(Остаток.ДоговорБрокерскогоОбслуживания) Тогда
			ДобавитьСправочникКВыгрузке(Остаток.ДоговорБрокерскогоОбслуживания);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("Запись", Записи);
	
КонецФункции

Функция Получить_ЗадолженностьКонтрагентов(НаДату)
	
	ЗадолженностьКонтрагентов = Новый Структура;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|			ТОГДА ""ДебиторскаяЗадолженность""
		|		ИНАЧЕ ""КредиторскаяЗадолженность""
		|	КОНЕЦ КАК ТипЗадолженности,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.ВидЗадолженности В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ДепозитарнаяКомиссия))
		|			ТОГДА &ДоговорСоСпецДепом
		|		КОГДА ЗадолженностиПоДенежнымСредствамОстатки.Контрагент = ЗадолженностиПоДенежнымСредствамОстатки.Организация.ЮрФизЛицо
		|			ТОГДА ЗадолженностиПоДенежнымСредствамОстатки.СчетДоверительногоУправления
		|		ИНАЧЕ ЗадолженностиПоДенежнымСредствамОстатки.Основание.Договор
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	ЗадолженностиПоДенежнымСредствамОстатки.Валюта.Код КАК Валюта,
		|	ЗадолженностиПоДенежнымСредствамОстатки.СуммаОстаток + ЗадолженностиПоДенежнымСредствамОстатки.СуммаКупонаОстаток КАК Сумма
		|ПОМЕСТИТЬ _ЗадолженностиКонтрагентов
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоДенежнымСредствам.Остатки(
		|			&ГраницаПериода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)) КАК ЗадолженностиПоДенежнымСредствамОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидАктива = ЗНАЧЕНИЕ(Перечисление.ВидыАктивов.КредиторскаяЗадолженность)
		|			ТОГДА ""КредиторскаяЗадолженность""
		|		ИНАЧЕ ""ДебиторскаяЗадолженность""
		|	КОНЕЦ,
		|	ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).Брокер.ЮрФизЛицо,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Валюта.Код,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынок
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели.СрезПоследних(
		|			НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период, СЕКУНДА, -1), ДЕНЬ),
		|			Организация = &Организация
		|				И СубъектАналитики = &СчетДоверительногоУправления
		|				И ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)) КАК ФинансовыеПоказателиСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|		ПО (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = ФинансовыеПоказателиСрезПоследних.Период)
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления)
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация)
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность)
		|			И (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО (СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления)
		|			И (ВЫБОР
		|				КОГДА СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВторойЧастиРЕПО)
		|					ТОГДА ВЫРАЗИТЬ(СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Основание КАК Документ.СделкаРЕПО).Брокер
		|			КОНЕЦ = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	""ДебиторскаяЗадолженность"",
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.МНО
		|			ТОГДА МНО.РасчетныйСчет.Банк.ЮрФизЛицо
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.ДепозитныеВклады
		|			ТОГДА ДепозитныеВклады.БанковскийСчет.Банк.ЮрФизЛицо
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.МНО
		|				И МНО.Договор <> ЗНАЧЕНИЕ(Справочник.Договоры.)
		|			ТОГДА МНО.Договор
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Документ.МНО
		|			ТОГДА МНО.РасчетныйСчет.ДоговорМНО
		|		КОГДА ЕдиныйБухгалтерскийУчетОстатки.Субконто2 ССЫЛКА Справочник.ДепозитныеВклады
		|			ТОГДА ДепозитныеВклады.БанковскийСчет.Договор
		|	КОНЕЦ,
		|	ЕдиныйБухгалтерскийУчетОстатки.Валюта.Код,
		|	ЕдиныйБухгалтерскийУчетОстатки.ВалютнаяСуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЕдиныйБухгалтерскийУчет.Остатки(
		|			&ГраницаПериода,
		|			Счет В (ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты01), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты03), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты09), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты11), ЗНАЧЕНИЕ(ПланСчетов.Единый.Депозиты13)),
		|			,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ЕдиныйБухгалтерскийУчетОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = ДепозитныеВклады.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.МНО КАК МНО
		|		ПО ЕдиныйБухгалтерскийУчетОстатки.Субконто2 = МНО.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиКонтрагентов.ТипЗадолженности КАК ТипЗадолженности,
		|	_ЗадолженностиКонтрагентов.Контрагент КАК Контрагент,
		|	_ЗадолженностиКонтрагентов.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	_ЗадолженностиКонтрагентов.Валюта КАК Валюта,
		|	СУММА(_ЗадолженностиКонтрагентов.Сумма) КАК Сумма
		|ИЗ
		|	_ЗадолженностиКонтрагентов КАК _ЗадолженностиКонтрагентов
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗадолженностиКонтрагентов.ТипЗадолженности,
		|	_ЗадолженностиКонтрагентов.Контрагент,
		|	_ЗадолженностиКонтрагентов.ДоговорКонтрагента,
		|	_ЗадолженностиКонтрагентов.Валюта
		|ИТОГИ ПО
		|	ТипЗадолженности");	
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Запрос.УстановитьПараметр("Период",				НаДату);
	Запрос.УстановитьПараметр("ГраницаПериода", 	Новый Граница(НаДату, ?(НаДату = КонецДня(НаДату), ВидГраницы.Включая, ВидГраницы.Исключая))); 
	Запрос.УстановитьПараметр("ДоговорСоСпецДепом",	ДоговорСоСпецДепом());	
	Запрос.УстановитьПараметр("НКО_НКЦ", 			НКО_НКЦ);	
	
	// Получаем данные в нужном формате	
	
	ВыборкаТипыЗадолженности = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	Пока ВыборкаТипыЗадолженности.Следующий() Цикл
		
		Задолженности = Новый Массив;		
		
		ВыборкаЗаписи = ВыборкаТипыЗадолженности.Выбрать();
		
		Пока ВыборкаЗаписи.Следующий() Цикл
			
			Запись = Новый Структура("Контрагент, ДоговорКонтрагента, Валюта, Сумма");
			
			ЗаполнитьЗначенияРеквизитов(Запись, ВыборкаЗаписи);
			
			Если НЕ ЗначениеЗаполнено(Запись.ДоговорКонтрагента) Тогда
				Запись.Удалить("ДоговорКонтрагента");
			ИначеЕсли Запись.Контрагент = НКО_НКЦ Тогда
				ДоговорыСНКО_НКЦ.Добавить(Запись.ДоговорКонтрагента);
			КонецЕсли;
			
			Задолженности.Добавить(Запись);	
			
		КонецЦикла;
		
		ЗадолженностьКонтрагентов.Вставить(ВыборкаТипыЗадолженности.ТипЗадолженности, Новый Структура("Запись", Задолженности));
		
	КонецЦикла;	

	Возврат ЗадолженностьКонтрагентов;
	
КонецФункции

Функция Получить_ДепозитарныеСчета()
	
	СчетаДЕПО = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.ДепозитарныйСчет КАК UID,
		|	ВложенныйЗапрос.ДепозитарныйСчет.НомерСчета КАК НомерСчета,
		|	ВложенныйЗапрос.ДепозитарныйСчет.Депозитарий.ЮрФизЛицо КАК Депозитарий
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		ВЫБОР
		|			КОГДА ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|				ТОГДА ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.Родитель
		|			ИНАЧЕ ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет
		|		КОНЕЦ КАК ДепозитарныйСчет
		|	ИЗ
		|		РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|	ГДЕ
		|		ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &ДатаНачала
		|				ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|		И ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет.ДатаОткрытия <= &ДатаОкончания) КАК ВложенныйЗапрос";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	ВыборкаСчетаДЕПО = Запрос.Выполнить().Выбрать();
	Пока ВыборкаСчетаДЕПО.Следующий() Цикл
		СчетДЕПО = Новый Структура("UID, Наименование, НомерСчета, Депозитарий");
		СчетДЕПО.Наименование = СформироватьНаименованиеДепозитарногоСчета(ВыборкаСчетаДЕПО.UID);
		
		ЗаполнитьЗначенияРеквизитов(СчетДЕПО, ВыборкаСчетаДЕПО);
		
		СчетаДЕПО.Добавить(СчетДЕПО);
	КонецЦикла;
	
	Возврат Новый Структура("СчетДЕПО", СчетаДЕПО);
	
КонецФункции	

Функция Получить_ДепозитныеСделки()
	
	ДепозитнаяСделка = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДенежныеСредстваВКредитныхИнструментахОбороты.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОбороты";
	
	УстановитьПараметрыЗапроса(Запрос);

	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Нет описания выгрузки документов ДепозитнаяСделка";
	КонецЕсли;
	
	Возврат Новый Структура("ДепозитнаяСделка", ДепозитнаяСделка);
	
КонецФункции

Функция Получить_ДоговорКонтрагента(Выборка)
	
	Договор = Новый Структура("UID, Портфель, Наименование, НомерДоговора, ДатаДоговора, Валюта, РольДоговора, ДатаОкончания");
	Договор.Наименование = СформироватьНаименованиеДоговора(Выборка.Договор_UID);
	
	ЗаполнитьЗначенияРеквизитов(Договор, Выборка, "Договор_");	
	
	Возврат Договор;
	
