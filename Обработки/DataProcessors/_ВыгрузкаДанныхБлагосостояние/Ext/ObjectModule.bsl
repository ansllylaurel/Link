Функция Получить_СделкиМНО()
	
	СделкаМНО = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МНО.Ссылка КАК UID,
		|	МНО.СчетДоверительногоУправления КАК Портфель,
		|	МНО.РасчетныйСчет КАК БанковскийСчет,
		|	МНО.РасчетныйСчет.Договор КАК Договор,
		|	НомераОбъектов.Номер КАК Номер,
		|	МНО.Дата КАК ДатаОткрытия,
		|	МНО.ДатаВозврата КАК ДатаЗавершения,
		|	МНО.Процент КАК ПроцентнаяСтавка,
		|	МНО.Сумма КАК СуммаМНО,
		|	""ВКонцеСрока"" КАК ПериодичностьВыплат
		|ИЗ
		|	Документ.МНО КАК МНО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераОбъектов
		|		ПО МНО.Организация = НомераОбъектов.Организация
		|			И МНО.СчетДоверительногоУправления = НомераОбъектов.СчетДоверительногоУправления
		|			И МНО.Основание = НомераОбъектов.Объект
		|			И (ГОД(МНО.Дата) = НомераОбъектов.Год)
		|			И (НомераОбъектов.ВидНумерации = ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.РаспоряженияНаМНО))
		|ГДЕ
		|	МНО.Проведен
		|	И МНО.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И МНО.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Шапка = Запрос.Выполнить().Выбрать();
	Пока Шапка.Следующий() Цикл
		РеквизитыШапки = Новый Структура("UID, Портфель, БанковскийСчет, Договор, ДатаОткрытия, ДатаЗавершения, ПроцентнаяСтавка, СуммаМНО, ПериодичностьВыплат");
		
		ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Шапка);
		
		РеквизитыШапки.Вставить("Номер", РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(Шапка.Номер));
		
		СделкаМНО.Добавить(РеквизитыШапки);
	КонецЦикла;
	
	Возврат Новый Структура("СделкаМНО", СделкаМНО);
	
КонецФункции	

