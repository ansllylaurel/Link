#КонецОбласти

#Область Наименования

Функция СформироватьНаименованиеДепозитарногоСчета(РеквизитыСчета) Экспорт
	
	Наименование = "";
	
	Если РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета Тогда
		Если      Лев(РеквизитыСчета.НомерСчета, 2) = "31" Тогда
			Наименование = "Торговый в НРД";
		ИначеЕсли Лев(РеквизитыСчета.НомерСчета, 2) = "36" Тогда
			Наименование = "Торговый+ в НРД";
		ИначеЕсли Лев(РеквизитыСчета.НомерСчета, 2) = "38" Тогда
			Наименование = "Блокиров. в НРД";
		Иначе
			Наименование = "";
		КонецЕсли;
		
		Наименование = РеквизитыСчета.Родитель.НомерСчета + ", " + ?(Наименование <> "", Наименование + ", ", "") + КраткоеНаименованиеЮрЛица(РеквизитыСчета.Брокер.ЮрФизЛицо);
		
	ИначеЕсли РеквизитыСчета.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.Депозитарный Тогда
		
		Наименование = "" + КраткоеНаименованиеЮрЛица(РеквизитыСчета.Депозитарий.ЮрФизЛицо) + ", " + РеквизитыСчета.ВидСчета + ", " + РеквизитыСчета.НомерСчета;
		
	КонецЕсли;
	
	Возврат Наименование;
	
КонецФункции

Функция СформироватьНаименованиеБанковскогоСчета(РеквизитыСчета) Экспорт
	
	Возврат СокрЛП(РеквизитыСчета.НомерСчета) + " (" + РеквизитыСчета.Валюта + ") в " + КраткоеНаименованиеЮрЛица(РеквизитыСчета.Банк.ЮрФизЛицо);
	
КонецФункции // СформироватьНаименование

Функция СформироватьНаименованиеДоговора(РеквизитыДоговора) Экспорт
	
	Наименование = "";
	
	Если ДоговорыСНКО_НКЦ.Найти(РеквизитыДоговора) <> Неопределено Тогда
		Наименование = "Договор на обслуживание по операциям на ОРЦБ";
		
	ИначеЕсли ТипЗнч(РеквизитыДоговора) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		
		Клиент					= Справочники.СчетаДоверительногоУправления.КлиентДоверительногоУправления(РеквизитыДоговора, ЭтотОбъект.Период.ДатаОкончания);
		НаименованиеКонтрагента	= КраткоеНаименованиеЮрЛица(Клиент, Истина);
		
		Наименование = "Договор ДУ " + НаименованиеКонтрагента + " №" + РеквизитыДоговора.НомерДоговора;
		
	ИначеЕсли ТипЗнч(РеквизитыДоговора) = Тип("СправочникСсылка.Договоры") Тогда
		НаименованиеКонтрагента = КраткоеНаименованиеЮрЛица(РеквизитыДоговора.Контрагент);
		Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.ДополнительноеСоглашение Тогда
			ВидДоговора	= "доп. согл.";
			
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.Прочее Тогда
			ВидДоговора	= "договор";
			
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоОбслуживания
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.БанковскогоДепозита
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоров.КомплексногоОбслуживания Тогда
			ВидДоговора	= "договор " + НРег(РеквизитыДоговора.ВидДоговора);
			
		Иначе
			ВидДоговора	= НРег(РеквизитыДоговора.ВидДоговора);
		КонецЕсли;
		
		Если ПустаяСтрока(РеквизитыДоговора.НомерДоговора) Тогда
			Наименование = "" + НаименованиеКонтрагента + ", " + ВидДоговора + " от " + Формат(РеквизитыДоговора.ДатаЗаключения, "ДФ=dd.MM.yy");
		Иначе
			Наименование = "" + НаименованиеКонтрагента + ", " + ВидДоговора + " № " + РеквизитыДоговора.НомерДоговора + " от " + Формат(РеквизитыДоговора.ДатаЗаключения, "ДФ=dd.MM.yy");
		КонецЕсли;
	Иначе
		НаименованиеКонтрагента = КраткоеНаименованиеЮрЛица(РеквизитыДоговора.Контрагент);
		Наименование = "" + НаименованиеКонтрагента + ", № " + СокрЛП(РеквизитыДоговора.НомерДоговора) + " от " + Формат(РеквизитыДоговора.ДатаЗаключения, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
			
	
	Возврат Наименование;
	
КонецФункции // СформироватьНаименование

Функция КраткоеНаименованиеЮрЛица(ЮрФизЛицо, АнкетныеДанные = Ложь)
	
	КраткоеНаименованиеПоУставу = "";
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЮрФизЛицо"		, ЮрФизЛицо);
	Запрос.УстановитьПараметр("ДатаОкончания"	, ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("АнкетныеДанные"	, АнкетныеДанные);
	Запрос.УстановитьПараметр("Организация"		, ЭтотОбъект.Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&ДатаОкончания,
		|			НЕ &АнкетныеДанные
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&ДатаОкончания,
		|			&АнкетныеДанные
		|				И Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КраткоеНаименованиеПоУставу = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыXML(Выборка.КраткоеНаименованиеПоУставу);
		КраткоеНаименованиеПоУставу = СтрЗаменить(КраткоеНаименованиеПоУставу, """", "");
	КонецЕсли;
	
	Возврат КраткоеНаименованиеПоУставу;
	
КонецФункции

#КонецОбласти

#Область Выгрузка_данных

Функция ВыгрузитьДанные() Экспорт
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация, СчетДоверительногоУправления, Период, Подписант, КаталогДанных"); 
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыгрузитьДанные()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	НКО_НКЦ = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
	
	Если РольДоступна("ПолныеПрава") Тогда
		
		Попытка
			ПакетДанных = ПолучитьПакетДанных();
		Исключение
			
			ТекстОшибки = ОписаниеОшибки();
			
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			
			Возврат Неопределено;
			
		КонецПопытки;
	Иначе
		ПакетДанных = ПолучитьПакетДанных();
	КонецЕсли;
	
	ИмяФайла = СформироватьXML(ПакетДанных);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Возврат ИмяФайла;
	
КонецФункции

Функция СформироватьXML(ПакетДанных)
	
	Если ПакетДанных.Свойство("Отказ") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Каталог = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов();
	
	ИмяФайла		 = Каталог + Строка(Новый УникальныйИдентификатор) + ".xml";
	ИмяФайлаXSDСхемы = Каталог + Строка(Новый УникальныйИдентификатор) + ".xsd";
	
	МакетXSDСхемы = ПолучитьМакет("СхемаВыгрузки");	
	МакетXSDСхемы.Записать(ИмяФайлаXSDСхемы);
	
	ФайлыXSD = Новый Массив;
	ФайлыXSD.Добавить(ИмяФайлаXSDСхемы);
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла, "UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	НоваяФабрикаXDTO = СоздатьФабрикуXDTO(ФайлыXSD);
	
	ТипОбъектаXDTO = НоваяФабрикаXDTO.Тип("www.avancore.ru/periodic_reference", "Пакет");
	
	ПакетДанныхXML = ПреобразоватьЗначениеВXML(ПакетДанных, "Пакет", НоваяФабрикаXDTO, ТипОбъектаXDTO);
	
	НоваяФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ПакетДанныхXML, "Пакет");
	
	ЗаписьXML.Закрыть();	
	
	Возврат ИмяФайла;		
	
КонецФункции

Функция ПреобразоватьЗначениеВXML(ПакетДанных, ИмяЭлемента, НоваяФабрикаXDTO, ТипОбъектаXDTO = "", ЕстьДанные = ЛОЖЬ)
	
	ТипЗначения = ТипЗнч(ПакетДанных);
	
	Если ТипЗначения = Тип("Структура")  Тогда
		ОбъектXDTO = НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);

		Для Каждого ЭлементПакета Из ПакетДанных Цикл
			Если ТипЗнч(ЭлементПакета.Значение) = Тип("Массив") Тогда
				Для Каждого ЭлементМассива Из ЭлементПакета.Значение Цикл
					ЕстьДанныеВПодчиненныхЭлементах = Ложь;
					ЭлементОбъекта = ПреобразоватьЗначениеВXML(ЭлементМассива, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип, ЕстьДанныеВПодчиненныхЭлементах);
					Если ЕстьДанныеВПодчиненныхЭлементах 
						ИЛИ ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).НижняяГраница > 0 Тогда
						ОбъектXDTO[ЭлементПакета.Ключ].Добавить(ЭлементОбъекта);
					КонецЕсли;
					ЕстьДанные = МАКС(ЕстьДанныеВПодчиненныхЭлементах, ЕстьДанные);
				КонецЦикла;
			Иначе
				ЕстьДанныеВПодчиненныхЭлементах = Ложь;
				ЭлементОбъекта = ПреобразоватьЗначениеВXML(ЭлементПакета.Значение, ЭлементПакета.Ключ, НоваяФабрикаXDTO, ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).Тип, ЕстьДанныеВПодчиненныхЭлементах);
				Если ЕстьДанныеВПодчиненныхЭлементах 
					ИЛИ ТипОбъектаXDTO.Свойства.Получить(ЭлементПакета.Ключ).НижняяГраница > 0 Тогда
					ОбъектXDTO[ЭлементПакета.Ключ] = ЭлементОбъекта;
				КонецЕсли;
				ЕстьДанные = МАКС(ЕстьДанныеВПодчиненныхЭлементах, ЕстьДанные);
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ЭтоПримитивныйТип(ПакетДанных) Тогда
		ЕстьДанные	= МАКС(ЗначениеЗаполнено(ПакетДанных), ЕстьДанные);
		Если ПакетДанных = ЭтотОбъект.ПустоеЗначение Тогда
			ОбъектXDTO	= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO);
		Иначе
			ОбъектXDTO	= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, ПакетДанных);
		КонецЕсли;
	Иначе
		ЕстьДанные	= МАКС(ЗначениеЗаполнено(ПакетДанных), ЕстьДанные);
		ОбъектXDTO	= НоваяФабрикаXDTO.Создать(ТипОбъектаXDTO, СериализаторXDTO.XMLСтрока(ПакетДанных));
	КонецЕсли;                                                 
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ЭтоПримитивныйТип(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Неопределено")
		ИЛИ ТипЗначения = Тип("Null")
	Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

