Функция Получить_СчетаБрокеров()
	
	СчетаБрокеров = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер КАК UID,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.ЮрФизЛицо КАК Брокер,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК ТорговыйКод,
		|	""ММВБ"" КАК Биржа
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&ДатаОкончания,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания.ДатаЗаключения <= &ДатаОкончания
		|	И (УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения >= &ДатаНачала)";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	ВыборкаСчетаБрокеров = Запрос.Выполнить().Выбрать();
	Пока ВыборкаСчетаБрокеров.Следующий() Цикл
		СчетБрокера = Новый Структура("UID, Брокер, ТорговыйКод, Биржа");
		ЗаполнитьЗначенияРеквизитов(СчетБрокера, ВыборкаСчетаБрокеров);
		СчетаБрокеров.Добавить(СчетБрокера);
	КонецЦикла;;
	
	Возврат Новый Структура("СчетБрокера", СчетаБрокеров);
	
КонецФункции

Функция Получить_ТипПортфеля(РодительВидаУчетногоАктива)
	
	Если РодительВидаУчетногоАктива = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПрибыльУбыток
		ИЛИ РодительВидаУчетногоАктива = Справочники.УчетныеАктивыЕПС.ДолевыеПоСправедливой Тогда
		Возврат "DFPL - Активы/обязательства, переоцениваемые по справедливой стоимости через прибыль или убыток";
	ИначеЕсли РодительВидаУчетногоАктива = Справочники.УчетныеАктивыЕПС.ДолговыеЧерезПСД Тогда
		Возврат "HTM - Инвестиции до погашения"
	ИначеЕсли РодительВидаУчетногоАктива = Справочники.УчетныеАктивыЕПС.ДолговыеДляПродажи
		ИЛИ РодительВидаУчетногоАктива = Справочники.УчетныеАктивыЕПС.ДолевыеДляПродажи Тогда
		Возврат "AFS - Активы для перепродажи";
	ИначеЕсли РодительВидаУчетногоАктива = Справочники.УчетныеАктивыЕПС.ДолговыеКромеВекселейДляПродажиИДоПогашения Тогда 
		Возврат "LR - Активы/обязательства, оцениваемые по амортизированной стоимости";
	КонецЕсли;
	
КонецФункции

Функция Получить_ФинансовыеИнструменты(НаДату)
	
	Записи = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Актив_UID,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Актив_ISIN_Код,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акция""
		|		КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Облигация""
		|		КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""ПаиПИФ""
		|	КОНЕЦ КАК Актив_ТипАктива,
		|	ВЫБОР
		|		КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала.Наименование
		|		КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала.Наименование
		|		КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФ.КраткоеНаименованиеФонда + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала.Наименование
		|	КОНЕЦ КАК Актив_Наименование,
		|	БухПартииЦенныхБумагОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.БухПартииЦенныхБумаг.Остатки(
		|			&НаДату,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)) КАК БухПартииЦенныхБумагОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&НаДату, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО БухПартииЦенныхБумагОстатки.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
		|		ПО (ВЫБОР
		|				КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФ
		|		ПО (ВЫБОР
		|				КОГДА БухПартииЦенныхБумагОстатки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|					ТОГДА ВЫРАЗИТЬ(БухПартииЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|			КОНЕЦ = РеквизитыПИФ.ПаевойИнвестиционныйФонд)";
	
	УстановитьПараметрыЗапроса(Запрос);
	Запрос.УстановитьПараметр("НаДату", НаДату);

	Остаток = Запрос.Выполнить().Выбрать();
	Пока Остаток.Следующий() Цикл
		Запись = Новый Структура("Количество"); //Новый Структура("Партия, Количество");
		
		ЗаполнитьЗначенияРеквизитов(Запись, Остаток);
		
		Запись.Вставить("Актив", Получить_Актив(Остаток));
		Записи.Добавить(Запись);
	КонецЦикла;
	
	Возврат Новый Структура("Запись", Записи);
	
КонецФункции

Процедура ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Выборка, Префикс = "")
	
	Для Каждого Реквизит Из РеквизитыШапки Цикл
		Если Реквизит.Ключ = "Наименование" И ЗначениеЗаполнено(Реквизит.Значение) Тогда
			Продолжить; //Заполнено ранее
		КонецЕсли;
		
		Если Реквизит.Ключ = "Номер" Тогда
			РеквизитыШапки.Номер = СтрЗаменить(СокрЛП(Выборка.Номер), "RAM-", "");
			
			Пока Лев(РеквизитыШапки.Номер, 1) = "0" Цикл
				РеквизитыШапки.Номер = Сред(РеквизитыШапки.Номер, 2);
			КонецЦикла;
			
		ИначеЕсли Реквизит.Ключ = "UID" И Выборка.Владелец().Колонки.Найти("НомерСтрокиРегистра") <> Неопределено Тогда
			РеквизитыШапки[Реквизит.Ключ] = Строка(Выборка.UID.УникальныйИдентификатор()) + Выборка.НомерСтрокиРегистра;
			
		ИначеЕсли Реквизит.Ключ = "Партия" Тогда
			ДобавитьСправочникКВыгрузке(Выборка[Префикс + Реквизит.Ключ], "Партия");		
			РеквизитыШапки[Реквизит.Ключ] = Строка(Выборка[Префикс + Реквизит.Ключ].УникальныйИдентификатор());
			
		ИначеЕсли Выборка[Префикс + Реквизит.Ключ] = Неопределено Тогда
			ВызватьИсключение "Не задано значение реквизита " + Префикс + Реквизит.Ключ;
			
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Выборка[Префикс + Реквизит.Ключ])) Тогда
			РеквизитыШапки[Реквизит.Ключ] = Строка(Выборка[Префикс + Реквизит.Ключ].УникальныйИдентификатор());
			
		ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Выборка[Префикс + Реквизит.Ключ])) Тогда
			ДобавитьСправочникКВыгрузке(Выборка[Префикс + Реквизит.Ключ]);		
			РеквизитыШапки[Реквизит.Ключ] = Строка(Выборка[Префикс + Реквизит.Ключ].УникальныйИдентификатор());
			
		Иначе
			РеквизитыШапки[Реквизит.Ключ] = Выборка[Префикс + Реквизит.Ключ];
	
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСправочникКВыгрузке(Элемент, ИмяМД = "")
	
	Если НЕ ЗначениеЗаполнено(Элемент) Тогда Возврат; КонецЕсли;
	
	Если ПустаяСтрока(ИмяМД) Тогда
		ИмяМД = Элемент.Метаданные().Имя;
	КонецЕсли;
	
	Если НЕ СправочникиКВыгрузке.Свойство(ИмяМД) Тогда
		СправочникиКВыгрузке.Вставить(ИмяМД, Новый Массив);
	КонецЕсли;
	
	Если СправочникиКВыгрузке[ИмяМД].Найти(Элемент) = Неопределено Тогда
		СправочникиКВыгрузке[ИмяМД].Добавить(Элемент);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивЭлементов(ИмяМассива)
	
	Если СправочникиКВыгрузке.Свойство(ИмяМассива) Тогда
		Возврат СправочникиКВыгрузке[ИмяМассива];
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	
КонецФункции	

Процедура КонтрольНаличияДокументов(ВидДокумента, ДополнительноеУсловиеЗапроса = "")
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Документ.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ВидДокумента + " КАК Документ
		|ГДЕ
		|	Документ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И Документ.Проведен
		|" + ДополнительноеУсловиеЗапроса;
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Нет описания выгрузки документов " + ВидДокумента;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПараметрыЗапроса(Запрос)
	
	Запрос.УстановитьПараметр("Организация",					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ДатаНачала",						ЭтотОбъект.Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ЭтотОбъект.Период.ДатаОкончания);

КонецПроцедуры

