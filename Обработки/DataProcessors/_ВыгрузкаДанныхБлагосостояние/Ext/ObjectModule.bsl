КонецФункции

Функция Получить_ОперацииПоСчетуБрокера()
	
	ОперацияПоСчетуБрокера = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОстаткиДенежныхСредствОбороты.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И Брокер <> ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)) КАК ОстаткиДенежныхСредствОбороты";
	
	УстановитьПараметрыЗапроса(Запрос);

	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Нет описания выгрузки документов ОперацииПоСчетуБрокера";
	КонецЕсли;
	
	Возврат Новый Структура("ОперацияПоСчетуБрокера", ОперацияПоСчетуБрокера);
	
КонецФункции

Функция Получить_Партии()
	
	Партии = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВводЦенныхБумаг.ВерсияДанных КАК ВерсияЭлемента,
		|	ВводЦенныхБумаг.Ссылка КАК UID,
		|	ВводЦенныхБумаг.СчетДоверительногоУправления КАК Портфель,
		|	ВводЦенныхБумаг.Номер КАК Номер,
		|	ВводЦенныхБумаг.Дата КАК Дата,
		|	"""" КАК Контрагент
		|ИЗ
		|	Документ.ВводЦенныхБумаг КАК ВводЦенныхБумаг
		|ГДЕ
		|	ВводЦенныхБумаг.Ссылка В(&Партии)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделке.ВерсияДанных,
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Номер,
		|	ИсполнениеОбязательствПоСделке.Дата,
		|	""""
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка В(&Партии)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КорректировкаРегистров.ВерсияДанных,
		|	КорректировкаРегистров.Ссылка,
		|	КорректировкаРегистров.СчетДоверительногоУправления,
		|	КорректировкаРегистров.Номер,
		|	КорректировкаРегистров.Дата,
		|	""""
		|ИЗ
		|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|ГДЕ
		|	КорректировкаРегистров.Ссылка В(&Партии)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоставкаЦенныхБумаг.ВерсияДанных,
		|	ПоставкаЦенныхБумаг.Ссылка,
		|	ПоставкаЦенныхБумаг.СчетДоверительногоУправления,
		|	ПоставкаЦенныхБумаг.Номер,
		|	ПоставкаЦенныхБумаг.Дата,
		|	""""
		|ИЗ
		|	Документ.ПоставкаЦенныхБумаг КАК ПоставкаЦенныхБумаг
		|ГДЕ
		|	ПоставкаЦенныхБумаг.Ссылка В(&Партии)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Сделка.ВерсияДанных,
		|	Сделка.Ссылка,
		|	Сделка.СчетДоверительногоУправления,
		|	Сделка.Номер,
		|	Сделка.Дата,
		|	Сделка.Контрагент
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Ссылка В(&Партии)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПО.ВерсияДанных,
		|	СделкаРЕПО.Ссылка,
		|	СделкаРЕПО.СчетДоверительногоУправления,
		|	СделкаРЕПО.Номер,
		|	СделкаРЕПО.Дата,
		|	СделкаРЕПО.Контрагент
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Ссылка В(&Партии)";
	
	Запрос.УстановитьПараметр("Партии", СправочникиКВыгрузке.Партия);
	
	ВыборкаПартии = запрос.Выполнить().Выбрать();
	Пока ВыборкаПартии.Следующий() Цикл
		Партия = Новый Структура("ВерсияЭлемента, UID, Портфель, Номер, Дата, Контрагент");
		ЗаполнитьЗначенияРеквизитов(Партия, ВыборкаПартии);
		
		Если НЕ ЗначениеЗаполнено(Партия.Контрагент) Тогда
			Партия.Удалить("Контрагент");
		КонецЕсли;
		
		Партии.Добавить(Партия);
	КонецЦикла;
	
	Возврат Новый Структура("Партия", Партии);
	                   
КонецФункции

Функция Получить_Портфели()
	
	Портфели = Новый Массив;
	
	Портфель = Новый Структура;
	Портфель.Вставить("UID"				, Строка(ЭтотОбъект.СчетДоверительногоУправления.УникальныйИдентификатор()));
	Портфель.Вставить("НомерДоговораДУ"	, ЭтотОбъект.СчетДоверительногоУправления.НомерДоговора);
	Портфель.Вставить("СчетаБрокеров"	, Получить_СчетаБрокеров());
	Портфель.Вставить("БанковскиеСчета"	, Получить_БанковскиеСчетаФонда());
	Портфель.Вставить("СчетаДЕПО"		, Получить_ДепозитарныеСчета());
	
	Портфели.Добавить(Портфель);
	
	
	Возврат Новый Структура("Портфель", Портфели);
	
КонецФункции

Функция Получить_ПоступленияНаРасчетныйСчет()
	
	ПоступлениеНаРасчетныйСчет = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ОплатаОснования.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|ГДЕ
		|	ОплатаОснования.Ссылка.Проведен
		|	И ОплатаОснования.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ОплатаОснования.НомерСтроки = 2
		|	И ОплатаОснования.Ссылка.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ОплатаОснования.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ОплатаОснования.Основание ССЫЛКА Документ.НачислениеДивидендов
		|			ИЛИ ОплатаОснования.Основание ССЫЛКА Документ.ПогашениеКупона)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Регистратор КАК UID,
		|	ОстаткиДенежныхСредств.Регистратор.Дата КАК Дата,
		|	ОстаткиДенежныхСредств.Регистратор.Номер КАК Номер,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК НомерВходящегоДокумента,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента КАК ДатаВходящегоДокумента,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК Портфель,
		|	ОстаткиДенежныхСредств.РасчетныйСчет КАК БанковскийСчетПортфеля,
		|	ОстаткиДенежныхСредств.Валюта.Код КАК Валюта,
		|	ОстаткиДенежныхСредств.Сумма КАК СуммаДокумента,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.Контрагент КАК Плательщик,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента КАК БанковскийСчетПлательщика,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ЕСТЬNULL(ПогашениеКупона.Облигация, НачислениеДивидендов.ЦеннаяБумага) КАК Актив_UID,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ПогашениеКупона.Облигация, НачислениеДивидендов.ЦеннаяБумага) ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Облигация""
		|		КОГДА НачислениеДивидендов.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акция""
		|		КОГДА НачислениеДивидендов.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""ПаиПИФ""
		|	КОНЕЦ КАК Актив_ТипАктива,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Актив_ISIN_Код,
		|	ВЫБОР
		|		КОГДА Акции.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА Акции.ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА Акции.ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + Акции.ВалютаНоминала.Наименование
		|		КОГДА Облигации.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА Облигации.ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА Облигации.ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + Облигации.ВалютаНоминала.Наименование
		|		КОГДА Паи.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА РеквизитыПИФ.КраткоеНаименованиеФонда + "", "" + ВЫБОР
		|					КОГДА Паи.ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА Паи.ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + Паи.ВалютаНоминала.Наименование
		|	КОНЕЦ КАК Актив_Наименование,
		|	ПогашениеКупона.Дата КАК ДатаОкончанияКупонногоПериода,
		|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
		|	ПогашениеКупона.СуммаКупона КАК СуммаНКД,
		|	ОстаткиДенежныхСредств.НомерСтроки КАК НомерСтрокиРегистра,
		|	НачислениеДивидендов.Сумма КАК СуммаДивидендов,
		|	ПриходПроцентовМНО.МНО КАК СделкаМНО,
		|	РеестрПлатежей.СтрокаБанковскойВыписки КАК СтрокаБанковскойВыписки
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ПО ОстаткиДенежныхСредств.Регистратор = РеестрПлатежей.Регистратор
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО ОстаткиДенежныхСредств.Регистратор = ОплатаОснования.Ссылка
		|			И (ОплатаОснования.НомерСтроки = 1)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПогашениеКупона КАК ПогашениеКупона
		|		ПО (ОплатаОснования.Основание = ПогашениеКупона.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеДивидендов КАК НачислениеДивидендов
		|		ПО (ОплатаОснования.Основание = НачислениеДивидендов.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&ДатаОкончания, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО (ЕСТЬNULL(ПогашениеКупона.Облигация, НачислениеДивидендов.ЦеннаяБумага) = КодыВТорговыхСистемахСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Облигации КАК Облигации
		|		ПО (ЕСТЬNULL(ПогашениеКупона.Облигация, НачислениеДивидендов.ЦеннаяБумага) = Облигации.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Акции КАК Акции
		|		ПО (НачислениеДивидендов.ЦеннаяБумага = Акции.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Паи КАК Паи
		|		ПО (НачислениеДивидендов.ЦеннаяБумага = Паи.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриходПроцентовМНО КАК ПриходПроцентовМНО
		|		ПО ОстаткиДенежныхСредств.Регистратор = ПриходПроцентовМНО.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.ПогашениеКупона)
		|					ТОГДА ПогашениеКупона.Облигация.Эмитент.ЮрФизЛицо
		|				КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.НачислениеДивидендов)
		|					ТОГДА ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФ
		|		ПО (ВЫБОР
		|				КОГДА ТИПЗНАЧЕНИЯ(ОплатаОснования.Основание) = ТИП(Документ.НачислениеДивидендов)
		|					ТОГДА ВЫРАЗИТЬ(НачислениеДивидендов.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|			КОНЕЦ = РеквизитыПИФ.ПаевойИнвестиционныйФонд)
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиДенежныхСредств.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И НЕ (ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств)
		|			И ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыПереводовДенежныхСредств.МеждуРасчетнымиСчетами))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидДвиженияДенежныхСредств,
		|	ВариантДвиженияДенежныхСредств";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	Если НЕ ПакетЗапросов[0].Пустой() Тогда
		ВызватьИсключение "Обнаружена исключительная ситуация: в оплате больше одной строки по оплате дивидендов или погашению купона!";
	КонецЕсли;
	
	Шапка = ПакетЗапросов[1].Выбрать();
	Пока Шапка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Шапка.СтрокаБанковскойВыписки) Тогда
			ВызватьИсключение "В документе " + Шапка.UID + " не указана строка банковской выписки";
		КонецЕсли;
		
		РеквизитыШапки = Новый Структура("UID, Дата, Номер, Портфель, БанковскийСчетПортфеля, Валюта, СуммаДокумента, Плательщик, НазначениеПлатежа");
		
		ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Шапка);
		
		РеквизитыШапки.Вставить("ВидОперации",			Получить_ВидОперацииПоступленияНаРасчетныйСчет(Шапка));
		РеквизитыШапки.Вставить("ПервичныйДокумент",	Получить_ПервичныйДокументПоступленияНаРасчетныйСчет(Шапка));
		
		ПоступлениеНаРасчетныйСчет.Добавить(РеквизитыШапки);
	КонецЦикла;
	
	Возврат Новый Структура("ПоступлениеНаРасчетныйСчет", ПоступлениеНаРасчетныйСчет);
	
КонецФункции

