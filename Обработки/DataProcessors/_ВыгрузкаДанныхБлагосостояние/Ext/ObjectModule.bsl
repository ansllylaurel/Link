// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, 
		"Выгрузка данных для фонда Благосостояние", 
		"0.82", 
		"", 
		Истина);
		
	// команды
	
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "КонтрольРасчетаМНО", "Контроль расчёта МНО", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт

	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "КонтрольРасчетаМНО") Тогда
		
		ЭтотОбъект.СчетДоверительногоУправления = ПараметрыКоманды.СчетДоверительногоУправления;
		ЭтотОбъект.Организация	= ЭтотОбъект.СчетДоверительногоУправления.Организация;

		ЭтотОбъект.Период.ДатаОкончания = КонецДня(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДата(), -2));
		
		КонтрольРасчетаМНО(ПараметрыКоманды.ПолучателиОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольРасчетаМНО(ПолучателиОповещения = "") Экспорт
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "Организация, СчетДоверительногоУправления, Период", Новый Структура("ПолучателиОповещения", ПолучателиОповещения)); 
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".КонтрольРасчетаМНО()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);

	ТемаПисьма	= "Повторная выгрузка по договору " + ЭтотОбъект.СчетДоверительногоУправления;
	ТекстПисьма	= "";
	
	ИндексРУОНИА = ОбщегоНазначения.ПолучитьИменованныйОбъект("Индекс_РУОНИА");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	ЭтотОбъект.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("ИндексРУОНИА",					ИндексРУОНИА);
	Запрос.УстановитьПараметр("Период",							ЭтотОбъект.Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ПериодГраница",					Новый Граница(ЭтотОбъект.Период.ДатаОкончания, ВидГраницы.Включая));
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДенежныеСредстваМНООстатки.МНО КАК МНО,
		|	ДенежныеСредстваМНООстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваМНО.Остатки(
		|			&ПериодГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДенежныеСредстваМНООстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияБиржевыхИндексов.БиржевойИндекс КАК БиржевойИндекс,
		|	ЗначенияБиржевыхИндексов.CLOSE КАК CLOSE
		|ИЗ
		|	РегистрСведений.ЗначенияБиржевыхИндексов КАК ЗначенияБиржевыхИндексов
		|ГДЕ
		|	ЗначенияБиржевыхИндексов.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|	И ЗначенияБиржевыхИндексов.БиржевойИндекс = &ИндексРУОНИА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ФинансовыеПоказатели.Значение КАК СЧА
		|ИЗ
		|	РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|ГДЕ
		|	ФинансовыеПоказатели.Организация = &Организация
		|	И ФинансовыеПоказатели.Активность
		|	И ФинансовыеПоказатели.СубъектАналитики = &СчетДоверительногоУправления
		|	И ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|	И ФинансовыеПоказатели.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики КАК МНО,
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СуммаРынок КАК ПроцентыМНО,
		|	1 КАК Флаг
		|ИЗ
		|	РегистрСведений.СтоимостьАктивовНеОтносящихсяКЦеннымБумагам КАК СтоимостьАктивовНеОтносящихсяКЦеннымБумагам
		|ГДЕ
		|	СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Организация = &Организация
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Активность
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.СубъектАналитики ССЫЛКА Документ.МНО
		|	И СтоимостьАктивовНеОтносящихсяКЦеннымБумагам.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)";
	
#КонецОбласти

	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ЕстьМНО		= (НЕ ПакетЗапросов[0].Пустой());
	ЕстьРУОНИА 	= (НЕ ПакетЗапросов[1].Пустой());
	ЕстьСЧА		= (НЕ ПакетЗапросов[2].Пустой());
	
	Если ЕстьМНО Тогда
		Если НЕ ЕстьРУОНИА Тогда
			ТекстПисьма = 
				"Не загружено значение ставки ROUNIA на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ".
				|Нет возможности проверить МНО на рыночность";
		ИначеЕсли НЕ ЕстьСЧА Тогда
			ТекстПисьма = 
				"Не зарегистрирована СЧА на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
			
		Иначе
			ТаблицаМНО = ПакетЗапросов[3].Выгрузить();
			
			Отказ = Ложь;
			
			НовыйРасчетМНО = РаботаСМНО.ПолучитьСтоимостиМНОСчетуДоверительногоУправления(
				ЭтотОбъект.СчетДоверительногоУправления, 
				Перечисления.ВидыУчета.БухгалтерскийУчет, 
				Ложь,
				КонецДня(ЭтотОбъект.Период.ДатаОкончания),
				Справочники.ЦелиРасчета.ОценкаОбъектовВУправлении,
				Отказ);
			
			Если Отказ Тогда
				ТекстПисьма = 
					"Не удалось рассчитать МНО на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
			Иначе
				Для Каждого СтрокаМНО Из НовыйРасчетМНО Цикл
					Если СтрокаМНО.ПроцентыМНО <> 0 Тогда
						НоваяСтрокаМНО = ТаблицаМНО.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаМНО, СтрокаМНО);
						НоваяСтрокаМНО.Флаг = -1;
					КонецЕсли;
				КонецЦикла;
				
				ТаблицаМНО.Свернуть("МНО, ПроцентыМНО", "Флаг");
				
				Если ТаблицаМНО.Количество() <> ТаблицаМНО.НайтиСтроки(Новый Структура("Флаг", 0)).Количество() Тогда
					ТекстПисьма = 
						"Изменилась оценка МНО на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + ".
						|Необходимо переформировать учёт и повторно направить выгрузку клиенту";	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолучателиОповещения) Тогда
		Если ЗначениеЗаполнено(ТекстПисьма) Тогда
			РаботаСЭлектроннойПочтой.ОтправитьПростоеЭлектронноеПисьмо(ПолучателиОповещения, ТемаПисьма, ТекстПисьма);		
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ТекстПисьма) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПисьма);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Расхождений на " + Формат(ЭтотОбъект.Период.ДатаОкончания, "ДФ=dd.MM.yyyy") + " не обнаружено.");
		КонецЕсли;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
КонецПроцедуры

#Область Автоматизация_формирования_отчета

Функция ПолучитьДоступныеНастройки() Экспорт

	Настройки = Новый Массив;
	Настройки.Добавить("ВариантОпределенияНачальнойДаты");
	Настройки.Добавить("ПутьКФайлу");
	Настройки.Добавить("СрокПредоставления");
	Настройки.Добавить("Подписант");
	
	Возврат Настройки;

КонецФункции

Процедура АвтоматическоеФормирование(НастройкиОтчета) Экспорт

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиОтчета);
	ЭтотОбъект.Подписант = НастройкиОтчета.Подписант.КонтактноеЛицо;
	
	ИмяВременногоФайла = ВыгрузитьДанные();
	
	Если ИмяВременногоФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОтчета.Вставить("Результат", Новый ДвоичныеДанные(ИмяВременногоФайла));
	
	УдалитьФайлы(ИмяВременногоФайла);
	
КонецПроцедуры

#КонецОбласти

#Область Получение_пакета_данных

Функция ПолучитьПакетДанных() Экспорт
	
	Пакет = Новый Структура;
	Пакет.Вставить("ВерсияФормата"						, "1.3.30");
	Пакет.Вставить("ВерсияФайла"						, Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
	Пакет.Вставить("СопроводительныеДанные"				, Получить_СопроводительныеДанные());
	Пакет.Вставить("Операции"							, Получить_Операции());
	Пакет.Вставить("СостояниеПортфеляНаНачалоПериода"	, Получить_СостояниеПортфеля(ЭтотОбъект.Период.ДатаНачала));
	Пакет.Вставить("СостояниеПортфеляНаКонецПериода"	, Получить_СостояниеПортфеля(ЭтотОбъект.Период.ДатаОкончания));
	Пакет.Вставить("НСИ"								, Получить_НСИ());
	
	Возврат Пакет;
	
КонецФункции

Функция Получить_Актив(Выборка)
	
	Актив = Новый Структура("UID,ТипАктива,ISIN_Код,Наименование");
	
	ЗаполнитьЗначенияРеквизитов(Актив, Выборка, "Актив_");
	
	Возврат Актив;
	
КонецФункции

Функция Получить_БанковскийСчет(Выборка)
	
	БанковскийСчет = Новый Структура("ВерсияЭлемента,UID,Наименование,НомерСчета,Банк");
	БанковскийСчет.Наименование = СформироватьНаименованиеБанковскогоСчета(Выборка.БанковскийСчет_UID);
	
	ЗаполнитьЗначенияРеквизитов(БанковскийСчет, Выборка, "БанковскийСчет_");
	
	Возврат БанковскийСчет;
	
КонецФункции

Функция Получить_БанковскиеСчетаФонда()
	
	БанковскиеСчетаФонда = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.ВерсияДанных КАК ВерсияЭлемента,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Ссылка КАК UID,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.НомерСчета КАК НомерСчета,
		|	ВЫБОР
		|		КОГДА ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.ВидБанковскогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.ДепозитныйСчет)
		|			ТОГДА ""Депозитный""
		|		ИНАЧЕ ""Расчетный""
		|	КОНЕЦ КАК ВидСчета,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Банк.Код КАК Банк,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Валюта.Код КАК Валюта,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор КАК Договор_UID,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК Договор_Портфель,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.НомерДоговора КАК Договор_НомерДоговора,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.ДатаЗаключения КАК Договор_ДатаДоговора,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.Организация.ВалютаУчета.Код КАК Договор_Валюта,
		|	""Банковского счета"" КАК Договор_РольДоговора,
		|	ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(1, 1, 1)) КАК Договор_ДатаОкончания,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.ВидБанковскогоСчета = ЗНАЧЕНИЕ(Перечисление.ВидыБанковскихСчетов.ДепозитныйСчет) КАК НачислениеПроцентов
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ДатаНачала, ) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО (УсловияДоговоровОбщиеСрезПоследних.Договор = ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор)
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет.Договор.ДатаЗаключения <= &ДатаОкончания
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &ДатаНачала)";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	ВыборкаБанковскиеСчетаФонда = Запрос.Выполнить().Выбрать();
	Пока ВыборкаБанковскиеСчетаФонда.Следующий() Цикл
		БанковскийСчет = Новый Структура("ВерсияЭлемента, UID, Наименование, НомерСчета, ВидСчета, Банк, Валюта, НачислениеПроцентов");
		БанковскийСчет.Наименование = СформироватьНаименованиеБанковскогоСчета(ВыборкаБанковскиеСчетаФонда.UID);
		
		ЗаполнитьЗначенияРеквизитов(БанковскийСчет, ВыборкаБанковскиеСчетаФонда);
		
		БанковскийСчет.Вставить("Договор", Получить_ДоговорКонтрагента(ВыборкаБанковскиеСчетаФонда));
		
		БанковскиеСчетаФонда.Добавить(БанковскийСчет);
	КонецЦикла;
	
	Возврат Новый Структура("БанковскийСчет", БанковскиеСчетаФонда);
	
КонецФункции

