	Запрос.УстановитьПараметр("МассивДоговоры"							, ПолучитьМассивЭлементов("Договоры"));
	Запрос.УстановитьПараметр("МассивДоговорыБрокерскогоОбслуживания"	, ПолучитьМассивЭлементов("ДоговорыБрокерскогоОбслуживания"));
	Запрос.УстановитьПараметр("МассивБанковскиеСчета"					, ПолучитьМассивЭлементов("БанковскиеСчета"));
	Запрос.УстановитьПараметр("НКО_НКЦ"									, НКО_НКЦ);	
	Запрос.УстановитьПараметр("ДоговорыСНКО_НКЦ"						, ДоговорыСНКО_НКЦ);	
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаКонтрагенты		= ПакетЗапросов[2].Выбрать();
	ТаблицаДоговоров		= ПакетЗапросов[3].Выгрузить();
	ТаблицаБанковскихСчетов	= ПакетЗапросов[4].Выгрузить();
	
	Пока ВыборкаКонтрагенты.Следующий() Цикл
		Контрагент = Новый Структура("UID, Наименование, ИНН_TIN, КПП");
		
		ЗаполнитьЗначенияРеквизитов(Контрагент, ВыборкаКонтрагенты);
		
		ТолькоБанковскиеДоговора = Истина;
		
		Договоры = Новый Массив;
		ПараметрыПоиска = Новый Структура("ЮрФизЛицо", ВыборкаКонтрагенты.UID);
		НайденныеСтроки = ТаблицаДоговоров.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаДоговоров Из НайденныеСтроки Цикл
			Договоры.Добавить(Получить_ДоговорКонтрагента(СтрокаДоговоров));
			Если СокрЛП(СтрокаДоговоров.Договор_РольДоговора) <> "Банковского счета" Тогда
				ТолькоБанковскиеДоговора = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Контрагент.Вставить("ДоговорыКонтрагентов", Новый Структура("ДоговорКонтрагента", Договоры));
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			ТолькоБанковскиеДоговора = Ложь;	
		КонецЕсли;
		
		БанковскиеСчета = Новый Массив;
		ПараметрыПоиска = Новый Структура("ЮрФизЛицо", ВыборкаКонтрагенты.UID);
		НайденныеСтроки = ТаблицаБанковскихСчетов.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаБанковскихСчетов Из НайденныеСтроки Цикл
			Если НЕ ТолькоБанковскиеДоговора Тогда
				БанковскиеСчета.Добавить(Получить_БанковскийСчет(СтрокаБанковскихСчетов));
			КонецЕсли;
		КонецЦикла;
		
		Контрагент.Вставить("БанковскиеСчета", Новый Структура("БанковскийСчет", БанковскиеСчета));
		
		
		Контрагенты.Добавить(Контрагент);
	КонецЦикла;
	
	Возврат Новый Структура("Контрагент", Контрагенты);
	
КонецФункции

Функция Получить_МестоХранения(МестоХраненияЦБИсточник)
	
	МестоХраненияЦБ = Новый Структура("ТипМестаХранения", Новый Структура);
	
	Если ТипЗнч(МестоХраненияЦБИсточник) = Тип("СправочникСсылка.ДепозитарныеСчета") Тогда
		Если МестоХраненияЦБИсточник.ТипСчета = Перечисления.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета Тогда 
			МестоХраненияЦБ.ТипМестаХранения.Вставить("СчетДепо", МестоХраненияЦБИсточник.Родитель);
		Иначе 
			МестоХраненияЦБ.ТипМестаХранения.Вставить("СчетДепо", МестоХраненияЦБИсточник);
		КонецЕсли;
	ИначеЕсли ТипЗнч(МестоХраненияЦБИсточник) = Тип("СправочникСсылка.БрокерскиеКомпании") Тогда
		МестоХраненияЦБ.ТипМестаХранения.Вставить("СчетБрокера", МестоХраненияЦБИсточник);
		
	КонецЕсли;
	
	Возврат МестоХраненияЦБ;
	
КонецФункции

Функция Получить_НачисленияВознаграждения()
	
	НачислениеВознаграждения = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеЗадолженности.Ссылка КАК UID,
		|	НачислениеЗадолженности.Ссылка.Дата КАК Дата,
		|	НачислениеЗадолженности.Ссылка.Номер КАК Номер,
		|	НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления КАК Портфель,
		|	НачислениеЗадолженности.Ссылка.Валюта.Код КАК ВалютаДокумента,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА ""УправляющаяКомпания""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария)
		|			ТОГДА ""СпецДепозитарий""
		|	КОНЕЦ КАК ВидКонтагента,
		|	ЛОЖЬ КАК ЗаУспех,
		|	НачислениеЗадолженности.Ссылка.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления
		|		ИНАЧЕ НачислениеЗадолженности.Ссылка.Договор
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	СУММА(НачислениеЗадолженности.Сумма) КАК СуммаВознаграждения,
		|	НачислениеЗадолженности.Ссылка.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	НачислениеЗадолженности.Ссылка.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	НачислениеЗадолженности.Ссылка.ПрочиеДоходыИРасходы.Наименование КАК СтатьяДоходовИРасходов
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженности
		|ГДЕ
		|	НачислениеЗадолженности.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ИЛИ НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария))
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеЗадолженности.Ссылка,
		|	НачислениеЗадолженности.Ссылка.Дата,
		|	НачислениеЗадолженности.Ссылка.Номер,
		|	НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Ссылка.Контрагент,
		|	НачислениеЗадолженности.Ссылка.Валюта.Код,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления
		|		ИНАЧЕ НачислениеЗадолженности.Ссылка.Договор
		|	КОНЕЦ,
		|	НачислениеЗадолженности.Ссылка.ДатаВходящегоДокумента,
		|	НачислениеЗадолженности.Ссылка.НомерВходящегоДокумента,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|			ТОГДА ""УправляющаяКомпания""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария)
		|			ТОГДА ""СпецДепозитарий""
		|	КОНЕЦ";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Шапка = Запрос.Выполнить().Выбрать();
	Пока Шапка.Следующий() Цикл
		РеквизитыШапки = Новый Структура("UID, Дата, Номер, Портфель, ВалютаДокумента, ВидКонтагента, ЗаУспех, Контрагент, ДоговорКонтрагента, СуммаВознаграждения, ДатаВходящегоДокумента, НомерВходящегоДокумента, СтатьяДоходовИРасходов");
		ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Шапка);
		НачислениеВознаграждения.Добавить(РеквизитыШапки);
	КонецЦикла;
	
	Возврат Новый Структура("НачислениеВознаграждения", НачислениеВознаграждения);
	
КонецФункции	

Функция Получить_НачисленияЗадолженностей()
	
	НачислениеЗадолженности = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НачислениеЗадолженности.Ссылка КАК UID,
		|	НачислениеЗадолженности.Ссылка.Дата КАК Дата,
		|	НачислениеЗадолженности.Ссылка.Номер КАК Номер,
		|	НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления КАК Портфель,
		|	НачислениеЗадолженности.Ссылка.Контрагент КАК Контрагент,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.БанковскаяКомиссия)
		|				ИЛИ НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБанковскойКомиссии)
		|			ТОГДА НачислениеЗадолженности.Ссылка.РасчетныйСчет.Договор
		|		ИНАЧЕ НачислениеЗадолженности.Ссылка.Договор
		|	КОНЕЦ КАК ДоговорКонтрагента,
		|	НачислениеЗадолженности.Ссылка.Валюта.Код КАК ВалютаВзаиморасчетов,
		|	СУММА(НачислениеЗадолженности.Сумма) КАК СуммаДокумента,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|				И НачислениеЗадолженности.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА ""Комиссия за обслуживание брокерского счета""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ТОГДА ""Комиссия за исполнение поручений ""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО)
		|			ТОГДА ""Расходы по расчетному и кассовому обслуживанию""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС)
		|			ТОГДА ""Расходы на услуги по переводам денежных средств, включая услуги платежных и расчетных систем""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета)
		|			ТОГДА ""Расходы по открытию и ведению банковских счетов""
		|		ИНАЧЕ НачислениеЗадолженности.Ссылка.ПрочиеДоходыИРасходы.Наименование
		|	КОНЕЦ КАК СтатьяДоходовИРасходов
		|ИЗ
		|	Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженности
		|ГДЕ
		|	НачислениеЗадолженности.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НачислениеЗадолженности.Ссылка.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоВознаграждениюУправляющего)
		|	И НачислениеЗадолженности.Ссылка.ВидЗадолженности <> ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.РасходыПоУслугамСпецДепозитария)
		|
		|СГРУППИРОВАТЬ ПО
		|	НачислениеЗадолженности.Ссылка,
		|	НачислениеЗадолженности.Ссылка.Дата,
		|	НачислениеЗадолженности.Ссылка.Номер,
		|	НачислениеЗадолженности.Ссылка.СчетДоверительногоУправления,
		|	НачислениеЗадолженности.Ссылка.Контрагент,
		|	НачислениеЗадолженности.Ссылка.Валюта.Код,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности.Родитель = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.БанковскаяКомиссия)
		|				ИЛИ НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБанковскойКомиссии)
		|			ТОГДА НачислениеЗадолженности.Ссылка.РасчетныйСчет.Договор
		|		ИНАЧЕ НачислениеЗадолженности.Ссылка.Договор
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|				И НачислениеЗадолженности.Основание = НЕОПРЕДЕЛЕНО
		|			ТОГДА ""Комиссия за обслуживание брокерского счета""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
		|			ТОГДА ""Комиссия за исполнение поручений ""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаБанкКлиентИРКО)
		|			ТОГДА ""Расходы по расчетному и кассовому обслуживанию""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаЗаПереводДС)
		|			ТОГДА ""Расходы на услуги по переводам денежных средств, включая услуги платежных и расчетных систем""
		|		КОГДА НачислениеЗадолженности.Ссылка.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.КомиссияБанкаОткрытиеИВедениеСчета)
		|			ТОГДА ""Расходы по открытию и ведению банковских счетов""
		|		ИНАЧЕ НачислениеЗадолженности.Ссылка.ПрочиеДоходыИРасходы.Наименование
		|	КОНЕЦ";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Шапка = Запрос.Выполнить().Выбрать();
	Пока Шапка.Следующий() Цикл
		РеквизитыШапки = Новый Структура("UID, Дата, Номер, Портфель, Контрагент, ДоговорКонтрагента, ВалютаВзаиморасчетов, СуммаДокумента, СтатьяДоходовИРасходов");
		ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Шапка);
		НачислениеЗадолженности.Добавить(РеквизитыШапки);
	КонецЦикла;
	
	Возврат Новый Структура("НачислениеЗадолженности", НачислениеЗадолженности);
	
КонецФункции

Функция Получить_НСИ()
	
	НСИ = Новый Структура;
	НСИ.Вставить("Портфели"		, Получить_Портфели()); 
	//НСИ.Вставить("Партии"		, Получить_Партии()); 
	НСИ.Вставить("Контрагенты"	, Получить_Контрагенты()); 
	
	Возврат НСИ;
	
КонецФункции

Функция Получить_Операции()
	
	Операции = Новый Структура;
	Операции.Вставить("ВводыЦенныхБумагВДУ"			, Получить_ВводыЦенныхБумагВДУ()); 
	Операции.Вставить("ВыводыЦенныхБумагИзДУ"		, Получить_ВыводыЦенныхБумагИзДУ()); 
	Операции.Вставить("Сделки"						, Получить_Сделки()); 
	Операции.Вставить("ИсполнениеСделокTn"			, Получить_ИсполнениеСделокTn()); 
	Операции.Вставить("СделкиРЕПО"					, Получить_СделкиРЕПО()); 
	Операции.Вставить("ИсполнениеСделокРЕПО"		, Получить_ИсполнениеСделокРЕПО()); 
	Операции.Вставить("ОперацииПоСчетуБрокера"		, Получить_ОперацииПоСчетуБрокера()); 
	Операции.Вставить("ПоступленияНаРасчетныйСчет"	, Получить_ПоступленияНаРасчетныйСчет()); 
	Операции.Вставить("СписанияСрасчетногоСчета"	, Получить_СписанияСрасчетногоСчета()); 
	Операции.Вставить("НачисленияЗадолженностей"	, Получить_НачисленияЗадолженностей()); 
	Операции.Вставить("НачисленияЗадолженностей"	, Получить_НачисленияЗадолженностей()); 
	Операции.Вставить("НачисленияВознаграждения"	, Получить_НачисленияВознаграждения()); 
	Операции.Вставить("СрочныеСделки"				, Получить_СрочныеСделки()); 
	Операции.Вставить("КлирингСрочныхИнструментов"	, Получить_КлирингСрочныхИнструментов()); 
	Операции.Вставить("СделкиМНО"					, Получить_СделкиМНО()); 
