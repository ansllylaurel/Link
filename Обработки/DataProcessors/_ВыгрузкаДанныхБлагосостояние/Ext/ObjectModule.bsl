Функция Получить_СписанияСрасчетногоСчета()
	
	СписаниеСРасчетногоСчета = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредств.Регистратор КАК UID,
		|	ОстаткиДенежныхСредств.Регистратор.Дата КАК Дата,
		|	ОстаткиДенежныхСредств.Регистратор.Номер КАК Номер,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК НомерВходящегоДокумента,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.ДатаПлатежногоДокумента КАК ДатаВходящегоДокумента,
		|	ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК Портфель,
		|	ОстаткиДенежныхСредств.РасчетныйСчет КАК БанковскийСчетПортфеля,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств)
		|			ТОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|		ИНАЧЕ РеестрПлатежей.СтрокаБанковскойВыписки.Контрагент
		|	КОНЕЦ КАК Получатель,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента КАК БанковскийСчетПолучателя,
		|	ОстаткиДенежныхСредств.Валюта.Код КАК Валюта,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ОстаткиДенежныхСредств.Сумма КАК СуммаДокумента,
		|	ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств КАК ВидДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.ВариантДвиженияДенежныхСредств КАК ВариантДвиженияДенежныхСредств,
		|	ОстаткиДенежныхСредств.НомерСтроки КАК НомерСтрокиРегистра,
		|	ЕСТЬNULL(ОстаткиДенежныхСредств.Регистратор.Основание.НомерВходящегоДокумента, """") КАК ПервичныйДокумент,
		|	РеестрПлатежей.СтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Валюта.Код КАК ВалютаСчетаПолучателя,
		|	РеестрПлатежейПолучателя.Сумма КАК СуммаВВалютеСчетаПолучателя,
		|	ВЫБОР
		|		КОГДА ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств)
		|				И РеестрПлатежейПолучателя.Сумма ЕСТЬ НЕ NULL 
		|			ТОГДА ОстаткиДенежныхСредств.Сумма / РеестрПлатежейПолучателя.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК КурсВалютыСчетаПолучателя,
		|	1 КАК КратностьВалютыСчетаПолучателя
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств КАК ОстаткиДенежныхСредств
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ПО ОстаткиДенежныхСредств.Регистратор = РеестрПлатежей.Регистратор
		|			И (ВЫБОР ОстаткиДенежныхСредств.ВидДвижения
		|				КОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|				КОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			КОНЕЦ = РеестрПлатежей.ВидДвижения)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрПлатежей КАК РеестрПлатежейПолучателя
		|		ПО ОстаткиДенежныхСредств.Регистратор = РеестрПлатежейПолучателя.Регистратор
		|			И (ОстаткиДенежныхСредств.ВидДвиженияДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств))
		|			И (ВЫБОР ОстаткиДенежныхСредств.ВидДвижения
		|				КОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|				КОГДА ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|					ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			КОНЕЦ = РеестрПлатежейПолучателя.ВидДвижения)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&ДатаОкончания, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ОстаткиДенежныхСредств.СчетДоверительногоУправления = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	ОстаткиДенежныхСредств.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ОстаткиДенежныхСредств.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ОстаткиДенежныхСредств.Брокер = ЗНАЧЕНИЕ(Справочник.БрокерскиеКомпании.ПустаяСсылка)
		|	И ОстаткиДенежныхСредств.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидДвиженияДенежныхСредств,
		|	ВариантДвиженияДенежныхСредств";
	
	УстановитьПараметрыЗапроса(Запрос);
	
	Шапка = Запрос.Выполнить().Выбрать();
	Пока Шапка.Следующий() Цикл
		РеквизитыШапки = Новый Структура("UID, Дата, Номер, Портфель, БанковскийСчетПортфеля, Получатель, БанковскийСчетПолучателя, Валюта, НазначениеПлатежа, СуммаДокумента");
		
		Если Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата 
			И (Шапка.ВариантДвиженияДенежныхСредств = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии
			ИЛИ Шапка.ВариантДвиженияДенежныхСредств.Родитель = Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
			РеквизитыШапки.Удалить("БанковскийСчетПолучателя");
		ИначеЕсли Шапка.ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств Тогда
			РеквизитыШапки.Удалить("БанковскийСчетПолучателя");
		КонецЕсли;
		
		ЗаполнитьЗначенияРеквизитов(РеквизитыШапки, Шапка);
		
		РеквизитыШапки.Вставить("ВидОперации",			Получить_ВидОперацииСписанияСРасчетногоСчета(Шапка));
		РеквизитыШапки.Вставить("ПервичныйДокумент",	Шапка.ПервичныйДокумент);
		
		СписаниеСРасчетногоСчета.Добавить(РеквизитыШапки);
	КонецЦикла;
	
	Возврат Новый Структура("СписаниеСРасчетногоСчета", СписаниеСРасчетногоСчета);
	
КонецФункции

Функция Получить_СопроводительныеДанные()
	
	СопроводительныеДанные = Новый Структура;
	
	СопроводительныеДанные.Вставить("УправляющаяКомпания"	, Организация.ЮрФизЛицо);
	СопроводительныеДанные.Вставить("ДатаНачалаПериода"		, ЭтотОбъект.Период.ДатаНачала);
	СопроводительныеДанные.Вставить("ДатаОкончанияПериода"	, ЭтотОбъект.Период.ДатаНачала);
	СопроводительныеДанные.Вставить("ДатаПодготовки"		, ТекущаяДата());
	СопроводительныеДанные.Вставить("АвторВыгрузки"			, Строка(Подписант));
	
	//Вызов сериализации
	ЗаполнитьЗначенияРеквизитов(СопроводительныеДанные, СопроводительныеДанные);
	
	Возврат СопроводительныеДанные;
	
КонецФункции

Функция Получить_СостояниеПортфеля(НаДату)
	
	МассивСостоянийПортфелей = Новый Массив;
	
	СостояниеПортфеля = Новый Структура;
	СостояниеПортфеля.Вставить("Портфель", ЭтотОбъект.СчетДоверительногоУправления);
	СостояниеПортфеля.Вставить("ДатаСверки", НаДату);
	СостояниеПортфеля.Вставить("ФинансовыеИнструменты",		Получить_ФинансовыеИнструменты(НаДату));
	СостояниеПортфеля.Вставить("ДенежныеСредства",			Получить_ДенежныеСредства(НаДату));
	СостояниеПортфеля.Вставить("ЗадолженностьКонтрагентов",	Получить_ЗадолженностьКонтрагентов(НаДату));
	СостояниеПортфеля.Вставить("СправедливаяСтоимость",		Получить_СправедливаяСтоимость(НаДату));
	
	МассивСостоянийПортфелей.Добавить(СостояниеПортфеля);
	
	Возврат МассивСостоянийПортфелей;
	
КонецФункции

Функция Получить_СправедливаяСтоимость(НаДату)
	
	Записи = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьПереоценки.ЦеннаяБумага КАК Актив_UID,
		|	КодыВТорговыхСистемахСрезПоследних.Код КАК Актив_ISIN_Код,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА ""Акция""
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ""Облигация""
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА ""ПаиПИФ""
		|	КОНЕЦ КАК Актив_ТипАктива,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).ВалютаНоминала.Наименование
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА РеквизитыЭмитента.СокращенноеНаименование + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала.Наименование
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|			ТОГДА РеквизитыПИФ.КраткоеНаименованиеФонда + "", "" + ВЫБОР
		|					КОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер <> """"
		|						ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ГосударственныйРегистрационныйНомер
		|					ИНАЧЕ КодыВТорговыхСистемахСрезПоследних.Код
		|				КОНЕЦ + "", "" + ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ВалютаНоминала.Наименование
		|	КОНЕЦ КАК Актив_Наименование,
		|	СтоимостьПереоценки.Организация.ВалютаУчета.Наименование КАК Валюта,
		|	СтоимостьПереоценки.УровеньОценки КАК УровеньИерархии,
		|	ВЫБОР
		|		КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|			ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.Цена * 100 / НоминалыЦенныхБумагСрезПоследних.Номинал КАК ЧИСЛО(19, 4))
		|		ИНАЧЕ СтоимостьПереоценки.Цена
		|	КОНЕЦ КАК СправедливаяЦенаЕПС
		|ИЗ
		|	(ВЫБРАТЬ
		|		СтоимостьПереоценки.Организация КАК Организация,
		|		СтоимостьПереоценки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		СтоимостьПереоценки.ЦельРасчета КАК ЦельРасчета,
		|		СтоимостьПереоценки.ВидЦеныОценки КАК ВидЦеныОценки,
		|		СтоимостьПереоценки.ВидУчета КАК ВидУчета,
		|		СтоимостьПереоценки.Период КАК Период
		|	ИЗ
		|		РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|	ГДЕ
		|		СтоимостьПереоценки.Период = &Период
		|		И СтоимостьПереоценки.Организация = &Организация
		|		И СтоимостьПереоценки.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|		И СтоимостьПереоценки.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет)
		|		И СтоимостьПереоценки.ВидЦеныОценки = ЗНАЧЕНИЕ(Перечисление.ВидыЦенОценки.ЦенаОценки)
		|		И СтоимостьПереоценки.ЦельРасчета = ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ЕдиныйПланСчетов)) КАК СтоимостьПереоценкиНаДату
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьПереоценки КАК СтоимостьПереоценки
		|		ПО СтоимостьПереоценкиНаДату.Организация = СтоимостьПереоценки.Организация
		|			И СтоимостьПереоценкиНаДату.СчетДоверительногоУправления = СтоимостьПереоценки.СчетДоверительногоУправления
		|			И СтоимостьПереоценкиНаДату.ЦельРасчета = СтоимостьПереоценки.ЦельРасчета
		|			И СтоимостьПереоценкиНаДату.ВидЦеныОценки = СтоимостьПереоценки.ВидЦеныОценки
		|			И СтоимостьПереоценкиНаДату.ВидУчета = СтоимостьПереоценки.ВидУчета
		|			И СтоимостьПереоценкиНаДату.Период = СтоимостьПереоценки.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыВТорговыхСистемахСрезПоследних
		|		ПО (СтоимостьПереоценки.ЦеннаяБумага = КодыВТорговыхСистемахСрезПоследних.Объект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО (СтоимостьПереоценки.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&ДатаОкончания,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЭмитента
		|		ПО (ВЫБОР
		|				КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Акции
		|					ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Акции).Эмитент.ЮрФизЛицо
		|				КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Облигации
		|					ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.ЮрФизЛицо
		|			КОНЕЦ = РеквизитыЭмитента.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&ДатаОкончания, ) КАК РеквизитыПИФ
		|		ПО (ВЫБОР
		|				КОГДА СтоимостьПереоценки.ЦеннаяБумага ССЫЛКА Справочник.Паи
		|					ТОГДА ВЫРАЗИТЬ(СтоимостьПереоценки.ЦеннаяБумага КАК Справочник.Паи).ПаевойИнвестиционныйФонд
		|			КОНЕЦ = РеквизитыПИФ.ПаевойИнвестиционныйФонд)";
	
	УстановитьПараметрыЗапроса(Запрос);
	Запрос.УстановитьПараметр("Период", НаДату - 1);

	СправедливаяСтоимость = Запрос.Выполнить().Выбрать();
	Пока СправедливаяСтоимость.Следующий() Цикл
		Запись = Новый Структура("Валюта, УровеньИерархии, СправедливаяЦенаЕПС");
		ЗаполнитьЗначенияРеквизитов(Запись, СправедливаяСтоимость);
		Запись.Вставить("Актив", Получить_Актив(СправедливаяСтоимость));
		Записи.Добавить(Запись);
	КонецЦикла;
	
	Возврат Новый Структура("Запись", Записи);
	
КонецФункции	

