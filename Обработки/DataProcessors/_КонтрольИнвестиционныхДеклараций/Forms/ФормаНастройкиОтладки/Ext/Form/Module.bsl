
&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	
	АдресНастроек = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
	ЭтаФорма.Закрыть(ПоместитьНастройкиВХранилище(АдресНастроек));
	
КонецПроцедуры

&НаСервере
Функция ПоместитьНастройкиВХранилище(АдресНастроек);

	ТекСтрока = СохраненныеНастройки.НайтиПоИдентификатору(Элементы.СохраненныеНастройки.ТекущаяСтрока);
	
	СтруктураНастроек = Новый Структура("Организация, Период, СчетДоверительногоУправления, ИнвестиционнаяДекларация, СовокупнаяИнвестДекларация, УчитыватьПлановыеОперации, ДинамическийРасчетСтоимости, РежимКонтроля, РежимГрупповогоКонтроля, Комментарий");
	
	ЗаполнитьЗначенияСвойств(СтруктураНастроек, ТекСтрока);
	
	СтруктураНастроек.Вставить("ИдентификаторНастроек", 			ТекСтрока.Идентификатор);
	СтруктураНастроек.Вставить("Претрейд", 							ТекСтрока.Претрейд.Выгрузить());
	СтруктураНастроек.Вставить("СоставГрупповогоКонтроля", 			ТекСтрока.СоставГрупповогоКонтроля.Выгрузить());
	СтруктураНастроек.Вставить("СоставСовокупнойИнвестДекларации", 	ТекСтрока.СоставСовокупнойИнвестДекларации.Выгрузить());
	Если ТекСтрока.РезультатСохранен Тогда
		СтруктураНастроек.Вставить("Результат", 						ПолучитьИзВременногоХранилища(ТекСтрока.Результат));	
	КонецЕсли; 
		
	ПоместитьВоВременноеХранилище(СтруктураНастроек, АдресНастроек);
	Возврат АдресНастроек;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторНастроек = Параметры.ИдентификаторНастроек;
	ЗаполнитьСохраненныеНастройки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСохраненныеНастройки()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХранилищеЗначений.Идентификатор КАК Идентификатор,
		|	ХранилищеЗначений.ХранилищеЗначения КАК ХранилищеЗначения,
		|	ХранилищеЗначений.ДатаСоздания КАК ДатаСоздания,
		|	ХранилищеЗначений.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ХранилищеЗначений КАК ХранилищеЗначений
		|ГДЕ
		|	ХранилищеЗначений.Источник = ""СохраненныеНастройкиКИД""
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаСоздания УБЫВ,
		|	ВЫРАЗИТЬ(ХранилищеЗначений.Комментарий КАК СТРОКА(500))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеЭлементы = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ЗначениеНастройки = Выборка.ХранилищеЗначения.Получить();
		
		Если ДобавляемыеРеквизиты.Количество() = 0 Тогда
		
			Для каждого Колонка Из ЗначениеНастройки.Претрейд.Колонки Цикл
				
				РеквизитФормы = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "СохраненныеНастройки.Претрейд", Колонка.Заголовок);
				ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
				
				СвойстваЭлемента = Новый Структура;
				СвойстваЭлемента.Вставить("Имя", 			Колонка.Имя);
				СвойстваЭлемента.Вставить("ТипЭлемента", 	Тип("ПолеФормы"));
				СвойстваЭлемента.Вставить("Родитель",		Элементы.СохраненныеНастройкиПретрейд);
				СвойстваЭлемента.Вставить("ПутьКДанным", 	Элементы.СохраненныеНастройкиПретрейд.ПутьКДанным + "." + Колонка.Имя);
				СвойстваЭлемента.Вставить("Заголовок", 		Колонка.Заголовок);
				
				ДобавляемыеЭлементы.Добавить(СвойстваЭлемента);
				
			КонецЦикла; 
			
			Для каждого Колонка Из ЗначениеНастройки.СоставГрупповогоКонтроля.Колонки Цикл
				
				РеквизитФормы = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "СохраненныеНастройки.СоставГрупповогоКонтроля", Колонка.Заголовок);
				ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
				
				СвойстваЭлемента = Новый Структура;
				СвойстваЭлемента.Вставить("Имя", 			Колонка.Имя);
				СвойстваЭлемента.Вставить("ТипЭлемента", 	Тип("ПолеФормы"));
				СвойстваЭлемента.Вставить("Родитель", 		Элементы.СохраненныеНастройкиСоставГрупповогоКонтроля);
				СвойстваЭлемента.Вставить("ПутьКДанным", 	Элементы.СохраненныеНастройкиСоставГрупповогоКонтроля.ПутьКДанным + "." + Колонка.Имя);
				СвойстваЭлемента.Вставить("Заголовок", 		Колонка.Заголовок);
				
				ДобавляемыеЭлементы.Добавить(СвойстваЭлемента);
				
			КонецЦикла; 
			
			Если ТипЗнч(ЗначениеНастройки.СоставСовокупнойИнвестДекларации) = Тип("ТаблицаЗначений") Тогда
			
				Для каждого Колонка Из ЗначениеНастройки.СоставСовокупнойИнвестДекларации.Колонки Цикл
					
					РеквизитФормы = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "СохраненныеНастройки.СоставСовокупнойИнвестДекларации", Колонка.Заголовок);
					ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
					
					СвойстваЭлемента = Новый Структура;
					СвойстваЭлемента.Вставить("Имя", 			Колонка.Имя);
					СвойстваЭлемента.Вставить("ТипЭлемента", 	Тип("ПолеФормы"));
					СвойстваЭлемента.Вставить("Родитель", 		Элементы.СохраненныеНастройкиСоставСовокупнойИнвестДекларации);
					СвойстваЭлемента.Вставить("ПутьКДанным", 	Элементы.СохраненныеНастройкиСоставСовокупнойИнвестДекларации.ПутьКДанным + "." + Колонка.Имя);
					СвойстваЭлемента.Вставить("Заголовок", 		Колонка.Заголовок);
					
					ДобавляемыеЭлементы.Добавить(СвойстваЭлемента);
					
				КонецЦикла; 				
			
			КонецЕсли; 
				
			ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			
			Для каждого Элемент Из ДобавляемыеЭлементы Цикл
			
				НовыйЭлемент = ЭтаФорма.Элементы.Добавить(Элемент.Родитель.Имя + Элемент.Имя, Элемент.ТипЭлемента, Элемент.Родитель);
				НовыйЭлемент.ПутьКДанным 	= Элемент.ПутьКДанным;
				НовыйЭлемент.Вид     		= ВидПоляФормы.ПолеВвода;
				НовыйЭлемент.Заголовок   	= Элемент.Заголовок;
			
			КонецЦикла; 
					
		КонецЕсли; 
		
		НоваяСтрока = ЭтаФорма.СохраненныеНастройки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначениеНастройки,, "Претрейд, СоставГрупповогоКонтроля, СоставСовокупнойИнвестДекларации");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Претрейд.Загрузить(ЗначениеНастройки.Претрейд);
		НоваяСтрока.СоставГрупповогоКонтроля.Загрузить(ЗначениеНастройки.СоставГрупповогоКонтроля);
		Если ТипЗнч(ЗначениеНастройки.СоставСовокупнойИнвестДекларации) = Тип("ТаблицаЗначений") Тогда
		
			НоваяСтрока.СоставСовокупнойИнвестДекларации.Загрузить(ЗначениеНастройки.СоставСовокупнойИнвестДекларации);
		
		КонецЕсли; 
				
		Если ЗначениеНастройки.Свойство("Результат") Тогда
			НоваяСтрока.РезультатСохранен = Истина;
			НоваяСтрока.Результат = ПоместитьВоВременноеХранилище(ЗначениеНастройки.Результат, ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
			
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеНастройкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗагрузитьНастройки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеНастройкиПриАктивизацииСтроки(Элемент)
	
	ТекСтрока = Элементы.СохраненныеНастройки.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если ТекСтрока.Претрейд.Количество() > 0 Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаПретрейд;
	ИначеЕсли ТекСтрока.СоставГрупповогоКонтроля.Количество() > 0 Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаГрупповойКонтроль;
	ИначеЕсли ТекСтрока.СовокупнаяИнвестДекларация Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСоставСовокупнойИнвестДекларации;
	КонецЕсли;
	
КонецПроцедуры
 