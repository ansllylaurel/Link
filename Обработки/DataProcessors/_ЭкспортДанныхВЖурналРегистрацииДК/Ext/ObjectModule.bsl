Процедура ПередатьДанныеНаСерверДепозитарнойКомпании(ИдентификаторКоманды) 
	
	// данные для статистики
	ТекстОшибки = Неопределено;
	
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтотОбъект, "ДатаВыгрузки, Организация");
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ДопДанныеДляСтатистики = Новый Структура;
	
	// данные для выгрузки
	ВремяНачалаВыполнения = ТекущаяДата();
	
	ДанныеДепозитарнойКомпании = ПолучитьДанныеДепозитарнойКомпании();
	
	ДопДанныеДляСтатистики.Вставить("ВремяВыборкиДанныеСек", ТекущаяДата() - ВремяНачалаВыполнения);
	ДопДанныеДляСтатистики.Вставить("КоличествоЗаписей", ДанныеДепозитарнойКомпании.Количество());
	
	// передачать данных на сервер 
	ВремяНачалаВыполнения = ТекущаяДата();	
	
	Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(ЭтотОбъект.СтрокаПодключения);
	
	Если Соединение <> Неопределено Тогда
			
		Для Каждого СтрокаДанныеДепозитарнойКомпании из ДанныеДепозитарнойКомпании Цикл
			Если СтрЧислоВхождений(СтрокаДанныеДепозитарнойКомпании.НомерСчета, ",") > 0 Тогда
				БрокерскиеСчета = СтрРазделить(СтрокаДанныеДепозитарнойКомпании.НомерСчета, ",", Ложь);
				Для Каждого БрокерскийСчет из БрокерскиеСчета Цикл
					СтрокаДанныеДепозитарнойКомпании.НомерСчета = СокрЛП(БрокерскийСчет);
					ЗаписатьДанныеВБазуДанных(Соединение, СтрокаДанныеДепозитарнойКомпании);
				КонецЦикла;
			Иначе	
				ЗаписатьДанныеВБазуДанных(Соединение, СтрокаДанныеДепозитарнойКомпании);
			КонецЕсли;
		КонецЦикла;
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		
		ДопДанныеДляСтатистики.Вставить("ВремяПередачиДанныхНаСерверСек", ТекущаяДата() - ВремяНачалаВыполнения);
		
	Иначе
		ТекстОшибки = "Ошибка подключения к базе данных";
		ЗарегистрироватьОшибку(ТекстОшибки);
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, Ложь, ДопДанныеДляСтатистики, ТекстОшибки);
	
КонецПроцедуры


