Функция ПолучитьДанныеДепозитарнойКомпании() 
		
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Ссылка КАК Ссылка,
		|	БанковскиеСчета.Наименование КАК Наименование,
		|	БанковскиеСчета.Организация КАК Организация,
		|	БанковскиеСчета.ЮрФизЛицо КАК ЮрФизЛицо,
		|	БанковскиеСчета.ВидБанковскогоСчета КАК ВидБанковскогоСчета,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(БанковскиеСчета.НомерСчета, 0, 3) В (&КодыДепозитныхСчетов)
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ТипСчета,
		|	БанковскиеСчета.НомерСчета КАК НомерСчета,
		|	БанковскиеСчета.Банк КАК Банк,
		|	БанковскиеСчета.Валюта КАК Валюта,
		|	БанковскиеСчета.ДатаЗакрытия КАК ДатаЗакрытия,
		|	БанковскиеСчета.Договор КАК Договор,
		|	БанковскиеСчета.ДатаОткрытия КАК ДатаОткрытия,
		|	БанковскиеСчета.Банк.Код КАК БанкКод
		|ПОМЕСТИТЬ _БанковскиеСчета
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.НомерСчета ПОДОБНО &regexp
		|	И БанковскиеСчета.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА СправочникСчетаДоверительногоУправления.КодСчета ПОДОБНО ""%"" + СправочникСчетаДоверительногоУправления.НомерДоговора + ""%""
		|			ТОГДА СправочникСчетаДоверительногоУправления.НомерДоговора
		|		ИНАЧЕ СправочникСчетаДоверительногоУправления.КодСчета
		|	КОНЕЦ КАК БрокерскийНомерДоговора,
		|	СправочникСчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СправочникСчетаДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	СправочникСчетаДоверительногоУправления.ДатаРасторжения КАК ДатаРасторжения,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ИНН КАК ИНН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.КПП КАК КПП,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ОГРН КАК ОГРН,
		|	РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо КАК ЮрФизЛицо,
		|	КлиентыДоверительногоУправленияСрезПоследних.Организация КАК Организация,
		|	СправочникСчетаДоверительногоУправления.Ссылка КАК Ссылка,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеУК,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеУК
		|ПОМЕСТИТЬ _ДоговорыДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СправочникСчетаДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СправочникСчетаДоверительногоУправления.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И СправочникСчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							ЮрФизЛица.Ссылка КАК Ссылка
		|						ИЗ
		|							Справочник.ЮрФизЛица КАК ЮрФизЛица
		|						ГДЕ
		|							ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо))
		|					И Организация = &Организация) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО СправочникСчетаДоверительногоУправления.Организация = РеквизитыЮридическихЛицАнкетныеСрезПоследних.Организация
		|			И (КлиентыДоверительногоУправленияСрезПоследних.Клиент = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо В
		|						(ВЫБРАТЬ
		|							ЮрФизЛица.Ссылка КАК Ссылка
		|						ИЗ
		|							Справочник.ЮрФизЛица КАК ЮрФизЛица
		|						ГДЕ
		|							ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо))
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = &Язык) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО СправочникСчетаДоверительногоУправления.АгентскийДоговор.Контрагент = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	СправочникСчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДоверительногоУправления
		|	И СправочникСчетаДоверительногоУправления.Организация = &Организация
		|	И (СправочникСчетаДоверительногоУправления.ДатаРасторжения > ДОБАВИТЬКДАТЕ(&Период, ДЕНЬ, -30)
		|			ИЛИ СправочникСчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДоговорыДоверительногоУправления.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	ДоговорыДоверительногоУправления.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	ДоговорыДоверительногоУправления.ИНН КАК ИНН,
		|	ДоговорыДоверительногоУправления.КПП КАК КПП,
		|	ДоговорыДоверительногоУправления.ОГРН КАК ОГРН,
		|	ДоговорыДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	ДоговорыДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключенияДоговора,
		|	ДоговорыДоверительногоУправления.ДатаРасторжения КАК ДатаРасторженияДоговора,
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДепозитарныеСчета.Родитель.НомерСчета КАК НомерСчета,
		|	ДоговорыДоверительногоУправления.КраткоеНаименованиеУК КАК КраткоеНаименованиеУК,
		|	РеквизитыБрокераСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБрокераПоУставу
		|ПОМЕСТИТЬ _РазделыСчетаДепоПоЦБ
		|ИЗ
		|	_ДоговорыДоверительногоУправления КАК ДоговорыДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык.Код = ""001"") КАК РеквизитыБрокераСрезПоследних
		|				ПО ДепозитарныеСчета.Брокер.ЮрФизЛицо = РеквизитыБрокераСрезПоследних.ЮрФизЛицо
		|			ПО ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет = ДепозитарныеСчета.Ссылка
		|		ПО ДоговорыДоверительногоУправления.Ссылка = ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления
		|			И ДоговорыДоверительногоУправления.Организация = ИсполнителиПоЦеннымБумагам.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(&Период, ) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО ДоговорыДоверительногоУправления.Организация.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	ИсполнителиПоЦеннымБумагам.Организация = &Организация
		|	И ДепозитарныеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.РазделДепозитарногоСчета)
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &Период
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДоговорыДоверительногоУправления.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	ДоговорыДоверительногоУправления.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу,
		|	ДоговорыДоверительногоУправления.ИНН КАК ИНН,
		|	ДоговорыДоверительногоУправления.КПП КАК КПП,
		|	ДоговорыДоверительногоУправления.ОГРН КАК ОГРН,
		|	ДоговорыДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	ДоговорыДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключенияДоговора,
		|	ДоговорыДоверительногоУправления.ДатаРасторжения КАК ДатаРасторженияДоговора,
		|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДепозитарныеСчета.НомерСчета КАК НомерСчета,
		|	ДоговорыДоверительногоУправления.КраткоеНаименованиеУК КАК КраткоеНаименованиеУК,
		|	ДоговорыДоверительногоУправления.ПолноеНаименованиеУК КАК ПолноеНаименованиеУК,
		|	РеквизитыБрокераЛицАнкетныеСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБрокераПоУставу
		|ПОМЕСТИТЬ _СчетыДепоПоЦБ
		|ИЗ
		|	_ДоговорыДоверительногоУправления КАК ДоговорыДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(&Период, Язык.Код = ""001"") КАК РеквизитыБрокераЛицАнкетныеСрезПоследних
		|				ПО ДепозитарныеСчета.Договор.Контрагент = РеквизитыБрокераЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|			ПО ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет = ДепозитарныеСчета.Ссылка
		|		ПО ДоговорыДоверительногоУправления.Ссылка = ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления
		|			И ДоговорыДоверительногоУправления.Организация = ИсполнителиПоЦеннымБумагам.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(&Период, ) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ДоговорыДоверительногоУправления.Организация.ЮрФизЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	ИсполнителиПоЦеннымБумагам.Организация = &Организация
		|	И ДепозитарныеСчета.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыДепозитарныхСчетов.Депозитарный)
		|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия >= &Период
		|			ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
