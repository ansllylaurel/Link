Процедура ЗаписатьДанныеВБазуДанных(Соединение, СтрокаДанных)
	
	nvarchar = 202;
	datetime = 133;
	int      = 4;
	
	Попытка
		
		Command = РаботаСВнешнимиСистемами.ADODBC_ПолучитьКомандуОбращенияКХранимойПроцедуре(Соединение, "Sp_AddInsurance");
		Command.NamedParameters = true;
		
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@InsuranceName",      nvarchar, 400, СтрокаДанных.КраткоеНаименованиеПоУставу); 
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@InsuranceFullName",  nvarchar, 400, СтрокаДанных.ПолноеНаименованиеПоУставу);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@InsuranceNameShort", nvarchar, 400, СтрокаДанных.КраткоеНаименованиеПоУставу);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@OGRN",               nvarchar,  50, СтрокаДанных.ОГРН);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@INN",                nvarchar,  50, СтрокаДанных.ИНН);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@KPP",                nvarchar,  50, СтрокаДанных.КПП);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@ContractNumber",     nvarchar,  50, СтрокаДанных.НомерДоговора);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@ContractDateOpen",   nvarchar, 128, Формат(СтрокаДанных.ДатаЗаключенияДоговора, "ДФ=yyyyMMdd"));
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@ContractDateClose",  nvarchar, 128, Формат(СтрокаДанных.ДатаРасторженияДоговора, "ДФ='yyyyMMdd'"));
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@AccountNumber",      nvarchar,  50, СтрокаДанных.НомерСчета);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@AccountType",             int,   4, СтрокаДанных.ТипСчета);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@AccountDateOpen",    nvarchar, 128, Формат(СтрокаДанных.ДатаОткрытияСчета, "ДФ='yyyyMMdd'"));
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@AccountDateClose",   nvarchar, 128, Формат(СтрокаДанных.ДатаЗакрытияСчета, "ДФ='yyyyMMdd'"));
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@BankName",           nvarchar, 400, СтрокаДанных.БанкИлиБрокер);
		РаботаСВнешнимиСистемами.ADODBC_ДобавитьВходнойПараметрКоманды(Command, "@BankBIC",            nvarchar,  50, СтрокаДанных.БИК, Ложь);
		
		Результат = Command.Execute();
		
	Исключение
		
		Информация  = ИнформацияОбОшибке();
		ТекстОшибки = "Ошибка записи данных в БД для записи с номером счета: " + СтрокаДанных.НомерСчета + ". Система сообщает: " + Информация.Описание;
		
		ЗарегистрироватьОшибку(ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры


Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках(ЕстьОшибки = Неопределено)
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры // ОповеститьОбОшибках

