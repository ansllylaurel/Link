
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
	   "ДополнительнаяОбработка",
	   "Экспорт данных в журнал регистрации ДК",
	   "1.08",
	   "",
	   Истина);
	
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();

	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПередатьДанныеНаСерверДепозитарнойКомпанииТест", "Передать данные на сервер депозитарной компании (тест)",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПередатьДанныеНаСерверДепозитарнойКомпанииПрод", "Передать данные на сервер депозитарной компании (прод)",, Ложь, "ВызовСерверногоМетода");

	РегистрационныеДанные.Вставить("Команды", Команды);

	Возврат РегистрационныеДанные;

КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	Если ПараметрыОбработки = Неопределено Тогда // режим тестирования
		
		ПараметрыКоманды = Новый Структура("Организация", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ДК"));
		
	Иначе
		
		ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);

	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыКоманды.Организация) Тогда
		ЭтотОбъект.Организация = ПараметрыКоманды.Организация;	
	Иначе
		ЗарегистрироватьОшибку("Для передачи данных на сервер страховой компании необходимо заполнить параметр команды [Организация].");	
	КонецЕсли;
	
	Если      ИдентификаторКоманды = "ПередатьДанныеНаСерверДепозитарнойКомпанииТест" Тогда
		ЭтотОбъект.СтрокаПодключения = СтрокаПодключенияКSQLСерверуТест();
	ИначеЕсли ИдентификаторКоманды = "ПередатьДанныеНаСерверДепозитарнойКомпанииПрод" Тогда
		ЭтотОбъект.СтрокаПодключения = СтрокаПодключенияКSQLСерверуПрод();
	КонецЕсли;
	
	ЭтотОбъект.ДатаВыгрузки = ТекущаяДата();
	
	ПередатьДанныеНаСерверДепозитарнойКомпании(ИдентификаторКоманды);
	
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры


