Перем КалендариМенеджер, Календарь, ТекущаяДата;
	
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Отправка оповещений по внешним вызовам", "1.19", "", Истина);
		
	// Команды
	
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВходящийДокументОповещениеОбОкончанииСрокаОтвета", "Оповещения об окончании срока ответа на входящий документ", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВходящийДокументОповещениеОРегистрацииЗаПредыдущийДень", "Оповещения о входящих документах за день Т-1", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВходящийДокументОповещениеОбОтсутствииОтветовНаЖалобыИОбращения", "Оповещения об отсутствии ответов на жалобы и обращения", , Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВходящийДокументОповещениеОбОтсутствииАвтоответов", "Оповещения об отсутствии автоответов не по существу", , Ложь, "ВызовСерверногоМетода");
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОстаткиНаБрокерскомСчете", "Оповещения об остатках на брокерском счете", , Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска формирования отчетов по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Механизм = СтрЗаменить(ЭтотОбъект.Метаданные().ПолноеИмя(), "ВнешняяОбработка.", "") + "." + ИдентификаторКоманды;
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	
	Если Не ИнициализироватьПеременныеКалендаря() Тогда
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		Возврат;
	КонецЕсли; 
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Если ИдентификаторКоманды = "ВходящийДокументОповещениеОбОкончанииСрокаОтвета" Тогда
		ВходящийДокументОповещениеОбОкончанииСрокаОтвета(ПараметрыКоманды.Организация);
	ИначеЕсли ИдентификаторКоманды = "ВходящийДокументОповещениеОРегистрацииЗаПредыдущийДень" Тогда
		ВходящийДокументОповещениеОРегистрацииЗаПредыдущийДень(ПараметрыКоманды.Организация);
	ИначеЕсли ИдентификаторКоманды = "ВходящийДокументОповещениеОбОтсутствииОтветовНаЖалобыИОбращения" Тогда
		ВходящийДокументОповещениеОбОтсутствииОтветовНаЖалобыИОбращения(ПараметрыКоманды.Организация);
	ИначеЕсли ИдентификаторКоманды = "ВходящийДокументОповещениеОбОтсутствииАвтоответов" Тогда
		ВходящийДокументОповещениеОбОтсутствииАвтоответов(ПараметрыКоманды.Организация) 
	ИначеЕсли ИдентификаторКоманды = "ОстаткиНаБрокерскомСчете" Тогда
		ОстаткиНаБрокерскомСчете(ПараметрыКоманды, ИдентификаторКоманды);
	Иначе
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,,, СтрШаблон("Неизвестный идентификатор команды '%1'", ИдентификаторКоманды));
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура ВходящийДокументОповещениеОбОкончанииСрокаОтвета(Организация) 
	
	СледующийРабочийДень = КалендариМенеджер.ДобавитьКДатеРабочиеДни(Календарь, КонецДня(ТекущаяДата), 1);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СледующийРабочийДень", СледующийРабочийДень);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Источник,
		|	ВходящийДокумент.Номер КАК Номер,
		|	ВходящийДокумент.Дата КАК Дата,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	ВходящийДокумент.ВидВходящегоДокумента КАК ВидВходящегоДокумента,
		|	ВходящийДокумент.Отправитель КАК Отправитель,
		|	ВходящийДокумент.Организация КАК Организация,
		|	ВходящийДокумент.СрокОтвета КАК СрокОтвета,
		|	ВЫБОР
		|		КОГДА ВходящийДокумент.СрокОтвета >= &ТекущаяДата
		|			ТОГДА 1
		|		КОГДА ВходящийДокумент.СрокОтвета = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК РазделОтчета
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.ТребуетОтветаПоСуществу
		|	И ВходящийДокумент.Дата >= ДАТАВРЕМЯ(2024, 1, 1)
		|	И ВходящийДокумент.Проведен
		|	И ВходящийДокумент.СрокОтвета <= &СледующийРабочийДень
		|	И НЕ 1 В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					1
		|				ИЗ
		|					Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|				ГДЕ
		|					ИсходящийДокументОснования.Основание = ВходящийДокумент.Ссылка
		|					И (ВходящийДокумент.Дата < ДАТАВРЕМЯ(2023, 9, 1)
		|						ИЛИ ИсходящийДокументОснования.Ссылка.ОтветПоСуществу))
		|
		|УПОРЯДОЧИТЬ ПО
		|	РазделОтчета,
		|	Дата УБЫВ
		|ИТОГИ ПО
		|	РазделОтчета";			
	#КонецОбласти 
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Разделы = Новый Соответствие;
		Разделы.Вставить(1, Новый Структура("Заголовок, ВыводитьСрок", "Входящие документы с истекающим сроком ответа", Истина));
		Разделы.Вставить(2, Новый Структура("Заголовок, ВыводитьСрок", "Входящие документы с нарушением срока", Истина));
		Разделы.Вставить(3, Новый Структура("Заголовок, ВыводитьСрок", "Входящие документы без указания срока", Ложь));
	 
		Макет = ПолучитьМакет("СрокиВходящихДокументов");
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		ВыборкаРаздел = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		СоответствиеИдентификаторов = Новый Соответствие;
		
		Пока ВыборкаРаздел.Следующий() Цикл
			
			ПараметрыРаздела = Разделы[ВыборкаРаздел.РазделОтчета];
			
			ОбластьЗаголовок.Параметры.Заполнить(ПараметрыРаздела);
			ТабличныйДокумент.Вывести(ОбластьЗаголовок);
			
			ИмяОбласти = ?(ПараметрыРаздела.ВыводитьСрок, "ВсеРеквизиты", "БезСрока");
			
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка|" + ИмяОбласти);
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка|" + ИмяОбласти);
			
			ТабличныйДокумент.Вывести(ОбластьШапка);
			
			Выборка = ВыборкаРаздел.Выбрать();
			
			Пока Выборка.Следующий() Цикл
			
				ОбластьСтрока.Параметры.Заполнить(Выборка);
				
				ВходящийДокумент = "№" + Выборка.Номер + "_от_" + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy_ЧЧ:мм:сс");
				ОбластьСтрока.Параметры.ВходящийДокумент = ВходящийДокумент;
				
				СоответствиеИдентификаторов.Вставить(ВходящийДокумент, ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Источник));
				
				ТабличныйДокумент.Вывести(ОбластьСтрока);
			
			КонецЦикла; 
		
		КонецЦикла;	
		
		СформироватьОповещение(Организация, ТабличныйДокумент, "ОповещениеОбОкончанииСрокаОтвета", СоответствиеИдентификаторов);
		
	КонецЕсли; 

КонецПроцедуры

Процедура ВходящийДокументОповещениеОРегистрацииЗаПредыдущийДень(Организация)
		
	ПредыдущийРабочийДень = КалендариМенеджер.ДобавитьКДатеРабочиеДни(Календарь, ТекущаяДата, -2);
	МетаданныеДокумента = Метаданные.Документы.ВходящийДокумент;
	
	МассивМетаданных = Новый Массив;
	МассивМетаданных.Добавить(МетаданныеДокумента);
	ИсторияДанных.ОбновитьИсторию(МассивМетаданных);
	
	// Получаем все добавленные входящие документы, добавленные за предыдущий рабочий день (Т-1)
	ОтборДляИсторииДанных = Новый Структура;
	ОтборДляИсторииДанных.Вставить("Метаданные", МетаданныеДокумента);
	ОтборДляИсторииДанных.Вставить("ВидИзмененияДанных", ВидИзмененияДанных.Добавление);
	ОтборДляИсторииДанных.Вставить("ДатаНачала", ПредыдущийРабочийДень);
	ОтборДляИсторииДанных.Вставить("ДатаОкончания", ТекущаяДата - 1); // На случай, если документы добавлялись в выходные
	
	Версии = ИсторияДанных.ВыбратьВерсии(ОтборДляИсторииДанных, "Данные");
	
	// Получаем документы, у которых дата входящего документа в интервале от Т-2 (включая) до Т-1 (исключая)
	НачалоПериода = КалендариМенеджер.ДобавитьКДатеРабочиеДни(Календарь, ПредыдущийРабочийДень, -2);
	ОкончаниеПериода = ПредыдущийРабочийДень - 1;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("Ссылка", Версии.ВыгрузитьКолонку("Данные"));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.Отправитель КАК Отправитель,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	ВходящийДокумент.ВидВходящегоДокумента КАК ВидВходящегоДокумента
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	ВходящийДокумент.Организация = &Организация
		|	И НЕ ВходящийДокумент.ПометкаУдаления
		|	И ВходящийДокумент.ДатаВходящегоДокумента МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|	И ВходящийДокумент.Ссылка В(&Ссылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Отправитель,
		|	НомерВходящегоДокумента
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
	
		СсылкаИБ = ОбщегоНазначенияПовтИсп.ПолучитьСсылкуИнформационнойБазы();
		
		Строки = Новый Массив;
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВнешнаяяСсылка = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
			Гиперссылка = "<A href=""" + ВнешнаяяСсылка + """>№" + Выборка.НомерВходящегоДокумента + " от " + Формат(Выборка.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy") + "</A>";
			
			Строки.Добавить("<TR CLASS=R1>
				|<TD CLASS=""R1C0"">" + Выборка.Отправитель + "</TD>
				|<TD CLASS=""R1C1""><SPAN STYLE=""white-space:nowrap;max-width:0px;"">" + Гиперссылка + "</SPAN></TD>
				|<TD CLASS=""R1C0"">" + Выборка.ВидВходящегоДокумента + "</TD>
				|<TD><SPAN></SPAN></TD>
				|<TD></TD>
				|</TR>");
			
		КонецЦикла; 
		
		ОтчетHTML = 
			"<STYLE TYPE=""text/css"">
			|body { background: #ffffff; margin: 0; font-family: Arial; font-size: 8pt; font-style: normal; }
			|tr.R0{ height: 17px; }
			|tr.R0 td.R0C0{ font-family: Arial; font-size: 10pt; font-style: normal; color: #4d4d4d; background-color: #f2f2f2; text-align: left; vertical-align: top; border-left: #a0a0a0 1px solid; border-top: #a0a0a0 1px solid; border-bottom: #a0a0a0 1px solid; border-right: #a0a0a0 1px solid; }
			|tr.R1{  }
			|tr.R1 td.R1C0{ color: #333333; background-color: #ffffff; text-align: left; vertical-align: top; border-left: #a0a0a0 1px solid; border-top: #a0a0a0 1px solid; border-bottom: #a0a0a0 1px solid; border-right: #a0a0a0 1px solid; }
			|tr.R1 td.R1C1{ color: #333333; background-color: #ffffff; text-align: left; vertical-align: top; border-left: #a0a0a0 1px solid; border-top: #a0a0a0 1px solid; border-bottom: #a0a0a0 1px solid; border-right: #a0a0a0 1px solid; }
			|table {table-layout: fixed; padding: 0px; padding-left: 2px; vertical-align:bottom; border-collapse:collapse;width: 100%; font-family: Arial; font-size: 8pt; font-style: normal; }
			|td { padding: 0px; padding-left: 2px; overflow:hidden; }
			|</STYLE>
			|<BODY STYLE=""background: #ffffff; margin: 0; font-family: Arial; font-size: 8pt; font-style: normal; "">
			|<TABLE style=""width:100%; height:0px; "" CELLSPACING=0>
			|<COL WIDTH=168>
			|<COL WIDTH=144>
			|<COL WIDTH=283>
			|<COL>
			|<TR CLASS=R0>
			|<TD CLASS=""R0C0""><SPAN STYLE=""white-space:nowrap;max-width:0px;"">Отправитель</SPAN></TD>
			|<TD CLASS=""R0C0""><SPAN STYLE=""white-space:nowrap;max-width:0px;"">Исходящий&nbsp;документ</SPAN></TD>
			|<TD CLASS=""R0C0""><SPAN STYLE=""white-space:nowrap;max-width:0px;"">Краткое&nbsp;описание</SPAN></TD>
			|<TD><SPAN></SPAN></TD>
			|<TD></TD>
			|</TR>" + СтрСоединить(Строки, Символы.ПС) + "
			|</TABLE>";
		
		ПрефиксНумерации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ПрефиксНумерации");
		Тема = "Входящие Т-1 " + СокрЛП(ПрефиксНумерации);
		РеквизитыОповещения = Новый Структура("Организация, Тема, Текст", Организация, Тема, ОтчетHTML); 
		
		Источник = МетаданныеДокумента.ПолноеИмя() + ".ОповещенияОРегистрацииЗаПрошлыеДаты";
		Справочники.Оповещения.СформироватьОповещения(Источник, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЕсли;	

КонецПроцедуры
 
Процедура ВходящийДокументОповещениеОбОтсутствииОтветовНаЖалобыИОбращения(Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Запрос.УстановитьПараметр("ДеньТМинус2", КалендариМенеджер.ДобавитьКДатеРабочиеДни(Календарь, ТекущаяДата, -2));
	#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Источник,
		|	ВходящийДокумент.Номер КАК Номер,
		|	ВходящийДокумент.Дата КАК Дата,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК НомерВходящегоДокумента,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК ДатаВходящегоДокумента,
		|	ВходящийДокумент.ВидВходящегоДокумента КАК ВидВходящегоДокумента,
		|	ВходящийДокумент.Отправитель КАК Отправитель,
		|	ВходящийДокумент.Организация КАК Организация,
		|	ВходящийДокумент.СрокОтвета КАК СрокОтвета
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|ГДЕ
		|	ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.Проведен
		|	И ВходящийДокумент.Дата МЕЖДУ ДАТАВРЕМЯ(2023, 9, 1) И &ДеньТМинус2
		|	И НЕ 1 В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					1
		|				ИЗ
		|					Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|				ГДЕ
		|					ИсходящийДокументОснования.Основание = ВходящийДокумент.Ссылка
		|					И НЕ ИсходящийДокументОснования.Ссылка.ПометкаУдаления)
		|	И ВходящийДокумент.ТипВходящегоДокумента В (ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.Жалоба), ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ОбращениеКлиента), ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ОбращениеПотенциальногоКлиента), ЗНАЧЕНИЕ(Перечисление.ТипыВходящихДокументов.ОбращениеИное))
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";			
	#КонецОбласти 
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Макет = ПолучитьМакет("СрокиВходящихДокументов");
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		ОбластьЗаголовок.Параметры.Заголовок = "Жалобы и обращения без ответа";
		ТабличныйДокумент.Вывести(ОбластьЗаголовок);
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		Выборка = Результат.Выбрать();
		
		СоответствиеИдентификаторов = Новый Соответствие;
		
		Пока Выборка.Следующий() Цикл
			
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			
			ВходящийДокумент = "№" + Выборка.Номер + "_от_" + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy_ЧЧ:мм:сс");
			ОбластьСтрока.Параметры.ВходящийДокумент = ВходящийДокумент;
			
			СоответствиеИдентификаторов.Вставить(ВходящийДокумент, ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Источник));
			
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		КонецЦикла;				
		
		СформироватьОповещение(Организация, ТабличныйДокумент, "ОповещениеОбОтсутствииОтветаНаЖалобыИОбращения", СоответствиеИдентификаторов);
		
	КонецЕсли; 

КонецПроцедуры

Процедура ВходящийДокументОповещениеОбОтсутствииАвтоответов(Организация) Экспорт
		
	Запрос = Новый Запрос;
	
#Область Текст_запроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВходящийДокумент.Ссылка КАК Ссылка,
		|	ВходящийДокумент.НомерВходящегоДокумента КАК НомерДокумента,
		|	ВходящийДокумент.ДатаВходящегоДокумента КАК ДатаДокумента,
		|	ВходящийДокумент.ВидВходящегоДокумента КАК ВидДокумента,
		|	ВходящийДокумент.ТипВходящегоДокумента КАК ТипДокумента,
		|	ВходящийДокумент.СпособПолучения КАК СпособПолучения,
		|	ВходящийДокумент.Отправитель КАК Отправитель,
		|	ВходящийДокумент.ОтветственныйСотрудник КАК ОтветственныйСотрудник,
		|	ВходящийДокумент.Отправитель ССЫЛКА Справочник.ЮрФизЛица КАК ОтправительОпределен
		|ПОМЕСТИТЬ _ВходящиеДокументы
		|ИЗ
		|	Документ.ВходящийДокумент КАК ВходящийДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ИсходящийДокументОснования.Основание КАК Ссылка
		|		ИЗ
		|			Документ.ИсходящийДокумент КАК ИсходящийДокумент
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИсходящийДокумент.Основания КАК ИсходящийДокументОснования
		|				ПО ИсходящийДокумент.Ссылка = ИсходящийДокументОснования.Ссылка
		|					И (ИсходящийДокумент.Дата МЕЖДУ &НачалоДня И &КонецДня)
		|					И (НЕ ИсходящийДокумент.ПометкаУдаления)) КАК ОснованияИсходящихДокументов
		|		ПО ВходящийДокумент.Ссылка = ОснованияИсходящихДокументов.Ссылка
		|ГДЕ
		|	ВходящийДокумент.Проведен
		|	И ВходящийДокумент.Организация = &Организация
		|	И ВходящийДокумент.Дата МЕЖДУ &НачалоДня И &КонецДня
		|	И ВходящийДокумент.СпособПолучения <> ЗНАЧЕНИЕ(Перечисление.СпособыПолученияДокументов.БумажныйДокумент)
		|	И ОснованияИсходящихДокументов.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВходящиеДокументы.Ссылка КАК ВходящийДокумент,
		|	_ВходящиеДокументы.СпособПолучения КАК СпособПолученияДокумента,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ТИПЗНАЧЕНИЯ(КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления) КАК ТипЗНЧ,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|		ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &НачалоДня КАК ДействующийКлиент
		|ПОМЕСТИТЬ _КлиентыДУ
		|ИЗ
		|	_ВходящиеДокументы КАК _ВходящиеДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&КонецДня, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО _ВходящиеДокументы.Отправитель = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|			И (_ВходящиеДокументы.ОтправительОпределен)
		|			И (НЕ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлиентыДУ.ВходящийДокумент КАК ВходящийДокумент,
		|	_КлиентыДУ.СчетДоверительногоУправления КАК Ссылка
		|ПОМЕСТИТЬ _ДоговорыЭдо
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|ГДЕ
		|	_КлиентыДУ.ДействующийКлиент
		|	И _КлиентыДУ.СпособПолученияДокумента = ЗНАЧЕНИЕ(Перечисление.СпособыПолученияДокументов.ЭлектронныйДокумент)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	_КлиентыДУ.ВходящийДокумент,
		|	ДействующиеДоговоры.Ссылка
		|ИЗ
		|	_КлиентыДУ КАК _КлиентыДУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			Договоры.Ссылка КАК Ссылка,
		|			Договоры.Контрагент КАК Контрагент
		|		ИЗ
		|			Справочник.Договоры КАК Договоры
		|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие КАК УсловияДоговоровОбщие
		|				ПО Договоры.Ссылка = УсловияДоговоровОбщие.Договор
		|					И (УсловияДоговоровОбщие.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1))
		|		ГДЕ
		|			Договоры.ДатаЗаключения <= &НачалоДня
		|			И Договоры.ВидДоговора В (ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.СоглашениеОбЭДО), ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ДополнительноеСоглашение))
		|			И ЕСТЬNULL(УсловияДоговоровОбщие.ДатаРасторжения, &НачалоДня) >= &НачалоДня) КАК ДействующиеДоговоры
		|		ПО _КлиентыДУ.Клиент = ДействующиеДоговоры.Контрагент
		|			И (_КлиентыДУ.ДействующийКлиент)
		|			И (_КлиентыДУ.СпособПолученияДокумента = ЗНАЧЕНИЕ(Перечисление.СпособыПолученияДокументов.ЭлектронныйДокумент))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДоговорыЭдо.ВходящийДокумент КАК Ссылка
		|ПОМЕСТИТЬ _ДокументыНеТребующиеОтвета
		|ИЗ
		|	_ДоговорыЭдо КАК _ДоговорыЭдо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСоглашенийОбЭДО.СрезПоследних(
		|				&КонецДня,
		|				Организация = &Организация
		|					И Договор В
		|						(ВЫБРАТЬ
		|							_ДоговорыЭдо.Ссылка
		|						ИЗ
		|							_ДоговорыЭдо КАК _ДоговорыЭдо)) КАК УсловияСоглашенийОбЭДОСрезПоследних
		|		ПО _ДоговорыЭдо.Ссылка = УсловияСоглашенийОбЭДОСрезПоследних.Договор
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.ДатаНачалаИспользованияЭДО <> ДАТАВРЕМЯ(1, 1, 1))
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.ДатаНачалаИспользованияЭДО <= &НачалоДня)
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.ДатаОкончанияИспользованияЭДО = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ УсловияСоглашенийОбЭДОСрезПоследних.ДатаОкончанияИспользованияЭДО > &НачалоДня)
		|			И (УсловияСоглашенийОбЭДОСрезПоследних.НеТребуетсяАвтоответ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Пользователи.ЮрФизЛицо КАК ФизЛицо,
		|	Пользователи.АдресЭлектроннойПочты КАК Емаил
		|ПОМЕСТИТЬ _ДополнительныеПолучатели
		|ИЗ
		|	_ВходящиеДокументы КАК _ВходящиеДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппПользователей КАК СоставГруппПользователей
		|			ПО Пользователи.Ссылка = СоставГруппПользователей.Пользователь
		|				И (СоставГруппПользователей.ГруппаПользователей В ИЕРАРХИИ (&КлиентскийОтдел))
		|		ПО _ВходящиеДокументы.ОтветственныйСотрудник = Пользователи.ЮрФизЛицо
		|			И (Пользователи.Организация = &Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДокументыНеТребующиеОтвета КАК _ДокументыНеТребующиеОтвета
		|		ПО _ВходящиеДокументы.Ссылка = _ДокументыНеТребующиеОтвета.Ссылка
		|ГДЕ
		|	СоставГруппПользователей.ГруппаПользователей ЕСТЬ NULL
		|	И _ДокументыНеТребующиеОтвета.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ВходящиеДокументы.Ссылка КАК Ссылка,
		|	_ВходящиеДокументы.НомерДокумента КАК НомерДокумента,
		|	_ВходящиеДокументы.ДатаДокумента КАК ДатаДокумента,
		|	_ВходящиеДокументы.ТипДокумента КАК ТипДокумента,
		|	_ВходящиеДокументы.ВидДокумента КАК ВидДокумента,
		|	_ВходящиеДокументы.СпособПолучения КАК СпособПолучения,
		|	_ВходящиеДокументы.Отправитель КАК Отправитель,
		|	_ВходящиеДокументы.ОтветственныйСотрудник КАК Ответственный,
		|	_ДополнительныеПолучатели.Емаил КАК Емаил
		|ИЗ
		|	_ВходящиеДокументы КАК _ВходящиеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			_КлиентыДУ.ВходящийДокумент КАК Ссылка
		|		ИЗ
		|			_КлиентыДУ КАК _КлиентыДУ) КАК ДокументыКлиентов
		|		ПО _ВходящиеДокументы.Ссылка = ДокументыКлиентов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДокументыНеТребующиеОтвета КАК _ДокументыНеТребующиеОтвета
		|		ПО _ВходящиеДокументы.Ссылка = _ДокументыНеТребующиеОтвета.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДополнительныеПолучатели КАК _ДополнительныеПолучатели
		|		ПО _ВходящиеДокументы.ОтветственныйСотрудник = _ДополнительныеПолучатели.ФизЛицо
		|ГДЕ
		|	_ДокументыНеТребующиеОтвета.Ссылка ЕСТЬ NULL
		|	И НЕ(_ВходящиеДокументы.ОтправительОпределен
		|				И ДокументыКлиентов.Ссылка ЕСТЬ NULL)";   	
#КонецОбласти

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоДня", ТекущаяДата);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДата));
	Запрос.УстановитьПараметр("КлиентскийОтдел", ОбщегоНазначения.ПолучитьИменованныйОбъект("КлиентскийОтдел"));

	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщения = "";
	ДопПолучатели = "";
	
	Пока Выборка.Следующий() Цикл 
		
		ТекстСообщения = ТекстСообщения + Символы.ПС 
			+ "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Ссылка)
			+ "</td><td>" + Выборка.Отправитель 
			+ "</td><td>" + ?(ЗначениеЗаполнено(Выборка.ТипДокумента), Выборка.ТипДокумента, "-----") 
			+ "</td><td>" + ?(ЗначениеЗаполнено(Выборка.СпособПолучения), Выборка.СпособПолучения, "-----") 
			+ "</td><td>" + Выборка.НомерДокумента 
			+ "</td><td>" + Формат(Выборка.ДатаДокумента, "ДФ=dd.MM.yyyy")
			+ "</td><td>" + Выборка.ВидДокумента + "</td>"
			+ "</td><td>" + Выборка.Ответственный + "</td></tr>";
			
		Если ЗначениеЗаполнено(Выборка.Емаил) И СтрНайти(ДопПолучатели, Выборка.Емаил) = 0 Тогда
			ДопПолучатели = ДопПолучатели + ?(ЗначениеЗаполнено(ДопПолучатели), ";", "") + Выборка.Емаил; 		
		КонецЕсли;
			
	КонецЦикла;
	
	Если ТекстСообщения <> "" Тогда
		
		ТекстСообщения =
		
#Область Текст_HTML
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body  { font-family: ""Arial""; font-size: 12px; }
			|		table { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td    { border: 1px solid #5877AD; padding: 5px; }
			|		.top  { background: #A6CAF0; }
			|	</style>
			|</head><body> 
			|<table cols=""8"">
			|<tr class=""top""><td>Ссылка</td><td>Отправитель</td><td>Тип</td><td>Способ получения</td><td>Номер</td><td>Дата</td><td>Описание</td><td>Ответственный</td></tr>"
			+ ТекстСообщения 
			+ "</table></body></html>";
#КонецОбласти
				
		РеквизитыОповещения = Новый Структура("Организация, Текст", Организация, ТекстСообщения);
		
		Если ЗначениеЗаполнено(ДопПолучатели) Тогда
			РеквизитыОповещения.Вставить("ДополнительныеПолучатели", ДопПолучатели);
		КонецЕсли;
		
		Источник = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЭтотОбъект.Метаданные().ПолноеИмя(), ".")[1] + ".ОповещениеОбОтсутствииАвтоответов";
		Справочники.Оповещения.СформироватьОповещения(Источник, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения); 
			
	КонецЕсли;
		
КонецПроцедуры

Процедура СформироватьОповещение(Организация, ТабличныйДокумент, ИсточникОповещения, СоответствиеИдентификаторов)

	ТекстПисьма = ПолучитьТекстОповещенияИзТабличногоДокумента(ТабличныйДокумент);
	
	Для каждого ЭлементСоответствия Из СоответствиеИдентификаторов Цикл
		ТекстПисьма = СтрЗаменить(ТекстПисьма, ЭлементСоответствия.Ключ, ЭлементСоответствия.Значение);
	КонецЦикла;
	
	РеквизитыОповещения = Новый Структура("Организация, Текст", Организация, ТекстПисьма);
	
	ИмяИсточника = Метаданные.Документы.ВходящийДокумент.ПолноеИмя() + "." + ИсточникОповещения;
	
	Справочники.Оповещения.СформироватьОповещения(ИмяИсточника, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры 

Функция ИнициализироватьПеременныеКалендаря()

	КалендариМенеджер = Справочники.Календари;
	Календарь = КалендариМенеджер.Общероссийский;
	ТекущаяДата = НачалоДня(ТекущаяДата());
	
	Возврат КалендариМенеджер.ЭтоРабочийДень(Календарь, ТекущаяДата);

КонецФункции 

Функция ПолучитьТекстОповещенияИзТабличногоДокумента(ТабличныйДокумент)

	// сохраним табличный документ в HTML
	ИмяФайла = ПолучитьИмяВременногоФайла("htm");
	ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяФайла);
	
	УдалитьФайлы(ИмяФайла);
	
	ТекстПисьма = ТелоПисьма.ПолучитьТекст();
	
	// Вырезаем из полученного текста только центральную часть с данными,
	// т.к. для оповещения тип текста - HTML, и текст уже содержит тэги <html>, <head> и <body>
	НачалоСтроки = СтрНайти(ТекстПисьма, "<STYLE");
	ТекстПисьма = Сред(ТекстПисьма, НачалоСтроки);
	КонецСтроки = СтрНайти(ТекстПисьма, "</BODY>")-1;
	ТекстПисьма = Лев(ТекстПисьма, КонецСтроки);
	
	Возврат ТекстПисьма;

КонецФункции 

Процедура ОстаткиНаБрокерскомСчете(ПараметрыКоманды, ИдентификаторКоманды)
			
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК Сумма,
		|	ОстаткиДенежныхСредствОстатки.Брокер КАК Брокер
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ОстаткиДенежныхСредствОстатки
		|ГДЕ Брокер <> Значение(Справочник.БрокерскиеКомпании.)
		|УПОРЯДОЧИТЬ ПО
		|	Брокер,
		|	Валюта
		|ИТОГИ ПО
		|	Брокер
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(ТекущаяДата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", ПараметрыКоманды.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПараметрыКоманды.СчетДоверительногоУправления);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		ТекстПисьма = "Денежные средства на брокерских счетах отсутствуют";
		
	Иначе
		
		ШаблонОстаток = "%1 (%2)";
		
		СтрокиБрокер = Новый Массив;
		ВыборкаБрокер = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаБрокер.Следующий() Цикл
		
			Выборка = ВыборкаБрокер.Выбрать();
		    СтрокиОстаток = Новый Массив;
			
			Пока Выборка.Следующий() Цикл
				
				СтрокиОстаток.Добавить(СтрШаблон(ШаблонОстаток, 
					Формат(Выборка.Сумма, "ЧДЦ=2; ЧГ=3,0"), 
					Выборка.Валюта));
					
			КонецЦикла;
			
			Если Выборка.Количество() = 1 Тогда
				СтрокаОстаток = СтрокиОстаток[0];
			Иначе
				СтрокаОстаток = Символы.ПС + СтрСоединить(СтрокиОстаток, Символы.ПС);
			КонецЕсли;
			
			ШаблонТекст = "Остаток денежных средств на брокерском счете %1 составляет: %2";
		    СтрокиБрокер.Добавить(СтрШаблон(ШаблонТекст, ВыборкаБрокер.Брокер, СтрокаОстаток));
					
		КонецЦикла;
		
		ТекстПисьма = СтрСоединить(СтрокиБрокер, Символы.ПС);
	
	КонецЕсли;
	
	РеквизитыОповещения = Новый Структура("Организация, СчетДоверительногоУправления, Текст");
	ЗаполнитьЗначенияСвойств(РеквизитыОповещения, ПараметрыКоманды);
	РеквизитыОповещения.Текст = ТекстПисьма;
	
	ИмяИсточника = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + ИдентификаторКоманды;
	
	Справочники.Оповещения.СформироватьОповещения(ИмяИсточника, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры