		|	_НКДсУчетомВалютыКотировки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_НКДсУчетомВалютыКотировки.ВалютаНоминала КАК ВалютаНоминала,
		|	_НКДсУчетомВалютыКотировки.Купон КАК Купон,
		|	_НКДсУчетомВалютыКотировки.Категория КАК Категория,
		|	_НКДсУчетомВалютыКотировки.ИндексируемыйНоминал КАК ИндексируемыйНоминал,
		|	_НКДсУчетомВалютыКотировки.БазаРасчета КАК БазаРасчета,
		|	_ДанныеКупона.Период КАК Период,
		|	_ДанныеКупона.Процент КАК Процент,
		|	_ДанныеКупона.СуммаКупона КАК СуммаКупона,
		|	_ДанныеКупона.Срок КАК Срок,
		|	_ДанныеКупона.ДатаОкончанияКупона КАК ДатаОкончанияКупона,
		|	_ДанныеКупона.ФормулаРасчетаСтавки КАК ФормулаРасчетаСтавки,
		|	_ПериодНоминала.ПериодНоминала КАК ПериодНоминала,
		|	_ДанныеКупона.СтавкаОпределена КАК СтавкаОпределена,
		|	ВЫБОР
		|		КОГДА УсловияОферт.Облигация ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ПрошлаОбязательнаяОферта
		|ИЗ
		|	_НКДсУчетомВалютыКотировки КАК _НКДсУчетомВалютыКотировки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПериодНоминала КАК _ПериодНоминала
		|		ПО _НКДсУчетомВалютыКотировки.ЦеннаяБумага = _ПериодНоминала.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеКупона КАК _ДанныеКупона
		|		ПО _НКДсУчетомВалютыКотировки.ЦеннаяБумага = _ДанныеКупона.Облигация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияОферт КАК УсловияОферт
		|		ПО _НКДсУчетомВалютыКотировки.ЦеннаяБумага = УсловияОферт.Облигация
		|			И (УсловияОферт.ДатаВыкупа <= &Период)
		|			И (НЕ УсловияОферт.ТолькоДляФизическихЛиц)
		|			И (УсловияОферт.ТипОферты = ЗНАЧЕНИЕ(Перечисление.ТипыОфертПоОблигациям.Досрочно))
		|			И (УсловияОферт.ДатаОбъявления <= &Период)
		|			И (УсловияОферт.ДатаВыкупа <> ДАТАВРЕМЯ(2019, 6, 10))
		|			И (УсловияОферт.ДатаВыкупа <> ДАТАВРЕМЯ(2019, 6, 3))"; // это даты, в которые прошли ковенанты - редчайшие случаи обязательная оферта, которая не гасит весь выпуск, пока захардкодил
	
	Запрос.УстановитьПараметр("Биржа", Биржа);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ЦеннаяБумага", ЦеннаяБумага);
	Запрос.УстановитьПараметр("ВалютаРУБ", ВалютаРубль);
	Запрос.УстановитьПараметр("ЦенныеБумагиПоКоторымБиржаНеДаетКупон", ЦенныеБумагиПоКоторымБиржаНеДаетКупон);
	Запрос.УстановитьПараметр("ВалютныеОблигацииСКупономВРубляхУКоторыхММВБСчитаетНКДДваЗнака", ВалютныеОблигацииСКупономВРубляхУКоторыхММВБСчитаетНКДДваЗнака);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(19, 2)", "ЧИСЛО(19, " + Строка(РазрядностьРуб) + ")");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЧИСЛО(19, 4)", "ЧИСЛО(19, " + Строка(РазрядностьВал) + ")");
	
	Если ПроверятьКотировкиЦенныхБумаг Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КотировкиТорговыхПлощадок", "КотировкиЦенныхБумаг");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	
	РеквизитыДанныхКупона = "ЦеннаяБумага, Период, Процент, СуммаКупона, Срок, ДатаОкончанияКупона, ФормулаРасчетаСтавки, ИндексируемыйНоминал, Категория, ПериодНоминала, СтавкаОпределена, БазаРасчета";
	ДанныеКупона = Новый Структура(РеквизитыДанныхКупона);
	
	ТаблицаБумагСРасхождением = Новый ТаблицаЗначений;
	
	ТаблицаБумагСРасхождением.Колонки.Добавить("Облигация",		Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ТаблицаБумагСРасхождением.Колонки.Добавить("НКДБиржа",		Новый ОписаниеТипов("Число"));
	ТаблицаБумагСРасхождением.Колонки.Добавить("НКДРасчетный",	Новый ОписаниеТипов("Число"));
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ДанныеКупона, ВыборкаДетальныеЗаписи, РеквизитыДанныхКупона);
		
		Если ВыборкаДетальныеЗаписи.ВалютаНоминала = ВалютаРубль ИЛИ ВыборкаДетальныеЗаписи.ВалютаНоминала = ВалютаЮань Тогда
			Разрядность = РазрядностьРуб;
		Иначе
			Разрядность = РазрядностьВал;
		КонецЕсли;
		
		НестандартнаяТочность = НестандартныеТочностиОкругленийПоБумагам.Получить(ВыборкаДетальныеЗаписи.ЦеннаяБумага);
		Если НестандартнаяТочность <> Неопределено Тогда
			Разрядность = НестандартнаяТочность;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.ПрошлаОбязательнаяОферта Тогда
			НКДРасчетный = 0;
		Иначе
			НКДРасчетный = РаботаСЦеннымиБумагами.ПолучитьРасчетныйКупон(ВыборкаДетальныеЗаписи.ЦеннаяБумага, Период, Справочники.СчетаДоверительногоУправления.ПустаяСсылка(),, Разрядность, ДанныеКупона);
		КонецЕсли;
		
		Если НКДРасчетный = ВыборкаДетальныеЗаписи.Купон Тогда
		    Продолжить;
		КонецЕсли;
		
		СтрокаТаблицаБумагСРасхождением = ТаблицаБумагСРасхождением.Добавить();
		
		СтрокаТаблицаБумагСРасхождением.Облигация = ВыборкаДетальныеЗаписи.ЦеннаяБумага;
		СтрокаТаблицаБумагСРасхождением.НКДБиржа = ВыборкаДетальныеЗаписи.Купон;
		СтрокаТаблицаБумагСРасхождением.НКДРасчетный = НКДРасчетный;
		
	КонецЦикла;
	
	Возврат ТаблицаБумагСРасхождением;
	
КонецФункции

Процедура ПроверитьРасчетныйНКД(Параметры) Экспорт

	ДатаНачала = Параметры.ДатаНачала;
	ДатаОкончания = Параметры.ДатаОкончания;
	Биржа = Параметры.Биржа;
	
	ЦеннаяБумага = Неопределено;
	Параметры.Свойство("ЦеннаяБумага", ЦеннаяБумага);
	
	ПроверятьКотировкиЦенныхБумаг = Ложь;
	Если НЕ Параметры.Свойство("ПроверятьКотировкиЦенныхБумаг", ПроверятьКотировкиЦенныхБумаг) Тогда
		ПроверятьКотировкиЦенныхБумаг = Ложь;
	КонецЕсли;
	
	ОповещенияПоОрганизациям = Новый Массив();
	
	Период = ДатаНачала;
	Пока Период <= ДатаОкончания Цикл
		
		ТаблицаБумагСРасхождением = ПолучитьРасхожденияРасчетныхКупоновСКотировками(Период, Биржа, ПроверятьКотировкиЦенныхБумаг, ЦеннаяБумага);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаБумагСРасхождением.Облигация КАК Облигация,
			|	ТаблицаБумагСРасхождением.НКДБиржа КАК НКДБиржа,
			|	ТаблицаБумагСРасхождением.НКДРасчетный КАК НКДРасчетный
			|ПОМЕСТИТЬ _ТаблицаБумагСРасхождением
			|ИЗ
			|	&ТаблицаБумагСРасхождением КАК ТаблицаБумагСРасхождением
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация КАК Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа КАК НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный КАК НКДРасчетный,
			|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)) КАК Организация,
			|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)) КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ПоОрганизациямИСчетамДУ
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(&Период, Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ОстаткиЦенныхБумагОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный,
			|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)),
			|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(&ПериодКД, Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ОстаткиЦенныхБумагОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный,
			|	ЕСТЬNULL(ЗадолженностиПоЦеннымБумагамОстатки.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)),
			|	ЕСТЬNULL(ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(&Период, Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ЗадолженностиПоЦеннымБумагамОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный,
			|	ЕСТЬNULL(ЗадолженностиПоЦеннымБумагамОстатки.Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)),
			|	ЕСТЬNULL(ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(&ПериодКД, Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ЗадолженностиПоЦеннымБумагамОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
			|	_ПоОрганизациямИСчетамДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ПоОрганизациямИСчетамДУ.Облигация КАК Облигация,
			|	_ПоОрганизациямИСчетамДУ.НКДБиржа КАК НКДБиржа,
			|	_ПоОрганизациямИСчетамДУ.НКДРасчетный КАК НКДРасчетный
			|ПОМЕСТИТЬ _ПоОрганизациямИПолный
			|ИЗ
			|	_ПоОрганизациямИСчетамДУ КАК _ПоОрганизациямИСчетамДУ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_ПоОрганизациямИСчетамДУ.Организация,
			|	_ПоОрганизациямИСчетамДУ.СчетДоверительногоУправления,
			|	_ПоОрганизациямИСчетамДУ.Облигация,
			|	_ПоОрганизациямИСчетамДУ.НКДБиржа,
			|	_ПоОрганизациямИСчетамДУ.НКДРасчетный
			|ИЗ
			|	_ПоОрганизациямИСчетамДУ КАК _ПоОрганизациямИСчетамДУ
			|ГДЕ
			|	НЕ _ПоОрганизациямИСчетамДУ.Организация ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	_ПоОрганизациямИПолный.Облигация КАК Облигация,
			|	_ПоОрганизациямИПолный.НКДБиржа КАК НКДБиржа,
			|	_ПоОрганизациямИПолный.НКДРасчетный КАК НКДРасчетный,
			|	_ПоОрганизациямИПолный.Организация КАК Организация,
			|	_ПоОрганизациямИПолный.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	_ПоОрганизациямИПолный КАК _ПоОрганизациямИПолный
			|ИТОГИ
			|	МАКСИМУМ(НКДБиржа),
			|	МАКСИМУМ(НКДРасчетный)
			|ПО
			|	Организация,
			|	Облигация";
		
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("ПериодКД", КонецДня(Период));
		Запрос.УстановитьПараметр("ТаблицаБумагСРасхождением", ТаблицаБумагСРасхождением);
		
		ПараметрыПодключения = РаботаСоСтрокамиКлиентСервер.ПолучитьПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
		СсылкаИБ = СтрШаблон("e1c://server/%1/%2", ПараметрыПодключения.Srvr, ПараметрыПодключения.Ref);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОрганизация.Следующий() Цикл
			
			ВыборкаОблигация = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Если ВыборкаОблигация.Количество() = 0 Тогда
				Продолжить;	
			КонецЕсли;
			
			РеквизитыОповещения = Неопределено;
			Для каждого Оповещение Из ОповещенияПоОрганизациям Цикл
				Если Оповещение.Организация = ВыборкаОрганизация.Организация Тогда
					РеквизитыОповещения = Оповещение;
					Прервать;
				КонецЕсли; 
			КонецЦикла;
			Если РеквизитыОповещения = Неопределено Тогда
				РеквизитыОповещения = Новый Структура("Организация, Период, Биржа, ТекстОповещения", ВыборкаОрганизация.Организация, ПредставлениеПериода(ДатаНачала, ДатаОкончания), Биржа, "");
				ОповещенияПоОрганизациям.Добавить(РеквизитыОповещения);
			КонецЕсли;
			
			КолонкаОрганизации = "";
			Если ВыборкаОрганизация.Организация = Справочники.Организации.ПустаяСсылка() Тогда
				КолонкаОрганизации = "<td><b>Организации</b></td>";
			КонецЕсли;
			
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<br><p style=""font-family: Arial;font-size: 10pt;line-height: 1.13;""><span style=""font-size: 10pt;"">Дата: " + Формат(Период, "ДФ=dd.MM.yyyy") + "</span></p>";
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<table border=""0"" cellspacing=""1"" bgcolor=""#000000""><tr bgcolor=""#FFFFFF""><td><b>Облигация</b></td><td><b>НКД котировка</b></td><td><b>НКД расчетный</b></td><td><b>Счета ДУ</b></td>" + КолонкаОрганизации + "</tr>";
			
			Пока ВыборкаОблигация.Следующий() Цикл
				
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<tr bgcolor=""#FFFFFF"">";
				
				Ссылка = СсылкаИБ + "#" + ПолучитьНавигационнуюСсылку(ВыборкаОблигация.Облигация);
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td valign = ""top""><A href=""" + Ссылка + """>" + Строка(ВыборкаОблигация.Облигация) + "</A></td>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Строка(ВыборкаОблигация.НКДБиржа) + "</td>";
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td align = ""right"" valign = ""top"">" + Строка(ВыборкаОблигация.НКДРасчетный) + "</td>";
				
				СтрокаСчетаДУ = "";
				СтрокаОрганизации = "";
				
				ВыборкаДетальныеЗаписи = ВыборкаОблигация.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					Если ВыборкаДетальныеЗаписи.СчетДоверительногоУправления <> Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
						СтрокаСчетаДУ = СтрокаСчетаДУ + Строка(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления) + "<br>";
						СтрокаОрганизации = СтрокаОрганизации + Строка(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления.Организация) + "<br>";
					КонецЕсли;
					
				КонецЦикла;
				
			    РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td>" + СтрокаСчетаДУ + "</td>";
				Если ВыборкаОрганизация.Организация = Справочники.Организации.ПустаяСсылка() Тогда
					РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "<td>" + СтрокаОрганизации + "</td>";
				КонецЕсли;
			    
				РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "</tr>";
				
			КонецЦикла;
			
			РеквизитыОповещения.ТекстОповещения = РеквизитыОповещения.ТекстОповещения + "</table>";
			
		КонецЦикла;
		
		Период = Период + 24 * 60 * 60;
		
	КонецЦикла;
	
	Для каждого Оповещение Из ОповещенияПоОрганизациям Цикл
	
		Справочники.Оповещения.СформироватьОповещения("Обработка._ПроверкаРасчетногоНКД", Перечисления.ТипыСобытий.ВнешнийВызов, Оповещение);
	
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьОтчет(ДатаНачала, ДатаОкончания, Результат, Организация) Экспорт

	Результат.Очистить();
	
	Биржа = ОбщегоНазначения.ПолучитьИменованныйОбъект("Биржа_ММВБ");
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	Если Организация <> Справочники.Организации.ПустаяСсылка() Тогда
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ОбластьШапка.Параметры.Организация = Организация;
		
	Иначе
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка1");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка1");
		
	КонецЕсли;
	
	Дата = ДатаНачала;
	Пока Дата <= ДатаОкончания Цикл
		
		ОбластьШапка.Параметры.Дата = Дата;
		ОбластьШапка.Параметры.Биржа = Биржа;
		
		ВывелиШапку = Ложь;
		
		ПроверятьКотировкиЦенныхБумаг = (НачалоДня(КонецМесяца(Дата)) = Дата И Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, Дата));
		ТаблицаБумагСРасхождением = ПолучитьРасхожденияРасчетныхКупоновСКотировками(Дата, Биржа, ПроверятьКотировкиЦенныхБумаг);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаБумагСРасхождением.Облигация КАК Облигация,
			|	ТаблицаБумагСРасхождением.НКДБиржа КАК НКДБиржа,
			|	ТаблицаБумагСРасхождением.НКДРасчетный КАК НКДРасчетный
			|ПОМЕСТИТЬ _ТаблицаБумагСРасхождением
			|ИЗ
			|	&ТаблицаБумагСРасхождением КАК ТаблицаБумагСРасхождением
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация КАК Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа КАК НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный КАК НКДРасчетный,
			|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка)) КАК СчетДоверительногоУправления
			|ПОМЕСТИТЬ _ПоСчетамДУ
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
			|				&Период,
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					И Организация = &Организация) КАК ОстаткиЦенныхБумагОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный,
			|	ЕСТЬNULL(ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
			|				&ПериодКД,
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					И Организация = &Организация) КАК ОстаткиЦенныхБумагОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ОстаткиЦенныхБумагОстатки.ЦеннаяБумага
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный,
			|	ЕСТЬNULL(ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
			|				&Период,
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					И Организация = &Организация) КАК ЗадолженностиПоЦеннымБумагамОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ТаблицаБумагСРасхождением.Облигация,
			|	_ТаблицаБумагСРасхождением.НКДБиржа,
			|	_ТаблицаБумагСРасхождением.НКДРасчетный,
			|	ЕСТЬNULL(ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			|ИЗ
			|	_ТаблицаБумагСРасхождением КАК _ТаблицаБумагСРасхождением
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
			|				&ПериодКД,
			|				Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
			|					И Организация = &Организация) КАК ЗадолженностиПоЦеннымБумагамОстатки
			|		ПО _ТаблицаБумагСРасхождением.Облигация = ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПоСчетамДУ.Облигация КАК Облигация,
			|	ПоСчетамДУ.НКДБиржа КАК НКДБиржа,
			|	ПоСчетамДУ.НКДРасчетный КАК НКДРасчетный,
			|	ПоСчетамДУ.СчетДоверительногоУправления КАК СчетДоверительногоУправления
			|ИЗ
			|	_ПоСчетамДУ КАК ПоСчетамДУ
			|ИТОГИ
			|	МАКСИМУМ(НКДБиржа),
			|	МАКСИМУМ(НКДРасчетный)
			|ПО
			|	Облигация";
		
		Запрос.УстановитьПараметр("Период", Дата);
		Запрос.УстановитьПараметр("ПериодКД", КонецДня(Дата));
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("ТаблицаБумагСРасхождением", ТаблицаБумагСРасхождением);
		
		Если Организация = Справочники.Организации.ПустаяСсылка() Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВНУТРЕННЕЕ СОЕДИНЕНИЕ", "ЛЕВОЕ СОЕДИНЕНИЕ");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Организация = &Организация", "");
		КонецЕсли;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаОблигация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОблигация.Следующий() Цикл
			
			СчетаДУ = "";
			Организации = "";
			
			ВыборкаДетальныеЗаписи = ВыборкаОблигация.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если ВыборкаДетальныеЗаписи.СчетДоверительногоУправления = Справочники.СчетаДоверительногоУправления.ПустаяСсылка() Тогда
					Продолжить;
				КонецЕсли;
				СчетаДУ = СчетаДУ + Строка(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления) + Символы.ПС;
				Организации = Организации + Строка(ВыборкаДетальныеЗаписи.СчетДоверительногоУправления.Организация) + Символы.ПС;
			КонецЦикла;
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаОблигация, "Облигация,НКДБиржа,НКДРасчетный");
			ОбластьСтрока.Параметры.СчетаДУ = СчетаДУ;
			Если Организация = Справочники.Организации.ПустаяСсылка() Тогда
				ОбластьСтрока.Параметры.Организации = Организации;
			КонецЕсли;
			
			Если НЕ ВывелиШапку Тогда
				Результат.Вывести(ОбластьШапка);
				ВывелиШапку = Истина;
			КонецЕсли;
			
			Результат.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		Дата = Дата + 24 * 60 * 60;
		
	КонецЦикла;		
		
КонецПроцедуры

Процедура СформироватьОтчетСтарый(Дата, Результат, Организация) Экспорт
	
	Результат.Очистить();
	
	РазрядностьММВБРуб = 2;
	РазрядностьММВБВал = 4; // вот тут совсем странно: ММВБ дает то 4 то 6 знаков по разным валютным бумагам
	РазрядностьBloombergРуб = 2;
	РазрядностьBloombergВал = 4;
	
	МаксимальнаяРазрядность = 6;
	
	ВалютаРубль = Организация.ВалютаУчета;
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрокаСчетДУ = Макет.ПолучитьОбласть("СтрокаСчетДУ");
	
	ОбластьШапка.Параметры.Организация = Организация;
	ОбластьШапка.Параметры.Дата = Дата;
	
	Результат.Вывести(ОбластьШапка);
	
	ТаблицаНКД = Новый ТаблицаЗначений;
	
	ТаблицаНКД.Колонки.Добавить("Облигация",						Новый ОписаниеТипов("СправочникСсылка.Облигации"));
	ТаблицаНКД.Колонки.Добавить("НКДРасчетный",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаНКД.Колонки.Добавить("НКДММВБ",							Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	ТаблицаНКД.Колонки.Добавить("НКДBloomberg",						Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиЦенныхБумагОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала КАК ВалютаНоминала,
		|	ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория КАК Категория,
		|	ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).ИндексируемыйНоминал КАК ИндексируемыйНоминал,
		|	ВЫРАЗИТЬ(ОстаткиЦенныхБумагОстатки.ЦеннаяБумага КАК Справочник.Облигации).БазаРасчета КАК БазаРасчета
		|ПОМЕСТИТЬ _БумагиСоСчетами
		|ИЗ
		|	РегистрНакопления.ОстаткиЦенныхБумаг.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)) КАК ОстаткиЦенныхБумагОстатки
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗадолженностиПоЦеннымБумагамОстатки.СчетДоверительногоУправления,
		|	ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага,
		|	ВЫРАЗИТЬ(ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК Справочник.Облигации).ВалютаНоминала,
		|	ВЫРАЗИТЬ(ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК Справочник.Облигации).Категория,
		|	ВЫРАЗИТЬ(ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК Справочник.Облигации).ИндексируемыйНоминал,
		|	ВЫРАЗИТЬ(ЗадолженностиПоЦеннымБумагамОстатки.ЦеннаяБумага КАК Справочник.Облигации).БазаРасчета
		|ИЗ
		|	РегистрНакопления.ЗадолженностиПоЦеннымБумагам.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Рынок = ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Облигации)
		|				И ТипЗадолженности = ЗНАЧЕНИЕ(Перечисление.ТипыЗадолженности.Дебиторская)
		|				И ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке)) КАК ЗадолженностиПоЦеннымБумагамОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_БумагиСоСчетами.ЦеннаяБумага КАК ЦеннаяБумага,
		|	_БумагиСоСчетами.ВалютаНоминала КАК ВалютаНоминала,
