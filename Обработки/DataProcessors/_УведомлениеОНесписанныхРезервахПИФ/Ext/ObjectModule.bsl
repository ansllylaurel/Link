// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Уведомление о несписанных резервах ПИФ", "0.21", , Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "УведомлениеОНесписанныхРезервахПИФРЭМ", 		"Уведомление о несписанных резервах ПИФ (РЭМ)",,		Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "УведомлениеОНесписанныхРезервахПИФТраст", 	"Уведомление о несписанных резервах ПИФ (Траст)",,		Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "УведомлениеОНесписанныхРезервахПИФМДТраст", 	"Уведомление о несписанных резервах ПИФ (МД Траст)",,	Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции 

Процедура ОтправитьУведомления(Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПИФОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РезервыПИФОстатки.Резерв КАК Резерв,
		|	РезервыПИФОстатки.СуммаОстаток КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиНаКонецГода
		|ИЗ
		|	РегистрНакопления.РезервыПИФ.Остатки(
		|			&КонецПредыдущегоГода,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда)) КАК РезервыПИФОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РезервыПИФОстаткиИОбороты.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РезервыПИФОстаткиИОбороты.Резерв КАК Резерв
		|ПОМЕСТИТЬ _Списания
		|ИЗ
		|	РегистрНакопления.РезервыПИФ.ОстаткиИОбороты(
		|			&НачалоГода,
		|			&ПоследнийВыходной,
		|			Запись,
		|			Движения,
		|			Организация = &Организация
		|				И (СчетДоверительногоУправления, Резерв) В
		|					(ВЫБРАТЬ
		|						_ОстаткиНаКонецГода.СчетДоверительногоУправления,
		|						_ОстаткиНаКонецГода.Резерв
		|					ИЗ
		|						_ОстаткиНаКонецГода КАК _ОстаткиНаКонецГода)) КАК РезервыПИФОстаткиИОбороты
		|ГДЕ
		|	РезервыПИФОстаткиИОбороты.СуммаНачальныйОстаток <> 0
		|	И РезервыПИФОстаткиИОбороты.СуммаКонечныйОстаток = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОстаткиНаКонецГода.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиНаКонецГода.Резерв КАК Резерв,
		|	_ОстаткиНаКонецГода.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	_ОстаткиНаКонецГода КАК _ОстаткиНаКонецГода
		|ГДЕ
		|	НЕ (_ОстаткиНаКонецГода.СчетДоверительногоУправления, _ОстаткиНаКонецГода.Резерв) В
		|				(ВЫБРАТЬ
		|					_Списания.СчетДоверительногоУправления,
		|					_Списания.Резерв
		|				ИЗ
		|					_Списания КАК _Списания)
		|ИТОГИ ПО
		|	СчетДоверительногоУправления");
	
	Запрос.УстановитьПараметр("Организация", 			ЭтотОбъект.Организация);  		
	Запрос.УстановитьПараметр("КонецПредыдущегоГода",	Новый Граница(НачалоГода(ЭтотОбъект.Дата) - 1, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачалоГода", 			НачалоГода(ЭтотОбъект.Дата));
	Запрос.УстановитьПараметр("ПоследнийВыходной", 		Новый Граница(КонецДня(Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоГода(ЭтотОбъект.Дата), 1) - 86400), ВидГраницы.Включая));
	    		
	ВыборкаСчетаДУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаСчетаДУ.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		        	
	Пока ВыборкаСчетаДУ.Следующий() Цикл
		
		Текст = "Необходимо списать резервы ПИФ, оставшиеся с прошлого года:" + Символы.ПС;
		
		ВыборкаДетальныеЗаписи = ВыборкаСчетаДУ.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Текст = Текст + "	- " + СокрЛП(ВыборкаДетальныеЗаписи.Резерв) + " " + СокрЛП(ВыборкаДетальныеЗаписи.СуммаОстаток) + " руб." + Символы.ПС; 		
		КонецЦикла;
		
		РеквизитыОповещения = Новый Структура();
		РеквизитыОповещения.Вставить("Текст",							Текст);		
		РеквизитыОповещения.Вставить("Организация",						ЭтотОбъект.Организация);
		РеквизитыОповещения.Вставить("СчетДоверительногоУправления",	ВыборкаСчетаДУ.СчетДоверительногоУправления);		
			
		Справочники.Оповещения.СформироватьОповещения(ЭтотОбъект.Метаданные().ПолноеИмя(), Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
		
	КонецЦикла;
		
КонецПроцедуры

#Область Работа_с_Регламентными_Заданиями

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	//Выполняем только в рабочие дни
	Если Не Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата()) Тогда
		Возврат;
	КонецЕсли;
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "УведомлениеОНесписанныхРезервахПИФ") Тогда
		
		ЭтотОбъект.Дата			= ТекущаяДата();
		ЭтотОбъект.Организация	= ПараметрыКоманды.Организация;
				
#Область СборСтатистики_Начало

		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
		
		ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
			ЭтотОбъект, 
			"Период,Организация", 
			Новый Структура("ИдентификаторКоманды", ИдентификаторКоманды));
		
		Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);

#КонецОбласти

		ОтправитьУведомления();

#Область СборСтатистики_Конец

		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);	

#КонецОбласти

	КонецЕсли;   	
	
КонецПроцедуры // ВыполнитьКоманду


#КонецОбласти

