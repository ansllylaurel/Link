// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Выгрузить коды счетов доверительного управления у брокеров",
		"0.03",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВыгрузитьКодыСчетовДоверительногоУправленияУБрокеров", "Выгрузить коды счетов доверительного управления у брокеров",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = "ВыгрузитьКодыСчетовДоверительногоУправленияУБрокеров" Тогда
		ВыгрузитьКодыСчетовДоверительногоУправленияУБрокеров();
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыгрузитьКодыСчетовДоверительногоУправленияУБрокеров() Экспорт
	
	Период = НачалоДня(ТекущаяДата()); 

	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(Новый Структура, "", Новый Структура("Период", Период)); 
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя();
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание);
	
	Запрос1с = Новый Запрос;
	Запрос1с.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.Наименование КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация.Наименование КАК Организация,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Брокер.Наименование КАК Брокер
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&Период, ) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|ГДЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код <> """"";
	
	Запрос1с.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос1с.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
	
		ТЗКодыУБрокера = РезультатЗапроса.Выгрузить();
		
		СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
		
		Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(СтрокаСоединения);
		
		Соединение.BeginTrans();
		
		Соединение.Execute("DELETE FROM [Externals].[dbo].[Client_Broker_Codes]");
		
		Запрос = Новый COMОбъект("ADODB.Command");
		Запрос.CommandText = "INSERT INTO [Externals].[dbo].[Client_Broker_Codes] (Client_Code, Client_Name, Broker_Name, Organization_Name) VALUES (?, ?, ?, ?)";
		
		Запрос.CommandType		= 1;
		Запрос.Prepared			= "True";
		Запрос.NamedParameters	= "True";
		
		Запрос.Parameters.Append(Запрос.CreateParameter("@Client_Code", 		200, 1, 100));
		Запрос.Parameters.Append(Запрос.CreateParameter("@Client_Name", 		200, 1, 150));
		Запрос.Parameters.Append(Запрос.CreateParameter("@Broker_Name", 		200, 1, 150));
		Запрос.Parameters.Append(Запрос.CreateParameter("@Organization_Name",	200, 1, 150));
		
		Запрос.ActiveConnection = Соединение;
		
		Для Каждого СтрокаКодыУБрокера Из ТЗКодыУБрокера Цикл
		
			Запрос.Parameters("@Client_Code").Value			= Строка(СтрокаКодыУБрокера.Код);
			Запрос.Parameters("@Client_Name").Value			= Строка(СтрокаКодыУБрокера.СчетДоверительногоУправления);
			Запрос.Parameters("@Broker_Name").Value			= Строка(СтрокаКодыУБрокера.Брокер);
			Запрос.Parameters("@Organization_Name").Value	= Строка(СтрокаКодыУБрокера.Организация);
			
			Запрос.Execute();
		
		КонецЦикла;
		
		Соединение.CommitTrans();
		
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры

