Функция СфомироватьДокументыСЭД(Организация, МассивСчетовДУ, Период, ТекКаталогФайлов, Подписант, ПодписантДолжность, ТекМакет)

	ТекКаталогФайлов = ТекКаталогФайлов + ?(Прав(ТекКаталогФайлов, 1) = "\", "", "\");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Ссылка КАК Ссылка,
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.Процент КАК Процент,
		|	Распоряжение.ДатаРазмещения КАК ДатаРазмещения,
		|	Распоряжение.ДатаВозврата КАК ДатаВозврата,
		|	Распоряжение.Банк КАК Банк,
		|	Распоряжение.Сумма КАК Сумма,
		|	Распоряжение.Валюта КАК Валюта,
		|	Распоряжение.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	Распоряжение.РасчетныйСчетВозвратаДенежныхСредств КАК РасчетныйСчетВозвратаДенежныхСредств
		|ПОМЕСТИТЬ _ДанныеРаспоряжений
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.ДатаРазмещения = &Период
		|	И Распоряжение.Организация = &Организация
		|	И Распоряжение.СчетДоверительногоУправления В(&МассивСчетовДУ)
		|	И Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|	И НЕ Распоряжение.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Объект КАК Объект,
		|	РеквизитыЮридическихЛицСрезПоследних.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеПоУставу,
		|	РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеПоУставу
		|ПОМЕСТИТЬ _РеквизитыБанковКлиентов
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		_ДанныеРаспоряжений.Банк КАК Объект,
		|		_ДанныеРаспоряжений.Банк.ЮрФизЛицо КАК ЮрЛицо
		|	ИЗ
		|		_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления,
		|		КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|	ИЗ
		|		РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК КлиентыДоверительногоУправленияСрезПоследних) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСрезПоследних
		|		ПО ВложенныйЗапрос.ЮрЛицо = РеквизитыЮридическихЛицСрезПоследних.ЮрФизЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПРЕДСТАВЛЕНИЕ(КонтактныеЛица.КонтактноеЛицо) КАК Представление
		|ПОМЕСТИТЬ _ДанныеПодписанта
		|ИЗ
		|	РегистрСведений.КонтактныеЛица КАК КонтактныеЛица
		|ГДЕ
		|	КонтактныеЛица.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|	И КонтактныеЛица.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)
		|	И КонтактныеЛица.КонтактноеЛицо = &Подписант
		|	И КонтактныеЛица.Объект.Ссылка = &ЮрЛицоОрганизации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеРаспоряжений.Ссылка КАК Распоряжение,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеРаспоряжений.Банк.ЮрФизЛицо КАК БанкЮрЛицо,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).НомерДоговора КАК Номер,
		|	ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ГенСоглашения
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления В (&МассивСчетовДУ)) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
		|		ПО _ДанныеРаспоряжений.Организация = ДоговорыСчетовДоверительногоУправленияСрезПоследних.Организация
		|			И _ДанныеРаспоряжений.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам))
		|			И (_ДанныеРаспоряжений.Банк.ЮрФизЛицо = ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры).Контрагент)
		|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО ((ВЫРАЗИТЬ(ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор КАК Справочник.Договоры)) = УсловияДоговоровОбщиеСрезПоследних.Договор)
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ГенСоглашения.Распоряжение КАК Распоряжение,
		|	_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ГенСоглашения.БанкЮрЛицо КАК БанкЮрЛицо,
		|	_ГенСоглашения.Номер КАК Номер,
		|	_ГенСоглашения.ДатаЗаключения КАК ДатаЗаключения
		|ПОМЕСТИТЬ _ЕдиничныеГенСоглашения
		|ИЗ
		|	(ВЫБРАТЬ
		|		_ГенСоглашения.Распоряжение КАК Распоряжение,
		|		_ГенСоглашения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|		_ГенСоглашения.БанкЮрЛицо КАК БанкЮрЛицо,
		|		МАКСИМУМ(_ГенСоглашения.ДатаЗаключения) КАК ДатаЗаключения
		|	ИЗ
		|		_ГенСоглашения КАК _ГенСоглашения
		|	ГДЕ
		|		НЕ _ГенСоглашения.Номер ЕСТЬ NULL
		|	
		|	СГРУППИРОВАТЬ ПО
		|		_ГенСоглашения.Распоряжение,
		|		_ГенСоглашения.СчетДоверительногоУправления,
		|		_ГенСоглашения.БанкЮрЛицо) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ГенСоглашения КАК _ГенСоглашения
		|		ПО ВложенныйЗапрос.Распоряжение = _ГенСоглашения.Распоряжение
		|			И ВложенныйЗапрос.СчетДоверительногоУправления = _ГенСоглашения.СчетДоверительногоУправления
		|			И ВложенныйЗапрос.БанкЮрЛицо = _ГенСоглашения.БанкЮрЛицо
		|			И ВложенныйЗапрос.ДатаЗаключения = _ГенСоглашения.ДатаЗаключения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеРаспоряжений.Организация КАК Организация,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеРаспоряжений.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументовСчетаСписания,
		|	_ДанныеРаспоряжений.РасчетныйСчетВозвратаДенежныхСредств.Договор.НаименованиеВладельцаДляДокументов КАК НаименованиеВладельцаДляДокументовСчетаВозврата,
		|	_РеквизитыКлиентов.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеКлиентаПоУставу,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговораДУ,
		|	_ДанныеРаспоряжений.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаДоговораДУ,
		|	_ДанныеРаспоряжений.ДатаРазмещения КАК ДатаРазмещения,
		|	_РеквизитыБанков.ПолноеНаименованиеПоУставу КАК НаименованиеБанка,
		|	_РеквизитыБанков.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеБанка,
		|	_ДанныеРаспоряжений.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _ДанныеРаспоряжений.Валюта = &Российский_рубль
		|			ТОГДА ""руб.""
		|		ИНАЧЕ _ДанныеРаспоряжений.Валюта.НаименованиеПолное
		|	КОНЕЦ КАК Валюта,
		|	_ДанныеРаспоряжений.Процент КАК Процент,
		|	РАЗНОСТЬДАТ(_ДанныеРаспоряжений.ДатаРазмещения, _ДанныеРаспоряжений.ДатаВозврата, ДЕНЬ) КАК Срок,
		|	_ДанныеРаспоряжений.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
		|	_ЕдиничныеГенСоглашения.Номер КАК НомерГенСоглашения,
		|	_ЕдиничныеГенСоглашения.ДатаЗаключения КАК ДатаГенСоглашения,
		|	НомераПодтверждений.Номер КАК НомерПодтверждения
		|ИЗ
		|	_ДанныеРаспоряжений КАК _ДанныеРаспоряжений
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыБанковКлиентов КАК _РеквизитыКлиентов
		|		ПО _ДанныеРаспоряжений.СчетДоверительногоУправления = _РеквизитыКлиентов.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеквизитыБанковКлиентов КАК _РеквизитыБанков
		|		ПО _ДанныеРаспоряжений.Банк = _РеквизитыБанков.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЕдиничныеГенСоглашения КАК _ЕдиничныеГенСоглашения
		|		ПО _ДанныеРаспоряжений.Ссылка = _ЕдиничныеГенСоглашения.Распоряжение
		|			И _ДанныеРаспоряжений.СчетДоверительногоУправления = _ЕдиничныеГенСоглашения.СчетДоверительногоУправления
		|			И _ДанныеРаспоряжений.Банк.ЮрФизЛицо = _ЕдиничныеГенСоглашения.БанкЮрЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераОбъектов КАК НомераПодтверждений
		|		ПО _ДанныеРаспоряжений.Ссылка = НомераПодтверждений.Объект
		|			И (НомераПодтверждений.Организация = &Организация)
		|			И (НомераПодтверждений.ВидНумерации В (ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияСбербанка), ЗНАЧЕНИЕ(Справочник.ВидыНумерацииОбъектов.ПодтвержденияВТБ)))";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Период", НачалоДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивСчетовДУ", МассивСчетовДУ);
	Запрос.УстановитьПараметр("Подписант", Подписант);
	Запрос.УстановитьПараметр("ЮрЛицоОрганизации", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо"));
	Запрос.УстановитьПараметр("Российский_рубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДанныеПодписанта = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеПодписанта"].ПолучитьДанные().Выгрузить();
	
	ПодписантФИО = "";
	
	Если ДанныеПодписанта.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось заполнить данные подписанта [" + Подписант + "].");
    Иначе
		ПодписантФИО = ДанныеПодписанта[0].Представление;
	КонецЕсли;

	Если Выборка.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("На выбранную дату отсутствуют распоряжения на размещение депозитных владов.");
		Возврат Ложь;		
	КонецЕсли;
		
	Пока Выборка.Следующий() Цикл
			
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		ТекМакет.Параметры.ВидСделки = "Заключение депозита";
		ТекМакет.Параметры.ПредметСделки = "Размещение денежных средств в банковский вклад (депозит)";
		ТекМакет.Параметры.НаименованиеКлиента = ?(ЗначениеЗаполнено(Выборка.НаименованиеВладельцаДляДокументовСчетаСписания), Выборка.НаименованиеВладельцаДляДокументовСчетаСписания, Выборка.НаименованиеВладельцаДляДокументовСчетаВозврата);
		ТекМакет.Параметры.ПолноеНаименованиеЮрЛицаКлиента = Выборка.ПолноеНаименованиеКлиентаПоУставу; 
		ТекМакет.Параметры.НомерДоговораДУ = Выборка.НомерДоговораДУ;
		ТекМакет.Параметры.ДатаДоговораДУ = Формат(Выборка.ДатаДоговораДУ, "ДФ='dd.MM.yyyy ''г.'''");
		ТекМакет.Параметры.ДатаУведомления = Формат(Выборка.ДатаРазмещения, "ДФ='dd.MM.yyyy ''г.'''");
		ТекМакет.Параметры.ВремяУведомления = Формат(ТекущаяДатаСеанса(), "ДФ='Ч'':''мм'");
		ТекМакет.Параметры.ДатаОплаты = Формат(Выборка.ДатаРазмещения, "ДФ='dd.MM.yyyy ''г.'''");
		ТекМакет.Параметры.ПодписантФИО = ПодписантФИО;
		
		ТекМакет.Параметры.Контрагент = Выборка.НаименованиеБанка;
		ТекМакет.Параметры.Сумма = Формат(Выборка.Сумма, "ЧДЦ=2");
		ТекМакет.Параметры.Валюта = Выборка.Валюта;
				
		ТекМакет.Параметры.УсловияСделки = 
			"Процентная ставка - " + Выборка.Процент + "% годовых; "
			+ СтрокаСЧислом(";срок - %1 день;;срок - %1 дня;срок - %1 дней;срок - %1 дня", Выборка.Срок, ВидЧисловогоЗначения.Количественное, "L=ru") + ";"
			+ " выплата процентов - " + НРег(Выборка.ПериодичностьВыплатыПроцентов) + "."; 
			
		Если ЗначениеЗаполнено(Выборка.НомерГенСоглашения) Тогда
			
			ТекМакет.Параметры.ДокОснование = "Соглашение № " + Выборка.НомерГенСоглашения + " от " + Формат(Выборка.ДатаГенСоглашения, "ДЛФ=DD");
			ТекМакет.Параметры.Приложение = "Проект Подтверждения Сделки № " + РаботаСоСтрокамиКлиентСервер.СократитьЛидирующиеНули(Выборка.НомерПодтверждения) + " от " + Формат(Выборка.ДатаРазмещения, "ДФ='dd.MM.yyyy ''г.'''");
						
		Иначе
			
			ТекМакет.Параметры.ДокОснование = "";
			ТекМакет.Параметры.Приложение = "Проект ДОГОВОРА № _______________ срочного депозита со сроком привлечения до года/свыше года";	
			
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ТекМакет);
		
		ТабличныйДокумент.ОтображатьСетку = Ложь;
		ТабличныйДокумент.Защита = Ложь;
		ТабличныйДокумент.ТолькоПросмотр = Ложь;
		ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
		
		ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Строка(Выборка.Организация) + "_"
				+ Строка(Выборка.СчетДоверительногоУправления) + "_" + Выборка.КраткоеНаименованиеБанка + "_"
				+ Формат(Выборка.Сумма, "ЧДЦ=0") + "_" + Строка(Выборка.Срок) + "_" + Формат(Выборка.ДатаРазмещения, "ДФ=ddMMyyyy")) + ".xls";
		
		Попытка
					
			ТабличныйДокумент.Записать(ТекКаталогФайлов + ИмяФайла, ТипФайлаТабличногоДокумента.XLS);
			
			Если ЗначениеЗаполнено(Выборка.НомерГенСоглашения) И Не ЗначениеЗаполнено(Выборка.НомерПодтверждения) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите [номер банковского подтверждения] в уведомлении [" + ИмяФайла + "] в поле [Приложения].");	
			КонецЕсли;
			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка сохранения файла " + ТекКаталогФайлов + ИмяФайла + ": " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции