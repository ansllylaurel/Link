
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	Объект.Период = ТекущаяДата();
	
	Объект.ВыгружатьОтдельнымиФайлами = Ложь;
	
	НастроитьВидимостьИДоступность(ЭтаФорма); 
	
	Если ЗначениеЗаполнено(Объект.Период) И ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.РежимВыгрузки) Тогда
		ОбновитьНаСервере();	
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗапуститьПриложение(Объект.КаталогДанных + ?(Прав(Объект.КаталогДанных, 1) = "\", "", "\"));

КонецПроцедуры

&НаКлиенте
Процедура РежимВыгрузкиПриИзменении(Элемент)
	
	Объект.КаталогДанных = ПолучитьКаталогДанныхНаСервере(); 		
		
	Если Не ЗначениеЗаполнено(Объект.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не указан каталог выгрузки распоряжений на МНО (%1) для организации %2", Объект.РежимВыгрузки, Объект.Организация));
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Обновить(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РаботаСОтчетамиКлиент.ПодписантНачалоВыбора(ЭтаФорма, Элемент, Объект.Ответственный, Объект.Организация, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
		
	РаботаСОтчетамиКлиент.ПодписантОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, Новый Структура, Объект.Организация);
	
	Объект.Ответственный = ВыбранноеЗначение;
	
КонецПроцедуры

#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаВыгрузитьДанные(Команда)
		
	Если Не ЗначениеЗаполнено(Объект.РежимВыгрузки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите режим выгрузки.",, "РежимВыгрузки");
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определеть каталог для выгрузки данных.",, "ПутьВыгрузки");
		Возврат;	
	КонецЕсли; 
	
	Если Объект.РежимВыгрузки = "ВТБ" И Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен ответственный.",, "Объект.Ответственный");
		Возврат;	
	КонецЕсли;

	ВыгрузитьДанные();
	
КонецПроцедуры 

&НаКлиенте
Процедура Обновить(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите дату выгрузки.",, "Период");
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определеть организацию.");
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РежимВыгрузки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите режим выгрузки.",, "РежимВыгрузки");
		Возврат;	
	КонецЕсли;
	
	ОбновитьНаСервере();
	
	ЭтаФорма.Элементы.ГруппаСтраницы.ТекущаяСтраница = ЭтаФорма.Элементы.ГруппаТаблицаРаспоряжений;
		
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВсеФлажки(Команда)
	
 	ИзменитьФлажки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеФлажки(Команда)
	
	ИзменитьФлажки(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
		
	Элементы.Ответственный.Видимость = (Объект.РежимВыгрузки = "ВТБ");
	Элементы.ВыгружатьОтдельнымиФайлами.Видимость = (Объект.РежимВыгрузки = "ГПБ");
	
	Если Форма.Модифицированность Тогда
		РаботаСФормамиКлиентСервер.ОчиститьЗначенияСкрытыхПолей(Форма, Новый Структура("Ответственный", "Объект.Ответственный"));
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДанные()
	
	МассивРаспоряжений = Новый Массив;
	
	Для Каждого ТекСтрока Из ЭтаФорма.РаспоряженияДляВыгрузки Цикл
		
		Если ТекСтрока.Флажок Тогда
			МассивРаспоряжений.Добавить(ТекСтрока.Распоряжение);	
		КонецЕсли;
			
	КонецЦикла; 
	
	Если МассивРаспоряжений.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите распоряжения для выгрузки данных.");
		Возврат;		
	КонецЕсли;
		
	КаталогДанных = СокрЛП(СтрЗаменить(Объект.КаталогДанных, "/", "\"));	
	КаталогДанных = КаталогДанных + ?(Прав(КаталогДанных, 1) = "\", "", "\");
		
	КаталогДанныхПоДате = КаталогДанных + Формат(Объект.Период, "ДФ=yyyy") + "\" + Формат(Объект.Период, "ДФ=MMMM") + "\" + Формат(Объект.Период, "ДФ=yyyy-MM-dd");
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(КаталогДанныхПоДате, Отказ);
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;

	МассивФайлов = ВыгрузитьДанныеНаСервере(МассивРаспоряжений);
	
	Если МассивФайлов = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют данные для выгрузки.");	
	Иначе
	
		Для Каждого ТекФайл Из МассивФайлов Цикл 
		
			Попытка
		
				ТекФайл.ДвоичныеДанныеФайла.Записать(КаталогДанныхПоДате + "\" + ТекФайл.ИмяФайла);
					
			Исключение
									
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
				ЭтаФорма.РезультатВыгрузки = Неопределено;
				
			КонецПопытки;
			
		КонецЦикла;
				
		ЭтаФорма.Элементы.ГруппаСтраницы.ТекущаяСтраница = ЭтаФорма.Элементы.ГруппаСтраницаРезультат;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ВыгрузитьДанныеНаСервере(МассивРаспоряжений)
	
	МассивДанных = Неопределено; 
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	Механизм = ТекущийОбъект.Метаданные().ПолноеИмя() + ".ВыгрузитьДанныеНаСервере()";    
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ТекущийОбъект);
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ЭтаФорма.РезультатВыгрузки.Очистить();
	
	ТабДокумент = Неопределено;
	ДанныеДляВыгрузки = ТекущийОбъект.ПолучитьДанныеДляВыгрузки(МассивРаспоряжений);
		
	Если ДанныеДляВыгрузки <> Неопределено Тогда
		
		МассивДанных = Новый Массив;
		
		ТабДокумент = Новый ТабличныйДокумент;
		Макет = ТекущийОбъект.ПолучитьМакет("РезультатВыгрузки");
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ОбластьСтрокаОбщегоФайла = Макет.ПолучитьОбласть("СтрокаОбщегоФайла");
	
		ТабДокумент.Вывести(ОбластьШапка);
		Сч = 1;
		
		Для Каждого ПакетДанных Из ДанныеДляВыгрузки Цикл
					
			ОбластьСтрока.Параметры.Заполнить(ПакетДанных);			
			ОбластьСтрока.Параметры.Сч = Сч;
			
			Если ПакетДанных.ВременныйФайл = Неопределено Тогда
				
				Если ЗначениеЗаполнено(ПакетДанных.ТекстСообщения) Тогда
					ОбластьСтрока.Параметры.ФайлВыгружен = "Нет";
				Иначе
					ОбластьСтрока.Параметры.ТекстСообщения = "Данные сформированы в общий файл.";
					ОбластьСтрока.Параметры.ФайлВыгружен   = "Да";
				КонецЕсли;
				
			Иначе
				
				Если ПакетДанных.СчетДоверительногоУправления = Неопределено Тогда
					ОбластьСтрокаОбщегоФайла.Параметры.Заполнить(ПакетДанных);
					ОбластьСтрокаОбщегоФайла.Параметры.СчетДоверительногоУправления = "Выгрузка общего файла";
					ИмяФайла = Объект.РежимВыгрузки + "_Распоржения_На_" + ?(ПакетДанных.ВидРаспоряжения = "Депозит", "Депозиты", "МНО") + ".xml";
				Иначе
					ИмяФайла = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(Объект.РежимВыгрузки + "_" + ПакетДанных.ВидРаспоряжения + "_" + ПакетДанных.СчетДоверительногоУправления + "_" + ПакетДанных.Сумма + ".xml");	
				КонецЕсли;
				
				Если ПакетДанных.СчетДоверительногоУправления = Неопределено Тогда
					ОбластьСтрокаОбщегоФайла.Параметры.ФайлВыгружен = "Да";
				Иначе
					ОбластьСтрока.Параметры.ФайлВыгружен = "Да";
				КонецЕсли;

			    МассивДанных.Добавить(Новый Структура("ИмяФайла, ДвоичныеДанныеФайла", ИмяФайла, Новый ДвоичныеДанные(ПакетДанных.ВременныйФайл)));
				
			КонецЕсли;
			
			Если ПакетДанных.СчетДоверительногоУправления = Неопределено Тогда
				ТабДокумент.Вывести(ОбластьСтрокаОбщегоФайла);
				Продолжить;
			Иначе
				ТабДокумент.Вывести(ОбластьСтрока);
			КонецЕсли;
			
			Сч = Сч + 1;
	
		КонецЦикла;
	
		ТабДокумент.ОтображатьСетку = Ложь;
		ТабДокумент.ОтображатьЗаголовки = Ложь;
		ТабДокумент.ТолькоПросмотр = Истина;
								
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	ЭтаФорма.РезультатВыгрузки = ТабДокумент;
	
	Возврат МассивДанных; 
	
КонецФункции

&НаСервере
Функция ПолучитьКаталогДанныхНаСервере()
	
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("КаталогПодтвержденийМНО" + ?(Объект.РежимВыгрузки = "ГПБ", "", "_" + Объект.РежимВыгрузки), Объект.Организация, '00010101');
	
КонецФункции

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	Объект.Организация	= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
		
	Объект.КаталогДанных = ПолучитьКаталогДанныхНаСервере();
	
	Если Не ЗначениеЗаполнено(Объект.КаталогДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан каталог выгрузки распоряжений на МНО для организации " + Объект.Организация);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Период) И ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.РежимВыгрузки) Тогда
		ОбновитьНаСервере();	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Запрос = Новый Запрос;

#Область Текст_Запроса	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распоряжение.Ссылка КАК Ссылка,
		|	Распоряжение.Организация КАК Организация,
		|	Распоряжение.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Распоряжение.ВидОперации КАК ВидОперации,
		|	Распоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	Распоряжение.Сумма КАК Сумма
		|ПОМЕСТИТЬ _Распоряжения
		|ИЗ
		|	Документ.Распоряжение КАК Распоряжение
		|ГДЕ
		|	Распоряжение.Организация = &Организация
		|	И НЕ Распоряжение.ПометкаУдаления
		|	И (Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|				И Распоряжение.РасчетныйСчет.Банк = &Банк
		|				И НАЧАЛОПЕРИОДА(Распоряжение.Дата, ДЕНЬ) = &Период
		|			ИЛИ Распоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.РазмещениеКредитногоИнструмента)
		|				И Распоряжение.Банк = &Банк
		|				И Распоряжение.ДатаРазмещения = &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокРаспоряжение.Ссылка КАК Распоряжение,
		|	ДокРаспоряжение.РасчетныйСчет КАК РасчетныйСчет,
		|	НастройкиАкцептованияОперацийСрезПоследних.Организация КАК Организация,
		|	НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта КАК ВидАкцепта,
		|	ЕСТЬNULL(НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование, ЛОЖЬ) КАК ТребуетсяАкцепт
		|ПОМЕСТИТЬ _НастройкиАкцептования
		|ИЗ
		|	_Распоряжения КАК ДокРаспоряжение
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних(
		|				&КонецДня,
		|				Организация = &Организация
		|					И ВидАкцепта В (ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО), ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНОСрочный30Дней4ПроцентаУКПИ))) КАК НастройкиАкцептованияОперацийСрезПоследних
		|		ПО ДокРаспоряжение.Организация = НастройкиАкцептованияОперацийСрезПоследних.Организация
		|			И ДокРаспоряжение.СчетДоверительногоУправления = НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления 
		|			И ДокРаспоряжение.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.МНО)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НастройкиАкцептования.Распоряжение КАК Распоряжение,
		|	ВЫБОР
		|		КОГДА _НастройкиАкцептования.ТребуетсяАкцепт
		|			ТОГДА АкцептованиеОперацийСрезПоследних.Операция ЕСТЬ NULL
		|					ИЛИ АкцептованиеОперацийСрезПоследних.Срок <> ДАТАВРЕМЯ(1, 1, 1)
		|						И АкцептованиеОперацийСрезПоследних.Срок <= &Период
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ТребуетсяАкцепт
		|ПОМЕСТИТЬ _АкцептованиеОпераций
		|ИЗ
		|	_НастройкиАкцептования КАК _НастройкиАкцептования
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|				&КонецДня,
		|				(Организация, ВидАкцепта) В
		|						(ВЫБРАТЬ
		|							_НастройкиАкцептования.Организация,
		|							_НастройкиАкцептования.ВидАкцепта
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|						ГДЕ
		|							_НастройкиАкцептования.ТребуетсяАкцепт)
		|					И Операция В
		|						(ВЫБРАТЬ
		|							_НастройкиАкцептования.Распоряжение
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|						ГДЕ
		|							_НастройкиАкцептования.ТребуетсяАкцепт
		|				
		|						ОБЪЕДИНИТЬ
		|				
		|						ВЫБРАТЬ
		|							_НастройкиАкцептования.РасчетныйСчет
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования
		|						ГДЕ
		|							_НастройкиАкцептования.ТребуетсяАкцепт)) КАК АкцептованиеОперацийСрезПоследних
		|		ПО _НастройкиАкцептования.Организация = АкцептованиеОперацийСрезПоследних.Организация
		|			И _НастройкиАкцептования.ВидАкцепта = АкцептованиеОперацийСрезПоследних.ВидАкцепта
		|			И (_НастройкиАкцептования.Распоряжение = АкцептованиеОперацийСрезПоследних.Операция
		|				ИЛИ _НастройкиАкцептования.РасчетныйСчет = АкцептованиеОперацийСрезПоследних.Операция)
		|			И (_НастройкиАкцептования.ТребуетсяАкцепт)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Распоряжения.Ссылка КАК Распоряжение, 
		|	_Распоряжения.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Распоряжения.ВидОперации КАК ВидОперации,
		|	_Распоряжения.Сумма КАК Сумма,
		|	_АкцептованиеОпераций.ТребуетсяАкцепт КАК ТребуетсяАкцепт,
		|	НЕ _АкцептованиеОпераций.ТребуетсяАкцепт КАК ВыгрузкаДоступна
		|ИЗ
		|	_Распоряжения КАК _Распоряжения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _АкцептованиеОпераций КАК _АкцептованиеОпераций
		|		ПО _Распоряжения.Ссылка = _АкцептованиеОпераций.Распоряжение";
#КонецОбласти

	Запрос.УстановитьПараметр("Период",	Объект.Период);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Объект.Период));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Банк", ?(Объект.РежимВыгрузки = "ГПБ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ГПБ"), ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_ВТБ")));
	
	ЭтаФорма.РаспоряженияДляВыгрузки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для Каждого ТекСтрока Из ЭтаФорма.РаспоряженияДляВыгрузки Цикл 
		
		ТекСтрока.Флажок = ТекСтрока.ВыгрузкаДоступна;
			
	КонецЦикла;
			
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажки(ЗначениеФлажка)
	
	Для Каждого СтрокаТаблицыФормы Из ЭтаФорма.РаспоряженияДляВыгрузки Цикл
		
		СтрокаТаблицыФормы.Флажок = ?(СтрокаТаблицыФормы.ВыгрузкаДоступна, ЗначениеФлажка, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	Обновить(Неопределено);	
	
КонецПроцедуры

#КонецОбласти
