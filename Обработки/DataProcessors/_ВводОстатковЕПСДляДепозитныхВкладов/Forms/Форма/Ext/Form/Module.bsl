
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтаФорма.Объект, "Дата, Организация, СчетДоверительногоУправления, КорректировкаРегистров"); 
	Механизм			= "_ВводОстатковЕПСДляДепозитныхВкладов.Форма.ЗаполнитьНаСервере()";
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 

	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент КАК КредитныйИнструмент,
	               |	ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
	               |			&Период,
	               |			Организация = &Организация
	               |				И СчетДоверительногоУправления = &СчетДоверительногоУправления
	               |				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)) КАК ДенежныеСредстваВКредитныхИнструментахОстатки";
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",Объект.СчетДоверительногоУправления);
	
	Остатки = Запрос.Выполнить().Выгрузить();
	
	Объект.ОстаткиНаДепозитныхВкладах.Очистить();
			  
	Для Каждого Строка из Остатки Цикл
		
		НовыйСтрока = Объект.ОстаткиНаДепозитныхВкладах.Добавить();
		НовыйСтрока.ДепозитныйВклад = Строка.КредитныйИнструмент;
		НовыйСтрока.Остаток = Строка.СуммаОстаток;
		НовыйСтрока.Сумма = НовыйСтрока.Остаток;
		
	КонецЦикла;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиНаДепозитныхВкладахСуммаПроцентовПриИзменении(Элемент)
	// Вставить содержимое обработчика.
	ТекущиеДанные = Элементы.ОстаткиНаДепозитныхВкладах.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Остаток - ТекущиеДанные.СуммаПроцентов;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	ПараметрыСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ЭтаФорма.Объект, "Дата, Организация, СчетДоверительногоУправления, КорректировкаРегистров"); 
	Механизм			= "_ВводОстатковЕПСДляДепозитныхВкладов.Форма.ЗаписатьНаСервере()";
	Сессия				= РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм, ПараметрыСтатистики.Хранилище, ПараметрыСтатистики.Описание); 
	
	НачатьТранзакцию();

	Регистратор = Документы.КорректировкаРегистров.СоздатьДокумент();
	Регистратор.Дата                         = Объект.Дата;
	Регистратор.Организация                  = Объект.Организация;
	Регистратор.СчетДоверительногоУправления = Объект.СчетДоверительногоУправления;
	Регистратор.Ответственный                = РаботаСПользователями.ТекущийПользователь();
	Регистратор.Комментарий                  = "Импорт остатков на депозитных счетах в ЕПС";
	
	Регистратор.ТаблицаРегистров.Добавить(); 
	
	Колонки = Новый Массив;
	
	Колонки.Добавить("ЕдиныйБухгалтерскийУчет");
	
	Регистратор.ТаблицаРегистров.ЗагрузитьКолонку(Колонки, "Имя");
	Регистратор.Записать();
			
	Регистратор = Регистратор.Ссылка;


	НаборEБУ = РегистрыБухгалтерии.ЕдиныйБухгалтерскийУчет.СоздатьНаборЗаписей();
	НаборEБУ.Отбор.Регистратор.Установить(Регистратор);
	НаборEБУ.Прочитать();
	НаборEБУ.Очистить();
	
	Для Каждого СтрокаВводДепозитногоВклада Из Объект.ОстаткиНаДепозитныхВкладах Цикл
		
		УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС;
		// тело
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаВводДепозитногоВклада.Сумма, 
			СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Валюта, Объект.Организация, Объект.Дата);
		
		Проводка =  РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(
			Регистратор, НаборEБУ, СуммаОперации,
				"Ввод депозитного вклада при импорте остатков на депозитных счетах");
				
		Проводка.СчетДт = УчетныйАктив.СчетУчета;
		Проводка.СубконтоДт.БанковскиеСчета = СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет;
		Проводка.СубконтоДт.ДепозитныеВклады = СтрокаВводДепозитногоВклада.ДепозитныйВклад;
		
		Проводка.ВалютаДт  = СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаДт = СтрокаВводДепозитногоВклада.Сумма; 
		
		Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоКт.Договоры = Объект.СчетДоверительногоУправления;
		
		Проводка.ВалютаКт = СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаКт = СтрокаВводДепозитногоВклада.Сумма;
		
		// проценты
		СуммаОперации = РаботаСВалютами.ПолучитьСуммуВВалютеУчета(СтрокаВводДепозитногоВклада.СуммаПроцентов, 
			СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Валюта, Объект.Организация, Объект.Дата);
		
		Проводка =  РаботаСРегистрамиБухгалтерии.ДобавитьПроводку(
			Регистратор, НаборEБУ, СуммаОперации,
				"Ввод депозитного вклада при импорте остатков на депозитных счетах. Проценты");
				
		Проводка.СчетДт = УчетныйАктив.СчетУчетаПереоценкиА;
		Проводка.СубконтоДт.Контрагенты = СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Банк.ЮрФизЛицо;
		Проводка.СубконтоДт.УсловияЗаймовКредитовИДепозитов = СтрокаВводДепозитногоВклада.ДепозитныйВклад;
		
		Если НЕ ЗначениеЗаполнено( Проводка.СубконтоДт.Контрагенты) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Для вклада '" + СтрокаВводДепозитногоВклада.ДепозитныйВклад+ "' у банка не установлено ЮрФизЛицо. Проводки не будут сформированы!",СтрокаВводДепозитногоВклада.ДепозитныйВклад,,, );
		КонецЕсли;
		
		Проводка.ВалютаДт = СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Валюта;
		Проводка.ВалютнаяСуммаДт = СтрокаВводДепозитногоВклада.СуммаПроцентов;
		
		Проводка.СчетКт = ПланыСчетов.Единый.АктивыВДУ03;
		Проводка.СубконтоКт.Договоры = Объект.СчетДоверительногоУправления;
		Проводка.ВалютаКт  = СтрокаВводДепозитногоВклада.ДепозитныйВклад.БанковскийСчет.Валюта;
	    Проводка.ВалютнаяСуммаКт = СтрокаВводДепозитногоВклада.СуммаПроцентов;

	КонецЦикла;
		
	НаборEБУ.Записать();	
	 
	ЗафиксироватьТранзакцию();
	
	Объект.КорректировкаРегистров = Регистратор;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)	
	ЗаписатьНаСервере();
КонецПроцедуры