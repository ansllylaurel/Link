#КонецОбласти

#Область Команды_формы

&НаКлиенте
Процедура КомандаОбновить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("КомандаОбновить");
	
	ВыполнитьОбновление(ПараметрыСессии);
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновление(ПараметрыСессии)
	
	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		ТекстОшибки = "Не заполнены обязательные реквизиты";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	ОчиститьТаблицы();
					
	ПолучитьДанныеФайловНаСервере(ПараметрыСессии, Объект.КаталогФайлов);
				
	Если ЭтаФорма.ФайлыИмпорта.Количество() = 0 Тогда
		ТекстОшибки = "Не найдены файлы импорта";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
		
	ОбновитьДанныеНаСервере(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьВсеФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("КомандаСнятьВсеФлажки");
	ВыполнитьСнятиеВсехФлажков(Команда);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСнятиеВсехФлажков(Команда)
	
	Если СтрНайти(ЭтаФорма.ТекущийЭлемент.Имя, Команда.Имя) = 0 Тогда		
		ЭтаФорма.ТекущийЭлемент = Элементы[СтрЗаменить(Элементы.СтраницыЗагрузка.ТекущаяСтраница.Имя, "Страница", "")];
	КонецЕсли;
	
	ИмяТаблицы = СтрЗаменить(ЭтаФорма.ТекущийЭлемент.Имя, Команда.Имя, "");
	
	ИзменитьВсеФлажкиТаблицы(ИмяТаблицы, Ложь);
	
КонецПроцедуры    

&НаКлиенте
Процедура КомандаУстановитьВсеФлажки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("КомандаУстановитьВсеФлажки");
	ВыполнитьУстановкуВсехФлажков(Команда);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьУстановкуВсехФлажков(Команда)
	
	Если СтрНайти(ЭтаФорма.ТекущийЭлемент.Имя, Команда.Имя) = 0 Тогда		
		ЭтаФорма.ТекущийЭлемент = Элементы[СтрЗаменить(Элементы.СтраницыЗагрузка.ТекущаяСтраница.Имя, "Страница", "")];
	КонецЕсли;
	
	ИмяТаблицы = СтрЗаменить(ЭтаФорма.ТекущийЭлемент.Имя, Команда.Имя, "");
	
	ИзменитьВсеФлажкиТаблицы(ИмяТаблицы, Истина);

КонецПроцедуры

&НаКлиенте
Процедура КомандаИмпортировать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("КомандаИмпортировать");
	ИмпортироватьНаСервере(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаСверитьОстатки(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("КомандаСверитьОстатки");

	ВыполнитьСверкуОстатков(ПараметрыСессии);
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСверкуОстатков(ПараметрыСессии)
	
	ЭтаФорма.СверкаОстатков.Очистить(); 
	ЭтаФорма.ФайлыИмпорта.Очистить();
	
	КомандаСверитьОстаткиНаСервере(ПараметрыСессии, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРазделитьФайлы(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессиюНаСервере("КомандаРазделитьФайлы");
	ВыполнитьРазделениеФайлов(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРазделениеФайлов(ПараметрыСессии)
	
	РазрезатьФайлыНаСервере(ПараметрыСессии);
	                               
	// Открываем и сохраняем в Excel
	Если РезультатРазделенияФайла.Количество() > 0 Тогда
		
		ExcelApp = РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗапуститьПриложение();
		
		Если ExcelApp = Неопределено Тогда
			ТекстОшибки = "Не удалось запустить приложение Excel";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		Для Каждого ТекСтрока Из РезультатРазделенияФайла Цикл
			
			Попытка
				
				НоваяКнигаExcel = РаботаСВнешнимиСистемамиКлиентСервер.ExcelСоздатьКнигу(ExcelApp, ТекСтрока.ИмяФайла);
				
				xlOpenXMLWorkbook	= 51;
				НовыйПуть = СтрЗаменить(ТекСтрока.ИмяФайла, ".html", ".xlsx"); 
				НоваяКнигаExcel.SaveAs(НовыйПуть, xlOpenXMLWorkbook); 
				НоваяКнигаExcel.Close();
				
				УдалитьФайлы(ТекСтрока.ИмяФайла);
				
				ТекСтрока.ИмяФайла = НовыйПуть;
				
			Исключение
				ОписаниеОшибкиИмпорта = ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибкиИмпорта);
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ОписаниеОшибкиИмпорта);
			КонецПопытки;	
			   		
		КонецЦикла;
		
		РаботаСВнешнимиСистемамиКлиентСервер.ExcelЗакрытьПриложение(ExcelApp);
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_процедуры_и_функции

&НаКлиенте
Процедура ОткрытьКаталог(ИмяРеквизита, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Адрес = "";
	
	Если Не ПустаяСтрока(Объект[ИмяРеквизита]) Тогда
		Адрес = Объект[ИмяРеквизита];
	КонецЕсли;
	
	Если Адрес <> "" Тогда
		ЗапуститьПриложение(Адрес);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицы()
	
	ЭтаФорма.ФайлыИмпорта.Очистить();   
	ЭтаФорма.РазмещенияДепозитныхВкладов.Очистить();
	ЭтаФорма.ЗакрытияДепозитныхВкладов.Очистить();
	ЭтаФорма.НачисленияКомиссии.Очистить();
	ЭтаФорма.ОплатыКомиссии.Очистить();
	ЭтаФорма.СверкаОстатков.Очистить();
	ЭтаФорма.РезультатРазделенияФайла.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеНаСервере(ПараметрыСессии)
		
	ИмяФайлаДанныхНаСервере = ПолучитьИмяВременногоФайла("xml");
	
	ШаблонТаблицыСделок = СоздатьТаблицуЗначений("TradeNo,TradeDate,TradeTime,Value,DepoRate,Amount,ExchComm,ClrComm,DueDate,SystemRef");	                                                		
	ШаблонТаблицыДДС 	= СоздатьТаблицуЗначений("CODETYPE,CREDIT,DATE,DEBIT,NUMBER,PAY_ACC,PAY_NAME,ACCOUNT,CURRENCY,CLOSING_BALANCE,PURPOSE_PAYMENT,REC_ACC,REC_NAME,TIME,TRANSKIND,TRANTYPE");
	
	СтруктураВнешнихДанных = Новый Структура("РазмещенияДепозитныхВкладов, ДопДанныеРазмещенияДепозитныхВкладов, ЗакрытияДепозитныхВкладов, НачисленияКомиссии, ОплатыКомиссии, ДвиженияДенежныхСредств, СверкаОстатков", 
									ШаблонТаблицыСделок.Скопировать(), 
									ШаблонТаблицыСделок.Скопировать(), 
									ШаблонТаблицыСделок.Скопировать(), 
									ШаблонТаблицыСделок.Скопировать(), 
									ШаблонТаблицыСделок.Скопировать(), 
									ШаблонТаблицыДДС.Скопировать(),
									ШаблонТаблицыДДС.Скопировать());
	
	Для Каждого СтрокаФайловИмпорта Из ЭтаФорма.ФайлыИмпорта Цикл
			
		СтрокаФайловИмпорта.ДанныеФайла.Записать(ИмяФайлаДанныхНаСервере);
		СтрокаФайловИмпорта.ДанныеФайла = Неопределено;
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяФайлаДанныхНаСервере, "windows-1251");
		
		ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
		Если Не ПустаяСтрока(ТекстФайла) Тогда		
			ЗаполнитьДаннымиФайлаНаСервере(ТекстФайла, СтруктураВнешнихДанных, ПараметрыСессии);
		КонецЕсли;
		
		УдалитьФайлы(ИмяФайлаДанныхНаСервере);
		
	КонецЦикла;
	
	// Для размещений депозитов нужно определить счета депозитных вкладов и заполнить дату завершения
	Если СтруктураВнешнихДанных.РазмещенияДепозитныхВкладов.Количество() > 0 Тогда 
				
		СтруктураВнешнихДанных.РазмещенияДепозитныхВкладов.Колонки.Добавить("НомерСчета",  Новый ОписаниеТипов("Строка", ,,, Новый КвалификаторыСтроки(20)));
		
		Для Каждого СтрокаРазмещения Из СтруктураВнешнихДанных.РазмещенияДепозитныхВкладов Цикл
			
			НайдСтрокиДопДанные = СтруктураВнешнихДанных.ДопДанныеРазмещенияДепозитныхВкладов.НайтиСтроки(Новый Структура("TradeNo", СокрЛП(СтрокаРазмещения.TradeNo)));
			
			Если НайдСтрокиДопДанные.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаРазмещения.DueDate = НайдСтрокиДопДанные[0].DueDate;
			
			НайдСтрокиДДС = СтруктураВнешнихДанных.ДвиженияДенежныхСредств.НайтиСтроки(Новый Структура("PURPOSE_PAYMENT", "Привлечение средств в депозит " + СокрЛП(СтрокаРазмещения.TradeNo)));
			
			Если НайдСтрокиДДС.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаРазмещения.НомерСчета = НайдСтрокиДДС[0].REC_ACC;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Заполняем таблицы на форме
	Для Каждого ТекСтрока Из СтруктураВнешнихДанных.РазмещенияДепозитныхВкладов Цикл
		
		НоваяСтрока = ЭтаФорма.РазмещенияДепозитныхВкладов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);		
		
		НоваяСтрока.Сумма			= XMLЗначение(Тип("Число"), ТекСтрока.Amount); 
		НоваяСтрока.Ставка 			= XMLЗначение(Тип("Число"), ТекСтрока.DepoRate);
		НоваяСтрока.ДатаПогашения 	= XMLЗначение(Тип("Дата"), 	ТекСтрока.DueDate);
		НоваяСтрока.НомерДоговора 	= ТекСтрока.TradeNo;
	
		НоваяСтрока.Флаг 			= ?(ЗначениеЗаполнено(НоваяСтрока.Ссылка), Ложь, Истина);
		
	КонецЦикла;
	
	Для Каждого ТекСтрока Из СтруктураВнешнихДанных.ЗакрытияДепозитныхВкладов Цикл
		
		НоваяСтрока = ЭтаФорма.ЗакрытияДепозитныхВкладов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.НомерДоговора 	= ТекСтрока.TradeNo;
		
		НоваяСтрока.Флаг = ?(ЗначениеЗаполнено(НоваяСтрока.Ссылка), Ложь, Истина);
		
	КонецЦикла;
	
	Для Каждого ТекСтрока Из СтруктураВнешнихДанных.НачисленияКомиссии Цикл
		
		Если Не (ЗначениеЗаполнено(ТекСтрока.ExchComm) Или ЗначениеЗаполнено(ТекСтрока.ClrComm)) Тогда
			Продолжить;
		КонецЕсли;
		
		НайдСтрокиРазмещений = СтруктураВнешнихДанных.РазмещенияДепозитныхВкладов.НайтиСтроки(Новый Структура("SystemRef", ТекСтрока.TradeNo));
		
		Если НайдСтрокиРазмещений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ЭтаФорма.НачисленияКомиссии.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.НомерДоговора 	= НайдСтрокиРазмещений[0].TradeNo;
		НоваяСтрока.Сумма			= XMLЗначение(Тип("Число"), ТекСтрока.ExchComm) + XMLЗначение(Тип("Число"), ТекСтрока.ClrComm); 
				
		НоваяСтрока.Флаг = ?(ЗначениеЗаполнено(НоваяСтрока.Ссылка), Ложь, Истина);
		
		НоваяСтрока = ЭтаФорма.ОплатыКомиссии.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.НомерДоговора 	= НайдСтрокиРазмещений[0].TradeNo;
		НоваяСтрока.Сумма			= XMLЗначение(Тип("Число"), ТекСтрока.ExchComm) + XMLЗначение(Тип("Число"), ТекСтрока.ClrComm); 
				
		НоваяСтрока.Флаг = ?(ЗначениеЗаполнено(НоваяСтрока.Ссылка), Ложь, Истина);
		
	КонецЦикла; 
		
	Для Каждого ТекСтрока Из СтруктураВнешнихДанных.СверкаОстатков Цикл
		
		Сумма = XMLЗначение(Тип("Число"), ТекСтрока.CLOSING_BALANCE); 
		Если СтрНачинаетсяС(ТекСтрока.Account, "30420810") Тогда
			
			НоваяСтрока = ЭтаФорма.СверкаОстатков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			НоваяСтрока.Сумма		= Сумма;
			НоваяСтрока.НомерСчета	= ТекСтрока.Account;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьОстаткиНаСервере();
	
	ЗаполнитьСуществующиеДокументыНаСервере();
	
КонецПроцедуры
    
&НаСервереБезКонтекста
Функция СоздатьТаблицуЗначений(КолонкиТаблицы)
	
	ШаблонТаблицы = Новый ТаблицаЗначений;
	
	КолонкиТаблицы = СтрРазделить(КолонкиТаблицы, ",");
	ТипСтрока = Новый ОписаниеТипов("Строка", ,,, Новый КвалификаторыСтроки(100));
	ШаблонТаблицы.Колонки.Добавить("СчетДоверительногоУправления", Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	
	Для Каждого КолонкаТаблицы Из КолонкиТаблицы Цикл
		ШаблонТаблицы.Колонки.Добавить(КолонкаТаблицы, ТипСтрока);
	КонецЦикла; 
	
	Возврат ШаблонТаблицы;
	
КонецФункции

&НаСервере            
Процедура СоздатьДепозитныеВкладыИРазмещенияНаСервере(ПараметрыСессии)
			
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("Документ",						Новый ОписаниеТипов("ДокументСсылка.Распоряжение"));
	ТаблицаДанных.Колонки.Добавить("УчетныйАктив",					Новый ОписаниеТипов("СправочникСсылка.УчетныеАктивыЕПС"));
 	ТаблицаДанных.Колонки.Добавить("РасчетныйСчетДепозита",			Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));
	ТаблицаДанных.Колонки.Добавить("СчетДоверительногоУправления",	Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ТаблицаДанных.Колонки.Добавить("Банк",							Новый ОписаниеТипов("СправочникСсылка.Банки"));
 	ТаблицаДанных.Колонки.Добавить("НомерПодтверждения",			Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(70)));
	ТаблицаДанных.Колонки.Добавить("ДатаПодтверждения",				Новый ОписаниеТипов("Дата"));	
	ТаблицаДанных.Колонки.Добавить("ДепозитЗаключенПоДоговору",		Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("Биржевой",						Новый ОписаниеТипов("Булево"));
	ТаблицаДанных.Колонки.Добавить("ДатаРазмещения",				Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("ДатаВозврата",					Новый ОписаниеТипов("Дата"));
	ТаблицаДанных.Колонки.Добавить("Ставка",						Новый ОписаниеТипов("Число"));
	ТаблицаДанных.Колонки.Добавить("Сумма",							Новый ОписаниеТипов("Число")); 
	ТаблицаДанных.Колонки.Добавить("НомерДоговора",					Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	
	Банк_НКО_НКЦ			= ОбщегоНазначения.ПолучитьИменованныйОбъект("Банк_НКО_НКЦ");
	Реквизиты_НКО_НКЦ		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Банк_НКО_НКЦ, "Код, ЮрФизЛицо");
	          
	Для Каждого ТекСтрокаРазмещения Из РазмещенияДепозитныхВкладов Цикл
		
		Если Не ТекСтрокаРазмещения.Флаг Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДанных.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаРазмещения); 
		НоваяСтрока.УчетныйАктив = Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС;
		НоваяСтрока.ДепозитЗаключенПоДоговору = Истина;
		НоваяСтрока.Биржевой = Истина;
		Справочники.БанковскиеСчета.СоздатьПолучитьРасчетныйСчет(НоваяСтрока.РасчетныйСчетДепозита, 
				Объект.Организация, 
				Реквизиты_НКО_НКЦ.Код, 
				ТекСтрокаРазмещения.НомерСчета, 
				Реквизиты_НКО_НКЦ.ЮрФизЛицо, 
				Ложь,
				Ложь); 
				
		НоваяСтрока.Банк 			= Банк_НКО_НКЦ;		
		НоваяСтрока.ДатаРазмещения 	= Объект.ДатаИмпорта;
		НоваяСтрока.ДатаВозврата	= ТекСтрокаРазмещения.ДатаПогашения;
			
	КонецЦикла;
	
	ТаблицаРазмещений = СоздатьДепозитыИРазмещения(Объект.Организация, ТаблицаДанных, ПараметрыСессии);
	Для Каждого СтрокаТаблицыРазмещений Из ТаблицаРазмещений Цикл
		
		НайдСтроки = РазмещенияДепозитныхВкладов.НайтиСтроки(Новый Структура("НомерДоговора", СтрокаТаблицыРазмещений.НомерДоговора));
		Если НайдСтроки.Количество() > 0 Тогда
			НайдСтроки[0].Ссылка	= СтрокаТаблицыРазмещений.РазмещениеДепозита;
			НайдСтроки[0].Флаг		= Ложь;
		КонецЕсли;		
				
	КонецЦикла;
					
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьДепозитыИРазмещения(Организация, ИсходныеДанные, ПараметрыСессии) Экспорт
	
	ТаблицаРазмещений = Новый ТаблицаЗначений;
	ТаблицаРазмещений.Колонки.Добавить("НомерДоговора", 		Новый ОписаниеТипов("Строка"));
	ТаблицаРазмещений.Колонки.Добавить("РазмещениеДепозита", 	Новый ОписаниеТипов("ДокументСсылка.РазмещениеКредитногоИнструмента"));
	  	
	Если ТипЗнч(ИсходныеДанные) <> Тип("ТаблицаЗначений") Тогда
		
		ТекстОшибкиФормата = "Данные для создания депозитного вклада не соответствует формату";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиФормата);
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиФормата);
		Возврат Неопределено;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	#Область Текст_запроса
	
	Запрос.Текст =
	 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	ИсходныеДанные.Документ КАК Документ,
	 	|	ИсходныеДанные.УчетныйАктив КАК УчетныйАктив,
	 	|	ИсходныеДанные.РасчетныйСчетДепозита КАК РасчетныйСчетДепозита,
	 	|	ИсходныеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	ИсходныеДанные.НомерПодтверждения КАК НомерПодтверждения,
	 	|	ИсходныеДанные.ДатаПодтверждения КАК ДатаПодтверждения,
	 	|	ИсходныеДанные.ДатаРазмещения КАК ДатаРазмещения,
	 	|	ИсходныеДанные.ДатаВозврата КАК ДатаВозврата,
	 	|	ИсходныеДанные.ДепозитЗаключенПоДоговору КАК ДепозитЗаключенПоДоговору,
	 	|	ИсходныеДанные.Биржевой КАК Биржевой,
	 	|	ИсходныеДанные.Ставка КАК Ставка,
	 	|	ИсходныеДанные.Сумма КАК Сумма,
	 	|	ИсходныеДанные.Банк КАК Банк,
	 	|	ИсходныеДанные.НомерДоговора КАК НомерДоговора
	 	|ПОМЕСТИТЬ _ИсходныеДанные
	 	|ИЗ
	 	|	&ИсходныеДанные КАК ИсходныеДанные
	 	|;
	 	|
	 	|////////////////////////////////////////////////////////////////////////////////
	 	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	&Организация КАК Организация,
	 	|	_ИсходныеДанные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	_ИсходныеДанные.Ставка КАК Процент,
	 	|	_ИсходныеДанные.ДатаРазмещения КАК ДатаРазмещения,
	 	|	_ИсходныеДанные.ДатаВозврата КАК ДатаВозврата,
	 	|	_ИсходныеДанные.Банк КАК Банк,
	 	|	ВЫРАЗИТЬ(_ИсходныеДанные.Банк КАК Справочник.Банки).ЮрФизЛицо КАК ЮрФизЛицоБанка,
	 	|	_ИсходныеДанные.Сумма КАК Сумма,
	 	|	&ВалютаУчета КАК Валюта,
	 	|	ЗНАЧЕНИЕ(Перечисление.ПериодичностиВыплатыПроцентов.ВКонцеСрока) КАК ПериодичностьВыплатыПроцентов,
	 	|	ЛОЖЬ КАК ДоВостребования,
	 	|	ЛОЖЬ КАК Субординированность,
	 	|	_ИсходныеДанные.Биржевой КАК Биржевой,
	 	|	_ИсходныеДанные.УчетныйАктив КАК УчетныйАктив,
	 	|	_ИсходныеДанные.РасчетныйСчетДепозита КАК РасчетныйСчетДепозита,
	 	|	_ИсходныеДанные.НомерПодтверждения КАК НомерПодтверждения,
	 	|	_ИсходныеДанные.ДатаПодтверждения КАК ДатаПодтверждения,
	 	|	_ИсходныеДанные.ДепозитЗаключенПоДоговору КАК ДепозитЗаключенПоДоговору,
	 	|	_ИсходныеДанные.НомерДоговора КАК НомерДоговора
	 	|ПОМЕСТИТЬ _Данные
	 	|ИЗ
	 	|	_ИсходныеДанные КАК _ИсходныеДанные
	 	|;
	 	|
	 	|////////////////////////////////////////////////////////////////////////////////
	 	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	Договоры.Контрагент КАК Контрагент,
	 	|	Договоры.Ссылка КАК Ссылка
	 	|ПОМЕСТИТЬ _ГенСоглашения
	 	|ИЗ
	 	|	_Данные КАК _Данные
	 	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСчетовДоверительногоУправления.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК ДоговорыСчетовДоверительногоУправленияСрезПоследних
	 	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	 	|				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&ТекущаяДата, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
	 	|				ПО Договоры.Ссылка = УсловияДоговоровОбщиеСрезПоследних.Договор
	 	|			ПО ДоговорыСчетовДоверительногоУправленияСрезПоследних.Договор = Договоры.Ссылка
	 	|				И (Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.ГенСоглашениеПоДепозитнымВкладам))
	 	|				И (НЕ Договоры.ПометкаУдаления)
	 	|		ПО _Данные.СчетДоверительногоУправления = ДоговорыСчетовДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
	 	|			И (ДоговорыСчетовДоверительногоУправленияСрезПоследних.Активный)
	 	|			И (НЕ _Данные.ДепозитЗаключенПоДоговору)
	 	|ГДЕ
	 	|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
	 	|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
	 	|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &ТекущаяДата)
	 	|;
	 	|
	 	|////////////////////////////////////////////////////////////////////////////////
	 	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	_Данные.Организация КАК Организация,
	 	|	_Данные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	_Данные.УчетныйАктив КАК УчетныйАктив,
	 	|	_Данные.ДатаРазмещения КАК ДатаРазмещения,
	 	|	_Данные.РасчетныйСчетДепозита КАК РасчетныйСчетДепозита,
	 	|	_Данные.НомерПодтверждения КАК НомерПодтверждения,
	 	|	_Данные.НомерДоговора КАК НомерДоговора,
	 	|	_Данные.ДатаПодтверждения КАК ДатаПодтверждения,
	 	|	_ГенСоглашения.Ссылка КАК ГенСоглашение,
	 	|	ДепозитныеВклады.Ссылка КАК КредитныйИнструмент
	 	|ПОМЕСТИТЬ _Ошибки
	 	|ИЗ
	 	|	_Данные КАК _Данные
	 	|		ЛЕВОЕ СОЕДИНЕНИЕ _ГенСоглашения КАК _ГенСоглашения
	 	|		ПО _Данные.СчетДоверительногоУправления = _ГенСоглашения.СчетДоверительногоУправления
	 	|			И (ВЫРАЗИТЬ(_Данные.Банк КАК Справочник.Банки).ЮрФизЛицо = _ГенСоглашения.Контрагент)
	 	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
	 	|		ПО _Данные.Организация = ДепозитныеВклады.Организация
	 	|			И _Данные.РасчетныйСчетДепозита = ДепозитныеВклады.БанковскийСчет
	 	|			И _Данные.ДатаРазмещения = ДепозитныеВклады.ДатаРегистрации
	 	|			И (НЕ ДепозитныеВклады.ПометкаУдаления)
	 	|ГДЕ
	 	|	(_Данные.УчетныйАктив = ЗНАЧЕНИЕ(Справочник.УчетныеАктивыЕПС.ПустаяСсылка)
	 	|			ИЛИ _Данные.РасчетныйСчетДепозита = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
	 	|			ИЛИ (_Данные.НомерПодтверждения = """"
	 	|				ИЛИ _Данные.ДатаПодтверждения = ДАТАВРЕМЯ(1, 1, 1))
	 	|				И НЕ _ГенСоглашения.Ссылка ЕСТЬ NULL
	 	|			ИЛИ НЕ ДепозитныеВклады.Ссылка ЕСТЬ NULL)
	 	|;
	 	|
	 	|////////////////////////////////////////////////////////////////////////////////
	 	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 	|	_Данные.Организация КАК Организация,
	 	|	_Данные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
	 	|	ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК) КАК МестоХранения,
	 	|	_Данные.Процент КАК Процент,
	 	|	_Данные.ДатаРазмещения КАК ДатаРазмещения,
	 	|	_Данные.ДатаВозврата КАК ДатаВозврата,
	 	|	_Данные.Банк КАК Банк,
	 	|	_Данные.Сумма КАК Сумма,
	 	|	_Данные.Валюта КАК Валюта,
	 	|	_Данные.ПериодичностьВыплатыПроцентов КАК ПериодичностьВыплатыПроцентов,
	 	|	_Данные.ДоВостребования КАК ДоВостребования,
	 	|	_Данные.Субординированность КАК Субординированность,
	 	|	_Данные.УчетныйАктив КАК УчетныйАктив,
	 	|	_Данные.РасчетныйСчетДепозита КАК РасчетныйСчетДепозита,
	 	|	_Данные.НомерПодтверждения КАК НомерПодтверждения,
	 	|	_Данные.ДатаПодтверждения КАК ДатаПодтверждения,
	 	|	_Данные.ЮрФизЛицоБанка КАК ЮрФизЛицоБанка,
	 	|	_Данные.НомерДоговора КАК НомерДоговора,
	 	|	ДепозитныеВклады.Ссылка КАК Депозит,
	 	|	РазмещенияДепозитов.Ссылка КАК РазмещениеДепозита
	 	|ИЗ
	 	|	_Данные КАК _Данные
	 	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
	 	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазмещениеКредитногоИнструмента КАК РазмещенияДепозитов
	 	|			ПО ДепозитныеВклады.Организация = РазмещенияДепозитов.Организация
	 	|				И ДепозитныеВклады.Ссылка = РазмещенияДепозитов.КредитныйИнструмент
	 	|				И (РазмещенияДепозитов.Проведен)
	 	|		ПО _Данные.Организация = ДепозитныеВклады.Организация
	 	|			И _Данные.РасчетныйСчетДепозита = ДепозитныеВклады.БанковскийСчет
	 	|			И _Данные.ДатаРазмещения = ДепозитныеВклады.ДатаРегистрации
	 	|			И (НЕ ДепозитныеВклады.ПометкаУдаления)
	 	|		ЛЕВОЕ СОЕДИНЕНИЕ _Ошибки КАК _Ошибки
	 	|		ПО _Данные.РасчетныйСчетДепозита = _Ошибки.РасчетныйСчетДепозита
	 	|ГДЕ
	 	|	(_Ошибки.РасчетныйСчетДепозита ЕСТЬ NULL
	 	|			ИЛИ ДепозитныеВклады.Ссылка ЕСТЬ NULL
	 	|			ИЛИ РазмещенияДепозитов.Ссылка ЕСТЬ NULL)";
	
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ТекущаяДата", 	ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("ВалютаУчета", 	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВалютаУчета"));
	Запрос.УстановитьПараметр("ИсходныеДанные", ИсходныеДанные); 
	
	ВыборкаРаспоряжений = Запрос.Выполнить().Выбрать();
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_Ошибки"].ПолучитьДанные().Выбрать();
	
	Пока ВыборкаОшибок.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ВыборкаОшибок.УчетныйАктив) Тогда
			ТекстОшибкиВыборки = "При создании депозитного вклада не указан учетный актив. Номер договора [" + ВыборкаОшибок.НомерДоговора + "]. Счету ДУ [" + ВыборкаОшибок.СчетДоверительногоУправления + "].";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиВыборки);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиВыборки);
		Конецесли;
		
		Если Не ЗначениеЗаполнено(ВыборкаОшибок.РасчетныйСчетДепозита) Тогда
			ТекстОшибкиВыборки = "При создании депозитного вклада не указан расчетный счет депозитного вклада. Номер договора [" + ВыборкаОшибок.НомерДоговора + "]. Счету ДУ [" + ВыборкаОшибок.СчетДоверительногоУправления + "].";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиВыборки);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиВыборки);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаОшибок.ГенСоглашение) Тогда
			
			Если Не ЗначениеЗаполнено(ВыборкаОшибок.НомерПодтверждения) Тогда
				ТекстОшибкиВыборки = "При создании депозитного вклада не заполнен номер подтверждения. Номер договора [" + ВыборкаОшибок.НомерДоговора + "]. Счету ДУ [" + ВыборкаОшибок.СчетДоверительногоУправления + "].";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиВыборки);
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиВыборки);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ВыборкаОшибок.ДатаПодтверждения) Тогда
				ТекстОшибкиВыборки = "Не заполнена дата подтверждения. Номер договора [" + ВыборкаОшибок.НомерДоговора + "]. Счету ДУ [" + ВыборкаОшибок.СчетДоверительногоУправления + "].";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиВыборки);
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиВыборки);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаОшибок.КредитныйИнструмент) Тогда
			ТекстОшибкиВыборки = "Найден существующий вклад  [" + ВыборкаОшибок.КредитныйИнструмент + "] с датой размещения [" + Формат(ВыборкаОшибок.ДатаРазмещения, "ДЛФ=Д") + "] и счетом [" + ВыборкаОшибок.РасчетныйСчетДепозита + "].";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиВыборки);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиВыборки);
		КонецЕсли;
		
	КонецЦикла;
		
	Пока ВыборкаРаспоряжений.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаРаспоряжений.РасчетныйСчетДепозита, "Договор")) Тогда
			
			// Создаем договор депозитного вклада  
			ДоговорСсылка = Справочники.Договоры.ПолучитьСсылку(Новый УникальныйИдентификатор);
			ОбъектРасчетныйСчетДепозита 									= ВыборкаРаспоряжений.РасчетныйСчетДепозита.ПолучитьОбъект();   
			ОбъектРасчетныйСчетДепозита.ЮрФизЛицо							= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ЮрФизЛицо");
			ОбъектРасчетныйСчетДепозита.ВидБанковскогоСчета					= Перечисления.ВидыБанковскихСчетов.ДепозитныйСчет;
			ОбъектРасчетныйСчетДепозита.ДатаОткрытия						= ВыборкаРаспоряжений.ДатаРазмещения;    
			ОбъектРасчетныйСчетДепозита.ВидУправленияДовереннымиСредствами	= Справочники.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ;
			
			НовыйДоговорДепозита = Справочники.Договоры.СоздатьЭлемент();			
			НовыйДоговорДепозита.УстановитьСсылкуНового(ДоговорСсылка);  
			
			НовыйДоговорДепозита.ВидДоговора	= Перечисления.ВидыДоговоров.БанковскогоДепозита;
			НовыйДоговорДепозита.Организация	= Организация;
			НовыйДоговорДепозита.ДатаЗаключения	= ВыборкаРаспоряжений.ДатаРазмещения; 
			НовыйДоговорДепозита.Контрагент		= ВыборкаРаспоряжений.ЮрФизЛицоБанка;
			НовыйДоговорДепозита.НомерДоговора	= ВыборкаРаспоряжений.НомерДоговора;
			
			РеквизитыДляНаименования			= РаботаСНормативноСправочнойИнформацией.ПолучитьЗадействованныеВНаименованииРеквизиты(ДоговорСсылка);
			НовыйДоговорДепозита.Наименование	= РаботаСНормативноСправочнойИнформацией.СформироватьНаименование(ДоговорСсылка, 
														ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(НовыйДоговорДепозита, РеквизитыДляНаименования));
			
			НовыйДоговорДепозита.Записать();
			ОбъектРасчетныйсчетДепозита.Договор = НовыйДоговорДепозита.Ссылка;
			ОбъектРасчетныйсчетДепозита.Записать();
			
			// Добавляем связь договора со счетом доверительного управления 
			Отказ = Ложь;
			РегистрыСведений.ДоговорыСчетовДоверительногоУправления.ДобавитьСвязьДоговораИСчетаДоверительногоУправления(
					ВыборкаРаспоряжений.ДатаРазмещения,
					НовыйДоговорДепозита.Ссылка,
					ВыборкаРаспоряжений.СчетДоверительногоУправления,
					Отказ);
					
			Если Отказ Тогда				
				Продолжить;				
			КонецЕсли;
			
		КонецЕсли;
		
		// Создаем депозит, если еще нет
		Если Не ЗначениеЗаполнено(ВыборкаРаспоряжений.Депозит) Тогда
			
			НачатьТранзакцию();
					
			ДепозитСсылка = Справочники.ДепозитныеВклады.ПолучитьСсылку(Новый УникальныйИдентификатор);
			
			ДепозитныйВклад = Справочники.ДепозитныеВклады.СоздатьЭлемент();
			ДепозитныйВклад.УстановитьСсылкуНового(ДепозитСсылка);
			ДепозитныйВклад.Организация		= Организация;
			ДепозитныйВклад.БанковскийСчет	= ВыборкаРаспоряжений.РасчетныйСчетДепозита;
			ДепозитныйВклад.МестоХранения	= ВыборкаРаспоряжений.МестоХранения;
			ДепозитныйВклад.ДатаРегистрации	= ВыборкаРаспоряжений.ДатаРазмещения;
			
			//Номер подтверждения заполняется только для клиентов, у которых заключено ген. соглашение по депозитным вкладам		
			ДепозитныйВклад.НомерПодтверждения				= ВыборкаРаспоряжений.НомерПодтверждения;
			ДепозитныйВклад.ДатаПодтверждения				= ВыборкаРаспоряжений.ДатаПодтверждения;
			ДепозитныйВклад.ДатаНачалаНачисленияПроцентов	= ВыборкаРаспоряжений.ДатаРазмещения + (24 * 60 * 60);		
			ДепозитныйВклад._НачальныйНоминал				= ВыборкаРаспоряжений.Сумма;
			
			ДепозитныйВклад.ДоВостребования		= ВыборкаРаспоряжений.ДоВостребования;
			ДепозитныйВклад.Субординированность	= ВыборкаРаспоряжений.Субординированность;
			РеквизитыДляНаименования			= РаботаСНормативноСправочнойИнформацией.ПолучитьЗадействованныеВНаименованииРеквизиты(ДепозитСсылка);
  			ДепозитныйВклад.Наименование 		= РаботаСНормативноСправочнойИнформацией.СформироватьНаименование(ДепозитСсылка, 
														ОбщегоНазначенияКлиентСервер.ПоляВСтруктуру(ДепозитныйВклад, РеквизитыДляНаименования));
			
			Попытка
				ДепозитныйВклад.Записать();
			Исключение
				
				ТекстОшибкиЗаписи = "Не удалось создать депозитный вклад." + Символы.ПС + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаписи);
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиЗаписи);
				ОтменитьТранзакцию();
				Продолжить;
				
			КонецПопытки;
			
			Запись = РегистрыСведений.УсловияКредитныхИнструментов.СоздатьМенеджерЗаписи();
			
			Запись.Период 							= ВыборкаРаспоряжений.ДатаРазмещения;
			Запись.Организация						= Организация;
			Запись.КредитныйИнструмент				= ДепозитСсылка;
			Запись.ДатаНачалаДействияУсловий		= ВыборкаРаспоряжений.ДатаРазмещения;
			Запись.ДатаПогашения					= ВыборкаРаспоряжений.ДатаВозврата;
			Запись.ПериодичностьВыплатыПроцентов	= ВыборкаРаспоряжений.ПериодичностьВыплатыПроцентов;
			Запись.Процент							= ВыборкаРаспоряжений.Процент;
			Запись.УчетныйАктив						= ВыборкаРаспоряжений.УчетныйАктив;
			Запись.Действует						= Истина;	
					
			Попытка
				Запись.Записать(Истина);
			Исключение
				
				ТекстОшибкиЗаписи = "Не удалось записать условия кредитного инструмента." + Символы.ПС + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаписи);
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиЗаписи);
				ОтменитьТранзакцию();
				Продолжить;
				
			КонецПопытки;
			
			ДепозитныйВклад.ПлановыеВыплаты.Загрузить(Справочники.ДепозитныеВклады.ПолучитьРасчетВыплат(ДепозитСсылка));
			ДепозитныйВклад.Записать();
					
			ЗафиксироватьТранзакцию();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан депозитный вклад [" + ДепозитСсылка + "]"); 
			
		Иначе
			
			ДепозитСсылка = ВыборкаРаспоряжений.Депозит;
			
		КонецЕсли;	
        			
		РазмещениеКредитногоИнструмента									= Документы.РазмещениеКредитногоИнструмента.СоздатьДокумент(); 
		
		// Время ставим позже, т. к. перед размещением могут быть переводы
		РазмещениеКредитногоИнструмента.Дата							= ВыборкаРаспоряжений.ДатаРазмещения + 17 * 60 * 60; 
		РазмещениеКредитногоИнструмента.Организация						= Организация;
		РазмещениеКредитногоИнструмента.СчетДоверительногоУправления	= ВыборкаРаспоряжений.СчетДоверительногоУправления;			
		РазмещениеКредитногоИнструмента.КредитныйИнструмент				= ДепозитСсылка;
		РазмещениеКредитногоИнструмента.Сумма							= ВыборкаРаспоряжений.Сумма; 
		РазмещениеКредитногоИнструмента.Ответственный					= РаботаСПользователями.ТекущийПользователь();
		
		ОшибкаПроведения = Ложь;
		
		//Пробуем провести, потом записать.
		Для Инд = 1 По 2 Цикл
			
			Если Не ОшибкаПроведения Тогда
			
				Попытка
					
					РазмещениеКредитногоИнструмента.Записать(РежимЗаписиДокумента.Проведение);
					Прервать;
					
				Исключение
					ОшибкаПроведения = Истина;
				КонецПопытки;
				
			Иначе
				
				Попытка
					РазмещениеКредитногоИнструмента.Записать(РежимЗаписиДокумента.Запись);
					ТекстОшибкиПроведения = "Не удалось провести документ [" + РазмещениеКредитногоИнструмента + "]. Документ находится в состоянии записан.";
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиПроведения);
					ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиПроведения);
				Исключение
					ТекстОшибкиПроведения = "Не удалось записать документ [Размещение кредитного инструмента]." + Символы.ПС + ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиПроведения);	
					ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиПроведения);
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не РазмещениеКредитногоИнструмента.ЭтоНовый() Тогда
			
			НоваяСтрокаРезультата = ТаблицаРазмещений.Добавить();
			НоваяСтрокаРезультата.НомерДоговора = ВыборкаРаспоряжений.НомерДоговора;
			НоваяСтрокаРезультата.РазмещениеДепозита = РазмещениеКредитногоИнструмента.Ссылка;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ТаблицаРазмещений;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДаннымиФайлаНаСервере(ТекстФайла, СтруктураДанных, ПараметрыСессии)
	                 	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM    = ПостроительDOM.Прочитать(ЧтениеXML);           
	
	Для Каждого ЭлементDOM Из ДокументDOM.ДочерниеУзлы Цикл
		
		Если ЭлементDOM.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ВидФайлаDOM Из ЭлементDOM.ДочерниеУзлы Цикл
			
			Если ВидФайлаDOM.ИмяУзла = "EQM06" Тогда
				
				Для Каждого ФирмаDOM Из ВидФайлаDOM.ДочерниеУзлы Цикл
					
					Если ФирмаDOM.ИмяУзла = "FIRM" Тогда             
						
						Для Каждого КодНаММВБDOM Из ФирмаDOM.ДочерниеУзлы Цикл
							
							ТекКод =  КодНаММВБDOM.ПолучитьАтрибут("ExtSettleCode");
							СчетаДУ = Объект.КодыСчетовДУНаММВБ.НайтиСтроки(Новый Структура("КодНаММВБ", ТекКод));
							Если СчетаДУ.Количество() = 0 Тогда
								ТекстОшибкиСчетаДУ = "Не найден счет ДУ с кодом на бирже ММВБ " + ТекКод;
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиСчетаДУ);
								ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиСчетаДУ);
								Продолжить;
							КонецЕсли;
							
							СчетДоверительногоУправления = СчетаДУ[0].СчетДоверительногоУправления;
							
							Для Каждого ВалютаDOM Из КодНаММВБDOM.ДочерниеУзлы Цикл
								
								Для Каждого ВидДокументаDOM Из ВалютаDOM.ДочерниеУзлы Цикл						
									
									Если ВидДокументаDOM.ПолучитьАтрибут("InfType") = "1" Тогда
										
										// Исполненные сделки/ депозитные договоры/ кредитные договоры предыдущих дней   
										// Здесь получаем данные для закрытия депозитов
										ЗаполнитьДанныеПоДокументам(СтруктураДанных.ЗакрытияДепозитныхВкладов, ВидДокументаDOM, СчетДоверительногоУправления);
										
										
									ИначеЕсли ВидДокументаDOM.ПолучитьАтрибут("InfType") = "2" Тогда	
										
										// Исполненные сделки/ депозитные договоры/ кредитные договоры текущего дня
										// Здесь получаем данные для размещения депозитов										
										ЗаполнитьДанныеПоДокументам(СтруктураДанных.РазмещенияДепозитныхВкладов, ВидДокументаDOM, СчетДоверительногоУправления);
								
									ИначеЕсли ВидДокументаDOM.ПолучитьАтрибут("InfType") = "3" Тогда		
										
										// Сделки/ депозитные договоры/ кредитные договоры, подлежащие исполнению										
										// Здесь получаем дополнительные данные для размещения депозитов (например, дату завершения)
										ЗаполнитьДанныеПоДокументам(СтруктураДанных.ДопДанныеРазмещенияДепозитныхВкладов, ВидДокументаDOM, СчетДоверительногоУправления);
										
									ИначеЕсли ВидДокументаDOM.ПолучитьАтрибут("InfType") = "5" Тогда
										
										// Заявки на заключение депозитных договоров, внесенные в реестр предложений / Заявления на изменение суммы депозита
										// Здесь получаем данные по начисленным комиссиям										
										ЗаполнитьДанныеПоДокументам(СтруктураДанных.НачисленияКомиссии, ВидДокументаDOM, СчетДоверительногоУправления);
										
									КонецЕсли;
									
								КонецЦикла;
															
							КонецЦикла;
							
						КонецЦикла;	
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ВидФайлаDOM.ИмяУзла = "CCX99" Тогда
				
				Для Каждого КодНаММВБDOM Из ВидФайлаDOM.ДочерниеУзлы Цикл
					
					ТекКод =  КодНаММВБDOM.ПолучитьАтрибут("ID");
					СчетаДУ = Объект.КодыСчетовДУНаММВБ.НайтиСтроки(Новый Структура("КодНаММВБ", ТекКод));
					Если СчетаДУ.Количество() = 0 Тогда						
						Продолжить;
					КонецЕсли;
					
					СчетДоверительногоУправления = СчетаДУ[0].СчетДоверительногоУправления;
					
					Для Каждого РасчетныйСчетDOM Из КодНаММВБDOM.ДочерниеУзлы Цикл
						
						// Для свеки остатков
						ДобавитьСтрокуВТаблицу(СтруктураДанных.СверкаОстатков, РасчетныйСчетDOM, СчетДоверительногоУправления);
						
						// Движения по счету
						Для Каждого ПоручениеDOM Из РасчетныйСчетDOM.ДочерниеУзлы Цикл
														
							ДобавитьСтрокуВТаблицу(СтруктураДанных.ДвиженияДенежныхСредств, ПоручениеDOM, СчетДоверительногоУправления);
							
						КонецЦикла;
						
					КонецЦикла;	
					
				КонецЦикла;		
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;	
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиДокументыПоНомерамДепозитов(МассивНомеровДепозитов, Организация)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК Ссылка,
		|	Договоры.НомерДоговора КАК НомерДоговора
		|ПОМЕСТИТЬ _Договоры
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоров.БанковскогоДепозита)
		|	И Договоры.НомерДоговора В(&НомераДоговоров)
		|	И НЕ Договоры.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДепозитныеВклады.Ссылка КАК КредитныйИнструмент,
		|	_Договоры.НомерДоговора КАК НомерДоговора,
		|	РазмещениеКредитногоИнструмента.Ссылка КАК РазмещениеДепозита,
		|	ЗакрытиеКредитногоИнструмента.Ссылка КАК ЗакрытиеДепозита,
		|	НачислениеЗадолженностиОснования.Ссылка КАК НачислениеКомиссии,
		|	ОплатаОснования.Ссылка КАК ОплатаКомиссии
		|ИЗ
		|	_Договоры КАК _Договоры
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО _Договоры.НомерДоговора = ДепозитныеВклады.БанковскийСчет.Договор.НомерДоговора
		|			И (НЕ ДепозитныеВклады.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗакрытиеКредитногоИнструмента КАК ЗакрытиеКредитногоИнструмента
		|		ПО (_Договоры.НомерДоговора = ВЫРАЗИТЬ(ЗакрытиеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора)
		|			И (НЕ ЗакрытиеКредитногоИнструмента.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РазмещениеКредитногоИнструмента КАК РазмещениеКредитногоИнструмента
		|		ПО (_Договоры.НомерДоговора = ВЫРАЗИТЬ(РазмещениеКредитногоИнструмента.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора)
		|			И (НЕ РазмещениеКредитногоИнструмента.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НачислениеЗадолженности.Основания КАК НачислениеЗадолженностиОснования
		|		ПО (_Договоры.НомерДоговора = ВЫРАЗИТЬ(ВЫРАЗИТЬ(НачислениеЗадолженностиОснования.Основание КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора)
		|			И (НЕ НачислениеЗадолженностиОснования.Ссылка.ПометкаУдаления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата.Основания КАК ОплатаОснования
		|		ПО (_Договоры.НомерДоговора = ВЫРАЗИТЬ(ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.РазмещениеКредитногоИнструмента).КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Договор.НомерДоговора)
		|			И (НЕ ОплатаОснования.Ссылка.ПометкаУдаления)");
	
	Запрос.УстановитьПараметр("Организация", 		Организация);
	Запрос.УстановитьПараметр("НомераДоговоров", 	МассивНомеровДепозитов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеПоДокументам(ТаблицаДокументов, УзелDOM, СчетДоверительногоУправления)

	Для Каждого ТипКлирингаDOM Из УзелDOM.ДочерниеУзлы Цикл
		
		Для Каждого ВидСессииDOM Из ТипКлирингаDOM.ДочерниеУзлы Цикл
			
			Для Каждого НаправлениеСделкиDOM Из ВидСессииDOM.ДочерниеУзлы Цикл
			
				Для Каждого ПлощадкаDOM Из НаправлениеСделкиDOM.ДочерниеУзлы Цикл
			
					Для Каждого ВидАктиваDOM Из ПлощадкаDOM.ДочерниеУзлы Цикл
			
						Для Каждого ДепозитDOM Из ВидАктиваDOM.ДочерниеУзлы Цикл
			
							Для Каждого ЗаписьDOM Из ДепозитDOM.ДочерниеУзлы Цикл
			
								ДобавитьСтрокуВТаблицу(ТаблицаДокументов, ЗаписьDOM, СчетДоверительногоУправления);	
								
							КонецЦикла;	
							
						КонецЦикла;	
						
					КонецЦикла;	
					
				КонецЦикла;	
				
			КонецЦикла;	
			
		КонецЦикла;	
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуВТаблицу(ТаблицаДокументов, ЗаписьDOM, СчетДоверительногоУправления)
	
	НоваяСтрока = ТаблицаДокументов.Добавить();
	Для Каждого КолонкаТаблицы Из ТаблицаДокументов.Колонки Цикл
		Новаястрока[КолонкаТаблицы.Имя] = ЗаписьDOM.ПолучитьАтрибут(КолонкаТаблицы.Имя);
	КонецЦикла;
	
	НоваяСтрока.СчетДоверительногоУправления = СчетДоверительногоУправления; 
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеФайловНаСервере(ПараметрыСессии, ПутьКФайлам, ТолькоСверкаОстатков = Ложь)
	
	ПутьКФайлам = ?(Прав(ПутьКФайлам, 1) = "\", ПутьКФайлам, ПутьКФайлам + "\");
	ФайлыКаталога = НайтиФайлы(ПутьКФайлам + ?(Не ТолькоСверкаОстатков, Формат(Объект.ДатаИмпорта, "ДФ=ddMMyyyy"), ""), "*", Истина);
		
	Для Каждого Файл Из ФайлыКаталога Цикл
		
		Если Файл.Расширение <> ".xml"
			Или СтрНайти(Файл.Имя, Формат(Объект.ДатаИмпорта, "ДФ=ddMMyy")) = 0 
			Или (Не ТолькоСверкаОстатков 
				И СтрНайти(Файл.Имя, "EQM06") = 0 
				И СтрНайти(Файл.Имя, "CCX99") = 0) 
			Или (ТолькоСверкаОстатков 
				И СтрНайти(Файл.Имя, "CCX99") = 0)
			Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка         
			ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);			
		Исключение
			ТекстОшибкиЧтения = ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЧтения);
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиЧтения);
			Продолжить;
		КонецПопытки;	
		
		НоваяСтрока = Этаформа.ФайлыИмпорта.Добавить();
		НоваяСтрока.ИмяФайла    = Файл.Имя;
		НоваяСтрока.ТипФайла	= файл.Расширение;
		НоваяСтрока.ДанныеФайла = ДанныеФайла;
			
	КонецЦикла;
	
	Если ЭтаФорма.ФайлыИмпорта.Количество() = 0 Тогда
		ТекстОшибкиОтсутствияФайлов = "В папке [" + ПутьКФайлам + "] отсутствуют необходимые файлы за [" + Формат(Объект.ДатаИмпорта, "ДФ=dd.MM.yyyy")  + "]";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиОтсутствияФайлов);
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиОтсутствияФайлов);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИмпортироватьНаСервере(ПараметрыСессии)
	
	СоздатьЗакрытияДепозитовНаСервере();
	
	СоздатьДепозитныеВкладыИРазмещенияНаСервере(ПараметрыСессии);
			
	СоздатьНачисленияКомиссииНаСервере(ПараметрыСессии);
	
	СоздатьОплатыКомиссииНаСервере(ПараметрыСессии);
	
	ЗаполнитьСуществующиеДокументыНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗакрытияДепозитовНаСервере()
	
	ДанныеДляЗакрытияДепозитов = ЗакрытияДепозитныхВкладов.Выгрузить(Новый Структура("Флаг", Истина), "КредитныйИнструмент, Ссылка");
	
	Справочники.ДепозитныеВклады.СоздатьЗакрытияКредитныхИнструментов(Объект.Организация, Объект.ДатаИмпорта, ДанныеДляЗакрытияДепозитов); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток КАК СуммаВ1С
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&ПериодГраница,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления.ВидДоговораДоверительногоУправления <> ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.Собственный)
		|				И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ММВБ_ДепозитыСЦК)) КАК ОстаткиДенежныхСредствОстатки");
	
	Запрос.УстановитьПараметр("ПериодГраница",	Новый Граница(КонецДня(Объект.ДатаИмпорта), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НайдСтроки = СверкаОстатков.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", Выборка.СчетДоверительногоУправления));
		Если НайдСтроки.Количество() > 0 Тогда
			НайдСтроки[0].СуммаВ1С = Выборка.СуммаВ1С;
		Иначе
			НоваяСтрока = СверкаОстатков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуществующиеДокументыНаСервере(Этап = 0)
	
	МассивНомеровДепозитов = РазмещенияДепозитныхВкладов.Выгрузить().ВыгрузитьКолонку("НомерДоговора");
	РаботаСКоллекциями.ДополнитьМассив(МассивНомеровДепозитов, ЗакрытияДепозитныхВкладов.Выгрузить().ВыгрузитьКолонку("НомерДоговора"));
	СуществующиеДокументы = НайтиДокументыПоНомерамДепозитов(МассивНомеровДепозитов, Объект.Организация);
	
	Если Этап <= 2 Тогда
		
		Для Каждого ТекСтрока Из РазмещенияДепозитныхВкладов Цикл
				
			НайдСтроки = СуществующиеДокументы.НайтиСтроки(Новый Структура("НомерДоговора", ТекСтрока.НомерДоговора));
			Если НайдСтроки.Количество() > 0 Тогда
				ТекСтрока.Ссылка = НайдСтроки[0].РазмещениеДепозита;			
				ТекСтрока.Флаг = ?(ЗначениеЗаполнено(ТекСтрока.Ссылка), Ложь, Истина);
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
	Если Этап = 0 Тогда
	
		Для Каждого ТекСтрока Из ЗакрытияДепозитныхВкладов Цикл
				
			НайдСтроки = СуществующиеДокументы.НайтиСтроки(Новый Структура("НомерДоговора", ТекСтрока.НомерДоговора));
			Если НайдСтроки.Количество() > 0 Тогда
				ТекСтрока.РазмещениеДепозита	= НайдСтроки[0].РазмещениеДепозита;
				ТекСтрока.КредитныйИнструмент	= НайдСтроки[0].КредитныйИнструмент;
				ТекСтрока.Ссылка 				= НайдСтроки[0].ЗакрытиеДепозита;
				ТекСтрока.Флаг 					= ?(ЗначениеЗаполнено(ТекСтрока.Ссылка) Или Не ЗначениеЗаполнено(ТекСтрока.РазмещениеДепозита), Ложь, Истина);
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;
	
	Если Этап = 0 Или Этап = 2 Тогда
		
		Для Каждого ТекСтрока Из НачисленияКомиссии Цикл
				
			НайдСтроки = СуществующиеДокументы.НайтиСтроки(Новый Структура("НомерДоговора", ТекСтрока.НомерДоговора));
			Если НайдСтроки.Количество() > 0 Тогда
				ТекСтрока.РазмещениеДепозита	= НайдСтроки[0].РазмещениеДепозита;
				ТекСтрока.Ссылка 				= НайдСтроки[0].НачислениеКомиссии;
				ТекСтрока.Флаг 					= ?(ЗначениеЗаполнено(ТекСтрока.Ссылка) 
											Или (Этап = 2 И Не (ЗначениеЗаполнено(ТекСтрока.РазмещениеДепозита) И ТекСтрока.Флаг)), Ложь, Истина);
			КонецЕсли;
				
		КонецЦикла;  
		
	КонецЕсли;
	
	Если Этап = 0 Или Этап = 3 Тогда
		
		Для Каждого ТекСтрока Из ОплатыКомиссии Цикл
					
			НайдСтроки = СуществующиеДокументы.НайтиСтроки(Новый Структура("НомерДоговора", ТекСтрока.НомерДоговора));
			Если НайдСтроки.Количество() > 0 Тогда
				ТекСтрока.НачислениеКомиссии	= НайдСтроки[0].НачислениеКомиссии;
				ТекСтрока.Ссылка 				= НайдСтроки[0].ОплатаКомиссии;
				ТекСтрока.Флаг 					= ?(ЗначениеЗаполнено(ТекСтрока.Ссылка) 
											Или (Этап = 3 И Не (ЗначениеЗаполнено(ТекСтрока.НачислениеКомиссии) И ТекСтрока.Флаг)), Ложь, Истина);
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьНачисленияКомиссииНаСервере(ПараметрыСессии)
	
	ЗаполнитьСуществующиеДокументыНаСервере(2);
	
	ДанныеДляНачисленияКомиссиий 	= НачисленияКомиссии.Выгрузить(Новый Структура("Флаг", 	Истина), 	"РазмещениеДепозита, СчетДоверительногоУправления, Сумма, Ссылка");
		
	МассивСчетовДУ = ДанныеДляНачисленияКомиссиий.ВыгрузитьКолонку("СчетДоверительногоУправления");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивСчетовДУ);
	
	НКО_НКЦ 	= ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
	ВалютаУчета	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	
	Для Каждого ТекСчетДУ Из МассивСчетовДУ Цикл
		
		СтрокиКомиссии = ДанныеДляНачисленияКомиссиий.НайтиСтроки(Новый Структура("СчетДоверительногоУправления", ТекСчетДУ));
		
		НачатьТранзакцию();
		
		Если ЗначениеЗаполнено(СтрокиКомиссии[0].Ссылка) Тогда
			
			НачислениеКомиссии = СтрокиКомиссии[0].Ссылка.ПолучитьОбъект();
			
			Если НачислениеКомиссии.Проведен Тогда
				
				Попытка
					НачислениеКомиссии.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				Исключение
					ТекстОшибкиЗаписи = ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаписи, НачислениеКомиссии.Ссылка);
					ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиЗаписи);
					ОтменитьТранзакцию();
					Продолжить;
				КонецПопытки;
				
				НачислениеКомиссии.Основания.Очистить();
				
			КонецЕсли;
			
		Иначе
			НачислениеКомиссии = Документы.НачислениеЗадолженности.СоздатьДокумент();
		КонецЕсли;
		
		НачислениеКомиссии.Дата							= Объект.ДатаИмпорта + 10 * 60 * 60; 
		НачислениеКомиссии.Организация					= Объект.Организация;
		НачислениеКомиссии.СчетДоверительногоУправления	= ТекСчетДУ;			
		НачислениеКомиссии.ВидЗадолженности				= Справочники.ВидыЗадолженности.ПоТорговойКомиссии;
		НачислениеКомиссии.Контрагент					= НКО_НКЦ;
		НачислениеКомиссии.МестоХранения				= Справочники.МестаХранения.ММВБ_ДепозитыСЦК;
		НачислениеКомиссии.ДатаПолученияДокумента		= ТекущаяДатаСеанса();
		НачислениеКомиссии.Валюта						= ВалютаУчета;
		
		НачислениеКомиссии.Ответственный = РаботаСПользователями.ТекущийПользователь();
		
		Для Каждого ТекСтрокаКомиссии Из СтрокиКомиссии Цикл
			
			Если Не ЗначениеЗаполнено(ТекСтрокаКомиссии.РазмещениеДепозита) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = НачислениеКомиссии.Основания.Добавить();
			
			НоваяСтрока.Основание		= ТекСтрокаКомиссии.РазмещениеДепозита;
			НоваяСтрока.ЦеннаяБумага	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаКомиссии.РазмещениеДепозита, "КредитныйИнструмент");
			НоваяСтрока.ДатаОплаты		= НачислениеКомиссии.Дата;
			НоваяСтрока.Сумма			= ТекСтрокаКомиссии.Сумма; 
			
		КонецЦикла;			
		
		Если НачислениеКомиссии.Основания.Количество() > 0 Тогда
			
			Попытка
				НачислениеКомиссии.Записать(РежимЗаписиДокумента.Проведение);
				ЗафиксироватьТранзакцию();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведен документ [" + НачислениеКомиссии + "]", НачислениеКомиссии.Ссылка);
			Исключение    
				ОтменитьТранзакцию();
				ТекстОшибкиПроведения = "Не удалось провести документ [Начисление задолженности]." + Символы.ПС + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиПроведения);	
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиПроведения);
			КонецПопытки;  
			
		Иначе
			
			ОтменитьТранзакцию();
			Продолжить;
			
		КонецЕсли;
			
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура СоздатьОплатыКомиссииНаСервере(ПараметрыСессии)
	
	ЗаполнитьСуществующиеДокументыНаСервере(3);
		
	ДанныеДляОплатКомиссиий = ОплатыКомиссии.Выгрузить(Новый Структура("Флаг", 	Истина), "НачислениеКомиссии, Ссылка");
	
	МассивНачислений = ДанныеДляОплатКомиссиий.ВыгрузитьКолонку("НачислениеКомиссии");
	РаботаСКоллекциями.УдалитьПовторяющиесяЗначенияМассива(МассивНачислений);
	
	НКО_НКЦ = ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ");
	ВалютаУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ВалютаУчета");
	Для Каждого ТекНачисление Из МассивНачислений Цикл
				
		// Создаем оплату 
		НачатьТранзакцию();
		
		СтрокиКомиссии = ДанныеДляОплатКомиссиий.НайтиСтроки(Новый Структура("НачислениеКомиссии", ТекНачисление));
		
		Если ЗначениеЗаполнено(СтрокиКомиссии[0].Ссылка) Тогда
			
			ОплатаКомиссии = СтрокиКомиссии[0].Ссылка.ПолучитьОбъект();
			Если ОплатаКомиссии.Проведен Тогда
				
				Попытка
					ОплатаКомиссии.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
				Исключение
					ТекстОшибкиЗаписи = ОписаниеОшибки();
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаписи, ОплатаКомиссии.Ссылка);
					ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиЗаписи);
					ОтменитьТранзакцию();
					Продолжить;
				КонецПопытки;
				
				ОплатаКомиссии.Основания.Очистить();
				
			КонецЕсли;
			
		Иначе
			ОплатаКомиссии = Документы.Оплата.СоздатьДокумент();
		КонецЕсли;
        		
		ОплатаКомиссии.Организация		= Объект.Организация;
       	ОплатаКомиссии.Ответственный	= РаботаСПользователями.ТекущийПользователь(); 
		ОплатаКомиссии.Заполнить(ТекНачисление);
		ОплатаКомиссии.Дата				= Объект.ДатаИмпорта + 17 * 60 * 60 + 10 * 60;
		
		Попытка
			ОплатаКомиссии.Записать(РежимЗаписиДокумента.Проведение);
			ЗафиксироватьТранзакцию();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Проведен документ [" + ОплатаКомиссии + "]", ОплатаКомиссии.Ссылка);
		Исключение    
			ОтменитьТранзакцию();
			ТекстОшибкиПроведения = "Не удалось провести документ [Оплата]." + Символы.ПС + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиПроведения);	
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиПроведения);
		КонецПопытки;
		
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВсеФлажкиТаблицы(ИмяТаблицы, Флаг)
		
	Для Каждого СтрокаТаблицы Из ЭтаФорма[ИмяТаблицы] Цикл
			
		СтрокаТаблицы.Флаг = Флаг;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНажатиеНаГиперссылку(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ИмяТаблицы    = Элемент.Имя;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если	Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "Ссылка"
			Или Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "КредитныйИнструмент"
			Или Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "РазмещениеДепозита"
			Или Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "НачислениеКомиссии"			
			Тогда
			
			Если ЗначениеЗаполнено(ТекущиеДанные[СтрЗаменить(Элемент.ТекущийЭлемент.Имя, ИмяТаблицы, "")]) Тогда
				ОткрытьЗначение(ТекущиеДанные[СтрЗаменить(Элемент.ТекущийЭлемент.Имя, ИмяТаблицы, "")]);
			КонецЕсли;
											
		ИначеЕсли Элемент.ТекущийЭлемент.Имя = ИмяТаблицы + "Флаг" Тогда
			
			ТекущиеДанные.Флаг = Не ТекущиеДанные.Флаг;
						
		КонецЕсли;
		
	КонецЕсли;
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Объект		= Форма.Объект;
	Элементы	= Форма.Элементы;

	Элементы.ФормаКомандаОбновить.Видимость			= Форма.Режим <> 0;
	Элементы.ФормаКомандаИмпортировать.Видимость	= Форма.Режим <> 0;	
	Элементы.ГруппаРазделениеФайлов.Видимость		= Форма.Режим <> 0;
	Элементы.ГруппаЗагрузка.Видимость				= Форма.Режим <> 0;		
	Элементы.СтраницаРазделениеФайлов.Видимость		= Форма.Режим <> 0 И Форма.РазделитьФайлПоКлиентам;
	Элементы.КаталогФайловПоКлиентам.Видимость		= Форма.РазделитьФайлПоКлиентам;
	Элементы.ПодтвердитьОперации.Видимость			= Форма.Режим <> 0;
	Элементы.ВремяПодтверждения.Видимость			= Форма.Режим <> 0 И Форма.ПодтвердитьОперации;
	
КонецПроцедуры

