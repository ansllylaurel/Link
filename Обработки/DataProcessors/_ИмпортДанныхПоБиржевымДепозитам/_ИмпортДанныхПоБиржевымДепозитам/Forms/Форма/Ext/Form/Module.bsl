					"\\g1\shares\UK\Client\РегионЭсМ\ОТДЕЛ_ ВНУТРЕННЕГО_ УЧЕТА\ММВБ\_Депозиты с ЦК на ММВБ\ОТЧЕТЫ ПО СДЕЛКАМ\") + Формат(Объект.ДатаИмпорта, "ДФ=yyyy");
	Объект.КаталогФайловПоКлиентам = "\\g1\shares\UK\Client\РегионЭсМ\ОТДЕЛ_ ВНУТРЕННЕГО_ УЧЕТА\ММВБ\_Депозиты с ЦК на ММВБ\Отчеты для клиентов_вырезки\" + Формат(Объект.ДатаИмпорта, "ДФ=yyyy");
		
КонецПроцедуры

&НаСервере
Процедура РазрезатьФайлыНаСервере(ПараметрыСессии)
	
	РезультатРазделенияФайла.Очистить();
	РазрезатьФайлНаСервере(ПараметрыСессии, "EQM6C");
	РазрезатьФайлНаСервере(ПараметрыСессии, "CCX99");
	
КонецПроцедуры

&НаСервере
Процедура РазрезатьФайлНаСервере(ПараметрыСессии, ВидФайла)
	
	ИсходныйФайл = Неопределено;
	
	ПутьКФайлам = ?(Прав(Объект.КаталогФайлов, 1) = "\", Объект.КаталогФайлов, Объект.КаталогФайлов + "\");
	ФайлыКаталога = НайтиФайлы(ПутьКФайлам + Формат(Объект.ДатаИмпорта, "ДФ=ddMMyyyy"), "*", Истина);
		
	Для Каждого Файл Из ФайлыКаталога Цикл
		
		Если Файл.Расширение <> ".xml"
			Или СтрНайти(Файл.Имя, ВидФайла) = 0 
			Или СтрНайти(Файл.Имя, Формат(Объект.ДатаИмпорта, "ДФ=ddMMyy")) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИсходныйФайл = Файл.ПолноеИмя;			
			
	КонецЦикла;
	
	Если ИсходныйФайл = Неопределено Тогда
		ТекстОшибкиОтсутствияФайла = СтрШаблон("В папке '%1' отсутствует файл с отчетом по %2 за %3",
		Объект.КаталогФайловПоКлиентам,
		?(ВидФайла = "EQM6C", "клиентам", "ДДС"),
		Формат(Объект.ДатаИмпорта, "ДФ=dd.MM.yyyy")
		);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиОтсутствияФайла);
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиОтсутствияФайла);
		Возврат;	
	КонецЕсли;
	
	ТекстФайла = Новый ТекстовыйДокумент; 
	
	ШаблонПреобразования = Новый ПреобразованиеXSL;
	ШаблонПреобразования.ЗагрузитьТаблицуСтилейXSLИзСтроки(?(ВидФайла = "EQM6C", Объект.ШаблонДляФайлаСделок, Объект.ШаблонДляФайлаДДС));
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(Объект.КаталогФайловПоКлиентам 
		+ ?(Прав(Объект.КаталогФайловПоКлиентам, 1) = "\", "", "\") 
		+ Формат(Объект.ДатаИмпорта, "ДФ=ddMMyyyy"), Отказ);
		
	Если Не Отказ Тогда
				
		// Разрезаем  	
		Для Каждого СтрокаКодаНаММВБ Из Объект.КодыСчетовДУНаММВБ Цикл
			
			ТекстФайла.Прочитать(ИсходныйФайл);
			УдалитьИзТекстаЛишниеДанные(ВидФайла, ТекстФайла, ?(ВидФайла = "EQM6C", СтрокаКодаНаММВБ.КодУБрокера, СтрокаКодаНаММВБ.КодНаММВБ));
			
			ТекстНовогоФайла = ШаблонПреобразования.ПреобразоватьИзСтроки(ТекстФайла.ПолучитьТекст());
			
			НовыйДокумент = Новый ТекстовыйДокумент;
			НовыйДокумент.УстановитьТекст(ТекстНовогоФайла);
						
			ПутьКНовомуФайлу = Объект.КаталогФайловПоКлиентам 
				+ ?(Прав(Объект.КаталогФайловПоКлиентам, 1) = "\", "", "\") 
				+ Формат(Объект.ДатаИмпорта, "ДФ=ddMMyyyy") + "\" + Формат(Объект.ДатаИмпорта, "ДФ=ddMMyyyy") + " выписка из реестра " + ?(ВидФайла = "EQM6C", "сделок ", "ДДС ") + СтрЗаменить(СтрокаКодаНаММВБ.НомерДоговора, "/", "_") + ".html";
				
			Попытка	 
					
				НовыйДокумент.Записать(ПутьКНовомуФайлу); 
				НоваяСтрока = РезультатРазделенияФайла.Добавить();
				НоваяСтрока.ИмяФайла = ПутьКНовомуФайлу;
				
			Исключение
				ТекстОшибкиЗаписиФайла = ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибкиЗаписиФайла);
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибкиЗаписиФайла);
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КомандаСверитьОстаткиНаСервере(ПараметрыСессии, ОтдельнаяСверкаОстатков = Ложь)

	Если ЭтаФорма.СверкаОстатков.Количество() = 0 Тогда
		
		// Нужно перечитать файл 
		КаталогСверки = Объект.КаталогФайлов 
		    + ?(Прав(Объект.КаталогФайлов, 1) = "\", "", "\")
			+ ?(ЭтаФорма.Режим = 0, 
				Формат(Объект.ДатаИмпорта, "ДФ='MMMM yyyy'"),
				"");
			
		ПолучитьДанныеФайловНаСервере(ПараметрыСессии, КаталогСверки, ОтдельнаяСверкаОстатков);
				
		Если ЭтаФорма.ФайлыИмпорта.Количество() > 0 Тогда
			ОбновитьДанныеНаСервере(ПараметрыСессии);		
		КонецЕсли
	
	КонецЕсли;
	
	ЗаполнитьОстаткиНаСервере();
	
	Если ЭтаФорма.ПодтвердитьОперации Тогда
		ПодтвердитьОперацииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьИзТекстаЛишниеДанные(ВидФайла, ТекстФайла, НеудаляемыйКодСчета)
		
	ИсходныйТекст = ТекстФайла.ПолучитьТекст();
	
	УдаляемыеСтроки = Новый Массив;
	КоличествоСтрок = ТекстФайла.КоличествоСтрок();
	
	НачальныйНеудаляемый	= 0;
	КонечныйНеудаляемый		= 0;
	
	Кавычки 						= Символ(34);	
	ПолученоНачалоСекцийКлиентов	= Ложь;
	
	Если ВидФайла = "EQM6C" Тогда
				
		Для НомерСтроки = 1 По КоличествоСтрок Цикл
			
			ТекстСтроки = ТекстФайла.ПолучитьСтроку(НомерСтроки); 
			
			Если СтрНачинаетсяС(СокрЛ(ТекстСтроки), "<FIRM") Тогда
				ПолученоНачалоСекцийКлиентов = Истина;
				Продолжить;
			ИначеЕсли Не ПолученоНачалоСекцийКлиентов Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНачинаетсяС(СокрЛ(ТекстСтроки), "<CLIENT ClientCode=" + Кавычки + НеудаляемыйКодСчета) Тогда
				НачальныйНеудаляемый = НомерСтроки;
			ИначеЕсли НачальныйНеудаляемый > 0 И КонечныйНеудаляемый = 0 И СтрНачинаетсяС(СокрЛ(ТекстСтроки), "</CLIENT") Тогда
				КонечныйНеудаляемый = НомерСтроки;
			ИначеЕсли НачальныйНеудаляемый > 0 И КонечныйНеудаляемый = 0 Тогда 
				Продолжить;
			ИначеЕсли СтрНачинаетсяС(СокрЛ(ТекстСтроки), "</FIRM>") Тогда
				//Секции с клиентами закончились
				Прервать;
			Иначе		
				УдаляемыеСтроки.Добавить(НомерСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для НомерСтроки = 1 По КоличествоСтрок Цикл
			
			ТекстСтроки = ТекстФайла.ПолучитьСтроку(НомерСтроки); 
			
			Если СтрНачинаетсяС(СокрЛ(ТекстСтроки), "<CCX99") Тогда
				ПолученоНачалоСекцийКлиентов = Истина;
				Продолжить;
			ИначеЕсли Не ПолученоНачалоСекцийКлиентов Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрНачинаетсяС(СокрЛ(ТекстСтроки), "<EXTSETTLECODE ID=" + Кавычки + НеудаляемыйКодСчета) Тогда
				НачальныйНеудаляемый = НомерСтроки;
			ИначеЕсли НачальныйНеудаляемый > 0 И КонечныйНеудаляемый = 0 И СтрНачинаетсяС(СокрЛ(ТекстСтроки), "</EXTSETTLECODE") Тогда
				КонечныйНеудаляемый = НомерСтроки;
			ИначеЕсли НачальныйНеудаляемый > 0 И КонечныйНеудаляемый = 0 Тогда 
				Продолжить;
			ИначеЕсли СтрНачинаетсяС(СокрЛ(ТекстСтроки), "</CCX99") Тогда
				//Секции с клиентами закончились
				Прервать;
			Иначе		
				УдаляемыеСтроки.Добавить(НомерСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	ИндексПоследнейУдаляемой = УдаляемыеСтроки.Количество() - 1;
	Если ИндексПоследнейУдаляемой >= 0 Тогда
		Для Сч = 0 По ИндексПоследнейУдаляемой Цикл
			УдаляемаяСтрока = УдаляемыеСтроки.Получить(ИндексПоследнейУдаляемой - Сч);
			ТекстФайла.УдалитьСтроку(УдаляемаяСтрока);		
		КонецЦикла;                                   
	КонецЕсли;	
			        
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьОперацииНаСервере()
	
	// Если по счету ДУ остатки совпадают, подтверждаем все сформированные документы по нему
	Для Каждого СтрокаСверки Из ЭтаФорма.СверкаОстатков Цикл
				
		Если СтрокаСверки.Сумма = СтрокаСверки.СуммаВ1С Тогда
			
			Операции = СписокОперацийПоСчетуДУНаСервере(СтрокаСверки.СчетДоверительногоУправления);
			
			Если Операции.Количество() > 0 Тогда
		
				РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПодтвердитьОперации(
					Операции,				
					"Клиринговый отчет",				
					ЭтаФорма.ВремяПодтверждения,
					"");
					
			КонецЕсли;
				
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокОперацийПоСчетуДУНаСервере(СчетДоверительногоУправления)
	
	Результат = Новый Массив;
	МассивТаблицДокументов = Новый Массив;
	МассивТаблицДокументов.Добавить("ЗакрытияДепозитныхВкладов");
	МассивТаблицДокументов.Добавить("РазмещенияДепозитныхВкладов");
	МассивТаблицДокументов.Добавить("НачисленияКомиссии");
	МассивТаблицДокументов.Добавить("ОплатыКомиссии");
	
	Для Каждого ТаблицаДокументов Из МассивТаблицДокументов Цикл
		
		НайдСтроки = ЭтаФорма[ТаблицаДокументов].НайтиСтроки(Новый Структура("СчетДоверительногоУправления", СчетДоверительногоУправления));
		Для Каждого ТекСтрока Из НайдСтроки Цикл
			РаботаСКоллекциями.ДополнитьМассив(Результат, ТекСтрока.Ссылка, Истина);			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

