					   
#Область События_формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.ДатаИмпорта = Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -2);
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект"); 
	
	ОбъектОбработки.ЗаполнитьТаблицуКодовКлиентовНаММВБ();
	ОбъектОбработки.ЗагрузитьШаблоныПреобразованияВHTML();
	
	Объект.ШаблонДляФайлаСделок = ОбъектОбработки.ШаблонДляФайлаСделок;
	Объект.ШаблонДляФайлаДДС	= ОбъектОбработки.ШаблонДляФайлаДДС;
	
	Объект.КодыСчетовДУНаММВБ.Загрузить(ОбъектОбработки.КодыСчетовДУНаММВБ.Выгрузить());	
	
	УстановитьКаталогиНаСервере();
	
	ЭтаФорма.РазделитьФайлПоКлиентам = Истина;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры
   
#КонецОбласти

#Область События_элементов_формы

&НаКлиенте
Процедура КаталогФайловОткрытие(Элемент, СтандартнаяОбработка)
	
	ОткрытьКаталог("КаталогФайлов", СтандартнаяОбработка);
		
КонецПроцедуры

&НаКлиенте
Процедура ИмяФайлаДанныхНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ДиалогВыбораКаталога                    = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогФайлов;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	ДиалогВыбораКаталога.Заголовок	        = "Выберите каталог с Файлами";
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогФайлов = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытияДепозитныхВкладовПередНачаломИзменения(Элемент, Отказ)
	
	ОбработатьНажатиеНаГиперссылку(Элемент, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура НачисленияКомиссииПередНачаломИзменения(Элемент, Отказ)
	
	ОбработатьНажатиеНаГиперссылку(Элемент, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыКомиссииПередНачаломИзменения(Элемент, Отказ)
	
	ОбработатьНажатиеНаГиперссылку(Элемент, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИмпортаПриИзменении(Элемент)
	
	ОчиститьТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогФайловПоКлиентамНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ДиалогВыбораКаталога                    = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталога.Каталог            = Объект.КаталогФайловПоКлиентам;
	ДиалогВыбораКаталога.МножественныйВыбор = Ложь;
	ДиалогВыбораКаталога.Заголовок	        = "Выберите каталог с Файлами";
	
	Если ДиалогВыбораКаталога.Выбрать() Тогда
		Объект.КаталогФайловПоКлиентам = ДиалогВыбораКаталога.Каталог;
	КонецЕсли;

