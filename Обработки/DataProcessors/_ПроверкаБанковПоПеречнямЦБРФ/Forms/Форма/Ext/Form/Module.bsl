&НаКлиенте
Процедура ОткрытьПеречень(Элемент, НомерПеречня)
	СписокВариантов = Новый СписокЗначений;
	СписокВариантов.Добавить("SQL", "Открыть загруженный файл");
	СписокВариантов.Добавить("HTTP", "Открыть файл с сайта ЦБ РФ");
	
	ВыбранныйВариант = ВыбратьИзМеню(СписокВариантов, Элемент);
	Если ВыбранныйВариант = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеФайлаПеречня = ПолучитьФайлПеречняНаСервере(НомерПеречня, ВыбранныйВариант.Значение);
	Если ОписаниеФайлаПеречня = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла	= КаталогВременныхФайлов() + Лев(ОписаниеФайлаПеречня.ИмяФайла, СтрДлина(ОписаниеФайлаПеречня.ИмяФайла) - СтрДлина(ОписаниеФайлаПеречня.Расширение)) + "_" + ВыбранныйВариант.Значение + ОписаниеФайлаПеречня.Расширение;
	ДвоичныеДанные		= ПолучитьИзВременногоХранилища(ОписаниеФайлаПеречня.Адрес);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ЗапуститьПриложение(ИмяВременногоФайла);
КонецПроцедуры

&НаСервере
Функция ПолучитьФайлПеречняНаСервере(НомерПеречня, ИсточникФайла)
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");	
	ИдентификаторПеречня = ОбработкаОбъект["ИдентификаторПеречняПо" + НомерПеречня];
	
	Перечень = ОбработкаОбъект.ПолучитьПереченьПоИдентификатору(ИдентификаторПеречня);
	Если Перечень = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РасширениеФайла		= Сред(Перечень.ИмяФайла, СтрНайти(Перечень.ИмяФайла, ".", НаправлениеПоиска.СКонца));
	ИмяФайла			= Сред(Перечень.ИмяФайла, СтрНайти(Перечень.ИмяФайла, "/", НаправлениеПоиска.СКонца) + 1);	
	ИмяВременногоФайла	= ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	Если ИсточникФайла = "SQL" Тогда  
		РаботаСВнешнимиСистемами.ADODBC_СохранитьМассивБайтВФайл(Перечень.МассивБайт, ИмяВременногоФайла);
	Иначе
		Попытка
			КопироватьФайл(Перечень.ИмяФайла, ИмяВременногоФайла);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения файла '" + Перечень.ИмяФайла + "' с сайта ЦБ РФ. Система сообщает: " + ИнформацияОбОшибке().Описание);
			Возврат Неопределено;	
		КонецПопытки;
	КонецЕсли;
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), ЭтаФорма.УникальныйИдентификатор);  
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Новый Структура("Адрес, ИмяФайла, Расширение", АдресФайла, ИмяФайла, РасширениеФайла);
КонецФункции

