Функция ПолучитьПереченьПоИдентификатору(ИдентификаторПеречня) Экспорт
	
	// Инициализация вспомогательных переменных
	СтрокаСоединения	= РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
	ТекстЗапроса		= "
		|SELECT
		|	Files.File_Name [ИмяФайла],
		|	Files.Upload_Time [ВремяЗагрузки],
		|	Files.File_Data [МассивБайт]
		|FROM
		|	[Externals].[dbo].[Files] [Files]
		|	INNER JOIN (
		|		SELECT
		|			MAX(Files.Id) [Id]
		|		FROM
		|			[Externals].[dbo].[Files] [Files]
		|		WHERE
		|			Files.Source_Id = &ИдентификаторПеречня
		|	) LastFile ON LastFile.Id = Files.Id";
	
	// Подготавливаем запрос
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИдентификаторПеречня", ИдентификаторПеречня);
	
	ТипыКолонок = Новый Структура;
	ТипыКолонок.Вставить("ИмяФайла",		Новый ОписаниеТипов("Строка"));
	ТипыКолонок.Вставить("ВремяЗагрузки",	Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТипыКолонок.Вставить("МассивБайт",		Новый ОписаниеТипов("COMSafeArray"));	
	
	Источник = ?(ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник"), ЭтотОбъект.ДополнительныеСвойства.Источник, ЭтотОбъект.Метаданные().ПолноеИмя()); 
	
	Попытка
		ВнешниеДанные = РаботаСВнешнимиСистемами.ADODBC_ПолучитьТаблицуДанныхССервера(СтрокаСоединения, ТекстЗапроса, ТипыКолонок, , Новый Структура("Источник", Источник));
	Исключение
		Инфо = ИнформацияОбОшибке();
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(ЭтотОбъект, "Ошибка получения данных с сервера. Система сообщает: " + Инфо.Описание);
		Возврат Неопределено;	
	КонецПопытки;
	
	Если ВнешниеДанные = Неопределено ИЛИ ВнешниеДанные.Количество() = 0 Тогда
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(ЭтотОбъект, "Перечень с идентификатором '" + ИдентификаторПеречня + "' не найден.");
		Возврат Неопределено;		
	КонецЕсли;
	
	ОписаниеПеречня = Новый Структура("ИмяФайла, ВремяЗагрузки, МассивБайт");
	ЗаполнитьЗначенияСвойств(ОписаниеПеречня, ВнешниеДанные[0]); 
	
	Возврат ОписаниеПеречня;

КонецФункции

