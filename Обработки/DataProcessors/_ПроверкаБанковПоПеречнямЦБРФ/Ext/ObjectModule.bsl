Функция СформироватьОтчетОПроверке() Экспорт
	
	ПеречниЦБРФ = Новый Соответствие();
	
	//14 июля 2017 г. 451 был заменен на 580
	Если ЭтотОбъект.Период < '20170714' Тогда
		ПеречниЦБРФ.Вставить("451", "Перечень кредитных организаций, соответствующих требованиям, предусмотренным подпунктами 2.1.1 - 2.1.2 и 2.1.4 пункта 2.1 Положения Банка России от 25.12.2014 № 451-П");
	Иначе
		ПеречниЦБРФ.Вставить("580", "Перечень кредитных организаций, удовлетворяющих требованиям, предусмотренным подпунктами 2.1.1 – 2.1.2 и 2.1.4 пункта 2.1 Положения Банка России от 01.03.2017 № 580-П, а также статьей 24 Федерального закона от 24.07.2002 № 111-ФЗ «Об инвестировании средств для финансирования накопительной пенсии в Российской Федерации» и статьей 23 Федерального закона от 20.08.2004 № 117-ФЗ «О накопительно-ипотечной системе обеспечения военнослужащих»");
	КонецЕсли;   
	Если ЭтотОбъект.Период < '20260101' Тогда
		ПеречниЦБРФ.Вставить("761", "Перечень кредитных организаций, удовлетворяющих требованиям, предусмотренным подпунктами «а» - «з», «м» - «о» пункта 1 постановления Правительства Российской Федерации от 13.12.2006 № 761");
	КонецЕсли;	            
	// Банк России c 01.01.2026 прекращает публикацию перечня кредитных организаций в связи с вступлением в силу Федерального закона от 13.12.2024 № 475-ФЗ «О внесении изменений в отдельные законодательные акты Российской Федерации»
	
	Параметры = Новый Структура;
	Параметры.Вставить("ПеречниЦБРФ", ПеречниЦБРФ);
	Параметры.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	Параметры.Вставить("ОтчетHTML", "");
		
	ПолучитьСписокСчетовИДепозитов(Параметры, ЭтотОбъект.Период); // формирует временные таблицы "Счета580(451)", "Счета761"
	ПолучитьКодыБанковЦБРФ(Параметры);
	
	ПроверитьЗаполнениеЮрЛицаБанка(Параметры, ЭтотОбъект.Период);   // Проверяет заполнение поля "ЮрФизЛицо" банков 
	ПроверитьЗаполнениеРегНомераЦБРФ(Параметры, ЭтотОбъект.Период); // Проверяет наличике кода внешней системы
		
	Для каждого Запись Из ПеречниЦБРФ Цикл
		Если ЗагрузитьПереченьБанковЦБРФ(Запись.Ключ, Параметры) Тогда // формирует временную таблицу "ПереченьХХХ"
			ПроверитьБанкиНаСоответствиеПеречнюЦБРФ(Запись.Ключ, Ложь, Параметры);
			Если Не ЭтотОбъект.ВключатьВОтчетТолькоОшибки Тогда
				ПроверитьБанкиНаСоответствиеПеречнюЦБРФ(Запись.Ключ, Истина, Параметры);
			КонецЕсли;
		Иначе
			Параметры.ОтчетHTML = Параметры.ОтчетHTML + "<p class=""Error"">Проверка банков на соответствие перечню " + Запись.Ключ + " ЦБ РФ не выполнялась!</p>";
			
			// чтобы не валились ошибки при проверке наименований создадим в менеджере
			// пустые временные таблицы, соответствующие перечню
			ПеренестиПереченьБанковЦБРФ(Запись.Ключ, СформироватьСтруктуруПеречняБанковЦБРФ(), Параметры);
		КонецЕсли;
	КонецЦикла;
	
	РаботаСДополнительнымиОтчетамиИОбработками.ОповеститьОВнутрОшибках(ЭтотОбъект);
	
	ПроверитьНаименованияБанков(Параметры, ЭтотОбъект.Период);	// Проверяет соответствие наименований банков в 1С и ЦБ РФ, а то вдруг код не тому банку присвоили	
	
	Если Не ПустаяСтрока(Параметры.ОтчетHTML) Тогда
		Параметры.ОтчетHTML =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style>
			|		body {
			|			font: 10pt sans-serif;
			|		}
			|		table {
			|			text-align: left;
			|			border: 1px solid black;
			|			border-spacing: 0;
			|			border-collapse: collapse;
			|		}
			|		div class=""Error"" {
			|			margin-top: 10px;
			|			text-align: left;
			|			color: red;
			|			background-color: white;
			|			font-weight: bold;
			|		}
			|		tr {
			|			border: 1px solid black;
			|		}
			|		th {
			|			font-weight: bolder;
			|			font-size: 12px;
			|			padding: 5px;
			|			border: 1px solid black;
			|			background-color: silver;
			|		}
			|		td {
			|			padding: 5px;
			|			vertical-align: top;
			|			border: 1px solid black;
			|		}
			|		.Error {
			|			margin-top: 10px;
			|			font-size: 12pt;
			|			font-weight: bold;
			|			color: red;
			|		}
			|		.Valid {
			|			margin-top: 10px;
			|			font-size: 12pt;
			|			font-weight: bold;
			|			color: green;
			|		}
			|		.DataSource, .DataSource a {
			|			margin-top: 5px;
			|			font-size: 10pt;
			|			color: gray;
			|		}
			|		.DataSource a {
			|			font-weight: bold;
			|		}			
			|	</style>
			|</head>
			|<body>"
			+ Параметры.ОтчетHTML +
			"</body></html>";
	КонецЕсли;
		
	Возврат Параметры.ОтчетHTML;	

КонецФункции // СформироватьОтчетОПроверке

Процедура ОтправитьОтчетПоЭлПочте(ОтчетHTML) Экспорт
	
	Если НачалоДня(ЭтотОбъект.Период) < '20170714' Тогда
		 ТекстПеречни = "451, 761";
	ИначеЕсли НачалоДня(ЭтотОбъект.Период) < '20260101' Тогда 
		 ТекстПеречни = "580, 761";
	Иначе	 
		 ТекстПеречни = "580";
	КонецЕсли; 
	
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность",
		ЭтотОбъект.ПолучателиОтчета,
		"Проверка банков " + ЭтотОбъект.Организация + " на вхождение в перечни " + ТекстПеречни + " ЦБ РФ на " + Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"),
		ОтчетHTML,
		"HTML", 
		ВажностьИнтернетПочтовогоСообщения.Обычная);
	
	РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	
КонецПроцедуры

Функция ЗагрузитьПереченьБанковЦБРФ(КодПеречня, Параметры)
	
	ИдентификаторПеречня = ЭтотОбъект["ИдентификаторПеречняПо" + КодПеречня];	
	
	Перечень = ПолучитьПереченьПоИдентификатору(ИдентификаторПеречня);
	Если Перечень = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Дополним параметры сведениями о перечне
	Параметры.Вставить("АдресПеречняПо" + КодПеречня, Перечень.ИмяФайла);
	Параметры.Вставить("ВремяЗагрузкиПеречняПо" + КодПеречня, Перечень.ВремяЗагрузки);	
	
	РасширениеФайла	= Сред(Перечень.ИмяФайла, СтрНайти(Перечень.ИмяФайла, ".", НаправлениеПоиска.СКонца));		
	ИмяФайлаЦБРФ	= ПолучитьИмяВременногоФайла(РасширениеФайла);
	
	РаботаСВнешнимиСистемами.ADODBC_СохранитьМассивБайтВФайл(Перечень.МассивБайт, ИмяФайлаЦБРФ);
	
	КодВозврата = ПрочитатьПереченьБанковЦБРФ(КодПеречня, ИмяФайлаЦБРФ, Параметры);
	
	УдалитьФайлы(ИмяФайлаЦБРФ);
	
	Возврат КодВозврата;
	
КонецФункции

Функция СформироватьСтруктуруПеречняБанковЦБРФ()
	
	КвалификаторСтроки = Новый КвалификаторыСтроки(Метаданные.Справочники.ЮрФизЛица.ДлинаНаименования, ДопустимаяДлина.Переменная);
	ТипСтрока = Новый ОписаниеТипов("Строка",, КвалификаторСтроки);
	
	Перечень = Новый ТаблицаЗначений;
	Перечень.Колонки.Добавить("НаименованиеБанка", ТипСтрока);
	Перечень.Колонки.Добавить("РегНомерЦБРФ", ТипСтрока);
	
	Возврат Перечень;

КонецФункции // СформироватьСтруктуруПеречняБанковЦБРФ

Процедура ПеренестиПереченьБанковЦБРФ(КодПеречня, Перечень, Параметры)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Перечень.НаименованиеБанка КАК НаименованиеБанка,
		|	Перечень.РегНомерЦБРФ КАК РегНомерЦБРФ
		|ПОМЕСТИТЬ ПереченьКодПеречня
		|ИЗ
		|	&Перечень КАК Перечень
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	РегНомерЦБРФ";
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КодПеречня", КодПеречня);
	
	Запрос.УстановитьПараметр("Перечень", Перечень);
	Запрос.Выполнить();
	
КонецПроцедуры // ПеренестиПереченьБанковЦБРФ

Функция ПрочитатьПереченьБанковЦБРФ(КодПеречня, ИмяФайла, Параметры)
	
	Попытка
		Таблица = Новый ТабличныйДокумент;
		Таблица.Прочитать(ИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
		
		Перечень = СформироватьСтруктуруПеречняБанковЦБРФ();
		
		Если Таблица.Область(5, 1).Текст = "№ п/п"
			И Таблица.Область(5, 2).Текст = "Наименование банка"
			И Таблица.Область(5, 3).Текст = "Рег. №"
			И Таблица.Область(6, 1).Значение = 1
		Тогда
		
		    // Проверка актуальности списка
			
			СрокАктуальности	= 65 * 86400; // 65 дней
			СтрокаАкуальности	= Таблица.Область(3, 1).Текст;
			ПрефиксДаты			= "по состоянию на";

			Если СтрНачинаетсяС(СтрокаАкуальности, ПрефиксДаты) Тогда
				ДатаАктуальностиПеречня = Дата(Сред(СтрокаАкуальности, СтрДлина(ПрефиксДаты) + 1) + " 00:00:00");
			ИначеЕсли КодПеречня = "451" Тогда // в этом перечне нет даты актуальности
				ДатаАктуальностиПеречня = Параметры["ВремяЗагрузкиПеречняПо" + КодПеречня];
			Иначе
				ДатаАктуальностиПеречня = Неопределено;
				РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(ЭтотОбъект,
					СтрШаблон("При проверке банков %1 на вхождение в перечень %2 ЦБ РФ на %3 не удалось проверить дату актуальности перечня. Возможно данные перечня устарели.",
						ЭтотОбъект.Организация, КодПеречня, Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy")));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДатаАктуальностиПеречня) И (ЭтотОбъект.Период - ДатаАктуальностиПеречня) > СрокАктуальности Тогда
				РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(ЭтотОбъект,
					СтрШаблон("При проверке банков %1 на вхождение в перечень %2 ЦБ РФ на %3 использован перечень по состоянию на %4. Возможно данные перечня устарели.",
						ЭтотОбъект.Организация, КодПеречня, Формат(ЭтотОбъект.Период, "ДФ=dd.MM.yyyy"), Формат(ДатаАктуальностиПеречня, "ДФ=dd.MM.yyyy")));
			КонецЕсли;
		
			// Загрузка перечня
		
			НомерПП = 1;
			
			Пока Истина Цикл
				
				Если Не Таблица.Область(5 + НомерПП, 1).СодержитЗначение  
					ИЛИ Таблица.Область(5 + НомерПП, 1).Значение <> НомерПП
				Тогда
					Прервать;
				КонецЕсли;
				
				СтрокаПеречня = Перечень.Добавить();
				СтрокаПеречня.НаименованиеБанка = ВРег(СокрЛП(Таблица.Область(5 + НомерПП, 2).Текст));
				
				Если Таблица.Область(5 + НомерПП, 3).СодержитЗначение Тогда
					СтрокаПеречня.РегНомерЦБРФ = Формат(Таблица.Область(5 + НомерПП, 3).Значение, "ЧДЦ=; ЧГ=");
				Иначе
					СтрокаПеречня.РегНомерЦБРФ = СокрЛП(Таблица.Область(5 + НомерПП, 3).Текст);
				КонецЕсли;
				
				НомерПП = НомерПП + 1;
				
			КонецЦикла;
			
			ПеренестиПереченьБанковЦБРФ(КодПеречня, Перечень, Параметры);
		    			
		Иначе
			
			ВызватьИсключение "Неверный формат файла";
			
		КонецЕсли;
		
	Исключение
		Инфо = ИнформацияОбОшибке();
		РаботаСДополнительнымиОтчетамиИОбработками.ЗарегистрироватьВнутрОшибкуВыполнения(ЭтотОбъект, "Ошибка чтения перечня по " + КодПеречня + ". Система сообщает: " + Инфо.Описание);
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Процедура ПолучитьСписокСчетовИДепозитов(Параметры, Дата)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОстаткиДенежныхСредствОстатки.Организация КАК Организация,
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДУ,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет КАК Счет,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Банк КАК Банк,
		|	ОстаткиДенежныхСредствОстатки.РасчетныйСчет.Банк.ЮрФизЛицо КАК ЮрФизЛицо,
		|	1 КАК ВидСчета
		|ПОМЕСТИТЬ Счета580
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И РасчетныйСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|				И РасчетныйСчет.Банк.ЮрФизЛицо <> &НКО_НКЦ
		|				И (СчетДоверительногоУправления.ВидСчетаДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|					ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих))) КАК ОстаткиДенежныхСредствОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Организация,
		|	ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления,
		|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет,
		|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк,
		|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо,
		|	2
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
		|				И КредитныйИнструмент <> ЗНАЧЕНИЕ(Справочник.ДепозитныеВклады.ПустаяСсылка)
		|				И ВЫРАЗИТЬ(КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо <> &НКО_НКЦ
		|				И ВЫРАЗИТЬ(КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|				И (СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|					ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих))) КАК ДенежныеСредстваВКредитныхИнструментах
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЮрФизЛицо,
		|	Банк"; 
	
	Если Дата < '20260101' Тогда 
		Запрос.Текст = Запрос.Текст + "
		|;
		|
		|//////////////////////////////////////////////////////////////////////////////// "
		+"
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДенежныеСредстваВКредитныхИнструментах.Организация КАК Организация,
		|	ДенежныеСредстваВКредитныхИнструментах.СчетДоверительногоУправления КАК СчетДУ,
		|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет КАК Счет,
		|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк КАК Банк,
		|	ВЫРАЗИТЬ(ДенежныеСредстваВКредитныхИнструментах.КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет.Банк.ЮрФизЛицо КАК ЮрФизЛицо,
		|	2 КАК ВидСчета
		|ПОМЕСТИТЬ Счета761
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И ТипКредитногоИнструмента = ЗНАЧЕНИЕ(Перечисление.ТипыКредитныхИнструментов.ДепозитныйВклад)
		|				И КредитныйИнструмент <> ЗНАЧЕНИЕ(Справочник.ДепозитныеВклады.ПустаяСсылка)
		|				И ВЫРАЗИТЬ(КредитныйИнструмент КАК Справочник.ДепозитныеВклады).БанковскийСчет <> ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)
		|				И (СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР)
		|					ИЛИ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиЖилищногоОбеспеченияВоеннослужащих))) КАК ДенежныеСредстваВКредитныхИнструментах
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЮрФизЛицо,
		|	Банк"; 
	КонецЕсли; 	
		
	Запрос.УстановитьПараметр("Период",      КонецДня(ЭтотОбъект.Период));
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("НКО_НКЦ",	 ОбщегоНазначения.ПолучитьИменованныйОбъект("НКО_НКЦ"));
	
	Если НачалоДня(ЭтотОбъект.Период) < '20170714' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "580", "451");
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Процедура ПолучитьКодыБанковЦБРФ(Параметры)
	
	// филиалы банков содержат помимо кода головной отделения код филиала после "/"
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо КАК Объект,
		|	ЕСТЬNULL(СтатусыЛицензийГоловныхОрганизацийСрезПоследних.Лицензия.Номер, СтатусыЛицензийСрезПоследних.Лицензия.Номер) КАК Код,
		|	НЕ СвязанныеЮридическиеЛицаСрезПоследних.Период ЕСТЬ NULL КАК ЭтоФилиал
		|ПОМЕСТИТЬ КодыБанковЦБРФ
		|ИЗ
		|	РегистрСведений.СтатусыЛицензий.СрезПоследних(
		|			&Период,
		|			Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|				И Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.ЛицензияБанкаРоссии)) КАК СтатусыЛицензийСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвязанныеЮридическиеЛица.СрезПоследних(&Период, ТипСвязи = ЗНАЧЕНИЕ(Справочник.ТипыСвязейЮрФизЛиц.ГоловнаяОрганизация)) КАК СвязанныеЮридическиеЛицаСрезПоследних
		|		ПО СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо = СвязанныеЮридическиеЛицаСрезПоследних.ЮридическоеЛицо
		|			И (СвязанныеЮридическиеЛицаСрезПоследних.Действует)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыЛицензий.СрезПоследних(
		|				&Период,
		|				Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДокументов.Действует)
		|					И Лицензия.ВидДеятельности = ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.ЛицензияБанкаРоссии)) КАК СтатусыЛицензийГоловныхОрганизацийСрезПоследних
		|		ПО (СвязанныеЮридическиеЛицаСрезПоследних.РодительскоеЮридическоеЛицо = СтатусыЛицензийГоловныхОрганизацийСрезПоследних.Лицензия.ЮрФизЛицо)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СтатусыЛицензийСрезПоследних.Лицензия.ЮрФизЛицо";
		
		
	Запрос.УстановитьПараметр("Период", КонецДня(ЭтотОбъект.Период));	
	Запрос.Выполнить();
	
КонецПроцедуры // ПолучитьКодыБанковЦБРФ

Процедура ПроверитьЗаполнениеЮрЛицаБанка(Параметры, Дата)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Счета580.Банк.Код КАК БИК,
		|	ПРЕДСТАВЛЕНИЕ(Счета580.Банк) КАК Банк
		|ИЗ
		|	Счета580 КАК Счета580
		|ГДЕ
		|	Счета580.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)"; 
		
	Если Дата < '20260101' Тогда 
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ
		|" + "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Счета761.Банк.Код,
		|	ПРЕДСТАВЛЕНИЕ(Счета761.Банк)
		|ИЗ
		|	Счета761 КАК Счета761
		|ГДЕ
		|	Счета761.ЮрФизЛицо = ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)";   
	КонецЕсли;
		
	Если НачалоДня(ЭтотОбъект.Период) < '20170714' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "580", "451");
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
			"<div class=""Error"">Не заполнено юр. лицо банка</div>
			|<table>
			|<tr>
			|	<th>БИК</th>
			|	<th>Банк</th>
			|</tr>
			|";
			
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
				"<tr>
				|	<td>" + Выборка.БИК + "</td>
				|	<td>" + Выборка.Банк + "</td>
				|</tr>
				|";
			
		КонецЦикла;
			
		Параметры.ОтчетHTML = Параметры.ОтчетHTML +
			"</table>";
			
	КонецЕсли;
	
КонецПроцедуры
	
Процедура ПроверитьЗаполнениеРегНомераЦБРФ(Параметры, Дата)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Счета580.ЮрФизЛицо КАК ЮрФизЛицо,
		|	Счета580.ЮрФизЛицо.Код КАК Код,
		|	Счета580.ЮрФизЛицо.Наименование КАК Наименование
		|ИЗ
		|	Счета580 КАК Счета580
		|		ЛЕВОЕ СОЕДИНЕНИЕ КодыБанковЦБРФ КАК КодыБанковЦБРФ
		|		ПО Счета580.ЮрФизЛицо = КодыБанковЦБРФ.Объект
		|ГДЕ
		|	Счета580.ЮрФизЛицо <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|	И КодыБанковЦБРФ.Код ЕСТЬ NULL";
	
	Если Дата < '20260101' Тогда 
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ
		|" + "  		
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Счета761.ЮрФизЛицо,
		|	Счета761.ЮрФизЛицо.Код,
		|	Счета761.ЮрФизЛицо.Наименование
		|ИЗ
		|	Счета761 КАК Счета761
		|		ЛЕВОЕ СОЕДИНЕНИЕ КодыБанковЦБРФ КАК КодыБанковЦБРФ
		|		ПО Счета761.ЮрФизЛицо = КодыБанковЦБРФ.Объект
		|ГДЕ
		|	Счета761.ЮрФизЛицо <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.ПустаяСсылка)
		|	И КодыБанковЦБРФ.Код ЕСТЬ NULL ";
	КонецЕсли;
		
	Если НачалоДня(ЭтотОбъект.Период) < '20170714' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "580", "451");
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
			"<div class=""Error"">Не заполнен рег. номер ЦБ РФ</div>
			|<table>
			|<tr>
			|	<th>Код юр. лица</th>
			|	<th>Наименование</th>
			|</tr>
			|";
				
		Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока Выборка.Следующий() Цикл
			Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
				"<tr>
				|	<td>" + Выборка.Код + "</td>
				|	<td>" + Выборка.Наименование + "</td>
				|</tr>
				|";
		КонецЦикла;
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML +
			"</table>";
			
	КонецЕсли;
		
КонецПроцедуры

Процедура ПроверитьНаименованияБанков(Параметры, Дата)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыБанковЦБРФ.Код КАК КодЦБРФ,
		|	Счета580.Банк.Код КАК БИК,
		|	Счета580.Банк.Наименование КАК Наименование1С,
		|	Перечень580.НаименованиеБанка КАК НаименованиеЦБ
		|ИЗ
		|	Счета580 КАК Счета580
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыБанковЦБРФ КАК КодыБанковЦБРФ
		|		ПО Счета580.ЮрФизЛицо = КодыБанковЦБРФ.Объект
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Перечень580 КАК Перечень580
		|		ПО (КодыБанковЦБРФ.Код = Перечень580.РегНомерЦБРФ)
		|			И НЕ КодыБанковЦБРФ.ЭтоФилиал
		|			И (Перечень580.НаименованиеБанка <> Счета580.ЮрФизЛицо.Наименование)";
	
	
	Если Дата < '20260101' Тогда 
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ
		|"+ "  
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КодыБанковЦБРФ.Код,
		|	Счета761.Банк.Код,
		|	Счета761.Банк.Наименование,
		|	Перечень761.НаименованиеБанка
		|ИЗ
		|	Счета761 КАК Счета761
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыБанковЦБРФ КАК КодыБанковЦБРФ
		|		ПО Счета761.ЮрФизЛицо = КодыБанковЦБРФ.Объект
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Перечень761 КАК Перечень761
		|		ПО (КодыБанковЦБРФ.Код = Перечень761.РегНомерЦБРФ)
		|			И НЕ КодыБанковЦБРФ.ЭтоФилиал
		|			И (Перечень761.НаименованиеБанка <> Счета761.Банк.Наименование)";  
	КонецЕсли;	
		
	Если НачалоДня(ЭтотОбъект.Период) < '20170714' Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "580", "451");
	КонецЕсли;

	Результат = Запрос.Выполнить();
	
	ЕстьРасхождения = Ложь;
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ВРег(СокрЛП(Выборка.Наименование1С)) = Выборка.НаименованиеЦБ Тогда // такую проверку в запросе не реализовать :((
				Продолжить;
			КонецЕсли;
			
			Если Не ЕстьРасхождения Тогда
				Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
					"<div class=""Error"">Различаются наименования банков в 1С и ЦБ РФ</div>
					|<table>
					|<tr>
					|	<th>Код ЦБ РФ</td>
					|	<th>БИК</td>
					|	<th>Наименование в 1C</td>
					|	<th>Наименование в перечне ЦБ РФ</td>
					|</tr>
					|";
					
				ЕстьРасхождения = Истина;
			КонецЕсли;
	
			Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
				"<tr>
				|	<td>" + ПредставлениеСтроки(Выборка.КодЦБРФ) + "</td>
				|	<td>" + ПредставлениеСтроки(Выборка.БИК) + "</td>
				|	<td>" + ПредставлениеСтроки(Выборка.Наименование1С) + "</td>
				|	<td>" + ПредставлениеСтроки(Выборка.НаименованиеЦБ) + "</td>
				|</tr>
				|";
					
		КонецЦикла;
		
		Если ЕстьРасхождения Тогда
			Параметры.ОтчетHTML = Параметры.ОтчетHTML +
				"</table>";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьБанкиНаСоответствиеПеречнюЦБРФ(КодПеречня, ПоискВхождений, Параметры)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Параметры.МенеджерВременныхТаблиц;
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КодыБанковЦБРФ.Код КАК РегНомерЦБРФ,
		|	СчетаКодПеречня.ВидСчета КАК ВидСчета,
		|	СчетаКодПеречня.Счет.НомерСчета КАК НомерСчета,
		|	СчетаКодПеречня.Счет.Банк.Код КАК БИК,
		|	ПРЕДСТАВЛЕНИЕ(СчетаКодПеречня.Счет.Банк) КАК Банк,
		|	СчетаКодПеречня.СчетДУ.КодСчета КАК КодСчетаДУ,
		|	ПРЕДСТАВЛЕНИЕ(СчетаКодПеречня.СчетДУ) КАК СчетДУ
		|ИЗ
		|	СчетаКодПеречня КАК СчетаКодПеречня
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыБанковЦБРФ КАК КодыБанковЦБРФ
		|		ПО СчетаКодПеречня.ЮрФизЛицо = КодыБанковЦБРФ.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПереченьКодПеречня КАК ПереченьКодПеречня
		|		ПО (КодыБанковЦБРФ.Код = ПереченьКодПеречня.РегНомерЦБРФ)
		|ГДЕ
		|	НЕ ПереченьКодПеречня.РегНомерЦБРФ ЕСТЬ NULL 
		|ИТОГИ ПО
		|	РегНомерЦБРФ";
		
	Если Не ПоискВхождений Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕ Перечень", "Перечень");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "КодПеречня", КодПеречня);
		
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
			"<div class=""" + ?(ПоискВхождений, "Valid", "Error") + """>" + ?(ПоискВхождений, "Входит", "Не входит") + " в " + Параметры.ПеречниЦБРФ[КодПеречня] + "</div>
			|<table>
			|<tr>
			|	<th>Рег. номер ЦБ РФ</th>
			|	<th>БИК</th>
			|	<th>Банк</th>
			|	<th>Номер счета</th>
			|	<th>Код счета д/у</th>
			|	<th>Счет д/у</th>
			|</tr>
			|";
				
		ВыборкаРегНомерЦБРФ = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРегНомерЦБРФ.Следующий() Цикл
			
			КоличествоБанковскихСчетов = 0;
			
			Выборка = ВыборкаРегНомерЦБРФ.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				КоличествоБанковскихСчетов = КоличествоБанковскихСчетов + 1;
				
				Если КоличествоБанковскихСчетов = 1 Тогда 
					Параметры.ОтчетHTML = Параметры.ОтчетHTML +
						"<tr>
						|	<td rowspan=""%1"">" + ПредставлениеСтроки(Выборка.РегНомерЦБРФ) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.БИК) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.Банк) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.НомерСчета) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.КодСчетаДУ) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.СчетДУ) + "</td>
						|</tr>
						|";
				Иначе
					Параметры.ОтчетHTML = Параметры.ОтчетHTML +
						"<tr>
						|	<td>" + ПредставлениеСтроки(Выборка.БИК) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.Банк) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.НомерСчета) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.КодСчетаДУ) + "</td>
						|	<td>" + ПредставлениеСтроки(Выборка.СчетДУ) + "</td>
						|</tr>
						|";
				КонецЕсли;
				
			КонецЦикла;
			
			Параметры.ОтчетHTML = СтрЗаменить(Параметры.ОтчетHTML, "%1", КоличествоБанковскихСчетов);
			
		КонецЦикла;
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML +
			"</table>";
		
		// Дополним результат сверки адресом файла
		Параметры.ОтчетHTML = Параметры.ОтчетHTML +
			"<p class=""DataSource"">Источник данных: <a href=""" + Параметры["АдресПеречняПо" + КодПеречня] + """>" + Параметры["АдресПеречняПо" + КодПеречня] + "</a> (загружено: " + Формат(Параметры["ВремяЗагрузкиПеречняПо" + КодПеречня], "ДФ=dd.MM.yyyy") + ")</p>";
		
	ИначеЕсли ПоискВхождений Тогда 	
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
			"<div class=""" + ?(ПоискВхождений, "Valid", "Error") + """>" + ?(ПоискВхождений, "Входит", "Не входит") + " в " + Параметры.ПеречниЦБРФ[КодПеречня] + "</div>";
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML + 
			"<table><tr><td width = ""1000px"" align = ""center"">Данные не обнаружены</td></tr></table>";
		
		Параметры.ОтчетHTML = Параметры.ОтчетHTML +
			"<p class=""DataSource"">Источник данных: <a href=""" + Параметры["АдресПеречняПо" + КодПеречня] + """>" + Параметры["АдресПеречняПо" + КодПеречня] + "</a> (загружено: " + Формат(Параметры["ВремяЗагрузкиПеречняПо" + КодПеречня], "ДФ=dd.MM.yyyy") + ")</p>";
		
	КонецЕсли;
	
КонецПроцедуры

