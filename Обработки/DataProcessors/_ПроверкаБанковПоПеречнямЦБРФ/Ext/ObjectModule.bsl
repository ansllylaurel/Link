
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчетHTML"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Проверка банков по перечням ЦБ РФ",
		"1.40",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверитьБанкиПоПеречнямЦБРФЗаВчераРЭМ", 		"Проверить банки по перечням ЦБ РФ за вчера РЭМ",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверитьБанкиПоПеречнямЦБРФЗаВчераТраст", 	"Проверить банки по перечням ЦБ РФ за вчера Траст",,Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ПроверитьБанкиПоПеречнямЦБРФЗаВчераРПИ", 		"Проверить банки по перечням ЦБ РФ за вчера РПИ",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска обработки
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетHTMLыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	// Запускаем только в рабочие дни.
	// Проверяем предыдущий рабочий день.
	Если НЕ Справочники.Календари.ЭтоРабочийДень(Справочники.Календари.Общероссийский, ТекущаяДата) Тогда
		Возврат;
	Иначе
		ЭтотОбъект.Период = Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата) - 1);
	КонецЕсли;
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	ЭтотОбъект.Организация					= ПараметрыКоманды.Организация;
	//ЭтотОбъект.Период						= НачалоДня(ТекущаяДата()) - 1;
	//ЭтотОбъект.АдресПеречняПо451			= ПараметрыКоманды.АдресПеречняПо451;
	//ЭтотОбъект.АдресПеречняПо580			= ПараметрыКоманды.АдресПеречняПо580;
	//ЭтотОбъект.АдресПеречняПо761			= ПараметрыКоманды.АдресПеречняПо761;
	ЭтотОбъект.ИдентификаторПеречняПо451	= ПараметрыКоманды.ИдентификаторПеречняПо451;
	ЭтотОбъект.ИдентификаторПеречняПо580	= ПараметрыКоманды.ИдентификаторПеречняПо580;
	ЭтотОбъект.ИдентификаторПеречняПо761	= ПараметрыКоманды.ИдентификаторПеречняПо761;
	ЭтотОбъект.ВключатьВОтчетТолькоОшибки	= ПараметрыКоманды.ВключатьВОтчетТолькоОшибки;
	ЭтотОбъект.ПолучателиОтчета				= ПараметрыКоманды.ПолучателиОтчета;	
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Найти(ИдентификаторКоманды, "ПроверитьБанкиПоПеречнямЦБРФЗаВчера") = 1 Тогда
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды);
		Попытка
		ОтчетHTML = СформироватьОтчетОПроверке();
		
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
			ДобавитьТекстОшибки(ПараметрыСессии, "В процессе проверки банков по перечням ЦБ РФ зарегистрированы внутренние ошибки");
		КонецЕсли;
		
		Если Не ПустаяСтрока(ОтчетHTML) Тогда
			ОтправитьОтчетПоЭлПочте(ОтчетHTML);
		КонецЕсли;
		Исключение
			ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьКоманду

