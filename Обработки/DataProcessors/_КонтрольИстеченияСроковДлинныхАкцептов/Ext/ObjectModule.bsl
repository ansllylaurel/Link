
////////////////////////////////////////////////////////////////////////////////
// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Контроль истечения сроков длинных акцептов",
		"0.01",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ВыполнитьКонтроль", "Выполнить контроль",, Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	Если Не ПараметрыКоманды.Свойство("Организация") Тогда
		ЗарегистрироватьОшибку("Отсутствует праметр команды [Организация].");
		ОповеститьОбОшибках();
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыКоманды.Организация) Или ТипЗнч(ПараметрыКоманды.Организация) <> Тип("СправочникСсылка.Организации") Тогда
		ЗарегистрироватьОшибку("Не указано значение параметра [Организация].");	
		ОповеститьОбОшибках();
		Возврат;
	КонецЕсли;
													 
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ПараметрыКоманды, "Организация");
	Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + ".ВыполнитьКоманду()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
		
	ВыполнитьКонтроль(ПараметрыКоманды.Организация);
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
		
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОповеститьОбОшибках() Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
		КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Очистить();	
	
КонецПроцедуры

Процедура ВыполнитьКонтроль(Организация, ДатаКонтроля = Неопределено, Получатель = Неопределено) Экспорт 
		
	Запрос = Новый Запрос;
	
#Область Текст_Запроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта КАК ВидАкцепта,
		|	ВЫБОР
		|		КОГДА НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный)
		|			ТОГДА КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания
		|		КОГДА НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО)
		|			ТОГДА ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет
		|	КОНЕЦ КАК ОбъектАкцептования
		|ПОМЕСТИТЬ _НастройкиАкцептования
		|ИЗ
		|	РегистрСведений.НастройкиАкцептованияОпераций.СрезПоследних(&ДатаКонтроля, Организация = &Организация) КАК НастройкиАкцептованияОперацийСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(&ДатаКонтроля, Организация = &Организация) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ПО НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления = КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления
		|			И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ПО НастройкиАкцептованияОперацийСрезПоследних.Организация = ИсполнителиПоДенежнымСредствамСобственные.Организация
		|			И НастройкиАкцептованияОперацийСрезПоследних.СчетДоверительногоУправления = ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления
		|			И (НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта = ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО))
		|ГДЕ
		|	НастройкиАкцептованияОперацийСрезПоследних.ТребуетсяАкцептование
		|	И НастройкиАкцептованияОперацийСрезПоследних.ВидАкцепта В (ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО), ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НастройкиАкцептования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НастройкиАкцептования.ВидАкцепта КАК ВидАкцепта,
		|	_НастройкиАкцептования.ОбъектАкцептования КАК ОбъектАкцептования,
		|	АкцептованиеОперацийСрезПоследних.Регистратор КАК Акцепт,
		|	АкцептованиеОперацийСрезПоследних.Акцептант КАК Акцептант,
		|	АкцептованиеОперацийСрезПоследних.Срок КАК Срок
		|ИЗ
		|	_НастройкиАкцептования КАК _НастройкиАкцептования
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АкцептованиеОпераций.СрезПоследних(
		|				&ДатаКонтроля,
		|				Организация = &Организация
		|					И Операция В
		|						(ВЫБРАТЬ
		|							_НастройкиАкцептования.ОбъектАкцептования
		|						ИЗ
		|							_НастройкиАкцептования КАК _НастройкиАкцептования)
		|					И ВидАкцепта В (ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.МНО), ЗНАЧЕНИЕ(Перечисление.ВидыАкцептов.ПереводСБрокерскогоСчетаНаРасчетный))) КАК АкцептованиеОперацийСрезПоследних
		|		ПО _НастройкиАкцептования.ВидАкцепта = АкцептованиеОперацийСрезПоследних.ВидАкцепта
		|			И _НастройкиАкцептования.ОбъектАкцептования = АкцептованиеОперацийСрезПоследних.Операция
		|			И (АкцептованиеОперацийСрезПоследних.Период < &ДатаКонтроля)
		|			И (АкцептованиеОперацийСрезПоследних.Срок <> ДАТАВРЕМЯ(1, 1, 1))
		|			И (РАЗНОСТЬДАТ(&ДатаКонтроля, АкцептованиеОперацийСрезПоследних.Срок, ДЕНЬ) МЕЖДУ 0 И 10)
		|			И (АкцептованиеОперацийСрезПоследних.Срок > &ДатаКонтроля)";
#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаКонтроля", ?(ДатаКонтроля = Неопределено, ТекущаяДатаСеанса(), ДатаКонтроля));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстПисьма = "";
	
	Пока Выборка.Следующий() Цикл 
			
		ТекстПисьма = ТекстПисьма + Символы.ПС 
			+ "<tr><td>" + ОбщегоНазначения.ПолучитьГиперссылкуНаОбъект(Выборка.Акцепт)
			+ "</td><td>" + Выборка.ВидАкцепта
			+ "</td><td>" + Выборка.ОбъектАкцептования
			+ "</td><td>" + Выборка.Акцептант 
            + "</td><td>" + СокрЛП(Выборка.СчетДоверительногоУправления)
			+ "</td><td>" + Формат(Выборка.Срок, "ДФ=dd.MM.yyyy") + "</td></tr>";
	
	КонецЦикла;
		
	Если ЗначениеЗаполнено(ТекстПисьма) Тогда  
						
		ТекстПисьма =
			"<html>
			|<head content=""text/html"" http-equiv=""Content-Type"" charset=""utf-8"">
			|	<style type=""text/css"">
			|		body     { font-family: ""Arial""; font-size: 12px; }
			|		table    { text-align: left; border-spacing: 0; border-collapse: collapse; }
			|		td       { border: 1px solid #5877AD; padding: 5px; }
			|		.top     { background: #A6CAF0; }
			|	</style>
			|</head>
			|<body>
			|<table cols=""6"">
			|<tr class=""top""><td>Акцепт</td><td>Вид акцепта</td><td>Объект акцепта</td><td>Акцептант</td><td>Счет д/у</td><td>Срок акцепта</td></tr>"
			+ ТекстПисьма + "</table></body></html>";
			
		Если ЗначениеЗаполнено(Получатель) Тогда
				
			ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста",
				Получатель,
				"Истекает срок акцептов. УК " + Организация,
				ТекстПисьма,
				"HTML");
				
			РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	
		Иначе	
			
			РеквизитыОповещения = Новый Структура("Организация, Текст", Организация, ТекстПисьма);
			Справочники.Оповещения.СформироватьОповещения("Обработка._КонтрольИстеченияСроковДлинныхАкцептов", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
			
		КонецЕсли;
		
	КонецЕсли;
				
КонецПроцедуры;

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
