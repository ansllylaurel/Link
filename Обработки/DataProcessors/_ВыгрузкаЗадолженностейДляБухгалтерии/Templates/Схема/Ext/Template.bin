<xs:schema xmlns:tns="EXCHANGE" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="EXCHANGE" attributeFormDefault="unqualified" elementFormDefault="qualified">
	<xs:complexType name="UFOtoBuh">
		<xs:sequence>
			<xs:element name="Документы" type="tns:Документ" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ЮрФизЛица" type="tns:ЮрФизЛицо" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Договоры" type="tns:Договор" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ВидыЗадолженности" type="tns:ВидЗадолженности" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ВидЗадолженности">
		<xs:sequence>
			<xs:element name="УникальныйИдентификатор" type="xs:string"/>
			<xs:element name="Наименование" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Договор">
		<xs:sequence>
			<xs:element name="УникальныйИдентификатор" type="xs:string"/>
			<xs:element name="ЮрЛицо" type="xs:string"/>
			<xs:element name="ВидДоговора" type="xs:string"/>
			<xs:element name="НомерДоговора" type="xs:string"/>
			<xs:element name="ДатаДоговора" type="xs:dateTime"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Документ">
		<xs:sequence>
			<xs:element name="УникальныйИдентификатор" type="xs:string"/>
			<xs:element name="Дата" type="xs:dateTime"/>
			<xs:element name="Номер" type="xs:string"/>
			<xs:element name="Организация" type="xs:string"/>
			<xs:element name="Клиент" type="xs:string"/>
			<xs:element name="ДоговорСКлиентом" type="xs:string"/>
			<xs:element name="ВидЗадолженности" type="xs:string"/>
			<xs:element name="Контрагент" type="xs:string"/>
			<xs:element name="Договор" type="xs:string"/>
			<xs:element name="Сумма" type="xs:string"/>
			<xs:element name="Валюта" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ЮрФизЛицо">
		<xs:sequence>
			<xs:element name="УникальныйИдентификатор" type="xs:string"/>
			<xs:element name="Наименование" type="xs:string"/>
			<xs:element name="ПолноеНаименование" type="xs:string"/>
			<xs:element name="Вид" type="xs:string"/>
			<xs:element name="ДатаРеквизитов" type="xs:string"/>
			<xs:element name="ИНН" type="xs:string"/>
			<xs:element name="КПП" type="xs:string"/>
			<xs:element name="ОГРН" type="xs:string"/>
			<xs:element name="IDMX" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>