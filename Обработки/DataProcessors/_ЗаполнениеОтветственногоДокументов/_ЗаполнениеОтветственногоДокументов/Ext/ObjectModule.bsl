Функция ДобавитьОшибку(РезультатОперации, Документ, ТекстОшибки)
	
	ОписаниеОшибки = Новый Структура("Документ, ТекстОшибки", Документ, ТекстОшибки);
	
	РезультатОперации.Ошибки.Добавить(ОписаниеОшибки);
	РезультатОперации.Ошибок = РезультатОперации.Ошибки.Количество();
	
	Возврат Истина;
	
КонецФункции

Процедура СоздатьСлужебноеСообщение(ИдентификаторФормы, РезультатОперации)
	
	СлужебноеСообщение = Новый СообщениеПользователю;
	СлужебноеСообщение.ИдентификаторНазначения = ИдентификаторФормы;
	СлужебноеСообщение.Текст = ЗначениеВСтрокуВнутр(РезультатОперации); //JSONСтрока(РезультатОперации);
	
	СлужебноеСообщение.Сообщить();
	
КонецПроцедуры

Функция JSONСтрока(Значение)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, Значение);
	
	Возврат ЗаписьJSON.Закрыть();	
КонецФункции

