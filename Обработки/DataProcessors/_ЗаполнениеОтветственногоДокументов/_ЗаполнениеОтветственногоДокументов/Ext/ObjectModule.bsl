
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", "Заполнение ответственных за операции", "1.07", "", Истина);
		
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ЗаполнитьОтветственногоВФоне(ПараметрыПроцедуры, АдресХранилища) Экспорт
	
	// Заполняем ответственных
	
	РезультатОперации = ЗаполнитьОтветственного(
		ПараметрыПроцедуры.Организация,
		ПараметрыПроцедуры.ГруппаВидовОпераций,
		ПараметрыПроцедуры.СубъектУчета,
		ПараметрыПроцедуры.ДатаНачала,
		ПараметрыПроцедуры.ДатаОкончания,
		ПараметрыПроцедуры.ПараметрыФоновогоЗадания
	);
	
	// Возвращем результат работы фонового задания 
	
	ПоместитьВоВременноеХранилище(РезультатОперации, АдресХранилища);  
	
КонецПроцедуры

Процедура ЗаполнитьОтветственногоЖурналаСверокПоВнутреннемуУчетуВФоне(ПараметрыПроцедуры, АдресХранилища) Экспорт
	
	// Заполняем ответственных в регистре журнала сверок по внутреннему учету
	
	РезультатОперации = ЗаполнитьОтветственногоЖурналаСверокПоВнутреннемуУчету(
		ПараметрыПроцедуры.Организация,
		ПараметрыПроцедуры.ДатаНачала,
		ПараметрыПроцедуры.ДатаОкончания,
		ПараметрыПроцедуры.ПараметрыФоновогоЗадания
	);
	
	// Возвращем результат работы фонового задания 
	
	ПоместитьВоВременноеХранилище(РезультатОперации, АдресХранилища);  
	
КонецПроцедуры

Процедура ЗаполнитьОтветственногоПодтвержденийОперацийВФоне(ПараметрыПроцедуры, АдресХранилища) Экспорт
	
	// Заполняем ответственных в регистре подтверждений операций
	
	РезультатОперации = ЗаполнитьОтветственногоПодтвержденийОпераций(
		ПараметрыПроцедуры.Организация,
		ПараметрыПроцедуры.ДатаНачала,
		ПараметрыПроцедуры.ДатаОкончания,
		ПараметрыПроцедуры.ПараметрыФоновогоЗадания
	);
	
	// Возвращем результат работы фонового задания 
	
	ПоместитьВоВременноеХранилище(РезультатОперации, АдресХранилища);  
	
КонецПроцедуры

#Область Заполнение_ответственного_в_операциях

Функция ЗаполнитьОтветственного(Организация, ГруппаВидовОпераций, СубъектУчета, ДатаНачала, ДатаОкончания, ПараметрыФоновогоЗадания = Неопределено)
	
	РезультатОперации = Новый Структура("Проверено, Изменено, Всего, Ошибок, Ошибки", 0, 0, 0, 0, Новый Массив);
	
	ЗапущеноВФоне		= ПараметрыСеанса.ЭтоФоновоеЗадание;
	ИдентификаторФормы	= Неопределено;
	
	Если ЗапущеноВФоне И ТипЗнч(ПараметрыФоновогоЗадания) = Тип("Структура") Тогда
		ПараметрыФоновогоЗадания.Свойство("ИдентификаторФормы", ИдентификаторФормы);
	КонецЕсли;
	
	РезультатЗапроса = ПолучитьНесоответствия(Организация, ГруппаВидовОпераций, СубъектУчета, ДатаНачала, ДатаОкончания);
	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатОперации; 
	КонецЕсли;
	
	// Выполняем замену
	
	ВыборкаПоКлиенту = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоКлиенту.Следующий() Цикл
		
		РезультатОперации.Всего = РезультатОперации.Всего + ВыборкаПоКлиенту.Ссылка; // В поле Ссылка для клиента указано количество документов с несоответствиями
		
		ВыбораПоДокументам = ВыборкаПоКлиенту.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		Пока ВыбораПоДокументам.Следующий() Цикл
			
			РезультатОперации.Проверено = РезультатОперации.Проверено + 1;
			
			НачатьТранзакцию();
			
			ДокументОбъект = ВыбораПоДокументам.Ссылка.ПолучитьОбъект();
			
			#Область Снимаем_даты_запрета_редактирования
			
			ИмяДокумента = ДокументОбъект.Метаданные().Имя;
			
			Если ТипЗнч(ВыборкаПоКлиенту.СубъектУчета) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
				СчетаДоверительногоУправления = ВыборкаПоКлиенту.СубъектУчета;
			ИначеЕсли РаботаСМетаданнымиПовтИсп.ДокументыСРегистрациейПоКлиенту().Получить(ИмяДокумента) <> Неопределено Тогда
				СчетаДоверительногоУправления = Документы[ИмяДокумента].ПолучитьСвязанныеСчетаДоверительногоУправления(ДокументОбъект);
			Иначе
				СчетаДоверительногоУправления = Неопределено;
			КонецЕсли;
			
			Если СчетаДоверительногоУправления = Неопределено Тогда
				РанееУстановленныеДатыЗапрета = Новый Соответствие;	
			Иначе
				РанееУстановленныеДатыЗапрета = ОчиститьДатыЗапретаДляРедактированияДокумента(ВыбораПоДокументам.Дата, Организация, СчетаДоверительногоУправления); 
			КонецЕсли;	
			
			#КонецОбласти
			
			// Заменяем ответственного
			
			ОшибкаЗаписи = Ложь;
			
			ДокументОбъект.Ответственный = ВыбораПоДокументам.НовыйОтветственный;
			Если ТипЗнч(ВыбораПоДокументам.Ссылка) = Тип("ДокументСсылка.РегистрацияСтоимостиПереоценки")
				ИЛИ ТипЗнч(ВыбораПоДокументам.Ссылка) = Тип("ДокументСсылка.НачислениеРезервовПИФ")
			Тогда
				ДокументОбъект.ДополнительныеСвойства.Вставить("ЗаписьВСоставеРегистрацииСтоимостиАктивов");
			КонецЕсли;
			
			СообщенияДоЗаписи = ПолучитьСообщенияПользователю(Истина);
			
			Попытка
				
				ДокументОбъект.Записать();
				
			Исключение
				
				ОтменитьТранзакцию();
				ОшибкаЗаписи = Истина;
				
				ТекстОшибки = СтрШаблон(
					"%1
					|------------------------------------------------------------                                                      
					|%2",
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
					ОбщегоНазначения.ПолучитьТекстСообщенийПользователю());
					
				ДобавитьОшибку(РезультатОперации, ВыбораПоДокументам.Ссылка, ТекстОшибки); 
					
			КонецПопытки;

			// При успехе возвращаем даты запрета и фиксируем изменения
			
			Если Не ОшибкаЗаписи Тогда
				
				#Область Возвращаем_даты_запрета_редактирования
				
				// Делаю в привилегированном режиме, т.к. без него при записи дат запрета может происходить ошибка,
				// когда организация в записи регистра не соответствует организации основного пользователя
				
				УстановитьПривилегированныйРежим(Истина); 
				
				Попытка
					
					Для Каждого ДатыЗапретаРедактирования Из РанееУстановленныеДатыЗапрета Цикл
						РегистрыСведений.ДатыЗапретаРедактирования.УстановитьДатыЗапретаРедактирования(ДатыЗапретаРедактирования.Значение, ДатыЗапретаРедактирования.Ключ, "Заполнение ответственных за операции");
					КонецЦикла;
					
				Исключение
					
					ОтменитьТранзакцию();
					ОшибкаЗаписи = Истина;
					
					ТекстОшибки = СтрШаблон(
						"%1
						|------------------------------------------------------------                                                      
						|%2",
						ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
						ОбщегоНазначения.ПолучитьТекстСообщенийПользователю());
						
					ДобавитьОшибку(РезультатОперации, ВыбораПоДокументам.Ссылка, ТекстОшибки); 
						
				КонецПопытки;
				
				УстановитьПривилегированныйРежим(Ложь);
				
				#КонецОбласти
				
			КонецЕсли;
			
			Если Не ОшибкаЗаписи Тогда
				
				ЗафиксироватьТранзакцию();
				
				РезультатОперации.Изменено = РезультатОперации.Изменено + 1;
				
			КонецЕсли;
			
			// Добавляем служебное сообщение для уведомления родительского задания
			
			Если ЗапущеноВФоне Тогда
				СоздатьСлужебноеСообщение(ИдентификаторФормы, РезультатОперации);
			КонецЕсли;
							
		КонецЦикла;

	КонецЦикла;
	
	Возврат РезультатОперации; 
	
КонецФункции

Функция ПолучитьНесоответствия(Организация, ГруппаВидовОпераций, Знач СубъектУчета = Неопределено, Знач ДатаНачала = Неопределено, Знач ДатаОкончания = Неопределено) Экспорт
	
	#Область Заполнение_параметров_по_умолчанию
	
	Если СубъектУчета = Неопределено Тогда
		СубъектУчета = Справочники.СчетаДоверительногоУправления.ПустаяСсылка();
	КонецЕсли;
	
	Если ДатаНачала = Неопределено Тогда
		ДатаНачала = '00010101';
	КонецЕсли;
	
	Если ДатаОкончания = Неопределено Тогда
		ДатаОкончания = '00010101';
	КонецЕсли;
	
	#КонецОбласти
	
	ТаблицаЗамещенийПользователей	= ПолучитьТаблицуЗамещенийПользователей(Организация, ГруппаВидовОпераций, ДатаНачала, ДатаОкончания);
	СписокРегистровБэкОфиса			= РаботаСМетаданнымиПовтИсп.ПолучитьСписокРегистровБэкОфиса();
	
	РегистрыБэкОфиса = Новый Массив;
	Для Каждого МетаРегистр Из СписокРегистровБэкОфиса Цикл
		РегистрыБэкОфиса.Добавить(МетаРегистр.Ключ);		
	КонецЦикла;
	
	Запрос = Новый Запрос(ПолучитьТекстЗапросаЗаменОтветственных());
		
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ГруппаВидовОпераций",			ГруппаВидовОпераций);
	Запрос.УстановитьПараметр("СубъектУчета",					СубъектУчета);
	Запрос.УстановитьПараметр("ДатаНачала",						ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	Запрос.УстановитьПараметр("ТаблицаЗамещенийПользователей",	ТаблицаЗамещенийПользователей);
	Запрос.УстановитьПараметр("РегистрыБэкОфиса",				РегистрыБэкОфиса);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапросаЗаменОтветственных() Экспорт
	
	СоответсвиеПолейКлиента = Новый Соответствие;
	
	СоответсвиеПолейКлиента.Вставить("АнкетаФизическогоЛица",										"ЮрФизЛицо");
	СоответсвиеПолейКлиента.Вставить("АнкетаЮридическогоЛица",										"ЮрФизЛицо");
	СоответсвиеПолейКлиента.Вставить("ЗаявкаПайщика",												"ПаевойИнвестиционныйФонд");
	СоответсвиеПолейКлиента.Вставить("ПервичнаяЗаявкаПайщика",										"ПИФ");
	СоответсвиеПолейКлиента.Вставить("РегистрацияИнвестиционногоПрофиля",							"СубъектУчета");
	СоответсвиеПолейКлиента.Вставить("РегистрацияПредоставленныхКлиентомСведенийОЦенныхБумагах",	"Клиент");
	СоответсвиеПолейКлиента.Вставить("НазначениеИнвестиционнойДекларации",							"Субъект");
	СоответсвиеПолейКлиента.Вставить("НесоответствиеИнвестиционнойДекларации",						"Субъект");
	
	ПрочиеОперации = Новый Массив;
	Для Каждого МетаДокумент Из Метаданные.Документы Цикл
		Если Метаданные.Перечисления.ВидыОперацийБэкОфиса.ЗначенияПеречисления.Найти(МетаДокумент.Имя) = Неопределено Тогда
		    ТекстЗапроса = 
			    "ВЫБРАТЬ
			    |	ДанныеДокумента.Ссылка КАК Ссылка,
			    |	ДанныеДокумента.СчетДоверительногоУправления КАК СубъектУчета,
			    |	ДанныеДокумента.Организация КАК Организация,
			    |	ДанныеДокумента.Ответственный КАК Ответственный,
			    |	ДанныеДокумента.Дата КАК Дата,
			    |	""РегистрацияСтоимостиПереоценки"" КАК ВидДокумента,
			    |	ДанныеДокумента.ЦельРасчета КАК ЦельРасчета
			    |ИЗ
			    |	Документ.РегистрацияСтоимостиПереоценки КАК ДанныеДокумента
			    |ГДЕ
			    |	ДанныеДокумента.Организация = &Организация
			    |	И &СубъектУчета В (ДанныеДокумента.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
			    |	И (ДанныеДокумента.Дата >= &ДатаНачала
			    |			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
			    |	И (ДанныеДокумента.Дата <= &ДатаОкончания
			    |			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))";
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрацияСтоимостиПереоценки", МетаДокумент.Имя);
			
			Если Не РаботаСМетаданнымиПовтИсп.ЕстьРеквизитШапкиДокумента(МетаДокумент.Имя, "ЦельРасчета") Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеДокумента.ЦельРасчета", "ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ПустаяСсылка)");  	
			КонецЕсли;
			
			Если Не РаботаСМетаданнымиПовтИсп.ЕстьРеквизитШапкиДокумента(МетаДокумент.Имя, "СчетДоверительногоУправления") Тогда
				ПолеКлиента = СоответсвиеПолейКлиента.Получить(МетаДокумент.Имя); 
				Если ПолеКлиента = Неопределено Тогда
					ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеДокумента.СчетДоверительногоУправления", """<Отсутствует>""");  	
				Иначе
					ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ДанныеДокумента.СчетДоверительногоУправления", "ДанныеДокумента." + ПолеКлиента);  	
				КонецЕсли;
			КонецЕсли;
			
			ПрочиеОперации.Добавить(ТекстЗапроса);
		КонецЕсли;
	КонецЦикла;
	
	ЗапросПрочихОпераций = СтрСоединить(ПрочиеОперации, Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС);
	Если Не ПустаяСтрока(ЗапросПрочихОпераций) Тогда
		ЗапросПрочихОпераций = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС + ЗапросПрочихОпераций;	
	КонецЕсли;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТаблицаЗамещенийПользователей.Дата КАК Дата,
		|	_ТаблицаЗамещенийПользователей.Пользователь КАК Пользователь,
		|	_ТаблицаЗамещенийПользователей.Замещающий КАК Замещающий
		|ПОМЕСТИТЬ _ТаблицаЗамещенийПользователей
		|ИЗ
		|	&ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийПользователей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.Ссылка КАК Ссылка,
		|	Сделка.СчетДоверительногоУправления КАК СубъектУчета,
		|	Сделка.Организация КАК Организация,
		|	Сделка.Ответственный КАК Ответственный,
		|	Сделка.Дата КАК Дата,
		|	""Сделка"" КАК ВидДокумента,
		|	ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ПустаяСсылка) КАК ЦельРасчета
		|ПОМЕСТИТЬ _Документы
		|ИЗ
		|	Документ.Сделка КАК Сделка
		|ГДЕ
		|	Сделка.Организация = &Организация
		|	И &СубъектУчета В (Сделка.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|	И (Сделка.Дата >= &ДатаНачала
		|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
		|	И (Сделка.Дата <= &ДатаОкончания
		|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|	И Сделка.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИсполнениеОбязательствПоСделке.Ссылка,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Организация,
		|	ИсполнениеОбязательствПоСделке.Ответственный,
		|	ИсполнениеОбязательствПоСделке.Дата,
		|	""ИсполнениеОбязательствПоСделке"",
		|	ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ПустаяСсылка)
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|ГДЕ
		|	ИсполнениеОбязательствПоСделке.Организация = &Организация
		|	И &СубъектУчета В (ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|	И (ИсполнениеОбязательствПоСделке.Дата >= &ДатаНачала
		|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
		|	И (ИсполнениеОбязательствПоСделке.Дата <= &ДатаОкончания
		|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|	И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	ЖурналОперацийБэкОфиса.Организация,
		|	ЖурналОперацийБэкОфиса.Ответственный,
		|	ЖурналОперацийБэкОфиса.Дата,
		|	ЖурналОперацийБэкОфиса.ВидОперации,
		|	ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ПустаяСсылка)
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И &СубъектУчета В (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|	И (ЖурналОперацийБэкОфиса.Дата >= &ДатаНачала
		|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
		|	И (ЖурналОперацийБэкОфиса.Дата <= &ДатаОкончания
		|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|	И НЕ ЖурналОперацийБэкОфиса.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.КорректировкаРегистров), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.СводнаяБиржеваяСделка), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.СводноеИсполнениеОбязательствПоБиржевымСделкам))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЖурналОперацийБэкОфиса.Документ,
		|	ЖурналОперацийБэкОфиса.СчетДоверительногоУправления,
		|	ЖурналОперацийБэкОфиса.Организация,
		|	ЖурналОперацийБэкОфиса.Ответственный,
		|	ЖурналОперацийБэкОфиса.Дата,
		|	ЖурналОперацийБэкОфиса.ВидОперации,
		|	ЗНАЧЕНИЕ(Справочник.ЦелиРасчета.ПустаяСсылка)
		|ИЗ
		|	РегистрСведений.ЖурналОперацийБэкОфиса КАК ЖурналОперацийБэкОфиса
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КорректировкаРегистров.ТаблицаРегистров КАК ТаблицаРегистров
		|		ПО (ТаблицаРегистров.Ссылка = ЖурналОперацийБэкОфиса.Документ)
		|			И (ТаблицаРегистров.Имя В (&РегистрыБэкОфиса))
		|ГДЕ
		|	ЖурналОперацийБэкОфиса.Организация = &Организация
		|	И &СубъектУчета В (ЖурналОперацийБэкОфиса.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))
		|	И (ЖурналОперацийБэкОфиса.Дата >= &ДатаНачала
		|			ИЛИ &ДатаНачала = ДАТАВРЕМЯ(1, 1, 1))
		|	И (ЖурналОперацийБэкОфиса.Дата <= &ДатаОкончания
		|			ИЛИ &ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|	И ЖурналОперацийБэкОфиса.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийБэкОфиса.КорректировкаРегистров)"
		+ ЗапросПрочихОпераций + Символы.ПС + ";" + Символы.ПС + Символы.ПС + 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Ссылка КАК Ссылка,
		|	_Документы.СубъектУчета КАК СубъектУчета,
		|	_Документы.ВидДокумента КАК ВидДокумента,
		|	_Документы.Ответственный КАК Ответственный,
		|	ЕСТЬNULL(_ТаблицаЗамещенийПользователей.Замещающий, ЕСТЬNULL(_ТаблицаЗамещенийОсновногоОтветственного.Замещающий, ОсновныеОтветственные.Сотрудник.Пользователь)) КАК НовыйОтветственный,
		|	_Документы.Дата КАК Дата
		|ИЗ
		|	_Документы КАК _Документы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОперации КАК ОсновныеОтветственные
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыВидовОпераций.ВидыОпераций КАК ВидыОперацийГруппы
		|			ПО (ВидыОперацийГруппы.Ссылка = ОсновныеОтветственные.ГруппаВидовОпераций)
		|				И (ВидыОперацийГруппы.ВидОперации <> НЕОПРЕДЕЛЕНО)
		|		ПО (ОсновныеОтветственные.Организация = _Документы.Организация)
		|			И (ОсновныеОтветственные.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ОсновныеОтветственные.Основной = ИСТИНА)
		|			И (ТИПЗНАЧЕНИЯ(ВидыОперацийГруппы.ВидОперации) = ТИПЗНАЧЕНИЯ(_Документы.Ссылка))
		|			И (ВидыОперацийГруппы.ЦельРасчета = _Документы.ЦельРасчета)
		|			И _Документы.Дата >= ОсновныеОтветственные.Период
		|			И (_Документы.Дата <= КОНЕЦПЕРИОДА(ОсновныеОтветственные.ДатаОкончания, ДЕНЬ)
		|				ИЛИ ОсновныеОтветственные.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОперации КАК ОтветственныеЗаОперации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыВидовОпераций.ВидыОпераций КАК ВидыОперацийГруппы2
		|			ПО (ВидыОперацийГруппы2.Ссылка = ОтветственныеЗаОперации.ГруппаВидовОпераций)
		|		ПО (ОтветственныеЗаОперации.Организация = _Документы.Организация)
		|			И (ОтветственныеЗаОперации.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ОтветственныеЗаОперации.Сотрудник.Пользователь = _Документы.Ответственный)
		|			И (ТИПЗНАЧЕНИЯ(ВидыОперацийГруппы2.ВидОперации) = ТИПЗНАЧЕНИЯ(_Документы.Ссылка))
		|			И (ВидыОперацийГруппы2.ЦельРасчета = _Документы.ЦельРасчета)
		|			И _Документы.Дата >= ОтветственныеЗаОперации.Период
		|			И (_Документы.Дата <= КОНЕЦПЕРИОДА(ОтветственныеЗаОперации.ДатаОкончания, ДЕНЬ)
		|				ИЛИ ОтветственныеЗаОперации.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийПользователей
		|		ПО (_ТаблицаЗамещенийПользователей.Пользователь = _Документы.Ответственный)
		|			И (_ТаблицаЗамещенийПользователей.Дата = НАЧАЛОПЕРИОДА(_Документы.Дата, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийОсновногоОтветственного
		|		ПО (_ТаблицаЗамещенийОсновногоОтветственного.Пользователь = ОсновныеОтветственные.Сотрудник.Пользователь)
		|			И (_ТаблицаЗамещенийОсновногоОтветственного.Дата = НАЧАЛОПЕРИОДА(_Документы.Дата, ДЕНЬ))
		|ГДЕ
		|	(ОтветственныеЗаОперации.Сотрудник ЕСТЬ NULL
		|			ИЛИ _ТаблицаЗамещенийПользователей.Пользователь ЕСТЬ НЕ NULL )
		|
		|УПОРЯДОЧИТЬ ПО
		|	СубъектУчета,
		|	_Документы.Дата
		|ИТОГИ
		|	КОЛИЧЕСТВО(Ссылка)
		|ПО
		|	СубъектУчета
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область Заполнение_ответственного_в_журнале_сверок_по_внутреннему_учету

Функция ЗаполнитьОтветственногоЖурналаСверокПоВнутреннемуУчету(Организация, ДатаНачала, ДатаОкончания, ПараметрыФоновогоЗадания = Неопределено)
	
	РезультатОперации = Новый Структура("Проверено, Изменено, Всего, Ошибок, Ошибки", 0, 0, 0, 0, Новый Массив);
	
	ЗапущеноВФоне		= ПараметрыСеанса.ЭтоФоновоеЗадание;
	ИдентификаторФормы	= Неопределено;
	
	Если ЗапущеноВФоне И ТипЗнч(ПараметрыФоновогоЗадания) = Тип("Структура") Тогда
		ПараметрыФоновогоЗадания.Свойство("ИдентификаторФормы", ИдентификаторФормы);
	КонецЕсли;
	
	ГруппаВидовОпераций			  = ОбщегоНазначения.ПолучитьИменованныйОбъект("ОперацииВнутреннегоУчета");
	ТаблицаЗамещенийПользователей = ПолучитьТаблицуЗамещенийПользователей(Организация, ГруппаВидовОпераций, ДатаНачала, ДатаОкончания);

	Запрос = Новый Запрос;

	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаЗамещенийПользователей, "_ТаблицаЗамещенийПользователей", Запрос);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналСверок.*,
		|	ЕСТЬNULL(_ТаблицаЗамещенийПользователей.Замещающий, ЕСТЬNULL(_ТаблицаЗамещенийОсновногоОтветственного.Замещающий, ОсновныеОтветственные.Сотрудник.Пользователь)) КАК НовыйОтветственный
		|ИЗ
		|	РегистрСведений.ЖурналСверокПоВнутреннемуУчету КАК ЖурналСверок
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОперации КАК ОсновныеОтветственные
		|		ПО (ОсновныеОтветственные.Организация = ЖурналСверок.Организация)
		|			И (ОсновныеОтветственные.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ОсновныеОтветственные.Основной = ИСТИНА)
		|			И ЖурналСверок.Период >= ОсновныеОтветственные.Период
		|			И (ЖурналСверок.Период <= ОсновныеОтветственные.ДатаОкончания
		|				ИЛИ ОсновныеОтветственные.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОперации КАК ОтветственныеЗаОперации
		|		ПО (ОтветственныеЗаОперации.Организация = ЖурналСверок.Организация)
		|			И (ОтветственныеЗаОперации.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ОтветственныеЗаОперации.Сотрудник.Пользователь = ЖурналСверок.Ответственный)
		|			И ЖурналСверок.Период >= ОтветственныеЗаОперации.Период
		|			И (ЖурналСверок.Период <= ОтветственныеЗаОперации.ДатаОкончания
		|				ИЛИ ОтветственныеЗаОперации.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийПользователей
		|		ПО (_ТаблицаЗамещенийПользователей.Пользователь = ЖурналСверок.Ответственный)
		|			И (_ТаблицаЗамещенийПользователей.Дата = НАЧАЛОПЕРИОДА(ЖурналСверок.Период, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийОсновногоОтветственного
		|		ПО (_ТаблицаЗамещенийОсновногоОтветственного.Пользователь = ОсновныеОтветственные.Сотрудник.Пользователь)
		|			И (_ТаблицаЗамещенийОсновногоОтветственного.Дата = НАЧАЛОПЕРИОДА(ЖурналСверок.Период, ДЕНЬ))	
		|ГДЕ
		|	ЖурналСверок.Организация = &Организация
		|	И ЖурналСверок.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (ОтветственныеЗаОперации.Сотрудник.Пользователь ЕСТЬ NULL
		|			ИЛИ _ТаблицаЗамещенийПользователей.Пользователь ЕСТЬ НЕ NULL )
		|	И &СчетДоверительногоУправления В (ЖурналСверок.СчетДоверительногоУправления, ЗНАЧЕНИЕ(Справочник.СчетаДоверительногоУправления.ПустаяСсылка))";
		
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ДатаНачала",						ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	Запрос.УстановитьПараметр("ГруппаВидовОпераций",			ГруппаВидовОпераций);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	Справочники.СчетаДоверительногоУправления.ПустаяСсылка());

	РезультатЗапроса = Запрос.Выполнить();

	ВыполненныеЗамены	= Новый ТаблицаЗначений;
	ОписаниеЗамены		= Новый Структура;

	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ВыполненныеЗамены.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		ОписаниеЗамены.Вставить(Колонка.Имя);	
	КонецЦикла;

	ВыборкаЗапроса = РезультатЗапроса.Выбрать();

	РезультатОперации.Всего = ВыборкаЗапроса.Количество();
	
	Пока ВыборкаЗапроса.Следующий() Цикл

		ТекстОшибки = "";
		
		РезультатОперации.Проверено = РезультатОперации.Проверено + 1;
		
		МенеджерЗаписи = РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.СоздатьМенеджерЗаписи();

		ЗаполнитьЗначенияСвойств(ОписаниеЗамены, ВыборкаЗапроса);
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаЗапроса);
		
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда

			МенеджерЗаписи.Ответственный = ВыборкаЗапроса.НовыйОтветственный;

			СообщенияДоЗаписи = ПолучитьСообщенияПользователю(Истина);
			
			Попытка
				МенеджерЗаписи.Записать();
				РезультатОперации.Изменено = РезультатОперации.Изменено + 1;
				ЗаполнитьЗначенияСвойств(ВыполненныеЗамены.Добавить(), ВыборкаЗапроса);
			Исключение
				ТекстОшибки = СтрШаблон(
					"%1
					|------------------------------------------------------------
					|%2",
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
					ОбщегоНазначения.ПолучитьТекстСообщенийПользователю());
			КонецПопытки;
			
		Иначе
			ТекстОшибки = "Запись не найдена";
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ДобавитьОшибку(РезультатОперации, РаботаСоСтрокамиКлиентСервер.ПредставлениеСтруктуры(ОписаниеЗамены), ТекстОшибки);	
		КонецЕсли;

		// Добавляем служебное сообщение для уведомления родительского задания
		
		Если ЗапущеноВФоне Тогда
			СоздатьСлужебноеСообщение(ИдентификаторФормы, РезультатОперации);
		КонецЕсли;		
		
	КонецЦикла;	
	
	Если ВыполненныеЗамены.Количество() > 0 Тогда
		РезультатОперации.Вставить("ВыполненныеЗамены", ВыполненныеЗамены);
	КонецЕсли;
	
	Возврат РезультатОперации; 
	
КонецФункции

#КонецОбласти

#Область Заполнение_ответственного_в_подтверждениях_операций

Функция ЗаполнитьОтветственногоПодтвержденийОпераций(Организация, ДатаНачала, ДатаОкончания, ПараметрыФоновогоЗадания = Неопределено)
	
	РезультатОперации = Новый Структура("Проверено, Изменено, Всего, Ошибок, Ошибки", 0, 0, 0, 0, Новый Массив);
	
	ЗапущеноВФоне		= ПараметрыСеанса.ЭтоФоновоеЗадание;
	ИдентификаторФормы	= Неопределено;
	
	Если ЗапущеноВФоне И ТипЗнч(ПараметрыФоновогоЗадания) = Тип("Структура") Тогда
		ПараметрыФоновогоЗадания.Свойство("ИдентификаторФормы", ИдентификаторФормы);
	КонецЕсли;
	
	ГруппаВидовОпераций			  = ОбщегоНазначения.ПолучитьИменованныйОбъект("ОперацииВнутреннегоУчета");
	ТаблицаЗамещенийПользователей = ПолучитьТаблицуЗамещенийПользователей(Организация, ГруппаВидовОпераций, ДатаНачала, ДатаОкончания);

	// ПРОВЕРИТЬ ЧТО В ПОДТВЕРЖДАЕМЫХ ОПЕРАЦИЯХ НЕ ПОЯВИЛАСЬ ЦЕЛЬ РАСЧЕТА
	
	Запрос = Новый Запрос;

	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаЗамещенийПользователей, "_ТаблицаЗамещенийПользователей", Запрос);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПодтверждений.*,
		|	ЕСТЬNULL(_ТаблицаЗамещенийПользователей.Замещающий, ЕСТЬNULL(_ТаблицаЗамещенийОсновногоОтветственного.Замещающий, ОсновныеОтветственные.Сотрудник.Пользователь)) КАК НовыйОтветственный
		|ИЗ
		|	РегистрСведений.ПодтверждениеОперацийБэкОфиса КАК ЖурналПодтверждений
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОперации КАК ОсновныеОтветственные
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыВидовОпераций.ВидыОпераций КАК ВидыОперацийГруппы
		|			ПО (ВидыОперацийГруппы.Ссылка = ОсновныеОтветственные.ГруппаВидовОпераций)
		|				И (ВидыОперацийГруппы.ВидОперации <> НЕОПРЕДЕЛЕНО)	
		|		ПО (ОсновныеОтветственные.Организация = ЖурналПодтверждений.Организация)
		|			И (ОсновныеОтветственные.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ОсновныеОтветственные.Основной = ИСТИНА)
		|			И (ТИПЗНАЧЕНИЯ(ВидыОперацийГруппы.ВидОперации) = ТИПЗНАЧЕНИЯ(ЖурналПодтверждений.Операция))
		//|			И ЕСТЬNULL(ВидыОперацийГруппы.ЦельРасчета = ЖурналПодтверждений.Операция.ЦельРасчета, ИСТИНА)	
		|			И ЖурналПодтверждений.Период >= ОсновныеОтветственные.Период
		|			И (ЖурналПодтверждений.Период <= КОНЕЦПЕРИОДА(ОсновныеОтветственные.ДатаОкончания, ДЕНЬ)
		|				ИЛИ ОсновныеОтветственные.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЗаОперации КАК ОтветственныеЗаОперации
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыВидовОпераций.ВидыОпераций КАК ВидыОперацийГруппы2
		|			ПО (ВидыОперацийГруппы2.Ссылка = ОтветственныеЗаОперации.ГруппаВидовОпераций)
		|		ПО (ОтветственныеЗаОперации.Организация = ЖурналПодтверждений.Организация)
		|			И (ОтветственныеЗаОперации.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ОтветственныеЗаОперации.Сотрудник.Пользователь = ЖурналПодтверждений.Ответственный)
		|			И (ТИПЗНАЧЕНИЯ(ВидыОперацийГруппы2.ВидОперации) = ТИПЗНАЧЕНИЯ(ЖурналПодтверждений.Операция))
		//|			И ЕСТЬNULL(ВидыОперацийГруппы2.ЦельРасчета = ЖурналПодтверждений.Операция.ЦельРасчета, ИСТИНА)	
		|			И ЖурналПодтверждений.Период >= ОтветственныеЗаОперации.Период
		|			И (ЖурналПодтверждений.Период <= КОНЕЦПЕРИОДА(ОтветственныеЗаОперации.ДатаОкончания, ДЕНЬ)
		|				ИЛИ ОтветственныеЗаОперации.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийПользователей
		|		ПО (_ТаблицаЗамещенийПользователей.Пользователь = ЖурналПодтверждений.Ответственный)
		|			И (_ТаблицаЗамещенийПользователей.Дата = НАЧАЛОПЕРИОДА(ЖурналПодтверждений.Период, ДЕНЬ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ТаблицаЗамещенийПользователей КАК _ТаблицаЗамещенийОсновногоОтветственного
		|		ПО (_ТаблицаЗамещенийОсновногоОтветственного.Пользователь = ОсновныеОтветственные.Сотрудник.Пользователь)
		|			И (_ТаблицаЗамещенийОсновногоОтветственного.Дата = НАЧАЛОПЕРИОДА(ЖурналПодтверждений.Период, ДЕНЬ))	
		|ГДЕ
		|	ЖурналПодтверждений.Организация = &Организация
		|	И ЖурналПодтверждений.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (ОтветственныеЗаОперации.Сотрудник.Пользователь ЕСТЬ NULL
		|			ИЛИ _ТаблицаЗамещенийПользователей.Пользователь ЕСТЬ НЕ NULL )";
		
	Запрос.УстановитьПараметр("Организация",					Организация);
	Запрос.УстановитьПараметр("ДатаНачала",						ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	Запрос.УстановитьПараметр("ГруппаВидовОпераций",			ГруппаВидовОпераций);

	РезультатЗапроса = Запрос.Выполнить();

	ВыполненныеЗамены	= Новый ТаблицаЗначений;
	ОписаниеЗамены		= Новый Структура;

	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ВыполненныеЗамены.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		ОписаниеЗамены.Вставить(Колонка.Имя);	
	КонецЦикла;

	ВыборкаЗапроса = РезультатЗапроса.Выбрать();

	РезультатОперации.Всего = ВыборкаЗапроса.Количество();
	
	Пока ВыборкаЗапроса.Следующий() Цикл

		ТекстОшибки = "";
		
		РезультатОперации.Проверено = РезультатОперации.Проверено + 1;
		
		МенеджерЗаписи = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.СоздатьМенеджерЗаписи();

		ЗаполнитьЗначенияСвойств(ОписаниеЗамены, ВыборкаЗапроса);
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ВыборкаЗапроса);
		
		МенеджерЗаписи.Прочитать();
		
		Если МенеджерЗаписи.Выбран() Тогда

			МенеджерЗаписи.Ответственный = ВыборкаЗапроса.НовыйОтветственный;

			СообщенияДоЗаписи = ПолучитьСообщенияПользователю(Истина);
			
			Попытка
				МенеджерЗаписи.Записать();
				РезультатОперации.Изменено = РезультатОперации.Изменено + 1;
				ЗаполнитьЗначенияСвойств(ВыполненныеЗамены.Добавить(), ВыборкаЗапроса);
			Исключение
				ТекстОшибки = СтрШаблон(
					"%1
					|------------------------------------------------------------
					|%2",
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),
					ОбщегоНазначения.ПолучитьТекстСообщенийПользователю());
			КонецПопытки;
			
		Иначе
			ТекстОшибки = "Запись не найдена";
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ДобавитьОшибку(РезультатОперации, РаботаСоСтрокамиКлиентСервер.ПредставлениеСтруктуры(ОписаниеЗамены), ТекстОшибки);	
		КонецЕсли;

		// Добавляем служебное сообщение для уведомления родительского задания
		
		Если ЗапущеноВФоне Тогда
			СоздатьСлужебноеСообщение(ИдентификаторФормы, РезультатОперации);
		КонецЕсли;		
		
	КонецЦикла;	
	
	Если ВыполненныеЗамены.Количество() > 0 Тогда
		РезультатОперации.Вставить("ВыполненныеЗамены", ВыполненныеЗамены);
	КонецЕсли;
	
	Возврат РезультатОперации; 
	
КонецФункции

#КонецОбласти

#Область Определение_ответственных_за_операции

Функция ПолучитьТаблицуЗамещенийПользователей(Организация, ГруппаВидовОпераций, ДатаНачала, ДатаОкончания) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _Дни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|ГДЕ
		|	ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаря.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_Дни.Дата КАК Дата,
		|	ЗамещающиеСотрудники.Сотрудник.Пользователь КАК Пользователь,
		|	ЗамещающиеСотрудники.Замещающий.Пользователь КАК Замещающий
		|ИЗ
		|	_Дни КАК _Дни
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗамещающиеСотрудники КАК ЗамещающиеСотрудники
		|		ПО (ЗамещающиеСотрудники.Организация = &Организация)
		|			И (ЗамещающиеСотрудники.ГруппаВидовОпераций = &ГруппаВидовОпераций)
		|			И (ЗамещающиеСотрудники.Период <= _Дни.Дата)
		|			И (КОНЕЦПЕРИОДА(ЗамещающиеСотрудники.ДатаОкончания, ДЕНЬ) >= _Дни.Дата
		|				ИЛИ ЗамещающиеСотрудники.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))");
	
	Запрос.УстановитьПараметр("Организация",		 Организация);
	Запрос.УстановитьПараметр("ГруппаВидовОпераций", ГруппаВидовОпераций);
	Запрос.УстановитьПараметр("ДатаНачала",			 ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",		 ДатаОкончания);
	
	КэшЗамещений = Новый Соответствие;
	КешЗамещающих = Новый Соответствие;
	
	ТаблицаЗамещений = Запрос.Выполнить().Выгрузить();
	ТаблицаЗамещений.Индексы.Добавить("Пользователь, Дата");	
	
	Для Каждого СтрокаЗамещения Из ТаблицаЗамещений Цикл
		
		СтруктураПоиска	= Новый Структура("Пользователь, Дата", СтрокаЗамещения.Пользователь, СтрокаЗамещения.Дата);
		КлючПоиска		= ЗначениеВСтрокуВнутр(СтруктураПоиска); // РаботаСоСтрокамиКлиентСервер.ПредставлениеСтруктуры(СтруктураПоиска);
		
		КешЗамещающих.Вставить(КлючПоиска, СтрокаЗамещения.Пользователь); // чтобы сам себя не замещал	
		
		СтрокаЗамещения.Замещающий = НайтиЗамещениеРекурсивно(ТаблицаЗамещений, СтрокаЗамещения.Замещающий, СтрокаЗамещения.Дата, КэшЗамещений, КешЗамещающих);
		
		КэшЗамещений.Вставить(КлючПоиска, СтрокаЗамещения.Замещающий);
		
	КонецЦикла;
		
	Возврат ТаблицаЗамещений;	
	
КонецФункции

Функция НайтиЗамещениеРекурсивно(ТаблицуЗамещений, Пользователь, Дата, КэшЗамещений, КешЗамещающих = Неопределено)	
		
	СтруктураПоиска	= Новый Структура("Пользователь, Дата", Пользователь, Дата);
	КлючПоиска		= ЗначениеВСтрокуВнутр(СтруктураПоиска); // РаботаСоСтрокамиКлиентСервер.ПредставлениеСтруктуры(СтруктураПоиска);
	
	Замещение = КэшЗамещений.Получить(КлючПоиска);
	
	Если Замещение = Неопределено Тогда
		
		// Проверка на зацикливание
		Если КешЗамещающих.Получить(КлючПоиска) <> Неопределено Тогда
			ВызватьИсключение "Обнаружено зацикливание замещений пользователя """ + Строка(Пользователь) + """ за " + Формат(Дата, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		КешЗамещающих.Вставить(КлючПоиска, Пользователь);	

		// поиск замещающего
		СтрокиЗамещения = ТаблицуЗамещений.НайтиСтроки(СтруктураПоиска);
		
		Если СтрокиЗамещения.Количество() > 0 Тогда
			Замещение = НайтиЗамещениеРекурсивно(ТаблицуЗамещений, СтрокиЗамещения[0].Замещающий, Дата, КэшЗамещений, КешЗамещающих);
		Иначе
			Замещение = Пользователь;	
		КонецЕсли;		
		
		КэшЗамещений.Вставить(КлючПоиска, Замещение);
		
	КонецЕсли;
		
	Возврат Замещение;
	
КонецФункции

#КонецОбласти

#Область Работа_с_датами_запрета_редактирования

Функция ОчиститьДатыЗапретаДляРедактированияДокумента(Период, Организация, Знач СчетаДоверительногоУправления, ГруппаЗапрета = Неопределено, ВидУчета = Неопределено)
	
	РанееУстановленныеДатыЗапрета = Новый Соответствие; 
	
	Если ТипЗнч(СчетаДоверительногоУправления) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		СчетаДоверительногоУправления = РаботаСКоллекциями.ЗначениеВМассив(СчетаДоверительногоУправления);
	КонецЕсли;
	
	Для Каждого СчетДоверительногоУправления Из СчетаДоверительногоУправления Цикл
		
		ЗаблокироватьДатыЗапретаРедактированияСчетаДоверительногоУправления(СчетДоверительногоУправления);
		
		ОтборДатЗапрета = РегистрыСведений.ДатыЗапретаРедактирования.СформироватьСтруктуруОтбораДатЗапрета(Организация, СчетДоверительногоУправления, ГруппаЗапрета, ВидУчета);

		ДатыЗапретаРедактирования = РегистрыСведений.ДатыЗапретаРедактирования.ПолучитьДатыЗапретаРедактирования(ОтборДатЗапрета);

		Если РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьЗапретРедактирования(Период, ДатыЗапретаРедактирования) Тогда
			
			РанееУстановленныеДатыЗапрета.Вставить(ОтборДатЗапрета, ДатыЗапретаРедактирования); 
			
			РегистрыСведений.ДатыЗапретаРедактирования.ОчиститьДатыЗапретаРедактирования(ОтборДатЗапрета);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат РанееУстановленныеДатыЗапрета;

КонецФункции

Процедура ЗаблокироватьДатыЗапретаРедактированияСчетаДоверительногоУправления(СчетДоверительногоУправления)
	
	Блокировка = Новый БлокировкаДанных;
	БлокировкаДатЗапрета = Блокировка.Добавить("РегистрСведений.ДатыЗапретаРедактирования");
	БлокировкаДатЗапрета.УстановитьЗначение("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Блокировка.Заблокировать();
	
КонецПроцедуры

