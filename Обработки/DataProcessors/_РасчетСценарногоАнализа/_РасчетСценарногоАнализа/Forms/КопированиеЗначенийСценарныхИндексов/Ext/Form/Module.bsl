// Возвращаемое значение:
//	Структура(
//		ПроизошелИмпорт - Булево - Произошёл ли импорт значений сценарных индексов для текущих параметров
//		ИнформационныйТекст - Строка - Обновлённый информационный текст
//	)

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КопироватьДанныеФормы(Параметры.Объект, Объект);
	
	// "НаправлениеКопирования" по умолчанию
	Если Не ЗначениеЗаполнено(НаправлениеКопирования) Тогда
		НаправлениеКопирования = "Импорт";
	КонецЕсли;
	// "БазаДанныхДляВзаимодействия" по умолчанию
	Если Не ЗначениеЗаполнено(БазаДанныхДляВзаимодействия) Тогда
		БазаДанныхДляВзаимодействия = Объект.ИспользуемаяБазаДанных;
	КонецЕсли;
	// "ПоведениеКопирования" по умолчанию
	Если Не ЗначениеЗаполнено(ПоведениеКопирования) Тогда
		ПоведениеКопирования = "БезЗамещения";
	КонецЕсли;
	// Параметры для взаимодействия по умолчанию
	ДатаРасчетаДляВзаимодействия = Объект.ДатаРасчета;
	НомерРасчетаДляВзаимодействия = Объект.НомерРасчета;
	
	БазаДанныхДляВзаимодействияПриИзмененииНаСервере();
	НаправлениеКопированияПриИзмененииНаСервере();
	ИспользоватьФильтрСценарииПриИзмененииНаСервере();
	ДатаРасчетаИлиНомерРасчетаДляВзаимодействияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ЭтаФорма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	СтруктураВозврата = Новый Структура("ПроизошелИмпорт, ИнформационныйТекст", ПроизошелИмпорт, Объект.ИнформационныйТекст);
	Закрыть(СтруктураВозврата);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура БазаДанныхДляВзаимодействияПриИзменении(Элемент)
	Если Объект.ИспользуемаяБазаДанных <> БазаДанныхДляВзаимодействия Тогда
		ИспользоватьФильтрСценарии = Ложь;
		Элементы.ИспользоватьФильтрСценарии.Доступность = Ложь;
		ИспользоватьФильтрСценарииПриИзменении(Неопределено);
	Иначе
		Элементы.ИспользоватьФильтрСценарии.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

// Копия процедуры "БазаДанныхДляВзаимодействияПриИзменении" на сервере
&НаСервере
Процедура БазаДанныхДляВзаимодействияПриИзмененииНаСервере()
	Если Объект.ИспользуемаяБазаДанных <> БазаДанныхДляВзаимодействия Тогда
		ИспользоватьФильтрСценарии = Ложь;
		Элементы.ИспользоватьФильтрСценарии.Доступность = Ложь;
		ИспользоватьФильтрСценарииПриИзмененииНаСервере();
	Иначе
		Элементы.ИспользоватьФильтрСценарии.Доступность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьФильтрСценарииПриИзменении(Элемент)
	// "ИспользоватьФильтрСценарии"
	Элементы.ИспользоватьФильтрСценарии.ПоложениеЗаголовка = ?(ИспользоватьФильтрСценарии,
		ПоложениеЗаголовкаЭлементаФормы.Нет, ПоложениеЗаголовкаЭлементаФормы.Право);
	// "ФильтрСценарии"
	Элементы.ФильтрСценарии.Видимость = ИспользоватьФильтрСценарии;
	// "ГруппаФильтрСценарииКонтур"
	Элементы.ГруппаФильтрСценарииКонтур.ЦветФона = ?(Не ИспользоватьФильтрСценарии,
		Элементы.ИспользоватьФильтрСценарии.ЦветФона, // Элемент "ИспользоватьФильтрСценарии" имеет ЦветФона = Авто
		?(НаправлениеКопирования = "Импорт",
			Элементы.ГруппаДанныеДляВзаимодействияКонтур.ЦветФона, Элементы.ГруппаТекущиеДанныеКонтур.ЦветФона));
	// "ГруппаФильтрСценарии"
	Элементы.ГруппаФильтрСценарии.ЦветФона = ?(Не ИспользоватьФильтрСценарии,
		Элементы.ИспользоватьФильтрСценарии.ЦветФона, // Элемент "ИспользоватьФильтрСценарии" имеет ЦветФона = Авто
		Элементы.ГруппаТекущиеДанные.ЦветФона);
КонецПроцедуры

// Копия процедуры "ИспользоватьФильтрСценарииПриИзменении" на сервере
&НаСервере
Процедура ИспользоватьФильтрСценарииПриИзмененииНаСервере()
	// "ИспользоватьФильтрСценарии"
	Элементы.ИспользоватьФильтрСценарии.ПоложениеЗаголовка = ?(ИспользоватьФильтрСценарии,
		ПоложениеЗаголовкаЭлементаФормы.Нет, ПоложениеЗаголовкаЭлементаФормы.Право);
	// "ФильтрСценарии"
	Элементы.ФильтрСценарии.Видимость = ИспользоватьФильтрСценарии;
	// "ГруппаФильтрСценарииКонтур"
	Элементы.ГруппаФильтрСценарииКонтур.ЦветФона = ?(Не ИспользоватьФильтрСценарии,
		Элементы.ИспользоватьФильтрСценарии.ЦветФона, // Элемент "ИспользоватьФильтрСценарии" имеет ЦветФона = Авто
		?(НаправлениеКопирования = "Импорт",
			Элементы.ГруппаДанныеДляВзаимодействияКонтур.ЦветФона, Элементы.ГруппаТекущиеДанныеКонтур.ЦветФона));
	// "ГруппаФильтрСценарии"
	Элементы.ГруппаФильтрСценарии.ЦветФона = ?(Не ИспользоватьФильтрСценарии,
		Элементы.ИспользоватьФильтрСценарии.ЦветФона, // Элемент "ИспользоватьФильтрСценарии" имеет ЦветФона = Авто
		Элементы.ГруппаТекущиеДанные.ЦветФона);
КонецПроцедуры

&НаКлиенте
Процедура ДатаРасчетаДляВзаимодействияПриИзменении(Элемент)
	ДатаРасчетаИлиНомерРасчетаДляВзаимодействияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НомерРасчетаДляВзаимодействияПриИзменении(Элемент)
	ДатаРасчетаИлиНомерРасчетаДляВзаимодействияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДатаРасчетаИлиНомерРасчетаДляВзаимодействияПриИзмененииНаСервере()
	// Получение списка сценариев для фильтра
	НайденныеСценарии = Неопределено;
	Если Объект.ИспользуемаяБазаДанных = БазаДанныхДляВзаимодействия Тогда
		ОбъектЗначение = РеквизитФормыВЗначение("Объект");
		ДатаРасчетаДляФильтраПоСценариям = ?(НаправлениеКопирования = "Импорт",
			ДатаРасчетаДляВзаимодействия, Объект.ДатаРасчета);
		НомерРасчетаДляФильтраПоСценариям = ?(НаправлениеКопирования = "Импорт",
			НомерРасчетаДляВзаимодействия, Объект.НомерРасчета);
		ИспользуемаяГруппаСценариев = ОбъектЗначение.ПолучитьГруппуСценариев(
			ДатаРасчетаДляФильтраПоСценариям, НомерРасчетаДляФильтраПоСценариям);
		ПолученныеСценарии = ОбъектЗначение.ПолучитьСценарии(ИспользуемаяГруппаСценариев);
		ОтфильтрованныеСценарии = ОбъектЗначение.ОтфильтроватьСценарииПоИспользуемым(
			ПолученныеСценарии, ДатаРасчетаДляФильтраПоСценариям, НомерРасчетаДляФильтраПоСценариям);
		НайденныеСценарии = ОтфильтрованныеСценарии;
	КонецЕсли;
	// Обновление фильтра по сценариям
	Элементы.ФильтрСценарии.СписокВыбора.Очистить();
	УникальныеНайденныеСценарии = Новый Соответствие; // Соответствие(Число (Идентификатор сценария), Истина)
	Если НайденныеСценарии <> Неопределено Тогда
		Для Каждого НайденныйСценарий Из НайденныеСценарии Цикл
			Элементы.ФильтрСценарии.СписокВыбора.Добавить(НайденныйСценарий.Идентификатор, НайденныйСценарий.Наименование);
			УникальныеНайденныеСценарии.Вставить(НайденныйСценарий.Идентификатор, Истина);
		КонецЦикла;
	КонецЕсли;
	Итератор = ФильтрСценарии.Количество() - 1;
	Пока Итератор >= 0 Цикл
		ТекущийСценарий = ФильтрСценарии[Итератор];
		Если УникальныеНайденныеСценарии.Получить(ТекущийСценарий.Значение) = Неопределено Тогда
			ФильтрСценарии.Удалить(Итератор);
		КонецЕсли;
		Итератор = Итератор - 1;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаСменитьНаправлениеКопирования(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСменитьНаправлениеКопирования");
	ВыполнитьКомандаСменитьНаправлениеКопирования();
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаСменитьНаправлениеКопирования()
	НаправлениеКопирования = ?(НаправлениеКопирования = "Импорт", "Экспорт", "Импорт");
	НаправлениеКопированияПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура КомандаСкопироватьЗначения(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаСкопироватьЗначения");
	ВыполнитьКомандаСкопироватьЗначения(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаСкопироватьЗначения(ПараметрыСессии)
	// Параметры процедуры
	ДатаРасчетаОткуда = ?(НаправлениеКопирования = "Импорт", ДатаРасчетаДляВзаимодействия, Объект.ДатаРасчета);
	ДатаРасчетаКуда = ?(НаправлениеКопирования = "Импорт", Объект.ДатаРасчета, ДатаРасчетаДляВзаимодействия);
	НомерРасчетаОткуда = ?(НаправлениеКопирования = "Импорт", НомерРасчетаДляВзаимодействия, Объект.НомерРасчета);
	НомерРасчетаКуда = ?(НаправлениеКопирования = "Импорт", Объект.НомерРасчета, НомерРасчетаДляВзаимодействия);
	НомераСценариев = ?(ИспользоватьФильтрСценарии, СтрСоединить(ФильтрСценарии.ВыгрузитьЗначения(), ", "), NULL);
	РабочаяЛиБазаДанныхОткуда = ?(НаправлениеКопирования = "Импорт", БазаДанныхДляВзаимодействия = "Рабочая", Объект.ИспользуемаяБазаДанных = "Рабочая");
	РабочаяЛиБазаДанныхКуда = ?(НаправлениеКопирования = "Импорт", Объект.ИспользуемаяБазаДанных = "Рабочая", БазаДанныхДляВзаимодействия = "Рабочая");
	//ПринудительноеКопирование = (ПоведениеКопирования = "СЗамещением");
	ПринудительноеКопирование = Истина;
	ОписаниеОшибки = "";
	// Проверка параметров
	Если ДатаРасчетаОткуда = ДатаРасчетаКуда
		И НомерРасчетаОткуда = НомерРасчетаКуда
		И РабочаяЛиБазаДанныхОткуда = РабочаяЛиБазаДанныхКуда
	Тогда
		ТекстОшибки = "Нельзя переносить значения сценарных индексов туда же, где они находятся";
		ПоказатьПредупреждение(, ТекстОшибки,, "Проверка параметров");
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		Возврат;
	КонецЕсли;
	// Проверка наличия значений в конечной точке
	Если ЕстьЗначения(ДатаРасчетаКуда, НомерРасчетаКуда) Тогда
		Ответ = Вопрос("В конечной точке уже имеются значения. Заменить их?", РежимДиалогаВопрос.ОКОтмена);
		Если Ответ <> КодВозвратаДиалога.ОК Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Запуск процедуры на сервере
	КомандаСкопироватьЗначенияНаСервере(
		ДатаРасчетаОткуда,
		ДатаРасчетаКуда,
		НомерРасчетаОткуда,
		НомерРасчетаКуда,
		РабочаяЛиБазаДанныхОткуда,
		РабочаяЛиБазаДанныхКуда,
		НомераСценариев,
		ПринудительноеКопирование,
		Объект.ИдентификаторСессии,
		ОписаниеОшибки);
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		Предупреждение(ОписаниеОшибки);
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	Если НаправлениеКопирования = "Импорт" Тогда
		ПроизошелИмпорт = Истина;
	КонецЕсли;
	ПолучитьИВывестиИнформационныйТекст();
	ПоказатьПредупреждение(, "Значения сценарных индексов успешно скопированы.");
КонецПроцедуры

&НаСервере
Процедура КомандаСкопироватьЗначенияНаСервере(ДатаРасчетаОткуда, ДатаРасчетаКуда, НомерРасчетаОткуда, НомерРасчетаКуда,
		РабочаяЛиБазаДанныхОткуда, РабочаяЛиБазаДанныхКуда, НомераСценариев, ПринудительноеКопирование, ИдентификаторСессии, ОписаниеОшибки = "")
	Попытка
		#Область ОписаниеПроцедуры
		// Описание процедуры P_Scenario_Copy_Indexes_Values:
		//	@AssetDateFrom DATE,				-- Отчётная дтаа (AssetDate), с которой копируются значения индексов
		//	@AssetDateTo DATE = NULL,			-- Отчётная дата (AssetDate), на которую копируются значения индексов с отчётной даты @AssetDateFrom.
		//										--	Если NULL, то перенос происходит на ту же отчётную дату.
		//	@CalcIDFrom INT,					-- Номер расчёта (CalcID), с которого копируются значения индексов
		//	@CalcIDTo INT = NULL,				-- Номер расчёта (CalcID), на который копируются значения индексов с номера расчёта @CalcIDFrom.
		//										--	Если NULL, то перенос происходит на тот же номер расчёта.
		//	@DatabaseFrom BIT,					-- База данных, с которой копируются значения индексов: 1 - Рабочая база, 0 - Тестовая база.
		//	@DatabaseTo BIT,					-- База данных, на которую копируются значения индексов: 1 - Рабочая база, 0 - Тестовая база.
		//	@ScenarioIDs NVARCHAR(MAX) = NULL,	-- Фильтр по номерам сценариев переносимых значений.
		//										--	Если NULL, то фильтр игнорируется. ВНИМАНИЕ: При удалении имеющихся значений фильтр игнорируется.
		//	-- Возможные значения:
		//	--	0 - Перенести значения в новое место только, если там нет значений;
		//	--	1 - Перенести значения в новое место, перетерев имеющиеся там значения.
		//	@ForceInsert BIT = 0,
		//
		//	-- Параметры, свойственные схеме 'AM':
		//
		//	@SessionID INT = 0 -- Идентификатор сессии расчётов
		#КонецОбласти
		ВнешниеИсточникиДанных.RiskControl.P_Scenario_Copy_Indexes_Values(
			ДатаРасчетаОткуда, ДатаРасчетаКуда, НомерРасчетаОткуда, НомерРасчетаКуда,
			РабочаяЛиБазаДанныхОткуда, РабочаяЛиБазаДанныхКуда, НомераСценариев, ПринудительноеКопирование, ИдентификаторСессии);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ОбъектЗначение = РеквизитФормыВЗначение("Объект");
		ОписаниеОшибки = ОбъектЗначение.ОчиститьОписаниеОшибкиSQL(ОписаниеОшибки);
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ЕстьЗначения(ДатаРасчета, НомерРасчета)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	T_Scenario_Indexes_Values.AssetDate КАК AssetDate
		|ИЗ
		|	ВнешнийИсточникДанных.RiskControl.Таблица.T_Scenario_Indexes_Values КАК T_Scenario_Indexes_Values
		|ГДЕ
		|	T_Scenario_Indexes_Values.AssetDate = &ДатаРасчета
		|	И T_Scenario_Indexes_Values.CalcID = &НомерРасчета";
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("НомерРасчета", НомерРасчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Количество() > 0;
КонецФункции

&НаКлиенте
Процедура НаправлениеКопированияПриИзменении()
	// Проверка с исправлением заранее, чтобы вывести предупреждение вместо сообщения
	Если НаправлениеКопирования = "Экспорт"
		И Объект.ПриращенияДоходности.Количество() = 0
		И Объект.МодельныеДоходностиИДюрации.Количество() = 0
		И Объект.ЗамещенияСценарныхИндексов.Количество() = 0
	Тогда
		Предупреждение("Нет значений для экспорта.",, "Смена направления копирования");
		НаправлениеКопирования = "Импорт";
	КонецЕсли;
	НаправлениеКопированияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура НаправлениеКопированияПриИзмененииНаСервере()
	Если НаправлениеКопирования = "Экспорт"
		И Объект.ПриращенияДоходности.Количество() = 0
		И Объект.МодельныеДоходностиИДюрации.Количество() = 0
		И Объект.ЗамещенияСценарныхИндексов.Количество() = 0
	Тогда
		Сообщить("Нет значений для экспорта.");
		НаправлениеКопирования = "Импорт";
	КонецЕсли;
	// Смена заголовка и разворот стрелки на картинке кнопки смены направления
	Если НаправлениеКопирования = "Импорт" Тогда
		Элементы.КомандаСменитьНаправлениеКопирования.Заголовок = "Импорт";
		Элементы.КомандаСменитьНаправлениеКопирования.Картинка = Элементы.ДекорацияСтрелкаВлево.Картинка;
		Элементы.КомандаСменитьНаправлениеКопирования.ПоложениеКартинки = ПоложениеКартинкиКнопкиФормы.Лево;
	Иначе
		Элементы.КомандаСменитьНаправлениеКопирования.Заголовок = "Экспорт";
		Элементы.КомандаСменитьНаправлениеКопирования.Картинка = Элементы.ДекорацияСтрелкаВправо.Картинка;
		Элементы.КомандаСменитьНаправлениеКопирования.ПоложениеКартинки = ПоложениеКартинкиКнопкиФормы.Право;
	КонецЕсли;
	Элементы.БазаДанныхДляВзаимодействия.Заголовок = СтрЗаменить(
		"База данных <НаправлениеКопирования>",
		"<НаправлениеКопирования>",
		?(НаправлениеКопирования = "Импорт", "для импорта", "для экспорта"));
	ИспользоватьФильтрСценарииПриИзмененииНаСервере();
	ДатаРасчетаИлиНомерРасчетаДляВзаимодействияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьИВывестиИнформационныйТекст(ТакжеСообщить = Ложь)
	ОбъектЗначение = РеквизитФормыВЗначение("Объект");
	ОбъектЗначение.ПолучитьИВывестиИнформационныйТекст(ТакжеСообщить);
	ЗначениеВРеквизитФормы(ОбъектЗначение, "Объект");
КонецПроцедуры

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		РеквизитФормыВЗначение("Объект"), ИмяКоманды);
КонецФункции

&НаСервере
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
КонецПроцедуры

#КонецОбласти
