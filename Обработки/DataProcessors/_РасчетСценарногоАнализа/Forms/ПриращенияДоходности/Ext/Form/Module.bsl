	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаУстановитьФормулу()
	// Поиск первой попавшейся формулы
	Формула = Неопределено;
	РазныеФормулы = Ложь;
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоПриращенийДоходности.ВыделенныеСтроки Цикл
		НайденнаяСтрока = ДеревоПриращенийДоходности.НайтиПоИдентификатору(ВыделеннаяСтрока);
		// Формула находится только на нижнем уровене
		Если НайденнаяСтрока.ПолучитьЭлементы().Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Формула = Неопределено Тогда
			Если Не ПустаяСтрока(НайденнаяСтрока.Формула) Тогда
				Формула = НайденнаяСтрока.Формула;
			КонецЕсли;
		ИначеЕсли Формула <> НайденнаяСтрока.Формула Тогда
			РазныеФормулы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если РазныеФормулы Тогда
		Предупреждение("Выбраны строки с разными заполненными формулами."
			+ Символы.ПС + "Параметры будут получены из первой выделенной формулы.",, "Предупреждение");
	КонецЕсли;
	// Открытие дочерней формы
	ОписаниеОповещенияОЗакрытииДочернейФормы = Новый ОписаниеОповещения("УстановкаФормулыПриращенияДоходностиПриЗакрытии", ЭтаФорма);
	ПараметрыФормы = Новый Структура("Объект, Формула", Объект, Формула);
	ОткрытьФорму("ВнешняяОбработка._РасчетСценарногоАнализа.Форма.УстановкаФормулыПриращенияДоходности",
		ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗакрытииДочернейФормы);
КонецПроцедуры

&НаКлиенте
Процедура КомандаРассчитатьПоФормулам(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаРассчитатьПоФормулам");
	Попытка
		КомандаРассчитатьПоФормуламНаСервере();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаСервере
Процедура КомандаРассчитатьПоФормуламНаСервере()
	// Сбор всех строк нижнего уровня с формулами - 3 или 4 уровень, т.к. есть варианты:
	//	Сценарий -> СценарныйИндекс -> Дюрация -> РепернаяДата;
	//	Сценарий -> СценарныйИндекс -> РепернаяДата.
	СтрокиНижнегоУровня = Новый Массив; // Массив(ДанныеФормыЭлементДерева)
	Для Каждого СтрокаСценарий Из ДеревоПриращенийДоходности.ПолучитьЭлементы() Цикл
		Для Каждого СтрокаСценарныйИндекс Из СтрокаСценарий.ПолучитьЭлементы() Цикл
			Для Каждого Строка3Уровня Из СтрокаСценарныйИндекс.ПолучитьЭлементы() Цикл
				Если Строка3Уровня.ПолучитьЭлементы().Количество() = 0 Тогда // Строка3Уровня -> СтрокаРепернаяДата
					Если Не ПустаяСтрока(Строка3Уровня.Формула) Тогда
						СтрокиНижнегоУровня.Добавить(Строка3Уровня);
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				Для Каждого СтрокаРепернаяДата Из Строка3Уровня.ПолучитьЭлементы() Цикл // Строка3Уровня -> СтрокаДюрация
					Если Не ПустаяСтрока(СтрокаРепернаяДата.Формула) Тогда
						СтрокиНижнегоУровня.Добавить(СтрокаРепернаяДата);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	// Соответствие(Строка (Формула), Структура(
	//	"Функция": Строка (Имя функции),
	//	"Параметры": Массив(Строка (Параметр в текстовом виде)),
	//	"СтрокиДанных": Массив(ДанныеФормыЭлементДерева (Строка, для которой рассчитывается значение))
	//	"Значение": Число|NULL (Результат расчёта по формуле))
	РассчитанныеЗначенияФормул = Новый Соответствие;
	// Изменение и группировка формул со строк нижнего уровня
	Для Каждого СтрокаНижнегоУровня Из СтрокиНижнегоУровня Цикл
		// Замена шаблонов в формуле на контекстные значения
		ИзмененнаяФормула = СтрокаНижнегоУровня.Формула;
		ИзмененнаяФормула = СтрЗаменить(ИзмененнаяФормула, "<ДатаРасчета>", Формат(Объект.ДатаРасчета, "ДФ=yyyy-MM-dd"));
		ИзмененнаяФормула = СтрЗаменить(ИзмененнаяФормула, "<РепернаяДата>", Формат(СтрокаНижнегоУровня.РепернаяДата, "ДФ=yyyy-MM-dd"));
		Если СтрНайти(ИзмененнаяФормула, "<ПроцентVaRСценария>") <> 0 Тогда
			#Область ПроцентVaRСценария
			СценарийСтрокиНижнегоУровня = 0;
			ТекущийРодитель = СтрокаНижнегоУровня.ПолучитьРодителя();
			Пока ТекущийРодитель <> Неопределено Цикл
				Если ТекущийРодитель.Сценарий <> 0 Тогда
					СценарийСтрокиНижнегоУровня = ТекущийРодитель.Сценарий;
					Прервать;
				КонецЕсли;
				ТекущийРодитель = ТекущийРодитель.ПолучитьРодителя();
			КонецЦикла;
			НайденныйСценарий = Объект.Сценарии.НайтиСтроки(Новый Структура("Идентификатор", СценарийСтрокиНижнегоУровня));
			НайденныйСценарий = ?(НайденныйСценарий.Количество() > 0, НайденныйСценарий[0], Неопределено);
			Если НайденныйСценарий <> Неопределено Тогда
				ОкончаниеПроцентаVaR = СтрНайти(НайденныйСценарий.Наименование, "%)");
				НачалоПроцентаVaR = 0;
				Если ОкончаниеПроцентаVaR > 0 Тогда
					НачалоПроцентаVaR = СтрНайти(НайденныйСценарий.Наименование, "(", НаправлениеПоиска.СКонца, ОкончаниеПроцентаVaR);
				КонецЕсли;
				Если НачалоПроцентаVaR = 0 Или ОкончаниеПроцентаVaR = 0 Тогда
					Сообщить("Не найден процент VaR'а в наименовании сценария """ + НайденныйСценарий.Наименование + """ по шаблону ""(<ПроцентVaR>%)"".");
					Возврат;
				КонецЕсли;
				ПроцентVaRСценария = Число(Сред(НайденныйСценарий.Наименование, НачалоПроцентаVaR + 1, ОкончаниеПроцентаVaR - НачалоПроцентаVaR - 1));
				ИзмененнаяФормула = СтрЗаменить(ИзмененнаяФормула, "<ПроцентVaRСценария>", Формат(ПроцентVaRСценария, "ЧРД=.; ЧН=; ЧГ="));
			КонецЕсли;
			#КонецОбласти
		КонецЕсли;
		Если СтрНайти(ИзмененнаяФормула, "<ДнейСНачала>") <> 0 Или СтрНайти(ИзмененнаяФормула, "<ТорговыхДнейСНачала>") <> 0 Тогда
			#Область ДнейСНачалаИлиТорговыхДнейСНачала
			СценарныйИндексСтрокиНижнегоУровня = 0;
			ТекущийРодитель = СтрокаНижнегоУровня.ПолучитьРодителя();
			Пока ТекущийРодитель <> Неопределено Цикл
				Если ТекущийРодитель.СценарныйИндекс <> 0 Тогда
					СценарныйИндексСтрокиНижнегоУровня = ТекущийРодитель.СценарныйИндекс;
					Прервать;
				КонецЕсли;
				ТекущийРодитель = ТекущийРодитель.ПолучитьРодителя();
			КонецЦикла;
			НайденнаяРепернаяДата = Объект.РеперныеДаты.НайтиСтроки(
				Новый Структура("СценарныйИндекс, РепернаяДата", СценарныйИндексСтрокиНижнегоУровня, СтрокаНижнегоУровня.РепернаяДата));
			НайденнаяРепернаяДата = ?(НайденнаяРепернаяДата.Количество() > 0, НайденнаяРепернаяДата[0], Неопределено);
			Если НайденнаяРепернаяДата <> Неопределено Тогда
				ИзмененнаяФормула = СтрЗаменить(ИзмененнаяФормула, "<ДнейСНачала>", Формат(НайденнаяРепернаяДата.ДнейСНачала, "ЧН=; ЧГ="));
				ИзмененнаяФормула = СтрЗаменить(ИзмененнаяФормула, "<ТорговыхДнейСНачала>", Формат(НайденнаяРепернаяДата.ТорговыхДнейСНачала, "ЧН=; ЧГ="));
			Иначе
				Сообщить("Не найдена реперная дата """ + СтрокаНижнегоУровня.РепернаяДата
					+ """ у сценарного индекса """ + СтрокаНижнегоУровня.СценарныйИндекс + """.");
				Возврат;
			КонецЕсли;
			#КонецОбласти
		КонецЕсли;
		ЭлементРассчитанныхЗначенийФормул = РассчитанныеЗначенияФормул.Получить(ИзмененнаяФормула);
		Если ЭлементРассчитанныхЗначенийФормул <> Неопределено Тогда
			ЭлементРассчитанныхЗначенийФормул.СтрокиДанных.Добавить(СтрокаНижнегоУровня);
			Продолжить;
		КонецЕсли;
		// Разбор частей формулы, где первый элемент - название функции, а следующие - её параметры
		СтруктураФормулы = Новый Структура("Функция, Параметры, СтрокиДанных, Результат", Неопределено, Новый Массив, Новый Массив, NULL);
		ЧастиФормулы = СтрРазделить(ИзмененнаяФормула, " ");
		СтруктураФормулы.Функция = ЧастиФормулы[0];
		Для Итератор = 1 По ЧастиФормулы.Количество() - 1 Цикл
			СтруктураФормулы.Параметры.Добавить(ЧастиФормулы[Итератор]);
		КонецЦикла;
		СтруктураФормулы.СтрокиДанных.Добавить(СтрокаНижнегоУровня);
		РассчитанныеЗначенияФормул.Вставить(ИзмененнаяФормула, СтруктураФормулы);
	КонецЦикла;
	// Расчёт значений по формулам
	Для Каждого КлючЗначение Из РассчитанныеЗначенияФормул Цикл
		ПараметрыФормулы = КлючЗначение.Значение.Параметры;
		Если КлючЗначение.Значение.Функция = "GCurve_Index_VaR" Тогда
			#Область GCurve_Index_VaR
			Если Не (ПараметрыФормулы.Количество() = 5 Или ПараметрыФормулы.Количество() = 6) Тогда
				Сообщить("Некорректная формула: " + КлючЗначение.Ключ + ". Может быть указано только 5 параметров и множитель (необязательный).");
				Продолжить;
			КонецЕсли;
			AssetDate = Дата(СтрЗаменить(ПараметрыФормулы[0], "-", "")); // @AssetDate DATE
			VaRPercent = Число(ПараметрыФормулы[1]); // @VaRPercent DECIMAL(5, 2)
			HorizonTradeDays = Число(ПараметрыФормулы[2]); // @HorizonTradeDays INT
			DurationYears = ?(ПараметрыФормулы[3] = "DEF", 1, Число(ПараметрыФормулы[3])); // @DurationYears DECIMAL(8, 2) = 1.
			HistoricalPeriodYears = Число(ПараметрыФормулы[4]); // @HistoricalPeriodYears INT
			// Выполнение функции SQL
			КлючЗначение.Значение.Результат = ВнешниеИсточникиДанных.RiskControl.F_GCurve_Index_VaR(
				AssetDate, VaRPercent, HorizonTradeDays, DurationYears, HistoricalPeriodYears);
			Если ПараметрыФормулы.Количество() = 6 Тогда
				МножительРезультата = Число(СтрЗаменить(ПараметрыФормулы[5], "*", ""));
				КлючЗначение.Значение.Результат = КлючЗначение.Значение.Результат * МножительРезультата;
			КонецЕсли;
			#КонецОбласти
		ИначеЕсли КлючЗначение.Значение.Функция = "Bond_Index_VaR"
			Или КлючЗначение.Значение.Функция = "Stock_Index_VaR"
		Тогда
			#Область Bond_Index_VaR_Или_Stock_Index_VaR
			Если Не (ПараметрыФормулы.Количество() = 5 Или ПараметрыФормулы.Количество() = 6) Тогда
				Сообщить("Некорректная формула: """ + КлючЗначение.Ключ + """. Может быть указано только 5 параметров и множитель (необязательный).");
				Продолжить;
			КонецЕсли;
			AssetDate = Дата(СтрЗаменить(ПараметрыФормулы[0], "-", "")); // @AssetDate DATE
			VaRPercent = Число(ПараметрыФормулы[1]); // @VaRPercent DECIMAL(5, 2)
			HorizonTradeDays = Число(ПараметрыФормулы[2]); // @HorizonTradeDays INT
			MOEXIndexID = Число(ПараметрыФормулы[3]); // @MOEXIndexID INT
			HistoricalPeriodYears = Число(ПараметрыФормулы[4]); // @HistoricalPeriodYears INT
			// Выполнение функции SQL
			Если КлючЗначение.Значение.Функция = "Bond_Index_VaR" Тогда
				КлючЗначение.Значение.Результат = ВнешниеИсточникиДанных.RiskControl.F_Bond_Index_VaR(
					AssetDate, VaRPercent, HorizonTradeDays, MOEXIndexID, HistoricalPeriodYears);
			ИначеЕсли КлючЗначение.Значение.Функция = "Stock_Index_VaR" Тогда
				КлючЗначение.Значение.Результат = ВнешниеИсточникиДанных.RiskControl.F_Stock_Index_VaR(
					AssetDate, VaRPercent, HorizonTradeDays, MOEXIndexID, HistoricalPeriodYears);
			КонецЕсли;
			Если КлючЗначение.Значение.Результат = NULL Тогда
				Сообщить("Не удалось рассчитать значение для формулы """ + КлючЗначение.Ключ + """. Проверьте указанные параметры.");
				КлючЗначение.Значение.Результат = 0;
				Продолжить;
			КонецЕсли;
			Если ПараметрыФормулы.Количество() = 6 Тогда
				МножительРезультата = Число(СтрЗаменить(ПараметрыФормулы[5], "*", ""));
				КлючЗначение.Значение.Результат = КлючЗначение.Значение.Результат * МножительРезультата;
			КонецЕсли;
			#КонецОбласти
		КонецЕсли;
	КонецЦикла;
	// Установка рассчитанных значений - "ПриращениеДоходности"
	Для Каждого КлючЗначение Из РассчитанныеЗначенияФормул Цикл
		Для Каждого СтрокаДанных Из КлючЗначение.Значение.СтрокиДанных Цикл
			Если СтрокаДанных.ПриращениеДоходности <> КлючЗначение.Значение.Результат Тогда
				СтрокаДанных.ПриращениеДоходности = КлючЗначение.Значение.Результат;
				ЭтаФорма.Модифицированность = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПрименить(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПрименить");
	Попытка
		ВыполнитьКомандаПрименить();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаПрименить()
	// Сохранение локальных приращений доходности
	Объект.ПриращенияДоходности.Очистить();
	Для Каждого СтрокаДерева1Уровня Из ДеревоПриращенийДоходности.ПолучитьЭлементы() Цикл
		СтрокиДерева2Уровня = СтрокаДерева1Уровня.ПолучитьЭлементы();
		Для Каждого СтрокаДерева2Уровня Из СтрокиДерева2Уровня Цикл
			СтрокиДерева3Уровня = СтрокаДерева2Уровня.ПолучитьЭлементы();
			Для Каждого СтрокаДерева3Уровня Из СтрокиДерева3Уровня Цикл
				СтрокиДерева4Уровня = СтрокаДерева3Уровня.ПолучитьЭлементы();
				Если СтрокиДерева4Уровня.Количество() = 0 Тогда
					Если СтрокаДерева3Уровня.Выбрано Тогда
						НоваяСтрока = Объект.ПриращенияДоходности.Добавить();
						НоваяСтрока.Сценарий = СтрокаДерева1Уровня.Сценарий;
						НоваяСтрока.СценарныйИндекс = СтрокаДерева2Уровня.СценарныйИндекс;
						НоваяСтрока.РепернаяДата = СтрокаДерева3Уровня.РепернаяДата;
						НоваяСтрока.ПриращениеДоходности = СтрокаДерева3Уровня.ПриращениеДоходности;
						НоваяСтрока.Формула = СтрокаДерева3Уровня.Формула;
					КонецЕсли;
				Иначе
					Для Каждого СтрокаДерева4Уровня Из СтрокиДерева4Уровня Цикл
						Если СтрокаДерева4Уровня.Выбрано Тогда
							НоваяСтрока = Объект.ПриращенияДоходности.Добавить();
							НоваяСтрока.Сценарий = СтрокаДерева1Уровня.Сценарий;
							НоваяСтрока.СценарныйИндекс = СтрокаДерева2Уровня.СценарныйИндекс;
							НоваяСтрока.Дюрация = СтрокаДерева3Уровня.Дюрация;
							НоваяСтрока.РепернаяДата = СтрокаДерева4Уровня.РепернаяДата;
							НоваяСтрока.ПриращениеДоходности = СтрокаДерева4Уровня.ПриращениеДоходности;
							НоваяСтрока.Формула = СтрокаДерева4Уровня.Формула;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	// Закрытие формы
	ЭтаФорма.Модифицированность = Ложь;
	Закрыть(Объект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

&НаКлиенте
Процедура ГрупповаяУстановкаПриращенийДоходностиПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда // Результат неопределён как при закрытии дочерней формы, так и при отсутствии изменений
		Возврат;
	КонецЕсли;
	ПриращенияДоходности.Очистить();
	Для Каждого СтрокаРезультата Из Результат Цикл
		Если Не СтрокаРезультата.Выбрано Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ПриращенияДоходности.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультата);
	КонецЦикла;
	ОбновитьДеревоПриращенийДоходности();
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

// Результат - Строка, Неопределено - Формула
&НаКлиенте
Процедура УстановкаФормулыПриращенияДоходностиПриЗакрытии(Результат, ДополнительныеПараметры) Экспорт
	Если Не ЭтаФорма.Открыта() Или Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Применение изменений
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоПриращенийДоходности.ВыделенныеСтроки Цикл
		НайденнаяСтрока = ДеревоПриращенийДоходности.НайтиПоИдентификатору(ВыделеннаяСтрока);
		// Формула устанавливается только на нижний уровень
		Если НайденнаяСтрока.ПолучитьЭлементы().Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НайденнаяСтрока.Формула <> Результат Тогда
			НайденнаяСтрока.Формула = Результат;
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
		Если Не НайденнаяСтрока.Выбрано Тогда
			НайденнаяСтрока.Выбрано = Истина;
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужеюныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДеревоПриращенийДоходности()
	// Заполнение локальных приращений доходности для дальнейшего редактирования
	Объект.МодельныеДоходностиИДюрации.Сортировать("СценарныйИндекс, Дюрация");
	Запрос = Новый Запрос;
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ
		|	Сценарии.Идентификатор КАК Идентификатор,
		|	Сценарии.Наименование КАК Наименование
		|ПОМЕСТИТЬ _Сценарии
		|ИЗ
		|	&Сценарии КАК Сценарии
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СценарныеИндексы.Идентификатор КАК Идентификатор,
		|	СценарныеИндексы.Наименование КАК Наименование,
		|	СценарныеИндексы.ЕстьРазрезПоДюрации КАК ЕстьРазрезПоДюрации
		|ПОМЕСТИТЬ _СценарныеИндексы
		|ИЗ
		|	&СценарныеИндексы КАК СценарныеИндексы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Дюрации.СценарныйИндекс КАК СценарныйИндекс,
		|	Дюрации.Дюрация КАК Дюрация
		|ПОМЕСТИТЬ _Дюрации
		|ИЗ
		|	&Дюрации КАК Дюрации
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РеперныеДаты.СценарныйИндекс КАК СценарныйИндекс,
		|	РеперныеДаты.РепернаяДата КАК РепернаяДата
		|ПОМЕСТИТЬ _РеперныеДаты
		|ИЗ
		|	&РеперныеДаты КАК РеперныеДаты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПриращенияДоходности.Сценарий КАК Сценарий,
		|	ПриращенияДоходности.СценарныйИндекс КАК СценарныйИндекс,
		|	ПриращенияДоходности.Дюрация КАК Дюрация,
		|	ПриращенияДоходности.РепернаяДата КАК РепернаяДата,
		|	ПриращенияДоходности.ПриращениеДоходности КАК ПриращениеДоходности,
		|	ПриращенияДоходности.Формула КАК Формула
		|ПОМЕСТИТЬ _ПриращенияДоходности
		|ИЗ
		|	&ПриращенияДоходности КАК ПриращенияДоходности
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	_Сценарии.Идентификатор КАК Сценарий,
		|	МАКСИМУМ(_Сценарии.Наименование) КАК НаименованиеСценария,
		|	_СценарныеИндексы.Идентификатор КАК СценарныйИндекс,
		|	МАКСИМУМ(_СценарныеИндексы.Наименование) КАК НаименованиеСценарногоИндекса,
		|	_Дюрации.Дюрация КАК Дюрация,
		|	_РеперныеДаты.РепернаяДата КАК РепернаяДата,
		|	МАКСИМУМ(_ПриращенияДоходности.ПриращениеДоходности) КАК ПриращениеДоходности,
		|	МАКСИМУМ(_ПриращенияДоходности.Формула) КАК Формула,
		|	ВЫБОР
		|		КОГДА НЕ МАКСИМУМ(_ПриращенияДоходности.ПриращениеДоходности) ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Выбрано
		|ИЗ
		|	_Сценарии КАК _Сценарии
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СценарныеИндексы КАК _СценарныеИндексы
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Дюрации КАК _Дюрации
		|		ПО (_СценарныеИндексы.Идентификатор = _Дюрации.СценарныйИндекс)
		|			И (_СценарныеИндексы.ЕстьРазрезПоДюрации)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РеперныеДаты КАК _РеперныеДаты
		|		ПО (_СценарныеИндексы.Идентификатор = _РеперныеДаты.СценарныйИндекс)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ПриращенияДоходности КАК _ПриращенияДоходности
		|		ПО _Сценарии.Идентификатор = _ПриращенияДоходности.Сценарий
		|			И (_СценарныеИндексы.Идентификатор = _ПриращенияДоходности.СценарныйИндекс)
		|			И (НЕ _СценарныеИндексы.ЕстьРазрезПоДюрации
		|				ИЛИ _Дюрации.Дюрация = _ПриращенияДоходности.Дюрация)
		|			И (_РеперныеДаты.РепернаяДата = _ПриращенияДоходности.РепернаяДата)
		|
		|СГРУППИРОВАТЬ ПО
		|	_Сценарии.Идентификатор,
		|	_СценарныеИндексы.Идентификатор,
		|	_Дюрации.Дюрация,
		|	_РеперныеДаты.РепернаяДата
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сценарий,
		|	СценарныйИндекс,
		|	Дюрация,
		|	РепернаяДата
		|ИТОГИ ПО
		|	Сценарий,
		|	СценарныйИндекс,
		|	Дюрация";
	#КонецОбласти
	Запрос.УстановитьПараметр("Сценарии", Объект.Сценарии.Выгрузить());
	Запрос.УстановитьПараметр("СценарныеИндексы", Объект.СценарныеИндексы.Выгрузить());
	Запрос.УстановитьПараметр("Дюрации", Объект.Дюрации.Выгрузить());
	Запрос.УстановитьПараметр("РеперныеДаты", Объект.РеперныеДаты.Выгрузить());
	Запрос.УстановитьПараметр("ПриращенияДоходности", РеквизитФормыВЗначение("ПриращенияДоходности"));
	ВыборкаСценарныйИндекс = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Строки сценариев (1 уровень)
	ВыборкаСценарий = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоПриращенийДоходности.ПолучитьЭлементы().Очистить();
	СтрокиСценариев = ДеревоПриращенийДоходности.ПолучитьЭлементы();
	Пока ВыборкаСценарий.Следующий() Цикл
		НоваяСтрокаСценариев = СтрокиСценариев.Добавить();
		НоваяСтрокаСценариев.Сценарий = ВыборкаСценарий.Сценарий;
		НоваяСтрокаСценариев.ГибридноеНаименованиеСценария =
			ВыборкаСценарий.НаименованиеСценария + " (" + Формат(ВыборкаСценарий.Сценарий, "ЧГ=") + ")";
		// Строки сценарных индексов (2 уровень)
		ВыборкаСценарныйИндекс = ВыборкаСценарий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		СтрокиСценарныхИндексов = НоваяСтрокаСценариев.ПолучитьЭлементы();
		Пока ВыборкаСценарныйИндекс.Следующий() Цикл
			НоваяСтрокаСценарныхИндексов = СтрокиСценарныхИндексов.Добавить();
			НоваяСтрокаСценарныхИндексов.СценарныйИндекс = ВыборкаСценарныйИндекс.СценарныйИндекс;
			НоваяСтрокаСценарныхИндексов.ГибридноеНаименованиеСценарногоИндекса =
				ВыборкаСценарныйИндекс.НаименованиеСценарногоИндекса + " (" + Формат(ВыборкаСценарныйИндекс.СценарныйИндекс, "ЧГ=") + ")";
			// Строки дюрации (если больше одного варианта) / Реперные даты (3 уровень)
			ВыборкаДюрация = ВыборкаСценарныйИндекс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			СтрокиДюрации = НоваяСтрокаСценарныхИндексов.ПолучитьЭлементы();
			Пока ВыборкаДюрация.Следующий() Цикл
				// Без разбиения по дюрации
				Если ВыборкаДюрация.Количество() = 1 Тогда
					РодительскаяСтрокаРеперныхДат = НоваяСтрокаСценарныхИндексов;
				// С разбиением по дюрации
				Иначе
					НоваяСтрокаДюрации = СтрокиДюрации.Добавить();
					НоваяСтрокаДюрации.Дюрация = ВыборкаДюрация.Дюрация;
					РодительскаяСтрокаРеперныхДат = НоваяСтрокаДюрации;
				КонецЕсли;
				// Строки реперных дат (3 или 4 уровень)
				Выборка = ВыборкаДюрация.Выбрать();
				СтрокиРеперныхДат = РодительскаяСтрокаРеперныхДат.ПолучитьЭлементы();
				Пока Выборка.Следующий() Цикл
					НоваяСтрокаРепернаяДата = СтрокиРеперныхДат.Добавить();
					НоваяСтрокаРепернаяДата.РепернаяДата = Выборка.РепернаяДата;
					НоваяСтрокаРепернаяДата.ПриращениеДоходности = Выборка.ПриращениеДоходности;
					НоваяСтрокаРепернаяДата.Формула = Выборка.Формула;
					НоваяСтрокаРепернаяДата.Выбрано = Выборка.Выбрано;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстОшибки(ПараметрыСессии, ТекстОшибки)

	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыСессии.ТекстОшибки) Тогда
		ПараметрыСессии.ТекстОшибки = ПараметрыСессии.ТекстОшибки + Символы.ПС + ТекстОшибки;
	Иначе
		ПараметрыСессии.ТекстОшибки = ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбъектОбработки);
	
	Механизм = ОбъектОбработки.Метаданные().ПолноеИмя() + ":" + ИмяКоманды;
	Сессия   = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);
	
	ПараметрыСессии = Новый Структура;
	ПараметрыСессии.Вставить("Механизм",     Механизм);
	ПараметрыСессии.Вставить("Сессия",        Сессия);
	ПараметрыСессии.Вставить("ДопПараметры",  Неопределено);
	ПараметрыСессии.Вставить("ТекстОшибки",   Неопределено);
	
	Возврат ПараметрыСессии;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм,
		ПараметрыСессии.Сессия,,
		ПараметрыСессии.ДопПараметры,
		ПараметрыСессии.ТекстОшибки);
	
КонецПроцедуры

#КонецОбласти
