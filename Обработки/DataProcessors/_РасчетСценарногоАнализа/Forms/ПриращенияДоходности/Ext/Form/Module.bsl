#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаГрупповаяУстановка(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаГрупповаяУстановка");
	Попытка
		ВыполнитьКомандаГрупповаяУстановка();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКомандаГрупповаяУстановка()
	// Конвертация дерева в массив:
	//	Массив(Структура(
	//		"Сценарий", "ГибридноеНаименованиеСценария", "СценарныйИндекс", "ГибридноеНаименованиеСценарногоИндекса",
	//		"Дюрация", "РепернаяДата", "ПриращениеДоходности", "Формула", "Выбрано"))
	ДеревоПриращенийДоходностиМассивом = Новый Массив;
	Для Каждого СтрокаДерева1Уровня Из ДеревоПриращенийДоходности.ПолучитьЭлементы() Цикл
		СтрокиДерева2Уровня = СтрокаДерева1Уровня.ПолучитьЭлементы();
		Для Каждого СтрокаДерева2Уровня Из СтрокиДерева2Уровня Цикл
			СтрокиДерева3Уровня = СтрокаДерева2Уровня.ПолучитьЭлементы();
			Для Каждого СтрокаДерева3Уровня Из СтрокиДерева3Уровня Цикл
				СтрокиДерева4Уровня = СтрокаДерева3Уровня.ПолучитьЭлементы();
				Если СтрокиДерева4Уровня.Количество() = 0 Тогда
					СтруктураПриращенийДоходности = Новый Структура(
						"Сценарий, ГибридноеНаименованиеСценария, СценарныйИндекс, ГибридноеНаименованиеСценарногоИндекса,
						|Дюрация, РепернаяДата, ПриращениеДоходности, Формула, Выбрано",
						СтрокаДерева1Уровня.Сценарий, СтрокаДерева1Уровня.ГибридноеНаименованиеСценария,
						СтрокаДерева2Уровня.СценарныйИндекс, СтрокаДерева2Уровня.ГибридноеНаименованиеСценарногоИндекса,
						СтрокаДерева3Уровня.Дюрация, СтрокаДерева3Уровня.РепернаяДата,
						СтрокаДерева3Уровня.ПриращениеДоходности, СтрокаДерева3Уровня.Формула, СтрокаДерева3Уровня.Выбрано);
					ДеревоПриращенийДоходностиМассивом.Добавить(СтруктураПриращенийДоходности);
				Иначе
					Для Каждого СтрокаДерева4Уровня Из СтрокиДерева4Уровня Цикл
						СтруктураПриращенийДоходности = Новый Структура(
							"Сценарий, ГибридноеНаименованиеСценария, СценарныйИндекс, ГибридноеНаименованиеСценарногоИндекса,
							|Дюрация, РепернаяДата, ПриращениеДоходности, Формула, Выбрано",
							СтрокаДерева1Уровня.Сценарий, СтрокаДерева1Уровня.ГибридноеНаименованиеСценария,
							СтрокаДерева2Уровня.СценарныйИндекс, СтрокаДерева2Уровня.ГибридноеНаименованиеСценарногоИндекса,
							СтрокаДерева3Уровня.Дюрация, СтрокаДерева4Уровня.РепернаяДата,
							СтрокаДерева4Уровня.ПриращениеДоходности, СтрокаДерева4Уровня.Формула, СтрокаДерева4Уровня.Выбрано);
						ДеревоПриращенийДоходностиМассивом.Добавить(СтруктураПриращенийДоходности);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	// Открытие формы
	ОписаниеОповещенияОЗакрытииДочернейФормы = Новый ОписаниеОповещения("ГрупповаяУстановкаПриращенийДоходностиПриЗакрытии", ЭтаФорма);
	ПараметрыФормы = Новый Структура("ПриращенияДоходности", ДеревоПриращенийДоходностиМассивом);
	ОткрытьФорму("ВнешняяОбработка._РасчетСценарногоАнализа.Форма.ГрупповаяУстановкаПриращенийДоходности",
		ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещенияОЗакрытииДочернейФормы);
КонецПроцедуры

&НаКлиенте
Процедура КомандаУстановитьФормулу(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаУстановитьФормулу");
	Попытка
		ВыполнитьКомандаУстановитьФормулу();
	Исключение
		ДобавитьТекстОшибки(ПараметрыСессии, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
