&НаСервере
Функция СфомироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов) Экспорт
	
	СтоимостьСобственныхСредствИзБухгалтерии = РаботаСВнешнимиСистемами.ПолучитьСтоимостьСобственныхСредствИзБухгалтерии(Организация, КонецДня(Период));	
	СтоимостьСобственныхСредствИзБухгалтерии = ?(ЗначениеЗаполнено(СтоимостьСобственныхСредствИзБухгалтерии), СтоимостьСобственныхСредствИзБухгалтерии, 0);
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	Запрос.УстановитьПараметр("Период", 					  				Период);
	Запрос.УстановитьПараметр("Организация", 				  				Организация);   	
	Запрос.УстановитьПараметр("ДатаОкончания", 								КонецДня(Период));
	Запрос.УстановитьПараметр("ГраницаОкончания", 							Новый Граница(КонецДня(Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПоследнийРабочийДень", 						Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, Период));
	Запрос.УстановитьПараметр("СтоимостьСобственныхСредствИзБухгалтерии", 	СтоимостьСобственныхСредствИзБухгалтерии);	
	Запрос.УстановитьПараметр("Организация",								Организация);
	Запрос.УстановитьПараметр("ИсключаемыеГоловныеОрганизации",			 	Новый Массив);
	Запрос.УстановитьПараметр("Коэффициент",								1000);
	
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
			|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
			|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
			|	СчетаДоверительногоУправления.Организация КАК Организация,
			|	СчетаДоверительногоУправления.Организация.ЮрФизЛицо КАК ЮрФизЛицо
			|ПОМЕСТИТЬ _Клиенты
			|ИЗ
			|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
			|ГДЕ
			|	НЕ СчетаДоверительногоУправления.ПометкаУдаления
			|	И СчетаДоверительногоУправления.Организация = &Организация
			|	И СчетаДоверительногоУправления.ДатаЗаключения <= &ДатаОкончания
			|	И (СчетаДоверительногоУправления.ДатаРасторжения >= &ДатаОкончания
			|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))";	 	
		
	Запрос.Выполнить();

	Запрос.Текст = РаботаСОтчетностьюЦБ.ПолучитьТекстЗапроса_СООУРКИ028(Период);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ТекстОтчета = Новый ТекстовыйДокумент;

		Кавычки = """";
		ВремяXML = " 00:00:00";
		
		ТекстОтчета.ДобавитьСтроку("<?xml version=" + Кавычки + "1.0" + Кавычки + " encoding=" + Кавычки + "windows-1251" + Кавычки + " standalone=""yes""?>");
  		ТекстОтчета.ДобавитьСтроку("<EDO_ODKF922>");
  		ТекстОтчета.ДобавитьСтроку("<report_on_date>" + Формат(Период, "ДФ=dd.MM.yyyy") + ВремяXML + "</report_on_date>");
        ТекстОтчета.ДобавитьСтроку("<Quartal>" + СокрЛП(Месяц(Период) / 3) + "</Quartal>");
  		ТекстОтчета.ДобавитьСтроку("<Year>" + Формат(Период, "ДФ=yyyy") + "</Year>");
	  	ТекстОтчета.ДобавитьСтроку("<UKName>" + Выборка.УправляющаяКомпания + "</UKName>");
		ТекстОтчета.ДобавитьСтроку("<UKINN>" + Выборка.ИННУправляющейКомпании + "</UKINN>");
		ТекстОтчета.ДобавитьСтроку("<OwnSum>" + Формат(Выборка.ВеличинаСобственныхСредств, "ЧРД=.; ЧГ=0") + "</OwnSum>");
		ТекстОтчета.ДобавитьСтроку("<QtyFunds>" + Формат(Выборка.КоличествоПИФАИФ, "ЧГ=0") + "</QtyFunds>");
		ТекстОтчета.ДобавитьСтроку("<QtyContractReserv>" + Формат(Выборка.КоличествоДоговоровДУ1, "ЧГ=0") + "</QtyContractReserv>");
		ТекстОтчета.ДобавитьСтроку("<QtyContractSavings>" + Формат(Выборка.КоличествоДоговоровДУ2, "ЧГ=0") + "</QtyContractSavings>");
		ТекстОтчета.ДобавитьСтроку("<SCHA>" + Формат(Выборка.СтоимостьЧистыхАктивовИФ, "ЧРД=.; ЧГ=0") + "</SCHA>");
		ТекстОтчета.ДобавитьСтроку("<PensReserv>" + Формат(Выборка.СтоимостьЧистыхАктивовПоДоговорамСНПФ, "ЧРД=.; ЧГ=0") + "</PensReserv>");
		ТекстОтчета.ДобавитьСтроку("<PensSavings>" + Формат(Выборка.СтоимостьПенсионныхРезервовНПФ, "ЧРД=.; ЧГ=0") + "</PensSavings>");
		ТекстОтчета.ДобавитьСтроку("<PensSavingsPFR>" + Формат(Выборка.СтоимостьЧистыхАктивовПоДоговорамСПФР, "ЧРД=.; ЧГ=0") + "</PensSavingsPFR>");
		ТекстОтчета.ДобавитьСтроку("</EDO_ODKF922>");
						
		// сформируем файл данных
		ПолноеИмяФайла = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "F922_ПФР_" + Формат(Период, "ДФ=dd.MM.yyyy") + ".xml";
		
		Попытка
			ТекстОтчета.Записать(ПолноеИмяФайла, "windows-1251");		
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выгрузки формы 923 по счету ДУ " + СокрЛП(СчетДоверительногоУправления) + " " + ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
			
КонецФункции