					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
					
					Если Операция.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
						ВидОперации.Код          = "1322";
