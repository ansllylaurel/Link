
&НаСервереБезКонтекста
Функция СериализоватьЗначение(Значение)
	
	Если      ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=");
	Иначе
		Возврат СокрЛП(Значение);
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоОплатаПоВознаграждению(Оплата, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(ВЫРАЗИТЬ(ОплатаОснования.Основание КАК Документ.НачислениеЗадолженности).Вознаграждение, ЛОЖЬ) КАК Вознаграждение
		|ИЗ
		|	Документ.Оплата.Основания КАК ОплатаОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Оплата КАК Оплата
		|		ПО ОплатаОснования.Ссылка = Оплата.Ссылка
		|ГДЕ
		|	ОплатаОснования.Ссылка = &Ссылка
		|	И Оплата.Организация = &Организация";
		
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ссылка",      Оплата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если      Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Вознаграждение;
	ИначеЕсли Выборка.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить, является ли документ " + Оплата + " оплатой по вознаграждению", Оплата);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось однозначно определить, является ли документ " + Оплата + " оплатой по вознаграждению", Оплата);
	КонецЕсли;
		
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидОперации(ВидДоговораДоверительногоУправления, ВидДвиженияДенежныхСредств, Операция, БанковскийСчет, Организация, ЭтоСчетДепозита = Ложь)
	
	ВидОперации = Новый Структура("Код, Наименование", "", "");

	Если ТипЗнч(Операция) <> Тип("ДокументСсылка.КорректировкаРегистров") Тогда	
		
		Если ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПФР Тогда
			// не распределены:
			//  * 30 - Перевод денежных средств с р/с на покупку валюты
			//  * 33 - Получение денежных средств на р/с от продажи валюты
			
			Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств Тогда
				
				ВидОперации.Код          = "13";
				ВидОперации.Наименование = "Получение средств пенсионных накоплений от ПФР";
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВыводДенежныхСредств Тогда
				
				ВидОперации.Код          = "14";
				ВидОперации.Наименование = "Перевод средств пенсионных накоплений в ПФР";
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата Тогда
				
				Если Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПервойЧастиРЕПО
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВторойЧастиРЕПО Тогда
					
					Если Операция.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
						ВидОперации.Код          = "952";
						ВидОперации.Наименование = "Получение денежных средств от продажи ЦБ на р/с (внебирж)";
					КонецЕсли;
									
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюОблигации
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации Тогда
					
					ВидОперации.Код          = "58";
					ВидОперации.Наименование = "Получение денежных средств от погашения/частичного погашения  ЦБ на р/с";
					
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовАкции 
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовПаи
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоНачислениюДивидендовДепозитарныеРасписки Тогда
					
					ВидОперации.Код          = "22";
					ВидОперации.Наименование = "Получение дивидендов по ЦБ на р/с";
					
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего 
					ИЛИ Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда
					
					ВидОперации.Код          = "34";
					ВидОперации.Наименование = "Оплата вознаграждения УК";
					
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоБанковскойКомиссии
					ИЛИ Операция.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.БанковскаяКомиссия) Тогда
					
					ВидОперации.Код          = "90";
					ВидОперации.Наименование = "Оплата комиссии банка";
					
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоДепозитарнойКомиссии
					ИЛИ Операция.ВидЗадолженности.ПринадлежитЭлементу(Справочники.ВидыЗадолженности.ДепозитарнаяКомиссия) Тогда
					
