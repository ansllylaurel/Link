					ВидОперации.Наименование = "Перевод денежных средств с р/с";
				ИначеЕсли Операция.РасчетныйСчетПолучатель = БанковскийСчет Тогда
					ВидОперации.Код          = "1800";
					ВидОперации.Наименование = "Получение денежных средств на р/с";
				КонецЕсли;
				
			КонецЕсли;	
			
			
		ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеАктивамиПаевогоИнвестиционногоФонда Тогда
			
			Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовМНО Тогда
				
				ВидОперации.Код          = "2117";
				ВидОперации.Наименование = "Получение процентов по остатку на р/с";
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.Оплата Тогда
				
				Если Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВознаграждениюУправляющего
					ИЛИ Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.НеобходимыеРасходыУправляющего Тогда
					
					ВидОперации.Код          = "1129";
					ВидОперации.Наименование = "Оплата вознаграждения УК (без возмещения НДС)";
					
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.РасходыПоВознаграждениюСпецдепозитария Тогда
					
					ВидОперации.Код          = "1130";
					ВидОперации.Наименование = "Оплата вознаграждений (без возмещения НДС)";
					
				ИначеЕсли Операция.ВидДвижения = Перечисления.ВидыДвижений.Расход Тогда
					
					ВидОперации.Код          = "1027";
					ВидОперации.Наименование = "Оплата прочим контрагентам";	
					
				КонецЕсли;	
					
			КонецЕсли;	
				
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидОперации.Код) Тогда
		Сообщить("Не удалось определить код и наименование операции из документа " + Операция);
	КонецЕсли;
	
	Возврат ВидОперации;
	
КонецФункции

&НаСервереБезКонтекста
Функция СфомироватьДокументыСЭД(Организация, СчетДоверительногоУправления, Период, КаталогФайлов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеестрПлатежей.Организация КАК Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет КАК РасчетныйСчет,
		|	МАКСИМУМ(РеестрПлатежей.СтрокаБанковскойВыписки.Дата) КАК Дата
		|ПОМЕСТИТЬ _ДатыПредыдущихСтрокВыписки
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК ДокументСтрокаБанковскойВыписки
		|		ПО РеестрПлатежей.СтрокаБанковскойВыписки = ДокументСтрокаБанковскойВыписки.Ссылка
		|ГДЕ
		|	РеестрПлатежей.ДатаПлатежа < &Период
		|	И РеестрПлатежей.Организация = &Организация
		|	И РеестрПлатежей.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|
		|СГРУППИРОВАТЬ ПО
		|	РеестрПлатежей.Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеестрПлатежей.Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчетКонтрагента,
		|	МАКСИМУМ(РеестрПлатежей.СтрокаБанковскойВыписки.Дата)
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК ДокументСтрокаБанковскойВыписки
		|		ПО РеестрПлатежей.СтрокаБанковскойВыписки = ДокументСтрокаБанковскойВыписки.Ссылка
		|ГДЕ
		|	РеестрПлатежей.ДатаПлатежа < &Период
		|	И РеестрПлатежей.Организация = &Организация
		|	И РеестрПлатежей.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И ТИПЗНАЧЕНИЯ(РеестрПлатежей.ДвижениеДенежныхСредств) В (ТИП(Документ.РазмещениеКредитногоИнструмента), ТИП(Документ.ЗакрытиеКредитногоИнструмента))
		|
		|СГРУППИРОВАТЬ ПО
		|	РеестрПлатежей.Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчетКонтрагента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.Организация КАК Организация,
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет КАК РасчетныйСчет,
		|	ЕСТЬNULL(ОстаткиДенежныхСредствОстатки.СуммаОстаток, 0) КАК СуммаОстаток
		|ПОМЕСТИТЬ _ОстаткиДенежныхСредств
		|ИЗ
		|	РегистрСведений.ИсполнителиПоДенежнымСредствамСобственные КАК ИсполнителиПоДенежнымСредствамСобственные
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления
		|					И НЕ РасчетныйСчет = ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка)) КАК ОстаткиДенежныхСредствОстатки
		|		ПО ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления
		|			И ИсполнителиПоДенежнымСредствамСобственные.РасчетныйСчет = ОстаткиДенежныхСредствОстатки.РасчетныйСчет
		|ГДЕ
		|	ИсполнителиПоДенежнымСредствамСобственные.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И (ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия >= &Период
		|			ИЛИ ИсполнителиПоДенежнымСредствамСобственные.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстатки.Организация, ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец.Организация),
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления, ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец.СчетДоверительногоУправления),
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент.БанковскийСчет, ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец.КредитныйИнструмент.БанковскийСчет),
		|	ЕСТЬNULL(ДенежныеСредстваВКредитныхИнструментахОстатки.СуммаОстаток, 0)
		|ИЗ
		|	РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДенежныеСредстваВКредитныхИнструментахОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеСредстваВКредитныхИнструментах.Остатки(
		|				&КонецПериодаГраница,
		|				Организация = &Организация
		|					И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец
		|		ПО ДенежныеСредстваВКредитныхИнструментахОстатки.Организация = ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец.Организация
		|			И ДенежныеСредстваВКредитныхИнструментахОстатки.СчетДоверительногоУправления = ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец.СчетДоверительногоУправления
		|			И ДенежныеСредстваВКредитныхИнструментахОстатки.КредитныйИнструмент.БанковскийСчет = ДенежныеСредстваВКредитныхИнструментахОстаткиНаКонец.КредитныйИнструмент.БанковскийСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ОстаткиДенежныхСредств.Организация КАК Организация,
		|	_ОстаткиДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ОстаткиДенежныхСредств.РасчетныйСчет КАК РасчетныйСчет
		|ПОМЕСТИТЬ _РасчетныеСчета
		|ИЗ
		|	_ОстаткиДенежныхСредств КАК _ОстаткиДенежныхСредств
		|ГДЕ
		|	&Период >= ДАТАВРЕМЯ(2019, 4, 24)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РеестрПлатежей.Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК ДокументСтрокаБанковскойВыписки
		|		ПО РеестрПлатежей.СтрокаБанковскойВыписки = ДокументСтрокаБанковскойВыписки.Ссылка
		|ГДЕ
		|	РеестрПлатежей.Организация = &Организация
		|	И РеестрПлатежей.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РеестрПлатежей.ДатаПлатежа МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РеестрПлатежей.Организация КАК Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет КАК РасчетныйСчет,
		|	ДокументСтрокаБанковскойВыписки.Дата КАК SummInfo_DateOper,
		|	ДокументСтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК SummInfo_BankDocNumber,
		|	ДокументСтрокаБанковскойВыписки.НомерПлатежногоДокумента КАК SummInfo_ClientDocNumber,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Банк.Код КАК SummInfo_BIKBank,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.Банк.КоррСчет КАК SummInfo_BankAccount,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчетКонтрагента.НомерСчета КАК SummInfo_PayerAccount,
		|	ВЫБОР
		|		КОГДА РеестрПлатежей.СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА РеестрПлатежей.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК SummInfo_Debet,
		|	ВЫБОР
		|		КОГДА РеестрПлатежей.СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА РеестрПлатежей.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК SummInfo_Credit,
		|	РеестрПлатежей.СтрокаБанковскойВыписки КАК _СтрокаБанковскойВыписки,
		|	ДокументСтрокаБанковскойВыписки.НазначениеПлатежа КАК SummInfo_PayAssign,
		|	РеестрПлатежей.ВидДвиженияДенежныхСредств КАК _ВидДвиженияДенежныхСредств,
		|	РеестрПлатежей.ДвижениеДенежныхСредств КАК _ДвижениеДенежныхСредств,
		|	ВЫРАЗИТЬ(РеестрПлатежей.ДвижениеДенежныхСредств КАК Документ.Оплата).ВидЗадолженности КАК _ВидЗадолженностиОплаты,
		|	РеестрПлатежей.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК _ВидДоговораДоверительногоУправления
		|ПОМЕСТИТЬ _РеестрПлатежей
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК ДокументСтрокаБанковскойВыписки
		|		ПО РеестрПлатежей.СтрокаБанковскойВыписки = ДокументСтрокаБанковскойВыписки.Ссылка
		|ГДЕ
		|	РеестрПлатежей.Организация = &Организация
