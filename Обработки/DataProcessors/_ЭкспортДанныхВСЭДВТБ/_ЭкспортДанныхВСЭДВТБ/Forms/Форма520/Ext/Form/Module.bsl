						ВидОперации.Наименование = "Оплата вознаграждения СД";
						
					Иначе
						ВидОперации.Код          = "100";
						ВидОперации.Наименование = "Оплата расходов, перевыставленных СД";
					КонецЕсли;
					
				ИначеЕсли Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоВозмещениюСтраховыхПремий Тогда	
					
					ВидОперации.Код          = "83";
					ВидОперации.Наименование = "Оплата услуг страховщика";
					
				КонецЕсли;
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона Тогда
				
				Если Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПогашениюКупона
					Или Операция.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона Тогда
					
					ВидОперации.Код          = "103";
					ВидОперации.Наименование = "Получение купонного дохода по ЦБ на р/с";
					
				КонецЕсли;

			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПереводДенежныхСредств Тогда
				
				Если Операция.РасчетныйСчет = БанковскийСчет И ЗначениеЗаполнено(Операция.БрокерПолучатель) Тогда
					ВидОперации.Код          = "17";
					ВидОперации.Наименование = "Перевод  денежных средств с р/с на брокерский счет";
				ИначеЕсли Операция.РасчетныйСчетПолучатель = БанковскийСчет И ЗначениеЗаполнено(Операция.Брокер) Тогда
					ВидОперации.Код          = "18";
					ВидОперации.Наименование = "Получение денежных средств на р/с с брокерского счета";
				Иначе
					ВидОперации.Код          = "41";
					ВидОперации.Наименование = "Перевод денежных средств с р/с ДУ на другой р\с счет ДУ";
				КонецЕсли;
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовМНО Тогда
				
				ВидОперации.Код          = "99";
				ВидОперации.Наименование = "Получение процентов по остатку на р/счете";
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ПриходПроцентовПоДепозитномуВкладу Тогда
				
				ВидОперации.Код          = "21";
				ВидОперации.Наименование = "Получение процентов по депозиту на р/с";
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.РазмещениеДенежныхСредствНаДепозитномВкладе Тогда
				
				ВидОперации.Код          = ?(ЭтоСчетДепозита, "25", "19");
				ВидОперации.Наименование = "Перевод денежных средств с р/с на депозитный счет";
				
			ИначеЕсли ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ЗакрытиеДепозитногоВклада Тогда
				
				ВидОперации.Код          = ?(ЭтоСчетДепозита, "24", "20");
				ВидОперации.Наименование = "Получение денежных средств на р/с с депозитного счета";
				
			КонецЕсли;
			
		ИначеЕсли ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями Тогда
			// Осталось обработать:
			//   - покупку/продажу валюты (484, 485)
			
			Если ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ВводДенежныхСредств Тогда
				
				ВидОперации.Код          = "468";
