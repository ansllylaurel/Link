		|	И РеестрПлатежей.ДатаПлатежа МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеестрПлатежей.Организация,
		|	РеестрПлатежей.СчетДоверительногоУправления,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчетКонтрагента,
		|	ДокументСтрокаБанковскойВыписки.Дата,
		|	ДокументСтрокаБанковскойВыписки.НомерПлатежногоДокумента,
		|	ДокументСтрокаБанковскойВыписки.НомерПлатежногоДокумента,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет.Банк.Код,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет.Банк.КоррСчет,
		|	ДокументСтрокаБанковскойВыписки.РасчетныйСчет.НомерСчета,
		|	ВЫБОР
		|		КОГДА РеестрПлатежей.СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Расход)
		|			ТОГДА РеестрПлатежей.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА РеестрПлатежей.СтрокаБанковскойВыписки.ВидДвижения = ЗНАЧЕНИЕ(Перечисление.ВидыДвижений.Приход)
		|			ТОГДА РеестрПлатежей.Сумма
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	РеестрПлатежей.СтрокаБанковскойВыписки,
		|	ДокументСтрокаБанковскойВыписки.НазначениеПлатежа,
		|	РеестрПлатежей.ВидДвиженияДенежныхСредств,
		|	РеестрПлатежей.ДвижениеДенежныхСредств,
		|	NULL,
		|	РеестрПлатежей.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления
		|ИЗ
		|	РегистрСведений.РеестрПлатежей КАК РеестрПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СтрокаБанковскойВыписки КАК ДокументСтрокаБанковскойВыписки
		|		ПО РеестрПлатежей.СтрокаБанковскойВыписки = ДокументСтрокаБанковскойВыписки.Ссылка
		|ГДЕ
		|	РеестрПлатежей.Организация = &Организация
		|	И РеестрПлатежей.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РеестрПлатежей.ДатаПлатежа МЕЖДУ НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) И КОНЕЦПЕРИОДА(&Период, ДЕНЬ)
		|	И ТИПЗНАЧЕНИЯ(РеестрПлатежей.ДвижениеДенежныхСредств) В (ТИП(Документ.РазмещениеКредитногоИнструмента), ТИП(Документ.ЗакрытиеКредитногоИнструмента))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_РасчетныеСчета.РасчетныйСчет.Договор.НаименованиеВладельцаДляДокументов КАК Name,
		|	РеквизитыЮрЛицаОрганизацииСрезПоследних.ИНН КАК UKINN,
		|	0 КАК KODFiliala,
		|	&Период КАК TheDate,
		|	_РасчетныеСчета.РасчетныйСчет.НомерСчета КАК Account,
		|	_РасчетныеСчета.РасчетныйСчет.Банк.Код КАК BIK,
		|	РеквизитыЮрЛицаБанкаСрезПоследних.ПолноеНаименованиеПоУставу КАК LendingAgencyName,
		|	РеквизитыЮрЛицаБанкаСрезПоследних.ИНН КАК INN,
		|	ВЫБОР
		|		КОГДА НЕ ДепозитныеВклады.Ссылка ЕСТЬ NULL
		|			ТОГДА 2
		|		ИНАЧЕ ВЫБОР
		|				КОГДА _РасчетныеСчета.РасчетныйСчет.Валюта = _РасчетныеСчета.Организация.ВалютаУчета
		|					ТОГДА 1
		|				ИНАЧЕ 3
		|			КОНЕЦ
		|	КОНЕЦ КАК AccountType,
		|	_ДатыПредыдущихСтрокВыписки.Дата КАК LastDate,
		|	_ОстаткиДенежныхСредств.СуммаОстаток КАК Incomingremains,
		|	_РеестрПлатежей.SummInfo_DateOper КАК SummInfo_DateOper,
		|	_РеестрПлатежей.SummInfo_BankDocNumber КАК SummInfo_BankDocNumber,
		|	_РеестрПлатежей.SummInfo_ClientDocNumber КАК SummInfo_ClientDocNumber,
		|	_РеестрПлатежей.SummInfo_BIKBank КАК SummInfo_BIKBank,
		|	_РеестрПлатежей.SummInfo_BankAccount КАК SummInfo_BankAccount,
		|	_РеестрПлатежей.SummInfo_PayerAccount КАК SummInfo_PayerAccount,
		|	_РеестрПлатежей.SummInfo_Debet КАК SummInfo_Debet,
		|	_РеестрПлатежей.SummInfo_Credit КАК SummInfo_Credit,
		|	_РеестрПлатежей._СтрокаБанковскойВыписки КАК _СтрокаБанковскойВыписки,
		|	_РеестрПлатежей.SummInfo_PayAssign КАК SummInfo_PayAssign,
		|	_РеестрПлатежей.РасчетныйСчет КАК _РасчетныйСчет,
		|	_РеестрПлатежей._ВидДвиженияДенежныхСредств КАК _ВидДвиженияДенежныхСредств,
		|	_РеестрПлатежей._ДвижениеДенежныхСредств КАК _ДвижениеДенежныхСредств,
		|	_РеестрПлатежей._ВидЗадолженностиОплаты КАК _ВидЗадолженностиОплаты,
		|	_РеестрПлатежей._ВидДоговораДоверительногоУправления КАК _ВидДоговораДоверительногоУправления,
		|	_РеестрПлатежей.Организация ЕСТЬ NULL КАК _ПлатежиОтсутствуют
		|ИЗ
		|	_РасчетныеСчета КАК _РасчетныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _РеестрПлатежей КАК _РеестрПлатежей
		|		ПО _РасчетныеСчета.Организация = _РеестрПлатежей.Организация
		|			И _РасчетныеСчета.СчетДоверительногоУправления = _РеестрПлатежей.СчетДоверительногоУправления
		|			И _РасчетныеСчета.РасчетныйСчет = _РеестрПлатежей.РасчетныйСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОстаткиДенежныхСредств КАК _ОстаткиДенежныхСредств
		|		ПО (_ОстаткиДенежныхСредств.Организация = _РасчетныеСчета.Организация)
		|			И (_ОстаткиДенежныхСредств.СчетДоверительногоУправления = _РасчетныеСчета.СчетДоверительногоУправления)
		|			И (_ОстаткиДенежныхСредств.РасчетныйСчет = _РасчетныеСчета.РасчетныйСчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДепозитныеВклады КАК ДепозитныеВклады
		|		ПО _РасчетныеСчета.РасчетныйСчет = ДепозитныеВклады.БанковскийСчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮрЛицаОрганизацииСрезПоследних
		|		ПО _РасчетныеСчета.Организация.ЮрФизЛицо = РеквизитыЮрЛицаОрганизацииСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮрЛицаБанкаСрезПоследних
		|		ПО _РасчетныеСчета.РасчетныйСчет.Банк.ЮрФизЛицо = РеквизитыЮрЛицаБанкаСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыПредыдущихСтрокВыписки КАК _ДатыПредыдущихСтрокВыписки
		|		ПО (_ДатыПредыдущихСтрокВыписки.Организация = _РасчетныеСчета.Организация)
		|			И (_ДатыПредыдущихСтрокВыписки.СчетДоверительногоУправления = _РасчетныеСчета.СчетДоверительногоУправления)
		|			И (_ДатыПредыдущихСтрокВыписки.РасчетныйСчет = _РасчетныеСчета.РасчетныйСчет)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА НЕ ДепозитныеВклады.Ссылка ЕСТЬ NULL
		|				ТОГДА НЕ _РеестрПлатежей.Организация ЕСТЬ NULL
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Account";
		
	Запрос.УстановитьПараметр("Организация",                  	Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления",	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Период",							Период);	
	Запрос.УстановитьПараметр("КонецПериодаГраница",			Новый Граница(КонецДня(Период), ВидГраницы.Включая));
	
	СтрокиВыписки = Запрос.Выполнить().Выгрузить();
	
	// определим варианты счетов по клиентам
	РасчетныеСчета = СтрокиВыписки.Скопировать(, "Account");
	РасчетныеСчета.Свернуть("Account");
	 
	Для каждого СтрокаРасчетныеСчета Из РасчетныеСчета Цикл
		
		ПолноеИмяФайла = КаталогФайлов + ?(Прав(КаталогФайлов, 1) = "\", "", "\") + "520\" +СтрЗаменить(СокрЛП(СчетДоверительногоУправления), """", "") + ", " + СокрЛП(СтрокаРасчетныеСчета.Account) + " выписка " + Формат(Период, "ДФ=dd.MM.yyyy") + ".xml";
	
		СтрокиВыпискиПоРСчету = СтрокиВыписки.Скопировать(Новый Структура("Account", СтрокаРасчетныеСчета.Account));
		
		// сформируем файл данных
		ЗаписьXML = Новый ЗаписьXML;
		
		Попытка 
			ЗаписьXML.ОткрытьФайл(ПолноеИмяФайла, "WINDOWS-1251");
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки() + ". Выгрузка отменена по счету ДУ " + СокрЛП(СчетДоверительногоУправления));
			Прервать;
		КонецПопытки;
		
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьНачалоЭлемента("EDO_ODKF520");
		
		ЗаписаныОбщиеРеквизитыФормы = Ложь;
		// отобразим общие реквизиты формы
		Если Не ЗаписаныОбщиеРеквизитыФормы И СтрокиВыпискиПоРСчету.Количество() > 0 Тогда
			
			СтрокаВыпискиПоРСчету = СтрокиВыпискиПоРСчету[0];
			
			Для каждого Колонка Из СтрокиВыпискиПоРСчету.Колонки Цикл
				Если СтрНачинаетсяС(Колонка.Имя, "_") Или СтрНачинаетсяС(Колонка.Имя, "SummInfo_") Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаписьXML.ЗаписатьНачалоЭлемента(Колонка.Имя);
				ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(СтрокаВыпискиПоРСчету[Колонка.Имя]));
				ЗаписьXML.ЗаписатьКонецЭлемента();
				
			КонецЦикла;
			
			Если СтрокаВыпискиПоРСчету._ПлатежиОтсутствуют Тогда
				ЗаписьXML.ЗаписатьНачалоЭлемента("Ostatok");
				ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(СтрокаВыпискиПоРСчету.Incomingremains));
				ЗаписьXML.ЗаписатьКонецЭлемента();
			КонецЕсли; 
			
			ЗаписаныОбщиеРеквизитыФормы = Истина;
			
		КонецЕсли;

		
		// иногда одной платежкой закрывают и погашение купона и погашение облигации;
		// в этом случае оставляем только погашение облигации
		Для Инд = 1 - СтрокиВыпискиПоРСчету.Количество() По 0 Цикл
			СтрокаВыпискиПоРСчету = СтрокиВыпискиПоРСчету[-Инд];
			
			Если СтрокаВыпискиПоРСчету._ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона
				И СтрокаВыпискиПоРСчету._ВидЗадолженностиОплаты = Справочники.ВидыЗадолженности.ПоПогашениюКупона
			Тогда
				ПараметрыОтбора = Новый Структура();
				ПараметрыОтбора.Вставить("_СтрокаБанковскойВыписки", СтрокаВыпискиПоРСчету._СтрокаБанковскойВыписки);
				ПараметрыОтбора.Вставить("_ВидЗадолженностиОплаты",  Справочники.ВидыЗадолженности.ПоПогашениюОблигации);
			
				Если СтрокиВыпискиПоРСчету.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда
					СтрокиВыпискиПоРСчету.Удалить(СтрокаВыпискиПоРСчету);
				КонецЕсли;
			
			ИначеЕсли СтрокаВыпискиПоРСчету._ВидДвиженияДенежныхСредств = Перечисления.ВидыДвиженийДенежныхСредств.ОплатаКупона
				И СтрокаВыпискиПоРСчету._ВидЗадолженностиОплаты = Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюКупона
			Тогда
				ПараметрыОтбора = Новый Структура();
				ПараметрыОтбора.Вставить("_СтрокаБанковскойВыписки", СтрокаВыпискиПоРСчету._СтрокаБанковскойВыписки);
				ПараметрыОтбора.Вставить("_ВидЗадолженностиОплаты",  Справочники.ВидыЗадолженности.ПоПоследнемуПогашениюОблигации);
			
				Если СтрокиВыпискиПоРСчету.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда
					СтрокиВыпискиПоРСчету.Удалить(СтрокаВыпискиПоРСчету);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого СтрокаВыпискиПоРСчету Из СтрокиВыпискиПоРСчету Цикл
			
			Если СтрокаВыпискиПоРСчету._ПлатежиОтсутствуют Тогда
				Продолжить;
			КонецЕсли; 
			
			// подч. группа "SummInfo"
			ЗаписьXML.ЗаписатьНачалоЭлемента("SummInfo");
			
			Для каждого Колонка Из СтрокиВыпискиПоРСчету.Колонки Цикл
				Если Лев(Колонка.Имя, 9) = "SummInfo_" Тогда
					ЗаписьXML.ЗаписатьНачалоЭлемента(Сред(Колонка.Имя, 10));
					ЗаписьXML.ЗаписатьТекст(СериализоватьЗначение(СтрокаВыпискиПоРСчету[Колонка.Имя]));
					ЗаписьXML.ЗаписатьКонецЭлемента();
				КонецЕсли;
			КонецЦикла;
			
			ВидОперации = ПолучитьВидОперации(СтрокаВыпискиПоРСчету._ВидДоговораДоверительногоУправления, СтрокаВыпискиПоРСчету._ВидДвиженияДенежныхСредств, СтрокаВыпискиПоРСчету._ДвижениеДенежныхСредств, СтрокаВыпискиПоРСчету._РасчетныйСчет, Организация, СтрокаВыпискиПоРСчету.AccountType = 2);
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("IDDocOperType");
			ЗаписьXML.ЗаписатьТекст(ВидОперации.Код);
			ЗаписьXML.ЗаписатьКонецЭлемента();

			ЗаписьXML.ЗаписатьКонецЭлемента();// SummInfo
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();// EDO_ODKF520
		ЗаписьXML.Закрыть();
		
	КонецЦикла;
	
КонецФункции