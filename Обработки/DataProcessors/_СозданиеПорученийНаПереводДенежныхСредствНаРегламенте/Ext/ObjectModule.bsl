// ИНТЕРФЕЙС

// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Создание поручений на перевод данежных средств на регламенте", "0.03", "", Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СоздатьПоручения", "Создание поручений на перевод ДС",,  Ложь, "ВызовСерверногоМетода");
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Если Не ЭтоРабочийИлиТорговыйДень(НачалоДня(ТекущаяДатаСеанса())) Тогда
		Возврат;
	КонецЕсли;
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если Найти(ИдентификаторКоманды, "СоздатьПоручения") = 1 Тогда
		СоздатьПоручения();
	Иначе
		ЗарегистрироватьОшибку("Для команды [" + ИдентификаторКоманды + "] не определены действия.");
	КонецЕсли;
	
	ОповеститьОбОшибках(Неопределено);
	
КонецПроцедуры

Функция ЭтоРабочийИлиТорговыйДень(НачалоДня) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА ДанныеКалендаряКотировок.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ИЛИ ДанныеОбщероссийскогоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФлагРабочийДень
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаряКотировок,
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеОбщероссийскогоКалендаря
		|ГДЕ
		|	ДанныеКалендаряКотировок.Календарь = &КалендарьКотировок
		|	И ДанныеОбщероссийскогоКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|	И ДанныеКалендаряКотировок.Дата = &НачалоДня
		|	И ДанныеОбщероссийскогоКалендаря.Дата = &НачалоДня";
	
	Запрос.УстановитьПараметр("НачалоДня"         , НачалоДня);
	Запрос.УстановитьПараметр("КалендарьКотировок", ОбщегоНазначения.ПолучитьИменованныйОбъект("КалендарьКотировок"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат[0].ФлагРабочийДень;
	
КонецФункции

Процедура ОповеститьОбОшибках(ЕстьОшибки)Экспорт
	
	ЕстьОшибки = ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки");
	
	Если Не ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
		КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");	
	
КонецПроцедуры

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	// дополним текст ошибки сообщениями пользователю
	МассивСообщений = ПолучитьСообщенияПользователю(Истина);
	Если МассивСообщений.Количество() > 0 Тогда

		ТекстОшибки = ТекстОшибки + Символы.ПС + "Сообщения пользователю:";
		Для Каждого ТекСообщение Из МассивСообщений Цикл
			
			Если ТекСообщение.Текст = "" Тогда
				Продолжить;
			Иначе
				Текст = ТекСообщение.Текст + ". " + Строка(ТекСообщение.КлючДанных);
				ТекстОшибки = ТекстОшибки + Символы.ПС + Текст; 
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		ТекстОшибки = ТекстОшибки;                                  
	КонецЕсли;
	
    Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда    	
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьПоручения() Экспорт
	
	Механизм = "_СозданиеПорученийНаПереводДенежныхСредствНаРегламенте.СоздатьПоручения()";
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(Механизм);
	
	//Брокер может исполнить поручение на следующий день,
	//поэтому исключаем создание повторного поручения если в предыдущем дне есть неисполненные поручения.
	
	АктивныйСтатус = Новый Массив;
	АктивныйСтатус.Добавить(Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Активно);
	АктивныйСтатус.Добавить(Перечисления.СтатусыПорученийНаПереводДенежныхСредств.Исполнено);
	
	ТекДата = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ _КлиентыИИС
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления = &ВидДоговораДУ
		|	И СчетаДоверительногоУправления.ДатаРасторжения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И СчетаДоверительногоУправления.ДатаРасторжения >= &НачалоДняТекущаяДата
		|	И СчетаДоверительногоУправления.Организация = &ОрганизацияРЭМ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДокПоручениеНаПереводДенежныхСредств.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	СУММА(ДокПоручениеНаПереводДенежныхСредств.Сумма) КАК Сумма,
		|	ДокПоручениеНаПереводДенежныхСредств.Валюта КАК Валюта
		|ПОМЕСТИТЬ _Поручения
		|ИЗ
		|	Документ.ПоручениеНаПереводДенежныхСредств КАК ДокПоручениеНаПереводДенежныхСредств
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _КлиентыИИС КАК _КлиентыИИС
		|		ПО (_КлиентыИИС.Ссылка = ДокПоручениеНаПереводДенежныхСредств.СчетДоверительногоУправления)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПереводДенежныхСредств КАК ПереводДенежныхСредств
		|		ПО (ПереводДенежныхСредств.Основание = ДокПоручениеНаПереводДенежныхСредств.Ссылка)
		|			И (ПереводДенежныхСредств.Проведен = ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПорученийНаПереводДенежныхСредств.СрезПоследних(, ) КАК СтатусыПорученийНаПереводДС
		|		ПО ДокПоручениеНаПереводДенежныхСредств.Ссылка = СтатусыПорученийНаПереводДС.ПоручениеНаПереводДенежныхСредств
		|ГДЕ
		|	(ДокПоручениеНаПереводДенежныхСредств.Дата >= &НачалоДняТекущаяДата
		|			ИЛИ НАЧАЛОПЕРИОДА(ДокПоручениеНаПереводДенежныхСредств.Дата, ДЕНЬ) = &НачалоДняПрошлыйДень
		|				И СтатусыПорученийНаПереводДС.Статус В (&АктивныйСтатус))
		|	И ДокПоручениеНаПереводДенежныхСредств.Организация = &ОрганизацияРЭМ
		|	И ДокПоручениеНаПереводДенежныхСредств.Брокер = &БрокерБК
		|	И ДокПоручениеНаПереводДенежныхСредств.МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И НЕ ДокПоручениеНаПереводДенежныхСредств.ПометкаУдаления
		|	И ПереводДенежныхСредств.Ссылка ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокПоручениеНаПереводДенежныхСредств.СчетДоверительногоУправления,
		|	ДокПоручениеНаПереводДенежныхСредств.Валюта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиДенежныхСредствОстатки.Организация КАК Организация,
		|	ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ОстаткиДенежныхСредствОстатки.Брокер КАК Брокер,
		|	ОстаткиДенежныхСредствОстатки.МестоХранения КАК МестоХранения,
		|	ОстаткиДенежныхСредствОстатки.Валюта КАК Валюта,
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток - ЕСТЬNULL(_Поручения.Сумма, 0) КАК Сумма
		|ПОМЕСТИТЬ _Остатки
		|ИЗ
		|	РегистрНакопления.ОстаткиДенежныхСредств.Остатки(
		|			&ТекущаяДата,
		|			Организация = &ОрганизацияРЭМ
		|				И Брокер = &БрокерБК
		|				И МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|				И СчетДоверительногоУправления В
		|					(ВЫБРАТЬ
		|						_КлиентыИИС.Ссылка
		|					ИЗ
		|						_КлиентыИИС)) КАК ОстаткиДенежныхСредствОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Поручения КАК _Поручения
		|		ПО ОстаткиДенежныхСредствОстатки.СчетДоверительногоУправления = _Поручения.СчетДоверительногоУправления
		|			И ОстаткиДенежныхСредствОстатки.Валюта = _Поручения.Валюта
		|ГДЕ
		|	ОстаткиДенежныхСредствОстатки.СуммаОстаток - ЕСТЬNULL(_Поручения.Сумма, 0) > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ТекущаяДата КАК Дата,
		|	_Остатки.Организация КАК Организация,
		|	_Остатки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_Остатки.Брокер КАК Брокер,
		|	_Остатки.МестоХранения КАК МестоХранения,
		|	""Внебиржевые_Основной"" КАК МестоХраненияСтрокой,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчет,
		|	_Остатки.Брокер КАК БрокерПолучатель,
		|	&МестоХраненияПолучатель КАК МестоХраненияПолучатель,
		|	""Биржевые_ФондоваяТПлюс"" КАК МестоХраненияПолучательСтрокой,
		|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчета.ПустаяСсылка) КАК РасчетныйСчетПолучатель,
		|	_Остатки.Валюта КАК Валюта,
		|	_Остатки.Сумма КАК Сумма,
		|	ВЫБОР
		|		КОГДА _Остатки.Валюта = &ВалютаРубль
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ОшибкаВалюты,
		|	ЛОЖЬ КАК СрочныйПереводБЭСП
		|ИЗ
		|	_Остатки КАК _Остатки";
#КонецОбласти

	Запрос.УстановитьПараметр("АктивныйСтатус", АктивныйСтатус);
	Запрос.УстановитьПараметр("ОрганизацияРЭМ", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("БрокерБК", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_БК_Регион"));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекДата);
	Запрос.УстановитьПараметр("НачалоДняТекущаяДата", НачалоДня(ТекДата));
	Запрос.УстановитьПараметр("НачалоДняПрошлыйДень", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, НачалоДня(ТекДата), - 1));
	Запрос.УстановитьПараметр("ВидДоговораДУ", Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет);
	Запрос.УстановитьПараметр("МестоХраненияПолучатель", ОбщегоНазначения.ПолучитьИменованныйОбъект("ММВБ_Торговый+"));
	Запрос.УстановитьПараметр("ВалютаРубль", ОбщегоНазначения.ПолучитьИменованныйОбъект("Валюта_Российский_рубль"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПорученияПроведены = 0;
	ПорученияЗаписаны  = 0;
	
	ПараметрыСеанса.ФормированиеДвиженийПоРегистрамБэкОфиса = Истина;//без флага падает ошибка.
	
	Пока Выборка.Следующий() Цикл
				
		Если Выборка.ОшибкаВалюты Тогда
			ЗарегистрироватьОшибку("На остатках внебиржевого раздела брокера " + Выборка.Брокер + " по счету " + Выборка.СчетДоверительногоУправления + " сумма в валюте" + Выборка.Валюта + ".");
			Продолжить;
		КонецЕсли;
		
		ПоручениеНаПеревод = Документы.ПоручениеНаПереводДенежныхСредств.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(ПоручениеНаПеревод, Выборка);
		
		ПоручениеНаПеревод.Ответственный = РаботаСПользователями.ТекущийПользователь();
		ПоручениеНаПеревод.Комментарий   = "Создан аппаратно-техническими средствами " + ТекДата;
		
		Попытка
			ПоручениеНаПеревод.Записать(РежимЗаписиДокумента.Проведение);
			ПорученияПроведены = ПорученияПроведены + 1;
			Продолжить;
		Исключение
			ЗарегистрироватьОшибку("Не удалось провести Поручение на перевод денежных средств по счету " + Выборка.СчетДоверительногоУправления + ". Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
			
		Попытка
			ПоручениеНаПеревод.Записать();
			ПорученияЗаписаны = ПорученияЗаписаны + 1;
		Исключение
			ЗарегистрироватьОшибку("Не удалось записать Поручение на перевод денежных средств по счету " + Выборка.СчетДоверительногоУправления + ". Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
					
	КонецЦикла;
	
	ДопПараметрыСтатистики = Новый Структура("НовыеПоручения", " проведено (" + ПорученияПроведены + "), записано (" + ПорученияЗаписаны + ")");
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") И (ПорученияПроведены > 0 Или ПорученияЗаписаны > 0) Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("НовыеПоручения", ДопПараметрыСтатистики.НовыеПоручения);	
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия,, ДопПараметрыСтатистики);
	
КонецПроцедуры

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;