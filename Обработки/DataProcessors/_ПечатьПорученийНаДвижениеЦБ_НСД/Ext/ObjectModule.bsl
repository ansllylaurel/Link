		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоминалыЦенныхБумаг.СрезПоследних(&Период, ) КАК НоминалыЦенныхБумагСрезПоследних
		|		ПО ДокументЦенныеБумаги.ЦеннаяБумага = НоминалыЦенныхБумагСрезПоследних.ЦеннаяБумага
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыВТорговыхСистемах.СрезПоследних(&Период, ВидКода = ЗНАЧЕНИЕ(Перечисление.ВидыКодовВТорговыхСистемах.ISIN)) КАК КодыISIN
		|		ПО ДокументЦенныеБумаги.ЦеннаяБумага = КодыISIN.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДоговорыСЦентральнымДепозитарием.СрезПоследних(&Период, ) КАК ДоговорыСЦентральнымДепозитариемСрезПоследних
		|		ПО (&ДоговорСЦентральнымДепозитариемКонтрагента)
		|ГДЕ
		|	ДокументЦенныеБумаги.Ссылка В(&СписокДокументов)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументЦенныеБумаги.ЦеннаяБумага,
		|	ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет,
		|	ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.НомерСчета,
		|	ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Договор.НомерДоговора,
		|	ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Договор.ДатаЗаключения,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.РезидентРФ, ИСТИНА),
		|	ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Родитель.НомерСчета,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Паи)
		|			ТОГДА РеквизитыПИФСрезПоследних.КраткоеНаименованиеФонда
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Акции)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Акции).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Векселя)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Векселя).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ДепозитарныеРасписки)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.ДепозитарныеРасписки).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Доли)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Доли).ЮрЛицо.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.ИпотечныеСертификатыУчастия)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.ИпотечныеСертификатыУчастия).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Облигации)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Облигации).Эмитент.Наименование)
		|		КОГДА ТИПЗНАЧЕНИЯ(ДокументЦенныеБумаги.ЦеннаяБумага) = ТИП(Справочник.Закладные)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮридическихЛицСрезПоследних.КраткоеНаименованиеПоУставу, ВЫРАЗИТЬ(ДокументЦенныеБумаги.ЦеннаяБумага КАК Справочник.Закладные).Банк.Наименование)
		|		ИНАЧЕ """"
		|	КОНЕЦ,
		|	&ДепозитарныйСчетПолучатель,
		|	&РазделМестаХраненияПолучатель,
		|	&НомерДепозитарногоДоговораПолучатель,
		|	&ДатаДепозитарногоДоговораПолучатель,
		|	&НомерСчетаПолучатель,
		|	&ВидПеревода,
		|	ЕСТЬNULL(НоминалыЦенныхБумагСрезПоследних.Номинал, """"),
		|	ЕСТЬNULL(ДокументЦенныеБумаги.ЦеннаяБумага.ВалютаНоминала, """"),
		|	ЕСТЬNULL(КодыISIN.Код, """"),
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.НомерТорговогоСчета,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.Идентификатор";	
	
	Если ЭтотОбъект.ВидДвижения = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг.ЦенныеБумаги", "Документ.ВводЦенныхБумаг.ЦенныеБумаги");
	ИначеЕсли ЭтотОбъект.ВидДвижения = 2 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг.ЦенныеБумаги", "Документ.ПереводЦенныхБумаг.ЦенныеБумаги");
	КонецЕсли;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДепозитарныйСчетПолучатель", 				?(ВидДвижения = 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель", 						"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&РазделМестаХраненияПолучатель", 				?(ВидДвижения = 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.НомерСчета", 			"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НомерДепозитарногоДоговораПолучатель", 		?(ВидДвижения = 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Договор.НомерДоговора", 	"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаДепозитарногоДоговораПолучатель", 		?(ВидДвижения = 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Договор.ДатаЗаключения", """""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НомерСчетаПолучатель", 						?(ВидДвижения = 2, "ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Родитель.НомерСчета", 	"""""")); 	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВидПеревода", 								?(ВидДвижения = 2, "ВЫБОР КОГДА ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Депозитарий = &НСД ТОГДА ""Перевод_Поступление"" ИНАЧЕ ""Перевод_Передача"" КОНЕЦ", 	"""""")); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДоговорСЦентральнымДепозитариемКонтрагента", ?(ВидДвижения = 2, "ВЫБОР КОГДА ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Депозитарий = &НСД ТОГДА (ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Депозитарий = ДоговорыСЦентральнымДепозитариемСрезПоследних.ДепозитарнаяКомпания) ИНАЧЕ (ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчетПолучатель.Депозитарий = ДоговорыСЦентральнымДепозитариемСрезПоследних.ДепозитарнаяКомпания) КОНЕЦ", 	"(ДокументЦенныеБумаги.Ссылка.ДепозитарныйСчет.Депозитарий = ДоговорыСЦентральнымДепозитариемСрезПоследних.ДепозитарнаяКомпания)")); 
	
	Запрос.УстановитьПараметр("СписокДокументов", ЭтотОбъект.ДокументыДвиженияЦБ.ВыгрузитьКолонку("Документ"));
	Запрос.УстановитьПараметр("Период", НачалоДня(ЭтотОбъект.ДатаПоручения));	
	Запрос.УстановитьПараметр("НСД",
		?(ЭтотОбъект.ДатаПоручения >= '20260720',
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД")));	
		
	РезультатЗапроса = Запрос.Выполнить();
	ИменаКолонок = Новый Массив;
	Для Каждого ТекКолонка Из РезультатЗапроса.Колонки Цикл
		ИменаКолонок.Добавить(ТекКолонка.Имя);
	КонецЦикла;	
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

#КонецОбласти

