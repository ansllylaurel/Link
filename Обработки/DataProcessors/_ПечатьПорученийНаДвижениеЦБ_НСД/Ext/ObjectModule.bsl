
#Область Регистрационные_Данные

Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка, "Печать поручений на движение ЦБ (НСД)", "1.0", "", Истина);
		
	// команды
	РегистрационныеДанные.Вставить("Команды", РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд());
	
	Возврат РегистрационныеДанные;
	
КонецФункции

#КонецОбласти

#Область Обработчики_событий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидДвижения <> 2 Тогда
		
		ПроверяемыеРеквизиты.Добавить("Контрагент");		
		ПроверяемыеРеквизиты.Добавить("НаименованиеКонтрагента");
		ПроверяемыеРеквизиты.Добавить("СчетДепоКонтрагента");
		ПроверяемыеРеквизиты.Добавить("НомерДепозитарногоДоговораКонтрагента");
		ПроверяемыеРеквизиты.Добавить("ДатаДепозитарногоДоговораКонтрагента");
		ПроверяемыеРеквизиты.Добавить("НомерРазделаКонтрагента");
		ПроверяемыеРеквизиты.Добавить("НомерРазделаВМестеХраненияКонтрагента");
				
	КонецЕсли;     
	
КонецПроцедуры

#КонецОбласти

#Область Прочие_Процедуры_и_Функции

Функция СформироватьПечатнуюФормуПоручения(СтруктураПодписанта,Отказ) Экспорт
	
	МассивПоручений = Новый Массив;
			
	ВыборкаШапки = ПолучитьВыборкуШапки();
	Если Не ВыборкаШапки.Следующий() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных по счету доверительного управления",,,, Отказ);
		Возврат МассивПоручений;
	КонецЕсли;	
	
	ВыборкаДанных = ПолучитьВыборкуДанных();
	Если ВыборкаДанных.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет данных по ценным бумагам",,,, Отказ);		
		Возврат МассивПоручений;
	КонецЕсли;
	
	Макет = ПолучитьМакет(?(ЭтотОбъект.ВидДвижения = 2, "Форма03", "Форма08"));
	
	ОбластьДоЦБ 	= Макет.ПолучитьОбласть("ДоЦБ");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("СтрокаЦБ");
	ОбластьПослеЦБ 	= Макет.ПолучитьОбласть("ПослеЦБ");
	
	ОбластьДоЦБ.Параметры.Заполнить(ВыборкаШапки);
	
	ОбластьДоЦБ.Параметры.НаименованиеДепонента = НаименованиеДепонента;
	ОбластьДоЦБ.Параметры.ДатаПоручения 		= Формат(ДатаПоручения, "ДФ=dd.MM.yyyy");
	
	ОбластьПослеЦБ.Параметры.НаименованиеКонтрагента = ВыборкаШапки.ПолноеНаименованиеСД;
	
	Если ЭтотОбъект.ВидДвижения = 2 Тогда
		ОбластьПослеЦБ.Параметры.КодКонтрагента = Выборкашапки.ИдентификаторНеНСД;	
		ОбластьПослеЦБ.Параметры.ДатаРасчетов	= Формат(СрокПеререгистрацииПрав, "ДФ=dd.MM.yyyy");	
		ОбластьПослеЦБ.Параметры.ДатаСделки		= Формат(ДатаПоручения, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	ОбластьПослеЦБ.Параметры.Подписант 						= СокрЛП(СтруктураПодписанта.ПодписантФИО);
	ОбластьПослеЦБ.Параметры.ПодписантОснованиеПолномочий 	= СокрЛП(СтруктураПодписанта.ПодписантОснованиеПолномочий);
	ОбластьПослеЦБ.Параметры.ПодписантДолжность 			= ?(ЭтотОбъект.ВидДвижения = 2, СокрЛП(СтруктураПодписанта.ПодписантДолжность), "");
	ОбластьПослеЦБ.Параметры.ДатаПисьмаФонда 				= Формат(ДатаТребованияФонда, "ДФ=dd.MM.yyyy");
	ОбластьПослеЦБ.Параметры.НомерПисьмаФонда 				= СокрЛП(НомерТребованияФонда); 
	
	ОдноПоручение = ВыборкаДанных.Количество() <= 50;
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ТекНомерДоговора = ПодготовитьНомерДоговора(ВыборкаШапки.НомерДоговора);
	
	Сч = 0;
	
	ИмяФайла = "";
	
	// Поступления с четными номерами
	НомерПоручения = ?(ЭтотОбъект.ВидДвижения = 0, 2, 1);
	Пока ВыборкаДанных.Следующий() Цикл    
		
		Если Сч%50 = 0 Тогда
			
			// Выводим подвал предыдущего
			Если Сч > 0 Тогда
				ТабДокумент.Вывести(ОбластьПослеЦБ);				
				МассивПоручений.Добавить(Новый Структура("ТабДокумент, ИмяФайла", ТабДокумент, ?(ЭтотОбъект.ВидДвижения = 2, ТекНомерДоговора + "_", "") + ИмяФайла));
			КонецЕсли;	
			
			// Выводим шапку
			ТабДокумент = Новый ТабличныйДокумент;
			ОбластьДоЦБ.Параметры.ТипОперации_Зачисление 	= ?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление" Или ЭтотОбъект.ВидДвижения = 1, "R", "*");
			ОбластьДоЦБ.Параметры.ТипОперации_Списание 		= ?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление" Или ЭтотОбъект.ВидДвижения = 1,  "*", "R");			
			ОбластьДоЦБ.Параметры.НомерСчета 				= СокрЛП(?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление", ВыборкаДанных.НомерСчетаПолучатель, ВыборкаДанных.НомерСчета));
			
			НомерСчетаЦифрами = ПолучитьНомерСчетаЦифрами(ОбластьДоЦБ.Параметры.НомерСчета);
			ИмяФайла = ?(ЭтотОбъект.ВидДвижения = 2,
							НомерСчетаЦифрами + ?(ОдноПоручение, "", "-" + Формат(НомерПоручения, "ЧГ=0")),
							?(ЭтотОбъект.ВидДвижения = 0, "зачисление_", "списание_") + Формат(ЭтотОбъект.ДатаПоручения, "ДФ=ddMMyy") + "-" + Формат(НомерПоручения, "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=0")) + "_" + ОбластьДоЦБ.Параметры.НомерСчета;
							
			ОбластьДоЦБ.Параметры.НомерПоручения = ?(ЭтотОбъект.ВидДвижения = 2, ИмяФайла,
						Формат(ЭтотОбъект.ДатаПоручения, "ДФ=ddMMyy") + "-" + Формат(НомерПоручения, "ЧЦ=2; ЧДЦ=0; ЧВН=; ЧГ=0"));
					
			
			ОбластьПослеЦБ.Параметры.ДатаДепозитарногоДоговора 	= Формат(?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление", ВыборкаДанных.ДатаДепозитарногоДоговораПолучатель, ВыборкаДанных.ДатаДепозитарногоДоговора), "ДФ=dd.MM.yyyy");
			ОбластьПослеЦБ.Параметры.НомерДепозитарногоДоговора = СокрЛП(?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление", ВыборкаДанных.НомерДепозитарногоДоговораПолучатель, ВыборкаДанных.НомерДепозитарногоДоговора));
			
			Если ЭтотОбъект.ВидДвижения <> 2 Тогда  				
				ОбластьПослеЦБ.Параметры.ДатаДепозитарногоДоговораКонтрагента 	= Формат(ЭтотОбъект.ДатаДепозитарногоДоговораКонтрагента, "ДФ=dd.MM.yyyy");
				ОбластьПослеЦБ.Параметры.НомерДепозитарногоДоговораКонтрагента 	= СокрЛП(ЭтотОбъект.НомерДепозитарногоДоговораКонтрагента); 	
				ОбластьПослеЦБ.Параметры.РазделСчетаДепоКонтрагента				= СокрЛП(ЭтотОбъект.НомерРазделаКонтрагента);
				ОбластьПослеЦБ.Параметры.НомерСчетаКонтрагента					= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.СчетДепоКонтрагента, "Родитель.НомерСчета"));
				ОбластьПослеЦБ.Параметры.НаименованиеКонтрагента				= СокрЛП(ЭтотОбъект.НаименованиеКонтрагента);
			КонецЕсли;
			
			ОбластьПослеЦБ.Параметры.ЛицевойСчетКонтрагента = ВыборкаДанных.МестоХраненияКонтрагента;
			ОбластьПослеЦБ.Параметры.НомерРазделаКонтрагента = СокрЛП(?(ЭтотОбъект.ВидДвижения <> 2, ЭтотОбъект.НомерРазделаВМестеХраненияКонтрагента,
																	?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление", ВыборкаДанных.РазделМестаХранения, ВыборкаДанных.РазделМестаХраненияПолучатель)));
			
			НомерПоручения = НомерПоручения + ?(ЭтотОбъект.ВидДвижения = 2, 1, 2);
			
			ТабДокумент.Вывести(ОбластьДоЦБ);
			
		КонецЕсли;	
			
		ОбластьСтрока.Параметры.Заполнить(ВыборкаДанных);
		ОбластьСтрока.Параметры.ИдентификаторЦБ 	= ?(ВыборкаДанных.РезидентРФ, ВыборкаДанных.ГосударственныйРегистрационныйНомер, ВыборкаДанных.ISIN);
		ОбластьСтрока.Параметры.КоличествоПрописью 	= СокрЛП(ЧислоПрописью(ВыборкаДанных.Количество, "Л = ru_RU;", ",,,,,,,,0"));
				
		ОбластьСтрока.Параметры.РазделСчетаДЕПО = СокрЛП(?(ВыборкаДанных.ВидПеревода = "Перевод_Поступление", ВыборкаДанных.РазделМестаХраненияПолучатель, ВыборкаДанных.РазделМестаХранения));
		ОбластьСтрока.Параметры.МестоХранения = ВыборкаШапки.МестоХранения;
		
		ТабДокумент.Вывести(ОбластьСтрока);
				
		Сч = Сч + 1;
		
	КонецЦикла;
	
	// Подвал последнего
	ТабДокумент.Вывести(ОбластьПослеЦБ);				
	МассивПоручений.Добавить(Новый Структура("ТабДокумент, ИмяФайла", ТабДокумент, ?(ЭтотОбъект.ВидДвижения = 2, ТекНомерДоговора + "_", "") + ИмяФайла));
				
	Возврат МассивПоручений;
	
КонецФункции

Функция ПолучитьНомерСчетаЦифрами(НомерСчета)
	
	СтрокаЦифр = "0123456789";
	
	Результат = "";
	
	ДлинаНомера = СтрДлина(НомерСчета);
	
	Для Сч = 1 По ДлинаНомера Цикл
		
		ТекСимвол = Сред(НомерСчета, Сч, 1);
		Если СтрНайти(СтрокаЦифр, ТекСимвол) > 0 Тогда
			// Лидирующие нули пропускаем
			Если Результат = "" И ТекСимвол = "0" Тогда
				Продолжить;
			Иначе
				Результат = Результат + ТекСимвол;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
				
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьНомерДоговора(НомерДоговора)
	
	ПозицияВспомогательнойЧасти = СтрНайти(НомерДоговора, "/");
	
	Если ПозицияВспомогательнойЧасти = 0 Тогда
		Возврат НомерДоговора;
	КонецЕсли;
	
	Возврат Лев(НомерДоговора, ПозицияВспомогательнойЧасти - 1);
	
КонецФункции

Функция ПолучитьВыборкуШапки(ИменаКолонок = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентДоверительногоУправления
		|ИЗ
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			СчетДоверительногоУправления = &СчетДоверительногоУправления
		|				И СчетДоверительногоУправления.Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыЮридическихЛицОрганизации.ПолноеНаименованиеПоУставу + "" Д.У."" КАК НаименованиеОрганизации,
		|	РеквизитыЮридическихЛицОрганизации.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеОрганизации,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	РеквизитыЮридическихЛицКлиента.ПолноеНаименованиеПоУставу КАК НаименованиеКлиента,
		|	РеквизитыЮридическихЛицКлиента.КраткоеНаименованиеПоУставу КАК КраткоеНаименованиеКлиента,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _КлиентДоверительногоУправления.СчетДоверительногоУправления.ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|			ТОГДА ""накоплений""
		|		ИНАЧЕ ""резервов""
		|	КОНЕЦ КАК ПН_ПР,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	_КлиентДоверительногоУправления.СчетДоверительногоУправления.ДатаЗаключения КАК ДатаЗаключения,
		|	ЕСТЬNULL(РеквизитыЮридическихЛицАнкетныеКонтрагента.КраткоеНаименованиеПоУставу, РеквизитыЮридическихЛицКонтрагента.КраткоеНаименованиеПоУставу) КАК НаименованиеКонтрагента,
		|	РеквизитыЮридическихЛицОрганизации.ОГРН КАК ОГРНОрганизации,
		|	РеквизитыЮридическихЛицСД.ОГРН КАК ОГРН_СД,
		|	РеквизитыЮридическихЛицСД.ДатаВыдачиОГРН КАК ДатаОГРН_СД,
		|	РеквизитыЮридическихЛицСД.ОрганВыдавшийОГРН КАК ОрганОГРН_СД,
		|	РеквизитыЮридическихЛицНРД.ОГРН КАК ОГРН_НРД,
		|	РеквизитыЮридическихЛицСД.ПолноеНаименованиеПоУставу КАК ПолноеНаименованиеСД,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.НомерТорговогоСчета КАК МестоХранения,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследних.Идентификатор КАК ИдентификаторСД,
		|	ДоговорыСЦентральнымДепозитариемСрезПоследнихНеНСД.Идентификатор КАК ИдентификаторНеНСД
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &ЮрФизЛицо
		|				И Организация = &Организация
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицОрганизации,
		|	_КлиентДоверительногоУправления КАК _КлиентДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКлиента
		|		ПО _КлиентДоверительногоУправления.Клиент = РеквизитыЮридическихЛицКлиента.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &Контрагент
		|					И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицКонтрагента
		|		ПО (РеквизитыЮридическихЛицКонтрагента.ЮрФизЛицо = &Контрагент)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				ЮрФизЛицо = &Контрагент
		|					И Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеКонтрагента
		|		ПО _КлиентДоверительногоУправления.Организация = РеквизитыЮридическихЛицАнкетныеКонтрагента.Организация,
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &Спецдепозитарий
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицСД,
		|	РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
		|			&Период,
		|			ЮрФизЛицо = &НРД
		|				И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицНРД,
		|	РегистрСведений.ДоговорыСЦентральнымДепозитарием.СрезПоследних(&Период, ДепозитарнаяКомпания.ЮрФизЛицо = &СпецдепозитарийНСД) КАК ДоговорыСЦентральнымДепозитариемСрезПоследних,
		|	РегистрСведений.ДоговорыСЦентральнымДепозитарием.СрезПоследних(&Период, ДепозитарнаяКомпания.ЮрФизЛицо = &Спецдепозитарий) КАК ДоговорыСЦентральнымДепозитариемСрезПоследнихНеНСД";
	
	ЮрФизЛицоОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.Организация, "ЮрФизЛицо");
	Запрос.УстановитьПараметр("Период", 						КонецДня(ЭтотОбъект.ДатаПоручения));
	Запрос.УстановитьПараметр("ЮрФизЛицо", 						ЮрФизЛицоОрганизации);
	Запрос.УстановитьПараметр("Организация", 					ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	ЭтотОбъект.СчетДоверительногоУправления);
	
	Запрос.УстановитьПараметр("Контрагент", 					?(ЭтотОбъект.ВидДвижения = 2, ЮрФизЛицоОрганизации, ЭтотОбъект.Контрагент));
	ДепозитарийНСД = ?(ЭтотОбъект.ДатаПоручения >= '20260720',
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии"),
		ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"));
		
	Запрос.УстановитьПараметр("СпецдепозитарийНСД", 			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДепозитарийНСД, "ЮрФизЛицо"));
