#Область События_Формы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	
	Объект.Организация 		= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");	
	Объект.ДатаПоручения	= ТекущаяДата();
	Объект.ВидДвижения 		= 2;
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ПереводЦенныхБумаг");

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РаботаСФормами.ПриЗагрузкеДанныхИзНастроек(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область События_Элементов_Формы

&НаКлиенте
Процедура ПодписантНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = РаботаСОтчетами.ПолучитьПараметрыФормыВыбораКонтактногоЛица(Новый Структура("Организация, КонтактноеЛицо", Объект.Организация, Объект.Подписант));
	
	ОткрытьФормуМодально("РегистрСведений.КонтактныеЛица.ФормаСписка", ПараметрыФормы, Элемент, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодписантОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтруктураДанныхКонтактногоЛица = РаботаСОтчетами.ПолучитьДанныеКонтактногоЛицаПоКлючу(ВыбранноеЗначение);
	
	ПодписантДолжность 				= СтруктураДанныхКонтактногоЛица.Должность;
	ПодписантОснованиеПолномочий 	= СтруктураДанныхКонтактногоЛица.ОснованиеПолномочий;
	ПодписантФИО					= ПолучитьФИО(СтруктураДанныхКонтактногоЛица.КонтактноеЛицо, Объект.ДатаПоручения, Объект.Организация);
	ВыбранноеЗначение				= СтруктураДанныхКонтактногоЛица.КонтактноеЛицо;
		
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога); 
	Диалог.Каталог            = Объект.КаталогДанных; 
	Диалог.МножественныйВыбор = Ложь; 
	Диалог.Заголовок          = "Выберите каталог"; 
	
	Если Диалог.Выбрать() Тогда 
		Объект.КаталогДанных = Диалог.Каталог;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЗапуститьПриложение(Объект.КаталогДанных + "\");

КонецПроцедуры

&НаКлиенте
Процедура ДокументыДиженияЦБДокументПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДокументыДвиженияЦБ.ТекущиеДанные;
	Если ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ВыводЦенныхБумаг.ПустаяСсылка")
		Или ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ВводЦенныхБумаг.ПустаяСсылка")
		Или ТекущиеДанные.Документ = ПредопределенноеЗначение("Документ.ПереводЦенныхБумаг.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущиеДанные.Документ, "Рынок, ДепозитарныйСчет, " + ?(Объект.ВидДвижения = 2, "ДепозитарныйСчетПолучатель", "Контрагент"));
	
	// У перевода выведем счет ДЕПО в НСД. Это либо отправитель, либо получатель
	Если Объект.ВидДвижения = 2 Тогда
		ДепозитарийСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыДокумента.ДепозитарныйСчет, "Депозитарий");
		Если ДепозитарийСчета = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД")
			Или ДепозитарийСчета = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии") Тогда
			ДЕПО_НСД = РеквизитыДокумента.ДепозитарныйСчет;
		Иначе
			ДЕПО_НСД = РеквизитыДокумента.ДепозитарныйСчетПолучатель;
		КонецЕсли;		
	Иначе
		ДЕПО_НСД = РеквизитыДокумента.ДепозитарныйСчет;	
	КонецЕсли;
	
	ТекущиеДанные.Рынок 		= РеквизитыДокумента.Рынок;
	ТекущиеДанные.СчетДепо 		= ДЕПО_НСД;
	ТекущиеДанные.Контрагент 	= ?(Объект.ВидДвижения = 2, "", РеквизитыДокумента.Контрагент);  	
	
	ЗаполнитьДанныеПоДокументуНаСервере(ТекущиеДанные.Документ);
	
КонецПроцедуры     

&НаКлиенте
Процедура ВидДвиженияПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
	Если Объект.ДокументыДвиженияЦБ.Количество() > 0 Тогда
		Объект.ДокументыДвиженияЦБ.Очистить();
	КонецЕсли;	
		
	// Назначим тип для выбора документам в табличной части
	Если Объект.ВидДвижения = 0 Тогда
		Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ВводЦенныхБумаг");
	ИначеЕсли Объект.ВидДвижения = 1 Тогда
	    Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ВыводЦенныхБумаг");
	Иначе
		Элементы.ДокументыДвиженияЦБДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ПереводЦенныхБумаг");
	КонецЕсли;
	
	ОбновитьСписокВыбораКонтрагента();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
			
	ОбновитьСписокВыбораКонтрагента();

	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументыДвиженияЦБ[0].Документ) Тогда
		Объект.ДокументыДвиженияЦБ.Очистить(); 
		Возврат;
	КонецЕсли;
	
	Если Объект.СчетДоверительногоУправления <> ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументыДвиженияЦБ[0].Документ, "СчетДоверительногоУправления") Тогда
		Объект.ДокументыДвиженияЦБ.Очистить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаИВремяФормированияПриИзменении(Элемент)
		
	ОбновитьСписокВыбораКонтрагента();
	
	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументыДвиженияЦБ[0].Документ) Тогда
		Объект.ДокументыДвиженияЦБ.Очистить(); 
		Возврат;
	КонецЕсли;
	
	Если НачалоДня(Объект.ДатаПоручения) <> НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументыДвиженияЦБ[0].Документ, "Дата")) Тогда
		Объект.ДокументыДвиженияЦБ.Очистить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДокументыДвиженияЦБПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	УсловиеВыполнено = ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И Объект.ДатаПоручения <> '00010101';
	ТекстСообщения = "Счет ДУ, дата и время составления должны быть заполнены";
	
	Если Объект.ВидДвижения <> 2 Тогда
		УсловиеВыполнено = УсловиеВыполнено И ЗначениеЗаполнено(Объект.Контрагент);
		ТекстСообщения = "Счет ДУ, контрагент, дата и время составления должны быть заполнены";
	КонецЕсли;
	
	Если Не УсловиеВыполнено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	Объект.ДокументыДвиженияЦБ.Очистить();
	ЗаполнитьТаблицуДокументовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверим спецдеп, разрешен только НСД
	Если Не ПроверитьСпецДепозитарий(ВыбранноеЗначение, Объект.ВидДвижения) Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеТекущейОрганизации() Экспорт

	// Обновляем организацию
	Объект.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	Объект.СчетДоверительногоУправления = "";    
	Элементы.Контрагент.СписокВыбора.Очистить();
	Объект.Контрагент = "";
	Объект.ДокументыДвиженияЦБ.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элемент.СписокВыбора.Количество() = 0 Тогда
		
		СтандартнаяОбработка = Ложь;				
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют " + ?(Объект.ВидДвижения = 0, "вводы", "выводы") + " ценных бумаг на выбранную дату");
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДепоКонтрагентаПриИзменении(Элемент)
	
	ДанныеСчетаДепоКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СчетДепоКонтрагента, Новый Структура("НомерРазделаВМестеХраненияКонтрагента, НаименованиеКонтрагента, НомерДепозитарногоДоговораКонтрагента, ДатаДепозитарногоДоговораКонтрагента", "НомерСчета", "Договор.НаименованиеВладельцаДляДокументов", "Договор.НомерДоговора", "Договор.ДатаЗаключения"));
	ЗаполнитьЗначенияСвойств(Объект, ДанныеСчетаДепоКонтрагента);	
		
КонецПроцедуры

#КонецОбласти

#Область Команды_Формы

&НаКлиенте
Процедура КомандаПечать(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаПечать");
	ВыполнитьПечать(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПечать(ПараметрыСессии)
			
	Если Не ПроверитьЗаполнение() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не заполнены обязательные поля");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьСпецДепозитарий(Объект.СчетДоверительногоУправления, Объект.ВидДвижения) Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка специализированного депозитария");
		Возврат;	
	КонецЕсли;

	Если Объект.ДокументыДвиженияЦБ.Количество() = 0 Тогда
		ТекстОшибки = "Не указаны документы для печати";
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;		
	КонецЕсли;
	
	Отказ = Ложь;
	РаботаСФайламиКлиентСервер.ПроверитьСоздатьКаталог(Объект.КаталогДанных, Отказ, Истина);
	
	Если Отказ Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не удалось создать каталог данных");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьДокументыНаСервере() Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не пройдена проверка документов");
		Возврат;
	КонецЕсли;
	
	СтруктураПодписанта = Новый Структура("ПодписантФИО, ПодписантДолжность, ПодписантОснованиеПолномочий, ", ПодписантФИО, ПодписантДолжность, ПодписантОснованиеПолномочий);
		
	Отказ = Ложь;
	МассивПоручений = ПечатьНаСервере(СтруктураПодписанта, Отказ);
	
	Если Отказ Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, "Не удалось сформировать печатные формы поручений");
		Возврат;
	КонецЕсли;
	
	ФормаПоручения = ?(Объект.ВидДвижения = 2, "Р-03_", "Р-08_");
	
	// Выводим поручения
	Для Каждого СтрокаПоручения Из МассивПоручений Цикл
		
		ТабДокумент = СтрокаПоручения.ТабДокумент;
		ТабДокумент.ОриентацияСтраницы 	= ОриентацияСтраницы.Ландшафт;
		ТабДокумент.ОтображатьСетку 	= Ложь;
		ТабДокумент.ТолькоПросмотр 		= Истина;
		ИспользуемоеИмяФайла = ?(ПустаяСтрока(Объект.КаталогДанных), "", Объект.КаталогДанных + "\") + ФормаПоручения + ?(Объект.ВидДвижения = 2, СокрЛП(Объект.Организация) + "_", "") + СокрЛП(СтрокаПоручения.ИмяФайла) + ".xlsx"; 
		
		Попытка
			ТабДокумент.Записать(ИспользуемоеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
		Исключение
			ТекстОшибки = "Не удалось сохранить файл " + ИспользуемоеИмяФайла + ": " + ОписаниеОшибки() + " Сохранение файлов прервано";
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			Прервать;
		КонецПопытки;
		
		ТабДокумент.Показать("Поручение", ИспользуемоеИмяФайла);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьТаблицуДокументов(Команда)
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию("КомандаЗаполнитьТаблицуДокументов");
	ВыполнитьЗаполнениеТаблицыДокументов(ПараметрыСессии);
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеТаблицыДокументов(ПараметрыСессии)
	
	УсловиеВыполнено = ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И Объект.ДатаПоручения <> '00010101';
	ТекстСообщения = "Счет ДУ, дата и время составления должны быть заполнены";
	
	Если Объект.ВидДвижения <> 2 Тогда
		УсловиеВыполнено = УсловиеВыполнено И ЗначениеЗаполнено(Объект.Контрагент);
		ТекстСообщения = "Счет ДУ, контрагент, дата и время составления должны быть заполнены";
	КонецЕсли;
	
	Если Не УсловиеВыполнено Тогда
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстСообщения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуДокументовНаСервере(ПараметрыСессии);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные_Процедуры_и_Функции

&НаСервере
Процедура ЗаполнитьТаблицуДокументовНаСервере(ПараметрыСессии = Неопределено)
	
	Объект.ДокументыДвиженияЦБ.Очистить();
	
	ВыборкаДокументовПоЦБ = ПолучитьВыборкуДокументов(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДатаПоручения, Объект.Контрагент, Объект.ВидДвижения);
	
	Если ВыборкаДокументовПоЦБ.Количество() = 0 Тогда
		
		ТекстДокумента = "вводы";
		Если Объект.ВидДвижения = 1 Тогда
			ТекстДокумента = "выводы";
		ИначеЕсли Объект.ВидДвижения = 2 Тогда
			ТекстДокумента = "переводы";
		КонецЕсли;
		
		ТекстОшибки = "Отсутствуют " + ТекстДокумента + " ценных бумаг на выбранную дату" + ?(Объект.ВидДвижения = 2, "", " по контрагенту " + СокрЛП(Объект.Контрагент));
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
		
	КонецЕсли;		
	
	Пока ВыборкаДокументовПоЦБ.Следующий() Цикл
		НоваяСтрока = Объект.ДокументыДвиженияЦБ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДокументовПоЦБ);		
	КонецЦикла;
	
	// Заполним связанные реквизиты обработки из первого документа
	Если Объект.ДокументыДвиженияЦБ.Количество() > 0 Тогда		
		ЗаполнитьДанныеПоДокументуНаСервере(Объект.ДокументыДвиженияЦБ[0].Документ);		
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоДокументуНаСервере(Документ)
	
	ДанныеПоручения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, 
						?(Объект.ВидДвижения <> 2, 
									Новый Структура("НомерТребованияФонда,ДатаТребованияФонда,СрокПеререгистрацииПрав,НаименованиеДепонента", 
										"Поручение.НомерВходящегоДокумента", 
										"Поручение.ДатаВходящегоДокумента", 
										"Поручение.ДатаИсполненияПо", 												
						                "ДепозитарныйСчет.Договор.НаименованиеВладельцаДляДокументов"),
									Новый Структура("НаименованиеДепонента", 
										"ДепозитарныйСчет.Договор.НаименованиеВладельцаДляДокументов")));
								
	ЗаполнитьЗначенияСвойств(Объект, ДанныеПоручения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВыборкуДокументов(Организация, СчетДоверительногоУправления, ДатаДокумента, Контрагент, ВидДвижения)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документ.Ссылка КАК Документ,
		|	Документ.ДепозитарныйСчет КАК СчетДепо,
		|	Документ.Контрагент КАК Контрагент,
		|	Документ.Рынок КАК Рынок		
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК Документ
		|ГДЕ
		|	Документ.Организация = &Организация
		|	И Документ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
		|	И НЕ Документ.ПометкаУдаления";
	
	Если ВидДвижения <> 2 Тогда
		Запрос.Текст = Запрос.Текст + "
		|И Документ.Контрагент = &Контрагент";
		Запрос.УстановитьПараметр("Контрагент", 		Контрагент);
	КонецЕсли;
	
	Если ВидДвижения = 0 Тогда
		// Поступление
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг", 	"Документ.ВводЦенныхБумаг");
	ИначеЕсли ВидДвижения = 2 Тогда
		// Перевод
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг", 	"Документ.ПереводЦенныхБумаг");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.Контрагент", 		"""""");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ДепозитарныйСчет", 	"ВЫБОР КОГДА Документ.ДепозитарныйСчет.Депозитарий = &НСД ТОГДА Документ.ДепозитарныйСчет ИНАЧЕ Документ.ДепозитарныйСчетПолучатель КОНЕЦ");
		Запрос.УстановитьПараметр("НСД",
			?(ДатаДокумента >= '20260720',
				ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии"),
				ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД")));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата", 							НачалоДня(ДатаДокумента));
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаСервере
Функция ПечатьНаСервере(СтруктураПодписанта, Отказ)
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
		
	Возврат ОбъектОбработки.СформироватьПечатнуюФормуПоручения(СтруктураПодписанта, Отказ);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьГруппыКонтрагент = Объект.ВидДвижения <> 2;
	
	Элементы.ГруппаКонтрагент.Видимость = ВидимостьГруппыКонтрагент;
	
	Если Не ВидимостьГруппыКонтрагент Тогда
		
		Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
			Объект.Контрагент = "";
			Элементы.Контрагент.СписокВыбора.Очистить();
		КонецЕсли;
		
		Если ПустаяСтрока(Объект.НомерДепозитарногоДоговораКонтрагента) Тогда
			Объект.НомерДепозитарногоДоговораКонтрагента = "";
		КонецЕсли;
		
		Если ПустаяСтрока(Объект.НомерРазделаКонтрагента) Тогда
			Объект.НомерРазделаКонтрагента = "";
		КонецЕсли;
		
		Если Объект.ДатаДепозитарногоДоговораКонтрагента <> '00010101' Тогда
			Объект.ДатаДепозитарногоДоговораКонтрагента = '00010101';
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДокументыНаСервере()
	Возврат ПроверитьДокументы(Объект.ДокументыДвиженияЦБ.Выгрузить(), Объект.ДатаПоручения, Объект.ВидДвижения, Объект.Контрагент);
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДокументы(ТаблицаДокументов, ДатаФормирования, ВидДвижения, Контрагент)
	
	// У всех документов проверяем дату и пометку удаления; 
	// В переводах у счета ДЕПО-отправителя или у счета ДЕПО-получателя должен быть НСД;
	// У вводов и выводов проверяем контрагента
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Документ КАК Документ,
		|	_Документы.СчетДепо КАК ДепозитарныйСчет,
		|	_Документы.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ _Документы
		|ИЗ
		|	&Документы КАК _Документы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Документы.Документ КАК Документ,
		|	""Дата"" КАК ВидОшибки
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(_Документы.Документ КАК Документ.ВводЦенныхБумаг).Дата, ДЕНЬ) <> &Период
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""ПометкаУдаления""
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТИПЗНАЧЕНИЯ(_Документы.Документ) = ТИП(Документ.ВводЦенныхБумаг)
		|				ТОГДА ВЫРАЗИТЬ(_Документы.Документ КАК Документ.ВводЦенныхБумаг).ПометкаУдаления
		|			КОГДА ТИПЗНАЧЕНИЯ(_Документы.Документ) = ТИП(Документ.ВыводЦенныхБумаг)
		|				ТОГДА ВЫРАЗИТЬ(_Документы.Документ КАК Документ.ВыводЦенныхБумаг).ПометкаУдаления
		|			КОГДА ТИПЗНАЧЕНИЯ(_Документы.Документ) = ТИП(Документ.ПереводЦенныхБумаг)
		|				ТОГДА ВЫРАЗИТЬ(_Документы.Документ КАК Документ.ПереводЦенныхБумаг).ПометкаУдаления
		|		КОНЕЦ = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""ДепозитарныйСчет""
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	ВЫРАЗИТЬ(_Документы.ДепозитарныйСчет КАК Справочник.ДепозитарныеСчета).Депозитарий <> &НСД
		|	И &ВидДвижения = 2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_Документы.Документ,
		|	""Контрагент""
		|ИЗ
		|	_Документы КАК _Документы
		|ГДЕ
		|	&ВидДвижения <> 2
		|	И _Документы.Контрагент <> &Контрагент";
	
	Если ВидДвижения = 1 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВводЦенныхБумаг", "Документ.ВыводЦенныхБумаг");
	ИначеЕсли ВидДвижения = 2 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВводЦенныхБумаг", "Документ.ПереводЦенныхБумаг"); 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Документы", 		ТаблицаДокументов);
	Запрос.УстановитьПараметр("Период", 		НачалоДня(ДатаФормирования));
	Запрос.УстановитьПараметр("ВидДвижения", 	ВидДвижения);
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
	Запрос.УстановитьПараметр("НСД", 			
		?(ДатаФормирования >= '20260720',
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии"),
			ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД")));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Успешно = Истина;
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = "";
		Если Выборка.ВидОшибки = "Дата" Тогда 
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " дата не совпадает с указанной";
		ИначеЕсли Выборка.ВидОшибки = "ПометкаУдаления" Тогда  			
			ТекстОшибки = "Документ " + СокрЛП(Выборка.Документ) + " помечен на удаление, его необходимо убрать из таблицы к выгрузке"; 	
		ИначеЕсли Выборка.ВидОшибки = "ДепозитарныйСчет" Тогда  			
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " депозитарий одного из счетов ДЕПО 'Откуда' или 'Куда' должен быть 'НСД'"; 
		ИначеЕсли Выборка.ВидОшибки = "Контрагент" Тогда
			ТекстОшибки = "У документа " + СокрЛП(Выборка.Документ) + " контрагент не совпадает с выбранным";
		КонецЕсли;			
			
		Если ТекстОшибки <> "" Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Выборка.Документ);	
			Успешно = Ложь;	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Успешно;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьСпецДепозитарий(СчетДоверительногоУправления, ВидДвижения)
	
	Если ВидДвижения = 2 Тогда
		Возврат Истина;
	КонецЕсли;
	
	СпецДеп = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетДоверительногоУправления, "СпециализированныйДепозитарий");
	ЭтоНСД = (СпецДеп = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НСД"))
		Или (СпецДеп = ОбщегоНазначения.ПолучитьИменованныйОбъект("Депозитарий_НФО_Технологии"));
	
	Если Не ЭтоНСД Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У счета доверительного управления должен быть специализированный депозитарий 'НФО Технологии'");
	КонецЕсли;
	
	Возврат ЭтоНСД;
		
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокВыбораКонтрагента()

	Если Объект.ВидДвижения = 2 Тогда
		// для перевода просто очищаем, контрагент не требуется
		Элементы.Контрагент.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
	
	Если Не (ЗначениеЗаполнено(Объект.СчетДоверительногоУправления) И ЗначениеЗаполнено(Объект.ДатаПоручения)) Тогда
		Элементы.Контрагент.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
		
	СписокКонтрагентов = ПолучитьСписокКонтрагентов(Объект.Организация, Объект.СчетДоверительногоУправления, Объект.ДатаПоручения, Объект.ВидДвижения);
	
	Элементы.Контрагент.СписокВыбора.ЗагрузитьЗначения(СписокКонтрагентов);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокКонтрагентов(Организация, СчетДоверительногоУправления, ДатаДокумента, ВидДвижения)	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Документ.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.ВыводЦенныхБумаг КАК Документ
		|ГДЕ
		|	Документ.Организация = &Организация
		|	И Документ.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И НАЧАЛОПЕРИОДА(Документ.Дата, ДЕНЬ) = &Дата
		|	И НЕ Документ.ПометкаУдаления
		|	И Документ.Контрагент <> ЗНАЧЕНИЕ(Справочник.ЮрФизЛица.)";
				
	Если ВидДвижения = 0 Тогда
		// Поступление
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВыводЦенныхБумаг", 	"Документ.ВводЦенныхБумаг");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", 					Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", 	СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("Дата", 							НачалоДня(ДатаДокумента));

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФИО(ЮрФизЛицо, ДатаСреза, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеквизитыСотрудниковОрганизации.Фамилия + "" "" + РеквизитыСотрудниковОрганизации.Имя + "" "" + РеквизитыСотрудниковОрганизации.Отчество КАК ФИО
		|ИЗ
		|	РегистрСведений.РеквизитыСотрудниковОрганизации.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ЮрФизЛицо = &ЮрФизЛицо
		|				И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыСотрудниковОрганизации";

	Запрос.УстановитьПараметр("Период",		ДатаСреза);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЮрФизЛицо", 	ЮрФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ФИО;
	КонецЕсли;
	
	Возврат СокрЛП(ЮрФизЛицо);
	
КонецФункции

#КонецОбласти

#Область СтатистикаРаботыВнутреннихМеханизмов

&НаСервере
Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки)
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
	
КонецПроцедуры

&НаСервере
Функция ЗарегистрироватьНовуюСессию(ИмяКоманды)
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		РеквизитФормыВЗначение("Объект"), ИмяКоманды);
КонецФункции

&НаСервере
Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии)
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
	
КонецПроцедуры

#КонецОбласти
