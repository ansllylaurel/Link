			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.ПараметрОшибки, ВыборкаОшибок.ИмяФайла));
		КонецЦикла;
		
		НачисленияЗадолженности = Запрос.МенеджерВременныхТаблиц.Таблицы["_НовыеИзмененныеНачисленияЗадолженности"].ПолучитьДанные().Выгрузить();
		
		СчетаДоверительногоУправленияИзНачислений = НачисленияЗадолженности.Скопировать(,"СчетДоверительногоУправления");
		СчетаДоверительногоУправленияИзНачислений.Свернуть("СчетДоверительногоУправления");
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для Каждого СтрокаСчетаДоверительногоУправленияИзНачислений Из СчетаДоверительногоУправленияИзНачислений Цикл
			
			ТаблицаСтрокНачисленияЗадолженности = НачисленияЗадолженности.Скопировать(Новый Структура("СчетДоверительногоУправления", СтрокаСчетаДоверительногоУправленияИзНачислений.СчетДоверительногоУправления));
			
			ТаблицаСтрокНачисленияЗадолженности.Сортировать("НомерСтроки УБЫВ");
			
			ДокНачислениеЗадолженности = Неопределено;
			
			Для Каждого СтрокаНачисленияЗадолженности Из ТаблицаСтрокНачисленияЗадолженности Цикл
				
				Если ЗначениеЗаполнено(СтрокаНачисленияЗадолженности.Ссылка) Тогда
					
					Если ДокНачислениеЗадолженности = Неопределено Тогда
						ДокНачислениеЗадолженности = СтрокаНачисленияЗадолженности.Ссылка.ПолучитьОбъект();
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаНачисленияЗадолженности.НомерСтроки) Тогда
						
						Если ЗначениеЗаполнено(СтрокаНачисленияЗадолженности.Сумма) Тогда
							ДокНачислениеЗадолженности.Основания[СтрокаНачисленияЗадолженности.НомерСтроки - 1].Сумма = СтрокаНачисленияЗадолженности.Сумма;
							ДокНачислениеЗадолженности.Основания[СтрокаНачисленияЗадолженности.НомерСтроки - 1].ДатаОплаты = СтрокаНачисленияЗадолженности.ДатаОплаты;
						Иначе
							ДокНачислениеЗадолженности.Основания.Удалить(СтрокаНачисленияЗадолженности.НомерСтроки - 1);
						КонецЕсли;
							
					Иначе
						ЗаполнитьЗначенияСвойств(ДокНачислениеЗадолженности.Основания.Добавить(), СтрокаНачисленияЗадолженности); 
					КонецЕсли;
					
				Иначе
					
					Если ДокНачислениеЗадолженности = Неопределено Тогда
						
						ДокНачислениеЗадолженности = Документы.НачислениеЗадолженности.СоздатьДокумент();
					
						ЗаполнитьЗначенияСвойств(ДокНачислениеЗадолженности, СтрокаНачисленияЗадолженности);
						ДокНачислениеЗадолженности.Ответственный = РаботаСПользователями.ТекущийПользователь();
						ДокНачислениеЗадолженности.Комментарий = "Создан аппаратно-техническими средствами " + ТекущаяДата();
						
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(ДокНачислениеЗадолженности.Основания.Добавить(), СтрокаНачисленияЗадолженности);
		
				КонецЕсли;
				
			КонецЦикла;
			
			Если ДокНачислениеЗадолженности <> Неопределено Тогда
			
				Если РаботаСДокументами.ЗапретРедактированияДокумента(ДокНачислениеЗадолженности, ДокНачислениеЗадолженности, Ложь, Ложь) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Не удалось загрузить начисление задолженности по брокерской комиссии. У счета доверительного управления [%1] установлена дата запрета редактирования!", СтрокаСчетаДоверительногоУправленияИзНачислений.СчетДоверительногоУправления));
				Иначе
							
					Если ДокНачислениеЗадолженности.Основания.Количество() = 0 Тогда
						
						Попытка
							
							ДокНачислениеЗадолженности = ДокНачислениеЗадолженности.Ссылка.ПолучитьОбъект();
							ДокНачислениеЗадолженности.УстановитьПометкуУдаления(Истина);
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("[" + ДокНачислениеЗадолженности + "] помечен на удаление. Счет доверительного управления [" + СтрокаСчетаДоверительногоУправленияИзНачислений.СчетДоверительногоУправления + "].", ДокНачислениеЗадолженности);
							ИзмененияНачисленийЗадолженности = Истина;
							
						Исключение
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось пометить на удаление [" + ДокНачислениеЗадолженности + "]. Счет доверительного управления [" + СтрокаСчетаДоверительногоУправленияИзНачислений.СчетДоверительногоУправления + "]. Система сообщает: " + ОписаниеОшибки());	
						КонецПопытки;
						
					Иначе
						
						НовыйДокументНачисление = ДокНачислениеЗадолженности.ЭтоНовый();
						
						Попытка
							
							ДокНачислениеЗадолженности.Записать(РежимЗаписиДокумента.Проведение);
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(НовыйДокументНачисление, "Создан", "Изменен") +  " документ [" + ДокНачислениеЗадолженности + "]. Счет доверительного управления [" + СтрокаСчетаДоверительногоУправленияИзНачислений.СчетДоверительногоУправления + "].", ДокНачислениеЗадолженности);	
							ИзмененияНачисленийЗадолженности = Истина;
							
						Исключение
							
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось " + ?(НовыйДокументНачисление, "провести начисление задолженности по брокерской комиссии", "изменить документ [" + ДокНачислениеЗадолженности + "]") + "Счет [" + СтрокаСчетаДоверительногоУправленияИзНачислений.СчетДоверительногоУправления + "]. Система сообщает: " + ОписаниеОшибки());
							
							Если НовыйДокументНачисление Тогда 
								ДокНачислениеЗадолженности.Записать(РежимЗаписиДокумента.Запись);
							КонецЕсли;
							
						КонецПопытки;
						
					КонецЕсли;
						
				КонецЕсли;
				
			КонецЕсли;
				
		КонецЦикла;
			
		Оплаты = Запрос.МенеджерВременныхТаблиц.Таблицы["_НовыеИзмененныеОплаты"].ПолучитьДанные().Выгрузить();
		
		СчетаДоверительногоУправленияИзОплат = Оплаты.Скопировать(,"СчетДоверительногоУправления");
		СчетаДоверительногоУправленияИзОплат.Свернуть("СчетДоверительногоУправления");
			
		Для Каждого СтрокаСчетаДоверительногоУправленияИзОплат Из СчетаДоверительногоУправленияИзОплат Цикл
			
			ТаблицаСтрокОплатБрокерскойКомисссии = Оплаты.Скопировать(Новый Структура("СчетДоверительногоУправления", СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления));
			
			ТаблицаСтрокОплатБрокерскойКомисссии.Сортировать("НомерСтроки УБЫВ");

			ДокОплата = Неопределено;
			
			Для Каждого СтрокаОплатыБрокерскойКомиссии Из ТаблицаСтрокОплатБрокерскойКомисссии Цикл
				
				Если ЗначениеЗаполнено(СтрокаОплатыБрокерскойКомиссии.Ссылка) Тогда
					
					Если ДокОплата = Неопределено Тогда
						ДокОплата = СтрокаОплатыБрокерскойКомиссии.Ссылка.ПолучитьОбъект();
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаОплатыБрокерскойКомиссии.НомерСтроки) Тогда
						
						Если ЗначениеЗаполнено(СтрокаОплатыБрокерскойКомиссии.Сумма) Или ЗначениеЗаполнено(СтрокаОплатыБрокерскойКомиссии.СуммаОплаты) Тогда
						
							ДокОплата.Основания[СтрокаОплатыБрокерскойКомиссии.НомерСтроки - 1].Сумма = СтрокаОплатыБрокерскойКомиссии.Сумма;
							ДокОплата.Основания[СтрокаОплатыБрокерскойКомиссии.НомерСтроки - 1].СуммаОплаты = СтрокаОплатыБрокерскойКомиссии.СуммаОплаты;
							
						Иначе
							ДокОплата.Основания.Удалить(СтрокаОплатыБрокерскойКомиссии.НомерСтроки - 1);		
						КонецЕсли;
						
					Иначе
						ЗаполнитьЗначенияСвойств(ДокОплата.Основания.Добавить(), СтрокаОплатыБрокерскойКомиссии); 
					КонецЕсли;
					
				Иначе
					
					Если ДокОплата = Неопределено Тогда
						
						ДокОплата = Документы.Оплата.СоздатьДокумент();
					
						ЗаполнитьЗначенияСвойств(ДокОплата, СтрокаОплатыБрокерскойКомиссии);
						ДокОплата.Ответственный = РаботаСПользователями.ТекущийПользователь();
						ДокОплата.Комментарий = "Создан аппаратно-техническими средствами " + ТекущаяДата();
						
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(ДокОплата.Основания.Добавить(), СтрокаОплатыБрокерскойКомиссии);
		
				КонецЕсли;
				
			КонецЦикла;
			
			Если ДокОплата <> Неопределено Тогда
			
				Если РаботаСДокументами.ЗапретРедактированияДокумента(ДокОплата, ДокОплата, Ложь, Ложь) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						СтрШаблон("Не удалось загрузить оплату комиссии брокера. У счета доверительного управления [%1] установлена дата запрета редактирования!", СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления ));
				Иначе
					
					Если ДокОплата.Основания.Количество() = 0 Тогда
						
						Попытка
							
							ДокОплата = ДокОплата.Ссылка.ПолучитьОбъект();
							ДокОплата.УстановитьПометкуУдаления(Истина);
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("[" + ДокОплата + "] помечен на удаление. Счет доверительного управления [" + СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления + "].", ДокОплата);
							ИзмененияОплат = Истина;
							
						Исключение
							
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось пометить на удаление [" + ДокОплата + "]. Счет доверительного управления [" + СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления + "]. Система сообщает: " + ОписаниеОшибки());	
												
						КонецПопытки;

					Иначе
						
						НовыйДокументОплата = ДокОплата.ЭтоНовый();
						
						Попытка
							
							ДокОплата.Записать(РежимЗаписиДокумента.Проведение);
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(?(НовыйДокументОплата, "Создан", "Изменен") + " документ [" + ДокОплата + "]. Счет доверительного управления [" + СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления + "].", ДокОплата);
							ИзмененияОплат = Истина;
							
						Исключение
							
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось " + ?(НовыйДокументОплата, "провести оплату по брокерской комиссии", "изменить документ [" + ДокОплата + "]") + ". Счет [" + СтрокаСчетаДоверительногоУправленияИзОплат.СчетДоверительногоУправления + "]. Система сообщает: " + ОписаниеОшибки());
							
							Если НовыйДокументОплата Тогда 
								ДокОплата.Записать(РежимЗаписиДокумента.Запись);
							КонецЕсли;
							
						КонецПопытки;
						
					КонецЕсли;
			
				КонецЕсли;
					
			КонецЕсли;
				
		КонецЦикла;
		
		УстановитьПривилегированныйРежим(Ложь);
				
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии("Сверка с брокером ГПБ. (ИмпортироватьКомиссиюБрокера)", Сессия);

	Возврат СверитьДанныеОтчетовБрокера(ДанныеОтчетовБрокера, ОбщиеПараметры);
	
КонецФункции

&НаСервере
Процедура ИмпортироватьГруппуОбъектов(ВнешниеДанные, ВидДокумента, ОбщиеПараметры, ТаблицаПараметров,  ИмпортируемыеДанные, ДанныеДляСтатистики)
	
	Если ВнешниеДанные.Количество() = 0 
		тогда возврат;
	КонецЕсли;
	
	МВТ = ПолучитьМенеджерВременныхТаблицСДанными(ВнешниеДанные, ОбщиеПараметры, ТаблицаПараметров, ВидДокумента);
	
	//МВТ = ПолучитьМенеджерВременныхТаблицСДанными(ВнешниеДанные, ВидДокумента, Брокер);
	
	Если      ВидДокумента = "Сделка" Тогда
		ИмпортируемыеДанные.Сделки                                 = ИмпортироватьСделки(Брокер, ОбщиеПараметры, МВТ);
	//	ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ);
		
	ИначеЕсли ВидДокумента = "СделкаРЕПО" Тогда
		ИмпортируемыеДанные.СделкиРЕПО = ИмпортироватьСделкиРЕПО(Брокер, ОбщиеПараметры, МВТ);
	//	
	//ИначеЕсли ВидДокумента = "СделкаСВалютой" Тогда
	//	ИмпортируемыеДанные.СделкиСВалютой = ИмпортироватьСделкиСВалютой(Брокер, МВТ);		
	КонецЕсли;
	////
	//Если ЭтотОбъект.РежимИмпорта <> 2 Тогда
	//	Возврат;
	//Иначе
	//	УдалитьВременныеТаблицы(ВидДокумента, МВТ);
	//КонецЕсли;
	//
	//// устраним расхождения и обновим данные при интерактивной работе
	Если      ВидДокумента = "Сделка" Тогда
		
		Если Не ИмпортируемыеДанные.Сделки = Неопределено Тогда
			ДанныеДляСтатистики.Сделки = УстранитьРасхождения(ИмпортируемыеДанные.Сделки, "Сделка");
		КонецЕсли;
		
		Если Не ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = Неопределено Тогда
			ДанныеДляСтатистики.БудущиеИсполненияОбязательствПоСделкам = УстранитьРасхождения(ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам, "ИсполнениеОбязательствПоСделке");
		КонецЕсли;
		
		//Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
			
		//	ИмпортируемыеДанные.Сделки                                 = ИмпортироватьСделки(Брокер, ОбщиеПараметры, МВТ);
			//ИмпортируемыеДанные.БудущиеИсполненияОбязательствПоСделкам = ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ);
			
		//КонецЕсли;
		
	ИначеЕсли ВидДокумента = "СделкаРЕПО" Тогда
		
		Если Не ИмпортируемыеДанные.СделкиРЕПО = Неопределено Тогда
			ДанныеДляСтатистики.СделкиРЕПО = УстранитьРасхождения(ИмпортируемыеДанные.СделкиРЕПО, "СделкаРЕПО");
		КонецЕсли;
		
		//УдалитьВременныеТаблицы(ВидДокумента, МВТ);
		
		//Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		//	ИмпортируемыеДанные.СделкиРЕПО = ИмпортироватьСделкиРЕПО(Брокер, ОбщиеПараметры, МВТ);
		//КонецЕсли;
	//	
	//ИначеЕсли ВидДокумента = "СделкаСВалютой" Тогда
	//	
	//	Если Не ИмпортируемыеДанные.СделкиСВалютой = Неопределено Тогда
	//		ДанныеДляСтатистики.СделкиСВалютой = УстранитьРасхождения(ИмпортируемыеДанные.СделкиСВалютой, ВидДокумента);
	//	КонецЕсли;
	//	
	//	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
	//		ИмпортируемыеДанные.СделкиСВалютой = ИмпортироватьСделкиСВалютой(Брокер, МВТ);
	//	КонецЕсли;
	//	
	КонецЕсли;
	
КонецПроцедуры // ИмпортироватьГруппуОбъектов

&НаСервере
Функция ИмпортироватьБудущиеИсполненияОбязательствПоСделкам(Брокер, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сделка.НомерСделки КАК НомерСделки,
		|	ВЫБОР
		|		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Покупка)
		|			ТОГДА ДОБАВИТЬКДАТЕ(Сделка.ДатаИсполнения, СЕКУНДА, 34200)
		|		КОГДА Сделка.ВидСделки = ЗНАЧЕНИЕ(Перечисление.ВидыСделок.Продажа)
		|			ТОГДА ДОБАВИТЬКДАТЕ(Сделка.ДатаИсполнения, СЕКУНДА, 34201)
		|	КОНЕЦ КАК Дата,
		|	НАЧАЛОПЕРИОДА(Сделка.ДатаИсполнения, ДЕНЬ) <= НАЧАЛОПЕРИОДА(&ТекущаяДата, ДЕНЬ) КАК Проведен,
		|	Сделка.Организация КАК Организация,
		|	Сделка.Ссылка КАК Основание,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоСделке) КАК ВидЗадолженности,
		|	Сделка.ВидСделки КАК ВидСделки,
		|	Сделка.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	Сделка.Рынок КАК Рынок,
		|	Сделка.МестоХранения КАК МестоХранения,
		|	Сделка.Брокер КАК Брокер,
		|	Сделка.КонтрагентНаБирже КАК КонтрагентНаБирже,
		|	Сделка.РасчетныйСчет КАК РасчетныйСчет,
		|	Сделка.ВалютаСделки КАК ВалютаСделки,
		|	СделкаЦенныеБумаги.НомерСтроки КАК ЦенныеБумагиНомерСтроки,
		|	СделкаЦенныеБумаги.ДепозитарныйСчет КАК ЦенныеБумагиДепозитарныйСчет,
		|	СделкаЦенныеБумаги.ЦеннаяБумага КАК ЦенныеБумагиЦеннаяБумага,
		|	СделкаЦенныеБумаги.Количество КАК ЦенныеБумагиКоличество,
		|	СделкаЦенныеБумаги.Цена КАК ЦенныеБумагиЦена,
		|	СделкаЦенныеБумаги.ЦенаПроцент КАК ЦенныеБумагиЦенаПроцент,
		|	СделкаЦенныеБумаги.ЦенаКупона КАК ЦенныеБумагиЦенаКупона,
		|	СделкаЦенныеБумаги.Сумма КАК ЦенныеБумагиСумма,
		|	СделкаЦенныеБумаги.СуммаКупона КАК ЦенныеБумагиСуммаКупона
		|ПОМЕСТИТЬ _СделкиКВИК
		|ИЗ
		|	_ВнешниеДанные КАК _ВнешниеДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка КАК Сделка
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Сделка.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|			ПО Сделка.Ссылка = СделкаЦенныеБумаги.Ссылка
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДублиСделок_1С КАК _ДублиСделок_1С
		|			ПО Сделка.НомерСделки = _ДублиСделок_1С.НомерСделки
		|		ПО _ВнешниеДанные.DealNumber = Сделка.НомерСделки
		|			И _ВнешниеДанные.ВидСделки = Сделка.ВидСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаБэкОфиса.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Брокер = &Брокер) КАК НастройкиУчетаБэкОфисаСрезПоследних
		|		ПО (1 = 1)
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(_ВнешниеДанные.DealDate, ДЕНЬ) <> _ВнешниеДанные.RepaymentDate
		|	И _ВнешниеДанные.RepaymentDate <> ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ Сделка.ПометкаУдаления
		|	И _ДублиСделок_1С.НомерСделки ЕСТЬ NULL
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Сделка.ВидСделки,
		|	НомерСделки,
		|	ЦенныеБумагиНомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИсполнениеОбязательствПоСделке.Ссылка КАК Ссылка,
		|	ИсполнениеОбязательствПоСделке.ВерсияДанных КАК ВерсияДанных,
		|	ИсполнениеОбязательствПоСделке.ПометкаУдаления КАК ПометкаУдаления,
		|	ИсполнениеОбязательствПоСделке.Номер КАК Номер,
		|	ИсполнениеОбязательствПоСделке.Дата КАК Дата,
		|	ИсполнениеОбязательствПоСделке.Проведен КАК Проведен,
		|	ИсполнениеОбязательствПоСделке.Организация КАК Организация,
		|	ИсполнениеОбязательствПоСделке.Основание КАК Основание,
		|	ИсполнениеОбязательствПоСделке.ВидЗадолженности КАК ВидЗадолженности,
		|	ИсполнениеОбязательствПоСделке.ВидСделки КАК ВидСделки,
		|	ИсполнениеОбязательствПоСделке.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ИсполнениеОбязательствПоСделке.Рынок КАК Рынок,
		|	ИсполнениеОбязательствПоСделке.Брокер КАК Брокер,
		|	ИсполнениеОбязательствПоСделке.МестоХранения КАК МестоХранения,
		|	ИсполнениеОбязательствПоСделке.РасчетныйСчет КАК РасчетныйСчет,
		|	ИсполнениеОбязательствПоСделке.ВалютаСделки КАК ВалютаСделки,
		|	ИсполнениеОбязательствПоСделке.КонтрагентНаБирже КАК КонтрагентНаБирже,
		|	ИсполнениеОбязательствПоСделке.Ответственный КАК Ответственный,
		|	ИсполнениеОбязательствПоСделке.Комментарий КАК Комментарий,
		|	ИсполнениеОбязательствПоСделкеЦенныеБумаги.НомерСтроки КАК НомерСтроки,
		|	ВЫРАЗИТЬ(ИсполнениеОбязательствПоСделке.Основание КАК Документ.Сделка).НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _Исполнения_1С
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК ИсполнениеОбязательствПоСделкеЦенныеБумаги
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИсполнениеОбязательствПоСделке КАК ИсполнениеОбязательствПоСделке
		|		ПО ИсполнениеОбязательствПоСделкеЦенныеБумаги.Ссылка = ИсполнениеОбязательствПоСделке.Ссылка
		|ГДЕ
		|	(НАЧАЛОПЕРИОДА(ИсполнениеОбязательствПоСделке.Основание.Дата, ДЕНЬ) = &Период
		|				И ИсполнениеОбязательствПоСделке.Организация = &Организация
		|				И ИсполнениеОбязательствПоСделке.Брокер = &Брокер
		|				И НЕ ИсполнениеОбязательствПоСделке.ПометкаУдаления
		|				И ИсполнениеОбязательствПоСделке.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|			ИЛИ ИсполнениеОбязательствПоСделке.Ссылка ЕСТЬ NULL)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Исполнения_1С.Ссылка) КАК Количество,
		|	_Исполнения_1С.НомерСтроки КАК НомерСтроки,
		|	_Исполнения_1С.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _ДублиИсполнений_1С
		|ИЗ
		|	_Исполнения_1С КАК _Исполнения_1С
		|
		|СГРУППИРОВАТЬ ПО
		|	_Исполнения_1С.НомерСтроки,
		|	_Исполнения_1С.НомерСделки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _Исполнения_1С.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(_СделкиКВИК.НомерСделки, 0) КАК НовНомерСделки,
		|	&ТекущиеИНовыеРеквизиты КАК ТекущиеИНовыеРеквизиты,
		|	Сделка.Ссылка КАК Документ,
		|	ВЫБОР
		|		КОГДА Сделка.Ссылка ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЭтоНовыйДокумент,
		|	ВЫБОР
		|		КОГДА _СделкиКВИК.Дата ЕСТЬ NULL
		|				ИЛИ Сделка.Ссылка ЕСТЬ NULL
		|				ИЛИ НЕ Сделка.Проведен
		|					И _СделкиКВИК.Дата <= &ТекущаяДата
		|				ИЛИ Сделка.Проведен
		|					И _СделкиКВИК.Дата > &ТекущаяДата
		|				ИЛИ &УсловиеПоискаРасхождений
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьРасхождения,
		|	1 КАК P_LotSize
		|ПОМЕСТИТЬ _ИмпортируемыеСделки
		|ИЗ
		|	Документ.ИсполнениеОбязательствПоСделке.ЦенныеБумаги КАК СделкаЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _Исполнения_1С КАК Сделка
		|			ЛЕВОЕ СОЕДИНЕНИЕ _ДублиИсполнений_1С КАК _ДублиИсполнений_1С
		|			ПО Сделка.НомерСделки = _ДублиИсполнений_1С.НомерСделки
		|		ПО СделкаЦенныеБумаги.Ссылка = Сделка.Ссылка
		|		ПОЛНОЕ СОЕДИНЕНИЕ _СделкиКВИК КАК _СделкиКВИК
		|		ПО (Сделка.Организация = _СделкиКВИК.Организация)
		|			И (Сделка.ВидСделки = _СделкиКВИК.ВидСделки)
		|			И (Сделка.НомерСделки = _СделкиКВИК.НомерСделки)
		|			И СделкаЦенныеБумаги.НомерСтроки = _СделкиКВИК.ЦенныеБумагиНомерСтроки
		|ГДЕ
		|	_ДублиИсполнений_1С.НомерСделки ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ИмпортируемыеСделки.НовНомерСделки КАК НомерСделки,
		|	NULL КАК Документ,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ _ОшибкиИмпортируемыхИсполнений
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НовНомерСделки <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	_ИмпортируемыеСделки.НовНомерСделки,
		|	_ИмпортируемыеСделки.Документ
		|
		|ИМЕЮЩИЕ
		|	СУММА(1) > 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ИмпортируемыеСделки.НовНомерСделки,
		|	_ИмпортируемыеСделки.Документ,
		|	1
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|ГДЕ
		|	_ИмпортируемыеСделки.НовНомерСделки = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Звездочка КАК Звездочка
		|ИЗ
		|	_ИмпортируемыеСделки КАК _ИмпортируемыеСделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиИмпортируемыхИсполнений КАК _ОшибкиИмпортируемыхИсполнений
		|		ПО _ИмпортируемыеСделки.НовНомерСделки = _ОшибкиИмпортируемыхИсполнений.НомерСделки
		|ГДЕ
		|	&ЕстьРасхождения
		|	И _ОшибкиИмпортируемыхИсполнений.НомерСделки ЕСТЬ NULL"
		+
		"
		|УПОРЯДОЧИТЬ ПО
		|	НовНомерСделки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _СделкиКВИК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _Исполнения_1С
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ИмпортируемыеСделки";
#КонецОбласти
	
	ДополнитьТекстЗапросаТекущимиИНовымиРеквизитами(Запрос.Текст, Метаданные.Документы.ИсполнениеОбязательствПоСделке,
		"Депозитарий, Ответственный, Комментарий, ЦенныеБумаги.Портфель, ЦенныеБумаги.СтрокаПартии, ЦенныеБумаги.УчетныйАктивЕПС", "", "");
		
	Запрос.УстановитьПараметр("Период"     , ЭтотОбъект.ДатаИмпорта);
	Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
	Запрос.УстановитьПараметр("Брокер"     , Брокер);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьРасхождения", ?(ЭтотОбъект.ОтображатьТолькоРасхождения, "ЕстьРасхождения", "Истина"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Звездочка КАК Звездочка", "*");
	
	Попытка
		ИмпортируемыеДанные = Запрос.Выполнить().Выгрузить();
		
		ДублиИсполнений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ДублиИсполнений_1С"].ПолучитьДанные().Выбрать();
		Пока ДублиИсполнений.Следующий() Цикл
			ЗарегистрироватьОшибкуИмпорта("В базе обнаружены дубли исполнений сделок. У сделки [" + ДублиИсполнений.НомерСделки + "] " + Строка(ДублиИсполнений.Количество) + " исполнени" + ?(ДублиИсполнений.Количество > 4, "й", "я") + ".");
		КонецЦикла;
		
		ОшибкиИмпортируемыхИсполнений = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиИмпортируемыхИсполнений"].ПолучитьДанные().Выбрать();
		Пока ОшибкиИмпортируемыхИсполнений.Следующий() Цикл
			Если ОшибкиИмпортируемыхИсполнений.НомерСделки = 0 Тогда
				ЗарегистрироватьОшибкуИмпорта("В 1С обнаружен документ [" + ОшибкиИмпортируемыхИсполнений.Документ + "], для которого не удалось определить сделку основание из данных QUIKа. Проверьте вывод данных (ODBC) из QUIKа.");
			Иначе
				ЗарегистрироватьОшибкуИмпорта("Исполнение обязательств по сделке [" + ОшибкиИмпортируемыхИсполнений.НомерСделки + "] не будет загружено, т.к. при формировании данных для загрузки обнаружено несколько записей [" + Строка(ОшибкиИмпортируемыхИсполнений.Количество) + "].");
			КонецЕсли;	
		КонецЦикла;
		
		Если ДублиИсполнений.Количество() > 0 Или ОшибкиИмпортируемыхИсполнений.Количество() > 0 Тогда
			Возврат Неопределено;
		Конецесли;
		
	Исключение
		ЗарегистрироватьОшибкуИмпорта(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ПроверитьЗаполнениеИмпортируемыхСделок(ИмпортируемыеДанные, Ложь, "ИсполнениеОбязательствПоСделке");
	
	Возврат ИмпортируемыеДанные;
		
КонецФункции // ИмпортироватьБудущиеИсполненияОбязательствПоСделкам

&НаСервере
Процедура УдалитьВременныеТаблицы(ВидДокумента, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Если ВидДокумента = "Сделка" Тогда
		
		Запрос.Текст =
			"УНИЧТОЖИТЬ _ДублиСделок_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ДублиИсполнений_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхСделок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхИсполнений";
		
	ИначеЕсли ВидДокумента = "СделкаРЕПО" Тогда
	
		Запрос.Текст = 
			"УНИЧТОЖИТЬ _ДублиСделокРЕПО_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхСделокРЕПО"; 
		
	ИначеЕсли ВидДокумента = "СделкаСВалютой" Тогда
		
		Запрос.Текст =
			"УНИЧТОЖИТЬ _ДублиСделокСВалютой_1С
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ _ОшибкиИмпортируемыхСделокСВалютой";
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры



&НаСервере
Функция УстранитьРасхождения(ИмпортируемыеДанные, ВидДокумента)
	
	Если ВидДокумента = "СделкаРЕПО" Тогда 
		СхлопнутьДвеЧастиСделкиРЕПО(ИмпортируемыеДанные);
	КонецЕсли;
	
	Если ТипЗнч(ИмпортируемыеДанные) <> Тип("ТаблицаЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//Данные для статистики
	Проведено      = 0;
	ПроведеноНовых = 0;
	Записано       = 0;
	ЗаписаноНовых  = 0;
	Распроведено   = 0;
		
	Для каждого СтрокаИмпортируемыеДанные Из ИмпортируемыеДанные Цикл
		
		Если Не СтрокаИмпортируемыеДанные.ЕстьРасхождения Тогда // пропускаем ранее не изменнные документы
			
			//в доп сведения запишем контрагента без редактирования самого документа
			Если ВидДокумента = "Сделка" И Не СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент И СтрокаИмпортируемыеДанные.ЕстьРасхожденияВДопСведениях Тогда
				РаботаСформами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(СтрокаИмпортируемыеДанные.Документ, "_РаскрытыйКонтрагент", СтрокаИмпортируемыеДанные.НовКонтрагентВДопСведения);	
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		//Вторые части сделок Репо загружаются одновременно с первыми частями
		//Т.к. у второй части не заполнен реквизит "Первая часть сделки репо" -> падает ошибка проверки заполнения
		Если ВидДокумента = "СделкаРЕПО" Тогда   
			
			Если СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент И СтрокаИмпортируемыеДанные.НовЧастьСделкиРепо = 2 И СтрокаИмпортируемыеДанные.НовПерваяЧастьРЕПО = NULL Тогда
				//Это не ошибка, вторая часть загрузиться при следующем запуске регламентного задания (когда в базе будет первая часть)
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		
		ОписаниеРасхождений = Новый Структура("Шапка", "");
		
		Если ВидДокумента <> "СделкаСВалютой" Тогда
		// документы с корзиной ценных бумаг пропускаем
			Если ТипЗнч(СтрокаИмпортируемыеДанные.НовЦенныеБумагиНомерСтроки) = Тип("Число") И СтрокаИмпортируемыеДанные.НовЦенныеБумагиНомерСтроки > 1 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(СтрокаИмпортируемыеДанные.ТекЦенныеБумагиНомерСтроки) = Тип("Число") И СтрокаИмпортируемыеДанные.ТекЦенныеБумагиНомерСтроки > 1 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		// создадим новый или получим существующий документ
		Если СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент Тогда
			
			Документ = Документы[ВидДокумента].СоздатьДокумент();
			
			Документ.Ответственный = РаботаСПользователями.ТекущийПользователь();
			Документ.Комментарий   = "Создан аппаратно-техническими средствами " + ТекущаяДата();
			
		Иначе
			
			Документ = СтрокаИмпортируемыеДанные.Документ.ПолучитьОбъект();
			
		КонецЕсли;
		
		// пометим на удаление документы, отсутствующие в КВИК-е
		Если Не ЗначениеЗаполнено(СтрокаИмпортируемыеДанные.НовНомерСделки) Тогда
			
			Документ.УстановитьПометкуУдаления(Истина);
			
			ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Информация,
				Документ.Метаданные(), Документ.Ссылка, "Помечен на удаление как отсутствующий в КВИК-е",
				РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
				
			Продолжить;
					
		КонецЕсли;
		
		ДокументМД = Метаданные.Документы[ВидДокумента];
		
		// поиск и устранение расхождений среди реквизитов шапки
		Если СтрокаИмпортируемыеДанные.НовДата <> СтрокаИмпортируемыеДанные.ТекДата Тогда
			
			Документ.Дата = СтрокаИмпортируемыеДанные.НовДата;
			
			ОписаниеРасхождений.Шапка = Символы.ПС + "Дата: [" + СтрокаИмпортируемыеДанные.ТекДата + "] -> [" + СтрокаИмпортируемыеДанные.НовДата + "]";
			
		КонецЕсли;		
		
		Для каждого РеквизитМД Из ДокументМД.Реквизиты Цикл
			
			ИмяПоля = РеквизитМД.Имя;
			
			Если ИмпортируемыеДанные.Колонки.Найти("Нов" + ИмяПоля) = Неопределено Или ИмпортируемыеДанные.Колонки.Найти("Тек" + ИмяПоля) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекущееЗначение = СтрокаИмпортируемыеДанные["Тек" + ИмяПоля];
			НовоеЗначение   = СтрокаИмпортируемыеДанные["Нов" + ИмяПоля];
			
			Если НовоеЗначение <> ТекущееЗначение Тогда
				
				Документ[ИмяПоля] = НовоеЗначение;
				
				ОписаниеРасхождений.Шапка = ОписаниеРасхождений.Шапка
					+ Символы.ПС + "   " + ИмяПоля + ": [" + Строка(ТекущееЗначение) + "] -> [" + Строка(НовоеЗначение) + "]";
				
			КонецЕсли;
			
		КонецЦикла;
		
		// поиск и устранение расхождений среди реквизитов табличных частях
		Для каждого ТабЧастьМД Из ДокументМД.ТабличныеЧасти Цикл
			
			Если СтрокаИмпортируемыеДанные["Нов" + ТабЧастьМД.Имя + "НомерСтроки"] = 0 Тогда // создание строк не требуется
				Если Документ[ТабЧастьМД.Имя].Количество() > 0 Тогда
					ОписаниеРасхождений.Вставить(ТабЧастьМД.Имя, "");
					ОписаниеРасхождений[ТабЧастьМД.Имя] = ОписаниеРасхождений[ТабЧастьМД.Имя]
						+ Символы.ПС + "   КоличествоСтрок: [" + Документ[ТабЧастьМД.Имя].Количество() + "] -> [0]";
						
					Документ[ТабЧастьМД.Имя].Очистить();
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			СтрокаТабЧ = Неопределено;
			
			Для каждого РеквизитМД Из ТабЧастьМД.Реквизиты Цикл
				
				ИмяПоля = ТабЧастьМД.Имя + РеквизитМД.Имя;
				
				Если ИмпортируемыеДанные.Колонки.Найти("Нов" + ИмяПоля) = Неопределено Или ИмпортируемыеДанные.Колонки.Найти("Тек" + ИмяПоля) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаТабЧ = Неопределено Тогда
					СтрокаТабЧ = ?(Документ[ТабЧастьМД.Имя].Количество() = 0, Документ[ТабЧастьМД.Имя].Добавить(), Документ[ТабЧастьМД.Имя][0]);
				КонецЕсли;
				
				ТекущееЗначение = СтрокаИмпортируемыеДанные["Тек" + ИмяПоля];
				НовоеЗначение   = СтрокаИмпортируемыеДанные["Нов" + ИмяПоля];
				
				Если НовоеЗначение <> ТекущееЗначение Тогда
				
					СтрокаТабЧ[РеквизитМД.Имя] = НовоеЗначение;
					
					Если Не ОписаниеРасхождений.Свойство(ТабЧастьМД.Имя) Тогда
						ОписаниеРасхождений.Вставить(ТабЧастьМД.Имя, "");
					КонецЕсли;
					
					ОписаниеРасхождений[ТабЧастьМД.Имя] = ОписаниеРасхождений[ТабЧастьМД.Имя]
						+ Символы.ПС + "   " + РеквизитМД.Имя + ": [" + Строка(ТекущееЗначение) + "] -> [" + Строка(НовоеЗначение) + "]";
				
				КонецЕсли;
			
			КонецЦикла;
			
							
			
		КонецЦикла;
		
		// запись изменений
		Если Документ.ПроверитьЗаполнение() Тогда
		//	Если Истина Тогда

			
			Если Документ.Дата <= КонецДня(ТекущаяДата()) Тогда
				
				ДокументОшибкаПроведения = Ложь;
	
				Попытка
					
					//!!! Для этапа тестирования, после тестирования вернуть ПРОВЕДЕНИЕ!!!
					//Документ.Записать(РежимЗаписиДокумента.Проведение);
					Документ.Записать(РежимЗаписиДокумента.Проведение);
					Проведено = Проведено + 1;
					ПроведеноНовых = ?(СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент, ПроведеноНовых + 1, ПроведеноНовых);					
				Исключение
					ЗарегистрироватьОшибкуИмпорта("Не удалось провести документ " + Документ + ". Организация [" + Документ.Организация + "], счет ДУ [" + Документ.СчетДоверительногоУправления + "]" + ?(ВидДокумента = "ИсполнениеОбязательствПоСделке", ".", ", номер сделки [" + Документ.НомерСделки + "].") + Символы.ПС + ОписаниеОшибки());
					ДокументОшибкаПроведения = Истина;
				КонецПопытки;
			
				Если ДокументОшибкаПроведения Тогда
				
					Попытка
						Документ.Записать(РежимЗаписиДокумента.Запись);
						Записано = Записано + 1;
						ЗаписаноНовых = ?(СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент, ЗаписаноНовых + 1, ЗаписаноНовых);					
					Исключение
						ЗарегистрироватьОшибкуИмпорта("Не удалось записать документ " + Документ + ". Организация [" + Документ.Организация + "], счет ДУ [" + Документ.СчетДоверительногоУправления + "]" + ?(ВидДокумента = "ИсполнениеОбязательствПоСделке", ".", ", номер сделки [" + Документ.НомерСделки + "].") + Символы.ПС + ОписаниеОшибки());
					КонецПопытки;
					
				КонецЕсли;
											
			Иначе
				
				Если Документ.Проведен Тогда
					Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					Распроведено = Распроведено + 1;
				Иначе
					Документ.Записать(РежимЗаписиДокумента.Запись);
					Записано = Записано + 1;
					ЗаписаноНовых = ?(СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент, ЗаписаноНовых + 1, ЗаписаноНовых);
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			ЗарегистрироватьОшибкуИмпорта("" + Документ + " не прошел проверку заполнения. " + ОписаниеОшибки());
		КонецЕсли;      
		
		//Заполнить документ  ИсполнениеОбязательствПоСделке
		Если ВидДокумента = "Сделка" тогда
			 	ДокументОбязательства = Документы["ИсполнениеОбязательствПоСделке"].СоздатьДокумент();     
				ДокументОбязательства.Дата = СтрокаИмпортируемыеДанные.НовДата;    
				ДокументОбязательства.Организация = Документ.Организация;
				ДокументОбязательства.Основание = Документ.Ссылка;
				ДокументОбязательства.Ответственный = РаботаСПользователями.ТекущийПользователь();
				ДокументОбязательства.Комментарий   = "Создан аппаратно-техническими средствами " + ТекущаяДата();
				ДокументОбязательства.ВидЗадолженности = Справочники.ВидыЗадолженности.ПоСделке; 
			    ДокументОбязательства.Рынок = Перечисления.РынкиЦенныхБумаг.Облигации;   
				ДокументОбязательства.ВалютаСделки = СтрокаИмпортируемыеДанные.НовВалютаСделки;
				ДокументОбязательства.Брокер = ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ");
				ДокументОбязательства.МестоХранения = СтрокаИмпортируемыеДанные.НовМестоХранения;  
				ДокументОбязательства.СчетДоверительногоУправления = СтрокаИмпортируемыеДанные.НовСчетДоверительногоУправления;  
				
				ДокументОбязательстваТЧ = ДокументОбязательства["ЦенныеБумаги"].Добавить();
				ДокументОбязательстваТЧ.ДепозитарныйСчет = СтрокаИмпортируемыеДанные.НовЦенныеБумагиДепозитарныйСчет;
				ДокументОбязательстваТЧ.ЦеннаяБумага = СтрокаИмпортируемыеДанные.НовЦенныеБумагиЦеннаяБумага;
				ДокументОбязательстваТЧ.Количество = СтрокаИмпортируемыеДанные.НовЦенныеБумагиКоличество;
				ДокументОбязательстваТЧ.Сумма = СтрокаИмпортируемыеДанные.НовЦенныеБумагиСумма;
				ДокументОбязательстваТЧ.Цена = СтрокаИмпортируемыеДанные.НовЦенныеБумагиЦена;
				ДокументОбязательстваТЧ.СуммаКупона = СтрокаИмпортируемыеДанные.НовЦенныеБумагиСуммаКупона;
				ДокументОбязательстваТЧ.ЦенаКупона = СтрокаИмпортируемыеДанные.НовЦенныеБумагиЦенаКупона;
				ДокументОбязательстваТЧ.ЦенаПроцент = СтрокаИмпортируемыеДанные.НовЦенныеБумагиЦенаПроцент;
				
				ДокументОбязательства.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;

		
		// оповещения об изменениях
		Если СтрокаИмпортируемыеДанные.ЭтоНовыйДокумент Тогда
			Сообщение = "Документ " + Документ + " " + ?(Документ.Проведен, "записан и проведен", "записан");
		Иначе
					
			Сообщение = "";
			Если ОписаниеРасхождений.Шапка <> "" Тогда
				Сообщение = ОписаниеРасхождений.Шапка;	
			КонецЕсли;
			
			Для каждого КлючЗначение Из ОписаниеРасхождений Цикл
				Если КлючЗначение.Ключ <> "Шапка" Тогда
					Сообщение = Сообщение + Символы.ПС + " " + КлючЗначение.Ключ + "[0]:" + КлючЗначение.Значение;
				КонецЕсли;
			КонецЦикла;
			
			Если Сообщение = "" Тогда
				Сообщение = "Документ " + Документ + " " + ?(Документ.Проведен, "проведен", "попытка проводения");
			Иначе	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Документ + " изменен: " + Сообщение);
			КонецЕсли;
			
		КонецЕсли;
		
		//Запись раскрываемого контрагента в доп. сведения
		Если ВидДокумента = "Сделка" И Не Документ.ЭтоНовый() И СтрокаИмпортируемыеДанные.ЕстьРасхожденияВДопСведениях Тогда
			РаботаСформами.ЗаписатьЗначениеДополнительногоСведенияОбъекта(Документ.Ссылка, "_РаскрытыйКонтрагент", СтрокаИмпортируемыеДанные.НовКонтрагентВДопСведения); 	
		КонецЕсли;
	
		ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Информация,
			Документ.Метаданные(), Документ.Ссылка, Сообщение);
		
	КонецЦикла;
		
	Если Проведено = 0 И Записано = 0 И Распроведено = 0 Тогда
		Возврат Неопределено;
	Иначе
		ДанныеДляСтатистики = Новый Структура("Проведено, Записано, Распроведено", "" + Проведено + "[новых " + ПроведеноНовых +"]", "" + Записано + "[новых " + ЗаписаноНовых +"]", Распроведено);
		Возврат ДанныеДляСтатистики;
	КонецЕсли;	
		
КонецФункции // УстранитьРасхождения

&НаСервере
Функция ИмпортироватьСделкиРЕПО(Брокер, ОбщиеПараметры, МВТ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
#Область ТЕКСТ_ЗАПРОСА	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Ссылка КАК Ссылка,
		|	СделкаРЕПО.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	СделкаРЕПО.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _СделкиРЕПО_1С
		|ИЗ
		|	Документ.СделкаРЕПО КАК СделкаРЕПО
		|ГДЕ
		|	СделкаРЕПО.Организация = &Организация
		|	И НЕ СделкаРЕПО.ПометкаУдаления
		|	И СделкаРЕПО.Брокер = &Брокер
		|	И СделкаРЕПО.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ВнебиржевойРынок)
		|	И (СделкаРЕПО.ЧастьСделкиРЕПО = 1
		|				И НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ) = &Период
		|			ИЛИ СделкаРЕПО.ЧастьСделкиРЕПО = 2
		|				И НАЧАЛОПЕРИОДА(СделкаРЕПО.ПерваяЧастьРЕПО.Дата, ДЕНЬ) = &Период)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СделкиРЕПО_1С.Ссылка) КАК Количество,
		|	_СделкиРЕПО_1С.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_СделкиРЕПО_1С.НомерСделки КАК НомерСделки
		|ПОМЕСТИТЬ _ДублиСделокРЕПО_1С
		|ИЗ
		|	_СделкиРЕПО_1С КАК _СделкиРЕПО_1С
		|ГДЕ
		|	_СделкиРЕПО_1С.НомерСделки <> """"
		|
		|СГРУППИРОВАТЬ ПО
		|	_СделкиРЕПО_1С.ЧастьСделкиРЕПО,
		|	_СделкиРЕПО_1С.НомерСделки
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ _СделкиРЕПО_1С.Ссылка) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СделкиРЕПО_1С.Ссылка КАК Ссылка,
		|	_СделкиРЕПО_1С.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
		|	_СделкиРЕПО_1С.НомерСделки КАК НомерСделки,
		|	СделкаРЕПОЦенныеБумаги.ДепозитарныйСчет КАК ДепозитарныйСчет
		|ПОМЕСТИТЬ _СделкиРЕПО
