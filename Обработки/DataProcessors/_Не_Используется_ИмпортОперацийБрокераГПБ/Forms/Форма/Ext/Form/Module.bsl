		|	_ВсеСделкиОтчет.НомерСделки КАК НомерСделки,
		|	_ВсеСделкиОтчет.ДатаСделки КАК ДатаСделки,
		|	_ВсеСделкиОтчет.ВидСделки КАК ВидСделки,
		|	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага,
		|	_ВсеСделкиОтчет.СуммаСделки КАК СуммаСделки,
		|	_ВсеСделкиОтчет.ЦенаНоминалПроц КАК ЦенаНоминалПроц,
		|	_ВсеСделкиОтчет.Купон КАК Купон,
		|	0 КАК СтавкаРЕПО,
		|	0 КАК ЧастьСделкиРЕПО,
		|	_ВсеСделкиОтчет.БумагиКоличество КАК БумагиКоличество,
		|	_ВсеСделкиОтчет.ТорговаяКомиссия КАК ТорговаяКомиссия,
		|	_ВсеСделкиОтчет.ДатаИсполнения КАК ДатаИсполнения,
		|	_ВсеСделкиОтчет.КодЦеннойБумаги КАК КодЦеннойБумаги,
		|	_ВсеСделкиОтчет.КомиссияБрокера КАК КомиссияБрокера
		|ПОМЕСТИТЬ _ДанныеДляСверки_ИсполненияСделок
		|ИЗ
		|	_ВсеСделкиОтчет КАК _ВсеСделкиОтчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО _ВсеСделкиОтчет.КодСчетаДоверительногоУправления = _СчетаДоверительногоУправления.КодСчета
		|			И _ВсеСделкиОтчет.ИмяФайла = _СчетаДоверительногоУправления.ИмяФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
		|		ПО _ВсеСделкиОтчет.КодЦеннойБумаги = _ЦенныеБумаги.Код
		|			И _ВсеСделкиОтчет.ИмяФайла = _ЦенныеБумаги.ИмяФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиСчетовДоверительногоУправления КАК _ОшибкиСчетовДоверительногоУправления
		|		ПО _ВсеСделкиОтчет.КодСчетаДоверительногоУправления = _ОшибкиСчетовДоверительногоУправления.КодСчета
		|			И _ВсеСделкиОтчет.ИмяФайла = _ОшибкиСчетовДоверительногоУправления.ИмяФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиЦенныхБумаг КАК _ОшибкиЦенныхБумаг
		|		ПО _ВсеСделкиОтчет.КодЦеннойБумаги = _ОшибкиЦенныхБумаг.Код
		|			И _ВсеСделкиОтчет.ИмяФайла = _ОшибкиЦенныхБумаг.ИмяФайла
		|ГДЕ
		|	_ВсеСделкиОтчет.ИмяЗаписи = ""ИсполнениеОбязательствПоСделке""
		|	И _ОшибкиСчетовДоверительногоУправления.КодСчета ЕСТЬ NULL
		|	И _ОшибкиЦенныхБумаг.Код ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗадолженностиПоСделкамОтчет.ИмяФайла КАК ИмяФайла,
		|	_ЗадолженностиПоСделкамОтчет.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
		|	_СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	_ЗадолженностиПоСделкамОтчет.НомерСделки КАК НомерСделки,
		|	_ЗадолженностиПоСделкамОтчет.ДатаСделки КАК ДатаСделки,
		|	_ЗадолженностиПоСделкамОтчет.ВидСделки КАК ВидСделки,
		|	_ЦенныеБумаги.Ссылка КАК ЦеннаяБумага,
		|	_ЗадолженностиПоСделкамОтчет.СуммаЗадолженностиПоСделке КАК СуммаЗадолженностиПоСделке,
		|	_ЗадолженностиПоСделкамОтчет.СуммаЗадолженностиПоКупону КАК СуммаЗадолженностиПоКупону,
		|	_ЗадолженностиПоСделкамОтчет.СуммаЗадолженностиПоТорговойКомиссии КАК СуммаЗадолженностиПоТорговойКомиссии,
		|	_ЗадолженностиПоСделкамОтчет.СуммаЗадолженностиПоБрокерскойКомиссии КАК СуммаЗадолженностиПоБрокерскойКомиссии,
		|	_ЗадолженностиПоСделкамОтчет.КоличествоЗадолженностиПоБумагам КАК КоличествоЗадолженностиПоБумагам
		|ПОМЕСТИТЬ _ДанныеДляСверки_ЗадолженностиПоСделкам
		|ИЗ
		|	_ЗадолженностиПоСделкамОтчет КАК _ЗадолженностиПоСделкамОтчет
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СчетаДоверительногоУправления КАК _СчетаДоверительногоУправления
		|		ПО _ЗадолженностиПоСделкамОтчет.КодСчетаДоверительногоУправления = _СчетаДоверительногоУправления.КодСчета
		|			И _ЗадолженностиПоСделкамОтчет.ИмяФайла = _СчетаДоверительногоУправления.ИмяФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЦенныеБумаги КАК _ЦенныеБумаги
		|		ПО _ЗадолженностиПоСделкамОтчет.КодЦеннойБумаги = _ЦенныеБумаги.Код
		|			И _ЗадолженностиПоСделкамОтчет.ИмяФайла = _ЦенныеБумаги.ИмяФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиСчетовДоверительногоУправления КАК _ОшибкиСчетовДоверительногоУправления
		|		ПО _ЗадолженностиПоСделкамОтчет.КодСчетаДоверительногоУправления = _ОшибкиСчетовДоверительногоУправления.КодСчета
		|			И _ЗадолженностиПоСделкамОтчет.ИмяФайла = _ОшибкиСчетовДоверительногоУправления.ИмяФайла
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ОшибкиЦенныхБумаг КАК _ОшибкиЦенныхБумаг
		|		ПО _ЗадолженностиПоСделкамОтчет.КодЦеннойБумаги = _ОшибкиЦенныхБумаг.Код
		|			И _ЗадолженностиПоСделкамОтчет.ИмяФайла = _ОшибкиЦенныхБумаг.ИмяФайла
		|ГДЕ
		|	_ОшибкиСчетовДоверительногоУправления.КодСчета ЕСТЬ NULL
		|	И _ОшибкиЦенныхБумаг.Код ЕСТЬ NULL";
	
	#КонецОбласти

	Запрос.УстановитьПараметр("ДатаСверки",				ОбщиеПараметры.ДатаСверки);
	Запрос.УстановитьПараметр("Организация",			ОбщиеПараметры.Организация);
	Запрос.УстановитьПараметр("Брокер",					ОбщиеПараметры.Брокер);
	Запрос.УстановитьПараметр("ОстаткиДенежныхСредств",	ОстаткиДенежныхСредств);
	Запрос.УстановитьПараметр("ОстаткиЦенныхБумаг",		ОстаткиЦенныхБумаг);
	Запрос.УстановитьПараметр("Сделки",					Сделки);
	Запрос.УстановитьПараметр("ЗадолженностиПоСделкам",	ЗадолженностиПоСделкам);

	Запрос.Выполнить();
	
	#Область Обработка_ошибок_сопоставления_данных
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиЦенныхБумаг"].ПолучитьДанные().Выбрать();
	Пока ВыборкаОшибок.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.Код, ВыборкаОшибок.ИмяФайла));	
	КонецЦикла;
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиСчетовДоверительногоУправления"].ПолучитьДанные().Выбрать();
	Пока ВыборкаОшибок.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.КодСчета, ВыборкаОшибок.ИмяФайла));		
	КонецЦикла;
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиМестаХранения"].ПолучитьДанные().Выбрать();
	Пока ВыборкаОшибок.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.ИмяМестаХранения, ВыборкаОшибок.ИмяФайла));		
	КонецЦикла;
	
	ВыборкаОшибок = Запрос.МенеджерВременныхТаблиц.Таблицы["_ОшибкиВалюты"].ПолучитьДанные().Выбрать();
	Пока ВыборкаОшибок.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ВыборкаОшибок.ТекстОшибки, ВыборкаОшибок.ИмяВалютыРасчетов, ВыборкаОшибок.ИмяФайла));	
	КонецЦикла;

	#КонецОбласти
	
	ОстаткиДенежныхСредств			= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляСверки_ОстаткиДенежныхСредств"].ПолучитьДанные().Выгрузить();
	ОстаткиЦенныхБумаг				= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляСверки_ОстаткиЦенныхБумаг"].ПолучитьДанные().Выгрузить();
	Сделки							= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляСверки_Сделки"].ПолучитьДанные().Выгрузить();
	СделкиРепо						= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляСверки_СделкиРепо"].ПолучитьДанные().Выгрузить();
	ИсполненияОбязательствПоСделкам	= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляСверки_ИсполненияСделок"].ПолучитьДанные().Выгрузить();
	ЗадолженностиПоСделкам			= Запрос.МенеджерВременныхТаблиц.Таблицы["_ДанныеДляСверки_ЗадолженностиПоСделкам"].ПолучитьДанные().Выгрузить();
	
	СчетаДоверительногоУправления	= Запрос.МенеджерВременныхТаблиц.Таблицы["_СчетаДоверительногоУправления"].ПолучитьДанные().Выгрузить();
	ТаблицаПараметров				= Запрос.МенеджерВременныхТаблиц.Таблицы["_ПараметрыОтчета"].ПолучитьДанные().Выгрузить();
 
	РезультатВыполнения	= Новый Структура;
	
	ИмпортируемыеДанные = Новый Структура("Сделки, ИсполненияОбязательствПоСделкам, БудущиеИсполненияОбязательствПоСделкам, СделкиРЕПО, СделкиСВалютой");
	ДанныеДляСтатистики = Новый Структура("Сделки, ИсполненияОбязательствПоСделкам, БудущиеИсполненияОбязательствПоСделкам, СделкиРЕПО, СделкиСВалютой");
	
	//МВТ = ПолучитьМенеджерВременныхТаблицСДанными(СделкиРепо, ОбщиеПараметры, ТаблицаПараметров, "СделкиРепо");	
	
	ИмпортироватьГруппуОбъектов(Сделки, "Сделка", ОбщиеПараметры, ТаблицаПараметров, ИмпортируемыеДанные, ДанныеДляСтатистики);
	ИмпортироватьГруппуОбъектов(ИсполненияОбязательствПоСделкам, "Сделка", ОбщиеПараметры, ТаблицаПараметров, ИмпортируемыеДанные, ДанныеДляСтатистики);
	ИмпортироватьГруппуОбъектов(СделкиРепо, "СделкаРЕПО", ОбщиеПараметры, ТаблицаПараметров, ИмпортируемыеДанные, ДанныеДляСтатистики);
	
	
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаСервере
Функция ИмпортироватьКомиссиюБрокера(ДанныеОтчетовБрокера, ОбщиеПараметры, ИзмененияНачисленийЗадолженности, ИзмененияОплат)
	
	ПараметрыВыполненияДляСбораСтатистики = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(ОбщиеПараметры, "Организация, Брокер, ДатаСверки, ВремяСверки, ФиксироватьРезультатСверки");
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		"Сверка с брокером ГПБ. (ИмпортироватьКомиссиюБрокера)",
		ПараметрыВыполненияДляСбораСтатистики.Хранилище,
		ПараметрыВыполненияДляСбораСтатистики.Описание);

	СтруктураТаблицыКомиссииБрокера = ПолучитьСтруктуруТаблицы("КомиссияБрокера");
	ТаблицаДанных = Неопределено;
		
	Для Каждого ЭлементДанныеОтчета Из ДанныеОтчетовБрокера Цикл
		
		Если ЭлементДанныеОтчета.Операции <> Неопределено И ЭлементДанныеОтчета.Операции.Свойство("Сделки") Тогда  
		
			ДанныеОтчета = ПреобразоватьМассивСтруктурВТаблицуЗначений(СтруктураТаблицыКомиссииБрокера, ЭлементДанныеОтчета.Операции.Сделки, ЭлементДанныеОтчета.ПараметрыОтчета); 
			
			Если ТаблицаДанных = Неопределено Тогда
				ТаблицаДанных = ДанныеОтчета;  	
		    Иначе 
				РаботаСКоллекциями.ТаблицаЗначений_Дополнить(ДанныеОтчета, ТаблицаДанных);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаДанных <> Неопределено И ТаблицаДанных.Количество() > 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	#Область ТЕКСТ_ЗАПРОСА
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаДанных.ИмяФайла КАК ИмяФайла,
			|	ТаблицаДанных.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
			|	ТаблицаДанных.ИмяЗаписи КАК ИмяЗаписи,
			|	ТаблицаДанных.ДатаСделки КАК ДатаСделки,
			|	ТаблицаДанных.НомерСделки КАК НомерСделки,
			|	ТаблицаДанных.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
			|	ТаблицаДанных.ВидСделки КАК ВидСделки,
			|	ТаблицаДанных.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
			|	ТаблицаДанных.КодЦеннойБумаги КАК КодЦеннойБумаги,
			|	ТаблицаДанных.ИмяМестаХранения КАК ИмяМестаХранения,
			|	ТаблицаДанных.ИмяВалютыРасчетов КАК ИмяВалютыРасчетов,
			|	ТаблицаДанных.КомиссияБрокера КАК Сумма,
			|	ТаблицаДанных.ДатаОплатыКомиссии КАК ДатаОплаты
			|ПОМЕСТИТЬ _ТаблицаДанных
			|ИЗ
			|	&ТаблицаДанных КАК ТаблицаДанных
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ТаблицаДанных.ИмяФайла КАК ИмяФайла,
			|	_ТаблицаДанных.КодСчетаДоверительногоУправления КАК КодСчетаДоверительногоУправления,
			|	_ТаблицаДанных.ИмяЗаписи КАК ИмяЗаписи,
			|	_ТаблицаДанных.ДатаСделки КАК ДатаСделки,
			|	_ТаблицаДанных.НомерСделки КАК НомерСделки,
			|	_ТаблицаДанных.ЧастьСделкиРЕПО КАК ЧастьСделкиРЕПО,
			|	_ТаблицаДанных.ВидСделки КАК ВидСделки,
			|	_ТаблицаДанных.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
			|	_ТаблицаДанных.КодЦеннойБумаги КАК КодЦеннойБумаги,
			|	_ТаблицаДанных.ИмяМестаХранения КАК ИмяМестаХранения,
			|	_ТаблицаДанных.ИмяВалютыРасчетов КАК ИмяВалютыРасчетов,
			|	_ТаблицаДанных.Сумма КАК Сумма,
			|	_ТаблицаДанных.ДатаОплаты КАК ДатаОплаты
			|ПОМЕСТИТЬ _ДанныеФайлов
			|ИЗ
			|	_ТаблицаДанных КАК _ТаблицаДанных
			|ГДЕ
			|	_ТаблицаДанных.ЧастьСделкиРЕПО В (0, 1)
			|	И _ТаблицаДанных.Сумма > 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Акции.Ссылка КАК Ссылка,
			|	Акции.ГосударственныйРегистрационныйНомер КАК ГосРегНомер
			|ПОМЕСТИТЬ _ЦенныеБумаги
			|ИЗ
			|	Справочник.Акции КАК Акции
			|ГДЕ
			|	Акции.ГосударственныйРегистрационныйНомер В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Данные.КодЦеннойБумаги
			|			ИЗ
			|				_ДанныеФайлов КАК _Данные)
			|	И Акции.ПометкаУдаления = ЛОЖЬ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Облигации.Ссылка,
			|	Облигации.ГосударственныйРегистрационныйНомер
			|ИЗ
			|	Справочник.Облигации КАК Облигации
			|ГДЕ
			|	Облигации.ГосударственныйРегистрационныйНомер В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				_Данные.КодЦеннойБумаги
			|			ИЗ
			|				_ДанныеФайлов КАК _Данные)
			|	И Облигации.ПометкаУдаления = ЛОЖЬ
			|
