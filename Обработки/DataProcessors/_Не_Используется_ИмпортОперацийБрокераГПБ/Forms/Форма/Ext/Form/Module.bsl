Функция ПреобразоватьМассивСтруктурВТаблицуЗначений(КолонкиТаблицы, СодержимоеТаблицы, Параметры = Неопределено)
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Для каждого КлючЗнач Из КолонкиТаблицы Цикл
		ТаблицаЗначений.Колонки.Добавить(КлючЗнач.Ключ, КлючЗнач.Значение);
	КонецЦикла;
	
	Для каждого ЭлементСодержимоеТаблицы Из СодержимоеТаблицы Цикл
		
		НоваяСтрока = ТаблицаЗначений.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементСодержимоеТаблицы);
		
		Если Параметры <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры);
		КонецЕсли;

	КонецЦикла;
		
	Возврат ТаблицаЗначений;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруТаблицы(ИмяТаблицы)
	
	СтруктураТаблицы = Новый Структура();
	
	СтруктураТаблицы.Вставить("ИмяФайла", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(275)));
	СтруктураТаблицы.Вставить("ИмяМестаХранения", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	СтруктураТаблицы.Вставить("КодСчетаДоверительногоУправления", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100)));
	СтруктураТаблицы.Вставить("ИмяВалютыРасчетов", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	СтруктураТаблицы.Вставить("ИмяЗаписи", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));

	Если ИмяТаблицы = "Сделки" Тогда
	
		СделкаМД = Метаданные.Документы.Сделка;
		
		СтруктураТаблицы.Вставить("НомерСделки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(16)));
		СтруктураТаблицы.Вставить("ДатаСделки", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("ВидСделки", СделкаМД.Реквизиты.ВидСделки.Тип);
		СтруктураТаблицы.Вставить("БумагиКоличество", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		СтруктураТаблицы.Вставить("ЦенаНоминалПроц", Метаданные.ОпределяемыеТипы.ЦенныеБумагиЦена.Тип);
		СтруктураТаблицы.Вставить("СуммаСделки", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		СтруктураТаблицы.Вставить("Купон", Метаданные.ОпределяемыеТипы.ЦенныеБумагиСумма.Тип);
		СтруктураТаблицы.Вставить("КомиссияБрокера", Метаданные.ОпределяемыеТипы.СуммаКомиссии.Тип);
		СтруктураТаблицы.Вставить("ТорговаяКомиссия", Метаданные.ОпределяемыеТипы.СуммаКомиссии.Тип);
		СтруктураТаблицы.Вставить("ЧастьСделкиРЕПО", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(1)));
		
		СтруктураТаблицы.Вставить("СтавкаРЕПО", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(7, 4)));
		СтруктураТаблицы.Вставить("ОтложенноеИсполнение", Новый ОписаниеТипов("Булево"));
		СтруктураТаблицы.Вставить("ДатаИсполнения", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("ДатаОплатыКомиссии", Новый ОписаниеТипов("Дата"));
			
	ИначеЕсли ИмяТаблицы = "ЗадолженностиПоСделкам" Тогда
		
		СделкаМД = Метаданные.Документы.Сделка;
	
		СтруктураТаблицы.Вставить("НомерСделки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(16)));
		СтруктураТаблицы.Вставить("ДатаСделки", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("ВидСделки", СделкаМД.Реквизиты.ВидСделки.Тип);
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоСделке", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоКупону", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СтруктураТаблицы.Вставить("КоличествоЗадолженностиПоБумагам", Метаданные.ОпределяемыеТипы.ЦенныеБумагиКоличество.Тип);
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоТорговойКомиссии", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СтруктураТаблицы.Вставить("СуммаЗадолженностиПоБрокерскойКомиссии", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		
	ИначеЕсли ИмяТаблицы = "КомиссияБрокера" Тогда
		
		СделкаМД = Метаданные.Документы.Сделка;
		 
		СтруктураТаблицы.Вставить("ДатаСделки", Новый ОписаниеТипов("Дата"));
		СтруктураТаблицы.Вставить("НомерСделки", СделкаМД.Реквизиты.НомерСделки.Тип);
		СтруктураТаблицы.Вставить("ЧастьСделкиРЕПО", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1)));
		СтруктураТаблицы.Вставить("ВидСделки", СделкаМД.Реквизиты.ВидСделки.Тип);
		
		СтруктураТаблицы.Вставить("ОтложенноеИсполнение", Новый ОписаниеТипов("Булево"));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("КомиссияБрокера", Метаданные.ОпределяемыеТипы.ДенежныеСуммы.Тип);
		СтруктураТаблицы.Вставить("ДатаОплатыКомиссии", Новый ОписаниеТипов("Дата"));
			
	ИначеЕсли ИмяТаблицы = "ОстаткиДенежныхСредств" Тогда
	
		РегистрМД = Метаданные.РегистрыНакопления.ОстаткиДенежныхСредств;
		
		СтруктураТаблицы.Вставить("СуммаНачальныйОстаток", РегистрМД.Ресурсы.Сумма.Тип);
		СтруктураТаблицы.Вставить("СуммаКонечныйОстаток", РегистрМД.Ресурсы.Сумма.Тип);
		
	ИначеЕсли ИмяТаблицы = "ОстаткиЦенныхБумаг" Тогда
		
		РегистрМД = Метаданные.РегистрыНакопления.ОстаткиЦенныхБумаг;
	
		СтруктураТаблицы.Вставить("НомерТорговогоРаздела", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
		СтруктураТаблицы.Вставить("КодЦеннойБумаги", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
		СтруктураТаблицы.Вставить("КоличествоНачальныйОстаток", РегистрМД.Ресурсы.Количество.Тип);
		СтруктураТаблицы.Вставить("КоличествоКонечныйОстаток", РегистрМД.Ресурсы.Количество.Тип);
		
	КонецЕсли;
	
	Возврат СтруктураТаблицы;
	
КонецФункции

