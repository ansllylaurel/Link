Функция ПолучитьМенеджерВременныхТаблицСДанными(ВнешниеДанные, ОбщиеПараметры, ТаблицаПараметров, ВидДокумента)
		
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;

#Область ТЕКСТ_ЗАПРОСА

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&ВидДокумента КАК ВидДокумента,
		|	НАЧАЛОПЕРИОДА(ВнешниеДанные.ДатаСделки, ДЕНЬ) КАК DealDate,
		|	ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВнешниеДанные.ДатаСделки, ДЕНЬ), ВнешниеДанные.ДатаСделки, СЕКУНДА)) КАК DealTime,
		|	ВнешниеДанные.НомерСделки КАК DealNumber,
		|	ВнешниеДанные.ВидСделки КАК Operation,
		|	ВнешниеДанные.СтавкаРЕПО КАК RepoRate,
		|	ВнешниеДанные.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ВнешниеДанные.БумагиКоличество КАК Quantity,
		|	ВнешниеДанные.СуммаСделки КАК Volume,
		|	ВнешниеДанные.ЦенаНоминалПроц КАК ЦенаНоминалПроц,
		|	ВнешниеДанные.Купон КАК Coupon,
		|	ВнешниеДанные.КомиссияБрокера КАК Comission,
		|	ВнешниеДанные.ТорговаяКомиссия КАК ТорговаяКомиссия,
		|	ВнешниеДанные.ЧастьСделкиРЕПО КАК RepoPart,
		|	ВнешниеДанные.КодСчетаДоверительногоУправления КАК AccountCode,
		|	ВнешниеДанные.СчетДоверительногоУправления КАК Account,
		|	ВнешниеДанные.ИмяФайла КАК ИмяФайла,
		|	ВнешниеДанные.ДатаИсполнения КАК ДатаИсполнения,
		|	ВнешниеДанные.КодЦеннойБумаги КАК InstrumentCode
		|ПОМЕСТИТЬ _ВсеВнешниеДанные
		|ИЗ
		|	&ВнешниеДанные КАК ВнешниеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаПараметров.ИмяФайла КАК ИмяФайла,
		|	ТаблицаПараметров.МестоХранения КАК МестоХранения,
		|	ТаблицаПараметров.ВалютаРасчетов КАК ВалютаРасчета
		|ПОМЕСТИТЬ _ТаблицаПараметров
		|ИЗ
		|	&ТаблицаПараметров КАК ТаблицаПараметров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ВсеВнешниеДанные.InstrumentCode КАК InstrumentCode,
		|	КодыВТорговыхСистемахСрезПоследних.Объект КАК Ссылка,
		|	ВЫБОР
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.Акции
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.РынкиЦенныхБумаг.Акции)
		|		КОГДА КодыВТорговыхСистемахСрезПоследних.Объект ССЫЛКА Справочник.Облигации
