#Область Получение_файлов_из_почты

Функция ПолучитьПутиКФайлам()

	ТекущаяДата = ТекущаяДатаСеанса();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПослеДатыОтправления", НачалоДня(ТекущаяДата));
	ПараметрыОтбора.Вставить("ДоДатыОтправления", КонецДня(ТекущаяДата));
	ПараметрыОтбора.Вставить("Отправитель", "rpa.unit00@region.ru");
	
	Письма = РаботаСЭлектроннойПочтой.ЗагрузитьСообщения(Справочники.УчетныеЗаписиЭлектроннойПочты.СистемнаяУчетнаяЗаписьЭлектроннойПочты,, ПараметрыОтбора);
	
	ПутиКФайлам = Новый Массив;
	ПараметрыПоВидамПеречней = ПараметрыОтбораПисем();
	
	Для Каждого Письмо Из Письма Цикл
		
		Для каждого Параметр Из ПараметрыПоВидамПеречней Цикл
		
			ПараметрыОтбораПисем = Параметр.Значение;

			Если Письмо.Тема = ПараметрыОтбораПисем.Тема Тогда
				
				Если Письмо.Тексты.Количество() = 1 Тогда
				
					ЧтениеHTML = Новый ЧтениеHTML;
					ЧтениеHTML.УстановитьСтроку(Письмо.Тексты[0].Получить("Текст"));
					        
					ПостроительDOM = Новый ПостроительDOM;
					ДокументHTML = ПостроительDOM.Прочитать(ЧтениеHTML);
					        
					ЧтениеHTML.Закрыть();
					
					ЭлементыTABLE = ДокументHTML.ПолучитьЭлементыПоИмени("TABLE");
					
					МассивСсылок = ПрочитатьТаблицуHTML(ПараметрыОтбораПисем, ЭлементыTABLE);
					ПутиКФайлам.Добавить(Новый Структура("ВидСписка, МассивСсылок", Параметр.Ключ, МассивСсылок));
					
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ПутиКФайлам;

КонецФункции

Функция ПараметрыОтбораПисем()

	Если ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ") Тогда
		ПрефиксОрганизации = "РЭМ";
	ИначеЕсли ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_ТрастМ") Тогда
		ПрефиксОрганизации = "РТ";
	ИначеЕсли ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_МДТраст") Тогда
		ПрефиксОрганизации = "МД Траст";
	ИначеЕсли ЭтотОбъект.Организация = ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РПИ") Тогда
		ПрефиксОрганизации = "РПИ";
	Иначе
		ПрефиксОрганизации = "";
	КонецЕсли;
	
	ПараметрыОтбораПисем = Новый Соответствие;
	СписокПолей = "Тема, Сценарий, НаименованиеПеречня, РасширениеФайла, ИмяФайла";
	
	// Отказники
	Параметры = Новый Структура(СписокПолей);
	Параметры.Тема = ПрефиксОрганизации + " Портал ЦБ Новое входящее сообщение Массовая рассылка в соответствии со 115-ФЗ (639-П).";
	Параметры.Сценарий = "Портал ЦБ";
	Параметры.НаименованиеПеречня = "Массовая рассылка в соответствии со 115-ФЗ (639-П).";
	Параметры.РасширениеФайла = ".xml";
	ПараметрыОтбораПисем.Вставить(Справочники.ВидыПеречнейОбъектов.СписокОтказников, Параметры);
		
	// МВК
	Параметры = Новый Структура(СписокПолей);
	Параметры.Тема = ПрефиксОрганизации + " Загрузка документов из ЛК РФМ";
	Параметры.Сценарий = "Загрузка документов из ЛК РФМ";
	Параметры.НаименованиеПеречня = "Перечень МВК";
	Параметры.РасширениеФайла = ".xml"; 
	ПараметрыОтбораПисем.Вставить(Справочники.ВидыПеречнейОбъектов.СписокРешенийМВК, Параметры);
		
	// Террористы
	Параметры = Новый Структура(СписокПолей);
	Параметры.Тема = ПрефиксОрганизации + " Загрузка документов из ЛК РФМ";
	Параметры.Сценарий = "Загрузка документов из ЛК РФМ";
	Параметры.НаименованиеПеречня = "Перечень террористов";
	Параметры.РасширениеФайла = ".xml";   
	ПараметрыОтбораПисем.Вставить(Справочники.ВидыПеречнейОбъектов.СписокТеррористов, Параметры);
		
	// СБООН
		
	Параметры = Новый Структура(СписокПолей);
	Параметры.Тема = ПрефиксОрганизации + " Загрузка документов из ЛК РФМ";
	Параметры.Сценарий = "Загрузка документов из ЛК РФМ";
	Параметры.НаименованиеПеречня = "Перечень ООН";
	Параметры.РасширениеФайла = ".xml";
	Параметры.ИмяФайла = "русскоязычный";
	ПараметрыОтбораПисем.Вставить(Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН, Параметры);
		
	Возврат ПараметрыОтбораПисем;

КонецФункции

Функция ПрочитатьТаблицуHTML(ПараметрыОтбораПисем, ЭлементыTABLE)

	МассивСсылок = Новый Массив;
	
	Если ПараметрыОтбораПисем.Сценарий = "Портал ЦБ" Тогда
		
		Для каждого Таблица Из ЭлементыTABLE Цикл
			
			ПрерватьОбходТаблиц = Ложь;
			
			Для каждого СтрокаТаблицы Из Таблица.ПолучитьЭлементыПоИмени("tr") Цикл
		
				Колонки = СтрокаТаблицы.ПолучитьЭлементыПоИмени("td");
				Если Не ПрерватьОбходТаблиц Тогда
				
					Если Колонки[0].ТекстовоеСодержимое = "Тема" 
						И Колонки[1].ТекстовоеСодержимое = "Массовая рассылка в соответствии со 115-ФЗ (639-П)." Тогда
					
						ПрерватьОбходТаблиц = Истина;
					
					КонецЕсли;
					
				ИначеЕсли Колонки[0].ТекстовоеСодержимое = "Вложения" Тогда
					
					ДобавитьФайлыПоСсылкам(МассивСсылок, СтрокаТаблицы, ПараметрыОтбораПисем);
					Прервать;
					
				КонецЕсли;
							
			КонецЦикла;
			
			Если ПрерватьОбходТаблиц Тогда
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		
	ИначеЕсли ПараметрыОтбораПисем.Сценарий = "Загрузка документов из ЛК РФМ" Тогда
		
		Для каждого Таблица Из ЭлементыTABLE Цикл
			
			Для каждого СтрокаТаблицы Из Таблица.ПолучитьЭлементыПоИмени("tr") Цикл
		
				НаименованиеПеречня = СтрокаТаблицы.ПолучитьЭлементыПоИмени("b");
				
				Если НаименованиеПеречня.Количество() = 1 И НаименованиеПеречня[0].ТекстовоеСодержимое = ПараметрыОтбораПисем.НаименованиеПеречня Тогда
					 ДобавитьФайлыПоСсылкам(МассивСсылок, СтрокаТаблицы, ПараметрыОтбораПисем);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСсылок;

КонецФункции

Процедура ДобавитьФайлыПоСсылкам(МассивСсылок, СтрокаТаблицы, ПараметрыОтбора)

	Для каждого Ссылка Из СтрокаТаблицы.ПолучитьЭлементыПоИмени("a") Цикл
					
		Файл = Новый Файл(Ссылка.Гиперссылка);
		Если НРег(Файл.Расширение) = НРег(ПараметрыОтбора.РасширениеФайла) Тогда
			Если ПараметрыОтбора.ИмяФайла = "" Или СтрНайти(Ссылка.Гиперссылка, ПараметрыОтбора.ИмяФайла) > 0 Тогда
				МассивСсылок.Добавить(Ссылка.Гиперссылка);
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Взаимодействие_с_Externals

Процедура СохранитьСписокДляСверкиВExternals(Знач ДанныеФайла, ПараметрыСписка = Неопределено) Экспорт

	МассивСтрок = Новый Массив;
	
	РеквизитыЮрФизЛицаСтрокой = "Is_Firm,Name,LastName,FirstName,MiddleName,BirthDate,INN,RegistrationNumber,LegalAddress,PlaceOfBirth";
	СтруктураNull = Новый Структура(РеквизитыЮрФизЛицаСтрокой, Null, Null, Null, Null, Null, Null, Null, Null, Null, Null);
	
	Период = ?(ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН, ЭтотОбъект.ДатаПубликации, ЭтотОбъект.ДатаСписка);
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
	
	Для Каждого СтрокаЮрФизЛиц Из ЭтотОбъект.СписокЮрФизЛиц Цикл
		
		ДанныеЮрФизЛица = Новый Структура(РеквизитыЮрФизЛицаСтрокой);
		ЗаполнитьЗначенияСвойств(ДанныеЮрФизЛица, СтруктураNull);
		
		ДанныеЮрФизЛица.Вставить("Period", Период);
		ДанныеЮрФизЛица.Name = СтрокаЮрФизЛиц.Наименование;
		ДанныеЮрФизЛица.RegistrationNumber = СтрокаЮрФизЛиц.РегНомер;
		ДанныеЮрФизЛица.LegalAddress = СтрокаЮрФизЛиц.Адрес;
		
		Если ЗначениеЗаполнено(СтрокаЮрФизЛиц.ИНН) Тогда
			ДанныеЮрФизЛица.INN = СтрокаЮрФизЛиц.ИНН;
		КонецЕсли;
		
		Если СтрокаЮрФизЛиц.ВидЮрФизЛица = ФизЛицо Тогда 
			
			ДанныеЮрФизЛица.Is_Firm = 0;
			ДанныеЮрФизЛица.LastName = СтрокаЮрФизЛиц.Фамилия;
			ДанныеЮрФизЛица.FirstName = СтрокаЮрФизЛиц.Имя;
			
			Если ЗначениеЗаполнено(СтрокаЮрФизЛиц.Отчество) Тогда
				ДанныеЮрФизЛица.MiddleName = СтрокаЮрФизЛиц.Отчество;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаЮрФизЛиц.ДатаРождения) Тогда
				ДанныеЮрФизЛица.BirthDate = СтрокаЮрФизЛиц.ДатаРождения;
			КонецЕсли;
			
			ДанныеЮрФизЛица.PlaceOfBirth = СтрокаЮрФизЛиц.МестоРождения;
			
		Иначе
			
			ДанныеЮрФизЛица.Is_Firm = 1;
			
		КонецЕсли;
		
		МассивСтрок.Добавить(ДанныеЮрФизЛица);
		
	КонецЦикла;
	
	Если ТипЗнч(ДанныеФайла) = Тип("Строка") И ЭтоАдресВременногоХранилища(ДанныеФайла) Тогда
		ДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла);
	КонецЕсли;

	Если ПараметрыСписка = Неопределено Тогда 
		ПараметрыСписка = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьПараметрыСписка(ЭтотОбъект.ВидСписка);
	КонецЕсли;
	РаботаСВнешнимиСистемами.СохранитьСписокДляСверкиВExternals(ЭтотОбъект.Организация, ПараметрыСписка.КодСписка, Период, МассивСтрок, ДанныеФайла);

КонецПроцедуры

Функция ФайлЗагруженВExternals(ДанныеФайла, ПараметрыСписка = Неопределено)
	
	Если ПараметрыСписка = Неопределено Тогда 
		ПараметрыСписка = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьПараметрыСписка(ЭтотОбъект.ВидСписка);
	КонецЕсли;
	
	ИмяФайла = ДанныеФайла.Имя;
	
	Если НРег(ДанныеФайла.Расширение) <> ".zip" Тогда
		ИмяФайла = ДанныеФайла.ИмяБезРасширения + ".zip";
	КонецЕсли;
	
	ХешСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДанныеФайла.ДвоичныеДанные, ХешФункция.SHA256);
	
	ИдентификаторФайла = РаботаСВнешнимиСистемами.ПолучитьИдентификаторФайлаВExternals(
		ПараметрыСписка.КодСписка,
		Строка(ЭтотОбъект.Организация.УникальныйИдентификатор()),
		ИмяФайла, 
		ХешСумма);
		
	ФайлЗагруженВExternals = (ИдентификаторФайла <> Неопределено);	
		
	Возврат ФайлЗагруженВExternals;

КонецФункции
	
#КонецОбласти

Процедура ДобавитьОтложенноеЗаданиеНаЭкспортВЛКК(ПутьКФайлу)
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("Организация",		ЭтотОбъект.Организация);		
	Параметры.Вставить("ВидСписка",			ЭтотОбъект.ВидСписка);		
	Параметры.Вставить("ПутьКФайлу",		ПутьКФайлу);
	
	Параметры.Вставить("ТекстОшибки",		СтрШаблон("Не удалось добавить отложенное задание '%1' для списка %2",
												"Обработки.ОбменДаннымиСЛККЕСИАФинанс.ЭкспортироватьСписокДляСверки",
												ЭтотОбъект.ВидСписка));
												
	Параметры.Вставить("ИсточникОшибки",	"Обмен данными с ЛКК ЕСИА.Финанс");
	
	// Плановое время запуска сдвинем на час вперед, т. к. один из файлов большой
	РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание("Обработки.ОбменДаннымиСЛККЕСИАФинанс", "ЭкспортироватьСписокДляСверки", Параметры, 15, Истина, ТекущаяДатаСеанса() + 3600);
	
КонецПроцедуры
	
Функция ВыполнитьСверкуСоСписком(ПараметрыСписка = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.ВидСписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПроверяемыеЛица = Неопределено;
	
	Если ЭтотОбъект.СверятьЗакрытыеСчетаИСвязанныеЛица Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		
	#Область ТЕКСТ_ЗАПРОСА
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДолиПайщиковВИнвестиционномФондеОстатки.Пайщик КАК ЮрФизЛицо
			|ПОМЕСТИТЬ _КлиентыДУ
			|ИЗ
			|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&Период, Организация = &Организация) КАК ДолиПайщиковВИнвестиционномФондеОстатки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО ДолиПайщиковВИнвестиционномФондеОстатки.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
			|			И ДолиПайщиковВИнвестиционномФондеОстатки.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
			|			И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ РАЗНОСТЬДАТ(КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения, &Период, ДЕНЬ) < 365)
			|			И (НЕ &ИсключитьНоминальныхДержателейПаев
			|				ИЛИ ДолиПайщиковВИнвестиционномФондеОстатки.Партия.Заявка.ВидПайщика <> ЗНАЧЕНИЕ(Перечисление.ВидыПайщиков.НоминальныйДержатель))
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	ЗаявкаПайщика.Пайщик
			|ИЗ
			|	Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&Период, Организация = &Организация) КАК КлиентыДоверительногоУправленияСрезПоследних
			|		ПО ЗаявкаПайщика.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
			|			И ЗаявкаПайщика.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
			|			И (ЗаявкаПайщика.Многократная)
			|			И (ЗаявкаПайщика.ВидПайщика <> ЗНАЧЕНИЕ(Перечисление.ВидыПайщиков.НоминальныйДержатель)
			|				ИЛИ НЕ &ИсключитьНоминальныхДержателейПаев)
			|			И (НЕ ЗаявкаПайщика.ПометкаУдаления)
			|			И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|				ИЛИ РАЗНОСТЬДАТ(КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения, &Период, ДЕНЬ) < 365)
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	КлиентыДоверительногоУправленияСрезПоследних.Клиент
			|ИЗ
			|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
			|			&Период,
			|			Организация = &Организация
			|				И (СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			|					ИЛИ РАЗНОСТЬДАТ(СчетДоверительногоУправления.ДатаРасторжения, &Период, ДЕНЬ) < 365)) КАК КлиентыДоверительногоУправленияСрезПоследних
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(КлиентыДоверительногоУправленияСрезПоследних.Клиент) = ТИП(Справочник.ЮрФизЛица)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо КАК ЮрФизЛицо
			|ПОМЕСТИТЬ _СвязанныеЛица
			|ИЗ
			|	_КлиентыДУ КАК _КлиентыДУ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ЮрФизЛицо В
			|						(ВЫБРАТЬ
			|							_КлиентыДУ.ЮрФизЛицо
			|						ИЗ
			|							_КлиентыДУ КАК _КлиентыДУ)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаФизическогоЛицаПредставителиВыгодоприобретатели
			|			ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.Ссылка
			|		ПО _КлиентыДУ.ЮрФизЛицо = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо
			|ИЗ
			|	_КлиентыДУ КАК _КлиентыДУ
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ЮрФизЛицо В
			|						(ВЫБРАТЬ
			|							_КлиентыДУ.ЮрФизЛицо
			|						ИЗ
			|							_КлиентыДУ КАК _КлиентыДУ)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаЮридическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели
			|			ПО РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Ссылка
			|		ПО _КлиентыДУ.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_КлиентыДУ.ЮрФизЛицо КАК ЮрФизЛицо
			|ИЗ
			|	_КлиентыДУ КАК _КлиентыДУ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	_СвязанныеЛица.ЮрФизЛицо
			|ИЗ
			|	_СвязанныеЛица КАК _СвязанныеЛица";
	#КонецОбласти
		
		Запрос.УстановитьПараметр("Организация", ЭтотОбъект.Организация);
		Запрос.УстановитьПараметр("ИсключитьНоминальныхДержателейПаев", ЭтотОбъект.ИсключитьНоминальныхДержателейПаев);
		Запрос.УстановитьПараметр("Период", ТекущаяДата());	
		
		ПроверяемыеЛица = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЮрФизЛицо");
		
	КонецЕсли;
		
	ПроверенныеЛица = РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСписком(ЭтотОбъект.Организация, ПроверяемыеЛица,,, ЭтотОбъект.ВидСписка);
	
	Если ПроверенныеЛица <> Неопределено Тогда
		
		Если ПараметрыСписка = Неопределено Тогда 
			ПараметрыСписка = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьПараметрыСписка(ЭтотОбъект.ВидСписка);
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("Заголовок", ПараметрыСписка.ПредставлениеСписка + Формат(ЭтотОбъект.ДатаСписка, "ДФ=dd.MM.yyyy"));
		Результат.Вставить("ОтчетОСверке", СформироватьОтчетОСверке());
		
	    Возврат Результат;
	
	КонецЕсли;
		
КонецФункции

Функция СформироватьОтчетОСверке()
	
	СхемаКомпоновкиДанных = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьМакет("РезультатыСверки");
		
	НастройкиКомпоновки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ЭтотОбъект.Организация);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидПеречня", ЭтотОбъект.ВидСписка);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", КонецДня(ТекущаяДатаСеанса()));
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("СверятьЗакрытыеСчетаИСвязанныеЛица", ЭтотОбъект.СверятьЗакрытыеСчетаИСвязанныеЛица);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ИсключитьНоминальныхДержателейПаев", ЭтотОбъект.ИсключитьНоминальныхДержателейПаев);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , , Истина);
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ДокументРезультат.ТолькоПросмотр		= Истина;
	ДокументРезультат.ОтображатьСетку		= Ложь;
	ДокументРезультат.ОтображатьЗаголовки	= Ложь;
	
	// Заполняем настройки печати по умочанию
	КлючПараметровПечати = "КлиентыСверенныеСоСписком" + ?(ЭтотОбъект.ВидСписка.Предопределенный, ЭтотОбъект.ВидСписка.ИмяПредопределенныхДанных, ЭтотОбъект.ВидСписка.Код);
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, КлючПараметровПечати, Истина, ОриентацияСтраницы.Портрет);

	Возврат ДокументРезультат;

КонецФункции

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки) Экспорт
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
	
КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(ЭтотОбъект, ИмяКоманды);
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
КонецПроцедуры

#КонецОбласти

ЭтотОбъект.ДополнительныеСвойства = Новый Структура;
