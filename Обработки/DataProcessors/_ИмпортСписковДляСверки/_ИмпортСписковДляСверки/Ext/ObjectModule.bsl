
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка", 
		"Импорт списков для сверки", 
		"0.35", 
		"", 
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СверкаСоСпискомНедействительныхПаспортовИОбновлениеАнкет"	, "Сверка со списком недействительных паспортов и обновление анкет",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "СверкаСоСпискомДисквалифицированныхЛиц", "Сверка со списком дисквалифицированных лиц",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "АвтоимпортИСверка", "Автоматический импорт и сверка со списками",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска загрузки по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт

	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("Источник", ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Удалить("Ошибки");
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыКоманды);

	Если ИдентификаторКоманды = "СверкаСоСпискомНедействительныхПаспортовИОбновлениеАнкет" Тогда
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("СверкаСоСпискомНедействительныхПаспортовИОбновлениеАнкет");
		ВыполнитьСверкуСоСпискомНедействительныхПаспортов();
		ОбновитьАнкеты();
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	ИначеЕсли ИдентификаторКоманды = "СверкаСоСпискомДисквалифицированныхЛиц" Тогда
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("СверкаСоСпискомДисквалифицированныхЛиц");
		ВыполнитьСверкуСоСпискомДисквалифицированныхЛиц();
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	ИначеЕсли ИдентификаторКоманды = "АвтоимпортИСверка" Тогда
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию("АвтоимпортИСверка");
		АвтоимпортИСверка(ПараметрыКоманды, ПараметрыСессии);
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	КонецЕсли;
	
КонецПроцедуры

#Область Обработка_команд

#Область Сверка_со_списком_недействительных_паспортов_и_обновление_анкет

Процедура ВыполнитьСверкуСоСпискомНедействительныхПаспортов()
	
	ДополнительныеСвойстваЗаписи = Новый Структура("РегламентнаяСверка", Истина);
	
	РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСпискомНедействительныхПаспортов(ЭтотОбъект.Организация,,,, ДополнительныеСвойстваЗаписи);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	СтатусыСверки = Новый Массив;
	СтатусыСверки.Добавить(1); //паспорт недействителен
	СтатусыСверки.Добавить(2); //Проверка не выполнялась
	//СтатусыСверки.Добавить(3); //паспорт действителен
	
	РезультатОтчета = РегистрыСведений.ЖурналСверкиСоСписками.РезультатыСверкиСоСпискомНедействительныхПаспортов(
		ЭтотОбъект.Организация,
		Справочники.ВидыПеречнейОбъектов.СписокНедействительныхПаспортов,
		,
		,
		СтатусыСверки);
	
	РезультатОтчета.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	Вложения = Новый Соответствие;
	Вложения.Вставить("Сверка со списком недействительных паспортов.xlsx", ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла)));
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому"		, ЭтотОбъект.ПолучателиОповещения);
	ПараметрыПисьма.Вставить("Тема"		, "Результат сверки со списком недействительных паспортов");
	ПараметрыПисьма.Вставить("Тело"		, "Во вложении результат сверки со списком недействительных паспортов");
	ПараметрыПисьма.Вставить("ТипТекста", "ПростойТекст");
	ПараметрыПисьма.Вставить("Вложения"	, Вложения);
	
	РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма,, Истина);			
	
КонецПроцедуры

Процедура ОбновитьАнкеты()
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период"		, ТекущаяДата());
	Запрос.УстановитьПараметр("Организация"	, ЭтотОбъект.Организация);
	
	Справочники.ЮрФизЛица.ПоместитьКлиентовВМенеджерВременныхТаблиц(Запрос, ЭтотОбъект.Организация, ТекущаяДата(), "_КлиентыДоверительногоУправления"); 
	
#Область ТекстЗапроса
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо КАК ФизЛицо
		|ПОМЕСТИТЬ _ФизическиеЛица
		|ИЗ
		|	_КлиентыДоверительногоУправления КАК _КлиентыДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮридическихЛицАнкетныеСрезПоследних
		|		ПО _КлиентыДоверительногоУправления.ЮрФизЛицо = РеквизитыЮридическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаЮридическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели
		|		ПО (РеквизитыЮридическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.Ссылка)
		|ГДЕ
		|	АнкетаЮридическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо
		|ИЗ
		|	_КлиентыДоверительногоУправления КАК _КлиентыДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _КлиентыДоверительногоУправления.ЮрФизЛицо = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица.ПредставителиВыгодоприобретатели КАК АнкетаФизическогоЛицаПредставителиВыгодоприобретатели
		|		ПО (РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо)
		|ГДЕ
		|	АнкетаФизическогоЛицаПредставителиВыгодоприобретатели.ЮрФизЛицо.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_КлиентыДоверительногоУправления.ЮрФизЛицо
		|ИЗ
		|	_КлиентыДоверительногоУправления КАК _КлиентыДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО _КлиентыДоверительногоУправления.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|			И (ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ФизическиеЛица.ФизЛицо КАК ФизЛицо,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.Пройдена, ЛОЖЬ) КАК АнкетаОбновлена,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.ДатаПоследнейСверки, ""-"") КАК ДатаПоследнейСверки,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.Комментарий, ""Проверка не выполнялась"") КАК Комментарий,
		|	ВЫБОР
		|		КОГДА ЖурналСверкиСоСписками.Пройдена ЕСТЬ NULL
		|			ТОГДА ""Проверка не проводилась""
		|		КОГДА ЖурналСверкиСоСписками.Пройдена
		|			ТОГДА ""Паспорт действителен""
		|		ИНАЧЕ
		|			""Паспорт недействителен""
		|	КОНЕЦ КАК ПаспортДействителен,
		|	АнкетаФизическогоЛица.Ссылка КАК Анкета
		|ИЗ
		|	_ФизическиеЛица КАК _ФизическиеЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _ФизическиеЛица.ФизЛицо = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|		ПО (РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛица.Ссылка)
		|			И (АнкетаФизическогоЛица.УпрощеннаяИдентификация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверкиСоСписками КАК ЖурналСверкиСоСписками
		|		ПО _ФизическиеЛица.ФизЛицо = ЖурналСверкиСоСписками.ЮрФизЛицо
		|			И (ЖурналСверкиСоСписками.Период = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ))
		|			И (ЖурналСверкиСоСписками.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокНедействительныхПаспортов))
		|			И (ЖурналСверкиСоСписками.Организация = &Организация)
		|ГДЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
		|	И РАЗНОСТЬДАТ(&Период, ДОБАВИТЬКДАТЕ(РеквизитыФизическихЛицАнкетныеСрезПоследних.Период, ГОД, 1), ДЕНЬ) <= 20
		|
		|УПОРЯДОЧИТЬ ПО
		|	АнкетаОбновлена,
		|	ФизЛицо
		|АВТОУПОРЯДОЧИВАНИЕ";
#КонецОбласти

	Результат = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("ОтчетОСверкеСоСпискомНедействительныхПаспортовИОбновленииАнкет");
	
	ОбластьШапка	= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока	= Макет.ПолучитьОбласть("Строка");
	
	Результат.Вывести(ОбластьШапка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
			
			Если Выборка.АнкетаОбновлена Тогда
				Анкета = Выборка.Анкета.Скопировать();
				
				Анкета.Организация	= ЭтотОбъект.Организация;
				Анкета.Дата			= ТекущаяДатаСеанса();
				
				Анкета.ДополнительныеСвойства.Вставить("АвтоматическоеОбновлениеАнкет");
				
				Анкета.Записать(РежимЗаписиДокумента.Проведение);
				
				ОбластьСтрока.Область("Строка").ЦветТекста = WebЦвета.Черный;
			Иначе
				ОбластьСтрока.Область("Строка").ЦветТекста = WebЦвета.Красный;
			КонецЕсли; 
			
			Результат.Вывести(ОбластьСтрока);
			
		КонецЦикла; 
		
		ИмяФайла = ПолучитьИмяВременногоФайла("htm");
		
		Результат.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
		
		ТемаПисьма = "Обновление анкет физических лиц по организации " + ЭтотОбъект.Организация;
		
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.Прочитать(ИмяФайла);
		
		УдалитьФайлы(ИмяФайла);
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", ЭтотОбъект.ПолучателиОповещения, ТемаПисьма, ТелоПисьма.ПолучитьТекст(), ТипТекстаПочтовогоСообщения.HTML);
		
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма, , Истина);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

Процедура ВыполнитьСверкуСоСпискомДисквалифицированныхЛиц()
	
	//Если с даты последней сверки был загружен новый список, тогда проводим сверку с последним списком
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Период"		, ТекущаяДата());
	Запрос.УстановитьПараметр("Организация"	, ЭтотОбъект.Организация);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(dbo_Files.Upload_Time) КАК ДатаОбновленияСписка
		|ИЗ
		|	ВнешнийИсточникДанных.Externals.Таблица.Data_Sources КАК Data_Sources
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВнешнийИсточникДанных.Externals.Таблица.dbo_Files КАК dbo_Files
		|		ПО Data_Sources.Ссылка = dbo_Files.Source_Id
		|ГДЕ
		|	Data_Sources.Id = 24";	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ДатаОбновленияСписка) Тогда
		ДатаОбновленияСписка = Выборка.ДатаОбновленияСписка;
		Запрос.УстановитьПараметр("ДатаОбновленияСписка", ДатаОбновленияСписка);
	Иначе
		ВызватьИсключение "Не обнаружен список дисквалифицированных лиц";
	КонецЕсли;
	
	РегистрыСведений.ВнутренниеПеречни.ЗаполнитьДолжностныеЛица(Запрос.МенеджерВременныхТаблиц, ЭтотОбъект.Организация, ДатаОбновленияСписка);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДолжностныеЛица.ЮрФизЛицо КАК ЮрФизЛицо,
		|	МАКСИМУМ(ЖурналСверкиСоСписками.ДатаПоследнейСверки) КАК ДатаПоследнейСверки
		|ИЗ
		|	_ДолжностныеЛица КАК _ДолжностныеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверкиСоСписками КАК ЖурналСверкиСоСписками
		|		ПО _ДолжностныеЛица.ЮрФизЛицо = ЖурналСверкиСоСписками.ЮрФизЛицо
		|			И _ДолжностныеЛица.Организация = ЖурналСверкиСоСписками.Организация
		|			И (ЖурналСверкиСоСписками.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокДисквалифицированныхЛиц))
		|			И (ЖурналСверкиСоСписками.ДатаПоследнейСверки МЕЖДУ &ДатаОбновленияСписка И &Период)
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДолжностныеЛица.ЮрФизЛицо
		|
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ЖурналСверкиСоСписками.ДатаПоследнейСверки) ЕСТЬ NULL";
	
	ПроверяемыеЛица = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЮрФизЛицо");
	
	Если ПроверяемыеЛица.Количество() Тогда
		РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСпискомДисквалифицированныхЛиц(ЭтотОбъект.Организация, ПроверяемыеЛица, ТекущаяДата());
	КонецЕсли;
	
КонецПроцедуры

#Область Автоматический_импорт_и_сверка

Процедура АвтоимпортИСверка(ПараметрыКоманды, ПараметрыСессии)

	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		 ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();
	КонецЕсли;
	
	ЭтотОбъект.Организация = ПараметрыКоманды.Организация;
	ЭтотОбъект.СверятьЗакрытыеСчетаИСвязанныеЛица	= ПараметрыКоманды.СверятьЗакрытыеСчетаИСвязанныеЛица;
	ЭтотОбъект.ИсключитьНоминальныхДержателейПаев	= ПараметрыКоманды.ИсключитьНоминальныхДержателейПаев;
	ЭтотОбъект.ВыгрузитьСпискиВЛКК					= ПараметрыКоманды.ВыгрузитьСпискиВЛКК;
	
	Для Каждого ПараметрыФайла Из ПолучитьПутиКФайлам() Цикл
	
		ЭтотОбъект.ВидСписка = ПараметрыФайла.ВидСписка;
		
		ПараметрыСписка = РегистрыСведений.ЖурналСверкиСоСписками.ПолучитьПараметрыСписка(ЭтотОбъект.ВидСписка);
		
		Для Каждого ИмяФайла Из ПараметрыФайла.МассивСсылок Цикл
		
			Файл = Новый Файл(ИмяФайла);
			Если Файл.Существует() Тогда
								
				ДанныеФайла = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайла);
				ДанныеФайла.Вставить("ДвоичныеДанные", Новый ДвоичныеДанные(ИмяФайла));
				
				Если ФайлЗагруженВExternals(ДанныеФайла, ПараметрыСписка) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПрочитатьФайл(ДанныеФайла, ПараметрыСессии) Тогда
				
					Если ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН Тогда
						ЭтотОбъект.ДатаПубликации = ТекущаяДатаСеанса();
					КонецЕсли;
					
					Если ЭтотОбъект.ВыгрузитьСпискиВЛКК
						И (ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов
							Или ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокОтказников
							Или ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН		
							Или ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокРешенийМВК)
					Тогда 
						ДобавитьОтложенноеЗаданиеНаЭкспортВЛКК(ИмяФайла);						
					КонецЕсли;
					
					СохранитьСписокДляСверкиВExternals(ДанныеФайла, ПараметрыСписка);
					РезультатСверки = ВыполнитьСверкуСоСписком(ПараметрыСписка);
					
					Если РезультатСверки = Неопределено Тогда
						ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, СтрШаблон("При выполнении сверки прозошли ошибки. %1", ЭтотОбъект.ВидСписка));
						ЗарегистрироватьОшибку(СтрШаблон("При выполнении сверки прозошли ошибки. %1", ЭтотОбъект.ВидСписка));
					Иначе
						СформироватьОповещенияПоАвтоматическойСверке(РезультатСверки);
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, СтрШаблон("Отсутсвует доступ к файлу '%1'", ИмяФайла));
				ЗарегистрироватьОшибку(СтрШаблон("Отсутсвует доступ к файлу '%1'", ИмяФайла));
				
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	ОповеститьОбОшибках();
	
КонецПроцедуры

Процедура СформироватьОповещенияПоАвтоматическойСверке(РезультатСверки)

	ИмяФайла = ПолучитьИмяВременногоФайла("htm");
	РезультатСверки.ОтчетОСверке.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
	
	ТелоПисьма = Новый ТекстовыйДокумент;
	ТелоПисьма.Прочитать(ИмяФайла);
	
	УдалитьФайлы(ИмяФайла);
	
	ТекстПисьма = ТелоПисьма.ПолучитьТекст();
	
	РеквизитыОповещения = Новый Структура("Организация, ВидСписка");
	ЗаполнитьЗначенияСвойств(РеквизитыОповещения, ЭтотОбъект);
	РеквизитыОповещения.Вставить("Текст", ТекстПисьма);
	РеквизитыОповещения.Вставить("Заголовок", РезультатСверки.Заголовок);
		
	ИсточникОповещения = ЭтотОбъект.Метаданные().ПолноеИмя() + ".АвтоимпортИСверка";
	Справочники.Оповещения.СформироватьОповещения(ИсточникОповещения, Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область Обработка_ошибок

Процедура ЗарегистрироватьОшибку(ТекстОшибки)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("Ошибки", Новый Массив());
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Ошибки.Найти(ТекстОшибки) = Неопределено Тогда
		ЭтотОбъект.ДополнительныеСвойства.Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры // ЗарегистрироватьОшибку

Процедура ОповеститьОбОшибках()
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("Ошибки") 
	 ИЛИ ЭтотОбъект.ДополнительныеСвойства.Ошибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Источник") Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(ЭтотОбъект.ДополнительныеСвойства.Ошибки, ЭтотОбъект.ДополнительныеСвойства.Источник);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			РаботаСоСтрокамиКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(ЭтотОбъект.ДополнительныеСвойства.Ошибки, Символы.ПС));
	КонецЕсли;
		
	ЭтотОбъект.ДополнительныеСвойства.Ошибки.Очистить();	
	
КонецПроцедуры // ОповеститьОбОшибках
	
#КонецОбласти

#Область Чтение_файлов

Функция ПрочитатьФайл(Знач ДанныеФайла, ПараметрыСессии = Неопределено) Экспорт
	
	ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.ПустаяСсылка();
	
	Если ТипЗнч(ДанныеФайла) = Тип("Строка") И ЭтоАдресВременногоХранилища(ДанныеФайла) Тогда
		ДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла);
	КонецЕсли;
	
	КаталогВременныхФайлов = ОбщегоНазначенияКлиентСервер.ПолучитьКаталогВременныхФайлов() + Строка(Новый УникальныйИдентификатор) + "\";
	ИмяВременногоФайла = КаталогВременныхФайлов + ДанныеФайла.Имя;
	
	ДанныеФайла.ДвоичныеДанные.Записать(ИмяВременногоФайла);
	Отказ = Ложь;
	
	#Область Извлечение_zip_архива
	Если НРег(ДанныеФайла.Расширение) = ".zip" Тогда

		ЧтениеZIP = Новый ЧтениеZipФайла(ИмяВременногоФайла);
		ЭлементАрхива = ЧтениеZIP.Элементы.Найти(ДанныеФайла.ИмяБезРасширения + ".xml");
		
		Если ЭлементАрхива = Неопределено Тогда
			
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, СтрШаблон("В архиве не обнаружен файл '%1'", ДанныеФайла.ИмяБезРасширения));
			ЗарегистрироватьОшибку(СтрШаблон("В архиве не обнаружен файл '%1'", ДанныеФайла.ИмяБезРасширения));
			
		Иначе
			
			Попытка
				
				ЧтениеZIP.Извлечь(ЭлементАрхива, КаталогВременныхФайлов, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
				ЧтениеZIP.Закрыть();
				УдалитьФайлы(ИмяВременногоФайла);
				ИмяВременногоФайла = КаталогВременныхФайлов + ДанныеФайла.ИмяБезРасширения + ".xml";
				
			Исключение
				
				ТекстОшибки = СтрШаблон("Ошибка при распаковке архива '%1':%2", ДанныеФайла.Имя, Символы.ПС + ОписаниеОшибки());
				ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
				ЗарегистрироватьОшибку(ТекстОшибки);
				Отказ = Истина;
				
			КонецПопытки;			
			
		КонецЕсли; 
		
	КонецЕсли;		
	#КонецОбласти 
	
	Если Не Отказ Тогда
	
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
		
		Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "TERRORISTS_CATALOG" Тогда
		
			ТекстовыйДокумент = Новый ТекстовыйДокумент;
			ТекстовыйДокумент.Прочитать(ИмяВременногоФайла);
			СтрокаXML = ТекстовыйДокумент.ПолучитьТекст();
			СтрокаXML = СтрЗаменить(СтрЗаменить(СтрокаXML, "&lt;", "<"), "&gt;", ">");
			ПараметрыЧтенияXML = Новый ПараметрыЧтенияXML(,,,,,,,,, Ложь);
			ЧтениеXML.УстановитьСтроку(СтрокаXML, ПараметрыЧтенияXML);
			
		Иначе
			
			ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
		
		КонецЕсли; 
		
		Попытка
			ЗаполнитьСписокЮрФизЛиц(ЧтениеXML, ИмяВременногоФайла);
		Исключение
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ОписаниеОшибки());
			ЗарегистрироватьОшибку(ОписаниеОшибки());
		КонецПопытки;
		
		ЧтениеXML.Закрыть();
	
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	ОповеститьОбОшибках();
	
	Возврат ЗначениеЗаполнено(ЭтотОбъект.ВидСписка);
	
КонецФункции

Процедура ЗаполнитьСписокЮрФизЛиц(ЧтениеXML, ИмяВременногоФайла)

	ЭтотОбъект.СписокЮрФизЛиц.Очистить();
	
	Фабрика = Новый ФабрикаXDTO;
	Данные = Фабрика.ПрочитатьXML(ЧтениеXML);
	
	Если Данные.Свойства().Получить("TERRORISTS") <> Неопределено Тогда // террористы
		
		ПрочитатьФайлСпискаТеррористов(Данные);
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов;
		
	ИначеЕсли Данные.Свойства().Получить("АктуальныйПеречень") <> Неопределено Тогда // террористы 2.0
		
		ПрочитатьФайлСпискаТеррористов2_0(Данные);
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокТеррористов;
		
	ИначеЕсли Данные.Свойства().Получить("СписокАктуальныхРешений") <> Неопределено Тогда // МВК
		
		ПрочитатьФайлСпискаРешенийМВК(Данные);
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокРешенийМВК;
				
	ИначеЕсли Данные.Свойства().Получить("АктуальныйСписок") <> Неопределено Тогда // ФРОМУ
		
		ПрочитатьФайлСпискаФРОМУ(Данные);
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокФРОМУ;
				
	ИначеЕсли Данные.Свойства().Получить("INDIVIDUALS") <> Неопределено Тогда // Список ООН
		
		ПрочитатьФайлСпискаСБООН(Данные);
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН;
				
	ИначеЕсли Данные.Свойства().Получить("СлужЧасть") <> Неопределено Тогда // список противодействия легализации доходов / положение ЦБ 639-П
		
		ПрочитатьФайлСпискаПротиводействияЛегализацииДоходов(Данные, ИмяВременногоФайла);
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.СписокОтказников;
				
	Иначе
		
		ЭтотОбъект.ВидСписка = Справочники.ВидыПеречнейОбъектов.ПустаяСсылка();
		
	КонецЕсли;
	
	Если ЭтотОбъект.ВидСписка <> Справочники.ВидыПеречнейОбъектов.СводныйПереченьСоветаБезопасностиООН Тогда
		
		ЭтотОбъект.ДатаПубликации = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивСтрокXDTO(Знач ОбъектXDTO, Знач ИмяСвойства)
	
	МассивСтрок = Новый Массив;
	
	Если ОбъектXDTO.Свойства().Получить(ИмяСвойства) = Неопределено Тогда //Раздел пуст
	
	ИначеЕсли ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("ОбъектXDTO") Тогда
		МассивСтрок.Добавить(ОбъектXDTO[ИмяСвойства]);
		
	ИначеЕсли ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("СписокXDTO") Тогда
		Для Каждого СтрокаXDTO Из ОбъектXDTO[ИмяСвойства] Цикл
			МассивСтрок.Добавить(СтрокаXDTO);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьЗначениеСвойства(ОбъектXDTO, ИмяСвойства, ТипЗначения = Неопределено)
	
	ЗначениеСвойства = "";
	
	Если ОбъектXDTO.Свойства().Получить(ИмяСвойства) <> Неопределено Тогда
		Если ТипЗнч(ОбъектXDTO[ИмяСвойства]) = Тип("ОбъектXDTO") Тогда
			
		ИначеЕсли ТипЗначения <> Тип("Строка") 
			И СериализаторXDTO.XMLЗначение(Тип("Строка"), ОбъектXDTO[ИмяСвойства]) = "Invalid date" Тогда
			
		ИначеЕсли  ТипЗначения <> Неопределено  Тогда
			ЗначениеСвойства = СериализаторXDTO.XMLЗначение(ТипЗначения, ОбъектXDTO[ИмяСвойства]);
		Иначе
			ЗначениеСвойства = ОбъектXDTO[ИмяСвойства];
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции

#Область Список_противодействия_легализации_доходов

Процедура ПрочитатьФайлСпискаПротиводействияЛегализацииДоходов(ДанныеXDTO, ИмяВременногоФайла)

	СвойстваОбъекта = ДанныеXDTO.Свойства();
	
	Если СвойстваОбъекта.Получить("СлужЧасть") <> Неопределено Тогда
		ЭтотОбъект.ДатаСписка = ДатаИзДДММГГГГ(ДанныеXDTO.СлужЧасть.ДатаСообщения);
	КонецЕсли;
	
	Если Не ПроверкаИмениФайла(ИмяВременногоФайла) Тогда
		Возврат;
	КонецЕсли;
	
	Если СвойстваОбъекта.Получить("ИнформЧасть") <> Неопределено Тогда
		
		Если ТипЗнч(ДанныеXDTO.ИнформЧасть.Раздел2) = Тип("ОбъектXDTO") Тогда
			СписокПротиводействияЛегализацииДоходовПрочитатьРаздел2(ДанныеXDTO.ИнформЧасть.Раздел2);
		Иначе
			Для Каждого СтрокаРаздела2 Из ДанныеXDTO.ИнформЧасть.Раздел2 Цикл
				СписокПротиводействияЛегализацииДоходовПрочитатьРаздел2(СтрокаРаздела2);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция ПроверкаИмениФайла(ИмяВременногоФайла)
	
	МассивПолногоИмениФайла = СтрРазделить(ИмяВременногоФайла, "\", Ложь);
	ИмяФайла = МассивПолногоИмениФайла[МассивПолногоИмениФайла.Количество() - 1];
	
	ШаблонИмениФайла = ВРЕГ("CB_ES550P_" + Формат(ЭтотОбъект.ДатаСписка, "ДФ=yyyyMMdd") + "_");
	Если Не СтрНачинаетсяС(ВРЕГ(ИмяФайла), ШаблонИмениФайла) ИЛИ ВРЕГ(Прав(ИмяФайла, 4)) <> ВРЕГ(".xml") Тогда
		ЗарегистрироватьОшибку("Имя файла не соответствует формату: " + ШаблонИмениФайла + "_XXX.xml");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура СписокПротиводействияЛегализацииДоходовПрочитатьРаздел2(СтрокаРаздела2)
	
	ЮрЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
	
	Если ТипЗнч(СтрокаРаздела2.Участник) = Тип("СписокXDTO") Тогда
		Для Каждого УчастникXDTO Из СтрокаРаздела2.Участник Цикл
			СписокПротиводействияЛегализацииДоходовДобавитьДанныеЮрФизЛица(УчастникXDTO, ЮрЛицо, ФизЛицо);
		КонецЦикла;
	Иначе
		СписокПротиводействияЛегализацииДоходовДобавитьДанныеЮрФизЛица(СтрокаРаздела2.Участник, ЮрЛицо, ФизЛицо);
	КонецЕсли;
	
КонецПроцедуры

Процедура СписокПротиводействияЛегализацииДоходовДобавитьДанныеЮрФизЛица(УчастникXDTO, ЮрЛицо, ФизЛицо)

	СвойстваУчастника	= УчастникXDTO.Свойства();
	
	Если СвойстваУчастника.Получить("СведФЛИП") <> Неопределено Тогда
		
		СведФЛИП = УчастникXDTO.СведФЛИП;
		
		НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
		НоваяСтрока.ВидЮрФизЛица = ФизЛицо;
					
		ФИО = Новый Структура("Фам,Имя,Отч");
		ЗаполнитьЗначенияСвойств(ФИО, СведФЛИП.ФИОФЛИП);
		
		Фамилия	= ТРег(ФИО.Фам);
		Имя	= ТРег(ФИО.Имя);
		Отчество = ТРег(ФИО.Отч);
		
		НоваяСтрока.ФИО	= Фамилия + " " + Имя + " " + Отчество;
		НоваяСтрока.Наименование = НоваяСтрока.ФИО;
		НоваяСтрока.Фамилия	= Фамилия;
		НоваяСтрока.Имя	= Имя;
		НоваяСтрока.Отчество = Отчество;
		
		Если СведФЛИП.Свойства().Получить("ДатаРождения") <> Неопределено Тогда
			НоваяСтрока.ДатаРождения	= ДатаИзДДММГГГГ(СведФЛИП.ДатаРождения);
		КонецЕсли;
		
		НоваяСтрока.ИНН	= ПреобразоватьXDTOКСтроке(СведФЛИП.ИННФЛИП);
		
		НоваяСтрока.РегНомер = ПреобразоватьXDTOКСтроке(СведФЛИП.СведДокУдЛичн.СерияДок) + ПреобразоватьXDTOКСтроке(СведФЛИП.СведДокУдЛичн.НомДок);
		
	ИначеЕсли СвойстваУчастника.Получить("СведЮЛ") <> Неопределено Тогда
		
		СведЮЛ = УчастникXDTO.СведЮЛ;
		
		НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
		НоваяСтрока.ВидЮрФизЛица = ЮрЛицо;
		
		НоваяСтрока.Наименование = ПреобразоватьXDTOКСтроке(СведЮЛ.НаимЮЛ);
		НоваяСтрока.РегНомер = ПреобразоватьXDTOКСтроке(СведЮЛ.ОГРНЮЛ);
		НоваяСтрока.ИНН	= ПреобразоватьXDTOКСтроке(СведЮЛ.ИННЮЛ);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПреобразоватьXDTOКСтроке(Значение)
	
	Если ТипЗнч(Значение) = Тип("ОбъектXDTO") Тогда
		Возврат "";
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

Функция ДатаИзДДММГГГГ(Значение)
	
	МассивЧастейДаты = СтрРазделить(Значение, "/");
	Возврат Дата(МассивЧастейДаты[2], МассивЧастейДаты[1], МассивЧастейДаты[0]);
	
КонецФункции

#КонецОбласти

#Область Список_решений_МВК

Процедура ПрочитатьФайлСпискаРешенийМВК(Данные)

	ЭтотОбъект.ВерсияФормата = Данные.ВерсияФормата;
	ЭтотОбъект.ДатаСписка = Дата(СтрЗаменить(Данные.ДатаСписка, "-", ""));
	
	ЮрЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
		
	Если ТипЗнч(Данные.СписокАктуальныхРешений.Решение) = Тип("СписокXDTO") Тогда
		Для каждого Решение Из Данные.СписокАктуальныхРешений.Решение Цикл
			Если ТипЗнч(Решение.СписокСубъектов.Субъект) = Тип("СписокXDTO") Тогда
				Для каждого Субъект Из Решение.СписокСубъектов.Субъект Цикл
					СтруктураСтроки = ОбработатьСубъектМВК(Субъект);
					НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
					НоваяСтрока.ВидЮрФизЛица = ?(СтруктураСтроки.ЮрЛицо, ЮрЛицо, ФизЛицо);
					НоваяСтрока.РегНомер = СтруктураСтроки.ИНН;
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
				КонецЦикла; 
			ИначеЕсли ТипЗнч(Решение.СписокСубъектов.Субъект) = Тип("ОбъектXDTO") Тогда
				СтруктураСтроки = ОбработатьСубъектМВК(Решение.СписокСубъектов.Субъект);
				НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
				НоваяСтрока.ВидЮрФизЛица = ?(СтруктураСтроки.ЮрЛицо, ЮрЛицо, ФизЛицо);
				НоваяСтрока.РегНомер = СтруктураСтроки.ИНН;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 

КонецПроцедуры

Функция ОбработатьСубъектМВК(Субъект)

	СтруктураСтроки = Новый Структура("ФИО,Фамилия,Имя,Отчество,ДатаРождения,ИНН,Наименование,ОГРН");
	
	Если Субъект.ТипСубъекта.Идентификатор = "2" Тогда
		
		СтруктураСтроки.Вставить("ЮрЛицо", Ложь);
		
		Для каждого КлючИЗначение Из СтруктураСтроки Цикл
			Если Субъект.ФЛ.Свойства().Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				Если КлючИЗначение.Ключ = "ДатаРождения" Тогда
					СтруктураСтроки[КлючИЗначение.Ключ] = Дата(СтрЗаменить(Субъект.ФЛ[КлючИЗначение.Ключ], "-", ""));
				ИначеЕсли КлючИЗначение.Ключ = "ФИО" Тогда
					СтруктураСтроки.Наименование = Субъект.ФЛ[КлючИЗначение.Ключ];				
				Иначе
					СтруктураСтроки[КлючИЗначение.Ключ] = Субъект.ФЛ[КлючИЗначение.Ключ];				
				КонецЕсли; 
			КонецЕсли; 
		КонецЦикла; 
		
	Иначе
		
		СтруктураСтроки.Вставить("ЮрЛицо", Истина);
		
		Для каждого КлючИЗначение Из СтруктураСтроки Цикл
			Если Субъект.ЮЛ.Свойства().Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				СтруктураСтроки[КлючИЗначение.Ключ] = Субъект.ЮЛ[КлючИЗначение.Ключ];
			КонецЕсли; 
		КонецЦикла; 
		
	КонецЕсли; 
	
	Возврат СтруктураСтроки;

КонецФункции
 
#КонецОбласти

#Область Список_субъектов_причастных_к_распространению_ОМУ

Процедура ПрочитатьФайлСпискаФРОМУ(Данные)

	ЭтотОбъект.ВерсияФормата = Данные.ВерсияФормата;
	ЭтотОбъект.ДатаСписка = Дата(СтрЗаменить(Данные.ДатаСписка, "-", ""));
	
	ЮрЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
	
	Если ТипЗнч(Данные.АктуальныйСписок.Субъект) = Тип("СписокXDTO") Тогда
		Для каждого Субъект Из Данные.АктуальныйСписок.Субъект Цикл
			
			СтруктураСтроки = ОбработатьСубъектМВК(Субъект);
			
			НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
			НоваяСтрока.ВидЮрФизЛица = ?(СтруктураСтроки.ЮрЛицо, ЮрЛицо, ФизЛицо);
			НоваяСтрока.РегНомер = СтруктураСтроки.ИНН;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
			
		КонецЦикла; 
	КонецЕсли; 

КонецПроцедуры

#КонецОбласти

#Область Список_террористов

Процедура ПрочитатьФайлСпискаТеррористов(Данные)

	ЭтотОбъект.ДатаСписка 	= Дата(Данные.DATE + " 00:00:00");
	
	Если Данные.Свойства().Получить("ID") <> Неопределено Тогда
		ЭтотОбъект.Идентификатор = Данные.ID;
	Иначе
		ЭтотОбъект.Идентификатор = "";
	КонецЕсли;
	
	Если Данные.Свойства().Получить("NUM") <> Неопределено Тогда
		ЭтотОбъект.НомерСписка = Данные.NUM;
	Иначе
		ЭтотОбъект.НомерСписка = "";
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	
	ЮрЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
	
	Для каждого СтрокаТер Из Данные.TERRORISTS Цикл
		
		ЭтоЮрЛицо = (РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(СтрокаТер.person_type) = "1");
		
		ДатаРождения = СокрЛП(СтрокаТер.birth_date);
		Если СтрДлина(ДатаРождения) = 4 Тогда
			ДатаРождения = Дата(Число(ДатаРождения), 1, 1);
		ИначеЕсли СтрДлина(ДатаРождения) = 10 Тогда
			ДатаРождения = Дата(ДатаРождения + " 00:00:00");
		Иначе
			ДатаРождения = '00010101';		
		КонецЕсли; 
		
		ФИО = СокрЛП(СтрЗаменить(СтрокаТер.TERRORISTS_NAME, "*", ""));
		МассивФИО = СтрРазделить(ФИО, " ");
		
		НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
		НоваяСтрока.ВидЮрФизЛица = ?(ЭтоЮрЛицо, ЮрЛицо, ФизЛицо);
		НоваяСтрока.ДатаРождения = ДатаРождения;
		НоваяСтрока.МестоРождения = СокрЛП(СтрокаТер.BIRTH_PLACE);
		НоваяСтрока.Наименование = СокрЛП(СтрЗаменить(СтрокаТер.TERRORISTS_NAME, "*", ""));
		Если Не ЭтоЮрЛицо Тогда
		
			Если МассивФИО.Количество() = 1 Тогда
				НоваяСтрока.Фамилия = МассивФИО[0];
			ИначеЕсли МассивФИО.Количество() = 2 Тогда
				НоваяСтрока.Фамилия = МассивФИО[0];
				НоваяСтрока.Имя = МассивФИО[1];
			ИначеЕсли МассивФИО.Количество() = 3 Тогда
				НоваяСтрока.Фамилия = МассивФИО[0];
				НоваяСтрока.Имя = МассивФИО[1];
				НоваяСтрока.Отчество = МассивФИО[2];
			КонецЕсли; 
		
		КонецЕсли; 

		НоваяСтрока.Адрес = СокрЛП(СтрокаТер.ADDRESS);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьФайлСпискаТеррористов2_0(Данные)

	ЭтотОбъект.ДатаСписка 	= СериализаторXDTO.XMLЗначение(Тип("Дата"), Данные.ДатаПеречня);
	
	МассивСтрок = Новый Массив;
	
	ЮрЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
	
	Для каждого СтрокаТер Из Данные.АктуальныйПеречень.Субъект Цикл
		
		НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
		
		Если СтрокаТер.ТипСубъекта.Идентификатор = "1"  
		 ИЛИ СтрокаТер.ТипСубъекта.Идентификатор = "3" Тогда
			НоваяСтрока.ВидЮрФизЛица = ЮрЛицо;
			
		ИначеЕсли СтрокаТер.ТипСубъекта.Идентификатор = "2"  
		 ИЛИ СтрокаТер.ТипСубъекта.Идентификатор = "4" Тогда
			НоваяСтрока.ВидЮрФизЛица = ФизЛицо;
		 
		Иначе 
			ВызватьИсключение "Неизвестный идентификатор террориста " + СтрокаТер.ТипСубъекта.Идентификатор;
		КонецЕсли;
		
		Если НоваяСтрока.ВидЮрФизЛица = ЮрЛицо Тогда
			Для Каждого ИмяРеквизита Из СтрРазделить("ЮЛ,Орг", ",") Цикл
				Если СтрокаТер.Свойства().Получить(ИмяРеквизита) <> Неопределено Тогда
					ДанныеЛица = СтрокаТер[ИмяРеквизита];
					
					Террористы2_0_ЗаполнитьЮЛ(ДанныеЛица, НоваяСтрока);
					
					Для Каждого СписокДрНаименований Из ПолучитьМассивСтрокXDTO(ДанныеЛица, "СписокДрНаименований") Цикл
						Для Каждого ДрНаименование Из ПолучитьМассивСтрокXDTO(СписокДрНаименований, "ДрНаименование") Цикл
							Террористы2_0_ЗаполнитьЮЛ(ДрНаименование, ЭтотОбъект.СписокЮрФизЛиц.Добавить(), НоваяСтрока);
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НоваяСтрока.ВидЮрФизЛица = ФизЛицо Тогда
			Для Каждого ИмяРеквизита Из СтрРазделить("ФЛ", ",") Цикл
				Если СтрокаТер.Свойства().Получить(ИмяРеквизита) <> Неопределено Тогда
					ДанныеЛица = СтрокаТер[ИмяРеквизита];
					
					Террористы2_0_ЗаполнитьФЛ(ДанныеЛица, НоваяСтрока);
					
					Для Каждого СписокДрНаименований Из ПолучитьМассивСтрокXDTO(ДанныеЛица, "СписокДрНаименований") Цикл
						Для Каждого ДрНаименование Из ПолучитьМассивСтрокXDTO(СписокДрНаименований, "ДрНаименование") Цикл
							Террористы2_0_ЗаполнитьФЛ(ДрНаименование, ЭтотОбъект.СписокЮрФизЛиц.Добавить(), НоваяСтрока);
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если СтрокаТер.Свойства().Получить("СписокАдресов") <> Неопределено
		   И СтрокаТер.СписокАдресов.Свойства().Получить("Адрес") <> Неопределено Тогда
			МассивАдресов = Новый Массив;
		   
			Если ТипЗнч(СтрокаТер.СписокАдресов.Адрес) = Тип("СписокXDTO") Тогда
				Для Каждого СтрокаАдреса ИЗ СтрокаТер.СписокАдресов.Адрес Цикл
					МассивАдресов.Добавить(СтрокаАдреса.ТекстАдреса);
				КонецЦикла;
			Иначе
				МассивАдресов.Добавить(СтрокаТер.СписокАдресов.Адрес.ТекстАдреса);
			КонецЕсли;
			
			НоваяСтрока.Адрес = СтрСоединить(МассивАдресов, "/");

		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

Функция Террористы2_0_ЗаполнитьФЛ(ОбъектXDTO, НоваяСтрока, СтрокаРодитель = Неопределено)
	
	Если СтрокаРодитель <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРодитель);
	КонецЕсли;
	
	НоваяСтрока.Наименование	= ОбъектXDTO.ФИО;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ОбъектXDTO);
	
	МассивРегНомеров = Новый Массив;
	Для Каждого ИмяРеквизита Из СтрРазделить("ИНН,СНИЛС", ",") Цикл
		Если ОбъектXDTO.Свойства().Получить(ИмяРеквизита) <> Неопределено
		   И ЗначениеЗаполнено(ОбъектXDTO[ИмяРеквизита]) Тогда
			МассивРегНомеров.Добавить(ОбъектXDTO[ИмяРеквизита]);		
		КонецЕсли;
	КонецЦикла;
	
	Если МассивРегНомеров.Количество() Тогда
		НоваяСтрока.РегНомер = СтрСоединить(МассивРегНомеров, "/");
	КонецЕсли;
	
	ДатаРождения = ПолучитьЗначениеСвойства(ОбъектXDTO, "ДатаРождения", Тип("Дата")); 
	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		НоваяСтрока.ДатаРождения	= ДатаРождения; 
	КонецЕсли;
	
	Если СтрокаРодитель <> Неопределено Тогда
		КонтрольИУдалениеНеуникальнойСтроки(НоваяСтрока, СтрокаРодитель, "Фамилия,Имя,Отчество,ДатаРождения,МестоРождения");
	КонецЕсли;
	
КонецФункции

Функция Террористы2_0_ЗаполнитьЮЛ(ОбъектXDTO, НоваяСтрока, СтрокаРодитель = Неопределено)
	
	Если СтрокаРодитель <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРодитель);
	КонецЕсли;
	
	НоваяСтрока.Наименование	= ОбъектXDTO.Наименование;
	
	МассивРегНомеров = Новый Массив;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("ИНН,ОГРН", ",") Цикл
		Если ОбъектXDTO.Свойства().Получить(ИмяРеквизита) <> Неопределено
		   И ЗначениеЗаполнено(ОбъектXDTO[ИмяРеквизита]) Тогда
			МассивРегНомеров.Добавить(ОбъектXDTO[ИмяРеквизита]);		
		КонецЕсли;
	КонецЦикла;
	
	Если МассивРегНомеров.Количество() Тогда
		НоваяСтрока.РегНомер = СтрСоединить(МассивРегНомеров, "/");
	КонецЕсли;
	
	Если СтрокаРодитель <> Неопределено Тогда
		КонтрольИУдалениеНеуникальнойСтроки(НоваяСтрока, СтрокаРодитель, "Наименование,РегНомер");
	КонецЕсли;
	
КонецФункции

Процедура КонтрольИУдалениеНеуникальнойСтроки(НоваяСтрока, СтрокаРодитель, Реквизиты)

	УдалитьСтроку = Истина;
	
	Для Каждого Реквизит Из СтрРазделить(Реквизиты, ",") Цикл
		Если НоваяСтрока[Реквизит] <> СтрокаРодитель[Реквизит] Тогда
			УдалитьСтроку = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если УдалитьСтроку Тогда
		ЭтотОбъект.СписокЮрФизЛиц.Удалить(НоваяСтрока);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Сводный_перечень_Совета_Безопасности_ООН 

Процедура ПрочитатьФайлСпискаСБООН(Данные)

	ЭтотОбъект.ДатаСписка = СериализаторXDTO.XMLЗначение(Тип("Дата"), Лев(Данные.dateGenerated, 19));
	
	МассивСтрок = Новый Массив;
	
	ЮрЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо");
	ФизЛицо = ПредопределенноеЗначение("Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо");
	
	Для Каждого СписокФизЛиц Из ПолучитьМассивСтрокXDTO(Данные, "INDIVIDUALS") Цикл 
		
		Для Каждого СтрокаФизЛиц Из ПолучитьМассивСтрокXDTO(СписокФизЛиц, "INDIVIDUAL") Цикл
			
			FIRST_NAME =  СокрЛП(ПолучитьЗначениеСвойства(СтрокаФизЛиц, "FIRST_NAME"));
			SECOND_NAME = СокрЛП(ПолучитьЗначениеСвойства(СтрокаФизЛиц, "SECOND_NAME"));
			THIRD_NAME =  СокрЛП(ПолучитьЗначениеСвойства(СтрокаФизЛиц, "THIRD_NAME"));
			
			НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
			НоваяСтрока.ВидЮрФизЛица = ФизЛицо;
			
			Если ТипЗнч(THIRD_NAME) = Тип("Строка") И ЗначениеЗаполнено(THIRD_NAME) Тогда
				
				НоваяСтрока.ФИО			 = THIRD_NAME + " " + FIRST_NAME + " " + SECOND_NAME;	
				НоваяСтрока.Наименование = THIRD_NAME + " " + FIRST_NAME + " " + SECOND_NAME;	
				НоваяСтрока.Фамилия 	 = THIRD_NAME;
				НоваяСтрока.Имя 		 = FIRST_NAME;
				НоваяСтрока.Отчество 	 = SECOND_NAME;
				
			Иначе
				
				НоваяСтрока.ФИО			 = SECOND_NAME + " " + FIRST_NAME;
				НоваяСтрока.Наименование = SECOND_NAME + " " + FIRST_NAME;
				НоваяСтрока.Фамилия 	 = SECOND_NAME;
				НоваяСтрока.Имя 		 = FIRST_NAME;
				
			КонецЕсли;
			
			Для Каждого INDIVIDUAL_DATE_OF_BIRTH Из ПолучитьМассивСтрокXDTO(СтрокаФизЛиц, "INDIVIDUAL_DATE_OF_BIRTH") Цикл 
				
				НоваяСтрока.ДатаРождения = ПолучитьЗначениеСвойства(INDIVIDUAL_DATE_OF_BIRTH, "DATE", Тип("Дата"));
					
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.ДатаРождения) Тогда
					
					ГодРождения = ПолучитьЗначениеСвойства(INDIVIDUAL_DATE_OF_BIRTH, "YEAR", Тип("Число"));
					
					Если ЗначениеЗаполнено(ГодРождения) Тогда
						
						НоваяСтрока.ДатаРождения = Дата(ГодРождения, 1, 1);
						
					Иначе
						
						ГодРождения = ПолучитьЗначениеСвойства(INDIVIDUAL_DATE_OF_BIRTH, "FROM_YEAR", Тип("Число"));
						Если ЗначениеЗаполнено(ГодРождения) Тогда
							НоваяСтрока.ДатаРождения = Дата(ГодРождения, 1, 1);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Для Каждого INDIVIDUAL_PLACE_OF_BIRTH Из ПолучитьМассивСтрокXDTO(СтрокаФизЛиц, "INDIVIDUAL_PLACE_OF_BIRTH") Цикл
				
				МестоРождения = Новый Массив;
				МестоРождения.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_PLACE_OF_BIRTH, "COUNTRY"));
				МестоРождения.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_PLACE_OF_BIRTH, "STATE_PROVINCE"));
				МестоРождения.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_PLACE_OF_BIRTH, "CITY"));
				
				Пока МестоРождения.Найти("") <> Неопределено Цикл
					МестоРождения.Удалить(МестоРождения.Найти(""));
				КонецЦикла;	
				
				Если ЗначениеЗаполнено(НоваяСтрока.МестоРождения) Тогда
					НоваяСтрока.МестоРождения = НоваяСтрока.МестоРождения + Символы.ПС;	
				КонецЕсли;
				
				НоваяСтрока.МестоРождения = НоваяСтрока.МестоРождения + СтрСоединить(МестоРождения, ",");
				
			КонецЦикла;
			
			Для Каждого INDIVIDUAL_ADDRESS Из ПолучитьМассивСтрокXDTO(СтрокаФизЛиц, "INDIVIDUAL_ADDRESS") Цикл
				
				Адрес = Новый Массив;
				Адрес.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_ADDRESS, "ZIP_CODE", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_ADDRESS, "NOTE", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_ADDRESS, "COUNTRY", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_ADDRESS, "CITY", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_ADDRESS, "STREET", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(INDIVIDUAL_ADDRESS, "STATE_PROVINCE", Тип("Строка")));
				
				Пока Адрес.Найти("") <> Неопределено Цикл
					Адрес.Удалить(Адрес.Найти(""));
				КонецЦикла;	
				
				Если ЗначениеЗаполнено(НоваяСтрока.Адрес) Тогда
					НоваяСтрока.Адрес = НоваяСтрока.Адрес + "/";	
				КонецЕсли;
				
				НоваяСтрока.Адрес = НоваяСтрока.Адрес + СтрСоединить(Адрес, "/");
				
			КонецЦикла;
			
			Для Каждого INDIVIDUAL_DOCUMENT Из ПолучитьМассивСтрокXDTO(СтрокаФизЛиц, "INDIVIDUAL_DOCUMENT") Цикл
				
				Если ЗначениеЗаполнено(НоваяСтрока.РегНомер) Тогда
					НоваяСтрока.РегНомер = НоваяСтрока.РегНомер + "/";	
				КонецЕсли;
				
				НоваяСтрока.РегНомер = НоваяСтрока.РегНомер + ПолучитьЗначениеСвойства(INDIVIDUAL_DOCUMENT, "NUMBER", Тип("Строка"));
				
			КонецЦикла;

		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СписокЮрЛиц Из ПолучитьМассивСтрокXDTO(Данные, "ENTITIES") Цикл 
		
		Для Каждого СтрокаЮрЛиц Из ПолучитьМассивСтрокXDTO(СписокЮрЛиц, "ENTITY") Цикл
			
			НоваяСтрока = ЭтотОбъект.СписокЮрФизЛиц.Добавить();
			НоваяСтрока.ВидЮрФизЛица = ЮрЛицо;
			НоваяСтрока.Наименование = ПолучитьЗначениеСвойства(СтрокаЮрЛиц, "FIRST_NAME", Тип("Строка"));
			
			Для Каждого ENTITY_ADDRESS Из ПолучитьМассивСтрокXDTO(СтрокаЮрЛиц, "ENTITY_ADDRESS") Цикл
				
				Адрес = Новый Массив;
				Адрес.Добавить(ПолучитьЗначениеСвойства(ENTITY_ADDRESS, "ZIP_CODE", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(ENTITY_ADDRESS, "NOTE", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(ENTITY_ADDRESS, "COUNTRY", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(ENTITY_ADDRESS, "CITY", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(ENTITY_ADDRESS, "STREET", Тип("Строка")));
				Адрес.Добавить(ПолучитьЗначениеСвойства(ENTITY_ADDRESS, "STATE_PROVINCE", Тип("Строка")));
				
				Пока Адрес.Найти("") <> Неопределено Цикл
					Адрес.Удалить(Адрес.Найти(""));
				КонецЦикла;	
				
				Если ЗначениеЗаполнено(НоваяСтрока.Адрес) Тогда
					НоваяСтрока.Адрес = НоваяСтрока.Адрес + "/";	
				КонецЕсли;
				
				НоваяСтрока.Адрес = НоваяСтрока.Адрес + СтрСоединить(Адрес, "/");
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

