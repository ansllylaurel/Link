
// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		"ДополнительнаяОбработка",
		"Проверка клиентов по СМЭВ",
		"0.15",
		"",
		Истина);
		
	// команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтправитьЗапрос", "Отправить запрос",, Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОбновитьАнкеты", "Обновить анкеты с упрощенной идентификацией",, Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Интерфейс для запуска формирования отчетов по регламентному заданию
//
// Параметры:
//     ИдентификаторКоманды (строка)  - идентификатор команды
//     ПараметрыОбработки (структура) - структура со свойством ДополнительнаяОбработкаСсылка (ссылка на
//        элемент справочника ДополнительныеОтчетыИОбработки, который связан с данной дополнительной обработкой)
//
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды, ПараметрыОбработки.ГруппаПараметров);
	Ошибки = "";
	
	ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды);
	
	Если ИдентификаторКоманды = "ОтправитьЗапрос" Тогда
		
		Ошибки = РегистрыСведений.ЖурналСверкиСоСписками.СверитьПоСМЭВ(ПараметрыКоманды.Организация);
		
		ТекстОшибкиРассылки = ОтправитьОтчетОНедействительныхПаспортахПоСМЭВ(ПараметрыКоманды.Организация);
		Если ЗначениеЗаполнено(ТекстОшибкиРассылки) Тогда
			Если ЗначениеЗаполнено(Ошибки) Тогда
				Ошибки = Ошибки + Символы.ПС + ТекстОшибкиРассылки;
			Иначе
				Ошибки = ТекстОшибкиРассылки;
			КонецЕсли;
		КонецЕсли;
				
	ИначеЕсли ИдентификаторКоманды = "ОбновитьАнкеты" Тогда
		
		ОбновитьАнкетыСУпрощеннойИдентификацией(ПараметрыКоманды);
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку(Ошибки, ПараметрыОбработки.ДополнительнаяОбработкаСсылка);
		ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, Ошибки);
	КонецЕсли;
	
	ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
	
КонецПроцедуры

Функция ОтправитьОтчетОНедействительныхПаспортахПоСМЭВ(Организация)
	
	ИмяВременногоФайла = "";
	
	Попытка
		
		РезультатОтчета = РезультатыСверкиПоСМЭВНедействительныеПаспорта(Организация);
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
		РезультатОтчета.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
		
		Вложения = Новый Соответствие;
		Вложения.Вставить(НСтр("ru = 'Клиенты с недействительными паспортами.xlsx'"), ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла)));
		
		УдалитьФайлы(ИмяВременногоФайла);
		ИмяВременногоФайла = "";
		
		РеквизитыОповещения = Новый Структура;
		РеквизитыОповещения.Вставить("Организация",	Организация);
		РеквизитыОповещения.Вставить("Вложения",		Вложения);
		
		Справочники.Оповещения.СформироватьОповещения(
			"Обработка._ПроверкаКлиентовПоСМЭВ",
			Перечисления.ТипыСобытий.ВнешнийВызов,
			РеквизитыОповещения);
		
	Исключение
		
		Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Функция РезультатыСверкиПоСМЭВНедействительныеПаспорта(Организация, Период = Неопределено)
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ДокументРезультат.ФиксацияСверху = 6;
	
	ДокументРезультат.ТолькоПросмотр		= Истина;
	ДокументРезультат.ОтображатьСетку		= Ложь;
	ДокументРезультат.ОтображатьЗаголовки	= Ложь;
	
	Если Период = Неопределено Тогда
		ПериодОтчета = КонецДня(ТекущаяДатаСеанса());
	Иначе
		ПериодОтчета = КонецДня(Период);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Справочники.ЮрФизЛица.ПоместитьКлиентовВМенеджерВременныхТаблиц(Запрос, Организация, ПериодОтчета);
	
	#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_Клиенты.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ЖурналСверкиСоСпискамиСрезПоследних.Период КАК ПериодСверки,
		|	ЖурналСверкиСоСпискамиСрезПоследних.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Фамилия КАК Фамилия,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Имя КАК Имя,
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.Отчество КАК Отчество
		|ПОМЕСТИТЬ _ТекущиеНедействительные
		|ИЗ
		|	_Клиенты КАК _Клиенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		|		ПО _Клиенты.ЮрФизЛицо = ЮрФизЛица.Ссылка
		|			И (ЮрФизЛица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверкиСоСписками.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СМЭВ)) КАК ЖурналСверкиСоСпискамиСрезПоследних
		|		ПО _Клиенты.ЮрФизЛицо = ЖурналСверкиСоСпискамиСрезПоследних.ЮрФизЛицо
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|		ПО _Клиенты.ЮрФизЛицо = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|ГДЕ
		|	ЖурналСверкиСоСпискамиСрезПоследних.Статус = ""INVALID""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ТекущиеНедействительные.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ТекущиеНедействительные.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
		|	_ТекущиеНедействительные.СерияУдостоверенияЛичности КАК СерияУдостоверенияЛичности,
		|	_ТекущиеНедействительные.НомерУдостоверенияЛичности КАК НомерУдостоверенияЛичности,
		|	_ТекущиеНедействительные.Фамилия КАК Фамилия,
		|	_ТекущиеНедействительные.Имя КАК Имя,
		|	_ТекущиеНедействительные.Отчество КАК Отчество,
		|	&СостояниеПаспорта КАК СостояниеПаспорта,
		|	&ИсточникСведений КАК ИсточникСведений,
		|	ВЫБОР
		|		КОГДА ПервыеВыявления.ПервыйПериод < _ТекущиеНедействительные.ПериодСверки
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПорядокГруппы
		|ИЗ
		|	_ТекущиеНедействительные КАК _ТекущиеНедействительные
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЖурналСверкиСоСписками.ЮрФизЛицо КАК ЮрФизЛицо,
		|			МИНИМУМ(ЖурналСверкиСоСписками.Период) КАК ПервыйПериод
		|		ИЗ
		|			РегистрСведений.ЖурналСверкиСоСписками КАК ЖурналСверкиСоСписками
		|		ГДЕ
		|			ЖурналСверкиСоСписками.Организация = &Организация
		|			И (ЖурналСверкиСоСписками.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СМЭВ)
		|					И ЖурналСверкиСоСписками.Статус = ""INVALID""
		|				ИЛИ ЖурналСверкиСоСписками.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокНедействительныхПаспортов)
		|					И ЖурналСверкиСоСписками.Пройдена = ЛОЖЬ)
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ЖурналСверкиСоСписками.ЮрФизЛицо) КАК ПервыеВыявления
		|		ПО _ТекущиеНедействительные.ЮрФизЛицо = ПервыеВыявления.ЮрФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокГруппы,
		|	Фамилия,
		|	Имя,
		|	Отчество
		|ИТОГИ ПО
		|	ПорядокГруппы";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Период",				ПериодОтчета);
	Запрос.УстановитьПараметр("СостояниеПаспорта",	НСтр("ru = 'Паспорт недействителен'"));
	Запрос.УстановитьПараметр("ИсточникСведений",	НСтр("ru = 'СМЭВ'"));
	
	Макет = ПолучитьМакет("МакетСверкиПоСМЭВНедействительныеПаспорта");
	
	ПараметрыОтчета = Новый Массив;
	ПараметрыОтчета.Добавить(СтрШаблон(НСтр("ru = 'Организация: %1'"), Организация));
	ПараметрыОтчета.Добавить(НСтр("ru = 'Источник сведений: СМЭВ'"));
	ПараметрыОтчета.Добавить(СтрШаблон(НСтр("ru = 'Период: %1'"), Формат(ПериодОтчета, "ДФ=dd.MM.yyyy")));
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ПараметрыОтчета = СтрСоединить(ПараметрыОтчета, Символы.ПС);
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ВыборкаГрупп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НомерСтроки = 0;
	ПоследняяВыведеннаяГруппа = 0;
	
	Пока ВыборкаГрупп.Следующий() Цикл
		
		Для ПропущеннаяГруппа = ПоследняяВыведеннаяГруппа + 1 По ВыборкаГрупп.ПорядокГруппы - 1 Цикл
			ДокументРезультат.Вывести(Макет.ПолучитьОбласть("Статус" + ПропущеннаяГруппа));
		КонецЦикла;
		
		ДокументРезультат.Вывести(Макет.ПолучитьОбласть("Статус" + ВыборкаГрупп.ПорядокГруппы));
		ПоследняяВыведеннаяГруппа = ВыборкаГрупп.ПорядокГруппы;
		
		ВыборкаДетальныеЗаписи = ВыборкаГрупп.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаДетальныеЗаписи);
			НомерСтроки = НомерСтроки + 1;
			ОбластьСтрока.Параметры.НП = НомерСтроки;
			
			ДокументРезультат.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для ПропущеннаяГруппа = ПоследняяВыведеннаяГруппа + 1 По 2 Цикл
		ДокументРезультат.Вывести(Макет.ПолучитьОбласть("Статус" + ПропущеннаяГруппа));
	КонецЦикла;
	
	Возврат ДокументРезультат;
	
КонецФункции

Процедура ОбновитьАнкетыСУпрощеннойИдентификацией(ПараметрыКоманды)

	Организация = ПараметрыКоманды.Организация;
	ПолучателиОповещения = ПараметрыКоманды.ПолучателиОповещения;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	#Область Текст_запроса
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент
		|ПОМЕСТИТЬ _КлиентыДоверительногоУправления
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|ГДЕ
		|	(СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения >= &Период)
		|	И КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ЮрФизЛица
		|	И СчетаДоверительногоУправления.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ДолиПайщиковВИнвестиционномФондеОстатки.Пайщик
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&Период, Организация = &Организация) КАК ДолиПайщиковВИнвестиционномФондеОстатки
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаявкаПайщика.Пайщик
		|ИЗ
		|	Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО ЗаявкаПайщика.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
		|			И (КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения >= &Период)
		|ГДЕ
		|	ЗаявкаПайщика.Многократная
		|	И ЗаявкаПайщика.ВидЗаявки = ЗНАЧЕНИЕ(Перечисление.ВидыЗаявокПайщиков.Зачисление)
		|	И ЗаявкаПайщика.Организация = &Организация
