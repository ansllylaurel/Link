		|	_ФизическиеЛица.ФизЛицо КАК ФизЛицо,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.Статус = ""VALID"", ЛОЖЬ) КАК АнкетаОбновлена,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.ДатаПоследнейСверки, ""-"") КАК ДатаПоследнейСверки,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.Комментарий, ""Проверка не пройдена"") КАК Комментарий,
		|	ЕСТЬNULL(ЖурналСверкиСоСписками.Пройдена, ЛОЖЬ) КАК Пройдена,
		|	АнкетаФизическогоЛица.Ссылка КАК Анкета
		|ИЗ
		|	_ФизическиеЛица КАК _ФизическиеЛица
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(&Период, Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФизическихЛицАнкетныеСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АнкетаФизическогоЛица КАК АнкетаФизическогоЛица
		|			ПО РеквизитыФизическихЛицАнкетныеСрезПоследних.Регистратор = АнкетаФизическогоЛица.Ссылка
		|				И (АнкетаФизическогоЛица.УпрощеннаяИдентификация)
		|		ПО _ФизическиеЛица.ФизЛицо = РеквизитыФизическихЛицАнкетныеСрезПоследних.ЮрФизЛицо
		|			И (РеквизитыФизическихЛицАнкетныеСрезПоследних.Организация = &Организация)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверкиСоСписками КАК ЖурналСверкиСоСписками
		|		ПО _ФизическиеЛица.ФизЛицо = ЖурналСверкиСоСписками.ЮрФизЛицо
		|			И (ЖурналСверкиСоСписками.ВидПеречня = ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СМЭВ))
		|			И (ЖурналСверкиСоСписками.Период = &Период)
		|			И (ЖурналСверкиСоСписками.Организация = &Организация)
		|ГДЕ
		|	РеквизитыФизическихЛицАнкетныеСрезПоследних.ВидУдостоверенияЛичности = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)
		|	И РАЗНОСТЬДАТ(&Период, ДОБАВИТЬКДАТЕ(РеквизитыФизическихЛицАнкетныеСрезПоследних.Период, ГОД, 1), ДЕНЬ) <= 20
		|
		|УПОРЯДОЧИТЬ ПО
		|	АнкетаОбновлена,
		|	ФизЛицо
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	#КонецОбласти 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = ПолучитьМакет("Макет");
	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));
	Строка = Макет.ПолучитьОбласть("Строка");
	
	Пока Выборка.Следующий() Цикл
		
		Строка.Параметры.Заполнить(Выборка);
		
		Если Выборка.АнкетаОбновлена Тогда
			// обновляем анкету
			Анкета = Выборка.Анкета.Скопировать();
			Анкета.Организация = Организация;
			Анкета.Дата = ТекущаяДатаСеанса();
			Анкета.Записать(РежимЗаписиДокумента.Проведение);
			Анкета.ДополнительныеСвойства.Вставить("АвтоматическоеОбновлениеАнкет");
			Строка.Область("Строка").ЦветТекста = WebЦвета.Черный;
		Иначе
			Строка.Область("Строка").ЦветТекста = WebЦвета.Красный;
		КонецЕсли; 
		
		ТабДок.Вывести(Строка);
		
	КонецЦикла; 
	
	Если Выборка.Количество() > 0 Тогда
	
		ИмяФайла = ПолучитьИмяВременногоФайла("htm");
		ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML);
		
		ТемаПисьма = "Обновление анкет физических лиц по организации " + Организация;
		
		ТелоПисьма = Новый ТекстовыйДокумент;
		ТелоПисьма.Прочитать(ИмяФайла);
		
		УдалитьФайлы(ИмяФайла);
		
		ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", ПолучателиОповещения, ТемаПисьма, ТелоПисьма.ПолучитьТекст(), ТипТекстаПочтовогоСообщения.HTML);
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма, , Истина);
	
	КонецЕсли; 

КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки) Экспорт
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
	
КонецПроцедуры

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды) Экспорт
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(ЭтотОбъект, ИмяКоманды);
КонецФункции

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	
	Если ПараметрыСессии = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
	
КонецПроцедуры

#КонецОбласти
 
