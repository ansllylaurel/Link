 	var queueID;
    var purl;
	var label;
	var preAlertLabel;
	var alertLabel;
	var UKUFO;
	var targetDiv;

	// вызов публикации
    function createAlertBar () {
      	hideRequestBlock();
        purl = '/app/v1.2/api/publications/action/GetOperatorByQueueId?queueID=' + queueID.val().taskId;
        $.ajax({
            method: "GET",
            url: purl,
        })
        .done(function(data) {
          	try {
               drawAlertBar (data[0].DisplayName, data[0].Phone, data[0].Email, data[0].que[0].GeneralEmail);
            }
            catch (e) {
               drawAlertBar ('', '', '', '');
            }
        });               
    }
    // подготовка индикатора - текст, цвет
    function drawAlertBar (displayname, phone, email, generalemail) {
      //if (!!displayname) {
      	  targetDiv = document.querySelector('[ep-wrapper-id="987"]');
          alertLabel = document.getElementById('clientIDAlertLabel');
          if (!alertLabel) {
            alertLabel = document.createElement('span');
            alertLabel.id = 'clientIDAlertLabel';
            alertLabel.classList.add('alert-label');
            targetDiv.appendChild(alertLabel);
          }
          alertLabel.style.backgroundColor = "#9fdbad";
          if (displayname == '' || !displayname) {
            alertLabel.innerHTML = '';
          }
          else {
            if (generalemail != '') {
              alertLabel.innerHTML = '[Дежурный (c 9:30 до 18:00): ' + displayname + '; телефон: ' + phone + '; почта: ' + generalemail + ']';
            }
            else {
              alertLabel.innerHTML = '[Дежурный (c 9:30 до 18:00): ' + displayname + '; телефон: ' + phone + '; почта: ' + email + ']';
            }
          }
      //}
  }
	
      // вызов публикации
  function hideRequestBlock() {
     UKUFO = document.querySelector('.vh-task-card__params .vh-task-card-params-wrapper.ng-star-inserted [data-id="331"]'); 
     techParams = document.querySelector('.vh-task-card__params .vh-task-card-params-wrapper.ng-star-inserted [data-id="45"]'); 
     techParams.style.display = "none";
     if (queueID.val()) {
         if (queueID.val().taskId == 227182) {
        	UKUFO.style.display = "block";
         }
         else {
        	UKUFO.style.display = "none";
     	 }
     }
     else {
        UKUFO.style.display = "none";
     }
  }

  function onLoad() {
      queueID = new ExtParam(987);
      try {
        alertLabel.innerHTML = '' 
      }
      catch(err) {
      }
      queueID.change(() => createAlertBar());
      createAlertBar();
  }

  function onDestroy() {
      window.removeEventListener('MTFMainLoadFinished', onLoad);
   }  
      
  window.addEventListener('MTFMainLoadFinished', onLoad);
  window.addEventListener('MTFMainDestroyed', onDestroy);