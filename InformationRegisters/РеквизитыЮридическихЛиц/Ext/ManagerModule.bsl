Функция ПроверитьРеквизитыЮрлица(Запись, Отказ) Экспорт
	
		Если ЗначениеЗаполнено(Запись.ИНН) Тогда
			
			Если Запись.ОрганизационноПравоваяФорма = ПредопределенноеЗначение("Справочник.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие") Тогда
				Если СтрДлина(Запись.ИНН) <> 12 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать ИНН '" + Запись.ИНН + "'. ИНН индивидуального частного предприятия должен состоять из 12 символов!", Запись.ЮрФизЛицо,,, Отказ);
				КонецЕсли;
			Иначе
				Если СтрДлина(Запись.ИНН) <> 10 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать ИНН '" + Запись.ИНН + "'. ИНН юридического лица должен состоять из 10 символов!", Запись.ЮрФизЛицо,,, Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Запись.СтранаРегистрации = Справочники.СтраныМира.Россия
			И (ТипЗнч(Запись) = Тип("РегистрСведенийЗапись.РеквизитыЮридическихЛицАнкетные") 
				Или Запись.ВидРегистрационногоДокумента = Перечисления.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)
			И ЗначениеЗаполнено(Запись.ОГРН) Тогда
			
			Если Запись.ОрганизационноПравоваяФорма = ПредопределенноеЗначение("Справочник.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие") Тогда
				Если СтрДлина(Запись.ОГРН) <> 15 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать ОГРН '" + Запись.ОГРН + "'. ОГРН индивидуального частного предприятия должен состоять из 15 символов!", Запись.ЮрФизЛицо,,, Отказ);
				КонецЕсли;
			Иначе
				Если СтрДлина(Запись.ОГРН) <> 13 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать ОГРН '" + Запись.ОГРН + "'. ОГРН юридического должен состоять из 13 символов!", Запись.ЮрФизЛицо,,, Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	
КонецФункции