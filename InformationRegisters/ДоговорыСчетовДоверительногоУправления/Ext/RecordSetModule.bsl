Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Проверяем, что записи с разрешенными видами договоров
	ЗапрещенныеВидыДоговоров = Новый Массив;
	ЗапрещенныеВидыДоговоров.Добавить(Перечисления.ВидыДоговоров.СоглашениеОбЭДО);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗапрещенныеВидыДоговоров", ЗапрещенныеВидыДоговоров);
	Запрос.УстановитьПараметр("Договоры", ЭтотОбъект.Выгрузить().ВыгрузитьКолонку("Договор"));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.ВидДоговора КАК ВидДоговора
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Ссылка В(&Договоры)
		|	И Договоры.ВидДоговора В(&ЗапрещенныеВидыДоговоров)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Договор '%1' с видом '%2' не может быть прикреплен к счету доверительного управления", Выборка.Договор, Выборка.ВидДоговора), Выборка.Договор,,, Отказ);
	КонецЦикла;
	
	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры // ОбработкаПроверкиЗаполнения

Процедура ПередЗаписью(Отказ, Замещение)
	
	УниверсальныеМеханизмы.ЗаполнитьОрганизациюИзВедущегоИзмерения(ЭтотОбъект, "СчетДоверительногоУправления");
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПередЗаписью