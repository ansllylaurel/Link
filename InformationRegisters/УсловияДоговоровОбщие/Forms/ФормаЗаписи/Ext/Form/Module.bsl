

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьИДоступность(Форма)
	
	Запись		= Форма.Запись;
	Элементы	= Форма.Элементы;
	
	Элементы.ГруппаСрокОплаты.Видимость = (ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.ДоговорыБрокерскогоОбслуживания") 
									  		ИЛИ (ТипЗнч(Запись.Договор) = Тип("СправочникСсылка.Договоры") И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Запись.Договор, "ВидДоговора") <> ПредопределенноеЗначение("Перечисление.ВидыДоговоров.ДополнительноеСоглашение")));
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	НастроитьВидимостьИДоступность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаРасторженияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Запись.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Запись.ДатаРасторжения) Тогда
		Возврат;
	КонецЕсли;
	
	АдресДереваДочернихЭлементов = АдресДереваДочернихПриРасторженииДоговораНаСервере(
		Запись.Договор, Запись.ДатаРасторжения, ЭтаФорма.УникальныйИдентификатор);
	
	Если Не ЗначениеЗаполнено(АдресДереваДочернихЭлементов) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеРеквизиты = Новый Массив;
	ДополнительныеРеквизиты.Добавить(Новый Структура(
		"Имя, ТипЗначения, Заголовок, Значение",
		"ДатаЗакрытия",
		Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата)),
		"Дата расторжения",
		Запись.ДатаРасторжения));
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимВыбора",               Истина);
	ДополнительныеПараметры.Вставить("МножественныйВыбор",        Истина);
	ДополнительныеПараметры.Вставить("ВидимыеКолонки",            "Представление");
	ДополнительныеПараметры.Вставить("ОтмеченныеЭлементы",        Новый Структура("Элемент", Запись.Договор));
	ДополнительныеПараметры.Вставить("ДополнительныеРеквизиты",   ДополнительныеРеквизиты);
	ДополнительныеПараметры.Вставить("ПутьКДаннымКартинкиСтроки", "ДеревоЗначений.ДанныеКартинки");
	ДополнительныеПараметры.Вставить("КартинкаСтрок",             БиблиотекаКартинок.РегистрСведенийЗапись);
	
	РезультатВопроса = РаботаСФормамиКлиент.ПоказатьДеревоЗначений(
		АдресДереваДочернихЭлементов,
		"При расторжении договора будут закрыты подчинённые элементы:",
		ЭтаФорма,
		РежимДиалогаВопрос.ОКОтмена,
		КодВозвратаДиалога.ОК,
		"Расторжение договора",
		ДополнительныеПараметры);
	
	Если РезультатВопроса <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	РаботаСИсполнителями.ЗакрытьДеревоЭлементов(
		ДополнительныеПараметры.АдресДереваЗначений,
		ДополнительныеПараметры.ДополнительныеРеквизиты.ДатаЗакрытия);
	
	ЭтотОбъект.Прочитать();
	
КонецПроцедуры

// Для договоров депозитарного обслуживания дерево строится обходом в ширину с защитой от циклов,
// без изменения общего модуля РаботаСИсполнителями. Остальные виды — прежний вызов ПолучитьДочерниеЭлементы.
//
&НаСервере
Функция ПриРасторженииИспользоватьДеревоБезРекурсииОбщегоМодуля(Договор)
	
	ВидыДепозит = Новый Массив;
	ВидыДепозит.Добавить(Перечисления.ВидыДоговоров.ДепозитарногоОбслуживания);
	ВидыДепозит.Добавить(Перечисления.ВидыДоговоров.ОтветственногоХранения);
	ВидыДепозит.Добавить(Перечисления.ВидыДоговоров.ВеденияРеестра);
	ВидыДепозит.Добавить(Перечисления.ВидыДоговоров.СпецДепозитарногоОбслуживания);
	ВидыДепозит.Добавить(Перечисления.ВидыДоговоров.СпецРегистрационногоОбслуживания);
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
	
	ВидОсновногоДоговора = Перечисления.ВидыДоговоров.ПустаяСсылка();
	Если ВидДоговора = Перечисления.ВидыДоговоров.ДополнительноеСоглашение Тогда
		
		Основание = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Основание");
		Если ЗначениеЗаполнено(Основание) И ТипЗнч(Основание) = Тип("СправочникСсылка.Договоры") Тогда
			ВидОсновногоДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ВидДоговора");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВидыДепозит.Найти(ВидДоговора) <> Неопределено Или ВидыДепозит.Найти(ВидОсновногоДоговора) <> Неопределено;
	
КонецФункции

&НаСервере
Функция ПрямыеДочерниеПриРасторженииДепозитарногоДоговора(Объект, ДатаГраницы)
	
	СтрокиДетей = Новый Массив;
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Договоры") Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	""Счет: "" КАК ТипОбъекта,
			|	""СправочникСсылка.ДепозитарныеСчета"" КАК ТипЗначенияЭлемента,
			|	2 КАК ДанныеКартинки,
			|	ДепозитарныеСчета.Ссылка КАК СсылкаЭлемента,
			|	ДепозитарныеСчета.Наименование КАК Представление
			|ИЗ
			|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
			|ГДЕ
			|	ДепозитарныеСчета.Договор = &Договор
			|	И ДепозитарныеСчета.ПометкаУдаления = ЛОЖЬ
			|	И ДепозитарныеСчета.Родитель = ЗНАЧЕНИЕ(Справочник.ДепозитарныеСчета.ПустаяСсылка)
			|	И (ДепозитарныеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ ДепозитарныеСчета.ДатаЗакрытия > &ДатаГраницы)
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	""Доп. соглашение:"",
			|	""СправочникСсылка.Договоры"",
			|	2,
			|	Договоры.Ссылка,
			|	Договоры.Наименование
			|ИЗ
			|	(ВЫБРАТЬ
			|		Договоры.Ссылка КАК Ссылка,
			|		Договоры.Наименование КАК Наименование,
			|		ЕСТЬNULL(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗакрытия
			|	ИЗ
			|		Справочник.Договоры КАК Договоры
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних КАК УсловияДоговоровОбщиеСрезПоследних
			|			ПО Договоры.Ссылка = УсловияДоговоровОбщиеСрезПоследних.Договор
			|	ГДЕ
			|		Договоры.Основание = &Договор
			|		И Договоры.ПометкаУдаления = ЛОЖЬ) КАК Договоры
			|ГДЕ
			|	(Договоры.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ Договоры.ДатаЗакрытия > &ДатаГраницы)");
		
		Запрос.УстановитьПараметр("Договор",      Объект);
		Запрос.УстановитьПараметр("ДатаГраницы",  ДатаГраницы);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Стр = Новый Структура("Элемент, ТипОбъекта, Представление, ДанныеКартинки");
			Стр.Элемент = Выборка.СсылкаЭлемента;
			Стр.ТипОбъекта = Выборка.ТипОбъекта;
			Стр.Представление = Выборка.Представление;
			Стр.ДанныеКартинки = Выборка.ДанныеКартинки;
			СтрокиДетей.Добавить(Стр);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.ДепозитарныеСчета") Тогда
		
		ЗапросРазделы = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДепозитарныеСчета.Ссылка КАК СсылкаЭлемента,
			|	ДепозитарныеСчета.Наименование КАК Представление
			|ИЗ
			|	Справочник.ДепозитарныеСчета КАК ДепозитарныеСчета
			|ГДЕ
			|	ДепозитарныеСчета.Родитель = &ДепозитарныйСчет
			|	И ДепозитарныеСчета.ПометкаУдаления = ЛОЖЬ
			|	И (ДепозитарныеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ ДепозитарныеСчета.ДатаЗакрытия > &ДатаГраницы)");
		
		ЗапросРазделы.УстановитьПараметр("ДепозитарныйСчет", Объект);
		ЗапросРазделы.УстановитьПараметр("ДатаГраницы",      ДатаГраницы);
		
		Выборка = ЗапросРазделы.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Стр = Новый Структура("Элемент, ТипОбъекта, Представление, ДанныеКартинки");
			Стр.Элемент = Выборка.СсылкаЭлемента;
			Стр.ТипОбъекта = "Раздел счета: ";
			Стр.Представление = Выборка.Представление;
			Стр.ДанныеКартинки = 1;
			СтрокиДетей.Добавить(Стр);
			
		КонецЦикла;
		
		ЗапросИсп = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсполнителиПоЦеннымБумагам.Организация КАК Организация,
			|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет КАК ДепозитарныйСчет,
			|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ИсполнителиПоЦеннымБумагам.СчетДоверительногоУправления.Наименование КАК НаименованиеСДУ
			|ИЗ
			|	РегистрСведений.ИсполнителиПоЦеннымБумагам КАК ИсполнителиПоЦеннымБумагам
			|ГДЕ
			|	ИсполнителиПоЦеннымБумагам.ДепозитарныйСчет = &ДепозитарныйСчет
			|	И (ИсполнителиПоЦеннымБумагам.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ ИсполнителиПоЦеннымБумагам.ДатаЗакрытия > &ДатаГраницы)");
		
		ЗапросИсп.УстановитьПараметр("ДепозитарныйСчет", Объект);
		ЗапросИсп.УстановитьПараметр("ДатаГраницы",      ДатаГраницы);
		
		Выборка = ЗапросИсп.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Стр = Новый Структура("Элемент, ТипОбъекта, Представление, ДанныеКартинки");
			СтруктураКлюча = Новый Структура("Организация, СчетДоверительногоУправления, ДепозитарныйСчет");
			ЗаполнитьЗначенияСвойств(СтруктураКлюча, Выборка);
			Стр.Элемент = РегистрыСведений.ИсполнителиПоЦеннымБумагам.СоздатьКлючЗаписи(СтруктураКлюча);
			Стр.ТипОбъекта = "Исполнитель: ";
			Стр.Представление = Выборка.НаименованиеСДУ;
			Стр.ДанныеКартинки = 0;
			СтрокиДетей.Добавить(Стр);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СтрокиДетей;
	
КонецФункции

&НаСервере
Функция АдресДереваРасторженияДепозитарногоДоговораНаСервере(Договор, ДатаРасторжения, УникальныйИдентификаторФормы)
	
	ДеревоРезультат = Новый ДеревоЗначений;
	ДеревоРезультат.Колонки.Добавить("Элемент");
	ДеревоРезультат.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"), "Договор / Счет / Раздел / Исполнитель");
	ДеревоРезультат.Колонки.Добавить("ДанныеКартинки", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(2)));
	
	КорневаяСтрока = ДеревоРезультат.Строки.Добавить();
	КорневаяСтрока.Элемент = Договор;
	КорневаяСтрока.Представление = "Договор: " + Строка(Договор);
	КорневаяСтрока.ДанныеКартинки = 3;
	
	Просмотренные = Новый Соответствие;
	Просмотренные.Вставить(Договор, Истина);
	
	ОчередьСсылок = Новый Массив;
	ОчередьУзлов  = Новый Массив;
	ОчередьСсылок.Добавить(Договор);
	ОчередьУзлов.Добавить(КорневаяСтрока);
	
	Пока ОчередьСсылок.Количество() > 0 Цикл
		
		ТекущийОбъект = ОчередьСсылок[0];
		УзелРодитель  = ОчередьУзлов[0];
		ОчередьСсылок.Удалить(0);
		ОчередьУзлов.Удалить(0);
		
		СтрокиДетей = ПрямыеДочерниеПриРасторженииДепозитарногоДоговора(ТекущийОбъект, ДатаРасторжения);
		Для Каждого СтрДоч Из СтрокиДетей Цикл
			
			ЭлементРебенок = СтрДоч.Элемент;
			
			Если ТипЗнч(ЭлементРебенок) = Тип("СправочникСсылка.ДепозитарныеСчета")
				Или ТипЗнч(ЭлементРебенок) = Тип("СправочникСсылка.Договоры") Тогда
				
				Если Просмотренные.Получить(ЭлементРебенок) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Просмотренные.Вставить(ЭлементРебенок, Истина);
				
			КонецЕсли;
			
			СтрокаДерева = УзелРодитель.Строки.Добавить();
			СтрокаДерева.Элемент = ЭлементРебенок;
			СтрокаДерева.Представление = СтрДоч.ТипОбъекта + СтрДоч.Представление;
			СтрокаДерева.ДанныеКартинки = СтрДоч.ДанныеКартинки;
			
			Если ТипЗнч(ЭлементРебенок) = Тип("СправочникСсылка.ДепозитарныеСчета")
				Или ТипЗнч(ЭлементРебенок) = Тип("СправочникСсылка.Договоры") Тогда
				
				ОчередьСсылок.Добавить(ЭлементРебенок);
				ОчередьУзлов.Добавить(СтрокаДерева);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если КорневаяСтрока.Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ДеревоРезультат, УникальныйИдентификаторФормы);
	
КонецФункции

&НаСервере
Функция АдресДереваДочернихПриРасторженииДоговораНаСервере(Договор, ДатаРасторжения, УникальныйИдентификаторФормы)
	
	Если ПриРасторженииИспользоватьДеревоБезРекурсииОбщегоМодуля(Договор) Тогда
		Возврат АдресДереваРасторженияДепозитарногоДоговораНаСервере(Договор, ДатаРасторжения, УникальныйИдентификаторФормы);
	КонецЕсли;
	
	Отбор = "(ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1) ИЛИ ДатаЗакрытия > ДАТАВРЕМЯ("
		+ Формат(Год(ДатаРасторжения), "ЧГ=0") + ", " + Формат(Месяц(ДатаРасторжения), "ЧГ=0") + ", " + Формат(День(ДатаРасторжения), "ЧГ=0") + ", 0, 0, 0))";
	
	Возврат РаботаСИсполнителями.ПолучитьДочерниеЭлементы(Договор, , Отбор, , УникальныйИдентификаторФормы);
	
КонецФункции

