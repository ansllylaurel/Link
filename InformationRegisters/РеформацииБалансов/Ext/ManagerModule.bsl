Функция ПолучитьДатыРеформацийЗаПериод(СчетДоверительногоУправления, НачалоПериода, КонецПериода) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеформацииБалансов.ДатаРеформации КАК ДатаРеформации
		|ИЗ
		|	РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
		|ГДЕ
		|	РеформацииБалансов.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|	И РеформацииБалансов.ДатаРеформации МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаРеформации";
	
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьПериодыСУчетомРеформаций(СчетДоверительногоУправления, НачалоПериода, КонецПериода) Экспорт

	ДатыРеформаций = ПолучитьДатыРеформацийЗаПериод(СчетДоверительногоУправления, НачалоПериода, КонецПериода);
	
	ПериодыСУчетомРеформаций = Новый ТаблицаЗначений;
	ПериодыСУчетомРеформаций.Колонки.Добавить("НачалоПериода", Новый ОписаниеТипов("Дата"));
	ПериодыСУчетомРеформаций.Колонки.Добавить("КонецПериода", Новый ОписаниеТипов("Дата"));
	
	НачальнаяДата = НачалоПериода;
	
	НовыйПериод = ПериодыСУчетомРеформаций.Добавить();
	НовыйПериод.НачалоПериода = НачалоПериода;
	
	Для каждого СтрокаДатыРеформаций Из ДатыРеформаций Цикл
	
		НовыйПериод.КонецПериода = КонецДня(СтрокаДатыРеформаций.ДатаРеформации);
		
		НовыйПериод = ПериодыСУчетомРеформаций.Добавить();
		НовыйПериод.НачалоПериода = СтрокаДатыРеформаций.ДатаРеформации + 60 * 60 * 24;
	
	КонецЦикла;
	
	НовыйПериод.КонецПериода = КонецПериода;
	
	Возврат ПериодыСУчетомРеформаций;

КонецФункции

Функция ПолучитьСписокПериодовСУчетомРеформаций(СчетДоверительногоУправления, НачалоПериода, КонецПериода) Экспорт

	ПериодыСУчетомРеформаций = ПолучитьПериодыСУчетомРеформаций(СчетДоверительногоУправления, НачалоПериода, КонецПериода);
	
	СписокПериодов = Новый СписокЗначений;
	
	Для каждого СтрокаПериодыСУчетомРеформаций Из ПериодыСУчетомРеформаций Цикл
	
		СписокПериодов.Добавить(
				Новый Структура(
					"НачалоПериода, КонецПериода",
					СтрокаПериодыСУчетомРеформаций.НачалоПериода,
					СтрокаПериодыСУчетомРеформаций.КонецПериода
				),
				ПредставлениеПериода(
					СтрокаПериодыСУчетомРеформаций.НачалоПериода,
					СтрокаПериодыСУчетомРеформаций.КонецПериода
				)
		);
	
	КонецЦикла;

	Возврат СписокПериодов;
	
КонецФункции
