&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ОтчетОСверке = ВыполнитьСверкуССанкционнымСписком();
	
	Если ОтчетОСверке = Неопределено Тогда
		ПоказатьПредупреждение(, "При выполнении сверки прозошли ошибки!");
		Возврат;	
	КонецЕсли;
	ОтчетОСверке.Показать("Результат сверки со списком лиц, в отношении которых вводятся специальные экономические меры");	
	
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ЖурналСверкиСоСписками"));
КонецПроцедуры

&НаСервере
Функция ВыполнитьСверкуССанкционнымСписком()
	ОтчетОСверке = Новый ТабличныйДокумент;

	Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСписком(Организация,,, ОтчетОСверке, Справочники.ВидыПеречнейОбъектов.СанкционныйСписок);
	
	Возврат ОтчетОСверке;
КонецФункции