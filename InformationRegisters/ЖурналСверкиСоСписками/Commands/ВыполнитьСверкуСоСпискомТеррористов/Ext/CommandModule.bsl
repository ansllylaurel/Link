&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ОтчетОСверке = ВыполнитьСверкуСоСписком();
	
	Если ОтчетОСверке = Неопределено Тогда
		ПоказатьПредупреждение(, "При выполнении сверки прозошли ошибки!");
		Возврат;	
	КонецЕсли;
	ОтчетОСверке.Показать("Результат сверки со списком террористов");	
	
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.ЖурналСверкиСоСписками"));
КонецПроцедуры

&НаСервере
Функция ВыполнитьСверкуСоСписком()
	ОтчетОСверке = Новый ТабличныйДокумент;

	Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	
	РегистрыСведений.ЖурналСверкиСоСписками.ВыполнитьСверкуСоСписком(Организация,,, ОтчетОСверке, Справочники.ВидыПеречнейОбъектов.СписокТеррористов);

	Возврат ОтчетОСверке;
КонецФункции