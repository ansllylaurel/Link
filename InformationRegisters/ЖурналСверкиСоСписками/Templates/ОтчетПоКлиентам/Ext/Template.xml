		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА КлиентыДУ.Клиент ССЫЛКА Справочник.ПаевыеИнвестиционныеФонды
			ТОГДА РеквизитыПИФСрезПоследних.УправляющаяКомпания.ЮрФизЛицо
		ИНАЧЕ КлиентыДУ.Клиент
	КОНЕЦ КАК Клиент
ПОМЕСТИТЬ _Клиенты
ИЗ
	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&amp;ТекущаяДата, ) КАК КлиентыДУ
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		ПО КлиентыДУ.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ.СрезПоследних(&amp;ТекущаяДата, ) КАК РеквизитыПИФСрезПоследних
		ПО ((ВЫРАЗИТЬ(КлиентыДУ.Клиент КАК Справочник.ПаевыеИнвестиционныеФонды)) = РеквизитыПИФСрезПоследних.ПаевойИнвестиционныйФонд)
ГДЕ
	СчетаДоверительногоУправления.Организация = &amp;Организация
	И (СчетаДоверительногоУправления.ДатаРасторжения &gt; &amp;ТекущаяДата
			ИЛИ СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1))
	И СчетаДоверительногоУправления.ДатаЗаключения &lt;= &amp;ТекущаяДата

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ДолиПайщиковВИнвестиционномФондеОстатки.Пайщик
ИЗ
	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&amp;ТекущаяДата, Организация = &amp;Организация) КАК ДолиПайщиковВИнвестиционномФондеОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&amp;ТекущаяДата, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		ПО ДолиПайщиковВИнвестиционномФондеОстатки.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
ГДЕ
	(&amp;ВидПеречня В (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокТеррористов), ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокЛицСЗамороженнымиСчетами))
			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения &gt;= &amp;ТекущаяДата)

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	ЗаявкаПайщика.Пайщик
ИЗ
	Документ.ЗаявкаПайщика КАК ЗаявкаПайщика
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(&amp;ТекущаяДата, ) КАК КлиентыДоверительногоУправленияСрезПоследних
		ПО ЗаявкаПайщика.ПаевойИнвестиционныйФонд = КлиентыДоверительногоУправленияСрезПоследних.Клиент
ГДЕ
	ЗаявкаПайщика.Организация = &amp;Организация
	И ЗаявкаПайщика.Многократная = ИСТИНА
	И (&amp;ВидПеречня В (ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокТеррористов), ЗНАЧЕНИЕ(Справочник.ВидыПеречнейОбъектов.СписокЛицСЗамороженнымиСчетами))
			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления.ДатаРасторжения &gt;= &amp;ТекущаяДата)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЮрФизЛица.Наименование КАК Клиент,
	ВЫБОР
		КОГДА ЖурналСверкиСоСписками.Пройдена = ЛОЖЬ
			ТОГДА 1
		КОГДА ЖурналСверкиСоСписками.Пройдена ЕСТЬ NULL
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ КАК ПорядокСтатусаПроверки,
	ЖурналСверкиСоСписками.Пройдена КАК Пройдена,
	ЖурналСверкиСоСписками.ДатаПоследнейСверки КАК ДатаПоследнейСверки,
	ЖурналСверкиСоСписками.Комментарий КАК Комментарий,
	ЖурналСверкиСоСписками.Ответственный КАК Ответственный
ИЗ
	_Клиенты КАК _Клиенты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК ЮрФизЛица
		ПО _Клиенты.Клиент = ЮрФизЛица.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЖурналСверкиСоСписками.СрезПоследних(
				&amp;ТекущаяДата,
				(Организация = &amp;Организация
					ИЛИ Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
					И ВидПеречня = &amp;ВидПеречня) КАК ЖурналСверкиСоСписками
		ПО (ЖурналСверкиСоСписками.ЮрФизЛицо = _Клиенты.Клиент)

УПОРЯДОЧИТЬ ПО
	ЮрФизЛица.Наименование</query>
