Функция ПолучитьРеквизитыПИФ(ПаевойИнвестиционныйФонд, Период) Экспорт
	
	Результат = Новый Структура;
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.РеквизитыПИФ.Ресурсы Цикл
		Результат.Вставить(Ресурс.Имя, Неопределено);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ПаевойИнвестиционныйФонд",	ПаевойИнвестиционныйФонд);
	Запрос.УстановитьПараметр("Период",						Период);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	*
	|ИЗ
	|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&Период, ПаевойИнвестиционныйФонд = &ПаевойИнвестиционныйФонд) КАК РеквизитыПИФСрезПоследних";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Возврат Результат;
	КонецЕсли;
	
	ВызватьИсключение "Не удалось получить реквизиты " + СокрЛП(ПаевойИнвестиционныйФонд) + " на дату " + Формат(Период, "ДФ=dd.MM.yyyy");
	
КонецФункции

// Возвращает результат запроса с ПИФами, которые были или находятся в управлении у наших УК. 
// Также содержит последние наименования ПИФов в этих УК
Функция ПолучитьПИФВУправлении() Экспорт
	
	Запрос = Новый Запрос;   
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УправляющиеКомпании.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ _НашиУК
	|ИЗ
	|	Справочник.УправляющиеКомпании КАК УправляющиеКомпании
	|ГДЕ
	|	УправляющиеКомпании.ЮрФизЛицо В
	|			(ВЫБРАТЬ
	|				Организации.ЮрФизЛицо
	|			ИЗ
	|				Справочник.Организации КАК Организации
	|			ГДЕ
	|				НЕ Организации.ПометкаУдаления)
	|	И НЕ УправляющиеКомпании.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Период КАК Период,
	|	РеквизитыПИФ.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд,
	|	РеквизитыПИФ.УправляющаяКомпания КАК УправляющаяКомпания,
	|	РеквизитыПИФ.КраткоеНаименованиеФонда КАК КраткоеНаименованиеФонда
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(РеквизитыПИФ.Период) КАК Период,
	|		РеквизитыПИФ.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
	|	ИЗ
	|		РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _НашиУК КАК _НашиУК
	|			ПО РеквизитыПИФ.УправляющаяКомпания = _НашиУК.Ссылка
	|	
	|	СГРУППИРОВАТЬ ПО
	|		РеквизитыПИФ.ПаевойИнвестиционныйФонд) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыПИФ КАК РеквизитыПИФ
	|		ПО ВложенныйЗапрос.ПаевойИнвестиционныйФонд = РеквизитыПИФ.ПаевойИнвестиционныйФонд
	|			И ВложенныйЗапрос.Период = РеквизитыПИФ.Период";
	
	Возврат Запрос.Выполнить();
			
КонецФункции