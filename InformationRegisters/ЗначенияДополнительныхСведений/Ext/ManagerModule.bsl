
Функция ПолучитьТаблицуНабораЗаписейПередЗаписью(НаборЗаписей) Экспорт

	НаборЗаписейПередЗаписью = СоздатьНаборЗаписей();
	
	Для каждого ЭлементОтбора Из НаборЗаписей.Отбор Цикл
		Если ЭлементОтбора.Использование Тогда
			НаборЗаписейПередЗаписью.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписейПередЗаписью.Прочитать();
	Возврат НаборЗаписейПередЗаписью.Выгрузить();

КонецФункции

Функция ПолучитьТаблицуПроверкиДатЗапретаРедактирования(НаборЗаписей) Экспорт

	// Если меняется значение свойства _РаскрытыйКонтрагент, значит должен быть открыт бэк-офис,
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	КолонкиНабора				= "Объект, Свойство, Значение";
	ПредыдущийНаборЗаписей		= ?(НаборЗаписей.ДополнительныеСвойства.Свойство("НаборЗаписейПередЗаписью"), НаборЗаписей.ДополнительныеСвойства.НаборЗаписейПередЗаписью, Неопределено); 
	ТаблицаНабораЗаписей		= НаборЗаписей.Выгрузить(, КолонкиНабора);
	ТаблицаПредыдущегоНабора	= ?(ПредыдущийНаборЗаписей = Неопределено, ТаблицаНабораЗаписей.СкопироватьКолонки(), ПредыдущийНаборЗаписей.Скопировать(, КолонкиНабора));
	
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаНабораЗаписей, "_НаборЗаписей", Запрос.МенеджерВременныхТаблиц);
	СистемныеФункции.ПоместитьТаблицуЗначенийВМенеджерВременныхТаблиц(ТаблицаПредыдущегоНабора, "_ПредыдущийНаборЗаписей", Запрос.МенеджерВременныхТаблиц);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕСТЬNULL(_НаборЗаписей.Объект, _ПредыдущийНаборЗаписей.Объект) КАК Объект,
		|	ЕСТЬNULL(_НаборЗаписей.Свойство, _ПредыдущийНаборЗаписей.Свойство) КАК Свойство,
		|	ЕСТЬNULL(_НаборЗаписей.Значение, _ПредыдущийНаборЗаписей.Значение) КАК Значение
		|ПОМЕСТИТЬ _Расхождения
		|ИЗ
		|	_НаборЗаписей КАК _НаборЗаписей
		|		ПОЛНОЕ СОЕДИНЕНИЕ _ПредыдущийНаборЗаписей КАК _ПредыдущийНаборЗаписей
		|		ПО _НаборЗаписей.Объект = _ПредыдущийНаборЗаписей.Объект
		|			И _НаборЗаписей.Свойство = _ПредыдущийНаборЗаписей.Свойство
		|ГДЕ
		|	ЕСТЬNULL(_НаборЗаписей.Значение <> _ПредыдущийНаборЗаписей.Значение, ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Организация КАК Организация,
		|	СделкаРЕПО.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис) КАК ГруппаЗапрета,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ПустаяСсылка) КАК ВидУчета,
		|	НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ) КАК Период
		|ИЗ
		|	_Расхождения КАК _Расхождения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО _Расхождения.Объект = СделкаРЕПО.Ссылка
		|			И (СделкаРЕПО.РежимБиржевыхТоргов.РЕПО_М)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО _Расхождения.Свойство = ДополнительныеСведения.Ссылка
		|			И (ДополнительныеСведения.Ключ = ""_РаскрытыйКонтрагент"")";
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();
			
КонецФункции