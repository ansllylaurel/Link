
Функция ПолучитьЗначениеНастройки(Настройка, Пользователь = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗначенияНастроекПользователей.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияНастроекПользователей КАК ЗначенияНастроекПользователей
		|ГДЕ
		|	ЗначенияНастроекПользователей.Пользователь = &Пользователь
		|	И ЗначенияНастроекПользователей.Настройка = &Настройка");
		
	Запрос.УстановитьПараметр("Настройка",		Настройка);
	Запрос.УстановитьПараметр("Пользователь",	?(Пользователь = Неопределено, РаботаСПользователями.ТекущийПользователь(), Пользователь));
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Возврат ?(ВыборкаЗапроса.Следующий(), ВыборкаЗапроса.Значение, Неопределено);
	
КонецФункции
