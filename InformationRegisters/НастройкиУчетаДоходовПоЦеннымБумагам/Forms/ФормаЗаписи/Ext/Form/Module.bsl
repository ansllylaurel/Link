
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не РеквизитФормыВЗначение("Запись").Выбран() Тогда
		Запись.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(Запись.Брокер) 
		И РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Новый Структура("Дата, Организация, Брокер", Запись.Период, Запись.Организация, Запись.Брокер)) Тогда	
		
		ПроверяемыеРеквизиты.Добавить("РасчетныйСчет");		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Брокер) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания КАК ДоговорБрокерскогоОбслуживания
			|ИЗ
			|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
			|			&Дата,
			|			Организация = &Организация
			|				И Брокер = &Брокер
			|				И СчетДоверительногоУправления = &СчетДоверительногоУправления) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Дата, ) КАК УсловияДоговоровОбщиеСрезПоследних
			|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Организация = УсловияДоговоровОбщиеСрезПоследних.Организация
			|			И КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
			|ГДЕ
			|	(УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения ЕСТЬ NULL
			|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Дата)";
		
		Запрос.УстановитьПараметр("Дата", ТекущийОбъект.Период);
		Запрос.УстановитьПараметр("Организация", ТекущийОбъект.Организация);
		Запрос.УстановитьПараметр("Брокер", ТекущийОбъект.Брокер);
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ТекущийОбъект.СчетДоверительногоУправления);
		
		Если Запрос.Выполнить().Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для счета ДУ отсутствует договор с брокером " + ТекущийОбъект.Брокер + ".",,, "Запись.Брокер", Отказ);
		КонецЕсли;
						
		Если ЗначениеЗаполнено(ТекущийОбъект.РасчетныйСчет) И Не РаботаСДокументами.ТребуетсяДетализацияПоРасчетномуСчету(Новый Структура("Дата, Организация, Брокер", ТекущийОбъект.Период, ТекущийОбъект.Организация, ТекущийОбъект.Брокер)) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для брокера " + ТекущийОбъект.Брокер + " не требуется детализация по расчетному счету. Удалите значение расчетного счета.",,, "Запись.РасчетныйСчет", Отказ);	
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры
