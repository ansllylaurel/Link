
Процедура СформироватьДвижения(СделкаРЕПО) Экспорт
	
	СделкаРЕПО.Движения.УсловияСделокРЕПО.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СделкаРЕПО.Дата КАК Период,
		|	СделкаРЕПО.Организация КАК Организация,
		|	СделкаРЕПО.Ссылка КАК СделкаРЕПО,
		|	1 КАК ЧастьСделкиРЕПО,
		|	СделкаРЕПО.Рынок КАК Рынок,
		|	СделкаРЕПОЦенныеБумаги.ЦеннаяБумага КАК ЦеннаяБумага,
		|	ЛОЖЬ КАК Отменено,
		|	СделкаРЕПОЦенныеБумаги.ДепозитарныйСчет КАК ДепозитарныйСчет,
		|	СделкаРЕПО.ДатаВторойЧастиРЕПО КАК ДатаВторойЧастиРЕПО,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
		|			ТОГДА СделкаРЕПО.ДатаИсполнения
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ)
		|	КОНЕЦ КАК ДатаИсполнения,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
		|			ТОГДА ВЫБОР
		|					КОГДА СделкаРЕПО.РаздельноеИсполнение
		|						ТОГДА СделкаРЕПО.ДатаОплаты
		|					ИНАЧЕ СделкаРЕПО.ДатаИсполнения
		|				КОНЕЦ
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ)
		|	КОНЕЦ КАК ДатаОплаты,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ОтложенноеИсполнение
		|			ТОГДА ВЫБОР
		|					КОГДА СделкаРЕПО.РаздельноеИсполнение
		|						ТОГДА СделкаРЕПО.ДатаПоставки
		|					ИНАЧЕ СделкаРЕПО.ДатаИсполнения
		|				КОНЕЦ
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(СделкаРЕПО.Дата, ДЕНЬ)
		|	КОНЕЦ КАК ДатаПоставки,
		|	СделкаРЕПО.ВалютаОплаты КАК ВалютаОплаты,
		|	СделкаРЕПО.СобственныйКурсОплаты КАК СобственныйКурсОплаты,
		|	СделкаРЕПО.КурсОплаты КАК КурсОплаты,
		|	СделкаРЕПОЦенныеБумаги.Количество КАК Количество,
		|	СделкаРЕПОЦенныеБумаги.Цена КАК Цена,
		|	СделкаРЕПОЦенныеБумаги.ЦенаПроцент КАК ЦенаПроцент,
		|	СделкаРЕПОЦенныеБумаги.ЦенаКупона КАК ЦенаКупона,
		|	СделкаРЕПОЦенныеБумаги.Сумма КАК Сумма,
		|	СделкаРЕПОЦенныеБумаги.СуммаКупона КАК СуммаКупона,
		|	СделкаРЕПО.ОтложенноеИсполнение КАК ОтложенноеИсполнение,
		|	СделкаРЕПО.РаздельноеИсполнение КАК РаздельноеИсполнение,
		|	СделкаРЕПО.ПлатежноеУсловиеСделки КАК ПлатежноеУсловиеСделки,
		|	СделкаРЕПО.СтавкаРЕПО КАК СтавкаРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумаги КАК СделкаРЕПОЦенныеБумаги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО СделкаРЕПОЦенныеБумаги.Ссылка = СделкаРЕПО.Ссылка
		|ГДЕ
		|	СделкаРЕПОЦенныеБумаги.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СделкаРЕПО.Дата,
		|	СделкаРЕПО.Организация,
		|	СделкаРЕПО.Ссылка,
		|	2,
		|	СделкаРЕПО.Рынок,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.ЦеннаяБумага,
		|	ЛОЖЬ,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.ДепозитарныйСчет,
		|	СделкаРЕПО.ДатаВторойЧастиРЕПО,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти
		|			ТОГДА СделкаРЕПО.ДатаИсполненияВторойЧасти
		|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти
		|			ТОГДА ВЫБОР
		|					КОГДА СделкаРЕПО.РаздельноеИсполнениеВторойЧасти
		|						ТОГДА СделкаРЕПО.ДатаОплатыВторойЧасти
		|					ИНАЧЕ СделкаРЕПО.ДатаИсполненияВторойЧасти
		|				КОНЕЦ
		|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти
		|			ТОГДА ВЫБОР
		|					КОГДА СделкаРЕПО.РаздельноеИсполнениеВторойЧасти
		|						ТОГДА СделкаРЕПО.ДатаПоставкиВторойЧасти
		|					ИНАЧЕ СделкаРЕПО.ДатаИсполненияВторойЧасти
		|				КОНЕЦ
		|		ИНАЧЕ СделкаРЕПО.ДатаВторойЧастиРЕПО
		|	КОНЕЦ,
		|	СделкаРЕПО.ВалютаОплатыВторойЧасти,
		|	СделкаРЕПО.СобственныйКурсОплатыВторойЧасти,
		|	СделкаРЕПО.КурсОплатыВторойЧасти,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.Количество,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.Цена,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.ЦенаПроцент,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.ЦенаКупона,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.Сумма,
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.СуммаКупона,
		|	СделкаРЕПО.ОтложенноеИсполнениеВторойЧасти,
		|	СделкаРЕПО.РаздельноеИсполнениеВторойЧасти,
		|	СделкаРЕПО.ПлатежноеУсловиеСделки,
		|	СделкаРЕПО.СтавкаРЕПО
		|ИЗ
		|	Документ.СделкаРЕПО.ЦенныеБумагиВторойЧасти КАК СделкаРЕПОЦенныеБумагиВторойЧасти
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СделкаРЕПО КАК СделкаРЕПО
		|		ПО СделкаРЕПОЦенныеБумагиВторойЧасти.Ссылка = СделкаРЕПО.Ссылка
		|ГДЕ
		|	СделкаРЕПОЦенныеБумагиВторойЧасти.Ссылка = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", СделкаРЕПО.Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(СделкаРЕПО.Движения.УсловияСделокРЕПО.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры // СформироватьДвижения
