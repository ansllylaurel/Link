
Процедура ПриЗаписи(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КоличествоКлиентовПоДоговорамДоверительногоУправленияПоСостояниюНаПоследнийКалендарныйДеньКвартала
		 ИЛИ Запись.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.СтоимостьИнвестиционныхПортфелейКлиентовПоДоверительномуУправлениюПоСостояниюНаПоследнийКалендарныйДеньКвартала
		 ИЛИ Запись.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.ОбъемСделокКуплиПродажиЦБЗаключенныхВТечениеКварталаПриОсуществленииДеятельностиПоУправлениюЦБ Тогда
			Если КонецДня(Запись.Период) <> КонецКвартала(Запись.Период) Тогда
		 		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Показатель '%1' регистрируется только в конце квартала", Запись.ВидПоказателя),,,, Отказ);
			КонецЕсли;
			
		ИначеЕсли Запись.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КатегорияПрофессиональногоУчастникаРынкаЦенныхБумаг Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Показатель %1 регистрируется в регистре '%2'", 
					Запись.ВидПоказателя,
					Метаданные.РегистрыСведений.ПоказателиДеятельности.Синоним), Запись.Регистратор,,, Отказ);
			
		ИначеЕсли НЕ ЗначениеЗаполнено(Запись.СубъектАналитики) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтрШаблон("Запись не верна! Значение поля ""Субъект аналитики"" не может быть пустым!: ФинансовыеПоказатели: %1, %2, , %3 (Регистр сведений: Финансовые показатели; Номер строки: %4)",
					Формат(Запись.Период, "ДФ=dd.MM.yyyy"),
					Запись.Организация,
					Запись.ВидПоказателя,
					Запись.НомерСтроки), Запись.Регистратор,,, Отказ);
		КонецЕсли; 
		
		Если Запись.ВидПоказателя = Справочники.ВидыФинансовыхПоказателей.КоличествоКлиентовПоДоговорамДоверительногоУправленияПоСостояниюНаПоследнийКалендарныйДеньКвартала И Цел(Запись.Значение) <> Запись.Значение Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Значения показателя '%1' должно быть целое число", Запись.ВидПоказателя),,,, Отказ);
		КонецЕсли;

	КонецЦикла;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗапускатьПроверки") ИЛИ ЭтотОбъект.ДополнительныеСвойства.ЗапускатьПроверки Тогда
		// #ТехДолг: Свойство "ЗапускатьПроверки" добавлено для исключения двойного запуска проверок в момент расчета финансовых показателей доходности документом РегистрацияСтоимостиАктивов
	
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.УстановитьПараметр("НаборЗаписей", ЭтотОбъект.Выгрузить());
		ЗапуститьКонтрольОтклоненияСЧА(Запрос);
		ЗапуститьКонтрольИД(Запрос, ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроведениеРегламентныхОпераций"));
		ЗапуститьКонтрольОтклоненияОтРыночныхЦенПН(Запрос);
		ЗапуститьОтправкуДанныхИИСВЛКК(Запрос);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапуститьКонтрольОтклоненияСЧА(Запрос)

	#Область Текст_запроса_Контроль_отклонения_СЧА
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НаборЗаписей.Организация КАК Организация,
		|	НаборЗаписей.СубъектАналитики КАК СубъектАналитики,
		|	НаборЗаписей.Период КАК Дата
		|ПОМЕСТИТЬ _СписокИзмененныхСЧА
		|ИЗ
		|	&НаборЗаписей КАК НаборЗаписей
		|ГДЕ
		|	НаборЗаписей.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_СписокИзмененныхСЧА.Организация КАК Организация,
		|	_СписокИзмененныхСЧА.СубъектАналитики КАК СубъектАналитики,
		|	МИНИМУМ(ФинансовыеПоказатели.Период) КАК Дата
		|ИЗ
		|	_СписокИзмененныхСЧА КАК _СписокИзмененныхСЧА
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФинансовыеПоказатели КАК ФинансовыеПоказатели
		|		ПО _СписокИзмененныхСЧА.Организация = ФинансовыеПоказатели.Организация
		|			И _СписокИзмененныхСЧА.СубъектАналитики = ФинансовыеПоказатели.СубъектАналитики
		|			И (ФинансовыеПоказатели.ВидПоказателя = ЗНАЧЕНИЕ(Справочник.ВидыФинансовыхПоказателей.СтоимостьЧистыхАктивов_Рынок))
		|			И _СписокИзмененныхСЧА.Дата < ФинансовыеПоказатели.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_СписокИзмененныхСЧА.Организация,
		|	_СписокИзмененныхСЧА.СубъектАналитики
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_СписокИзмененныхСЧА.Организация,
		|	_СписокИзмененныхСЧА.СубъектАналитики,
		|	_СписокИзмененныхСЧА.Дата
		|ИЗ
		|	_СписокИзмененныхСЧА КАК _СписокИзмененныхСЧА";			
	#КонецОбласти 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Параметры = Новый Структура;
		
		Параметры.Вставить("Организация",					Выборка.Организация);
		Параметры.Вставить("СчетДоверительногоУправления",	Выборка.СубъектАналитики);
		Параметры.Вставить("ДатаНачала",					Выборка.Дата);
		Параметры.Вставить("ДатаОкончания",					Выборка.Дата);
		Параметры.Вставить("ПроцентОтклоненияСЧА",			5);
		
		Параметры.Вставить("ТекстОшибки",					"Не удалось добавить отложенное задание 'Обработки.КонтрольОтклоненияСЧА.ВыполнитьОповещение' для контроля отклонения СЧА.");
		Параметры.Вставить("ИсточникОшибки",				"Контроль отклонения СЧА");
		
		РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание("Обработки.КонтрольОтклоненияСЧА", "ВыполнитьОповещение", Параметры, 15, Истина);
		
	КонецЦикла;

КонецПроцедуры
 
Процедура ЗапуститьКонтрольИД(Запрос, ЭтоПроведениеРегламентныхОпераций)

	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_СписокИзмененныхСЧА.СубъектАналитики КАК СчетДоверительногоУправления,
		|	_СписокИзмененныхСЧА.Организация КАК Организация,
		|	_СписокИзмененныхСЧА.Дата КАК Период
		|ИЗ
		|	_СписокИзмененныхСЧА КАК _СписокИзмененныхСЧА
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(_СписокИзмененныхСЧА.СубъектАналитики) = ТИП(Справочник.СчетаДоверительногоУправления)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_КонтрольИнвестиционныхДеклараций");
		Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить контроль ИД при регистрации СЧА. Обработка '_КонтрольИнвестиционныхДеклараций' не найдена", "Контроль инвестиционных деклараций");
			Возврат;
		КонецЕсли; 
		
		ТекДата = ТекущаяДатаСеанса();
		ТекЧас = Час(ТекДата);
		Если ТекЧас < 15 Тогда
			
			Если ЭтоПроведениеРегламентныхОпераций Тогда
				// при проведении регламентных операций запускаем контроли раз в 30 минут
				Если Минута(ТекДата) < 30 Тогда
					ДатаЗапускаПлан = НачалоДня(ТекДата) + (ТекЧас + 0.5) * 3600;
				Иначе
				    ДатаЗапускаПлан = НачалоДня(ТекДата) + (ТекЧас + 1) * 3600;
				КонецЕсли; 
				
			Иначе	
				// при обычном проведении РСА, выполненном до 15:00 запускаем контроль в 15:00
				ДатаЗапускаПлан = НачалоДня(ТекДата) + 15 * 3600;
				
			КонецЕсли; 
			
		Иначе
			// контроль по документу, проведенному после 15:00 запускаем оперативно
			ДатаЗапускаПлан = ТекДата;
		КонецЕсли;
		
		Параметры = Новый Структура("Организация, Период, СчетДоверительногоУправления");
		ЗаполнитьЗначенияСвойств(Параметры, Выборка);
		
		Параметры.Вставить("ИсточникОшибки", "Контроль инвестиционных деклараций");
		
		Если ЭтоПроведениеРегламентныхОпераций Тогда
			Параметры.Вставить("ТекстОшибки",	"Не удалось добавить отложенное задание '_КонтрольИнвестиционныхДеклараций.КонтрольПриЗакрытииДня'.");
			Команда = "КонтрольПриЗакрытииДня";
		Иначе
			Параметры.Вставить("ТекстОшибки",	"Не удалось добавить отложенное задание '_КонтрольИнвестиционныхДеклараций.КонтрольПриРегистрацииСЧА'.");
			Команда = "КонтрольПриРегистрацииСЧА";
		КонецЕсли; 
		
		РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, Команда, Параметры, 15, Истина, ДатаЗапускаПлан);
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьКонтрольОтклоненияОтРыночныхЦенПН(Запрос)

	// Проверяем только предыдущий рабочий день
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_СписокИзмененныхСЧА.СубъектАналитики КАК СчетДоверительногоУправления,
		|	_СписокИзмененныхСЧА.Организация КАК Организация,
		|	_СписокИзмененныхСЧА.Дата КАК Период
		|ИЗ
		|	_СписокИзмененныхСЧА КАК _СписокИзмененныхСЧА
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(_СписокИзмененныхСЧА.СубъектАналитики) = ТИП(Справочник.СчетаДоверительногоУправления)
		|	И ВЫРАЗИТЬ(_СписокИзмененныхСЧА.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями)
		|	И _СписокИзмененныхСЧА.Дата = &ПредыдущийРабочийДень";
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -2));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	
		ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ОтчетностьЦБ");
		Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить контроль отклонения от рыночных цен для ПН. Отчет '_ОтчетностьЦБ' не найден", "Контроль отклонения от рыночных цен");
			Возврат;
		КонецЕсли; 
		
		ТекДата = ТекущаяДатаСеанса();
		ТекЧас = Час(ТекДата);
		Если ТекЧас < 15 Тогда						
			// при проведении до 15:00 запускаем контроль в 15:00
			ДатаЗапускаПлан = НачалоДня(ТекДата) + 15 * 3600;				
		Иначе
			// контроль по документу, проведенному после 15:00, запускаем оперативно
			ДатаЗапускаПлан = ТекДата;
		КонецЕсли;
		
		Команда = "АвтоОтправкаОтчета_ОКУД0420511";
				
		// Отложенное задание добавляем, если такое еще не зарегистрировано в этот день
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Организация", 	Выборка.Организация);
		ПараметрыЗадания.Вставить("Объект",			ДополнительнаяОбработкаСсылка);
		ПараметрыЗадания.Вставить("Состояния",		Перечисления.СостоянияОтложенныхЗаданий.Ожидание);
		ПараметрыЗадания.Вставить("Команда", 		Команда);
		
		Если РегистрыСведений.ОтложенныеЗадания.ЕстьОтложенноеЗадание(ДатаЗапускаПлан, ДатаЗапускаПлан, ПараметрыЗадания) Тогда
			Возврат;
		КонецЕсли;
				
		Параметры = Новый Структура("Организация, Период");
		
		ЗаполнитьЗначенияСвойств(Параметры, Выборка);
		
		Параметры.Вставить("ИсточникОшибки", 				"Контроль отклонения от рыночных цен");  				
		Параметры.Вставить("ТекстОшибки",					"Не удалось добавить отложенное задание '_ОтчетностьЦБ.АвтоОтправкаОтчета_ОКУД0420511'.");  
		Параметры.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
				
		РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, Команда, Параметры, 15, Истина, ДатаЗапускаПлан);
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьОтправкуДанныхИИСВЛКК(Запрос)

	// Проверяем только предыдущий рабочий день
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	_СписокИзмененныхСЧА.СубъектАналитики КАК СчетДоверительногоУправления,
		|	_СписокИзмененныхСЧА.Организация КАК Организация,
		|	_СписокИзмененныхСЧА.Дата КАК Период
		|ИЗ
		|	_СписокИзмененныхСЧА КАК _СписокИзмененныхСЧА
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(_СписокИзмененныхСЧА.СубъектАналитики) = ТИП(Справочник.СчетаДоверительногоУправления)
		|	И ВЫРАЗИТЬ(_СписокИзмененныхСЧА.СубъектАналитики КАК Справочник.СчетаДоверительногоУправления).ВидДоговораДоверительногоУправления = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет)
		|	И _СписокИзмененныхСЧА.Дата = &ПредыдущийРабочийДень";
	
	Запрос.УстановитьПараметр("ПредыдущийРабочийДень", Справочники.Календари.ДобавитьКДатеРабочиеДни(Справочники.Календари.Общероссийский, ТекущаяДатаСеанса(), -2));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
	    
		ДополнительнаяОбработкаСсылка = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьСсылкуПоИмениОбъекта("_ВыгрузкаДанныхВЛичныйКабинетКлиента");
		Если ДополнительнаяОбработкаСсылка = Неопределено Тогда
			РаботаСРегламентнымиЗаданиями.ЗарегистрироватьОшибку("Не удалось запустить выгрузку данных ИИС в ЛКК. Отчет '_ВыгрузкаДанныхВЛичныйКабинетКлиента' не найден", "Выгрузка данных в личный кабинет клиента");
			Возврат;
		КонецЕсли; 
		
		ДатаЗапускаПлан = ТекущаяДатаСеанса();
				
		Команда = "ОтправкаДанныхИИСВЛКК";
						
		// Отложенное задание добавляем, если такое еще не зарегистрировано в этот день
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Организация", 	Выборка.Организация);
		ПараметрыЗадания.Вставить("Объект",			ДополнительнаяОбработкаСсылка);
		ПараметрыЗадания.Вставить("Состояния",		Перечисления.СостоянияОтложенныхЗаданий.Ожидание);
		ПараметрыЗадания.Вставить("Команда", 		Команда);
		
		Если РегистрыСведений.ОтложенныеЗадания.ЕстьОтложенноеЗадание(ДатаЗапускаПлан, ДатаЗапускаПлан, ПараметрыЗадания) Тогда
			Возврат;
		КонецЕсли;
		
		Параметры = Новый Структура("Организация, Период");
		
		ЗаполнитьЗначенияСвойств(Параметры, Выборка);
		
		Параметры.Вставить("ИсточникОшибки", 				"Выгрузка данных в личный кабинет клиента");  				
		Параметры.Вставить("ТекстОшибки",					"Не удалось добавить отложенное задание 'Выгрузка данных в личный кабинет клиента'.");  
		Параметры.Вставить("ДополнительнаяОбработкаСсылка", ДополнительнаяОбработкаСсылка);
				
		РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание(ДополнительнаяОбработкаСсылка, Команда, Параметры, 15, Истина, ДатаЗапускаПлан);
		
	КонецЕсли;

КонецПроцедуры
