
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УниверсальныеМеханизмы.ПослеОбработкиПроверкиЗаполнения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеОГРН(ДанныеНабора, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ", ДанныеНабора);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ.ЮрФизЛицо КАК ЮрФизЛицо,
		|	ТЗ.Период КАК Период,
		|	ТЗ.Вид КАК ВидДокумента,
		|	ТЗ.Номер КАК Номер
		|ПОМЕСТИТЬ _ДанныеНабораЗаписей
		|ИЗ
		|	&ТЗ КАК ТЗ
		|ГДЕ
		|	ТЗ.Вид = ЗНАЧЕНИЕ(Перечисление.ВидыДокументовЮридическихЛиц.СвидетельствоОГосударственнойРегистрации)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЮрФизЛицо,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РеквизитыЮридическихЛиц.ЮрФизЛицо КАК ЮрФизЛицо,
		|	РеквизитыЮридическихЛиц.Период КАК Период,
		|	РеквизитыЮридическихЛиц.ОрганизационноПравоваяФорма КАК ОрганизационноПравоваяФорма
		|ПОМЕСТИТЬ _Реквизиты
		|ИЗ
		|	РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮридическихЛиц
		|ГДЕ
		|	(РеквизитыЮридическихЛиц.ЮрФизЛицо, РеквизитыЮридическихЛиц.Подразделение, РеквизитыЮридическихЛиц.Язык) В
		|			(ВЫБРАТЬ
		|				_ДанныеНабораЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
		|				ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний) КАК Подразделение,
		|				ЗНАЧЕНИЕ(Справочник.Языки.Русский) КАК Язык
		|			ИЗ
		|				_ДанныеНабораЗаписей КАК _ДанныеНабораЗаписей)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЮрФизЛицо,
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеНабораЗаписей.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ДанныеНабораЗаписей.Период КАК Период,
		|	_ДанныеНабораЗаписей.Номер КАК Номер,
		|	МАКСИМУМ(ЕСТЬNULL(_Реквизиты.Период, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаРеквизитов
		|ПОМЕСТИТЬ _ДатыРеквизитов
		|ИЗ
		|	_ДанныеНабораЗаписей КАК _ДанныеНабораЗаписей
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Реквизиты КАК _Реквизиты
		|		ПО _ДанныеНабораЗаписей.ЮрФизЛицо = _Реквизиты.ЮрФизЛицо
		|			И _ДанныеНабораЗаписей.Период >= _Реквизиты.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_ДанныеНабораЗаписей.ЮрФизЛицо,
		|	_ДанныеНабораЗаписей.Период,
		|	_ДанныеНабораЗаписей.Номер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыРеквизитов.ЮрФизЛицо КАК ЮрФизЛицо,
		|	_ДатыРеквизитов.Период КАК Период,
		|	_ДатыРеквизитов.Номер КАК Номер,
		|	ЕСТЬNULL(_Реквизиты.ОрганизационноПравоваяФорма, НЕОПРЕДЕЛЕНО) КАК ОПВ
		|ИЗ
		|	_ДатыРеквизитов КАК _ДатыРеквизитов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _Реквизиты КАК _Реквизиты
		|		ПО _ДатыРеквизитов.ЮрФизЛицо = _Реквизиты.ЮрФизЛицо
		|			И _ДатыРеквизитов.ДатаРеквизитов = _Реквизиты.Период";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Номер) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать данные свидетельства о государственной регистрации (ОГРН), т.к. номер не заполнен!", Выборка.ЮрФизЛицо,,, Отказ);
		Иначе
			
			Если Выборка.ОПВ = Справочники.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие
				И СтрДлина(Выборка.Номер) <> 15 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать ОГРН '" + Выборка.Номер + "'. ОГРН индивидуального частного предприятия должен состоять из 15 символов!", Выборка.ЮрФизЛицо,,, Отказ);
			ИначеЕсли Выборка.ОПВ <> Справочники.ОрганизационноПравовыеФормы.ИндивидуальноеЧастноеПредприятие
				И СтрДлина(Выборка.Номер) <> 13 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать ОГРН '" + Выборка.Номер + "'. ОГРН юридического лица должен состоять из 13 символов!", Выборка.ЮрФизЛицо,,, Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	// Проверяем заполненность ОГРН в наборе записей, а также длину ОГРН для разных организационно-правовых форм.
	ПроверитьЗаполнениеОГРН(ЭтотОбъект.Выгрузить(, "ЮрФизЛицо, Период, Вид, Номер"), Отказ);
	
КонецПроцедуры
