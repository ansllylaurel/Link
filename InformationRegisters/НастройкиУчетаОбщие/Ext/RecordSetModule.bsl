
Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	ДопустимыеСчетаУчетаПроцентовПоМНО = Новый Массив;
	ДопустимыеСчетаУчетаПроцентовПоМНО.Добавить(ПланыСчетов.Единый.ПустаяСсылка());
	ДопустимыеСчетаУчетаПроцентовПоМНО.Добавить(ПланыСчетов.Единый.РасчетныеСчета);
	ДопустимыеСчетаУчетаПроцентовПоМНО.Добавить(ПланыСчетов.Единый.Депозиты);
	ДопустимыеСчетаУчетаПроцентовПоМНО.Добавить(ПланыСчетов.Единый.Расчеты);
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если ДопустимыеСчетаУчетаПроцентовПоМНО.Найти(Запись.СчетУчетаПроцентовПоМНО) = Неопределено Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимое значение настройки 'Счет учета процентов по МНО': возможно только 205, 206, 474 счета или незаполненное значение",,,, Отказ);
		
		КонецЕсли;
		
		Если Запись.СчетУчетаПроцентовПоМНО <> ПланыСчетов.Единый.Депозиты И Запись.ИспользоватьСчетРасчетовПоПроцентамДляМНО Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимая комбинация настроек: 'Счет учета процентов по МНО' <> 206 и 'Использовать счет расчетов по процентам для МНО' = 'Да'",,,, Отказ);
		
		КонецЕсли;	
		
		Если Запись.РасчетСтоимостиИтерационноЕжедневноСПромежуточнымОкруглением И Запись.РасчетСтоимостиМетодомЧИСТНЗ Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимая комбинация настроек: 'Расчет стоимости методом ЧИСТНЗ' и 'Расчет стоимости итерационно ежедневно с промежуточным округлением (УГМК)' не могут быть включены одновременно",,,, Отказ);
		
		КонецЕсли;
		
		Если Запись.СписыватьПриПолномПогашенииВМоментПогашения И Запись.УчитыватьПогашенныеОблигацииДоПрекращенияПризнанияПоНоминалу Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимая комбинация настроек: 'Списывать при полном погашении в момент погашения' и 'Учитывать погашенные облигации до прекращения признания по номиналу' не могут быть включены одновременно",,,, Отказ);
		
		КонецЕсли;
		
		Если Запись.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 И Запись.ВариантРасчетаОжидаемыхКредитныхУбытков = Справочники.ВариантыРасчетаОжидаемыхКредитныхУбытков.ПустаяСсылка() Тогда
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимая комбинация настроек: 'Вариант учета стоимости и обесценения финансовых активов' " + Перечисления.СтандартыФинансовойОтчетности.МСФО9 + ", а 'Вариант расчета ОКУ' не выбран",,,, Отказ);
		
		КонецЕсли;
		
		Если  Запись.ВариантУчетаСтоимостиИОбесцененияФинансовыхАктивов = Перечисления.СтандартыФинансовойОтчетности.МСФО9 И СтрДлина(Запись.ОснованияДляПерерасчетаРезервов) > 0 Тогда
		
			СписокДопустимыхВидовОпераций = РегистрыСведений.НастройкиУчетаОбщие.ВидыОперацийОснованийДляРасчетаРезервов();
			
			МассивВариантов = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(Запись.ОснованияДляПерерасчетаРезервов, ",", Истина, Истина);
			
			Для каждого Вариант Из МассивВариантов Цикл
				Если РаботаСКоллекциями.НайтиЗначениеСпискаПоПредставлению(СписокДопустимыхВидовОпераций, Вариант) = Неопределено Тогда
				    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недопустимый вид операции основания для резервов: '" + Вариант + "'",,,, Отказ);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры // ПередЗаписью
