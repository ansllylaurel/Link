
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		КредитныйИнструмент = РаботаСКредитнымиИнструментами.ПолучитьКредитныйИнструмент(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(КредитныйИнструмент) Тогда
			
			ЗаполнилиПоСрезу = Ложь;
			СрезПоследних = РегистрыСведений.УсловияКредитныхИнструментов.СрезПоследних(?(ДанныеЗаполнения.Свойство("Период"), ДанныеЗаполнения.Период, ТекущаяДата()), Новый Структура("КредитныйИнструмент", КредитныйИнструмент));
			СрезПоследних.Сортировать("ДатаНачалаДействияУсловий УБЫВ");
			Для каждого ДанныеСреза ИЗ СрезПоследних Цикл
				
				Если НЕ ДанныеСреза.Действует Тогда
					Продолжить;
				КонецЕсли;
				
				Для Каждого Колонка Из СрезПоследних.Колонки Цикл
					
					Если Колонка.Имя = "КредитныйИнструмент" 
						ИЛИ Колонка.Имя = "Комментарий" 
						ИЛИ Колонка.Имя = "Период" 
						ИЛИ Колонка.Имя = "ДатаНачалаДействияУсловий" Тогда 
						
						Продолжить; 
					КонецЕсли;
					
					Если ДанныеЗаполнения.Свойство(Колонка.Имя) И ЗначениеЗаполнено(ДанныеЗаполнения[Колонка.Имя])	Тогда 
						Продолжить; 
					КонецЕсли;
					
					ДанныеЗаполнения.Вставить(Колонка.Имя, ДанныеСреза[Колонка.Имя]);
					
				КонецЦикла;
				
				ЗаполнилиПоСрезу = Истина;
				Прервать;
			КонецЦикла;
				
			Если ТипЗнч(КредитныйИнструмент) = Тип("СправочникСсылка.ДепозитныеВклады") Тогда
				ДанныеЗаполнения.Вставить("УчетныйАктив", Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС);	
				Если НЕ ЗаполнилиПоСрезу  Тогда
					ДанныеЗаполнения.Вставить("Период", КредитныйИнструмент.ДатаРегистрации);
					ДанныеЗаполнения.Вставить("ДатаНачалаДействияУсловий", КредитныйИнструмент.ДатаРегистрации);
				КонецЕсли;
			ИначеЕсли ТипЗнч(КредитныйИнструмент) = Тип("СправочникСсылка.Займы") Тогда
				Если КредитныйИнструмент.ВидКредитногоИнструмента = Перечисления.ВидыКредитныхИнструментов.Выданный Тогда
					ДанныеЗаполнения.Вставить("УчетныйАктив", Справочники.УчетныеАктивыЕПС.ПредоставленныеЗаймы);	
				Иначе 
					ДанныеЗаполнения.Вставить("УчетныйАктив", Справочники.УчетныеАктивыЕПС.ПолученныеЗаймы);	
				КонецЕсли;
				Если НЕ ЗаполнилиПоСрезу  Тогда
					ДанныеЗаполнения.Вставить("Период", КредитныйИнструмент.ДатаЗаключения);
					ДанныеЗаполнения.Вставить("ДатаНачалаДействияУсловий", КредитныйИнструмент.ДатаЗаключения);
				КонецЕсли;
			КонецЕсли;

			Если Не ДанныеЗаполнения.Свойство("Организация") Тогда
				ДанныеЗаполнения.Вставить("Организация", КредитныйИнструмент.Организация);	
			КонецЕсли;
			
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ДанныеЗаполнения.Свойство("УчетныйАктив") Тогда
		ДанныеЗаполнения.Вставить("УчетныйАктив", Справочники.УчетныеАктивыЕПС.ДепозитныеВкладыПоАС);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если РаботаСКредитнымиИнструментами.НеобходимоЗаполнениеЗначенияРасчетногоСчетаВозвратаДенежныхСредств(Запись.Организация, Запись.КредитныйИнструмент) Тогда
			
			ПроверяемыеРеквизиты.Добавить("РасчетныйСчетВозвратаДенежныхСредств");			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	УниверсальныеМеханизмы.ЗаполнитьОрганизациюИзВедущегоИзмерения(ЭтотОбъект, "КредитныйИнструмент");
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если Справочники.ДепозитныеВклады.БылиДвиженияПоДепозиту(Запись.КредитныйИнструмент, Запись.Организация) Тогда
		
			РеквизитыОповещения = Новый Структура;
			РеквизитыОповещения.Вставить("Организация",						Запись.Организация);
			РеквизитыОповещения.Вставить("Депозит",							Запись.КредитныйИнструмент);
			РеквизитыОповещения.Вставить("ДатаПогашения", 					Запись.ДатаПогашения);
			РеквизитыОповещения.Вставить("Процент",							Запись.Процент);
			РеквизитыОповещения.Вставить("ПериодичностьВыплатыПроцентов",	Запись.ПериодичностьВыплатыПроцентов);
			
			Справочники.Оповещения.СформироватьОповещения("РегистрСведений.УсловияКредитныхИнструментов", Перечисления.ТипыСобытий.ПриЗаписиРегистраСведений, РеквизитыОповещения);
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
