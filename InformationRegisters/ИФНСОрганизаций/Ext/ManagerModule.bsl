Функция ПолучитьИФНС(Период, Организация, ПоКрупнейшимНалогоплательщикам) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИФНСОрганизацийСрезПоследних.ИФНС КАК ИФНС
		|ИЗ
		|	РегистрСведений.ИФНСОрганизаций.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И ПоКрупнейшимНалогоплательщикам = &ПоКрупнейшимНалогоплательщикам) КАК ИФНСОрганизацийСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ПоКрупнейшимНалогоплательщикам", ПоКрупнейшимНалогоплательщикам);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ИФНС;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции