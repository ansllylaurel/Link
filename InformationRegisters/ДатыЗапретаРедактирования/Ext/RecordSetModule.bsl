
Функция ПолучитьОбрабатываемыеСчетаДоверительногоУправления()
	
	ОбрабатываемыеСчетаДоверительногоУправления = Новый Массив;
	
	Если ЭтотОбъект.Отбор.СчетДоверительногоУправления.Использование Тогда
		// если установлен отбор по счету д/у, то всё просто — берем его (напомню, на всякий случай,
		// что в отборе набора записей допустимо сравнение только на равно)
		ОбрабатываемыеСчетаДоверительногоУправления.Добавить(ЭтотОбъект.Отбор.СчетДоверительногоУправления.Значение);
		
	Иначе
		// счета доверительного управления необходимо получить из базы данных при записи набора,
		// т.к. если совершается удаление записей ЭтотОбъект содержит пустой набор
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
			|	ДатыЗапретаРедактирования.СчетДоверительногоУправления
			|ИЗ
			|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
			|ГДЕ
			|	ИСТИНА";
			
		Для каждого ЭлементОтбора Из ЭтотОбъект.Отбор Цикл
			Если ЭлементОтбора.Использование Тогда
				Запрос.Текст = Запрос.Текст + Символы.ПС + Символы.Таб + "И " + ЭлементОтбора.ПутьКДанным + " = &" + ЭлементОтбора.ПутьКДанным;
				Запрос.УстановитьПараметр(ЭлементОтбора.ПутьКДанным, ЭлементОтбора.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ОбрабатываемыеСчетаДоверительногоУправления.Добавить(Выборка.СчетДоверительногоУправления);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ОбрабатываемыеСчетаДоверительногоУправления
	
КонецФункции // ПолучитьОбрабатываемыеСчетаДоверительногоУправления

////////////////////////////////////////////////////////////////////////////////

Процедура ПередЗаписью(Отказ, Замещение)
	
	ДоступныеПользователи = ?(РаботаСПользователями.ЭтоПолноправныйПользователь() И Не РаботаСПользователями.ЭтоНеуказанныйПользователь(),
		РаботаСПользователями.ДоступныеПользователи(), Неопределено);
	
	// Проверка периода (может быть только прошедшей датой) и уточнение данных
	ПредельнаяДата = НачалоДня(ТекущаяДатаСеанса());
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.ДатаЗапретаРедактирования >= ПредельнаяДата Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дату запрета можно устанавливать только в прошлом периоде",,,, Отказ);
			Прервать;
		КонецЕсли;
		
		Запись.Ответственный = РаботаСПользователями.ТекущийПользователь(ДоступныеПользователи, Запись.Организация, Отказ);
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	НужнаПроверкаНаФормированиеУчета = Ложь;
	Для каждого Запись Из ЭтотОбъект Цикл
		Если Запись.ГруппаЗапрета = Перечисления.ГруппыЗапретаРедактирования.БэкОфис И ЗначениеЗаполнено(Запись.ВидУчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При выбранной группе запрета '" + Запись.ГруппаЗапрета + "' вид учета не должен быть заполнен",,,, Отказ);
		ИначеЕсли Запись.ГруппаЗапрета <> Перечисления.ГруппыЗапретаРедактирования.БэкОфис И Не ЗначениеЗаполнено(Запись.ВидУчета) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При выбранной группе запрета '" + Запись.ГруппаЗапрета + "' вид учета должен быть заполнен",,,, Отказ);
		КонецЕсли;
		Если Запись.ГруппаЗапрета <> Перечисления.ГруппыЗапретаРедактирования.БэкОфис Тогда
			НужнаПроверкаНаФормированиеУчета = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановкуДатЗапретаПроизводитФБУ = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("УстановкуДатЗапретаПроизводитФБУ", УстановкуДатЗапретаПроизводитФБУ) Тогда
		УстановкуДатЗапретаПроизводитФБУ = Ложь;
	КонецЕсли;
	
	Если НужнаПроверкаНаФормированиеУчета И НЕ УстановкуДатЗапретаПроизводитФБУ Тогда
		
		ПараметрыФормированияБухгалтерскогоУчета = Обработки.МенеджерОтложенныхЗаданий.ПолучитьПараметрыФормированияБухгалтерскогоУчета();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НаборЗаписей.Организация КАК Организация,
			|	НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НаборЗаписей.ГруппаЗапрета КАК ГруппаЗапрета,
			|	НаборЗаписей.ВидУчета КАК ВидУчета
			|ПОМЕСТИТЬ _НаборЗаписей
			|ИЗ
			|	&НаборЗаписей КАК НаборЗаписей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	_НаборЗаписей.Организация КАК Организация,
			|	_НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_НаборЗаписей.ВидУчета КАК ВидУчета
			|ПОМЕСТИТЬ _ПроверятьСчета
			|ИЗ
			|	_НаборЗаписей КАК _НаборЗаписей
			|ГДЕ
			|	_НаборЗаписей.ГруппаЗапрета <> ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОтложенныеЗадания.Идентификатор КАК Идентификатор
			|ИЗ
			|	_ПроверятьСчета КАК _ПроверятьСчета
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОтложенныеЗадания КАК ОтложенныеЗадания
			|		ПО _ПроверятьСчета.Организация = ОтложенныеЗадания.Организация
			|			И _ПроверятьСчета.СчетДоверительногоУправления = ОтложенныеЗадания.СчетДоверительногоУправления
			|			И _ПроверятьСчета.ВидУчета = ОтложенныеЗадания.ВидУчета
			|			И (ОтложенныеЗадания.Объект = &ОбъектФормированияБухгалтерскогоУчета)
			|			И (ОтложенныеЗадания.Команда = &КомандаФормированияБухгалтерскогоУчета)
			|			И (ОтложенныеЗадания.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Ожидание), ЗНАЧЕНИЕ(Перечисление.СостоянияОтложенныхЗаданий.Выполняется)))";
		
		Запрос.УстановитьПараметр("НаборЗаписей", ЭтотОбъект.Выгрузить());
		Запрос.УстановитьПараметр("ОбъектФормированияБухгалтерскогоУчета",			ПараметрыФормированияБухгалтерскогоУчета.ОбъектФормированияБухгалтерскогоУчета);
		Запрос.УстановитьПараметр("КомандаФормированияБухгалтерскогоУчета",			ПараметрыФормированияБухгалтерскогоУчета.КомандаФормированияБухгалтерскогоУчета);
		
		// сотрудник, устанавливающий даты запрета может не иметь прав на регистр ОЗ
		// но вообще странно - бух-я имеет права на ОЗ, а бэкофис нет 
		УстановитьПривилегированныйРежим(Истина);
		ИдетФБУ = НЕ Запрос.Выполнить().Пустой();
		УстановитьПривилегированныйРежим(Ложь);		
		
		Если ИдетФБУ Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нельзя изменять даты запрета т.к. в данный момент идет формирование учета",,,, Отказ);
			Возврат;
		КонецЕсли;		
	
	КонецЕсли;
	
	#Область Проверка_необходимости_пересчета_СЧА
	// проверим корректность расчета СЧА при ручной установке даты запрета
	Организация = ЭтотОбъект.Отбор.Организация.Значение;
	ВыполнятьКонтрольСЧА = ПланыВидовХарактеристик.ДополнительныеСведения.ЗначениеДополнительнойНастройки(, "ПрочиеНастройки._ВыполнятьКонтрольСЧАПриИзмененииДатыЗапрета", Организация);
	Если ЗначениеЗаполнено(ВыполнятьКонтрольСЧА) И ВыполнятьКонтрольСЧА
		И (ЭтотОбъект.ДополнительныеСвойства.Свойство("ИнтерактивнаяУстановкаДатыЗапрета") Или ЭтотОбъект.ДополнительныеСвойства.Свойство("АвтоматическаяУстановкаДатыЗапрета"))
		И Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ТаблицаЗаписейДляКонтроляСЧА")
		И ЭтотОбъект.Отбор.ГруппаЗапрета.Значение = Перечисления.ГруппыЗапретаРедактирования.БэкОфис Тогда
		
		ИсключаемыеКодыСчетовДоверительногоУправления = Новый Массив;
		ИсключаемыеКодыСчетовДоверительногоУправления.Добавить("О"); // Исключаем из контроля СЧА служебный счет ДУ "НЕОПРЕДЕЛЕН".
		
		АвтоматическаяУстановкаДатыЗапрета = ?(ЭтотОбъект.ДополнительныеСвойства.Свойство("АвтоматическаяУстановкаДатыЗапрета"), ЭтотОбъект.ДополнительныеСвойства.АвтоматическаяУстановкаДатыЗапрета, Ложь);
		// свойство АвтоматическаяУстановкаДатыЗапрета добавляется в обработке ПроведениеРегламентныхОпераций, когда выполняются все операции с перезаполнением документов
		// т.к. все документы были только что перезаполнены - в этот день контролировать СЧА не имеет смысла
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НаборЗаписей",									ЭтотОбъект.Выгрузить());
		Запрос.УстановитьПараметр("АвтоматическаяУстановкаДатыЗапрета",				АвтоматическаяУстановкаДатыЗапрета);
		Запрос.УстановитьПараметр("ИсключаемыеКодыСчетовДоверительногоУправления",	ИсключаемыеКодыСчетовДоверительногоУправления);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НаборЗаписей.Организация КАК Организация,
			|	НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	НаборЗаписей.ГруппаЗапрета КАК ГруппаЗапрета,
			|	НаборЗаписей.ВидУчета КАК ВидУчета,
			|	НаборЗаписей.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
			|ПОМЕСТИТЬ _НаборЗаписей
			|ИЗ
			|	&НаборЗаписей КАК НаборЗаписей
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_НаборЗаписей.Организация КАК Организация,
			|	_НаборЗаписей.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ЕСТЬNULL(ДОБАВИТЬКДАТЕ(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, ДЕНЬ, 1), ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачала,
			|	ВЫБОР
			|		КОГДА &АвтоматическаяУстановкаДатыЗапрета
			|			ТОГДА ДОБАВИТЬКДАТЕ(_НаборЗаписей.ДатаЗапретаРедактирования, ДЕНЬ, -1)
			|		ИНАЧЕ _НаборЗаписей.ДатаЗапретаРедактирования
			|	КОНЕЦ КАК ДатаОкончания
			|ИЗ
			|	_НаборЗаписей КАК _НаборЗаписей
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
			|		ПО _НаборЗаписей.Организация = ДатыЗапретаРедактирования.Организация
			|			И _НаборЗаписей.СчетДоверительногоУправления = ДатыЗапретаРедактирования.СчетДоверительногоУправления
			|			И _НаборЗаписей.ГруппаЗапрета = ДатыЗапретаРедактирования.ГруппаЗапрета
			|			И _НаборЗаписей.ВидУчета = ДатыЗапретаРедактирования.ВидУчета
			|ГДЕ
			|	ВЫБОР
			|			КОГДА &АвтоматическаяУстановкаДатыЗапрета
			|				ТОГДА ДОБАВИТЬКДАТЕ(_НаборЗаписей.ДатаЗапретаРедактирования, ДЕНЬ, -1)
			|			ИНАЧЕ _НаборЗаписей.ДатаЗапретаРедактирования
			|		КОНЕЦ > ЕСТЬNULL(ДатыЗапретаРедактирования.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1))
			|	И НЕ _НаборЗаписей.СчетДоверительногоУправления.КодСчета В (&ИсключаемыеКодыСчетовДоверительногоУправления)";
		
		ЭтотОбъект.ДополнительныеСвойства.Вставить("ТаблицаЗаписейДляКонтроляСЧА", Запрос.Выполнить().Выгрузить());
	
	КонецЕсли; 
	#КонецОбласти
	
КонецПроцедуры // ПередЗаписью

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.УдалениеВСоставеИзмененияНабора Тогда // проверим непротиворичивость новых данных
		
		#Область Проверка_непротиворечивости
		
		// ПРАВИЛА НЕПРОТИВОРЕЧИВОСТИ:
		//	- если закрываются проводки, партии должны быть закрыты
		//	- если закрываются партии, бэк-офис должен быть закрыт
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		#Область ТекстЗапроса
	
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ДатыЗапретаРедактирования.Организация КАК Организация,
			|	ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ДатыЗапретаРедактирования.ГруппаЗапрета КАК ГруппаЗапрета,
			|	ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета,
			|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
			|ПОМЕСТИТЬ _ДатыЗапретаРедактирования
			|ИЗ
			|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
			|ГДЕ
			|	ДатыЗапретаРедактирования.СчетДоверительногоУправления В(&СчетДоверительногоУправления)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ВложенныйЗапрос.Организация КАК Организация,
			|	ВложенныйЗапрос.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	ВложенныйЗапрос.ГруппаЗапрета КАК ГруппаЗапрета,
			|	ВложенныйЗапрос.ВидУчета КАК ВидУчета,
			|	ВложенныйЗапрос.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
			|	ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности КАК ВидДеятельности
			|ПОМЕСТИТЬ _ДатыЗапретаРедактированияСВидамиДеятельности
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ДатыЗапретаРедактирования.Организация КАК Организация,
			|		_ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета КАК ГруппаЗапрета,
			|		_ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета,
			|		_ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
			|		ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности КАК ВидДеятельности,
			|		МАКСИМУМ(ЛицензииДоговоровДоверительногоУправления.Период) КАК Период
			|	ИЗ
			|		_ДатыЗапретаРедактирования КАК _ДатыЗапретаРедактирования
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
			|			ПО _ДатыЗапретаРедактирования.Организация = ЛицензииДоговоровДоверительногоУправления.Организация
			|				И _ДатыЗапретаРедактирования.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
			|				И _ДатыЗапретаРедактирования.ДатаЗапретаРедактирования >= ЛицензииДоговоровДоверительногоУправления.Период
			|	ГДЕ
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис)
			|	
			|	СГРУППИРОВАТЬ ПО
			|		_ДатыЗапретаРедактирования.Организация,
			|		_ДатыЗапретаРедактирования.СчетДоверительногоУправления,
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета,
			|		_ДатыЗапретаРедактирования.ВидУчета,
			|		_ДатыЗапретаРедактирования.ДатаЗапретаРедактирования,
			|		ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности) КАК ВложенныйЗапрос
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
			|		ПО ВложенныйЗапрос.Организация = ЛицензииДоговоровДоверительногоУправления.Организация
			|			И ВложенныйЗапрос.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления
			|			И ВложенныйЗапрос.ВидДеятельности = ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности
			|			И ВложенныйЗапрос.Период = ЛицензииДоговоровДоверительногоУправления.Период
			|ГДЕ
			|	ЛицензииДоговоровДоверительногоУправления.Действует
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДатыЗапретаРедактированияСВидамиДеятельности.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактированияКонтролера,
			|	_ДатыЗапретаРедактированияСВидамиДеятельности.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
			|	""Нужный вид лицензии на дату запрета редактирования"" КАК Комментарий
			|ПОМЕСТИТЬ _СоответствиеДатамЗапретаРедактированияКонтролера
			|ИЗ
			|	_ДатыЗапретаРедактированияКонтролера КАК _ДатыЗапретаРедактированияКонтролера
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактированияСВидамиДеятельности КАК _ДатыЗапретаРедактированияСВидамиДеятельности
			|		ПО _ДатыЗапретаРедактированияКонтролера.Организация = _ДатыЗапретаРедактированияСВидамиДеятельности.Организация
			|			И _ДатыЗапретаРедактированияКонтролера.ВидДеятельности = _ДатыЗапретаРедактированияСВидамиДеятельности.ВидДеятельности
			|			И _ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования > _ДатыЗапретаРедактированияСВидамиДеятельности.ДатаЗапретаРедактирования
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	_ДатыЗапретаРедактирования.СчетДоверительногоУправления,
			|	_ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования,
			|	_ДатыЗапретаРедактирования.ДатаЗапретаРедактирования,
			|	""Нужный вид лицензии установлен между датой запрета и датой запрета контролёра""
			|ИЗ
			|	_ДатыЗапретаРедактированияКонтролера КАК _ДатыЗапретаРедактированияКонтролера
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК _ДатыЗапретаРедактирования
			|		ПО _ДатыЗапретаРедактированияКонтролера.Организация = _ДатыЗапретаРедактирования.Организация
			|			И (_ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
			|			И _ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования > _ДатыЗапретаРедактирования.ДатаЗапретаРедактирования
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправления
			|		ПО (_ДатыЗапретаРедактирования.Организация = ЛицензииДоговоровДоверительногоУправления.Организация)
			|			И (_ДатыЗапретаРедактирования.СчетДоверительногоУправления = ЛицензииДоговоровДоверительногоУправления.СчетДоверительногоУправления)
			|			И _ДатыЗапретаРедактированияКонтролера.ВидДеятельности = ЛицензииДоговоровДоверительногоУправления.Лицензия.ВидДеятельности
			|			И (ЛицензииДоговоровДоверительногоУправления.Период МЕЖДУ _ДатыЗапретаРедактирования.ДатаЗапретаРедактирования И _ДатыЗапретаРедактированияКонтролера.ДатаЗапретаРедактирования)
			|			И (ЛицензииДоговоровДоверительногоУправления.Действует)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДатыЗапретаРедактированияПроводки.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДатыЗапретаРедактированияПроводки.ГруппаЗапрета КАК ГруппаЗапрета,
			|	_ДатыЗапретаРедактированияПроводки.ВидУчета КАК ВидУчета,
			|	_ДатыЗапретаРедактированияПроводки.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактированияПроводки,
			|	_ДатыЗапретаРедактированияПартии.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактированияПартии
			|ПОМЕСТИТЬ _СоответствиеДатЗапретаРедактированияПроводокИПартий
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ДатыЗапретаРедактирования.Организация КАК Организация,
			|		_ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета КАК ГруппаЗапрета,
			|		_ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета,
			|		_ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
			|	ИЗ
			|		_ДатыЗапретаРедактирования КАК _ДатыЗапретаРедактирования
			|	ГДЕ
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки)) КАК _ДатыЗапретаРедактированияПроводки
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК _ДатыЗапретаРедактированияПартии
			|		ПО _ДатыЗапретаРедактированияПроводки.Организация = _ДатыЗапретаРедактированияПартии.Организация
			|			И _ДатыЗапретаРедактированияПроводки.СчетДоверительногоУправления = _ДатыЗапретаРедактированияПартии.СчетДоверительногоУправления
			|			И _ДатыЗапретаРедактированияПроводки.ВидУчета = _ДатыЗапретаРедактированияПартии.ВидУчета
			|			И (_ДатыЗапретаРедактированияПартии.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
			|ГДЕ
			|	_ДатыЗапретаРедактированияПроводки.ДатаЗапретаРедактирования > ЕСТЬNULL(_ДатыЗапретаРедактированияПартии.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	_ДатыЗапретаРедактированияПартии.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|	_ДатыЗапретаРедактированияПартии.ГруппаЗапрета КАК ГруппаЗапрета,
			|	_ДатыЗапретаРедактированияПартии.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактированияПартии,
			|	_ДатыЗапретаРедактированияБэкОфис.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактированияБэкОфис
			|ПОМЕСТИТЬ _СоответствиеДатЗапретаРедактированияПартийИОперацийБэкОфиса
			|ИЗ
			|	(ВЫБРАТЬ
			|		_ДатыЗапретаРедактирования.Организация КАК Организация,
			|		_ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета КАК ГруппаЗапрета,
			|		_ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета,
			|		_ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования
			|	ИЗ
			|		_ДатыЗапретаРедактирования КАК _ДатыЗапретаРедактирования
			|	ГДЕ
			|		_ДатыЗапретаРедактирования.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии)) КАК _ДатыЗапретаРедактированияПартии
			|		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК _ДатыЗапретаРедактированияБэкОфис
			|		ПО _ДатыЗапретаРедактированияПартии.Организация = _ДатыЗапретаРедактированияБэкОфис.Организация
			|			И _ДатыЗапретаРедактированияПартии.СчетДоверительногоУправления = _ДатыЗапретаРедактированияБэкОфис.СчетДоверительногоУправления
			|			И (_ДатыЗапретаРедактированияБэкОфис.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис))
			|ГДЕ
			|	_ДатыЗапретаРедактированияПартии.ДатаЗапретаРедактирования > ЕСТЬNULL(_ДатыЗапретаРедактированияБэкОфис.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1))";
		
		#КонецОбласти		

		РегистрыСведений.ДатыЗапретаРедактирования.ПоместитьВЗапросДатыЗапретаРедактированияКонтролера(Запрос, ЭтотОбъект.ДополнительныеСвойства.Свойство("ИгнорироватьДатуЗапретаРедактированияКонтролера"));
		
		Запрос.УстановитьПараметр("СчетДоверительногоУправления", ПолучитьОбрабатываемыеСчетаДоверительногоУправления());
		Запрос.Выполнить();
		
		// проверим соответствие дат запрета редактирования счетов датам запрета редактирования контролёра
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СоответствиеДатамЗапретаРедактированияКонтролера").ПолучитьДанные().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.ДатаЗапретаРедактирования) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("По счету д/у '%1' отсутствует дата запрета редактирования операций бэк-офиса", Выборка.СчетДоверительногоУправления),,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("По счету д/у '%1' дата запрета редактирования операций бэк-офиса (%2) меньше, чем дата запрета редактирования контролёра (%3)", Выборка.СчетДоверительногоУправления, Формат(Выборка.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy"), Формат(Выборка.ДатаЗапретаРедактированияКонтролера, "ДФ=dd.MM.yyyy")),,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
		// проверим соответствие дат запрета редактирования проводок и партий
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СоответствиеДатЗапретаРедактированияПроводокИПартий").ПолучитьДанные().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.ДатаЗапретаРедактированияПартии) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету д/у '" + Выборка.СчетДоверительногоУправления + "' отсутствует дата запрета редактирования партий по виду учета '" + Выборка.ВидУчета + "'",,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету д/у '" + Выборка.СчетДоверительногоУправления + "' дата запрета редактирования партий по виду учета '" + Выборка.ВидУчета + "' меньше, чем дата запрета редактирования проводок",,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
		// проверим соответствие дат запрета редактирования партий и операций бэк-офиса
		Выборка = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("_СоответствиеДатЗапретаРедактированияПартийИОперацийБэкОфиса").ПолучитьДанные().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.ДатаЗапретаРедактированияБэкОфис) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету д/у '" + Выборка.СчетДоверительногоУправления + "' отсутствует дата запрета редактирования операций бэк-офиса",,,, Отказ);
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету д/у '" + Выборка.СчетДоверительногоУправления + "' дата запрета редактирования операций бэк-офиса меньше, чем дата запрета редактирования партий",,,, Отказ);
			КонецЕсли;
		КонецЦикла;
		
		#КонецОбласти 
		
		#Область Проверка_последовательности
		
		// !!! Проверка временно отключена, т.к. на текущий момент есть последовательности, которые не восстанавливаются
		//Если ЭтотОбъект.Количество() > 0 Тогда
		//	
		//	РезультатЗапроса = Обработки.ВосстановлениеПоследовательностей.ВыбратьНевосстановленныеПоследовательностиПоНаборуЗаписей(ЭтотОбъект.Выгрузить());
		//	Выборка = РезультатЗапроса.Выбрать();
		//	Пока Выборка.Следующий() Цикл
		//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По счету д/у '" + Выборка.СчетДоверительногоУправления + "' не восстановлена последовательность операций",,,, Отказ);
		//	КонецЦикла; 			
		//
		//КонецЕсли; 
		
		#КонецОбласти 

		#Область Проверка_необходимости_пересчета_СЧА
		
		ТаблицаЗаписейДляКонтроляСЧА = Неопределено;
		Если Не Отказ И ЭтотОбъект.ДополнительныеСвойства.Свойство("ТаблицаЗаписейДляКонтроляСЧА", ТаблицаЗаписейДляКонтроляСЧА) Тогда
			
			Для каждого ТекСтрока Из ТаблицаЗаписейДляКонтроляСЧА Цикл
				
				ОтсутствуютНастройкиСЧА = Ложь;
				МассивДатСЧА = Справочники.НастройкиРегламентныхДействий.ПолучитьДатыРасчетаСЧАЗаПериод(ТекСтрока.СчетДоверительногоУправления, ТекСтрока.ДатаНачала, ТекСтрока.ДатаОкончания,,ОтсутствуютНастройкиСЧА);
	
				Если ОтсутствуютНастройкиСЧА Тогда
					
					ТемаПисьма = СтрШаблон("Контроль СЧА. По счету д/у %1 не заданы настройки формирования СЧА за период с %2 по %3", ТекСтрока.СчетДоверительногоУправления, Формат(ТекСтрока.ДатаНачала, "ДФ=dd.MM.yyyy"), Формат(ТекСтрока.ДатаОкончания, "ДФ=dd.MM.yyyy"));
					
					РеквизитыОповещения = Новый Структура("Организация, Тема, Текст", ТекСтрока.Организация, ТемаПисьма, "");
					Справочники.Оповещения.СформироватьОповещения("Обработка.КонтрольСЧА.ВыполнитьПроверкуВФоне()", Перечисления.ТипыСобытий.ВнешнийВызов, РеквизитыОповещения);
					
				Иначе
					
					Параметры = Новый Структура("Организация, СчетДоверительногоУправления");
					ЗаполнитьЗначенияСвойств(Параметры, ТекСтрока);
					
					Параметры.Вставить("ТекстОшибки",		"Не удалось добавить отложенное задание 'Обработки.КонтрольСЧА.ВыполнитьКонтрольПоКлиенту' при изменении даты запрета.");
					Параметры.Вставить("ИсточникОшибки",	"Контроль СЧА");
					
					Для каждого ДатаРасчета Из МассивДатСЧА Цикл
						
						Параметры.Вставить("Дата", ДатаРасчета);
						
						РаботаСРегламентнымиЗаданиями.ДобавитьОтложенноеЗадание("Обработки.КонтрольСЧА", "ВыполнитьОтложенныйКонтроль", Параметры, 15, Истина);
						
					КонецЦикла;
					
				КонецЕсли;
				              				
			КонецЦикла; 
		
		КонецЕсли;
		
		#КонецОбласти 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("НеПроверятьЗаполнениеДатыЗапрета") Тогда
		Для Индекс = 0 По ПроверяемыеРеквизиты.ВГраница()  Цикл
			ТекРеквизит = ПроверяемыеРеквизиты[Индекс];
			Если ТекРеквизит = "ДатаЗапретаРедактирования" Тогда
				ПроверяемыеРеквизиты.Удалить(Индекс);
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
	КонецЕсли; 
	
КонецПроцедуры

