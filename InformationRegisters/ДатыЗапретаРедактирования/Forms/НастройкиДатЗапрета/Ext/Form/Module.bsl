
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ТолькоПросмотр = Не ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.ДатыЗапретаРедактирования);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "Организация, СчетДоверительногоУправления");
	
	Параметры.Свойство("ЭтоФормаСчетаДУ", ЭтаФорма.ЭтоФормаСчетаДУ);
	
	Если ЭтаФорма.ЭтоФормаСчетаДУ Тогда
		Элементы.ФормаЗаписать.КнопкаПоУмолчанию = Истина;
	Иначе
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, "ОтображатьБухгалтерскийУчет, ОтображатьНалоговыйУчет, ОтображатьЕдиныйБухгалтерскийУчет");
	КонецЕсли; 
	
	СоответствиеВидовУчета = Новый Соответствие;
	СоответствиеВидовУчета.Вставить(Перечисления.ВидыУчета.ПустаяСсылка(), "Бэк");
	СоответствиеВидовУчета.Вставить(Перечисления.ВидыУчета.БухгалтерскийУчет, "БУ");
	СоответствиеВидовУчета.Вставить(Перечисления.ВидыУчета.НалоговыйУчет, "НУ");
	СоответствиеВидовУчета.Вставить(Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет, "ЕПС");
	
	СоответствиеГрупп = Новый Соответствие;
	СоответствиеГрупп.Вставить(Перечисления.ГруппыЗапретаРедактирования.БэкОфис, "");
	СоответствиеГрупп.Вставить(Перечисления.ГруппыЗапретаРедактирования.Партии, "Партии");
	СоответствиеГрупп.Вставить(Перечисления.ГруппыЗапретаРедактирования.Проводки, "Проводки");
	
	СтруктураСоответствий = Новый Структура("СоответствиеВидовУчета, СоответствиеГрупп", СоответствиеВидовУчета, СоответствиеГрупп);
	АдресСтруктурыСоответствий = ПоместитьВоВременноеХранилище(СтруктураСоответствий, ЭтаФорма.УникальныйИдентификатор);
	
	Если ЗначениеЗаполнено(ЭтаФорма.СчетДоверительногоУправления) Тогда
		ЗаполнитьДатыЗапрета();
	Иначе
		Элементы.СчетДоверительногоУправления.ТолькоПросмотр = Ложь;
	КонецЕсли; 
	
	Элементы.ФормаЗаписать.Видимость = ЭтаФорма.ЭтоФормаСчетаДУ;
	Элементы.ФормаЗаписатьИЗакрыть.Видимость = Не ЭтаФорма.ЭтоФормаСчетаДУ;
	Элементы.ФормаЗакрыть.Видимость = Не ЭтаФорма.ЭтоФормаСчетаДУ;
	Элементы.ГруппаШапка.Видимость = Не ЭтаФорма.ЭтоФормаСчетаДУ;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьПоВидамУчета(); 
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
	
		Отказ = Истина;
		ТекстПредупреждения = НСтр("ru='Даты запрета редактирования были изменены.
										|Перед завершением работы рекомендуется записать настройки,
										|иначе измененные данные будут утеряны.'");
		
		Возврат;
	
	КонецЕсли; 
	
	Если ЭтаФорма.Модифицированность Тогда
		
		ТекстВопроса = "Даты запрета редактирования были изменены. Сохранить изменения?";
		РежимДиалога = ?(ЭтаФорма.ЭтоФормаСчетаДУ, РежимДиалогаВопрос.ДаНетОтмена, РежимДиалогаВопрос.ДаНет);
		
		Ответ = Вопрос(ТекстВопроса, РежимДиалога);
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
		    Если ЗаписатьНаСервере() Тогда
				Оповестить("ОбновленыДатыЗапретаРедактирования"); 
			КонецЕсли;
		ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
			Отказ = Истина;
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтображатьБухгалтерскийУчетПриИзменении(Элемент)
	УстановитьВидимостьПоВидамУчета();
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьНалоговыйУчетПриИзменении(Элемент)
	УстановитьВидимостьПоВидамУчета();
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьЕдиныйБухгалтерскийУчетПриИзменении(Элемент)
	УстановитьВидимостьПоВидамУчета();
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	ЗаполнитьДатыЗапрета();
КонецПроцедуры

#КонецОбласти 

#Область КомандыФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если ЗаписатьНаСервере() Тогда
		Оповестить("ОбновленыДатыЗапретаРедактирования"); 
		ЭтаФорма.Модифицированность = Ложь;
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДатыЗапрета()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.ГруппаЗапрета КАК ГруппаЗапрета,
		|	ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК Дата,
		|	ДатыЗапретаРедактирования.Ответственный КАК Ответственный,
		|	ДатыЗапретаРедактирования.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления";

	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИменаРеквизитов = СтрРазделить("Дата,Ответственный,Комментарий", ",");
	
	СтруктураСоответствий = ПолучитьИзВременногоХранилища(АдресСтруктурыСоответствий);
	
	Пока Выборка.Следующий() Цикл
		
		ПостфиксИмениРеквизита = СтруктураСоответствий.СоответствиеГрупп[Выборка.ГруппаЗапрета] + СтруктураСоответствий.СоответствиеВидовУчета[Выборка.ВидУчета];
		
		Для каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			
			ИмяРеквизитаФормы = ИмяРеквизита + ПостфиксИмениРеквизита;
			
			ЭтаФорма[ИмяРеквизитаФормы] = Выборка[ИмяРеквизита];
			
		КонецЦикла; 
		
	
		ОтборКлючаЗаписи = Новый Структура("Организация, СчетДоверительногоУправления, ГруппаЗапрета, ВидУчета",
			ЭтаФорма.Организация,
			ЭтаФорма.СчетДоверительногоУправления,
			Выборка.ГруппаЗапрета,
			Выборка.ВидУчета);
			
		КлючЗаписи = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьКлючЗаписи(ОтборКлючаЗаписи);
		ИсторияДанных.ОбновитьИсторию(КлючЗаписи, Ложь, Ложь);
		
		ОтборДляИсторииДанных = Новый Структура("Данные", КлючЗаписи);
		Версии = ИсторияДанных.ВыбратьВерсии(ОтборДляИсторииДанных, "Дата",, 1);
		Если Версии.Количество() > 0 Тогда
		
			ЭтаФорма["ВремяИзменения" + ПостфиксИмениРеквизита] = Версии[0].Дата;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры
 
&НаКлиенте
Процедура УстановитьВидимостьПоВидамУчета()

	Элементы.ГруппаБУ.Видимость  = ЭтаФорма.ОтображатьБухгалтерскийУчет;
	Элементы.ГруппаНУ.Видимость  = ЭтаФорма.ОтображатьНалоговыйУчет;
	Элементы.ГруппаЕПС.Видимость = ЭтаФорма.ОтображатьЕдиныйБухгалтерскийУчет;

КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере(ОбновитьПослеЗаписи = Ложь)
	
	НовыеДатыЗапрета = Новый ТаблицаЗначений;
	ДатыЗапретаМД = Метаданные.РегистрыСведений.ДатыЗапретаРедактирования;
	Для каждого Измерение Из ДатыЗапретаМД.Измерения Цикл
		НовыеДатыЗапрета.Колонки.Добавить(Измерение.Имя, Измерение.Тип);
	КонецЦикла; 
	Для каждого Ресурс Из ДатыЗапретаМД.Ресурсы Цикл
		НовыеДатыЗапрета.Колонки.Добавить(Ресурс.Имя, Ресурс.Тип);
	КонецЦикла;
	Для каждого Реквизит Из ДатыЗапретаМД.Реквизиты Цикл
		НовыеДатыЗапрета.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	СтруктураСоответствий = ПолучитьИзВременногоХранилища(АдресСтруктурыСоответствий);
	
	Для каждого ГруппаЗапрета Из СтруктураСоответствий.СоответствиеГрупп Цикл
	
		Для каждого ВидУчета Из СтруктураСоответствий.СоответствиеВидовУчета Цикл
			
			ИмяЭлемента = ГруппаЗапрета.Значение + ВидУчета.Значение;
			
			Попытка
				ДатаЗапрета = ЭтаФорма["Дата" + ИмяЭлемента];
			Исключение
				Продолжить;
			КонецПопытки; 
			
			НоваяСтрока = НовыеДатыЗапрета.Добавить();
			НоваяСтрока.Организация                  = ЭтаФорма.Организация;
			НоваяСтрока.СчетДоверительногоУправления = ЭтаФорма.СчетДоверительногоУправления;
			НоваяСтрока.ГруппаЗапрета                = ГруппаЗапрета.Ключ;
			НоваяСтрока.ВидУчета                     = ВидУчета.Ключ;
			НоваяСтрока.ДатаЗапретаРедактирования    = ДатаЗапрета;
			НоваяСтрока.Комментарий                  = ЭтаФорма["Комментарий" + ИмяЭлемента];
			
		КонецЦикла; 	
	
	КонецЦикла; 
	
	Если НЕ РегистрыСведений.ДатыЗапретаРедактирования.ПроверитьКорректностьДатЗапретаРедактирования(Организация, НовыеДатыЗапрета) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НовыеДатыЗапрета.Организация КАК Организация,
		|	НовыеДатыЗапрета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	НовыеДатыЗапрета.ГруппаЗапрета КАК ГруппаЗапрета,
		|	НовыеДатыЗапрета.ВидУчета КАК ВидУчета,
		|	НовыеДатыЗапрета.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
		|	ВЫРАЗИТЬ(НовыеДатыЗапрета.Комментарий КАК СТРОКА(1024)) КАК Комментарий
		|ПОМЕСТИТЬ _НовыеДатыЗапрета
		|ИЗ
		|	&НовыеДатыЗапрета КАК НовыеДатыЗапрета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДатыЗапретаРедактирования.Организация КАК Организация,
		|	ДатыЗапретаРедактирования.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДатыЗапретаРедактирования.ГруппаЗапрета КАК ГруппаЗапрета,
		|	ДатыЗапретаРедактирования.ВидУчета КАК ВидУчета,
		|	ДатыЗапретаРедактирования.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
		|	ВЫРАЗИТЬ(ДатыЗапретаРедактирования.Комментарий КАК СТРОКА(1024)) КАК Комментарий
		|ПОМЕСТИТЬ _СтарыеДатыЗапрета
		|ИЗ
		|	РегистрСведений.ДатыЗапретаРедактирования КАК ДатыЗапретаРедактирования
		|ГДЕ
		|	ДатыЗапретаРедактирования.Организация = &Организация
		|	И ДатыЗапретаРедактирования.СчетДоверительногоУправления = &СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НовыеДатыЗапрета.Организация КАК Организация,
		|	_НовыеДатыЗапрета.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_НовыеДатыЗапрета.ГруппаЗапрета КАК ГруппаЗапрета,
		|	_НовыеДатыЗапрета.ВидУчета КАК ВидУчета,
		|	_НовыеДатыЗапрета.ДатаЗапретаРедактирования КАК ДатаЗапретаРедактирования,
		|	_НовыеДатыЗапрета.Комментарий КАК Комментарий
		|ИЗ
		|	_НовыеДатыЗапрета КАК _НовыеДатыЗапрета
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СтарыеДатыЗапрета КАК _СтарыеДатыЗапрета
		|		ПО _НовыеДатыЗапрета.Организация = _СтарыеДатыЗапрета.Организация
		|			И _НовыеДатыЗапрета.СчетДоверительногоУправления = _СтарыеДатыЗапрета.СчетДоверительногоУправления
		|			И _НовыеДатыЗапрета.ГруппаЗапрета = _СтарыеДатыЗапрета.ГруппаЗапрета
		|			И _НовыеДатыЗапрета.ВидУчета = _СтарыеДатыЗапрета.ВидУчета
		|ГДЕ
		|	_НовыеДатыЗапрета.ДатаЗапретаРедактирования <> ЕСТЬNULL(_СтарыеДатыЗапрета.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1))
		|	ИЛИ _НовыеДатыЗапрета.Комментарий <> ЕСТЬNULL(_СтарыеДатыЗапрета.Комментарий, """")
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|		КОГДА _НовыеДатыЗапрета.ДатаЗапретаРедактирования > ЕСТЬNULL(_СтарыеДатыЗапрета.ДатаЗапретаРедактирования, ДАТАВРЕМЯ(1, 1, 1)) ТОГДА
		|			ВЫБОР
		|				КОГДА _НовыеДатыЗапрета.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис) ТОГДА 1
		|				КОГДА _НовыеДатыЗапрета.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии) ТОГДА 2
		|				КОГДА _НовыеДатыЗапрета.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки) ТОГДА 3
		|			КОНЕЦ
		|		ИНАЧЕ
		|			ВЫБОР
		|				КОГДА _НовыеДатыЗапрета.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.БэкОфис) ТОГДА 30
		|				КОГДА _НовыеДатыЗапрета.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии) ТОГДА 20
		|				КОГДА _НовыеДатыЗапрета.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки) ТОГДА 10
		|			КОНЕЦ
		|	КОНЕЦ
		|";
	Запрос.УстановитьПараметр("Организация", ЭтаФорма.Организация);
	Запрос.УстановитьПараметр("СчетДоверительногоУправления", ЭтаФорма.СчетДоверительногоУправления);
	Запрос.УстановитьПараметр("НовыеДатыЗапрета", НовыеДатыЗапрета);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Измерения = Метаданные.РегистрыСведений.ДатыЗапретаРедактирования.Измерения;
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
	
		НаборЗаписей = РегистрыСведений.ДатыЗапретаРедактирования.СоздатьНаборЗаписей();
		НаборЗаписей.ДополнительныеСвойства.Вставить("ИнтерактивнаяУстановкаДатыЗапрета");
		НаборЗаписей.ДополнительныеСвойства.Вставить("НеПроверятьЗаполнениеДатыЗапрета");
		
		Для каждого Измерение Из Измерения Цикл
			НаборЗаписей.Отбор[Измерение.Имя].Установить(Выборка[Измерение.Имя]);
		КонецЦикла; 
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Комментарий = СокрЛП(Запись.Комментарий);
		
		Попытка
			НаборЗаписей.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При попытке записать новые значения дат запрета редактирования произошла ошибка:" + Символы.ПС + ОписаниеОшибки());
			
			ОтменитьТранзакцию();
			Возврат Ложь;
		КонецПопытки;
		
	КонецЦикла; 
	
	ЗафиксироватьТранзакцию();
	
	Если ОбновитьПослеЗаписи Тогда
	
		ЗаполнитьДатыЗапрета();
	
	КонецЕсли; 
	
	Возврат Выборка.Количество();
		
КонецФункции

&НаКлиенте
Процедура Записать(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
	
		Если ЗаписатьНаСервере(Истина) Тогда
			Оповестить("ОбновленыДатыЗапретаРедактирования"); 
			ЭтаФорма.Модифицированность = Ложь;
		КонецЕсли;
	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти 




