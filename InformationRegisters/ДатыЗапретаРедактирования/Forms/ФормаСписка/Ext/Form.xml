		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = ДатыЗапретаПартииБУ.СчетДоверительногоУправления
			И (ДатыЗапретаПартииБУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет))
			И (ДатыЗапретаПартииБУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК ДатыЗапретаПартииНУ
		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = ДатыЗапретаПартииНУ.СчетДоверительногоУправления
			И (ДатыЗапретаПартииНУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
			И (ДатыЗапретаПартииНУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК ДатыЗапретаПартииЕПС
		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = ДатыЗапретаПартииЕПС.СчетДоверительногоУправления
			И (ДатыЗапретаПартииЕПС.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
			И (ДатыЗапретаПартииЕПС.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Партии))
		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК ДатыЗапретаПроводкиБУ
		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = ДатыЗапретаПроводкиБУ.СчетДоверительногоУправления
			И (ДатыЗапретаПроводкиБУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.БухгалтерскийУчет))
			И (ДатыЗапретаПроводкиБУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки))
		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК ДатыЗапретаПроводкиНУ
		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = ДатыЗапретаПроводкиНУ.СчетДоверительногоУправления
			И (ДатыЗапретаПроводкиНУ.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.НалоговыйУчет))
			И (ДатыЗапретаПроводкиНУ.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки))
		ЛЕВОЕ СОЕДИНЕНИЕ _ДатыЗапретаРедактирования КАК ДатыЗапретаПроводкиЕПС
		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = ДатыЗапретаПроводкиЕПС.СчетДоверительногоУправления
			И (ДатыЗапретаПроводкиЕПС.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчета.ЕдиныйБухгалтерскийУчет))
			И (ДатыЗапретаПроводкиЕПС.ГруппаЗапрета = ЗНАЧЕНИЕ(Перечисление.ГруппыЗапретаРедактирования.Проводки))
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		ПО ДатыЗапретаБэкОфис.СчетДоверительногоУправления = СчетаДоверительногоУправления.Ссылка
