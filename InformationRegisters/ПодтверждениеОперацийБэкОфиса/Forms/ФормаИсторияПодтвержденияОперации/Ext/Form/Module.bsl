&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не (Параметры.Свойство("Операция", Операция) И ЗначениеЗаполнено(Операция)) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен параметр ""Операция""", , , , Отказ);
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Операция, "Организация");
	
	ОбновитьИсториюПодтвержденияОперации();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ПодтверждениеОперации" Тогда
		Если Параметр = ЭтаФорма.Операция
			ИЛИ (ТипЗнч(Параметр) = Тип("Массив") И Параметр.Найти(ЭтаФорма.Операция) <> Неопределено)
		Тогда
			ОбновитьИсториюПодтвержденияОперации();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтвердитьОперацию(Команда)

	ОповещениеПриЗакрытииДочернегоОкна = Новый ОписаниеОповещения("ПриЗакрытииДочернегоОкна", ЭтаФорма);

	ЗначенияЗаполнения = Новый Структура("Операция, Организация", ЭтаФорма.Операция, ЭтаФорма.Организация);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);

	ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , ОповещениеПриЗакрытииДочернегоОкна, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтменитьПодтверждение(Команда)
	
	ОповещениеПриЗакрытииДочернегоОкна = Новый ОписаниеОповещения("ПриЗакрытииДочернегоОкна", ЭтаФорма);
	
	ЗначенияЗаполнения = Новый Структура("Операция, Организация", ЭтаФорма.Операция, ЭтаФорма.Организация);
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения, ОтменаПодтверждения", ЗначенияЗаполнения, Истина);
	
	ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.ФормаЗаписи", ПараметрыФормы, ЭтаФорма, , , , ОповещениеПриЗакрытииДочернегоОкна, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьИсториюПодтверждения(Команда)

	ОбновитьИсториюПодтвержденияОперации();		
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПодтвержденийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.ИсторияПодтверждений.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("КорректировкаЗаписи, Ключ", Истина, РаботаСДокументами.ПолучитьКлючЗаписиПодтвержденияОперации(ЭтаФорма.Операция, ЭтаФорма.Организация, ТекущиеДанные.Период));
	РезультатЗакрытия = ОткрытьФормуМодально("РегистрСведений.ПодтверждениеОперацийБэкОфиса.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииДочернегоОкна(Параметр, ДополнительныеПараметры) Экспорт
	
	Если Параметр <> Неопределено Тогда 
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИсториюПодтвержденияОперации()
	
	ОперацияПодтверждена = Ложь;
	ИсторияПодтверждений.Очистить();	
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПодтверждениеОперацийБэкОфиса.Период КАК Период,
		|	ПодтверждениеОперацийБэкОфиса.Подтверждена КАК Подтверждена,
		|	ПодтверждениеОперацийБэкОфиса.Основание КАК Основание,
		|	ПодтверждениеОперацийБэкОфиса.РучнойРежим КАК РучнойРежим,
		|	ПодтверждениеОперацийБэкОфиса.Примечание КАК Примечание,
		|	ВЫБОР
		|		КОГДА ПодтверждениеОперацийБэкОфиса.Подтверждена
		|				И ПодтверждениеОперацийБэкОфиса.РучнойРежим
		|			ТОГДА ""Подтверждена вручную""
		|		КОГДА ПодтверждениеОперацийБэкОфиса.Подтверждена
		|			ТОГДА ""Подтверждена""
		|		ИНАЧЕ ""Не подтверждена""
		|	КОНЕЦ КАК ПредставлениеСостояния
		|ИЗ
		|	РегистрСведений.ПодтверждениеОперацийБэкОфиса КАК ПодтверждениеОперацийБэкОфиса
		|ГДЕ
		|	ПодтверждениеОперацийБэкОфиса.Операция = &Операция
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период");
	
	Запрос.УстановитьПараметр("Операция", Операция);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ИсторияПодтверждений.Загрузить(РезультатЗапроса.Выгрузить());
		
		ОперацияПодтверждена = ИсторияПодтверждений[(ИсторияПодтверждений.Количество() - 1)].Подтверждена;
	КонецЕсли;
	
	Элементы.ФормаПодтвердитьОперацию.Видимость = Не ОперацияПодтверждена;
	Элементы.ФормаОтменитьПодтверждение.Видимость = ОперацияПодтверждена;
	
	Элементы.ФормаПодтвердитьОперацию.КнопкаПоУмолчанию = Элементы.ФормаПодтвердитьОперацию.Видимость;
	Элементы.ФормаОтменитьПодтверждение.КнопкаПоУмолчанию = Элементы.ФормаОтменитьПодтверждение.Видимость;

КонецПроцедуры