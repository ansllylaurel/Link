
#Область События_формы_и_элементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ОрганизацияПараметр.Видимость	= РаботаСПользователями.ЭтоПолноправныйПользователь();
	Элементы.Организация.Видимость			= Не Элементы.ОрганизацияПараметр.Видимость;
	
	ЭтаФорма.Организация				= ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
	ЭтаФорма.Период.ДатаОкончания		= НачалоДня(ТекущаяДата()) - 1;
	ЭтаФорма.Период.ДатаНачала			= НачалоДня(ЭтаФорма.Период.ДатаОкончания);
	ЭтаФорма.ВремяСверки				= ТекущаяДата();	
	
	Если ЭтаФорма.Параметры.Свойство("ПараметрыЗаполнения") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, ЭтаФорма.Параметры.ПараметрыЗаполнения);
	КонецЕсли;	
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);	
	
	Если Параметры.Свойство("СформироватьПриОткрытии") И Параметры.СформироватьПриОткрытии = Истина Тогда
		СкомпоноватьРезультатНаСервере();	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьВидимостьДоступностьЭлементовФормы(ЭтаФорма);	
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	СтрокаСообщенийОбОшибках = "";
	
	Если Не ОбщегоНазначенияКлиентСервер.ПериодЗаполненКорректно(ЭтаФорма.Период, Ложь, Ложь, СтрокаСообщенийОбОшибках) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщенийОбОшибках, , , "Период", Отказ); 	
	КонецЕсли;
	
	Если ЭтаФорма.ФиксироватьРезультатСверки И Не ЗначениеЗаполнено(ЭтаФорма.ВремяСверки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для фиксации результатов сверки должно быть указано время сверки.", , "ВремяСверки", , Отказ);
	КонецЕсли;
	
	Если ЭтаФорма.РежимОтбора = 1 Тогда
		ПроверяемыеРеквизиты.Добавить("СчетДоверительногоУправления");
	ИначеЕсли ЭтаФорма.РежимОтбора = 2 Тогда
		ПроверяемыеРеквизиты.Добавить("ВидДеятельности"); 
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодДатаНачалаПриИзменении(Элемент)
	
	Если ЭтаФорма.ВидПериода = "День" Тогда
		Период.ДатаОкончания = КонецДня(Период.ДатаНачала);
	КонецЕсли;	
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодДатаОкончанияПриИзменении(Элемент)
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПериодаПриИзменении(Элемент)
	
	Если ЭтаФорма.ВидПериода = "День" Тогда
		Период.ДатаОкончания = КонецДня(Период.ДатаНачала);
	КонецЕсли;
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);	
	
	НастроитьВидимостьДоступностьЭлементовФормы(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтбораПриИзменении(Элемент)
	
	НастроитьВидимостьДоступностьЭлементовФормы(ЭтаФорма);

	ПриИзмененииПараметровОтчета(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоверительногоУправленияПриИзменении(Элемент)
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВидДеятельностиПриИзменении(Элемент)
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоНеподтвержденныеОперацииПриИзменении(Элемент)
	
	ПриИзмененииПараметровОтчета(ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ФиксироватьРезультатСверкиПриИзменении(Элемент)
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		ЭтаФорма.ВремяСверки = ТекущаяДата();
	КонецЕсли;
	
	НастроитьВидимостьДоступностьЭлементовФормы(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ВремяСверкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ВыбранноеЗначение = ВыбранноеЗначение + (ЭтаФорма.ВремяСверки - НачалоДня(ЭтаФорма.ВремяСверки));		
	
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Перем ВыбранноеДействие, ПараметрыВыбранногоДействия;

	Если ЭтоАдресВременногоХранилища(АдресРасшифровки) И ЭтоАдресВременногоХранилища(АдресСКД) Тогда
		СтандартнаяОбработка = Ложь;
		
		ПоляЭлементаРасшифровки = ПолучитьПоляЭлементаРасшифровки(Расшифровка, АдресРасшифровки);
		
		ДоступныеДействия		= Новый Массив;
		ДополнительныеДействия	= Новый СписокЗначений;
				
		ДополнительныеДействия.Добавить("ОткрытьЗначение", "Открыть значение");	
		Если ПоляЭлементаРасшифровки.Свойство("СчетДоверительногоУправления") Тогда		
			ДополнительныеДействия.Добавить("ИсторияПодтверждений", "История подтверждений");	
		КонецЕсли;		
		Если ПоляЭлементаРасшифровки.Свойство("Операция") Тогда		
			ДополнительныеДействия.Добавить("ИсторияПодтвержденияОперации", "История подтверждения операции");	
		КонецЕсли;
		
		ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(АдресРасшифровки, Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));
		ОбработкаРасшифровки.ВыбратьДействие(Расшифровка, ВыбранноеДействие, ПараметрыВыбранногоДействия, ДоступныеДействия, ДополнительныеДействия);
		
		Если ВыбранноеДействие = "ОткрытьЗначение" Тогда
			
			Для Каждого ПолеРасшифровки Из ПоляЭлементаРасшифровки Цикл
				ОткрытьЗначение(ПолеРасшифровки.Значение);
				Прервать;
			КонецЦикла;
			
		ИначеЕсли ВыбранноеДействие = "ИсторияПодтвержденияОперации" Тогда
			
			ПараметрыФормы = Новый Структура("Операция", ПоляЭлементаРасшифровки.Операция);		
			ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.Форма.ФормаИсторияПодтвержденияОперации", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ВыбранноеДействие = "ИсторияПодтверждений" Тогда
			
			ПоказатьИсториюПодтверждений(ЭтаФорма.Организация, ПоляЭлементаРасшифровки.СчетДоверительногоУправления, ЭтаФорма.Период);		
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаВвестиПериод(Команда)
	ДиалогВыбораПериода = Новый ДиалогРедактированияСтандартногоПериода();
	ДиалогВыбораПериода.Период.ДатаНачала		= ЭтаФорма.Период.ДатаНачала;
	ДиалогВыбораПериода.Период.ДатаОкончания	= ЭтаФорма.Период.ДатаОкончания;
	
	Если ДиалогВыбораПериода.Редактировать() Тогда 
		ЭтаФорма.Период.ДатаНачала		= ДиалогВыбораПериода.Период.ДатаНачала;
		ЭтаФорма.Период.ДатаОкончания	= ДиалогВыбораПериода.Период.ДатаОкончания;
		
		ПриИзмененииПараметровОтчета(ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаСформировать(Команда)

	Если Не ЭтаФорма.ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ФиксироватьРезультатСверки Тогда
		Если Период.ДатаОкончания > ЭтаФорма.ВремяСверки Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При фиксации результатов сверки период не должен быть позже времени сверки.", , "Период.ДатаОкончания");
			Возврат;
		ИначеЕсли (Период.ДатаОкончания - Период.ДатаНачала) / 86400 > 5 Тогда
			Если Вопрос("Фиксация результатов сверки за большой период может занять продолжительное время." + Символы.ПС + "Продолжить?" , РежимДиалогаВопрос.ОКОтмена) <> КодВозвратаДиалога.ОК Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СкомпоноватьРезультатНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодтвердитьВручную(Команда)

	ПараметрыЗаполнения = Новый Структура("Организация, РежимОтбора, ВидДеятельности, СчетДоверительногоУправления, Период");
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ЭтаФорма);	
	
	ПараметрыФормы = Новый Структура("ПараметрыЗаполнения, ОбновитьСписокПриОткрытии", ПараметрыЗаполнения, Истина); 
	
	ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.Форма.ФормаРучногоПодтвержденияОпераций", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверкаПодтверждений(Команда)

	ПараметрыЗаполнения = Новый Структура("Организация, РежимОтбора, ВидДеятельности, СчетДоверительногоУправления, Период");
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ЭтаФорма);	
	
	ПараметрыФормы = Новый Структура("ПараметрыЗаполнения, ОбновитьСписокПриОткрытии", ПараметрыЗаполнения, Истина); 
	
	ОткрытьФорму("РегистрСведений.ПодтверждениеОперацийБэкОфиса.Форма.ФормаПроверкиПодтверждений", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция СкомпоноватьРезультатНаСервере(ПараметрыОтбора = Неопределено, ИсторияПодтверждений = Ложь, ВыводВОсновнойДокумент = Истина)
	
	Если ПараметрыОтбора = Неопределено Тогда
		ПараметрыОтбора = Новый Структура("Организация, Период, РежимОтбора, СчетДоверительногоУправления, ВидДеятельности, ТолькоНеподтвержденныеОперации, ФиксироватьРезультатСверки");
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ЭтаФорма);
	КонецЕсли;
	
	Если ВыводВОсновнойДокумент Тогда
		ДокументРезультат = ЭтаФорма.Результат;
	Иначе
		ДокументРезультат = Новый ТабличныйДокумент;
		
		ДокументРезультат.ТолькоПросмотр = Истина;
		ДокументРезультат.ОтображатьСетку = Ложь;
		ДокументРезультат.ОтображатьЗаголовки = Ложь;
	КонецЕсли;
	
	ДокументРезультат.Очистить();
	
	СхемаКомпоновкиДанных = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьМакет("ЖурналПодтверждений");
	
	НастройкиКомпоновки = ?(ИсторияПодтверждений, СхемаКомпоновкиДанных.ВариантыНастроек.ИсторияПодтверждений.Настройки, СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ИсторияПодтверждений", ИсторияПодтверждений);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("Организация", ПараметрыОтбора.Организация);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаНачала", ПараметрыОтбора.Период.ДатаНачала);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ДатаОкончания", ПараметрыОтбора.Период.ДатаОкончания);
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ПредставлениеПериода", ПредставлениеПериода(ПараметрыОтбора.Период.ДатаНачала, ПараметрыОтбора.Период.ДатаОкончания));
	
	ПодтверждаемыеВидыОпераций = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьПодтверждаемыеВидыОпераций();
	НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ПодтверждаемыеВидыОпераций", ПодтверждаемыеВидыОпераций);

	НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("СчетДоверительногоУправления").Использование = Ложь;
	НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ВидДеятельности").Использование = Ложь;
	
	Если ПараметрыОтбора.РежимОтбора = 1 Тогда
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("СчетДоверительногоУправления", ПараметрыОтбора.СчетДоверительногоУправления);
	ИначеЕсли ПараметрыОтбора.РежимОтбора = 2 Тогда 
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ВидДеятельности", ПараметрыОтбора.ВидДеятельности);
	КонецЕсли;
	
	Если ПараметрыОтбора.ТолькоНеподтвержденныеОперации Тогда
		НастройкиКомпоновки.ПараметрыДанных.УстановитьЗначениеПараметра("ТолькоНеподтвержденные", Истина);
	Иначе
		НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти("ТолькоНеподтвержденные").Использование = Ложь;		
	КонецЕсли;	
	
	// Фиксируем запуск процедуры
	Механизм = "РегистрСведений.ПодтверждениеОперацийБэкОфиса.ЖурналПодтверждений";
	Сессия = ЗарегистрироватьНовуюСессиюРаботыВнутреннихМеханизмов(Механизм, НастройкиКомпоновки, ПараметрыОтбора.ФиксироватьРезультатСверки);	
	
	// Формируем отчет
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки, ДанныеРасшифровки);
	
	Если Не ВыводВОсновнойДокумент Тогда
		ДанныеРасшифровки = Неопределено;
	КонецЕсли;	
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	// Группируем строки по операциям
	Если ИсторияПодтверждений Тогда
		ВысотаШапки = 9;
		ПоследнееЗначение = ДокументРезультат.Область(ВысотаШапки - 1, 1, ВысотаШапки - 1, 1).Текст;
		ОбъединитьСтрок = 0;
		
		Для НомерСтроки = ВысотаШапки По ДокументРезультат.ВысотаТаблицы Цикл
			ТекущееЗначение = ДокументРезультат.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
			
			Если ТекущееЗначение = ПоследнееЗначение Тогда
				ОбъединитьСтрок = ОбъединитьСтрок + 1;				
			Иначе
				Если ОбъединитьСтрок > 0 Тогда
					ДокументРезультат.Область(НомерСтроки-ОбъединитьСтрок-1, 1, НомерСтроки-1, 1).Объединить();
					ДокументРезультат.Область(НомерСтроки-ОбъединитьСтрок-1, 2, НомерСтроки-1, 2).Объединить();
					ДокументРезультат.Область(НомерСтроки-ОбъединитьСтрок-1, 3, НомерСтроки-1, 3).Объединить();	
				КонецЕсли;
				
				ОбъединитьСтрок = 0;
			КонецЕсли;
			
			ПоследнееЗначение = ТекущееЗначение;			
		КонецЦикла;
		
		Если ОбъединитьСтрок > 0 Тогда
			ДокументРезультат.Область(НомерСтроки-ОбъединитьСтрок-1, 1, НомерСтроки-1, 1).Объединить();
			ДокументРезультат.Область(НомерСтроки-ОбъединитьСтрок-1, 2, НомерСтроки-1, 2).Объединить();
			ДокументРезультат.Область(НомерСтроки-ОбъединитьСтрок-1, 3, НомерСтроки-1, 3).Объединить();	
		КонецЕсли;
	КонецЕсли;
	
	РаботаСОтчетами.ЗаполнитьНастройкиПечати(ДокументРезультат, Механизм, Истина, ОриентацияСтраницы.Ландшафт);		
		
	// Фиксируем сверку
	Если ПараметрыОтбора.ФиксироватьРезультатСверки Тогда
		ОтборКлиентов = Неопределено;
		Если ПараметрыОтбора.РежимОтбора = 1 Тогда
			ОтборКлиентов = ПараметрыОтбора.СчетДоверительногоУправления;
		ИначеЕсли ПараметрыОтбора.РежимОтбора = 2 Тогда
			ОтборКлиентов = ПараметрыОтбора.ВидДеятельности;
		КонецЕсли;
		
		ЗафиксироватьРезультатыСверкиСЖурналомПодтверждений(
			ПараметрыОтбора.Период.ДатаНачала,
			ПараметрыОтбора.Период.ДатаОкончания,
			ПараметрыОтбора.Организация,
			ОтборКлиентов,
			ЭтаФорма.ВремяСверки
		);
	КонецЕсли;
	
	// Фиксируем завершение процедуры
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия);
	
	Если ВыводВОсновнойДокумент Тогда
		ЭтаФорма.АдресСКД			= ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор);
		ЭтаФорма.АдресРасшифровки	= ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);
			
		РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(Элементы.Результат, "НеИспользовать");
		
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ДокументРезультат;	
	
КонецФункции

#Область Вспомогательные_функции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДоступностьЭлементовФормы(ЭтаФорма)

	Элементы = ЭтаФорма.Элементы;		
	
	ПериодДень = (ЭтаФорма.ВидПериода = "День");
	Элементы.ГруппаПериодДатаОкончания.Видимость	= Не ПериодДень;
	Элементы.ВвестиПериод.Видимость					= Не ПериодДень;	
	
	Элементы.СчетДоверительногоУправления.Видимость	= (ЭтаФорма.РежимОтбора = 1);
	Элементы.ВидДеятельности.Видимость				= (ЭтаФорма.РежимОтбора = 2);
	Элементы.ВремяСверки.Доступность				= ЭтаФорма.ФиксироватьРезультатСверки;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииПараметровОтчета(ЭтаФорма)
	
	РаботаСФормамиКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ЭтаФорма.Элементы.Результат, "НеАктуальность");		
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоляЭлементаРасшифровки(Расшифровка = Неопределено, АдресРасшифровки = Неопределено, ВключаяРодителей = Ложь, Знач ЭлементРасшифровки = Неопределено, Знач ДанныеРасшифровки = Неопределено, ПоляЭлементаРасшифровки = Неопределено)
	
	Если ПоляЭлементаРасшифровки = Неопределено Тогда 
		ПоляЭлементаРасшифровки = Новый Структура;
	КонецЕсли;
	
	Если ДанныеРасшифровки = Неопределено Тогда 
		ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровки);
	КонецЕсли;
	
	Если ЭлементРасшифровки = Неопределено Тогда 
		ЭлементРасшифровки = ДанныеРасшифровки.Элементы[Расшифровка];
	КонецЕсли;

	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для Каждого ПолеРасшифровки Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			ПоляЭлементаРасшифровки.Вставить(ПолеРасшифровки.Поле, ПолеРасшифровки.Значение);	
		КонецЦикла;
	КонецЕсли;
	
	Если ВключаяРодителей Тогда
		Для Каждого ПолеРодителя Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
			ПолучитьПоляЭлементаРасшифровки( , , ВключаяРодителей, ПолеРодителя, ДанныеРасшифровки, ПоляЭлементаРасшифровки);	
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПоляЭлементаРасшифровки;
    
КонецФункции

&НаСервереБезКонтекста
Функция ЗарегистрироватьНовуюСессиюРаботыВнутреннихМеханизмов(Механизм, НастройкиКомпоновки, ФиксироватьРезультатСверки)
	
	ПараметрыВыполнения	= Новый Соответствие;
	Описание			= "";	
	
	Для Каждого ПараметрДанных Из НастройкиКомпоновки.ПараметрыДанных.Элементы Цикл
		Если ПараметрДанных.Использование Тогда
			ПараметрыВыполнения.Вставить(Строка(ПараметрДанных.Параметр), ПараметрДанных.Значение);
			Описание = Описание + Строка(ПараметрДанных.Параметр) + ": " + ПараметрДанных.Значение + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	
	Если ФиксироватьРезультатСверки Тогда
		ПараметрыВыполнения.Вставить("Фиксация результатов сверки", Истина);
	КонецЕсли;
	
	Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
		Механизм,
		Новый ХранилищеЗначения(ПараметрыВыполнения, Новый СжатиеДанных(9)),
		Описание
	);		

	Возврат Сессия;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗафиксироватьРезультатыСверкиСЖурналомПодтверждений(ДатаНачала, ДатаОкончания, Организация, ОтборКлиентов = Неопределено, ВремяСверки = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатыСверки = РегистрыСведений.ПодтверждениеОперацийБэкОфиса.ПолучитьРезультатыСверкиСЖурналомПодтверждений(
		ДатаНачала,
		ДатаОкончания,
		Организация,
		ОтборКлиентов
	);
	
	НачатьТранзакцию();	
	
	Для Каждого РезультатСверки Из РезультатыСверки Цикл
		РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
			РезультатСверки.Организация,
			РезультатСверки.СчетДоверительногоУправления,
			РезультатСверки.ПериодСверки,
			Справочники.ВнешниеСистемы.ЖурналПодтвержденийОпераций,
			РезультатСверки.Пройдена,
			Ложь,
			ВремяСверки
		);			
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсториюПодтверждений(Организация, СчетДоверительногоУправления, Период)
	
	ПараметрыОтбора = Новый Структура("Организация, Период, РежимОтбора, СчетДоверительногоУправления, ВидДеятельности, ТолькоНеподтвержденныеОперации, ФиксироватьРезультатСверки",
		Организация,
		Период,
		1, // по счету д/у
		СчетДоверительногоУправления,
		Неопределено,
		Ложь,
		Ложь
	);
	
	ДокументРезультат = СкомпоноватьРезультатНаСервере(ПараметрыОтбора, Истина, Ложь);
	
	Если ТипЗнч(ДокументРезультат) = Тип("ТабличныйДокумент") Тогда
		ДокументРезультат.Показать("История подтверждений операций '" + СокрЛП(СчетДоверительногоУправления) + "' за " + ПредставлениеПериода(Период.ДатаНачала, Период.ДатаОкончания)); 			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
