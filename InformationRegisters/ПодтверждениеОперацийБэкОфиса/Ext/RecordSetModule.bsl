Процедура ПередЗаписью(Отказ, Замещение)
	// Дозаполнение данных
	ТекущийПользователь	= РаботаСПользователями.ТекущийПользователь();
	ОрганизацииОпераций	= ПолучитьОрганизацииОпераций(); 
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Не ЗначениеЗаполнено(Запись.Ответственный) Тогда
			Запись.Ответственный = ТекущийПользователь;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
			ОрганизацияОперации = ОрганизацииОпераций.Найти(Запись.Операция, "Операция"); 
			Если ОрганизацияОперации <> Неопределено Тогда 
				Запись.Организация = ОрганизацияОперации.Организация;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьОрганизацииОпераций()
	
	ОрганизацииОпераций = Новый ТаблицаЗначений;
	ОрганизацииОпераций.Колонки.Добавить("Операция",		Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.Измерения.Операция.Тип);
	ОрганизацииОпераций.Колонки.Добавить("Организация",	Метаданные.РегистрыСведений.ПодтверждениеОперацийБэкОфиса.Измерения.Организация.Тип);
	
	ТипыОпераций = Новый Соответствие;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
			ТипыОпераций.Вставить(ТипЗнч(Запись.Операция), Истина); 
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ТипыОпераций) Тогда
		Возврат ОрганизацииОпераций;	
	КонецЕсли;
	
	// Формируем запрос, т.к. обращаться к реквизиту ссылки, полученной из ТЗ, без приведения к типу нельзя
	
	РеквизитОрганизация	= "ВЫБОР";
	Для Каждого ТипОперации Из Метаданные.ОпределяемыеТипы.ПодтверждаемыеОперацииБэкОфиса.Тип.Типы() Цикл
		Если ТипыОпераций.Получить(ТипОперации) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПолноеИмяОбъектаМетаданных = Метаданные.НайтиПоТипу(ТипОперации).ПолноеИмя();
		
		РеквизитОрганизация = РеквизитОрганизация + "
			|КОГДА _ПодтверждаемыеОперации.Операция ССЫЛКА " + ПолноеИмяОбъектаМетаданных + "  
			|	ТОГДА ВЫРАЗИТЬ(_ПодтверждаемыеОперации.Операция КАК " + ПолноеИмяОбъектаМетаданных + ").Организация";
	КонецЦикла;
	РеквизитОрганизация	= РеквизитОрганизация + Символы.ПС + "КОНЕЦ";
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПодтверждаемыеОперации.Операция КАК Операция
		|ПОМЕСТИТЬ _ПодтверждаемыеОперации
		|ИЗ
		|	&ПодтверждаемыеОперации КАК ПодтверждаемыеОперации
		|ГДЕ
		|	ПодтверждаемыеОперации.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ПодтверждаемыеОперации.Операция КАК Операция,
		|	&Организация КАК Организация
		|ИЗ
		|	_ПодтверждаемыеОперации КАК _ПодтверждаемыеОперации");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Организация", РеквизитОрганизация);	
	
	Запрос.УстановитьПараметр("ПодтверждаемыеОперации", ЭтотОбъект.Выгрузить(Неопределено, "Операция, Организация"));
	
	// Получаем организации 	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ОрганизацииОпераций = РезультатЗапроса.Выгрузить();
		ОрганизацииОпераций.Индексы.Добавить("Операция");
	КонецЕсли;
	
	Возврат ОрганизацииОпераций; 	
	
КонецФункции