
Процедура ПередЗаписью(Отказ, Замещение)

	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Для каждого Запись Из ЭтотОбъект Цикл
		
		Если Запись.ТочностьРасчетаСтоимостиПартий < 2 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Точность расчета стоимости партий не может быть менее двух знаков",,,, Отказ);
			Возврат;
		КонецЕсли;
		
		Если Запись.МетодПризнанияРасходовПоСделкамРЕПО = Перечисления.МетодыПризнанияРасходовПоСделкам.ВЗависимостиОтПериодичности
			И Запись.ВидУчета <> Перечисления.ВидыУчета.ЕдиныйБухгалтерскийУчет Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	НастройкиУчетаКомиссии.ВидЗадолженности КАК ВидЗадолженности,
				|	ВЫБОР
				|		КОГДА НастройкиУчетаКомиссии.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
				|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссииБрокера)
				|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии)
				|	КОНЕЦ КАК ПравильныйСчет
				|ИЗ
				|	РегистрСведений.НастройкиУчетаКомиссии.СрезПоследних(
				|			&Период,
				|			ВидУчета = &ВидУчета
				|				И Организация = &Организация
				|				И СчетДоверительногоУправления = &СчетДоверительногоУправления
				|				И ВидЗадолженности В (ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии), ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоТорговойКомиссии))) КАК НастройкиУчетаКомиссии
				|ГДЕ
				|	ВЫБОР
				|			КОГДА НастройкиУчетаКомиссии.ВидЗадолженности = ЗНАЧЕНИЕ(Справочник.ВидыЗадолженности.ПоБрокерскойКомиссии)
				|				ТОГДА НастройкиУчетаКомиссии.СчетУчета <> ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссииБрокера)
				|			ИНАЧЕ НастройкиУчетаКомиссии.СчетУчета <> ЗНАЧЕНИЕ(ПланСчетов.Основной.РасчетыПоКомиссии)
				|		КОНЕЦ";
			
			Запрос.УстановитьПараметр("ВидУчета", Запись.ВидУчета);
			Запрос.УстановитьПараметр("Период", Запись.Период);
			Запрос.УстановитьПараметр("СчетДоверительногоУправления", Запись.СчетДоверительногоУправления);
			Запрос.УстановитьПараметр("Организация", Запись.Организация);
			
			ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				ТекстСообщения = СтрШаблон("Счет Д/у: %1, на: %2, по: %3, вид: %4, cчет учета не равен %5",
					Запись.СчетДоверительногоУправления,
					Запись.Период,
					Запись.ВидУчета,
					ВыборкаДетальныеЗаписи.ВидЗадолженности,
					ВыборкаДетальныеЗаписи.ПравильныйСчет.Код);
					
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				Возврат;
			
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры
