
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого СтрокаНабора Из ЭтотОбъект Цикл
		Если ЗначениеЗаполнено(СтрокаНабора.ДатаОкончания) И СтрокаНабора.ДатаОкончания < СтрокаНабора.Период Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Дата начала должна быть меньше или равна дате окончания", ЭтотОбъект, "Запись.ДатаНачала", , Отказ);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Справочники.Сотрудники.ПроверитьНаличиеПользователяУСотрудников(ЭтотОбъект, "Замещающий", Отказ);

	Справочники.Сотрудники.ПроверитьОтветственныхНаУвольнение(ЭтотОбъект, Отказ);
	
	РегистрыСведений.ЗамещающиеСотрудники.ПроверитьЗамещающихНаВхождениеВСпискиОтветственныхЗаОперации(ЭтотОбъект, Отказ);
	
	ПроверитьПересеченияПоЗамещениям(Отказ);
	
КонецПроцедуры

// Проверяет, что нет пересечений по замещению одного пользователя
Функция ПроверитьПересеченияПоЗамещениям(Отказ)
	
	// Если записи удаляются, то проверку не выполняем
	Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат Истина;	
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗамещающиеНовогоНабора.Организация КАК Организация,
		|	_ЗамещающиеНовогоНабора.ГруппаВидовОпераций КАК ГруппаВидовОпераций,
		|	_ЗамещающиеНовогоНабора.Сотрудник КАК Сотрудник,
		|	_ЗамещающиеНовогоНабора.Замещающий КАК Замещающий,
		|	_ЗамещающиеНовогоНабора.Период КАК Период,
		|	_ЗамещающиеНовогоНабора.ДатаОкончания КАК ДатаОкончания
		|ПОМЕСТИТЬ _ЗамещающиеНовогоНабора
		|ИЗ
		|	&ЗамещающиеНовогоНабора КАК _ЗамещающиеНовогоНабора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗамещающиеСотрудники.Сотрудник КАК Сотрудник,
		|	ЗамещающиеСотрудники.Замещающий КАК Замещающий,
		|	ЗамещающиеСотрудники.Период КАК ДатаНачала,
		|	ЗамещающиеСотрудники.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.ЗамещающиеСотрудники КАК ЗамещающиеСотрудники
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ЗамещающиеНовогоНабора КАК _ЗамещающиеНовогоНабора
		|		ПО (_ЗамещающиеНовогоНабора.Организация = ЗамещающиеСотрудники.Организация)
		|			И (_ЗамещающиеНовогоНабора.ГруппаВидовОпераций = ЗамещающиеСотрудники.ГруппаВидовОпераций)
		|			И (_ЗамещающиеНовогоНабора.Сотрудник = ЗамещающиеСотрудники.Сотрудник)
		|			И (_ЗамещающиеНовогоНабора.Период <> ЗамещающиеСотрудники.Период)
		|			И (_ЗамещающиеНовогоНабора.Период <= ЗамещающиеСотрудники.ДатаОкончания
		|				ИЛИ ЗамещающиеСотрудники.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|			И (ЗамещающиеСотрудники.Период <= _ЗамещающиеНовогоНабора.ДатаОкончания
		|				ИЛИ _ЗамещающиеНовогоНабора.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|ИТОГИ ПО
		|	Сотрудник");
	Запрос.УстановитьПараметр("ЗамещающиеНовогоНабора", ЭтотОбъект.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	МассивОшибок = Новый Массив;
		
	ВыборкаПоПользователю = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоПользователю.Следующий() Цикл
		МассивЗамещений = Новый Массив;
		
		ВыборкаПоЗамещениям = ВыборкаПоПользователю.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока ВыборкаПоЗамещениям.Следующий() Цикл
			МассивЗамещений.Добавить(Строка(ВыборкаПоЗамещениям.Замещающий) + Формат(ВыборкаПоЗамещениям.ДатаНачала, "ДФ=' dd.MM.yyyy'") + Формат(ВыборкаПоЗамещениям.ДатаОкончания, "ДФ=' - dd.MM.yyyy'; ДП=' и далее'"));						
		КонецЦикла;
		
		МассивОшибок.Добавить(Строка(ВыборкаПоПользователю.Сотрудник) + " (" + СтрСоединить(МассивЗамещений, ", ") + ")");	
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Замещения пересекаются по времени: " + СтрСоединить(МассивОшибок, ", "), , , , Отказ);			
	
	Возврат Ложь;

КонецФункции
