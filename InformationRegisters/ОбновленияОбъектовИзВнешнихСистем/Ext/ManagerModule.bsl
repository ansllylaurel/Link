
Процедура ЗарегистрироватьДатуОбновления(Объект, ВнешняяСистема, Примечание = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.ОбновленияОбъектовИзВнешнихСистем.СоздатьМенеджерЗаписи();
	Запись.Объект         = Объект;
	Запись.ВнешняяСистема = ВнешняяСистема;
	Запись.Примечание     = Примечание;
	Запись.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры // ЗарегистрироватьДатуОбновления

Функция ПолучитьДатуОбновления(Объект, ВнешняяСистема) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОбновленияОбъектовИзВнешнихСистем.ДатаОбновления КАК ДатаОбновления
		|ИЗ
		|	РегистрСведений.ОбновленияОбъектовИзВнешнихСистем КАК ОбновленияОбъектовИзВнешнихСистем
		|ГДЕ
		|	ОбновленияОбъектовИзВнешнихСистем.Объект = &Объект
		|	И ОбновленияОбъектовИзВнешнихСистем.ВнешняяСистема = &ВнешняяСистема";
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("ВнешняяСистема", ВнешняяСистема);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДатаОбновления;
	Иначе
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
КонецФункции // ПолучитьДатуОбновления
