// ПРЕДОПРЕДЕЛЕННЫЕ

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ОтказДляОднойИзСтрокИстина = Ложь;

	// проверим, что выбранным значением является физическое лицо
	Для каждого ЗаписьРегистраСведений Из ЭтотОбъект Цикл
		Если ТипЗнч(ЗаписьРегистраСведений.КонтактноеЛицо) = Тип("СправочникСсылка.ЮрФизЛица") Тогда
			Если ЗаписьРегистраСведений.КонтактноеЛицо.ВидЮрФизЛица <> Перечисления.ВидыЮрФизЛиц.ФизическоеЛицо Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контактным лицом может быть только физическое лицо.",,,,Отказ);
				ОтказДляОднойИзСтрокИстина = Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Отказ = ОтказДляОднойИзСтрокИстина;

	ЭтотОбъект.ДополнительныеСвойства.Вставить("ОбработкаПроверкиЗаполненияОтказ", Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	// блокирующие проверки
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);

КонецПроцедуры
