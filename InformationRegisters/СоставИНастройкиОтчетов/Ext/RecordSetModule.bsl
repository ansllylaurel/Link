
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого Запись Из ЭтотОбъект Цикл
		
		Индекс = ЭтотОбъект.Индекс(Запись);
		
		// Настройка состава отчетов.
		Если Запись.Настройка = ПланыВидовХарактеристик.НастройкиОтчетов.Формировать
			И Запись.Приоритет <> 12
			И Запись.Приоритет <> 18
			И Запись.Приоритет <> 24 Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 настройка состава отчетов не соответствует виду настройки!", Индекс),,,,Отказ);
			Продолжить;
			
		КонецЕсли;
		
		// Субъект.
		Если Запись.Приоритет > 6 Тогда
			
			// не заполнили.
			Если НЕ ЗначениеЗаполнено(Запись.Субъект) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 не выбран субъект настройки!", Индекс),,,,Отказ);
			// должен быть клиент (ФЛ/ЮЛ/ПИФ).
			ИначеЕсли Запись.Приоритет < 19
						И ТипЗнч(Запись.Субъект) <> Тип("СправочникСсылка.ЮрФизЛица")
						И ТипЗнч(Запись.Субъект) <> Тип("СправочникСсылка.ПаевыеИнвестиционныеФонды") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 в качестве субъекта должен быть указан клиент!", Индекс),,,,Отказ);
			// должен быть договор (счет ДУ).
			ИначеЕсли Запись.Приоритет > 18
						И ТипЗнч(Запись.Субъект) <> Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 в качестве субъекта должен быть указан договор!", Индекс),,,,Отказ);
			КонецЕсли;
			
		// должен быть не заполнен.
		ИначеЕсли ЗначениеЗаполнено(Запись.Субъект) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 субъект должен быть пустым!", Индекс),,,,Отказ);
		КонецЕсли;
		
		// Вид договора.
		Если Запись.Приоритет > 12 И Запись.Приоритет < 19 Тогда
			
			// не заполнили.
			Если НЕ ЗначениеЗаполнено(Запись.ВидДоговора) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 не выбран вид договора клиента!", Индекс),,,,Отказ);
			КонецЕсли;
			
		// должен быть не заполнен.
		ИначеЕсли ЗначениеЗаполнено(Запись.ВидДоговора) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 вид договора клиента должен быть пустым!", Индекс),,,,Отказ);
		КонецЕсли;
		
		// Периодичность.
		Если Запись.Приоритет / 2  = Цел(Запись.Приоритет / 2) Тогда
			
			// не заполнили.
			Если НЕ ЗначениеЗаполнено(Запись.Периодичность) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 не выбрана периодичность!", Индекс),,,,Отказ);
			КонецЕсли;
			
		// должна быть не заполнена.
		ИначеЕсли ЗначениеЗаполнено(Запись.Периодичность) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 периодичность должна быть пустой!", Индекс),,,,Отказ);
		КонецЕсли;
		
		// Отчет.
		Если Запись.Приоритет > 2 И Запись.Приоритет < 7
			ИЛИ Запись.Приоритет > 8 И Запись.Приоритет < 13 
			ИЛИ Запись.Приоритет > 14 И Запись.Приоритет < 19
			ИЛИ Запись.Приоритет > 20 Тогда
			
			// не заполнили.
			Если НЕ ЗначениеЗаполнено(Запись.Отчет) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 не выбран отчет!", Индекс),,,,Отказ);
			ИначеЕсли (Запись.Приоритет = 2 ИЛИ Запись.Приоритет = 3
				ИЛИ Запись.Приоритет = 9 ИЛИ Запись.Приоритет = 10
				ИЛИ Запись.Приоритет = 15 ИЛИ Запись.Приоритет = 16
				ИЛИ Запись.Приоритет = 21 ИЛИ Запись.Приоритет = 22)
				И НЕ Запись.Отчет.ЭтоГруппа Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 в качестве отчета должа быть указана группа отчетов!", Индекс),,,,Отказ);
			ИначеЕсли (Запись.Приоритет = 5 ИЛИ Запись.Приоритет = 6
				ИЛИ Запись.Приоритет = 11 ИЛИ Запись.Приоритет = 12
				ИЛИ Запись.Приоритет = 17 ИЛИ Запись.Приоритет = 18
				ИЛИ Запись.Приоритет = 23 ИЛИ Запись.Приоритет = 24)
				И Запись.Отчет.ЭтоГруппа Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 в качестве отчета должен быть указан отчет, а не группа отчетов!", Индекс),,,,Отказ);
			КонецЕсли;
			
		// должен быть не заполнен.
		ИначеЕсли ЗначениеЗаполнено(Запись.Отчет) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 отчет должен быть пустым!", Индекс),,,,Отказ);
		КонецЕсли;
		
		// Значение.
		Если Запись.ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.ПоУмолчанию
			И ЗначениеЗаполнено(Запись.Значение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 выбран тип значения 'По умолчанию' и указано значение!", Индекс),,,,Отказ);
		ИначеЕсли Запись.Настройка = ПланыВидовХарактеристик.НастройкиОтчетов.Формировать
			И Запись.ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.Собственное
			И НЕ ЗначениеЗаполнено(Запись.Значение) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В строке %1 не указано значение настройки!", Индекс),,,,Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, Замещение)
	
	Если Отбор.Количество() = 0
		ИЛИ ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтключитьКонтрольИОповещения")
			И ЗначениеЗаполнено(ЭтотОбъект.ДополнительныеСвойства.ОтключитьКонтрольИОповещения)
			И ЭтотОбъект.ДополнительныеСвойства.ОтключитьКонтрольИОповещения Тогда
		Возврат;
	КонецЕсли;
	
	УниверсальныеМеханизмы.ОбъектМожноЗаписать(ЭтотОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем, что не добавлены записи, дублирующие действующие и/или будущие настройки
	#Область Проверка_дублей

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НаборЗаписей",	ЭтотОбъект.Выгрузить());
	
	Запрос.Текст =
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НаборЗаписей.Период КАК Период,
		|	НаборЗаписей.Организация КАК Организация,
		|	НаборЗаписей.Субъект КАК Субъект,
		|	НаборЗаписей.ВидДоговора КАК ВидДоговора,
		|	НаборЗаписей.Отчет КАК Отчет,
		|	НаборЗаписей.Периодичность КАК Периодичность,
		|	НаборЗаписей.Настройка КАК Настройка,
		|	НаборЗаписей.ВидЗначения КАК ВидЗначения,
		|	НаборЗаписей.Значение КАК Значение,
		|	НаборЗаписей.Приоритет КАК Приоритет
		|ПОМЕСТИТЬ _НаборЗаписей
		|ИЗ
		|	&НаборЗаписей КАК НаборЗаписей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетов.Период КАК Период,
		|	СоставИНастройкиОтчетов.Организация КАК Организация,
		|	СоставИНастройкиОтчетов.Субъект КАК Субъект,
		|	СоставИНастройкиОтчетов.ВидДоговора КАК ВидДоговора,
		|	СоставИНастройкиОтчетов.Отчет КАК Отчет,
		|	СоставИНастройкиОтчетов.Периодичность КАК Периодичность,
		|	СоставИНастройкиОтчетов.Настройка КАК Настройка,
		|	СоставИНастройкиОтчетов.ВидЗначения КАК ВидЗначения,
		|	СоставИНастройкиОтчетов.Значение КАК Значение,
		|	СоставИНастройкиОтчетов.Приоритет КАК Приоритет
		|ПОМЕСТИТЬ _ДанныеРегистра
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	(СоставИНастройкиОтчетов.Организация, СоставИНастройкиОтчетов.Субъект, СоставИНастройкиОтчетов.ВидДоговора, СоставИНастройкиОтчетов.Отчет, СоставИНастройкиОтчетов.Периодичность, СоставИНастройкиОтчетов.Настройка) В
		|			(ВЫБРАТЬ
		|				_НаборЗаписей.Организация КАК Организация,
		|				_НаборЗаписей.Субъект КАК Субъект,
		|				_НаборЗаписей.ВидДоговора КАК ВидДоговора,
		|				_НаборЗаписей.Отчет КАК Отчет,
		|				_НаборЗаписей.Периодичность КАК Периодичность,
		|				_НаборЗаписей.Настройка КАК Настройка
		|			ИЗ
		|				_НаборЗаписей КАК _НаборЗаписей)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НаборЗаписей.Период КАК Период,
		|	_НаборЗаписей.Организация КАК Организация,
		|	_НаборЗаписей.Субъект КАК Субъект,
		|	_НаборЗаписей.ВидДоговора КАК ВидДоговора,
		|	_НаборЗаписей.Отчет КАК Отчет,
		|	_НаборЗаписей.Периодичность КАК Периодичность,
		|	_НаборЗаписей.Настройка КАК Настройка,
		|	_НаборЗаписей.ВидЗначения КАК ВидЗначения,
		|	_НаборЗаписей.Значение КАК Значение,
		|	_НаборЗаписей.Приоритет КАК Приоритет,
		|	МИНИМУМ(_ДанныеРегистра.Период) КАК Дата
		|ПОМЕСТИТЬ _ДатыСледующихЗаписей
		|ИЗ
		|	_НаборЗаписей КАК _НаборЗаписей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеРегистра КАК _ДанныеРегистра
		|		ПО _НаборЗаписей.Организация = _ДанныеРегистра.Организация
		|			И _НаборЗаписей.Субъект = _ДанныеРегистра.Субъект
		|			И _НаборЗаписей.ВидДоговора = _ДанныеРегистра.ВидДоговора
		|			И _НаборЗаписей.Отчет = _ДанныеРегистра.Отчет
		|			И _НаборЗаписей.Периодичность = _ДанныеРегистра.Периодичность
		|			И _НаборЗаписей.Настройка = _ДанныеРегистра.Настройка
		|			И _НаборЗаписей.Период < _ДанныеРегистра.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_НаборЗаписей.Период,
		|	_НаборЗаписей.Организация,
		|	_НаборЗаписей.Субъект,
		|	_НаборЗаписей.ВидДоговора,
		|	_НаборЗаписей.Отчет,
		|	_НаборЗаписей.Периодичность,
		|	_НаборЗаписей.Настройка,
		|	_НаборЗаписей.ВидЗначения,
		|	_НаборЗаписей.Значение,
		|	_НаборЗаписей.Приоритет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_НаборЗаписей.Период КАК Период,
		|	_НаборЗаписей.Организация КАК Организация,
		|	_НаборЗаписей.Субъект КАК Субъект,
		|	_НаборЗаписей.ВидДоговора КАК ВидДоговора,
		|	_НаборЗаписей.Отчет КАК Отчет,
		|	_НаборЗаписей.Периодичность КАК Периодичность,
		|	_НаборЗаписей.Настройка КАК Настройка,
		|	_НаборЗаписей.ВидЗначения КАК ВидЗначения,
		|	_НаборЗаписей.Значение КАК Значение,
		|	_НаборЗаписей.Приоритет КАК Приоритет,
		|	МАКСИМУМ(_ДанныеРегистра.Период) КАК Дата
		|ПОМЕСТИТЬ _ДатыПредыдущихЗаписей
		|ИЗ
		|	_НаборЗаписей КАК _НаборЗаписей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеРегистра КАК _ДанныеРегистра
		|		ПО _НаборЗаписей.Организация = _ДанныеРегистра.Организация
		|			И _НаборЗаписей.Субъект = _ДанныеРегистра.Субъект
		|			И _НаборЗаписей.ВидДоговора = _ДанныеРегистра.ВидДоговора
		|			И _НаборЗаписей.Отчет = _ДанныеРегистра.Отчет
		|			И _НаборЗаписей.Периодичность = _ДанныеРегистра.Периодичность
		|			И _НаборЗаписей.Настройка = _ДанныеРегистра.Настройка
		|			И _НаборЗаписей.Период > _ДанныеРегистра.Период
		|
		|СГРУППИРОВАТЬ ПО
		|	_НаборЗаписей.Период,
		|	_НаборЗаписей.Организация,
		|	_НаборЗаписей.Субъект,
		|	_НаборЗаписей.ВидДоговора,
		|	_НаборЗаписей.Отчет,
		|	_НаборЗаписей.Периодичность,
		|	_НаборЗаписей.Настройка,
		|	_НаборЗаписей.ВидЗначения,
		|	_НаборЗаписей.Значение,
		|	_НаборЗаписей.Приоритет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДатыСледующихЗаписей.Период КАК Период,
		|	_ДатыСледующихЗаписей.Организация КАК Организация,
		|	_ДатыСледующихЗаписей.Субъект КАК Субъект,
		|	_ДатыСледующихЗаписей.ВидДоговора КАК ВидДоговора,
		|	_ДатыСледующихЗаписей.Отчет КАК Отчет,
		|	_ДатыСледующихЗаписей.Периодичность КАК Периодичность,
		|	_ДатыСледующихЗаписей.Настройка КАК Настройка,
		|	_ДатыСледующихЗаписей.ВидЗначения КАК ВидЗначения,
		|	_ДатыСледующихЗаписей.Значение КАК Значение,
		|	_ДатыСледующихЗаписей.Приоритет КАК Приоритет,
		|	_ДатыСледующихЗаписей.Дата КАК Дата
		|ИЗ
		|	_ДатыСледующихЗаписей КАК _ДатыСледующихЗаписей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеРегистра КАК _ДанныеРегистра
		|		ПО _ДатыСледующихЗаписей.Дата = _ДанныеРегистра.Период
		|			И _ДатыСледующихЗаписей.Организация = _ДанныеРегистра.Организация
		|			И _ДатыСледующихЗаписей.Субъект = _ДанныеРегистра.Субъект
		|			И _ДатыСледующихЗаписей.ВидДоговора = _ДанныеРегистра.ВидДоговора
		|			И _ДатыСледующихЗаписей.Отчет = _ДанныеРегистра.Отчет
		|			И _ДатыСледующихЗаписей.Периодичность = _ДанныеРегистра.Периодичность
		|			И _ДатыСледующихЗаписей.Настройка = _ДанныеРегистра.Настройка
		|			И _ДатыСледующихЗаписей.ВидЗначения = _ДанныеРегистра.ВидЗначения
		|			И _ДатыСледующихЗаписей.Значение = _ДанныеРегистра.Значение
		|			И _ДатыСледующихЗаписей.Приоритет = _ДанныеРегистра.Приоритет
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	_ДатыПредыдущихЗаписей.Период,
		|	_ДатыПредыдущихЗаписей.Организация,
		|	_ДатыПредыдущихЗаписей.Субъект,
		|	_ДатыПредыдущихЗаписей.ВидДоговора,
		|	_ДатыПредыдущихЗаписей.Отчет,
		|	_ДатыПредыдущихЗаписей.Периодичность,
		|	_ДатыПредыдущихЗаписей.Настройка,
		|	_ДатыПредыдущихЗаписей.ВидЗначения,
		|	_ДатыПредыдущихЗаписей.Значение,
		|	_ДатыПредыдущихЗаписей.Приоритет,
		|	_ДатыПредыдущихЗаписей.Дата
		|ИЗ
		|	_ДатыПредыдущихЗаписей КАК _ДатыПредыдущихЗаписей
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ДанныеРегистра КАК _ДанныеРегистра
		|		ПО _ДатыПредыдущихЗаписей.Дата = _ДанныеРегистра.Период
