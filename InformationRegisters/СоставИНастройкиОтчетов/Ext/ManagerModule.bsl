
#Область Интерфейс

// Функция - Получить состав и настройки отчетов на дату
//
//	Параметры:
//		Организация								- организация, по которой требуется получить список пакетов
//		Дата									- дата, на которую требуется получить пакеты
//		УчитываяСрокФормирования				- флаг, включающий/отключающий учет значения настройки "СрокФормирования" при получении списка отчетов на дату
//		Отбор									- структура с возможными параметрами отбора (ТекущееВремя, Лицензия, Клиенты, ВидыДоговоровДоверительногоУправления, СчетаДоверительногоУправления, Периодичность, ГруппаОтчетов, СписокОтчетов, ИсключаемыеОтчеты, Настройка, ЗначениеНастройки)
//		УникальныйИдентификаторФормы			- уникальный идентификатор, используемый для помещения значений настроек отчета во временное хранилище
//		ВсеОтчетыБезУчетаПериодичности  		- флаг для возможности получения таблицы всех формируемых отчетов без учета периодичности
//      ВыводитьСообщенияОРазницеВНастройках    - нужно ли выводить сообщения о разнице в настройках
//	Возвращаемое значение:
//	Таблица значений, содержащая список отчетов, соответствующих параметрам вызова, с колонками:
//		Субъект							- пока только счет доверительного управления, далее будут клиенты и, возможно, вид договора клиента
//		Отчет							- клиентский отчет
//		ГруппаОтчетов					- группа отчетов верхнего уровня ("Бухгалтерия УК" или "Бэк-офис УК"), которой принадлежит отчет
//		Периодичность					- периодичность предоставления отчетности
//		Дата							- отчетная дата
//		ДатаНачала						- начало периода отчета
//		ДатаОкончания					- конец периода отчета
//		ОтправляетсяПочтой				- признак того, что для отчета включена автоматическая отправка почтой
//		ВыгружаетсяВЭДО					- признак того, что для отчета включена автоматическая выгрузка в ЭДО
//		ВремяФормирования				- время, на которое назначено автоматическое форимрование отчета
//		ИмяФайла						- имя файла отчета
//		Регламентированный				- признак того, что отчет является регламентированным
//		ВалютаДокумента					- валюта документа 'Регламентирванный отчет'
//		ОтчетЗаПоследнийКвартал			- признак того, что это регламентированный очтет за последний квартал
//		ВыбраннаяФорма					- выбранная форма регламентированного отчета
//		ОшибкаВНастройках				- признак того, что не все обязательные настройки установлены
//		АдресНастроек					- адрес временного хранилища, в котором содержатся настройки отчета
//
Функция ПолучитьСоставИНастройкиОтчетовНаДату(Организация, Дата, УчитываяСрокФормирования, Отбор, УникальныйИдентификаторФормы = Неопределено, ВсеОтчетыБезУчетаПериодичности = Ложь, ВыводитьСообщенияОРазницеВНастройках = Ложь) Экспорт
	
	ДанныеОбОтчетах = Новый ТаблицаЗначений;
	
	ДанныеОбОтчетах.Колонки.Добавить("Субъект",						Новый ОписаниеТипов("СправочникСсылка.СчетаДоверительногоУправления"));
	ДанныеОбОтчетах.Колонки.Добавить("СубъектПредставление",		Новый ОписаниеТипов("Строка"));
	ДанныеОбОтчетах.Колонки.Добавить("Отчет",						Новый ОписаниеТипов("СправочникСсылка.Отчеты"));
	ДанныеОбОтчетах.Колонки.Добавить("ОтчетПредставление",			Новый ОписаниеТипов("Строка"));	
	ДанныеОбОтчетах.Колонки.Добавить("ГруппаОтчетов",				Новый ОписаниеТипов("СправочникСсылка.Отчеты"));
	ДанныеОбОтчетах.Колонки.Добавить("Периодичность",				Новый ОписаниеТипов("ПеречислениеСсылка.ПериодичностьПредоставленияОтчетности"));
	ДанныеОбОтчетах.Колонки.Добавить("Дата",						Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ДанныеОбОтчетах.Колонки.Добавить("ДатаНачала",					Новый ОписаниеТипов("Дата"));
	ДанныеОбОтчетах.Колонки.Добавить("ДатаОкончания",				Новый ОписаниеТипов("Дата"));
	ДанныеОбОтчетах.Колонки.Добавить("Регламентированный",			Новый ОписаниеТипов("Булево"));
	ДанныеОбОтчетах.Колонки.Добавить("ОтправляетсяПочтой",			Новый ОписаниеТипов("Булево"));
	ДанныеОбОтчетах.Колонки.Добавить("ВыгружаетсяВЭДО",				Новый ОписаниеТипов("Булево"));
	ДанныеОбОтчетах.Колонки.Добавить("РучнаяЗагрузкаФайловВЭДО",	Новый ОписаниеТипов("Булево"));
	ДанныеОбОтчетах.Колонки.Добавить("ВремяФормирования",			Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.Время)));
	ДанныеОбОтчетах.Колонки.Добавить("СрокФормирования",			Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	ДанныеОбОтчетах.Колонки.Добавить("ИмяФайла",					Новый ОписаниеТипов("Строка"));
	ДанныеОбОтчетах.Колонки.Добавить("ВалютаДокумента",				Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ДанныеОбОтчетах.Колонки.Добавить("ОтчетЗаПоследнийКвартал",		Новый ОписаниеТипов("Булево"));
	ДанныеОбОтчетах.Колонки.Добавить("ВыбраннаяФорма",				Новый ОписаниеТипов("Строка"));
	
	МассивТипов = Новый Массив;
	
	МассивТипов.Добавить(Тип("Строка"));
	МассивТипов.Добавить(Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки"));
	
	ДанныеОбОтчетах.Колонки.Добавить("КлючОтчета",				Новый ОписаниеТипов(МассивТипов,, Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
	ДанныеОбОтчетах.Колонки.Добавить("ОшибкаВНастройках",		Новый ОписаниеТипов("Булево"));
	ДанныеОбОтчетах.Колонки.Добавить("АдресНастроек",			Новый ОписаниеТипов("Строка"));
	
	// Вспомогательная колонка для контроля дублей отчетов с одинаковым периодом
	ДанныеОбОтчетах.Колонки.Добавить("ЕстьДублированиеПоПериоду",		Новый ОписаниеТипов("Булево"));
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация",							Организация);
	Запрос.УстановитьПараметр("Период",									КонецДня(Дата));
	Запрос.УстановитьПараметр("ТекущаяДата",							КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("УчитываяСрокФормирования",				УчитываяСрокФормирования);
	Запрос.УстановитьПараметр("ОбщиеНастройки",							РаботаСОтчетами.ПолучитьОбщиеНастройки());
	Запрос.УстановитьПараметр("ТекущееВремя",							ПолучитьЗначениеПараметраОтбора("ТекущееВремя",			Отбор));
	Запрос.УстановитьПараметр("Лицензия",								ПолучитьЗначениеПараметраОтбора("Лицензия",				Отбор));
	Запрос.УстановитьПараметр("Периодичность",							ПолучитьЗначениеПараметраОтбора("Периодичность",		Отбор));
	Запрос.УстановитьПараметр("ГруппаОтчетов",							ПолучитьЗначениеПараметраОтбора("ГруппаОтчетов",		Отбор));
	Запрос.УстановитьПараметр("Клиенты",								ПолучитьЗначениеПараметраОтбора("Клиенты",				Отбор));
	Запрос.УстановитьПараметр("ВидыДоговоров",							ПолучитьЗначениеПараметраОтбора("ВидыДоговоров",		Отбор));
	Запрос.УстановитьПараметр("Договоры",								ПолучитьЗначениеПараметраОтбора("Договоры",				Отбор));
	Запрос.УстановитьПараметр("СписокОтчетов",							ПолучитьЗначениеПараметраОтбора("СписокОтчетов",		Отбор));
	Запрос.УстановитьПараметр("ИсключаемыеОтчеты",						ПолучитьЗначениеПараметраОтбора("ИсключаемыеОтчеты",	Отбор));
	Запрос.УстановитьПараметр("Настройка",								ПолучитьЗначениеПараметраОтбора("Настройка",			Отбор));
	Запрос.УстановитьПараметр("ЗначениеНастройки",						ПолучитьЗначениеПараметраОтбора("ЗначениеНастройки",	Отбор));
	Запрос.УстановитьПараметр("ОтборПоКлиентам",						Запрос.Параметры.Клиенты			<> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоВидамДоговоров",					Запрос.Параметры.ВидыДоговоров		<> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоДоговорам",						Запрос.Параметры.Договоры			<> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоОтчетам",							Запрос.Параметры.СписокОтчетов		<> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоИсключаемымОтчетам",				Запрос.Параметры.ИсключаемыеОтчеты	<> Неопределено);
	Запрос.УстановитьПараметр("ОтборПоЗначениюНастройки",				Запрос.Параметры.Настройка			<> Неопределено);
	Запрос.УстановитьПараметр("УчитываяВремяФормирования",				Запрос.Параметры.ТекущееВремя		<> Неопределено);
	Запрос.УстановитьПараметр("ИсключитьПрошлогодниеДоговоры",			НачалоДня(Дата) 					>= Дата(Год(Дата), 4, 1));
	Запрос.УстановитьПараметр("НачалоГода", 							НачалоГода(Дата));
	Запрос.УстановитьПараметр("НачалоПрошлогоГода", 					НачалоГода(ДобавитьМесяц(Дата, -12)));	
	Запрос.УстановитьПараметр("ВсеОтчетыБезУчетаПериодичности",			ВсеОтчетыБезУчетаПериодичности);
	
	#Область Текст_запроса
	
	Запрос.Текст =
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	СчетаДоверительногоУправления.Ссылка КАК Договор,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора
		|ПОМЕСТИТЬ _ДействующиеДоговоры
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ВЫБОР
		|						КОГДА НЕ &ОтборПоДоговорам
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ СчетДоверительногоУправления В (&Договоры)
		|					КОНЕЦ
		|					И ВЫБОР
		|						КОГДА НЕ &ОтборПоВидамДоговоров
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|					КОНЕЦ) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ВЫБОР
		|				КОГДА НЕ &ОтборПоКлиентам
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ КлиентыДоверительногоУправленияСрезПоследних.Клиент В (&Клиенты)
		|			КОНЕЦ)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				Организация = &Организация
		|					И ВЫБОР
		|						КОГДА НЕ &ОтборПоДоговорам
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ СчетДоверительногоУправления В (&Договоры)
		|					КОНЕЦ
		|					И ВЫБОР
		|						КОГДА НЕ &ОтборПоВидамДоговоров
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ СчетДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|					КОНЕЦ
		|					И ВЫБОР
		|						КОГДА &Лицензия = НЕОПРЕДЕЛЕНО
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ Лицензия.ВидДеятельности В (&Лицензия)
		|					КОНЕЦ) КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|		ПО СчетаДоверительногоУправления.Ссылка = ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует)
		|ГДЕ
		|	СчетаДоверительногоУправления.Организация = &Организация
		|	И СчетаДоверительногоУправления.ДатаЗаключения <= &Период
		|	И ВЫБОР
		|			КОГДА НЕ &ОтборПоДоговорам
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ СчетаДоверительногоУправления.Ссылка В (&Договоры)
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА НЕ &ОтборПоВидамДоговоров
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоров)
		|		КОНЕЦ
		|	И (СчетаДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ ВЫБОР
		|				КОГДА &УчитываяСрокФормирования
		|					ТОГДА ВЫБОР
		|							КОГДА &ИсключитьПрошлогодниеДоговоры
		|								ТОГДА СчетаДоверительногоУправления.ДатаРасторжения >= &НачалоГода
		|							ИНАЧЕ СчетаДоверительногоУправления.ДатаРасторжения >= &НачалоПрошлогоГода
		|						КОНЕЦ
		|				ИНАЧЕ КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(СчетаДоверительногоУправления.ДатаРасторжения, ГОД, 1), ДЕНЬ) >= &Период
		|			КОНЕЦ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 50
		|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи,
		|	ДанныеКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ _РабочиеДни
		|ИЗ
		|	РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
		|			ДанныеКалендаря.Дата КАК Дата
		|		ИЗ
		|			РегистрСведений.ДанныеКалендаря КАК ДанныеКалендаря
		|		ГДЕ
		|			ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский)
		|			И ДанныеКалендаря.Дата > НАЧАЛОПЕРИОДА(&Период, ДЕНЬ)
		|			И ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|		
		|		УПОРЯДОЧИТЬ ПО
		|			ДанныеКалендаря.Дата) КАК СледующийРабочийДень
		|		ПО (ДанныеКалендаря.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И ДанныеКалендаря.Дата <= СледующийРабочийДень.Дата
		|			И (ДанныеКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный))
		|				ИЛИ ДанныеКалендаря.Дата = НАЧАЛОПЕРИОДА(&Период, ДЕНЬ))
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДанныеКалендаря.Дата УБЫВ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Дата,
		|	НомерЗаписи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ДействующиеДоговоры.Клиент КАК Субъект,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка) КАК ВидДоговора
		|ПОМЕСТИТЬ _НаборАналитикПоДействующимДоговорам
		|ИЗ
		|	_ДействующиеДоговоры КАК _ДействующиеДоговоры
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	_ДействующиеДоговоры.Клиент,
		|	_ДействующиеДоговоры.ВидДоговора
		|ИЗ
