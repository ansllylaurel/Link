		|	МАКСИМУМ(ВыгружаетсяВЭДО),
		|	МАКСИМУМ(РучнаяЗагрузкаФайловВЭДО),
		|	МАКСИМУМ(ВремяФормирования),
		|	МАКСИМУМ(СрокФормирования),
		|	МАКСИМУМ(ИмяФайла),
		|	МАКСИМУМ(ДатаРасторженияДоговора),
		|	МАКСИМУМ(Регламентированный),
		|	МАКСИМУМ(ВалютаДокумента),
		|	МАКСИМУМ(ОтчетЗаПоследнийКвартал),
		|	МАКСИМУМ(ВыбраннаяФорма),
		|	МАКСИМУМ(КлючОтчета)
		|ПО
		|	ПолеДляИтогов";
	
	#КонецОбласти
	
	ВыборкаОтчеты = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДатыРеформаций				= Новый Соответствие;
	СведенияОбОтчетахИКлиентах	= ПолучитьСведенияОбОтчетахИКлиентах("_Итоговая", Запрос);
	
	Пока ВыборкаОтчеты.Следующий() Цикл
		
		// Т.к. для разных отчетов могут быть указаны различные варианты определения начальной даты - получаем все отчеты - и 14, и 15 февраля
		
		Если (ВыборкаОтчеты.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ДваРазаВМесяц
				И НЕ КонецМесяца(ВыборкаОтчеты.ДатаОкончания) = КонецДня(ВыборкаОтчеты.ДатаОкончания))
			И ((ВыборкаОтчеты.ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета._16ЧислоМесяца
						И День(ВыборкаОтчеты.ДатаОкончания) <> 15) 
				ИЛИ (ВыборкаОтчеты.ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.СерединаМесяца
						И Месяц(ВыборкаОтчеты.ДатаОкончания) = 2 И День(ВыборкаОтчеты.ДатаОкончания) <> 14))
		Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаНачала = ПолучитьДатуНачала(Организация, Отбор, ВыборкаОтчеты, ДатыРеформаций);
		
		Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = НачалоДня(ВыборкаОтчеты.Дата);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаОтчеты.ДатаРасторженияДоговора) 
				И ВыборкаОтчеты.ДатаРасторженияДоговора < ДатаНачала Тогда
			Продолжить;
		КонецЕсли;
		
		// Свернем одинаковые отчеты с разной периодичностью и совпадающим периодом
		ЕстьДублированиеПоПериоду = Ложь;
		Если ВсеОтчетыБезУчетаПериодичности Тогда
			ЕстьДублированиеПоПериоду = ЕстьОтчетССовпадающимПериодом(ДанныеОбОтчетах, ВыборкаОтчеты, ДатаНачала);
		КонецЕсли;  		
		
		Отчет = ДанныеОбОтчетах.Добавить();
		
		ЗаполнитьЗначенияСвойств(Отчет, ВыборкаОтчеты);
		
		Отчет.ЕстьДублированиеПоПериоду = ЕстьДублированиеПоПериоду; 
		
		Отчет.ДатаНачала = ДатаНачала;
		Отчет.ИмяФайла	 = ОбработатьПутьКФайлу(Отчет.ИмяФайла, Отчет, СведенияОбОтчетахИКлиентах);
		
		// Помещаем настройки во временное хранилище
		
		ОшибкаВНастройках		= Ложь;
		МассивЗначенийНастроек	= Новый Массив;
		
		ВыборкаНастройки = ВыборкаОтчеты.Выбрать();
		
		Пока ВыборкаНастройки.Следующий() Цикл
			
			ОшибкаВЗначении =
				ВыборкаНастройки.Обязательная
				И ТипЗнч(ВыборкаНастройки.Значение) <> Тип("Число")
				И НЕ ЗначениеЗаполнено(ВыборкаНастройки.Значение);
			
			Если ВыборкаНастройки.КодНастройки = "ИмяФайла" Тогда
				Значение = Отчет.ИмяФайла;
			ИначеЕсли ВыборкаНастройки.КодНастройки = "ПутьКФайлу"
				ИЛИ ВыборкаНастройки.КодНастройки = "КаталогОтправленныхОтчетов"
				ИЛИ ВыборкаНастройки.КодНастройки = "КаталогФайловДляОтправкиПоЭДО"
				ИЛИ ВыборкаНастройки.КодНастройки = "КаталогФайловСОшибкойОтправкиПоЭДО"
				ИЛИ ВыборкаНастройки.КодНастройки = "ТемаПисьма"
			Тогда
				Значение = ОбработатьПутьКФайлу(ВыборкаНастройки.Значение, Отчет, СведенияОбОтчетахИКлиентах);
			Иначе
				Значение = ВыборкаНастройки.Значение;
			КонецЕсли;			
			
			ЗначениеНастройки = Новый Структура;
			ЗначениеНастройки.Вставить("Настройка",			ВыборкаНастройки.Настройка);
			ЗначениеНастройки.Вставить("КодНастройки",		ВыборкаНастройки.КодНастройки);
			ЗначениеНастройки.Вставить("КлючЗначения",		ВыборкаНастройки.КлючЗначения);
			ЗначениеНастройки.Вставить("Приоритет",			ВыборкаНастройки.Приоритет);
			ЗначениеНастройки.Вставить("ДатаЗначения",		ВыборкаНастройки.ДатаЗначения);
			ЗначениеНастройки.Вставить("ОшибкаВЗначении",	ОшибкаВЗначении);			
			ЗначениеНастройки.Вставить("Значение",			Значение);
			
			МассивЗначенийНастроек.Добавить(ЗначениеНастройки);
			
			Если ОшибкаВЗначении Тогда
				ОшибкаВНастройках = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Отчет.ОшибкаВНастройках = ОшибкаВНастройках;
		Отчет.АдресНастроек		= ПоместитьВоВременноеХранилище(МассивЗначенийНастроек, УникальныйИдентификаторФормы);
		
	КонецЦикла;
	
	// Теперь проверяем дубли отчетов. Если значения влияющих на результат настроек не совпадают, не удаляем отчет из таблицы
	Если ВсеОтчетыБезУчетаПериодичности Тогда 
		
		СтрокиКУдалению = Новый Массив;
		ТаблицаОтчетовСПериодами = ДанныеОбОтчетах.Скопировать();
		ТаблицаОтчетовСПериодами.Свернуть("Отчет, ДатаНачала, ДатаОкончания");
		
		Для Каждого СтрокаОтчетаСПериодом Из ТаблицаОтчетовСПериодами Цикл
			
			ДублиОтчета = ДанныеОбОтчетах.НайтиСтроки(Новый Структура("Отчет, ДатаНачала, ДатаОкончания, ЕстьДублированиеПоПериоду", СтрокаОтчетаСПериодом.Отчет, СтрокаОтчетаСПериодом.ДатаНачала, СтрокаОтчетаСПериодом.ДатаОкончания, Истина));
			
			Если ДублиОтчета.Количество() <= 1 Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьДублиОтчета(ДублиОтчета, СтрокиКУдалению, ВыводитьСообщенияОРазницеВНастройках);
			
		КонецЦикла;
		
		Для Каждого УдаляемаяСтрока Из СтрокиКУдалению Цикл			
			ДанныеОбОтчетах.Удалить(УдаляемаяСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеОбОтчетах.Колонки.Удалить("ЕстьДублированиеПоПериоду");	
	
	ДанныеОбОтчетах.Сортировать("СубъектПредставление, ОтчетПредставление, Периодичность, ДатаНачала, ДатаОкончания");
	
	Возврат ДанныеОбОтчетах;
	
КонецФункции

// Функция - Получить значение настройки отчета для договора с возможностью указания периодичности.
//	Получает актуальную настройку отчета для договора ДУ.
//
//	Параметры:
//		Период			- Дата 
//		Договор			- СправочникСсылка.СчетаДоверительногоУправления
//		Отчет			- СправочникСсылка.Отчеты|Строка - Ссылка на отчет или значение ключа отчета. Для дополнительных отчетов может быть передана строка - значение реквизита справочника ИмяОбъекта
//		Настройка		- ПланВидовХарактеристикСсылка.НастройкиОтчетов|Строка - Ссылка на настройку или значение ключа настройки
//		Периодичность	- Перечисление.ПериодичностьПредоставленияОтчетности - требуемая периодичность. Значение по умолчанию = Неопределено. Если не указана, значения настройки для конкретных периодичностей учитываться не будут.
//
//	Возвращаемое значение:
//	Характеристика.НастройкиОтчетов|Неопределено - Если значение настройки по заданным параметрам не найдено, возвращается Неопределено
//
Функция ПолучитьЗначениеНастройки(Период, Договор, Знач Отчет, Знач Настройка, Периодичность = Неопределено) Экспорт

	Если ТипЗнч(Отчет) = Тип("Строка") И Не НайтиСсылкуПоКлючу(Отчет, "Отчет") Тогда
		ВызватьИсключение "Не удалось найти отчет по переданному ключу";
	КонецЕсли;
	
	Если ТипЗнч(Настройка) = Тип("Строка") И Не НайтиСсылкуПоКлючу(Настройка, "Настройка") Тогда
		ВызватьИсключение "Не удалось найти настройку по переданному ключу";
	КонецЕсли; 
	
	ВариантОпределенияНастройкиОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "ВариантОпределенияНастройкиОтчета");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",					Период);
	Запрос.УстановитьПараметр("ДатаПолученияНастройки",	?(ВариантОпределенияНастройкиОтчета = Перечисления.ВариантыОпределенияНастроекОтчетов.НаОтчетнуюДату, Период, ТекущаяДата()));
	Запрос.УстановитьПараметр("Договор",				Договор);
	Запрос.УстановитьПараметр("Отчет",					Отчет);
	Запрос.УстановитьПараметр("Настройка",				Настройка);
	Запрос.УстановитьПараметр("Периодичность",			Периодичность);
	
	Запрос.Текст = 
	#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора,
		|	СчетаДоверительногоУправления.Ссылка КАК Договор
		|ПОМЕСТИТЬ _ДанныеДоговора
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДоговора.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	_ДанныеДоговора.ВидДоговора КАК ВидДоговора,
		|	_ДанныеДоговора.Договор КАК Договор
		|ПОМЕСТИТЬ _СтруктураДоговора
		|ИЗ
		|	_ДанныеДоговора КАК _ДанныеДоговора
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|				&Период,
		|				(Организация, СчетДоверительногоУправления) В
		|					(ВЫБРАТЬ
		|						_ДанныеДоговора.Организация КАК Организация,
		|						_ДанныеДоговора.Договор КАК Договор
		|					ИЗ
		|						_ДанныеДоговора КАК _ДанныеДоговора)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|		ПО _ДанныеДоговора.Организация = КлиентыДоверительногоУправленияСрезПоследних.Организация
		|			И _ДанныеДоговора.Договор = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&ДатаПолученияНастройки,
		|			(Организация, Субъект, ВидДоговора) В
		|					(ВЫБРАТЬ
		|						_СтруктураДоговора.Организация КАК Организация,
		|						НЕОПРЕДЕЛЕНО КАК Субъект,
		|						ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка) КАК ВидДоговора
		|					ИЗ
		|						_СтруктураДоговора КАК _СтруктураДоговора
		|			
		|					ОБЪЕДИНИТЬ ВСЕ
		|			
		|					ВЫБРАТЬ
		|						_СтруктураДоговора.Организация,
		|						_СтруктураДоговора.Клиент,
		|						ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|					ИЗ
		|						_СтруктураДоговора КАК _СтруктураДоговора
		|			
		|					ОБЪЕДИНИТЬ ВСЕ
		|			
		|					ВЫБРАТЬ
		|						_СтруктураДоговора.Организация,
		|						_СтруктураДоговора.Клиент,
		|						_СтруктураДоговора.ВидДоговора
		|					ИЗ
		|						_СтруктураДоговора КАК _СтруктураДоговора
		|			
		|					ОБЪЕДИНИТЬ ВСЕ
		|			
		|					ВЫБРАТЬ
		|						_СтруктураДоговора.Организация,
		|						_СтруктураДоговора.Договор,
		|						ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|					ИЗ
		|						_СтруктураДоговора КАК _СтруктураДоговора)
		|				И Настройка = &Настройка
		|				И (Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|					ИЛИ Отчет = ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель
		|					ИЛИ Отчет = ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель.Родитель
		|					ИЛИ Отчет = &Отчет)
		|				И (Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)
		|					ИЛИ Периодичность = &Периодичность)) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СоставИНастройкиОтчетовСрезПоследних.Приоритет УБЫВ";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Функция - Получить значение настройки отчета / группы отчетов с возможностью указания периодичности.
//	Получает актуальную настройку отчета / группы отчетов.
//
//	Параметры:
//		Отчет			- СправочникСсылка.Отчеты|Строка - Ссылка на отчет или значение ключа отчета. Для дополнительных отчетов может быть передана строка - значение реквизита справочника ИмяОбъекта
//		Настройка		- ПланВидовХарактеристикСсылка.НастройкиОтчетов|Строка - Ссылка на настройку или значение ключа настройки
//		Организация		- СправочникСсылка.Организации 
//		Период			- Дата 
//		Периодичность	- Перечисление.ПериодичностьПредоставленияОтчетности - требуемая периодичность. Значение по умолчанию = Неопределено. Если не указана, значения настройки для конкретных периодичностей учитываться не будут.
//
//	Возвращаемое значение:
//	Характеристика.НастройкиОтчетов|Неопределено - Если значение настройки по заданным параметрам не найдено, возвращается Неопределено
//
Функция ПолучитьЗначениеНастройкиОтчета(Знач Отчет, Знач Настройка, Организация, Период, Периодичность = Неопределено) Экспорт

	Если ТипЗнч(Отчет) = Тип("Строка") И Не НайтиСсылкуПоКлючу(Отчет, "Отчет") Тогда
		ВызватьИсключение "Не удалось найти отчет по переданному ключу";
	КонецЕсли;
	
	Если ТипЗнч(Настройка) = Тип("Строка") И Не НайтиСсылкуПоКлючу(Настройка, "Настройка") Тогда
		ВызватьИсключение "Не удалось найти настройку по переданному ключу";
	КонецЕсли; 	
	
	ВариантОпределенияНастройкиОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Настройка, "ВариантОпределенияНастройкиОтчета");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",			?(ВариантОпределенияНастройкиОтчета = Перечисления.ВариантыОпределенияНастроекОтчетов.НаОтчетнуюДату, Период, ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("Отчет",			Отчет);
	Запрос.УстановитьПараметр("Настройка",		Настройка);
	Запрос.УстановитьПараметр("Периодичность",	Периодичность);
	
	Запрос.Текст =
		#Область ТекстЗапроса
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Субъект = НЕОПРЕДЕЛЕНО
		|				И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				И Настройка = &Настройка
		|				И (Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|					ИЛИ Отчет = ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель
		|					ИЛИ Отчет = ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель.Родитель
		|					ИЛИ Отчет = &Отчет)
		|				И (Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)
		|					ИЛИ Периодичность = &Периодичность)) КАК СоставИНастройкиОтчетовСрезПоследних
		|ГДЕ
		|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СоставИНастройкиОтчетовСрезПоследних.Приоритет УБЫВ";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
КонецФункции

// Функция - Получить настройки отчета
// Получает актуальную настройку отчета для клиента. Если настройка для клиента не задана - будет возвращена настройка отчета
// 
// Параметры:
//  ОтчетнаяДата	- Отчетная дата. На эту дату будут получены настройки с вариантом определения НаОтчетнуюДату. Остальные настройки будут получены на текущую дату
//  Договор			- СправочникСсылка.СчетаДоверительногоУправления - 
//  Отчет			- СправочникСсылка.Отчеты|Строка - Ссылка на отчет или значение ключа отчета. Для дополнительных отчетов
//						может быть передана строка - значение реквизита справочника ИмяОбъекта
//  Периодичность	- ПеречислениеСсылка.ПериодичностьПредоставленияОтчетности. Значение по умолчанию = Неопределено.
//						Заполняется, если необходимо получить настройки пакета
//	Настройки		- Настройки, значения которых нужно получить. Если Неопределено, возвращаются все настройки.
// 
// Возвращаемое значение:
// Структура - Ключ структуры - Код элемента плана видов характеристик НастройкиОтчетов. Значение - значение соответствующей настройки
//
Функция ПолучитьНастройкиОтчета(ОтчетнаяДата, Договор, Знач Отчет, Периодичность = Неопределено, Настройки = Неопределено) Экспорт

	Если (ТипЗнч(Отчет) = Тип("Строка") Или ТипЗнч(Отчет) = Тип("СправочникСсылка.ДополнительныеОтчетыИОбработки")) И Не НайтиСсылкуПоКлючу(Отчет, "Отчет") Тогда
		ВызватьИсключение "Не удалось найти отчет по переданному ключу";
 	КонецЕсли;
	
	Если Настройки <> Неопределено Тогда
		
		ОтборПоНастройкам	= Истина;
		МассивНастроек		= Новый Массив;
		
		Для Каждого Настройка Из Настройки Цикл
			
			Если ТипЗнч(Настройка) = Тип("Строка") И НЕ НайтиСсылкуПоКлючу(Настройка, "Настройка") Тогда
				ВызватьИсключение "Не удалось найти настройку по переданному ключу";
			КонецЕсли;
			
			МассивНастроек.Добавить(Настройка);
			
		КонецЦикла;
		
	Иначе
		ОтборПоНастройкам	= Ложь;
		МассивНастроек		= Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период",				ОтчетнаяДата);
	Запрос.УстановитьПараметр("ТекущаяДата",		ТекущаяДата());
	Запрос.УстановитьПараметр("Договор",			Договор);
	Запрос.УстановитьПараметр("Отчет",				Отчет);
	Запрос.УстановитьПараметр("Периодичность",		Периодичность);
	Запрос.УстановитьПараметр("ОтборПоНастройкам",	ОтборПоНастройкам);
	Запрос.УстановитьПараметр("Настройки",			МассивНастроек);
	Запрос.УстановитьПараметр("ОбщиеНастройки",		РаботаСОтчетами.ПолучитьОбщиеНастройки());
	
	#Область ТекстЗапроса
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.Ссылка КАК Договор,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора
		|ПОМЕСТИТЬ _ДанныеДоговора
		|ИЗ
		|	Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|ГДЕ
		|	СчетаДоверительногоУправления.Ссылка = &Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДоговора.Организация КАК Организация,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	_ДанныеДоговора.ВидДоговора КАК ВидДоговора,
		|	_ДанныеДоговора.Договор КАК Договор
		|ПОМЕСТИТЬ _СтруктураДоговора
		|ИЗ
		|	_ДанныеДоговора КАК _ДанныеДоговора,
		|	РегистрСведений.КлиентыДоверительногоУправления.СрезПоследних(
		|			&Период,
		|			(Организация, СчетДоверительногоУправления) В
		|				(ВЫБРАТЬ
		|					_ДанныеДоговора.Организация КАК Организация,
		|					_ДанныеДоговора.Договор КАК Договор
		|				ИЗ
		|					_ДанныеДоговора КАК _ДанныеДоговора)) КАК КлиентыДоверительногоУправленияСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОтчетов.Ссылка КАК Настройка
		|ПОМЕСТИТЬ _ОбщиеНастройки
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НастройкиОтчетов.Ссылка В(&ОбщиеНастройки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ОбщиеНастройки.Настройка КАК Настройка
		|ПОМЕСТИТЬ _СписокНастроек
		|ИЗ
		|	_ОбщиеНастройки КАК _ОбщиеНастройки
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	НазначенияНастроекОтчетов.Настройка
		|ИЗ
		|	РегистрСведений.НазначенияНастроекОтчетов КАК НазначенияНастроекОтчетов
		|ГДЕ
		|	НазначенияНастроекОтчетов.Отчет = &Отчет
		|	И НазначенияНастроекОтчетов.Настройка <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать)
		|	И НазначенияНастроекОтчетов.Настройка.Код <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СписокНастроек.Настройка КАК Настройка,
		|	_СписокНастроек.Настройка.Код КАК Код,
		|	ЕСТЬNULL(СоставИНастройкиОтчетовСрезПоследних.Значение, НЕОПРЕДЕЛЕНО) КАК Значение,
		|	ЕСТЬNULL(СоставИНастройкиОтчетовСрезПоследних.Приоритет, 0) КАК Приоритет
		|ПОМЕСТИТЬ _ЗначенияНастроек
		|ИЗ
		|	_СписокНастроек КАК _СписокНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СоставИНастройкиОтчетовНаОтчетнуюДату.Значение КАК Значение,
		|			СоставИНастройкиОтчетовНаОтчетнуюДату.Приоритет КАК Приоритет,
		|			СоставИНастройкиОтчетовНаОтчетнуюДату.Настройка КАК Настройка,
		|			СоставИНастройкиОтчетовНаОтчетнуюДату.ВидЗначения КАК ВидЗначения
		|		ИЗ
		|			РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|					&Период,
		|					Настройка.ВариантОпределенияНастройкиОтчета = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияНастроекОтчетов.НаОтчетнуюДату)
		|						И (Организация, Субъект, ВидДоговора) В
		|							(ВЫБРАТЬ
		|								_СтруктураДоговора.Организация КАК Организация,
		|								НЕОПРЕДЕЛЕНО КАК Субъект,
		|								ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка) КАК ВидДоговора
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								_СтруктураДоговора.Организация,
		|								_СтруктураДоговора.Клиент,
		|								ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								_СтруктураДоговора.Организация,
		|								_СтруктураДоговора.Клиент,
		|								_СтруктураДоговора.ВидДоговора
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								_СтруктураДоговора.Организация,
		|								_СтруктураДоговора.Договор,
		|								ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора)
		|						И Настройка В
		|							(ВЫБРАТЬ
		|								_СписокНастроек.Настройка КАК Настройка
		|							ИЗ
		|								_СписокНастроек КАК _СписокНастроек
		|							ГДЕ
		|								ВЫБОР
		|									КОГДА &ОтборПоНастройкам
		|										ТОГДА _СписокНастроек.Настройка В (&Настройки)
		|									ИНАЧЕ ИСТИНА
		|								КОНЕЦ)
		|						И (Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|							ИЛИ ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель.Родитель = Отчет
		|							ИЛИ ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель = Отчет
		|							ИЛИ Отчет = &Отчет)
		|						И (Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)
		|							ИЛИ Периодичность = &Периодичность)) КАК СоставИНастройкиОтчетовНаОтчетнуюДату
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			СоставИНастройкиОтчетовНаДатуПредоставления.Значение,
		|			СоставИНастройкиОтчетовНаДатуПредоставления.Приоритет,
		|			СоставИНастройкиОтчетовНаДатуПредоставления.Настройка,
		|			СоставИНастройкиОтчетовНаДатуПредоставления.ВидЗначения
		|		ИЗ
		|			РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
		|					&ТекущаяДата,
		|					Настройка.ВариантОпределенияНастройкиОтчета = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияНастроекОтчетов.НаДатуПредоставления)
		|						И (Организация, Субъект, ВидДоговора) В
		|							(ВЫБРАТЬ
		|								_СтруктураДоговора.Организация КАК Организация,
		|								НЕОПРЕДЕЛЕНО КАК Субъект,
		|								ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка) КАК ВидДоговора
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								_СтруктураДоговора.Организация,
		|								_СтруктураДоговора.Клиент,
		|								ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								_СтруктураДоговора.Организация,
		|								_СтруктураДоговора.Клиент,
		|								_СтруктураДоговора.ВидДоговора
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора
		|					
		|							ОБЪЕДИНИТЬ ВСЕ
		|					
		|							ВЫБРАТЬ
		|								_СтруктураДоговора.Организация,
		|								_СтруктураДоговора.Договор,
		|								ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|							ИЗ
		|								_СтруктураДоговора КАК _СтруктураДоговора)
		|						И Настройка В
		|							(ВЫБРАТЬ
		|								_СписокНастроек.Настройка КАК Настройка
		|							ИЗ
		|								_СписокНастроек КАК _СписокНастроек
		|							ГДЕ
		|								ВЫБОР
		|									КОГДА &ОтборПоНастройкам
		|										ТОГДА _СписокНастроек.Настройка В (&Настройки)
		|									ИНАЧЕ ИСТИНА
		|								КОНЕЦ)
		|						И (Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
		|							ИЛИ ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель.Родитель = Отчет
		|							ИЛИ ВЫРАЗИТЬ(&Отчет КАК Справочник.Отчеты).Родитель = Отчет
		|							ИЛИ Отчет = &Отчет)
		|						И (Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка)
		|							ИЛИ Периодичность = &Периодичность)) КАК СоставИНастройкиОтчетовНаДатуПредоставления) КАК СоставИНастройкиОтчетовСрезПоследних
		|		ПО _СписокНастроек.Настройка = СоставИНастройкиОтчетовСрезПоследних.Настройка
		|ГДЕ
		|	(СоставИНастройкиОтчетовСрезПоследних.ВидЗначения ЕСТЬ NULL
		|			ИЛИ СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное))
		|	И ВЫБОР
		|			КОГДА &ОтборПоНастройкам
		|				ТОГДА _СписокНастроек.Настройка В (&Настройки)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ЗначенияНастроек.Настройка КАК Настройка,
		|	МАКСИМУМ(_ЗначенияНастроек.Приоритет) КАК Приоритет
		|ПОМЕСТИТЬ _ПриоритетыИспользуемыхНастроек
		|ИЗ
		|	_ЗначенияНастроек КАК _ЗначенияНастроек
		|
		|СГРУППИРОВАТЬ ПО
		|	_ЗначенияНастроек.Настройка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	_ЗначенияНастроек.Код КАК Ключ,
		|	_ЗначенияНастроек.Значение КАК Значение
		|ИЗ
		|	_ЗначенияНастроек КАК _ЗначенияНастроек
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ПриоритетыИспользуемыхНастроек КАК _ПриоритетыИспользуемыхНастроек
		|		ПО _ЗначенияНастроек.Настройка = _ПриоритетыИспользуемыхНастроек.Настройка
		|			И _ЗначенияНастроек.Приоритет = _ПриоритетыИспользуемыхНастроек.Приоритет";
	#КонецОбласти
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура; 
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ключ, Выборка.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие, где ключ - приоритет настройки, а значение - строковое представление приоритета
//
Функция ПолучитьСоответствиеВидовНастроекПриоритету() Экспорт
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(1,	"Настройка организации");
	Результат.Вставить(2,	"Настройка организации с определенной периодичностью");
	Результат.Вставить(3,	"Настройка группы отчетов");
	Результат.Вставить(4,	"Настройка группы отчетов с определенной периодичностью");
	Результат.Вставить(5,	"Настройка отчета");
	Результат.Вставить(6,	"Настройка отчета с определенной периодичностью");
	Результат.Вставить(7,	"Настройка клиента");
	Результат.Вставить(8,	"Настройка клиента с определенной периодичностью");
	Результат.Вставить(9,	"Настройка группы отчетов клиента");
	Результат.Вставить(10,	"Настройка группы отчетов клиента с определенной периодичностью");
	Результат.Вставить(11,	"Настройка отчета клиента");
	Результат.Вставить(12,	"Настройка отчета клиента с определенной периодичностью");
	Результат.Вставить(13,	"Настройка вида договора клиента");
	Результат.Вставить(14,	"Настройка вида договора клиента с определенной периодичностью");
	Результат.Вставить(15,	"Настройка группы отчетов вида договора клиента");
	Результат.Вставить(16,	"Настройка группы отчетов вида договора клиента с определенной периодичностью");
	Результат.Вставить(17,	"Настройка отчета вида договора клиента");
	Результат.Вставить(18,	"Настройка отчета вида договора клиента с определенной периодичностью");
	Результат.Вставить(19,	"Настройка договора");
	Результат.Вставить(20,	"Настройка договора с определенной периодичностью");
	Результат.Вставить(21,	"Настройка группы отчетов договора");
	Результат.Вставить(22,	"Настройка группы отчетов договора с определенной периодичностью");
	Результат.Вставить(23,	"Настройка отчета договора");
	Результат.Вставить(24,	"Настройка отчета договора с определенной периодичностью");
	
	Возврат Результат;
	
КонецФункции

// Возвращает приоритет значения настройки по ключу записи
//
Функция ОпределитьПриоритетПоЗначениямКлючаЗаписи(ЗначенияКлючаЗаписи) Экспорт
	
	Результат = 0;
	
	Если ЗначенияКлючаЗаписи.Субъект = Неопределено Тогда
		Результат = 1;
	ИначеЕсли ТипЗнч(ЗначенияКлючаЗаписи.Субъект) = Тип("СправочникСсылка.СчетаДоверительногоУправления") Тогда
		Результат = 19;
	ИначеЕсли ЗначениеЗаполнено(ЗначенияКлючаЗаписи.ВидДоговора) Тогда
		Результат = 13;
	Иначе
		Результат = 7;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначенияКлючаЗаписи.Отчет) Тогда
		Если ЗначенияКлючаЗаписи.Отчет.ЭтоГруппа Тогда
			Результат = Результат + 2;
		Иначе
			Результат = Результат + 4;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначенияКлючаЗаписи.Периодичность) Тогда
		Результат = Результат + 1;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Меняет дату у записи регистра
//	Параметры:
//		ЗначенияКлючаЗаписи	- значения ключевых измерений записи
//		НоваяДата			- новая дата записи
//		ВидЗначения			- собственное или наследуемое значение (перечисление ВидыЗначенияНастроекОтчетов)
//		Значение			- значенеи настройки отчета
//		Замещение			- признак того, что можно заместить уже существующую запись с таким ключом с новой датой
//
Функция ИзменитьДатуИЗначениеНастройки(Знач ЗначенияКлючаЗаписи, НоваяДата, ВидЗначения, Значение = Неопределено, Замещение = Ложь, Примечание = "") Экспорт
	
	// Начинаем транзакцию и устанавливаем блокировки.
	НачатьТранзакцию();
	
	Если НЕ УдалитьЗапись(ЗначенияКлючаЗаписи) Тогда
		ОтменитьТранзакцию();
		
		Возврат Ложь;
	КонецЕсли;
	
	ЗначенияКлючаЗаписи.Вставить("Период", НоваяДата);
	
	Если НЕ ДобавитьЗапись(ЗначенияКлючаЗаписи, ВидЗначения, Значение, Замещение, Примечание) Тогда
		ОтменитьТранзакцию();
		
		Возврат Ложь;
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;
	
КонецФункции

// Добавляет запись в регистр по переданным параметрам
//	Параметры:
//		ЗначенияКлючаЗаписи	- значения ключевых измерений записи
//		ВидЗначения			- собственное или наследуемое значение (перечисление ВидыЗначенияНастроекОтчетов)
//		Значение			- значенеи настройки отчета
//		Замещение			- признак того, что можно заместить уже существующую запись с таким ключом
//
Функция ДобавитьЗапись(ЗначенияКлючаЗаписи, ВидЗначения, Значение = Неопределено, Замещение = Ложь, Примечание = "") Экспорт
	
	Запись = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(Запись, ЗначенияКлючаЗаписи);
	
	Запись.ВидЗначения	= ВидЗначения;
	Запись.Примечание 	= Примечание;
	
	Если ВидЗначения = Перечисления.ВидыЗначенияНастроекОтчетов.Собственное Тогда
		Запись.Значение		= Значение;		
	КонецЕсли;
	
	Запись.Приоритет = ОпределитьПриоритетПоЗначениямКлючаЗаписи(ЗначенияКлючаЗаписи);
	
	Запись.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	Попытка
		Запись.Записать(Замещение);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Удаляет запись в регистре по переданному ключу
// 
Функция УдалитьЗапись(ЗначенияКлючаЗаписи) Экспорт
	
	Запись = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(Запись, ЗначенияКлючаЗаписи);
	
	Попытка
		Запись.Удалить();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Определяет наличие в регистре записи со значениями ключа, идентичными переданным в параметре
//
Функция ПроверитьНаличиеЗаписей(ЗначенияКлючаЗаписи) Экспорт
	
	НаборЗаписей = РегистрыСведений.СоставИНастройкиОтчетов.СоздатьНаборЗаписей();
	
	Для Каждого Значение Из ЗначенияКлючаЗаписи Цикл
		НаборЗаписей.Отбор[Значение.Ключ].Установить(Значение.Значение);
	КонецЦикла;
	
	НаборЗаписей.Прочитать();
	
	Возврат НаборЗаписей.Количество() > 0;
		
КонецФункции

// Возвращает путь к файлу (каталог), построенный по шаблону на основании данных отчета
//
// Параметры:
//	Шаблон - Строка - строка-шаблон пути к файлу
//		Может иметь следующие части:
//			— %ИмяОтчета%							- Наименование отчета (Справочник.Отчеты.Наименование)
//			— %КраткоеИмяОтчета%					- Краткое наименование отчета (Справочник.Отчеты.КраткоеНаименование)
//			— %ВидДоговора%							- ДУ или НПФ
//			— %ИмяКлиента%							- Наименование счета ДУ 
//			— %ИмяКлиентаБезНПФ%					- Наименование счета ДУ без первых 4х смволов, если это "НПФ "
//			— %КраткоеНаименованиеКлиента%			- Краткое наименование клиента по уставу, либо Фамилия И.О. для физ. лиц
//			— %КраткоеНаименованиеКлиентаБезОПФ%	- То же, что и %КраткоеНаименованиеКлиента%, но без организационно-правовой формы (ОПФ), т.е. без АО, ООО, НПФ и пр.	
//			— %ИмяОрганизации%						- Наименование организации счета ДУ 
//			— %Периодичность%						- Периодичность в формате "_Ежедневные" и т.д.
// 			— %КаталогПоПериодичности%				- Каталог и подкаталог по периодичности (только для полного пути к файлу/каталогу)
//			— %Год%									- Год отчетной даты
//			— %Квартал%								- Квартал отчетной даты
//			— %Месяц%								- Месяц отчетной даты
//			— %Декада%								- Декада отчетной даты
//			— %Неделя%								- Неделя отчетной даты
//			— %День%								- День отчетной даты
//			— %ДатаНачала%							- Дата начала отчёта
//			— %ДатаОкончания%						- Дата окончания отчёта
//			— %ПредставлениеПериодичности%			- Представление периодичности для названия файла
//			— %ПредставлениеПериода%				- Представление бухгалтерского периода. См в РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода
//	ДанныеОтчета - Структура - структура данных, содержащая данные отчета
//		Обязательные поля:
//			— Субъект		- субъект отчета (пока только договор ДУ)
//			— Отчет			- ссылка на клиентский отчет
//			— Периодичность	- периодичность отчета
//			— ДатаНачала	- начало периода отчета
//			— ДатаОкончания	- конец периода отчета
//	СведенияОбОтчетахИКлиентах - Структура - структура данных, содержащая данные о клиентах и отчетах (см. функцию ПолучитьСведенияОбОтчетахИКлиентах)
//
// Возвращаемое значение:
//	ПутьКФайлу - Строка - обработанный путь к файлу
//
Функция ОбработатьПутьКФайлу(Шаблон, ДанныеОтчета, СведенияОбОтчетахИКлиентах = Неопределено) Экспорт

	Если СведенияОбОтчетахИКлиентах = Неопределено Тогда
		СведенияОбОтчетахИКлиентах = ПолучитьСведенияОбОтчетахИКлиентах(ДанныеОтчета);	
	КонецЕсли;
	
	РеквизитыОтчета = СведенияОбОтчетахИКлиентах.РеквизитыОтчетов.Найти(ДанныеОтчета.Отчет, "Отчет");
	ДанныеКлиентов	= СведенияОбОтчетахИКлиентах.ДанныеКлиентов.НайтиСтроки(Новый Структура("Субъект, ДатаОкончания", ДанныеОтчета.Субъект, ДанныеОтчета.ДатаОкончания));
	ДанныеКлиента	= ?(ДанныеКлиентов.Количество() > 0, ДанныеКлиентов[0], СведенияОбОтчетахИКлиентах.ДанныеКлиентов.СкопироватьКолонки().Добавить()); 
	
	ДатаНачала		= ДанныеОтчета.ДатаНачала;
	ДатаОкончания	= ДанныеОтчета.ДатаОкончания;
	
	Год 			= Формат(ДатаОкончания, "ДФ=yyyy");
	Квартал 		= Строка((Месяц(НачалоКвартала(ДатаОкончания)) + 2) / 3) + " квартал";
	Месяц 			= Формат(ДатаОкончания, "ДФ=MMMM");
	НачалоНедели 	= ?(ДатаНачала > НачалоНедели(ДатаОкончания), ДатаНачала, НачалоНедели(ДатаОкончания));
	КонецНедели 	= ?(КонецНедели(ДатаОкончания) > ДатаОкончания, ДатаОкончания, КонецНедели(ДатаОкончания));
	Неделя 			= Формат(НачалоНедели, "ДФ=yyyyMMdd") + "-" + Формат(КонецНедели, "ДФ=yyyyMMdd");
	День			= Формат(ДатаОкончания, "ДФ=yyyyMMdd");
	ДвеНедели		= Формат(ДатаНачала, "ДФ=yyyyMMdd") + "-" + Формат(КонецНедели, "ДФ=yyyyMMdd");
	Декада          = Декада(ДатаОкончания);
	Произвольный	= Формат(ДатаНачала, "ДФ=yyyyMMdd") + "-" + Формат(ДатаОкончания, "ДФ=yyyyMMdd");

	Если ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ДваРазаВМесяц Тогда
		ИмяПериодичности 			= "Ежемесячные";
		ПредставлениеПериодичности 	= ДвеНедели;
		КаталогПоПериодичности		= Месяц;
	ИначеЕсли ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно Тогда
		ИмяПериодичности 			= "Годовые";
		ПредставлениеПериодичности 	= Год;
		КаталогПоПериодичности 		= "";
	ИначеЕсли ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежедневно Тогда
		ИмяПериодичности 			= "Ежедневные";
		ПредставлениеПериодичности 	= День;
		КаталогПоПериодичности 		= Месяц + "\" + День;
	ИначеЕсли ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально Тогда
		ИмяПериодичности 			= "Квартальные";
		ПредставлениеПериодичности 	= Квартал;
		КаталогПоПериодичности 		= Квартал;
	ИначеЕсли ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежемесячно Тогда
		ИмяПериодичности 			= "Ежемесячные";
		ПредставлениеПериодичности 	= Месяц;
		КаталогПоПериодичности 		= Месяц;
	ИначеЕсли ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Еженедельно Тогда
		ИмяПериодичности 			= "Еженедельные";
		ПредставлениеПериодичности 	= Неделя;
		КаталогПоПериодичности 		= Месяц + "\" + Неделя;
	ИначеЕсли ДанныеОтчета.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ПоДекадам Тогда
		ИмяПериодичности 			= "Декады";
		ПредставлениеПериодичности 	= Неделя;
		КаталогПоПериодичности 		= Месяц + "\" + Декада;
	Иначе
		ИмяПериодичности			= "";
		ПредставлениеПериодичности 	= Произвольный;
		КаталогПоПериодичности 		= "";
	КонецЕсли; 
	
	// Представим наименования только основных периодов
	
	Если НачалоДня(ДатаНачала) = НачалоДня(ДатаОкончания)													// День
		ИЛИ ДатаНачала = НачалоМесяца(ДатаНачала) И КонецДня(ДатаОкончания) = КонецМесяца(ДатаНачала)		// Месяц
		ИЛИ ДатаНачала = НачалоКвартала(ДатаНачала) И КонецДня(ДатаОкончания) = КонецКвартала(ДатаНачала)	// Квартал
		ИЛИ ДатаНачала = НачалоГода(ДатаНачала) И КонецДня(ДатаОкончания) = КонецКвартала(ДатаНачала)		// Полугодие / 9 месяцев
		ИЛИ ДатаНачала = НачалоГода(ДатаНачала) И КонецДня(ДатаОкончания) = КонецГода(ДатаНачала)			// Год
	Тогда
		ПредставлениеПериода = РаботаСБухгалтерскимиОтчетамиКлиентСервер.ПолучитьПредставлениеПериода(ДатаНачала, КонецДня(ДатаОкончания));
	Иначе
		ПредставлениеПериода = " за " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + "-" + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");	
	КонецЕсли;	
	
	СтрокиЗамены = Новый Соответствие;
		
	СтрокиЗамены.Вставить("%ВидДоговора%", 						ДанныеКлиента.ВидДоговора);
	СтрокиЗамены.Вставить("%ИмяОрганизации%", 					ДанныеКлиента.НаименованиеОрганизации);
	СтрокиЗамены.Вставить("%ИмяКлиента%", 						ДанныеКлиента.Наименование);
	СтрокиЗамены.Вставить("%ИмяКлиентаБезНПФ%", 				ДанныеКлиента.НаименованиеБезНПФ);
	СтрокиЗамены.Вставить("%Год%", 								Год);
	СтрокиЗамены.Вставить("%Квартал%", 							Квартал);
	СтрокиЗамены.Вставить("%Месяц%", 							Месяц);
	СтрокиЗамены.Вставить("%Неделя%", 							Неделя);
	СтрокиЗамены.Вставить("%День%", 							День);
	СтрокиЗамены.Вставить("%Периодичность%", 					ИмяПериодичности);
	СтрокиЗамены.Вставить("%КаталогПоПериодичности%",			КаталогПоПериодичности);
	СтрокиЗамены.Вставить("%ПредставлениеПериодичности%",		ПредставлениеПериодичности);
	СтрокиЗамены.Вставить("%ПредставлениеПериода%",				ПредставлениеПериода);
	СтрокиЗамены.Вставить("%ИмяОтчета%",						РеквизитыОтчета.Наименование);
	СтрокиЗамены.Вставить("%КраткоеИмяОтчета%",					РеквизитыОтчета.КраткоеНаименование);
	СтрокиЗамены.Вставить("%НомерДоговора%", 					ДанныеКлиента.НомерДоговора);
	СтрокиЗамены.Вставить("%КраткоеНаименованиеКлиента%",		ДанныеКлиента.КраткоеНаименованиеКлиента);
	СтрокиЗамены.Вставить("%КраткоеНаименованиеКлиентаБезОПФ%",	ДанныеКлиента.КраткоеНаименованиеКлиентаБезОПФ);
	СтрокиЗамены.Вставить("%ИИС%",								ДанныеКлиента.ИИС);
	СтрокиЗамены.Вставить("%Лицензия%",							ДанныеКлиента.Лицензия);
	
	Результат = Шаблон;
	
	ЗаполнитьФорматыДаты(Результат, "%ФорматДаты_",	   СтрокиЗамены, ДатаОкончания);
	ЗаполнитьФорматыДаты(Результат, "%ТекущаяДата_",   СтрокиЗамены, ТекущаяДатаСеанса());
	ЗаполнитьФорматыДаты(Результат, "%ДатаДоговора_",  СтрокиЗамены, ДанныеКлиента.ДатаДоговора);
	ЗаполнитьФорматыДаты(Результат, "%ДатаНачала_",	   СтрокиЗамены, ДатаНачала);
	ЗаполнитьФорматыДаты(Результат, "%ДатаОкончания_", СтрокиЗамены, ДатаОкончания);
	
	Для каждого СтрокаЗамены Из СтрокиЗамены Цикл
		КлючЗамены	= СтрокаЗамены.Ключ + ?(СтрокаЗамены.Ключ = "%КаталогПоПериодичности%" И СтрокаЗамены.Значение = "", "\", ""); 
		Результат	= СтрЗаменить(Результат, КлючЗамены, СтрокаЗамены.Значение);
	КонецЦикла; 
	
	Если Лев(Результат, 2) = "\\" Тогда
		Результат = "\\" + СтрЗаменить(Сред(Результат, 3), "\\", "\");
	Иначе 
		Результат = СтрЗаменить(Результат, "\\", "\");
	КонецЕсли; 
	
	// Избавляемся от двух точек перед расширением файла
	
	ОписаниеФайла = Новый Файл(Результат); 
	
	Если ЗначениеЗаполнено(ОписаниеФайла.Расширение) Тогда
		
		ПолноеИмяБезРасширения = Лев(ОписаниеФайла.ПолноеИмя, СтрДлина(ОписаниеФайла.ПолноеИмя) - СтрДлина(ОписаниеФайла.Расширение));
		
		Пока Прав(ПолноеИмяБезРасширения, 1) = "." Цикл
			ПолноеИмяБезРасширения = Лев(ПолноеИмяБезРасширения, СтрДлина(ПолноеИмяБезРасширения) - 1);		
		КонецЦикла;
		
		Результат = ПолноеИмяБезРасширения + ОписаниеФайла.Расширение;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - получает ссылки настроек отчетов по ключам настроек
// Параметры:
//		КлючиНастроек - Массив строк, содержащий ключи настроек отчетов
// Возвращаемое значение:
//		Массив - содержит ссылки на настройки отчетов с типом ПланВидовХарактеристик.Ссылка
// Если по ключу настройка не будет найдена, вызывается исключение
// Если по ключу будет найдено больше одной настройки, вызывается исключение

Функция НастройкиПоКлючу(КлючиНастроек)
	
	Результат = Новый Массив;
	
	ТаблицаКлючей = Новый ТаблицаЗначений;
	ТаблицаКлючей.Колонки.Добавить("Ключ", Метаданные.ПланыВидовХарактеристик.НастройкиОтчетов.СтандартныеРеквизиты["Код"].Тип);
	Для Каждого Ключ Из КлючиНастроек Цикл
		НоваяСтрока = ТаблицаКлючей.Добавить();
		НоваяСтрока.Ключ = Ключ;
	КонецЦикла;	
	ТаблицаКлючей.Свернуть("Ключ");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключи", ТаблицаКлючей);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ключи.Ключ КАК Ключ
		|ПОМЕСТИТЬ _КлючиНастроек
		|ИЗ
		|	&Ключи КАК Ключи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_КлючиНастроек.Ключ КАК Ключ,
		|	МАКСИМУМ(НастройкиОтчетов.Ссылка) КАК Настройка,
		|	КОЛИЧЕСТВО(НастройкиОтчетов.Ссылка) КАК КоличествоНастроек
		|ИЗ
		|	_КлючиНастроек КАК _КлючиНастроек
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
		|		ПО _КлючиНастроек.Ключ = НастройкиОтчетов.Код
		|
		|СГРУППИРОВАТЬ ПО
		|	_КлючиНастроек.Ключ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ключ,
		|	Настройка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.КоличествоНастроек = 0 Тогда
			ВызватьИсключение СтрШаблон("Для ключа ""%1"" настройка не найдена!", Выборка.Ключ);
		ИначеЕсли Выборка.КоличествоНастроек > 1 Тогда	
			ВызватьИсключение СтрШаблон("Для ключа ""%1"" найдено более одной настройки!", Выборка.Ключ);
		Иначе
			Результат.Добавить(Выборка.Настройка);	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

// Функция - Получает значения настроек отчетов на основании списка сформированного по экземплярам отчетов
//
// 	Параметры:
// 		ДанныеОтчетов 		- Таблица значений, содержащая обязательные колонки:
//			Дата 			- дата из экземпляра отчета
//          Субъект 		- субъект из экземпляра отчета
//     		Периодичность 	- периодичность из экземпляра отчета
//         	Отчет 			- отчет из экземляра отчета
//		КлючиНастроек	    - массив, содержащий текстовые ключи настроек отчетов
//	Возвращаемое значение:
//	Таблица значений:
//			Дата 			- дата из экземпляра отчета
//          Субъект 		- субъект из экземпляра отчета
//     		Периодичность 	- периодичность из экземпляра отчета
//         	Отчет 			- отчет из экземляра отчета
//			Настройки 		- структура со значениями настроек
//
Функция ПолучитьНастройкиОтчетов(Знач ДанныеОтчетов, КлючиНастроек = Неопределено) Экспорт
	
	НастройкиПоКлючу = ?(КлючиНастроек = Неопределено, Неопределено, НастройкиПоКлючу(КлючиНастроек));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаОтчетов",    ДанныеОтчетов);
	Запрос.УстановитьПараметр("ТекущаяДата",	   ТекущаяДата());
	Запрос.УстановитьПараметр("ОтборПоНастройкам", НастройкиПоКлючу <> Неопределено);
	Запрос.УстановитьПараметр("Настройки",		   НастройкиПоКлючу);
	Запрос.УстановитьПараметр("ОбщиеНастройки",	   РаботаСОтчетами.ПолучитьОбщиеНастройки());
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Таб.Отчет КАК Справочник.Отчеты) КАК Отчет,
		|	Таб.Дата КАК ОтчетнаяДата,
		|	Таб.Субъект КАК Договор,
		|	Таб.Периодичность КАК Периодичность
		|ПОМЕСТИТЬ _ИсходныеДанныеОтчетов
		|ИЗ
		|	&ТаблицаОтчетов КАК Таб
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ИсходныеДанныеОтчетов.Отчет КАК Отчет,
		|	ВТ_ИсходныеДанныеОтчетов.Периодичность КАК Периодичность,
		|	ВТ_ИсходныеДанныеОтчетов.ОтчетнаяДата КАК ОтчетнаяДата,
		|	ВТ_ИсходныеДанныеОтчетов.Договор КАК Договор,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговора
		|ПОМЕСТИТЬ _ДанныеДоговора
		|ИЗ
		|	_ИсходныеДанныеОтчетов КАК ВТ_ИсходныеДанныеОтчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО ВТ_ИсходныеДанныеОтчетов.Договор = СчетаДоверительногоУправления.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеДоговора.Отчет КАК Отчет,
		|	_ДанныеДоговора.Периодичность КАК Периодичность,
		|	_ДанныеДоговора.ОтчетнаяДата КАК ОтчетнаяДата,
		|	_ДанныеДоговора.Организация КАК Организация,
		|	_ДанныеДоговора.Договор КАК Договор,
		|	_ДанныеДоговора.ВидДоговора КАК ВидДоговора,
		|	ЕСТЬNULL(КлиентыДоверительногоУправления1.Клиент, НЕОПРЕДЕЛЕНО) КАК Клиент
		|ПОМЕСТИТЬ _СтруктураДоговора
		|ИЗ
		|	_ДанныеДоговора КАК _ДанныеДоговора
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления1
		|		ПО _ДанныеДоговора.Организация = КлиентыДоверительногоУправления1.Организация
		|			И _ДанныеДоговора.Договор = КлиентыДоверительногоУправления1.СчетДоверительногоУправления
		|			И _ДанныеДоговора.ОтчетнаяДата >= КлиентыДоверительногоУправления1.Период
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправления2
		|		ПО (КлиентыДоверительногоУправления1.Организация = КлиентыДоверительногоУправления2.Организация)
		|			И (КлиентыДоверительногоУправления1.СчетДоверительногоУправления = КлиентыДоверительногоУправления2.СчетДоверительногоУправления)
		|			И _ДанныеДоговора.ОтчетнаяДата >= КлиентыДоверительногоУправления2.Период
		|			И (КлиентыДоверительногоУправления2.Период > КлиентыДоверительногоУправления1.Период)
		|ГДЕ
		|	КлиентыДоверительногоУправления2.Период ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОтчетов.Ссылка КАК Настройка
		|ПОМЕСТИТЬ _ОбщиеНастройки
		|ИЗ
		|	ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
		|ГДЕ
		|	НастройкиОтчетов.Ссылка В(&ОбщиеНастройки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВсеНастройки.Отчет КАК Отчет,
		|	ВсеНастройки.Настройка КАК Настройка
		|ПОМЕСТИТЬ _СписокНастроек
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_ИсходныеДанныеОтчетов.Отчет КАК Отчет,
		|		_ОбщиеНастройки.Настройка КАК Настройка
		|	ИЗ
		|		_ИсходныеДанныеОтчетов КАК ВТ_ИсходныеДанныеОтчетов,
		|		_ОбщиеНастройки КАК _ОбщиеНастройки
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ВТ_ИсходныеДанныеОтчетов.Отчет,
		|		НазначенияНастроекОтчетов.Настройка
		|	ИЗ
		|		РегистрСведений.НазначенияНастроекОтчетов КАК НазначенияНастроекОтчетов
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ _ИсходныеДанныеОтчетов КАК ВТ_ИсходныеДанныеОтчетов
		|			ПО НазначенияНастроекОтчетов.Отчет = ВТ_ИсходныеДанныеОтчетов.Отчет
		|				И (НазначенияНастроекОтчетов.Настройка <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.Формировать))
		|				И (НазначенияНастроекОтчетов.Настройка.Код <> """""""")) КАК ВсеНастройки
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтборПоНастройкам
		|				ТОГДА ВсеНастройки.Настройка В (&Настройки)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_СтруктураДоговора.Отчет КАК ВходОтчет,
		|	_СтруктураДоговора.Периодичность КАК ВходПериодичность,
		|	_СтруктураДоговора.ОтчетнаяДата КАК ВходОтчетнаяДата,
		|	_СтруктураДоговора.Договор КАК ВходДоговор,
		|	ЕСТЬNULL(СоставИНастройкиОтчетов.Настройка, ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.ПустаяСсылка)) КАК Настройка,
		|	ЕСТЬNULL(СоставИНастройкиОтчетов.Значение, НЕОПРЕДЕЛЕНО) КАК Значение,
		|	ЕСТЬNULL(СоставИНастройкиОтчетов.Приоритет, 0) КАК Приоритет
		|ПОМЕСТИТЬ _СоставНастроекСПриоритетами
		|ИЗ
		|	_СтруктураДоговора КАК _СтруктураДоговора
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СписокНастроек КАК _СписокНастроек
		|		ПО (_СписокНастроек.Отчет = _СтруктураДоговора.Отчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|		ПО (СоставИНастройкиОтчетов.Настройка = _СписокНастроек.Настройка)
		|			И (СоставИНастройкиОтчетов.Отчет = _СтруктураДоговора.Отчет.Родитель.Родитель
		|				ИЛИ СоставИНастройкиОтчетов.Отчет = _СтруктураДоговора.Отчет.Родитель
		|				ИЛИ СоставИНастройкиОтчетов.Отчет = _СтруктураДоговора.Отчет
		|				ИЛИ СоставИНастройкиОтчетов.Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка))
		|			И (СоставИНастройкиОтчетов.Периодичность = _СтруктураДоговора.Периодичность
		|				ИЛИ СоставИНастройкиОтчетов.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПустаяСсылка))
		|			И (ВЫБОР
		|				КОГДА СоставИНастройкиОтчетов.Настройка.ВариантОпределенияНастройкиОтчета = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияНастроекОтчетов.НаОтчетнуюДату)
		|					ТОГДА СоставИНастройкиОтчетов.Период <= _СтруктураДоговора.ОтчетнаяДата
		|				ИНАЧЕ СоставИНастройкиОтчетов.Период <= &ТекущаяДата
		|			КОНЕЦ)
		|			И (СоставИНастройкиОтчетов.Организация = _СтруктураДоговора.Организация)
		|			И (СоставИНастройкиОтчетов.Субъект = НЕОПРЕДЕЛЕНО
		|					И СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				ИЛИ СоставИНастройкиОтчетов.Субъект = _СтруктураДоговора.Клиент
		|					И СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
		|				ИЛИ СоставИНастройкиОтчетов.Субъект = _СтруктураДоговора.Клиент
		|					И СоставИНастройкиОтчетов.ВидДоговора = _СтруктураДоговора.ВидДоговора
		|				ИЛИ СоставИНастройкиОтчетов.Субъект = _СтруктураДоговора.Договор
		|					И СоставИНастройкиОтчетов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов2
		|		ПО (СоставИНастройкиОтчетов.Организация = СоставИНастройкиОтчетов2.Организация)
		|			И (СоставИНастройкиОтчетов.Субъект = СоставИНастройкиОтчетов2.Субъект)
		|			И (СоставИНастройкиОтчетов.ВидДоговора = СоставИНастройкиОтчетов2.ВидДоговора)
		|			И (СоставИНастройкиОтчетов.Отчет = СоставИНастройкиОтчетов2.Отчет)
		|			И (СоставИНастройкиОтчетов.Периодичность = СоставИНастройкиОтчетов2.Периодичность)
		|			И (СоставИНастройкиОтчетов.Настройка = СоставИНастройкиОтчетов2.Настройка)
		|			И (ВЫБОР
		|				КОГДА СоставИНастройкиОтчетов2.Настройка.ВариантОпределенияНастройкиОтчета = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияНастроекОтчетов.НаОтчетнуюДату)
		|					ТОГДА СоставИНастройкиОтчетов2.Период <= _СтруктураДоговора.ОтчетнаяДата
		|				ИНАЧЕ СоставИНастройкиОтчетов2.Период <= &ТекущаяДата
		|			КОНЕЦ)
		|			И (СоставИНастройкиОтчетов.Период < СоставИНастройкиОтчетов2.Период)
		|ГДЕ
		|	СоставИНастройкиОтчетов2.Период ЕСТЬ NULL
		|	И СоставИНастройкиОтчетов.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВТ_СоставНастроекСПриоритетами.ВходОтчет КАК ВходОтчет,
		|	ВТ_СоставНастроекСПриоритетами.ВходПериодичность КАК ВходПериодичность,
		|	ВТ_СоставНастроекСПриоритетами.ВходОтчетнаяДата КАК ВходОтчетнаяДата,
		|	ВТ_СоставНастроекСПриоритетами.ВходДоговор КАК ВходДоговор,
		|	ВТ_СоставНастроекСПриоритетами.Настройка КАК Настройка,
		|	ВТ_СоставНастроекСПриоритетами.Значение КАК Значение
		|ПОМЕСТИТЬ _СоставНастроек
		|ИЗ
		|	_СоставНастроекСПриоритетами КАК ВТ_СоставНастроекСПриоритетами
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СоставНастроекСПриоритетами КАК ВТ_СоставНастроекСПриоритетами1
		|		ПО ВТ_СоставНастроекСПриоритетами.ВходОтчет = ВТ_СоставНастроекСПриоритетами1.ВходОтчет
		|			И ВТ_СоставНастроекСПриоритетами.ВходПериодичность = ВТ_СоставНастроекСПриоритетами1.ВходПериодичность
		|			И ВТ_СоставНастроекСПриоритетами.ВходОтчетнаяДата = ВТ_СоставНастроекСПриоритетами1.ВходОтчетнаяДата
		|			И ВТ_СоставНастроекСПриоритетами.ВходДоговор = ВТ_СоставНастроекСПриоритетами1.ВходДоговор
		|			И ВТ_СоставНастроекСПриоритетами.Настройка = ВТ_СоставНастроекСПриоритетами1.Настройка
		|			И ВТ_СоставНастроекСПриоритетами.Приоритет < ВТ_СоставНастроекСПриоритетами1.Приоритет
		|ГДЕ
		|	ВТ_СоставНастроекСПриоритетами1.Приоритет ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ИсходныеДанныеОтчетов.Отчет КАК Отчет,
		|	ВТ_ИсходныеДанныеОтчетов.ОтчетнаяДата КАК Дата,
		|	ВТ_ИсходныеДанныеОтчетов.Договор КАК Субъект,
		|	ВТ_ИсходныеДанныеОтчетов.Периодичность КАК Периодичность,
		|	ЕСТЬNULL(_СписокНастроек.Настройка.Код, """""""") КАК Ключ,
		|	ЕСТЬNULL(ВТ_СоставНастроек.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
		|ИЗ
		|	_ИсходныеДанныеОтчетов КАК ВТ_ИсходныеДанныеОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СписокНастроек КАК _СписокНастроек
		|		ПО (_СписокНастроек.Отчет = ВТ_ИсходныеДанныеОтчетов.Отчет)
		|		ЛЕВОЕ СОЕДИНЕНИЕ _СоставНастроек КАК ВТ_СоставНастроек
		|		ПО (_СписокНастроек.Настройка = ВТ_СоставНастроек.Настройка)
		|			И ВТ_ИсходныеДанныеОтчетов.Отчет = ВТ_СоставНастроек.ВходОтчет
		|			И ВТ_ИсходныеДанныеОтчетов.ОтчетнаяДата = ВТ_СоставНастроек.ВходОтчетнаяДата
		|			И ВТ_ИсходныеДанныеОтчетов.Договор = ВТ_СоставНастроек.ВходДоговор
		|			И ВТ_ИсходныеДанныеОтчетов.Периодичность = ВТ_СоставНастроек.ВходПериодичность
		|ИТОГИ
		|	МАКСИМУМ(Ключ),
		|	МАКСИМУМ(Значение)
		|ПО
		|	Отчет,
		|	Дата,
		|	Субъект,
		|	Периодичность";
	
	Результат = ДанныеОтчетов.СкопироватьКолонки();
	Результат.Колонки.Добавить("Настройки");
	
	ВыборкаОтчет = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОтчет.Следующий() Цикл
		ВыборкаОтчетнаяДата = ВыборкаОтчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОтчетнаяДата.Следующий() Цикл
			ВыборкаДоговор = ВыборкаОтчетнаяДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаДоговор.Следующий() Цикл
				ВыборкаПериодичность = ВыборкаДоговор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаПериодичность.Следующий() Цикл
					НоваяСтрока = Результат.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПериодичность);
					
					СтруктураНастройки = Новый Структура;
					ВыборкаНастройки = ВыборкаПериодичность.Выбрать();
					Пока ВыборкаНастройки.Следующий() Цикл
						СтруктураНастройки.Вставить(ВыборкаНастройки.Ключ, ВыборкаНастройки.Значение);
					КонецЦикла;
					НоваяСтрока.Настройки = СтруктураНастройки;
				КонецЦикла;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Дополнительные_процедуры_и_функции

Функция ЕстьОтчетССовпадающимПериодом(ДанныеОбОтчетах, СтрокаВыборки, ДатаНачала)
	
	Если ДанныеОбОтчетах.Количество() = 0 Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	НайдОтчеты = ДанныеОбОтчетах.НайтиСтроки(Новый Структура("Отчет, ДатаНачала, ДатаОкончания", СтрокаВыборки.Отчет, ДатаНачала, СтрокаВыборки.ДатаОкончания));
	
	Если НайдОтчеты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Отчет Из НайдОтчеты Цикл		
		Отчет.ЕстьДублированиеПоПериоду = Истина;		
	КонецЦикла;	
	
	Возврат Истина;
	
КонецФункции

Процедура ПроверитьДублиОтчета(ДублиОтчета, СтрокиКУдалению, ВыводитьСообщенияОРазницеВНастройках)
		
	КоличествоСтрок = ДублиОтчета.Количество();
	
	МассивТаблицНастроек = Новый Массив;
	
	// Эталонная строка - строка с максимальным периодом в периодичности
	ИндексЭталоннойСтроки = 0;
	Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежедневно;
	Для Сч = 0 По КоличествоСтрок - 1 Цикл
		
		ТекущаяСтрока = ДублиОтчета[Сч];
		ТаблицаНастроек = ЗначенияНастроекВТаблицу(ТекущаяСтрока.АдресНастроек);
		
		МассивТаблицНастроек.Добавить(ТаблицаНастроек);
		
		Если НайденОтчетСБольшейПериодичностью(ТекущаяСтрока, Периодичность) Тогда
			Периодичность = ТекущаяСтрока.Периодичность;
			ИндексЭталоннойСтроки = Сч;
		КонецЕсли;
			
	КонецЦикла;
	
	// Сверяем настройки
	ЭталонныеНастройки = МассивТаблицНастроек[ИндексЭталоннойСтроки];
	
	Для Сч = 0 По КоличествоСтрок - 1 Цикл
		
		Если Сч = ИндексЭталоннойСтроки Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущиеНастройки = МассивТаблицНастроек[Сч]; 
		
		НастройкиСРазнымиЗначениями = ПолучитьНастройкиСРазнымиЗначениями(ЭталонныеНастройки, ТекущиеНастройки);
		Если Пустаястрока(НастройкиСРазнымиЗначениями) Тогда
			СтрокиКУдалению.Добавить(ДублиОтчета[Сч]);
		ИначеЕсли ВыводитьСообщенияОРазницеВНастройках Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отличаются настройки отчета '" + СокрЛП(ДублиОтчета[ИндексЭталоннойСтроки].Отчет) + "' с периодичностью '" + СокрЛП(ДублиОтчета[ИндексЭталоннойСтроки].Периодичность) + "' и '" + СокрЛП(ДублиОтчета[Сч].Периодичность) + "': " + Символы.ПС + НастройкиСРазнымиЗначениями);
		КонецЕсли;
		
	КонецЦикла;		
	
КонецПроцедуры

Функция ПолучитьНастройкиСРазнымиЗначениями(ЭталонныеНастройки, ТекущиеНастройки)
			
	// Проверяем сверткой объединенной таблицы
	ОбщаяТаблица = ЭталонныеНастройки.Скопировать();
	ОбщаяТаблица.Колонки.Добавить("Контроль", Новый ОписаниеТипов("Число"));
	ОбщаяТаблица.ЗаполнитьЗначения(1, "Контроль");
	
	Для Каждого ТекущаяСтрока Из ТекущиеНастройки Цикл
		НоваяСтрока = ОбщаяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		НоваяСтрока.Контроль = 1;
	КонецЦикла;
	
	ОбщаяТаблица.Свернуть("Настройка, Значение", "Контроль");
	
	Результат = Новый Массив;
	СтрокиОтличий = ОбщаяТаблица.НайтиСтроки(Новый Структура("Контроль", 1));
	Для Каждого СтрокаОтличий Из СтрокиОтличий Цикл
		РаботаСКоллекциями.ДополнитьМассив(Результат, СтрокаОтличий.Настройка, Истина);
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, ", ");
	
КонецФункции

Функция НайденОтчетСБольшейПериодичностью(СтрокаОтчета, Периодичность)

	МассивПериодичности = Новый Массив;
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно);	
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально);
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.Ежемесячно);
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.ДваРазаВМесяц);
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.ПоДекадам);
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.Еженедельно);
	МассивПериодичности.Добавить(Перечисления.ПериодичностьПредоставленияОтчетности.Ежедневно);  	
	
	Для Каждого ЗначениеПеречисления Из МассивПериодичности Цикл
		
		Если СтрокаОтчета.Периодичность = ЗначениеПеречисления И СтрокаОтчета.Периодичность <> Периодичность Тогда
			Возврат Истина;
		ИначеЕсли СтрокаОтчета.Периодичность = Периодичность Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЗначенияНастроекВТаблицу(АдресНастроек)
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("Настройка", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.НастройкиОтчетов"));
	ТаблицаНастроек.Колонки.Добавить("Значение");
	
	Настройки = ПолучитьИзВременногоХранилища(АдресНастроек);
			
	Для Каждого Настройка Из Настройки Цикл
		
		// В таблицу вносим только настройки, влияющие на результат, и настройки без ошибок в значении
		Если Настройка.КодНастройки = "РучнаяЗагрузкаФайловВЭДО" 			
			Или Настройка.КодНастройки = "АвтоматическаяВыгрузкаВЭДО"
			Или Настройка.КодНастройки = "АвтоматическаяОтправка"
			Или Настройка.КодНастройки = "ВариантПолученияКонечнойДатыПриЕженедФормировании"
			Или Настройка.КодНастройки = "ВариантОпределенияНачальнойДаты"
			Или Настройка.КодНастройки = "ВремяФормирования"			
			Или Настройка.КодНастройки = "СрокФормирования" 
			Или Настройка.КодНастройки = "АдресОтправителя"			
			Или Настройка.КодНастройки = "АдресЭлектроннойПочтыБухгалтерии"
			Или Настройка.КодНастройки = "АдресЭлектроннойПочтыБэкОфиса"
			Или Настройка.КодНастройки = "МаксимальныйСуммарныйРазмерфайловПисьма"
			Или Настройка.КодНастройки = "ОтправлятьОтчетВСоставеПакета" 			
			Или Настройка.КодНастройки = "ВыгружатьОтчетВСоставеПакета" 			
			Или Настройка.КодНастройки = "МаксимальныйРазмерФайлаДляВыгрузкиВЭДО"
			Или Настройка.КодНастройки = "РучнаяЗагрузкаФайловВЭДО" 
			Или Настройка.ОшибкаВЗначении Тогда
			
			Продолжить;
				
		КонецЕсли;
		
		НоваяСтрока = ТаблицаНастроек.Добавить();
				
		НоваяСтрока.Настройка		= Настройка.Настройка;
		НоваяСтрока.Значение		= Настройка.Значение;
				
	КонецЦикла;
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Процедура ПоместитьНастройкиОтчетовВМенеджерВременныхТаблицЗапроса(Запрос, УчитываяСрокФормирования)
	
	// Получение настроек с вариантом НаОтчетнуюДату:
	// Если не учитывается срок формирования, то период в параметрах запроса - это отчетная дата (т. е. получаем срезом последних);
	// иначе отчетную дату каждого отчета требуется получать отдельно в зависимости от периодичности и срока формирования
	Если УчитываяСрокФормирования Тогда
		
		#Область Учитывая_срок_формирования
		
		// Получаем сроки формирования и таблицу всех отчетов с настройкой Формировать = Истина.
		// Для этой таблицы определяем отчетные даты. Далее применяем отчетные даты для получения всех настроек с вариантом НаОтчетнуюДату		
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(&Период, ДЕНЬ) КАК ТекущаяДата,
			|	СоставИНастройкиОтчетовСрезПоследних.Период КАК Период,
			|	СоставИНастройкиОтчетовСрезПоследних.Организация КАК Организация,
			|	СоставИНастройкиОтчетовСрезПоследних.Субъект КАК Субъект,
			|	СоставИНастройкиОтчетовСрезПоследних.ВидДоговора КАК ВидДоговора,
			|	СоставИНастройкиОтчетовСрезПоследних.Периодичность КАК Периодичность,
			|	СоставИНастройкиОтчетовСрезПоследних.Настройка КАК Настройка,
			|	СоставИНастройкиОтчетовСрезПоследних.Значение КАК Значение,
			|	СоставИНастройкиОтчетовСрезПоследних.Отчет КАК Отчет,
			|	СоставИНастройкиОтчетовСрезПоследних.Приоритет КАК Приоритет
			|ПОМЕСТИТЬ _ДействующиеСрокиФормирования
			|ИЗ
			|	РегистрСведений.СоставИНастройкиОтчетов.СрезПоследних(
			|			&ТекущаяДата,
			|			Организация = &Организация
			|				И Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.СрокФормирования)
			|				И (Субъект = НЕОПРЕДЕЛЕНО
			|					ИЛИ (Субъект, ВидДоговора) В
			|						(ВЫБРАТЬ
			|							_НаборАналитикПоДействующимДоговорам.Субъект,
			|							_НаборАналитикПоДействующимДоговорам.ВидДоговора
			|						ИЗ
			|							_НаборАналитикПоДействующимДоговорам))) КАК СоставИНастройкиОтчетовСрезПоследних
			|ГДЕ
			|	СоставИНастройкиОтчетовСрезПоследних.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
			|";
		
		Запрос.Выполнить();
		
		ПараметрыЗапроса = Новый Структура();
	    ПараметрыЗапроса.Вставить("Организация", 					Запрос.Параметры.Организация);
		ПараметрыЗапроса.Вставить("ТекущаяДата", 					Запрос.Параметры.ТекущаяДата);
		
		ПараметрыЗапроса.Вставить("Настройка", 	ПланыВидовХарактеристик.НастройкиОтчетов.Формировать);
		ПоместитьЗначенияНастройкиВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ПараметрыЗапроса, "_НастройкаФормировать");
		
		ПараметрыЗапроса.Вставить("Настройка", 	ПланыВидовХарактеристик.НастройкиОтчетов.УчетКалендарныхДнейПриЕжедневномФормировании);
		ПоместитьЗначенияНастройкиВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ПараметрыЗапроса, "_НастройкаУчетКалендарныхДнейПриЕжедневномФормировании");
		
		ПараметрыЗапроса.Вставить("Настройка", 	ПланыВидовХарактеристик.НастройкиОтчетов.ВариантПолученияКонечнойДатыПриЕженедФормировании);		
		ПоместитьЗначенияНастройкиВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ПараметрыЗапроса, "_НастройкаВариантПолученияКонечнойДатыПриЕженедельномФормировании");
		
		ПараметрыЗапроса.Вставить("Настройка", 	ПланыВидовХарактеристик.НастройкиОтчетов.УчитыватьНачалоИКонецМесяцаПриЕженедФормировании);
		ПоместитьЗначенияНастройкиВМенеджерВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, ПараметрыЗапроса, "_НастройкаУчетНачалаИКонцаМесяцаПриЕженедельномФормировании");
		
		Запрос.Текст = 		
		    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		    |	_НастройкаФормировать.Период КАК Период,
		    |	_НастройкаФормировать.Организация КАК Организация,
		    |	_НастройкаФормировать.ВидДоговора КАК ВидДоговора,
		    |	_НастройкаФормировать.Отчет КАК Отчет,
		    |	_НастройкаФормировать.Периодичность КАК Периодичность,
		    |	_НастройкаФормировать.Настройка КАК Настройка,
