		|		ПО _СоставОтчетов.Договор = _ЗначенияНастройкиВариантОпределенияНачальнойДаты.Договор
		|			И _СоставОтчетов.Отчет = _ЗначенияНастройкиВариантОпределенияНачальнойДаты.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначенияНастройкиВариантОпределенияНачальнойДаты.Периодичность
		|			И (_ЗначенияНастройкиВариантОпределенияНачальнойДаты.КодНастройки = ""ВариантОпределенияНачальнойДаты"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначенияНастройкиВремяФормирования
		|		ПО _СоставОтчетов.Договор = _ЗначенияНастройкиВремяФормирования.Договор
		|			И _СоставОтчетов.Отчет = _ЗначенияНастройкиВремяФормирования.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначенияНастройкиВремяФормирования.Периодичность
		|			И (_ЗначенияНастройкиВремяФормирования.КодНастройки = ""ВремяФормирования"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначенияНастройкиИмяФайла
		|		ПО _СоставОтчетов.Договор = _ЗначенияНастройкиИмяФайла.Договор
		|			И _СоставОтчетов.Отчет = _ЗначенияНастройкиИмяФайла.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначенияНастройкиИмяФайла.Периодичность
		|			И (_ЗначенияНастройкиИмяФайла.КодНастройки = ""ИмяФайла"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначенияНастройкиАвтоматическаяОтправка
		|		ПО _СоставОтчетов.Договор = _ЗначенияНастройкиАвтоматическаяОтправка.Договор
		|			И _СоставОтчетов.Отчет = _ЗначенияНастройкиАвтоматическаяОтправка.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначенияНастройкиАвтоматическаяОтправка.Периодичность
		|			И (_ЗначенияНастройкиАвтоматическаяОтправка.КодНастройки = ""АвтоматическаяОтправка"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначенияНастройкиАвтоматическаяВыгрузкаВЭДО
		|		ПО _СоставОтчетов.Договор = _ЗначенияНастройкиАвтоматическаяВыгрузкаВЭДО.Договор
