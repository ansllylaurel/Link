Процедура ПоместитьСоставОтчетовВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл                         		
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;	
	
	Запрос.Текст = 
    	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
    	|	_СписокНастроек.Организация КАК Организация,
    	|	_СписокНастроек.Клиент КАК Клиент,
    	|	_СписокНастроек.ВидДоговора КАК ВидДоговора,
    	|	_СписокНастроек.Договор КАК Договор,
    	|	_СписокНастроек.Отчет КАК Отчет,
    	|	_СписокНастроек.Периодичность КАК Периодичность,
    	|	_СписокНастроек.Настройка КАК Настройка,
    	|	ЕСТЬNULL(_ДанныеРегистра.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК ПериодНастройки,
    	|	ЕСТЬNULL(_ДанныеРегистра.Значение, НЕОПРЕДЕЛЕНО) КАК Значение,
    	|	ЕСТЬNULL(_ДанныеРегистра.Приоритет, 0) КАК Приоритет
    	|ПОМЕСТИТЬ _НастройкиОтчетов
    	|ИЗ
    	|	_СписокНастроек КАК _СписокНастроек
    	|		ЛЕВОЕ СОЕДИНЕНИЕ _ДанныеРегистра КАК _ДанныеРегистра
    	|		ПО _СписокНастроек.Настройка = _ДанныеРегистра.Настройка
    	|			И (_ДанныеРегистра.Субъект = НЕОПРЕДЕЛЕНО
    	|				ИЛИ _СписокНастроек.Клиент = _ДанныеРегистра.Субъект
    	|					И _ДанныеРегистра.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровДоверительногоУправления.ПустаяСсылка)
    	|				ИЛИ _СписокНастроек.Клиент = _ДанныеРегистра.Субъект
    	|					И _СписокНастроек.ВидДоговора = _ДанныеРегистра.ВидДоговора
    	|				ИЛИ _СписокНастроек.Договор = _ДанныеРегистра.Субъект)
    	|			И (_ДанныеРегистра.Отчет = ЗНАЧЕНИЕ(Справочник.Отчеты.ПустаяСсылка)
    	|				ИЛИ ВЫБОР
