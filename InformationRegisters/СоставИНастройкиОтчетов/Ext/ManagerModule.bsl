		|				И ТИПЗНАЧЕНИЯ(_ЗначенияНастройкиВыбраннаяФорма1ФС.Значение) = ТИП(Справочник.ЗначенияНастроекОтчетов)
		|			ТОГДА _ЗначенияНастройкиВыбраннаяФорма1ФС.КлючЗначения
		|		КОГДА ТИПЗНАЧЕНИЯ(_ЗначенияНастройкиВыбраннаяФорма.Значение) = ТИП(Справочник.ЗначенияНастроекОтчетов)
