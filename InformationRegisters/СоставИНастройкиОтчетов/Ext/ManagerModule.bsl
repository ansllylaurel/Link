		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначенияНастройкиВыбраннаяФорма1ФС
		|		ПО (_СоставОтчетов.Регламентированный)
		|			И _СоставОтчетов.Договор = _ЗначенияНастройкиВыбраннаяФорма1ФС.Договор
		|			И _СоставОтчетов.Отчет = _ЗначенияНастройкиВыбраннаяФорма1ФС.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначенияНастройкиВыбраннаяФорма1ФС.Периодичность
		|			И (_ЗначенияНастройкиВыбраннаяФорма1ФС.КодНастройки = ""ВыбраннаяФорма1ФС"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначенияНастройкиСрокФормирования
		|		ПО _СоставОтчетов.Договор = _ЗначенияНастройкиСрокФормирования.Договор
		|			И _СоставОтчетов.Отчет = _ЗначенияНастройкиСрокФормирования.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначенияНастройкиСрокФормирования.Периодичность
		|			И (_ЗначенияНастройкиСрокФормирования.КодНастройки = ""СрокФормирования"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначениеНастройкиРучнаяЗагрузкаФайловВЭДО
		|		ПО _СоставОтчетов.Договор = _ЗначениеНастройкиРучнаяЗагрузкаФайловВЭДО.Договор
		|			И _СоставОтчетов.Отчет = _ЗначениеНастройкиРучнаяЗагрузкаФайловВЭДО.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначениеНастройкиРучнаяЗагрузкаФайловВЭДО.Периодичность
		|			И (_ЗначениеНастройкиРучнаяЗагрузкаФайловВЭДО.КодНастройки = ""РучнаяЗагрузкаФайловВЭДО"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначениеНастройкиУчитыватьНачалоИКонецМесяцаПриЕженедельномФормировании
		|		ПО _СоставОтчетов.Договор = _ЗначениеНастройкиУчитыватьНачалоИКонецМесяцаПриЕженедельномФормировании.Договор
		|			И _СоставОтчетов.Отчет = _ЗначениеНастройкиУчитыватьНачалоИКонецМесяцаПриЕженедельномФормировании.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначениеНастройкиУчитыватьНачалоИКонецМесяцаПриЕженедельномФормировании.Периодичность
		|			И (_ЗначениеНастройкиУчитыватьНачалоИКонецМесяцаПриЕженедельномФормировании.КодНастройки = ""УчитыватьНачалоИКонецМесяцаПриЕженедФормировании"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастроек КАК _ЗначениеНастройкиФормироватьЕслиКонецПериодаСПонедельникаПоСреду
		|		ПО _СоставОтчетов.Договор = _ЗначениеНастройкиФормироватьЕслиКонецПериодаСПонедельникаПоСреду.Договор
		|			И _СоставОтчетов.Отчет = _ЗначениеНастройкиФормироватьЕслиКонецПериодаСПонедельникаПоСреду.Отчет
		|			И _СоставОтчетов.Периодичность = _ЗначениеНастройкиФормироватьЕслиКонецПериодаСПонедельникаПоСреду.Периодичность
		|			И (_ЗначениеНастройкиФормироватьЕслиКонецПериодаСПонедельникаПоСреду.КодНастройки = ""ФормироватьЕслиКонецПериодаСПонедельникаПоСреду"")
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеКалендаря КАК КонецПериодаРабочийДень
		|		ПО (КонецПериодаРабочийДень.Календарь = ЗНАЧЕНИЕ(Справочник.Календари.Общероссийский))
		|			И (НАЧАЛОПЕРИОДА(_СоставОтчетов.ДатаОкончания, ДЕНЬ) = КонецПериодаРабочийДень.Дата)
		|			И (КонецПериодаРабочийДень.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейКалендаря.Предпраздничный)))
		|ГДЕ
		|	(НЕ &ОтборПоЗначениюНастройки
