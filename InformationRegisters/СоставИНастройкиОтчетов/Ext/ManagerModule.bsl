		|				И (КВАРТАЛ(_СоставОтчетов.Дата) = 1
		|					ИЛИ КВАРТАЛ(_СоставОтчетов.Дата) = 4))
		|	И ВЫБОР
		|			КОГДА ЕСТЬNULL(_ЗначениеНастройкиФормироватьЕслиКонецПериодаСПонедельникаПоСреду.Значение, ЛОЖЬ) = ИСТИНА
		|				ТОГДА КонецПериодаРабочийДень.Дата ЕСТЬ НЕ NULL 
		|						И ДЕНЬНЕДЕЛИ(_СоставОтчетов.ДатаОкончания) В (1, 2, 3)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
