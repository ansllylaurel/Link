    	|			И (УчетНачалаИКонцаМесяцаПриЕженедельномФормировании.Отчет = _ОтчетныеДаты.Отчет)
    	|			И (УчетНачалаИКонцаМесяцаПриЕженедельномФормировании.Периодичность = _ОтчетныеДаты.Периодичность)
    	|			И (УчетНачалаИКонцаМесяцаПриЕженедельномФормировании.Настройка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.НастройкиОтчетов.УчитыватьНачалоИКонецМесяцаПриЕженедФормировании))
    	|			И (_ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.Еженедельно))
    	|ГДЕ
    	|	(&ВсеОтчетыБезУчетаПериодичности
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.Ежедневно)
    	|				И (_ОтчетныеДаты.РабочийДень
    	|					ИЛИ УчетКалендарныхДнейПриЕжедневномФормировании.Значение = ЗНАЧЕНИЕ(Перечисление.ВариантыУчетаКалендарныхДней.ВсеДни)
    	|					ИЛИ УчетКалендарныхДнейПриЕжедневномФормировании.Значение = ЗНАЧЕНИЕ(Перечисление.ВариантыУчетаКалендарныхДней.ТолькоРабочиеДниИКонецМесяца)
    	|						И _ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, МЕСЯЦ))
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.Еженедельно)
    	|				И ВЫБОР
    	|					КОГДА ЕСТЬNULL(УчетНачалаИКонцаМесяцаПриЕженедельномФормировании.Значение, ЛОЖЬ) = ИСТИНА
    	|							И НЕДЕЛЯ(_ОтчетныеДаты.ОтчетнаяДата) = НЕДЕЛЯ(КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, МЕСЯЦ))
    	|						ТОГДА КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, ДЕНЬ) = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, МЕСЯЦ)
    	|					КОГДА ВариантОпределенияКонечнойДатыПриЕженедельномФормировании.Значение = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияКонечнойДатыОтчета.ПоследнийРабочийДень)
    	|						ТОГДА _ОтчетныеДаты.РабочийДень
    	|								И _ОтчетныеДаты.СледующийРабочийДень > КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, НЕДЕЛЯ)
    	|					КОГДА ВариантОпределенияКонечнойДатыПриЕженедельномФормировании.Значение = ЗНАЧЕНИЕ(Перечисление.ВариантыОпределенияКонечнойДатыОтчета.Среда)
    	|						ТОГДА ДЕНЬНЕДЕЛИ(_ОтчетныеДаты.ОтчетнаяДата) = 3
    	|					ИНАЧЕ _ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, НЕДЕЛЯ)
    	|				КОНЕЦ
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ДваРазаВМесяц)
    	|				И (_ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, МЕСЯЦ)
    	|					ИЛИ МЕСЯЦ(_ОтчетныеДаты.ОтчетнаяДата) = 2
    	|						И ДЕНЬ(_ОтчетныеДаты.ОтчетнаяДата) = 14
    	|					ИЛИ ДЕНЬ(_ОтчетныеДаты.ОтчетнаяДата) = 15)
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.Ежемесячно)
    	|				И _ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, МЕСЯЦ)
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.Ежеквартально)
    	|				И _ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, КВАРТАЛ)
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.Ежегодно)
    	|				И _ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, ГОД)
    	|			ИЛИ _ОтчетныеДаты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьПредоставленияОтчетности.ПоДекадам)
    	|				И (_ОтчетныеДаты.ОтчетнаяДата = КОНЕЦПЕРИОДА(_ОтчетныеДаты.ОтчетнаяДата, МЕСЯЦ)
    	|					ИЛИ ДЕНЬ(_ОтчетныеДаты.ОтчетнаяДата) = 10
    	|					ИЛИ ДЕНЬ(_ОтчетныеДаты.ОтчетнаяДата) = 20))
    	|	И ВЫБОР
    	|			КОГДА &УчитываяВремяФормирования
    	|				ТОГДА _ВремяФормирования.Значение <> ДАТАВРЕМЯ(1, 1, 1)
    	|						И _ВремяФормирования.Значение <= &ТекущееВремя
    	|			ИНАЧЕ ИСТИНА
    	|		КОНЕЦ";	
	
	Запрос.Выполнить();	
	
КонецПроцедуры

Процедура ПоместитьЗначенияНастройкиВМенеджерВременныхТаблиц(МенеджерВременныхТаблиц, ПараметрыЗапроса, ИмяТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл                         		
		Запрос.УстановитьПараметр(ПараметрЗапроса.Ключ, ПараметрЗапроса.Значение);
	КонецЦикла;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставИНастройкиОтчетов.Период КАК Период,
		|	СоставИНастройкиОтчетов.Организация КАК Организация,
		|	СоставИНастройкиОтчетов.ВидДоговора КАК ВидДоговора,
		|	СоставИНастройкиОтчетов.Отчет КАК Отчет,
		|	СоставИНастройкиОтчетов.Периодичность КАК Периодичность,
		|	СоставИНастройкиОтчетов.Настройка КАК Настройка,
		|	СоставИНастройкиОтчетов.Значение КАК Значение,
		|	СоставИНастройкиОтчетов.Субъект КАК Субъект,
		|	СоставИНастройкиОтчетов.Приоритет КАК Приоритет,
		|	СоставИНастройкиОтчетов.ВидЗначения КАК ВидЗначения
		|ПОМЕСТИТЬ _ЗначенияНастройки_БезОтбора
		|ИЗ
		|	РегистрСведений.СоставИНастройкиОтчетов КАК СоставИНастройкиОтчетов
		|ГДЕ
		|	СоставИНастройкиОтчетов.Организация = &Организация
		|	И СоставИНастройкиОтчетов.Настройка = &Настройка
		|	И СоставИНастройкиОтчетов.Период <= &ТекущаяДата
		|	И (СоставИНастройкиОтчетов.Субъект = НЕОПРЕДЕЛЕНО
		|			ИЛИ (СоставИНастройкиОтчетов.Субъект, СоставИНастройкиОтчетов.ВидДоговора) В
		|				(ВЫБРАТЬ
		|					_НаборАналитикПоДействующимДоговорам.Субъект,
		|					_НаборАналитикПоДействующимДоговорам.ВидДоговора
		|				ИЗ
		|					_НаборАналитикПоДействующимДоговорам))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СобственныеЗначения.Период КАК Период,
		|	СобственныеЗначения.Организация КАК Организация,
		|	СобственныеЗначения.Субъект КАК Субъект,
		|	СобственныеЗначения.ВидДоговора КАК ВидДоговора,
		|	СобственныеЗначения.Периодичность КАК Периодичность,
		|	СобственныеЗначения.Настройка КАК Настройка,
		|	СобственныеЗначения.Значение КАК Значение,
		|	СобственныеЗначения.Отчет КАК Отчет,
		|	СобственныеЗначения.Приоритет КАК Приоритет,
		|	СобственныеЗначения.ВидЗначения КАК ВидЗначения
		|ПОМЕСТИТЬ _ИмяТаблицы
		|ИЗ
		|	_ЗначенияНастройки_БезОтбора КАК СобственныеЗначения
		|		ЛЕВОЕ СОЕДИНЕНИЕ _ЗначенияНастройки_БезОтбора КАК ЗначенияПоУмолчанию
		|		ПО СобственныеЗначения.Организация = ЗначенияПоУмолчанию.Организация
		|			И СобственныеЗначения.Субъект = ЗначенияПоУмолчанию.Субъект
		|			И СобственныеЗначения.Периодичность = ЗначенияПоУмолчанию.Периодичность
		|			И СобственныеЗначения.ВидДоговора = ЗначенияПоУмолчанию.ВидДоговора
		|			И СобственныеЗначения.Настройка = ЗначенияПоУмолчанию.Настройка
		|			И СобственныеЗначения.Отчет = ЗначенияПоУмолчанию.Отчет
		|			И (ЗначенияПоУмолчанию.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.ПоУмолчанию))
		|ГДЕ
		|	СобственныеЗначения.ВидЗначения = ЗНАЧЕНИЕ(Перечисление.ВидыЗначенияНастроекОтчетов.Собственное)
		|	И СобственныеЗначения.Период >= ЕСТЬNULL(ЗначенияПоУмолчанию.Период, ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ _ЗначенияНастройки_БезОтбора";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "_ИмяТаблицы", ИмяТаблицы);
	Запрос.Выполнить();
	
КонецПроцедуры


Функция НачалоДекады(ДатаМесяца)
	
	ДеньМесяца = День(ДатаМесяца);
	
	Если ДеньМесяца <= 10 Тогда
		ДатаНачала = НачалоМесяца(ДатаМесяца);
	ИначеЕсли ДеньМесяца > 10 И ДеньМесяца <= 20 Тогда
		ДатаНачала = НачалоМесяца(ДатаМесяца) + 10 * 86400;
	ИначеЕсли ДеньМесяца > 20 Тогда
		ДатаНачала = НачалоМесяца(ДатаМесяца) + 20 * 86400;
	КонецЕсли;
	
	Возврат ДатаНачала;
	
КонецФункции

Функция ПолучитьДатыРеформаций(Организация, Отбор, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеформацииБалансов.Организация КАК Организация,
		|	РеформацииБалансов.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	ДОБАВИТЬКДАТЕ(МАКСИМУМ(РеформацииБалансов.ДатаРеформации), ДЕНЬ, 1) КАК ДатаРеформации
		|ИЗ
		|	РегистрСведений.РеформацииБалансов КАК РеформацииБалансов
		|ГДЕ
		|	РеформацииБалансов.ДатаРеформации МЕЖДУ &НачалоГода И &ОтчетнаяДата
		|	И РеформацииБалансов.Организация = &Организация
		|	И &Договоры
		|
		|СГРУППИРОВАТЬ ПО
		|	РеформацииБалансов.Организация,
		|	РеформацииБалансов.СчетДоверительногоУправления";
	
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("НачалоГода", 	НачалоГода(Дата));
	Запрос.УстановитьПараметр("ОтчетнаяДата", 	КонецДня(Дата) - 24 * 60 * 60);
	
	Если Отбор <> Неопределено И Отбор.Свойство("Договоры") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Договоры", "РеформацииБалансов.СчетДоверительногоУправления В (&Договоры)");
		Запрос.УстановитьПараметр("Договоры", Отбор.Договоры);
	Иначе
		Запрос.УстановитьПараметр("Договоры", Истина);
	КонецЕсли; 
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолучитьДатуНачала(Организация, Отбор, ДанныеОбОтчете, ДатыРеформаций)

	ВариантОпределенияНачальнойДаты = ДанныеОбОтчете.ВариантОпределенияНачальнойДаты;
	
	ДатаНачала = Неопределено;
	
	Если ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ДваРазаВМесяц Тогда
		
		Если КонецДня(ДанныеОбОтчете.Дата) = КонецМесяца(ДанныеОбОтчете.Дата) Тогда
			
			Если ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета._16ЧислоМесяца Тогда
				День = 16;
			Иначе
				// берем середину месяца: для февраля 15 число, для остальных - 16
				День = ?(Месяц(ДанныеОбОтчете.Дата) = 2, 15, 16);
			КонецЕсли; 
			
			ДатаНачала = Дата(Год(ДанныеОбОтчете.Дата), Месяц(ДанныеОбОтчете.Дата), День);
			
		Иначе
			ДатаНачала = НачалоМесяца(ДанныеОбОтчете.Дата);
		КонецЕсли;
		
	ИначеЕсли ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.НачалоДекады Тогда
		ДатаНачала = НачалоДекады(ДанныеОбОтчете.Дата); 
	ИначеЕсли ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.НачалоКвартала Тогда
		ДатаНачала = НачалоКвартала(ДанныеОбОтчете.Дата);
	ИначеЕсли ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.НачалоМесяца Тогда
		ДатаНачала = НачалоМесяца(ДанныеОбОтчете.Дата);
	ИначеЕсли ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.НачалоНедели Тогда
		ДатаНачала = НачалоНедели(ДанныеОбОтчете.Дата);	
	ИначеЕсли ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.Ежедневно Тогда
		ДатаНачала = НачалоДня(ДанныеОбОтчете.Дата);
	ИначеЕсли ВариантОпределенияНачальнойДаты = Перечисления.ВариантыОпределенияНачальнойДатыОтчета.НачалоГода Тогда
		ДатаНачала = НачалоГода(ДанныеОбОтчете.Дата);
	Иначе
		
		// заполняем стандартным вариантом
		Если ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежегодно Тогда
			ДатаНачала = НачалоГода(ДанныеОбОтчете.Дата);
		ИначеЕсли ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежедневно Тогда
			ДатаНачала = НачалоДня(ДанныеОбОтчете.Дата);
		ИначеЕсли ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежеквартально Тогда
			ДатаНачала = НачалоКвартала(ДанныеОбОтчете.Дата);
		ИначеЕсли ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Ежемесячно Тогда
			ДатаНачала = НачалоМесяца(ДанныеОбОтчете.Дата);
		ИначеЕсли ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.Еженедельно Тогда
			ДатаНачала = НачалоНедели(ДанныеОбОтчете.Дата);
		ИначеЕсли ДанныеОбОтчете.Периодичность = Перечисления.ПериодичностьПредоставленияОтчетности.ПоДекадам Тогда
			ДатаНачала = НачалоДекады(ДанныеОбОтчете.Дата);
		КонецЕсли;
	КонецЕсли;
	
	ДатыРеформацийНаОтчетнуюДату = ДатыРеформаций.Получить(ДанныеОбОтчете.Дата);
	
	Если ДатыРеформацийНаОтчетнуюДату = Неопределено Тогда
		
		ДатыРеформацийНаОтчетнуюДату = ПолучитьДатыРеформаций(Организация, Отбор, ДанныеОбОтчете.Дата);
		
		ДатыРеформаций.Вставить(ДанныеОбОтчете.Дата, ДатыРеформацийНаОтчетнуюДату);
		
	КонецЕсли;
	
	НайденныеСтроки = ДатыРеформацийНаОтчетнуюДату.НайтиСтроки(Новый Структура("Организация, СчетДоверительногоУправления", Организация, ДанныеОбОтчете.Субъект));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		ДатаНачала = Макс(ДатаНачала, НайденныеСтроки[0].ДатаРеформации);
	КонецЕсли; 
	
	Возврат ДатаНачала;

КонецФункции

Функция ПолучитьЗначениеПараметраОтбора(ИмяПараметра, Отбор)
	
	Результат = Неопределено;
	
	Если Отбор <> Неопределено
		И Отбор.Свойство(ИмяПараметра)
		И ЗначениеЗаполнено(Отбор[ИмяПараметра]) Тогда
		Результат = Отбор[ИмяПараметра];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиСсылкуПоКлючу(Ключ, ВидОбъекта)
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ключ", Ключ);
	
	Если ВидОбъекта = "Отчет" Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Отчеты.Ссылка
			|ИЗ
			|	Справочник.Отчеты КАК Отчеты
			|ГДЕ
			|	Отчеты.Ключ = &Ключ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Отчеты.Ссылка
			|ИЗ
			|	Справочник.Отчеты КАК Отчеты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеОтчетыИОбработки КАК ДополнительныеОтчетыИОбработки
			|		ПО Отчеты.Ключ = ДополнительныеОтчетыИОбработки.Ссылка
			|ГДЕ
			|	ДополнительныеОтчетыИОбработки.ИмяОбъекта = &Ключ";
	ИначеЕсли ВидОбъекта = "Настройка" Тогда
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НастройкиОтчетов.Ссылка
			|ИЗ
			|	ПланВидовХарактеристик.НастройкиОтчетов КАК НастройкиОтчетов
			|ГДЕ
			|	НастройкиОтчетов.Код = &Ключ";
	Иначе
		Возврат Результат;			
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Ключ		= Выборка.Ссылка;
		Результат	= Истина;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция Декада(ДатаМесяца)
	
	ДеньМесяца = День(ДатаМесяца);
	
	Если      ДеньМесяца <= 10 Тогда
		Декада = 1;
	ИначеЕсли ДеньМесяца > 10 И ДеньМесяца <= 20 Тогда
		Декада = 2;
	ИначеЕсли ДеньМесяца > 20 Тогда
		Декада = 3;
	КонецЕсли;
	
	Возврат Декада;
	
КонецФункции // Декада

Процедура ЗаполнитьФорматыДаты(ПутьКФайлу, СтрокаПоиска, СоответствиеШаблонов, ФорматируемаяДата)

	ЧислоВхожденийФорматовДаты = СтрЧислоВхождений(ПутьКФайлу, СтрокаПоиска);
	
	Для НомерВхождения = 1 По ЧислоВхожденийФорматовДаты Цикл
	
		НачалоФорматаДаты = СтрНайти(ПутьКФайлу, СтрокаПоиска, , , НомерВхождения);
		Если НачалоФорматаДаты > 0 Тогда
			
			НачалоФорматнойСтроки = СтрНайти(ПутьКФайлу, "_", , НачалоФорматаДаты) + 1;
			КонецФорматнойСтроки = СтрНайти(ПутьКФайлу, "%", , НачалоФорматнойСтроки);
			ФорматнаяСтрока = Сред(ПутьКФайлу, НачалоФорматнойСтроки, КонецФорматнойСтроки - НачалоФорматнойСтроки);
			СоответствиеШаблонов.Вставить(Сред(ПутьКФайлу, НачалоФорматаДаты, КонецФорматнойСтроки - НачалоФорматаДаты + 1), Формат(ФорматируемаяДата, ФорматнаяСтрока));
			
		КонецЕсли; 
			
	КонецЦикла;
	
КонецПроцедуры

// Возвращает сведения об отчетах и клиентах
//
// Параметры:
//	ДатыОтчетыСубъекты		- Строка, Структура - имя временной таблицы или структура
//								Обязательные поля:
//								— ДатаОкончания - Дата	
//								— Отчет			- СправочникСсылка.Отчеты
//								— Субъект		- СправочникСсылка.СчетаДоверительногоУправления
//	ИсточникВременныхТаблиц	- Запрос, МенеджерВременныхТаблиц - источник временных таблиц
//
// Возвращаемое значение:
//	СведенияОбОтчетахИКлиентах - Структура - структура, содержащая поля:
//	— РеквизитыОтчетов - Таблица значений с колонками:
//		— Отчет
//		— Наименование
//		— КраткоеНаименование
//	— ДанныеКлиентов - Таблица значений с колонками:
//		— Субъект
//		— ДатаОкончания
//		— СчетДоверительногоУправления
//		— НомерДоговора
//		— ДатаДоговора
//		— Наименование
//		— НаименованиеБезНПФ
//		— ВидДоговораДоверительногоУправления
//		— ВидДоговора
//		— ИИС
//		— Лицензия
//		— КраткоеНаименованиеКлиента
//		— КраткоеНаименованиеКлиентаБезОПФ
//		— НаименованиеОрганизации 
//
Функция ПолучитьСведенияОбОтчетахИКлиентах(ДатыОтчетыСубъекты, ИсточникВременныхТаблиц = Неопределено)
	
	МенеджерВременныхТаблиц =
		?(ИсточникВременныхТаблиц = Неопределено,
			Новый МенеджерВременныхТаблиц,
			СистемныеФункции.МенеджерВременныхТаблицИзИсточникаВременныхТаблиц(ИсточникВременныхТаблиц));
		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	#Область Получаем_различные_отчеты_и_даты_субъектов
	
	Если ТипЗнч(ДатыОтчетыСубъекты) = Тип("Строка") Тогда
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДатыОтчетыСубъекты.Отчет КАК Отчет
			|ПОМЕСТИТЬ _РазличныеОтчеты
			|ИЗ
			|	#ДатыОтчетыСубъекты# КАК ДатыОтчетыСубъекты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДатыОтчетыСубъекты.ДатаОкончания КАК ДатаОкончания,
			|	ДатыОтчетыСубъекты.Субъект КАК Субъект
			|ПОМЕСТИТЬ _РазличныеДатыСубъектов
			|ИЗ
			|	#ДатыОтчетыСубъекты# КАК ДатыОтчетыСубъекты";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДатыОтчетыСубъекты#", ДатыОтчетыСубъекты);
		
	Иначе
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Отчет КАК Отчет
			|ПОМЕСТИТЬ _РазличныеОтчеты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&ДатаОкончания КАК ДатаОкончания,
			|	&Субъект КАК Субъект
			|ПОМЕСТИТЬ _РазличныеДатыСубъектов";
		
		Запрос.УстановитьПараметр("ДатаОкончания",	ДатыОтчетыСубъекты.ДатаОкончания);
		Запрос.УстановитьПараметр("Отчет",			ДатыОтчетыСубъекты.Отчет);
		Запрос.УстановитьПараметр("Субъект",		ДатыОтчетыСубъекты.Субъект);
		
	КонецЕсли;
	
	Запрос.Выполнить();
	
	#КонецОбласти
	
	#Область Основной_запрос	
	
	// Для клиентов используются данные группы компаний - это неправильно,
	// однако сейчас они очень сильно отличаются, и перевести нельзя, пока не исправят.
	// Указал на это в задаче #450276
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Отчеты.Ссылка КАК Отчет,
		|	Отчеты.Наименование КАК Наименование,
		|	Отчеты.КраткоеНаименование КАК КраткоеНаименование
		|ПОМЕСТИТЬ _РеквизитыОтчетов
		|ИЗ
		|	Справочник.Отчеты КАК Отчеты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ _РазличныеОтчеты КАК _РазличныеОтчеты
		|		ПО Отчеты.Ссылка = _РазличныеОтчеты.Отчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РазличныеДатыСубъектов.Субъект КАК Субъект,
		|	_РазличныеДатыСубъектов.ДатаОкончания КАК ДатаОкончания,
		|	СчетаДоверительногоУправления.Ссылка КАК СчетДоверительногоУправления,
		|	СчетаДоверительногоУправления.Организация КАК Организация,
		|	СчетаДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	СчетаДоверительногоУправления.ДатаЗаключения КАК ДатаДоговора,
		|	СчетаДоверительногоУправления.Наименование КАК Наименование,
		|	СчетаДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Клиент,
		|	ВЫБОР
		|		КОГДА КлиентыДоверительногоУправленияСрезПоследних.Клиент ССЫЛКА Справочник.ЮрФизЛица
		|			ТОГДА ВЫРАЗИТЬ(КлиентыДоверительногоУправленияСрезПоследних.Клиент КАК Справочник.ЮрФизЛица).ВидЮрФизЛица
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ВидЮрФизЛицаКлиента
		|ПОМЕСТИТЬ _ДанныеСчетовДоверительногоУправления
		|ИЗ
		|	_РазличныеДатыСубъектов КАК _РазличныеДатыСубъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СчетаДоверительногоУправления КАК СчетаДоверительногоУправления
		|		ПО _РазличныеДатыСубъектов.Субъект = СчетаДоверительногоУправления.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК КлиентыДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_РазличныеДатыСубъектов.ДатаОкончания КАК ДатаОкончания,
		|				_РазличныеДатыСубъектов.Субъект КАК Субъект,
		|				МАКСИМУМ(Клиенты.Период) КАК Период
		|			ИЗ
		|				_РазличныеДатыСубъектов КАК _РазличныеДатыСубъектов
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КлиентыДоверительногоУправления КАК Клиенты
		|					ПО (Клиенты.СчетДоверительногоУправления = _РазличныеДатыСубъектов.Субъект)
		|						И (Клиенты.Период <= _РазличныеДатыСубъектов.ДатаОкончания)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_РазличныеДатыСубъектов.ДатаОкончания,
		|				_РазличныеДатыСубъектов.Субъект) КАК ДатыИзмененийКлиентов
		|			ПО КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = ДатыИзмененийКлиентов.Субъект
		|				И КлиентыДоверительногоУправленияСрезПоследних.Период = ДатыИзмененийКлиентов.Период
		|		ПО _РазличныеДатыСубъектов.Субъект = КлиентыДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (_РазличныеДатыСубъектов.ДатаОкончания = ДатыИзмененийКлиентов.ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_ДанныеСчетовДоверительногоУправления.Субъект КАК Субъект,
		|	_ДанныеСчетовДоверительногоУправления.ДатаОкончания КАК ДатаОкончания,
		|	_ДанныеСчетовДоверительногоУправления.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	_ДанныеСчетовДоверительногоУправления.НомерДоговора КАК НомерДоговора,
		|	_ДанныеСчетовДоверительногоУправления.ДатаДоговора КАК ДатаДоговора,
		|	_ДанныеСчетовДоверительногоУправления.Наименование КАК Наименование,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК НаименованиеБезНПФ,
		|	_ДанныеСчетовДоверительногоУправления.ВидДоговораДоверительногоУправления КАК ВидДоговораДоверительногоУправления,
		|	ВЫБОР
		|		КОГДА _ДанныеСчетовДоверительногоУправления.ВидДоговораДоверительногоУправления В (&ВидыДоговоровНПФ)
		|			ТОГДА ""НПФ""
		|		ИНАЧЕ ""ДУ""
		|	КОНЕЦ КАК ВидДоговора,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ИИС,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(150)) КАК Лицензия,
		|	_ДанныеСчетовДоверительногоУправления.Клиент КАК Клиент,
		|	_ДанныеСчетовДоверительногоУправления.ВидЮрФизЛицаКлиента КАК ВидЮрФизЛицаКлиента,
		|	ВЫБОР
		|		КОГДА _ДанныеСчетовДоверительногоУправления.Клиент ССЫЛКА Справочник.ЮрФизЛица
		|				И _ДанныеСчетовДоверительногоУправления.ВидЮрФизЛицаКлиента = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
		|			ТОГДА ЕСТЬNULL(РеквизитыЮрЛицКлиентов.КраткоеНаименованиеПоУставу, """")
		|		КОГДА _ДанныеСчетовДоверительногоУправления.Клиент ССЫЛКА Справочник.ЮрФизЛица
		|			ТОГДА ЕСТЬNULL(РеквизитыФизЛицКлиентов.Фамилия + ВЫБОР
		|						КОГДА РеквизитыФизЛицКлиентов.Имя <> """"
		|							ТОГДА "" "" + ПОДСТРОКА(РеквизитыФизЛицКлиентов.Имя, 1, 1) + "".""
		|						ИНАЧЕ """"
		|					КОНЕЦ + ВЫБОР
		|						КОГДА РеквизитыФизЛицКлиентов.Отчество <> """"
		|							ТОГДА "" "" + ПОДСТРОКА(РеквизитыФизЛицКлиентов.Отчество, 1, 1) + "".""
		|						ИНАЧЕ """"
		|					КОНЕЦ, """")
		|		ИНАЧЕ _ДанныеСчетовДоверительногоУправления.Наименование
		|	КОНЕЦ КАК КраткоеНаименованиеКлиента,
		|	ВЫРАЗИТЬ("""" КАК СТРОКА(255)) КАК КраткоеНаименованиеКлиентаБезОПФ,
		|	_ДанныеСчетовДоверительногоУправления.Организация.ЮрФизЛицо.Представление КАК НаименованиеОрганизации
		|ПОМЕСТИТЬ _ДанныеКлиентов
		|ИЗ
		|	_ДанныеСчетовДоверительногоУправления КАК _ДанныеСчетовДоверительногоУправления
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК РеквизитыФизЛицКлиентов
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ДанныеСчетовДоверительногоУправления.ДатаОкончания КАК ДатаОкончания,
		|				Реквизиты.Организация КАК Организация,
		|				Реквизиты.ЮрФизЛицо КАК Клиент,
		|				Реквизиты.Язык КАК Язык,
		|				МАКСИМУМ(Реквизиты.Период) КАК Период
		|			ИЗ
		|				_ДанныеСчетовДоверительногоУправления КАК _ДанныеСчетовДоверительногоУправления
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные КАК Реквизиты
		|					ПО (Реквизиты.Организация = _ДанныеСчетовДоверительногоУправления.Организация)
		|						И (Реквизиты.ЮрФизЛицо = _ДанныеСчетовДоверительногоУправления.Клиент)
		|						И (Реквизиты.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|						И (Реквизиты.Период <= _ДанныеСчетовДоверительногоУправления.ДатаОкончания)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ДанныеСчетовДоверительногоУправления.ДатаОкончания,
		|				Реквизиты.Организация,
		|				Реквизиты.ЮрФизЛицо,
		|				Реквизиты.Язык) КАК ДатыИзмененийРеквизитовФизЛицКлиентов
		|			ПО РеквизитыФизЛицКлиентов.Организация = ДатыИзмененийРеквизитовФизЛицКлиентов.Организация
		|				И РеквизитыФизЛицКлиентов.ЮрФизЛицо = ДатыИзмененийРеквизитовФизЛицКлиентов.Клиент
		|				И РеквизитыФизЛицКлиентов.Язык = ДатыИзмененийРеквизитовФизЛицКлиентов.Язык
		|				И РеквизитыФизЛицКлиентов.Период = ДатыИзмененийРеквизитовФизЛицКлиентов.Период
		|		ПО _ДанныеСчетовДоверительногоУправления.Клиент = РеквизитыФизЛицКлиентов.ЮрФизЛицо
		|			И (_ДанныеСчетовДоверительногоУправления.ДатаОкончания = ДатыИзмененийРеквизитовФизЛицКлиентов.ДатаОкончания)
		|			И _ДанныеСчетовДоверительногоУправления.Организация = РеквизитыФизЛицКлиентов.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК РеквизитыЮрЛицКлиентов
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_ДанныеСчетовДоверительногоУправления.ДатаОкончания КАК ДатаОкончания,
		|				Реквизиты.Подразделение КАК Подразделение,
		|				Реквизиты.ЮрФизЛицо КАК Клиент,
		|				Реквизиты.Язык КАК Язык,
		|				МАКСИМУМ(Реквизиты.Период) КАК Период
		|			ИЗ
		|				_ДанныеСчетовДоверительногоУправления КАК _ДанныеСчетовДоверительногоУправления
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц КАК Реквизиты
		|					ПО (Реквизиты.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний))
		|						И (Реквизиты.ЮрФизЛицо = _ДанныеСчетовДоверительногоУправления.Клиент)
		|						И (Реквизиты.Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский))
		|						И (Реквизиты.Период <= _ДанныеСчетовДоверительногоУправления.ДатаОкончания)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_ДанныеСчетовДоверительногоУправления.ДатаОкончания,
		|				Реквизиты.Подразделение,
		|				Реквизиты.ЮрФизЛицо,
		|				Реквизиты.Язык) КАК ДатыИзмененийРеквизитовЮрЛицКлиентов
		|			ПО РеквизитыЮрЛицКлиентов.Подразделение = ДатыИзмененийРеквизитовЮрЛицКлиентов.Подразделение
		|				И РеквизитыЮрЛицКлиентов.ЮрФизЛицо = ДатыИзмененийРеквизитовЮрЛицКлиентов.Клиент
		|				И РеквизитыЮрЛицКлиентов.Язык = ДатыИзмененийРеквизитовЮрЛицКлиентов.Язык
		|				И РеквизитыЮрЛицКлиентов.Период = ДатыИзмененийРеквизитовЮрЛицКлиентов.Период
		|		ПО _ДанныеСчетовДоверительногоУправления.Клиент = РеквизитыЮрЛицКлиентов.ЮрФизЛицо
		|			И (_ДанныеСчетовДоверительногоУправления.ДатаОкончания = ДатыИзмененийРеквизитовЮрЛицКлиентов.ДатаОкончания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	_РазличныеДатыСубъектов.Субъект КАК Субъект,
		|	_РазличныеДатыСубъектов.ДатаОкончания КАК ДатаОкончания,
		|	ВЫБОР ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Лицензия.ВидДеятельности
		|		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюИнвестиционнымиФондамиПИФиНПФ)
		|			ТОГДА ""НПФ""
		|		КОГДА ЗНАЧЕНИЕ(Справочник.ВидыДеятельности.НаОсуществлениеДеятельностиПоУправлениюЦеннымиБумагами)
		|			ТОГДА ""ДУ""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ВидДеятельности
		|ПОМЕСТИТЬ _ВидыЛицензий
		|ИЗ
		|	_РазличныеДатыСубъектов КАК _РазличныеДатыСубъектов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК ЛицензииДоговоровДоверительногоУправленияСрезПоследних
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				_РазличныеДатыСубъектов.ДатаОкончания КАК ДатаОкончания,
		|				_РазличныеДатыСубъектов.Субъект КАК Субъект,
		|				МАКСИМУМ(Лицензии.Период) КАК Период
		|			ИЗ
		|				_РазличныеДатыСубъектов КАК _РазличныеДатыСубъектов
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЛицензииДоговоровДоверительногоУправления КАК Лицензии
		|					ПО (Лицензии.СчетДоверительногоУправления = _РазличныеДатыСубъектов.Субъект)
		|						И (Лицензии.Период <= _РазличныеДатыСубъектов.ДатаОкончания)
		|			
		|			СГРУППИРОВАТЬ ПО
		|				_РазличныеДатыСубъектов.ДатаОкончания,
		|				_РазличныеДатыСубъектов.Субъект) КАК ДатыИзмененийЛицензий
		|			ПО ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления = ДатыИзмененийЛицензий.Субъект
		|				И ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Период = ДатыИзмененийЛицензий.Период
		|		ПО _РазличныеДатыСубъектов.Субъект = ЛицензииДоговоровДоверительногоУправленияСрезПоследних.СчетДоверительногоУправления
		|			И (_РазличныеДатыСубъектов.ДатаОкончания = ДатыИзмененийЛицензий.ДатаОкончания)
		|			И (ЛицензииДоговоровДоверительногоУправленияСрезПоследних.Действует)";
	
	ВидыДоговоровНПФ = Новый Массив;
	ВидыДоговоровНПФ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиНакоплениями);
	ВидыДоговоровНПФ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеПенсионнымиРезервами);
	ВидыДоговоровНПФ.Добавить(Перечисления.ВидыДоговоровДоверительногоУправления.УправлениеСобственнымиСредствамиПенсионныхФондов);
	
	Запрос.УстановитьПараметр("ВидыДоговоровНПФ", ВидыДоговоровНПФ);
	
	#КонецОбласти
	
	Запрос.Выполнить();
	
	РеквизитыОтчетов = МенеджерВременныхТаблиц.Таблицы["_РеквизитыОтчетов"].ПолучитьДанные().Выгрузить();
	РеквизитыОтчетов.Индексы.Добавить("Отчет");
	
	ДанныеКлиентов = МенеджерВременныхТаблиц.Таблицы["_ДанныеКлиентов"].ПолучитьДанные().Выгрузить();
	ДанныеКлиентов.Индексы.Добавить("Субъект, ДатаОкончания");
	
	// Дополнительная обработка сведений об отчетах
	
	Для Каждого РеквизитыОтчета Из РеквизитыОтчетов Цикл
		
		РеквизитыОтчета.Наименование		= РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(РеквизитыОтчета.Наименование);
		РеквизитыОтчета.КраткоеНаименование	= ?(ЗначениеЗаполнено(РеквизитыОтчета.КраткоеНаименование), РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(РеквизитыОтчета.КраткоеНаименование), РеквизитыОтчета.Наименование);		
		
	КонецЦикла;
	
	// Дополнительная обработка сведений о клиентах
	
	Для Каждого ДанныеКлиента Из ДанныеКлиентов Цикл
		
		ДанныеКлиента.Наименование				 = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ДанныеКлиента.Наименование);
		ДанныеКлиента.НаименованиеБезНПФ		 = ?(СтрНачинаетсяС(ДанныеКлиента.Наименование, "НПФ "), СокрЛП(Сред(ДанныеКлиента.Наименование, 5)), ДанныеКлиента.Наименование);
		ДанныеКлиента.НаименованиеОрганизации	 = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ДанныеКлиента.НаименованиеОрганизации);
		ДанныеКлиента.НомерДоговора				 = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(СтрЗаменить(СтрЗаменить(ДанныеКлиента.НомерДоговора, "/", "_"), "\", "_"));
		ДанныеКлиента.ИИС						 = ?(ДанныеКлиента.ВидДоговораДоверительногоУправления = Перечисления.ВидыДоговоровДоверительногоУправления.ИндивидуальныйИнвестиционныйСчет, "Клиенты ИИС\", "");
		ДанныеКлиента.КраткоеНаименованиеКлиента = РаботаСоСтрокамиКлиентСервер.УдалитьНедопустимыеСимволыИмениФайла(ДанныеКлиента.КраткоеНаименованиеКлиента);
		
		// Получаем наименование клиента без организационно-правовой формы (ОПФ):
		// считаем ОПФ известные аббревиатуры, расположенные в начале наименования
		
		ДанныеКлиента.КраткоеНаименованиеКлиентаБезОПФ = ДанныеКлиента.КраткоеНаименованиеКлиента;
		
		Если ДанныеКлиента.ВидЮрФизЛицаКлиента = Перечисления.ВидыЮрФизЛиц.ЮридическоеЛицо Тогда
			
			ВариантыОПФ = СтрРазделить("АО, ООО, НПФ, МНПФ, ААУ", ", ", Ложь);
			
			НовыйПоиск = Истина;
			Пока НовыйПоиск Цикл
				НовыйПоиск = Ложь;
				Для Каждого ВариантОПФ Из ВариантыОПФ Цикл  
					Если СтрНачинаетсяС(ДанныеКлиента.КраткоеНаименованиеКлиентаБезОПФ, ВариантОПФ + " ") Тогда
						ДанныеКлиента.КраткоеНаименованиеКлиентаБезОПФ = Сред(ДанныеКлиента.КраткоеНаименованиеКлиентаБезОПФ, СтрДлина(ВариантОПФ + " ") + 1);
						ВариантыОПФ.Удалить(ВариантыОПФ.Найти(ВариантОПФ));
						НовыйПоиск = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
				
		КонецЕсли;		
		
	КонецЦикла;
	
	// Дополним сведения о клиентах данными о лицензиях
	
	ВыборкаВидовЛицензий = МенеджерВременныхТаблиц.Таблицы.Найти("_ВидыЛицензий").ПолучитьДанные().Выбрать();
	Пока ВыборкаВидовЛицензий.Следующий() Цикл
		ДанныеКлиента = ДанныеКлиентов.НайтиСтроки(Новый Структура("Субъект, ДатаОкончания", ВыборкаВидовЛицензий.Субъект, ВыборкаВидовЛицензий.ДатаОкончания))[0];
		ДанныеКлиента.Лицензия = ДанныеКлиента.Лицензия + ?(ПустаяСтрока(ДанныеКлиента.Лицензия), "", " ") + ВыборкаВидовЛицензий.ВидДеятельности;	
	КонецЦикла;
	
	Возврат Новый Структура("РеквизитыОтчетов, ДанныеКлиентов", РеквизитыОтчетов, ДанныеКлиентов);	
	
КонецФункции

#КонецОбласти
