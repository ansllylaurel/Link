// Интерфейс для регистрации обработки. Вызывается при добавлении обработки в справочник "ВнешниеОбработки"
//
// Возвращаемое значение (Структура):
//     Вид (Строка) - вид подключаемого объекта:
//         |- "ДополнительнаяОбработка"
//         |- "ДополнительныйОтчет"
//         |- "ЗаполнениеОбъекта"
//         |- "ПечатнаяФорма"
//
//     Назначение (массив строк) - имена объектов метаданных в формате <ИмяКлассаОбъектаМетаданного>.[*|<ИмяОбъектаМетаданных>]
//         Например, "Документ.СчетЗаказ" или "Справочник.*"
//
//     Наименование (строка) - краткая строка для идентификации обработки администратором (должна быть уникальна в пределах вида)
//
//     Версия (строка) - версия обработки в формате <старший номер>.<младший номер> (например "10.37")
//
//     Информация (Строка) - описание обработки
//
//     Команды (ТаблицаЗначений) - команды, поставляемые обработкой; одна строка таблицы соотвествует одной команде; колонки:
//         |- Представление (строка) - представление команды конечному пользователю
//         |- Идентификатор (строка) - идентификатор команды
//         |- Использование (строка) - варианты запуска обработки:
//         |      |- "ОткрытиеФормы"          - открыть форму обработки
//         |      |- "ВызовКлиентскогоМетода" - вызов клиентского экспортного метода из формы обработки
//         |      |- "ВызовСерверногоМетода"  - вызов серверного экспортного метода из модуля объекта обработки
//    	   |- ПоказыватьОповещение (Булево) - если Истина, требуется оказывать оповещение при начале и при окончании запуска обработки
//         |      Прим. Имеет смысл только при запуске обработки без открытия формы.
//	       |- Модификатор (Cтрока) - для печатных форм MXL, которые требуется отображать в форме ПечатьДокументов подсистемы
//                Печать требуется установить как "ПечатьMXL"
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительнаяОбработка,
		"Конвертация отчетов брокера ГПБ в PDF",
		"0.13",
		"",
		Истина
	);
		
	// Команды
	Команды = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтчетыБрокераГПБHTML2PDFЗаПредыдущийРабочийДень_РЭМ", "Отчеты брокера ГПБ HTML2PDF за предыдущий рабочий день (РЭМ)",,  Ложь, "ВызовСерверногоМетода");
	РаботаСДополнительнымиОтчетамиИОбработками.ДобавитьНовуюКомандуВТаблицу(Команды, "ОтчетыБрокераГПБHTML2PDFЗаПредыдущийРабочийДень_Траст", "Отчеты брокера ГПБ HTML2PDF за предыдущий рабочий день (Траст)",,  Ложь, "ВызовСерверногоМетода");
	
	РегистрационныеДанные.Вставить("Команды", Команды);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	// заполним параметры команды (вариативности команд здесь нет)
	ПараметрыКоманды = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(ПараметрыОбработки.ДополнительнаяОбработкаСсылка, ИдентификаторКоманды);
	
	Если СтрНачинаетсяС(ИдентификаторКоманды, "ОтчетыБрокераГПБHTML2PDFЗаПредыдущийРабочийДень") Тогда
		ПредыдущийРабочийДень	= Справочники.Календари.ПолучитьБлижайшуюРабочуюДату(Справочники.Календари.Общероссийский, НачалоДня(ТекущаяДата() - 24*60*60));
		Организация 			= ПараметрыКоманды.Организация;
		
		ПараметрыСессии = ЗарегистрироватьНовуюСессию(ИдентификаторКоманды, Новый Структура("Организация, ПредыдущийРабочийДень", Организация, ПредыдущийРабочийДень));
		СконвертироватьФайлы(ПредыдущийРабочийДень, Организация, Истина, Истина, ПараметрыСессии);
		ЗарегистрироватьОкончаниеСессии(ПараметрыСессии);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СконвертироватьФайлы(Дата, Организация, КонвертироватьTXT = Ложь, КонвертироватьXLSX = Истина, ПараметрыСессии = Неопределено) Экспорт
    	
	ШаблонКаталога = ПланыВидовХарактеристик.ДополнительныеСведения.КаталогОтчетаДляОрганизации("ВнешниеОбработки._КонвертацияОтчетовБрокераГПБ.ШаблонКаталогаОтчетов", Организация, Дата);
	
	Каталог = ПланыВидовХарактеристик.ДополнительныеСведения.ОбработатьПутьКФайлу(ШаблонКаталога, Новый Структура("Период, Периодичность", Дата, ""));
	КаталогДляСконвертированных = Каталог + "_Сконвертированные\";
	
	КаталогДляСконвертированныхНаДиске = Новый Файл(КаталогДляСконвертированных);
	Если НЕ КаталогДляСконвертированныхНаДиске.Существует() Тогда
		СоздатьКаталог(КаталогДляСконвертированных);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления КАК СчетДоверительногоУправления,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.Код КАК Код,
		|	КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.СчетДоверительногоУправления.Наименование КАК СчетДоверительногоУправленияНаименование
		|ИЗ
		|	РегистрСведений.КодыСчетовДоверительногоУправленияУБрокеров.СрезПоследних(
		|			&Период,
		|			Организация = &Организация
		|				И Брокер = &Брокер
		|				И (СчетДоверительногоУправления.ДатаРасторжения >= &Период
		|					ИЛИ СчетДоверительногоУправления.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))) КАК КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияДоговоровОбщие.СрезПоследних(&Период, Организация = &Организация) КАК УсловияДоговоровОбщиеСрезПоследних
		|		ПО КодыСчетовДоверительногоУправленияУБрокеровСрезПоследних.ДоговорБрокерскогоОбслуживания = УсловияДоговоровОбщиеСрезПоследних.Договор
		|ГДЕ
		|	(УсловияДоговоровОбщиеСрезПоследних.Договор ЕСТЬ NULL
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения > &Период
		|			ИЛИ УсловияДоговоровОбщиеСрезПоследних.ДатаРасторжения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";
	
	Запрос.УстановитьПараметр("Брокер", ОбщегоНазначения.ПолучитьИменованныйОбъект("Брокер_ГПБ"));
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ПолучитьИменованныйОбъект("Организация_РЭМ"));
	Запрос.УстановитьПараметр("Период", Дата);
	
	КодыУБрокера = Запрос.Выполнить().Выгрузить();
	
	НайденыеФайлы = Новый Массив;
	
	Если КонвертироватьXLSX Тогда
		РезультатXLSX = НайтиФайлы(Каталог, "*.xlsx");
		Для Каждого Файл Из РезультатXLSX Цикл
			НайденыеФайлы.Добавить(Файл);
		КонецЦикла;
	КонецЕсли;
	
	Если КонвертироватьTXT Тогда
		РезультатTXT = НайтиФайлы(Каталог, "*.txt");
		Для Каждого Файл Из РезультатTXT Цикл
			НайденыеФайлы.Добавить(Файл);
		КонецЦикла;
	КонецЕсли;
	
	Для каждого НайденыйФайл Из НайденыеФайлы Цикл
		
		ИмяФайла = НайденыйФайл.Имя;
		
		// i02_12670_k_d_220330_EUR.txt разобъем на куски, на интересны только (1) 12670 - код клиента и (4) 220330 - дата и (5) EUR - валюта и его может не быть
		ДанныеИмениФайла = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			НайденыйФайл.ИмяБезРасширения,
			"_");
		
		Если ДанныеИмениФайла[4] <> Формат(Дата, "ДФ=yyMMdd") Тогда // затесался файл другой даты
			Продолжить;
		КонецЕсли;
		
		СтрокиКодУБрокера = КодыУБрокера.НайтиСтроки(Новый Структура("Код", ДанныеИмениФайла[1]));
		Если СтрокиКодУБрокера.Количество() = 0 Тогда // странно, тогда не переименовываем
			ИмяСчетаДУ = ДанныеИмениФайла[1];
		Иначе
			ИмяСчетаДУ = СокрЛП(СтрокиКодУБрокера[0].СчетДоверительногоУправленияНаименование);
		КонецЕсли;
		
		Если ДанныеИмениФайла.Количество() < 6 Тогда // без валюты
			ИмяВалюты = "RUB";
		Иначе	
			ИмяВалюты = ДанныеИмениФайла[5];
		КонецЕсли;
		
		НовоеИмяФайла = ИмяСчетаДУ + ", ГПБ, " + ДанныеИмениФайла[1] + ", " + ИмяВалюты + "_" + Формат(Дата, "ДФ=dd.MM.yyyy");
		
		Если НайденыйФайл.Расширение = ".txt" Тогда
			СконвертироватьTXT(НайденыйФайл.ПолноеИмя, КаталогДляСконвертированных + НовоеИмяФайла + ".pdf", КаталогДляСконвертированных + НовоеИмяФайла + ".txt");
		Иначе
			СконвертироватьXLSX(НайденыйФайл.ПолноеИмя, КаталогДляСконвертированных + НовоеИмяФайла + ".pdf", КаталогДляСконвертированных + НовоеИмяФайла + ".xlsx", ПараметрыСессии);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура СконвертироватьTXT(ИмяTXTФайла, ИмяPDFФайла, ИмяСконвертированногоTXTФайла) Экспорт
	
	Результат = Новый ТабличныйДокумент;
	
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяTXTФайла);
	
	СтрокНаЯчейку = 82; // точнее строк на страницу т.к. 1 ячейка = 1 страница, 1с иначе не может
	КонецБлизок = Ложь;
	ТекстовыйБуфер = "";
	Для Инд = 2 По Текст.КоличествоСтрок() Цикл
	
		СтрокаТекста = Текст.ПолучитьСтроку(Инд);
		ПечататьСтроку = Истина;
		
		Если КодСимвола(СтрокаТекста, 1) = 12 Тогда // прогон страницы - игнорим
			ПечататьСтроку = Ложь;
		ИначеЕсли КонецБлизок И СтрДлина(СокрЛП(СтрокаТекста)) = 0 Тогда // финальные строки - ГПБ в конце кучу пустых выводит
			ПечататьСтроку = Ложь;
		ИначеЕсли СтрДлина(СтрокаТекста) > 0 И СтрДлина(СокрЛП(СтрокаТекста)) = 0 Тогда // строки из пробелов и табов
			ПечататьСтроку = Ложь;
		ИначеЕсли СокрЛП(СтрокаТекста) = "(1) Внимание! Таблица «Движение по счету учета ценных бумаг» носит информационный характер." Тогда // конец близок...
			КонецБлизок = Истина;
		ИначеЕсли Лев(СокрЛП(СтрокаТекста), 8) = "Страница" Тогда // концы страниц не выводим
			ПечататьСтроку = Ложь;
		КонецЕсли;
		
		Если ПечататьСтроку Тогда
			ТекстовыйБуфер = ТекстовыйБуфер + Символы.ПС + СтрокаТекста;
			Если СтрЧислоСтрок(ТекстовыйБуфер) >= СтрокНаЯчейку Тогда
				ОбластьСтрока.Параметры.ТекстовыйБуфер = ТекстовыйБуфер;
				Результат.Вывести(ОбластьСтрока);
				ТекстовыйБуфер = "";
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрЧислоСтрок(ТекстовыйБуфер) > 0 Тогда
		ОбластьСтрока.Параметры.ТекстовыйБуфер = ТекстовыйБуфер;
		Результат.Вывести(ОбластьСтрока);
	КонецЕсли;	
	
	Результат.РазмерСтраницы = "A4";
	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Результат.ПолеСлева = 10;
	
	Результат.Записать(ИмяPDFФайла, ТипФайлаТабличногоДокумента.PDF);
	КопироватьФайл(ИмяTXTФайла, ИмяСконвертированногоTXTФайла);
	
КонецПроцедуры

Процедура СконвертироватьXLSX(ИмяXLSXФайла, ИмяPDFФайла, ИмяСконвертированногоXLSXФайла, ПараметрыСессии = Неопределено)
	
    Попытка
        ТабличныйДокумент = Новый ТабличныйДокумент;
        ТабличныйДокумент.Прочитать(ИмяXLSXФайла);
		
        // Установка базовых параметров отображения (опционально)
        ТабличныйДокумент.ОтображатьСетку = Ложь;
        ТабличныйДокумент.ОтображатьЗаголовки = Истина;
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабличныйДокумент.АвтоМасштаб = Истина;
        
        ТабличныйДокумент.Записать(ИмяPDFФайла, ТипФайлаТабличногоДокумента.PDF);
        КопироватьФайл(ИмяXLSXФайла, ИмяСконвертированногоXLSXФайла);
	Исключение
		ТекстОшибки = "Ошибка при конвертации файла '" + ИмяXLSXФайла + "': " + ОписаниеОшибки();
		Если ПараметрыСессии <> Неопределено Тогда
			ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки);
		КонецЕсли;
		Сообщить(ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

#Область СтатистикаРаботыВнутреннихМеханизмов

Функция ЗарегистрироватьНовуюСессию(ИмяКоманды, ПараметрыВыполнения = Неопределено) Экспорт
	Возврат РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессиюОбъекта(
		ЭтотОбъект, ИмяКоманды, ПараметрыВыполнения);
КонецФункции

Процедура ДополнитьПараметрыВыполненияСессии(ПараметрыСессии, ТекстОшибки) Экспорт
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ДополнитьПараметрыВыполненияСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия, Новый Структура("ТекстОшибки", ТекстОшибки));
КонецПроцедуры

Процедура ЗарегистрироватьОкончаниеСессии(ПараметрыСессии) Экспорт
	РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(
		ПараметрыСессии.Механизм, ПараметрыСессии.Сессия);
КонецПроцедуры

#КонецОбласти
