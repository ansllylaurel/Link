#Область ЭкспортВExternals

// Сохраняет файл реестра пайщиков и данные в SQL базу Externals.
Процедура СохранитьФайлИРеестрВExternals(ДвоичныеДанныеФайла, ПолноеИмяФайла, Организация, ТаблицаПайщиков, ДатаРеестра, ПИФ)
	
	Разложить = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайла);
	ИмяФайла = Разложить.Имя;
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ЛогироватьСообщение("Не удалось определить имя файла для сохранения в Externals", УровеньЖурналаРегистрации.Предупреждение, "СохранитьФайлИРеестрВExternals");
		Возврат;
	КонецЕсли;

	ИдентификаторОрганизации = ?(ЗначениеЗаполнено(Организация), Строка(Организация.УникальныйИдентификатор()), "");
	Источник = 31; 
	ДатаПубликации = ТекущаяДата();
	
	Соединение = Неопределено; 
	
	Попытка
		
		// Сохранение файла (оставлено через ADO)
		ХешСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДвоичныеДанныеФайла, ХешФункция.SHA256); 
		ПараметрыСоединения = Новый ПараметрыСоединенияВнешнегоИсточникаДанных;
		ПараметрыСоединения.СтрокаСоединения = РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals();
		
		Попытка
			ВнешниеИсточникиДанных.Externals.УстановитьОбщиеПараметрыСоединения(ПараметрыСоединения);
			ВнешниеИсточникиДанных.Externals.УстановитьСоединение();	
		Исключение
			ЛогироватьСообщение("Ошибка подключения к Externals: " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка, "СохранитьФайлИРеестрВExternals");
			Возврат;
		КонецПопытки;
		
		Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals());
		
		РаботаСВнешнимиСистемами.СохранитьФайлВExternals(ИмяФайла, Источник, ДвоичныеДанныеФайла, 
			ДатаПубликации, ИдентификаторОрганизации, ХешСумма, Соединение);
		
		File_Id = РаботаСВнешнимиСистемами.ПолучитьИдентификаторФайлаВExternals(
			Источник, ИдентификаторОрганизации, ИмяФайла, ХешСумма, Соединение);
			
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		Соединение = Неопределено;

		Если File_Id = Неопределено Тогда
			ЛогироватьСообщение("Не удалось получить идентификатор сохранённого файла в Externals", УровеньЖурналаРегистрации.Предупреждение, "СохранитьФайлИРеестрВExternals");
			Возврат;
		КонецЕсли;
		// Работа с реестром через Внешний Источник Данных
		ТаблицаВИД = ВнешниеИсточникиДанных.Externals.Таблицы.dbo_Register_Of_Unit_Holders;
		
		ЗапросУдаления = Новый Запрос;
		ЗапросУдаления.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	dbo_Register_Of_Unit_Holders.Ссылка КАК Ссылка
			|ИЗ
			|	ВнешнийИсточникДанных.Externals.Таблица.dbo_Register_Of_Unit_Holders КАК dbo_Register_Of_Unit_Holders
			|ГДЕ
			|	dbo_Register_Of_Unit_Holders.File_Id = &File_Id";
		
		ЗапросУдаления.УстановитьПараметр("File_Id", File_Id);
		
		ВыборкаУдаления = ЗапросУдаления.Выполнить().Выбрать();
		Пока ВыборкаУдаления.Следующий() Цикл
			Попытка
				ОбъектУдаления = ВыборкаУдаления.Ссылка.ПолучитьОбъект();
				ОбъектУдаления.Удалить();
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		// Добавление новых записей
		Fund_Name = ?(ЗначениеЗаполнено(ПИФ), Лев(СокрЛП(Строка(ПИФ)), 100), "");
		Compilation_Date = ?(ЗначениеЗаполнено(ДатаРеестра), ДатаРеестра, ТекущаяДата());
		Для Каждого СтрокаП Из ТаблицаПайщиков Цикл
			
			НоваяЗапись = ТаблицаВИД.СоздатьОбъект();
			
			НоваяЗапись.File_Id = File_Id;
			НоваяЗапись.Fund_Name = Fund_Name;
			НоваяЗапись.Compilation_Date = Compilation_Date;
			// Новые поля
			НоваяЗапись.Personal_Account_Number = Лев(СтрокаП.Personal_Account_Number, 50);
			НоваяЗапись.Is_Nominee = (СтрокаП.Is_Nominee = 1); 
			НоваяЗапись.Number_Of_Units = СтрокаП.Number_Of_Units;
			НоваяЗапись.Size_Of_Share = СтрокаП.Size_Of_Share;
			НоваяЗапись.Full_Name = Лев(СокрЛП(Строка(СтрокаП.Идентификатор)), 255);
			
			Если ЗначениеЗаполнено(СтрокаП.ДатаРождения) Тогда
				НоваяЗапись.Birthday = СтрокаП.ДатаРождения; 
			Иначе
				НоваяЗапись.Birthday = NULL; 
			КонецЕсли;
			РегИнфо = СокрЛП(Строка(СтрокаП.СерияПаспорта) + " " + Строка(СтрокаП.НомерПаспорта));
			Если ЗначениеЗаполнено(СтрокаП.ИНН) Тогда
				РегИнфо = РегИнфо + ?(ЗначениеЗаполнено(РегИнфо), " ", "") + "ИНН " + Строка(СтрокаП.ИНН);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаП.ОГРН) Тогда
				РегИнфо = РегИнфо + ?(ЗначениеЗаполнено(РегИнфо), " ", "") + "ОГРН " + Строка(СтрокаП.ОГРН);
			КонецЕсли;
			НоваяЗапись.Registration_Info = Лев(РегИнфо, 255);
			
			Адрес = Лев(СокрЛП(Строка(СтрокаП.Адрес)), 255);
			НоваяЗапись.Registration_Address = Адрес;
			НоваяЗапись.Fact_Address = Адрес;
			
			НоваяЗапись.Bank_Account = Лев(СокрЛП(Строка(СтрокаП.РасчетныйСчет)), 255);
			
			НоваяЗапись.Записать();
			
		КонецЦикла;
		ЛогироватьСообщение(СтрШаблон("Файл ""%1"" и реестр (%2 записей) сохранены в Externals", ИмяФайла, ТаблицаПайщиков.Количество()), УровеньЖурналаРегистрации.Информация, "СохранитьФайлИРеестрВExternals");
			
	Исключение
		Если Соединение <> Неопределено Тогда
			РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
		КонецЕсли;
		ЛогироватьСообщение("Ошибка сохранения в Externals: " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка, "СохранитьФайлИРеестрВExternals");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМетоды

Функция РазвернутьСписокПользователей(Знач Параметр)
	
	МассивРезультат = Новый Массив;
	Если Не ЗначениеЗаполнено(Параметр) Тогда 
		Возврат МассивРезультат; 
	КонецЕсли;
	
	ТипП = ТипЗнч(Параметр);
	
	Если ТипП = Тип("СправочникСсылка.ГруппыПользователей") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ГруппыПользователейСостав.Пользователь КАК Пользователь
			|ИЗ
			|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|ГДЕ
			|	ГруппыПользователейСостав.Ссылка = &Группа";
		
		Запрос.УстановитьПараметр("Группа", Параметр);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивРезультат.Добавить(Выборка.Пользователь);
		КонецЦикла;
	ИначеЕсли ТипП = Тип("СправочникСсылка.Пользователи") Тогда
		МассивРезультат.Добавить(Параметр);
		
	ИначеЕсли ТипП = Тип("СписокЗначений") Тогда
		МассивРезультат = Параметр.ВыгрузитьЗначения();
		
	ИначеЕсли ТипП = Тип("Массив") Тогда
		МассивРезультат = Параметр;
	КонецЕсли;
	Возврат МассивРезультат;

КонецФункции

Процедура ОтправитьРезультатСверкиПоПочте(Организация, ДатаРеестра, ПИФ, Расхождения, ТекстHTML, СписокПолучателей)

	Если Не ЗначениеЗаполнено(СписокПолучателей) Тогда 
		Возврат; 
	КонецЕсли;

	Адреса = Новый Массив;
	Для Каждого Юзер Из СписокПолучателей Цикл
		Если ТипЗнч(Юзер) <> Тип("СправочникСсылка.Пользователи") Тогда 
			Продолжить; 
		КонецЕсли;
		
		Email = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Юзер, "АдресЭлектроннойПочты");
		Если ЗначениеЗаполнено(Email) Тогда
			Адреса.Добавить(Новый Структура("Адрес, Представление", Email, Строка(Юзер)));
		КонецЕсли;
	КонецЦикла;

	Если Адреса.Количество() = 0 Тогда 
		Возврат; 
	КонецЕсли;
	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", 
		Адреса, 
		СтрШаблон("Сверка ПИФ %1 (%2)", ПИФ, Формат(ДатаРеестра, "ДФ=dd.MM.yyyy")), 
		ТекстHTML, 
		"HTML");

	Попытка
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	Исключение
		ЛогироватьСообщение("Ошибка отправки почты: " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка, "ОтправитьРезультатСверкиПоПочте");
	КонецПопытки;

КонецПроцедуры

Процедура ЗафиксироватьРезультатСверкиВЖурнале(Организация, ДатаРеестра, ПИФ, Расхождения)
	
	КоличествоРасхождений = 0;
	Если ТипЗнч(Расхождения) = Тип("ТаблицаЗначений") Тогда 
		КоличествоРасхождений = Расхождения.Количество(); 
	КонецЕсли;
	РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
		Организация, 
		Справочники.СчетаДоверительногоУправления.ПустаяСсылка(), 
		ДатаРеестра, 
		Неопределено, 
		(КоличествоРасхождений = 0), 
		Истина, 
		ТекущаяДата(), 
		"Автосверка (Регламентное задание)");
		
КонецПроцедуры

Процедура ЛогироватьСообщение(Текст, Знач Уровень = Неопределено, Метод = "")
	
	ТекущийУровень = ?(Уровень = Неопределено, УровеньЖурналаРегистрации.Информация, Уровень);
	
	Если ТекущийУровень = УровеньЖурналаРегистрации.Ошибка Тогда
		ЗаписьЖурналаРегистрации("ВнешняяОбработка._СверкаСРеестромВладельцевИнвестиционныхПаев", ТекущийУровень, , ,Текст);
		ЗаписатьРаботуВнутреннегоМеханизма(Текст, Метод);
	Иначе
		ЗаписатьРаботуВнутреннегоМеханизма(Текст, Метод);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьРаботуВнутреннегоМеханизма(Текст, Метод)
	
	Если ВыполняетсяИнтерактивно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	Иначе
		ПараметрыВыполненияДляСбораСтатистики = 
			РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ПолучитьПараметрыВыполнения(
				ЭтотОбъект, "Организация, ПутьКПапке, СохранятьДанныеРеестраВExternals");
		Механизм = ЭтотОбъект.Метаданные().ПолноеИмя() + "." + Метод;
		Сессия = РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьНовуюСессию(
			Механизм,
			ПараметрыВыполненияДляСбораСтатистики.Хранилище,
			ПараметрыВыполненияДляСбораСтатистики.Описание);
		РегистрыСведений.СтатистикаРаботыВнутреннихМеханизмов.ЗарегистрироватьОкончаниеСессии(Механизм, Сессия, ,Текст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти