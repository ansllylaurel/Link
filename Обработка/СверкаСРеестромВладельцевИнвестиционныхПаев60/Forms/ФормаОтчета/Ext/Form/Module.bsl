&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Отчет.СохранятьДанныеРеестраВExternals = Ложь;
	
	// Устанавливаем текущую дату по умолчанию для сверки
	ДатаСверки = ТекущаяДатаСеанса();
	
	Если Не ЗначениеЗаполнено(Отчет.Организация) Тогда
		Попытка
			Отчет.Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ЗначениеЗаполнено(Отчет.Организация) Тогда
		ПоказатьОповещениеПользователя("Ошибка", , "Укажите организацию", БиблиотекаКартинок.Ошибка);
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Отчет.ПутьКПапке) Тогда
		ПоказатьОповещениеПользователя("Внимание", , "Выберите папку с файлами", БиблиотекаКартинок.Предупреждение);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСверки) Тогда
		ПоказатьОповещениеПользователя("Ошибка", , "Укажите дату сверки", БиблиотекаКартинок.Ошибка);
		Возврат;
	КонецЕсли;

	Если Отчет.СохранятьДанныеРеестраВExternals Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросОСохранении", ЭтаФорма);
		ТекстВопроса = "Включена опция сохранения данных в Externals."
					   + Символы.ПС + 
					   "Существующие данные по этим файлам в базе будут УДАЛЕНЫ и заменены новыми."
					   + Символы.ПС +
					   "Продолжить?";
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
		
	КонецЕсли;

	ЗапуститьСверкуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьКПапкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите папку с реестрами";
	
	Если ЗначениеЗаполнено(Отчет.ПутьКПапке) Тогда
		Файл = Новый Файл(Отчет.ПутьКПапке);
		Если Файл.Существует() Тогда
			Диалог.Каталог = ?(Файл.ЭтоКаталог(), Файл.ПолноеИмя, Файл.Путь);
		КонецЕсли;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПапки", ЭтаФорма);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРезультатовПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ТаблицаРезультатов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ДокументОтчета = ""; // Очищаем поле HTML, если ничего не выбрано
		Возврат;
	КонецЕсли;
	// Показываем HTML из скрытой колонки
	ДокументОтчета = ТекДанные.ДанныеHTML;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПапки(ВыбранныеФайлы, Параметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Отчет.ПутьКПапке = ВыбранныеФайлы[0];
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРассылку(Команда)
	Элементы.ПолучателиРассылки.Видимость = НЕ Элементы.ПолучателиРассылки.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОСохранении(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗапуститьСверкуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСверкуНаСервере()
	
	Состояние("Поиск файлов на локальном компьютере...");
	
	ПутьНорм = Отчет.ПутьКПапке;
	Если Не СтрЗаканчиваетсяНа(ПутьНорм, "\") И Не СтрЗаканчиваетсяНа(ПутьНорм, "/") Тогда
		ПутьНорм = ПутьНорм + "\";
	КонецЕсли;

	КаталогНаДиске = Новый Файл(ПутьНорм);
	Если Не КаталогНаДиске.Существует() Тогда
		ПоказатьОповещениеПользователя("Ошибка", , "Указанный каталог не существует!", БиблиотекаКартинок.Ошибка);
		Возврат;
	КонецЕсли;

	ФайлыВПапке = НайтиФайлы(ПутьНорм, "*.xlsx", Ложь);
	Если ФайлыВПапке.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Внимание", , "В папке не найдены файлы XLSX!");
		Возврат;
	КонецЕсли;
	
	МассивФайловДляСервера = Новый Массив;
	
	НачалоДняСверки = НачалоДня(ДатаСверки);

	Для Каждого ТекФайл Из ФайлыВПапке Цикл
		
		ДатаИзИмени = ИзвлечьДатуИзИмениФайлаКлиент(ТекФайл.ИмяБезРасширения);
		
		Если ДатаИзИмени = НачалоДняСверки Тогда
			Попытка
				ДвоичныеДанные = Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
				
				// Помещаем файл во Временное Хранилище, чтобы Сервер смог его забрать
				Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
				
				ОписаниеФайла = Новый Структура;
				ОписаниеФайла.Вставить("Имя", ТекФайл.Имя);
				ОписаниеФайла.Вставить("ПолноеИмя", ТекФайл.ПолноеИмя);
				ОписаниеФайла.Вставить("Адрес", Адрес);
				
				МассивФайловДляСервера.Добавить(ОписаниеФайла);
			Исключение
				Сообщить("Не удалось прочитать файл " + ТекФайл.Имя + ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Если МассивФайловДляСервера.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Информация", , "В папке нет файлов XLSX с датой " + Формат(ДатаСверки, "ДФ=dd.MM.yyyy") + " в имени.");
		Возврат;
	КонецЕсли;

	Состояние("Выполняется сверка файлов на сервере...");
	
	РезультатСверки = СформироватьНаСервере(МассивФайловДляСервера);
	
	Если РезультатСверки.КоличествоОшибок > 0 Тогда
		ТекстСообщения = СтрШаблон("Завершено. Обработано файлов: %1. Ошибок: %2", РезультатСверки.ВсегоФайлов, РезультатСверки.КоличествоОшибок);
		ПоказатьОповещениеПользователя("Есть ошибки", , ТекстСообщения, БиблиотекаКартинок.Предупреждение);
	Иначе
		ПоказатьОповещениеПользователя("Успешно", , СтрШаблон("Обработано файлов: %1", РезультатСверки.ВсегоФайлов), БиблиотекаКартинок.Информация);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИзвлечьДатуИзИмениФайлаКлиент(ИмяБезРасширения)
	
	Части = СтрРазделить(ИмяБезРасширения, "_");
	
	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаДаты = СокрЛП(Части[Части.ВГраница()]);
	
	Если СтрДлина(СтрокаДаты) <> 6 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		День  = Число(Лев(СтрокаДаты, 2));
		Месяц = Число(Сред(СтрокаДаты, 3, 2));
		Год   = Число("20" + Прав(СтрокаДаты, 2));
		
		Если День = 0 Или Месяц = 0 Или Месяц > 12 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат Дата(Год, Месяц, День);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СформироватьНаСервере(МассивФайлов)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	
	ТаблицаРезультатов.Очистить();
	ДокументОтчета = "";
	
	Статистика = Новый Структура("ВсегоФайлов, КоличествоОшибок", МассивФайлов.Количество(), 0);

	Для Каждого ФайлИзСписка Из МассивФайлов Цикл
		
		Попытка
			Двоичные = ПолучитьИзВременногоХранилища(ФайлИзСписка.Адрес);
			
			РезультатОбработки = ОтчетОбъект.СформироватьОтчет(
				ОтчетОбъект.Организация, 
				Двоичные, 
				ФайлИзСписка.ПолноеИмя,  
				ОтчетОбъект.СохранятьДанныеРеестраВExternals,
				Истина
			);
			
			НоваяСтрока = ТаблицаРезультатов.Добавить();
			НоваяСтрока.ПредставлениеФайла = ФайлИзСписка.Имя;
			
			Если РезультатОбработки.Успех Тогда
				НоваяСтрока.ДанныеHTML = РезультатОбработки.ТекстОтчета;
			Иначе
				ТекстОшибки = ?(ЗначениеЗаполнено(РезультатОбработки.ТекстОшибки), РезультатОбработки.ТекстОшибки, "Неизвестная ошибка");
				НоваяСтрока.ДанныеHTML = "<html><body><h3 style='color:red'>Ошибка обработки файла</h3><p>" + ТекстОшибки + "</p></body></html>";
				Статистика.КоличествоОшибок = Статистика.КоличествоОшибок + 1;
				Сообщить("Ошибка в файле " + ФайлИзСписка.Имя + ": " + ТекстОшибки);
			КонецЕсли;
			
		Исключение
			ТекстИсключения = ОписаниеОшибки();
			НоваяСтрока = ТаблицаРезультатов.Добавить();
			НоваяСтрока.ПредставлениеФайла = ФайлИзСписка.Имя + " (Сбой)";
			НоваяСтрока.ДанныеHTML = "<html><body><h3 style='color:red'>Критическая ошибка</h3><p>" + ТекстИсключения + "</p></body></html>";
			Статистика.КоличествоОшибок = Статистика.КоличествоОшибок + 1;
			Сообщить("Сбой при обработке " + ФайлИзСписка.Имя + ": " + ТекстИсключения);
		КонецПопытки;
		
	КонецЦикла;
	
	Если ТаблицаРезультатов.Количество() > 0 Тогда
		ДокументОтчета = ТаблицаРезультатов[0].ДанныеHTML;
	КонецЕсли;
	
	Возврат Статистика;

КонецФункции