Функция ИзвлечьДатуИзСтрокиРеестра(ТекстСтроки)
	
	Если Не ЗначениеЗаполнено(ТекстСтроки) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Позиция = 1; 
	ДлинаСтроки = СтрДлина(ТекстСтроки);
	
	Пока Позиция <= ДлинаСтроки - 9 Цикл
		ПотенциальнаяДата = Сред(ТекстСтроки, Позиция, 10);
		Если Сред(ПотенциальнаяДата, 3, 1) = "." И Сред(ПотенциальнаяДата, 6, 1) = "." И РаботаСоСтрокамиКлиентСервер.ТолькоЦифрыВСтроке(Лев(ПотенциальнаяДата, 2), Истина, Ложь) Тогда
			ВремяСтрока = ""; 
			Остаток = СокрЛ(Сред(ТекстСтроки, Позиция + 10));
			Если ЗначениеЗаполнено(Остаток) Тогда
				Если СтрДлина(Остаток) >= 8 И Сред(Остаток, 3, 1) = ":" И Сред(Остаток, 6, 1) = ":" Тогда 
					ВремяСтрока = Лев(Остаток, 8);
				ИначеЕсли СтрДлина(Остаток) >= 5 И Сред(Остаток, 3, 1) = ":" Тогда 
					ВремяСтрока = Лев(Остаток, 5) + ":00"; 
				КонецЕсли;
			КонецЕсли;
			Возврат РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ПотенциальнаяДата, ВремяСтрока, Истина);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции

Функция ИзвлечьСерияИНомерПаспорта(ТекстПаспорта)
	
	Результат = Новый Структура("Серия, Номер, ИНН", "", "", "");
	Если Не ЗначениеЗаполнено(ТекстПаспорта) Тогда 
		Возврат Результат; 
	КонецЕсли;
	
	Части = СтрРазделить(ТекстПаспорта, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть, " ");
		Если Цифры = "0" Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если ПустаяСтрока(Результат.Серия) И СтрДлина(Цифры) = 4 Тогда 
			Результат.Серия = Цифры;
		ИначеЕсли ПустаяСтрока(Результат.Номер) И СтрДлина(Цифры) = 6 Тогда 
			Результат.Номер = Цифры;
		ИначеЕсли ПустаяСтрока(Результат.ИНН) И СтрДлина(Цифры) = 12 Тогда 
			Результат.ИНН = Цифры;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ИзвлечьНомерРасчетногоСчета(ТекстБанковскихРеквизитов)

    Если Не ЗначениеЗаполнено(ТекстБанковскихРеквизитов) Тогда
        Возврат "";
    КонецЕсли;

    Части = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстБанковскихРеквизитов, " ", Истина, Истина);

    Для Каждого Часть Из Части Цикл
		Цифры = РаботаСоСтрокамиКлиентСервер.ОставитьТолькоЦифрыВСтроке(Часть);
		Если Цифры = "0" Тогда
            Продолжить;
        КонецЕсли;
		Если СтрДлина(Цифры) = 20 Тогда
            Возврат Цифры;
		КонецЕсли;
    КонецЦикла;
    
    Возврат "";

КонецФункции

Функция ОставитьТолькоЦифрыИПробелыИНН(Текст)
    Результат = "";
    Для Номер = 1 По СтрДлина(Текст) Цикл
        Символ = Сред(Текст, Номер, 1);
        Код = КодСимвола(Символ);
        Результат = Результат + ?(Код >= 48 И Код <= 57, Символ, " ");
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция НайтиИННИОГРНВМассивеЧастей(Части)
    
    Результат = Новый Структура("ИНН, ОГРН", "", "");
    Для Каждого Часть Из Части Цикл
        Длина = СтрДлина(Часть);
        Если ПустаяСтрока(Результат.ИНН) И (Длина = 10 Или Длина = 12) Тогда 
        	Результат.ИНН = Часть; 
        	Продолжить; 
        КонецЕсли;
        
        Если ПустаяСтрока(Результат.ОГРН) И (Длина = 13 Или Длина = 15) Тогда 
        	Результат.ОГРН = Часть; 
        	Продолжить; 
        КонецЕсли;
        
        Если Не ПустаяСтрока(Результат.ИНН) И Не ПустаяСтрока(Результат.ОГРН) Тогда 
        	Прервать; 
        КонецЕсли;
    КонецЦикла;
    
    Возврат Результат;

КонецФункции

Функция ИзвлечьИННИОГРНИзСтрокиРегистрации(Текст)
    
    Результат = Новый Структура("ИНН, ОГРН", "", "");
    Если Не ЗначениеЗаполнено(Текст) Тогда 
    	Возврат Результат; 
    КонецЕсли;
    
    СтрокаСПробелами = ОставитьТолькоЦифрыИПробелыИНН(Текст);
    Части = РаботаСоСтрокамиКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСПробелами, " ", Истина, Ложь);
    Данные = НайтиИННИОГРНВМассивеЧастей(Части);
    
    Результат.ИНН = Данные.ИНН; 
    Результат.ОГРН = Данные.ОГРН;
    
    Возврат Результат;

КонецФункции

Функция ИзвлечьОрганРегистрацииПослеДаты(Текст, ДатаРег)
	
	СтрокаДата = Формат(ДатаРег, "ДФ=dd.MM.yyyy");
	ПозДата = СтрНайти(Текст, СтрокаДата);
	
	Если ПозДата <= 0 Тогда 
		Возврат ""; 
	КонецЕсли;
	
	НачалоОргана = ПозДата + СтрДлина(СтрокаДата);
	
	// Пропускаем разделители
	Пока НачалоОргана <= СтрДлина(Текст) Цикл
		Симв = Сред(Текст, НачалоОргана, 1);
		Если Симв <> " " И Симв <> "," Тогда 
			Прервать; 
		КонецЕсли;
		НачалоОргана = НачалоОргана + 1;
	КонецЦикла;
	
	Хвост = Сред(Текст, НачалоОргана);
	ПозИНН = СтрНайти(ВРег(Хвост), "ИНН");
	
	Если ПозИНН > 0 Тогда 
		Возврат СокрЛП(Лев(Хвост, ПозИНН - 1)); 
	КонецЕсли;
	
	Возврат СокрЛП(Хвост);

КонецФункции

Функция ИзвлечьРеквизитыРегистрацииЮЛ(Текст)
	
	Результат = Новый Структура("ИНН, ОГРН, ДатаРегистрации, ОрганРегистрации", "", "", Неопределено, "");
	Если Не ЗначениеЗаполнено(Текст) Тогда 
		Возврат Результат;
	КонецЕсли;
	
	ДанныеИННОГРН = ИзвлечьИННИОГРНИзСтрокиРегистрации(Текст);
	Результат.ИНН = ДанныеИННОГРН.ИНН; 
	Результат.ОГРН = ДанныеИННОГРН.ОГРН;
	
	ДатаРег = ИзвлечьДатуИзСтрокиРеестра(Текст);
	Если ДатаРег = Неопределено Тогда 
		Возврат Результат;
	КонецЕсли;
	
	Результат.ДатаРегистрации = ДатаРег;
	Результат.ОрганРегистрации = ИзвлечьОрганРегистрацииПослеДаты(Текст, ДатаРег);
	
	Возврат Результат;

КонецФункции

Функция ИзвлечьРеквизитыРегистрацииФЛ(Текст)
    
    Результат = Новый Структура("ДатаВыдачи, ОрганВыдавший", Неопределено, "");
    ДатаВыдачи = ИзвлечьДатуИзСтрокиРеестра(Текст);
    Если ДатаВыдачи = Неопределено Тогда 
    	Возврат Результат; 
    КонецЕсли;
    
    Результат.ДатаВыдачи = ДатаВыдачи;
    СтрокаДата = Формат(ДатаВыдачи, "ДФ=dd.MM.yyyy");
    ПозДата = СтрНайти(Текст, СтрокаДата);
    НачалоОргана = ПозДата + СтрДлина(СтрокаДата);
    
    Пока НачалоОргана <= СтрДлина(Текст) Цикл
        Симв = Сред(Текст, НачалоОргана, 1);
        Если Симв <> " " И Симв <> "," Тогда 
        	Прервать; 
        КонецЕсли;
        НачалоОргана = НачалоОргана + 1;
    КонецЦикла;
    
    ПозЗапятой = СтрНайти(Текст, ",", НаправлениеПоиска.СНачала, НачалоОргана);
    ДлинаОргана = ?(ПозЗапятой > 0, ПозЗапятой - НачалоОргана, СтрДлина(Текст));
    Результат.ОрганВыдавший = СокрЛП(Сред(Текст, НачалоОргана, ДлинаОргана));
    
    Возврат Результат;

КонецФункции

