#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	РегистрационныеДанные = РаботаСДополнительнымиОтчетамиИОбработками.ЗаполнитьРегистрационныеДанные(
		Перечисления.ВидыДополнительныхОтчетовИОбработок.ДополнительныйОтчет,
		"Сверка с реестром владельцев инвестиционных паев",
		"0.49",
		"Сверка данных пайщиков ПИФ (Регламентное задание)",
		Истина);

	РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);

	ТаблицаКоманд = РаботаСДополнительнымиОтчетамиИОбработками.СоздатьТаблицуКоманд();
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = "Выполнить сверку по расписанию";
	НоваяКоманда.Идентификатор = "СверкаПоРасписанию";
	НоваяКоманда.Использование = "ВызовСерверногоМетода"; 
	НоваяКоманда.ПоказыватьОповещение = Ложь;

	РегистрационныеДанные.Вставить("Команды", ТаблицаКоманд);

	Возврат РегистрационныеДанные;

КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыВыполненияКоманды) Экспорт

	Если ИдентификаторКоманды <> "СверкаПоРасписанию" Тогда
		Возврат;
	КонецЕсли;

	Настройки = РаботаСДополнительнымиОтчетамиИОбработками.ПолучитьПараметрыКоманды(
		ПараметрыВыполненияКоманды.ДополнительнаяОбработкаСсылка,
		"СверкаПоРасписанию");

	Если Настройки = Неопределено Тогда
		ЛогироватьСообщение("Ошибка: настройки команды не найдены в справочнике.", УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;

	Организация = Неопределено;
	ПутьКПапке  = "";
	
	Настройки.Свойство("Организация", Организация);
	Настройки.Свойство("ПутьКПапке",  ПутьКПапке);

	ПараметрПолучатели = Неопределено;
	Настройки.Свойство("ПолучателиРассылки", ПараметрПолучатели);
	
	// Разворачиваем группу/пользователя в массив для рассылки
	МассивПолучателей = РазвернутьСписокПользователей(ПараметрПолучатели);

	ВыполнитьСверкуИзКаталога(Организация, ПутьКПапке, МассивПолучателей);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основной цикл обработки файлов из указанного каталога.
//
// Параметры:
//   Организация - СправочникСсылка.Организации - Организация для сверки.
//   ПутьКПапке - Строка - Путь к каталогу с файлами реестров.
//   Получатели - Массив - Список получателей отчета.
Процедура ВыполнитьСверкуИзКаталога(Организация, ПутьКПапке, Получатели = Неопределено)

	Если Не ЗначениеЗаполнено(Организация) Или ПустаяСтрока(ПутьКПапке) Тогда
		ЛогироватьСообщение("Сверка пропущена: Не заполнены Организация или Путь.", УровеньЖурналаРегистрации.Предупреждение);
		Возврат;
	КонецЕсли;

	ПутьНорм = ПутьКПапке;
	Если Не СтрЗаканчиваетсяНа(ПутьНорм, "\") И Не СтрЗаканчиваетсяНа(ПутьНорм, "/") Тогда
		ПутьНорм = ПутьНорм + "\";
	КонецЕсли;

	Файлы = НайтиФайлы(ПутьНорм, "*.xlsx", Ложь);
	Если Файлы.Количество() = 0 Тогда
		ЛогироватьСообщение("Файлы XLSX не найдены в папке: " + ПутьНорм, УровеньЖурналаРегистрации.Информация);
		Возврат;
	КонецЕсли;

	Для Каждого ФайлРеестра Из Файлы Цикл
		Попытка
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ФайлРеестра.ПолноеИмя);
			Результат = СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ФайлРеестра.ПолноеИмя, Получатели, Истина);
			Если Результат.Успех Тогда
				ЛогироватьСообщение("Успешно обработан: " + ФайлРеестра.Имя);
			ИначеЕсли ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
				ЛогироватьСообщение("Файл " + ФайлРеестра.Имя + ": " + Результат.ТекстОшибки, УровеньЖурналаРегистрации.Ошибка);
			КонецЕсли;
		Исключение
			ЛогироватьСообщение("Ошибка файла " + ФайлРеестра.Имя + ": " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Основная функция: чтение, парсинг, сверка, отчетность.
//
// Параметры:
//   Организация - СправочникСсылка.Организации
//   ДвоичныеДанныеФайла - ДвоичныеДанные - Файл Excel.
//   ПолноеИмяФайла - Строка
//   ПолучателиРассылки - Массив
//   СохранятьВExternals - Булево - Флаг выгрузки в SQL.
//
// Возвращаемое значение:
//   Структура - Результат выполнения (Успех, ТекстОтчета, ТекстОшибки).
Функция СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла, ПолучателиРассылки = Неопределено, СохранятьВExternals = Ложь) Экспорт

	Результат = Новый Структура("Успех, ТекстОтчета, ТекстОшибки", Ложь, "", "");

	Попытка
		// 1. Чтение Excel
		ВременныйФайл = ПолучитьИмяВременногоФайла("xlsx");
		ДвоичныеДанныеФайла.Записать(ВременныйФайл);
		ТаблицаФайла = Новый ТабличныйДокумент;
		ТаблицаФайла.Прочитать(ВременныйФайл, СпособЧтенияЗначенийТабличногоДокумента.Текст, ТипФайлаТабличногоДокумента.XLSX);
		УдалитьФайлы(ВременныйФайл);

		// 2. Парсинг данных
		ДанныеИзФайла = ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла);
		
		// Обработка ошибки формата файла
		Если ТипЗнч(ДанныеИзФайла) = Тип("Строка") Тогда 
			Результат.ТекстОшибки = ДанныеИзФайла;
			Возврат Результат;
		КонецЕсли;

		// Проверка: ПИФ из файла должен принадлежать выбранной Организации
		Если Не ПИФПринадлежитОрганизации(Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра) Тогда
			Результат.ТекстОшибки = СтрШаблон("ПИФ ""%1"" не принадлежит выбранной организации. Сверка по файлу не выполнена.", ДанныеИзФайла.ПИФ);
			Возврат Результат;
		КонецЕсли;

		// 3. Получение данных 1С
		Данные1С = ПолучитьДанныеПайщиковИз1С(Организация, ДанныеИзФайла.ПИФ, ДанныеИзФайла.ДатаРеестра);
		
		// 4. Сравнение
		Расхождения = СформироватьТаблицуРасхождений(ДанныеИзФайла.Таблица, Данные1С);

		// 5. Генерация HTML (с полным именем файла в шапке)
		Результат.ТекстОтчета = ПолучитьHTMLОтчетаОРасхождениях(
			Расхождения, 
			Организация, 
			ДанныеИзФайла.ПИФ, 
			ДанныеИзФайла.ДатаРеестра, 
			ДанныеИзФайла.Таблица, 
			Данные1С,
			ПолноеИмяФайла);
			
		Результат.Успех = Истина;

		// 6. Фиксация результата и отправка
		ЗафиксироватьРезультатСверкиВЖурнале(Организация, ДанныеИзФайла.ДатаРеестра, ДанныеИзФайла.ПИФ, Расхождения);
		ОтправитьРезультатСверкиПоПочте(Организация, ДанныеИзФайла.ДатаРеестра, ДанныеИзФайла.ПИФ, Расхождения, Результат.ТекстОтчета, ПолучателиРассылки);

		// 7. Сохранение в SQL
		Если СохранятьВExternals Тогда
			СохранитьФайлИРеестрВExternals(ДвоичныеДанныеФайла, ПолноеИмяФайла, Организация, ДанныеИзФайла.Таблица, ДанныеИзФайла.ДатаРеестра, ДанныеИзФайла.ПИФ);
		КонецЕсли;

	Исключение
		Результат.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПарсингФайла

Функция ПроверитьРазмерИЗаголовкиРеестра(ТаблицаФайла)
	
	Высота = ТаблицаФайла.ВысотаТаблицы;
	Ширина = ТаблицаФайла.ШиринаТаблицы;
	
	Если Высота = 0 Или Ширина = 0 Тогда 
		Возврат "В файле нет данных."; 
	КонецЕсли;
	
	МинСтрок = 13;
	МинКолонок = 9;
	
	Если Высота < МинСтрок Или Ширина < МинКолонок Тогда 
		Возврат СтрШаблон("Файл не соответствует формату реестра: ожидается не менее %1 строк и %2 колонок.", МинСтрок, МинКолонок);
	КонецЕсли;
	
	ТекстСтр7 = СокрЛП(ТаблицаФайла.Область(7, 1, 7, 1).Текст);
	Если ТекстСтр7 <> "Информация из реестра владельцев инвестиционных паев" Тогда 
		Возврат "Файл не соответствует формату реестра: в 7-й строке ошибка.";
	КонецЕсли;
	
	Возврат "";

КонецФункции

Функция ПолучитьДатуИНаименованиеПИФИзРеестра(ТаблицаФайла)
	
	Результат = Новый Структура("ДатаРеестра, НаименованиеПИФ, Ошибка", Неопределено, "", "");
	
	ТекстСтр8 = СокрЛП(ТаблицаФайла.Область(8, 1, 8, 1).Текст);
	Результат.ДатаРеестра = ИзвлечьДатуИзСтрокиРеестра(ТекстСтр8);
	
	Если Не ЗначениеЗаполнено(Результат.ДатаРеестра) Тогда 
		Результат.Ошибка = "В 8-й строке не удалось извлечь дату."; 
		Возврат Результат; 
	КонецЕсли;
	
	ТекстСтр9 = СокрЛП(ТаблицаФайла.Область(9, 1, 9, 1).Текст);
	ПозДвоеточие = СтрНайти(ТекстСтр9, ":");
	Результат.НаименованиеПИФ = ?(ПозДвоеточие > 0, СокрЛП(Сред(ТекстСтр9, ПозДвоеточие + 1)), "");
	
	Если Не ЗначениеЗаполнено(Результат.НаименованиеПИФ) Тогда 
		Результат.Ошибка = "В 9-й строке не найдено наименование фонда."; 
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция СоздатьТаблицуПайщиковИзДокументаРеестра(ТаблицаФайла, Высота)
	
	ПерваяСтрокаДанных = 13; 
	КолонкаФИО = 3;
	КолонкаДР = 4;  
	КолонкаРегистрации = 5;
	КолонкаАдрес = 6; 
	КолонкаБанковскиеРеквизиты = 8;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(2)));
	Таблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));
    Таблица.Колонки.Добавить("ДатаРождения", Новый ОписаниеТипов("Дата",, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Таблица.Колонки.Добавить("СерияПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("НомерПаспорта", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12)));
	Таблица.Колонки.Добавить("ОГРН", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(15)));
	Таблица.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	Таблица.Колонки.Добавить("РасчетныйСчет", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("ДатаГосРегистрации", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("ОрганГосРегистрации", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(500)));

	Для НомерСтроки = ПерваяСтрокаДанных По Высота Цикл
		
		Лицо = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаФИО, НомерСтроки, КолонкаФИО).Текст);
		Если Не ЗначениеЗаполнено(Лицо) Тогда 
			Продолжить; 
		КонецЕсли;

		ТекстРегистрации = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаРегистрации, НомерСтроки, КолонкаРегистрации).Текст);
		ПризнакЮЛ = (СтрНайти(ВРег(ТекстРегистрации), "ОГРН") = 1);
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Идентификатор = Лицо;
        
        Если Не ПризнакЮЛ Тогда
            ТекстДР = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаДР, НомерСтроки, КолонкаДР).Текст);
            НоваяСтрока.ДатаРождения = РаботаСоСтрокамиКлиентСервер.ДатаИзСтрокиДДММГГГГ(ТекстДР, "", Ложь);
        КонецЕсли;

		Если ПризнакЮЛ Тогда 
			ЗаполнитьСтрокуДанныхЮЛ(НоваяСтрока, ТекстРегистрации);
		Иначе 
			ЗаполнитьСтрокуДанныхФЛ(НоваяСтрока, ТекстРегистрации); 
		КонецЕсли;
		
		НоваяСтрока.Адрес = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаАдрес, НомерСтроки, КолонкаАдрес).Текст);

		ТекстБанк = СокрЛП(ТаблицаФайла.Область(НомерСтроки, КолонкаБанковскиеРеквизиты, НомерСтроки, КолонкаБанковскиеРеквизиты).Текст);
		НоваяСтрока.РасчетныйСчет = ИзвлечьНомерРасчетногоСчета(ТекстБанк);
		
	КонецЦикла;
	
	Возврат Таблица;

КонецФункции

Процедура ЗаполнитьСтрокуДанныхЮЛ(НоваяСтрока, ТекстРегистрации)
	
	НоваяСтрока.ТипЛица = "ЮЛ";
	НоваяСтрока.СерияПаспорта = "";
	НоваяСтрока.НомерПаспорта = "";
	
	ДанныеРегЮЛ = ИзвлечьРеквизитыРегистрацииЮЛ(ТекстРегистрации);
	
	НоваяСтрока.ИНН = ДанныеРегЮЛ.ИНН; 
	НоваяСтрока.ОГРН = ДанныеРегЮЛ.ОГРН;
	НоваяСтрока.ДатаГосРегистрации = ДанныеРегЮЛ.ДатаРегистрации; 
	НоваяСтрока.ОрганГосРегистрации = ДанныеРегЮЛ.ОрганРегистрации;

КонецПроцедуры

Процедура ЗаполнитьСтрокуДанныхФЛ(НоваяСтрока, ТекстРегистрации)
    
    НоваяСтрока.ТипЛица = "ФЛ";
    
    РезультатПаспорт = ИзвлечьСерияИНомерПаспорта(ТекстРегистрации);
    НоваяСтрока.СерияПаспорта = РезультатПаспорт.Серия; 
    НоваяСтрока.НомерПаспорта = РезультатПаспорт.Номер;
    
    ДанныеИНН = ИзвлечьИННИОГРНИзСтрокиРегистрации(ТекстРегистрации);
    НоваяСтрока.ИНН = ДанныеИНН.ИНН; 
    НоваяСтрока.ОГРН = "";
    
    ДанныеРегФЛ = ИзвлечьРеквизитыРегистрацииФЛ(ТекстРегистрации);
    НоваяСтрока.ДатаГосРегистрации = ДанныеРегФЛ.ДатаВыдачи; 
    НоваяСтрока.ОрганГосРегистрации = ДанныеРегФЛ.ОрганВыдавший;

КонецПроцедуры

Функция ПрочитатьДанныеРеестраИзТабличногоДокумента(ТаблицаФайла)
	
	ОшибкаФормат = ПроверитьРазмерИЗаголовкиРеестра(ТаблицаФайла);
	Если ОшибкаФормат <> "" Тогда 
		Возврат ОшибкаФормат; 
	КонецЕсли;
	
	ДанныеДатаПИФ = ПолучитьДатуИНаименованиеПИФИзРеестра(ТаблицаФайла);
	Если ДанныеДатаПИФ.Ошибка <> "" Тогда 
		Возврат ДанныеДатаПИФ.Ошибка; 
	КонецЕсли;
	
	ПИФ = НайтиПИФПоНаименованию(ДанныеДатаПИФ.НаименованиеПИФ, ДанныеДатаПИФ.ДатаРеестра);
	Если Не ЗначениеЗаполнено(ПИФ) Тогда 
		Возврат СтрШаблон("ПИФ не найден. Значение из файла: ""%1"".", ДанныеДатаПИФ.НаименованиеПИФ); 
	КонецЕсли;
	
	Таблица = СоздатьТаблицуПайщиковИзДокументаРеестра(ТаблицаФайла, ТаблицаФайла.ВысотаТаблицы);
	Если Таблица.Количество() = 0 Тогда 
		Возврат "В файле не найдены данные пайщиков."; 
	КонецЕсли;
	
	Возврат Новый Структура("Таблица, ДатаРеестра, ПИФ", Таблица, ДанныеДатаПИФ.ДатаРеестра, ПИФ);

КонецФункции

#КонецОбласти

