Функция ПолучитьДанныеПайщиковИз1С(Организация, ПИФ, ДатаРеестра)
    
    Запрос = Новый Запрос;
    Запрос.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	Доли.Пайщик КАК Пайщик,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА ""ФЛ""
	    |		ИНАЧЕ ""ЮЛ""
	    |	КОНЕЦ КАК ТипЛица,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА СОКРЛП(РеквизитыФЛ.Фамилия + "" "" + РеквизитыФЛ.Имя + "" "" + РеквизитыФЛ.Отчество)
	    |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ПолноеНаименованиеПоУставу, ЕСТЬNULL(РеквизитыЮЛ.ПолноеНаименованиеПоУставу, """"))
	    |	КОНЕЦ КАК Идентификатор,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА РеквизитыФЛ.СерияУдостоверенияЛичности
	    |		ИНАЧЕ NULL
	    |	КОНЕЦ КАК СерияПаспорта,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА РеквизитыФЛ.НомерУдостоверенияЛичности
	    |		ИНАЧЕ NULL
	    |	КОНЕЦ КАК НомерПаспорта,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА РеквизитыФЛ.ИНН
	    |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ИНН, РеквизитыЮЛ.ИНН)
	    |	КОНЕЦ КАК ИНН,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ЮридическоеЛицо)
	    |			ТОГДА ЕСТЬNULL(РеквизитыЮЛАнкетные.ОГРН, РеквизитыЮЛ.ОГРН)
	    |		ИНАЧЕ NULL
	    |	КОНЕЦ КАК ОГРН,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА ЕСТЬNULL(РеквизитыФЛ.АдресРегистрации, РеквизитыФЛ.АдресМестаЖительства)
	    |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ЮридическийАдрес, """")
	    |	КОНЕЦ КАК Адрес,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА РеквизитыФЛ.ДатаРождения
	    |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	    |	КОНЕЦ КАК ДатаРождения,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА РеквизитыФЛ.ДатаВыдачиУдостоверенияЛичности
	    |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ДатаВыдачиОГРН, РеквизитыЮЛ.ДатаВыдачиОГРН)
	    |	КОНЕЦ КАК ДатаГосРегистрации,
	    |	ВЫБОР
	    |		КОГДА Лица.ВидЮрФизЛица = ЗНАЧЕНИЕ(Перечисление.ВидыЮрФизЛиц.ФизическоеЛицо)
	    |			ТОГДА РеквизитыФЛ.ОрганВыдавшийУдостоверениеЛичности
	    |		ИНАЧЕ ЕСТЬNULL(РеквизитыЮЛАнкетные.ОрганВыдавшийОГРН, РеквизитыЮЛ.ОрганВыдавшийОГРН)
	    |	КОНЕЦ КАК ОрганГосРегистрации
	    |ИЗ
	    |	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(
	    |			&ДатаРеестра,
	    |			Организация = &Организация
	    |				И ПаевойИнвестиционныйФонд = &ПИФ) КАК Доли
	    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮрФизЛица КАК Лица
	    |		ПО Доли.Пайщик = Лица.Ссылка
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыФизическихЛицАнкетные.СрезПоследних(
	    |				&ДатаРеестра,
	    |				Организация = &Организация
	    |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыФЛ
	    |		ПО Доли.Пайщик = РеквизитыФЛ.ЮрФизЛицо
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛиц.СрезПоследних(
	    |				&ДатаРеестра,
	    |				Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ГруппаКомпаний)
	    |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮЛ
	    |		ПО Доли.Пайщик = РеквизитыЮЛ.ЮрФизЛицо
	    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыЮридическихЛицАнкетные.СрезПоследних(
	    |				&ДатаРеестра,
	    |				Организация = &Организация
	    |					И Язык = ЗНАЧЕНИЕ(Справочник.Языки.Русский)) КАК РеквизитыЮЛАнкетные
	    |		ПО Доли.Пайщик = РеквизитыЮЛАнкетные.ЮрФизЛицо
	    |ГДЕ
	    |	Доли.КоличествоОстаток > 0
	    |	И Лица.ВидЮрФизЛица ЕСТЬ НЕ NULL ";

    Запрос.УстановитьПараметр("Организация", Организация);
    Запрос.УстановитьПараметр("ПИФ", ПИФ);
    Запрос.УстановитьПараметр("ДатаРеестра", ДатаРеестра);

    Результат = Запрос.Выполнить();
    ТаблицаПаищиков = Результат.Выгрузить();
    ТаблицаПаищиков.Колонки.Добавить("СписокСчетов", Новый ОписаниеТипов("Строка"));

    ЗапросСчета = Новый Запрос;
	ЗапросСчета.Текст =
	    "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	Счета.ЮрФизЛицо КАК Пайщик,
	    |	Счета.НомерСчета КАК НомерСчета
	    |ИЗ
	    |	Справочник.БанковскиеСчета КАК Счета
	    |ГДЕ
	    |	Счета.ПометкаУдаления = ЛОЖЬ
	    |	И Счета.Организация = &Организация";
	
    ЗапросСчета.УстановитьПараметр("Организация", Организация);
    ВыборкаСчета = ЗапросСчета.Выполнить().Выбрать();
   
    СловарьСчетов = Новый Соответствие;
    Пока ВыборкаСчета.Следующий() Цикл
        ТекстСчетов = СловарьСчетов.Получить(ВыборкаСчета.Пайщик);
        СловарьСчетов.Вставить(ВыборкаСчета.Пайщик, ?(ЗначениеЗаполнено(ТекстСчетов), ТекстСчетов + ", " + ВыборкаСчета.НомерСчета, ВыборкаСчета.НомерСчета));
    КонецЦикла;

    Для Каждого Строка Из ТаблицаПаищиков Цикл
        Строка.СписокСчетов = СловарьСчетов.Получить(Строка.Пайщик);
        Если Строка.СписокСчетов = Неопределено Тогда 
        	Строка.СписокСчетов = ""; 
        КонецЕсли;
    КонецЦикла;

    Возврат ТаблицаПаищиков;

КонецФункции

Функция НайтиПИФПоНаименованию(НаименованиеПИФ, ДатаРеестра)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Срез.ПаевойИнвестиционныйФонд КАК ПаевойИнвестиционныйФонд
		|ИЗ
		|	РегистрСведений.РеквизитыПИФ.СрезПоследних(&Дата, (ВЫРАЗИТЬ(ПолноеНаименованиеФонда КАК СТРОКА(500))) = &Наим) КАК Срез";
	
	Запрос.УстановитьПараметр("Дата", ДатаРеестра);
	Запрос.УстановитьПараметр("Наим", НаименованиеПИФ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ПаевойИнвестиционныйФонд; 
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

// Проверяет, что ПИФ относится к выбранной Организации (есть остатки в регистре по этой паре).
Функция ПИФПринадлежитОрганизации(Организация, ПИФ, ДатаРеестра)
	
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(ПИФ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле1
		|ИЗ
		|	РегистрНакопления.ДолиПайщиковВИнвестиционномФонде.Остатки(&Дата, Организация = &Организация И ПаевойИнвестиционныйФонд = &ПИФ) КАК Остатки";
	
	Запрос.УстановитьПараметр("Дата", ДатаРеестра);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПИФ", ПИФ);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область ЛогикаСравнения

Функция СформироватьТаблицуРасхождений(ТаблицаФайла, Данные1С)
    
    Расхождения = СоздатьПустуюТаблицуРасхождений();
    
    Словарь1С = Новый Соответствие;
    Для Каждого Строка1С Из Данные1С Цикл
        Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
        Словарь1С.Вставить(Ключ, Строка1С);
    КонецЦикла;
	
	Для Каждого СтрокаФайла Из ТаблицаФайла Цикл
        Ключ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
        Строка1С = Словарь1С.Получить(Ключ);
        
        Если Строка1С = Неопределено Тогда
            ДобавитьЗаписьВРасхождения(
				Расхождения, 
				СтрокаФайла.ТипЛица, 
				СтрокаФайла.Идентификатор, 
				"Лицо из файла реестра не найдено в 1С", 
				"-", "Указано в файле реестра", "-");
            Продолжить;
        КонецЕсли;
        
        СравнитьСтрокуФайлаС1С(Расхождения, СтрокаФайла, Строка1С);
    КонецЦикла;
	
	ДобавитьЛицаОтсутствующиеВФайле(Расхождения, ТаблицаФайла, Данные1С);
    
    Возврат Расхождения;

КонецФункции

Функция СоздатьПустуюТаблицуРасхождений()
    
    Расхождения = Новый ТаблицаЗначений;
    Расхождения.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("ВидРасхождения", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("ЗначениеВФайле", Новый ОписаниеТипов("Строка"));
    Расхождения.Колонки.Добавить("ЗначениеВ1С", Новый ОписаниеТипов("Строка"));
    
    Возврат Расхождения;

КонецФункции

Процедура ДобавитьЗаписьВРасхождения(Расхождения, ТипЛица, Идентификатор, ВидРасхождения, Реквизит, ЗначениеВФайле, ЗначениеВ1С)
    
    Новая = Расхождения.Добавить();
    Новая.ТипЛица = ТипЛица;
    Новая.Идентификатор = Идентификатор;
    Новая.ВидРасхождения = ВидРасхождения;
    Новая.Реквизит = Реквизит;
    Новая.ЗначениеВФайле = ЗначениеВФайле;
    Новая.ЗначениеВ1С = ЗначениеВ1С;

КонецПроцедуры

Процедура ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, Реквизит, ЗначВФайле, ЗначВ1С)
    
    Если ЗначВФайле = ЗначВ1С Тогда 
    	Возврат; 
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ЗначВФайле) И Не ЗначениеЗаполнено(ЗначВ1С) Тогда 
    	Возврат; 
    КонецЕсли;
    
    ДобавитьЗаписьВРасхождения(Расхождения, СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, "Не совпадает", Реквизит, ЗначВФайле, ЗначВ1С);

КонецПроцедуры

Процедура СравнитьСтрокуФайлаС1С(Расхождения, СтрокаФайла, Строка1С)
    
    Если СтрокаФайла.ТипЛица = "ФЛ" Тогда
        ПаспортФайл = СокрЛП(Строка(СтрокаФайла.СерияПаспорта) + " " + Строка(СтрокаФайла.НомерПаспорта));
        Паспорт1С = СокрЛП(Строка(Строка1С.СерияПаспорта) + " " + Строка(Строка1С.НомерПаспорта));
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "Паспорт", ПаспортФайл, Паспорт1С);
        
        ДР_Файл = ?(ЗначениеЗаполнено(СтрокаФайла.ДатаРождения), Формат(СтрокаФайла.ДатаРождения, "ДФ=dd.MM.yyyy"), "");
        ДР_1С   = ?(ЗначениеЗаполнено(Строка1С.ДатаРождения),   Формат(Строка1С.ДатаРождения,   "ДФ=dd.MM.yyyy"), "");
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "Дата рождения", ДР_Файл, ДР_1С);
    КонецЕсли;

    Если СтрокаФайла.ТипЛица = "ЮЛ" Тогда
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "ИНН", СокрЛП(Строка(СтрокаФайла.ИНН)), СокрЛП(Строка(Строка1С.ИНН)));
        ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "ОГРН", СокрЛП(Строка(СтрокаФайла.ОГРН)), СокрЛП(Строка(Строка1С.ОГРН)));
    КонецЕсли;
	
	ДобавитьРасхождениеПоРеквизиту(Расхождения, СтрокаФайла, "Адрес", СокрЛП(Строка(СтрокаФайла.Адрес)), СокрЛП(Строка(Строка1С.Адрес)));
    
    РсФайл = СокрЛП(Строка(СтрокаФайла.РасчетныйСчет));
    СписокСчетов1С = Строка1С.СписокСчетов;

    СчетНайден = ЗначениеЗаполнено(СписокСчетов1С) И ЗначениеЗаполнено(РсФайл) И (Найти(СписокСчетов1С, РсФайл) > 0);

    Если Не СчетНайден И (ЗначениеЗаполнено(РсФайл) Или ЗначениеЗаполнено(СписокСчетов1С)) Тогда
        ДобавитьЗаписьВРасхождения(Расхождения, СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, "Не совпадает", "Расчётный счёт", РсФайл, СписокСчетов1С);
    КонецЕсли;
	
	ДатаРегФайл = СтрокаФайла.ДатаГосРегистрации; 
	ДатаРег1С = Строка1С.ДатаГосРегистрации;
	
	Если (ДатаРегФайл <> ДатаРег1С) И (ЗначениеЗаполнено(ДатаРегФайл) Или ЗначениеЗаполнено(ДатаРег1С)) Тогда
        ЗначВФайле = ?(ЗначениеЗаполнено(ДатаРегФайл), Формат(ДатаРегФайл, "ДФ=dd.MM.yyyy"), "");
        ЗначВ1С = ?(ЗначениеЗаполнено(ДатаРег1С), Формат(ДатаРег1С, "ДФ=dd.MM.yyyy"), "");
        ДобавитьЗаписьВРасхождения(
			Расхождения, 
			СтрокаФайла.ТипЛица, 
			СтрокаФайла.Идентификатор, 
			"Не совпадает", 
			"Дата гос. регистрации / выдачи документа", 
			ЗначВФайле, 
			ЗначВ1С);
    КонецЕсли;

    ОрганРегФайл = ОчиститьОрганРегистрации(СокрЛП(Строка(СтрокаФайла.ОрганГосРегистрации)));
    ОрганРег1С = ОчиститьОрганРегистрации(СокрЛП(Строка(Строка1С.ОрганГосРегистрации)));
    ДобавитьРасхождениеПоРеквизиту(
		Расхождения, 
		СтрокаФайла, 
		"Орган, осуществивший регистрацию / выдавший документ", 
		ОрганРегФайл, 
		ОрганРег1С);

КонецПроцедуры

Процедура ДобавитьЛицаОтсутствующиеВФайле(Расхождения, ТаблицаФайла, Данные1С)
    
    Для Каждого Строка1С Из Данные1С Цикл
        Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
        НайденВФайле = Ложь;
        
        Для Каждого СтрокаФ Из ТаблицаФайла Цикл
            КлючФ = ПолучитьКлючПоискаВ1С(СтрокаФ.ТипЛица, СтрокаФ.Идентификатор, СтрокаФ.ИНН);
            Если КлючФ = Ключ Тогда 
            	НайденВФайле = Истина; 
            	Прервать; 
            КонецЕсли;
        КонецЦикла;
        
        Если Не НайденВФайле Тогда 
        	ДобавитьЗаписьВРасхождения(
				Расхождения, 
				Строка1С.ТипЛица, 
				Строка1С.Идентификатор, 
				"Лицо из 1С отсутствует в файле реестра", 
				"-", 
				"-", 
				"Указано в 1С"); 
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры

Функция ОчиститьОрганРегистрации(Знач Текст)
    
    Если Не ЗначениеЗаполнено(Текст) Тогда 
    	Возврат Текст; 
    КонецЕсли;
    
    Текст = СокрЛП(Текст);
    
    Пока Прав(Текст, 1) = "," Или Прав(Текст, 1) = ";" Или Прав(Текст, 1) = " " Цикл 
    	Текст = Лев(Текст, СтрДлина(Текст) - 1); 
    	Текст = СокрП(Текст); 
    КонецЦикла;
    
    Пока СтрНайти(Текст, "  ") > 0 Цикл 
    	Текст = СтрЗаменить(Текст, "  ", " "); 
    КонецЦикла;
    
    Возврат Текст;

КонецФункции

Функция ПолучитьКлючПоискаВ1С(ТипЛица, Идентификатор, ИНН)
    
    Идентификатор = НормализоватьИдентификаторДляКлюча(Идентификатор);
    ИНН = ВРег(СокрЛП(Строка(ИНН)));
    
    Если ТипЛица = "ФЛ" Тогда 
    	Возврат "ФЛ|" + Идентификатор; 
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ИНН) Тогда 
    	Возврат "ЮЛ|" + ИНН; 
    КонецЕсли;
    
    Возврат "ЮЛ|НАИМ|" + Идентификатор;

КонецФункции

Функция НормализоватьИдентификаторДляКлюча(Строка)
    
    Строка = СокрЛП(Строка(Строка));
    Строка = РаботаСоСтрокамиКлиентСервер.ЗаменитьПробельныеСимволы(Строка, " ");
    
    Пока СтрНайти(Строка, "  ") > 0 Цикл 
    	Строка = СтрЗаменить(Строка, "  ", " "); 
    КонецЦикла;
    
    Возврат ВРег(СокрЛП(Строка));

КонецФункции

