Функция ПолучитьСтрокуРеквизитаИлиПусто(СтрокаДанных, ИмяРеквизита)
	Если СтрокаДанных = Неопределено Тогда 
		Возврат ""; 
	КонецЕсли;
	Возврат Строка(СтрокаДанных[ИмяРеквизита]);
КонецФункции

Процедура ЗаполнитьСтрокуОтчетаДаннымиЛица(СтрокаОтчета, Строка1С, СтрокаФайла, ТипЛица)
	
	СтрокаОтчета._Тек_Паспорт = ?(ТипЛица = "ФЛ", ПолучитьПаспортИзСтрокиДанных(Строка1С), "");
	СтрокаОтчета._Нов_Паспорт = ?(ТипЛица = "ФЛ", ПолучитьПаспортИзСтрокиДанных(СтрокаФайла), "");
	
    СтрокаОтчета._Тек_ДатаРождения = ?(Строка1С <> Неопределено И ЗначениеЗаполнено(Строка1С.ДатаРождения), Формат(Строка1С.ДатаРождения, "ДФ=dd.MM.yyyy"), "");
    СтрокаОтчета._Нов_ДатаРождения = ?(СтрокаФайла <> Неопределено И ЗначениеЗаполнено(СтрокаФайла.ДатаРождения), Формат(СтрокаФайла.ДатаРождения, "ДФ=dd.MM.yyyy"), "");

	СтрокаОтчета._Тек_Наименование = ?(ТипЛица = "ЮЛ", ПолучитьНаименованиеИзСтрокиДанных(Строка1С), "");
	СтрокаОтчета._Нов_Наименование = ?(ТипЛица = "ЮЛ", ПолучитьНаименованиеИзСтрокиДанных(СтрокаФайла), "");
	СтрокаОтчета._Тек_ИНН = ПолучитьСтрокуРеквизитаИлиПусто(Строка1С, "ИНН");
	СтрокаОтчета._Нов_ИНН = ПолучитьСтрокуРеквизитаИлиПусто(СтрокаФайла, "ИНН");
	СтрокаОтчета._Тек_ОГРН = ПолучитьСтрокуРеквизитаИлиПусто(Строка1С, "ОГРН");
	СтрокаОтчета._Нов_ОГРН = ПолучитьСтрокуРеквизитаИлиПусто(СтрокаФайла, "ОГРН");
	СтрокаОтчета._Тек_Адрес = ПолучитьСтрокуРеквизитаИлиПусто(Строка1С, "Адрес");
	СтрокаОтчета._Нов_Адрес = ПолучитьСтрокуРеквизитаИлиПусто(СтрокаФайла, "Адрес");

	РсФайл = ПолучитьСтрокуРеквизитаИлиПусто(СтрокаФайла, "РасчетныйСчет");
	СписокСчетов1С = ПолучитьСтрокуРеквизитаИлиПусто(Строка1С, "СписокСчетов");
	СчетСовпадает = ЗначениеЗаполнено(СписокСчетов1С) И ЗначениеЗаполнено(РсФайл) И Найти(СписокСчетов1С, РсФайл) > 0;

	СтрокаОтчета._Тек_РасчетныйСчет = ?(СчетСовпадает, РсФайл, СписокСчетов1С);
	СтрокаОтчета._Нов_РасчетныйСчет = РсФайл;
	
	СтрокаОтчета._Тек_ДатаГосРегистрации = ПолучитьДатуГосРегистрацииФормат(Строка1С);
	СтрокаОтчета._Нов_ДатаГосРегистрации = ПолучитьДатуГосРегистрацииФормат(СтрокаФайла);
	СтрокаОтчета._Тек_ОрганГосРегистрации = ОчиститьОрганРегистрации(ПолучитьСтрокуРеквизитаИлиПусто(Строка1С, "ОрганГосРегистрации"));
	СтрокаОтчета._Нов_ОрганГосРегистрации = ОчиститьОрганРегистрации(ПолучитьСтрокуРеквизитаИлиПусто(СтрокаФайла, "ОрганГосРегистрации"));

КонецПроцедуры

Процедура ПрименитьРасхожденияПоРеквизитамКСтроке(СтрокаОтчета, КлючПара, РасхожденияПоРеквизитам)
	
	Подзапись = РасхожденияПоРеквизитам.Получить(КлючПара);
	Если Подзапись = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Для Каждого КлючИЗнач Из Подзапись Цикл
		ИмяПоля = КлючИЗнач.Ключ;
		Если ИмяПоля <> "РасчетныйСчет" Тогда
			ЗначТекНов = КлючИЗнач.Значение;
			СтрокаОтчета["_Тек_" + ИмяПоля] = Строка(ЗначТекНов.Тек);
			СтрокаОтчета["_Нов_" + ИмяПоля] = Строка(ЗначТекНов.Нов);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПостроитьСловарь1СДляОтчета(Данные1С)
    
    Словарь1С = Новый Соответствие;
    Для Каждого Строка1С Из Данные1С Цикл
        
        Ключ = ПолучитьКлючПоискаВ1С(Строка1С.ТипЛица, Строка1С.Идентификатор, Строка1С.ИНН);
        Словарь1С.Вставить(Ключ, Строка1С);
        
        Если Строка1С.ТипЛица = "ЮЛ" И ЗначениеЗаполнено(Строка1С.Идентификатор) Тогда
            Словарь1С.Вставить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(Строка1С.Идентификатор), Строка1С);
        КонецЕсли;
        
        КлючПара1С = Строка1С.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(Строка1С.Идентификатор);
        Словарь1С.Вставить(КлючПара1С, Строка1С);
    
    КонецЦикла;
    
    Возврат Словарь1С;

КонецФункции

Функция ПостроитьСловарьФайлаДляОтчета(ТаблицаФайла)
    
    СловарьФайла = Новый Соответствие;
    Для Каждого СтрокаФ Из ТаблицаФайла Цикл
        КлючПараФ = СтрокаФ.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(СтрокаФ.Идентификатор);
        СловарьФайла.Вставить(КлючПараФ, СтрокаФ);
    КонецЦикла;
    
    Возврат СловарьФайла;

КонецФункции

Функция НайтиСтроку1СВСловаре(СтрокаФайла, КлючПара, Словарь1С, ВариантРасхождения)
    
    ЗаписьУдалена = 2; 
    Строка1С = Неопределено;
	
	Если СтрокаФайла <> Неопределено Тогда
        Ключ = ПолучитьКлючПоискаВ1С(СтрокаФайла.ТипЛица, СтрокаФайла.Идентификатор, СтрокаФайла.ИНН);
        Строка1С = Словарь1С.Получить(Ключ);
        Если Строка1С = Неопределено И СтрокаФайла.ТипЛица = "ЮЛ" Тогда
            Строка1С = Словарь1С.Получить("ЮЛ|НАИМ|" + НормализоватьИдентификаторДляКлюча(СтрокаФайла.Идентификатор));
        КонецЕсли;
    КонецЕсли;
	
	Если Строка1С = Неопределено И ВариантРасхождения = ЗаписьУдалена Тогда 
		Строка1С = Словарь1С.Получить(КлючПара); 
	КонецЕсли;
    
    Возврат Строка1С;

КонецФункции

Функция ПолучитьПриращениеСчетчиковПоВарианту(ВариантРасхождения)
    
    НоваяЗапись = 1; 
    ЗаписьУдалена = 2; 
    ЗаписьИзменена = 3;
    
    Возврат Новый Структура("Новая, Удалена, Изменена", 
    	?(ВариантРасхождения = НоваяЗапись, 1, 0), 
    	?(ВариантРасхождения = ЗаписьУдалена, 1, 0), 
    	?(ВариантРасхождения = ЗаписьИзменена, 1, 0));

КонецФункции

Функция ПостроитьРасхожденияПоРеквизитамДляОтчета(Расхождения, МаппингРеквизитВИмяПоля)
    
    РасхожденияПоРеквизитам = Новый Соответствие;
	
	Для Каждого СтрокаРасх Из Расхождения Цикл
		
		ИмяПоля = МаппингРеквизитВИмяПоля.Получить(СтрокаРасх.Реквизит);
		Если ИмяПоля = Неопределено Тогда 
			Продолжить; 
		КонецЕсли;
		
		КлючПара = СтрокаРасх.ТипЛица + "|" + НормализоватьИдентификаторДляКлюча(СтрокаРасх.Идентификатор);
        Подзапись = РасхожденияПоРеквизитам.Получить(КлючПара);
		
		Если Подзапись = Неопределено Тогда 
			Подзапись = Новый Структура; 
			РасхожденияПоРеквизитам.Вставить(КлючПара, Подзапись); 
		КонецЕсли;
		
		Подзапись.Вставить(ИмяПоля, Новый Структура("Тек, Нов", СтрокаРасх.ЗначениеВ1С, СтрокаРасх.ЗначениеВФайле));
	
	КонецЦикла;
    
    Возврат РасхожденияПоРеквизитам;

КонецФункции

Функция СоздатьПустуюТаблицуОтчетаОРасхождениях(СравниваемыеПоляОтчета)
    
    ТаблицаОтчета = Новый ТаблицаЗначений;
    ТаблицаОтчета.Колонки.Добавить("ТипЛица", Новый ОписаниеТипов("Строка"));
    ТаблицаОтчета.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
    ТаблицаОтчета.Колонки.Добавить("ВариантРасхождения", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИмяПоля Из СравниваемыеПоляОтчета Цикл
        ТаблицаОтчета.Колонки.Добавить("_Тек_" + ИмяПоля, Новый ОписаниеТипов("Строка"));
        ТаблицаОтчета.Колонки.Добавить("_Нов_" + ИмяПоля, Новый ОписаниеТипов("Строка"));
    КонецЦикла;
    
    Возврат ТаблицаОтчета;

КонецФункции

Функция ПреобразоватьРасхожденияВФорматОтчетаОРасхождениях(Расхождения, ТаблицаФайла, Данные1С)
    
    УникальныеПары = ПолучитьУникальныеЛицаСВариантомРасхождения(Расхождения);
    Словарь1С = ПостроитьСловарь1СДляОтчета(Данные1С);
    СловарьФайла = ПостроитьСловарьФайлаДляОтчета(ТаблицаФайла);
    ДанныеМаппинга = ПолучитьМаппингРеквизитовИПоляОтчета();
    МаппингРеквизитВИмяПоля = ДанныеМаппинга.МаппингРеквизитВИмяПоля;
    СравниваемыеПоляОтчета = ДанныеМаппинга.СравниваемыеПоляОтчета;
    РасхожденияПоРеквизитам = ПостроитьРасхожденияПоРеквизитамДляОтчета(Расхождения, МаппингРеквизитВИмяПоля);
    ТаблицаОтчета = СоздатьПустуюТаблицуОтчетаОРасхождениях(СравниваемыеПоляОтчета);
	
	СчетчикНовая = 0; 
	СчетчикУдалена = 0; 
	СчетчикИзменена = 0;
	
	Для Каждого ЭлементПары Из УникальныеПары Цикл
		
		КлючПара = ЭлементПары.Ключ;
        Пара = ЭлементПары.Значение;
        СтрокаФайла = СловарьФайла.Получить(КлючПара);
        Строка1С = НайтиСтроку1СВСловаре(СтрокаФайла, КлючПара, Словарь1С, Пара.ВариантРасхождения);
		
		НоваяСтрока = ТаблицаОтчета.Добавить();
        НоваяСтрока.ТипЛица = Пара.ТипЛица;
        НоваяСтрока.Идентификатор = Пара.Идентификатор;
        НоваяСтрока.ВариантРасхождения = Пара.ВариантРасхождения;
		
		Дельта = ПолучитьПриращениеСчетчиковПоВарианту(Пара.ВариантРасхождения);
        СчетчикНовая = СчетчикНовая + Дельта.Новая; 
        СчетчикУдалена = СчетчикУдалена + Дельта.Удалена; 
        СчетчикИзменена = СчетчикИзменена + Дельта.Изменена;
		
		ЗаполнитьСтрокуОтчетаДаннымиЛица(НоваяСтрока, Строка1С, СтрокаФайла, Пара.ТипЛица);
        ПрименитьРасхожденияПоРеквизитамКСтроке(НоваяСтрока, КлючПара, РасхожденияПоРеквизитам);
	
	КонецЦикла;
	
	Результат = Новый Структура;
    Результат.Вставить("ЕстьРасхождения", (СчетчикНовая + СчетчикУдалена + СчетчикИзменена) > 0);
    Результат.Вставить("НоваяЗапись", СчетчикНовая);
    Результат.Вставить("ЗаписьУдалена", СчетчикУдалена);
    Результат.Вставить("ЗаписьИзменена", СчетчикИзменена);
    Результат.Вставить("Таблица", ТаблицаОтчета);
    
    Возврат Результат;

КонецФункции

// Формирует итоговый HTML-отчет на основе таблицы расхождений.
// ПолноеИмяФайла - путь и имя файла, по которому построен отчёт (выводится в шапке).
