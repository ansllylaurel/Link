#КонецОбласти

#Область ЭкспортВExternals

// Сохраняет файл реестра пайщиков и данные в SQL базу Externals.
Процедура СохранитьФайлИРеестрВExternals(ДвоичныеДанныеФайла, ПолноеИмяФайла, Организация, ТаблицаПайщиков, ДатаРеестра, ПИФ)
	
	// Подготовка данных файла
	Разложить = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайла);
	ИмяФайла = Разложить.Имя;
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ЛогироватьСообщение("Не удалось определить имя файла для сохранения в Externals.", УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;

	ИдентификаторОрганизации = ?(ЗначениеЗаполнено(Организация), Строка(Организация.УникальныйИдентификатор()), "");
	Источник = 31; // Реестр владельцев инвестиционных паев
	ДатаПубликации = ТекущаяДата();
	Соединение = Неопределено;
	
	Попытка
		
		// 1. Сохранение файла в Externals
		ХешСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДвоичныеДанныеФайла, ХешФункция.SHA256);
		Соединение = РаботаСВнешнимиСистемами.ADODBC_УстановитьСоединение(РаботаСВнешнимиСистемами.СтрокаСоединенияСExternals());
		
		РаботаСВнешнимиСистемами.СохранитьФайлВExternals(ИмяФайла, Источник, ДвоичныеДанныеФайла, 
			ДатаПубликации, ИдентификаторОрганизации, ХешСумма, Соединение);
		
		File_Id = РаботаСВнешнимиСистемами.ПолучитьИдентификаторФайлаВExternals(
			Источник, ИдентификаторОрганизации, ИмяФайла, ХешСумма, Соединение);

		Если File_Id = Неопределено Тогда
			ЛогироватьСообщение("Не удалось получить идентификатор сохранённого файла в Externals.", УровеньЖурналаРегистрации.Ошибка);
			Возврат;
		КонецЕсли;

		// 2. Очистка старых записей реестра
		ТекстЗапроса = "DELETE FROM Externals.dbo.Register_Of_Unit_Holders WHERE File_Id = " + Формат(File_Id, "ЧН=0; ЧГ=");
		Соединение.Execute(ТекстЗапроса);

		// 3. Подготовка общих данных реестра
		Fund_Name = ?(ЗначениеЗаполнено(ПИФ), Лев(СокрЛП(Строка(ПИФ)), 10), "");
		
		Compilation_DateSQL = ?(ЗначениеЗаполнено(ДатаРеестра), ДатаРеестра, ТекущаяДата());
		СтрокаДатаКомпиляции = Формат(Compilation_DateSQL, "ДФ=yyyy-MM-dd HH:mm:ss");
		
		// 4. Подготовка параметризованного запроса INSERT
		Запрос = Новый COMОбъект("ADODB.Command");
		Запрос.CommandText = 
			"INSERT INTO Externals.dbo.Register_Of_Unit_Holders
			|	(File_Id, Fund_Name, Compilation_Date, Personal_Account_Number, Is_Nominee, 
			|	 Full_Name, Birthday, Registration_Info, Registration_Address, Fact_Address, 
			|	 Bank_Account, Number_Of_Units, Size_Of_Share)
			|VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)";

		Запрос.CommandType = 1;
		Запрос.Prepared = "True";
		Запрос.NamedParameters = "False";
		
		// Параметры запроса
		Запрос.Parameters.Append(Запрос.CreateParameter("@1", 20, 1, 19));   // File_Id
		Запрос.Parameters.Append(Запрос.CreateParameter("@2", 200, 1, 10));  // Fund_Name
		Запрос.Parameters.Append(Запрос.CreateParameter("@3", 135, 1, 8));   // Compilation_Date
		Запрос.Parameters.Append(Запрос.CreateParameter("@4", 200, 1, 50));  // Personal_Account_Number
		Запрос.Parameters.Append(Запрос.CreateParameter("@5", 11, 1, 1));    // Is_Nominee
		Запрос.Parameters.Append(Запрос.CreateParameter("@6", 200, 1, 255)); // Full_Name
		Запрос.Parameters.Append(Запрос.CreateParameter("@7", 200, 1, 10));  // Birthday
		Запрос.Parameters.Append(Запрос.CreateParameter("@8", 200, 1, 255)); // Registration_Info
		Запрос.Parameters.Append(Запрос.CreateParameter("@9", 200, 1, 255)); // Registration_Address
		Запрос.Parameters.Append(Запрос.CreateParameter("@10", 200, 1, 255)); // Fact_Address
		Запрос.Parameters.Append(Запрос.CreateParameter("@11", 200, 1, 255)); // Bank_Account
		Запрос.Parameters.Append(Запрос.CreateParameter("@12", 20, 1, 18));  // Number_Of_Units
		Запрос.Parameters.Append(Запрос.CreateParameter("@13", 20, 1, 18));  // Size_Of_Share
		
		Запрос.ActiveConnection = Соединение;

		// 5. Загрузка строк реестра
		КоличествоЗаписей = 0;
		Для Каждого СтрокаП Из ТаблицаПайщиков Цикл
			
			// Базовые параметры
			Запрос.Parameters(0).Value = File_Id;            // File_Id
			Запрос.Parameters(1).Value = Fund_Name;          // Fund_Name
			Запрос.Parameters(2).Value = СтрокаДатаКомпиляции; // Compilation_Date
			Запрос.Parameters(3).Value = "";                 // Personal_Account_Number
			Запрос.Parameters(4).Value = Ложь;               // Is_Nominee
			
			// Данные пайщика
			Запрос.Parameters(5).Value = Лев(СокрЛП(Строка(СтрокаП.Идентификатор)), 255); // Full_Name
			
            Если ЗначениеЗаполнено(СтрокаП.ДатаРождения) Тогда
                Запрос.Parameters(6).Value = Формат(СтрокаП.ДатаРождения, "ДФ=yyyy-MM-dd");
            Иначе
                Запрос.Parameters(6).Value = "";
            КонецЕсли;
			
			// Registration_Info (паспорт + ИНН + ОГРН)
			РегИнфо = СокрЛП(Строка(СтрокаП.СерияПаспорта) + " " + Строка(СтрокаП.НомерПаспорта));

			Если ЗначениеЗаполнено(СтрокаП.ИНН) Тогда
				РегИнфо = РегИнфо + ?(ЗначениеЗаполнено(РегИнфо), " ", "") + "ИНН " + Строка(СтрокаП.ИНН);
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаП.ОГРН) Тогда
				РегИнфо = РегИнфо + ?(ЗначениеЗаполнено(РегИнфо), " ", "") + "ОГРН " + Строка(СтрокаП.ОГРН);
			КонецЕсли;
			Запрос.Parameters(7).Value = Лев(РегИнфо, 255); // Registration_Info
			
			// Адреса и счет
			Адрес = Лев(СокрЛП(Строка(СтрокаП.Адрес)), 255);
			Запрос.Parameters(8).Value = Адрес;  // Registration_Address
			Запрос.Parameters(9).Value = Адрес;  // Fact_Address
			
			Запрос.Parameters(10).Value = Лев(СокрЛП(Строка(СтрокаП.РасчетныйСчет)), 255); // Bank_Account
			Запрос.Parameters(11).Value = 0;     // Number_Of_Units
			Запрос.Parameters(12).Value = 0;     // Size_Of_Share
			
			Запрос.Execute();
			КоличествоЗаписей = КоличествоЗаписей + 1;
			
		КонецЦикла;

		ЛогироватьСообщение(СтрШаблон("Файл ""%1"" и реестр (%2 записей) сохранены в Externals.", ИмяФайла, КоличествоЗаписей), УровеньЖурналаРегистрации.Информация);
			
	Исключение
		ЛогироватьСообщение("Ошибка сохранения в Externals: " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;
	
	// Закрытие соединения
	Если Соединение <> Неопределено Тогда
		РаботаСВнешнимиСистемами.ADODBC_ЗакрытьСоединение(Соединение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеМетоды

// Разворачивает группу пользователей или возвращает одиночного пользователя в массиве.
Функция РазвернутьСписокПользователей(Знач Параметр)
	
	МассивРезультат = Новый Массив;
	Если Не ЗначениеЗаполнено(Параметр) Тогда 
		Возврат МассивРезультат; 
	КонецЕсли;
	
	ТипП = ТипЗнч(Параметр);
	
	Если ТипП = Тип("СправочникСсылка.ГруппыПользователей") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ГруппыПользователейСостав.Пользователь КАК Пользователь
			|ИЗ
			|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
			|ГДЕ
			|	ГруппыПользователейСостав.Ссылка = &Группа";
		
		Запрос.УстановитьПараметр("Группа", Параметр);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивРезультат.Добавить(Выборка.Пользователь);
		КонецЦикла;
		
	ИначеЕсли ТипП = Тип("СправочникСсылка.Пользователи") Тогда
		МассивРезультат.Добавить(Параметр);
		
	ИначеЕсли ТипП = Тип("СписокЗначений") Тогда
		МассивРезультат = Параметр.ВыгрузитьЗначения();
		
	ИначеЕсли ТипП = Тип("Массив") Тогда
		МассивРезультат = Параметр;
	КонецЕсли;
	
	Возврат МассивРезультат;

КонецФункции

// Отправляет сформированный HTML-отчет на указанные email адреса.
//
// Параметры:
//   Организация - СправочникСсылка.Организации
//   ДатаРеестра - Дата
//   ПИФ - СправочникСсылка.ПаевыеИнвестиционныеФонды
//   Расхождения - ТаблицаЗначений
//   ТекстHTML - Строка - Тело письма.
//   СписокПолучателей - Массив - Список пользователей для рассылки.
Процедура ОтправитьРезультатСверкиПоПочте(Организация, ДатаРеестра, ПИФ, Расхождения, ТекстHTML, СписокПолучателей)

	Если Не ЗначениеЗаполнено(СписокПолучателей) Тогда 
		Возврат; 
	КонецЕсли;

	Адреса = Новый Массив;
	Для Каждого Юзер Из СписокПолучателей Цикл
		Если ТипЗнч(Юзер) <> Тип("СправочникСсылка.Пользователи") Тогда 
			Продолжить; 
		КонецЕсли;
		
		Email = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Юзер, "АдресЭлектроннойПочты");
		Если ЗначениеЗаполнено(Email) Тогда
			Адреса.Добавить(Новый Структура("Адрес, Представление", Email, Строка(Юзер)));
		КонецЕсли;
	КонецЦикла;

	Если Адреса.Количество() = 0 Тогда 
		Возврат; 
	КонецЕсли;

	ПараметрыПисьма = Новый Структура("Кому, Тема, Тело, ТипТекста", 
		Адреса, 
		СтрШаблон("Сверка ПИФ %1 (%2)", ПИФ, Формат(ДатаРеестра, "ДФ=dd.MM.yyyy")), 
		ТекстHTML, 
		"HTML");

	Попытка
		РаботаСЭлектроннойПочтой.ОтправитьЭлектронноеПисьмо(РаботаСЭлектроннойПочтой.ПолучитьСистемнуюУчетнуюЗапись(), ПараметрыПисьма);
	Исключение
		ЛогироватьСообщение("Ошибка отправки почты: " + ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;

КонецПроцедуры

// Фиксирует факт сверки в регистре "ЖурналСверокПоВнутреннемуУчету".
Процедура ЗафиксироватьРезультатСверкиВЖурнале(Организация, ДатаРеестра, ПИФ, Расхождения)
	
	КоличествоРасхождений = 0;
	Если ТипЗнч(Расхождения) = Тип("ТаблицаЗначений") Тогда 
		КоличествоРасхождений = Расхождения.Количество(); 
	КонецЕсли;

	РегистрыСведений.ЖурналСверокПоВнутреннемуУчету.ЗафиксироватьРезультатСверки(
		Организация, 
		Справочники.СчетаДоверительногоУправления.ПустаяСсылка(), 
		ДатаРеестра, 
		Неопределено, 
		(КоличествоРасхождений = 0), 
		Истина, 
		ТекущаяДата(), 
		"Автосверка (Регламентное задание)");

КонецПроцедуры

// Записывает сообщение в Журнал регистрации.
Процедура ЛогироватьСообщение(Текст, Знач Уровень = Неопределено)
	
	ТекущийУровень = ?(Уровень = Неопределено, УровеньЖурналаРегистрации.Информация, Уровень);
	
	ЗаписьЖурналаРегистрации("ВнешняяОбработка.СверкаПИФ", ТекущийУровень, , , Текст);

КонецПроцедуры

#КонецОбласти