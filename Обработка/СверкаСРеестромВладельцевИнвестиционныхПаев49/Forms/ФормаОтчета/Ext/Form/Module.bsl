&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Элементы.ПолучателиРассылки.Видимость = Ложь;
    РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
    
    Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
    СрокОжиданияФайлов = КонецЧаса(Дата(Год(ТекущаяДата()), Месяц(ТекущаяДата()), День(ТекущаяДата()), 19, 0, 0));
    
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыРассылки(Команда)
    
    Элементы.ПолучателиРассылки.Видимость = НЕ Элементы.ПолучателиРассылки.Видимость;
    
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайла(Команда)
    
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Фильтр = "Файлы Excel (*.xlsx)|*.xlsx";
    Диалог.Заголовок = "Выберите файл реестра (xlsx)";
    
    Если Диалог.Выбрать() Тогда
        ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПутьКПапкеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    СтандартнаяОбработка = Ложь;
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    Диалог.Заголовок = "Выберите каталог с файлами реестра (xlsx)";
    Диалог.Каталог = ПутьКПапке;
    
    Если ЗначениеЗаполнено(ПутьКПапке) Тогда
        Файл = Новый Файл(ПутьКПапке);
        Если Файл.Существует() Тогда
            Если Файл.ЭтоКаталог() Тогда
                Диалог.Каталог = Файл.ПолноеИмя;
            Иначе
                Диалог.Каталог = Файл.Путь;
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    Диалог.Показать(Новый ОписаниеОповещения("ПутьКПапкеНачалоВыбораЗавершение", ЭтаФорма, Новый Структура("Диалог", Диалог)));
    
КонецПроцедуры

&НаКлиенте
Процедура ПутьКПапкеНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    
    Если ДополнительныеПараметры <> Неопределено И ДополнительныеПараметры.Свойство("Диалог") Тогда
        ПутьКПапке = ДополнительныеПараметры.Диалог.Каталог;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
    
    Если Не ЗначениеЗаполнено(Организация) Тогда
        ПоказатьОповещениеПользователя("Укажите организацию.");
        Возврат;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ПутьКПапке) Тогда
        СформироватьИзПапки();
        Возврат;
    КонецЕсли;
    
    Если Не ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
        ПоказатьОповещениеПользователя("Укажите файл реестра или папку с файлами.");
        Возврат;
    КонецЕсли;
    
    Расширение = ВРег(СтрЗаменить(РаботаСФайламиКлиентСервер.ПолучитьРасширениеИмениФайла(ПолноеИмяФайла), ".", ""));
    Если Расширение <> "XLSX" Тогда
        ПоказатьОповещениеПользователя(
            СтрШаблон("Допустим только формат xlsx. Указан: %1.", Расширение));
        Возврат;
    КонецЕсли;
    
    Попытка
        ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяФайла);
    Исключение
        ПоказатьОповещениеПользователя("Не удалось прочитать файл: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;
    
    АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
    ТекстОшибкиСверки = "";
    СформироватьНаСервере(АдресХранилища, ПолноеИмяФайла, Ложь);
    Если ЗначениеЗаполнено(ТекстОшибкиСверки) Тогда
        ПоказатьОповещениеПользователя(ТекстОшибкиСверки);
    Иначе
        ПоказатьОповещениеПользователя("Сверка по файлу выполнена.");
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИзПапки()
    
    Каталог = Новый Файл(ПутьКПапке);
    Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
        ПоказатьОповещениеПользователя("Укажите существующую папку.");
        Возврат;
    КонецЕсли;
    
    ПутьНормализованный = ПутьКПапке;
    Если Не СтрЗаканчиваетсяНа(ВРег(ПутьНормализованный), "\\") Тогда
        ПутьНормализованный = ПутьНормализованный + "\\";
    КонецЕсли;
    
    ФайлыКаталога = НайтиФайлы(ПутьНормализованный, "*.xlsx", Ложь);
    
    Если ФайлыКаталога.Количество() = 0 Тогда
        Если ЗначениеЗаполнено(СрокОжиданияФайлов) И ТекущаяДата() > СрокОжиданияФайлов Тогда
            ПоказатьОповещениеПользователя("Файлы не поступили в папку в установленный срок.");
            Возврат;
        Иначе
            ПоказатьОповещениеПользователя("Файлы в папке отсутствуют.");
            Возврат;
        КонецЕсли;
    КонецЕсли;
    
    ОчиститьРезультатыИПодготовитьЗакладки();
    
    Для Каждого ФайлРеестра Из ФайлыКаталога Цикл
        
        Если ФайлРеестра.ЭтоКаталог() Тогда
            Продолжить;
        КонецЕсли;
        
        ПолноеИмяТекущегоФайла = ФайлРеестра.ПолноеИмя;
        
        Попытка
            ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяТекущегоФайла);
        Исключение
            ПоказатьОповещениеПользователя(
                "Не удалось прочитать файл """ + ПолноеИмяТекущегоФайла + """: " + ОписаниеОшибки());
            Продолжить;
        КонецПопытки;
        
        АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
        СформироватьНаСервере(АдресХранилища, ПолноеИмяТекущегоФайла, Истина);
        
    КонецЦикла;
    
    ПостроитьЗакладкиРезультатов();
    ПоказатьОповещениеПользователя(СтрШаблон("Обработано файлов: %1.", РезультатыСверки.Количество()));
    
КонецПроцедуры

&НаСервере
Процедура ОчиститьРезультатыИПодготовитьЗакладки()
    РезультатыСверки.Очистить();
    ДокументОтчета = "";
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере(АдресХранилища, ПолноеИмяФайла, СохранятьВExternals = Ложь)
    
    ТекстОшибкиСверки = "";
    Попытка
        ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранилища);
        ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
        Получатели = Неопределено;
        Если ТипЗнч(ПолучателиРассылки) = Тип("СписокЗначений") Тогда
            Получатели = ПолучателиРассылки.ВыгрузитьЗначения();
        КонецЕсли;
        Результат = ОтчетОбъект.СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла,
            Получатели, СохранятьВExternals);
        
        Если Результат.Успех Тогда
            Если СохранятьВExternals Тогда
                НоваяСтрока = РезультатыСверки.Добавить();
                НоваяСтрока.ПолноеИмяФайла = ПолноеИмяФайла;
                НоваяСтрока.ТекстОтчета = Результат.ТекстОтчета;
            Иначе
                ДокументОтчета = Результат.ТекстОтчета;
            КонецЕсли;
        ИначеЕсли ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
            ТекстОшибкиСверки = Результат.ТекстОшибки;
        КонецЕсли;
        
    Исключение
        ТекстОшибкиСверки = ОписаниеОшибки();
        ЗаписьЖурналаРегистрации(
            "ВнешняяОбработка.СверкаПИФ",
            УровеньЖурналаРегистрации.Ошибка,
            ,
            ,
            ТекстОшибкиСверки);
    КонецПопытки;
    
КонецПроцедуры

&НаСервере
Процедура ПостроитьЗакладкиРезультатов()
    
    Если РезультатыСверки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    Если РезультатыСверки.Количество() = 1 Тогда
        ДокументОтчета = РезультатыСверки[0].ТекстОтчета;
        Возврат;
    КонецЕсли;
    
    // Несколько файлов: объединяем отчёты в один HTML (каждый файл — секция с заголовком)
    ШапкаHTML = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Сверка с реестром</title>"
        + "<style>body{font-family:Arial,sans-serif;margin:20px;} .report-file-block{margin-bottom:30px;border-bottom:2px solid #ccc;padding-bottom:20px;} .report-file-title{color:#2c3e50;font-size:1.1em;}</style></head><body>";
    ХвостHTML = "</body></html>";
    ЧастиТела = "";
    Для Каждого СтрокаРезультата Из РезультатыСверки Цикл
        ИмяФайлаЭкранир = СтрЗаменить(СтрокаРезультата.ПолноеИмяФайла, "&", "&amp;");
        ИмяФайлаЭкранир = СтрЗаменить(СтрЗаменить(ИмяФайлаЭкранир, "<", "&lt;"), ">", "&gt;");
        ПозНач = СтрНайти(СтрокаРезультата.ТекстОтчета, "<body>");
        ПозКон = СтрНайти(СтрокаРезультата.ТекстОтчета, "</body>");
        ТелоФрагмент = ?(ПозНач > 0 И ПозКон > ПозНач, Сред(СтрокаРезультата.ТекстОтчета, ПозНач + 6, ПозКон - ПозНач - 6), СтрокаРезультата.ТекстОтчета);
        ЧастиТела = ЧастиТела + "<div class=""report-file-block""><h2 class=""report-file-title"">" + ИмяФайлаЭкранир + "</h2>" + ТелоФрагмент + "</div>";
    КонецЦикла;
    ДокументОтчета = ШапкаHTML + ЧастиТела + ХвостHTML;
    
КонецПроцедуры
