&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ПолучателиРассылки") И Параметры.ПолучателиРассылки <> Неопределено Тогда
		ПолучателиРассылки.Загрузить(Параметры.ПолучателиРассылки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	Закрыть(ПолучателиРассылки.Скопировать());
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	ДобавитьПользователя();
КонецПроцедуры

&НаСервере
Процедура ДобавитьПользователя()
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьПользователяОбработкаВыбора", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПользователяОбработкаВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ВыбранноеЗначение <> Неопределено Тогда
		ДобавитьВыбранногоПользователяНаСервере(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьВыбранногоПользователяНаСервере(Пользователь)
	НайденныеСтроки = ПолучателиРассылки.НайтиСтроки(Новый Структура("Пользователь", Пользователь));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	НоваяСтрока = ПолучателиРассылки.Добавить();
	НоваяСтрока.Пользователь = Пользователь;
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	УдалитьВыбраннуюСтроку();
КонецПроцедуры

&НаСервере
Процедура УдалитьВыбраннуюСтроку()
	ТекущиеДанные = Элементы.ПолучателиРассылки.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПолучателиРассылки.Удалить(ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры
