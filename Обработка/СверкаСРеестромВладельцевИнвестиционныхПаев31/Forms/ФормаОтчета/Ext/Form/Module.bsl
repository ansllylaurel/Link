&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ПолучателиРассылки.Видимость = Ложь;
	РаботаСФормами.УстановитьВерсиюДополнительногоОтчетаОбработки(ЭтаФорма);
	Организация = ОбщегоНазначения.ЗначениеПараметраСеанса("ТекущаяОрганизация");
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыРассылки(Команда)
	Элементы.ПолучателиРассылки.Видимость = НЕ Элементы.ПолучателиРассылки.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайла(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Файлы Excel (*.xlsx)|*.xlsx";
	Диалог.Заголовок = "Выберите файл реестра (xlsx)";
	Если Диалог.Выбрать() Тогда
		ПолноеИмяФайла = Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборПапки(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите папку с файлами реестра (xlsx)";
	Если Диалог.Выбрать() Тогда
		ПутьКПапке = Диалог.ПолноеИмяФайла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите организацию.");
		Возврат;
	КонецЕсли;
	
	// Работа по папке: ПутьКПапке и список файлов *.xlsx
	Если ЗначениеЗаполнено(ПутьКПапке) Тогда
		СформироватьИзПапки();
		Возврат;
	КонецЕсли;
	
	// Работа по одному файлу (старая логика — реквизит ПолноеИмяФайла)
	Если Не ЗначениеЗаполнено(ПолноеИмяФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите папку с файлами реестра или выберите один файл реестра (xlsx).");
		Возврат;
	КонецЕсли;
	
	Расширение = ВРег(СтрЗаменить(РаботаСФайламиКлиентСервер.ПолучитьРасширениеИмениФайла(ПолноеИмяФайла), ".", ""));
	Если Расширение <> "XLSX" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Допустим только формат xlsx. Указан: %1.", Расширение));
		Возврат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяФайла);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось прочитать файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
	СформироватьНаСервере(АдресХранилища, ПолноеИмяФайла, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИзПапки()
	Каталог = Новый Файл(ПутьКПапке);
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите существующую папку.");
		Возврат;
	КонецЕсли;
	
	ПутьНормализованный = ПутьКПапке;
	Если Не СтрЗаканчиваетсяНа(ВРег(ПутьНормализованный), "\") Тогда
		ПутьНормализованный = ПутьНормализованный + "\";
	КонецЕсли;
	
	ФайлыКаталога = НайтиФайлы(ПутьНормализованный, "*.xlsx", Ложь);
	
	Если ФайлыКаталога.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(СрокОжиданияФайлов) И ТекущаяДата() > СрокОжиданияФайлов Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файлы не поступили в папку в установленный срок.");
			Возврат;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файлы в папке отсутствуют.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ФайлРеестра Из ФайлыКаталога Цикл
		Если ФайлРеестра.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмяТекущегоФайла = ФайлРеестра.ПолноеИмя;
		Попытка
			ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяТекущегоФайла);
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось прочитать файл """ + ПолноеИмяТекущегоФайла + """: " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
		СформироватьНаСервере(АдресХранилища, ПолноеИмяТекущегоФайла, Истина);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере(АдресХранилища, ПолноеИмяФайла, СохранятьВExternals = Ложь)
	Попытка
		ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранилища);
		ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
		Результат = ОтчетОбъект.СформироватьОтчет(Организация, ДвоичныеДанныеФайла, ПолноеИмяФайла, ПолучателиРассылки.ВыгрузитьЗначения());
		Если Результат.Успех Тогда
			ДокументОтчета = Результат.ТекстОтчета;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отчёт сформирован.");
			Если СохранятьВExternals Тогда
				СохранитьФайлВExternalsНаСервере(ДвоичныеДанныеФайла, ПолноеИмяФайла);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьФайлВExternalsНаСервере(ДвоичныеДанныеФайла, ПолноеИмяФайла)
	Разложить = РаботаСФайламиКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайла);
	ИмяФайла = Разложить.Имя;
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось определить имя файла для сохранения в Externals.");
		Возврат;
	КонецЕсли;
	ИдентификаторОрганизации = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		ИдентификаторОрганизации = Строка(Организация.УникальныйИдентификатор());
	КонецЕсли;
	// Источник 31 — реестр владельцев инвестиционных паев (соответствует имени обработки)
	Источник = 31;
	ДатаПубликации = ТекущаяДата();
	Попытка
		ХешСумма = УниверсальныеМеханизмы.ПолучитьКонтрольнуюСуммуДвоичныхДанных(ДвоичныеДанныеФайла, ХешФункция.SHA256);
		РаботаСВнешнимиСистемами.СохранитьФайлВExternals(ИмяФайла, Источник, ДвоичныеДанныеФайла, ДатаПубликации, ИдентификаторОрганизации, ХешСумма);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл """ + ИмяФайла + """ сохранён в Externals.");
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка сохранения файла в Externals: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры